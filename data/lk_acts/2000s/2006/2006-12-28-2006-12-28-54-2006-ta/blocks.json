    "text": "(2) \u00a4\u008a\u00bc\u00b6\u00c6\u00d7\u00b6\u00c6\u00cc\u00b6\u00c7\u00bf\u00c7\u008a\u00bc\u00b6\u00c6\u00d7 \u00a9\u00e1\u00b9\u00b6\u00c6\u00cc\u00b6\u00b4\u00c6\u00b4\u00c7\u00ba\u00c6\u00a4\u00ae\u0088\u0081 2 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00b7\u00c9\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u008123 \u00db\u00b6\u00be\u00c6 27 \u00c1\u00ce\u00bc\u008a\u00be\u00c7\u00b8 \u0089\u00bc\u00c8\u00e2\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 (101 \u00a4\u00ba\u00c6\u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8) \u00d0\u0088\u008a\u00bb\u00be\u00c6 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00db\u00ce\u00bd\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u008a\u0081 753 \u00db\u00b6\u00be\u00c6 760 \u00c1\u00ce\u00bc\u008a\u00be\u00c7\u00b8\u0089\u00bc\u00c8\u00e2\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 765 \u00db\u00b6\u00be\u00c6 777 \u00c1\u00ce\u00bc\u008a\u00be\u00c7\u00b8\u0089\u00bc\u00c8\u00e2\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6\" \u00cd\u00ba\u00be\u00c6\u00db\u00ce\u00bd\u0094\u00b4\u00c6\u00d5 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c7\u00be\u00c6(1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b7\u00c8\u00bb\u00c7\u00bb\u00c7\u00b6\u00c8\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00b6\u00c6\u00b6\u00c7\u00b8 \u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7\u00ba\u00c6\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\" \u00ba\u00c7\u00af\u00c7\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u00af\u00c6\u00cc\u00af\u00