    "text": "\u00b6+\u00c6\u00af\u00bf\u00c6 \u00b7\u00c8\u00bb\u00ba\u00b8\u00b9\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00bc+\u00c6\u00af\u00ce\u00bf\u00b1\u00c6 \u00b1\u00ba\u00bc\u00c6\u00b9\u00c6\u0089\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00ac\u0081\u00bd\u00c8\u00be\u00c6\u00a5\u00bd\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf\u00b8\u00bc\u00c7\u00b6\u00be\u00c7\u00df\u00ba\u00c6 \u00a3\u0081\u00cd\u00bd\u00be\u00c6 \u00da\u00be\u00ba\u00c6\u00cc\u00b9\u00bb\u00bc\u00c6\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf\u00c7\u00bc\u00c7\u00b6\u00be\u00c7\u00df\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b6+\u00c6\u00af\u00bf\u00c6 \u00af\u00b4\u00c6\u00b1\u00c8\u00ce\u00bb \u00ba\u00c7\u00bd\u00c6\u00bd\u00c8\u008a\u00dd\u00b9\u00c6\u00b9\u00b6\u00b8\u00c7\u00df\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00b6+\u00c6\u00af\u00bf\u00c6 \u00cc\u00b9\u00bb\u00bc\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00b6 \u00b7\u00c8\u00bb\u00ba\u00b8+\u00c6\u00af\u00ce\u00bf\u00b1\u00c6 \u00b1\u00ba\u00bc\u00c6\u00b9\u00c6\u0089\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf \u00a4\u00b4\u00c6\u00af\u00e0\u00bf\u00c6\u00af\u00b5\u00c8\u00b1\u00ba\u00c7\u00b8 \u00b7\u00c8\u00bb\u00ba\u00b8+\u00c6\u00af\u00ce\u00bf\u00b1\u00c6 \u00b1\u00ba\u00bc\u00c6\u00b9\u00c6\u0089\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00d5\u00cc\u00b1\u0081\u00de\u00bf\u00c6\u00bf\u00b8\u00bc\u00c6 \u00a9\u0081\u00bd \u00b7\u00c8\u00af\u00c0\u00c6\u008c\u0081 \u00af\u00c7\u00bc\u00b5\u00ba\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00c8\u00bb\u00ba\u00b8\u00b9\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00bc+\u00c6\u00af\u00ce\u00bf\u00b1\u00c6 \u00b1\u00ba\u00bc\u00c6\u00b9\u00c6\u0089\u00b6\u00c6\u00b6 \u00cd\u00b7\u00bc\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00db\u00b9\u00c6\u00b9\u00b6\u00c6\u00ce\u00b6\u00b7\u00c6\u00d7 \u00c1\u00bb\u00d7\u00af\u00c6\u00d0\u00af\u00c6\u00d0\u00ce\u00bd\u00c1\u00c7\u008a\u00dd\u00b7\u00c6\u00b6 