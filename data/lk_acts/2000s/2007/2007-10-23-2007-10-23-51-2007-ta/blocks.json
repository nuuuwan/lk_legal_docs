0b1\u00c7\u00ce\u00be\u00af\u00c6\u00af\u00b4\u00c6\u0088\u00b4\u00b6\u00c6\u00cc\u00b6\u00c7\u00d0\u00b6\u00c8 \u00a7\u00b4\u00c6\u00b9\u00b4 \u00a3\u00b6\u0081 \u00ba\u00c9\u00d7\u00bf\u00c6\u00bf \u00a9\u00be\u00c6\u00be\u00c7\u00af\u00c6 \u00af\u00b4\u00c6\u0088\u00b4+\u00c6\u00af\u00e0\u00b4\u0081\u00b9\u008a\u00bc\u00c6\u00af\u00e0\u00b4\u00d9\u00ba\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b6\u00c6\u00d7 \u00cd\u00af\u00c7+\u00c6\u00af\u00c4\u00c7\u00c1\u00b6\u00c6\u00b6 \u00a9\u00b8\u00c1\u00ce\u00c0\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00d7\u00ba\u00c6 \u00a3\u00bd\u00c8\u00bb\u00b9\u00c6\u00b9\u00d5\u00c1\u00d7\u00ba\u00c7\u00b8 \u00a3\u00af\u00c6\u00af\u00c7\u00b5\u00c8\u00b6\u00c6\u00d7\u00ae\u00d5 \u00a3\u00b4+\u00c6\u00af\u00df\u00ba\u00c6 ; \u00b9\u00bc\u00b9\u00c6\u00b9\u00bf\u008c\u00be\u00c6 \u00a5\u00d7\" \u00cc\u00b1\u00c7\u00be\u00c6\u00be\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00d2\u00c1\u00d5\u00c1\u00ce\u00bc\u00b9\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00b9\u0088 \u00ad\u00bc\u00c6 \u00aa\u00af\u00c6\u00af\u00bc\u00c6 \u00db\u00b9\u00c6\u00b9\u00b6\u00c6\u00ce\u00b6\u00b7\u00c6\u00d7 \u00b6\u00b1\u00ba\u00c6 \u00ac\u0081\u00de \u00a5\u00bc\u00ae\u00d5\u00cd\u00b9\u00bc\u00c6\u00b1\u00c6\u00d2\u00af\u00c6\u00af\u00ce\u00bf (\u00aa01- \u00f40-\u00cd\u00b9 35\u00b012) \u00cc\u00af\u00c7\u00ae\u00d5\u00bf\u00c6\u00bf\u00d7\u00b0",
