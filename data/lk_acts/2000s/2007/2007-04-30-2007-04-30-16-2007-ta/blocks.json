    "text": "\u00a3\u00b6\u00b8\u00c7\u00be\u00c6 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00a7\u00bf\u00c6\u00f7\u00bc\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u008a\u0081\u00cc\u00c1\u00bd\u00c6\u00bd\u00c8\u00b4\u00cc\u00ba\u00c7\u0081\u00de \u00a9\u00e1\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\u00ba\u00c6 \u00cc\u00b6\u00bc\u00c8\u00c1\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00a3\u00df\u00c1\u00be\u00bc\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b7\u00c8\u00af\u00c0\u00c6\u00ce\u00c1\u00b9\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8 \u00b9\u00b6\u008c\u00ce\u00bb\u00c1\u00bd\u00c8\u00b6\u00c7\u00af\u00c6\u00af\u00c8\u00bb \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c8\u0081 \u00b7\u00c8\u00bb\u00ba\u00b8\u00b9\u00c6 \u00b9\u00b6\u00c6\u00b6\u00c8\u00bc\u00b6\u00c6\u00ce\u00b6\u00b1\u00c6\u00b1\u00ba\u00bc\u00c6\u00b9\u00c6\u0089\u00b6\u00c6\u00b6 \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00bc\u00b1\u00c8\u00bb\u00bd\u00c6 \u00af\u00b4\u00c6\u00b1\u00c8\u008a\u0081\u00cc\u00b1\u00bb\u00be\u00c7\u00bf\u00dd\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00d2\u00cd\u00bb\u00b1\u00c6\u00ce\u00b1\u00af\u00c6 \u00d0\u00e1\u008c\u0081 \u00d0\u00e1\u00b6\u00c6\u00b6\u00ce\u00be\u00c1\u00dd\u00af\u00c6\u00d0 \u00cc\u00c1\u00bd\u00c6\u00bd\u00c8\u00b4\u00b6\u00c6\u00ce\u00b6 \u00b7\u00c8\u00bc\u00b9\u00c6\u00da\u00b6\u00be\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c7\u00b8 \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u008b\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00bf\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00c1\u00bd\u00c6\u00bd\u00c8\u00b4\u00b6\u00c6\u00ce\u00b6 \u00b7\u00c8\u00bc\u00b9\u00c6\u00da\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af \u00a7\u00bf\u00c6\u00f7\u00bc\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u0081\u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c7\u00af \u00a5\u00dd\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00b6\u00ce\u00af\u00ce\u00ba\u00dc\u00bf\u00c6\u00bf \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00ce\u00bc\u00b9\u00c6\u00cc\u00b9\u00bb\u00bc\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00d0\u00ba\u00c7\u00de \u00a3\u00c1\u00ce\u00bc\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8 \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b1\u00bb\u00be\u00c7\u00bf\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00e1\u00b6\u00c6\u00b6\u00ce\u00be\u00c1\u00bc\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00c1\u00bd\u00c6\u00bd\u00c8\u00b4\u00b6\u00c6\u00ce\u00b6 \u00b7\u00c8\u00bc\u00b9\u00c6\u00da\u00c1\u00b6\u00bd\u00c6\u00d0\u00b6\u00c6 \u00b6\u00ce\u00af\u00ce\u00ba\u00dc\u00bf\u00c6\u00bf \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00ce\u00bc \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00bf\u00c6\u00cc\u00b9\u00bb\u00bc\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7 \u00b7\u00c8\u00bb\u00ba\u00c8\u00b9\u00c6\u00b9\u00c7\u00bc\u00c7\u008a\u0081 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00c1\u00bd\u00c6\u00bd\u00c8\u00b4\u00b6\u00c6\u00ce\u00b6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00cc\u00b9\u00bb\u00bc\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00bc\u00b1\u00c8\u00bb\u00ce\u00ba\u00b9\u00c6\u0089\u00bd\u00c6\u00af\u00c7\u00b8\u00aa\u00c0\u00c7\u00c1\u00d7 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00be\u00c6 \u00b6\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00b9\u0088\u00c1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cd\u00af\u00bd\u00c6\u00b9 \u00a7\u00de\u00b6\u00c8\u00dc\u00ce\u00bc\u00ce\u00bb \u00cc\u00ba\u00c7\u00c0\u00c8\u00b7\u00c6\u00d7\u00af\u00c9\u00cc\u00c0\u00c7\u00b9\u00c6\u00b9\u00ba\u00c8\u00b4\u00c6\u00d5 \u00a3\u00be\u00c6\u00be\u00d7 \u00b1\u00b6\u00c6\u00b6\u00c8\u00bb\u00b6\u00c6\u00ce\u00b6\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00d7\u00af\u00c9\u00cc\u00c0\u00c7\u00b9\u00c6\u00b9\u00ba\u00c8\u00b4\u00c6\u00d5 \u008c\u00b4\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00cd\u00af\u00bd\u00c6\u00b9 \u00b1\u00b6\u00c6\u00b6\u00c8\u00bb\u00cc\u00ba\u00c7\u0081\u00de\u00b4\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00de\u00b6\u00c8\u00dc\u00ce\u00bc\u00cc\u00bb\u00c7\u0081\u00de\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cc\u00b9\u00bb\u00bc\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00b6 \u00b7\u00c8\u00bb\u00ba\u00b8\u00ba\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b6\u00c6\u00b6\u00d9\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00d5\u00ba\u00c7\u008a\u0081\"\u00cc\u00b6\u00bc\u00c8\u00c1\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8 \u00a3\u00df\u00c1\u00be\u00bc\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c6\u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00a7\u00bf\u00c6\u00f7\u00bc\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u008a\u0081 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c7\u00af\u00b6\u00c6 \u00cd\u00b6\u00bc\u00c6\u00b7\u00c6\u00cc\u00b6\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00b6\u00c7\u00af\u00cc\u00c1\u00bf\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\