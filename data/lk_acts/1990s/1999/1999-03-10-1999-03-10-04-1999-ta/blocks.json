    "text": "\u00b9\u00c7\u00af\u00ba\u00c6 1 2\u00b0(i) \u00cd\u00b6\u00b1\u00c8\u00bb \u0096\u00b4\u00ce\u00ba\u00b9\u00c6\u00da \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00dd\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00b6\u00b1\u00c8\u00bb\u0096\u00b4\u00ce\u00ba\u00b9\u00c6\u00da \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00af\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00ba\u00c7\u00b8\u00ce\u00c1\u00dc\u00ba\u00c61994,\u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00c7\u00c6 31 \u00a4\u00b7\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u0081\u00b8\u00c7\u00c6 \u00b7\u00c8\u00c7\u00c6\u00ba\u00c7\u00b5\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00ce\u00c1\u00dc\u00ba\u00c6\u008c\u00bd\u00c6\u00b9\u00ce\u00b8, \u00d0\u00b6\u00c6\u00b6\u00ce\u00af, \u00c1\u00c7\u00b4\u00ce\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c7\u00b4\u00ce\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b8\u00e2 \u00a9\u0081\u00bd\u00c1\u00ce\u00af\u008a\u00be\u00c6 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00e0\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u0081\u00a4\u00b4\u00c6\u00b1\u00c8\u00dc\u00ce\u00b4\u00ce\u00ba \u00ce\u00af\u00bb\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00ce\u00c1\u00dc\u00ba\u00c7\u00b8 \u00a9\u00be\u00c6\u00be\u00c7\u00af\u00c6 \u00e7\u00b4\u00c6\u00b4\u00c7\u00b4\u00c6\u00b1\u00c8\u00a4\u00b6\u00b8+\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00c1\u00ce\u00bc\u00b9\u00b4+\u00c6\u00af\u00ce\u00bf, \u00cd\u00ba\u00bd\u00c6\u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 5 \u00a4\u00ba\u00c6\u0089\u00c7\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00de:-(\u00a3) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00a4\u00b6\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7\u00ba\u00c6 \u00c1\u00ce\u00bc\u00b9\u00b4\u00ba\u00c6 \u00a3\u00b6\u0081\u00d7\u00ce\u00b5 \u008c\u00b6\u00c8\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00ac\u00e1+\u00c6\u00d0 \u008c\u00b6\u00c8\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6\u00a5\u00b5+\u00c6\u00af\u00c8\u00bb\u00b6\u00c7\u00af \u00a7\u00bf\u00c6\u00bf\u00b8 \u00a9\u0081\u00bd \u00b9\u00bb\u0081\u00b9\u00c7\u00b4\u00c6\u0088\u00bd\u00c6\u00d0\u00a7\u00bf\u00c6\u00f7\u00bc\u00b6\u00c8\u00af\u00c7\u00bc \u00b1\u00ce\u00b9\u008a\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7 \u00b1\u00c7\u0081\u00bd\u00c8\u00b6\u00cc\u00c0\u00c7\u0081\u00de\u00ba\u00c6\u00a3\u00b6\u00c6\u00d7\u00b4\u0081",
