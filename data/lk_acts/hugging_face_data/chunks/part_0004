    "chunk_text": "(\u00a5) \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00b5\u00c8\u00b8\u00c8\u00b6\u00c6 \u00cd\u00b6\u00af\u00c6\u00af\u00ba\u00c6\" \u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00bc\u00e2 \u00a3\u00be\u00c6\u00be\u00d7\u00b6\u00af\u00c1\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00db\u00ce\u00bd\u00b1\u00c6 \u00cd\u00b1\u00ce\u00c1 \u00a7\u00b4\u00c6\u00b9\u00b4 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6\u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00da\u00bc\u00c8\u00ce\u00af\u008a\u00be\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00b1\u00b6\u00c8\u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00b1\u00ce\u00c1 \u00db\u00af\u00c6\u00af\u00c8\u00bb\u00ba\u00c7\u00b8 \u00cd\u00b7\u00bc\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u0088\u00be\u00c6 \u00b6\u00bf\u00ba\u00c6 \u00cc\u00b9\u00bd\u00c6\u00bd\u00c8\u00dd\u00b7\u00c6\u00b6\u008c\u00b4\u00b6\u00c6\u00d7 ;\u00a3\u00be\u00c6\u00be\u00d7\n\n22007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 24 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00b5\u00c8\u00b8\u00c8\u00c1\u00c0\u00c8\u00af\u00c6\u00d0\u00bd\u00c6\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6\u00a3\u00d6\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00cc\u00b1\u00bb\u00ce\u00be\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00bd\u00c7\u00b6\u00be\u00c6\u00b0\n\n\u00af\u00b5\u00c8\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de\u00af\u00c6\u00d0 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6\u00a3\u00d6\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cc\u00af\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00cc\u00b1\u00bb\u00ce\u00be\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00c1\u00d7\u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00bd\u00c7\u00b6\u00be\u00c6\u00b0\n\n\u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a6) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u201c\u00a4\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00be\u00c6\u00be\u00d7 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6 \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00d0\u00e1\u00cc\u00c1\u00c7\u0081\u00ce\u00bd \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6\u00b0\n\n\u00b9\u00c7\u00af\u00ba\u00c6 I\n\n\u00af\u00b5\u00c8\u00b8\u00c8\u00c1\u00c0\u00c8\u00af\u00c6 \u00d0\u00bd\u00c6\u00bd\u00ba\u00c6\n\n3\u00b0 \u00b6\u00ba\u00af\u00c6\u00af\u00c7\u00af\u00cd\u00c1\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00e0\u00af\u00c6\u00af\u00c7\u00af\u00cd\u00c1\u00c7 -\n\n(\u00a3)\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00b5\u00c8\u00b8\u00c8\u00af\u00c6\u00d0 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4)\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00b5\u00c8\u00b8\u00c8\u008a\u00be\u00c6 \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00b6\u00af\u00c1\u00df\u00af\u00c6\u00d0\"\n\n\u00a3\u00d6\u00af\u00c6\u00af\u00b6\u00c6\u00ce\u00b6 \u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00d0 \u00b6\u00c7\u00ba\u00c6 \u00b1\u00b4\u00c6\u00b4\u00db\u00ce\u00bd\u00bb\u00c7\u00b8 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b6\u00c6\u00ce\u00b6\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00af\u00c6\u00af\u008c\u00be\u00c6\u00ce\u00be \u00a9\u00b8 \u00a3\u00bd\u00c8\u00b7\u00c6\u00b6\u00c8\u00dd\u00b7\u00c6\u00d7\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00c6\u00c1\u00c7\u00de\u00b7\u00ba\u00c6\u00da\u00c1\u00b6\u00bd\u00c6\u00d0\u00af\u00c6 \u00af\u00c7\u00bc\u00b5\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a3\u00d6\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00c8\u00be\u00c6 \u00a7\u00bf\u00af\u00c6\u00af\u00dd\u00b6\u00c6\u00d7\u00b4\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b1\u00bb\u00ce\u00be\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd \u00a4\u00cc\u00bf\u00c1\u00dd\u00ba\u00c6\" \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c6\u00bd\u00c1\u00c7\u00bf\u00c8\u00bb\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00d0\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u0081\u00cd\u00ba\u00be\u00c6 \u00ac\u00dd \u00a5\u00be\u00b4\u00c6\u00b1\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1\u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bc\u00ae\u00d5\u00a4\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00d0 \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00a5\u00dd\u00c1\u00ce\u00af\u008a\u00cc\u00be\u00c7\u00dd\u00c1\u00ce\u00af\u00ba\u00bd\u00c8\u00bb\u00bd\u00c6\u00bd\u00ae\u00b4\u00ce\u00b8\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6\"\u00ba\u00bd\u00c8\u00bb\u00bd\u00c6\u00bd\u00ae\u00b4\u00ce\u00b8 \u00a4\u00af\u00c8\u00bb \u00a5\u00bc\u00ae\u0088\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a4\u00bf\u00c7\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n4\u00b0 \u00b6\u00ba\u00af\u00c6\u00af\u00c7\u00af\u00cd\u00c1\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00e0\u00af\u00c6\u00af\u00c7\u00af\u00cd\u00c1\u00c7 -\n\n(\u00a3)\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00b5\u00c8\u00b8\u00c8\u00af\u00c6\u00d0 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4)\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00b5\u00c8\u00b8\u00c8\u008a\u00be\u00c6 \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00b6\u00af\u00c1\u00df\u00af\u00c6\u00d0\"\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 24 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00b5\u00c8\u00b8\u00c8\u00c1\u00c0\u00c8\u00af\u00c6\u00d0\u00bd\u00c6\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c63\n\n\u00b1\u00b4\u00c6\u00b4\u00db\u00ce\u00bd\u00bb\u00c7\u00b8\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00c8\u0081\u00bd\u00c8\u00af\u00b5\u00c8\u00b8\u00c8 \u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00b9\u00b5\u00c8\u00cc\u00bb\u00c7\u0081\u00de\u00cc\u00b1\u00bb\u00c6\u00bb\u00ce\u00c1\u00b9\u00c6\u00b9\u00d7 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00bd\u00c7\u00b6\u00be\u00c6\u00b0"
