    "chunk_text": "\u00a6\u00a8\u00f9 \u00be\u00e5\u00c4\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00c3\u00e5\u00c7 \u00f3\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0095\u00c6 \u00c6\u00e5\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00ba\u00e6\u00be\u00e0\u00d1\u00c4\u00ef\u00cd\u00e5\u00e0 \u00cc\u00e8\u00c6 \u00c0\u00a8\u00e0\u00cb \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4, \u00be\u00e5\u00c4 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00c3\u00e5\u00c7 \u00f3\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00cc\u00e2\u00a9\u00f1\u00e5\u00c9\u00a8\u00e0 \u0097\u00ef\u00bc\u00e0\u00ca\u00aa\u00ba\u00d1\u00c4 \u00c6\u00be \u00a8\u00c7\u00e6\u00b8\u00ea \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c6\u00ef\u00bb\u00e5\u00e0\u00a8\u00e0\u00ba \u00be\u00e5\u00c4 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00e6\u00bf\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00bc\u00fb \u00c9\u00c6\u00cc \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3\u00ba\u00e8\u00cc\u00e0\u00c0\u00cd\u00b4 \u00a1\u00b6\u00ea \u00c9\u00ec \u00a1\u00ef\u00c0\u00e0\u00a8\u00e0\u00cb\u00a8\u00c6\u00be\u00e0 \u00bc\u00e6\u00be\u00e0 \u00c9\u00c6\u00cc \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ba\u00f8\u00cc\u00e0\u00c0\u00cd \u00a2\u00a8\u00e0\u00c4\u00c9\u00e5 \u00a1\u00e6\u00ba\u00e8\u00ef\u00cd\u00c6\u00fa\u00be\u00e0 \u00a2\u00cd\u00ba \u00a8\u00f9 \u00c4\u00cd \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9, \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5 \u00c0\u00cd \u00cc\u00cd \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u0097\u00cc\u00e8\u00cd\u00ba \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00f5\u00ba\u00f8\u00be\u00e0 \u00be\u00e5\u00c4\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00e6\u00bf\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5\u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00e6\u00c8\u00e6\u00cc\u00e0\u00d1\u00c4 \u00a1\u00c9\u00ca\u00f1 \u00d1 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00c6\u00fa\u00be\u00e0 \u00bc:\n\n\u00c0\u00ec\u00da\u0097\u00a8\u00e5\u00c9.\n\n2007 \u00a1\u00e2\u00a8 55 \u00bc\u00c7\u00be \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00a1\u00e5\u00c6\u00ba\u00be(\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba2\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00c4\u00ef\u00cc\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n1.\u00ef\u008a \u00c0\u00be\u00ba 2007 \u00a1\u00e2\u00a8 55 \u00bc\u00c7\u00be \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00a1\u00e5\u00c6\u00ba\u00be(\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n2.(1) \u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u201d \u00ef\u00c8\u00cc \u00bc\u00a8\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be(262 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec ) \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00a1\u00e5\u00c6\u00ba\u00be \u00af\u00be\u00e0\u00bc \u0097\u00c4\u00cc\u00e9\u008a\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 26 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ce \u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00e6\u00be\u00e0\u00d1\u008a \u00c0\u00f2\u00a8\u00e5\u00c7,\u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00ce\u00e8\u00be\u00e0 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 I \u00c9\u00be, II \u00c9\u00be \u00cc\u00cd III \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c9\u00c8\u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c4\u00cd \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9, \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5 \u00cc\u00cd \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00cc\u00bf\u00cd\u00e5 \u00af\u00be\u00e0\u00bc \u0097\u00c4\u00cc\u00e9\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0, \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 28 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00be\u00e5\u00c4 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00c0\u00ba\u00f2, \u00a8\u00f8\u00cc\u00e8 \u0097\u00ef\u00b4\u00a8\u00ba\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0\u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ea\u00c9\u00e5\u00a8\u00e0 \u00ef\u00c4\u00be\u00e0 \u00c9\u00c8\u00e2\u00aa\u00eb \u00ef\u00be\u00e5\u00c9\u00be \u00cd\u00e5 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00ef\u00be\u00e5\u00c9\u00be \u00ef\u00c8\u00cc\u00bc \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n(2) \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00ce\u00e8\u00be\u00e0 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 I \u00c9\u00be, II \u00c9\u00be \u00cc\u00cd III \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c9\u00c8\u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c4\u00cd \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9, \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5 \u00cc\u00cd \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00cc\u00bf\u00cd\u00e5 \u00af\u00be\u00e0\u00bc \u0097\u00c4\u00cc\u00e9\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0, \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 38 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ce \u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00e6\u00be\u00e0\u00d1\u008a \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00c0\u00f2\u00ba\u00f1\u00e5\u00bc\u00fa\u00cb\u00e0\u00b4\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n(3) \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00ce\u00e8\u00be\u00e0 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 I \u00c9\u00be, II \u00c9\u00be \u00cc\u00cd III \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c9\u00c8\u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c4\u00cd \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9, \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5 \u00cc\u00cd \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c9\u00c8\u00b4\u00ef\u00ba\u00e5\u00e0\u00c7\u00e5 \u00c0\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e0\u00c9\u00e5\u009e\u00be \u00a8\u00b8\u00e0\u00b6\u00e5\u00c6\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00a1\u00ef\u00c0\u00e0\u00a8\u00e0\u00cb\u00a8\u00c6\u00be\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 29 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb, \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 30 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00c0\u00b4\u00cd\u00e6\u00be\u00f8\u00c9 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00a6\u00c6 \u00ef\u00be\u00e5\u00ba\u00a8\u00e5 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 29\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ba\u00c4\u00be\u00e0 \u00ef\u00c9\u00ba \u00be\u00f8\u00a8\u00eb\u00ba\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c8\u00f3\u00c0\u00ba\u00a8\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00ba\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb\u00c9 \u00a8\u00ce \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be\u00bc\u00fa\u00be\u00c6 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00a8\u00e5\u00c8\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00da\u00cb\u00c6\u00a8\u00b4 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00ef\u00bc\u00e5\u00ce\u00cd \u00c2\u00e6\u00aa\u00fa\u00be\u00e0 \u00c9\u00ec\u00ef\u00c0\u00e5\u00ce\u00e8\u00c6\u00a8\u00e0 \u00cc\u00c4\u00aa \u00a6\u00e0 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00e0 \u00c4\u00ea\u00bc\u00c8 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00c9\u00ba \u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u00c9\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
