    "chunk_text": "(2) \u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00d1\u00ef\u008a \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00c9\u00cc\u00be\u00e0 \u00d1\u00c4\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9,\u00a6\u00a8\u00e0 \u00c4\u00e5\u00cc\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba, \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb, \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00ef\u008a\u00a8\u00e5\u00c8\u00c6 \u00ba\u00c9\u00f3\u00c7\u00b4\u00ba\u00e0 \u00bc\u00fb\u00da\u00ab \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6. \u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00c6\u008a \u00a6\u00a8\u00e0 \u00bc\u00fb\u00da\u00ab\u00a8\u00f8\u00d7\u00c4\u00a8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00ef\u008c \u00a6\u00a8\u00ba\u00eb\u00c9, \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00a8\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be\u00c0\u00d6\u00bc\u00fa \u00c9\u00ec \u00a6\u00c4 \u00bc\u00fb\u00da\u00ab \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ef\u00bc\u00a8\u00a8\u00b4 \u00c9\u00b6\u00e5 \u00c9\u00e6\u0091 \u00ef\u00be\u00e5\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce \u00a8\u00c7\u00be \u00c8\u00bc\u00be\u00f8\u00c6\u00c4\u00c6 \u00a1\u00be\u00ea\u00c4\u00ba\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9 \u00ef\u00c9\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00cc\u00cd \u00c9\u00c8\u00e2\u00aa\u00eb\u00d1\u00c4.\n\n2007 \u00a1\u00e2\u00a8 42 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6(\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba9\n\n8.2007 \u00c4\u00e6\u00c6\u00fa \u00c4\u00cc 31 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00d1 \u00ef\u008a \u00c0\u00be\u00ba\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00d1\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00be \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00c8\u00e2\u00aa\u00eb \u00a8\u00f8\u00d7\u00ef\u008a \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00ef\u00bc\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00bc, \u00a6\u00c4 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00bc\u00c6 \u00c9\u00c8\u00e2\u00aa\u00eb \u00ef\u00c8\u00cc \u00a2\u00b4\u00ea \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8\u00c2\u00c9\u00b4 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n9.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6(2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\n\nI \u00ba\u00f9\u00c7\u00e6\u00c9II \u00ba\u00f9\u00c7\u00e6\u00c9\n\n1.\u00a1\u00be\u00ea\u00c2\u00c8 \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c\n\n\u00be\u008a, \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00c7\u00bc\u00a8\u00b4\n\n\u00a1\u00be\u00ea\u00c2\u00c8\u00bc\u00fb\u00c4.\n\n2.\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00c7\u00bc\u00a8\u00b4 \u00a1\u00be\u00ea\u00c2\u00c8\u00bc\u00fb\u00c4\u00ef\u00cd\u00e5\u00e0 \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00eb\u00c4\u00be\u00e0\u00ba\u00f2\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\n\n3.\u0095\u00be\u00f9\u00c4\u00e6\u00c7\u00e6\u00c4\n\n4.\u0095\u00be\u00f9\u00c4\u00e6\u00c7\u00e6\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00a4\u00c0\u00c9\u00e5\u00bc\u00f1 \u00c4\u00be\u00ea\u00cb\u00f1 \u00ab\u00e5\u00ba\u00be\u00c6\n\n5.\u0095\u00be\u00f9\u00c4\u00e6\u00c7\u00e6\u00c4\u00b4 \u00ba\u00e6\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\n\n6.\u0095\u00be\u00f9\u00c4\u00e6\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c0\u00cd\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0\u00c0\u00e6\u00cd\u00e6\u00c7\u00ef\u00aa\u00be \u00c6\u00e5\u00c4\n\n7.\u00a1\u00c6\u00ea\u00ba\u00eb \u00ef\u00c8\u00cc \u00cc\u00e8\u00c7\u00a8\u00c7 \u00ba\u00e6\u009f\u00ef\u008a \u00ef\u0083\u00ba\u00be\u00e5\u00ef\u00c9\u00be\u00e0 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00a1\u00c0\u00cd\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7\u00ef\u00aa\u00be\u00c6\u00e5\u00c4\n\n8.\u00c2\u00c7\u00c0\u00ba\u00c8 \u00ba\u00eb\u00c9\u00e5\u00c8 \u00a8\u00f8\u00d7\u00c4 \u00a1\u00e5\u00bc\u00fa\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00a1\u00c0\u00cd\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7\u00ef\u00aa\u00be\u00c6\u00e5\u00c4\n\n113\u00a1\u00e5 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6\n\n296 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6297 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6\n\n300 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6\n\n355 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6.\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6\n\n356 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6\n\n358 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n102 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6\n\n\u00c9\u00c8\u00e2\u00aa\u00eb \u00a8\u00f8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 42 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6(\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba10\n\n9.\u00a1\u00c0\u00cd\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00cc\u00ad\u00c9\u00e5 \u00ba\u00e6\u009f\u00c4\u00ef\u00cd\u00e5\u00e0 \u00cc\u00e8\u00c7\u00a8\u00c7 \u00ba\u00e6\u009f\u00c4\n\n10.\u00cc\u00e0\u00ba\u00f2\u00e9 \u00f4\u00cb\u00b8\u00c6\n\n11.\u00ef\u00cc\u00e5\u00c7\u00a8\u00c4, \u00c4\u00c7\u00b8\u00c6 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cc\u00ea\u00bc\u00e5\u00be\u008a \u00d1\u00c4 \u00a1\u00e5\u00bc\u00fa\u00c6\n\n12.\u00c4\u00c7\u00b8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00c7\u00c0\u00ba\u00c8 \u00ba\u00eb\u00c9\u00e5\u00c8 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ba\u00e6\u00ba\u00e0\u00a8\u00c7 \u00ef\u00a8\u00e5\u00c8\u00e0\u00c8\u00a8\u00e7\u00c4\n\n13.\u00c4\u00e5\u00c7\u00a8 \u00a1\u00e5\u00c6\u00ea\u00bd\u00c9\u00c8\u00e8\u00be\u00e0 \u00cc\u00be\u00e0\u00be\u00bc\u00e0\u00bd \u00ef\u00a8\u00e5\u00c8\u00e0\u00c8 \u00a8\u00e6\u00c4\u00b4\u00ba\u00e6\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\n\n14.\u00a2\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00e6\u00c7\u00bc\u00fa\u00c9\u00c8\u00e8\u00be\u00e0 \u00c6\u008a \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4\u00ba\u00e6\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4"
