    "chunk_text": "5\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8+\u00c6\u00af\u00bf\" \u00b6\u00ba\u00c8\u00c0\u00c6 \u00a7\u00ce\u00bc\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00ce\u00b4\u00cd\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00bb \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba\u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6\u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf\u00a7\u00ce\u00bc \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 55 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a7\u00bf\u00c6\u00f7\u00bc\u00c6\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00af\u00bf\u00c6 (\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c65\n\n\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 I\n\n\u00ba\u00c7\u00b7\u00af\u00bc \u00b1\u00ce\u00b9\u00af\u00bf\u00c6\n\n\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 II\n\n\u00b7\u00af\u00bc\u00b1\u00ce\u00b9\u00af\u00bf\u00c6\n\n1\u00b0 \u00c1\u00be\u00c6\u00cc\u00c1\u00b4\u00c6\u0088\u00b6\u00c6\u00d7\u00ce\u00bd \u00b7\u00af\u00bc\u00b1\u00ce\u00b9\n\n2\u00b0 \u00b9\u00dd\u00b6\u00c6\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bd \u00b7\u00af\u00bc\u00b1\u00ce\u00b9\n\n3\u00b0 \u00b1\u00c7\u00c1\u00af\u00b1\u00c6\u00cd\u00b1\u00bc\u00c8 \u00b7\u00af\u00bc\u00b1\u00ce\u00b9\n\n4\u00b0 \u00c1\u00e2\u00b8\u00c8\u00bb\u00c7 \u00b7\u00af\u00bc\u00b1\u00ce\u00b9\n\n5\u00b0 \u00ba\u0081\u00b8\u00c7\u00bc\u00c6 \u00b7\u00af\u00bc\u00b1\u00ce\u00b9\n\n\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 III\n\n\u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b9\u00af\u00bf\u00c6\n\n1\u00b0 \u00af\u00c7\u00ce\u00bc\u00b7\u00af\u00bc\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n2\u00b0 \u00a8\u00bc\u00c6\u00af\u00c7\u00c1\u00bd\u00c6\u00de\u00ce\u00bd \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n3\u00b0 \u00cc\u00b7\u00d5\u00b7\u00c6\u00b6\u00c9\u00e2 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n4\u00b0 \u00cd\u00c1\u00ce\u00be\u00ce\u00b5 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n5\u00b0 \u00c1\u008b\u00af\u00c7\u00ba\u00ba\u00c6 (\u00cd\u00ba\u00bd\u00c6\u00d0) \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n6\u00b0 \u00c1\u008b\u00af\u00c7\u00ba\u00ba\u00c6 (\u00c1\u00b4\u00af\u00c6\u00d0) \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n7\u00b0 \u00c1\u008b\u00af\u00c7\u00ba\u00ba\u00c6 (\u00cc\u00b6\u0081\u00cd\u00ba\u00bd\u00c6\u00d0) \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n8\u00b0 \u00c1\u008b\u00af\u00c7\u00ba\u00ba\u00c6 (\u00cc\u00b6\u00bd\u00c6\u00d0) \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n9\u00b0 \u00c1\u008b\u00af\u00c7\u00ba\u00ba\u00c6 (\u00af\u00c8\u00c0\u00af\u00c6\u00d0) \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n10\u00b0 \u00c1\u00b4\u00ba\u00bc\u00c7\u00b4\u00c6\u00b1\u00c8 (\u00cc\u00b6\u0081\u00cd\u00ba\u00bd\u00c6\u00d0) \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n11\u00b0 \u00b9\u00dd\u00b6\u00c6\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bd \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n12\u00b0 \u00b1\u00c7\u00c1\u00af\u00b1\u00c6\u00cd\u00b1\u00bc\u00c8 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n13\u00b0 \u00b7\u00be\u00c6\u00df{\u00bc\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n14\u00b0 \u00b9\u00b1\u00c6\u00b1\u00c8\u00ce\u00be\u00b9\u00c6\u00b9\u00bf\u00c6\u00bf\u00c8 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n15\u00b0 \u00af\u00ce\u00bc\u00b1\u00c6\u00b1\u00c8 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n62007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 55 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a7\u00bf\u00c6\u00f7\u00bc\u00c6\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00af\u00bf\u00c6 (\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n16\u00b0 \u00b9[\u00b7\u00af\u00bc\u00c8 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n17\u00b0 \u00ba\u0081\u00b8\u00c7\u00bc\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n18\u00b0 \u00b7\u00c7\u00b8\u00c7\u00b4\u00c6\u00b4\u00c7\u0081 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n19\u00b0 \u00db\u00b1\u008b \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n20\u00b0 \u00ba\u00c7\u00b7\u00c6\u00ce\u00b6 \u00cd\u00ba\u00bd\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n21\u00b0 \u00c1\u00e2\u00b8\u00c8\u00bb\u00c7 \u00c1\u00b4\u00af\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n22\u00b0 \u00cc\u00c1+\u00c6\u00af\u00be\u00b1\u00c6 \u00cc\u00b1\u00b4\u00c6\u0088\u00af\u00c6\u00d0\u00bf\u00ba\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n23\u00b0 \u00c1\u00e2\u00b8\u00c8\u00bb\u00c7 \u00cc\u00b6\u00bd\u00c6\u00d0 \u00b6\u00ba\u00c8\u00c0\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n24\u00b0 \u00c1\u00e2\u00b8\u00c8\u00bb\u00c7 \u00cc\u00b6\u00bd\u00c6\u00d0 \u00b1\u00c8+\u00c6\u00af\u00bf\u00ba\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n25\u00b0 \u00ba\u00c7\u00b7\u00c6\u00ce\u00b6 \u00af\u00c8\u00c0\u00af\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n26\u00b0 \u00d7\u00d6\u00af\u00c6\u00af\u00c7\u00bb\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n27\u00b0 \u00db\u00c4\u00cb\u00d7\u00b9\u00b4\u00b9\u00bd\u00c6\u00de \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 55 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a7\u00bf\u00c6\u00f7\u00bc\u00c6\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00af\u00bf\u00c6 (\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c67\n\n\u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00b4\u00c6\u00b4\u00f2\u00be+\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00b1\u00b4\u00c6\u00b4+\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00b6\u00ba\u00c8\u00c0\u00c6\u00b9\u00c6 \u0089\u00bc\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00c1\u00dd\u00b4\u00c7\u00b7\u00c6\u00b6\u00b1\u00b7\u00c6\u00b6\u00c7 (\u00a7\u00bf\u00c6\u00b7\u00c7\u00d5) \u00f4\u00b9\u00c7 1\"387 : (\u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00d5) \u00f4\u00b9\u00c7 1\"849 ; \u00ac\u00c1\u00c6\u00cd\u00c1\u00c7\u00bc\u00c7\u00ae\u00d5\u00ba\u00c6 \u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00bc\u00c6\u00ba\u00c7\u00b6\u00ba\u00c6 15 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u0081 \u00a9\u00b6\u00c8\u00bc\u00c6\u00c1\u00dd\u00ba\u00c6 \u00a4\u00ae\u00d5\u00af\u00c6\u00af\u00c7\u00b8 \u00b1\u00b7\u00c6\u00b6\u00c7\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00b4\u00c6\u00b1\u00af\u00bc\u00c6\" \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00b4\u00df\u00c1\u00be\u00af\u00ba\u00c6\" \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00b6\u00af\u00c1\u00be\u00c6 \u00b6\u00c8\u00ce\u00b5\u00af\u00c6\u00af\u00bf\u00ba\u00c6\" \u00a5\u00be\u00b0 163\" \u00af\u00c8\u00dd\u00be\u00b9\u00ce\u00b8 \u00ba\u00c7\u00c1\u00b6\u00c6\u00ce\u00b6\"\u00cc\u00b9\u00c7\u00be\u00c6\u00cd\u00c4\u0081\u00cc\u00af\u00c7\u00ce\u00b4\" \u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da 05 \u00a9\u0081\u00bd \u008c\u00be\u00c7\u00b1\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a3\u00d9\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00b4 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6"
