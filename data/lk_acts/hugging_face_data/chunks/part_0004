    "description": "Cancer Research Foundation of Sri Lanka (Incorporation)",
    "url_metadata": "https://documents.gov.lk/view/acts/acts_2009.html",
    "lang": "en",
    "url_pdf": "https://documents.gov.lk/view/acts/2009/11/67-2009_E.pdf",
