    "chunk_text": "\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081 \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b1\u00b4\u00c6\u00b4\u00ba\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00c7\u00d0\u00af :-\n\n1\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\" 2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 38 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b9\u00af\u00c1\u00c7\u0081 \u00fe \u00b1\u00b6\u00c6\u00bb \u00b1\u00c7\u008a \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u0081\u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b1\u00ce\u00b9 (\u00e7\u00b4\u00c6\u0088 \u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a9\u00b8\u00a9\u00d5\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n\u00d2\u00dd\u00af\u00c6\u00af\u00b9\u00c6 \u00cc\u00b9\u00bb\u00bc\u00c6\u00b0\n\n\u00a5\u00be+\u00c6\u00ce\u00af \u00b9\u00af\u00c1\u00c7\u0081\u00fe \u00b1\u00b6\u00c6\u00bb \u00b1\u00c7\u008a\u00ba\u00b6\u00c6\u00b6\u00c8\u00bb \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u0081\u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00b1\u00ce\u00b9\u00ce\u00bb\u00af\u00c6\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n\u00db\u0081\u00d9\u00ce\u00bc\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 38 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af \u00b9\u00af\u00c1\u00c7\u0081\u00fe \u00b1\u00b6\u00c6\u00bb \u00b1\u00c7\u008a \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u0081 \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b1\u00ce\u00b9 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n2\n\n\u00d7\u00dd\u00c1\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00de\u00ba\u00c6 \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 (\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00b8\u00bc\u00c6\u201c\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00ba\u00c6\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00a5\u00b8\u00c8\u00cd\u00ba\u00be\u00c6\u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00bf\u00c7\u00af\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00e2\u00bf\u00c6\u00bf \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a9\u00ae\u00b5\u00c8\u00af\u00c6\u00ce\u00af\u008a\u00b8\u00bc\u00c7\u00b8 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u201c\u00a5\u00be+\u00c6\u00ce\u00af \u00b9\u00af\u00c1\u00c7\u0081 \u00fe \u00b1\u00b6\u00c6\u00bb \u00b1\u00c7\u008a \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb\u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u0081 \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b1\u00ce\u00b9\u201d \u00a9\u0081\u00bd\u00cc\u00b9\u00bb\u00bc\u00c8\u0081 \u00af\u00c9\u00e1\u00ba\u00c6 \u00ba\u00d0\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00c9\u00e1\u00ba\u00c6 \u00a5\u00ce\u00b4\u00bb\u00bd\u00c7\u00c1\u00c0\u00c8\u00dc\u00bc\u00c8\u00ce\u00ba \u00cc\u00af\u00c7\u00ae\u00b4\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00d0\u00e1\u00cc\u00c1\u00c7\u0081\u00bd\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081\"\u00cc\u00b9\u00c7\u00d7 \u00a5\u00be\u00b1\u00c6\u00b1\u00c8\u00ce\u00b8\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00e2\u00ba\u00c6\" \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00e2\u00ba\u00c6\"\u00a3\u00d7 \u008c\u00dd\u00ba\u00c6\u0089\u00bb\u00c7+\u00c6\u00d0 \u00a3\u00b6\u00ce\u00b8 \u00ba\u00c7\u00bd\u00c6\u00bd\u00e2\u00ba\u00c6 \u00db\u00e1\u00b6\u00c6 \u00b6\u00b6\u00c6\u00d7\u00c1\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6\"\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6 \u00cc\u00af\u00c7\u00ae\u00b4\u00b6\u00c7\u00af\u008c\u00dd\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00cd\u00ba\u00df\u00ba\u00c6\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b9\u00bb\u00bc\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5 \u00a3\u00d7 \u00c1\u00c0\u00af\u00c6\u00d0\u00b6\u00c6 \u00cc\u00b6\u00c7\u00d5\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00a9\u0081\u00b9\u00d7\u00b4\u0081\" \u00a3\u00b6\u00bd\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af \u00c1\u00c0\u00af\u00c6\u00d0\u00b6\u00c6 \u00cc\u00b6\u00c7\u00d5\u00af\u00c6\u00af\u00e2\u00ba\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n3\u00b0 \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00c6 \u00cc\u00b9\u00c7\u00d7\u00af\u00c6 \u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00bf\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b8\u00c1\u00c7\u00af \u00a5\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u00b8 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n(i)\u00b9\u00af\u00c1\u00c7\u0081 \u00fe \u00b1\u00b6\u00c6\u00bb \u00b1\u00c7\u008a \u00b9\u00c7\u00b9\u00c7 \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00cc\u00b1\u00bb\u00c6\u00b6\u00c8\u00ce\u00bb\u00dc\u00ba\u00c6\u00cd\u00b9\u00c7\u00b6\u00ce\u00b8\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cc\u00b6\u00bc\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6 ;\n\n(ii)\u00b9\u00af\u00c1\u00c7\u0081 \u00fe \u00b1\u00b6\u00c6\u00bb \u00b1\u00c7\u008a \u00b9\u00c7\u00b9\u00c7 \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00bd\u00c6\u00bd \u00b1\u00b6\u00c6\u00b6\u00c8\u00bb\u00ba\u00c6 (\u00a7\u00ae\u00ce\u00ba)\" \u00b6\u00dd\u00ba\u00ba\u00c6 (\u00b7\u0081\u00cc\u00b8\u00bd\u00c8)\" \u00b1\u00c7\u00b7\u00c6\u00b6\u00c8(\u00b1\u00ba\u00c7\u00b6\u00c7\u00b8\u00ba\u00c6)\" \u0089\u00cd\u00bc\u00ce\u00ba (\u00a3\u0081\u00da) \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00c4\u00c8\u00ba\u00c6\u00ce\u00b1(\u00b1\u00c7\u00b6\u00c6\u0096\u00af\u00ba\u00c6) \u00a4\u00af\u00c8\u00bb \u00a3\u0088\u00b9\u00c6\u00b9\u00ce\u00b4\u00af\u00c6 \u00cd\u00af\u00c7\u00b4\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf\u00af\u00c6\u00af\u00ce\u00b4\u00b9\u00c6\u0089\u0088\u00b9\u00c6\u00b9\u00b6\u0081 \u00f2\u00be\u00ba\u00c7\u00af\u00e2\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a9\u00d5\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b4\u00c6\u00d5\u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af \u00db\u00ce\u00bd\u008a\u0081 \u00f2\u00be\u00ba\u00c7\u00af\u00e2\u00ba\u00c6 \u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 ;\n\n(iii)\u00cd\u00c1\u00b6+\u00c6\u00af\u00bf\u00c6\" \u00a7\u00b9\u00b7\u00c8\u00b4\u00b6+\u00c6\u00af\u00bf\u00c6\" \u00b1\u00c7\u00b6\u00c6\u00b6\u00c8\u00bc+\u00c6\u00af\u00bf\u00c6\" \u00da\u00bc\u00c7\u00b5+\u00c6\u00af\u00bf\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b1\u00b8\u00c7\u00b6\u00b8 \u00b6\u00dd\u00ba\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00c1\u00de \u00a5\u00be\u00af\u00c6\u00af\u00c8\u00bb+\u00c6\u00af\u00bf\u00c6\u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00a3\u00bd\u00c8\u008c\u00ce\u00b8 \u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 ;\n\n(iv)\u00a7\u00be\u00af\u00c8\u00be\u00c6 \u00b7\u00c8\u00be\u00e2\u00ba\u00c6 \u0089\u00bc\u00b6\u00c7\u00b8 \u00ba\u00b6+\u00c6\u00af\u00bf\u00c6 \u00a3\u00ce\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7\u00ba\u00c6\u00a7\u0081\u00b8\u00b6\" \u008c\u00e1\u00ba\u00c8\u00bb \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00b6\u00c8\u00dc\u00bb\u00bc\u00c6 \u00ac\u00e1\u00af\u00c6\u00af\u00cc\u00b7\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00b4\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a9\u00be\u00c6\u00be\u00c7 \u00ba\u00b6+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6\u00a7\u00ae\u00ce\u00ba\u00bb\u00c7\u00b8 \u00a3\u0088\u00b9\u00c6\u00b9\u00ce\u00b4\u00bb\u00c7\u00af\u00e2\u00bf\u00c6\u00bf \u00a4\u0081\u00ba\u00c9\u00af \u00a5\u00bb\u00be\u00c6\u0089\u00b8\u00d7\u00ba\u00c6 \u00a4\u00bb\u00c6\u008c\u00ce\u00b8 \u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 ;\n\n(v)\u00ba\u00b6+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00ce\u00b4\u008a\u00be\u00c6 \u00ac\u00b6\u00c6\u00b6\u00c8\u00ce\u00b1\u00ce\u00c1 \u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 ;\n\n\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00cc\u00b9\u00c7\u00d7\u00af\u00c6\u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00bf\u00c6\u00b0\n\n32007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 38 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af \u00b9\u00af\u00c1\u00c7\u0081\u00fe \u00b1\u00b6\u00c6\u00bb \u00b1\u00c7\u008a \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u0081 \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b1\u00ce\u00b9 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6"
  },
