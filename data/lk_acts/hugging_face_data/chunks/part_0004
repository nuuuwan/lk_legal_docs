u00d7\u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00bc\u00c8\u00cd\u00b1\u00c7\u00b6\u00ce\u00b8\u00af\u00ce\u00bf\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00be\u00c7\u00ba\u00c6\u00b0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00d0 \u00a3\u00c1\u00b1\u00c8\u00bb\u00cc\u00ba\u00b8 \u00a3\u00c1\u00bc\u00c6 \u00af\u00dd\u00d7\u00af\u00c8\u0081\u00bd\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a7\u00b6\u008c\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00ce\u00bf \u00a3\u00c1\u00bc\u00c6 \u00b6\u00ba\u00c6\u00db\u00b4\u0081 \u00cc\u00af\u00c7\u00ae\u00d5\u00c1\u00bc\u00be\u00c7\u00ba\u00c6\u00b0\n\n(3) \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\" \u00cd\u00b6\u00a3\u00a3\u00af \u00b1\u00ce\u00b9\u00af\u00c6\u00d0\u00af\u00c6 \u00af\u00c7\u00be\u00c7\u00af\u00c7\u00be \u00a3\u00bd\u00c8\u00af\u00c6\u00ce\u00af\u00af\u00ce\u00bf\u00b1\u00c6 \u00b1\u00ba\u00bc\u00c6\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081\" \u00a3\u00ce\u00c1 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00b7\u00c8\u00ce\u00be\u00bb+\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00b1\u00c8\u00af\u00c8\u00b1\u00c6\u00ce\u00b1\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00a9\u00ae\u00b5\u00c8\u00af\u00c6\u00ce\u00af\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\u00b1\u00c6 \u00b1\u00c8\u00af\u00c8\u00b1\u00c6\u00ce\u00b1\u00bb\u00bf\u00c8\u00b6\u00c6\u00b6\u00be\u00c6 \u00b7\u00c8\u00ce\u00be\u00bb+\u00c6\u00af\u00bf\u00c8\u0081 \u00b9\u00b5\u00c8\u00b9\u00bd\u00c6\u00bd\u00c8\u00dc\u00ba\u00c6\"\u00a3\u00e2\u00b4\u00b6+\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00b6+\u00c6\u00af\u00c8\u00dc\u00bf\u00c6\u00bf \u00a4\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00b1\u00c8\u00af\u00c8\u00b1\u00c6\u00ce\u00b1\u00dc\u00ba\u00c6 \u00da\u00b8\u00bc\u00c6\u00c1\u00c7\u00c0\u00c6\u00e2\u00c1\u00b1\u00b6\u00c8\u00af\u00e0\u00ba\u00c6 \u00c1\u00c0+\u00c6\u00d0\u00c1\u00b6\u00c8\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b7\u00c8\u00ce\u00be\u00bb+\u00c6\u00af\u00bf\u00c8\u0081 \u00b9\u00bb\u00d9\u00ce\u00b4\u00ce\u00ba \u00b9\u00bd\u00c6\u00bd\u00c8\u00dc\u00ba\u00c7\u00b8 \u00b6\u00af\u00c1\u00ce\u00be\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n5\u00b0 \u00cd\u00b6\u00a3\u00a3\u00af\u00b1 \u00a4\u00b8\u00d7\" \u00b1\u00c8\u00af\u00c8\u00b1\u00c6\u00ce\u00b1\u00bb\u00bf\u00c8\u00b6\u00c6\u00b6\u00be\u00c6 \u00b7\u00c8\u00ce\u00be\u00bb+\u00c6\u00af\u00bf\u00c8\u0081\u00b6\u00c8\u00bd\u00ce\u00ba\u00bb\u00c7\u00b8 \u00db\u00af\u00c7\u00ce\u00ba\u00ce\u00bb \u00a7\u00de\u00b6\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00b8\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b9\u00c7\u00d7\u00c1\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u008c\u00cd\u00b1\u00b4\u00ba\u00c7\u00b8 \u00b9\u00b5\u00c8\u00b9\u00c6\u00da\u00af\u00ce\u00bf\u00af\u00c6 \u00af\u00c7\u00be\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00af\u00c6\u00af\u00c7\u00be\u00ba\u00c6 \u008c\u00d5\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00b5\u00c8\u00b9\u00c6\u00da\u00af\u00e0\u00af\u00c6\u00d0 \u00a5\u00b5+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u00e1\u00d0\u00b6\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b7\u00c8\u00ce\u00be\u00bb+\u00c6\u00af\u00bf\u00c8\u0081 \u00af\u00b4\u00ce\u00ba\u00bb\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0"
