    "chunk_text": "\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00c4\u00ef\u00cc\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2013\n\n1.\u00ef\u008a \u00c0\u00be\u00ba 2007 \u00a1\u00e2\u00a8 52 \u00bc\u00c7\u00be \u00c4\u00cd\u00be\u00ea\u00c9\u00c7 \u00a1\u00cc\u00e0\u00aa\u00fa\u00d6\u00ef\u00c6\u00e0 \u00c0\u00c8\u00e8\u00c0\u00e5\u00be\u00ca\u00f2\u00e9 \u00ae\u00be\u00e0\u00bc\u00e5\u00be\u00be\u00e0\u00bc \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd \u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cd\u00e5 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00c6(\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a) \u00c0\u00be\u00ba \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n\u00c4\u00cd\u00be\u00ea\u00c9\u00c7 \u00a1\u00cc\u00e0\u00aa\u00fa\u00d6\u00ef\u00c6\u00e0\u00c0\u00c8\u00e8\u00c0\u00e5\u00be \u00ca\u00f2\u00e9\u00ae\u00be\u00e0\u00bc\u00e5\u00be\u00be\u00e0\u00bc\u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd\u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cd\u00e5\u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4.\n\n22007 \u00a1\u00e2\u00a8 52 \u00bc\u00c7\u00be \u00c4\u00cd\u00be\u00ea\u00c9\u00c7 \u00a1\u00cc\u00e0\u00aa\u00fa\u00d6\u00ef\u00c6\u00e0 \u00c0\u00c8\u00e8\u00c0\u00e5\u00be \u00ca\u00f2\u00e9 \u00ae\u00be\u00e0\u00bc\u00e5\u00be\u00be\u00e0\u00bc \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd \u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cd\u00e5\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00c6 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a) \u00c0\u00be\u00ba\n\n\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00ef\u00c0\u00e5\u00f3\u00c0\u00c7\u00c4\u00e5\u00da\u00bb.3.\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00ef\u00c0\u00e5\u00f3 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00cc\u00bf\u00cd\u00e5 \u00bc, \u00a6\u00e0\u00ef\u00c0\u00e5\u00f3 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00c0\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00d6\u00bc\u00fa \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6\u00c6\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00ef\u0089 :\u2014\n\n(\u00a1) \u00c4\u00cd\u00be\u00ea\u00c9\u00c7 \u00a1\u00cc\u00e0\u00aa\u00fa\u00d6 \u00c4\u00cd\u00e5 \u0097\u00cd\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c0\u00e8\u00cd\u00fa\u0090 \u00c0\u00ea\u00cc\u00e0\u00ba\u00a8\u00e5\u00c8\u00c6 \u00cc\u00cd\u00ef\u00bc\u00c4\u00cd\u00c8\u00e0 \u00bd\u00da\u00c4 \u00c4\u00be\u00e0\u00bc\u00fa\u00c7\u00c6 \u00cd\u00e5 \u00a6\u00c6 \u00c0\u00e8\u00cd\u00fa\u0090 \u00a2\u00b6\u00c4 \u00cd\u00e5 \u00a3\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ae\u00e2\u00ae\u00c8 \u00cd\u00e5 \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00c8 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4, \u00be\u00b6\u00ba\u00e0\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5\u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a1\u00e5) \u00ef\u00c0\u00c7 \u00bc\u00fb, \u00c0\u00c8\u00e8\u00c0\u00e5\u00be \u00ca\u00f2\u00e9 \u00ae\u00be\u00e0\u00bc\u00e5\u00be\u00be\u00e0\u00bc \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd\u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00c4\u00bd\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00b4 \u00a1\u00c6\u00ba\u00e0\u00c9 \u00ba\u00f8\u00c2\u00ec \u00cc\u00cd \u00c9\u00da\u00ba\u00c4\u00e5\u00be\u00ef\u00c6\u00e0,\u00c4\u00cd\u00be\u00ea\u00c9\u00c7 \u00a1\u00cc\u00e0\u00aa\u00fa\u00d6\u00c6 \u00c0\u00c8\u00e8\u00c0\u00e5\u00be \u00ca\u00f2\u00e9 \u00ae\u00be\u00e0\u00bc\u00e5\u00be\u00be\u00e0\u00bc \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd\u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cd\u00e5 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00c6 \u00ef\u00c9\u00ba \u00c0\u00c9\u00c7\u00e5 \u00ba\u00f8\u00ef\u00c2\u00be\u00cc\u00e8\u00c6\u00f5\u00c4 \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00cc\u00cd \u00ae\u00e2\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4, \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6\u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4;\n\n(\u00a1\u00e6) \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd \u00bc\u00da\u00ca\u00be\u00c6 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00cc\u00cd \u0097\u00ef\u00bc\u00e0\u00ca\u00c6\u00be\u00e0\u00cd\u00fa \u00c9\u00f1\u00e5\u00c0\u00e0\u00ba \u00a8\u00f8\u00d7\u00c4\u00cc\u00bf\u00cd\u00e5 \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd \u00c3\u00fa\u00a8\u00e0\u00cb\u00ec\u00be\u00e0 \u00c9\u00cd\u00be\u00e0\u00ef\u00cc\u00e0\u00c8\u00e5 \u00cc\u00cd \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd\u00c6\u00fa\u00be\u00e0 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00a8\u00f8\u00d7\u00c4 ; \u00cc\u00cd\n\n(\u00a1\u00e7) \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd \u00bc\u00da\u00ca\u00be\u00c6 \u00cd\u00e5 \u00a3\u00b4 \u00a1\u00be\u00ea\u00c2\u00bc\u00e0\u00bd \u0097\u00cb\u00c6\u00c6\u00be\u00e0 \u00cd\u00e6\u00bc\u00e7\u00d7\u00c4\u00b4 \u00cd\u00e5\u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd\u00c6\u00fa\u00be\u00e0 \u00bc\u00fa\u00d6\u00c4\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd\u00a7\u00c9\u00ea\u00be\u00b4 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00bc\u00fb\u00c4.\n\n4.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c8\u00e8\u008d\u00ba \u00be\u00f9\u00ba\u00f8\u00c6\u00a8 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4\u00c6\u00b4\u00ba\u00e0\u00c9 \u00c2\u00e6\u00e2\u00a8\u00eb \u00aa\u00fa\u00b8\u00ea\u008a \u0097\u00c9\u00ee\u00ba \u00a8\u00f8\u00d7\u00ef\u008a, \u00c9\u00e6\u00cc\u00e9\u00ef\u008a \u00bc, \u00a1\u00e6\u00c0 \u00a1\u00e6\u00ba\u00f8\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00be\u00e6\u00ba\u00f8\u00c9\u00c4\u00ea\u00bc\u00c8\u00e0 \u00b8\u00c6\u00b4 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00bc \u00a6\u00cd\u00fa \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00a8\u00f8\u00d7\u00ef\u008a \u00cd\u00e5 \u0097\u00c6\u00bc\u008a \u00a8\u00f8\u00d7\u00ef\u008a\u00bc, \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00be\u00e0 \u00cd\u00e5 \u00c0\u00d6\u00ba\u00f1\u00e5\u00aa\u00c6\u00be\u00e0 \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a\u00cd\u00e5 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u008a\u00bc \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00a2\u00b4\u00ea \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5\u00a1\u00c9\u00ca\u00f1 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0 \u00cd\u00e5 \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00e0 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba \u00a8\u00c7\u00d1\u00ef\u008a, \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00e0\u00ef\u00c6\u00bc\u00d1\u00ef\u008a \u00cc\u00cd \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u00c0\u00cd \u00a8\u00f8\u00d7\u00ef\u008a \u00bc \u00c2\u00c8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00c0\u00c7\u00c4\u00e5\u00da\u00bb\u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00a1\u00ba\u00eb\u00d6\u00be\u00e0 \u00c6\u008a \u00c0\u00c7\u00c4\u00e5\u00da\u00bb\u00c6\u00a8\u00e0 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0\u00be\u00e2\u00c9\u00e5\u00c8\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c9\u00ca\u00f1 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c6\u00e5\u00e0\u00aa\u00f1 \u00a8\u00c9\u00c7 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e8\u00c6\u00f5 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00f8\u00d7\u00ef\u008a, \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00ef\u008a \u00cd\u00e5 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ef\u008c \u00ef\u00c6\u00bc\u00d1\u00ef\u008a \u00c2\u00c8\u00c6 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00b4 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6.\n\n5.(1) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u008a\u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00cc\u00cd 6 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00c2\u00be\u00d7\u00ba\u00f8\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6\u00a8\u00f8\u00d7\u00c4.\n\n\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u00c2\u00c8\u00ba\u00c8."
