    "chunk_text": "\u201c\u00a8\u0095\u00b4\u00ea\u00c9\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00e0, \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 10 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u0095\u00b4\u00ea\u00c9 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00a8\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c4\u00bd\u00f1\u00c4 \u00b0\u00e5\u00c8\u00c6 \u00ba\u00eb\u00ce \u00c9\u00ec \u00be\u00e6\u00c9\u00ba \u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c4 \u00cc\u00bf\u00cd\u00e5\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 18 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1)\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00be\u00e0\u00ba\u00a8\u00eb\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00a8\u00e5\u00da\u00c6\u00a8\u00e0\u00cb\u00c4\u00ba\u00e5 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c6\u008a\u00ef\u00cc\u00e0\u00c9\u00c6\u00a8 \u00ba\u00ba\u00e0\u00c9\u00c6\u00b4 \u00c2\u00c8\u00c0\u00e7\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00a6\u00c4 \u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba\u00ef\u00cc\u00e0\u00c9\u00e5\u00c9 \u00c8\u00c2\u00e5\u00bc\u00fb\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00e6\u00ba\u00e0\u00ba\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a1\u00c9\u00ca\u00f1 \u00c9\u00ec \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00c0\u00d6\u00ef\u00c3\u00e5\u00e0\u00b0\u00be\u00c6 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00c6\u00ba\u00e0\u00ba \u00bc\u00e6\u00d7\u00c4, \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00cd\u00d6\u00ba \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00cc\u00cd\u00be\u00bc\u00e5\u00c6\u00e8 \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u00c4\u00ba \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8\u00ef\u00cd\u00e5\u00e0 \u00cd\u00e6\u00a8\u00f8 \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec, \u00c0\u00ee\u00bb\u0097\u00ef\u00c6\u00e0 \u00c0\u00d6\u00cc\u00c7\u00c6 \u00cc\u00cd \u00c0\u00d6\u00cc\u00c7\u0097\u00bc\u00f1\u00e5\u00c9 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00aa\u00be\u00ea \u00c8\u00c2\u00be \u00a8\u00f2\u00e8\u00c6\u00e5 \u00c4\u00e5\u00da\u00aa \u00cc\u00bf\u00cd\u00e5\u00c8\u00c2\u00e5\u00ef\u00bc\u00be \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00b0\u00c8\u0097\u00f3\u00c8\u00e8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c0\u00f2\u00ba\u00f8\u00a8\u00f2\u00e8\u00c6\u00e5 \u00cc\u00cd \u00b0\u00c9\u00be\u00e9\u00c6 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00c8\u00e8\u00cd\u00c7\u00cd\u00e5 \u00aa\u00c4\u00be\u00e0 \u00a8\u00c7\u00be \u00b0\u00c8 \u00bd\u00e5\u00c7\u00e5\u00c9\u00a8\u00f8\u00be\u00e0 \u00b0\u00be\u00be\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8\u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00c6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00c4\u00bd\u00f1\u00c4 \u00b0\u00e5\u00c8\u00ef\u00c6\u00be\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00c9\u00ec \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0,\u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c0\u00d6\u00ef\u00c3\u00e5\u00e0\u00b0\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a6\u00a8\u00e0\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec \u00be\u00e6\u00c9\u00ba \u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00c6\u00a8\u00b4 \u00c0\u00d6\u00c9\u00da\u00ba\u00be\u00c6 \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00c6\u008a\n\n\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n2007 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00be\u00f8\u00ba\u00f1 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba52\n\n\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8 \u00cc\u00e8\u00f3\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e5\u00c8\u00c2\u00be\u00e0\u00be\u00e5\u00c9\u00ec \u00bc \u00be\u00f8\u00c4\u00e5\u00c9\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00c4\u00bd\u00f1\u00c4 \u00b0\u00e5\u00c8\u00ef\u00c6\u00be\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00c9\u00ec \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00c0\u00e5\u00d6\u00ef\u00c3\u00e5\u00e0\u00aa\u00fa\u00a8 \u00cc\u0095\u00ba\u00f8\u00c6\u201d\u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00b0\u00e5\u00ba\u00f8\u00a8 \u0097\u00f3\u00c8\u00e8\u00c2\u00c8 \u00cc\u00e6\u00c0\u00c6\u00ea\u00c4\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00a8\u00c7\u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00c9\u00ec \u00bc, \u00ef\u00c2\u00bc\u00e5 \u00cd\u00e6\u00d7\u00ef\u008a \u00b0\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cd\u00c7\u00cd\u00e5 \u00ba\u00c4\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00b4 \u0097\u00f3\u00c8\u00e8\u00c2\u00c8\u00c6 \u00b0\u00be\u00be\u00c6 \u00a8\u00c7 \u00ef\u00c2\u00bc\u00e5\u00cd\u00e6\u00d7\u00ef\u008a \u00a1\u00c7\u00c4\u00ea\u00b8\u00e8\u00be\u00e0\u00c6\u008a \u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba \u00c3\u00ed\u00ef\u00aa\u00e5\u00e0\u00c8\u00e9\u00c6 \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00be\u00e6\u00c9\u00ba \u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00be\u00f8\u00c0\u00bc\u00d1\u00c4 \u00cc\u00cd \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5,\u00a1\u00bc\u00e5\u00ce \u00c0\u00ce\u00e5\u00ba\u00e0 \u00cc\u00c3\u00e5\u00c9 \u00ef\u00c9\u00ba \u00c6\u00bb\u00e5 \u00c0\u00d6\u00bc\u00fa \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00c9\u00ec \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00c3\u00e5\u0097\u00ba \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00f2\u00b0\u00e5\u00c9\u00a8\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7\u00be \u00c6\u008a \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00c4\u00bd\u00f1\u00c4 \u00b0\u00e5\u00c8\u00c6 \u00ba\u00eb\u00ce \u00c9\u00ec \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c6\u008a \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00be\u00e6\u00c9\u00ba \u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00e8\u00c6\u00a8\u00e0 \u0097\u00f3\u00c8\u00e8\u00c2\u00c8\u00c6 \u00c2\u00c9\u00b4\u00c0\u00d6\u00c9\u00da\u00ba\u00be\u00c6 \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00a6\u00ef\u00cc\u00e0 \u00b0\u00be\u00be\u00c6 \u00a8\u00ce \u0097\u00f3\u00c8\u00e8\u00c2\u00c8\u00c6 \u00c8\u00e2\u00a8\u00e5\u0097\u00f3\u00c8\u00e8\u00c2\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u0097\u00f3\u00c8\u00e8\u00c2\u00c8\u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c6\u00b4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be \u00cc\u00cd \u00c6\u008a \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f8\u00c4\u00e5\u00c9\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00c2\u00c8\u00c0\u00ba\u00f2 \u00bc\u00c7\u00be\u00e0\u00be\u00e5\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 , \u00c4\u00bd\u00f1\u00c4 \u00b0\u00e5\u00c8\u00ef\u00c6\u00be\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00c9\u00ec \u00be\u00e6\u00c9\u00ba\u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8 \u00be\u00f8\u00c6\u00e6\u00c8\u00e9 \u00cc\u00e8\u009b\u00c4 \u00cc\u00bf\u00cd\u00e5\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 25 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d9\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;"
