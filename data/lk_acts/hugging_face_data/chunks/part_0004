    "chunk_text": "(2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00ac\u00bd\u00c6\u00cd\u00bd\u00c7\u00b9\u00bc\u00c6 \u00ba\u00c7\u00b6\u00ba\u00c6 09 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7)\n\n\u00a3\u00bc\u00b1\u00c8\u00b8\u00bc\u00c6 \u00a4\u00ce\u00b5\u00b9\u00c6\u00b9\u0088 \u00a3\u00b1\u00c6\u00b1\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\n\n\u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00a3\u00b1\u00c6\u00d2\u00b6\u00c6 \u00b6\u00c8\u00ce\u00b5\u00af\u00c6\u00af\u00bf\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00b9\u00b6\u00c8\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00bd\u00c6\u00bd\u00d7\u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da 5\" \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00b4\u00df\u00c1\u00be\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00be\u00c7\u00ba\u00c6\n\n\u008c\u00ce\u00be : \u00f4\u00b9\u00c7 14\u00b000\u00b6\u00b9\u00c7\u00bd\u00c6 \u00cc\u00b1\u00be\u00e2 : \u00f4\u00b9\u00c7 5\u00b000\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081\u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00ba\u00c6\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u00b8\u00c6 42 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00d0\u00bd\u00c6\u00bd\u008c\u00bb\u00be\u00c6\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00db\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1 (\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6)\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n2007\" \u00ac\u00bd\u00c6\u00cd\u00bd\u00c7\u00b9\u00bc\u00c6 \u00ba\u00c7\u00b6\u00ba\u00c6 12 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb \u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081\u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00b9\u00c6 \u00b9\u00b6\u00c6\u00b6\u00c8\u00bc\u00c8\u00ce\u00af\u008a\u0081 II \u00a4\u00ba\u00c6 \u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00b7\u00c8\u00bc\u00b9\u00c6\u0089\u00bb\u00c7\u00af \u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 42 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00d0\u00bd\u00c6\u00bd\u008c\u00bb\u00be\u00c6\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00db\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1(\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n1\n\n2 \u2013PL 002281 \u2013 1,200 (2007/07)\n\n\u00ce\u00af\u00d7\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a4\u00ce\u00bf\u00b6\u00c6\u00b6\u00d5\u00b6\u00c6\u00d7\u00ce\u00c1\u00af\u00c6\u00d0\u00ba\u00c6\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00d0\u00bd\u00c8\u00b6\u00c6\u00b6\u00b1\u00c8\u00be\u008c\u00b4\u00bb+\u00c6\u00af\u00bf\u00c8\u00be\u00c6\u00a5\u00dd\u00b9\u00b6\u00c6\u00d7\u00b7\u00c7\u0081\u00d0\u00ba\u00b5\u00c8\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00be+\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7\u00b7\u00c7\u00bd\u00c6\u00b9\u00b6\u00c6\u00cc\u00b6\u00b4\u00c6\u00d5\u00ba\u00b5\u00c8\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00be+\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00d5\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n\u00d2\u00dd\u00af\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00bb\u00bc\u00c6\u00b0\n\n[2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00ac\u00bd\u00c6\u00cd\u00bd\u00c7\u00b9\u00bc\u00c6 \u00ba\u00c7\u00b6\u00ba\u00c6 09 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00b0]\n\n\u00b1\u00b0\u00c1\u00b0\u00ad\u00b0 16 /2007\n\n\u00da\u00be\u00b8\u00c7\u00bb\u00c6\u00e2\u00af\u00ce\u00bf \u00b7\u00b4\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0 \u00c1\u00b1\u00b6\u00c8\u00bb\u00bf\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00af\u0089\u0088\u00bb\u00c7\u00ce\u00b5\u008a\u0081\u00bd\u00c8\u00af\u00c6 \u00ce\u00af\u00d7\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00b6\u00d5\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00ce\u00bb \u00b7\u00c9\u0088\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6\" \u00d0\u00bd\u00c8\u00b6\u00c6\u00b6\u00b1\u00c8\u00be \u00c1\u00c0\u00af\u00c6\u00d0\u00af\u00bf\u00c8\u00be\u00c6 \u00d2\u00dd\u00af\u00c6\u00af\u00db\u00ce\u00bd\u00bb\u00bd\u00c6\u00bd \u008c\u00b1\u00c7\u00bc\u00ce\u00b5\u00ce\u00bb \u00b7\u00b4\u00b6\u00c6\u00d7\u00c1\u00b6\u00ce\u00b8\u00b6\u00c6 \u00b6\u008c\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6\" \u00c1\u00c0\u00af\u00c6\u00d0\u00b6\u00c6\u00cc\u00b6\u00c7\u00d5\u00b7\u00dd\u00af\u00c6\u00af\u00c7\u00b8 \u00b1\u00c7\u00b4\u00c6\u00b1\u00c8\u00af\u00c6\u00af\u00c7\u00bc\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00b1\u00b6\u00c6\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u0081\u00ba\u00c9\u00b6\u00c7\u00b8 \u00c1\u00c7\u00af\u00c6\u00d0\u00f2\u00be\u00b6\u00c6\u00ce\u00b6 \u00a9\u00d5\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u00cd\u00b8\u00c7\u00d5 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b9\u00b4\u00c6\u00b4\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00a5\u00ce\u00b4\u00cd\u00b7\u00bc\u00c6\u008c\u00ce\u00bf\u00c1\u00c7\u00b8 \u00af\u00dd\u00ba+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c7\u00b8\u00cc\u00b6\u00c7\u00dd \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081 \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b1\u00b4\u00c6\u00b4\u00ba\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00c7\u00d0\u00af :-\n\n1\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 42 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00d0\u00bd\u00c6\u00bd\u008c\u00bb\u00be\u00c6\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00db\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1 (\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\u00a9\u00b8 \u00a9\u00d5\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n2\u00b0 \u00a4\u008a\u00bc\u00b6\u00c6\u00d7\u00b6\u00c6 \u00cc\u00b6\u00c7\u00bf\u00c7\u008a\u00bc\u00b6\u00c6\u00d7 \u00a9\u00e1\u00b6\u00c6\u00cc\u00b6\u00c7\u0081\u00b9\u00b6\u00c7\u00ba\u00c6 \u00a4\u00ae\u0088\u008115 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00d0\u00bd\u00c6\u00bd\u008c\u00bb\u00be\u00c6 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00db\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 43(\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf\u00b6\u00c6 \u00b6\u008c\u00bc\"\u00a3\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00b4+\u00c6\u00af\u00c8\u00dc\u00bf\u00c6\u00bf \u00a9\u00d7 \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c8\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6\" \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6\u00b1\u00ba\u00c7\u00b6\u00c7\u00b8 \u00a3\u00df\u00c1\u00be\u00bc\u00c6\" \u0089\u0088\u00bb\u00c7\u00ce\u00b5\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00be\u00c6\u00be\u00c7\u00ba\u00be\u00c6 \u00ce\u00af\u00d7\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00ce\u00bc \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u0081 \u00a9\u00be\u00c6\u00be\u00c7\u00b1\u00c6 \u00e9\u00c0\u00c6\u00b7\u00c8\u00ce\u00be\u00af\u00bf\u00c8\u0081\u00af\u00c9\u00e1\u00ba\u00c6 \u00b7\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8\u00ce\u00b6\u008c\u00b4 \u00b7\u00c9\u00ae\u00b4\u00cc\u00c1\u00c7\u00dd \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00af\u00b4\u00c6\u00d5\u00af\u00c6\u00af\u00c7\u00c1\u008b\u00be\u00c6 \u00b6\u00d5\u00b6\u00c6\u00d7\u00ce\u00c1\u00b6\u00c6\u00b6\u00cd\u00be\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de\u00c1\u00ce\u00af\u008a\u00be\u00c6\u00ba\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00c1\u00b6\u00c6\u00b6\u00cd\u00be\u00c7 \u00a4\u00af\u00c7\u00d7 \u00a9\u0081\u00b9\u00d7\u00b4\u0081\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00bb\u00c7\u00b8\u00d7 \u00ce\u00af\u00d7\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00b4\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00b7\u00c9\u00b6\u00c8\u00c1\u00c7\u0081 \u00db\u0081\u00b8\u00c8\u00ce\u00be\u00af\u00c6\u00d0 \u0089\u00bc\u00bb\u00c7\u00b5\u00ba\u00c6\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00b8 \u00cd\u00b7\u00bc\u00ba\u00c6 \u00b7\u00c9+\u00c6\u00af\u00be\u00c7\u00af\u00a5\u00dd\u00b9\u00b6\u00c6\u00d7 \u00b7\u00c7\u0081\u00d0 \u00ba\u00b5\u00c8\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00be+\u00c6\u00af\u00ce\u00bf \u008c\u00b3\u00c6\u00d2\u00b6\u00be\u00c7\u00af\u00c7\u00d7 :"
