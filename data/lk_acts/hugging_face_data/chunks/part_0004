    "chunk_text": "(ii) \u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u201c\u00a6\u00ef\u00cc\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00bc\u00fb \u201d\u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b8\u00c6\u00c9\u00c7 \u00c8\u00e8\u00c0\u00e8\u00c6\u00a8\u00e0 \u0097\u00c9\u00ee\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00ef\u00cc\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6\u00a8\u00c7\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00bc\u00fb \u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n2006 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba2\n\n(3)\u00be\u00e6\u00c9\u00ba \u00a1\u00e2\u00a8 \u00ef\u00c6\u00f4 (\u00a1\u00e5)(i) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00ef\u00d8\u00bc\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n(iii) \u00ef\u008a \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (i) \u00c9\u00be \u00cc\u00cd (ii) \u00c9\u00be \u00a4\u00c0\u00ef\u00d8\u00bc\u00c9\u00c8 \u00a8\u00e5\u00da\u00c6\u00cc\u00bf\u00cd\u00e5, \u201c\u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00d1\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00bc\u00fa\u00be\u00c6\u201d\u00c6\u00be \u00ef\u00c6\u00f3\u00ef\u00c4\u00be\u00e0 2007 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be)\u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be \u00bc\u00fa\u00be\u00c6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n(4)\u00ef\u008a \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00c6 \u00a1\u00c9\u00cc\u00e5\u00be\u00c6\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(3) \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00c0\u00cd\u00a8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00aa\u00b8\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00a6\u00a8\u00e0\u00c9\u00c7\u00a8\u00e0\u00aa\u00b8\u00be\u00e0 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00a2\u00be\u00e0\u00c0\u00cc\u00ea\u00c9 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3\u00c0\u00cd\u00a8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00aa\u00b8\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00ef\u00be\u00e5\u00aa\u00ba\u00c6\u00ea\u00ba\u00eb \u00c6.\u201d.\n\n2007 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba3\n\n3.\u00ef\u008a \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) (i) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00ef\u008a \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6,\u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 2006 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 31 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00ec\u00c2\u00c9\u00b4 \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n2005 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 III \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\n\n4.2005 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 III \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc (\u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a\u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00c2\u00bc\u00e0\u00bc) \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u00a6\u00c4 \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 14 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c(\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb\u201c\u00a1\u00c6\u00fa.\u00cc\u00e9.\u009b.\u00a6\u00e0.\u009c\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a\u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00cc\u00cd \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201c\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n(2)\u00a6\u00c4 \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 15 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u2014\n\n(\u00a1)\u201c\u00a1\u00c6\u00fa.\u00cc\u00e9.\u009b.\u00a6\u00e0.\u009c.\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00bc\u00e5\u00c6\u008a\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\u00cc\u00cd\n\n(\u00a1\u00e5)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00e6\u00ba\u00f8 \u00cc\u00b4\u00cd\u00ef\u00be\u00cd\u00fa \u00a1\u00e6\u00ba\u00e8 \u201c\u00a1\u00c6\u00fa.\u00cc\u00e9.\u009b.\u00a6\u00e0.\u009c.\u201d\u00c6\u00be \u00c9\u00ae\u00be\u00c6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u201d.\n\n(3)\u00a6\u00c4 \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 17 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00a1\u00c6\u00fa.\u00cc\u00e9.\u009b.\u00a6\u00e0.\u009c.\u201d \u00c6\u00be\u00c9\u00ae\u00be\u00c6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0 \u201d\u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n(4)\u00a6\u00c4 \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 18 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00a1\u00c6\u00fa.\u00cc\u00e9.\u009b.\u00a6\u00e0.\u009c.\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u201d \u00c6\u00be\u00c9\u00ae\u00be\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 .\n\n\u00a1\u00ba\u00e9\u00ba\u00c6\u00b4 \u00c2\u00c8\u00c0\u00e7\u00c4.\n\n2005 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 III\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba4"
