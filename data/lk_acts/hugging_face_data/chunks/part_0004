    "chunk_text": "\u00c1\u00df\u008c\u0081 \u00b1\u00c8\u00af\u00c6\u00af\u00b8\u00ba\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cd\u00b9\u00b5\u00c8\u00af\u00c6\u00af\u00c7\u00b6\u00c6\u00b6\u00be\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00b8\u00b7\u00c8\u00af\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4+\u00c6\u00af\u00bf\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 35 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b7\u00c8\u00ce\u00be\u00cc\u00b9\u00de\u00b6\u00d0 \u00c1\u00df \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c638\n\n\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00b8 \u00cc\u00af\u00c7\u00bf\u00c6\u00ce\u00af \u00c1\u00c0\u00c8\u00db\u00ce\u00bd\u00af\u00ce\u00bf \u00a8\u00af\u00c6\u00d0\u008c\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00a3\u00b6\u00ce\u00b8 \u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0 \u00c1\u00b1\u00b6\u00c8\u00bb\u00bf\u00c8\u00b6\u00c6\u00b6\u00df\u00ba\u00c6;\n\n(\u00a6)\u00c1\u00df\u008c\u0081 \u00b9\u00d0\u00b6\u00c6\u00b6\u00bd\u00c8\u00e2\u00b9[\u00bc\u00c6\u00c1\u00ba\u00c7\u00b8 \u00b9\u00c7\u00c1\u00ce\u00b8\u00ce\u00bb \u00a8\u00af\u00c6\u00d0\u008c\u00b9\u00c6\u00b9\u00d7\u00ba\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00da\u00d7\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00be\u00c6\u00be\u00c7\u00b6\u00c1\u00df \u00f2\u00be\u00c1\u00bf+\u00c6\u00af\u00bf\u00c8\u0081 \u00b9\u00c7\u00c1\u00ce\u00b8\u00ce\u00bb\u00af\u00c6 \u00d0\u00ce\u00bd\u00b9\u00c6\u00b9\u00d7\u00ba\u00c7\u00b8\u00c1\u00df\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1 \u00db\u00af\u00c7\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1\u00b6\u00c6\u00b6\u00c8\u0081 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00a9\u00be\u00c6\u00be\u00c7 \u00a3\u00ba\u00c6\u00b1+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 ;\n\n(\u00a7)\u00c1\u00df\u008c\u00ce\u00b8\u00b6\u00c6 \u00b6\u00c8\u00bd\u00ce\u00ba\u00dc\u00b4\u0081 \u00cd\u00b1\u00ba\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\" \u00db\u00ce\u00bd\u00c1\u00c0\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\" \u00ba\u00c7\u00bd\u00c6\u00de\u00b6\u00be\u00c6\" \u00aa\u00bd\u00c6\u00bd\u00c8\u00b1\u00c6\u00cc\u00b1\u00be\u00c6\u00df\u00b6\u00be\u00c6\" \u00af\u00bf\u00b3\u00c6\u00b1\u00c8\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\" \u00c1\u00df\u008c\u0081 \u00b9\u00bb\u0081\u00b9\u00c7\u00d5 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00bd\u00c8\u00be\u00c6 \u00b6\u00c8\u00bd\u00ce\u00b8\u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00af\u00c6 \u00af\u00c8\u00ce\u00b4\u00b6\u00c6\u00b6\u00d0 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00d8\u00b4\u00c6\u00b9\u008c\u008a\u00be\u00c6\u00af\u00ce\u00bf \u00a5\u00b8\u00ba\u00c6 \u00af\u00c7\u00d6\u00b6\u00df\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00d8\u00b4\u00c6\u00b9\u008c\u00bb\u00be\u00c6\u00af\u00ce\u00bf \u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00ce\u00b8 \u00c1\u00b1\u00b6\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00df\u00ba\u00c6 ;\n\n(\u00a8)\u00a7\u00b9\u00af\u00bc\u00b5+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a7\u00b9\u00c7\u00bb+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00c1\u00df\u00b1\u00c6 \u00d2\u00b4\u00c6\u00d5\u00b6\u00c6\u00d7\u00ae\u0088\u00bd\u00c6\u00d0\u00ba\u00c6 \u00b7\u00c8\u00af\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00b6\u00c6 \u00b6\u00c8\u00b4\u00c6\u00b4+\u00c6\u00af\u00ce\u00bf \u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00df\u00ba\u00c6 \u00a7\u00b1\u00c6\u00b1\u00ba\u00b4\u00c6\u00b4 \u00a3\u00bf\u00e2\u00af\u00ce\u00bf\u00b6\u00c6 \u00b6\u00c7\u0089\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 ;\n\n(\u00a9)\u00c1\u00df\u008c\u0081 \u00b1\u00c8\u00af\u00c6\u00af\u00b8\u00b9\u00c6 \u00b9\u00c7\u00c1\u00ce\u00b8\u00af\u00c6\u00d0\u00ba\u00c6 \u00af\u00b4\u00c6\u0088\u00b4+\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00c1\u00df\u008c\u0081 \u0096\u00ae \u008c\u00bc\u00bb\u00b6\u00c6\u00ce\u00b6\u00af\u00c6 \u00d0\u00ce\u00bd\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00b7\u00c8\u00bb\u00ba+\u00c6\u00af\u00bf\u00c6\"\u00cc\u00b9\u00c7\u00d7 \u00cc\u00b7\u00bd\u00c8\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cd\u00af\u00c7\u00ce\u00c1\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a3\u00bf\u0096\u00b4\u00c6\u00ce\u00b4\u00dc\u00ba\u00c6\u00b1\u00bc\u00c8\u00b9\u00c7\u00bc\u00c6\u00b6\u00c6\u00b6\u00be\u00c6 \u00a4\u00bb\u00c6\u00e2\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u00da\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00af\u00b4\u00c6\u0088\u00b4\u00af\u00c6 \u00cd\u00af\u00c7\u00ce\u00c1\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00b7\u00ce\u00b4 \u00db\u00ce\u00bd\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00df\u00ba\u00c6;\n\n(\u00aa)\u00c1\u00df\u00b1\u00c6 \u00b1\u00c8\u00af\u00c6\u00af\u00b8\u00ba\u00c6\" \u00cd\u00b9\u00b5\u00c8\u00af\u00c6\u00af\u00c7\u00b6\u00c6\u00b6\u00be\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00cd\u00b6\u00ce\u00c1\u00db\u00af\u00c7\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1\u00ba\u00c6 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00bd\u00c8\u0081 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a3\u00ba\u00c6\u00b1+\u00c6\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a4\u00bb\u00c6\u00ce\u00c1\u00dc\u00ba\u00c6 \u00af\u00b5\u00c8\u00b9\u00c6\u0093\u00d5\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00da\u00be\u00b8\u00c7\u00bb\u00c6\u00e2\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4\u00af\u00c6\u00af\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00b6\u00df\u00ba\u00c6\u00ac\u00dd+\u00c6\u00af\u00c8\u00ce\u00b5\u00b6\u00c6\u00b6\u00df\u00ba\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 35 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b7\u00c8\u00ce\u00be\u00cc\u00b9\u00de\u00b6\u00d0 \u00c1\u00df \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c639\n\n36\u00b0 (1) \u00b1\u00ce\u00b9\u00bb\u00c7\u00b8\u00d7\" \u00a9\u00be\u00c6\u00be\u00c7 \u00c1\u00df\u00b9\u00c7\u00c1\u00ce\u00b8\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c7\u00df\u00ba\u00c6\u00a5\u00b5+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u00e1\u00af\u00b9\u00c6\u00b9\u00b4 \u00cd\u00c1\u00ae\u0088\u00bb \u00d0\u00bd\u00c8\u00b6\u00c6\u00b6 \u00c1\u00df \u00b1\u00c8\u00af\u00c6\u00af\u00b8 \u00cd\u00ba\u00ba\u00c6\u00b9\u00c7\u00b4\u00c6\u00d5\u00af\u00c6\u00af\u00c7\u00b8 \u00a7\u00b1\u00c6\u00b1 \u00ba\u00b4\u00c6\u00b4 \u00a3\u00bf\u00e2\u00af\u00ce\u00bf \u00a3\u00d7 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00ac\u00e1+\u00c6\u00d0 \u008c\u00b6\u00c8\u00af\u00bf\u00c6 \u00f2\u00be\u00ba\u00c6 \u00af\u00c7\u00be\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00af\u00c6 \u00af\u00c7\u00be\u00ba\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n(2) \u00b1\u00ce\u00b9\u00bb\u00c7\u00b8\u00d7 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a7\u00b1\u00c6\u00b1\u00ba\u00b4\u00c6\u00b4 \u00a3\u00bf\u00e2\u00af\u00bf\u00c6 \u00a5\u00b5+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u00e1\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00ce\u00b6 \u00a7\u00de\u00b6\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00af \u00a3\u00c1\u00b1\u00c8\u00bb\u00cc\u00ba\u00b8\u00af\u00c6 \u00af\u00dd\u00d7\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7 \u2013\n\n(\u00a3)\u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00c1\u00bf\u00e2\u00af\u00bf\u00c8\u00be\u00c6\" \u00c1\u00bf\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00af\u00b4\u00c6\u0088\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a7\u00b4\u00c6\u00da\u00d0\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00b6\u00af\u00c1\u00be\u00c6 \u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6\u00b6\u00af\u00c1\u00ce\u00be \u00b1\u00bc\u00c8\u00b9\u00c7\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00cd\u00c1\u00de \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00da\u00be\u00b8\u00c7\u00bb\u00c6\u00e2\u00af\u00ce\u00bf \u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 ;\n\n(\u00a4)\u00c1\u00df\u008c\u0081 \u00b9\u00bb\u0081\u00b9\u00c7\u00d5\" \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\" \u00cc\u00b9\u00de\u00ce\u00af \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u008c\u00bd\u00c6\u00b9\u00ce\u00b8 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00b6\u00af\u00c1\u00be\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00e2\u00ba\u00c7\u00de\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00ce\u00bf\u00b9\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 ;\n\n(\u00a5)\u00af\u00b4\u00c6\u0088\u00b4+\u00c6\u00af\u00bf\u00c8\u00df\u00ba\u00c6 \u00ce\u00af\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00c1\u00bf\u00e2\u00af\u00bf\u00c8\u00df\u00ba\u00c6 \u00c1\u00df\u008c\u0081\u00b9\u00c7\u00c1\u00ce\u00b8\u00ce\u00bb\u00af\u00c6 \u00af\u00ae\u00af\u00c7\u00b5\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00b6\u00ce\u00bc \u00c1\u00c7\u00af\u00b8+\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00af\u00b9\u00c6\u00b9\u00be\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00c1\u00c7\u00d9{\u00bc\u00c6\u00b6\u00c8\u00af\u00ce\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00c1\u00df\u00b1\u00c6\u00b1\u00c8\u00af\u00c6\u00af\u00b8\u00b6\u00c6\u00ce\u00b6 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00db\u00af\u00c1\u00bc\u00c7\u00ae\u00ce\u00ba\u00af\u00e0\u00b4\u0081\u00a5\u00ce\u00b5\u00b7\u00c6\u00d7 \u00af\u00ae\u00af\u00c7\u00b5\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 ;"
