    "description": "Agrarian Development Act (Amendment)",
    "url_metadata": "https://documents.gov.lk/view/acts/acts_2011.html",
    "lang": "en",
    "url_pdf": "https://documents.gov.lk/view/acts/2011/11/46-2011_E.pdf",
