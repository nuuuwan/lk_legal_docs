    "chunk_text": "(2)\u00ba\u00c9\u00bf \u00a5\u00be\u00af\u00c6\u00af\u00ba\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6\" \u201c133 \u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c134 \u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6 \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 ;\u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(3)\u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00ba\u00c9\u00bf \u00a5\u00be\u00af\u00c6\u00af\u00ba\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 (1) \u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00ce\u00c1 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00ce\u00c1\u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :-\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c653\n\n34\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 138 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2\" \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081(2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6\" \u201c\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 133 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6\u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00b4\u00c6\u0088 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00ce\u00b6 \u00a3\u00b6\u00b8\u00d7\u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u00b7\u00c8\u00bb\u00b6\u00c8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a7\u00b4\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8\u00dc\u00bf\u00c6\u00bf\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00af\u008c\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00a4\u00bf\u00c6 \u00a9\u00c1\u00dd\u00ba\u00c6\"\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a9\u00ae\u00d6\u00af\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 134 \u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00b4\u00c6\u0088 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00ce\u00b6\u00a3\u00c1\u00bc\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00b8\u00d7 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u00b7\u00c8\u00bb\u00b6\u00c8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u00a7\u00b4\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8\u00dc\u00bf\u00c6\u00bf \u00b6\u00b8\u00c8\u00bb\u00c7\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00c7\u00b6 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c7\u00bf\u00c6\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a9\u00ae\u00ce\u00b5\u00dc\u00ba\u00c6\" \u201c\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081138 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c654\n\n\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00b8\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u008c\u00b3\u00c6\u00d2\u00ce\u00af\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00ba\u00c9\u00bf\u00bf\u00c8\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00de\u00af\u00c6\u00d0 \u00a7\u00bc\u00c8\u00b6\u00c6\u00d7\u00ce\u00b4\u00bb\u00b6\u00c7\u00be\u00c7\u00af\u00c7\u00d7\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u008c\u00b3\u00c6\u00d2\u00cc\u00b6\u00c7\u00ce\u00af\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00ba\u00c9\u00bf\u00bf\u00c8\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00de\u00af\u00c6\u00d0 \u00a7\u00bc\u00c8\u00b6\u00c6\u00d7\u00ce\u00b4\u00bb\u00c1\u00bc\u00c7\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00db\u00ce\u00bd\u00cd\u00bb \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00bd\u00c6\u00bd\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7\u00b0\n\n35\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 139 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00bd\u00c6\u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n(1) \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6\" \u201c133 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00a3\u00be\u00c6\u00be\u00d7 136 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6\u00a9\u00ae\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u201c133 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 \u00a3\u00be\u00c6\u00be\u00d7135 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00a9\u00ae\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u201c133 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00a3\u00be\u00c6\u00be\u00d7 136 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a9\u00ae\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u201c133 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00a3\u00be\u00c6\u00be\u00d7 135 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a9\u00ae\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00db\u00ce\u00bd\u00cd\u00bb \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 ;\n\n(2) \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (5) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6\" \u201c133 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00a3\u00be\u00c6\u00be\u00d7 136 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a9\u00ae\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u201c133 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00a3\u00be\u00c6\u00be\u00d7 135 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a9\u00ae\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(3) \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u00e2\u00af\u00c6\u00af\u00c7\u00b8 \u00ad\u00bc\u00af\u00c6\u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00be\u00c6\" \u201c133 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\u00a3\u00be\u00c6\u00be\u00d7 136 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a9\u00ae\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u201c133 \u00a4\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7135 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00a9\u00ae\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6\u00b0"
