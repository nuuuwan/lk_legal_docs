    "chunk_text": "(4) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00a1\u00c3\u00fa\u00c6\u00e5\u00ae\u00be\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00c8\u00c9 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00a8\u00f2\u00c4\u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c 136 \u00c9\u00be \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00d7\u00ba\u00f8 \u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00ba\u00a8\u00e0,\u00a1\u00c3\u00fa\u00c6\u00e5\u00ae\u00be\u00e5\u0093\u00a8\u00c7\u00b8\u00c6\u00b4 \u00c0\u00f2\u00ba\u00f8\u00ef\u00ca\u00e5\u00e0\u00bd\u00be \u00c4\u00e5\u00da\u00aa\u00ef\u00c6\u00be\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00a6\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e5\u00bc\u00be \u00c8\u00bc \u00d7\u00ba\u00f8, \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e7\u00c4 \u00a1\u00c3\u00fa\u00c6\u00e5\u00ae\u00be\u00c6\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c4 \u00a1\u00bc\u00e5\u00ce \u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00c4\u00bd\u00f1\u00c4 \u00b0\u00e5\u00c8\u00ef\u00c6\u00be\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00c9\u00ec \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8 \u00be\u00f8\u00c7\u00ba\u00ef\u00c9\u0095\u00be\u00e0\u00a6\u00c9\u00e6\u00be\u00e0\u00be\u00a8\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00e5\u00c4\u00b4 \u00a1\u00ef\u00c0\u00e0\u00a8\u00e0\u00cb\u00e5 \u00a8\u00c7\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00be\u00f8\u00c6\u0095\u00ba \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 \u00cc\u00cd \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00c8\u00e0\u00a9\u00be \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00a6\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec\u00be\u00f8\u00c6\u0095\u00ba \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8 \u00c0\u00ba\u00f2\u00c6\u00a8\u00f8\u00be\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb-\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\u2014\n\n(\u00a1)\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c3\u00ed\u00ef\u00aa\u00e5\u00e0\u00c8\u00e9\u00c6 \u00c0\u00e8\u00cd\u00fa\u009b\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c9\u00ec \u00cc\u00e8\u00ba\u00f8\u00c6\u00c4\u00a8\u00c0\u00e8\u00b4\u00c0\u00ba\u00a8\u00e0 ;\n\n\u00c4\u00bd\u00f1\u00c4 \u00b0\u00e5\u00c8\u00ef\u00c6\u00be\u00e0\u00c2\u00e6\u00cd\u00e6\u00c7 \u00c9\u00ec \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8.\n\n2007 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00be\u00f8\u00ba\u00f1 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba22\n\n(\u00a1\u00e5)\u00b0\u00be\u00be\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00cc\u00cd \u00a6\u00cd\u00fa \u00a1\u00e6\u00cc\u00e0\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00a8\u00c7\u00be \u00c8\u00bc \u00c4\u00ea\u00dd \u00c0\u00e8\u00d6\u00c9\u00e6\u00c6 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00ef\u00a8\u0090\u0097\u00cc\u00e0\u00ba\u00c7\u00c6\u00a8\u00e0 ;\n\n(\u00a1\u00e6)\u00ef\u00c6\u00e5\u00bc\u00e5\u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00c0\u00f2\u00ca\u00cc\u00e0\u00ba\u00a8\u00c7\u00b8 \u00a4\u00c0\u00c4\u00e5\u00be\u00c6 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00c4\u00ea\u00c8\u00f1\u00cc\u00e6\u00ce\u00cc\u00ea\u00c4 \u00cc\u00cd \u00a1\u00e6\u00cc\u00e0\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00aa\u00ba \u00c4\u00ea\u00dd \u00c0\u00e8\u00d6\u00c9\u00e6\u00c6 ;\n\n(\u00a1\u00e7)\u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00ba\u00e0 \u00c4\u00ea\u00c8\u00f1 \u00c0\u00f2\u00ba\u00f8\u00c0\u00e5\u00bc\u00be \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4 \u00cc\u00e5\u00bd\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00cc\u00bf\u00cd\u00e5 \u00a1\u00c9\u00ca\u00f1 \u00a8\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c8\u00c2\u00e5\u00aa\u00be\u00e0\u00be\u00e5 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6 ;\n\n(\u00a2)\u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00e8\u00cd\u00fa\u009b\u00c4, (\u00a6\u00c6 \u00b0\u00c8 \u0097\u00f3\u00c8\u00e8 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u008c\u00be\u008a,\u00aa\u00e2\u00aa\u00e5\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00fa\u00c6 \u00c0\u00cd\u00c7\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00b0\u00e5\u00ef\u00a8\u00e5\u00b4\u00ea\u00c9 \u00cc\u00cd\u00c2\u00c8\u00e5\u00aa\u00e5\u00c7\u00c6, \u00a6\u00c6 \u00cc\u00ea\u00ce\u00e2 \u00c2\u00c8 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u008c \u00be\u008a, \u00cc\u00ea\u00ce\u00e2\u00ba\u00c8\u00c2\u00c4\u00be \u00cc\u00cd \u00c9\u00f1\u00ea\u00cd\u00c6\u00be\u00e0, \u00a6\u00c6 \u00ef\u00ef\u00b0\u00c9 \u00cc\u00e0\u00a8\u00be\u00e0\u00bd \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u008c\u00be\u008a \u00a2\u00be\u00e0\u00bd\u00be \u00c9\u00aa\u00e5\u00c9, \u00c2\u00c8\u00e5\u00aa\u00e5\u00c7\u00c6 \u00cc\u00cd \u00b0\u00c8 \u00c4\u00ec\u00c8\u00e5\u00ca\u00f2\u00c6 \u00cc\u00cd \u00a6\u00c6\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u008c \u00be\u008a, \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00e8 \u00c4\u00ec\u00c8\u00e5\u00ca\u00f2\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9\u00c0\u00d6\u00c9\u00da\u00ba\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00be\u00f8\u00c4\u00e5\u00c9\u00be\u00e0) ;\n\n(\u00a3)\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00cc\u00c4\u00aa\u00fa\u00be\u00e0 \u00c9\u00ec \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ca\u00a8\u00f1\u00ba\u00e5 \u00a1\u00bd\u00f1\u00c6\u00be \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 :\u2014\n\n(i)\u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u0097\u00cc\u00e0\u00ba\u00c7\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a2\u00e2\u00d4\u00ef\u00be\u00e0\u00c7\u00e6\u00cc\u00e6\u00ce\u00e6\u00cc\u00e0\u00c4\u00a8\u00e0 ;\n\n(ii)\u00a6\u00e0 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3 \u00c8\u00c2\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00cc\u00c4\u00e5\u00b0 \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00cc\u00e4\u00a8\u00e0\u00cb\u00b8\u00c6\u00a8\u00e0 ;\n\n(iii)\u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00a1\u00e6\u00ba\u00f8\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c0\u00e5\u00d6\u00cc\u00d6\u00a8\u00c4\u00c6\u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 1980 \u00a1\u00e2\u00a8 47 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8\u00c0\u00e5\u00d6\u00cc\u00d6\u00a8 \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00c4\u00bd\u00f1\u00c4 \u00c0\u00d6\u00cc\u00c7\u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00be\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 ; \u00cc\u00cd\n\n(iv)\u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00a8\u00e5\u00c8 \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00d7\u00cc\u00e6\u00ce\u00e6\u00cc\u00e0\u00c4\u00a8\u00e0 ;\n\n(\u00a4)\u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00c6 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u201c\u00c4\u00bd\u00f1\u00c4 \u00b0\u00e5\u00c8\u00ef\u00c6\u00be\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00c0\u00e5\u00d6\u00ef\u00c3\u00e5\u00e0\u00aa\u00fa\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00cc\u0095\u00ba\u00f8\u00c6\u00a8\u00e0\u201d \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00d1\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5,\u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c2\u00c8\u00e5\u00ef\u00c0\u00e5\u00ef\u00c7\u00e5\u00ba\u00e0\u00ba\u00eb \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00da\u00bb\u00c8\u00e5\u00c3\u00e9\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0\u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00a2\u00c8\u00e0\u00f5\u008a\u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00e8\u00b4\u00c0\u00ba\u00a8\u00e0 ;\n\n2007 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00be\u00f8\u00ba\u00f1 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba23"
