    "chunk_text": "\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc , \u00a6\u00c9\u00e6\u00be\u00f8 \u00c0\u00e8\u00d6\u00be\u00e6\u00e4\u00c4\u00a8\u00e0 \u00c3\u00e5\u00c7 \u00ef\u00be\u00e5\u00aa\u00be\u00ea \u00c8\u00c2\u00be\u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6\u00be\u00e0 \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00e8\u00cc\u00e0\u00ef\u008c\u0083\u00af\u00e5\u00ef\u00c9\u00be\u00e0 \u00ba\u00c4 \u00ef\u00cc\u00e0\u00c9\u00c6 \u00cd\u00e6\u00c7\u00aa\u00fa\u00c6\u00e5\u00ef\u00cc\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a7\u00c9\u00ea\u00be\u00e0\u0097\u00ca\u00f2\u00e5\u00c4 \u00c6\u00e5\u00ef\u008a \u00bc\u00e9 \u00a7\u00c9\u00ea\u00be\u00e0\u00b4 \u00cd\u00fa\u0095\u00a8\u008a \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00a1\u00da\u00bb\u00c8\u00e5\u00c3 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c0\u00d6\u00bc\u00e8 \u00c9\u00ec \u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00ba\u00e0 \u00c9\u00be\u00e0\u00bc\u00fa \u00ef\u00cd\u00e5\u00e0\u00c0\u00e5\u00d6\u00ef\u00ba\u00e5\u00e0\u00cb\u00e8\u00a8 \u00c7\u00b0\u00ef\u00c6\u00be\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a7\u00c9\u00ea\u00be\u00e0\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6.\n\n(3) \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00cc\u00cd \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9_\n\n\u00aa\u008a\u00c0\u00cd \u0097\u00a8\u00f2\u00c4\u00e5\u00c7\u008e\u008e\u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00ca\u00e8\u00a8\u00e0\u00cb\u00b8\u00ef\u00c7\u00e5\u00e0\u00cd\u00c8 \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u00b4\u00c0\u00e6\u00c9\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 51 \u00bc\u00c7\u00be \u00aa\u008a\u00c0\u00cd \u0097\u00a8\u00f2\u00c4\u00e5\u00c7\u0083\u008e \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u00ca\u00fa\u00a8\u00e0\u00cb\u00b8 \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8 (\u00c0\u00e6\u00c9\u00d7\u00ef\u008a) \u00c0\u00be\u00ba3\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5\u00c0\u00e5\u00b5\u00c6 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n(\u00a1\u00e5) \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00a8\u00e6\u00ce\u00b8\u00e8\u00c6 \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8\u00ef\u00c6\u00e0 \u00c9\u00e5\u00cc\u00e8\u00c6\u00b4 \u00ef\u00cd\u00e5\u00e0\u00a3\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00f3\u00c9 \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00c6\u00b4 \u00a2\u00cd\u00ba\u00f8\u00be\u00e0\u00c9\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00a2\u00b4\u00ea \u00ef\u00be\u00e5\u00a8\u00c7 \u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00be\u00b6\u00ea \u00ba\u00e9\u00be\u00e0\u00f3 \u00cd\u00e5 \u00ba\u00f9\u00be\u00e0\u00f3 \u00c0\u00f2\u00a8\u00e5\u00ca,\u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00e8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba\u00c0\u00d6\u00bc\u00fa \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00c9\u00e5\u00cc\u00e8\u00c6\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c6\u00b4\u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00be\u00b6\u00ea \u00ba\u00f9\u00be\u00e0\u00f3 \u00cd\u00e5 \u00ba\u00f9\u00be\u00e0\u00f3 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 , \u00a6\u00e0 \u00a1\u00be\u00ea\u00c9 \u00a6\u00e0 \u00be\u00b6\u00ea\u00ba\u00f9\u00be\u00e0\u00f3 \u00cd\u00e5 \u00ba\u00f9\u00be\u00e0\u00f3 \u00c0\u00f2\u00a8\u00e5\u00ca \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(\u00a1\u00e6) \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c9\u00ec \u00bc, \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00c6\u00b4 \u00a2\u00cd\u00ba\u00f8\u00be\u00e0 \u00c9\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0\u00c0\u00c9\u00ba\u00f8\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00a8\u00e6\u00ce\u00b8\u00e8\u00c6 \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e8\u00c6\u00f5\u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00cd\u00e5 \u00c9\u00aa\u00a8\u00f9\u008a \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c\u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00cd\u00e5 \u00c9\u00aa\u00a8\u00f9\u008a \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n3.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n4.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u2014\n\n\u201c\u00a8\u00e6\u00ce\u00b8\u00e8\u00c6 \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 , 1978 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be\u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8 \u00c0\u00be\u00ef\u00ba\u00e0 25 \u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0\u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00a8\u00e6\u00ce\u00b8\u00e8\u00c6 \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6(2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\n\n\u00c2\u00cc\u00e0\u00be\u00e5\u00cd\u00fa\u00c7 \u00c0\u00ce\u00e5\u00ef\u00ba\u00e0 \u00aa\u008a\u00c0\u00cd \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00aa\u008a\u00c0\u00cd \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a \u00ef\u00a8\u00e5 \u00b5\u00e5\u00ca\u00ef\u00c6\u00e0 \u00c4\u00e6\u00bc\u00c0\u00ba\u00e0\u00ba\u00eb\u00ef\u008c \u00c6\u00a8\u00e0\u00a8\u00c8 \u00be\u008a \u00aa\u00f2\u00e5\u00c4\u00ef\u00c6\u00e0 \u00c0\u00e8\u00cd\u00fa\u0090 \u00ef\u00a8\u00e5\u00e0\u00be\u00e0\u00aa\u00cd\u00c9\u00ba\u00e0\u00ba \u00be\u008a \u00a2\u00b6\u00ef\u00c4\u00be\u00e0 \u00c4\u00e6\u00be \u00cc\u00e5\u00bc\u00be \u00c8\u00bc \u00a1\u00c6\u00fa.\u00a6\u00e0. \u0097\u00ef\u00d9\u00ba\u00f8\u00c8\u00a8 \u0095\u00be\u00ea\u008a\u00ef\u00bc\u00e5\u00e0\u00c7\u00e6 \u00a1\u0093\u00a8\u00e5\u00d6 \u00ba\u00eb\u00c4\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 2003 .11 .12 \u00bc\u00e5\u00ba\u0095\u00be\u00e0 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00c7\u00be \u00c8\u00bc\u00a1\u00e2\u00a8 \u00aa\u008a/\u00aa\u008a/ 03/275-B \u00cc\u00cd 2004 \u00cc\u00e6\u00c0\u00e0\u00ba\u00e6\u008a\u00c2\u00da \u00cd\u00e5 \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u00c2\u00da \u00bc\u00c7\u00be \u00a1\u00be\u00ea\u00ef\u00da\u00a9\u00be\u00ef\u00c6\u00e0\u00ef\u00c8\u00e5 \u00a1\u00e2\u00a8 1 \u00ef\u00c8\u00cc \u00c8\u00a8\u00eb\u00b8\u00ea \u00ef\u00a8\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00aa\u008a\u00c0\u00cd \u0097\u00a8\u00f2\u00c4\u00e5\u00c7\u0083\u008e \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8\u00e0 \u00cc\u00e2\u00a8\u00f9\u00da\u00b8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00dd\u00cc\u00e8\u00c6\u00f5 \u00aa\u00cd\u00ef\u00a8\u00e5\u00ce \u00c0\u00ce\u00ba\u00eb\u00c7\u00e6 \u00cc\u00cd \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8 \u00cc\u00cd\u00fa\u00ba \u00a1\u00a8\u00e0\u00a8\u00c7 \u00a6\u00a8\u00c6\u00fa \u00c0\u00da\u00ae\u00cc\u00e0 \u00ba\u00f8\u00cc\u00e0 \u00c0\u00cd\u00c6\u00e8 \u00bc\u00ca\u00c4\u00a6\u00a8\u00c6\u00fa \u00ef\u00bc\u00a8\u00a8 (\u00a1. 1 \u00c7\u00e7. 0 \u00c0\u00da. 35.12 ) \u0097\u00ca\u00e5\u00c8\u00ba\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u00c6\u00ea\u00ba\u00e0 \u00a6\u00a8\u00f9 \u00a2\u00b6\u00c4 \u00ef\u008c.\n\n\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n2007 \u00a1\u00e2\u00a8 51 \u00bc\u00c7\u00be \u00aa\u008a\u00c0\u00cd \u0097\u00a8\u00f2\u00c4\u00e5\u00c7\u0083\u008e \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u00ca\u00fa\u00a8\u00e0\u00cb\u00b8 \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8 (\u00c0\u00e6\u00c9\u00d7\u00ef\u008a) \u00c0\u00be\u00ba4"
  },
