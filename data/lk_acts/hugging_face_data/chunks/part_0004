    "chunk_text": "\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 26\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba14\n\n(iv)\u00a6\u00e0 \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (v) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c\u00a6\u00a8\u00ba\u00eb \u00a8\u00ce\u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0;\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201c\u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0; \u00ef\u00cd\u00e5\u00e0\u201d, \u00c6\u00be\u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00c2) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (iv) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0(\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c\u00c4\u00ea\u00dd \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\u201d, \u00c6\u00be\u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 :\u2014\n\n\u201c\u00c4\u00ea\u00dd \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\u00cc\u00cd\u201d\n\n(v) \u201c\u00b8\u00c6\u201d \u00c6\u00be\u00e0\u00be\u00b4 \u00cd\u00c7 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00db\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c.\u201d\n\n\u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(\u00a1\u00e6)\u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00c2) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00ef\u00d8\u00bc\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(\u00c4) \u00c6\u008a \u00c0\u00e5\u00c8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c6\u008a \u00c0\u00e5\u00c8\u00e8\u00ba\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00f8\u00be\u00e0 \u00a6\u00e0 \u00c0\u00e5\u00c8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0\u00c8\u00c2\u00e5\u00aa\u00ba\u00e0 \u00c6\u008a \u00b8\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0, \u00c6\u008a\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c9\u00be\u00ef\u00c0\u00e5\u00ce\u00e8\u00c6, \u00a6\u00e0 \u00c0\u00e5\u00c8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00a8\u00eb \u00c9\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00a1\u00c9\u00cc\u00e5\u00be\u00ef\u00c6\u00e0\u00bc\u00fb \u00a6\u00e0 \u00c0\u00e5\u00c8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00ce\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00ef\u00c6\u00e0 \u00cc\u00cd \u00cc\u00e2\u008e\u00ba\u00c9\u00c8 \u00a6\u00a8\u00ba\u00eb\u00ef\u008c\u00ba\u00eb\u00be\u00e0 \u00aa\u00eb\u00b8\u00c6\u00a8\u00b4 \u00cc\u00c4\u00e5\u00be \u00a6\u00a8\u00f9 \u00b8\u00c6 \u00c4\u00ea\u00bc\u00ef\u00c8\u00cd\u00fa\u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00b4 \u00a1\u00be\u00ea\u00c7\u00e7\u00c0 \u00c9\u00be \u00ef\u00c0\u00e5\u00ce\u00e8\u00c6\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u0097\u00b4, \u00a6\u00c4 \u00ef\u00c0\u00e5\u00c8\u00e8\u00ef\u00c6\u00cd\u00fa \u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba\u00c6:\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9\u00bc, \u00a6\u00e0 \u00c0\u00e5\u00c8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00a8\u00eb \u00ef\u00be\u00e5\u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb,\u201c\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00ce \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00ef\u00c6\u00e0 \u00cc\u00cd\u00cc\u00e2\u008e\u00ba\u00c9\u00c8 \u00a6\u00a8\u00ba\u00eb\u00ef\u008c \u00ba\u00eb\u00be\u00e0 \u00aa\u00eb\u00b8\u00c6\u00a8\u00b4\u00cc\u00c4\u00e5\u00be\u201d, \u00c6\u00be \u00c9\u00ae\u00be\u00c9\u00c8\u00b4 \u00a6\u00e0 \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00c9\u00ec\n\n2007 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba15\n\n\u00cc\u00bf\u00cd\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00ef\u00c6\u00e0 \u00cc\u00cd\u00cc\u00e2\u008e\u00ba\u00c9\u00c8 \u00a6\u00a8\u00ba\u00eb\u00ef\u008c \u00cd\u00ba\u00c7 \u00aa\u00eb\u00b8\u00c6\u00a8\u00b4 \u00cc\u00c4\u00e5\u00be\u201d,\u00c6\u00be \u00c9\u00ae\u00be\u00c9\u00c8\u00b4 \u00c9\u00ec \u00cc\u00bf\u00cd\u00be\u00a8\u00e0 \u00ef\u00c8\u00cc \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00c8\u00cc\u00e8\u00be\u00e0 \u00a1\u00bc\u00e5\u00ce \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00ef\u008a \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u2014\n\n(i) \u201c\u00c0\u00e5\u00c8\u00e8\u00ba\u201d \u00cc\u00cd \u201c\u00c0\u00e5\u00c8\u00a8 \u00cc\u00c4\u00e5\u00aa\u008a\u201d\u00c6\u00be \u00ef\u00c6\u00f3\u008a\u00c9\u00c8\u00b4 2007 \u00a1\u00e2\u00a8 7\u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a6\u00e0\u00c9\u00e5\u00b4 \u00bc\u00fb\u00a1\u00e6\u00ba\u00f8 \u00a6\u00c4 \u00a1\u00bc\u00e5\u00ce \u00a1\u00da\u00bb\u00c6\u00c4 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6 ;\n\n(ii) \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a\u00c0\u00e5\u00c8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00ef\u00c4\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00b4 \u00c0\u00be\u00cd\u00a8\u00b4 \u00c9\u00b6\u00e5 \u00c9\u00e6\u0091\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00a6\u00c4 \u00c0\u00e5\u00c8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0 \u00c8\u00e6\u00c2\u00ea\u00ef\u00be\u00e0\u00be\u008a, \u00a6\u00c4 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00b4\u00a1\u00bc\u00e5\u00ce\u00c9 \u00c0\u00e5\u00c8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u201c\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00a8\u00eb\u201d \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(iii) \u201c\u00cc\u00e2\u008e\u00ba\u201d \u00c6\u00be\u00e0\u00be\u00b4, \u00c9\u00ba\u00e0\u00a8\u008a \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0\u00be\u00e6\u00c9\u00ba \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c8\u00bc \u00c6\u008a\u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba\u00c6\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00ce\u00cc\u00e2\u008e\u00ba \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\u00cc\u00cd\n\n(iv) \u201c\u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00c4\u201d \u00c6\u00be\u00e0\u00be, \u00c6\u008a \u00c0\u00e5\u00c8\u00a8\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9, \u00a6\u00e0 \u00c0\u00e5\u00c8\u00a8\u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00c7\u00be\u00c8\u00bc \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c9\u00c8\u00e8\u00be\u00e0 \u00a6\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00c6 \u00ba\u00eb\u00ce \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e7\u00c4\u0097\u00a8\u00f8\u00b8\u00e9\u00c4\u00a8\u00f8\u00be\u00e0 \u00c4:\u2014\n\n(\u00a1) (i) \u00c6\u008a \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00c9\u00ba\u00e0\u00a8\u00c4\u00a8\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7\n\n2007 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba16\n\n\u00a8\u00f8\u00d7\u00c4\u00a8 \u00bc\u00fb \u00c8\u00ba\u00e0 \u00c4\u00ea\u00dd\u00c4\u00ea\u00bc\u00c8, \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00c8\u00bc \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00e0\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0;"
