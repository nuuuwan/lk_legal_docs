    "chunk_text": "(2) \u00a1\u0093\u00a8\u00e5\u00d6\u00c6, (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a3\u00b4 \u00c0\u00c9\u00c7\u00be \u00c8\u00bc \u00be\u00e5\u00c4\u00ef\u00c6\u00be\u00e0\u00a1\u0097\u0083\u00d2\u00be\u00e0\u00be \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00c4\u00a8\u00e0 \u00cd\u00e5 \u00ef\u00c0\u00e5\u00f3 \u00c4\u00ea\u00f7\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7,\u00a6\u00e0 \u00be\u00e5\u00c4\u00ef\u00c6\u00be\u00e0 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc, \u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00bc, \u00be\u00b6\u00ea \u00c0\u00c9\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00be\u00f8\u00ba\u00f1\u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4.\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6 \u00cc\u00cd\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00c9\u00be \u00bc\u00fa\u00be\u00c6.\n\n2007 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00be\u00f8\u00ba\u00f1 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba2\n\n(\u00a1) \u00be\u00f8\u00c8 \u00c2\u00c8\u00ef\u00c6\u00be\u00e0 \u00c0\u00ba\u00e0\u00c9\u00be \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0:\u2014\n\n(i)\u0097\u00f3\u00c8\u00e8\u00c2\u00c8 \u00cd\u00e5 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0\u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00be\u00e5\u0095\u00a8\u00ef\u00c6\u00a8\u00e0 ;\n\n(ii)\u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00cc\u00cd \u00c0\u00ce\u00e5\u00ba\u00e0 \u00cc\u00c3\u00e5 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0\u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00be\u00e5\u0095\u00a8\u00ef\u00c6\u00a8\u00e0;\n\n(iii)\u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00cc\u00cd \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c0\u00f2\u00c9\u00da\u00bd\u00be \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0\u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00be\u00e5\u0095\u00a8\u00ef\u00c6\u00a8\u00e0;\n\n(iv)\u00a2\u00b6\u008a \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0\u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00be\u00e5\u0095\u00a8\u00ef\u00c6\u00a8\u00e0;\n\n(v)\u00a8\u00ee\u00cb\u00e8\u00a8\u00da\u00c4 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00be\u00e5\u0095\u00a8\u00ef\u00c6\u00a8\u00e0;\n\n(vi)\u00c9\u00e6\u0097\u00c8\u00e8 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00be\u00e5\u0095\u00a8\u00ef\u00c6\u00a8\u00e0;\n\n(vii)\u00c0\u00d6\u00cc\u00c7 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00be\u00e5\u0095\u00a8\u00ef\u00c6\u00a8\u00e0;\n\n(viii) \u00c9\u00e5\u00d6\u00c4\u00e5\u00da\u00aa \u00cc\u00cd \u00c4\u00cd\u00c9\u00e6\u00c8\u00e8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0\u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00be\u00e5\u0095\u00a8\u00ef\u00c6\u00a8\u00e0;\n\n(ix)\u00c0\u00f2\u00c9\u00e5\u00cd\u00be \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00be\u00e5\u0095\u00a8\u00ef\u00c6\u00a8\u00e0;\n\n\u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e2\u00c6\u00ea\u00ba\u00f8\u00c6.\n\n2007 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00be\u00f8\u00ba\u00f1 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba3\n\n(x)\u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0\u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00be\u00e5\u0095\u00a8\u00ef\u00c6\u00a8\u00e0;\n\n(xi)\u0097\u00bc\u00f1\u00e5 \u00cd\u00e5 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00be\u00e5\u0095\u00a8\u00ef\u00c6\u00a8\u00e0; \u00cc\u00cd\n\n(xii)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd\u00b0\u00be \u00a4\u00c0\u00ef\u00c6\u00e5\u00e0\u00aa\u00fa\u00ba\u00e5 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00ef\u008c\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 :\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, (i) \u00cc\u00e8\u00b4 (xi) \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c9\u00c8\u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u0097\u00cb\u00c6\u00c6\u00be\u00e0 \u00ef\u00bc\u00a8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4\u00c9\u00e6\u0091 \u00aa\u00b8\u00be\u00a8\u00e0 \u00ba\u00be\u00f8 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00a8\u00eb\u00b4 \u00c0\u00c9\u00c7\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c3\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c0\u00c9\u00ba\u00f8\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb, \u00a6\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0\u00a6\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00c6\u00b4 \u00a6\u00a8\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00a8\u00eb\u00b4 \u00c9\u00b6\u00e5 \u00c9\u00e6\u0091\u00aa\u00b8\u00be\u00a8\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb \u00a6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00e6\u00a1\u00ba\u00d6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00c6\u00a8\u00eb \u00c0\u00c4\u00b8\u00a8\u00e0, \u00ef\u008a \u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00c2\u00c9\u00b4 \u00c0\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6;\n\n(\u00a1\u00e5)(\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00c0\u00ba\u00e0\u00a8\u00ce \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u201d\u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c0\u00cd\u00ba\u00cc\u00bf\u00cd\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 :\u2014\n\n(i)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00e2\u00aa\u00c4\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be \u00c8\u00bc \u00a6\u00c4 \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0\u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00ef\u00c6\u00a8\u00e0;"
