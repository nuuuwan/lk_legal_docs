    "chunk_text": "(2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00ba\u00c7\u00b1\u00c6\u00d2 \u00ba\u00c7\u00b6\u00ba\u00c6 20 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7)\n\n\u00a3\u00bc\u00b1\u00c8\u00b8\u00bc\u00c6 \u00a4\u00ce\u00b5\u00b9\u00c6\u00b9\u0088 \u00a3\u00b1\u00c6\u00b1\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\n\n\u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00a3\u00b1\u00c6\u00d2\u00b6\u00c6 \u00b6\u00c8\u00ce\u00b5\u00af\u00c6\u00af\u00bf\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00b9\u00b6\u00c8\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00bd\u00c6\u00bd\u00d7\u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da 1\" \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00b4\u00df\u00c1\u00be\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00be\u00c7\u00ba\u00c6\n\n\u008c\u00ce\u00be : \u00f4\u00b9\u00c7 390'75\u00b6\u00b9\u00c7\u00bd\u00c6 \u00cc\u00b1\u00be\u00e2 : \u00f4\u00b9\u00c7 65\u00b000\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081\u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00ba\u00c6\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u00b8\u00c6 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n2007\" \u00ba\u00c7\u00b1\u00c6\u00d2 \u00ba\u00c7\u00b6\u00ba\u00c6 23 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb \u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6\u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00b9\u00c6 \u00b9\u00b6\u00c6\u00b6\u00c8\u00bc\u00c8\u00ce\u00af\u008a\u0081 II \u00a4\u00ba\u00c6 \u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00b7\u00c8\u00bc\u00b9\u00c6\u0089\u00bb\u00c7\u00af\u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\n\ni\n\n\u0089\u00bc\u00c8\u00e2\u00b9\u00af\u00c6\u00af\u00ba\u00c6\n\n1' \u00d2\u00dd\u00af\u00c6\u00af\u00b9\u00c6 \u00cc\u00b9\u00bb\u00dd\u00ba\u00c6 \u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00af\u00c6\u00d0 \u00c1\u00dd\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00dc\u00ba\u00c6\n\n\u00b9\u00c7\u00af\u00ba\u00c6 I\n\n\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00ce\u00bf\u00af\u00c6 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b9\u00b4\u00c6\u00b4 \u00af\u00dd\u00ba+\u00c6\u00af\u00e0\u00ba\u00c6\n\n\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c8\u0081 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00c1\u00b1\u00c8\u00bb\u00b6\u00c6 \u00b6\u00b8\u00c8\u00b9\u00c6\u00b9\u00ae\u00da\u00af\u00bf\u00c6\n\n2' \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u0081 \u00b1\u00b4\u00c6\u00b4 \u00a3\u00b7\u00c6\u00b6\u0083\u00d7\u00ba\u00c6 \u00b6\u00ce\u00af\u00ce\u00ba\u00dc\u00ba\u00c6\n\n3' \u00cc\u00c1\u00c1\u00c6\u00cd\u00c1\u00de \u00c1\u00ce\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\n\n\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00ce\u00bf\u00af\u00c6 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\n\n4. \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00af\u00c6 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00d0\u00ba\u00c6 \u00db\u00ce\u00bd\n\n5. \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00ce\u00bb\u00af\u00c6 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6\n\n\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00cc\u00b9\u00bb\u00bc\u00c6\u00af\u00bf\u00c6\n\n6. \u00cc\u00b9\u00bb\u00bc\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\n\n7' \u00cc\u00b9\u00bb\u00bc\u00c6\u00af\u00bf\u00c6 \u00ba\u00c9\u00b6\u00c7\u00b8 \u00ba\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00c7\u00d5\n\n8' \u00cc\u00b9\u00bb\u00bc\u00c6 \u00ba\u00c7\u00bd\u00c6\u00bd\u00ba\u00c6\n\n9' \u00cc\u00b9\u00bb\u00bc\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6\n\n10' \u00cc\u00b9\u00bb\u00ce\u00bc \u00ba\u00c7\u00bd\u00c6\u00de\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00b9\u00b5\u00c8\u00b9\u00c6\u00da\n\n11' \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a3\u00b7\u00c6\u00b6\u0083\u00d7 \u00ba\u00c7\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u0081\u00ba\u00c9\u00d7 \u00cc\u00b9\u00bb\u00bc\u00c6 \u00ba\u00c7\u00bd\u00c6\u00bd\u00ba\u00c6\n\n12' \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00b9\u00c6 \u00cc\u00b9\u00bb\u00bc\u00c8\u00b8\u00d7\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00a5\u00be\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7\u00ba\u00c6 \u00b9\u00bb\u0081\u00b9\u00c7\u00d5\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00af\u00ba\u00c6\n\n\u0089\u00bc\u00c8\u00e2\u00b9\u00af\u00c6\u00af\u00ba\u00c6\n\n1\n\n1\n\n2\n\n3\n\n4\n\n5\n\n5\n\n7\n\n9\n\n9\n\n11\n\n12\n\nii\n\n\u0089\u00bc\u00c8\u00e2\u00b9\u00af\u00c6\u00af\u00ba\u00c6\n\n\u00a3\u00ce\u00ba\u00b9\u00c6\u00b9\u00af\u008c\u00b6\u00c8\u00af\u00bf\u00c6\n\n13' \u00a3\u00af\u008c\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00af\u00ba\u00c6\n\n14' \u00ba\u00c7\u00b6\u00c8\u00bc\u00c8 \u00a3\u00ce\u00ba\u00b9\u00c6\u00b9\u00af \u008c\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00ce\u00ba\n\n15' \u00a3\u00ce\u00ba\u00b9\u00c6\u00b9\u00af \u008c\u00b6\u00c8\u00af\u00ce\u00bf \u00aa\u00bd\u00c6\u00bd+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00b6\u00c6\u00b6\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\n\n16' \u00a3\u00ce\u00ba\u00b9\u00c6\u00b9\u00af \u008c\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00b9\u00bb\u0081\n\n17' \u00a3\u00ce\u00ba\u00b9\u00c6\u00b9\u00af \u008c\u00b6\u00c8\u00af\u00bf\u00c8\u00be\u00c6 \u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00bf\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00e7\u00bd\u00c6\u00bd\u00c8\u0081 \u00b9\u00bb\u0081\n\n18' \u00a3\u00ce\u00ba\u00b9\u00c6\u00b9\u00af \u008c\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u0089\u00bc\u00b6\u00c8\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00d0 \u00b9+\u00c6\u00d0\u00b6\u00c7\u00bc\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00bf\u00c6\u00bf \u00a7\u00bc\u00c8\u00ce\u00ba\n\n\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00ac\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6+\u00c6\u00af\u00bf\u00c6 \u00db\u00b6\u008b\u00bb\u00b8\n\n19' \u00ac\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00b3\u00c6 \u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6 \u00db\u00ce\u00bd\n\n20' \u00a3\u00bd\u00c6\u00cd\u00bd\u00c7\u00b8\u00c8\u00b6\u00c6 \u00b6\u00b6\u00c6\u00d7\u00c1\u00af\u00c7\u00bc\u00bc\u00c6\u00af\u00bf\u00c6\n\n21' \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c6\" \u00a3\u00df\u00c1\u00be\u00bc\u00c6\u00af\u00bf\u00c6\" \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00db\u00af\u00c1\u00bc\u00c6\u00af\u00bf\u00c6 \u00a4\u00af\u00c8\u00cd\u00bb\u00c7\u00bc\u00c8\u0081\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00c6\n\n22' \u00a3\u00ce\u00ba\u00b9\u00c6\u00da \u00c1\u00c0\u00c8 \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6 \u00a5\u00be\u00c6\u00ce\u00be\n\n\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b9\u00c6\u0089\u00bd\u00c6\u00d0 \u00db\u0081\u00b8\u00bc\u00c7\u00b8 \u00ac\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6+\u00c6\u00af\u00bf\u00c6\n\n23' \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b9\u00c6\u0089\u00bd\u00c6\u00d0 \u00db\u0081\u00b8\u00bc\u00c7\u00b8 \u00ac\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6+\u00c6\u00af\u00bf\u00c6 \u00c1\u00df\u00c1\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\n\n24' \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b9\u00c6\u0089\u00bd\u00c6\u00d0 \u00db\u0081\u00b8\u00bc\u00c7\u00b8 \u00ac\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6+\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00a7\u00b4\u00c6\u00af\u00c8\u00ce\u00b4\u00bb\u00c7\u00b8\u00af\u00b4\u00c6\u00d5\u00de\u00b6\u00c6\u00d7\u00af\u00bf\u00c6\n\n25' \u00c1\u00df\u00c1\u00c7\u00af\u00c6\u00af\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b6\u00c6 \u00b6\u00c1\u00de\u00b6\u00be\u00c6\n\n14\n\n14\n\n15\n\n16\n\n16\n\n17\n\n18\n\n20\n\n22\n\n22\n\n22\n\n23\n\n24\n\niii\n\n\u0089\u00bc\u00c8\u00e2\u00b9\u00af\u00c6\u00af\u00ba\u00c6\n\n\u00a4\u00c1\u00b5+\u00c6\u00af\u00bf\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00be\u00c6 \u00cc\u00ba\u00bb\u00c6\u00cc\u00bb\u0081\u00de\u00de\u00b6\u00c8 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00be\u00c6\n\n26' \u00a4\u00c1\u00b5+\u00c6\u00af\u00bf\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00be\u00c6 \u00cc\u00ba\u00bb\u00c6\u00cc\u00bb\u0081\u00de\u00de\u00b6\u00c8 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00be\u00c6\n\n\u00b9\u00c7\u00af\u00ba\u00c6 II\n\n\u00b6\u00b8\u00c8\u00bb\u00c7\u00bc\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\n\n27' \u00b6\u00b8\u00c8\u00bb\u00c7\u00bc\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a3\u00ce\u00ba\u00b9\u00c6\u00b9\u00af \u008c\u00b6\u00c8\u00af\u00bf\u00c6"
