    "chunk_size_bytes": 3467,
    "chunk_text": "\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c4\u00ef\u00cc\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n1.\u00ef\u008a \u00c0\u00be\u00ba 2007 \u00a1\u00e2\u00a8 38 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c3\u00aa\u00c9\u00e5\u00be\u00e0 \u00ca\u00f2\u00e9\u00cc\u00ba\u00f1 \u00cc\u00e5\u00c6\u00fa \u00c4\u00bd\u00f1\u00c4 \u00c3\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c3\u00e5\u00c7\u00a8\u00e5\u00c7 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a)\u00c0\u00be\u00ba \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c3\u00aa\u00c9\u00e5\u00be\u00e0\u00ca\u00f2\u00e9 \u00cc\u00ba\u00f1 \u00cc\u00e5\u00c6\u00fa\u00c4\u00bd\u00f1\u00c4 \u00c3\u00e5\u00c7\u00ef\u00c6\u00e0\u00c3\u00e5\u00c7\u00a8\u00e5\u00c7 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 38 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c3\u00aa\u00c9\u00e5\u00be\u00e0 \u00ca\u00f2\u00e9 \u00cc\u00ba\u00f1 \u00cc\u00e5\u00c6\u00fa\u00c4\u00bd\u00f1\u00c4 \u00c3\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c3\u00e5\u00c7\u00a8\u00e5\u00c7 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a) \u00c0\u00be\u00ba2\n\n3. \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00ef\u00c0\u00e5\u00f3 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb\u00cc\u00bf\u00cd\u00e5 \u00bc, \u00a6\u00e0 \u00ef\u00c0\u00e5\u00f3 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6\u00c6\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(i) \u00c3\u00aa\u00c9\u00e5\u00be\u00e0 \u00ca\u00f2\u00e9 \u00cc\u00ba\u00f1 \u00cc\u00e5\u00c6\u00fa \u00c2\u00e5\u00c2\u00e5 \u00ba\u00eb\u00c4\u00e5\u00ef\u00aa\u00e0 \u00a2\u00aa\u00e6\u00be\u00e0\u00d1\u008a \u00cc\u00cd\u00c0\u00b8\u00e8\u00c9\u00ea\u00b6\u00c6 \u00ef\u00c2\u00bc\u00e5 \u00cd\u00e6\u00d7\u00c4 ;\n\n(ii) \u00c3\u00aa\u00c9\u00e5\u00be\u00e0 \u00ca\u00f2\u00e9 \u00cc\u00ba\u00f1 \u00cc\u00e5\u00c6\u00fa \u00c2\u00e5\u00c2\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba \u00cc\u00ba\u00f1,\u00bd\u00da\u00c4\u00c6, \u00ca\u00e5\u00be\u00e0\u00ba\u00f8\u00c6, \u00ef\u00c0\u00f2\u00e0\u00c4\u00c6 \u00cc\u00cd \u00a1\u00cd\u00fa\u00e2\u00cc\u00e5\u00c9 \u00c6\u00be \u00ef\u008a \u00c4\u00ec\u00c8\u00e8\u00a8\u00c4\u00ec\u00c8\u00bd\u00da\u00c4 \u00c0\u00d6\u00ae\u00ef\u00c6\u00be\u00e0 \u00cd\u00e5 \u00a1\u00e5\u00bc\u00da\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(iii) \u00ef\u008c\u00bc, \u00a4\u00c0\u00be\u00f8\u00cb\u00bc\u00e0, \u00ca\u00e5\u00cc\u00e0\u00ba\u00f2, \u00c0\u00ea\u00c7\u00e5\u00b8 \u00cc\u00cd \u00cc\u00be\u00e5\u00bb\u00be \u00bd\u00da\u00c4\u00c6\u00b4\u00a1\u00c6\u00ba\u00e0 \u00ef\u00cc\u00cc\u00ea \u00cc\u00e5\u00cd\u00fa\u00ba\u00f1\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00bc\u00e6\u00be\u00ea\u00c4 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(iv) \u00ef\u00c8\u00e5\u00e0\u00a8\u00ef\u00c6\u00e0 \u00cc\u00e8\u00c6\u00f5\u00c4 \u00c0\u00f2\u00bd\u00e5\u00be \u00a1\u00e5\u00aa\u008a\u00c9\u00c8 \u00ef\u00ca\u00f2\u00e0\u00cb\u00e0\u00b5, \u00a4\u00ba\u00e0\u00a8\u00ee\u00cb\u00e0\u00b4\u00cd\u00e5 \u00a4\u00ba\u00e0\u00ba\u00d7\u00ba\u00c7 \u00a1\u00e5\u00ae\u00e5\u00c7 \u00bd\u00da\u00c4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c4\u00ec\u00c8\u00bd\u00da\u00c4 \u00cc\u00cd\u00a6\u00c9\u00e6\u00be\u00f8 \u00a1\u00e5\u00aa\u008a\u00c9\u00c8 \u00cc\u00ba\u00f1 \u00c0\u00bc\u00be\u00c4 \u00c9\u00be\u00e0\u00be\u00e5\u00c9\u00ec \u00a1\u00bd\u00f1\u00e5\u00ba\u00e0\u0095\u00a8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00a1\u00bd\u00f1\u00c6\u00be\u00c6 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(v) \u00a1\u00e5\u00aa\u008a \u00a1\u00ba\u00c7 \u00cc\u00c4\u00aa\u00fa\u00c6 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(vi) \u00c4\u00be\u00ea\u00cb\u00f1 \u00c9\u00da\u00aa\u00c6\u00e5 \u00a1\u00ba\u00c7 \u00cc\u00e5\u00c4\u00c6 \u00cc\u00cd \u00cc\u00ea\u00cd\u00bc \u00c2\u00c9 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6\u00a8\u00f8\u00d7\u00c4 ;\n\n(vii) \u0081\u00be\u00e7\u00c4 \u00c0\u00e5\u00cc\u00c8\u00a8, \u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u00a8, \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0\u00c3\u00e5\u00c7\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be\u00c6\u00cd\u00e6\u00bc\u00e7\u00d7\u00c4\u00b4 \u00cc\u00ea\u00f3\u00cc\u00ea \u00ca\u00fa\u00cb\u00f1\u00c6\u00be\u00b4 \u00ca\u00fa\u00cb\u00f1\u00ba\u00e0\u00c9 \u00c8\u00c2\u00e5\u00bc\u00fb\u00c4 ;\n\n(viii) \u00a1\u00e5\u00bd\u00e5\u00c7 \u00a1\u00c9\u00ca\u00f1 \u00f3\u00c0\u00e0\u00c0\u00ba\u00e0 \u00ca\u00fa\u00cb\u00f1\u00c6\u00be\u00e0\u00b4 \u00ef\u00c0\u00e5\u00ba\u00e0, \u00a4\u00c0\u00a8\u00c7\u00b8, \u00a1\u00e6\u00df\u008a\u00c0\u00e6\u00ce\u00df\u008a, \u00b8\u00c6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00cd\u00e5 \u00c4\u00ea\u00c8\u00f1\u00c4\u00c6 \u00c0\u00f2\u00ba\u00f8\u00c0\u00e5\u00bc\u00be \u00cc\u00c0\u00c6\u00e5 \u00bc\u00fb\u00ef\u00c4\u00be\u00e0\u00cc\u00cd\u00e5\u00c6 \u00bc\u00e6\u00a8\u00e0\u00d1\u00c4 ;\n\n(ix) \u00a1\u00bd\u00f1\u00e5\u00c0\u00be\u00c6 \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00ef\u00a8\u00ef\u00c7\u00be \u00c0\u00be\u00e0\u00ba\u00f8,\u00ef\u00bc\u00e0\u00ca\u00be, \u00cc\u008a\u00c4\u00be\u00e0\u00ba\u00f2\u00b8 \u00cc\u00cd \u00a1\u00bd\u00f1\u00c6\u00be \u00ae\u00e5\u00d6\u00a8\u00e5 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00cd\u00a3\u00b4 \u00a1\u00bc\u00e5\u00ce \u00ef\u00c9\u00be\u00ba\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8 \u00be\u00f8\u00c7\u00ba\u00d1\u00c4 ;\n\n(x) \u00bc\u00fa\u00ce\u00e8\u00df, \u00c4\u00cd\u00f5 \u00cc\u00cd \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00a1\u00c6\u00b4 \u00cc\u00cd \u00a1\u00be\u00e5\u00bb \u00ce\u00c4\u00c6\u00fa\u00be\u00b4\u00be\u00f8\u00c9\u00e5\u00cc \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 ;\n\n\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00ef\u00c0\u00e5\u00f3\u00c0\u00c7\u00c4\u00e5\u00da\u00bb.\n\n2007 \u00a1\u00e2\u00a8 38 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c3\u00aa\u00c9\u00e5\u00be\u00e0 \u00ca\u00f2\u00e9 \u00cc\u00ba\u00f1 \u00cc\u00e5\u00c6\u00fa\u00c4\u00bd\u00f1\u00c4 \u00c3\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c3\u00e5\u00c7\u00a8\u00e5\u00c7 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a) \u00c0\u00be\u00ba3\n\n. (xi) \u00a1\u00e5\u00c0\u00bc\u00e5\u00c9\u00be\u00e0\u00b4 \u00c0\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00be\u00e0\u00b4 \u0097\u00c6\u00ce\u00e8 \u00a1\u00e5\u00cd\u00e5\u00c7,\u00a8\u00e7\u00c4, \u00a1\u00e6\u00df\u008a \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 ;\n\n(xii) \u00ef\u00c7\u00e5\u00e0\u00aa\u00fb \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00be\u00e0\u00b4 \u00c0\u00f2\u00ba\u00f8\u00a8\u00e5\u00c7 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00e5\u00ef\u00c7\u00e5\u00e0\u00aa\u00f1\u00ca\u00e5\u00c8\u00e5\u00cc\u00cd \u00cc\u00e5\u00c6\u00be \u00a2\u00bc\u00fa \u00a8\u00f8\u00d7\u00c4, \u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 ;\n\n(xiii) \u00ef\u00c7\u00e5\u00e0\u00aa\u00fb \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00be\u00e0\u00b4 \u00a7\u00f0\u00cb\u00bd \u00cc\u00cd \u00ef\u00ef\u00c9\u00bc\u00f1 \u00c0\u00f2\u00ba\u00f8\u00a8\u00e5\u00c7\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 ;\n\n(xiv) \u00ef\u00cc\u00f0\u00a9\u00f1\u00c6, \u00cc\u00c4\u00e5\u00b0 \u00cc\u00ea\u00c3\u00cc\u00e5\u00bd\u00be\u00c6 \u00cc\u00cd \u00cc\u00c4\u00e5\u00b0\u00c0\u00ea\u00be\u00c7\u00e6\u00ba\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4\u00ba\u00e0, \u00ef\u00c7\u00e5\u00e0\u00aa \u00ef\u00c2\u00e5\u00e0\u00d1\u00c4\u00c9\u00ce\u00a8\u00e5\u00c8\u00e9\u00c4\u00b4\u00ba\u00e0 \u00ba\u00eb\u00b6\u00ea\u00ef\u00bc\u00be \u00c0\u00f2\u00bc\u00da\u00ca\u00be \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00cd \u00a3\u00b4\u00a1\u00bc\u00e5\u00ce \u00ef\u00c9\u00be\u00ba\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8 \u00be\u00f8\u00c7\u00ba \u00d1\u00c4 ;\u00cc\u00cd"
