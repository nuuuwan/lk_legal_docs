 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a1\u00e6)\u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00cd\u00e5 \u0097\u00ca\u00e0\u00ef\u00c8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u00cc\u00cd \u00a1\u00bc\u00e5\u00ce \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c7\u00b4\u00ba\u00eb\u00ce \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c2\u00bc\u00e5\u00cd\u00e6\u00d7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u00ea\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba\u00c3\u00e5\u00c9\u00c6,\u0097\u00ca\u00e0\u00c9\u00e5\u00cc\u00be\u00f9\u00c6\u00ba\u00e0\u00c9\u00c6 \u00cc\u00cd \u00c0\u00e8\u00d6\u00c9\u00e6\u00c6 \u00cc\u00c1\u00c8\u00ba\u00e5\u00c9\u00c6 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4;\u00cc\u00cd\n\n(\u00a1\u00e7)\u00b0\u00e5\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c6\u00cd\u00c0\u00ba \u00a4\u00ef\u00bc\u00cc\u00e5 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00c9\u00c8 \u00a1\u00c9\u00c4 \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00c0\u00e8\u00d6\u00c9\u00e6\u00c6\u00b4\u00cc\u00cd \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00c9\u00c8 \u00cc\u00ea\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba\u00c3\u00e5\u00c9\u00c6\u00b4 \u00a1\u00be\u00ea\u00c7\u00e7\u00c0 \u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00b4 \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00ba\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00c9\u00ba\u00f8\u00be \u00c2\u00c9 \u00ba\u00cd\u00c9\u00ea\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4,\n\n\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb."
