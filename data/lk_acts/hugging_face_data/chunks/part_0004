    "chunk_text": "(\u00a7) \u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4 \u00a3\u00ce\u00ba\u008c\u00b4\u00ba\u00c6 (\u00a3\u00d7 \u00b7\u00c9\u00bc\u00c6\u00ba\u00c8\u0081\u00b1\u00af\u00c6\u00b6\u00c8\u00af\u00c6 \u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00cc\u00ba\u00c7\u0081\u00bd\u00c7\u00af\u008c\u00dd\u00b9\u00c6\u0089\u0081\" \u00a4\u00bd\u00c6\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00dd\u008c\u00db\u00ce\u00bd\u00ce\u00ba \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b9\u00b4\u00c6\u00b4 \u0089\u00bb\u00bc\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00ba\u00c8\u0081\u00b1\u00af\u00c6\u00b6\u00c8 \u00a3\u00af\u00ba\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00d7 \u00af\u00c7\u00bd\u00c6\u00de \u00ba\u00c8\u0081\u00b1\u00af\u00c6\u00b6\u00c8\u00af\u00c6 \u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00cc\u00ba\u00c7\u0081\u00bd\u00c7\u00af\u008c\u00dd\u00b9\u00c6\u0089\u0081\" \u00af\u00c7\u00bd\u00c6\u00de \u008c\u00ce\u00b1\u00bb\u00c7\u00c0\u00c8 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00ba\u00b9\u00c6\u00da\u00af\u00bf\u00c6\" \u00a3\u00d7 \u00a7\u008a\u00bc\u00c8\u00bb\u00bd\u00c6 \u00cd\u00b1\u00b6\u00b8\u00af\u00c6 \u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00cc\u00ba\u00c7\u0081\u00bd\u00c7\u00af\u008c\u00dd\u00b9\u00c6\u0089\u0081\" \u00c1\u00df \u00a4\u00af\u00c6\u00af\u00c8\u00b4\u00ba\u00c6\" \u00ba\u00c8\u0081\u00b1\u00af\u00c6\u00b6\u00c8 \u00a3\u00af\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00b7\u00c9\u00bc\u00c6\u00c1\u00bf\u00f2\u00be\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00d7 \u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00ba\u00c7\u00af\u008c\u00dd\u00b9\u00c6\u0089\u0081\" \u00c1\u00df\u00f2\u00be\u00c1\u00bf\u00d9\u00b4\u0081 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b9\u00b4\u00c6\u00b4\u00b7\u00c8\u00ce\u00be\u00ba\u00c7\u00bd\u00c6\u00de\u00b1\u00c6 \u00cc\u00b1\u00bb\u008b\u00b4\u00ba\u00c6) ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(i)\u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u008c\u00c1\u00bc\u00ba\u00c7\u00b8\u00cd\u00c1\u00c7\u00bc\u00c6 \u00a9\u00b7\u00c6\u00b6\u00c8\u00bc\u008c\u00bb\u00be\u00c6\u00c1\u0088\u00c1\u00ce\u00ba\u00b9\u00c6\u00da ;\n\n(ii)\u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00f2\u00be\u00ba\u00c6 \u00b7\u0081\u00ce\u00ba\u00cc\u00b9\u00de\u00cd\u00c1\u00c7\u00bc\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb\u00cc\u00c1\u00c7\u00dd \u00b1\u00f2\u00af \u2013 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc \u00a3\u00bf\u0096\u00d5 ;\n\n(iii)\u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c7\u00b6\u00c6\u00b6\u00c8\u00bb\u00ba\u00c7\u00b8 \u00e9\u00c0\u00be\u00c6\u00b1\u00c7\u00bc\u00c6 \u008c\u00ce\u00bf\u00e2\u00af\u00bf\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7 1990 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u00be\u00c6 47 \u00a4\u00ba\u00c6\u00a5\u00be\u00af\u00c6\u00af\" \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb \u00e9\u00c0\u00be\u00c6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u008a\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00b6\u00c7\u00b8\u00cd\u00c1\u00c7\u00bc\u00c6 \u00a3\u00bd\u00c8\u00af\u00c6\u00ce\u00af ;\n\n(iv)\u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00ba\u00c7\u00b8\u00d7 \u00a9\u00ba\u00c6\u00db\u00ce\u00bd\u008a\u00be\u00c6 \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u00d5\u00cd\u00ba\u00c7 \u00a3\u00ba\u00c6\u00db\u00ce\u00bd\u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00af\u00c7\u00be\u00cc\u00c1\u00be\u00c6\u00ce\u00be\u00ce\u00bb\u00dc\u00ce\u00b4\u00bb\u00cc\u00c1\u00c7\u00dd \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00b6\u00c6 \u00b6\u00c8\u00b4\u00c6\u00b4\u00ba\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 35 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b7\u00c8\u00ce\u00be\u00cc\u00b9\u00de\u00b6\u00d0 \u00c1\u00df \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c628\n\n(\u00a9) \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00ba\u00c7\u00af\u00c7\u00b5 \u00c1\u00df \u00a3\u00ce\u00ba\u00b1\u00c6\u00d2\u00b4\u0081 \u201c\u00cc\u00b7\u00bb\u00c6\u00bb\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00c7\u00be\u00c7\u00b8 \u00c1\u00df\u00b9\u00c6 \u00b9\u00c7\u00c1\u00ce\u00b8\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c6 \u00b1+\u00c6\u00af\u00ba\u00c6\u201d \u00ac\u0081\u00bd\u00c7\u00af\u00b9\u00c6\u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af\" \u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00b7\u0081\u00ce\u00ba\u00cc\u00b9\u00de\u00cd\u00c1\u00c7\u00bc\u00c7\u00af \u00c1\u00bc\u00e2\u00bf\u00c6\u00bf\u00c1\u00bc\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00bd\u00c6 \u00b1\u00ba\u00bc\u00c6\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9+\u00c6\u00af\u00bf\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u0081\u00bd\u00c8\u00b8\u00d7\u00ba\u00c6 \u0089\u00bc\u00b6\u00c8\u00cc\u00bb\u00c7\u0081\u00de ;\n\n(\u00aa) 2002 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 28 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00ba\u00c8\u0081\u00b1\u00c7\u00bc\u00b1\u00c6 \u00b1\u00c9\u00bc\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u0089\u00bd\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00be\u00c6 \u00a7\u00bc\u00c8\u00ba\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00b9\u00c6\u00cc\u00b9\u00de\u00af\u00c8\u0081\u00bd \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00c7\u00b4\u00c6\u0088\u008b\u00dd\u00b7\u00c6\u00d7 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00c8\u008a\u00be\u00c6\u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00b7\u00c6\u00b6\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008a\u0081\u00f2\u00be\u00ba\u00c6 \u008c\u00be\u00af\u00c6\u00af\u00bf\u00c8\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00de \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008a\u0081\u0089\u00bc\u00b6\u00c8\u00cc\u00bb\u00c7\u0081\u00de ;\n\n(\u00ab) \u00b9\u00b7\u00c6\u00b6\u00c8 (\u00a3)\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00da\u008c\u008a\u00bb\u00be\u00c6\u00a5\u00b4\u00b6\u00c6\u00b6\u00c8\u00d9\u00bf\u00c6 \u00c1\u00c7\u00c0\u00c6\u00af\u00c8\u0081\u00bd \u00a3\u00b9\u00c6\u00b9\u00c7\u00c1\u00ce\u00b8\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c8\u0081\u00c1\u00bf\u00e2\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u0089\u00bd\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ba\u00c8\u0081\u00b1\u00af\u00c6\u00b6\u00c8\u00ce\u00bb\u008c\u00b7\u00c8\u00cd\u00bb\u00c7\u00af\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\" 2002 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 28 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00ba\u00c8\u0081\u00b1\u00c7\u00bc \u00b1\u00c9\u00bc\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u008c\u00b7\u00c8\u00cd\u00bb\u00c7\u00af\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\u00a7\u00bc\u00c8\u00ba\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00cc\u00b9\u00de\u00af\u00c8\u0081\u00bd \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00c7\u00b4\u00c6\u0088\u008b\u00dd\u00b7\u00c6\u00d7\u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00c8\u008a\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00b7\u00c6\u00b6\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008a\u0081\u00f2\u00be\u00ba\u00c6 \u008c\u00be\u00af\u00c6\u00af\u00bf\u00c8\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00de \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008a\u0081 \u0089\u00bc\u00b6\u00c8\u00cc\u00bb\u00c7\u0081\u00de ;\n\n(\u00ac) \u0089\u00bd\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ba\u00c8\u0081\u00b1\u00af\u00c6\u00b6\u00c8\u00ce\u00bb \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00af\u00c7\u00bc\u00bc\u00c6\u00a9\u00c1\u00c6\u00c1\u00c7\u00de \u008c\u00b7\u00c8\u00cd\u00bb\u00c7\u00af\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0 \u00a7\u00b4\u00c6\u00af\u00dd\u00d7\u00af\u00c8\u0081\u00bd\u00c7\u00bc\u00c6 \u00a9\u0081\u00b9\u00b6\u00ce\u00b8 \u008c\u00bf\u00af\u00c6\u00d0\u00af\u00c8\u0081\u00bd \u00e7\u00bd\u00c6\u00cc\u00bd\u00c7\u0081\u00de\u00ba\u00c6\" \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00af\u00c7\u00bc\u00bc\u00c8\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7 \u00ba\u00c8\u0081\u00b1\u00af\u00c6\u00b6\u00c8 \u00c1\u00c0+\u00c6\u00af\u00ce\u00be\u00b9\u00c6 \u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00d0\u00b1\u00c6\u00b1\u00ba\u00c6\u00ba\u00b6\u00c8\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00c7\u00c1\u00ce\u00b8\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c8\u0081\u00cc\u00b9\u00bb\u00bc\u00c6\u00af\u00e0\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00c7\u00c1\u00ce\u00b8\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00a3\u00b7\u00c6\u00b6\u00b7\u00c6\u00b6\u00c1\u00bf\u00e2\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u0089\u00bd\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ba\u00c8\u0081\u00b1\u00af\u00c6\u00b6\u00c8\u00ce\u00bb \u00cc\u00af\u00c7\u00ae\u00d5\u00cc\u00b1\u00be\u00c6\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00bf\u00e2\u00af\u00bf\u00c6 \u00a3\u00ce\u00ba\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf\u00da\u008c\u008a\u00be\u00c6 \u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00da \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b9\u00b4\u00c6\u00b4 \u008c\u00b7\u00c8\u00cd\u00bb\u00c7\u00af\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\u00db\u00ce\u00bd\u00ce\u00ba \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb\u00cc\u00c1\u00c7\u00dd \u00b6\u00c8\u00b4\u00c6\u00b4\u00b3\u00c6\u00b1\u00c7\u00bc\u00c6 \u00b9\u00b4\u00db\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081"
  },
