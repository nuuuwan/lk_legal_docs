    "chunk_text": "(3) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00a8\u00eb\u00b4\u00a1\u00c9\u00ca\u00f1 \u00a8\u00c7\u00be \u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a \u00cc\u00cd \u00c0\u00ce\u00c0\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc (\u0097\u00bc\u00f1\u00ea\u00ba\u00e0 \u00a2\u00e2\u00d4\u00ef\u00be\u00e0\u00c7\u00e6 \u00ca\u00fa\u00c8\u00e0\u00c0\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8 \u00ca\u00fa\u00c8\u00e0\u00c0\u00ef\u00c6\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba \u00a8\u00e0\u00ef\u00cb\u00e0\u00ba\u00f2\u00c9\u00c8 \u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00ef\u00aa\u00be)\u00a7\u00c9\u00ea\u00be\u00e0 \u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00f2\u00c4\u00c6 \u00cc\u00cd \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6 \u00cc\u00cd \u00a6\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00be\u00e0 \u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00ef\u008a\u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa \u00c4\u00aa\u00fa\u00be\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c0\u00d6\u00bc\u00fa \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u0097\u00c4\u00da\u00ca\u00be\u00c6\u00a8 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00cc\u00cd\u00e5\u00c6 \u00d1\u00c4\u00b4 \u00a8\u00e6\u00bf\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00a8\u00eb\u00b4 \u2014\n\n(\u00a1)\u00a4\u00c0 \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00c0\u00d7\u00a8\u00e0\u00cb\u00a8\u00c9\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00be\u00f8\u00c8\u00c6\u00b4 \u00c9\u00b6\u00e5 \u00a1\u00b6\u00ea \u00ef\u00be\u00e5\u00c9\u00be\u00be\u00f8\u00c8\u00c6\u00a8 \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00cc\u00c4\u00aa \u00c6\u008a \u00c0\u00d6\u00ca\u00f2\u00c6\u00a8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00dd\u00d1\u00c4\u00cc\u00bf\u00cd\u00e5 ;\n\n(\u00a1\u00e6)\u00cd\u00ea\u00c9\u00c4\u00e5\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00bc\u00ba\u00e0\u00ba\u00c6\u00a8\u00e0 \u00ef\u00cd\u00c8\u00e8\u00a8\u00c7\u00be \u00ef\u00c8\u00cc \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00be\u00f8\u00c6\u00c4 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 ;\n\n(\u00a1\u00e7)\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00be\u00e0 \u00c9\u00e5\u008e\u00a8\u00c9 \u00c0\u00f2\u00ca\u00e0\u00be \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 ;\n\n(\u00a2)\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00ef\u00c8\u00cc \u00a1\u00c9\u00ca\u00f1 \u00c9\u00be\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00cc\u00e8\u00c6\u00f5 \u00ef\u00bc\u00e0 \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5,\n\n\u00c2\u00c8\u00c6 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n2007 \u00a1\u00e2\u00a8 24 \u00bc\u00c7\u00be \u00c0\u00d6\u00aa\u00b8\u00a8 \u00a1\u00c0\u00c7\u00e5\u00bd \u00c0\u00be\u00ba11\n\n(5) \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00c4\u00cc\u00e5 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00c0\u00e5\u00d6\u00ca\u00f2\u0095\u00a8\u00c6\u00a8\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00a8\u00eb\u00b4 \u00ef\u00aa\u00c9\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(6) \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00c9\u00c7\u00bc\u00a8\u00e0 \u0097\u00c4\u00da\u00ca\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00c6\u008a \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00b4 \u00cc\u00cd\u00e5\u00c6\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00a8\u00eb \u00a8\u00e6\u00bf\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7,\u00a6\u00c4 \u0097\u00c4\u00da\u00ca\u00be\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c9\u00ca\u00f1 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00cc\u00e8\u00c6\u00f5\u00cc\u00cd\u00e5\u00c6 \u00c8\u00c2\u00e5\u00bc\u00fb\u00c4 \u00c0\u00ba\u00e0\u00a8\u00c7\u00be \u00c8\u00bc \u00a6\u00c4 \u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u0097\u00c4\u00da\u00ca\u00be\u00ef\u00c6\u00e0 \u00ba\u00f9\u00c7\u00b8\u00c9\u00c8 \u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00c6\u008a \u00be\u00f9\u00ba\u00f8 \u00a8\u00ee\u00ba\u00f1\u00c6\u00a8\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00d1\u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00e0 \u0097\u00c4\u00da\u00ca\u00be \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00c8\u00e8\u00ef\u00c6\u00e0 \u00bc\u00fb \u00ba\u00c4\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00ba \u00cd\u00e6\u00a8\u00f8\u00c6\u008a \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6, \u00bc\u00ba\u00e0\u00ba, \u00a8\u00c7\u00e6\u00b8\u00ea \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a8\u00e5\u00c7\u00b8\u00e5 \u00a6\u00c4 \u00a8\u00ee\u00ba\u00f1\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00cc\u00bf\u00cd\u00e5 \u00c8\u00c2\u00e5\u00bc\u00fb\u00c4 \u00c0\u00ba\u00e0 \u00a8\u00ce \u00a6\u00c4 \u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n18.(1) \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00be \u0097\u00c4\u00da\u00ca\u00be \u00a8\u00e5\u00da\u00c6\u00c6\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5\u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0, \u00c4\u00ef\u00cd\u00e0\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00a1\u0093\u00a8\u00e5\u00d6 \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00c4\u00ba \u00c9\u00ec \u00c2\u00c8\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0, \u00a6\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0\u00a8\u00c7\u00be \u00a2\u00c8\u00e0\u00f5\u008a \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00c4\u00ba \u2014\n\n(i) \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00ef\u00aa\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5\u00bc\u00e5\u00c6\u00a8 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6\u00cc\u00cd \u00cd\u00ea\u00c9\u00c4\u00e5\u00c7\u00e6\u00c9\u00be \u00bc\u00ba\u00e0\u00ba \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u0081\u00be\u00e7\u00c4 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00a8\u00e0\u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 ;\n\n(ii) \u00ef\u00cc\u00e0\u00c9\u00e5\u00bc\u00e5\u00c6\u00a8 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00cc\u00cd \u00cd\u00ea\u00c9\u00c4\u00e5\u00c7\u00e6\u00c9\u00be \u00bc\u00ba\u00e0\u00ba \u00bc\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c6\u008a \u0097\u00f3\u00c8\u00e8 \u00ef\u00cd\u00e5\u00e0 \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00cc\u00e2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u0081\u00be\u00e7\u00c4 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb \u00a1\u00ba\u00c7\u00c4\u00aa \u00c2\u00e5\u00bd\u00e5 \u00c0\u00e6\u0095\u00b8\u00d1\u008a \u00ef\u00cd\u00e5\u00e0\u00a6\u00e0\u00c9\u00e5 \u00a1\u00ba\u00e0\u00c0\u00ba\u00e0 \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4,\n\n\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9 \u00bc,\u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u0093\u00a8\u00e5\u00d6 \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9 \u00bc, \u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c8\u00ba\u00c8 \u00cc\u00e8\u00c6\u00c8\u00e0\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0\u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u2014\n\n(\u00a1) \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00b4 \u00a1\u00c9\u00ca\u00f1 \u0097\u00c4\u00da\u00ca\u00be\u00ef\u00c6\u00e0 \u00cd\u00bc\u00fa\u00cc\u00e8 \u00c3\u00e5\u00c9\u00c6 ; \u00cc\u00cd"
