    "chunk_text": "(2) \u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00ce\u00ba\u00bb \u00b7\u00c9\u00b6\u00c8\u00c1\u00c7\u0081\"1979 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 15 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00d0\u00bd\u00c6\u00bd\u008c\u00bb\u00be\u00c6 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00db\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c6 XI \u00a9\u0081\u00b9\u00b6\u0081\u00b7\u00c8\u00bb\u00b6\u00c8\u00af\u00bf\u00c8\u0081\u00b9\u0088 \u00b7\u00b4\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00da\u00be\u00b8\u00c7\u00bb\u00c6\u008c\u0081\u00cd\u00b9\u00c7\u00d7 \u00b1\u00c7\u00b4\u00c6\u00b1\u00c8\u00af\u00c6\u00af\u00c7\u00bc\u00bc\u00c7\u00be\u00c6 \u00a3\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00e7\u00bd\u00c6\u00ce\u00bd\u00af\u00c6 \u00d0\u00bd\u00c6\u00bd\u00b3\u00c6\u00b1\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00dd\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u00db\u0081\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00c7\u00b4\u00c6\u00b1\u00c8\u00af\u00c6\u00af\u00c7\u00bc\u00bc\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00c1\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00b1\u00c7\u00b4\u00c6\u00b1\u00c8\u00af\u00c6\u00af\u00c7\u00bc\u00bc\u00c8\u0081 \u00db\u0081\u00b8\u00c8\u00ce\u00be\u008a\u00df\u00ba\u00c6 \u00a3\u00c1\u00dd\u00af\u00c6\u00d0\u00af\u00c6 \u00cd\u00af\u00b4\u00c6\u00d0\u00ba\u00c6 \u008c\u00b6\u00b6\u00c6\u00b6\u00c8\u00df\u00ba\u00c6 \u00c1\u00c7\u00b1\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c7\u00b1\u00c8\u00af\u00c6\u00af\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u008c\u00b6\u