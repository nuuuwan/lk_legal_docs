    "chunk_text": "(6) \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c6 \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00b7\u00c8\u00bb\u00b6\u00c8\u00af\u00bf\u00c8\u0081\u00b9\u0088 \u00c1\u00bc\u00c8\u00af\u00c6\u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b6\u00c6 \u00b6\u00c1\u00de\u00af\u00c8\u0081\u00bd\u008c\u00b4\u00b6\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 (2)\u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u00af\u00c6\u00d0 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ce\u00bb \u00a3\u00d9\u00b9\u00c6\u00b9\u00b6\u00c6 \u00b6\u00c1\u00de\u00af\u00c8\u0081\u00bd\u008c\u00b4\u00b6\u00c6\u00d7 \u00a3\u00c1\u00bc\u00c6 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c7\u00bf\u00c6\" \u00b6\u00c1\u00ce\u00b5 \u00b6\u00c1\u00bd\u00c8\u00bb\u00c1\u00bc\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081\" \u00c1\u00bc\u00c8\u00a3\u00bd\u0096\u00d5 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6 \u00b9\u00c7\u00b8 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\"\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b6\u00c1\u00ce\u00b5\u00b6\u00c1\u00de\u00ce\u00af\u008a\u0081\u00ba\u00c9\u00d7 \u00a3\u00b6\u00bd\u00c6\u00af\u00c8\u00b5+\u00c6\u00af \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n8\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 76 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2\" \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081(1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00bd\u00c6\u00af\u00c7\u00b8 \u00f2\u0081\u00bd\u00c7\u00c1\u00d7 \u00af\u00c7\u00b9\u00c6\u00da\u00c1\u00c7\u00b1\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\"\u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00c0+\u00c6\u00af\u00be\u00c6 \u00a9\u00c1\u00c6\u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u00be\u00c6 \u008c\u00be\u00af\u00c6\u00af\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c0+\u00c6\u00af\u00be\u00c7\u00af (\u00db\u00b1\u00c6\u00b1\u00af\u00c6\u00af\u00bc \u00c1\u00ae\u0088\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00b6\u00c6\u00b6\u00ce\u00af \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00b6\u00be\u00c6\u00c1\u00b1\u00b6\u00c8\u00af\u00ce\u00bf \u00c1\u00c0+\u00c6\u00d0\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00bd\u008c\u00bc) \u0089\u0081\u00b8\u00bc\u00c6 \u00c1\u00dd\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00c0+\u00c6\u00af\u00be\u00c6\" 2006 \u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00bc\u00c6 31\u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0 \u00db\u0081\u00b8\u00bc\u00c6 \u008c\u00be\u00af\u00c6\u00af\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00c0+\u00c6\u00af\u00be\u00c7\u00af\u00c1\u00b7\u00c6\u00b6\u00c7\u00be\u00c6\"\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a9\u00ae\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00bd\u00c6\u00bd\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008176 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 14 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c614\n\n9\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b8 \u00db\u00b6\u00be\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\"\u00a3\u00b6\u0081 \u00b9\u00c7\u00af\u00ba\u00c6 II\u00a5\u00be\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00bd\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n(1) \u00a3\u00c1\u00c6\u00c1\u00b4\u00c6\u00b4\u00ce\u00b5\u008a\u0081 (\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 -\n\n(\u00a3) (i)\u008c\u00b4\u00bb\u00ba\u00c6 (vi)\u00a5\u00be\u00c6\" \u201c\u00c1\u00c7\u00d9{\u00bc\u00c6\u00b6\u00c8 \u00a9\u00bc\u00c8\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00af\u00b9\u00c6\u00b9\u00be\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8 \u00a9\u00ae\u00cc\u00b5\u00bb\u00c6\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u201c\u00c1\u00c7\u00d9{\u00bc\u00c6\u00b6\u00c8 \u00a9\u00bc\u00c8\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\" \u00af\u00b9\u00c6\u00b9\u00be\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8\u00a9\u00ae\u00cc\u00b5\u00bb\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a5\u00ce\u00b1\u00c1\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a7\u00b5\u00e2\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u008c\u00c1\u00bc\u00b5\u00b6\u00c6\u00b6\u00c8\u0081 2710.19.60\u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a9\u00bc\u00c8\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u00a9\u00ae\u00cc\u00b5\u00bb\u00c6\"\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a9\u00ae\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6\u00b0\n\n(ii)\u008c\u00b4\u00bb\u00ba\u00c6 (vii)\u00a5\u00be\u00c6\" \u201c\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u0089\u00cd\u00bd\u00bb\u00c6\u008b\u00a9\u00e1\u00d7\u00ba\u00c6 \u00b9\u00be\u00ce\u00af\u00af\u00bf\u00c6 ;\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u201c\u0089\u00cd\u00bd\u00bb\u00c6\u008b \u00a9\u00e1\u00d7\u00ba\u00c6\u00b9\u00be\u00ce\u00af\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00b7\u00c6\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u0081\u00ba\u00c9\u00d7\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00cd\u00c1\u00ae\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b7\u00c8\u00c1\u00c7\u00bc\u00b5\u00b6\u00c6\u00b6\u00c8\u0081 \u00a3\u00bf\u00ce\u00c1\u00af\u00c6 \u00af\u00c1\u00b8\u00b6\u00c6\u00d7\u00b4\u00c6\u00cc\u00af\u00c7\u00ae\u00d5\" \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00ce\u00c1\u00dc\u00ba\u00c6\" \u00a5\u00bb\u00be\u00c7\u00ce\u00ba\u00af\u00c6\u00d0\u00b4\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b9\u00ce\u00c1\u00dc\u00ba\u00c7\u00b8\u00cd\u00c1\u00cc\u00bd\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c6;\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6\u00b0\n\n(\u00a4) \u008c\u00b4\u00bb\u00ba\u00c6 (xiv)\u00ab \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8\u00b1\u00c6\u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :-\n\n\u201c(xv) \u00a5\u00bd\u00c7\u00be\u00c6\u00af\u00bf\u00c6.\u201d;\n\n(2) \u00a3\u00b6\u0081 (\u00a4) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 -\n\n(\u00a3) \u008c\u00b4\u00bb\u00ba\u00c6 (xvi)\u00ab \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8\u00b1\u00c6\u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :-\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b8 \u00db\u00b6\u00be\u00c7\u00ba\u00c6\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00ce\u00bb\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 14 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c615"
