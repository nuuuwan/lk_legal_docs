    "chunk_text": "\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\n\n2007 \u00a1\u00e2\u00a8 51 \u00bc\u00c7\u00be \u00aa\u008a\u00c0\u00cd \u0097\u00a8\u00f2\u00c4\u00e5\u00c7\u0083\u008e \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u00ca\u00fa\u00a8\u00e0\u00cb\u00b8 \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8 (\u00c0\u00e6\u00c9\u00d7\u00ef\u008a) \u00c0\u00be\u00ba\n\n\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00be\u00f8\u00c6\u00c4\u00c6 \u00c0\u00d6\u00bc\u00fa \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00fb\n\n[\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00ef\u00ce\u00e0 2007 \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u00c2\u00da \u00c4\u00cc 23 \u00c9\u00be \u00bc\u00fa\u00be]\n\n2007 \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u00c2\u00da \u00c4\u00cc 26 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0II \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00a1\u00ba\u00f8\u00ef\u00da\u00a8\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00c8 \u00a8\u00c7\u00be \u00c8\u00bc\u00fb.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00c4\u00ea\u00f7\u00b8 \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00fb.\n\n\u00ef\u00a8\u00e5\u00ce\u00c5 5, \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be \u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00ef\u00c6\u00be\u00e0 \u0095\u00ce\u00bc\u00fb \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u00c6.\u0095\u00ce : \u00c7\u00e6. 4.00 \u00c6\u00fa.\u00ba\u00e6\u00c0\u00e6\u00c8\u00e0 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 : \u00c7\u00e6. 5.00 \u00c6\u00fa\n\n2007 \u00a1\u00e2\u00a8 51 \u00bc\u00c7\u00be \u00aa\u008a\u00c0\u00cd \u0097\u00a8\u00f2\u00c4\u00e5\u00c7\u0083\u008e \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u00ca\u00fa\u00a8\u00e0\u00cb\u00b8 \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8 (\u00c0\u00e6\u00c9\u00d7\u00ef\u008a) \u00c0\u00be\u00ba1\n\n2\u2014P L 001975-3,600 (2007/05)\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6 \u00cc\u00cd\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00ef\u008a\u00bc\u00fa\u00be\u00c6.\n\n\u00c0\u00ec\u00da\u0097\u00a8\u00e5\u00c9.\n\n[\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00ef\u00ce\u00e0 2007 \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u00c2\u00da \u00c4\u00cc 23 \u00c9\u00be \u00bc\u00fa\u00be]\n\n\u00a6\u00c8\u00e0.\u009c.\u2014\u0081.62/2005\n\n\u00aa\u008a\u00c0\u00cd \u0097\u00a8\u00f2\u00c4\u00e5\u00c7\u0083\u008e \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00ca\u00e8\u00a8\u00e0\u00cb\u00b8 \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8 \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u00b4 \u00c0\u00e6\u00c9\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd \u00a3\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00be\u00ea\u00cb\u00e2\u00aa\u00fa\u00a8 \u00a8\u00e5\u00c7\u00b8\u00e5 \u00cc\u00bf\u00cd\u00e5 \u00bc \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00e6\u00c8\u00e6\u00cc\u00e0\u00d1\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00c9\u00ec\u00c0\u00be\u00ba\u00a8\u00f8.\n\n\u00aa\u008a\u00c0\u00cd \u0097\u00a8\u00f2\u00c4\u00e5\u00c7\u0083\u008e \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u0097\u00bc\u00f1\u00e5\u00c8\u00c6 \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00cd\u00e5 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u00a8\u00e0 (\u00ef\u00c4\u00cd\u00e8 \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u201d\u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be ) \u00aa\u008a\u00c0\u00cd \u0097\u00a8\u00f2\u00c4\u00e5\u00c7\u0083\u008e \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u0097\u00bc\u00f1\u00e5\u00c8\u00c6 \u00c6\u00be \u00be\u00e5\u00c4\u00c6 \u00cd\u00e5 \u00a1\u00c3\u00e8\u00bd\u00e5\u00be\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 1982 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be\u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00cd\u00c6\u00e8\u00be\u00e0 \u00bc :\n\n\u00ef\u00ef\u00c9\u00bc\u00f1 \u00ca\u00fa\u00cb\u00f1\u00c6\u00be\u00e0 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd \u00ef\u00c7\u00e5\u00e0\u00aa\u00fb\u00be\u00e0\u00b4 \u00ef\u00be\u00e5\u0095\u00ef\u00c8\u00e0\u00ef\u00ef\u00c9\u00bc\u00f1 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00cc\u00e6\u00c0\u00c6\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00ca\u00e8\u00a8\u00e0\u00cb\u00b8 \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8\u00a8\u00e0 \u00a6\u00a8\u00f9\u0097\u00bc\u00f1\u00e5\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00e5 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00c6\u00e8\u00be\u00e0 \u00cc\u00cd\u00a6\u00a8\u00f9 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00a6\u00a8\u00f9 \u00ca\u00e8\u00a8\u00e0\u00cb\u00b8\u00ef\u00c7\u00e5\u00e0\u00cd\u00c8 \u00a6\u00a8\u00f9 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00c9 \u00c0\u00e6\u00c9\u00ba\u00eb\u00be\u00ea \u00ef\u00cd\u00c6\u00fa\u00be\u00e0 \u00bc :\n\n1978 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8 \u00c0\u00be\u00ef\u00ba\u00e0 24 \u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c9\u00ec \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a6\u00a8\u00f9 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6 \u00a4\u00cc\u00cc\u00e0 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec\u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00ef\u00aa\u00be \u00a8\u00e6\u00ce\u00b8\u00e8\u00c6 \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u00b4 \u00a1\u00be\u00ea\u00c2\u00bc\u00e0\u00bd\u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00cd\u00c6\u00e8\u00be\u00e0 \u00cc\u00cd \u00a6\u00cd\u00fa \u00c0\u00f2\u00ba\u00f8\u00a6\u00c8\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a6\u00cd\u00fa \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u00ca\u00fa\u00a8\u00e0\u00cb\u00b8 \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8 \u00a6\u00a8\u00f9 \u00a8\u00e6\u00ce\u00b8\u00e8\u00c6 \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u00b4 \u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00ef\u00cd\u00c6\u00fa\u00be\u00e0 \u00bc :\n\n\u00a6\u00a8\u00f9 \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00ca\u00e8\u00a8\u00e0\u00cb\u00b8 \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8 \u00c0\u00c9\u00c7\u00e5\u00ef\u00aa\u00be \u00a6\u00c6 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6\u00a8\u00c7\u00be \u00ef\u00c8\u00cc \u00a6\u00a8\u00f9 \u00a8\u00e6\u00ce\u00b8\u00e8\u00c6 \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c7\u00b0\u00ef\u00c6\u00be\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e5\u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00c6\u00e8\u00be\u00e0 \u00cc\u00cd \u00a6\u00ef\u00cc\u00e0 \u00c0\u00e6\u00c9\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00e6\u00c8\u00e6\u00cc\u00e0\u00d1\u00c4 \u00c4\u00cd\u00b0\u00be\u00c6\u00cd\u00c0\u00ba \u00cc\u00bf\u00cd\u00e5 \u00c9\u00be \u00ef\u00cd\u00c6\u00e8\u00be\u00e0 \u00bc:\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c4\u00ef\u00cc\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089:\u2014"
