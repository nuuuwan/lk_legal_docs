+\u00c6\u00af \u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00b4\u00df\u00c1\u00be\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00be\u00c7\u00ba\u00c6\u00b0\n\n\u008c\u00ce\u00be : \u00f4\u00b9\u00c7 13\u00b075\u00b6\u00b9\u00c7\u00bd\u00c6 \u00cc\u00b1\u00be\u00e2 : \u00f4\u00b9\u00c7 5\u00b025\n\n(\u00c1\u00ce\u00be\u00b9\u00c6\u0089\u00b8\u00c6\u00b8\u00be\u00c6 \u00ba\u00c7\u00bd\u00c6\u00de\u00db\u00ce\u00bd)\n\n1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 37 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c61\n\n\u00d2\u00dd\u00af\u00c6\u00af\u00b9\u00c6 \u00cc\u00b9\u00bb\u00c7\u00c6\u00b0\n\nH-022545\n\n\u00ac\u00dd \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6\u00d7\u00ce\u00b5\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081\u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00bc\u00c7\u00bb\u00ba\u00ce\u00b4\u00b7\u00c6\u00b6\u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u008b\u0081\u00a3\u00be\u00c6\u00be\u00d7\u00a8\u00b8\u00db\u00bd\u00c6\u00bd\u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u008b\u0081\u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00b8\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b0\n\n[1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00ac\u00bd\u00c6\u00cd\u00bd\u00c7\u00b9\u00c7\u00c6 \u00ba\u00c7\u00b6\u00ba\u00c6 22 \u00a4\u00b7\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00b0 ]\n\n\u00b1\u00b0\u00c1.\u2013\u2013\u00ad. 35/98.\n\n\u00b6+\u00c6\u00af\u00ce\u00bf\u00b9\u00c6 \u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b6\u00c6\u00d7\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf \u00a5\u00bb\u00be\u00c7\u00b6\u00c1\u00c7\u00c6\u00af\u00bf\u0