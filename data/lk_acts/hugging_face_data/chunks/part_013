    "chunk_text": "(ii)\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b9\u00d5 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8 \u00db\u0088\u00e2\u00bd\u00c6\u00bd\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a5\u00bc\u00ae\u00b4\u00c7\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00c8\u00b7\u00c6\u00b6\u00c7\u00ba\u00be\u00c6\u00b0\n\n\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n\u00a1 (\u00a5) \u00b9\u00b7\u00c6\u00b6\u00c8 (\u00a3) \u008c\u0081 \u00af\u00c9\u00c0\u00c7\u00b8 \u00db\u00ce\u00bd\u00b9\u00c6\u00b9\u00c7\u00cc\u00b4\u00c7\u0081\u00de \u00a9\u00d7\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u00a5\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081, \u00db\u00ce\u00bd\u00b9\u00c6\u00b9\u00c7\u00b4\u00c6\u00b4\u00c7\u00bf\u00c7\u00c8\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00b6\u00c7\u00b8\u00b1\u00b6\u00c6\u00b6\u00c8\u00bb\u00af\u00c6 \u00af\u00b4\u00b6\u00c7\u00b1\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00a4\u00b6\u00c7\u00bc\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00df\u00ba\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(\u00a7) \u00b9\u00b7\u00c6\u00b6\u00c8 (\u00a6) \u00a5\u0081 \u00af\u00c9\u00c0\u00c6 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00dd\u00af\u00c6\u00d0 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a3\u00ce\u00c0\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00a3\u00b7\u00c6\u00b6 \u00a4\u00e0\u00af\u00c6\u00d0 \u00cd\u00b7\u00bc\u0088\u00bb\u00c7\u00af\u00b1\u00c6 \u00cd\u00b1\u00c7\u00c6\u00b9\u00c6\u00b9\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b7\u00c6\u00b6 \u00a4\u00bf\u00c6 \u00af\u00ce\u00b4\u00b1\u00c8\u00bb\u00c7\u00af \u00c1\u00b1\u00c8\u00b6\u00c6\u00b6\u00b6\u00c7\u00af\u00a3\u00bd\u00c8\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00c1\u00c8\u00b4\u00c6\u00d5\u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(\u00a8) \u00b9\u00b7\u00c6\u00b6\u00c8 (\u00a6) \u00a5\u0081 \u00af\u00c9\u00c0\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00db\u0081\u00b8\u00c7\u00c6\u00cd\u00b6\u00c7\u0081\u00de\u00ba\u00c6\u00b9\u0088 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008c\u00b4\u00c6\u00b4\u00ce\u00c0\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c7\u00bf\u00c6,\u00a3\u00ce\u00c0\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00af\u00c6\u00d0 \u00a5\u00b5\u00af\u00c6\u00af\u00ba\u00c7\u00af \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00cd\u00b6\u00c7\u0081\u00de\u00c1\u00b6\u00bd\u00c6\u00d0\u00b6\u00c6 \u00b6\u00c1\u00de\u00c1\u00c7\u00bc\u00c7\u008a\u0081, \u00a3\u00c1\u00ce\u00bc\u00af\u00c6 \u00ce\u00af\u00d7 \u00cc\u00b1\u00bb\u00c6\u00d7 \u00a3\u00b6\u0081\u00db\u0081\u00b8\u00c7\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00c1\u00dd\u00c1\u00b6\u00bd\u00c6\u00d0 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6 \u0089\u0088\u00bb\u00c7\u00ce\u00b5\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(13) (\u00a3) \u00b9\u0081\u00b8\u00c8\u00cc\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u00c1\u00c8\u00b8\u00c6 \u00af\u00c9\u00c0\u00c7\u00b8\u00db\u00ce\u00bd\u00b9\u00c6\u00b9\u00c7\u00b4\u00c6\u0088\u0081 \u00cd\u00af\u00b4\u00c6\u0089\u0081\u00ba\u00c9\u00d7, \u00a9\u00b7\u00c6\u00b6\u00c6\u00b6 \u00b6\u00c1\u00de\u00af\u00c6\u00af\u00c7\u00b8\u00b7\u00c8\u00bb\u00b6\u00c8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00db\u00ce\u00bd\u00bb\u00c7\u00b8 \u00b6\u00ae\u00b4\u00ba\u00c6 \u00ba\u00bd\u00c8\u00bb\u00bd\u00c6\u00bd\u00ae\u00b4\u00b8\u00bf\u00bb\u00c7\u00af\u00dc\u00bf\u00c6\u00bf\u00cd\u00b6\u00c7\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00ce\u00b8 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6\u00b6\u00c6 \u00b6\u00c1\u00de\u00af\u00c6\u00d0\n\n71999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 47 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00d0\u00bd\u00c6\u00bd\u008c\u00bb\u00be\u00c6\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00db\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00c7\u00c6 \u00d0\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c9\u00c7\u00c6\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00c7\u00cc\u00bc\u0081\u00de\u00ba\u00c6, \u00a9\u00b7\u00c6\u00b6\u00b6\u00c6\u00b6\u00c1\u00de \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u0089\u00be\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6 \u00b7\u00c8\u00de\u00b6\u00c6\u00b6\u00c8\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b6\u00c6\u00b6\u00c9\u00c7\u00c6\u00b9\u00cc\u00b9\u00c7\u00b8\u00c6\u00ce\u00bd \u00c1\u00c8\u00b6\u00c8\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6\u00b6\u00c6 \u00b6\u00c1\u00de \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u00b9\u00c7\u00b8\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b9\u00d5 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081\u00cd\u00b9\u00c7\u00d7 \u00b6\u00c1\u00bd\u00c7\u00b8\u00d7 \u00da\u00c7\u00c8\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cc\u00b6\u0081\u00de\u00ba\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6 \u00b6\u00c8\u00dd\u00b9\u00c6\u00b6\u00c8\u00b9\u00c6\u00b9\u0088\u0081, \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c7\u00b8\u00d7,(7) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u00be\u00c6 \u00a9\u00d7 \u00a9\u00b9\u00c6\u00b9\u0088\u008a\u00dd\u00b9\u00c6\u00b9\u00c8\u00d9\u00ba\u00c6, -\n\n(i) \u00b7\u00c8\u00de\u00b6\u00c6\u00b6\u00c8\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b6\u00c6\u00b6\u00c9\u00c7\u00c6\u00b9\u00c6\u00ce\u00b9 \u00a3\u00be\u00c6\u00be\u00d7\u00b9\u00d0\u00b6\u00c8\u00bb\u00bf\u008c\u00be\u00c7\u00b8 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b6\u00c6\u00b6\u00c9\u00c7\u00c6\u00b9\u00c6\u00ce\u00b9 \u00ba\u00c9\u00b4\u00c6\u00d5 \u00a3\u00b6\u00ce\u00b8\u00a3\u00d9\u00b9\u00c1\u00c8\u00af\u00c6\u00d0\u00ba\u00c6\u00b9\u0088 \u00b6\u00c1\u00bd\u00c7\u00bf\u00dd\u00af\u00c6\u00d0\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008a\u00b4\u00be\u00c7\u00ba\u00c6 ;\u00a3\u00be\u00c6\u00be\u00d7\n\n(ii) \u00b7\u00c8\u00de\u00b6\u00c6\u00b6\u00c8\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b6\u00c6\u00b6\u00c9\u00c7\u00c6\u00b9\u00c6\u0089\u0081 \u00b9\u00c7\u00af\u00b6\u00c6\u00ce\u00b6\u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00d0\u00b6\u00c8\u00bb\u00bf\u008c\u00be\u00c7\u00b8 \u00a3\u00ae\u00b4\u00ce\u00b8\u00b6\u00c6\u00b6\u00c9\u00c7\u00c6\u00b9\u00ce\u00b9\u00ba\u00c9\u00b4\u00c6\u00d5 \u00a3\u00b6\u00ce\u00b8 \u00a3\u00d9\u00b9\u008c\u00af\u00c6\u00d0\u00ba\u00c6\u00b9\u0088 \u00b6\u00c1\u00bd\u00c7\u00bf\u00dd\u00af\u00c6\u00d0\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008a\u00b4\u00be\u00c7\u00ba\u00c6 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(iii) \u00db\u00e1\u00ce\u00ba\u00bb\u00c7\u00af \u00b7\u00c8\u00de\u00b6\u00c6\u00b6\u00c8\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b6\u00c6\u00b6\u00c9\u00c7\u00c6\u00b9\u00c6\u0089\u0081 \u00c1\u00c8\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6, \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b6\u00c6\u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7\u00b9\u0081\u00b8\u00c8\u00cc\u00bc\u00ae\u00d5 \u00ba\u00c7\u00b6+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u0089\u00b7\u00c6\u00b6\u00c7\u00b6 \u00ac\u00dd\u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b9\u00d5 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00ce\u00bb \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6 ;\u00a3\u00be\u00c6\u00be\u00d7\n\n(iv) \u00b7\u00c8\u00de\u00b6\u00c6\u00b6\u00c8\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b6\u00c6\u00b6\u00c9\u00c7\u00c6\u00b9\u00c6\u00da \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u00b9\u00c8\u00be\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00cc\u00bb\u00b6\u00ce\u00b8\u00dc\u00ba\u00c6 \u00a4\u00af\u00c6\u00af\u00c7\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00cd\u00b1\u00c7\u00c6\u00b7\u00c6\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c8\u0081\u00ba\u00c9\u00d7 \u00a5\u00dd\u00b9\u00b6\u00c6\u00ce\u00b6\u00bb\u00c7\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00ce\u00bd \u00c1\u00c8\u00b6\u00c8\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n(\u00a4) \u00b7\u00c8\u00de\u00b6\u00c6\u00b6\u00c8\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00ba\u00bd\u00c8\u00bb\u00bd\u00c6\u00bd\u00ae\u00b4\u00ce\u00b8\u00af\u00c6 \u00af\u00c7\u00be\u00b6\u00c6\u00ce\u00b6\u00a3\u00d9\u00b9\u008c\u00af\u00c6\u00d0\u00ba\u00c6\u00b9\u0088 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6 \u00b6\u00c1\u00bd\u00c7\u00bf\u00c7\u00c6 \u00ac\u00dd\u00c1\u00dd\u00af\u00c6\u00d0(\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081\u00af\u00c9\u00c0\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008a\u0088\u0081, \u00a3\u00af\u00c6\u00af\u00c7\u00be\u00ba\u00c7\u00b8\u00d7,\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6 \u00cd\u00c1\u00de\u00c1\u00ce\u00af\u00bb\u00c7\u00af\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008a\u00b4\u00c6\u00b4\u00c7\u00cc\u00be\u00c7\u00c0\u00c8\u00bb\u00b0\n\n(i) \u00a7\u00b4\u00b8\u0088\u00bb\u00c7\u00af \u00a3\u00d9\u00b9\u008c\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\u00a3\u00b6\u00c6\u00d7\u00b4\u0081"
  },
