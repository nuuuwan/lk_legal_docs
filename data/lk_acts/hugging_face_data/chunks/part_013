    "chunk_text": "\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c\u00c4\u00ea\u00f7\u00e5\u00c9.\n\n\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00ae\u00e2\u00ae\u00c8 \u00ef\u00cd\u00e5 \u00be\u00f8\u00ca\u00e0\u00ae\u00c8\u00ef\u00bc\u00e0\u00c0\u00ce \u00bc\u00e6\u00d6\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c2\u00c9.\n\n\u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00cd\u00e5\u00a1\u00be\u00f1\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4.\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n\u00c0\u00bc\u00be\u00c4 \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00aa\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00cc\u00cd\u00c0\u00bc\u00be\u00c4\u00b4 \u00a1\u00c6\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00b8\u00c6.\n\n\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 (5(2) \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\n\n\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0/ \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8 :\u00cb\u00e5\u00ef\u00c9\u00e5\u00e0, \u00c6\u00ec \u00c9\u00ea\u00e2\n\n\u0097\u00bd\u00e5\u00c6\u00a8 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb :\u00a6\u00bc\u00fa\u00d6\u00d1\u00c7 \u00ef\u00c0\u00f2\u00e0\u00c4\u00c7\u00ba\u00e0\u00be \u00c4\u00cd\u00ba\u00e5\n\n\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00e6 :\u00a8\u00e2, \u00ef\u00cd\u00e5\u00e0- \u00c8\u00e8\u00be\u00e0f\u00c0\u00e2 \u00a8\u00e0\u00c9\u00e2-\u008e\u00e2\u0090\u00ef\u00cc\u00e2, \u0090-\u00c8\u00c6\u00fa\u00c8\u00e8\u00be\u00e0, \u00cb\u00e5\u00be\u00e0 - \u00ef\u00b4\u00ef\u00ae\u008a, f\u00c0\u00ec - \u00ef\u00cb\u00f0\u00c0\u00ec\u00b0\u00f1 \u00cd\u00c8\u00e0\u00c9\u00ba\u00eb\u00ef\u00da \u00a1\u00cc\u00e0\u00cc\u00d4 \u00cd\u00fa\u0095\u00c0\u00ec\u00b0\u00f1 \u00a8\u00f8\u00ba\u00c8\u00aa\u00c4 \u00c0\u00e8\u00c6\u00ba\u00f8\u00cc\u00e0\u00cc \u00cd\u00fa\u0095\u00a8\u00eb\u00c5\u00ea\u00c7\u00e6\u00aa\u00c4\u00ea\u00ef\u008a \u00c4\u00cd\u00e5\u00be\u00e5\u00aa \u00cd\u00fa\u0095\u00cc\u00ea\u00be\u00f8\u00c8\u00e0 \u00a4\u00ef\u0089\u00cc\u00e8\u00d6 \u00c4\u00cd\u00ba\u00e5\n\n\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c0\u00be\u00ba\u00e0 \u00ef\u00a8\u00b4\u00ea\u008a\u00c0\u00ba\u00e0\u00c9\u00c8 \u00cc\u00cd \u00c0\u00be\u00ba\u00e0\u00c9\u00c8 \u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00bc\u00e5\u00c6\u00a8 \u0095\u00ce (\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6) \u00c7\u00e6.870 \u00a8\u00f8.(\u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6) \u00c7\u00e6.1,160 \u00a8\u00f8. \u00a1\u00e2\u00a8 32, \u00b4\u00f2\u00e5\u00be\u00e0\u00cc\u00e0\u00c9\u00da\u00a8\u00e0\u00cc\u00e0 \u00c4\u00be\u00e0\u00bc\u00fa\u00c7\u00c6, \u00ef\u00c8\u00e5\u00e0\u00b4\u00cc\u00e0 \u00c0\u00e5\u00c7, \u00ef\u00a8\u00e5\u00ce\u00c5 01, \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be\u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00a1\u0093\u00a8\u00e5\u00d6 \u00ef\u00c9\u00ba \u00cc\u00e7\u00c4 \u00c9\u00da\u00cb\u00c6\u00a8\u00c4 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 15 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00aa\u00c9\u00e5 \u00c0\u00cc\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0\u00c9\u00e5 \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8\u00c6."
