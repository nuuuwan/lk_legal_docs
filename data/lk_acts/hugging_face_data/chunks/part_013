    "chunk_text": "(\u00a9)\u00b1\u00c8\u00de \u00ce\u00af\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00ba\u00c7\u00b5\u00c1\u00bc\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00b9\u008a\u00bd\u00c6\u00de\u00c1\u00d7\u00b4\u0081 \u00a3\u00c1\u00bc\u00c6\u00af\u00ce\u00bf \u00b7\u00bd\u00c6\u00d0\u0088\u00ba\u00af\u00c6\u00af\u00bf\u00c7\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af\u00a3\u00c1\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00b7\u00c8\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00a7\u00b6\u008c\u00af\u00ce\u00bf \u00a3\u00bf\u00c8\u00b6\u00c6\u00b6\u00be\u00c6;\n\n\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00cc\u00b9\u00c7\u00d7\u00af\u00c6\u00d0\u00bd\u00c8\u00af\u00c6 \u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00bf\u00c6\u00b0\n\n31999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 23 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00ba\u00c4\u00d8\u00c1\u00bc \u00cc\u00b9\u00bf\u00b6\u00c6\u00b6\u008c\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7 \u0093\u00b4\u00c6\u00b4\u00bb (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(\u00ac)\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00ce\u00bf \u00db\u0081\u00cc\u00b8\u00d5\u00b6\u00c6\u00d7\u00b1\u00c6\u00cc\u00b1\u00be\u00c6\u00c1\u00b6\u00c8\u00be\u00c6 \u00a6\u00d5\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u0089\u00af\u00c6\u00d0\u00ba\u00c7\u00bc\u00c6, \u00cc\u00b6\u00c7\u00ae\u00b4\u00bc\u00c6\u00af\u00bf\u00c6\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00cd\u00c1\u00de \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00a9\u0081\u00cd\u00b9\u00c7\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00da\u00be\u00ce\u00ba\u00b9\u00c6\u00b9\u00bc\u00c8\u00b1\u00c8\u00be\u00c6\u00af\u00bf\u00c6, \u00b7\u00c8\u00b6\u00c8 \u00cd\u00b9\u00c7\u0081\u00bd\u00c1\u00bd\u00c6\u00ce\u00bd \u00c1\u00c0+\u00c6\u00d0\u00c1\u00b6\u0081 \u00f2\u00be\u00ba\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00c1\u00c0\u00c8\u008a\u00be\u00c6 \u00a7\u00b6\u008c \u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6 \u00f2\u00be\u00ba\u00c6;\n\n(\u00ad)\u00d8{\u00be\u00af+\u00c6\u00af\u00ce\u00bf \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00d7 \u00cd\u00b9\u00d6\u00c1\u00d7\u00ba\u00c6 \u00da\u00b6\u00c6\u00b6\u00af+\u00c6\u00af\u00bf\u00c6,\u00b1\u00b3\u00c6\u00b1\u00c8\u00ce\u00af\u00af\u00bf\u00c6, \u00b7\u00c8\u00ce\u00b8\u00e2\u00ba\u00be\u00bc\u00c6\u00af\u00bf\u00c6, \u00b9\u00dd\u00c1 \u00aa\u00d5\u00af\u00bf\u00c6\u00db\u00b6\u008b\u00bb\u00c1\u00bd\u00c6\u00ce\u00bd \u00cc\u00c1\u00bf\u00c8\u008a\u00d5\u00b6\u00df\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00c6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00ce\u00bf \u00a3\u00ce\u00b4\u00c1\u00b6\u00bd\u00c6\u00d0\u00a9\u00d7\u00c1\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00af\u00b7\u00c6\u00b6\u00b8\u00c1\u00c7\u00b8 \u00cd\u00c1\u00de \u00a9\u00be\u00c6\u00be\u00c7\u00af\u00c6\u00af\u00c7\u00bc\u00c8\u00bb+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00af\u00dd\u00ba+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00b6\u00df\u00ba\u00c6;\n\n(\u00ac\u00bf)\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00ce\u00bf \u00db\u0081\u00cc\u00b8\u00d5\u00b6\u00c6\u00d7\u00b1\u00c6\u00cc\u00b1\u00be\u00c6\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00af\u00ae\u00af\u00c7\u00b4\u00c6\u00b1\u00c8\u00af\u00bf\u00c6, \u008c\u00bc\u00c8\u00e2\u00ce\u00bc\u00af\u00bf\u00c6,\u00af\u00dd\u00b6\u00c6\u00b6\u00bc+\u00c6\u00d0\u00af\u00bf\u00c6 \u00af\u00be\u00b7\u00c6\u00d7\u00ce\u00bc\u00bb\u00c7\u00b4\u00be\u00c6\u00af\u00bf\u00c6, \u00cd\u00c1\u00ce\u00be\u00b6\u00c6\u00b6\u00bf+\u00c6\u00af\u00bf\u00c6\u00b0\u00c1\u00d0\u00b9\u00c6\u00da\u00af\u00bf\u00c6, \u008c\u00c1\u00c7\u00b6+\u00c6\u00af\u00bf\u00c6, \u00ba\u00c7\u00b7\u00c7\u00d5\u00af\u00bf\u00c6, \u00a7\u00be\u00c6\u00be\u00c7\u00b1\u00b9\u00c6\u00b9\u00bb\u00b5+\u00c6\u00af\u00bf\u00c6, \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00af\u00c6\u00af\u00bf\u00c6 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00ce\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00ce\u00bf \u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00ac\u00e1+\u00c6\u00d0\u00cc\u00b1\u00bb\u00c6\u00b6\u00df\u00ba\u00c6\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00b6\u00df\u00ba\u00c6;\n\n(\u00af)\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00ce\u00bf \u00ac\u00b6\u00c6\u00b6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00ce\u00bf\u00dc\u00ce\u00b4\u00bb \u00cd\u00c1\u00de \u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00af\u00bf\u00c6, \u00a3\u00ce\u00ba\u00b9\u00c6\u00da\u00af\u00bf\u00c6\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00b1+\u00c6\u00af+\u00c6\u00af\u00bf\u00c6 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00de\u00b4\u0081 \u00e7\u00b4\u00c6\u00d5\u00b1\u00c6\u00cd\u00b1\u00bc\u00c6\u00b7\u00c6\u00d7\u00ba\u00c6 \u00a5\u00ce\u00b5\u00b7\u00c6\u00d7\u00ba\u00c6 \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 ;\n\n4 1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 23 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00ba\u00c4\u00d8\u00c1\u00bc \u00cc\u00b9\u00bf\u00b6\u00c6\u00b6\u008c\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7 \u0093\u00b4\u00c6\u00b4\u00bb (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(+)\u00a4\u00dc\u00bf\u00c6\u00cd\u00c1\u00b6\u00b6\u00c6\u00b6\u00c8\u00df\u00ba\u00c6 \u00a7\u00bf\u00c6\u00b7\u00c7\u00b4\u00c6\u00d5 \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u00df\u00ba\u00c6\u00a4\u00bb\u00c6\u00e2\u00af\u00ce\u00bf \u00cd\u00ba\u00bd\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00af\u00be\u00c6\u008c \u00b7\u00c8\u00af\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00a7\u00bb\u00bc\u00c6\u00af\u00be\u00c6\u008c\u0088\u00b9\u00c6\u00cd\u00bf\u00c7\u00ba\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00aa\u00ce\u00b8\u00bb \u00af\u00bd\u00c6\u00ce\u00af \u00cc\u00b7\u00bd\u00c8\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00d7 \u00cc\u00af\u00c7\u00ae\u00d5\u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 ;\n\n(\u00b1)\u00af\u00be\u00c6\u008c \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd\u00a7\u00bf\u00c6\u00b7\u00c7\u00b4\u00c6\u00d5 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u00d5\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00d8\u00b4\u00c6\u00b9 \u00a3\u00be\u00c6\u00be\u00d7\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6 \u00b9\u008a\u00bd\u00c6\u00b1\u00c8 \u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00a5\u00ce\u00b5\u00b9\u00c6\u00da \u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c7\u00af\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00ce\u00ba\u00b9\u00c6\u0089\u0081 \u00db\u00af\u00c1\u00bc\u00c7\u00af\u00b1\u00c6 \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00d5\u00b6\u00be\u00c6;\u00a3\u00b6\u00c6\u00d7\u00b4\u00b8\u00c6\n\n(\u00b3)\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00ba\u00bd\u00c6\u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00ce\u00bf\u00a3\u00ce\u00b4\u00c1\u00b6\u00bd\u00c6\u00d0 \u00aa\u00d7\u00c1\u00c7\u00b8 \u00cd\u00c1\u00de \u00a9\u00be\u00c6\u00be\u00c7\u00af\u00c6 \u00af\u00c7\u00bc\u00c8\u00bb+\u00c6\u00af\u00ce\u00bf \u00dc\u00ba\u00c6\u00af\u00dd\u00ba+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0"
