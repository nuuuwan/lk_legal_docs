    "chunk_text": "8.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 13 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00d5\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be\u00c3\u00e5\u00da\u00c6\u00e5\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e0\u00c9\u00e5\u0095\u00c0\u00ea\u00c7\u00e6\u00cb\u00c6\u00e5\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u00c3\u00e5\u00c7 \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00be\u00f8\u00c6\u0095\u00ba \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8 \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00be\u008a \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00ef\u00cd\u00e5\u00e0, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00d5\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00c3\u00e5\u00da\u00c6\u00e5\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e0\u00c9\u00e5\u0095\u00c0\u00ea\u00c7\u00e6\u00cb\u00c6\u00e5\u00b4\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00ef\u0089.\n\n9.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 21 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 : -\n\n\u201c(\u00a1\u00e6\u00a1\u00e6) \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00b0\u00ef\u00c6\u00e0 \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00cd\u00b0\u00be\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00f8\u00be\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u00c0\u00c9\u00c7\u00e5 \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00cc\u00e8\u00c6\u00f5\u00c4\u00c4\u00ea\u00bc\u00c8\u00e0 ;\u201d \u00cc\u00cd\n\n\u00c0\u00f2\u00bd\u00e5\u00be\u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 9\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be\u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 21\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\u00a8\u00f8\u00d7\u00c4.\n\n1999 \u00a1\u00e2\u00a8 33 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00b0 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00b8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba5\n\n(2) \u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0, 3 \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 _\n\n\u201c (4) \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c4\u00ec\u00c8\u00e8\u00a8 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00c6 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00bc\u00ca\u00c8\u00a8\u00e0\u00cb\u00cc\u00e8\u00c6\u00c6\u00a8\u00e0 \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7, \u00a6\u00c4 \u00c4\u00ea\u00bc\u00c8 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb \u0097\u00cc\u00da\u00b0\u00be\u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00cc\u008a\u00c4\u00ba\u00c6\u00a8\u00f8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u00c9\u00d6\u00be\u00e0 \u00c9\u00c7 \u00c9\u00e6\u0091 \u00a8\u00ce \u00cd\u00e6\u00a8. \u00a6\u00c4 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00cb\u00c6\u00c6\u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a4\u00c0\u00ef\u00bc\u00e0\u00ca\u00c6 \u00cd\u00e5 \u00a1\u00c4\u00e5\u00ba\u00f1 \u00ba\u00f9\u00c7\u00b8\u00c6 \u00c4\u00ba \u00c9\u00e5\u00d6\u00a8\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7, \u00a6\u00c4\u00c4\u00ea\u00dd \u00aa\u00b8\u00be \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00c2\u00e6\u00c7 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(5) 1979 \u00a1\u00e2\u00a8 28 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ef\u00ba\u00e0 8 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ba\u00b4 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0\u00c8\u00e5\u00c3\u00c6 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 . \u201d\n\n10. \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 28 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7,\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 28\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c8\u00cc \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6: -\n\n28 \u00a1 (1) \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd\u00a8\u00da\u00ba\u00c9\u00f1 \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c0\u00e5\u00f3\u0097\u00bd\u00e5\u00be \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7, \u00a6\u00c2\u00df \u00cc\u00e7\u00c4 \u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00c4\u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6.\n\n(2) \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00a8\u00da\u00ba\u00c9\u00f1 \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6\u00cc\u00c0\u00c6\u00be \u00ef\u00c4\u00be\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u00c8\u00e8\u008d\u00ba\u00c9 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u0097\u00bd\u00e5\u00be \u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7, \u00a6\u00c2\u00df \u00cc\u00e7\u00c4 \u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00c4 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c6\u00ea\u00ba\u00eb\u00a8\u00c4 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d\n\n11. \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00b428 \u00a1 \u00a1\u00f5\u00ba\u00e0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4.\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n\u201c\u0097\u00bd\u00e5\u00be\u00c6\u00bc\u00fb\u00c4\u00b4\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00b4\u00cd\u00fa\u0095 \u00c2\u00c8\u00c6."
