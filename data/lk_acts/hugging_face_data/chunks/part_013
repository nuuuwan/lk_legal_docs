    "chunk_text": "\u00aa\u00ce\u00b8\u00bb \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00af\u00b4\u00ce\u00ba\u00af\u00ce\u00bf\u00b9\u00c6\u00da\u00c7\u00c8\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6,\u00b1\u00c7\u00c6\u00cd\u00c1\u00c7\u00b6\u00bb\u00b6\u00c6\u00cd\u00b6\u00c7\u00d5 \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u00da\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc\n\n\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cd\u00b1\u00ba\u00b7\u00be\u00af\u00c6 \u00e7\u00de\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00b6\u00c7\u0089\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6, \u00b9\u00b6\u008c\u00b6\u00c7+\u00c6\u00d0\u00b7\u00c7\u00c6 \u00d0\u00e1\u00ce\u00c1 \u00a3\u00ce\u00ba\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6\n\n\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7.\n\n\u00a7\u00ce\u00bc\u00cd\u00bb \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8 \u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00c6.\n\n6 \u00b0\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b8 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u00b7\u00c9\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5 \u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\n\n\u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00814 \u00a4\u00ba\u00c6 \u0089\u00c7\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00816 \u00a4\u00ba\u00c6 \u0089\u00c7\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba\u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6\u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf\u00a7\u00ce\u00bc \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b8\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00ce\u00bb\u00ba\u00c7\u00bd\u00c6\u00bd\u00c9\u00d5 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0\n\n51999\u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af,\u00a5\u00be+\u00c6\u00ce\u00af \u00b2\u00c7\u00b6\u00c8\u00af\u00b1\u00c7\u00c6\u00cd\u00c1\u00c7\u00b6\u00bb \u00b1\u00c8\u00bc\u00ba\u00b6\u00c7\u00b8\u00b1\u00c6 \u00b1+\u00c6\u00af\u00ba\u00c6 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6)(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u201c\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u201d\n\n\u00db\u0081\u00d9\u00ce\u00bc\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00df\u00ba\u00c6 \u00a7\u00be\u00af\u00c8\u0081 \u00aa\u00ce\u00b8\u00bb \u00b7\u00c7\u00d5\u00af\u00bf\u00c8\u00df\u00ba\u00c6 \u00c1\u00c7\u00bb\u00c6\u00ce\u00ba,\u00a3\u00af\u00c8\u00ba\u00c6\u00ce\u00b1,\u00b6\u0081\u00b8\u00be\u00ba\u00de\u00b9\u00c6\u00da \u00a9\u0081\u00b9\u00b8\u00cd\u00c1 \u00a3\u00b1\u00c6\u00b1+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00c6 \u00a3\u0088\u00af\u00c6\u00af\u00bd\u00c6\u00af\u00bf\u00c7\u00af\u00e2\u00ba\u00c6 \u00bb\u00c7\u00c1\u00bc\u00d7\u00ba\u00c6\u00b7\u0081\u00ce\u00ba\u00cd\u00bb-\u00b1\u00c7\u00c6\u00cd\u00c1\u00c7\u00b6\u00bb\u00cd\u00ba-\u00a9\u00ba\u00c6 \u00a9\u00be\u00c6\u00cd\u00be\u00c7\u00c7\u00c8\u00b8\u00d7\u00ba\u00c6 \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00bf\u00c8\u0081\u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c7\u00af\u00e2\u00ba\u00c6 \u00a3\u00ce\u00ba\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf \u00b1\u00c7\u00c6\u00cd\u00c1\u00c7\u00b6\u00bb \u00b1\u00f2\u00af \u00a3\u00ce\u00ba\u00b9\u00c6\u00da \u00ac\u0081\u00bd\u00c8\u00ce\u00b8\u00a4\u00af\u00c6\u00d0\u00ba\u00c6 \u00a7\u00bb\u00c7\u00c6\u00b7\u00c6\u00b6 \u00b9\u00b5\u00c8\u008a\u00be\u00c6 \u00a9\u00ba\u00c6 \u00c1\u00c7\u00c0\u00c6\u00ce\u00c1 \u00a3\u00c7\u00c6\u00b9\u00c6\u00b9\u00b5\u00c8\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf \u00b7\u00c7\u00ba\u00c6, \u00b9\u00bc\u0083\u00b9\u00bc\u00a3\u0081\u00da, \u008c\u00d2\u00c1\u00c7\u00b1\u00ba\u00c6, \u00ac\u00b6\u00c6\u00d7\u00ce\u00c0\u00b9\u00c6\u00da, \u00b1\u00ba\u00b9\u00af\u00c8\u00c7\u00c6\u00e2 \u00a9\u0081\u00b9\u00b8 \u00b7\u00c8\u00ce\u00bd\u00b7\u00c6\u00b6 \u00d0\u00d5\u00ba\u00c6\u00b9\u00ba\u00c6\u00ac\u0081\u00bd\u00c8\u0081 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c7\u00af \u00a5\u00c1\u00c6\u008c\u00be\u00b4\u00c6\u00b1\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u00ce\u00b8 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00c8 \u008c\u00ce\u00b8\u00bb\u00c7\u00bd\u00c6\u00bd \u00a7\u00de\u00b6\u00c8\u00cc\u00af\u00c7\u00ae\u00d5\u00bf\u00c6\u00cd\u00bf\u00c7\u00ba\u00c7\u00b6\u00be\u00c7\u00df\u00ba\u00c6, \u00a9+\u00c6\u00af\u00bf\u00c6 \u00cd\u00b1\u00ce\u00c1 \u00b7\u00c8\u00af\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00b6\u00c6 \u00b6\u00c8\u00b4\u00c6\u00b4+\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00b6\u00c8\u00bd\u00ce\u00ba\u00b6\u00c6\u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b9\u00c6\u00b6\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6 \u00aa\u00ce\u00b8\u00bb \u00b1\u00f2\u00af\u00ac\u00e1+\u00c6\u00af\u00ce\u00ba\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00af\u00bf\u00c6 \u00a9\u0081\u00b9\u00b8\u00c1\u00bd\u00c6\u00de\u00b4\u0081 \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u00da\u00af\u00ce\u00bf\u00aa\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6, \u201c\u00a5\u00be+\u00c6\u00ce\u00af \u00b2\u00c7\u00b6\u00c8\u00af \u00b1\u00c7\u00c6\u00cd\u00c1\u00c7\u00b6\u00bb \u00b1\u00c8\u00bc\u00ba\u00b6\u00c7\u00b8\u00b1\u00c6\u00b1+\u00c6\u00af\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b9\u00bb\u00dd\u00b4\u0081 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u008c\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00af\u00c9\u00c0\u00c6 \u00a9\u00ba\u00c6\u00ce\u00ba \u00ad\u00c7\u00c6\u00ac\u00e1+\u00c6\u00af\u00ce\u00ba\u00b9\u00c6\u00b9\u00c7\u00af \u00a3\u00ce\u00ba\u00b6\u00c6\u00d7\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00af\u00c8\u0081\u00cd\u00bd\u00c7\u00ba\u00c6:-\n\n\u00a5\u00be+\u00c6\u00ce\u00af \u00b2\u00c7\u00b6\u00c8\u00af \u00b1\u00c7\u00c6\u00cd\u00c1\u00c7\u00b6\u00bb \u00b1\u00c8\u00bc\u00ba\u00b6\u00c7\u00b8\u00b1\u00c6 \u00b1+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u008c\u00b6\u00c8\u00af\u00bf\u00c6\n\n\u008c\u00b6\u00c8 1- \u00cc\u00b9\u00bb\u00c7\u00c6 :\n\n\u00a5\u00af\u00c6\u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00cc\u00b9\u00bb\u00c7\u00c6 \u201c\u00a5\u00be+\u00c6\u00ce\u00af \u00b2\u00c7\u00b6\u00c8\u00af \u00b1\u00c7\u00c6\u00cd\u00c1\u00c7\u00b6\u00bb \u00b1\u00c8\u00bc\u00ba\u00b6\u00c7\u00b8\u00b1\u00c6 \u00b1+\u00c6\u00af\u00ba\u00c6\u201d\u00a9\u0081\u00b9\u00b6\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6. \u00a3\u00d7 \u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00c7\u00c6 \u00b1+\u00c6\u00af\u00ba\u00c6 \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u008c\u00b6\u00c8 2- \u00b1\u00c8\u00b8\u00c6\u00b8\u00ba\u00c6 :\n\n\u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8\u0081\u00b8\u00ba\u00c6,\u00a7\u00b6\u00bb\u00e9\u00c7\u00c8\u00bb\u00ce\u00b8\u00b9\u00c6 \u00b9\u00c8\u0081\u00b8\u00b5\u00c8\u008a\u00bd\u00c6 \u00cc\u00af\u00c7\u00ae\u00b4 \u00ba\u00be\u00c7\u00c6\u00b7\u00c6\u00b6\u00a5\u00bf\u00b3\u00c6\u00b1\u00c8\u00c1\u00b9\u00c6\u00da\u00b6\u00c6 \u00b6\u00c7\u00ba\u00ce\u00bc \u00ba\u00be\u00bc\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u008c\u00b6\u00c8 3- \u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6 \u00c1\u00c7\u00b1\u00af\u00ba\u00c6 :\n\n\u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6 \u00c1\u00c7\u00b1\u00af\u00ba\u00c6 \u201c\u00af\u00c8\u00bc\u00c7\u00ba\u00ba\u00c6 \u00af\u00c8\u00bc\u00c7\u00ba\u00ba\u00c7\u00af\u00b1\u00c6 \u00cc\u00b1\u0081\u00de\u00a9\u00be\u00c6\u00cd\u00be\u00c7\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00cd\u00b1\u00ce\u00c1 \u00cc\u00b1\u00bb\u00c6\u00cd\u00c1\u00c7\u00ba\u00c7\u00af\u201d \u00a9\u0081\u00b9\u00b6\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6.\n\n\u008c\u00b6\u00c8 4 - \u00cc\u00af\u00c7\u0088 :\n\n\u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00c6 \u00cc\u00af\u00c7\u0088 \u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8\u0081\u00b8\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6 \u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6 \u00c1\u00c7\u00b1\u00af\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6\u00cc\u00c1\u00ae\u00b5\u00c8\u00bd\u00b9\u00c6 \u0089\u0081\u00b8\u00b5\u00c8\u008a\u00bd\u00c6 \u00cc\u00af\u00c7\u00ae\u00b4\u00b6\u00c7\u00af\u008c\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6.\n\n\u008c\u00b6\u00c8 5- \u00cc\u00b9\u00c7\u00d7\u00af\u00c6 \u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00bf\u00c6 :\n\n\u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00cc\u00b9\u00c7\u00d7\u00af\u00c6 \u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00bf\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b8\u00c1\u00c7\u00af \u00a5\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :-"
