    "chunk_text": "(6) \u008c\u00b4\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00d0 \u00aa\u00bd\u00c6\u00bd\u00c1\u00c7\u00de (2) \u00a4\u00ba\u00c6, (3) \u00a4\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 (4)\u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00d0 \u00aa\u00bd\u00c6\u00bd\u00c1\u00c7\u00de, \u0089\u00bf\u00c6\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u0081, \u00b9\u00bc\u00c7\u00bb\u00ba\u00ce\u00b4\u00b7\u00c6\u00b6 \u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u008b\u0081 \u00a3\u00be\u00c6\u00be\u00d7\u00a8\u00b8\u00db\u00bd\u00c6\u00bd \u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u008b\u0081 \u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00b8 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00cc\u00ba\u00c7\u0081\u00de \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u008c\u00b4\u00b6\u00c6\u00d7, \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6 \u00ac\u0081\u00bd\u00c8\u0081,\u00b6\u00c8\u00bd\u00b6\u00c6\u00b6\u00c1\u00c7\u00c6\u00af\u00bf\u00c8\u0081 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00ba\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00b8\u00d7\u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00b9\u00c6 \u0089\u00cd\u00bc\u00bc\u00ce\u00b5\u008a\u0081 \u00cd\u00ba\u00be\u00c6, \u00a3\u00d5\u00b6\u00c6\u00b6 \u00cc\u00b9\u00bd\u00c6\u00bd\u00c7\u00ce\u00bc \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00b6\u00c6 \u00b6\u00c8\u00bd\u00b6\u00c6\u00b6\u00c1\u00c7\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c7\u00af\u00b1\u00c6 \u00cd\u00b1\u00c7\u00c6\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6,\u00a3\u00b6\u00c6\u00d7\u00b4\u0081, \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00c7\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00ac\u00dd\u00c1\u00dd\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00c7\u00c6\u00af\u00bf\u00c6 \u00a5\u00dd\u00c1\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00a9\u00b6\u00c8\u00bc\u00c7\u00af\u00cd\u00b6\u00c7\u00b6\u00c7\u00b8\u00b6\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00ce\u00bb \u00a4\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 37 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c64\n\n4\u00b0(1) \u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00b8 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00cc\u00ba\u00c7\u0081\u00de _\n\n(\u00a3)\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00ba\u00c6 \u00ac\u00dd \u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081\u00a3\u00be\u00c6\u00be\u00d7 \u00a8\u00b8\u00db\u00bd\u00c6\u00bd \u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u008b\u0081\u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00b8\u00b6\u00c7\u008a\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7, \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u0089\u00bf\u00c6\u00ce\u00bf\u00bb\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a8\u00b8\u00db\u00bd\u00c6\u00bd \u0089\u00bf\u00c6\u00ce\u00bf\u00ce\u00bb\u00a3\u00be\u00c6\u00be\u00d7 \u00a8\u00b8\u00db\u00bd\u00c6\u00bd \u0089\u00bf\u00c6\u00ce\u00bf\u00ce\u00bb \u00af\u00b4\u00c6\u00d5\u00af\u00c6\u00af\u00c7\u00b9\u00c6\u0089\u00be\u00c6\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 ;\n\n(\u00a4)\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00ba\u00c6 \u00b9\u00bc\u00c7\u00bb\u00ba\u00ce\u00b4\u00b7\u00c6\u00b6 \u00ac\u00dd\u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u008b\u0081 \u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00b8\u00b6\u00c7\u008a\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7, \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00bc\u00c7\u00bb\u00ce\u00b4\u00b7\u00c6\u00b6\u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u00be\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00b6\u00c6\u00ce\u00b6\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6 \u00a4\u00bd\u00c6\u00bd\u008b\u00be\u00c6\u00be\u00c7\u00b6\u008c\u00b4\u00b6\u00c6\u00d7 \u00a3\u00b6\u0081\u00b1\u00c7\u00c7\u00c6\u0089\u00be\u00c6 \u00a9\u00c1\u00cd\u00bc\u00d9\u00b8\u00ba\u00c6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a5)\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00ba\u00c6 \u00ac\u00dd \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6\u00d7\u00ce\u00b5\u008a\u0081 \u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u008a\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7,\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6\u00d7\u00ce\u00b5\u00bb\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6\u00d7\u00ce\u00b5 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00b6\u00c6\u00ce\u00b6\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6 \u00a4\u00bd\u00c6\u00bd\u008b\u00be\u00c6\u00be\u00c7\u00b6\u008c\u00b4\u00b6\u00c6\u00d7, \u00a3\u00c1\u00c7\u00c6 \u00b1\u00c7\u00c7\u00c6\u0089\u00be\u00c6 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n(2)\u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00b8 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00cc\u00ba\u00c7\u0081\u00de, \u00a9\u00b7\u00c6\u00b6 \u00b7\u00c9\u00b6\u00c1\u00c7\u0081\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00b7\u00c8\u00bb\u00c7\u00bb\u00c7\u00b6\u00c8\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00d9\u00bf\u00c6 \u00a3\u00c1\u00c6\u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00b6\u00c7\u00c7\u00c8,\u00a3\u00be\u00c6\u00be\u00d7 \u00a9\u00b7\u00c6\u00b6 \u00a4\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u0089\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a9\u00b7\u00c6\u00b6 \u00a4\u00e0\u00af\u00c6\u00d0 \u00a9\u00b6\u00c8\u00bc\u00c7\u00af\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00a4\u00bf\u00c6\u00c1\u00b6\u00c8\u00af\u00c8\u0081\u00bd\u00c7\u00cd\u00bc\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00b7\u00c9\u00b6\u00c8\u00c1\u00c7\u0081 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n\u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00cc\u00b1\u00be\u00c6\u00df\u00b9\u0088\u00bb\u00c7\u00d0\u00ba\u00c6\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00b0\n\n\u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00b8\u008c\u00ae\u00b5\u00b9\u00c6\u00b9+\u00c6\u00af\u00bf\u00c6\u00b0\n\n1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 37 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c65\n\n\u00b9\u00c7\u00af\u00ba\u00c6 II\n\n\u00b9\u00bc\u00c7\u00ba\u