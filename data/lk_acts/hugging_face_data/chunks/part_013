    "chunk_text": "(4) \u00a5\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6, 3 \u00a4\u00be\u00c6\u00be\u00d73\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00c7\u00c8\u00e2\u00af\u00e0\u00af\u00c6\u00d0 \u00db\u00bc\u00b5\u00c7\u00af \u00a9\u00d7 \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c8\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6, \u00b9\u00bb\u00d9\u00de\u00c1\u00b6\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\n\n3. \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00af\u00c6\u00d0\u00ba\u00c6 \u00b6\u00ba\u00c8\u00c0\u00c6 \u00a7\u00ce\u00bc\u00af\u00c6\u00d0\u00ba\u00c8\u00ce\u00b4\u00cd\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00af\u00c7\u00b5\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6,\u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00bb \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8 \u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0"
