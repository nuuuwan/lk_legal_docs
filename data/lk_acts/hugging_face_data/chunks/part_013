    "chunk_text": "(\u00a1\u00e6) \u00c6\u008a \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e5\u00bc\u00be \u00c8\u00bc \u00c6\u008a\u00be\u00f8\u00c6\u00c4\u00c6\u00a8, \u00d7\u00ba\u00f8\u00c6\u00a8, \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6\u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6 \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00c8\u00e8\u00c6\u00e5 \u00a1\u00ba\u00e0\u00cc\u00be\u00e0\u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0\u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8 \u00a6\u00c9\u00e6\u00be\u00f8 \u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00d6\u00be \u00c8\u00bc \u00cc\u00c3\u00e5\u00c9\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e8\u00c6\u00f5 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00f8\u00d7\u00c4, \u00be\u00c9\u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00ef\u008c \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00cc\u00e9\u00c4\u00e5\u00c9\u00c8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a6\u00e0 \u00cc\u00c3\u00e5\u00ef\u008c \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00cc\u00e9\u00c4\u00e5\u00c9\u00c8\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00c6\u008a \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00be\u00c9\u00cc\u00c3\u00e5\u00c9\u00b4 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00f8\u00d7\u008a \u00c9\u00ec\u00c9\u00e5\u00a8\u00e0 \u00ef\u00c4\u00be\u00e0 \u00ef\u00ba\u00e0\u00c7\u00e6\u008a\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d\n\n3.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00e8 \u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n41999 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba"
