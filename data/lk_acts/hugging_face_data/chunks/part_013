    "chunk_size_bytes": 3558,
    "chunk_text": "(\u00a1\u00e5) \u00cc\u00e8\u00aa\u00db , \u00cc\u00ea\u00c7\u00e6 \u00b4\u00ea, \u009f\u0091, \u00cc\u00e8\u00aa\u00db \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00c6\u00fa\u00c0\u00e0\u00c0\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00c3\u00e5\u0097\u00ba\u00e5 \u00a8\u00f8\u00d7\u00c4\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c6\u00e5\u00e0\u00d4\u00ba \u00c3\u00e5\u0097\u00ba\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a6\u00e0 \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8 \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0\u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00e8\u00c6\u00f5 \u0097\u00cc\u00e0\u00ba\u00c7 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00bc\u00a8\u00e0 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.; \u00ba\u00c9 \u00bc,\n\n(\u00a1\u00e6) \u00be\u00f8\u00c6\u0095\u00ba \u00a2\u00c8\u00e0\u00f5\u008a \u00c0\u00ba\u00f2 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9, \u00a2\u00c8\u00e0\u00f5\u008a \u00c0\u00ba\u00f2\u00c6 \u00cc\u00c4\u00aa \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n1999 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00c2\u00f3 \u00c0\u00be\u00ba5\n\n6. (1) \u00c6\u008a \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0\u00a8\u00c8 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00c2\u00bc\u00e0\u00bc \u00cc\u00ea\u00c7\u00e5\u00c2\u00f3 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u008a\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00eb\u00b4 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00c4\u00ea\u00bc\u00c8 \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00c2\u00e6\u00c7 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00c2\u00bc\u00e0\u00bc \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u0097\u0093\u0097\u00bd\u00e5\u00be 21\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa \u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u00c8\u00cc\u00e0\u00c9\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n7. (1) \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00bc \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\u00cc\u00e8\u00f3 \u00a8\u00c7\u0095\u00be\u00e0 \u00c0\u00c9\u00ba\u00f9 \u00bc \u00c6\u00be\u00e0\u00be \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7 \u00bc\u00e6\u00be \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0\u00c6\u008a \u00c9\u00e5\u00cd\u00be\u00c6\u00a8, \u00c6\u00e5\u00ba\u00f2\u00e5\u00c9\u00a8, \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00ca\u00e5\u00c8\u00e5\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00d6\u00ca\u00f2\u00c6\u00a8\u00f3\u008a\u00ef\u00a8\u00e5\u00ce, \u00cc\u00e8\u00aa\u00db , \u00cc\u00ea\u00c7\u00e6 \u00b4\u00ea, \u009f\u0091, \u00cc\u00e8\u00aa\u00db \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00c6\u00fa\u00c0\u00e0\u00c0\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00ef\u00a8\u00e5\u00c0\u00c4\u00b8 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00ba\u00f8\u00ef\u0089 \u00bc \u00c6\u00be\u00e0\u00be \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7 \u00bc\u00e6\u00be\u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00c9\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00c2\u00bc\u00e0\u00bc, \u00cc\u00ea\u00c7\u00e5\u00c2\u00f3(\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c2\u00f3, \u00ba\u00f9\u00c7\u00e6 \u00c2\u00f3 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00aa\u00c9\u00e5 \u00ba\u00f8\u00ef\u0089\u00bc \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00bc \u00c6\u00be\u00e0\u00be \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7 \u00bc\u00e6\u00be \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00ea\u00c7\u00e5\u00c2\u00f3 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00cc\u00c0\u00c6\u00e5 \u00a1\u00e6\u00ba\u00f8\u00c6\u008a \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8 \u00cc\u00ba\u00f1\u00ba\u00e5\u00c9 \u00cc\u00be\u00e5\u00bb \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa, \u00f3\u008a\u00ef\u00a8\u00e5\u00ce, \u00cc\u00e8\u00aa\u00db , \u00cc\u00ea\u00c7\u00e6 \u00b4\u00ea, \u009f\u0091,\u00cc\u00e8\u00aa\u00db \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00c6\u00fa\u00c0\u00e0\u00c0 \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00c6\u00be\u00e5\u00bc\u00fa\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce\u00ef\u00c0\u00e5\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5, \u00cc\u00ea\u00c7\u00e5\u00c2\u00f3 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ea\u00c7\u00e5\u00c2\u00f3 \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00c0\u00d7\u00a8\u00e0\u00cb\u00a8\u00c9\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0\u00be\u00f8\u00c8\u00c6\u00b4 \u00c9\u00b6\u00e5 \u00c0\u00cd\u00ce \u00ef\u00be\u00e5\u00c9\u00ec \u00be\u00f8\u00c8\u00c6\u00a8\u00e0 \u00bc\u00c7\u00be \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00f9\u00c7\u00e6\u00c2\u00f3\u00ef\u00aa\u00c9\u00e5 \u00a1\u00e6\u00bc\u00e0\u00bc \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00ef\u00aa\u00d1\u00c4\u00b4 \u00a1\u00e6\u00bc\u00e0\u00bc \u00c6\u00be\u00e0\u00be \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00ef\u00a8\u00e5\u00b4 \u00bc\u00e6\u00be \u00aa\u00e6\u00be\u00f9\u00c4\u00cc\u00bf\u00cd\u00e5 \u00ef\u00da\u00aa\u00eb \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00a1\u0093\u00a8\u00e5\u00d6\u00c9\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00be\u00f8\u00c8\u00c6\u00b4 \u00c9\u00b6\u00e5 \u00c0\u00cd\u00ce\u00ef\u00be\u00e5\u00c9\u00ec \u00be\u00f8\u00c8\u00c6\u00a8\u00e0 \u00bc\u00c7\u00be \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0 \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0\u00c0\u00d7\u00a8\u00e0\u00cb\u00a8\u00c9\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00be\u00f8\u00c8\u00c6\u00b4 \u00c9\u00b6\u00e5 \u00c0\u00cd\u00ce \u00ef\u00be\u00e5\u00c9\u00ec \u00be\u00f8\u00c8\u00c6\u00a8\u00e0 \u00bc\u00c7\u00be\u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0, -\n\n(\u00a1) \u00f3\u008a\u00ef\u00a8\u00e5\u00ce, \u00cc\u00e8\u00aa\u00db , \u00cc\u00ea\u00c7\u00e6 \u00b4\u00ea, \u009f\u0091, \u00cc\u00e8\u00aa\u00db \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00ef\u00cd\u00e5\u00e0 \u00c0\u00c6\u00fa\u00c0\u00e0\u00c0 \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00c6 \u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0\u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00c6 \u00a8\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u00c6\u00fa \u00cc\u00e6\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a\u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00e5\u00ba\u00f2\u00e5\u00c9\u00a8\u00e0 \u00be\u00c9\u00ba\u00e5 \u00a6\u00e0 \u00ba\u00eb\u00ce\u00b4 \u00a1\u00e6\u00ba\u00eb\u00dd \u0097\u00c6\u00cd\u00e6\u00a8\u00f8\u00c6 ;\n\n\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00c2\u00bc\u00e0\u00bc\u00cc\u00ea\u00c7\u00e5\u00c2\u00f3\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba\u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00c8\u00c6.\n\n61999 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00c2\u00f3 \u00c0\u00be\u00ba"
