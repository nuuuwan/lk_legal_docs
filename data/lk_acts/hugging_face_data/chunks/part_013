    "chunk_text": "6.26 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00ef\u00c4\u00cd\u00fa \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7,\u00a6\u00c6 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00e5\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e026 \u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c8\u00cc \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6:-\n\n26\u00a1 (1) \u00c2\u00c8\u00c6 \u00c0\u00e6\u00c9\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0\u00cc\u008a\u00c4\u00ba \u00a8\u00c7\u00aa\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba\u00c6\u00a8 \u00cc\u00bf\u00cd\u00be\u00e0\u00c6\u008a \u00be\u00f8\u00c6\u00c4 \u00cd\u00e5 \u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c6\u008a\u00a8\u00da\u00ba\u00c9\u00f1 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00c7\u00a8\u008a \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e026 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\n\n\u201c\u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u00e5\u0093\u00a8\u00e5\u00d6\u00c9\u00c7\u00c6\u00e5 \u00cc\u00cd\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00ef\u00c9\u00ba \u00c2\u00c8\u00ba\u00c8\u00c0\u00e6\u00c9\u00d7\u00c4.\n\n51999 \u00a1\u00e2\u00a8 22 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a2\u00ba\u00f8\u00d6\u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n\u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u0093\u00a8\u00e5\u00d6\u00c9\u00c7\u00c6\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00b4\u00ef\u00cd\u00e5\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00c8 \u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7, \u00a6\u00c9\u00e6\u00be\u00f8 \u00c6\u008a\u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00c9\u00e2\u00aa\u00eb \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00cc\u00e0\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00c4 \u00bc \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c\u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u00e5\u0093\u00a8\u00e5\u00d6\u00c9\u00c7\u00c6\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00b4 \u00c6\u008a \u00c2\u00c8\u00ba\u00c8 \u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9 \u00bc,\u00a6\u00ef\u00cc\u00e0 \u00c0\u00c9\u00c7\u00be \u00c8\u00bc \u00a8\u00da\u00ba\u00c9\u00f1\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00e0\u00ba\u00a8\u00e0 \u00a2\u00b4\u00ea\u00a8\u00e8\u00d7\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u00c4\u00a8\u00e0\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6.\n\n7.1995 \u00a1\u00e2\u00a8 28 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e041 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00ef\u00c4\u00cd\u00fa\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :-\n\n41. \u00cd\u00fa\u0095\u00a8\u008a\u00c0\u00e5\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb \u00cc\u00e2\u008e\u00ba\u00c6\u00a8\u00c4\u00ea\u00bc\u00c8\u00e0 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00c7 \u00ba\u00f8\u00c2\u00ec \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00cc\u00e2\u008e\u00ba\u00c6\u00b4\u00c4\u00e5\u00c7\u00e6 \u00a8\u00c7\u00be \u00c8\u00bc \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00ba \u00ef\u00c0\u00e5\u00ce\u00e8\u00c6 \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9, \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u00c9\u00cd\u00fa\u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00ba \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00c9 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c0\u00e5\u00ce\u00e9 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d\n\n8.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa 41 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00c6\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 42 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c8\u00cc \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :-\n\n42. \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 , \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00a8\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8\u00aa\u00fa\u00b8\u00ea\u008a \u00c0\u00be\u00e0\u00ba\u00f8 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00c9 \u00ef\u00c0\u00e5\u00ce\u00e8\u00c6\u00b4 \u00a1\u00c4\u00ba\u00c7\u00c9\u00ef\u00aa\u00d1\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\u201d\n\n9.1995 \u00a1\u00e2\u00a8 28 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e047 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (4) \u00c9\u00be \u00a4\u00c0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u201c\u00a6\u00c4 \u00aa\u00fa\u00b8\u00ea\u00ef\u008a \u00ba\u00f8\u00c2\u00ea\u00b8\u00ea\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4 \u00cc\u00c4\u00e5\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e5\u00be\u00e0\u00be\u00e5\u00b4 \u00ef\u00aa\u00c9\u00e5\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c41 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0\n\n\u201c\u00ef\u00c0\u00e5\u00ce\u00e8\u00c6\u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9\n\n\u201c\u00ef\u00c0\u00e5\u00ce\u00e8\u00c6\u00b4\u00a1\u00c4\u00ba\u00c7\u00c9\u00ef\u00aa\u00d1\u008a.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e041 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00e5\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e042 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e047 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n61999 \u00a1\u00e2\u00a8 22 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a2\u00ba\u00f8\u00d6\u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba"
