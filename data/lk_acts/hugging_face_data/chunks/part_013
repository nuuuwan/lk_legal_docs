    "chunk_text": "\u201c\u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\u00af\u00bf\u00c8\u0081\u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00da\u00a9\u00be\u00c6\u00ce\u00be\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00bf\u00c8\u0081\u00a9\u00ae\u00b5\u00c8\u00ce\u00af\u00ce\u00bb\u00dc\u00ba\u00c6 \u00cd\u00c1\u00de\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\u00ce\u00bb\u00af\u00c6\u00af\u00ce\u00be\u00b6\u00c6\u00d7\u00ba\u00c7\u00bd\u00c6\u00bd\u00c9\u00d5\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6\u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00dd\u00af\u00c6\u00d0\u00bf\u00c6\u00bf\u00b6\u00b6\u00c6\u00d7\u00c1\u00ba\u00c6\u00b0\n\n1987 \u00a4\u00ba\u00c6\u00a4\u00ae\u0088\u0081 15 \u00a4\u00ba\u00c6\u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c69 \u00a3, 9\u00a4 \u00a9\u0081\u00d9\u00ba\u00c6\u00da\u00b6\u00c8\u00bb \u0089\u00c7\u00c8\u00e2\u00af\u00ce\u00bf\u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n21999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 14 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\u00af\u00bf\u00c6 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(\u00a6) \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b9\u00ce\u00bb, \u00a3\u00c1\u00c6\u008c\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00ba\u00c7\u00b7\u00af\u00bc\u00b1\u00ce\u00b9\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00af\u00bc \u00b1\u00ce\u00b9\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00a3\u00ce\u00ba\u00af\u00c6\u00d0\u00ba\u00c6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00af\u00af\u00c6 \u00af\u00ce\u00be\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\u00ba\u00c7\u00b7\u00af\u00bc \u00b1\u00ce\u00b9\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00a3\u00ce\u00ba\u00af\u00c6\u00ce\u00af\u008a\u00be\u00c6,\u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00c7\u00c6 \u00ba\u00c7\u00b7\u00af\u00bc \u00b1\u00ce\u00b9\u00af\u00bf\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00812\u00a4\u00ba\u00c6 \u0089\u00c7\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00d0 \u00a5\u00b5+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u00e1\u00d0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00ba\u00c7\u00b7\u00af\u00bc \u00b1\u00ce\u00b9 \u00a9\u00b7\u00c6\u00b6 \u00a5\u00b4\u00b9\u00c6 \u00b9\u00bc\u00b9\u00c6\u0089\u00bd\u00c6\u00af\u00c7\u00af\u00a3\u00ce\u00ba\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00e2\u00bf\u00c6\u00bf\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u0089\u0081\u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00ce\u00bb\u00dc\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b9\u00c7\u00d7 \u00c1\u00b1\u00b6\u00c8\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00e0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00b7\u00af\u00bc \u00b1\u00ce\u00b9\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00a3\u00ce\u00ba\u00af\u00c6\u00ce\u00af\u008a\u00be\u00c6\u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00c7\u00c6, \u00b7\u00af\u00bc \u00b1\u00ce\u00b9\u00af\u00bf\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 2\u00a4\u00ba\u00c6 \u0089\u00c7\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00d0 \u00a5\u00b5+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u00e1\u00d0\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00b0\u00c6\n\n\u00a4\u008a\u00d9\u00ba\u00c6, \u00a5\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c7\u00be\u00c6\u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00a9\u00d7\u00e2\u00ba\u00c6, \u00a3\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008a\u00be\u00c6\u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a7\u00bf\u00b6\u00c7\u00ba\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b9\u00a9\u00b6\u00b8\u00d7\u00ba\u00c6 \u00a7\u00de\u00b9\u00c6\u00b9\u00c8\u00b8\u00c7\u00c6\u00af\u00bf\u00c8\u0081 \u00b9\u00b6\u008c\u00af\u00c6 \u00af\u00c7\u00be\u00ba\u00c6\u00db\u0088\u00c1\u00ce\u00b4\u00b7\u00c6\u00b6\u00b6\u0081 \u0089\u0081\u00b8\u00c7\u00c6 \u00c1\u00ce\u00bc \u00c1\u00df\u00e2\u00af\u00c6\u00d0 \u00c1\u00dd\u00b6\u00be\u00c6\u00a4\u00af\u00c7\u00d7\u00b0\n\n9 \u00a4\u00b0 \u00a9\u00b7\u00c6\u00b6\u00b9\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b9 \u00af\u00ce\u00be\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00c7\u00a3\u00b7\u00c6\u00b6\u00b9\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b9 \u00a9\u00b6\u00b8\u00d7\u00ba\u00c6 \u00a5\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 9\u00a3\u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00c7\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b9\u00a3\u00ce\u00ba\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7-\n\n(\u00a3) \u00a9\u00b7\u00c6\u00b6\u00b9\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b9 \u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00c7\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af\u00af\u00c6 \u00af\u00ce\u00be\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b1\u00ce\u00b9\u00bb\u00c7\u00b8\u00d7 \u00a3\u00ce\u00ba\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6\u00b9\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9 \u00a5\u00b4\u00b9\u00c6 \u00b9\u00bc\u00b9\u00c6\u00da \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00c7\u00af\u00ba\u00c6\u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u0089\u00be\u00c7\u00b8 \u00a9\u00be\u00c6\u00be\u00c7 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6,\u00a9\u00b7\u00c6\u00b6\u00b9\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9 \u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00af\u00b9\u00c6 \u00da\u00b6\u00c8\u00bb\u00b1\u00ce\u00b9 \u00a3\u00ce\u00ba\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6\u00b9\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b9\u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u0089\u0081 \u00b7\u00c8\u00dd\u00c1\u00c7\u00af \u00a9\u00be\u00c6\u00ce\u00be\u008a\u00d9\u00bf\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00a5\u00b4\u00b9\u00c6 \u00b9\u00bc\u00b9\u00c6\u00da \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00b9\u00c7\u00af\u00ba\u00c6 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\n\n\u00da\u00b6\u00c8\u00bb \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\u00aa\u00be\u00cd\u00c1\u00dc\u00bf\u00c6\u00bf\u00b1\u00ce\u00b9\u00ce\u00bb\u00a3\u00d5\u00b6\u00c6\u00d7\u00de\u00c1\u00b6\u00c7\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00b0\u00c6\n\n31999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 14 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u0089\u00bc\u00cd\u00b6\u00b1\u00b1\u00ce\u00b9\u00af\u00bf\u00c6 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00c1\u00ce\u00bc, \u00da\u00b6\u00c8\u00bb \u00b1\u00ce\u00b9\u00bb\u00c7\u00b8\u00d7 \u00a3\u00d7\u00a3\u00ce\u00ba\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00c8\u00af\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00af\u00ce\u00be\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b1\u00ce\u00b9\u00ce\u00bb \u00a3\u00d5\u00b6\u00c6\u00d7\u00de\u00c1\u00b6\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6;\n\n(\u00a4) \u00da\u00b6\u00c8\u00bb \u00b1\u00ce\u00b9\u008a\u0081 \u00b7\u00c8\u00dd\u00c1\u00c7\u00af \u00a9\u00be\u00c6\u00ce\u00be\u00af\u00e0\u00af\u00c6\u00d0\u00bf\u00c6\u00a3\u00ce\u00ba\u00b7\u00c6\u00b6\u00c8\u00dd\u00b9\u00c6\u00b9\u00b6\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00ce\u00be\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b1\u00ce\u00b9\u008a\u0081 \u00a9\u00be\u00c6\u00be\u00c7 \u00a4\u00b6\u00b8\u00db\u00ba\u00c6, \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00af\u00ce\u00be\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00ce\u00b9\u008a\u0081 \u00a9\u00be\u00c6\u00be\u00c7 \u00a7\u00c7\u00c8\u00ce\u00ba\u00af\u00bf\u00c6,\u00b6\u00b6\u00c6\u00d7\u00c1+\u00c6\u00af\u00bf\u00c6, \u00af\u00b4\u00ce\u00ba\u00af\u00bf\u00c6, \u00b6\u00b8\u00c8\u00d2\u00af\u00bf\u00c6, \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6, \u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6, \u00a9\u0081\u00b9\u00b8\u00e2\u00ba\u00c6 \u00a3\u00ce\u00c1 \u00da\u00b6\u00c8\u00bb\u00b1\u00ce\u00b9\u008a\u0081 \u00b7\u00c8\u00dd\u00c1\u00c7\u00af \u00a9\u00be\u00c6\u00ce\u00be\u00af\u00e0\u00af\u00c6\u00d0\u00bf\u00c6\u00bf\u00c7\u00b8\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a5\u00b4\u00b9\u00c6 \u00b9\u00bc\u00b9\u00c6\u00ce\u00b9\u00b6\u00c6 \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u00da\u00de\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd\u00c1\u00ce\u00bc, \u00da\u00b6\u00c8\u00bb \u00b1\u00ce\u00b9 \u00a3\u00ce\u00ba\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u00bb\u00c8\u00be\u00c6\u00a5\u00dd\u00b7\u00c6\u00d7 \u00da\u00b6\u00c8\u00bb \u00b1\u00ce\u00b9\u00af\u00c6\u00d0\u00af\u00c6 \u00ce\u00af\u00ba\u00c7\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b8\u00c1\u00c7\u00af\u00af\u00c6\u00af\u00dd\u00b6\u00b9\u00c6 \u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6;"
  },
