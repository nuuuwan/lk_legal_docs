    "chunk_text": "12.(1) \u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00c6 (\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00c7\u00c6 \u201c\u00b1\u00ce\u00b9\u201d\u00a9\u00b8\u00af\u00c6\u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00af\u00be\u00c6\u008c\u00b1\u00c7\u00c7\u00c6 \u00b1\u00ce\u00b9 \u00ac\u00b8\u00c6\u00de\u00a5\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u0081, \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b1\u00ce\u00b9\u00bb\u00c7\u00b8\u00d7\u0089\u00b8\u00c6\u00c1\u00dd\u00ba\u00c6 \u00a4\u00b4\u00c6\u00af\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :-\n\n(i) \u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00c6 \u00b6\u008c\u00b1\u00c7\u00bf\u00c7\u00c6 ;\n\n(ii) \u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00bf\u00c7\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 ;\n\n(iv) 1998 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u00b8\u00c6 53 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af,\u00cd\u00b6\u00b1\u00c8\u00bb \u00b7\u00c9\u00c7\u00c6\u00c1\u00c7\u00c0\u00c6\u00c1\u00bf \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00b1\u00c8\u00bb \u00b7\u00c9\u00c7\u00c6\u00c1\u00c7\u00c0\u00c6\u00c1\u00bf \u00a3\u00b9\u00c8\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u008a\u0081\u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00c7\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 ;\n\n(v) 1985 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 28 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00cd\u00b6\u00b1\u00c8\u00bb \u00af\u00be\u00c6\u008c\u00b7\u00c8\u00de\u00c1\u00af\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b1\u00c8\u00bb\u00af\u00be\u00c6\u008c \u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00c7\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8;\n\n(vi) \u00fe \u00ab\u00bb\u00c1\u00c7\u00c6\u00b6\u00c6\u00b6\u00b8\u00da\u00bc \u00b9\u00be\u00c6\u00af\u00ce\u00be\u00af\u00c6\u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u008c\u00be+\u00c6\u00af\u00c8\u00bb\u00be\u00c6\u0093\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00c1\u00c7\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00d7 \u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8 ;\n\n(vii) \u00cc\u00ba\u00c7\u00bc\u00b4\u00c6\u00d5\u00c1 \u00b9\u00be\u00c6\u00af\u00ce\u00be\u00af\u00c6\u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00b4\u00cd\u00be\u00c7\u00b4\u00c6\u00d5\u00a9\u00b7\u00c6\u00b6\u00c8\u00bc\u008c\u00bb\u00be\u00c6 \u0093\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00c1\u00c7\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00d7\u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8 ;\n\n(viii) \u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da \u00b9\u00be\u00c6\u00af\u00ce\u00be\u00af\u00c6\u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00f2\u00af \u008c\u00b3\u00c6\u00b3\u00c7\u00b8\u0093\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00c1\u00c7\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00d7 \u00b9\u00c8\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8 ;\n\n\u00cd\u00b9\u00bc\u00ce\u00c1\u008a\u0081\u00a7\u00de\u00b9\u00c6\u00b9\u00c8\u00b8\u00c7\u00c6\u00af\u00bf\u00c8\u0081\u00a8\u00b6\u00c8\u00bb\u00ba\u00c6\u00b0\n\n\u00af\u00be\u00c6\u008c\u00b1\u00c7\u00c7\u00c6 \u00b1\u00ce\u00b9\u00b0\n\n111999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 36 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00af\u00b4\u00bd\u00c6\u00cc\u00bd\u00c7\u00c0\u00c8\u00be\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00af\u00b4\u00cd\u00be\u00c7\u00b4\u00c6\u00d5 \u00a9\u00b7\u00c6\u00b6\u00c8\u00bc\u008c\u00bb\u00be\u00c6 \u00cd\u00b6\u00b1\u00c8\u00bb \u00b7\u00c8\u00de\u00c1\u00af\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(ix) \u00a7\u00dd\u00d0\u00d6 \u00b9\u00be\u00c6\u00af\u00ce\u00be\u00af\u00c6\u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00b4\u00bd\u00c6\u00cc\u00bd\u00c7\u00c0\u00c8\u00be\u00c6\u00a7\u008a\u00c7\u00c8\u00bb\u00be\u00c6 \u00b9\u00d0\u00b6\u00c8\u008a\u0081 \u00d7\u00ce\u00bd\u00b6\u00c6\u00b6\u00ce\u00be\u00c1\u00c7\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00c1\u00bc\u00d7 \u00b9\u00c8\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8 ;\n\n(x) 1981 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 54 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00cd\u00b6\u00b1\u00c8\u00bb\u00b7\u00c9\u00c7\u00c6\u00c1\u00c7\u00c0\u00c6\u00c1\u00bf \u00a4\u00bc\u00c7\u00bb\u00c6\u00b1\u00c6\u00b1\u00c8, \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00db\u00af\u00c1\u00c7\u00c6\u00b7\u00c8\u00ce\u00be\u00bb\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b1\u00c8\u00bb\u00b7\u00c9\u00c7\u00c6\u00c1\u00c7\u00c0\u00c6\u00c1\u00bf \u00a4\u00bc\u00c7\u00bb\u00c6\u00b1\u00c6\u00b1\u00c8, \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00db\u00af\u00c1\u00c7\u00c6\u00b7\u00c8\u00ce\u00be\u00bb\u00b9\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00c7\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 ;\n\n(xi) 1990 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 20 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00f8\u0081\u00bd\u00c7\u00ba\u00c6\u00b7\u00c8\u00ce\u00be\u00af\u00c6\u00af\u00be\u00c6\u008c \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6 \u00af\u00be\u00c6\u008c\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b1\u00c8\u00bb \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00b9\u008a\u00df\u00b7\u00c7\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00ce\u00af\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00b9\u008a\u00bd\u00c6\u00b1\u00c8 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u008a\u0081 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00c7\u00c6\u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00d7 \u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8 ;\n\n(xii) \u00ba\u00c4\u00cc\u00b9\u00c7\u00be \u00b9\u008a\u00bd\u00c6\u00b1\u00c8 \u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b9\u00c8\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8\u00cc\u00bb\u00c7\u00dd\u00c1\u00c7\u00c6;\n\n(xiii) \u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00be\u00c6\u008c\u00b1\u00c7\u00c7\u00c6 \u00b6\u00c8\u00ce\u00b5\u00af\u00c6\u00af\u00bf+\u00c6\u00af\u00bf\u00c8\u0081\u00b6\u00ce\u00be\u00c1\u00c7\u00c6\u00af\u00bf\u00c6\u00b0\n\n13.(1) \u00b1\u00ce\u00b9\u00bb\u00c7\u00b8\u00d7 \u00cd\u00b9\u00bc\u00ce\u00c1\u00af\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081 \u00b9\u00c8\u0081\u00c1\u00dd\u00ba\u00c6 \u00b6\u00b6\u00c6\u00d7\u00c1+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00b9\u00ae\u00da\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00c8\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00de\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :-\n\n(\u00a3) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00ce\u00ba\u00bb, \u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00be\u00c6\u008c\u00b1\u00c7\u00c7\u00c6 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00e0\u00b4\u0081 \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u00b9\u00c7\u00af\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00dd\u00ba+\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00cd\u00b9\u00bc\u00ce\u00c1\u00af\u00c6\u00d0\u00a4\u00cd\u00be\u00c7\u00b1\u00ce\u00b8\u00bb\u00bf\u00c8\u00b6\u00c6\u00b6\u00be\u00c6 ;\n\n(\u00a4) \u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u008c\u00b6\u00c8\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00b5+\u00c6\u00af \u00b9\u00c7\u00c9\u00b4\u00c6\u00ce\u00b1\u00af\u00ce\u00bf\u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00b6\u00df\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00c7\u00c9\u00b4\u00c6\u00ce\u00b1\u00af\u00bf\u00c8\u00be\u00c6 \u00b1\u00c8\u00b6\u00c6\u00b6\u00c8\u00bb\u00ce\u00b4\u00b7\u00c6\u00b6\u00c1\u00c7\u00c6\u00af\u00e0\u00ba\u00c6 \u00b7\u00c8\u00de\u00c1\u00af\u00ba\u00c6 \u008c\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00c1\u00de \u00b7\u00c8\u00b9\u00b7\u00c6\u00b6\u00ce\u00b8\u00af\u00ce\u00bf\u00b6\u00c6\u00b6\u00c8\u00dd\u00b9\u00c6\u00b6\u00c8\u00cc\u00b1\u00bb\u00c6\u00d7\u00bf\u00c6\u00bf\u00c1\u00c7\u00c6\u00af\u00e0\u00ba\u00c7\u00b8 \u00a4\u00b4\u00c6\u00af\u00ce\u00bf \u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00c8\u00b9\u00c6\u00da\u00cd\u00bf\u00c7\u00ba\u00c7\u00af\u00c6\u00af\u00bf\u00c6, \u00b1\u00c7\u0081\u00bd\u00c8\u00b6\u00c0\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00cd\u00c1\u00de \u00af\u00be\u00c6\u008c\u00b1\u00c7\u00c7\u00c6 \u00b1\u00c8\u00bd\u00b9\u00c6\u00da\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00d0 \u00b6\u00d0\u00b6\u00c8\u00bb\u00c7\u00b8\u00c1\u00c7\u00c6\u00af\u00cc\u00bf\u00b8\u00b9\u00c6 \u00cd\u00b9\u00bc\u00ce\u00c1\u00af\u00c6\u00d0 \u008c\u00b6\u00b7\u00c6\u00d7\u00ce\u00bc\u00b6\u00c6\u00b6\u00be\u00c6 ;"
  },
