    "chunk_text": "5. \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00c9\u00ba (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00bc\u00b6\u00c6\u00a8\u00e0\u00c0\u00e6\u00be\u00d1\u00c4 \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0, 4 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00b4\u00ef\u00cd\u00e5\u00e0 \u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00b4 \u00a6\u00a8\u00ad\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a1\u00ef\u00c0\u00e5\u00ef\u00cd\u00e5\u00cc\u00ba\u00e0\u00d1\u00ef\u008a, \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d7\u00ef\u008a, \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00c9 \u00be\u00f8\u00cc\u00e5 \u00a7\u00cd\u00ea \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6\u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c6\u008a \u00be\u00b6\u00ea \u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00f8\u00be\u00e0, \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0\u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nIII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00be\u00f8\u00ef\u00c7\u00e5\u00e0\u00bd\u00e5\u00c6\u00be \u00c0\u00ce\u00e8\u00ef\u00c2\u00e5\u00e0\u00bd\u00c6\u00be\u00e0\n\n(2) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00b4 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00be\u00e8\u00ef\u00c7\u00e5\u00e0\u00bd\u00e5\u00c6\u00be \u00c0\u00ce\u00e8\u00ef\u00c2\u00e5\u00e0\u00bd\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c0\u00ce\u00e8\u00ef\u00c2\u00e5\u00e0\u00bd \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c6\u008a \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00cc\u00e5\u00bd\u00a8 \u00a1\u00e6\u00ba\u00e0\u00be\u008a \u00a6\u00e0 \u00c2\u00c9 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00c9\u00cd\u00e5\u00c4 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00c8\u00e8\u008d\u00ba\u00c9 \u00bc\u00e6\u00be\u00ea\u008a \u00bc\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00ba\u00ba\u00e0\u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c8\u00e8\u008d\u00ba \u00a4\u00c0\u00ef\u00bc\u00cc\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00c8\u00e6\u009f \u00a1\u00e6\u00ba\u00e0\u00be\u008a \u0095\u00cc, \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00b4\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00be\u00f8\u00ef\u00c7\u00e5\u00e0\u00bd\u00e5\u00c6\u00be \u00c0\u00ce\u00e8\u00ef\u00c2\u00e5\u00e0\u00bd\u00c6\u00a8\u00f8\u00be\u00e0 \u00a1\u00e5\u00cc\u00e5\u00bc\u00be\u00c6 \u00d1\u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00ca\u00e5\u00a8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ca\u00e5\u00a8 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00e6\u00be \u00bc\u00e6\u00be\u00c4 \u00ce\u00ad \u00ba\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4, \u0097\u00a8\u00f8\u00b8\u00e9\u00c4, \u00c9\u00aa\u00e5 \u00a8\u00e8\u00d7\u00c4, \u00c4\u00ea\u00bc\u00e5\u00cd\u00e6\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00e6\u00be \u00bc\u00e6\u00be\u00c4\u00ce\u00ad \u00ba\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4, \u0097\u00a8\u00f8\u00b8\u00e9\u00c4\u00b4, \u00c9\u00aa\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4, \u00c4\u00ea\u00bc\u00e5 \u00cd\u00e6\u00d7\u00c4\u00b4, \u00ef\u00c2\u00bc\u00e5\n\n1999 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ca\u00e5\u00a8 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8 \u00c0\u00be\u00ba5\n\n\u00cd\u00e6\u00d7\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u00e6\u00c8\u00e6\u00cc\u00e0\u00d1\u00c4 \u00a8\u00c7\u00be\u00ea\u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00ca\u00e5\u00a8\u00c6\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00ca\u00e5\u00a8 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u0097\u00be\u00e5\u00ca \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0\u00c2\u00c8\u00c6\u00c8\u00ba\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00b4 \u00c3\u00e5\u00c7\u00bc\u00fb\u00c4, (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0\u00c4\u00aa\u00fa\u00be\u00e0 \u00ba\u00cd\u00be\u008a \u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(5) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c6\u008a \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00ba\u00eb\u00ce \u00c6\u008a \u00be\u00f8\u00ef\u00c7\u00e5\u00e0\u00bd\u00e5\u00c6\u00be \u00c0\u00ce\u00e8\u00ef\u00c2\u00e5\u00e0\u00bd\u00c6\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00c0\u00ce\u00e8\u00ef\u00c2\u00e5\u00e0\u00bd \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00b4 \u00c6\u008a\u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00a8\u00e0 \u00c8\u00e6\u00c2\u00ea\u00b8\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00c4 \u00c0\u00ce\u00e8\u00ef\u00c2\u00e5\u00e0\u00bd\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ce\u00e8\u00ef\u00c2\u00e5\u00e0\u00bd \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0, \u00a1\u00c9\u00ca\u00f1 \u00c6\u00c6\u00fa \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00cc\u00e8\u00c6\u00f5 \u00c0\u00e8\u00c6\u00c9\u00c7\u00c9\u00cd\u00e5\u00c4 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6."
