    "chunk_text": "(\u00a1\u00e5) \u00a6\u00a8\u00f9 \u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00be\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00d1 \u00cc\u00e8\u0090\u00be \u00cc\u00e8\u00c6\u00f5 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0, \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 5 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00c9\u00ec \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00be\u00e0 \u00ef\u00c8\u00cc \u00cc\u00ce\u00a8\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n23. \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n24. \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0, -\n\n(i) \u00b6\u00ef\u00c6\u00e5\u00e0\u00cc\u00e0\u00c0\u00c6\u00fa\u00ef\u00c7\u00e5\u00cc\u00e0 \u00ef\u00c4\u00c8\u00ef\u00be\u00e5\u00a8\u00e0\u00cc\u00e8\u00ef\u00c8\u00e5\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00b6\u00ef\u00c6\u00e5\u00cc\u00e0\u00c0\u00c6\u00fa\u00ef\u00c7\u00e5\u00cc\u00e0\u00a6\u0094\u00be\u008a \u00c6\u00be \u00a4\u00bc\u00e0\u00c3\u00e8\u00bc \u0097\u00bc\u00f1\u00e5\u00ba\u00e0\u00c4\u00a8 \u00be\u00e5\u00c4\u00ef\u00c6\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be\u00a6\u00c2\u00be\u00be\u00f8 \u00c9\u00da\u00aa\u00ef\u00c6\u00e0 \u00ab\u00da\u00c4 \u00a8\u00c8\u00e5\u00c0\u00e9\u00c6 \u00ca\u00e5\u00a9\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00c6\u008a\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8 \u00ca\u00e5\u00a8\u00c6\u00a8\u00f8\u00be\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00be\u00e0\u00be\u00e5 \u00ef\u00a8\u00e5\u00ce\u00c6\u00a8 \u00a7\u00ba\u00be \u00c8\u00bc\u00e0\u00bc\u00e5\u00c9\u00ec; \u00cc\u00cd\n\n(ii) \u00f3\u008a\u00c0\u00e5\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00bc\u00e5 \u00c9\u00ec\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.;\n\n\u201c\u00cc\u00ea\u00c7\u00e6 \u00b4\u00ea \u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00a8\u00c0\u00e5 \u00ef\u00c0\u00e5\u0091\u00a8\u00c7, \u00a8\u00e6\u00c2\u00c8\u00e8\u00a8\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00eb\u00b6\u00ea\u00a8\u00c7 -\n\n(i) \u00f3\u008a\u00ef\u00a8\u00e5\u00ce\u00c6\u00a8 \u00a7\u00ba\u00be \u00c8\u00bc; \u00cc\u00cd\n\n(ii) \u00f3\u008a\u00c0\u00e5\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.;\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n1999 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00c2\u00f3 \u00c0\u00be\u00ba15\n\n\u201c\u00cc\u00e8\u00aa\u00db \u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00cc\u00e8\u00aa\u00db \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u0097\u00ef\u00ca\u00e0\u00cb\u00ef\u00c6\u00be\u00e0\u00c9\u00c9\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00a8\u00c0\u00e5 \u00ef\u00c0\u00e5\u0091\u00a8\u00c7, \u00a8\u00e6\u00c2\u00c8\u00e8\u00a8\u00c7 \u00ef\u00cd\u00e5\u00e0\u00a8\u00eb\u00b6\u00ea\u00a8\u00c7 -\n\n(i) \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00ef\u00cd\u00e5\u00e0 \u009f\u0091 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00a8\u00ce \u00ef\u00a8\u00e5\u00ce\u00c9\u00da\u00aa\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00c6\u008a \u00c9\u00da\u00aa\u00c6\u00a8 \u00bc\u00c9\u00b4\u00be\u00c6\u00a8 \u00a7\u00ba\u00be\u00c8\u00bc\u00e0\u00bc\u00e5 \u00c9\u00ec; \u00cc\u00cd\n\n(ii) \u00f3\u008a\u00c0\u00e5\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\n\n\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c;\n\n\u201c\u00cc\u00e8\u00aa\u00db \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00a8\u00c9\u00c7 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00c9\u00ea\u00c9 \u00bc \u00bc\u00c9\u00b4\u00be\u00c6\u00a8\u00a7\u00ba\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00cc\u00cd \u00f3\u008a\u00c0\u00e5\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00f3\u008a\u00ef\u00a8\u00e5\u00ce\u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be \u00a1\u00ba\u00c7, \u009f\u0091, \u00cc\u00ea\u00c7\u00e6 \u00b4\u00ea \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e8\u00aa\u00db \u00a3\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00ef\u00be\u00e5\u00ef\u008c.\n\n\u201c\u00cc\u00ea\u00c7\u00e5\u00c2\u00f3 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00cc\u00ea\u00c7\u00e5\u00c2\u00f3\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00ea\u00c7\u00e5\u00c2\u00f3 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n\u201c\u00ef\u00da\u00aa\u00eb \u00c2\u00f3 \u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ef\u00da\u00aa\u00eb \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00be\u00c9\u00e5 \u00a1\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00ef\u00da\u00aa\u00eb \u00c2\u00bc\u00e0\u00bc \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n\u201c\u00ef\u00da\u00aa\u00eb \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ef\u00da\u00aa\u00eb \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00da\u00aa\u00eb \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00a1\u00bc\u00cd\u00cc\u00e0\u00ef\u008c.\n\n\u201c\u00cc\u00ea\u00c7\u00e5\u00c2\u00f3 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, 1989, \u00a1\u00e2\u00a8 13\u00bc\u00c7\u00be \u00cc\u00ea\u00c7\u00e5\u00c2\u00f3 (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00c8\u00bc \u00cc\u00ea\u00c7\u00e5\u00c2\u00f3 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n\u201c\u00cc\u00ea\u00c7\u00e5 \u00c2\u00bc\u00e0\u00bc \u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, 1989 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00cc\u00ea\u00c7\u00e5\u00c2\u00f3 (\u0097\u00ef\u00ca\u00e0\u00cb\u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00be\u00c9\u00e5 \u00a1\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00cc\u00ea\u00c7\u00e5 \u00c2\u00bc\u00e0\u00bc\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n\u201c\u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00ca\u00e5\u00c8\u00e5\u00c9\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0-(\u00a1) \u00cc\u00e8\u00aa\u00db , \u00cc\u00ea\u00c7\u00e6 \u00b4\u00ea, \u009f\u0091, \u00cc\u00e8\u00aa\u00db \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8 \u00ef\u00cd\u00e5\u00e0\u00c0\u00c6\u00fa\u00c0\u00e0\u00c0 \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00c7 \u00ef\u00aa\u00be \u00c6\u00be\u00ea\u00c8\u00c2\u00be \u00a8\u00c9\u00c7 \u00c9\u00ea\u00c9\u00bc \u00c0\u00d6\u00ca\u00f2\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ; \u00ba\u00c9\u00bc,\n\n161999 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00c2\u00f3 \u00c0\u00be\u00ba\n\n(\u00a1\u00e5) \u00a2\u00cd\u00ba (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00c0\u00d6\u00ca\u00f2\u00c6\u00a8\u00e0 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00c9\u00c0\u00c9\u00ba\u00e0\u00c9\u00e5 \u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00aa\u00c2\u00b6\u00e5\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8\u00e0 \u00a3\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c."
