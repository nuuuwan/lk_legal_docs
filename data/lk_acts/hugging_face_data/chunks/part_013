    "chunk_text": "3.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00a6\u00ef\u00cd\u00ba\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00cd\u00ba\u00a8\u00b4\u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 (\u00a1\u00da\u00bd \u00cc\u00ea\u00ef\u00a9\u00e5\u00e0\u00c0\u00ef\u00c3\u00e5\u00e0\u00aa\u00fb \u00bc\u00e0\u0097\u00ba\u00e0\u00c9 \u00a8\u00e5\u00da\u00c6 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da\u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be) \u00cc\u00e7\u00c4 \u00cc\u00ea\u00ef\u00a9\u00e5\u00e0\u00c0\u00ef\u00c3\u00e5\u00e0\u00aa\u00fb \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0 \u201d \u00c6\u00be \u00c9\u00ae\u00be\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a6\u00ef\u00cd\u00ba\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00cd\u00ba\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 (\u00a1\u00da\u00bd\u00cc\u00ea\u00ef\u00a9\u00e5\u00e0\u00c0\u00ef\u00c3\u00e5\u00e0\u00aa\u00fb \u00bc\u00e0\u0097\u00ba\u00e0\u00c9 \u00a8\u00e5\u00da\u00c6 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u00aa\u00be\u00e0 \u00c7\u00bb\u00c6\u00a8\u00e0\u00ef\u00be\u00e5\u00c9\u00be) \u00cc\u00e7\u00c4 \u00cc\u00ea\u00ef\u00a9\u00e5\u00e0\u00c0\u00ef\u00c3\u00e5\u00e0\u00aa\u00fb \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0 \u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00e5\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e03 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n1995 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 2 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6.\n\n\u201c\u009c\u00cc\u00c8\u00e0 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da\u00c9\u00e5\u00cd\u00be \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c2\u00bc\u00e0\u00bc.\n\nH - 022545\n\n4.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 4 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00a6\u00ef\u00cd\u00ba\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00cd\u00ba\u00a8\u00b4\u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e7\u00c4 \u00a1\u00da\u00bd \u00cc\u00ea\u00ef\u00a9\u00e5\u00e0\u00c0\u00ef\u00c3\u00e5\u00e0\u00aa\u00fb \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a6\u00ef\u00cd\u00ba\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00cd\u00ba\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 (\u00a1\u00da\u00bd \u00cc\u00ea\u00ef\u00a9\u00e5\u00e0\u00c0\u00ef\u00c3\u00e5\u00e0\u00aa\u00fb \u00bc\u00e0\u0097\u00ba\u00e0\u00c9 \u00a8\u00e5\u00da\u00c6 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u00aa\u00be\u00e0 \u00c7\u00bb\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be) \u00cc\u00e7\u00c4 \u00a1\u00da\u00bd \u00cc\u00ea\u00ef\u00a9\u00e5\u00e0\u00c0\u00ef\u00c3\u00e5\u00e0\u00aa\u00fb \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n5.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 5 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00a6\u00ef\u00cd\u00ba\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00cd\u00ba\u00a8\u00b4\u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e7\u00c4 \u00a1\u00da\u00bd \u00cc\u00ea\u00ef\u00a9\u00e5\u00e0\u00c0\u00ef\u00c3\u00e5\u00e0\u00aa\u00fb \u00bc\u00e0\u0097\u00ba\u00e0\u00c9 \u00a8\u00e5\u00da\u00c6 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da\u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u00c4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a6\u00ef\u00cd\u00ba\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00cd\u00ba\u00a8\u00b4\u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 (\u00c9\u00e6\u00aa\u00be\u00e0 \u00c7\u00bb\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be) \u00cc\u00e7\u00c4 \u00a1\u00da\u00bd\u00cc\u00ea\u00ef\u00a9\u00e5\u00e0\u00c0\u00ef\u00c3\u00e5\u00e0\u00aa\u00e9 \u00bc\u00e0\u0097\u00ba\u00e0\u00c9 \u00a8\u00e5\u00da\u00c6 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c4\u201d \u00c6\u00be\u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n6.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 6 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00a1\u00da\u00bd \u00cc\u00ea\u00ef\u00a9\u00e5\u00e0\u00c0\u00ef\u00c3\u00e5\u00e0\u00aa\u00fb\u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be \u00c2\u00bc\u00e0\u00bc \u00cc\u00cd \u00a1\u00da\u00bd \u00cc\u00ea\u00ef\u00a9\u00e5\u00e0\u00c0\u00ef\u00c3\u00e5\u00aa\u00fb \u00bc\u00e0\u0097\u00ba\u00e0\u00c9 \u00a8\u00e5\u00da\u00c6 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da\u00c9\u00e5\u00cd\u00be \u00c2\u00bc\u00e0\u00bc \u00cc\u00cd \u00a3\u00b4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00bc\u00b8\u00e0\u00b6\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u201d \u00c6\u00be \u00c9\u00ae\u00be\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a1\u00da\u00bd \u00cc\u00ea\u00ef\u00a9\u00e5\u00e0\u00c0\u00ef\u00c3\u00e5\u00e0\u00aa\u00fb \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be \u00c2\u00bc\u00e0\u00bc \u00cc\u00cd \u00a1\u00da\u00bd\u00cc\u00ea\u00ef\u00a9\u00e5\u00e0\u00c0\u00ef\u00c3\u00e5\u00e0\u00aa\u00fb \u00bc\u00e0\u0097\u00ba\u00e0\u00c9 \u00a8\u00e5\u00da\u00c6 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be \u00c2\u00bc\u00e0\u00bc\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n7.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00e5\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 7 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00c6\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00e5\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa 7 \u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6:-\n\n\u201c7\u00a1 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be \u00c0\u00be\u00ef\u00ba\u00e0 37 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be \u00c0\u00be\u00ba\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00c9\u00ec\u00c0\u00ce\u00e5\u00ba\u00e0 \u00cc\u00c3\u00e5\u00c9\u00a8 \u00c6\u008a \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00a8 \u00a3\u00b4 \u00a1\u00be\u00ea\u00c7\u00e7\u00c0 \u00c6\u008a\u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be\u00c6\u00a8 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00ce \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00ef\u00bc\u00e0 \u00c4\u00e5\u00cc \u00cd\u00c6\u00a8\u00b4\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00b4 \u00ef\u00be\u00e5\u00aa\u00e6\u00be\u00f9\u00c4\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5\u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c6\u008a \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5"
