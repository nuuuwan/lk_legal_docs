    "chunk_text": "(\u00a4)\u00a3\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c7\u00af\u00b9\u00c6 \u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00a9\u00be\u00c6\u00cd\u00be\u00c7\u00dd\u00ba\u00c6, \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 5 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b9\u00b6\u00c8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00b7\u00c9\u00af\u00c6\u00d0\u00b6\u00df\u00ba\u00c6\u00cd\u00b9\u00b5\u00be\u00c6\u00af\u00e0\u00ba\u00c6\u00b0\n\n181999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00da\u00ce\u00af\u00bb\u00c8\u00ce\u00be\u00c1\u00bc\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n24. \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 -\n\n\u201c\u0093\u0088\u201d \u00a9\u0081\u00b9\u00d7, \u00a3\u00d7 \u00cc\u00c1\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00cc\u00be\u0081\u00b8,\u00b7\u00d2\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00cc\u00be\u0081\u00b8, \u00cc\u00b7\u00c7\u00dd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00cc\u00be\u0081\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00d7{\u00bf\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00cc\u00be\u0081\u00b8 -\n\n(i) \u201c\u00a9\u00b9\u00b8\u00b8\u00c8\u00cd\u00bb \u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00d0\u00d5\u00ba\u00c6\u00b9\u00b6\u00c6\u00ce\u00b6\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b7\u00c6\u00b6\u00d7\u00ba\u00c6\u201c\u00ce\u00b4\u00cd\u00bb\u00c7\u0083\u00ce\u00b9\u00cd\u00bd\u00c7\u0083 \u00cc\u00ba\u00be\u00cc\u00bf\u00c7\u00af\u00c6\u008e \u00cd\u00be\u00c7\u0081\u201d \u00a3\u00be\u00c6\u00be\u00d7\u201c\u00ce\u00b4\u00bb\u00c7\u0083\u00ce\u00b9\u00cd\u00bd\u00c7\u0083 \u00a9\u0089\u00b8\u00ba\u00c6\u201d \u00a9\u00b8 \u00a3\u00bd\u00c8\u00bb\u00b9\u00c6\u00b9\u00d5\u00c1\u00d7\u00ba\u00c7\u00b8\u00b6\u00c7\u00c1\u00bc\u008c\u00bb\u00be\u00c6 \u00cc\u00b9\u00bb\u00ce\u00bc\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00b4 \u00a7\u0082\u00b5\u00c1\u00be\u00bb \u00ba\u00bc\u00b6\u00c6\u00b6\u00c8\u0081\u00a5\u00ce\u00be\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00b9\u00b6\u00c8\u0095\u00b4\u00c6\u00d5\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00ce\u00c1\u00b6\u00c6\u00d7\u00b1\u00c6 \u00d2\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00ba\u00c6 \u00a4\u00b8; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(ii) \u00da\u00ce\u00af\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00db\u0081\u00b8\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00ba\u00c6 \u00a4\u00b8 \u0093\u0088\u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00af\u00c6\u00cc\u00af\u00b8 \u008c\u00cd\u00b1\u00b4\u00ba\u00c7\u00af\u00b9\u00c6 \u00b9\u008a\u00bc\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00da\u00ce\u00af\u008a\u00ce\u00be \u00a9\u00b8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n\u201c\u00d2\u00dd\u00b4\u00c6\u00d5\u201d \u00a9\u0081\u00b9\u00d7, \u00cc\u00c1\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00cc\u00be\u0081\u00b8, \u00b7\u00d2\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00cc\u00be\u0081\u00b8, \u00cc\u00b7\u00c7\u00dd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00cc\u00be\u0081\u00b8\u00a3\u00be\u00c6\u00be\u00d7 \u00d7{\u00bf\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00cc\u00be\u0081\u00b8 -\n\n(i) \u00da\u00ce\u00af\u008a\u00ce\u00be\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00be\u00c6 \u00ce\u00c1\u00b6\u00c6\u00d7\u00b1\u00c6 \u00d2\u00dd\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00ba\u00c7\u00b8,\u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(ii) \u00da\u00ce\u00af\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00db\u0081\u00b8\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00ba\u00c7\u00b8, \u00da\u00ce\u00af\u008a\u00ce\u00be \u00a9\u00b8\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n\u201c\u00b1\u00c8\u00af\u00bc\u00b4\u00c6\u00d5\u201d \u00a9\u0081\u00b9\u00d7, \u00cc\u00c1\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00cc\u00be\u0081\u00b8, \u00b7\u00d2\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00cc\u00be\u0081\u00b8, \u00cc\u00b7\u00c7\u00dd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00cc\u00be\u0081\u00b8\u00a3\u00be\u00c6\u00be\u00d7 \u00d7{\u00bf\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00cc\u00be\u0081\u00b8 -\n\n(i) (\u0093\u0088 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00af\u00c6\u00af\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00da\u00ce\u00af\u008a\u00ce\u00be\u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00ce\u00be \u00b6\u008c\u00bc\u00c6\u00b7\u00c6\u00b6) \u00cd\u00c1\u00de \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00ce\u00af\u00ce\u00bb\u00b1\u00c6\u00cd\u00b1\u00bc\u00c6\u00b7\u00c6\u00b6 \u00af\u00c7\u00b9\u00c6\u0089\u00ce\u00be\u008a\u00be\u00c6 \u00ce\u00c1\u00b6\u00c6\u00d7\u00b1\u00c6 \u00d2\u00dd\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00ba\u00c7\u00b8;\u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00cd\u00af\u00c7\u00b4\u00be\u00c6\u00b0\n\n191999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00da\u00ce\u00af\u00bb\u00c8\u00ce\u00be\u00c1\u00bc\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(ii) \u00da\u00ce\u00af\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00db\u0081\u00b8\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00ba\u00c7\u00b8,\n\n\u00b1\u00c8\u00af\u00bc\u00b4\u00c6\u00d5 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00af\u00c6\u00cc\u00af\u00b8 \u008c\u00cd\u00b1\u00b4\u00ba\u00c7\u00af\u00b9\u00c6 \u00b9\u008a\u00bc\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00da\u00ce\u00af\u008a\u00ce\u00be \u00a9\u00b8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n\u201c\u00b1\u00c8\u00af\u00bc\u00b4\u00c6\u00d5\u00b9\u00c6 \u00b9\u00b6\u00c8\u0095\u00b4\u00c6\u00d5\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7, \u00a9\u00c1\u00c6\u00c1\u00ce\u00af\u00bb\u00c7\u00b8\u00af\u00c7\u00b9\u00c6\u0089\u00ce\u00be\u008a\u00be\u00c6 \u00a9\u00c1\u00c6\u00e2\u00dd\u00c1\u00b6\u00c6\u00b6\u00c8\u00df\u00ba\u00c6 \u00ce\u00c1\u00b6\u00c6\u00d7\u00b1\u00c6 \u00d2\u00dd\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00ba\u00c6 \u00da\u00ce\u00af\u0089\u0088\u00b6\u00c6\u00b6\u00df\u00af\u00c6\u00cc\u00af\u00b8 \u00db\u0081\u00b8\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00ba\u00c7\u00b8\u00a9\u00c1\u00c6\u00c1\u00ce\u00af\u00bb\u00c7\u00b8\u00d7\u00ba\u00c7\u00b8 \u00da\u00ce\u00af\u008a\u00ce\u00be\u00cc\u00bb\u00b8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6,\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u0093\u0088\u00cc\u00bb\u00c7\u0081\u00ce\u00bd, \u00d2\u00dd\u00b4\u00c6\u00cc\u00b4\u00c7\u0081\u00ce\u00bd \u00a3\u00be\u00c6\u00be\u00d7\u00b1\u00c8\u00af\u00bc\u00b4\u00c6\u00d5 \u00ac\u0081\u00ce\u00bd \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00af\u00c7\u00d7 ;\n\n\u201c \u00ba\u00d7\u00c1\u00bc\u00c8 \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u201d \u00a9\u0081\u00b9\u00d7, \u00ba\u00d7\u00c1\u00bc\u00c8\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ba\u00d7\u00c1\u00bc\u00c8\u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n\u201c\u00d2+\u00c6\u00af\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00ce\u00c1\u201d \u00a9\u0081\u00b9\u00d7, \u00d2+\u00c6\u00af\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a5\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00d2+\u00c6\u00af\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00ce\u00c1\u00a9\u00b8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n\u201c\u00d2+\u00c6\u00af\u00b9\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u201d \u00a9\u0081\u00b9\u00d7, \u00d2+\u00c6\u00af\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00d2+\u00c6\u00af\u00b9\u00c6\u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 \u00a9\u00b8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;"
  },
