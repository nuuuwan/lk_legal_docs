    "chunk_text": "(4) \u00ba\u00c4\u00e5\u00b4\u00c4 \u00ba\u00c4\u00e5\u00ef\u00aa\u00e0 \u00be\u00b6\u00ba\u00e0\u00ba\u00eb\u00c9 \u00a8\u00c7\u00aa\u00ba \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00e8, \u00a1\u00e5\u00c2\u00e5\u0093\u00ba\u00bc\u00c7\u00e6\u00c9\u00a8\u00eb \u00be\u00b6\u00ba\u00e0\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4, \u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00ba\u00e0 \u00c9\u00ba\u00e0\u00a8\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c4\u008c\u00c0\u00e8\u00c6\u00be\u00e0\u00ef\u00aa\u00be\u00e0\u00ef\u00a8\u00be\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00be\u00e5\u00cc\u00c8\u00a8\u00e5 \u00cd\u00d6\u00be \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 , \u00be\u00b6\u00ba\u00e0\u00ba\u00eb \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00c4\u00ba \u00cc\u00cd \u00a6\u00e0 \u00ef\u00be\u00e5\u00cc\u00c8\u00a8\u00e5\u00cd\u00e6\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00f8\u00d7\u00c4 \u00a7\u00c0\u00e0\u00c0\u00ea \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4, \u00c4\u008c\u00c0\u00e8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00cc\u00cd \u00a6\u00e0 \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00bc\u00c7\u00e6\u00c9\u00e5\u00ef\u00aa\u00e0 \u00c9\u00ba\u00e0\u00a8\u008a \u00cd\u00e5 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00be\u00ea\u00aa\u00ba\u00a8\u00c7\u00e6\u00b8\u00ea \u00cc\u00e6\u00c8\u00a8\u00e8\u00c8\u00e0\u00c8\u00b4 \u00aa\u00be\u00f8\u0095\u00be\u00e0, \u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00ea\u00f3\u00cc\u00ea \u00c6\u00c6\u00e8\n\n1999 \u00a1\u00e2\u00a8 37 \u00bc\u00c7\u00be \u00be\u00b6\u00ba\u00e0\u00ba\u00eb \u00c0\u00be\u00ba3\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u0097\u00c9\u00e5\u00cd\u00c6\u00a8\u00f8\u00be\u00e0 \u00be\u00ec\u00c0\u00be\u00e0 \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00bc\u00c7\u00e6\u00c9\u00a8\u00eb \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00c9\u00be \u0097\u00b4\u00a8, \u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00e5 \u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00c0\u00f2\u00c2\u00c8 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00c4\u00aa\u00fa\u00be\u00e0\u00c4\u008c\u00c0\u00e8\u00c6\u00c3\u00e5\u00c9\u00c6 \u00ba\u00cd\u00c9\u00ea\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u0095\u00cc, \u00a6\u00c9\u00e6\u00be\u00f8 \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea\u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(5) (1) \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 (2) \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 (3) \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 (4) \u00c9\u00be \u00ef\u00cd\u00e5\u00e0\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00a1\u00be\u00ea\u00c9 \u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00a8\u00e0 \u00ef\u00aa\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5\u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8,\u00c9\u00e5\u00da\u00ba\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c4\u00be\u00e5 \u00ef\u00cd\u00e0\u00ba\u00ed\u00be\u00e0 \u00c4\u00ba \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00bc\u00fa\u00be\u00c6\u00a8 \u00cc\u00e8\u00b4\u00ef\u00aa\u00d1\u008a \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6\u00c6\u00e8 \u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00b3\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e0\u00be\u008a\u0095\u00cc, \u00be\u00b6\u00ba\u00e0\u00ba\u00eb \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00ef\u00c9\u00ba \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4 \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 \u00c6\u008a\u00bc\u00fa\u00be\u00c6\u00a8 \u00bc \u00a6 \u00bc\u00fa\u00be \u00c0\u00b4\u00be\u00e0 \u00a6\u00e0 \u00bc\u00fb\u00c4\u00be\u00e5\u00c9 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(6) \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fb, \u00c6\u008a \u00ce\u00c4\u00c6\u00a8\u00eb \u0097\u00c6\u00c0\u00ba\u00e0 \u00bc\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00bc\u00c7\u00e6\u00c9\u00a8\u00eb \u00be\u00b6\u00ba\u00e0\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba\u00c0\u00d6\u00bc\u00fa ,(2) \u00c9\u00be, (3) \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00a1\u00e6\u00ba\u00e8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0, \u00c0\u00e5\u00da\u00ca\u00c9\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4 \u00c4\u00ba\u00ef\u00cd\u00e5\u00e0 \u00a1\u0093\u00a8\u00c7\u00b8\u00ef\u00c6\u00e0 \u00ef\u00c4\u00ef\u00cd\u00c6\u00d1\u00ef\u00c4\u00be\u00e0 \u00c4 \u00ef\u00cd\u00e5\u00e0, \u00a6\u00e0 \u00c4\u008c\u00c0\u00e8\u00c6 \u00ef\u00bc\u00ef\u00bc\u00be\u00e5 \u00a1\u00ba\u00eb\u00ef\u00c7\u00be\u00e0\u00a1\u00ef\u00be\u00a8\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a6\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00b4 \u00c0\u00e5\u00da\u00ca\u00c9\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00e8 \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00c4\u008c\u00c0\u00e8\u00c6 \u00ef\u00bc\u00ef\u00bc\u00be\u00e5\u00ef\u00aa\u00be\u00e0 \u00a6\u00a8\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00ef\u00cd\u00e5\u00e0\u00a7\u00c9\u00ea\u00be\u00e0 \u00ef\u00bc\u00ef\u00bc\u00be\u00e5\u00b4 \u00c4 \u00ef\u00cd\u00e5\u00e0 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00a4\u008e\u00ba \u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n3.\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00ce\u00c4\u00c6\u00a8\u00eb, \u0097\u00c6\u00c0\u00ba\u00e0 \u00bc\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00c2\u00e5\u0093\u00ba\u00bc\u00c7\u00e6\u00c9\u00a8\u00eb \u00be\u00b6\u00ba\u00e0\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00c6\u008a \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a1\u00c6\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c9 \u00ba\u00f8\u00c2\u00ec \u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a\u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cd\u00e6\u00c7, \u00a6\u00e0 \u00a1\u00e5\u00b3\u00e5\u00c9 \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00e8, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8 \u00ce\u00c4\u00c6\u00a8\u00eb, \u0097\u00c6\u00c0\u00ba\u00e0 \u00bc\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00bc\u00c7\u00e6\u00c9\u00a8\u00eb\u00c9 \u00cc\u00e8\u009b\u00c4\u00be\u00ba\u00c7 \u00d1\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea \u00a6\u00e0 \u00a1\u00e5\u00b3\u00e5\u00c9 \u00be\u00f8\u00da\u00c2\u00c8 \u00cc\u00cd \u00a1\u00c9\u00c8\u00e2\u00aa\u00eb \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n\u00a1\u00e5\u00b3\u00e5\u00c9 \u00c9\u00c8\u00e2\u00aa\u00eb\u00c9\u00be\u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9.\n\n1999 \u00a1\u00e2\u00a8 37 \u00bc\u00c7\u00be \u00be\u00b6\u00ba\u00e0\u00ba\u00eb \u00c0\u00be\u00ba4\n\n4.(1) \u00be\u00b6\u00ba\u00e0\u00ba\u00eb \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 _"
