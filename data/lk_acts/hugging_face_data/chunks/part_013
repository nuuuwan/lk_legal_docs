    "chunk_text": "1 \u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6, 1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 11 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af,\u00b9\u00bb+\u00c6\u00af\u00bc\u00c1\u00c7\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00d0\u00ae\u00d5\u00b6\u00c6\u00b6\u00c7\u00af\u00c6\u00d0\u00b6\u00be\u00c6\u00af\u00ce\u00bf \u00ac\u00d5\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\u00a9\u00b8 \u00a9\u00d5\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c7\u00be\u00c6,\u00c1\u00c7\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00c8\u008a\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00f2\u00be\u00ba\u00c6, 1998 \u00b1\u00b8\u00c1\u00bc\u00c812 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8\u00bb\u0081\u00de \u00b7\u00c8\u00bb[\u00cd\u00bb\u00c7\u00bc\u00c6\u00af\u00c6\u00af\u00c8\u00be\u00c6 \u00ce\u00af\u00cc\u00bb\u00c7\u00b9\u00c6\u00b9\u00ba\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4,\u00b9\u00bb+\u00c6\u00af\u00bc\u00c1\u00c7\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00d0\u00ae\u00d5\u00b6\u00c6\u00b6\u00c7\u00af\u00c6\u00d0\u00b6\u00be\u00c6\u00af\u00ce\u00bf \u00ac\u00d5\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8\u00b1\u00ba\u00c1\u00c7\u00bb\u00ba\u00c6 (\u00a5\u00d7 \u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u201c\u00b1\u00ba\u00c1\u00c7\u00bb\u00ba\u00c6\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00c1\u00df\u00e2\u00af\u00c6\u00d0\u00c1\u00dd\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8\u00bb\u00c7\u00af \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b6\u00c8\u00af\u00b6\u00c8\u00bb\u0081\u00de \u00a5\u00be+\u00c6\u00ce\u00af \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u0089\u00be\u00c6 \u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00af\u00c6\u00d0 \u00c1\u00dd\u00b6\u00df\u00ba\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\nH- 22545\n\n2 1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 11 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00b9\u00bb+\u00c6\u00af\u00bc\u00c1\u00c7\u00b6\u00c8\u00af\u00bf\u00c8\u0081\u00d0\u00ae\u00d5\u00b6\u00c6\u00b6\u00c7\u00af\u00c6\u00d0\u00b6\u00be\u00c6\u00af\u00ce\u00bf \u00ac\u00d5\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n2 \u00b0 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c6, \u00af\u00c7\u00be\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00af\u00c6\u00af\u00c7\u00be\u00ba\u00c6, \u00c1\u00c7\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00c8\u008a\u00be\u00c6\u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008a\u0081 \u00f2\u00be\u00ba\u00c6 \u00b1\u00ba\u00c1\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8\u00b6\u00c8\u00bd\u00b6\u00c6\u00b6\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u00b8 \u00a3\u00bc\u00d2\u00af\u00ce\u00bf \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c7\u00ba\u00c6\u00b0 \u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\u00a9\u00b7\u00c6\u00b6 \u00a3\u00bc\u00d2 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00de \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6\u00a3\u00bc\u00d2 \u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u201c\u00b1\u00ba\u00c1\u00c7\u00bb \u00a3\u00bc\u00d2\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00b0\n\n3 \u00b0 (1) \u00cc\u00b9\u00c7\u00d7\u00ba\u00af\u00c6\u00af\u00bf\u00c8\u0081 \u00b9\u00bb\u0081\u00b9\u00c7\u00b4\u00c6\u00d5\u00af\u00c6\u00af\u00c7\u00b8 \u00ad\u00bc\u00c8\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6, \u00ad\u00bc\u00c6 \u00a3\u00bc\u00b1\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00c1\u00b1\u00b6\u00c8\u00af\u00c6\u00e7\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6, \u00ac\u00dd \u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00d7\u00db\u00ce\u00bd\u00ce\u00ba\u008a\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00bf\u00c6\u00bf\u00af\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00ba\u00b9\u00c6\u00da \u00c1\u00b1\u00b6\u00c8\u00af\u00c6 \u00e7\u00b4\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u00be\u00c6,\u00a3\u00b6\u00d9\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af :\u2013\n\n(\u00a3) \u00a5\u00bd\u00b9\u00c6\u00ce\u00b9 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00c7\u00bc\u00d7{\u00bc\u00ba\u00c7\u00b8 \u00a7\u00b4\u00be\u00c6 \u00a8\u00ce\u00bd\u00aa\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a5\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0, \u00c1\u00b1\u00b6\u00c8\u00af\u00c6\u00e7\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7\u00db\u00ce\u00bd\u00ce\u00ba\u00af\u00c6\u00d0 \u00b9\u00bc\u00b7\u00c6\u00b6\u00bf\u008c\u00be\u00c7\u00b8 \u00a3\u00c0\u00c8\u00ce\u00c1, \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00a3\u00c0\u00c8\u008c\u0081 \u008c\u00ce\u00bf\u00c1\u00c7\u00af \u00b9\u00c7\u00bc\u00c8\u00bb \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc \u00a5\u00c0\u00b9\u00c6\u00da\u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b1\u00c7\u00b6\u00c6\u00b6\u00c8\u00bb\u00db\u00bf\u00c6\u00bf \u008c\u00b4\u00b6\u00c6\u00d7\u00a3\u00b6\u00ce\u00b8 \u00aa\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6,\n\n\u00db\u0081\u00b8\u00b6\u00c6\u00d7\u00b4\u0081 \u00cc\u00c1\u0088\u00cc\u00b9\u00c7\u00dd\u00cc\u00bf\u00c7\u0081\u00ce\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u008a\u00bc\u00c6\u00b1\u00c6\u00cd\u00b1\u00b6\u00ba\u00c6 \u00aa\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6 \u00af\u00dd\u008c\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00b1\u00b4\u00c6\u00b4\u008c\u00cd\u00bc\u00c7\u00b6\u00ba\u00c7\u00af\u00e2\u00ba\u00c6\u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u00b8\u00e2\u00ba\u00c6 \u00a3\u00d9\u00b9\u00c6\u0089\u00ce\u00c1\u00af\u00c6\u00af\u00c8\u0081\u00bd, \u00a5\u00b4\u00c6\u00d5\u00ce\u00c1\u00af\u00c6\u00af\u00c8\u0081\u00bd,\u00cc\u00c1\u0088\u00b6\u00c9\u00bc\u00c6\u00af\u00c6\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b9\u00c7\u00bd\u00c8\u008a\u00d5\u00af\u00c8\u0081\u00bd \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6\u00a4\u00bf\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c6\u00bd\u00c1\u00c7\u00bf\u00c8\u00bb\u00c7\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00cd\u00ba\u00be\u00c6\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00af\u00bc\u00c6\u008c\u00b8\u00c6 \u00ba\u00c9\u00b6\u00c7\u00b8 \u008c\u00bf\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u0089\u0081\u00b8\u00bc\u00c6 \u00d0\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u0081\u00cd\u00ba\u00be\u00c6 \u00b9\u00b6\u00c8\u00ce\u00b8\u00b7\u00c6\u00d7 \u00a4\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6\u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00a5\u00dd\u00b9\u00d7 \u00a4\u00ae\u00d5\u00af\u00ce\u00bf \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00b6\u00c7\u00dd\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0 \u00ba\u00bd\u00c8\u00bb\u00bd\u00c6\u00bd\u00ae\u00b4\u00ce\u00b8\u00dc\u00b4\u0081 \u00b6\u00ae\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) (\u00a3) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00da\u00bc\u00c8\u00bb\u00a9\u00b6\u00c6\u00b6\u00b8\u00c8\u00af\u00c6\u00af\u00c8\u0081\u00bd ;\n\n(\u00a4) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00da\u00bc\u00c8\u00c1\u00b6\u00c8\u00be\u00c6\u00a7\u00b6\u00e2\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00b4\u00b7\u00c6\u00ce\u00b6\u00bb\u00c7\u008a\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd ;\u00a3\u00be\u00c6\u00be\u00d7\n\n\u00b1\u00ba\u00c1\u00c7\u00bb \u00a3\u00bc\u00d2\u00af\u00bf\u00c6\u00b0\n\n\u00b9\u00bb+\u00c6\u00af\u00bc\u00c1\u00c7\u00b6\u00d0\u00ae\u00d5\u00b6\u00c6\u00b6\u00c7\u00af\u00c6\u00d0\u00b6\u00be\u00c6\u00a9\u0081\u00d9\u00ba\u00c6 \u00b6\u00c1\u00de\u00b0\n\n31999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 11 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00b9\u00bb+\u00c6\u00af\u00bc\u00c1\u00c7\u00b6\u00c8\u00af\u00bf\u00c8\u0081\u00d0\u00ae\u00d5\u00b6\u00c6\u00b6\u00c7\u00af\u00c6\u00d0\u00b6\u00be\u00c6\u00af\u00ce\u00bf \u00ac\u00d5\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(\u00a5) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00da\u00bc\u00c8\u00c1\u00b6\u00bd\u00c6\u00d0\u00cd\u00c1\u00cd\u00bd\u00c7\u00bc\u00c6 \u00a4\u00e0\u00b4\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u0081\u00d0\u00e1\u00cc\u00c1\u00c7\u0081\u00de\u00b4\u0081 \u00e9\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u00b8\u00c6\u00bd,"
  },
