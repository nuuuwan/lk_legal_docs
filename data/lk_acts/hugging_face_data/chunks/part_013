    "chunk_text": "\u00c0\u00c4\u00ea\u00b8\u00ea\u00c9\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c8\u00e8\u008d\u00ba\u00be\u00f9\u00ba\u00f8\u00c6\u00a8 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8 \u00ef\u00be\u00e5\u00c9\u00be \u00d7\u00ba\u00f8, \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c4\u00cd\u00e5 \u00cc\u00c3\u00e5 \u00db\u00cc\u00e0\u00d1\u00ef\u008a \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c4\u00cd\u00e5 \u00cc\u00c3\u00e5 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb \u00a3\u00b4 \u00c0\u00e6\u0095\u00b8\u00af\u00be\u00e0\u00bc\u00c6 \u00ef\u00bc\u00be \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00ba\u00eb\u00ef\u00be\u00be\u00e0 \u00ef\u00bc\u00a8\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00af\u00be\u00e0\u00bc\u00ef\u00c6\u00be\u00e0\u00cc\u00e7\u00bc\u00fb\u00c4 \u00be\u00e9\u00ba\u00f1\u00e5\u00be\u00ea\u00a8\u00ed\u00c8 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6. \u00a6\u00c9\u00e6\u00be\u00f8 \u00d7\u00ba\u00f8 \u00cc\u00e7\u00bc\u00fb\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea \u00a6\u00c9\u00e6\u00be\u00f8\u00c4\u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb \u00a6\u00c9\u00e6\u00be\u00f8\u00c4 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00a6\u00e0\u00c9\u00e5 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4, \u00a6\u00e0\u00c9\u00e5\u00b4 \u00c6\u00c4\u00a8\u00e0\u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4, \u00a6\u00e0\u00c9\u00e5 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00d6\u0083\u00d2\u00be\u00e0\u00be \u00a8\u00f8\u00d7\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(2) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00ba\u00ba\u00e0\u00a8\u00e5\u00c8\u00ef\u00c6\u00e0 \u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00d7\u00ba\u00f8\u00c9\u00c8\u00b4\u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6.\n\n8. \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0 \u00cd\u00e5 \u00ef\u00c8\u00e0\u00a8\u008a \u00a2\u00bc\u00fa\u00d6\u00c0\u00e8\u00b4 \u00bc\u00fb \u0095\u00cc \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c\u00c4\u00ea\u00f7\u00e5\u00c9 \u00a8\u00f8\u00cc\u00e8\u00f3 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00ba\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00ba\u00c4\u00be\u00e0 \u00c0\u00e6\u0095\u00b8\u00cc\u00e8\u0090 \u00c2\u00c9\u00b4 \u00cc\u00ce\u00a8\u00eb\u00b8\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a7\u00c9\u00ea\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00a8\u00f9 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00ef\u00c6\u00cd\u00fa \u00ba\u00c4\u00be\u008a \u00a1\u00ba\u00e0\u00cc\u00be\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6. \u00a6\u00c4 \u00a1\u00ba\u00e0\u00cc\u00be\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a1\u00ba\u00e0\u00cc\u00be\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c0\u00d6\u00c2\u00e5\u00cd\u00fa\u00c7\u00c9 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6.\n\n9. (1) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00b4 \u00a6\u00cd\u00fa\u00c4 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 \u00ba\u00f1\u00e5\u00aa,\u00ef\u00ba\u00cc\u00e0\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb \u00be\u00e9\u00c6\u00e5\u00bc\u00be, \u00c0\u00e6\u00c9\u00c7\u00e6\u008a, \u00c0\u00d6\u00ba\u00f1\u00e5\u00aa, \u00cc\u008a\u00c4\u00e5\u00bc\u008a \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00cc\u00e8\u00c6\u00f5 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00c2\u00e6\u00e2\u00a8\u00eb \u00a6\u00a8\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u0091 \u00aa\u00b8\u00be\u00a8, \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00be\u0095\u00be\u00e0 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00ef\u00bc\u00e0\u00c0\u00ce \u00c0\u00ea\u00be\u00c7\u00e6\u00ba\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00a1\u00aa\u00c6 \u00a8\u00e0\u00cb\u00c6\u00d1\u00ef\u008a \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0,\u00cc\u00e2\u008e\u00ba\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00bc\u00be\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(3) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00c2\u00c8\u00ba\u00c8 \u00cc\u00cd \u00a8\u00e5\u00da\u00c6 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a2\u00b4\u00ea\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00cc\u00e8\u00c6\u00f5 \u0097\u00c6\u00bc\u008a \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00ef\u00c2\u00f0\u00bc\u00e0\u00bd \u0097\u00bc\u00f1\u00e5\u00c0\u00e9\u00b5\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00cc\u00cd \u00a3\u00b4 \u00a1\u00c6\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00b8\u00c6.\n\n\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00c4\u00ea\u00f7\u00e5\u00c9\u00ba\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6.\n\n\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8.\n\n61999 \u00a1\u00e2\u00a8 23 \u00bc\u00c7\u00be \u00c4\u00cd\u00be\u00ea\u00c9\u00c7 \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd \u0097\u00bc\u00f1\u00e5\u00c0\u00e9\u00b5\u00c6(\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a) \u00c0\u00be\u00ba\n\n\u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00cc\u00cd\u00a1\u00be\u00f1\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4.\n\n10. \u00c6\u008a \u0095\u00c8\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4\u00a8\u00e8\u00be\u00e0, \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00f8\u00be\u00e0, \u00ba\u00f1\u00e5\u00aa\u00c6\u00a8\u00f8\u00be\u00e0, \u00ef\u00ba\u00cc\u00e0\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00be\u00f9\u00c6\u00e5\u00bc\u00be\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u00ef\u00c9\u00ba \u00cc\u00ba\u00eb\u00c9\u00be \u00c6\u008a\u00ae\u00e2\u00ae\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00cc\u00cd \u00bc\u00e6\u00d7\u00c4\u00b4 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00b4\u00be\u00f9\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00c2\u00c8\u00c6 \u00cc\u00cd \u00cd\u00e6\u00a8\u00f8\u00c6\u00e5\u00c9 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6. \u00ba\u00c9\u00bc, \u00a6\u00c9\u00e6\u00be\u00f8 \u00cc\u00e8\u00c6\u00f5\u00c4 \u00ef\u00bc\u00e0\u00c0\u00ce\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00d7\u00ba\u00f8\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00a4\u00a8\u00cc\u00e0\u00a8\u00f8\u00d7\u00ef\u008a, \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u008a, \u00c2\u00bc\u00e0\u00bc\u00b4 \u00bc\u00fb\u00ef\u008a, \u00cd\u00ea\u00c9\u00c4\u00e5\u00c7\u00e6 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00ec\u00da\u00b8 \u00c2\u00c8\u00c6 \u00cc\u00cd\u00fa\u00ba\u00c9 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00e6\u00d6\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6."
