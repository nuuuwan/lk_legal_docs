    "chunk_text": "6\u00b01998 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 52 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u00a5\u00de\u00b6\u00c8\u00bb\u00c7\u00af\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008123 \u00a4\u00ba\u00c6 \u0089\u00c7\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00cd\u00ba\u00df\u00ba\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u00b6\u00c8\u0081\u00bd\u00d7 :\u2013\n\n(1)\u00a3\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u00be\u00c6 \u2013\n\n(\u00a3)\u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u0081 (\u00a7\u00a7\u00a7) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u2013\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008123 \u00a4\u00ba\u00c6 \u0089\u00c7\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 41 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c65\n\n(ii) \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8 (ii\u00a3) \u00a9\u0081\u00b9\u00b6\u00ce\u00b8 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6\u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u00ce\u00bb \u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n(ii\u00a3)\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 1998 \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1\u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u0081\u00b8\u00c7\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6\u00cc\u00af\u00c7\u00ae\u00d5\u00b7\u00b4\u00c7\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b6\u00c6\u00b6\u00c8\u00be\u00c6, \u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00be\u00c6, \u00a7\u00bb\u00c7\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00be\u00c6\u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00d5\u00c1\u00d7\u00ba\u00c7\u00b8 \u00af\u00b5\u00b8\u00c8\u00c1\u0081\u00bc\u00af\u00b6\u00c6\u00ce\u00b6, \u00cc\u00b6\u00c7\u00ce\u00be\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u00da\u00a7\u00b9\u00af\u00bc\u00b5\u00b6\u00c6\u00ce\u00b6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00d7\u00ce\u00b5\u00dc\u00de\u00b9\u00c6\u00ce\u00b9\u00ba\u00c7\u00bd\u00c6\u00bd\u00c9\u00d5 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00a3\u00be\u00c6\u00be\u00d7\u00b6\u00bc\u00db\u00bb\u00c7\u00c6\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 1998 \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1\u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u0089\u0081\u00b8\u00c7\u00c6\u00a4\u00b8\u00c7\u00be\u00c6 2000 \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00b7\u00c6\u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u00b8\u00c6\u00b8\u00c7\u00c6 \u00a3\u00c1\u00bc\u00c7\u00be\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00b5\u00b8\u00c8 \u00c1\u0081\u00bc\u00af\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00cc\u00b6\u00c7\u00ce\u00be\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u00da \u00a7\u00b9\u00af\u00bc\u00b5\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00dd\u008c\u00af\u00c6\u00af\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7\u00a7\u00b9\u00af\u00bc\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00d7\u00ce\u00b5\u00dc\u00de\u00b9\u00c6\u00da \u00da\u00b6\u00c8\u00bb\u00d8{\u00bd\u00c6\u00bd\u00c7\u00ae\u0088\u00bd\u00c6\u00d0 \u00a5\u00ce\u00b1\u00b7\u00c6\u00b6\u00b6\u00c7\u00af \u00a5\u00dd\u00b9\u00c6\u0089\u0081\u00a3\u00b6\u00ce\u00b8\u00b9\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8\u00cc\u00b1\u00be\u008c\u0081 \u00d8{\u00de \u00b1\u00b6\u0096\u00b6\u00b9\u00c6\u00b9\u0088 ;\u201d\n\n61999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 41 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(\u00a3) \u00a3\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081 (\u00a7\u00a7\u00a7\u00a7\u00a7) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00ce\u00bb \u00b7\u00c9\u00af\u00c6\u00af\u00b3\u00c6\u00cc\u00b1\u00bb\u00c6\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00ce\u00bb\u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c(\u00a7\u00a7\u00a7\u00a7\u00a7) (ii) \u00a9\u00b7\u00c6\u00b6\u00af\u00c6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00e0\u00ba\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00db\u00ba\u00c6 \u00a4\u00bb\u00c6\u00b7\u00c6\u00b6\u00bd\u00c8\u00bb\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00b8\u00cd\u00c1\u00c7 \u00a3\u00b7\u00c6\u00b6\u00af\u00c6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u00be\u00c6 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6\u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b6\u00c6\u00b6\u00c8\u00be\u00c6, \u00cc\u00b6\u00c7\u00c0\u008b\u00be\u00c6, \u00a7\u00bb\u00c7\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00be\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00c1\u00d7\u00ba\u00c7\u00b8,(ii) \u00a4\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6 \u00b9\u00b4\u00c6\u00b4\u00af\u00b5\u00b8\u00c8 \u00cc\u00ba\u0081\u00bc\u00af\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00c7\u00b6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00af\u00b8\u00b8\u00c8 \u00cc\u00ba\u0081\u00bc\u00af\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u0089\u00be\u00c7\u00b8\u008c\u00d5\u00cc\u00b6\u00c7\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00de, \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u008c\u00d5\u00cc\u00b6\u00c7\u00ce\u00af \u2013\n\n(\u00a3) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00b5\u00b8\u00c8 \u00cc\u00ba\u0081\u00bc\u00af\u00ba\u00c6 1997 \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00b7\u00c6\u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u0081\u00b8\u00c7\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u008c\u00b4\u00b6\u00c6\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00b5\u00b8\u00c8 \u00cc\u00ba\u0081\u00bc\u00af\u00b6\u00c6\u00ce\u00b6\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u008b\u0081 \u00cc\u00b1\u00be\u008c\u0081\u00db\u00b9\u00c6\u00b9\u00b6\u00c6\u00d7 \u00f2\u0081\u00de\u00ba\u00c6 \u00f2\u0081\u00bd\u00c8\u00cc\u00be\u00c7\u00dd \u00b1\u00b6\u0096\u00b6\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b1\u00c6 \u00b1\u00ba\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00cc\u00b6\u00c7\u00ce\u00af\u00bb\u00c7\u00d0\u00ba\u00c6 ;\u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a4) \u00a3\u00b6\u00b6\u00ce\u00af\u00bb \u00af\u00b5\u00b8\u00c8 \u00cc\u00ba\u0081\u00bc\u00af\u00ba\u00c6 1997 \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00b7\u00c6\u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081\u0089\u0081\u00b8\u00c7\u00c6 \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u008c\u00b4\u00b6\u00c6\u00d7, \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00b5\u00b8\u00c8 \u00cc\u00ba\u0081 \u00bc\u00af\u00b6\u00c6\u00ce\u00b6\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u008b\u0081 \u00cc\u00b1\u00be\u008c\u0081 \u00ab\u00ba\u00c6\u00b9\u00d7\u00b1\u00b6\u0096\u00b6\u00b6\u00c6 \u00d7\u00af\u00c6\u00d0\u00b1\u00c6 \u00b1\u00ba\u00ba\u00c7\u00b8\u00cc\u00b6\u00ce\u00af\u00bb\u00c7\u00d0\u00ba\u00c6 ;\n\n1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 41 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c67"
