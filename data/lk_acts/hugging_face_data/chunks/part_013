    "chunk_text": "(i) \u00a6\u00e0 \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (i\u00a1) \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00cd\u00fa \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u201c[(ii) \u00c9\u00be\u00ef\u00cd\u00e5\u00e0 (ii\u00a1) \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00cd\u00e8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00e8\u00d6\u00c6\u00ba\u00a8\u00e0, \u00c6\u00be\u00e0\u00ba\u00f2\u00ef\u00cd\u00e5\u00e0 \u00cc\u0097\u00a8\u00f8\u00d7\u008a \u00ef\u00be\u00e5\u00c9\u00be]\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cd\u00e5 \u00a2\u00c8\u00a8\u00e0\u00a8\u008a\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c[(ii), (ii\u00a1) \u00ef\u00cd\u00e5\u00e0 (ii\u00a1\u00e5) \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c9\u00c8\u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00e8\u00d6\u00c6\u00ba\u00a8\u00e0, \u00c6\u00be\u00e0\u00ba\u00f2 \u00ef\u00cd\u00e5\u00e0 \u00cc\u0097\u00a8\u00f8\u00d7\u008a \u00ef\u00be\u00e5\u00c9\u00be]\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00cd\u00e5 \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(ii) \u00a6\u00e0 \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (ii\u00a1) \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2013\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e023 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n1999 \u00a1\u00e2\u00a8 41 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba5\n\n(\u00a1\u00e5) \u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a2\u00a2\u00a2\u00a2\u00a2) \u00ef\u00d8\u00bc\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2013\n\n\u201c(\u00a2\u00a2\u00a2\u00a2\u00a2)(i) ((ii) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00d6\u00aa\u00b8\u00a8\u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00ef\u00be\u00e5\u00c9\u00be,) \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00be\u00f8\u00ca\u00e0\u00ae\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00ba\u00eb\u00ce \u00bc\u00fb, \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec \u00bc, \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0\u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00cd\u00e5\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea\u00c8\u00c2\u00be \u00c6\u008a \u00ef\u00c9\u00ef\u00ce\u00bc\u00e5\u00c4\u00a8, \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8, \u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00c6\u00a8\u00ef\u00cd\u00e5\u00e0 \u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00a8 \u00bc\u00fb, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c3\u00e5\u0097\u00ba\u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00c6\u008a \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 _\n\n(\u00a1)\u00a6\u00e0 \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00a6\u00ef\u00cc\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 1997 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be\u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00e0\u00c0\u00d6\u00aa\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a\u00c0\u00e8\u00d6\u00c9\u00e6\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00ba\u00f8\u00cc\u00e0 \u00ba\u00eb\u00be\u00c6\u00fa \u00ba\u00eb\u00ef\u00be\u00be\u00e0\u00a6\u00a8\u00a8\u00e0 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc ; \u00cc\u00cd\n\n(\u00a1\u00e5) \u00a6\u00e0 \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00a6\u00ef\u00cc\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 1997 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be\u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00e0\u00c0\u00d6\u00aa\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a\u00c0\u00e8\u00d6\u00c9\u00e6\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00c0\u00be\u00cd\u00a8\u00e0 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc,\u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00a8\u00e0 ;\n\n(ii) 1998 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00ba\u00e0\u00ba\u00e5\u00c9\u00ec \u00bc, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00e0\u00be\u00e5 \u00c9\u00ec, \u00c6\u008a \u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u00c4\u00a8, \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8, \u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00c6\u00a8\u00ef\u00cd\u00e5\u00e0 \u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00a8 \u00bc\u00fb \u00c3\u00e5\u0097\u00ba \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00c6\u008a \u00c0\u00d6\u00aa\u00b8\u00a8\u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00c0\u00f2\u00ba\u00f8\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00be\u00aa\u00e5 \u00cc\u00e8\u00b4\u00ea\u00d1\u00c4\u00cc\u00bf\u00cd\u00e5 1998 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a6\u00ef\u00cd\u00ba\u00e02000 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0\u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00ba\u00e0 \u00c6\u008a \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00cc\u00cd\u00ca\u00f2 \u00c9\u00da\u00cb\u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u00c6\u00ea\u00a8\u00e0\u00ba \u00be\u008a, 1998 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be\u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00ba\u00e0 \u00a6\u00e0 \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a6\u00e0\u00c9\u00e5\u00ef\u00c6\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c0\u00e8\u00d6\u00c9\u00e6\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4\u00cc\u00e8\u00c6\u00c6\u00a8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00c9\u00be \u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00a8\u00e0 ;\n\n61999 \u00a1\u00e2\u00a8 41 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c4 \u00c9\u00ec \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c9\u00c8 \u00bc\u00fb \u00c0\u00d6\u00aa\u00b8\u00a8\u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00c8 \u00a6\u00a8\u00ba\u00eb\u00c9\u00a6\u00e0 \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c0\u00e8\u00d6\u00c9\u00e6\u00c6\u00b4 \u00cc\u00c4\u00e5\u00be \u00be\u008a,\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ef\u008a \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u00c0\u00ec\u00da\u00c9\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00f8\u00cc\u00e8\u00f3 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00a2\u00b6 \u00ef\u00be\u00e5\u00bc\u00fa\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\u201d."
