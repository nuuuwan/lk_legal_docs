    "chunk_text": "\u201c\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u00c7\u00b0\u00c6\u00ef\u00cd\u00e5\u00e0 \u00c0\u00ce\u00e5\u00ba\u00e0\u00c0\u00e5\u00c8\u00be\u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c9\u00be\u0097\u00b4.\n\n\u201c\u00c2\u00bc\u00e0\u00bc \u00ef\u00aa\u00c9\u00ec\u00c2\u00c9 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u00a7\u00c0\u00e0\u00c0\u00ea\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00a1\u00f5\u00ba\u00e0 8\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e09 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n41999 \u00a1\u00e2\u00a8 24 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(1)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba, \u00a6\u00ef\u00cc\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00bc\u00e0\u00bc\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba, \u00a6\u00ef\u00cc\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00c7\u00a1\u00e6\u00ba\u00f8 \u00c2\u00bc\u00e0\u00bc \u00cc\u00cd \u00a3\u00b4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00bc\u00b8\u00e0\u00b6\u00be\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;(2)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :-\n\n\u201c(4)(\u00a1) \u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00e6\u00d6 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c6\u008a \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00ef\u00c4\u00e5\u00e0\u00b4\u00da\u00c9\u00e5\u00cd\u00be\u00c6\u00a8 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8,\u00bc\u00e6\u00be\u00e0\u00d1\u00c4 \u00a7\u00cd\u00ea \u00ef\u00c9\u00ba \u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8\u00c9 \u00c4 \u00c3\u00e5\u00c7 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c9\u00e5\u00cd\u00be\u00c6 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00ef\u008a\u00cc\u00cd\u00ba\u00f8\u00a8\u00ef\u00c6\u00e0 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c8\u00e8\u00c0\u00e8\u00be\u00c6\u00b4 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00ba\u00e6\u00c0\u00e7\u00ef\u00c8\u00be\u00e0 \u00c6\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5) \u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00e6\u00d6 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c7\u00a8\u00e0\u00cb\u00a8\u00c6\u00a8\u00eb \u00c9\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00bc\u00e6\u00be\u00e0\u00d1\u00c4 \u00a7\u00cd\u00ea \u00ef\u00c9\u00ba \u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8\u00c9 \u00c4\u00c3\u00e5\u00c7 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00e5\u00da\u00c6\u00e5\u00c8\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00cc\u00e0\u00bb\u00e5\u00be\u00ef\u00c6\u00e0\u00c8\u00e8\u00c0\u00e8\u00be\u00c6\u00b4 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ba\u00e6\u00c0\u00e7\u00ef\u00c8\u00be\u00e0 \u00c6\u00c9\u00be\u00ea\u00c8\u00e6\u00c2\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0\n\n\u00a6\u00e0 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00e6\u00d6 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00c9\u00ba \u00c6\u00bb\u00e5 \u00c0\u00d6\u00bc\u00fa\u00c3\u00e5\u00c7 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5\u00a8\u00e0 \u00ef\u00cc\u00e0 \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00ba\u00e6\u00c0\u00e7\u00ef\u00c8\u00be\u00e0 \u00c6\u00c9\u00be \u00c8\u00bc \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be\u0097\u00b4, \u00a6\u00c6 \u00a7\u00cd\u00ea\u00b4 \u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u00ef\u00c6\u00be\u00e0 \u00c3\u00e5\u00c7 \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c9\u00ba\u00f8\u00c2\u00ea\u00b8 \u00bc\u00fa\u00be \u00bc\u00fb \u00a6\u00c6 \u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00e6\u00d6 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00c9\u00ba \u00c8\u00e6\u00c2\u00ea\u00b8\u00ea \u00ef\u00cc\u00e0\u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d\n\n11.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 10 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00e0\u00c9\u00e5\u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00e8\u00be\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 10\u00a1 \u00cc\u00cd 10\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6:-\n\n10\u00a1.\u00a1\u00bc\u00e5\u00ce \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7 \u00c2\u00bc\u00e0\u00bc \u00ef\u00aa\u00d1\u00c4\u00b4 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u00a1\u00cc\u00c4\u00ba\u00e0 \u00c9\u00ec\u00ef\u00c6\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a1\u00c6\u00e8\u00ba\u00f8\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0\u00c0\u00e5\u00c8\u00be\u00ef\u00c6\u00be\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00c9\u00ec \u00ef\u00cd\u00e0\u00ba\u00eb \u00be\u00f8\u00cc\u00e5 \u00c2\u00c9\u00b4 \u00bc \u00cc\u00e8\u00c6\u00f5 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba\u00a8\u00c7\u00e6\u00b8\u00ea \u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e010 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u201c\u00bc\u00b8\u00e0\u00b6\u00be \u00c4\u00ea\u00bc\u00c8\u00a1\u00ba\u00e0\u00cd\u00e6\u00d7\u00c4\u00b4\u00ef\u00cd\u00e5\u00e0 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00c4\u00b4\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5\u00cc\u00ba\u00eb \u00c2\u00c8\u00c6\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e010\u00a1 \u00cc\u00cd 10\u00a1\u00e5\u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n51999 \u00a1\u00e2\u00a8 24 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n\u00aa\u00ba\u00e0 \u00a8\u00ce, 10 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00bc\u00b8\u00e0\u00b6\u00be \u00c4\u00ea\u00bc\u00c8 \u00a1\u00ba\u00e0\u00cd\u00e6\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00c4 \u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00cc\u00cd \u00c6\u00ea\u00a8\u00e0\u00ba\u00f8 \u00cc\u00cd\u00aa\u00ba \u00c2\u00c9\u00b4 \u00bc\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5 \u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a,\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4 \u00bc\u00b8\u00e0\u00b6\u00be \u00c4\u00ea\u00bc\u00c8\u00a1\u00ba\u00e0\u00cd\u00e6\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00c4 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6."
