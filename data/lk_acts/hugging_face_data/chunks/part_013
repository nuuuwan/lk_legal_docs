    "chunk_text": "\u00af\u00ba\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u00ce\u00bb\u00b7\u00c8\u00bb\u00ba\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\nH - 022545\n\n\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00df\u00c1\u00be\u00bc\u00c6\u00af\u00bf\u00c6\u00b0\n\n21999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 35 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00b6\u00c7\u00c1\u00bc\u00b9\u00c6\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00cd\u00b1\u00c7\u00b6\u00ce\u00b8\u008a\u00d5\u00ba\u00c6\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af\u00c1\u00bf\u00e2\u00af\u00bf\u00c8\u00d9\u00b4\u00c6\u0089\u00bc\u00cd\u00c1\u00b1\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n\u00b9\u00c7\u00af\u00ba\u00c6 II\n\n\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00db\u00ce\u00bd\n\n(2) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b1\u00c7\u00b6\u00ce\u00b8\u00af\u00c6\u00d0\u00ba\u00c6\u00b9\u00bc\u00c8\u00cd\u00b1\u00c7\u00b6\u00ce\u00b8\u00af\u00c6\u00d0\u00ba\u00c6 \u0089\u0081\u00b8\u00bc\u00c6, \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00c1\u00bf\u00e2\u00af\u00bf\u00c8\u00be\u00c6 \u00ac\u00dd \u0093\u00ce\u00b4\u00a3\u00be\u00c6\u00be\u00d7 \u0093\u00ce\u00b4\u00af\u00bf\u00c6 \u00a7\u00bf\u00c6\u00bf\u00b8\u00cc\u00c1\u0081\u00de \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00df\u00c1\u00be\u00bc\u00c6 \u00b6\u00c8\u00dd\u00b9\u00c6\u00b6\u00c8\u00b9\u00c6\u00b9\u0088\u0081, \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u0093\u00ce\u00b4\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u0093\u00ce\u00b4\u00af\u00bf\u00c8\u0081 \u00b6\u0081\u00ce\u00ba\u00ce\u00bb\u00dc\u00ba\u00c6 \u00a3\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00ce\u00c1\u00b9\u00bc\u00c1\u00af\u00c6\u00e7\u0088\u00bb \u00b1\u00c7\u00b6\u00c6\u00b6\u00c8\u00bb\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6 \u00af\u00c1\u00b8\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00cc\u00af\u00c7\u00ae\u00d5, \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00df\u00c1\u00be\u00bc\u00c6,\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cd\u00af\u00bd\u00c6\u00b9 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u0093\u00ce\u00b4\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u0093\u00ce\u00b4\u00af\u00bf\u00c8\u0081\u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8\u00bb\u00c7\u00bf\u00dd\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00bf\u00e2\u00af\u00bf\u00c8\u0081\u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00af\u00c6\u00af\u00c7\u00bc\u00dd\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00dd\u00b9\u00c6\u00b9\u00c7\u00b4\u00c6\u00b1\u00c8\u00bb\u00c7\u00bf\u00dd\u00af\u00c6\u00d0 \u00ac\u00dd \u00b9\u00b5\u00c8\u00b9\u00c6\u0089\u00be\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6 \u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00af \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u0093\u00ce\u00b4 \u00a3\u00be\u00c6\u00be\u00d7 \u0093\u00ce\u00b4\u00af\u00bf\u00c6\u00b9\u00bc\u00e2\u00c1\u00ce\u00b6\u00b6\u00c6 \u00b6\u00d5\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00c0\u00c8\u00db\u00ce\u00bd\u00af\u00ce\u00bf\u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00de\u00ba\u00c6\u00b9\u0088 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00c1\u00ce\u00be\u00ce\u00bb\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00d7\u00db\u0088\u00af\u00c6\u00d0\u00ba\u00c6\u00b9\u0088 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8\u00bb\u00c7\u00bf\u00ce\u00bc \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00bf\u00e2\u00af\u00bf\u00c8\u0081 \u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00af\u00c6\u00af\u00c7\u00bc\u00ce\u00bc \u00a3\u00be\u00c6\u00be\u00d7\u00a5\u00dd\u00b9\u00c6\u00b9\u00c7\u00b4\u00c6\u00b1\u00c8\u00bb\u00c7\u00bf\u00ce\u00bc\u00b9\u00c6 \u00b9\u00b5\u00c8\u00b6\u00c6\u00d7, \u00b6\u00b8\u00d7 \u00db\u0088\u00ce\u00b9 \u00a3\u00b6\u00bd\u00c6\u00af\u00c7\u00b8\u00af\u00c7\u00bc\u00b5+\u00c6\u00af\u00e0\u00b4\u0081 \u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00cc\u00b6\u00bc\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n31999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 35 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00b6\u00c7\u00c1\u00bc\u00b9\u00c6\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(3) \u0093\u00ce\u00b4\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u0093\u00ce\u00b4\u00af\u00bf\u00c8\u00b8\u00c6 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8\u00bb\u00c7\u00bf\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00c1\u00bf\u00e2\u00af\u00bf\u00c8\u0081 \u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00af\u00c6\u00af\u00c7\u00bc\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00dd\u00b9\u00c6\u00b9\u00c7\u00b4\u00c6\u00b1\u00c8\u00bb\u00c7\u00bf\u00bc\u00c6 (2) \u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b9\