    "chunk_text": "(5) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00c0\u00b4\u00cd\u00e6\u00be\u00f8\u00c9 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a8\u00c9\u00c7\u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00ba\u00e8\u00c2\u00ea\u00b8 \u00bc, \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00cc\u00e7\u00c4\u00c2\u00c8\u00c6\u00c8\u00ba\u00e0 \u00cc\u00e8\u00c8\u00e0\u00c8\u00c7 \u00ef\u00c9\u00ef\u00ce\u00be\u00e0\u00bc\u00a8\u00eb\u00b4\u00c4, \u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8\u00c4\u00e5\u00cc\u00e8\u00a8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5 \u00ef\u00c9\u00be\u00e0 \u00a8\u00c7 \u00bc\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00c2\u00c8\u00c6\u00c8\u00ba\u00e0\u00cc\u00e8\u00c8\u00e0\u00c8\u00c7 \u00ef\u00c9\u00ef\u00ce\u00be\u00e0\u00bc\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00a1\u00be\u00ea\u00c9 \u00c4\u00e5\u00cc\u00e8\u00a8 \u00c9\u00e5\u00da\u00ba\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fa\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(6) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5-\n\n\u201c\u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0\u00c0\u00ce\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6\u00ef\u00a8\u00e5\u00b4 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00c3\u00e5\u00b8\u00e0\u00b6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n15.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 71 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6, \u00a6\u00cd\u00fa (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n\u201c(2)\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4\u2014\n\n(i)2002 \u00a1\u00ef\u00aa\u00e5\u00e0\u00cc\u00e0\u00ba\u00eb \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be\u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00ef\u008c \u00c0\u00b4\u00be\u00e0 \u00cc\u00e7\u00c4 \u00c4\u00e5\u00cc\u00c6\u00a8\u00c4 \u00a1\u00c6\u00a8\u00c7 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00aa\u00be\u00e0\u00be\u00e5 \u00c2\u00f3 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u0097\u00cc\u00e8\u00c0\u00cd\u00a8\u00e0, \u00a6\u00e0 \u00c4\u00e5\u00cc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00a6\u00ce\u00ef\u00c5\u00be \u00c4\u00e5\u00cc\u00ef\u00c6\u00e0 \u00c0\u00cd\u00ef\u00ce\u00e5\u00cc\u00e0\u00c9\u00be \u00bc\u00fa\u00be \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00ef\u00c0\u00c7\u00cc\u00cd \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c4\u00e5\u00cc\u00ef\u00c6\u00e0 \u00c0\u00cd\u00ef\u00ce\u00e5\u00cc\u00e0\u00c9\u00be \u00bc\u00fa\u00be \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0\u00a3\u00b4 \u00ef\u00c0\u00c7 \u00c2\u00e6\u00c7 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e071 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba14\n\n(ii)2006 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00cc\u00bf\u00cd\u00e5, 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00c3\u00e5\u00b8\u00e0\u00b6 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00c4\u00ba \u00ef\u00da\u00aa\u00eb \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00c6\u00a8\u00c7 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00c2\u00f3 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4\u00bc\u00cd\u00c6\u00a8\u00e0, \u00a6\u00c4 \u00c4\u00e5\u00cc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00a6\u00ce\u00ef\u00c5\u00be \u00c4\u00e5\u00cc\u00ef\u00c6\u00e0\u00c0\u00cd\u00ef\u00ce\u00e5\u00cc\u00e0\u00c9\u00be \u00bc\u00fa\u00be \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00ef\u00c0\u00c7 \u00cc\u00cd \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0\u00c4\u00e5\u00cc\u00ef\u00c6\u00e0 \u00c0\u00cd\u00ef\u00ce\u00e5\u00cc\u00e0\u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00ef\u00c0\u00c7 \u00c2\u00e6\u00c7 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n16.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 73 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6, \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2013\n\n(1)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2013\n\n\u201c(1) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00ef\u00c4\u00cd\u00fa \u00c8\u00e5 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00cc\u00cd\u00e5\u00c6 \u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0\u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00e0 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00cc\u00e8\u0090\u00be \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e6\u00c2 \u00cc\u00e8\u0090 \u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00c4\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00a8\u00e5\u00da\u00c6\u00c6 \u00a2\u00b4\u00ea\u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00ba\u00c4\u00be\u00e0\u00b4 \u00bc\u00e6\u00be \u00aa\u00e6\u00be\u00f9\u00c4\u00b4\u00c8\u00e6\u00ef\u00c2\u00be \u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00c7\u00b8\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c7\u00cd\u00cc\u00f1\u00ba\u00e5\u00c9 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4\u00cc\u00cd \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00ef\u00c4\u00cd\u00fa \u00c8\u00e5 \u00cc\u00cd\u00e5\u00c6\u00d1\u00c4 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6. \u00ba\u00c9 \u00bc, \u00a6\u00e0 \u00a8\u00e5\u00c7\u00b8\u00c6\u00a1\u00bc\u00e5\u00ce \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00bc \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00c2\u00c8\u00c6\u00c8\u00ba\u00e0 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00cb\u00c6\u00c6\u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5\u00b4 \u00cd\u00e6\u00c7 \u00ef\u00c9\u00be\u00ba\u00e0\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00eb\u00b4\u00a6\u00c9\u00e6\u00be\u00f8 \u00c6\u008a \u00a8\u00c7\u00e6\u00b8\u00a8\u00e0 \u00ef\u00be\u00e5\u00bc\u00e6\u00be\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00cc\u00be\u00e0\u00ba\u00a8\u00ef\u00c6\u00cd\u00fa, \u00c3\u00e5\u00c7\u00ef\u00c6\u00cd\u00fa \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e5\u00c8\u00be\u00ef\u00c6\u00cd\u00fa \u00a1\u00e6\u00ba\u00f8\u00ef\u00c8\u00e0\u00a9\u00be \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a1\u00c9\u00cc\u00c7 \u00bc\u00fb\u00c4 \u00ef\u00cd\u00e5\u00e0\u00a2\u00b6 \u00cd\u00e6\u00d7\u00c4 \u00ef\u00be\u00e5\u00a8\u00c8 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d;"
