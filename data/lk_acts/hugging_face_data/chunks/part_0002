    "chunk_text": "(2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00cd\u00ba \u00ba\u00c7\u00b6\u00ba\u00c6 13 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7)\n\n\u00a3\u00bc\u00b1\u00c8\u00b8\u00bc\u00c6 \u00a4\u00ce\u00b5\u00b9\u00c6\u00b9\u0088 \u00a3\u00b1\u00c6\u00b1\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\n\n\u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00a3\u00b1\u00c6\u00d2\u00b6\u00c6 \u00b6\u00c8\u00ce\u00b5\u00af\u00c6\u00af\u00bf\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00b9\u00b6\u00c8\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00bd\u00c6\u00bd\u00d7\u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da 1\" \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00b4\u00df\u00c1\u00be\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00be\u00c7\u00ba\u00c6\n\n\u008c\u00ce\u00be : \u00f4\u00b9\u00c7 21\u00b025\u00b6\u00b9\u00c7\u00bd\u00c6 \u00cc\u00b1\u00be\u00e2 : \u00f4\u00b9\u00c7 7\u00b050\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081\u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00ba\u00c6\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u00b8\u00c6 13 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b9\u00c6\u00cd\u00b9\u00bc\u00c0\u00c8\u00e2\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c7\u00b4\u00c6\u00b1\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n2005\" \u00cd\u00ba \u00ba\u00c7\u00b6\u00ba\u00c6 13 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb \u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6\u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00b9\u00c6 \u00b9\u00b6\u00c6\u00b6\u00c8\u00bc\u00c8\u00ce\u00af\u008a\u0081 II \u00a4\u00ba\u00c6 \u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00b7\u00c8\u00bc\u00b9\u00c6\u0089\u00bb\u00c7\u00af\u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b9\u00c6\u00cd\u00b9\u00bc\u00c0\u00c8\u00e2\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c7\u00b4\u00c6\u00b1\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c61\n\n\u00d2\u00dd\u00af\u00c6\u00af\u00b9\u00c6 \u00cc\u00b9\u00bb\u00bc\u00c6\u00b0\n\n2 \u2013PL. 000092\u2013 1,250 (2005/02)\n\n\u00db\u0081\u00d9\u00ce\u00bc\u00b0\n\n[2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00cd\u00ba \u00ba\u00c7\u00b6\u00ba\u00c6 13 \u00a4\u00b7\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00b0]\n\n\u00b1\u00b0 \u00c1\u00b0 \u2013 \u00ad 56/904341\n\n\u00cd\u00b6\u00b1\u00c8\u00bb \u00cd\u00b9\u00bc\u00c0\u00c8\u00e2\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6 \u00cd\u00b9\u00bc\u00ce\u00c1\u00ce\u00bb\u00dc\u00ba\u00c6 \u00cd\u00b9\u00bc\u00c0\u00c8\u00e2\u00b1\u00c6\u00cc\u00b1\u00bb\u00be\u00c7\u00b4\u00c6\u00b1\u00c8 \u00b7\u00c8\u00ce\u00be\u00bb\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6 \u00b6\u00c7\u0089\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6; \u00cc\u00b6\u00c7\u00c0\u00c8\u00d9\u00b4\u00c6\u00b9\u00ba\u00b6\u00c8\u00dc\u00ce\u00bc\u00af\u00c6 \u00d0\u00e1\u00af\u00c6\u00af\u00ce\u00bf \u00b7\u00c8\u00bb\u00ba\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6; \u00cd\u00b9\u00bc\u00c0\u00c8\u00e2\u00b1\u00c6\u00cc\u00b1\u00bb\u00be\u00c7\u00b4\u00c6\u00b1\u00c8\u00b6\u00c6 \u00b6\u00c8\u00b4\u00c6\u00b4+\u00c6\u00af\u00ce\u00bf\u00b6\u00c6 \u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 ; \u00cd\u00b9\u00bc\u00c0\u00c8\u00e2\u00b7\u00c8\u00ce\u00be\u00ce\u00ba\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00cc\u00c1\u00bf\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 ; \u00b7\u00b4\u00c6\u00b4\u00a6\u00d5\u00a3\u00bf\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00c1\u00bd\u00c6\u00cd\u00bd\u00c7\u00d5 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b9\u00b4\u00c6\u00b4\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u0081 \u00a5\u00ce\u00b4\u00cd\u00b7\u00bc\u00c6\u008c\u00ce\u00bf\u00c1\u00c7\u00b8 \u00af\u00dd\u00ba+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c7\u00b8\u00cc\u00b6\u00c7\u00dd \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00a5\u00be+\u00c6\u00ce\u00af \u00a4\u00bf\u00c6\u00da\u00be\u00b6\u00c6\u00b6\u00c8\u00d9\u00bf\u00c6 \u00a5\u00b4\u00ba\u00c6\u00cc\u00b9\u00de\u00ba\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00b6\u00b1\u00c8\u00be \u00cd\u00b9\u00bc\u00c0\u00c8\u00e2\u00af\u00bf\u00c8\u0081 \u00af\u00c7\u00bc\u00b5\u00ba\u00c7\u00af \u00ba\u00b8\u00c8\u00b6 \u00a7\u008a\u00dd\u00ba\u00c6\" \u00a4\u00b6\u00b8\u00db\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00a5\u00be+\u00c6\u00ce\u00af\u008a\u0081 \u00e9\u00c0\u00df\u00ba\u00c6 \u00a3\u00b1\u00c6\u00d2\u00de\u00b6\u00c6\u00b6\u00df\u00af\u00c6\u00d0\u00ba\u00c6 \u00a4\u00b9\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6\u00a7\u00b4\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00b8\u00c1\u00c7\u00b6\u00be\u00c7\u00df\u00ba\u00c6 :\n\n\u00a3\u00b6\u00c6\u00d7\u00b4\u0081\" \u00a5\u00b7\u00c6\u00b6\u00b9\u00c6 \u00cd\u00b9\u00bc\u00c0\u00c8\u00e2\u00af\u00bf\u00c8\u0081 \u008c\u00ce\u00bf\u00e2\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00ba\u00b8\u00c8\u00b6\u00a7\u008a\u00ce\u00bc\u00dc\u00ba\u00c6\" \u00ba\u00af\u00c6\u00af\u00bf\u00c8\u0081 \u00a4\u00b6\u00b8\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u0081\u00e9\u00c0\u00ce\u00be\u00dc\u00ba\u00c6\" \u00cd\u00b6\u00b1\u00c8\u00bb\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00dc\u00ba\u00c6 \u00b6\u00c8\u00b4\u00c6\u00b4\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00dc\u00ba\u00c6\u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u00b9\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00af\u00c7\u00bf\u00c6\u00ce\u00af\u00af\u00c6\u00d0\u00ba\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6 \u00b9\u00bb\u0081\u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00ce\u00ba\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00ac\u00dd+\u00c6\u00af\u00c8\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00d0\u00e1\u00af\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00b9\u00c6\u00b9\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 \u00cd\u00b6\u00b1\u00c8\u00bb\u00af\u00c6 \u00af\u00ae\u00cd\u00b5\u00c7\u00b4\u00c6\u00b4\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u00be\u00c6 \u00a3\u00c1\u00bd\u00c6\u00ce\u00bd\u00b9\u00c6\u00b9\u00bb\u00d9\u00bf\u00c6\u00bf\u00c1\u00ce\u00af\u008a\u00be\u00c6 \u00ce\u00af\u00bb\u00c7\u00bf\u00c6\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00b9\u00d7\u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00af\u00c8\u00dc\u00bf\u00c6\u00bf\u00b6\u00c7\u00b6\u00be\u00c7\u00df\u00ba\u00c6 :\n\n\u00a4\u00af\u00cd\u00c1\" \u00a5\u00b9\u00c6\u00cc\u00b9\u00c7\u00e1\u00d7 \u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6\u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081 \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b1\u00b4\u00c6\u00b4\u00ba\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00c7\u00d0\u00af :\u2013\n\n1\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b9\u00c6\u00cd\u00b9\u00bc\u00c0\u00c8\u00e2\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c7\u00b4\u00c6\u00b1\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a9\u00b8 \u00a9\u00d5\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00a9\u0081\u00b9\u00d7\u00b4\u0081\" \u00af\u00cc\u00b1\u00bd\u00c6\u00bd\u00c8\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00f2\u00be\u00ba\u00c6 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c7\u00be\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de(\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u201c\u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00af\u00c6\u00d0 \u00c1\u00dd\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b9\u00c6\u00cd\u00b9\u00bc\u00c0\u00c8\u00e2\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c7\u00b4\u00c6\u00b1\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c62"
