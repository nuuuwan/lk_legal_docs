    "chunk_text": "2\u00b0 \u00af\u00ba\u00c6\u00b9\u00c4\u00c7 \u00b7\u00c8\u00bc\u00c6\u00c1\u00c7\u00af \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b7\u00c9\u00bc\u00c6\u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da\" \u00c1\u00b6\u00c6\u00b6\u00ce\u00bf\u00b0\n\n3\u00b0 \u00af\u00e0\u00b6\u00c6\u00d7\u00ce\u00bd \u00b7\u00c8\u00bc\u00c6\u00c1\u00c7\u00af \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b9\u00c7\u00b5\u00b7\u00c6\u00d7\u00ce\u00bd\" \u00af\u00e0\u00b6\u00c6\u00d7\u00ce\u00bd\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cd\u00b9\u00dd\u00c1\u00ce\u00bf\u00b0\n\n4\u00b0 \u00af\u00c7\u008b \u00b7\u00c8\u00bc\u00c6\u00c1\u00c7\u00af \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00cc\u00b9\u00b7\u00c6\u00cd\u00b6\u00c7\u00b4\u00c6\u00ce\u00b4\" \u00b9\u00be\u00b9\u00c6\u0089\u00b4\u00c6\u0088\"\u00a3\u00ba\u00c6\u00b9\u00be\u00c7+\u00c6\u00cc\u00af\u00c7\u00ce\u00b4\" \u00c4\u00c8\u00af\u00c6\u00af\u00d5\u00ce\u00c1\" \u00af\u00c7\u008b \u00b7\u00c7\u0081\u00d0 \u00d2\u00bd\u00c6\u00de\u00b9\u00c6 \u0089\u00bc\u00c8\u00e2\u00af\u00bf\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00c4\u00b9\u00bc\u00c7\u00d7\u00c1\u00b0\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba\u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6\u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf\u00a7\u00ce\u00bc \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d2\u00b8\u00c7\u00ba\u00c8(\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c621\n\n6\u00b0 \u00c4\u00ba\u00c6\u00b9\u00b7\u00c6\u00cd\u00b6\u00c7\u00b4\u00c6\u00ce\u00b4 \u00b7\u00c8\u00bc\u00c6\u00c1\u00c7\u00af \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b6\u00c8\u0083\u00c3\u00ba\u00c4\u00c7\u00bc\u00c7\u00ba\"\u00c4\u00ba\u00c6\u00b9\u00b7\u00c6\u00cd\u00b6\u00c7\u00b4\u00c6\u00ce\u00b4\" \u00a3\u00ba\u00c6\u00b9\u00be\u00c7\u00b7\u00c6\u00cd\u00b6\u00c7\u00b4\u00c6\u00ce\u00b4 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b6+\u00c6\u00af\u00c7\u00ce\u00be\u00b0\n\n7\u00b0 \u00bb\u00c7\u00c0\u00c6\u00b9\u00c6\u00b9\u00c7\u00b5\u00ba\u00c6 \u00b7\u00c8\u00bc\u00c6\u00c1\u00c7\u00af \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b6\u00c9\u00e2\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8 \u00c1\u00b4\u00af\u00c6\u00d0(\u00a8\u00bc\u00c6\u00af\u00c7\u00c1\u00bd\u00c6\u00de\u00ce\u00bd)\" \u00af\u00bc\u00cc\u00c1\u00b4\u00c6\u0088\" \u00b9\u00dd\u00b6\u00c6\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bd\" \u00b1\u00c7\u00c1\u00af\u00b1\u00c6\u00cd\u00b1\u00bc\u00c8\"\u00af\u00c7\u00ce\u00bc\u00b7\u00af\u00bc\u00c6\" \u00ba\u00dd\u00b6+\u00c6\u00cd\u00af\u00b5\u00c8\" \u00cc\u00b6\u00be\u00c6\u008b\u00b9\u00c6\u00b9\u00ce\u00bf \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cc\u00b7\u00d5\u00b7\u00c6\u00b6\u00c9\u00e2\u00b0\n\n8\u00b0 \u00db\u00be\u00c6\u00ce\u00be\u00b6\u00c6\u00b6\u00c9\u00e2 \u00b7\u00c8\u00bc\u00c6\u00c1\u00c7\u00af \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00da\u00d7\u00af\u00c6\u00d0\u0088\u008a\u00dd\u00b9\u00c6\u00da \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00ba\u00dd\u00b6\u00ba\u00c6\u00b9\u00bd\u00c6\u00de\u00b0\n\n9\u00b0 \u00af\u00c8\u00bf\u00c8\u00cc\u00b7\u00c7\u00b1\u00c6\u00b1\u00c8 \u00b7\u00c8\u00bc\u00c6\u00c1\u00c7\u00af \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00af\u00b4\u00c6\u00ce\u00b4\u00cd\u00c1\u008b \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b9[\u00b7\u00af\u00bc\u00c8\u00b0\n\n10\u00b0 \u00ba\u00b4\u00c6\u00b4\u00af\u00c6\u00af\u00bf\u00b9\u00c6\u00da \u00b7\u00c8\u00bc\u00c6\u00c1\u00c7\u00af \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00cd\u00af\u00c7\u00bd\u00ce\u00bf\u00b9\u00c6\u00b9\u00bd\u00c6\u00de \u00ba\u00b6\u00c6\u00b6\u00c8\"\u00cc\u00b1+\u00c6\u00af\u00be\u0088\" \u00c1\u00c7\u00ce\u00c0\u00b1\u00c6\u00cd\u00b1\u00ce\u00b8\" \u00af\u00e0\u00c1\u00c7\u00b3\u00c6\u00b1\u00c8\u00af\u00c6\u00d0\u0088\" \u00aa\u00bd\u00c7\u00c1[\u00bc\u00c6 \u00b7\u00af\u00bc\u00c6\"\u00ba\u00ae\u00db\u00ce\u00b8 \u00c1\u00b4\u00af\u00c6\u00d0\" \u00c1\u00c7\u00af\u00ce\u00bc\" \u00af\u00c7\u00b6\u00c6\u00b6\u00c7\u0081\u00d0\u0088\" \u00a4\u00ce\u00bc\u00bb\u00ba\u00c6\u00b9\u00b6\u00c8\" \u00af\u00c8\u00bc\u00c7\u0081\"\u00cc\u00c1\u00bf\u00c6\u00bf\u00c7\u00cc\u00c1\u00bf\u00c8\" \u00b9\u00b4\u00c6\u0088\u00b9\u00c6\u00b9\u00ce\u00bf\" \u00c1\u00e2\u00b5\u00b6\u00c9\u00e2 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00ad\u00b4\u00c6\u00b4\u00ba\u00c7\u00c1\u0088\u00b0\n\n11\u00b0 \u00a3\u00ba\u00c6\u00b9\u00c7\u00ce\u00bd \u00b7\u00c8\u00bc\u00c6\u00c1\u00c7\u00af \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00af\u00be\u00c6\u00db\u00ce\u00b8\" \u00b1\u00c7\u00bb\u00c6\u00b7\u00c6\u00b6\u00ba\u00dd\u00d7\"\u00cd\u00af\u00ce\u00bc\u00b6\u00c6\u00b6\u00c9\u00e2\" \u00b7\u00c8\u00b7\u00c6\u00b6\u00c1[\u00bc\u00c6\" \u00a3\u00b4\u00c6\u00b4\u00c7\u00ce\u00bf\u00b1\u00c6\u00cd\u00b1\u00ce\u00b8\" \u00a3\u00af\u00c6\u00af\u00ce\u00bc\u00b9\u00c6\u00b9\u00bd\u00c6\u00de\"\u00a4\u00ce\u00be\u00bb\u0088\u00cd\u00c1\u00ba\u00c6\u00da\" \u00b6\u00c8\u00dd\u00af\u00c6\u00cd\u00af\u00c7\u008c\u00be\u00c6\" \u00cc\u00b9\u00c7\u00b6\u00c6\u00d7\u008c\u00be\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00be\u00c4\u00cb\u00af\u00be\u00b0\n\n12\u00b0 \u00b6\u00c8\u00dd\u00cd\u00af\u00c7\u00b5\u00ba\u00ce\u00be \u00b7\u00c8\u00bc\u00c6\u00c1\u00c7\u00af \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00d0\u00b1\u00c6\u00b1\u00cc\u00c1\u00bf\u00c8\" \u00b6\u00c8\u00dd\u00cd\u00af\u00c7\u00b5\u00ba\u00ce\u00be \u00b7\u00af\u00bc\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00d2\u00bd\u00c6\u00de\u00b9\u00c6 \u0089\u00bc\u00c8\u00e2\u00af\u00bf\u00c6\" \u00b6\u00ba\u00c6\u00b9\u00be\u00af\u00c7\u00ba\u00ba\u00c6\" \u00af\u00c8\u00ae\u00b5\u00c8\u00bb\u00c7\"\u00f2\u00d7{\u00bc\u00c6\" \u00cd\u00b1\u00dd\u008c\u00be \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00cc\u00c1\u00dd\u00af\u00be\u00c6 \u00a6\u00b1\u00c6\u00b1\u00c8\u00be\u00ba\u00c6\u00b9\u00b6\u00c6\u00ce\u00b6\u00b0\n\n13\u00b0 \u00da\u00b6\u00c6\u00b6\u00bf\u00ba\u00c6 \u00b7\u00c8\u00bc\u00c6\u00c1\u00c7\u00af \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00cc\u00c1\u0081\u00b8\u00b9\u00c6\u00da\u00c1\u00b0\n\n\u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5[(\u0089\u00bc\u00c8\u00e2 3) (2)]\n\n.........................................................\u00af\u00c8\u00bc\u00c7\u00ba \u00a3\u00df\u00c1\u00be\u00dd\u00af\u00c6\u00d0\"\n\n\u00af\u00c7\u00b5\u00c7\u00ba\u00bd\u00c6\u00cd\u00b9\u00c7\u00b8 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c8\u0081 \u00a5\u00bd\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00c7\u0081\u00bd\u00c8\u00b6\u00cc\u00c0\u00c7\u0081\u00bd\u00c8\u0081\u00c1\u00c0+\u00c6\u00d0\u00ce\u00af\u00af\u00c6\u00af\u00c7\u00b8 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00ba\u00c6\n\n1\u00b0 \u00af\u00c7\u00b5\u00c7\u00ba\u00bd\u00c6\u00cd\u00b9\u00c7\u00b8 \u00a4\u00bf\u00c8\u0081 \u00db\u00e1\u00b9\u00c6\u00cc\u00b9\u00bb\u00bc\u00c6 :\n\n2\u00b0 \u00b9\u00c7\u00be\u00c6 :\n\n3\u00b0 \u00a5\u00b8\u00ba\u00c6 :\n\n4\u00b0 \u00c1\u00bb\u00d7 :\n\n5\u00b0 \u00a5\u00bd\u00b7\u00c6\u00b6 \u00b6\u00c8\u00af\u00b6\u00c8 :\n\n222005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d2\u00b8\u00c7\u00ba\u00c8(\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n6\u00b0 \u00cc\u00b6\u00bc\u00c8\u00b7\u00c6\u00b6 \u00af\u00ce\u00b4\u00b1\u00c8 \u00db\u00af\u00c1\u00bc\u00c8 :\n\n7\u00b0 \u00b7\u00c8\u00bc\u00b7\u00c6\u00b6\u00bc \u00c1\u00b6\u00c8\u008c\u00b4 \u00db\u00af\u00c1\u00bc\u00c8 :\n\n8\u00b0 \u00b9\u00b6\u008c \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 :\n\n9\u00b0 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00af\u00c7\u00bc\u00bc\u00c8\u0081 \u00db\u00e1\u00b9\u00c6\u00cc\u00b9\u00bb\u00bc\u00c6 :\n\n10\u00b0 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00af\u00c7\u00bc\u00bc\u00c8\u0081 \u00c1\u00b6\u00c8\u008c\u00b4\u00db\u00ba\u00c6 \u00cc\u00b6\u00c7\u00ce\u00be\u00cd\u00b9\u00b1\u00c8 \u00a5\u00be\u00af\u00c6\u00af\u00db\u00ba\u00c6 :\n\n11\u00b0 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00af\u00c7\u00bc\u00bc\u00c8\u0081 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6/\u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 :\n\n12\u00b0 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00af\u00c7\u00bc\u00bc\u00c8\u0081 \u00cc\u00b6\u00c7\u00c0\u00c9\u008b\u00b4\u00db\u00ba\u00c6 \u00cc\u00b6\u00c7\u00ce\u00be\u00cd\u00b9\u00b1\u00c8 \u00a5\u00be\u00af\u00c6\u00af\u00db\u00ba\u00c6 :\n\n13\u00c6 \u00af\u00c7\u00b5\u00c7\u00ba\u00bd\u00c6\u00cd\u00b9\u00c7\u00b8 \u00a4\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00af\u00c7\u00bc\u00dd\u00af\u00c6\u00d0\u00db\u00bf\u00c6\u00bf \u00a7\u00bd\u00e2 :"
