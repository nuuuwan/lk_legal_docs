    "chunk_text": "(\u00a6)\u00be\u00f8\u00c6\u0095\u00ba \u00cc\u00e9\u00c4\u00e5\u00c9\u00b4 \u00cc\u00c4\u00e5\u00be\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c6 \u00a2\u00a8\u00e0\u00c4\u00c9\u00e5,\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb, \u00cc\u00c4\u00aa \u00c4\u00ea\u00bc\u00c8\u00e0 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u00c8 \u00be\u00f8\u00c7\u00ba\u00c9\u00be\u0097\u00b4, 1993 \u00a1\u00e2\u00a8 50 \u00bc\u00c7\u00be \u00c4\u00e6\u00b8\u00e8\u00a8\u00e0 \u00cd\u00e5 \u00cc\u00e0\u00c9\u00da\u00b8\u00e5\u00c3\u00c7\u00b8\u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a1\u00e5\u00c9\u00c7\u00b8\u00c6 \u00c9\u00be \u00ef\u00c8\u00e5\u00e0\u00cd \u00cd\u00e5 \u00aa\u00c8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9, \u00a6\u00ef\u00cd\u00ba\u00e0\u00a6\u00e0\u00c9\u00e5\u00b4 \u00cc\u00e9\u00c4\u00e5 \u00ef\u00be\u00e5\u00c9\u00ec,\u00c9\u0090\u00be\u00e5 \u00ef\u00c8\u00e5\u00e0\u00cd \u00ef\u00c9\u00ef\u00ce\u00f3\u00be\u00e0 \u00cc\u00cd \u00c4\u00e6\u00b8\u00e8\u00a8\u00e0\u00aa\u00c8\u00e0 \u00cd\u00e5 \u00a1\u00b6 \u00c4\u00e6\u00b8\u00e8\u00a8\u00e0 \u00aa\u00c8\u00e0 \u00ef\u00c9\u00ef\u00ce\u00df\u00be\u00e0 ;\n\n332006 \u00a1\u00e2\u00a8 6 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c9\u00e5\u00da\u00ba\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba\n\n(i)\u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce \u0095\u00c8\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cd\u00e5 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 ;\n\n(ii)\u00ef\u00cc\u00e0\u00c9\u00e5\u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0, \u00a1\u00e6\u00c0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c9\u00ba\u00e0\u00a8\u008a\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 ;\n\n(iii)\u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00a2\u00ba\u00f8\u00d6\u00a8\u00c7\u00aa\u00ba\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00c0 \u00aa\u00fa\u00b8\u00ea\u008a\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(iv)\u00cc\u00c4\u00e5\u00aa\u008a \u00a1\u00e6\u00ba\u00f8 \u00a8\u00f8\u00d7\u00c4, \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0\u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ; \u00cc\u00cd\n\n(v)\u00ef\u00ef\u00be\u00ba\u00f8\u00a8 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00f8\u00a8\u00f8\u00d7\u00c4, \u00ef\u00c4\u00ef\u00cd\u00c6\u00d1\u00c4\u00ef\u00cd\u00e5\u00e0 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00a1\u00cc\u00e0\u00ba\u00f8\u00ba\u00e0\u00c9 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00f8\u00d7\u00c4, \u0095\u00c8\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cd\u00e5\u0097\u00a8\u00f8\u00b8\u00e9\u00c4 ;\n\n(\u00a7)\u00ef\u008a \u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00a1\u00e5\u00c9\u00c7\u00b8\u00c6\u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00be\u00e5\u00c9\u00ec, \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ba\u00eb\u00be\u00e0\u00c9\u00be\u00c0\u00e5\u00da\u00ca\u00e0\u00c9\u00c6\u00be\u00e0\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00be\u00e0 \u00a6\u00a8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c9\u00e6\u0091 \u00aa\u00b8\u00be\u00a8\u00e0 \u00cc\u00c0\u00c6\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c4\u00e5\u00aa\u008a\u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00c0\u00c6\u00be\u00e0\u00ef\u00be\u00a8\u00e0 :\u2014\n\n(i)\u00ef\u00ef\u00be\u00ba\u00f8\u00a8 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00cc\u00e6\u00a8\u00cc\u00ea\u00c4 \u00ef\u00cd\u00e5\u00e0\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 ;\n\n(ii)\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00a8\u00eb,\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00ef\u00be\u00ba\u00f8\u00a8 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00fa\u00be\u00e0\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9\u00cc\u00c4\u00e5\u00be \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00a8\u00f8\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00f8\u00d7\u00c4\u00cc\u00bf\u00cd\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00f8\u00d7\u00c4 ;\n\n(iii)\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0, \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00ef\u00ef\u00be\u00ba\u00f8\u00a8 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00ef\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00c6\u0095\u00ba \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8\u00e0\u00cc\u00bf\u00cd\u00e5 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7\u00be \u00c8\u00bc \u00a8\u00e5\u00da\u00c6\u00e5\u00c8\u00c6\u00a8\u00e0 ,\u00c9\u00f1\u00e5\u00c0\u00e5\u00d6\u00a8 \u00c8\u00e8\u00c0\u00e8\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a2\u00b6\u00a8\u00b6, \u00ba\u00e6\u00c0\u00e6\u00c8\u00e0\u00c4\u00e5\u00da\u00aa\u00fa\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00c4\u00c6 \u00c8\u00e8\u00c0\u00e8\u00be\u00c6\u00a8\u00e0\u00c8\u00c2\u00e5\u00bc\u00fb\u00c4 ;\n\n342006 \u00a1\u00e2\u00a8 6 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c9\u00e5\u00da\u00ba\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba\n\n(iv)\u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00c3\u00e5\u00c7\u00c6\u00a8 \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00cc\u00ec\u00bc\u00e5\u00be\u008a \u00a8\u00f8\u00d7\u00c4 ;\n\n(v)\u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00be\u00e5\u0095\u00a8\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00cc\u00ec\u00bc\u00e5\u00be\u008a\u00a8\u00f8\u00d7\u00c4 ;\n\n(\u0081)\u00ef\u00c9\u00be\u00ba\u00e0 \u00c8\u00e8\u008d\u00ba \u00be\u00f9\u00ba\u00f8\u00c9\u00c8 \u00a1\u00a8\u00e0 \u00ef\u00c9\u00c7\u00ce \u00a6\u00e0\u00a8\u00a8 \u00cc\u00bf\u00cd\u00e5 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8\u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00a6\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8\u00a8\u00e8\u00d7\u00c4 ; \u00cc\u00cd\n\n(\u00a8)\u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00aa\u00be\u00f8\u0095\u00be\u00e0,\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00c8 \u00be\u00f8\u00c6\u00c4\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7,\n\n\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u201c\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c6\u008a \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be\u00a1\u00ba\u00c7, \u00a6\u00c6\u00b4\u2014\n\n(\u00a1)\u00c8\u00e8\u00d1\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00ef\u00bc\u00c6\u00a8\u00e0 ;\n\n(\u00a1\u00e5)\u00a1\u00da\u00bb\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00c8\u00a8\u00eb\u00b8\u00ea, \u00a2\u00c8\u00a8\u00e0\u00a8\u008a, \u00cc\u00c8\u00a8\u00eb\u00b8\u00ea \u00ef\u00cd\u00e5\u00e0\u00cc\u00e8\u00f3\u00c7\u00e6 \u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a\u00c8\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4,\u00a6\u00c9\u00e6\u00be\u00f8 \u00ef\u00bc\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00ef\u00bc\u00c6\u00a8\u00e0 ;\n\n(\u00a1\u00e6)\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ef\u00bc\u00c6\u00a8 \u00a1\u00e5\u00bd\u00e5\u00c7\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00be\u00e6\u00ba\u00f8\u00c9 \u00ca\u0089\u00bc,\u00c0\u00f2\u00ba\u00f8\u00c7\u00e7\u00c0 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e8\u00c6\u0097\u00c8\u00e8 \u00be\u00f8\u00c0\u00bc\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00ef\u00bc\u00c6\u00a8\u00e0 ;"
