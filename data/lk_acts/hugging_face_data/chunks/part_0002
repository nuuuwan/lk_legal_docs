    "chunk_text": "(iv)\u00ef\u008a \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (i) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5 \u00ef\u00aa\u00be\u00c6\u00e5\u00c4\u00b4 \u00be\u00f8\u00c6\u0095\u00ba \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00cd\u00e5\u00cc\u00ba\u00f1\u00e5\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00ef\u008a \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (ii)\u00c9\u00be \u00ef\u00cd\u00e5\u00e0 (iii) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00ef\u00c9\u00ba\u00a2\u00bc\u00e8\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00a8\u00ef\u00cd\u00e5\u00e0 \u00c0\u00e6\u00cd\u00e6\u00bc\u00fa\u00c8\u00e8 \u00a8\u00f8\u00d7\u00c4\u00a8 \u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba \u00c6\u008a \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6\u00cc\u00ba\u00f1\u00e5\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00ba\u00e5\u00aa \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5\n\n2005 \u00a1\u00e2\u00a8 31 \u00bc\u00c7\u00be \u00a8\u00c0\u00e0\u00c7\u00e6\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00c0\u00be\u00ba8\n\n\u00a8\u00f8\u00d7\u00ef\u008a \u00cd\u00e5 \u00be\u00f8\u00c9\u00e6\u00c7\u00bc\u00fa\u00ba\u00e5\u00c9\u00c6 \u00c2\u00e6\u00c8\u00e9\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a\u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00ef\u008c\u00c8\u00e5\u00c9\u00a8 \u00c6\u008a \u00a2\u00b6\u00c4\u00a8\u00b4, \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8\u00a8\u00b4,\u00a8\u00e5\u00da\u00c6\u00e5\u00c8\u00c6\u00a8\u00b4, \u00aa\u00c2\u00b6\u00e5\u00c9\u00a8\u00b4, \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00ca\u00e5\u00c8\u00e5\u00c9\u00a8\u00b4,\u00c4\u00b6\u00ea\u00c9\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00d6\u00ca\u00f2\u00c6\u00a8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00dd \u00d1\u00c4 \u00cc\u00cd \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4.\n\nIII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00a8\u00c0\u00e0\u00c7\u00e6\u00a8 \u00cc\u0095\u00ba\u00f8\n\n15.\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00ce \u00a8\u00c0\u00e0\u00c7\u00e6\u00a8 \u00cc\u0095\u00ba\u00f8\u00c6\u00a8\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ba\u00e0\u00c9\u00c6 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00c0\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00cc\u00ea\u00f3\u00cc\u00e0\u00cc\u00be\u00e0 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00ef\u008c :\u2014\n\n(\u00a1) \u00c9\u00c6\u00cc \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00bc\u00cd\u00a1\u00b4\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00a8\u00eb\u00b6\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0\u00c9\u00ba\u00eb \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00c9\u00ec \u00a6\u00c9\u00e6\u00be\u00f8 \u00cc\u0095\u00ba\u00f8\u00c6\u00a8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00d7 \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c0\u00e8\u00cd\u00fa\u0090\u00ef\u00c0\u00e5\u00c8\u00e0 \u00a2\u00b6\u008a \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00cc\u00cd ;\n\n(\u00a1\u00e5) \u00a6\u00e0 \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a1\u00f5\u00ba\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00c9\u00aa\u00e5\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c9\u00cc\u00c7\u00c0\u00ba\u00f2 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a8\u00eb\u00b6\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0\u00c9\u00ba\u00eb \u00cd\u00fa\u0095\u00c6\u00be\u00e0 ; \u00cc\u00cd\n\n(\u00a1\u00e6) \u00ef\u00c4\u00c4 \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00bc\u00e6\u00be\u00b4 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be,\u00a1\u00dd\u00ba\u00f8\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00c0\u00e5\u00c8\u00e0 \u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00a8\u00eb\u00b6\u00e5\u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00a8\u00c7\u00e6\u00c9\u00be\u00e0.\n\n16.\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00ce \u00cc\u00e7\u00c4 \u00a8\u00c0\u00e0\u00c7\u00e6\u00a8 \u00cc\u0095\u00ba\u00f8\u00c6\u00a8\u00c4\u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00c9\u00be\u00ea\u00ef\u00c6\u00e0 \u2014\n\n(\u00a1) \u00cc\u00e5\u00c4\u00e5\u00b0\u00e8\u00a8\u00c6\u00be\u00e0 \u00a1\u00ba\u00c7, \u00a1\u00c9\u00ef\u00c2\u00e5\u00e0\u00bd\u00c6 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a6\u00c6 \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea\u00a8\u00f8\u00d7\u00c4 \u00bc, \u00a6\u00ef\u00cc\u00e0\u00c4 \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00cc\u00bf\u00cd\u00e5 \u00a4\u00c0\u00d6\u00c4 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3\u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd\u00ef\u00c6\u00e5\u00e0\u00aa\u00ef\u00c6\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 ;\n\n\u00a8\u00c0\u00e0\u00c7\u00e6\u00a8 \u00cc\u0095\u00ba\u00f8\u00c9\u00c8\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ba\u00e0\u00c9\u00c6.\n\n\u00a8\u00c0\u00e0\u00c7\u00e6\u00a8 \u00cc\u0095\u00ba\u00f8\u00c9\u00c8\u00c0\u00c7\u00c4\u00e5\u00da\u00bb.\n\n2005 \u00a1\u00e2\u00a8 31 \u00bc\u00c7\u00be \u00a8\u00c0\u00e0\u00c7\u00e6\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00c0\u00be\u00ba9\n\n(\u00a1\u00e5) \u00cc\u00e8\u00c6 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00a1\u00ba\u00c7 \u00cc\u00a8\u00cc\u00ea\u00c7\u00e6\u00c9\u008a \u00c3\u00e5\u00c9\u00c6 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00a8\u00e5\u00b4, \u00a6\u00c6\u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00cd\u00e5 \u00cc\u00e5\u00c4\u00e5\u00b0\u00c6\u00fb\u00c6\u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00be\u00e0 \u00a2\u00cd\u00ce \u00be\u00e6\u00e2\u00d1\u00c4 ;\n\n.(\u00a1\u00e6) \u00ba\u00c4 \u00a8\u00eb\u00b6\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0\u00c9\u00ba\u00eb\u00c9\u00c8 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00cc\u00cd \u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8\u00c1\u00c8\u00bc\u00e5\u00c9 \u00be\u00e2\u00c9\u00e5\u00c8\u00e9\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00cc\u00cd \u00a1\u00bc\u00e5\u00ce \u0097\u00bc\u00f1\u00e5\u00ba\u00e0\u00c4\u00a8 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00c6\u00c3\u00e5\u0097\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ba\u00c4 \u00a8\u00eb\u00b6\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00c9\u00ba\u00eb\u00c9\u00c8\u00e8\u00be\u00e0 \u00c8\u00c2\u00be \u00c8\u00e5\u00c3\u00c9\u00e6\u0091 \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00a8\u00eb\u00b6\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0\u00c9\u00ba\u00eb \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00b4 \u00cc\u00cd\u00e5\u00c6 \u00d1\u00c4 ;\n\n(\u00a1\u00e7) \u00ef\u00c0\u00e5\u00c8\u00e0 \u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00cc\u00ea\u00f5 \u00c0\u00d6\u00c4\u00e5\u00b8\u00ef\u00c6\u00e0 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c9\u00ec \u00ef\u00c6\u00e5\u00e0\u00aa\u00f1\u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a2) \u00cc\u0095\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c9\u00ca\u00f1 \u00ef\u00c0\u00e5\u00c8\u00e0\u00c0\u00e8\u00d6\u00cc\u00e6\u00a8\u00cc\u00e9\u00ef\u008a \u00a6\u00e0\u00a8\u00a8, \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00ca\u00e5\u00c8\u00e5 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0 \u00c0\u00cd\u00cc\u00ea\u00a8\u008a\u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4, \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4 ;\n\n(\u00a3) \u00cc\u0095\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00b4 \u00c4\u00ea\u00c8\u00f1 \u00cd\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00c8\u00c2\u00e5 \u00bc\u00fb\u00c4 ;\n\n(\u00a4) \u00c9\u0090\u00be\u00e5\u00a8\u00c4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00ef\u00c0\u00e5\u00c8\u00e0 \u00cd\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c0\u00bc\u00be\u008a \u00a8\u00c7\u00aa\u00ba\u00e0 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00a4\u00be\u00be\u00e0\u00f3 \u00a8\u00c7\u00d1\u00c4 ;\n\n(\u00a4\u00f0) \u00a6\u00c9\u00e6\u00be\u00f8 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00cd\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00c0\u00e8\u00d6\u00cc\u00e6\u00a8\u00cc\u00ea\u008a \u00a6\u00e0\u00a8\u00a8\u00c9\u00c8 \u00ef\u00cd\u00e5\u00e0\u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00ca\u00e5\u00c8\u00e5\u00c9\u00c8 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be, \u00a1\u00ef\u00c8\u0097 \u00a8\u00f8\u00d7\u00c4, \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00cc\u00cd \u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ; \u00cc\u00cd"
