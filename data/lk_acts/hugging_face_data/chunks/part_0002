    "chunk_text": "(2) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00cd\u00fa \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u201c\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9 \u00ba\u00eb\u00ce \u00a1\u00e6\u00ba\u00f8\u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00e9\u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e5\u00c3 \u00cd\u00e5 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c6\u00be\u00e0\u00be\u00b4\u201d \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00cd\u00fa\u00bc\u00fb\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00cd\u00fa \u00c9\u00ec \u00ef\u00bc\u00e0\u00c0\u00ce\u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0,\u00ef\u00a8\u00c8\u00e8\u00be\u00e0\u00c4 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00c4\u00e5\u00da\u00aa\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00cd\u00fa\u00bc\u00fb\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c9\u00f1\u00e5\u00c0\u00e5\u00d6\u00a8 \u00a8\u00b4\u00c6\u00ea\u00ba\u00e0\u00ba\u00a8\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e6\u00c2\u00ea\u00b8\u00ea \u00cc\u00e8\u00c6\u00f5\u00c4 \u00c8\u00e5\u00c3 \u00cd\u00e5\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c.\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6.\n\n\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00c0\u00e6\u00be\u00d1\u00c4.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba2\n\nII \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00c2\u00f3 \u00be\u00f8\u00c6\u00c4 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\n\n(\u00a1)\u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00e5\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00ef\u00a8\u00ba\u00c7\u008a \u00ef\u00a8\u0090 \u00c9\u00ea\u00c9 \u00bc, \u00c6\u008a \u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u00c4\u00a8\u00f8\u00be\u00e0, \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0,\u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00a8\u00f8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c8\u00e5\u00c3 ;\n\n(\u00a1\u00e5)\u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6\u00a8\u00f8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c8\u00e5\u00c3 ;\n\n(\u00a1\u00e6)\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8, \u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00a8 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00bc\u00fa\u00e2\u008e\u00d1 \u00ef\u00be\u00e5\u00cc\u00e8\u0090\u00be\u00ba\u00e5\u00a8\u00e0 \u00f3\u00c7\u00b4, \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00bc\u00fa\u00e2\u008e\u00c9 \u00cc\u00e8\u0090\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00a2\u00b6\u00c4\u00a8 \u00cd\u00e5 \u00a6\u00e0 \u00a2\u00b6\u00ef\u00c4\u00cd\u00fa\u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a\u00c9\u00c8 \u00ca\u00eb\u00bc\u00e0\u00bd \u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00c9\u0090\u00be\u00e5\u00a8\u00c4 ;\n\n(\u00a1\u00e7)\u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) (\u00a1\u00e5) \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e5\u00c3 \u00cd\u00e5\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a\u00bc\u00fb \u00aa\u00b8\u00be\u00e0 \u00aa\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00ef\u0089 \u00be\u008a\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00eb\u00c8\u00e9 \u00ef\u00be\u00e5\u00ef\u00aa\u00c9\u00e5 \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a\u00a2\u00b6\u00c4\u00a8 \u00cd\u00e5 \u00a6\u00e0 \u00a2\u00b6\u00ef\u00c4\u00cd\u00fa \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a\u00c9\u00c8 \u00ca\u00eb\u00bc\u00e0\u00bd \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c9\u0090\u00be\u00e5\u00a8\u00c4, \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00e0 \u00a2\u00b6\u00c4 \u00cd\u00e5 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a\u00c9\u00c8\u00b4\u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00a8\u00eb\u00c8\u00e8\u00c6 \u00ca\u00eb\u00bc\u00e0\u00bd \u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00c9\u0090\u00be\u00e5\u00a8\u00c4\u00b4 \u00c9\u00b6\u00e5 \u00a1\u00b6\u00ea \u00c9\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00a6\u00e0 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c\u00bc\u00fb \u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a8\u00eb\u00c8\u00e8\u00c6 \u00a2\u00a8\u00e0\u00c4\u00c9\u00e5 \u00cc\u00e8\u0090\u00be \u00a6\u00e0 \u00ca\u00eb\u00bc\u00e0\u00bd \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c9\u0090\u00be\u00e5\u00a8\u00ef\u00c4\u00cd\u00fa \u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba\u00c6 ;\n\n(\u00a2)\u00c8\u00e5\u00c3\u00e5\u00e2\u00ca, \u00ef\u00c0\u00e5\u00c8\u00e9 \u00ef\u00cd\u00e5\u00e0 \u00c9 \u00b4\u008a ;\n\n(\u00a3)\u00a1\u00c6\u00d1\u008a \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c6\u00be\u00e0 ;\n\n(\u00a4)\u00a8\u00eb\u00c8\u00e9, \u00c7\u00e5\u00b0\u00f1\u00c3\u00e5\u00aa \u00ef\u00cd\u00e5\u00e0 \u00a1\u0093\u0095\u00c8 ;\n\n(\u00a4\u00f0)\u00ef\u00c8\u00e5\u00ba\u00db\u00c6\u00fa\u00c6\u00a8\u00f8\u00be\u00e0, \u00a7 \u00b4\u00ea \u00a1\u00e6\u00c8\u00e0\u00c8\u00e9\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ec\u00f3 \u00a8\u00f2\u00e9\u00b6\u00e5\u00c9\u00a8\u00f8\u00be\u00e0 \u00bc\u00fa\u00be\u00ea\u008a\u00c8\u00e6\u009f\u00c4 ;\n\n(\u00a6)\u00c7\u00e5\u00b0\u00f1 \u00ef\u00be\u00e5\u00c9\u00be \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4, \u00c0\u00f2\u00bc\u00e5\u00be,\u00c0\u00d6\u00ba\u00f1\u00e5\u00aa \u00ef\u00cd\u00e5\u00e0 \u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0\u00a6\u00c4 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6 \u00ef\u00c9\u00ba \u00c8\u00e6\u00ef\u00c2\u00be \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 ; \u00cc\u00cd\n\n\u00c2\u00f3 \u00be\u00f8\u00c6\u00c4 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba3\n\n(\u00a6\u00e0)\u00a1\u00be\u00f8\u00c6\u008a \u00cd\u00e5 \u00a1\u00be\u00e5\u00c9\u00da\u00ba \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00c6\u00a8 \u00c8\u00e5\u00c3 \u00cd\u00e6\u00c7, \u00ef\u00c9\u00be\u00ba\u00e0 \u00a8\u00c9\u00c7 \u00c9\u00ec\u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00c3\u00c9\u00c6\u00a8\u00f8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4,\n\n\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n4.(1) \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6\u00a8\u00f8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c8\u00e5\u00c3\u00c9\u00c8\u00b4\u2014\n\n(\u00a1)\u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00a8\u00eb\u00ef\u00aa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00be\u00e0\u00c8\u00e6\u00c2\u00ea\u00b8 \u00bc, \u00a4\u00bc\u00e0\u00aa\u00ba \u00c9\u00ea\u00c9 \u00bc\u2014\n\n(i)\u00c6\u008a \u00c9\u00e6\u00b4\u00ea\u00c0\u00a8\u00e0, \u00ef\u008c\u00ba\u00be\u00c6\u00a8\u00e0, \u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00a8\u00e0, \u00be\u00f8\u00c9\u00e5\u00b6\u00ea \u00c0\u0091\u00c6\u00a8\u00e0,\u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0, \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00a8\u00e0, \u00ef\u00a8\u00e5\u0095\u00cc\u00e0 \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0, \u00c0\u00f2\u00cc\u00e5\u00bc\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0, \u00c0\u00e5\u00d6\u00ef\u00ba\u00e5\u00e0\u00cb\u00e8\u00a8\u00c6\u00a8\u00e0, \u00a1\u00c4\u00ba\u00c7 \u00c8\u00e6\u009f\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00c4\u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u00ef\u00c6\u00bc\u00fb \u00cc\u00e8\u0090\u00be \u00a1\u00ba\u00c7\u00ba\u00eb\u00c7 \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00c2\u00e5\u00aa\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00c9\u00ec \u00a6\u00c9\u00e6\u00be\u00f8\u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00aa\u00d1\u00c4\u00a8\u00e0 ;"
