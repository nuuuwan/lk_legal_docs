    "chunk_text": "\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00d5 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00b6\u00ba\u00d7 \u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00b1\u00c6\u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00b1\u00c6 \u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u0081 \u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00b9+\u00c6\u00d0\u00ce\u00b4\u00ce\u00ba\u008a\u0081 \u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9+\u00c6\u00d0\u00ce\u00b4\u00ce\u00ba\u00af\u00bf\u00c8\u0081 \u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6\u00a3\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6 \u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00bc\u00e2 \u00ce\u00c1\u00af\u00c6\u00d0\u00ba\u00c6\n\n\u201c\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00b4\u00c6\u00b4\u00b5\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00d7 \u2013\n\n(\u00a4)\u00a3\u00ba\u00c6\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00be\u00c6 \u00ab\u00b7\u00c6\u00d7 \u00a5\u00be\u00b4\u00c6\u00b1\u00ba\u00c6 \u00f4\u00b9\u00c7\n\n\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00d5 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cd\u00af\u00bd\u00c6\u00b9\"\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9+\u00c6\u00d0\u00ce\u00b4\u00ce\u00ba\u00bb\u00c7\u00be\u00c6\u00d2\u00cd\u00bb\u00b1\u00c6\u00ce\u00b1\u00bb\u00c7\u00b8 \u00ac\u00dd\u00b6\u0081\u00ce\u00ba\u008a\u00be\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00b7\u00b4\u00c7\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00a4\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u0081 \u00a7\u00bb\u00bc\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u0081\" \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c8\u0081 \u00cc\u00b7\u00bd\u00c8\u00db\u00ce\u00bd\u008a\u0081\u00cd\u00b9\u00c7\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9+\u00c6\u00d0\u00b4\u00ce\u00ba\u00bb\u00c7\u00be\u00c6\u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00cd\u00b1\u00ce\u00c1\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u0089\u00bc\u00b6\u00c8 \u00b9\u00bb\u00b8\u00c7\u00af \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a4\u00cc\u00bf\u00c1\u00bc\u00c7\u00df\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b6\u00bc\u00ce\u00af\u00dc\u00ba\u00c6\" \u00b6\u00bc\u00d0\u00af\u00c6 \u00e7\u008b\u00ce\u00bb\u00dc\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00c1\u00bd\u00c6\u00ce\u00bd\u00cc\u00bb\u00c7\u00b6\u00c6\u00b6 \u00a5\u00bb\u00be\u00c6\u0089\u00b8\u00b6\u00c7\u00b8\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00ce\u00bb\u00dc\u00ba\u00c6 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6\" \u00a4\u00b8\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00bf\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00cc\u00b7\u00bd\u00c8\u00db\u00ce\u00bd\u008a\u0081\u00cd\u00b9\u00c7\u00d7\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00bf\u00c8\u0081 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a8\u00c0\u00c8\u00bb\u00dd\u00af\u00c6\u00d0\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7 156 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081(2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00c1\u00ce\u00bc\u008c\u00be\u00af\u00c6\u00af\u00b5\u00ba\u00c6 \u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00de \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00c7\u00b5\u00c8\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00b4\u00c6\u0088\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00b9\u00c7\u00c1\u00ce\u00b8\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00dd\u00b9\u00c6\u00b9\u00c7\u00b4\u00c6\u00b1\u00c8\u00af\u00c6\u00d0 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8\u00cd\u00c1\u00de \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00ce\u00c1 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00af\u00c7\u00d7\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6297\n\nXVI \u00a4\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf,\u00a5\u00b7\u00c6\u00b6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00b6\u00c6\u00b6\u00c7\u00af\u00c6\u00af\u00be\u00c6"
