    "chunk_text": "5.(1) \u00a1\u00f5\u00ba\u00e0\u00c9\u00e6\u0091\u00c6\u00e5 \u00a8\u00f8\u00d7\u008a \u00cd\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0 \u0097\u00c6\u00bc\u008a \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e8\u00c6\u00c6\u00b4 \u0097\u00cc\u00e8\u00c0\u00cd\u00a8\u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u008a\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9, \u00c6\u008a \u00a2\u00b6\u00c4\u00a8 \u00cd\u00e5 \u00a6\u00e0 \u00a2\u00b6\u00ef\u00c4\u00cd\u00fa \u00a1\u00e6\u00ba\u00f8 \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a\u00c9\u00c8\u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c9\u00e5\u00cc\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00ca\u00eb\u00bc\u00e0\u00bd \u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00c9\u0090\u00be\u00e5\u00a8\u00c4, (\u00a8\u00eb\u00c8\u00e9\u00be\u00f8\u00c9\u00e6\u00cc\u00e8\u00c6\u00e5\u00c9\u00d6\u00c0\u00be\u008a \u00bc, \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u00a1\u00f5\u00ba\u00e0\u00c9\u00e6\u0091\u00c6\u00e5 \u00a8\u00f8\u00d7\u008a\u00c9\u00c8 \u0097\u00c6\u00bc\u008a \u00bc, \u00ef\u00aa\u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8)\u00c9\u00cc\u00d6\u00be\u00e0 \u00c9\u00cc\u00c7 \u00aa\u00ba\u00e0 \u00a8\u00c8 \u00a8\u00eb\u00c8\u00e9\u00be\u00f8\u00c9\u00e6\u00cc\u00e8\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4 \u00a2\u00b6\u00c4\u00b4 \u00cd\u00e5 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea\u00a8\u00f8\u00d7\u008a\u00c9\u00c8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u00cc\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u00c6\u00fa \u00c6\u00ea\u00a8\u00e0\u00ba\u00f8 \u00cc\u00cd\u00aa\u00ba\u00c9\u00c2\u00c8\u00e5\u00ef\u00c0\u00e5\u00ef\u00c7\u00e5\u00ba\u00e0\u00ba\u00eb \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a8\u00eb\u00c8\u00e8\u00c6 \u00a1\u00be\u00ea\u00c9 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n6.\u00a2\u00b6\u008a \u00cc\u00cd \u00a6\u00e0\u00c9\u00e5\u00ef\u00c6\u00e0 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a \u00c2\u00f3 \u00bc\u00fb\u00ef\u00c4\u00be\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00be \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00ef\u00cd\u00e5\u00e0 \u00c8\u00e5\u00c3, \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u00cd\u00e5 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u00bc\u00ce \u00a8\u00eb\u00c8\u00e9 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6\u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00e6\u00d6\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c9\u00ec \u00c9\u00d6\u00c0\u00be\u008a \u00a1\u00b6\u00ea \u00a8\u00c7, \u00a1\u00f5\u00ba\u00e0\u00c9\u00e6\u0091\u00c6\u00e5 \u00a8\u00f8\u00d7\u008a\u00c9\u00c8 \u0097\u00c6\u00bc\u008a\u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u00c3\u00e5\u00c7\u00ef\u00aa\u00be \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00ef\u00ca\u00e0\u00cb\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u0097\u00cc\u00e8\u00c0\u00cd\u00a8\u00e0 \u00a1\u00b6\u00ea\u00a8\u00ce \u00c0\u00cc\u00ea \u00a2\u00ba\u00f8\u00d6 \u00c9\u00be \u00c4\u00ea\u00bc\u00c8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00be\u00c4\u00ea\u00ba\u00e0, \u00a6\u00c6 \u00a6\u00c9\u00e6\u00be\u00f8 \u00a2\u00b6\u008a \u00cd\u00e5 \u00a6\u00e0\u00c9\u00e5\u00ef\u00c6\u00e0\u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u00a8\u00eb\u00c8\u00e8\u00c6 \u00ba\u00ba\u00e0\u00a8\u00e5\u00c8\u00ef\u00c6\u00e0\u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00c6\u008a \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u00e9\u00c4\u00e5\u00a8\u00c7 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00bc\u00fb, \u00a8\u00eb\u00c8\u00e9\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00c8\u00c2\u00e5\u00aa\u00ba \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00ba \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0\u00cc\u00bf\u00cd\u00e5 \u00a1\u00bc\u00e5\u00ce \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00e6\u00c8\u00cc\u00e9\u00ef\u00c4\u00be\u00e0 3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e7) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c9\u00be \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00a6\u00c6\u00fa\u00be\u00e0 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea \u00a2\u00ba\u00f8\u00d6\u00c9\u00be \u00ca\u00eb\u00bc\u00e0\u00bd \u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00c9\u0090\u00be\u00e5\u00a8\u00ef\u008a \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4, \u00a1\u00b6\u00ea\u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nIII \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\n\n7.(\u00a1) (i) \u00ef\u00c8\u00e5\u00e0\u00a8 \u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 ;\n\n(ii) \u00a6\u00a8\u00e0\u00cc\u00ba\u00e0 \u00b0\u00e5\u00ba\u00f9\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00c9\u00ec \u00cd\u00e5 \u00a6\u00e0\u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c6 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c0\u00d6\u00cd\u00c7\u00b8\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00cd\u00fa \u00c0\u00e8\u00cd\u00fa\u0090 \u00c6\u008a \u00a2\u00b6\u00c4\u00a8 \u00cd\u00e5\u00a6\u00e0 \u00a2\u00b6\u00ef\u00c4\u00cd\u00fa \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a\u00c9\u00c8 \u00ca\u00eb\u00bc\u00e0\u00bd \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c9\u0090\u00be\u00e5\u00a8\u00c4 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00a6\u00e0 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 ;\n\n\u00a2\u00b6\u008a \u00cc\u00cd \u00a6\u00e0\u00c9\u00e5\u00ef\u00c6\u00e0\u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a\u00a8\u00eb\u00c8\u00e8\u00c6\u00b4 \u00bc\u00fb\u00ef\u00c4\u00be\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00be \u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4.\n\n\u00a1\u00e6\u00ba\u00e6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0(\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00be\u00e0 \u00cd\u00e6\u00c7)\u00a7\u00c9\u00ea\u00be\u00e0 \u00c8\u00c2\u00be \u00c8\u00e5\u00c3\u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c9\u00c8 \u00c4\u00ea\u00dd\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0\u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00c4\u00ba,\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0\u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n\u00a2\u00b6\u00c4 \u00cc\u00cd \u00a6\u00cd\u00fa \u00a1\u00e6\u00ba\u00f8\u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a\u00c9\u00c8\u00ef\u00cd\u00e5\u00e0 \u00c6\u008a\u00c9\u00e5\u00cc\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8 \u00ca\u00eb\u00bc\u00e0\u00bd\u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00c9\u0090\u00be\u00e5\u00a8\u00c4.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba8\n\n(iii) \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0 ;\n\n(iv) \u00a1\u00e5\u00cc\u00e8\u00c6\u00e5\u00be\u00ea \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c;\n\n(v) \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c;\n\n(vi) \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00b4 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a\u00b8\u00c6 \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00c4\u00ba \u00c9\u00ec \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00c6\u00a8\u00f8\u00d7\u008a\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ef\u00c6\u00ef\u00bc\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec,\u00c0\u00f2\u00ba\u00f8\u00cc\u00e2\u00cc\u00e0\u00a8\u00c7\u00b8\u00c6 \u00cc\u00cd \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00ce \u00ef\u00c9\u00be\u00ba\u00e0\u00c6\u008a \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00ef\u00cd\u00e5\u00e0 \u0097\u00ef\u00bc\u00e0\u00ca \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8;\n\n(vii) \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00c9\u00e5\u00d6\u00c4\u00e5\u00da\u00aa \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0;"
