    "chunk_size_bytes": 3582,
    "chunk_text": "(12) \u0097\u00c4\u00da\u00ca\u00be\u00c6 \u00a1\u00ba\u00eb\u00c7\u00ba\u00eb\u00c7 \u00bc\u00fb \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e8\u00c6\u00b4 \u00a8\u00c7\u00be\u00c8\u00bc \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00cc\u00c4\u00aa \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00ae\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c9\u00e5\u00da\u00ba\u00e5\u00aa\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca \u00cc\u00cd \u00c0\u00e6\u00cd\u00e6\u00bc\u00fa\u00c8\u00e8 \u00a8\u00f8\u00d7\u008a \u00a1\u00e6\u00ba\u00e0\u00be\u008a \u00a6\u00e0\u00c9\u00e5\u00bc, (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7 \u00c9\u00e5\u00da\u00ba\u00e5\u00aa\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00a6\u00a8\u00ba\u00eb\u00a8\u00f8\u00d7\u008a, \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u008a \u00cc\u00cd \u00c0\u00e6\u00cd\u00e6\u00bc\u00fa\u00c8\u00e8 \u00a8\u00f8\u00d7\u008a \u00ef\u00cd\u00e5\u00e0 (5) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c8\u00bc \u00cd\u00e5 \u00c9\u00e5\u00da\u00ba\u00e5\u00aa\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u0097\u00cc\u00e0\u00ba\u00c7\u00c6, \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0\u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00bc\u00fa\u00c9\u00ea\u00c7\u00e6\u008a \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(13) \u00be\u00b6\u00ea \u0097\u00c3\u00e5\u00aa\u00ef\u00c6\u00e0 \u00bc\u00fb \u00ae\u00ea\u00bc\u00fa\u00ba\u00c6\u00e5\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e7\u00c4\u00cc\u00e5\u00a8\u00e0\u00cb\u00e8\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00b4 \u00c4, \u00be\u00e9\u00ba\u00f8\u00b3\u00c6\u00a8\u00eb \u00c4\u00aa\u00fa\u00be\u00e0 \u00ef\u00c0\u00be\u00f9 \u00cc\u00e8\u009b\u00c4\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba.\n\n2005 \u00a1\u00e2\u00a8 15 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6(\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba8\n\n(15) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00c4\u00ec\u00c8\u00e8\u00a8\u00c0\u00d7\u00a8\u00e0\u00cb\u00b8\u00c6\u00a8\u00b4, 1979 \u00a1\u00e2\u00a8 15 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 \u00c0\u00be\u00ef\u00ba\u00e0XV \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00c9\u00ca\u00f1 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u008a \u00cc\u00cd\u00fa\u00ba\u00c9 \u00a1\u00bc\u00e5\u00ce \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n7.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be, \u00a6\u00c6 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3\u00ef\u00bc\u00a8\u00a8 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n8.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00be\u00ba \u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00a8\u00e5\u00c8\u00c6.\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5\u00c0\u00e5\u00b5\u00c6 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n2005 \u00a1\u00e2\u00a8 15 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6(\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba9\n\n\u00a1\u00be\u00ea\u00c2\u00c8 \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00be\u008a,\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00c7\u00bc\u00a8\u00b4 \u00a1\u00be\u00ea\u00c2\u00c8 \u00bc\u00fb\u00c4\n\n\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00c7\u00bc\u00a8\u00b4 \u00a1\u00be\u00ea\u00c2\u00c8\u00bc\u00fb\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00eb\u00c4\u00be\u00e0\u00ba\u00f2\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\n\n\u0095\u00be\u00f9 \u00c4\u00e6\u00c7\u00e6\u00c4\n\n\u0095\u00be\u00f9 \u00c4\u00e6\u00c7\u00e6\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00a4\u00c0\u00c9\u00e5\u00bc\u00f1 \u00c4\u00be\u00ea\u00cb\u00f1 \u00ab\u00e5\u00ba\u00be\u00c6\n\n\u0095\u00be\u00f9 \u00c4\u00e6\u00c7\u00e6\u00c4\u00b4 \u00ba\u00e6\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\n\n\u0095\u00be\u00f9 \u00c4\u00e6\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c0\u00cd\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00ef\u00aa\u00be \u00c6\u00e5\u00c4\n\n\u00a1\u00c6\u00ea\u00ba\u00eb \u00ef\u00c8\u00cc \u00cc\u00e8\u00c7\u00a8\u00c7 \u00ba\u00e6\u009f\u00ef\u008a \u00ef\u0083\u00ba\u00be\u00e5\u00ef\u00c9\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00be\u00e0\u00ba\u00a8\u00eb\u00a1\u00c0\u00cd\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00ef\u00aa\u00be \u00c6\u00e5\u00c4\n\n\u00c2\u00c7\u00c0\u00ba\u00c8 \u00ba\u00eb\u00c9\u00e5\u00c8 \u00a8\u00f8\u00d7\u00c4 \u00a1\u00e5\u00bc\u00fa\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00a1\u00c0\u00cd\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00ef\u00aa\u00be \u00c6\u00e5\u00c4\n\n\u00a1\u00c0\u00cd\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00cc\u00ad\u00c9\u00e5 \u00ba\u00e6\u009f\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e8\u00c7\u00a8\u00c7\u00ba\u00e6\u009f\u00c4\n\n\u00cc\u00e0\u00ba\u00f2\u00e9 \u00f4\u00cb\u00b8\u00c6\n\n\u00ef\u00cc\u00e5\u00c7\u00a8\u00c4, \u00c4\u00c7\u00b8\u00c6 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cc\u00ec\u00bc\u00e5\u00be\u008a \u00d1\u00c4 \u00a1\u00e5\u00bc\u00fa\u00c6\n\n\u00c4\u00c7\u00b8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00c7\u00c0\u00ba\u00c8 \u00ba\u00eb\u00c9\u00e5\u00c8 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ba\u00e6\u00ba\u00e0 \u00a8\u00c7 \u00ef\u00a8\u00e5\u00c8\u00e0\u00c8\u00a8\u00e7\u00c4\n\n\u00c4\u00e5\u00c7\u00a8 \u00a1\u00e5\u00c6\u00ea\u00bd\u00c9\u00c8\u00e8\u00be\u00e0 \u00cc\u00be\u00e0\u00be\u00bc\u00e0\u00bd\u00c9 \u00ef\u00a8\u00e5\u00c8\u00e0\u00c8 \u00a8\u00e7\u00c4\u00b4 \u00ba\u00e6\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\n\n\u00a2\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00e6\u00c7\u00bc\u00fa\u00c9\u00c8\u00e8\u00be\u00e0 \u00c6\u008a \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ba\u00e6\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\n\n\u00c0\u00ea\u00c0\u00ea\u00c7\u00b8 \u00f7\u00c9\u00f1 \u00c3\u00e5\u0097\u00ba \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0, \u00c0\u00e9\u00b6\u00e5\u00a8\u00e5\u00d6 \u00a1\u00e5\u00c6\u00ea\u00bd \u00c3\u00e5\u0097\u00ba\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00eb\u00c9\u00a8\u00e0\u00a8\u00eb\u00c9\u00a8\u00e0 \u00c3\u00e5\u0097\u00ba \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a\u00c9\u00c7\u00bc\u00a8\u00e0.\n\n102 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6\n\n113 \u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6\n\n296 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6\n\n297 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6\n\n300 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6\n\n355 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6"
