    "chunk_text": "\u201c\u00cd\u00b6\u00c7\u00b6\u00c7\u00b8 \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b9\u00c6 \u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00bc\u00c6\u201d\" \u201c\u00cd\u00b6\u00c7\u00b6\u00c7\u00b8 \u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00bc\u00c6\u201d\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u201c\u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00b8 (110 \u00a4\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8) \u0089\u00bd\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6\" \u00a5\u00bd\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6 \u00b9\u00b6\u00c8\u00e2\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6\u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u00bd\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00d7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b9\u00c7\u00dd\u00ce\u00bf\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\n\n\u201c\u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b9\u00c6 \u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" (110 \u00a4\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8)\u0089\u00bd\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6\" \u00a5\u00bd\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6 \u00b9\u00b6\u00c8\u00e2\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 4 \u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u0089\u00bd\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6 \u00a5\u00bd\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6\u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b9\u00c6 \u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 \u00a9\u00b8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n\u00b9\u00c7\u00af\u00ba\u00c6 II\n\n\u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00a5\u00bf\u00ba\u00c6 \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00af\u00b4\u00c6\u00d5\u00af\u00c6\u00af\u00c7\u00c1\u00be\u00c6\n\n7\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00a5\u00b9\u00c6\u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u0089\u0081\u00c1\u00dd\u00cd\u00c1\u00c7\u00bc\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\u2013\n\n\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00cd\u00af\u00c7\u00b4\u00be\u00c6\u00b0\n\n62005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d2\u00b8\u00c7\u00ba\u00c8(\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n2004\" \u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00bc\u00c6 26 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a5\u00b4\u00ba\u00c6\u00cc\u00b9\u00bd\u00c6\u00bd \u00d2\u00b8\u00c7\u00ba\u00c8\u008a\u0081\u008c\u00ce\u00bf\u00cc\u00c1\u00c7\u0081\u00bd\u00c7\u00af \u2013\n\n(\u00a3)\u00a3\u00b7\u00c7\u00ce\u00b6\u00bb\u00c7\u00af \u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u0089\u00bf\u00c6\u00ce\u00bf \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a5\u00bf\u00ba\u00c6 \u00a4\u00bf\u00c6\u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00c1\u00dd\u00ba\u00c6 ;\n\n(\u00a4)\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081 \u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00ce\u00b9 \u00aa\u00bd\u00c6\u00af\u00db\u0088\u00bb\u00c7\u00b6\u00c8\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00b6\u00b8\u00c8\u00cc\u00bb\u00c7\u00dd \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00dd\u00b4\u0081 \u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u0089\u00bf\u00c6\u00ce\u00bf \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u0081\u00de\u00ba\u00c6 ;\n\n(\u00a5)\u00b6\u00b8\u00c8\u00cc\u00bb\u00c7\u00dd \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00dd\u00b4\u0081 \u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00c1\u00dd\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c7\u00be\u00c6 \u00c1\u00c0+\u00c6\u00af \u00db\u0088\u00bb\u00c7\u00b6\u00c8\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00da\u00ba\u00c6 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00ba\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00a5\u00bf\u00ba\u00c6 \u00a4\u00bf\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00c1\u00dd\u00ba\u00c6\u00b0\n\n8\u00b0 (1) 1998 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 50 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b6\u00b1\u00c8\u00bb \u00b1\u00c8\u00de\u00c1\u00bc\u00c6\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b1\u00c8\u00bb\u00b1\u00c8\u00de\u00c1\u00bc\u00c6 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9 (\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6\u201c\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00a3\u00b7\u00c7\u00ce\u00b6\u00bb\u00c7\u00af\u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u0089\u00bf\u00c6\u00ce\u00bf \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u0081\u00de \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00df\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u00a9\u00b7\u00c6\u00b6\u00b9\u00c6\u0089\u00bf\u00c6\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bf\u00ba\u00c6 \u00a4\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u008111 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00d2\u0096\u00af\u00c7\u00bc\u00ba\u00c6 \u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00da \u008c\u00dd\u00ba\u00c6\u00b9\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7\u00a3\u00b7\u00c6\u00b6\u00b9\u00c6 \u0089\u00bf\u00c6\u00ce\u00bf \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a5\u00bf\u00ba\u00c6 \u00a4\u00bf\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00c1\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00df\u00ba\u00c6\u00af\u00c8\u00ce\u00b4\u00af\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00bd\u00c6\u00de\u00bf\u00c6\u00bf \u00a9\u00be\u00c6\u00be\u00c7\u00b6\u00c6 \u00b6\u00af\u00c1\u00df\u00ba\u00c6 \u00a3\u00b4+\u00c6\u00af\u00c8\u00bb \u00a5\u00b4\u00c7\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00cd\u00b9\u00d6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00cd\u00b9\u00b5\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00a5\u00b4\u00c7\u00b9\u00c6\u00da\u00cc\u00b1\u00ba\u00c6\u00ce\u00ba\u00bb\u00c7\u00b8 \u00b6\u00af\u00c1\u00ce\u00be\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b9\u00c6\u00b9\u00b6\u00ce\u00b8 \u00a7\u00de\u00b6\u00c8\u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af \u00a9\u00b7\u00c6\u00b6\u00b9\u00c6 \u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00bf\u00ba\u00c6 \u00a4\u00b4\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00b6\u00af\u00c1\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a5\u00b4\u00c7\u00b9\u00c6\u0089\u00be\u00c6 \u00b9\u00b6\u00c8\u00bb\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6\u00b9\u00c6\u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00bf\u00ba\u00c6 \u00a4\u00b4\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8 \u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00b8\u00cc\u00b6\u00b8\u00a3\u00d7 \u00af\u00dd\u00b6\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u008c\u00b1\u00c7\u00bc\u00ce\u00b5\u00ce\u00bb\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c7\u00de\u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n9\u00b0 (1) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00a5\u00b9\u00c6\u00b9\u00c7\u00af\u00ba\u00c6 \u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00af\u00c6\u00d0\u00c1\u00dd\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 7 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (\u00a3) \u00a3\u00be\u00c6\u00be\u00d7 (\u00a4) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00af \u0089\u00bf\u00c6\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00af\u00c6 \u00af\u00b4\u00c6\u00d5\u00af\u00c6\u00af\u00c7\u00b9\u00c6\u0089\u00be\u00c6\u00ce\u00c1\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf \u00ac\u00c1\u00c6\u00cd\u00c1\u00c7\u00bc\u00c7\u00e0\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c6 :-\n\n(\u00a3)\u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c7\u00af \u00a5\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u0081\u00bd\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 ;\n\n\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00a5\u00b4\u00c7\u00b9\u00c6\u00da \u00ac\u0081\u00ce\u00bd\u00b9\u00c6\u00cd\u00b9\u00d6\u00b6\u00be\u00c6\u00b0\n\n\u00b7\u00c8\u00af\u00c0\u00c6\u00af\u00c7\u00be\u00af\u00c6\u00af\u00b4\u00c6\u00d5\u00af\u00c6\u00af\u00c7\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c7\u00af\u00b9\u00c6\u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0"
