    "chunk_size_bytes": 3534,
    "chunk_text": "\u00cd\u00ba\u00c7\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00d6\u00bc\u00fa \u00c9\u00ec \u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c0\u00d6\u00bc\u00fa\u00c9\u00ec \u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00ca\u00ed\u00be\u00f1 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00aa\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6 \u00ef\u00be\u00e5\u00c9\u00be\u00c3\u00e5\u00b8\u00e0\u00b6 \u00cd\u00e5 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00c9\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be \u00c3\u00e5\u00b8\u00e0\u00b6\u00c9\u00c8\u00c9\u0090\u00be\u00e5\u00a8\u00c4 \u00c4\u00ba \u00c2\u00f3 \u00a1\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00cc\u00cd ;\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6.\n\n2002 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be,\u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba\u00c2\u00f3 \u00c0\u00be\u00ef\u00ba\u00e0 2 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba2\n\n(3)\u00a6\u00cd\u00fa (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (II) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c\u00be\u00e8\u0095 \u00a1\u00e6\u00ad\u00dd\u008a \u00cc\u00e6\u00c0\u00c6\u00ea\u00c4\u00c4\u00ba\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00c9\u00c8 \u00cc\u00e8\u00b4 \u201c\u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be \u00ba\u00e5\u00a8\u00e0 \u00a8\u00c8\u00e0 ;\u201d\u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00c9\u00ae\u00be \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(III)1996 \u00a1\u00e2\u00a8 33 \u00bc\u00c7\u00be \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ba\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc, \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0\u00cc\u00ee\u00b0\u00ea\u00c9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1978 \u00a1\u00e2\u00a8 4\u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00cc\u00c4\u00aa\u00a6\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 17 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4\u00a6\u00ce\u00d0 \u00cc\u00e8\u0090\u00be \u00a1\u00c0\u00be\u00c6\u00be \u00ef\u00c9\u00ef\u00ce\u00bf \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0\u00c4\u00e5\u00da\u00aa\u00ef\u00c6\u00be\u00e0 \u00a1\u00c0\u00be\u00c6\u00be \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8\u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00c9 \u00cc\u00e8\u0090\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc\u00a1\u00c0\u00be\u00c6\u00be\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00cc\u00c0\u00c6\u00be \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00ef\u00c6\u00e5\u00bc\u00e5\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00c7\u00be \u00a1\u00e6\u00ad\u00dd\u008a \u00c9\u00be, \u00a1\u00e6\u00ad\u00dd\u008a \u00cc\u00e6\u00c0\u00c6\u00ea\u00c4\u00c4\u00ba; \u00ef\u00cd\u00e5\u00e0\n\n(iv)\u00c6\u008a \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00ee\u00b0\u00ea\u00c9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00b0\u00e5\u00ba\u00f8\u00a8\u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1978 \u00a1\u00e2\u00a8 4 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ef\u00ba\u00e0 17 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00cc\u00c4\u00aa \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00d1\u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00a1\u00c0\u00be\u00c6\u00be \u00ef\u00c9\u00ef\u00ce\u00bf \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00cd\u00c7\u00cd\u00e5\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be, 1996 \u00a1\u00e2\u00a8 33 \u00bc\u00c7\u00be \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00cc\u00e6\u00c0\u00c6\u00ea\u00c4\u00a8\u00e0 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec\u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8\u00c9\u00c8 \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6, \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c9\u0090\u00be\u00e5\u00a8\u00c4\u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00be \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00c6\u00a8\u00e0 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4\u00c4\u00ba,\n\n\u00a6\u00c4 \u00a1\u00e6\u00ad\u00dd\u008a \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0\u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00c7\u00a8\u008a \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e4\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00c7,\u00a6\u00c4 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00b4, \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5 \u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be\u00c0\u00d6\u00bc\u00fa \u00a6\u00c4 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00cc\u00e6\u00c0\u00c6\u00e9\u008a\u00c8\u00e5\u00c3\u00fb\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00ba\u00f1 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c4\u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00c2\u00c9\u00b4, \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\n\n2006 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba3\n\n\u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00ef\u00ba\u00f2\u00c4\u00e5\u00cc\u00e8\u00a8 \u00c0\u00bc\u00be\u00c4\u00a8\u00e0 \u00c4\u00ba \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00cc\u00e6\u00cc\u00df\u008a\u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00ba\u00e5\u00a8\u00e0 \u00a8\u00c8\u00e0,\u201d;\n\n(4)(3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00bc\u00c9\u00be \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0\u2014\n\n(\u00a1) \u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0, (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (iv) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6\u00b4\u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4, \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0:\u2014"
