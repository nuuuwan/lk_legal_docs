    "chunk_text": "\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 (\u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081/\u00a5\u00bf\u00ba\u00c6 \u00a4\u00bf\u00c8\u0081 \u00cc\u00b9\u00bb\u00bc\u00c6)\u00a9\u0081\u00b9\u00c1\u00bc\u00c8\u0081 \u00d2\u0096\u00af\u00c7\u00bc\u00b9\u00c6 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c7\u00af /\u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c6\u00af\u00bf\u00c7\u00af \u00ad\u00bc\u00c7\u00ae\u00d5\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00b6\u00c6 \u00b6+\u00c6\u00af\u00ce\u00bf \u00b7\u00c8\u00bb\u00ba\u00c8\u00b6\u00c6\u00d7 \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 \u00a4\u00ba\u00c6\u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00d2\u0096\u00af\u00c7\u00bc\u00af\u00c6 \u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00da\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u008a\u00dd\u00b7\u00c6\u00d7 \u00cd\u00ba\u00df\u00ba\u00c6 \u00ad\u00bc\u00c7\u00ae\u00d5 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00da\u00d7\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7\u00b0\n\n2\u00b0 \u00a5\u00b7\u00c6\u00b7\u00c8\u00bb\u00ba\u00b8\u00ba\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00b7\u00c8\u00b9\u00b7\u00c6\u00b6\u00ce\u00b8\u00af\u00e0\u00af\u00c6\u00d0 \u00a3\u00ce\u00ba\u00c1\u00c7\u00b8\u00b6\u00c7\u00d0\u00ba\u00c6 :\n\n(\u00a4) \u00b6+\u00c6\u00af\u00bf\u00c7\u00be\u00c6 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00d2\u0096\u00af\u00c7\u00bc\u00af\u00c6 \u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00da \u00b9\u00bd\u00c6\u00bd\u00c8 \u00a3\u00bd\u00c8\u00af\u00c6\u00ce\u00af\u008a\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a5\u00b6\u0081\u00af\u00c9\u00c0\u00c6 \u00cc\u00b9\u00bb\u00bc\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00ae\u00af\u00c7\u00b5\u00c8\u00b9\u00c6\u00da\u00a3\u00df\u00c1\u00be\u00ce\u00bc \u00a5\u00bb\u00be\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a9\u00be\u00c6\u00be\u00c7 \u00a7\u00b6\u008c\u00ce\u00bb\u00dc\u00ba\u00c6 \u00ac\u00b6\u00c6\u00d7\u00ce\u00c0\u00b9\u00c6\u00ce\u00b9\u00dc\u00ba\u00c6\u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00a5\u00b7\u00c6\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00af \u00d2\u0096\u00af\u00c7\u00bc\u00b9\u00c6 \u0089\u00bf\u00c6\u00ce\u00bf / \u00a5\u00bf\u00ba\u00c6 \u00a4\u00bf\u00c6 \u00c1\u00b6\u00c8\u00dc\u00ba\u00c6 \u00c1\u00bf\u00e2\u00af\u00bf\u00c8\u00be\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00cd\u00b7\u00bc\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00cd\u00c1\u00b1\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00a3\u00c1\u00b1\u00c8\u00bb\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00ce\u00bf \u008c\u00b1\u00c7\u00bc\u00c8\u00af\u00c6\u00af\u00e2\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a5\u00b4\u00b6\u00c6\u00ce\u00b6 \u00cd\u00b1\u00c7\u00b6\u00ce\u00b8\u008a\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u00c1\u00dd\u00af\u00c6\u00d0 \u00a3\u00d9\u00ba\u00b6\u00c8\u00bb\u00bf\u00c8\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d2\u00b8\u00c7\u00ba\u00c8(\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c633\n\n3\u00b0 \u00cd\u00ba\u00bd\u00c6\u00b9\u0088 \u00b7\u00c8\u00b9\u00b7\u00c6\u00b6\u00ce\u00b8\u00af\u00bf\u00c6 \u00a9\u00c1\u00bd\u00c6\u00ce\u00bd\u00dc\u00ba\u00c6 \u00b6\u00c7+\u00c6\u00af\u00bf\u00c6 \u00ba\u00c9\u00de\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00d2\u0096\u00af\u00c7\u00bc\u00af\u00c6 \u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00da\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00a5\u00be\u00c6\u00be\u00c7\u00cc\u00b6\u00c7\u00c0\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a4\u00bf\u00c7\u00d0\u00ba\u00c6\u00b0\n\n4\u00b0 (\u00a3)\u00a5\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00a5\u00be\u00c6\u00be\u00c7\u00cc\u00b6\u00c7\u00c0\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u0088\u0081\"\n\n(\u00a4)\u00a5\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00db\u0088\u00e2\u00de\u00c1\u00b6\u0081\u00cd\u00ba\u00be\u00c6\"\n\n(\u00a5)\u00a5\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00a3\u00bd\u00c6\u00de\u00b9\u00c6\u00cd\u00b9\u00c7\u00c1\u00b6\u0081\u00cd\u00ba\u00be\u00c6\"\n\n\u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081/ \u00a5\u00bf\u00ba\u00c6 \u00a4\u00bf\u00c8\u0081 \u00af\u00b4\u00c6\u00d5\u00af\u00c6\u00cd\u00af\u00c7\u00b9\u00c6\u00ce\u00b9 \u00cd\u00b6\u00b1\u00c8\u00bb \u00b1\u00c8\u00de\u00c1\u00bc\u00c6 \u00b9\u00c7\u00d7