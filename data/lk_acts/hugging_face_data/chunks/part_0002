    "chunk_text": "\u00a9\u00be\u00c6\u00be\u00c7\u00b1\u00c6 \u00e9\u00c0\u00c6\u00b7\u00c8\u00ce\u00be\u00af\u00bf\u00c8\u00df\u00ba\u00c6\" \u00d0\u00bd\u00c6\u00bd\u00b3\u00c6\u00b1\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6\" \u00db\u00ce\u00bd\u00c7\u00b8\u008c\u00bf\u00af\u00c6\u00af\u00db\u00ba\u00c6 \u00a9\u00b6\u00c8\u00bc\u00c6\u00c1\u00c7\u00b6\u00d7\u00ba\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00b7\u0081\u00ce\u00ba\u00cc\u00b9\u00de\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\" \u00a5\u00ce\u00c1 \u00b6\u00bd\u00c6\u00cd\u00b9\u00c7\u00ce\u00b6\u00bb \u00b1\u00ba\u00c1\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081 105 \u00a4\u00ba\u00c6 \u00a7\u00de\u00b9\u00c6\u00da\u00ce\u00bc\u008a\u00b8\u00c7\u00df\u00ce\u00c6\u00a3\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b8\u00c1\u00bd\u00c6\u00bd\u00c8\u00b8\u00c7\u00df\u00ba\u00c6 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bd\u00c6\u00bd\u00c8\u00df\u00ba\u00c6 \u00b9\u00c7\u00bc\u00c6\u00af\u00c6\u00af\u00a3\u00d9\u00e7\u00be\u00ba\u00c6 \u00d0\u00ce\u00bd\u00b7\u00c6\u00b6\u00b8\u00c1\u00c7\u00af\u008c\u00dd\u00b6\u00c6\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n\u00a7\u00de\u00b9\u00c6\u00da\u00ce\u00bc 130\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 4 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cc\u00b2\u00b8\u00c9\u00c1\u00c7\u00b1\u00ba\u00c1\u00c7\u00bb+\u00c6\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c624\n\n\u00a7\u00de\u00b9\u00c6\u00da\u00ce\u00bc 131\n\n\u00a7\u00bb\u00bc\u00c6 \u00ac\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00b6\u00c6 \u00b6\u00c8\u00bd\u00b6\u00c6\u00b6\u00c1\u00bc\u00c6 \u00a9\u00d7\u00e2\u00ba\u00c6\" \u00db\u00bd\u00c6\u00cd\u00b9\u00c7\u00b7\u00c6\u00b6 \u00a7\u00de\u00b9\u00c6\u00da\u00ce\u00bc\u0