    "chunk_text": "(vi) \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00b4 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a\u00b8\u00c6 \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00c4\u00ba \u00c9\u00ec \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00c6\u00a8\u00f8\u00d7\u008a\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ef\u00c6\u00ef\u00bc\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec,\u00c0\u00f2\u00ba\u00f8\u00cc\u00e2\u00cc\u00e0\u00a8\u00c7\u00b8\u00c6 \u00cc\u00cd \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00ce \u00ef\u00c9\u00be\u00ba\u00e0\u00c6\u008a \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00ef\u00cd\u00e5\u00e0 \u0097\u00ef\u00bc\u00e0\u00ca \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8;\n\n(vii) \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00c9\u00e5\u00d6\u00c4\u00e5\u00da\u00aa \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0;\n\n(i) \u009f \u00a8\u00c8\u00e5\u00c0\u00ef\u00c6\u00e0 2 \u00c9\u00be \u00cc\u00cd 3 \u00c9\u00be \u00a4\u00c0 \u00a8\u00c8\u00e5\u00c0\u00c9\u00c8 ;\u00cc\u00cd\n\n(ii) \u00d5 \u00a8\u00c8\u00e5\u00c0\u00ef\u00c6\u00e0,\n\n\u00b0\u00be\u00c0\u00bc\u00fa\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c6\u00cd\u00c0\u00ba \u00cc\u00bf\u00cd\u00e5 \u00c6\u00ea\u00ef\u00c7\u00e5\u00e0\u00c0\u00e9\u00c6 \u00a1\u00e5\u00da\u00bb\u00fc\u00a8\u00cd\u00c9\u00ea\u00ef\u00c8\u00e0 \u00c4\u00ea\u00c8\u00f1\u00e5\u00bd\u00e5\u00c7 \u00a1\u00e6\u00ba\u00f8\u00c9 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c3\u00e5\u00c7 \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0;\n\n(ix) \u00c7\u00ba\u00eb\u00a8\u00eb\u00c7\u00e6\u00cc \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0 \u00a1\u00be\u00e0\u00ba\u00da \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a8\u0095\u00b4\u00ea\u00ef\u008c ;\n\n(x) \u00a1\u00e6\u00ef\u00c4\u00d6\u00a8\u00e5 \u00a6\u00a8\u00e0\u00cc\u00ba\u00e0 \u00b0\u00be\u00c0\u00bc\u00ef\u00c6\u00e0 \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8\u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c ;\n\n(xi) \u00b0\u00c0\u00e5\u00be\u00ef\u00c6\u00e0 \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00cc\u00cd\u00ef\u00c6\u00e5\u00e0\u00aa\u00fa\u00ba\u00e5 \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 ;\n\n(xii) \u00ef\u00c8\u00e5\u00e0\u00a8 \u00cc\u00e2\u00c7\u00a8\u00e0\u00cb\u00b8 \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0 ;\n\n(xiii) \u00ef\u00c0\u00e5\u00f3 \u00c7\u00e5\u00b0\u00f1 \u00c4\u00b8\u00e0\u00b6\u00c8\u00e9\u00c6 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c ;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba9\n\n(xiv) 1982 \u00a1\u00e2\u00a8 17 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba\u00a2\u00be\u00e0\u00f3 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00bc\u00be\u00ef\u008a ;\n\n(xv) \u00c6\u00ea\u00ef\u00c7\u00e5\u00e0\u00c0\u00e9\u00c6 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c ;\n\n(xvi) 1988 \u00ef\u00be\u00e5\u00c9\u00e6\u008a\u00c2\u00da \u00c4\u00cc 2 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00b6\u00be\u00e0\u00c4\u00e5\u00da\u00a8,\u00c0\u00e8\u00be\u00e0\u00c8\u00be\u00e0\u00ba, \u00a1\u00c6\u00fa\u00cc\u00e0\u00c8\u00be\u00e0\u00ba, \u00ef\u00be\u00e5\u00e0\u00da\u00ef\u008c \u00cc\u00cd \u00cc\u00e0\u0097\u009c\u00be\u00e0 \u00c7\u00e5\u00b0\u00f1\u00c6\u00be\u00e0\u00a1\u00ba\u00c7 \u00a6\u00ce\u00c5\u00ea\u00b8\u00ea \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00b4 \u00a1\u00be\u00ea\u00c9 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00be\u00e5\u00e0\u00da\u0091\u00a8\u00e0\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0,\n\n(xvii) \u00bc \u00ef\u00be\u00e5\u0091\u00a8\u00e0 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c ;\n\n\u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 ;\n\n(\u00a1\u00e5)(i) (276 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00be\u00f9\u00ba\u00f8 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00cc\u00c3\u00e5\u00c9 \u00c0\u00be\u00ba\u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00be\u00f9\u00ba\u00f8 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00cc\u00c3\u00e5\u00ef\u008c;\n\n(ii) 1959 \u00a1\u00e2\u00a8 23 \u00bc\u00c7\u00be \u00c9\u00c7\u00c8\u00ba\u00e0 \u00aa\u00b8\u00a8\u00e5\u0093\u00a8\u00e5\u00d7\u00be\u00e0\u00ef\u00aa\u00e0 \u00c0\u00be\u00ba\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c9\u00c7\u00c8\u00ba\u00e0\u00aa\u00b8\u00a8\u00e5\u0093\u00a8\u00e5\u00d7\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0;\n\n(iii) \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1975 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00ba\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00ba\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0;\n\n(iv) 1970 \u00a1\u00e2\u00a8 17 \u00bc\u00c7\u00be \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c0\u00ea\u00cc\u00e0\u00ba\u00a8\u00e5\u00c8 \u00ef\u00cc\u00e0\u00c9\u00e5\u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c8\u00e2\u00a8\u00e5 \u00c0\u00ea\u00cc\u00e0\u00ba\u00a8\u00e5\u00c8\u00ef\u00cc\u00e0\u00c9\u00e5 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0;\n\n(v) 1978 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u0097\u00ca\u00e0\u00c9\u0097\u00bc\u00f1\u00e5\u00c8 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00bc\u00e6\u00c6\u00fa \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00c2\u00be \u00c6\u008a \u0097\u00ca\u00e0\u00c9\u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u00a8;\n\n(vi) 1971 \u00a1\u00e2\u00a8 46 \u00bc\u00c7\u00be \u00ef\u00c0\u00e5\u00c8\u00e0 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00c0\u00e5\u00c8\u00e0 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0, \u00ef\u00c0\u00e5\u00c8\u00e0 \u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00cd \u00ef\u00c0\u00e5\u00c8\u00e0\u00c9\u00aa\u00e5\u00a8\u00f8\u00d7\u00ef\u008a \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 ;\n\n(vii) (431 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c7\u00b0\u00ef\u00c6\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00c9\u00e6\u00be\u00e0\u00bc\u00c5\u00ea \u00cc\u00cd \u00a1\u00be\u00ba\u00e0\u00bc\u00c7\u00e6 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4\u00c6\u00a8;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba10\n\n(viii) \u00c0\u00c8\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00ef\u00cc\u00e0\u00c9\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a\u00c9\u00e6\u00be\u00e0\u00bc\u00c5\u00ea \u00cc\u00cd \u00a1\u00be\u00ba\u00e0\u00bc\u00c7\u00e6 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4\u00c6\u00a8 ;"
