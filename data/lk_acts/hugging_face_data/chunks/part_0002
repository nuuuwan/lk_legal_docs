    "chunk_text": "\u201c\u00ba\u00bd\u00c6\u00bd\u00c1\u00bc\u00c8\u0081 \u00b9\u008b\u00af\u00c6\u00d0\u00b4\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6 \u00b6\u0081\u00ce\u00ba\u00ce\u00bb\u00b9\u00c6 \u00b9\u00bb\u0081\u00d8\u00af\u00bc\u00c6\u00b6\u00be\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6\u00cd\u00c1\u00cc\u00bd\u00c7\u00dd\u00c1\u00ce\u00bc \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00c1\u00de \u00a4\u00bf\u00c8\u0081\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc\" \u00af\u00be\u00c7\u00b1\u00c6\u00b1\u00c7\u00bc \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de\u00e9\u00c0\u00c6\u00b7\u00c8\u00ce\u00be\u00af\u00ce\u00bf\u00b1\u00c6 \u00b1\u00c7\u00b6\u00af\u00ba\u00c7\u00af\u00c6\u00af\u00c8\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b1\u00bb\u00df\u00af\u00c6\u00d0\u00a3\u0088\u00b9\u00b5\u00c8\u00dc\u00ba\u00c7\u00de \u00b7\u00c8\u00bc\u00c6\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u00b6\u00c6\u00b6\u00be\u00c6 \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6\u00b0\n\n360\u00a6' \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00ce\u00bf \u00ba\u00af\u00cd\u00c1\u00bd\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00af\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cc\u00af\u00b8 \u2013\n\n(i) \u0089\u00bf\u00c6\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00de \u00a3\u00b6\u0081 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c8\u0081\u00a3\u00be\u00c6\u00be\u00d7 \u00b1\u00b4\u00c6\u00b4\u00b9[\u00bc\u00c6\u00c1\u00ba\u00c7\u00b8 \u00b9\u00c7\u00d7\u00af\u00c7\u00c1\u00be\u00bc\u00c8\u0081\u00b1\u00ba\u00c6\u00ba\u00b6\u00ba\u00c8\u0081\u00bd\u00c8 \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00cc\u00b4\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00b9\u00c6\u0089\u00bc\u00bb\u00c7\u00b5\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00d7\u00ce\u00b5\u00da\u00bc\u00c8\u00af\u00c8\u0081\u00bd ;\n\n(ii) \u00af\u00bc\u00c6\u00b9\u00c6\u00b9\u00ba\u00c6 \u00b6\u00bc\u00c8\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00cc\u00b9\u00ae \u00ac\u00dd\u00c1\u00bc\u00c8\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b9\u00ae\u00b5\u00c8\u0081 \u00a5\u0081\u00b8\u00db\u00ba\u00c6 \u0089\u00bd\u00af\u00c6\u00af\u00c7\u00b6 \u0089\u00bf\u00c6\u00ce\u00bf\u00ce\u00bb \u00b9\u00b5\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af\u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u0089\u00bc\u00b6\u00c8\u00b9\u00bb\u00d9\u00af\u00c6\u00af\u00c7\u00af\u00ba\u00af\u00cd\u00c1\u00bd\u00c6\u00da \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af \u00a3\u00c1\u00bc\u00d7\u00b1\u00ba\u00c6\u00ba\u00b6\u00b6\u00c6\u00ce\u00b6 \u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u008a\u00d9\u00b3\u00c6\u00b1\u00bc\u00c8 \u00c1\u00c7\u00bb\u00c6\u00f2\u00be\u00ba\u00c7\u008a\u00d9\u00b3\u00c6\u00b1\u00bc\u00c8 \u00cc\u00b9\u00de\u00af\u00c8\u0081\u00bd ;\n\n(iii) \u00d0\u00c0\u00b7\u00c6\u00ce\u00b6\u00af\u00bf\u00c6 \u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00ac\u00dd\u00cc\u00b9\u00ae\u00ce\u00b5 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00ae\" \u00cc\u00b9\u00ae \u00cd\u00b1\u00c7\u0088\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00a3\u00ba\u00bc\u00c6\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd ;\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6360\u00a6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6360\u00a7 \u00a9\u0081\u00d9\u00ba\u00c6\u00da\u00b6\u00c8\u00bb \u0089\u00bc\u00c8\u00e2\u00af\u00ce\u00bf\u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\u201c\u00ba\u00af\u00cd\u00c1\u00bd\u00c6\u00da\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c7\u00b8\u00b6\u00c1\u00de\u00af\u00bf\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c612\n\n(iv) \u0089\u00bd\u00b9\u00c6\u00da\u00af\u00bf\u00c6 \u00b9\u00b6\u00c8\u00e2\u00b4\u0081 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b9\u00b4\u00c6\u00b4 \u00a4\u00bf\u00c6\u00ac\u00dd\u00c1\u00bc\u00c7\u00af \u00a5\u00dd\u00b7\u00c6\u00d7\u00cc\u00af\u00c7\u00ae\u00d5 \u0089\u00bd\u00b9\u00c6\u00da\u00af\u00ce\u00bf\u00b9\u00c6\u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a5\u00b4\u00c7\u00b9\u00c6\u00ce\u00b9 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00a5\u00b4\u00c7\u00b9\u00c6\u0089\u00be\u00c6 \u00a3\u00b4+\u00c6\u00af\u00c8\u00dc\u00bf\u00c6\u00bf \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u0089\u00bd\u00b9\u00c6\u00da\u00b9\u00c6 \u00b9\u00b6\u00c8\u00ce\u00c1 \u00cc\u00b6\u00bc\u00c8\u00b7\u00c6\u00d7\u00cc\u00af\u00c7\u00ae\u00cd\u00b4 \u00cc\u00b9\u00c7\u00bb\u00c6\u00b9\u00c6\u00da\u00ce\u00b8\u00b6\u00ce\u00be \u00a3\u00d9\u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00c8\u0081\u00bd ;\n\n(v) \u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u0089\u00bc\u00b6\u00c8\u00b9\u00bb\u00d9\u00af\u00c6\u00af\u00c7\u00af \u00a4\u00d2\u00b9\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00bc\u00c8\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\"\u00cc\u00b9\u00ae\u00af\u00bf\u00c6 \u00da\u00af\u008b\u00b4+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\" \u00b1\u00c8\u00af\u00c8\u00b1\u00c6\u00ce\u00b1\u00b7\u00c8\u00ce\u00be\u00bb+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\" \u00c1\u00bf\u00bc\u00c6\u00b9\u00c6\u00da \u00b7\u00c8\u00ce\u00be\u00bb+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\" \u00b9\u00af\u00bd\u00c6\u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00da \u00b7\u00c8\u00ce\u00be\u00bb+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u0089\u00bf\u00c6\u00ce\u00bf\u00b9\u00c6\u00b9\u00bc\u00c7\u00ba\u00bc\u00c8\u00b9\u00c6\u00da \u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00be\u00ba\u00c6 \u00cd\u00b9\u00b5\u00be\u00c6 \u00b7\u00c8\u00ce\u00be \u00bb+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00ce\u00bf\u00b9\u00c6 \u00cc\u00b9\u00de\u00c1\u00b6\u00c8\u00be\u00c6 \u00a6\u00d5\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00c7\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00ce\u00bf \u00ba\u00c8\u00bc\u00b4\u00c6\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00c8\u00ce\u00be\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00ba\u00af\u00cd\u00c1\u00bd\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00af \u0089\u00bf\u00c6\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00cc\u00b9\u00de\u00af\u00c8\u0081\u00bd ;\u00a3\u00be\u00c6\u00be\u00d7\n\n(vi) \u00b6\u00c7\u00ce\u00bb \u00a4\u00bf\u00c6\u00ba\u00c7\u00bd\u00c7\u00b4\u00c6\u00b4\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c6\u00ba\u00c7\u00bd\u00c7\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00a7\u00b6\u008c \u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd\"\n\n\u00a9\u00c1\u00dd\u00ba\u00c6 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c6\u00bd\u00c1\u00c7\u00bf\u00c8\u00bb\u00c7\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081\" \u00d0\u00bd\u00c6\u00bd\u00b6\u00c6 \u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u0081 \u00cd\u00ba\u00be\u00c6 \u00a5\u00dd\u00b9\u00d7 \u00a4\u00ae\u00d5\u00af\u00ce\u00bf \u008c\u00b3\u00c6\u00b1\u00c7\u00b6 \u00cc\u00c1\u00c7\u00dd\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0 \u00a5\u00dd\u00c1\u00ce\u00af\u008a\u00cc\u00be\u00c7\u00dd\u00c1\u00ce\u00af \u00ba\u00bd\u00c8\u00bb\u00bd\u00c6\u00bd\u00ae\u00b4\u00ce\u00b8\u00bb\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00ba\u00bd\u00c8\u00bb\u00bd\u00c6\u00bd\u00ae\u00b4\u00ce\u00b8\" \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6 \u00a4\u00af\u00c8\u00bb \u00a5\u00bc\u00ae\u00b4\u00c7\u00df\u00ba\u00c6 \u00b6\u00ae\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c613\n\n(2) \u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u201c\u0089\u00bf\u00c6\u00ce\u00bf\u201d \u00a9\u0081\u00b9\u00d7\" \u00b9\u00b6\u00c8\u00cc\u00b8\u00b4\u00c6\u00d5\u00c1\u00bb\u00d7\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00c1\u00c7\u00b8 \u00ad\u00bc\u00c6 \u00a4\u00bf\u00c6 \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6\u00b0\n\n360\u00a7\u00b0 (1) \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0\u00bf\u00c6 \u00a4\u008a\u00d9\u00b3\u00c6\u00b1\u00bc\u00c8\" \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0 \u00cc\u00c1\u00bf\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00b6\u00c7\u008a\u00d9\u00b3\u00c6\u00b1\u00bc\u00c8 \u00a9\u00b6\u00c6\u00b6\u0081\u00ce\u00ba\u00bb\u00d7\u00ba\u00c7\u00b8 \u00c1\u00c0\u00c8\u00db\u00ce\u00bd\u008a\u00b8\u00c7\u00be\u00c6 \u2013"
