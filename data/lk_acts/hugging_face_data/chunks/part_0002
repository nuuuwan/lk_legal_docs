    "chunk_text": "178.\u00ba\u00cd\u00be\u008a \u00ef\u00a8\u00e5\u00b4 \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0 \u00c2\u00bc\u00e0\u00bc \u00a1\u00c6 \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4.251\n\n179.\u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c4\u00ef\u00cd\u00e0\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u00a2\u00bc\u00fa\u00d6\u00ef\u00c6\u00e0 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00ef\u00c9\u00be\u00be\u00f9\u00ba\u00f8 \u00a8\u00ee\u00ba\u00f1253\n\n180.\u00b8\u00c6 \u00a1\u00e5\u00bc\u00fa\u00ef\u00c6\u00be\u00e0 \u00c2\u00bc\u00e0\u00bc \u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4255\n\n181.\u00c2\u00bc\u00e0\u00bc \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00ef\u00aa\u00d1\u00c4 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9\u00b4 \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce \u00c0\u00e6\u00c9\u00d7\u00c4258\n\n183.\u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00ef\u00aa\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c2\u00bc\u00e0\u00bc \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0\u00c9\u00ba\u00e0\u00a8\u008a \u00c9\u00c8\u00e8\u00be\u00e0 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.261\n\n184.\u00bc\u00c7\u00e6\u00c9\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u00c4\u00be\u00e0 \u00c2\u00f3 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4261\n\n185.\u00a1\u00da\u00bb\u00c8\u00e5\u00c3\u00fa\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00ef\u00aa\u00be\u00e0 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4261\n\n186.\u00a1\u00da\u00bb\u00c8\u00e5\u00c3\u00fa\u00ef\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00ef\u00c0\u00e5\u00c8\u00e0\u00c4\u00e3\u00a8\u00c7\u00e6\u00ef\u00aa\u00be\u00e0 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4.261\n\n187.\u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8 \u00bc \u00ba\u00f1\u00e5\u00aa \u00c2\u00bc\u00e0\u00bc \u00ba\u00f1\u00e5\u00aa \u00c8\u00e5\u00c3\u00fa\u00c6\u00e5\u00ef\u00aa\u00be\u00e0 \u00a1\u00c6 \u00a8\u00c7\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.262\n\n188.\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00c6\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4.262\n\n189.\u00c2\u00f3\u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c4\u00e5\u00da\u00aa\u00c9\u00c8\u00e8\u00be\u00e0 \u00a6\u00a8\u00a8\u00b4 \u00c9\u00e6\u0091 \u00aa\u00b8\u00be\u00a8\u00e0\u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4.263\n\n190.\u00c2\u00f3\u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00cc\u00ba\u00eb \u00c2\u00c8\u00c6.263\n\n191.\u00a1\u00e7\u00c9\u00c7 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c9\u00aa\u00a8\u00f9\u00c4.263\n\n192.\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c2\u00c8\u00ba\u00c8 \u00cd\u00e5 \u00a8\u00da\u00ba\u00c9\u00f1 \u00c0\u00e6\u00c9\u00d7\u00c4.264\n\n193.\u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00be\u00ea\u00aa\u00ba \u00a8\u00c7\u00e6\u00be\u00ea\u00c9\u00c8\u00bc\u00fb \u00c9\u00cc\u00c7 \u00c0\u00cd\u00a8\u00e0 \u00a2\u00a8\u00eb\u00ba\u00e0\u00d1\u00ef\u00c4\u00be\u00e0\u00c0\u00cc\u00ea\u00c9 \u00be\u00b6\u00ea \u00c0\u00c9\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.264\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\nxvii\n\nXXVII \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u0097\u0097\u00bd \u00a8\u00c7\u00e6\u00b8\u00ea\n\n194.\u00a1\u00ba\u00e0\u00cc\u00be \u00cd\u00e5 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4 \u00c3\u00e5\u00c7 \u00bc\u00fb\u00c4.264\n\n195.\u00bc\u00e6\u00be\u00e0\u00d1\u00c4, \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00f8\u00d7\u008a \u00a1\u00e5\u00bc\u00fa\u00ef\u00c6\u00cd\u00fa \u00c9\u00c8\u00e2\u00aa\u00eb\u00ba\u00e5\u00c9\u00c6.265\n\n196.\u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c0\u00f2\u00c4\u00ea\u00a9 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00a8\u00c7\u00e6 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00c8 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.266\n\n197.\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00f2\u00bd\u00e5\u00be \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5\u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00c8 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.266\n\n198.\u00ef\u00c2\u00c8\u00cd\u00fb\u00be \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00a8\u00c9\u00c7\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8\u00bc \u00c6\u00be \u00c2\u00c9.267\n\n199.\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4.267\n\nXXVIII \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u00d1\u00c4\n\n200.\u00c9\u00e6\u0091\u00c0\u00ea\u00c7 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c2\u00bc\u00e0\u00bc \u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.268\n\n201.\u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00bc\u00fb \u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u00c9\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00ef\u00c0\u00e5\u00c8\u00e8\u00c6.271\n\nXXIX \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00c9\u00e6\u00c7\u00bc\u00fa \u00cc\u00cd \u00bc\u00b8\u00e0\u00b6\u00be\n\n202.\u00c9\u00e5\u00da\u00ba\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d7\u00c4, \u00cc\u00e5\u00c9\u00bc\u00f1 \u00c9\u00e5\u00da\u00ba\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00a1\u00e5\u00bc\u00fa\u00c6\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc\u00b9\u00ea\u00c9\u008a.271\n\n203.\u00c7\u00cd\u00cc\u00f1\u00ba\u00e5\u00c9\u00c6 \u00a8\u00b6\u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a8\u00e5\u00c7\u00b8\u00e5 \u00c9\u00e6\u00c7\u00bc\u00fa \u00c9\u00be \u00c2\u00c9.275\n\n204.\u00c9\u00e2\u00ae\u00e5\u00c9 \u00a1\u00e5\u00bc\u00fa\u00c6 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc\u00b8\u00e0\u00b6\u00be \u0097\u0093\u0097\u00bd\u00e5\u00be.275\n\n205.\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c6\u008a \u00be\u00b6\u00ea \u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00ba\u00a8\u00e5 \u00c2\u00f3 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.277\n\n206.\u00be\u00b6\u00ea \u00c0\u00e6\u00c9\u00d7\u008a \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00be\u00ea\u00c4\u00e6\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.277\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\nxviii\n\n207.\u00c0\u00f2\u00a8\u00e5\u00ca \u00cc\u00cd \u00ef\u00c8\u00e0\u00a9\u00be \u00cc\u00e5\u00a8\u00e0\u00cb\u00f1\u00ef\u00c6\u00e0\u00bc\u00fb \u00a1\u00e5\u00ef\u008c\u00ca\u00f1 \u00a8\u00f8\u00d7\u00c4.278\n\nXXX \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00c6\n\n208.\u00be\u00f8\u00c8\u00bd\u00c7\u00ef\u00c6\u00e5\u00e0.278\n\n209.\u00be\u00f8\u00c8 \u00c7\u00cd\u00cc\u00f1\u00ba\u00e5\u00c9\u00c6.279\n\n210.\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00bc\u00fa\u00d6\u00aa\u00e6\u00be\u00e0\u00d1\u00ef\u008a \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8.286"
