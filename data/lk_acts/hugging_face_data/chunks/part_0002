    "chunk_text": "(\u00ae)1985 \u00a1\u00e2\u00a8 21 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u0097\u00ef\u00bc\u00e0\u00ca \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00c6 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u0097\u00ef\u00bc\u00e0\u00ca \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8 \u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00e5\u00c4\u00b4\u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00ef\u00cd\u00e5\u00e0\u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00b4 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6 \u00c8\u00c2\u00e5\u00ef\u00bc\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c8\u00cc\u00e5 \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00ca\u00f2\u00e9 \u00c8\u00e5\u00e2\u00a8\u00e8\u00a8\u00c6\u00a8\u00eb \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00c0\u00e5\u00c7\u00c6\u00a8\u00b4 \u00a6\u00a8\u00f9 \u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ba\u00eb\u00be\u00e0\u00bc\u00cd\u00cc\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc ;\n\n(\u00b4)\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa \u00c8\u00c8\u00e8\u00ba \u00a8\u00c8\u00e5, \u00cc\u00e5\u00cd\u00fa\u00ba\u00f1 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00f2\u00e9\u00b6\u00e5\u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00c8\u00c2\u00e5\u00aa\u00ba\u00e0 \u00c8\u00e8\u008d\u00ba\u00a1\u00be\u00ea\u00c4\u00ba\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9 \u00a8\u00c7\u00be \u00c8\u00bc \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00e0 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec, \u00c8\u00c8\u00e8\u00ba\u00a8\u00c8\u00e5, \u00cc\u00e5\u00cd\u00fa\u00ba\u00f1 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00f2\u00e9\u00b6\u00e5 \u00a8\u00e0\u00ef\u00cb\u00e0\u00ba\u00f2\u00ef\u00c6\u00cd\u00fa \u00ba\u00c4 \u0097\u00ca\u00fa\u00cb\u00e0\u00b5\u00ba\u00e0\u00c9\u00c6\u00c0\u00e8\u00ce\u00e8\u00aa\u00e6\u00be\u00f9\u00ef\u00c4\u00cd\u00fa \u00c8\u00e5 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c6\u008a\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c3\u00e5\u00c7\u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00c8\u00a8\u00e0\u00cb\u00c6\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8 \u00a6\u00a8\u00ba\u00eb\u00c9\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc ;\n\n(\u00b6)\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00cc\u00cd \u00c3\u00e5\u00c7 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 114\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u201c\u00cc\u00ea\u00f3 \u00ef\u00be\u00dd\u008a\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u201d \u0097\u00cc\u00e8\u00be\u00e0 \u00c6\u008a \u00c9\u00e5\u00b8\u00e8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8\u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00c4\u00ba \u00cc\u00ea\u00f3 \u00ef\u00be\u00dd\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00b4 \u00a4\u00c0\u008e\u00ba \u00c9\u00be \u00c6\u008a\u00ef\u00c0\u00e5\u00c8\u00e8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9 \u00b4\u00c4\u00a8\u00e0 ;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba36\n\n(\u00b8)\u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2, \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00cc\u00cd\u0097\u00be\u00f8\u00c4\u00c6 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c9\u00cc\u00e0\u00ba\u00eb \u0097\u00be\u00f8\u00c4\u00c6 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00ce\u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00be\u00f8\u00c8\u00c8\u00e6\u00c6\u00fa\u00cc\u00e0\u00ba\u00eb\u00c9\u00a8 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00cc\u00e8\u00f3\u00a8\u00c7\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00be\u00e0 \u00c9\u00be \u0097\u00b4\u00c8\u00e6\u00c6\u00fa\u00cc\u00e0\u00ba\u00eb\u00aa\u00ba \u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc, \u00c6\u008a \u00c2\u00e6\u00df\u008a\u00a8\u00c7\u00c6\u00a8\u00e0,\u00b8\u00c6\u00a8\u00c7\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00b8\u00c6 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00a6\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0 \u00a7\u00cd\u00ea\u00b4 \u00a4\u00bc\u00e0\u00aa\u00ba \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec\u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u008e\u00ba \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec 3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c6\u008a \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u008a ;\n\n(\u00ba)\u00c6\u008a \u00a6\u00e0\u00a8\u00a8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0, \u00a1\u00ef\u00be\u00f1\u00be\u00f1 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4\u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00b4, 2005 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e07 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c2\u00bc\u00e0\u00bc \u00a1\u00c6\u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8, \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0, \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6\u00a8\u00e0,\u00c0\u00f2\u00cc\u00e5\u00bc \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00a1\u0093\u00a8\u00e5\u00c7 \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0,\u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u008e\u00ba \u00c9\u00be \u00c6\u008a \u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00bc\u00c6\u00c4 ;"
