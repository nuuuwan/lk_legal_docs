    "chunk_text": "(\u00ba)\u00c6\u008a \u00a6\u00e0\u00a8\u00a8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0, \u00a1\u00ef\u00be\u00f1\u00be\u00f1 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4\u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00b4, 2005 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e07 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c2\u00bc\u00e0\u00bc \u00a1\u00c6\u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8, \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0, \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6\u00a8\u00e0,\u00c0\u00f2\u00cc\u00e5\u00bc \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00a1\u0093\u00a8\u00e5\u00c7 \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0,\u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u008e\u00ba \u00c9\u00be \u00c6\u008a \u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00bc\u00c6\u00c4 ;\n\n(\u00be)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9 \u00ba\u00eb\u00ce \u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00c8\u00bc \u00cc\u00cd \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba\u00f8\u00be\u00e0\u00c0\u00e6\u0095\u00b8\u00e8 \u00ba\u00c7\u00aa\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa \u00c9\u00be \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00a8\u00f2\u00e9\u00b6\u00e5\u00c9\u00a8\u00b4\u00ef\u00cd\u00e5\u00e0 \u00c4\u00c8\u00c8 \u00a8\u00f2\u00e9\u00b6\u00e5 \u00a2\u00cc\u008c\u00c9\u00a8\u00b4 \u00ba\u00c7\u00aa\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb, \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u0097\u00bd\u00e5\u00c6\u00a8\u00c6\u00a8\u00eb \u00ef\u00c8\u00cc \u00cc\u00cd\u00c3\u00e5\u00aa\u00fb \u00d1\u00ef\u00c4\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00c8\u00e5\u00c3\u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u2014\n\n\u00ef\u008a \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 :\u2014\n\n(i)\u201c\u00cc\u00e2\u0097\u00bd\u00e5\u00c6\u00a8\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00c7\u00b4\u00a8 \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00a8\u00f2\u00e9\u00b6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00c8\u00c8 \u00a8\u00f2\u00e9\u00b6\u00e5 \u00a2\u00cc\u008c\u00c9\u00a8\u00e0\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba37\n\n\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00e5\u00c8\u00be \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7\u00be \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00c6\u008a \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00a6\u00a8\u00ad\u00ba\u00e0\u00c9\u00c6 \u00c8\u00e6\u009f\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00a6\u00a8\u00ad\u00ba\u00e0\u00c9\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9\u00be\u008a \u00a8\u00c7\u00be \u00c8\u00bc \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00e0\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb\u00ef\u00aa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00c9\u00e6\u0091 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00fa\u00be\u00e0\u00aa\u00be\u00be\u00a8\u00ef\u00aa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00e0 \u00a8\u00b8\u00e0\u00b6\u00e5\u00c6\u00c4\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4\u00c9\u00e6\u0091 \u00a8\u00b8\u00e0\u00b6\u00e5\u00c6\u008a \u00aa\u00be\u00be\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00a2\u00cc\u008c\u00c9\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7\u00be \u00c7\u00ef \u00ba\u00ba\u00e0\u00a8\u00e5\u00c8\u00ef\u00c6\u00e0 \u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00be\u00e5\u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00c6\u008a\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0, \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00e0, \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00e0\u00ef\u00be\u00e5\u00c9\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u00c9\u00be \u00a1\u00ba\u00c7 \u00c6\u008a\u00a2\u00cc\u008c\u00c9\u00a8\u00e0 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00c7\u00be \u00d7\u00ba\u00f8 \u00cc\u00e5\u00bc\u00be\u00c6\u008a \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0 \u00bc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ; \u00cc\u00cd\n\n(ii)\u201c\u00ba\u00c7\u00ad\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00a8\u00f2\u00e9\u00b6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00c8\u00c8\u00a8\u00f2\u00e9\u00b6\u00e5 \u00a2\u00cc\u008c\u00c9\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9, \u00c6\u008a \u00a2\u00cc\u008c\u00c9\u00a8\u00b4 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fb\u00c9\u00be \u00c6\u008a \u00a8\u00b8\u00e0\u00b6\u00e5\u00c6\u00c4\u00a8\u00e0 \u00cc\u00cd \u00ba\u00be\u00f8 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00ef\u00c6\u00a8\u00eb \u00ef\u00c8\u00cc\u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00a8\u00b8\u00e0\u00b6\u00e5\u00c6\u008a \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00ef\u00c8\u00cc \u00a8\u00f8\u00cc\u00e8\u00c6\u008a\u00a2\u00cc\u008c\u00c9\u00a8\u00b4 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00c6\u008a \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n(\u00c0)\u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00ba\u00eb\u00c8 \u00bc\u00fb \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00cd\u00e6\u00b4\u00b4 \u00a6\u00ce\u00ef\u00c5\u00be\u00ef\u00cd\u00e5\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8 \u00bc\u00fb \u00c9\u00c6\u00cc \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00cd\u00e6\u00b4\u00b4\u00a6\u00ce\u00c5 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb\u00b4, \u00c6\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 2000\u00a1\u00e2\u00a8 43 \u00bc\u00c7\u00be \u00c7\u00a8\u00e0\u00cb\u00b8 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00c6 \u0097\u0093\u00c4\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00c7\u00a8\u00e0\u00cb\u00b8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00f8\u00be\u00e0\u0095\u00c8\u00bc\u00fb \u00aa\u00ba\u00e0 \u00cc\u00cd \u00d5\u0097\u00ba \u00a8\u00e5\u00c8\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00bc\u00cd\u00c6\u00b4 \u00a1\u00b6\u00ea\u00ef\u00be\u00e5\u00c9\u00be \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00bc, \u00a6\u00c4 \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c6 \u0095\u00c8\u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00ef\u008a\u00bc\u00fb \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00c4\u00ea\u00bc\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00c8 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00c0\u00f2\u00ba\u00f8\u00ca\u00e0\u00b5\u00e5\u00c9\u00cc\u00bf\u00cd\u00e5 \u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u00d1\u00c4\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a4\u00c0\u008e\u00ba \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00c6\u008a\u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c6\u00a8\u00e0 ;\n\n(\u00c2)\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00b4 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00b8\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00b4 \u00c8\u00e6\u00ef\u00c2\u00be \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6, \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be\u00c8\u00bc \u00c4\u00ea\u00dd \u00c4\u00ea\u00bc\u00c8 -\n\n(i)\u00a6\u00c4 \u00cc\u00c4\u00e5\u00aa\u00c4 20 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2)\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6) \u00c9\u00be \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00b4 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u0097\u00b4 \u00bc\u00fb ; \u00ef\u00cd\u00e5\u00e0"
