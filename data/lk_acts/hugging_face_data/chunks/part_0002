    "chunk_text": "(\u00a1)\u00a6\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4, \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0\u00a1\u009e\u00a8\u00e0\u00cb\u00a8\u00c9\u00c7\u00c6\u00a8\u00eb \u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 ; \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\n\n\u00ef\u00cd\u00ce\u00e8\u00bc\u00c7\u008c \u00a8\u00f8\u00d7\u00c4\u00ef\u00be\u00e5\u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n\u00cc\u00e6\u00a8 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c9\u00e5\u00da\u00ba\u00e5\u00a8\u00c7\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4.\n\n112006 \u00a1\u00e2\u00a8 6 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c9\u00e5\u00da\u00ba\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba\n\n\u00cc\u00e8\u0097\u00c8\u00e0 \u00a1\u00c0\u00c7\u00e5\u00bd \u00ef\u00cd\u00e5\u00e0 \u0097\u00be\u00c6\u00e5\u00be\u00ea\u00a8\u00ed\u00c8 \u00be\u00f9\u00ba\u00f8 \u00a8\u00ee\u00ba\u00f1 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00ef\u00be\u00e5\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 8 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u0097\u00cc\u00e0\u00ba\u00c7 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00c7\u00bc\u00a8\u00e0\u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00be\u00f9\u00ba\u00f8 \u00a8\u00ee\u00ba\u00f1 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0, \u0097\u00aa\u00b8\u00a8 \u00c9\u00f1\u00e5\u00c0\u00e5\u00d6\u00a8 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u009e\u00a8\u00e0\u00cb\u00b8\u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00a8\u00e0 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00c6\u008a \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8, \u00c9\u00f1\u00e5\u00c0\u00e5\u00d6\u00a8 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0\u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00a8 \u00c6\u008a \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00ef\u00c6\u00a8\u00e0, \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00a8\u00c7\u00e6\u00ef\u00c9\u00a8\u00e0, \u00be\u00f8\u00c8\u00bd\u00c7\u00ef\u00c6\u00a8\u00e0,\u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00ef\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00ef\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0, \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a8\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a, \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00ca\u00eb\u00bc\u00e0\u0093\u00a8\u00c7\u00b8 \u00c9\u00c7\u00bc\u00b4 \u00be\u00b6\u00ea\u00c0\u00e6\u00c9\u00d7\u00ef\u008a \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00c6\u008a \u0097\u00ef\u00b4\u00a8 \u00bc\u00fb \u00a6\u00e0 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00cc\u00be\u00e0\u00ba\u00a8\u00ef\u00c6\u00e0 \u00ef\u00be\u00e5\u00ba\u00f8\u00c2\u00ec\u00ef\u00c8\u00cc\u00b4 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n13.(1) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 4 \u00c9\u00be, 5 \u00c9\u00be, 6 \u00c9\u00be, 7 \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 8 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00c6\u008a \u00c9\u00c7\u00c0\u00f2\u00cc\u00e5\u00bc\u00c8\u00ba\u00e0 \u00bc\u00e6\u00be\u00ea\u008a\u00bc\u00fb\u00c4\u00a8\u00e0 \u00ef\u00cd\u00ce\u00e8\u00bc\u00c7\u008c\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u0093 \u00be\u00f9\u00ba\u00f8\u00b3\u00c9\u00c7\u00c6\u00a8\u00eb\u00b4 \u00be\u00f8\u00c6\u00c4 \u00ef\u00a8\u00ef\u00c7\u00be \u00c0\u00d6\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00ef\u00ba\u00e0\u00c7\u00e6\u008a\u00ef\u00be\u00e5\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00bc\u00e6\u00be\u00ea\u008a\u00bc\u00fb\u00c4\u00a8\u00e0\u2014\n\n(\u00a1)(i)\u00a1\u0093 \u00be\u00f9\u00ba\u00f8\u00b3\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00be\u00f9\u00ba\u00f8 \u00a4\u00c0\u00ef\u00bc\u00e0\u00ca\u00a8\u00c6\u00a8\u00eb, \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00c6\u00ef\u00aa\u00e0 \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00be\u00e0 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0\u00c2\u00e6\u00d6\u00cc\u00e0\u00b4\u00da\u00c9\u00c7\u00c6\u00a8\u00eb, \u00ef\u00cc\u00e5\u00c8\u00e8\u00cc\u00e8\u00b4\u00da\u00c9\u00c7\u00c6\u00a8\u00eb, \u00be\u00f9\u00ba\u00f8\u00b3\u00c9\u00c7\u00c6\u00a8\u00eb,\u00ef\u00cd\u00e5\u00e0 \u00be\u00f9\u00ba\u00f8 \u00a4\u00c0\u00ef\u00bc\u00e0\u00ca\u00a8\u00c9\u00c7\u00c6\u00a8\u00eb \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 ;\n\n(ii)\u00a1\u0093 \u00be\u00f9\u00ba\u00f8\u00b3\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00be\u00e9\u00ba\u00f8 \u00a4\u00c0\u00ef\u00bc\u00e0\u00ca\u00a8\u00c6\u00a8\u00eb, \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0\u00a1\u00e6\u00c6\u00ef\u00aa\u00e0 \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00c6\u00ef\u00aa\u00e0\u00ef\u00cc\u00e0\u00c9\u00e5\u00bc\u00e5\u00c6\u00a8\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00a8\u00ce\u00e8\u00be\u00e0\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00c9\u00ea\u00be\u00e0 \u00a1\u00ba\u00d6\u00be\u00e0\u00ef\u00a8\u00be\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c9\u00e5\u008e\u00a8\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e8\u00c6\u0097\u00c8\u00e0\u00c8\u00a8\u00f8\u00be\u00e0 \u00ef\u00a8\u00ef\u00c7\u00be \u00c7\u00cd\u00cc\u00f1 \u00bc\u00e6\u00be\u00ea\u008a \u00bc\u00fb\u00c4\u00a8\u00e0 ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 \u00be\u00f9\u00ba\u00f8 \u00a4\u00c0\u00ef\u00bc\u00e0\u00ca \u00ef\u00cd\u00e5\u00e0 \u00cc\u00cd\u00e5\u00c6\u00c8\u00c2\u00e5\u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00bc\u00fb\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 ; \u00cc\u00cd\n\n\u00c9\u00c7\u00c0\u00f2\u00cc\u00e5\u00bc \u00c8\u00ba\u00e0 \u00bc\u00e6\u00be\u00ea\u008a\u00bc\u00fb\u00c4.\n\n122006 \u00a1\u00e2\u00a8 6 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c9\u00e5\u00da\u00ba\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba\n\n(\u00a1\u00e6)\u00ef\u00be\u00e5\u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00be\u00e5\u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 \u00be\u00f9\u00ba\u00f8 \u0097\u00ef\u00c7\u00e5\u00e0\u009e\u00ef\u00cd\u00e5\u00e0 \u00be\u00f9\u00ba\u00f1\u00be\u00ea\u00a8\u00ed\u00c8 \u00ef\u00be\u00e5\u00c9\u00be \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00a8\u