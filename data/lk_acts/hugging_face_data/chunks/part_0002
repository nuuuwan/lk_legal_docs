    "chunk_text": "(\u00a1\u00e5)25 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa (\u00a2) \u00cc\u00cd (\u00a4)\u00c6\u00be \u00ef\u00d8\u00bc\u00c9\u00c8 \u00cc\u00bf\u00cd\u00be\u00e0 \u0097\u00c6\u00bc\u008a \u00ef\u00be\u00e5\u00c9\u00be, \u00cc\u00e8\u00c6 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6\u00b4\u00a1\u00bc\u00e5\u00ce\u00c9 \u00bc\u00c7\u00be \u00c8\u00bc \u0097\u00c6\u00bc\u008a ;\n\n\u00c8\u00e5\u00c3 \u00cc\u00cd\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a\u00bc\u00fb \u00a2\u00b6 \u00ef\u00be\u00e5\u00bc\u00fa\u00c6\u00c6\u00ea\u00ba\u00eb \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u008a.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba68\n\n(i)\u00c6\u008a \u00c3\u00e5\u00b8\u00e0\u00b6\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00b6\u00ea\u00c9\u00a8 \u00a1\u00c0\u00be\u00c6\u00be \u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u00c4\u00be\u00e2\u00c9\u00e5\u00c8\u00e9\u00c4 ; \u00ef\u00cd\u00e5\u00e0\n\n(ii)\u0097\u00ef\u00bc\u00e0\u00ca \u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00ef\u00aa\u00d1\u008a \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a\u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00be\u00e0 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4,\n\n\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00aa\u00c4\u00be\u00e0 \u0094\u00c4\u00be\u00e0\u00c9\u00c8 \u00bc\u00fb \u00bc\u00c7\u00be\u00c8\u00bc \u0097\u00c6\u00bc\u008a \u00ef\u00be\u00e5\u00c9\u00be, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00aa\u00c4\u00be\u00e0 \u0094\u00c4\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5\u00bc\u00c7\u00be \u00c8\u00bc \u0097\u00c6\u00bc\u008a ;\n\n(\u00a1\u00e7)\u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00c6 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00e2\u00ae\u00e5\u00c7\u00a8\u00c4\u00b8\u00b6\u00c8\u00c6 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00ce \u00c9\u00e6\u00b6 \u00cc\u00b4\u00cd\u00be\u00a8\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a\u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00c4\u00b8\u00a8\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00aa\u00c4\u00be\u00e0 \u0094\u00c4\u00be\u00e0\u00cc\u00bf\u00cd\u00e5 \u00bc\u00c7\u00be \u00c8\u00bc \u0097\u00c6\u00bc\u008a \u00cd\u00e6\u00c7, \u00cc\u00e2\u00ae\u00e5\u00c7\u00a8\u00c6\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a\u00ef\u00cd\u00e5\u00e0\u00b4\u00c8\u00c6\u00a8\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8 \u00c6\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00aa\u00c4\u00be\u00e0 \u0094\u00c4\u00be\u00e0 \u00c6\u00e5\u00ef\u008a \u00bc\u00fb\u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u0097\u00c6\u00bc\u00c4\u00a8\u00e0 ;\n\n(\u00a2)\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00cd\u00e5\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be\u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00ef\u00c9\u00ce\u00bf\u00e5\u00c4\u00a8\u00b4, \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00b4, \u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00c7\u00be \u00c8\u00bc \u00cc\u00e2\u00aa\u00f2\u00cd\u0097\u00c6\u00bc\u008a ;\n\n(\u00a3)\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u0097\u00bd\u00e5\u00c6\u00a8 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5\u00b4 \u00ef\u00aa\u00c9\u00be\u00ea\u00c8\u00c2\u00be \u00cc\u00e2\u00aa\u00f2\u00cd \u00bc\u00fb\u00c4\u00be\u00e5\u00c9 ;\n\n(\u00a4)\u00a6\u00e0 \u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00be\u00f8\u00c0\u00bc\u00d1\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u0097\u00c6\u00bc\u008a \u00a8\u00c7\u00be\u00c8\u00bc \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u0097\u00c6\u00c0\u00e6\u00cd\u00e6\u00bc\u008a \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00d1\u00c4 ;\n\n(\u00a4\u00f0)\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00c7\u00be \u00c8\u00bc \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00ef\u00c6\u00e0 \u00c6\u008a\u0097\u00c6\u00bc\u00c4\u00a8\u00e0 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00be\u00e6\u00ba\u00f8\u00d1\u00c6\u00e5\u00c4\u00a8\u00e0 ;\n\n(\u00a6)\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a\u00c9\u00c8\u0097\u00c6\u00bc\u00c4 ;\n\n\u2014\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba69\n\n(\u00a6\u00e0)\u00c7\u00a8\u00e0\u00cb\u00b8 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00e5\u00be\u00f8 \u00c0\u00ec\u00da\u00b8 \u00c7\u00a8\u00e0\u00cb\u00b8 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e6\u00c2\u00ea\u00b8\u00ea\u00c4\u00ea\u00bc\u00c8 1979 \u00a1\u00e2\u00a8 28 \u00bc\u00c7\u00be \u00c0\u00be\u00ef\u00ba\u00e0 89 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00ef\u00cd\u00e5\u00e0 2000 \u00a1\u00e2\u00a8 38 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ef\u00ba\u00e0 95 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 100 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00a6\u00c4 \u00ef\u00c9\u00ce\u00bf\u00e5\u00ef\u00c4\u00be\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00be\u00e0, \u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5 \u00db\u00a8\u00f8\u00c6\u00e5\u00ef\u00c9\u00be\u00e0\u00c8\u00e6\u00c2\u00ea\u00b8 \u00c8\u00e6\u009f\u00c4\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00ef\u0089 \u00be\u008a \u00a6\u00c9\u00e6\u00be\u00f8\u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 ;\n\n(\u00a7)\u00a6\u00e0 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00be\u00f8\u00c0\u00bc\u00d1\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00bc\u00fa\u00e2\u008e\u00c6\u00b4\u00ef\u00be\u00e5\u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c0\u00d6\u00cd\u00c7\u00b8\u00c6 \u00ef\u00be\u00e5\u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00a8\u00eb\u00c8\u00e8\u00c6 \u00ef\u00cd\u00e5\u00e0\u0097\u00c6\u00bc\u00c4 ;\n\n(\u0081)\u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u2014"
