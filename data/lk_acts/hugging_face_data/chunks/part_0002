    "chunk_text": "1979 \u00a1\u00e2\u00a8 15 \u00bc\u00c7\u00be\u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be\u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 \u00c0\u00be\u00ef\u00ba\u00e0\u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u201c286\u00a1\u00e5\n\n2006 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea\u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba2\n\n(2) 349 \u00c9\u00be \u00cc\u00b4\u00cd\u00be\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00a1\u00e6\u00ba\u00f8 \u00ca\u00fb\u00da\u00cb\u00c6 \u00a2\u00c9\u00ba\u00e0\u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00ca\u00fb\u00da\u00cb\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n(3) 358 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce \u00cc\u00b4\u00cd\u00be\u00e0\u00c9\u00c8\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00c4 :\u2014\n\n358\u00a1 \u201c\u00b8\u00c6\u00c2\u00e6\u00df\u008a\u00a8\u00c7\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0\u00bc\u00e5\u00cc\u00c3\u00e5\u00c9\u00c6\u00b4\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00c2\u00c8\u00cd\u00ba\u00e0\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00f8\u00c9\u00e5\u00da\u00c6\u00ef\u00c6\u00be\u00e0 \u00c9\u00e6\u00b6\u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0\u00c9\u00cd\u00c8\u00e0 \u00a8\u00c4\u00b4\u00c3\u00e5\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00a6\u00c4\u00a6\u00c4\u00a6\u00c4\u00a6\u00c4\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u0097\u00cc\u00e0\u00cc\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd\u00bc\u00b6\u00c6.\n\n\u00a6\u00c4\u00a6\u00c4\u00a6\u00c4\u00a6\u00c4\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ba\u00f8\u00cd\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd\u00bc\u00b9\u00c6\n\n\u00ce\u00c4\u00c6\u00a8\u00eb\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00c9\u00be\u0097\u00b4 \u00b8\u00c6\u00c2\u00e6\u00df\u008a\u00a8\u00c7\u00c6\u00a8\u00b4\u00ef\u00cd\u00e5\u00e0,\u00bc\u00e5\u00cc\u00c3\u00e5\u00c9\u00c6\u00b4\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\u00c2\u00c8\u00cd\u00ba\u00e0\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00ef\u00cd\u00e5\u00e0\u00a1\u00be\u00f8\u00c9\u00e5\u00da\u00c6\u00ef\u00c6\u00be\u00e0\u00c9\u00e6\u00b6\u00aa\u00e6\u00be\u00f9\u00c4,\u00c9\u00cd\u00c8\u00e0\u00c3\u00e5\u00c9\u00c6\u00b4\u00c3\u00e5\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4,\u00ef\u00cd\u00e5\u00e0 \u00cc\u00be\u00e0\u00be\u00bc\u00e0\u00bd\u00a1\u00c7\u00aa\u00c8\u00c6\u00a8\u00ef\u00c6\u00bc\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5\u00ce\u00c4\u00c6\u00a8\u00eb\u00ef\u00c6\u00e5\u00bc\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00ef\u00cd\u00e5\u00e0 \u00c2\u00bf\u00c9\u00e5\u00aa\u00e6\u00be\u00f9\u00c4\u201d.\n\n(4) 360\u00a1\u00e6 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce \u00cc\u00e8\u00c6\u00f5 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0\u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00cc\u00b4\u00cd\u00be\u00e0 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n2006 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea\u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba3\n\n\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u00c4\u00a8\u00f8\u00d7\u00c4\n\n\u201c360\u00a1\u00e6\u00a6\u00c4\u00a6\u00c4 \u00a6\u00c4\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ef\u00bc\u00a8\u00a8\u00b4\u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u0097\u00cc\u00e0\u00cc\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00bc\u00b6\u00c4\u00ea\u00bc\u00c8\u00a8\u00f8\u00be\u00e0 \u00bc\u00b9\u00ea\u00c9\u008a\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8\u00c6.\n\n\u00c9\u00ef\u00c7\u00be\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0\u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9\u00a1\u00ba\u00e0\u00a1\u00b6\u00e2\u00aa\u00eb\u00c9\u00b4\u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8\u00c6.\n\n\u00c9\u00c7\u00bc \u00ce\u00c4\u00c6\u00a8\u00eb\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00cc\u00e8\u00f3\u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00bc\u00fb\n\n\u00a6\u00c4\u00a6\u00c4\u00a6\u00c4\u00a6\u00c4\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ba\u00eb\u00be\u00a8\u00b4\u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u0097\u00cc\u00e0\u00cc\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00bc\u00b6\u00c4\u00ea\u00bc\u00c8\u00a8\u00f8\u00be\u00e0 \u00bc\u00bc\u00b9\u00ea\u00c9\u008a \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c6.\n\n\u00ce\u00c4\u00c6\u00fa\u00be\u00e0 \u00bc\u00c7\u00e6\u00a8\u00c4\u00b4\u00cd\u00bc\u00e5\u00aa\u00e6\u00be\u00f9\u00c4 \u00cd\u00e5\u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00c9\u00e6\u00c7\u00bc\u00fa\n\n360\u00a1\u00e7\u00a6\u00c4\u00a6\u00c4 \u00a6\u00c4\u00a6\u00c4\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u0097\u00cc\u00e0\u00cc\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00b6\u00c6\u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00bc\u00b6\u00c6\u00c6\u00be \u00ef\u00bc\u00a8\u00c4.\n\n\u00ce\u00c4\u00c6\u00a8\u00eb \u00ef\u00c0\u00e5\u00ce\u00c5\u00c9\u00e5\u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a1\u00e6\u0097\u0090\u00c8\u00e8 \u00a8\u00f8\u00d7\u00c4.360\u00a2\u00a6\u00c4\u00a6\u00c4 \u00a6\u00c4\u00a6\u00c4\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00bc\u00cd\u00c6\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00b6\u00c6\u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00bc\u00b6\u00c6\u00c6\u00be \u00ef\u00bc\u00a8\u00c4.\u201d.\n\n2006 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea\u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba4\n\n(5) 365\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce \u00cc\u00e8\u00c6\u00f5 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0\u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u00c2\u00c7\u00c0\u00ba\u00c8 \u00c8\u00e8\u00e2\u00aa\u00fa\u00a8\u00a1\u00c0\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u201c365\u00a1\u00e5\u00a6\u00c4\u00a6\u00c4 \u00a6\u00c4\u00a6\u00c4\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00c0\u00cd\u00a8\u00b4\u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u0097\u00cc\u00e0\u00cc\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00c2\u00c7\u00c0\u00ba\u00c8 \u00c9\u00e6\u00b6\u00a1\u00e6\u00ba\u00f8\u00c9\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00bc\u00b6\u00c6\u00cc\u00cd \u00c9\u00be\u00e0\u00bc\u00fa\u00c6\u00a8\u00e0.\n\n\u00c9\u00c7\u00bc \u00cc\u00e8\u00f3\u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0\u00c9\u00c6\u00cc \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00bc\u00cd\u00a1\u00b4\u00b4\u00a1\u00b6\u00ea \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00bc\u00fb"
