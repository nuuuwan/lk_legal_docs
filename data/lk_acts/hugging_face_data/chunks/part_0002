    "chunk_text": "\u201c\u00ba\u00f1\u00e5\u00aa\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 , 1979 \u00a1\u00e2\u00a8 28 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ef\u00ba\u00e052 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8 \u00c9\u00ec \u00ba\u00f1\u00e5\u00aa\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00c6\u008a\u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00a1\u00ca\u00a8\u00e0\u00be\u00ea\u00ba\u00e5\u00c9\u00b4 \u00c0\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c2\u00e5\u00c8\u00c9\u00c6\u00cc\u00e0\u00a8\u00c7\u00e6\u00ef\u00c9\u00a8\u00e0,\u00a4\u00be\u00e0\u00c4\u00ba\u00e0\u00a8\u00ef\u00c6\u00a8\u00e0, \u00c4\u00ea\u00aa\u00e0\u00bd\u00ef\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e8\u00cd\u00fa\u0097\u00a8\u00c8\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00ef\u00c9\u00ef\u00ce\u00bf \u00ef\u00c0\u00e5\u00ce \u00a1\u00aa\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00a6\u00c6 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u00cd\u00e5 \u00c6\u008a \u00bc\u00fa\u00be\u00c6\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u00c6\u00ef\u00bc\u00be \u0097\u00b4, \u0097\u00c9\u00ee\u00ba \u00ef\u00c9\u00ef\u00ce\u00bf \u00ef\u00c0\u00e5\u00ce\u00a8\u00bc\u00fb, \u00a6\u00e0\u00bc\u00fa\u00be\u00ef\u00c6\u00cd\u00fa\u00bc\u00fb \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00cc\u00bf\u00cd\u00e5 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00c4\u00ba\u00c6 \u00a1\u00be\u00ea\u00c9\u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u0095\u00c8 \u00a2\u00be\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00a1\u00ef\u00be\u00f1\u00e5\u00be\u00f1 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00cc\u00cd \u0097\u00be\u00f8\u00c4\u00c6\u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00ef\u00be\u00f1\u00e5\u00be\u00f1 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00ef\u00bc\u00be \u00c8\u00bc \u00c6\u008a \u00a1\u00ef\u00be\u00f1\u00e5\u00be\u00f1 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e0\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ef\u00be\u00e5\u00c9\u00be\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, 79 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c9\u00e5\u00cc\u00e8\u00a8 \u00ef\u00be\u00e5\u00c9\u00ec \u00c2\u00c9 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00be, \u00a2\u00b6\u00c4\u00a8\u00e0 \u00cd\u00e5 \u00a6 \u00cd\u00fa \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00e8\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00ef\u00c6\u00ef\u00bc\u00be \u0097\u00b4, \u0094\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00a8\u00b4\u00c6\u00b4\u00ba\u00e0\u00c9 \u00a6\u00e0 \u00a2\u00b6\u00c4 \u00cc\u00cd \u00a6\u00cd\u00fa \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4 \u00c3\u00eb\u00a8\u00e0\u00ba\u00f8 \u0097\u00bf\u00fa\u00be\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00a2\u00be\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u201d \u00c6\u00be\u00e0\u00be\u00b4, \u00c6\u008a \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00ef\u00aa\u00e0\u00ef\u00c2\u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c8\u00e5\u00c3\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c2\u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00c8\u00e5\u00c3\u00ef\u00c6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00cc\u00c4\u00ad \u00cd\u00c9\u00ea\u00ef\u00c8\u00e0\u00ef\u00c2\u00bc\u00e5 \u00aa\u00be\u00ea \u00c8\u00e6\u009f\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00c9\u00ec \u00c6\u008a \u00be\u00f8\u00c6\u00e5\u00bc\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0, \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0,\u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00e0, \u00c0\u00f2\u00ba\u00f8\u00b3\u00c9\u00a8\u00e0, \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0, \u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00e0, \u00ef\u0089\u00c7\u00e6\u008a \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c9\u00e6\u00b6\u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00ce\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0\u00c6 ;\n\n3012006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba\n\n\u201c\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u201d \u00c6\u00be\u00e0\u00be\u00b4, \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0, \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ;\n\n\u201c\u00c0\u00f2\u00c4\u00ea\u00a9 \u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00bc\u00fa\u00e2\u008e\u00c9 \u00cc\u00e8\u0090\u00be \u00cc\u00a8\u00f2\u00e9\u00c6\u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00d6\u00be\u00e0_\n\n(\u00a1) \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00aa\u00fa\u0097\u00cc\u00ea\u00ef\u008a \u00c0\u00ce\u00c4\u00ea\u00ef\u00c9\u00be\u00e0 \u00be\u008a \u00ef\u00a8\u00e5\u00b4\u00a1\u00e6\u00ba\u00f8 ;\n\n(\u00a1\u00e5) \u00a6\u00c9\u00e6\u00be\u00f8 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00be\u008a, \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00ef\u00cd\u00e5\u00e0\u00cc\u00e5\u00c4\u00e5\u00be\u00f1 \u00be\u00e5\u00c4\u00ef\u00c6\u00be\u00e0 \u00ba\u00be\u00f8\u00c9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00f8\u00a8\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00b4\u00c0\u00f2\u00c4\u00ea\u00a9\u00c9 \u00be\u0095\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00c8\u00a8\u00eb\u00c7\u00e6\u00c9\u00c8\u00e8\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8 ;\u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e6) 1987 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00be\u00e5\u00c4 \u00c0\u00be\u00ef\u00ba\u00e0 4 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c0\u00f2\u00a8\u00e5\u00ca\u00be\u00ef\u00c6\u00cd\u00fa \u00c0\u00ce\u00c4\u00ea\u00ef\u00c9\u00be\u00e0\u00be\u008a \u00ef\u00a8\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8,\n\n\u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00be\u00f8\u00c6\u0095\u00ba, \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c9\u00c8\u00e8\u00be\u00e0\u00be\u00f8\u00c6\u0095\u00ba \u00c2\u00c9 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;"
  },
