    "chunk_text": "\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00a8\u00eb\u00b4 \u00ef\u00cc\u00e0\u00c9\u00c6 \u00c8\u00c2\u00e5\u00bc\u00fb\u00c4\u00b4\u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00e5 \u00a1\u00ef\u00c0\u00e5\u00ef\u00cd\u00e5\u00cc\u00ba\u00e0 \u00d1\u00c4 \u00cd\u00e6\u00c7 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00cd\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00be\u00f8\u00cc\u00e5\u00c6\u008a \u00c8\u00e8\u008d\u00ba \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a1\u00be\u00ea\u00c9, \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be \u00aa\u00b8\u00be \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cc\u00e0\u00c9\u00c6 \u00ef\u00be\u00e5\u00a8\u00c7\u00be \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00a8\u00eb\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4, \u00a6\u00c4 \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00e5\u00b4 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00bc\u00fb\u00c4\u00be\u00e5\u00c9\n\n\u00be\u00f8\u00cc\u00e8 \u00c2\u00c8\u00bd\u00c7\u00c6\u00e5.\n\n\u00a1\u00c6\u00c9\u00e6\u00c6 \u00bc\u00fb\u00c4\u00be\u00e5 \u00ef\u00aa\u00d1\u00c4.\n\n2005 \u00a1\u00e2\u00a8 36 \u00bc\u00c7\u00be \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00c6\u00c9\u00e6\u00c6\u00cc\u00cd\u00be \u00bc\u00fb\u00c4\u00be\u00e5\u00c9 \u00c0\u00be\u00ba2\n\n(\u00a1\u00e5)\u00ef\u00ef\u00bc\u00be\u00f8\u00a8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00c4\u00ba \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00a8\u00eb\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4, \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00bc\u00fb\u00c4\u00be\u00e5\u00c9, \u00c4\u00e5\u00cc\u00c6 \u00ba\u00eb\u00ce \u00a7\u00cd\u00ea\u00ef\u00cc\u00e0\u00c9\u00c6 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00bc\u00fa\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00bc\u00fa\u00be\u00a8\u00b4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cd\u00ba\u00c8\u00e8\u00cd\u00c2\u00e6\u00aa\u00fa\u00be\u00e0 \u00aa\u00b8\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00a6\u00a8\u00e0 \u00c4\u00e5\u00cc\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00cc\u00cd\n\n(\u00a1\u00e6)\u00a8\u00e7\u00c8\u00e8 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00a1\u00be\u00ea\u00c9 \u00ef\u00aa\u00d1\u00c4 \u00c4\u00ba \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00e0 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c9 \u00cc\u00e8\u0090\u00be\u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00a8\u00eb \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4 \u00c6\u008a \u00c4\u00e5\u00cc\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00bc\u00fb\u00c4\u00be\u00e5\u00c9 \u00a6\u00c4 \u00c4\u00e5\u00cc\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00e5\u00b4 \u00ef\u00aa\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00ef\u008c\u00ba\u00be\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u00b4\u00ea\u00ef\u00c0\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00bc\u00cd\u00c6\u00a8\u00b4 \u00c9\u00b6\u00e5 \u00a1\u00b6\u00ea\u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n\u00a6\u00ef\u00cc\u00e0\u00c4 \u00ba\u00c9\u00f3\u00c7\u00b4\u00ba\u00e0, \u00a6\u00a8\u00e0 \u00c4\u00e5\u00cc\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00bc\u00fb\u00c4\u00be\u00e5\u00c9 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00ef\u008c\u00ba\u00be\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u00b4\u00ea\u00c0 \u00c4\u00cc\u00a8\u00b4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0097\u00cc\u00e8\u00bc\u00cd\u00cc\u00a8\u00b4 \u00c9\u00e6\u0091\u00c9 \u00a6\u00ef\u00cd\u00ba\u00e0\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0097\u00cc\u00e8 \u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091\u00c9 \u00c8\u00c2\u00be \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00a8\u00eb\u00b4, \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0\u00c4\u00e5\u00cc\u00c6 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0, \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0097\u00cc\u00e8 \u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc\u00a8 \u00c4\u00ea\u00bc\u00c8 \u00cc\u00cd \u00a6\u00e0 \u00c4\u00e5\u00cc\u00c6\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ef\u008c\u00ba\u00be\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u00b4\u00ea\u00c0 \u00ef\u00c8\u00cc \u00a6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a4\u00c0\u00c6\u00e5\u00aa\u00be\u00e0\u00be\u00e5\u00c8\u00bc \u00c4\u00ea\u00bc\u00c8 \u00a1\u00ba\u00c7 \u00c9\u00ec \u00ef\u00c9\u00be\u00cc\u00b4 \u00cc\u00c4\u00e5\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00a8\u00e0 \u00ef\u00c8\u00cc \u00ef\u00aa\u00c9\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) 2004 \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u008a\u00c2\u00da \u00c4\u00e5\u00cc\u00c6 \u00ba\u00eb\u00ce \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00ef\u008c\u00ba\u00be\u00c6 \u00ef\u00cd\u00e5\u00e0\u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00c9\u00da\u00bd\u00a8\u00c6 \u00c8\u00c2\u00e5\u00ef\u00aa\u00be \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00a8\u00eb, \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00bc\u00cd\u00cc\u00a8 \u00c4\u00ea\u00bc\u00c8 \u00cc\u00cd\u00a6\u00e0 \u00ef\u008c\u00ba\u00be\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00c9\u00da\u00bd\u00a8 \u00c4\u00ea\u00bc\u00c8 \u00a1\u00ba\u00c7 \u00c9\u00ec \u00ef\u00c9\u00be\u00cc\u00b4 \u00cc\u00c4\u00e5\u00be \u00c4\u00ea\u00bc\u00c8\u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00aa\u00be\u00f8\u0095\u00be\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be\u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00a8\u00b4 \u00cd\u00fa\u0095\u00a8\u008a \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) (\u00a1) \u00cc\u00e5\u00c4\u00ea\u00cd\u00fa\u00a8 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5) (131 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00a8\u00e5\u00da\u0095\u00a8 \u00a1\u00e5\u00c7\u00e5\u00c9\u00ea\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 10\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec\u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00f8\u00be\u00e0 \u00a6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00cc\u00e5\u00c4\u00ea\u00cd\u00fa\u00a8 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00a1\u00bc\u00e5\u00ce \u00d1\u00c4 \u00bc\u00fb\u00da\u00ab \u00a8\u00f8\u00d7\u00c4\u00a8\u00f8\u00be\u00e0,\n\n2005 \u00a1\u00e2\u00a8 36 \u00bc\u00c7\u00be \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00c6\u00c9\u00e6\u00c6\u00cc\u00cd\u00be \u00bc\u00fb\u00c4\u00be\u00e5\u00c9 \u00c0\u00be\u00ba3\n\n\u00a1\u00e5\u00c9\u00c7\u00b8\u00c6 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00a8\u00eb (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec\u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00a8\u00b4 \u00cd\u00fa\u0095\u00a8\u008a \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(5) \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c9 \u00c0\u00c9\u00ba\u00f8\u00be \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00be\u00e0\u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00aa\u00be\u00f8\u0095\u00be\u00e0 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0,\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00be\u00f8\u00c6\u00c4\u00ef\u00c6\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00a8\u00f8\u00cc\u00e8\u00c6\u008a\u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c9 \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4\u00a6\u00cd\u00fa \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00bc\u00fa\u00be\u00c6\u00a8\u00b4 \u00a8\u00c8\u00e0 \u00ba\u00c2\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00e8 \u00c6 :"
