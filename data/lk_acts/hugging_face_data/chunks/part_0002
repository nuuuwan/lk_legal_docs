\u00ce\u00b8 \u00a4\u00af\u00c8\u00bb \u00a5\u00bc\u00ae\u0088\u00b8\u00c7\u00df\u00ba\u00c6 \u00b6\u00ae\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00bf\u00c7\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6 9 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00ce\u00c1 \u00a3\u00be\u00c6\u00be\u00d710 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00ce\u00c1\" \u00b1\u00b4\u00c6\u00b4\u008c\u00cd\u00bc\u00c7\u00b6\u00ba\u00c7\u00b8\u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00c7\u00cc\u00b4\u00c7\u0081\u00bd\u00c7\u00af \u00a3\u00ce\u00ba\u00dc\u00ba\u00c6 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00bd\u00c8\u0081\" \u00b9\u00b5\u00ba\u00c6\u00d7{\u00bb\u00c6\u00b6\u00c7\u00af\u00c6\u00af\u008b\u0081 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00bd\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00bb+\u00c6\u00af\u00bc\u00c1\u00c7\u00b6\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b7\u00c8\u00b6\u00c8\u00bb\u00bf\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00bd\u00c8\u0081 \u00da\u00be\u00b8\u00c7\u00bb\u00c6\u00ce\u00c1\u00b9\u00c6 \u00b9+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6\u00db\u0081\u00b8\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00ba\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6\u00a4\u00e0\u00af\u00c6\u00d0 \u00cd\u00b7\u00bc\u0088\u00bb\u00c7\u00af\u00cd\u00c1\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00b7\u00bc\u0088\u00bb\u00c7\u00af\u008c\u00be\u00c6\u00be\u00c7\u00ba\u00cd\u00be\u00c7\u00a3\u00d9\u00e7\u00be\u00cc\u00ba\u00c7\u0081\u00ce\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00b5 \u00a4\u00b6\u00c7\u00bb\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00cc\u00b9\u00de