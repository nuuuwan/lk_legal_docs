    "chunk_text": "(\u00a5)\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b6\u00c1\u00de\u00af\u00c6\u00d0 \u00d0\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00be\u00c6\u00be\u00d7\u00cc\u00b9\u00c7\u008b\u00d2\u00b9\u00c6 \u00b9\u00b6\u00c8\u00cc\u00c1\u00c7\u0081\u00ce\u00bd\u00dc\u00ce\u00b4\u00bb \u00a4\u00b4\u00c6\u00af\u00bf\u00c6\"\n\n(\u00a6)\u00b7\u00c9\u00ae\u00b4\u00af\u00c7\u00be\u00b9\u00c6 \u00b9\u00d0\u00b6\u00c8\u00cc\u00bb\u00c7\u0081\u00de\u00af\u00c6\u00d0 \u00cc\u00b6\u00c7\u00c0\u00c8\u00df\u00af\u00c6\u00af\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7\u00cd\u00c1\u00de \u00af\u00c7\u00bc\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00af \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00d5 \u00cc\u00b1\u00be\u00c6\u00be\u00b6\u00c6 \u00b6\u00c8\u00b4\u00c6\u00b4\u00ba\u00c8\u00d5\u00ba\u00c6\u00a4\u00b4\u00c6\u00af\u00bf\u00c6\u00b0\n\n302005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d2\u00b8\u00c7\u00ba\u00c8(\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n7\u00b0\u00a3\u00ae\u00ce\u00ba\u008a\u00be\u00c6 \u0089\u00bf\u00c6\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u0081 \u00a5\u00bd\u00b9\u00c6\u00da \u00b7\u00c8\u00af\u00c0\u00c6\u00b7\u00c6\u00b6 \u00d0\u00d5\u00ba\u00c6\u00b9\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u00be\u00c6 \u00a5\u00b4\u00ba\u00bf\u00c8\u00b6\u00c6\u00b6\u00be\u00c7\u00b8\u00d7 \u00a5\u00b6\u0081\u00af\u00ae \u00b6\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00cd\u00c1\u00de\u00f2\u00be\u00b9\u00c6 \u0089\u00bc\u00ba\u00c7\u00b5+\u00c6\u00af\u00bf\u00c6 \u00a9\u00be\u00c6\u00be\u00c7\u00c1\u00bd\u00c6\u00ce\u00bd\u00dc\u00ba\u00c6 \u00db\u00ce\u00bd\u00bb\u00c7\u00af \u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cc\u00af\u00c7\u00ae\u00b4\u00b6\u0081 \u0089\u0081\u00b8\u00bc\u00c6 \u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00c6\u00d0 \u00a3\u00b6\u00c8\u00af\u00bf\u00e2 \u00b7\u0081\u00ce\u00ba \u00b9\u00bb\u00b9\u00c6\u00b9\u00b6\u00c7\u00af\u00a5\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u0081\u00bd\u00c8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00d0\u00d5\u00ba\u00c6\u00b9\u00cc\u00ba\u00c7\u0081\u00de \u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n8\u00b0\u00d2\u0096\u00af\u00c7\u00bc\u00b9\u00c6 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c6 \u2013\n\n(\u00a3)\u00a7\u00bf\u00bc\u00c9\u00b6\u00c8\u00bb\u00c7\u00b8 \u00a3\u00b6\u00c8\u00bc\u00c6\u00b1\u00c6\u00b1\u00c8\u00af\u00c6\u00d0\u00b4\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ac\u00dd \u0089\u00bf\u00c6\u00ce\u00bf\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7\u00a5\u00bf\u00ba\u00c6 \u00a4\u00ce\u00bf\u00af\u00c6 \u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c6 \u00b9\u008a\u00bd\u00c6\u00b1\u00c8\u00ce\u00bb \u00cd\u00ba\u00bd\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u008c\u00dd\u00ba\u00c6\u00da\u00af\u00c8\u0081\u00bd\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u00af\u00e2\u00ba\u00c6 ;\n\n(\u00a4)\u00d2\u00af\u00c7\u00b6\u00c7\u00bc \u00c1\u00b1\u00b6\u00c8\u00af\u00ce\u00bf \u00c1\u00c0+\u00c6\u00d0\u00c1\u00b6\u00c8\u00df\u00ba\u00c6 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da \u00b1\u00c7\u00bc\u00c6\u00b7\u00c6\u00b6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c8\u00df\u00ba\u00c6 \u00b9\u008a\u00bd\u00c6\u00b1\u00c8\u00ce\u00bb \u00cd\u00ba\u00bd\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf \u008c\u00dd\u00ba\u00c6\u00da\u00af\u00c8\u0081\u00bd\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u00af\u00e2\u00ba\u00c6 \u00a3\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00a4\u00bd\u00c6\u00bd\u00df\u00ce\u00b4\u00bb\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u00af\u00e2\u00ba\u00c6 ;\n\n(\u00a5)\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00d5 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00af\u00ae\u00af\u00c7\u00b5\u00c8\u00b9\u00c6\u00da \u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u008a\u0081 \u00ac\u00dd \u00b9\u00d0\u00b6\u00c8\u00bb\u00c7\u00af \u00cd\u00b7\u00bc\u00c8\u00be\u00c6 \u00b1\u00b7\u00c6\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00b9\u00c7\u00bc\u00c6\u00ce\u00c1\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a7\u00b4\u0081\u00b9\u00d5\u00b9\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u00af\u00e2\u00ba\u00c6 ;\n\n\u00a5\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n9\u00b0\u00a5\u00be\u00c6\u00be\u00ba\u00c6 \u2013\n\n(\u00a3)\u00a3\u00b6\u0081\u00af\u00ae \u00c1\u00b6\u00c8\u00dc\u00ba\u00c6 \u00a9\u00be\u00c6\u00be\u00c7 \u00d0\u00d5\u00ba\u00c6\u00b9 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6\u00cd\u00b9\u00c7\u00b6\u00c8\u00bb\u00bf\u00e2 \u00a5\u00b4\u00c1\u00b1\u00b6\u00c8\u00ce\u00bb\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\n\n(\u00a4)\u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081 \u00c1\u00bb\u00d7\u00b4\u0081 \u00ac\u00b9\u00c6\u00da\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00af \u00d2\u00b6\u00c6\u00b6\u00ba\u00c6\"\u00d2\u00af\u00c7\u00b6\u00c7\u00bc\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af \u00b1\u00c8\u00bd\u00b7\u00c6\u00b6 \u00b6\u00bc\u00c7\u00b6\u00bc\u00ba\u00c6\u00cd\u00b9\u00b5\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n10\u00b0\u00d2\u0096\u00af\u00c7\u00bc\u00b9\u00c6 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b8\u00c1\u00bd\u00c6\u00ce\u00bd \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00af\u00c6 \u00e7\u0088\u00bb\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u008a\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\u2013\n\n(\u00a3)\u00cd\u00b9\u00c7\u00b6\u00c8\u00bb \u00db\u00b6\u00b8\u00c8\u00ce\u00be \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b6\u00d5\u00b9\u00c6\u00da\u00b1\u00c6 \u00d2\u00af\u00c7\u00b6\u00c7\u00bc\u00af\u00c6 \u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00da\u00b0\n\n(\u00a4)\u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bf\u00ba\u00c6 \u00a4\u00bf\u00c8\u0081 \u00a7\u00b4\u00be\u00c6\" \u00a7\u00bf\" \u00a7\u00b5\u00bc\u00c6\u00e2\u00b7\u00c8\u00ce\u00be \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b1\u00f2\u00af \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00ce\u00bb \u00b7\u00c8\u00ce\u00bd\u00e2 \u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6\u00d2\u00af\u00c7\u00b6\u00c7\u00bc\u00af\u00c6 \u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00da\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00af\u00bf\u00c6\u00b0\n\n(\u00a5)\u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bf\u00ba\u00c6 \u00a4\u00bf\u00c8\u0081 \u00db\u00e1 \u00c1\u00bf\u00bc\u00c6\u00b1\u00c6\u00b1\u00c8\u00af\u00c6\u00af\u00c7\u00b8\u00c1\u00c7\u00bb\u00c6\u00b9\u00c6\u00ce\u00b9 \u00a9\u00bb\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00b8 \u00a8\u00b4\u00c6\u00b4\u00b1\u00c6\u00b1\u00b6\u00c6\u00d7\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d2\u00b8\u00c7\u00ba\u00c8(\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c631\n\n11\u00b0\u00d2\u0096\u00af\u00c7\u00bc\u00b9\u00c6 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c6 \u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00c6\u00d0\u00b9\u00c6 \u00cd\u00b9\u00c7\u00b6\u00c8\u00bb\u00bf\u00e2 \u00af\u00be\u00c6\u008c\u00bb\u00bd\u00c8\u00c1[\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00d5\u00c1\u00ce\u00b6 \u00a7\u00de\u00b6\u00c8 \u00cc\u00b1\u00bb\u00c6\u00bb\u00af\u00c6 \u00e7\u0088\u00bb\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u008a\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n12\u00b0\u00e7\u00b4\u00c6\u00d5\u00af\u00c6\u00d0\u00d5\u00ba\u00c6\u00b9\u00b6\u00c6\u00d7\u00b4\u00d9\u00ba\u00c6 \u00b7\u00ae\u00b9\u00bc\u00c6\u00af\u00e0\u00b4\u00d9\u00ba\u00c7\u00b8 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b7\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8\u00bf\u00e2 \u00b1\u00c7\u00b6\u00c6\u00b6\u00c8\u00bb\u00ba\u00bd\u00c6\u00bd\u00b6\u00c7\u00af\u00e2\u00ba\u00c6 \u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081 \u00b7\u00be\u00d9\u00af\u00c6\u00d0\u00ac\u00c1\u00c6\u00c1\u00c7\u00b6\u00b6\u00c7\u00af\u00e2\u00ba\u00c6 \u00a5\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u0081\u00bd\u00c8 \u00d2\u0096\u00af\u00c7\u00bc\u00b9\u00c6 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00af\u00ce\u00bf\u00b9\u00c6 \u00cd\u00b9\u00d6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c7\u00b8\u00c1\u00c7\u00bb\u00c6\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00ce\u00bf \u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bf\u00ba\u00c6 \u00a4\u00e0\u00af\u00c6\u00d0 \u00c1\u00c0+\u00c6\u00af\u008c\u00dd\u00b9\u00c6\u00b9\u00db\u00bf\u00c6\u00bf\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u00af \u00a5\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n13\u00b0\u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081 \u008c\u00dd\u00b9\u00c6\u00b9+\u00c6\u00af\u00e0\u00bf\u00c6 \u00cd\u00b9\u00c7\u00b6\u00c8\u00bb\u00bf\u00e2 \u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n14\u00b0\u00d2\u0096\u00af\u00c7\u00bc \u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00da\u00af\u00c6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081 \u0089\u0081\u00b8\u00bc\u00c6 \u0089\u00bf\u00c6\u00ce\u00bf\u00ce\u00bb\u00ba\u00af\u00cd\u00c1\u00bd\u00c6\u00da \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00af\u00c7\u00bc\u00bc\u00c8\u0081 \u00a4\u00bc\u00c6\u00c1\u00ba\u00c6 \u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0"
