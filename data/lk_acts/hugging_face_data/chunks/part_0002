    "chunk_text": "\u201c\u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 (110 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec)\u00a4\u00c0\u00e0\u00c0\u00e6\u00be\u00e0\u00be \u00cc\u00cd \u00c4\u00c7\u00b8 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 4 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00a4\u00c0\u00e0\u00c0\u00e6\u00be\u00e0\u00be \u00cc\u00cd \u00c4\u00c7\u00b8 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ; \u00cc\u00cd\n\n\u00c9\u00e6\u00c7\u00bc\u00fa.\n\n\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n2005 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00cc\u00ea\u00be\u00e5\u0095 (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba5\n\nII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00ce\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00cd \u00ef\u00c6\u00f0\u00c9\u00be\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c3\u00e5\u00c7\u00a8\u00e5\u00c7\u00ba\u00e0\u00c9\u00c6\n\n7.2004 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 26 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00f3 \u00c9\u00ec \u00cc\u00ea\u00be\u00e5\u0095 \u0097\u00c0\u00ef\u00ba\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c6\u00a8\u00e0\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u2013\n\n(\u00a1) \u00ef\u00bc\u00c4\u00e5\u00c0\u00e8\u00c6\u00be\u00e0 \u00a1\u00cd\u00fa\u0095 \u00c9\u00ec \u00cc\u00e7\u00c4 \u00ce\u00c4\u00c6\u00a8\u00eb\u00b4\u00c4 \u00cc\u00cd \u00ef\u00c6\u00f0\u00c9\u00be\u00c6\u00a8\u00eb\u00b4\u00c4 ;\n\n(\u00a1\u00e5) \u00ef\u00bc\u00c4\u00e5\u00c0\u00e8\u00c6 \u00ef\u00bc\u00ef\u00bc\u00be\u00e5\u00ef\u00aa\u00be\u00e0 \u00a6\u00a8\u00e0\u00ef\u00a8\u00be\u00a8\u00eb \u00a1\u00cd\u00fa\u0095 \u00c9\u00ec \u00cc\u00cd \u00b0\u00e9\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be\u00c4\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00c6\u00e5\u00b4 \u00db\u00a8\u00c2\u00c8\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00cd\u00e6\u00a8\u00f8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00cc\u00e7\u00c4 \u00ce\u00c4\u00c6\u00a8\u00eb\u00b4\u00c4 ; \u00cc\u00cd\n\n(\u00a1\u00e6) \u00ef\u00bc\u00c4\u00e5\u00c0\u00e8\u00c6 \u00ef\u00bc\u00ef\u00bc\u00be\u00e5\u00ef\u00aa\u00be\u00e0 \u00a6\u00a8\u00e0\u00ef\u00a8\u00be\u00a8\u00eb \u00a1\u00cd\u00fa\u0095 \u00c9\u00ec \u00cc\u00cd \u00db\u00a8\u00c9\u00c7\u00b8\u00c6\u00cc\u00cd \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9 \u00a1\u00c9\u00ca\u00f1 \u00a6\u00ef\u00cd\u00ba\u00e0 \u00a6\u00e0 \u00db\u00a8\u00c9\u00c7\u00b8\u00c6 \u00cc\u00cd \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4\u00b4 \u00d5\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00c4\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00c6\u00e5\u00b4 \u00cd\u00e6\u00a8\u00f8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00cc\u00e7\u00c4 \u00ef\u00c6\u00f0\u00c9\u00be\u00c6\u00a8\u00eb\u00b4\u00c4,\n\n\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00bc\u00e5\u00ce \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n8.(1) 11 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0, \u00a1\u00be\u00e5\u00bb\u00c6\u00a8\u00eb \u00c2\u00c9\u00b4 \u00c0\u00ba\u00e0 \u00c9\u00ec \u00cc\u00e7\u00c4\u00ce\u00c4\u00c6\u00a8\u00eb\u00b4\u00c4 \u00cc\u00cd \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00e6\u00c0\u00a8\u00c7\u00e6 \u00c4\u00e5\u00c0\u00e8\u00c6 \u00db\u00a8\u00c9\u00c7\u00b8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00ba\u00e6\u009f\u00c4\u00b4 \u00c4\u00be\u00e5\u00c0 \u00cc\u00e7\u00c4 \u00ce\u00c4\u00c6\u00a8\u00eb \u00cc\u00cd \u00ef\u00c6\u00f0\u00c9\u00be\u00c6\u00a8\u00eb\u00b4\u00c4 \u00a1\u00bc\u00e5\u00ce \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00c7\u00c6\u00a8\u00e0 (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) 1998 \u00a1\u00e2\u00a8 50 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00ce\u00c4\u00e5 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00b0\u00e5\u00ba\u00f8\u00a8 \u00ce\u00c4\u00e5 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be\u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00c7\u00ef\u00c6\u00e0 \u00be\u00f8\u00c9\u00e6\u00c7\u00bc\u00fa \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba\u00c9 \u00ba\u00f8\u00ef\u00c2\u00be \u00c2\u00c9\u00b4 \u00cc\u00cd\u00ba\u00f8\u00a8\u00d1\u00ef\u008a \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00a6\u00c4 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00c7\u00ef\u00c6\u00e0 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00c9\u00e5\u00da\u00ba\u00e5\u00aa\u00ba \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8\u00ce\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00cd \u00ef\u00c6\u00f0\u00c9\u00be\u00c6\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00c9\u00ca\u00f1 \u00c6\u00c6\u00fa \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00c2\u00be \u00c6\u008a \u00c0\u00d7\u00a8\u00e0\u00cb\u00b8\u00c6\u00a8\u00e0 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00be\u00ef\u00ba\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00bc\u00e5\u00ce \u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00c4.\n\n\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00c7\u00c6\u00a8\u00e0\u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n2005 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00cc\u00ea\u00be\u00e5\u0095 (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba6\n\n9.(1) \u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00d1\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3\u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e07 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c9\u00c8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ce\u00c4\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00c3\u00e5\u00c7\u00a8\u00e5\u00c7\u00ba\u00e0\u00c9\u00c6\u00a1\u00e6\u00ba\u00f8 \u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00c4, \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u2013\n\n(\u00a1) \u00ce\u00c4\u00c6\u00e5\u00ef\u00aa\u00e0 \u00ef\u00bc\u00c4\u00e5\u00c0\u00e8\u00c6\u00be\u00e0 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u0095\u00cc ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5) 2004 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 26 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00c0\u00cc\u00ea \u00c6\u008a \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0\u00ce\u00c4\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c3\u00e5\u00c7\u00a8\u00e5\u00c7\u00ba\u00e0\u00c9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e0\u00be\u008a \u0095\u00cc,\u00ef\u00cd\u00e5\u00e0 \u00ce\u00c4\u00c6\u00e5\u00ef\u00aa\u00e0 \u00db\u00a8\u00c9\u00c7\u00b8\u00c6 \u00c3\u00e5\u00c7 \u00bc\u00fb \u00a1\u00e6\u00ba\u00e0\u00be\u008a \u0095\u00cc,"
