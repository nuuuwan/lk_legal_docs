    "chunk_text": "138.\u00c7\u00bf\u00c9\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c2\u00bc\u00e0\u00bc\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e9 \u00c4\u00ba \u00ef\u00aa\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u00d1\u00c4207\n\n139.133 \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 136 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e9 \u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u00c4\u00be\u00e0 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u008a\u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u0097\u00bd\u00e5\u00be \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.208\n\n140.\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c0\u00bc\u00fa\u00be \u00c2\u00e6\u00e2\u00a8\u00eb \u00cc\u00cd \u00c4\u00ea\u00c8\u00f1 \u00a1\u00e5\u00c6\u00ba\u00be \u00cc\u00ba\u00eb \u00a8\u00e5\u00da\u00c6. 210\n\n141.\u00c2\u00f3 \u00ef\u00aa\u00d1\u00c4 \u00c4\u00aa\u00cd\u00e6\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00bc\u00b8\u00e0\u00b6\u00be.210\n\n143.\u00c2\u00e6\u00e2\u00a8\u00eb \u00cc\u00cd \u00c4\u00ea\u00c8\u00f1 \u00a1\u00e5\u00c6\u00ba\u00be \u00ef\u00c9\u00ba \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.212\n\n144.\u00a1\u00c3\u00fa\u00c6\u00e5\u00ae\u00be.213\n\n145.\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc\u00b8\u00e0\u00b6\u00be\u00c6.214\n\n146.\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc\u00b8\u00e0\u00b6\u00be\u00c6 \u00cc\u00cd \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6.215\n\n147.\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.215\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\nxiii\n\n148.\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6.215\n\n149.\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00cc\u00c4\u00ea\u00c0\u00a8\u00e5\u00c7 \u00cc\u0095\u00ba\u00f8 \u00cc\u00c4\u00e5\u00aa\u008a \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be \u00c2\u00c9.215\n\n150.\u00c2\u00e6\u00e2\u00a8\u00eb \u00cc\u00cd \u00c4\u00ea\u00c8\u00f1 \u00a1\u00e5\u00c6\u00ba\u00be \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4.216\n\nXVII \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00c8\u00e8\u00be\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\n\n151.\u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4.216\n\n152.\u00a8\u00eb\u00c8\u00e9, \u00c2\u00f3 \u00a8\u00eb\u00c8\u00e9 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00c4\u00e5\u00be \u00ef\u00aa\u00d1\u008a\u00c9\u00c8\u00e8\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00f3 \u00a1\u00b6\u00ea \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00c9\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4.216\n\n153.\u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00c8\u00e8\u00be\u00e0 \u00a1\u00bc\u00e5\u00c6\u008a \u00c2\u00f3\u00a1\u00b6\u00ea\u00a8\u00c7 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.217\n\n154.\u00ef\u008a \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00c8\u00e8\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00c4\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 XVI \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00bc\u00e5\u00ce \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.218\n\nXVIII \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00c0\u00bc\u00fa\u00e2\u008e\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cd\u00e6\u00c7, \u00c6\u008a \u00a2\u00b6\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8\u00a8\u00e0 \u00c0\u00e5\u0097\u0083\u008e \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00d6\u00cd\u00c7\u00b8\u00c6\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00a8\u00eb\u00c8\u00e9,\u00c2\u00f3 \u00a8\u00eb\u00c8\u00e9 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00aa\u00d1\u008a\u00c9\u00c8\u00e8\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\n\n155.\u00a8\u00eb\u00c8\u00e9, \u00c2\u00f3 \u00a8\u00eb\u00c8\u00e9 \u00c6\u00be\u00e5\u00bc\u00fa\u00c6 \u00ef\u00aa\u00c9\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3\u00a1\u00b6\u00ea\u00a8\u00c7\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.218\n\n156.XVI \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00ef\u008a \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.219\n\nXIX \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00cc\u00e6\u00c0\u00c6\u00ea \u00a1\u00c6\u00b4 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00ba\u00f1\u00e5\u00aa \u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8\u00e8\u00be\u00e0\u00cc\u00cd \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00bc\u00b6 \u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00c9\u00c8\u00e8\u00be\u00e0\u00cc\u00cd \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00ef\u00c8\u00e5\u00ba\u00db\u00c6\u00fa \u00ba\u00f1\u00e5\u00aa\u00c9\u00c8\u00e8\u00be\u00e0\u00cc\u00ec\u00f3 \u00cc\u00cd \u0081 \u00b4\u00ea \u00a1\u00e6\u00c8\u00e0\u00c8\u00e9\u00ef\u008a \u00bc\u00fa\u00be\u00ea\u008a\u00c9\u00c8\u00e8\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\n\n157.\u00ba\u00f1\u00e5\u00aa \u00ef\u00cd\u00e5\u00e0 \u00bc\u00b6 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c8\u00e5\u00ba\u00db\u00c6\u00fa \u00bc\u00fa\u00be\u00ea\u008a \u00a1\u00e5\u00bc\u00e8\u00c6 \u00ef\u00aa\u00c9\u00be \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c\u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea\u00a8\u00c7 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.220\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\nxiv\n\n158.\u00ef\u008a \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a XVII \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 XVII\u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00bc\u00e5\u00ce \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.220\n\n159.\u00ef\u00c8\u00e5\u00ba\u00db\u00c6\u00fa, \u00a7 \u00b4\u00ea \u00a1\u00e6\u00c8\u00e0\u00c8\u00e9\u008a \u00cc\u00cd \u00cc\u00ec\u00f3 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7 \u00ef\u00aa\u00be \u00c6\u00be\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4.223\n\nXX \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6"
