    "chunk_text": "(\u00a1\u00e5)2000 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00ec \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0\u00cc\u00e8\u00b4 \u00a3\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00a6\u00ce\u00c5\u00ea\u00b8\u00ea \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb \u00c0\u00cd \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00da\u00cb\u00c6 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0, 2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00a6\u00a8\u00e0 \u00c9\u00da\u00cb\u00c6\u00a8\u00b4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00c8\u00a8\u00e0\u00cb\u00c0\u00be\u00cc\u00e0 \u00bc\u00cd\u00cc\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 (\u00c7\u00e6. 2,50,000) \u00c2\u00e6\u00aa\u00fa\u00be\u00e0 \u00bc\u00fa\u00aa\u00b4\u00c4\u00ef\u00aa\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00cd, \u00a6\u00e0 \u00c2\u00c9\u00b4 \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00c4, \u00a6\u00ef\u00cc\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6\u00a8\u00c7\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c\u00bc\u00fb (235 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ef\u00da\u00aa\u00eb \u00a1\u00e5\u00b3\u00e5 \u00c0\u00be\u00ba,1989 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00c2\u00f3 (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba\u00cc\u00cd 2002 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3 \u00c0\u00be\u00ba\u00c6\u00be \u00c0\u00be\u00ba\u00e0 \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00aa\u00d1\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00c9\u00be \u00c6\u008a\u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00c8\u00f1 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4, \u00a6\u00c4 \u00c2\u00f3 \u00cc\u00cd \u00a1\u00c6\u00a8\u00f8\u00d7\u008a\u00c9\u00c8\u00c4\u00ea\u00dd \u00a6\u00a8\u00ba\u00eb\u00c9 \u00c4\u00ba \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00c0\u00d6\u00bc\u00fa \u00c9\u00ec \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4 \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00aa\u00d1\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. ;\n\n(2) \u00a2\u00cd\u00ba (\u00a1) \u00cc\u00cd (\u00a1\u00e5) \u00ef\u00d8\u00bc \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e5\u00bc\u00be \u00c8\u00bc\u00cc\u00e7\u00c4 \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0\u00c4 \u00ba\u00c4 \u00a1\u00ba\u00e0\u00cc\u00be \u00a6\u00a8\u00f9 \u00be\u00f8\u00c6\u00c4\u00c6 \u00c4\u00ba \u00ba\u00c2\u00be \u00c8\u00bc \u00bc\u00fa\u00be \u00cc\u00e8\u00b4\u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n4.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00c2\u00bc\u00e0\u00bc \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u00a1\u00c9\u00ca\u00f1 \u00cc\u00e5\u00c4\u00e5\u00be\u00f1 \u00ef\u00cd\u00e5\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb \u0097\u00bd\u00e5\u00be, \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00c8 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n\u0097\u00bd\u00e5\u00be \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00ce\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00ef\u00da\u00aa\u00eb \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00c2\u00bc\u00e0\u00bc\u00a1\u00c6\u00a8\u00c7 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n2006 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba3\n\n\u00c7\u00e7\u00c0\u00c9\u00e5\u00cd\u00fa\u00be\u00f9\u00be\u00e5\u00c8\u00e8\u00a8\u00e5\u00c9\u00c8\u00e8\u00be\u00e0\u00ef\u00c0\u00be\u00e0\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ca\u00f2\u00e9\u00c8\u00e2\u00a8\u00e5\u00c9\u00b4 \u00a1\u00e5\u00be\u00c6\u00be\u00c6\u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00b4\u00c8\u00e8\u00be\u00e5\u00b4\u00f1, \u008e\u00ba\u00f2\u00c0\u00b4 \u00cc\u00cd\u00c9\u00e5\u00be\u00f8\u00b0 \u00c9\u00e6\u00b6 \u00cc\u00b4\u00cd\u00be\u00e0\u00c4\u00ba \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00c0\u00e6\u00be\u00d1\u00c4.\n\n5.2006 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00d1 \u00ef\u008a \u00c0\u00be\u00ba\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00be \u00a8\u00e5\u00c8 \u00cc\u00e9\u00c4\u00e5\u00c9 \u00ba\u00eb\u00c8 \u00bc\u00fb, \u00a6\u00ef\u00cc\u00e0 \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be, 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c9\u00c8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00be\u00e0 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00ef\u00da\u00aa\u00eb \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0, 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00be\u00f8\u00c6\u00c4\u00ef\u00c6\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9\u00cc\u00bf\u00cd\u00be\u00e0\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8 \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00a1\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb, \u00a6\u00c4\u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00c8\u00e2\u00aa\u00eb \u00ef\u00c8\u00cc \u00a1\u00c6\u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00c8\u00cc\u00cc\u00cd \u00a1\u00c6\u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 \u00a6\u00c4 \u00a1\u00c6 \u00a8\u00f8\u00d7\u00c4\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00c6\u00f5 \u00a1\u00c0\u00c7\u00e5\u00bd \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e8\u0097\u00c8\u00e0 \u00be\u00b6\u00ea\u00c9\u00c8\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00ef\u00da\u00aa\u00eb \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00c9\u00aa\u00a8\u00f9\u00ef\u00c4\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\nII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00ef\u00b4\u00c8\u00e8 \u00be\u00e5\u00b4\u00f1, \u008e\u00ba\u00f2\u00c0\u00b4 \u00cc\u00cd \u00c7\u00e7\u00c0\u00c9\u00e5\u00cd\u00fa\u00be\u00f9 \u00c9\u00e5\u00b8\u00e8\u00b0 \u00c9\u00e6\u00b6 \u00cc\u00b4\u00cd\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5\u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00c0\u00e6\u00be\u00d1\u00c4"
