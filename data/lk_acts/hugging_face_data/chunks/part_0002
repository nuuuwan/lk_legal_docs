    "chunk_text": "(xiii) \u00cc\u00a8\u00cc\u00e0 \u00ef\u00be\u00e5\u00a8\u00ce \u00bc\u00e6\u00c9 \u00a8\u00bf\u00be\u00e0, \u00be\u00e6\u008c \u00ef\u00cd\u00e5\u00e0\u00ba\u00eb\u00be\u00e0\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c3\u00e5\u00b8\u00e0\u00b6\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9\u00b4 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be\u00ba\u00e5\u00a8\u00e0\u00f3\u00c7\u00b4 \u00a6\u00c4 \u00cc\u00a8\u00cc\u00e0 \u00ef\u00be\u00e5\u00a8\u00ce \u00bc\u00e6\u00c9\u00a8\u00bf\u00be\u00e0, \u00be\u00e6\u008c \u00cc\u00cd \u00c3\u00e5\u00b8\u00e0\u00b6 ;\n\n(xiv) \u00a1\u0093 \u00ef\u00c0\u00f2\u00e5\u00e0\u009b\u00be \u00cc\u00cd\u00fa\u00ba \u00cc\u00cd \u00a1\u0093 \u00ca\u00a8\u00e0\u00ba\u00f8\u00b0\u00be\u00a8\u00a8\u00ee\u00cb\u00e8 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00ef\u00c8\u00cc \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00cd\u00df\u00be\u00e5\u00aa\u00ba\u00e0, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c\u00c9\u00aa\u00e5\u00a8\u00c7\u00be \u00bd\u00e5\u00be\u00f1\u00c9\u00c8\u00e8\u00be\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00fa\u00ba\u00a1\u00e5\u00cd\u00e5\u00c7 \u00c9\u00da\u00aa \u00a6\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00bd\u00e5\u00be\u00f1\u00ef\u00be\u00e5\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00c0\u00ce\u00e5\u00ba\u00e0 \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00a8\u00c7\u00ef\u00aa\u00be\u00cc\u00c0\u00c6\u00e5 \u00aa\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a ;\n\n(xvi) \u00c4\u00ea\u00cd\u00ea\u00f3 \u00c9\u00e6\u00c8\u00e8 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4. \u201d;\n\n(3)(\u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u2013\n\n(\u00a1) \u00a6\u00cd\u00e8 (iii) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u2013\n\n\u201c(iii) \u00c6\u008a \u00c3\u00e5\u00b8\u00e0\u00b6 \u00cc\u00e0\u00c9\u00e5\u00c3\u00e5\u0097\u00a8\u00c9 \u00ef\u00cd\u00e5\u00e0 \u0095\u00be\u00f8\u00cc\u00e0\u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00c7\u00a8\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u00cd\u00bc\u00fa\u00cc\u00e8 \u00a1\u00e5\u00c0\u00bc\u00e5\u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd\u00be \u00cc\u00e6\u00c8\u00cc\u00e9\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6\n\n2006 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba24\n\n\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00e8\u00be\u00e0 \u00ba\u00f1\u00e5\u00aa\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00c3\u00e5\u00b8\u00e0\u00b6 \u00c2\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8\u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00e8\u00be\u00e0 \u00c8\u00e6\u00c2\u00ea\u00b8\u00ea \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8\u00e8\u00be\u00e0 \u00c8\u00c2\u00e5\u00aa\u00ba\u00e0\u00c3\u00e5\u00b8\u00e0\u00b6 \u00c2\u00c9\u00b4 \u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00c3\u00e5\u00b8\u00e0\u00b6 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\u00a6\u00c4 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00ef\u00ef\u00c9\u00bc\u00f1 \u00a4\u00c0\u00a8\u00c7\u00b8, \u00ef\u00ef\u00c9\u00bc\u00f1\u00c6\u00be\u00e0\u00ef\u00ba\u00f2\u00e5\u00e0\u00c0\u00a8\u00c7\u00b8 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00aa\u00fa\u00c8\u00be\u00e0 \u00c7\u00bb \u00c9\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00a6\u00e0 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00a1\u00e5\u00be\u00c6\u00be\u00c6;\u201d;\n\n(\u00a1\u00e5) (x) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u2013\n\n\u201c(xi)\u00c6\u008a \u00be\u00e6\u00c9\u00a8\u00e0 ;\n\n(xii)\u00cc\u00a8\u00cc\u00e0 \u00ef\u00be\u00e5\u00a8\u00ce \u00bc\u00e6\u00c9 \u00a8\u00bf\u00be\u00e0. \u201d.\n\n19.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cd\u00ba\u00c7\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (xix) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00cc\u00cd (xx)\u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u2014\n\n\u201c(xix)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c9\u00aa\u00e5 \u00a8\u00c7\u00be\u2014\n\n(i) \u00a2\u00ad\u00eb\u00c7\u00e6 ;\n\n(ii) \u00ef\u00be\u00c8\u00e0\u00c8\u00e8 ;\n\n(iii) \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u00fb\u00c6 \u00ca\u00e5\u00a9\n\n\u00c9\u00c8\u00e8\u00be\u00e0 \u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00c2\u00be \u00a9\u00be\u00f8\u00b0 \u00c0\u00e5\u00be \u00cd\u00e6\u00c7 \u00a9\u00be\u00f8\u00b0 \u00c0\u00e5\u00be ;\u00cc\u00cd\n\n(xx)\u00ef\u00da\u00aa\u00eb \u00c2\u00f3 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e2\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba \u00c9\u00da\u00aa\u00fb\u00a8\u00c7\u00b8 \u00ca\u00e9\u00da\u00cb\u00a1\u00e2\u00a8 22..07 \u00ef\u00cd\u00e5\u00e0 22.08 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00a3\u00ba\u00c6\u00fa\u00c8\u00e0 \u00c4\u00bd\u00f1\u00cc\u00e5\u00c7 \u00c9\u00da\u00aa\u00cc\u00cd \u00a1\u00ef\u00be\u00a8\u00eb\u00ba\u00e0 \u00cc\u00e0\u00c0\u00f2\u00e9\u00ba\u00eb \u00c9\u00da\u00aa \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00c4\u00ba\u00e0\u00c0\u00e6\u00be\u00e0. ;\n\n(2) \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u2013\n\n\u201c(\u00a1\u00e5) \u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u008a\u00ef\u008a\u00c8\u00be, \u00cc\u008a\u00c4\u00be\u00e0\u00ba\u00f2\u00b8 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00be\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u00bf\u00cd\u00e5 \u00cd\u00e6\u00c7, \u0097\u00c9\u00e5\u00cd \u00c4\u00e2\u00aa\u00c8 \u00a4\u00ba\u00e0\u00cc\u00c9 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0\u00cc\u008a\u00c3\u00e5\u00cb\u00b8 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00cd \u00a6\u00c4 \u0097\u00c9\u00e5\u00cd \u00c4\u00e2\u00aa\u00c8 \u00a4\u00ba\u00e0\u00cc\u00c9 \u00cd\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0\u00cc\u008a\u00c3\u00e5\u00cb\u00b8 \u00cc\u00bf\u00cd\u00e5 \u00ca\u00e5\u00c8\u00e5 \u00a8\u00eb\u00ce\u00e8\u00c6\u00b4 \u00bc\u00fb\u00c4 \u00bc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00c9, \u00ef\u00cd\u00e5\u00e0\u00b4\u00c8\u00e0,\u00a1\u00e5\u00aa\u00be\u00e0\u00ba\u00eb\u00a8 \u00be\u00f8\u00c9\u00e5\u00cc, \u00a1\u00e5\u00c0\u00be\u00ca\u00e5\u00c8\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cd\u00e5 \u00cc\u00c4\u00e5\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00e9\u00c4,\u201d.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00cd\u00ba\u00c7\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba25\n\n20.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u2013\n\n(\u00a1)2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 2(3) \u00cc\u00cd (4) \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8\u00e8\u00be\u00e0\n\n\u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be , \u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 2006 \u00b0\u00be\u00c9\u00e5\u00d6\n\n\u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00bc\u00fb \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00ec \u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;"
