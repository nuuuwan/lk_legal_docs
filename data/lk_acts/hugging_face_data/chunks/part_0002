    "chunk_text": "\u201c\u00cd\u00b6\u00bd\u00c8\u00bb\u00d7 \u00a7\u00b4\u0081\u00b9\u0088\u00af\u00c6\u00ce\u00af\u201d \u00a9\u0081\u00b9\u00d7\" \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00ce\u00bf\u00b9\u00c6\u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00d0\u00b6\u00c6 \u00b6\u00bd\u00c6\u00cd\u00b9\u00c7\u00ce\u00b6\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00a9\u00b6\u00c8\u00bc\u00c6\u00af\u00c7\u00be\u00a7\u00ae\u00ce\u00ba\u00af\u00e0\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00ce\u00bf\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00b6\u00c6 \u00b6\u00bd\u00c6\u00cd\u00b9\u00c7\u00ce\u00b6\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00a9\u00b6\u00c8\u00bc\u00c6\u00af\u00c7\u00be\u00af\u00c6 \u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf \u00cd\u00b6\u00bd\u00c8\u00bb\u00b6\u00c7\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00a9\u00b6\u00c8\u00bc\u00c8\u00b4\u00c6\u00d5 \u00b7\u00c9\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00d0 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd \u00a5\u00bc\u00ae\u00d5 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0\u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b7\u00c8\u00b6\u00c8 \u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00e0\u00af\u00c6\u00af\u00c8\u00ce\u00b4\u00cd\u00bb\u00bb\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7\u00ba\u00b6\u00c6\u00b6\u00c8\u00bb \u00c1+\u00c6\u00af\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00ac\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c6\u00b4\u00b7\u00c8\u00b6\u00c8\u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00ce\u00b4\u00cd\u00bb\u00bb\u00c7\u00b8\u00d7\u00ba\u00c6 \u00a7\u00b4\u0081\u00b9\u0088\u00af\u00c6\u00ce\u00af\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 28 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00c6 \u00b6\u00c9\u00bc\u00c6\u00b6\u00c6\u00b6\u00be\u00c6 \u00db\u00ce\u00bd\u00ce\u00ba\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c647\n\n\u201c\u00a5\u00be+\u00c6\u00ce\u00af\u008a\u0081 \u00b7\u00c8\u00b6\u00c8\u00b1\u00c7\u00bc\u00c6 \u00db\u00ce\u00bd\u00ce\u00ba\u008a\u00be\u00c6 \u00a3\u00b9\u00c7\u00bb\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00d7 \u00ac\u00dd\u00af\u00b5\u00af\u00c6\u00d0\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00e2 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b6\u00c6\u00b6\u00be\u00c6 \u00db\u00ce\u00bd\u00ce\u00ba\u008a\u00be\u00c6 \u00b9+\u00c6\u00d0\u00b9\u00bd\u00c6\u00de\u00b7\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c8\u0081 \u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb\u00ce\u00c1\u00bb\u00c7\u00af \u00c1\u00dd\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7 \u00a3\u00c1\u00bc\u00c8\u0081 \u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf\u00b9\u00c6 \u00b9[\u00bc\u00c6\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00c1\u00bc\u00c6 \u00a5\u00bb\u00be\u00c7\u00b6\u00c8\u00dd\u00af\u00c6\u00d0\u00ba\u00c6\u00a3\u00b9\u00c7\u00bb\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00b5\u00af\u00c6\u00d0\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00e2 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b6\u00c6\u00b6\u00be\u00c6 \u00db\u00ce\u00bd\u00ce\u00ba\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00d9\u00bf\u00c6 \u00b7\u00c8\u00b6\u00c8\u00b1\u00c7\u00bc\u00c6 \u0089\u00bc\u00b1\u00c6\u00b1\u00c8\u00ce\u00b8\u00af\u00ce\u00bf \u00a3\u00d9\u00b9\u00c6\u00da\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 \u2013\n\n(i)\u00af\u00b5\u00af\u00c6\u00d0\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00e2 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b6\u00c6\u00b6\u00be\u00c6\u00db\u00ce\u00bd\u00ce\u00ba\u008a\u00df\u00bf\u00c6\u00bf \u00aa\u00ce\u00b8\u00bb \u00b9+\u00c6\u00d0\u00b9\u00bd\u00c6\u00de\u00b7\u00bc\u00c6\u00af\u00bf\u00c6\"\u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00cd\u00c1\u00ae\u0088\u00bb\u00b8\u00c1\u00c7\u00af \u00c1\u00dd\u00af\u00c8\u0081\u00bd\u00cd\u00b9\u00c7\u00d7 \u00a3\u00c1\u00bd\u00c6\u00ce\u00bd\u00b9\u00c6 \u00b9[\u00bc\u00c6\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a5\u00bb\u00be\u00c7\u00b6\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u00af \u008c\u00dd\u00b9\u00c6\u00b9\u00b6\u00ce\u00b8 ;\n\n(ii)\u00a5\u00be+\u00c6\u00ce\u00af\u008a\u0081 \u00b7\u00c8\u00b6\u00c8\u00b1\u00c7\u00bc\u00c6 \u00db\u00ce\u00bd\u00ce\u00ba\u008a\u0081 \u00aa\u00ce\u00b8\u00bb\u00b9\u00c7\u00af+\u00c6\u00af\u00bf\u00c8\u00df\u00bf\u00c6\u00bf \u00b7\u00c8\u00b6\u00c8\u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00af\u00bf\u00c6\" \u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u0081\u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00cd\u00c1\u00ae\u0088\u00bb\u00b8\u00c1\u00c7\u00af\u00c1\u00dd\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7 \u00a3\u00c1\u00bd\u00c6\u00ce\u00bd\u00b9\u00c6 \u00b9[\u00bc\u00c6\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00d0\u00a5\u00bb\u00be\u00c7\u00b6\u00c8\u00dd\u00b9\u00c6\u00b9\u00b6\u00ce\u00b8 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(iii)\u00af\u00b5\u00af\u00c6\u00d0\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00e2 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b6\u00c6\u00b6\u00be\u00c6\u00db\u00ce\u00bd\u00ce\u00ba\u008a\u0081 \u00af\u00b5\u00af\u00c6\u00d0\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00e2 \u00ba\u00ce\u00b8 \u00a3\u00be\u00c6\u00be\u00d7\u00a5\u00be+\u00c6\u00ce\u00af\u008a\u0081 \u00b7\u00c8\u00b6\u00c8\u00b1\u00c7\u00bc\u00c6 \u00db\u00ce\u00bd\u00ce\u00ba\u008a\u00d9\u00bf\u00c6 \u00a7\u00bf\u00c6\u00bf\u00a5\u0081\u00cc\u00b8\u00c7\u00dd \u00af\u00b5\u00af\u00c6\u00d0\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00e2 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b6\u00c6\u00b6\u00be\u00c6 \u00db\u00ce\u00bd\u00ce\u00ba\" \u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u0081 \u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb\u00b8\u00c1\u00c7\u00af \u00c1\u00dd\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7\u00a3\u00c1\u00bd\u00c6\u00ce\u00bd\u00b9\u00c6 \u00b9[\u00bc\u00c6\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a5\u00bb\u00be\u00c7\u00b6\u00c8\u00dd\u00b9\u00c6\u00b9\u00b6\u00ce\u00b8\n\n\u008c\u00ce\u00bf\u008c\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00ac\u00dd \u00af\u00b5\u00af\u00c6\u00d0\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00e2 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b6\u00c6\u00b6\u00be\u00c6 \u00db\u00ce\u00bd\u00ce\u00ba\u00af\u00c6\u00af\u00c7\u00b8 \u00a5\u00ce\u00b4\u00b6\u00c6\u00b6\u00b4+\u00c6\u00af\u00be\u00c6\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 28 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00c6 \u00b6\u00c9\u00bc\u00c6\u00b6\u00c6\u00b6\u00be\u00c6 \u00db\u00ce\u00bd\u00ce\u00ba\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c648\n\n\u00b9\u00c7\u00af\u00ba\u00c6 III\n\n\u00a5\u00be\u00b6\u00c6\u00b6\u00c8\u00bc\u0081\u00db\u00ce\u00bd\u00af\u00c6 \u00af\u00c7\u00cd\u00b1\u00c7\u00ce\u00be \u00db\u0081\u00ce\u00c1\u00b9\u00c6\u00da\n\n33\u00b0 (1) \u00c1+\u00c6\u00af\u00c8\u00bb\u00c7\u00bf\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c6\" \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00c6\u00af\u00c7\u00af\u00af\u00c6 \u00af\u00c7\u00cd\u00b1\u00c7\u00ce\u00be\u00ce\u00bb \u00db\u0081\u00ce\u00c1\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u00a3\u00b6\u0081 \u00cd\u00b6\u00c7\u00bd\u00c6\u00bd\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00af\u00c6\u00af\u00c7\u00cd\u00b1\u00c7\u00ce\u00be\u008a\u0081 \u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00be\u00b6\u00c6\u00b6\u00c8\u00bc\u0081\u00db\u00ce\u00bd\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00b6\u00c6\u00b6\u00af\u00c1\u00df\u00b4\u0081 \u00cd\u00b1\u00bc\u00c6\u00b6\u00c6\u00d7 \u00a3\u00d9\u00b9\u00c6\u00da\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6\" \u00af\u00c7\u00cd\u00b1\u00c7\u00ce\u00be\u00cc\u00bb\u00c7\u0081\u00de\u00a9\u00b7\u00c6\u00b6 \u00c1+\u00c6\u00af\u00c8\u00bb\u00c7\u00bf\u00bc\u00c8\u0081 \u00cc\u00b9\u00bb\u00bc\u00c8\u00be\u00c6 \u00c1\u00ce\u00bc\u00bb\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6\u00c1+\u00c6\u00af\u00c8\u00bb\u00c7\u00bf\u00dd\u00af\u00c6\u00d0\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af \u00a5\u00be\u00b6\u00c6\u00b6\u00c8\u00bc\u00b8\u00c8\u00bb\u00be\u00c6\u00db\u00ce\u00bd \u00c1\u00c0\u00c8\u00bb\u00c7\u00af \u00a3\u00b6\u00ce\u00b8 \u00db\u0081\u00ce\u00c1\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0"
