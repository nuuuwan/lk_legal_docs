    "chunk_text": "(6) \u00a1\u00cc\u00be\u00f9\u00c0\u00d1\u00c4 \u00be\u00f8\u00cc\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7\u00c9 \u00cc\u00e8\u009b\u00c4 \u00be\u00f8\u00cc\u00e5 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00be\u00f8\u00cc\u00e5 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb\u00b4 \u00cc\u00e8\u00c6 \u00bd\u00ea\u00c7\u00ef\u00c6\u00e0\u00a8\u00da\u00ba\u00c9\u00f1 \u00ba\u00e5\u00c9\u00a8\u00e5\u00c8\u00e8\u00a8\u00c9 \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8\u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00e0\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00e5 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(2) \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c4\u00ea\u00f7\u00e5\u00c9 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c6\u008a \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00b4 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(3) \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c4\u00ea\u00f7\u00e5\u00c9, \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00ef\u00bc\u00ef\u00bc\u00be\u00a8\u00eb \u00a2\u00bc\u00fa\u00d6\u00c0\u00e8\u00b4 \u00bc\u00fb\u00cd\u00e6\u00c7 \u00a8\u00f8\u00cc\u00e8\u00c4 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00ba\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00e0\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00ef\u00bc\u00ef\u00bc\u00be\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00c4\u00be\u00e0 \u00c0\u00e6\u0095\u00b8 \u00cc\u00e8\u00b4 \u00c2\u00c9\u00b4 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00a6\u00e0 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00a1\u00ba\u00e0\u00cc\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c4\u00ea\u00f7\u00e5\u00c9 \u00ba\u00c2\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c9\u00c8 \u00cd\u00e5 \u00ef\u00c8\u00e0\u00a9\u00be\u00c9\u00c8\u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00c7\u00c6\u00a8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5 \u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n11.\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00ce\u00d0\u00c4\u00b4 \u00ef\u00c6\u00e5\u00e0\u00d4\u00ba \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4 \u00ef\u00a8\u00c8\u00e8\u00be\u00e0\u00c4 \u00ef\u00cd\u00e5\u00e0\u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00ef\u00c6\u00e0 \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb\u00a1\u00be\u00e5\u00c9\u00c7\u00b8\u00c6 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6. \u00a6\u00e0 \u00a1\u00be\u00e5\u00c9\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00c8\u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00cc\u00e5\u00a8\u0083\u00af\u00e5\u00c9\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00ba\u00f9\u00c7\u00b8\u00c6\u00a8\u00b4\u00a6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00e5 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c4\u00ea\u00f7\u00e5\u00c9.\n\n\u00aa\u00fa\u0097\u00cc\u00ea\u008a\u00c9\u00c8\u00b4 \u00a1\u00e6\u00ba\u00f8\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00e5\u00c9\u00c7\u00b8\u00c6\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n2005 \u00a1\u00e2\u00a8 31 \u00bc\u00c7\u00be \u00a8\u00c0\u00e0\u00c7\u00e6\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00c0\u00be\u00ba5\n\n12.\u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a6\u00a8\u00ad\u00ba\u00e0\u00c9\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00b4 \u00cc\u00cd \u00a6\u00c9\u00e6\u00be\u00f8\u00a1\u00be\u00ea \u00c0\u00f2\u00c4\u00e5\u00b8 \u00a1\u00be\u00ea\u00c9 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00b4 \u00c0\u00e5\u00d6\u00ca\u00f2\u0095\u00a8 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.II \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb\n\n13.\u00c0\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\u2014\n\n(\u00a1) \u00a8\u00eb\u00b6\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00c9\u00ba\u00eb \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00b4 \u00cd\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00a8\u00eb\u00b6\u00e5\u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00b4 \u00cc\u00a8\u00cc\u00ea\u00c7\u00e6\u00c9\u008a\u00c3\u00e5\u00c9\u00c6 \u00c0\u00ea\u00c7\u00e6\u00f3 \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5\u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00c4\u00e5\u00b0, \u00a1\u00e5\u00da\u00bb\u00fc\u00a8, \u00cc\u00ea\u00c2\u00cc\u00e5\u00bd\u00be\u00c4 \u00b4\u00c4 \u00a2\u00cd\u00ce \u00be\u00e6\u00e2\u00d1\u00c4 ;\n\n(\u00a1\u00e5) \u00ba\u00c4 \u00a8\u00eb\u00b6\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00c9\u00ba\u00eb\u00c9\u00c8 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00cd\u00e5 \u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8\u00c1\u00c8\u00bc\u00e5\u00c6\u00fa\u00ba\u00e5\u00c9\u00c6 \u00be\u00e2\u00c9\u00e5\u00c8\u00e9\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00cc\u00cd \u00a1\u00bc\u00e5\u00ce \u0097\u00bc\u00f1\u00e5\u00ba\u00e0\u00c4\u00a8\u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00c6 \u00c3\u00e5\u0097\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ba\u00c4 \u00a8\u00eb\u00b6\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00c9\u00ba\u00eb\u00c9\u00c8\u00e8\u00be\u00e0\u00c8\u00c2\u00be \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3 \u00c9\u00e6\u0091 \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00a8\u00eb\u00b6\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00c9\u00ba\u00eb\u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00b4 \u00cc\u00cd\u00e5\u00c6\u00d1\u00c4 ;\n\n(\u00a1\u00e6) \u00ef\u00c0\u00e5\u00c8\u00e0 \u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00cc\u00ea\u00dd \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00a1\u00e6\u00c7\u00d0\u00c4 \u00cd\u00e5 \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a\u00c9\u00c8\u00b4\u00a1\u00bc\u00e5\u00ce \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a1\u00e7) \u00a8\u00eb\u00b6\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0\u00c9\u00ba\u00eb\u00c9\u00c8 \u00c1\u00c8\u00bc\u00e5\u00c9 \u00be\u00f8\u0095 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00c2\u00c9\u00b4 \u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u00a1\u00c9\u00ca\u00f1 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00c0\u00e8\u00d6\u00cc\u00e6\u00a8\u00cc\u00ea\u008a \u00a6\u00e0\u00a8\u00a8, \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00ca\u00e5\u00c8\u00e5 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0\u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4, \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4 ;"
