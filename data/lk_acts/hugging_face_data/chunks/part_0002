    "chunk_text": "(\u00a2)\u00ba\u00f2\u00cc\u00e0\u00ba\u00c9\u00e5\u00bc\u00fb \u00a8\u00b8\u00e0\u00b6\u00e5\u00c6\u00c4\u00a8\u00b4 \u00cc\u00cd\u00e5\u00c6 \u00bc\u00fb\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00ba\u00f2\u00cc\u00e0\u00ba\u00c9\u00e5\u00bc\u00fb\u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00b4 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00cc\u00e6\u00c0\u00c6\u00fb\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00a8\u00ba\u00eb\u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0\n\n\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00be\u008a \u00a8\u00c7\u00be \u00c8\u00bc \u00c4\u00ea\u00bc\u00c8\u00e0\u00ef\u00be\u00e5\u00c9\u00be \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00c6\u008a \u00a8\u00b4\u00c6\u00ea\u00ba\u00e0\u00ba\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0\u00ef\u008c ;\n\n\u201c\u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00b4\u201d \u00a1\u00bc\u00e5\u00ce\u00c9\u00be \u0097\u00b4\n\n\u201c\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u00a8\u00b4\u201d\u2014\n\n(\u00a1\u00e5)\u00a1\u00e6\u00ef\u00b4\u00e5\u00e0\u00be\u00f8 \u00c2\u00c8\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c6\u008a \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00ba\u00e0\u00c9\u00c6\u00a8\u00e0 \u00cd\u00e5\u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00e0 ;\n\n(\u00a1\u00e6)\u00a8\u00c9\u00c7 \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00c9\u00c7 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u0097\u00cc\u00e0\u00ba\u00c7\u00c6\u00a8\u00ef\u00cd\u00e5\u00e0 \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00c6\u00a8, \u00a6\u00e0 \u00c2\u00c9 \u00ef\u00a8\u00ef\u00cc\u00e0 \u0097\u00cc\u00e0\u00ba\u00c7 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0\u00c9\u00ea\u00c9 \u00bc, \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u00c4\u00a8\u00e0, \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00c8 \u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c6\u00fa\u00be\u00e0 \u00c6\u008a\u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00c9\u00da\u00ba\u00c4\u00e5\u00be\u00ef\u00c6\u00e0\u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00e5\u00aa\u00ba\u00ef\u00c6\u00e0 \u00bc\u00fb \u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c6\u008a \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6\u00a8\u00e0 ; \u00ef\u00cd\u00e5\u00e0 \u00cd\u00fa\u0095\u00a8\u00c4\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00c7\u00c0\u00f2\u00cc\u00e5\u00bc\u00c6\u00a8\u00e0 \u00c8\u00c2\u00e5 \u00ef\u00bc\u00be \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce\u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0, \u00a6\u00c6\u00c0\u00c9\u00c7\u00e5 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00ef\u00cc\u00e0 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c9\u00ea\u00c9\u00bc \u00a6\u00c4 \u00ef\u00bc\u00e0\u00c0\u00ce\n\n\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00ba\u00c9 \u00bc\n\n\u201c\u00be\u00f9\u00ba\u00f8 \u0097\u00ef\u00c7\u00e5\u00e0\u009e \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00c8\u00e8\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0-\n\n(\u00a1)(218 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00c9\u00cc \u00c9\u00da\u00aa, \u00a1\u0094\u00be\u00e0 \u00cc\u00cd\u00a1\u00be\u00e0\u00ba\u00c7\u00e5\u00c6\u00bc\u00e5\u00c6\u00a8 \u00a7\u00f0\u00cb\u00bd \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba ;\n\n402006 \u00a1\u00e2\u00a8 6 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c9\u00e5\u00da\u00ba\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba\n\n(\u00a1\u00e5)\u00ba\u00f2\u00cc\u00e0\u00ba\u00c9\u00e5\u00bc\u00c6 \u00c9\u00ce\u00a8\u00e0\u00c9\u00e5\u00c8\u00e9\u00c4 \u00cd\u00e5 \u00c4\u00e6\u00b6\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9\u00ba\u00ba\u00e0\u00a8\u00e5\u00c8\u00ef\u00c6\u00e0 \u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00c6\u008a \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8\u00e0 ;\n\n(\u00a1\u00e6)(26 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00a1\u00c8\u00e0\u00c8\u00cc\u00e0 \u00c0\u00be\u00ba ;\n\n(\u00a1\u00e7)(182 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ba\u00eb\u00c9\u00a8\u00e0\u00a8\u00eb \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba,(183 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00c0\u00ea\u00c0\u00ea\u00c7\u00b8 \u00f7\u00c9\u00f1 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba \u00ef\u00cd\u00e5\u00e01966 \u00a1\u00e2\u00a8 18 \u00bc\u00c7\u00be \u00c0\u00e9\u00b6\u00e5\u00a8\u00e5\u00d7 \u00a1\u00e5\u00c6\u00ea\u00bd \u00c0\u00be\u00ba ;\n\n(\u00a2)(423 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u0097\u00be\u00f8\u00c4\u00c6 \u00c0\u00e5\u00c8\u00be \u00c0\u00be\u00ba ;\n\n(\u00a3)1988 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb \u00c0\u00be\u00ef\u00ba\u00e0 83\u00a1\u00e6 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 ;\n\n(\u00a4)\u00b0\u00e5\u00ba\u00e9\u00be\u00e0 \u00a1\u00ba\u00c7 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6 \u00ef\u00a8\u00c7\u00e6\u00b8\u00ea \u00a1\u00c0\u00c7\u00e5\u00bd\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce,\u00ba\u00ba\u00e0 \u00a8\u00e5\u00c8\u00ef\u00c6\u00e0 \u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00c6\u008a \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0 ;\n\n(\u00a4\u00f0)\u00cc\u00c6\u00fa\u00c2\u00da \u00a1\u00c0\u00c7\u00e5\u00bd\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00ba\u00ba\u00e0\u00a8\u00e5\u00c8\u00ef\u00c6\u00e0 \u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00c6\u008a \u00be\u00e9\u00ba\u00f8\u00c6\u00a8\u00e0 ;\n\n(\u00a6)\u00ce\u00c4\u00c6\u00fa\u00be\u00e0\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9\u00ec \u00c9\u00e6\u00c7\u00bc\u00fa\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce, \u00ba\u00ba\u00e0 \u00a8\u00e5\u00c8\u00ef\u00c6\u00cd\u00fa\u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00c6\u008a \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0 ;\n\n(\u00a6\u00e0)\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00be\u00e0 \u00c6\u00e5\u00be\u00c9\u00e5\u00cd\u00be \u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00aa\u00be\u00c6\u00e5\u00c4 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00c9\u00e6\u00c7\u00bc\u00fa\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00c8, \u00ba\u00ba\u00e0\u00a8\u00e5\u00c8\u00ef\u00c6\u00cd\u00fa \u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00c6\u008a\u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0 ; \u00cc\u00cd\n\n(\u00a7)\u00c4\u00c7\u00b8\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00cd\u00ba\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0\u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00f8\u00be\u00e0 \u00bc\u00b9\u00ea\u00c9\u008a \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8, \u00ba\u00ba\u00e0\u00a8\u00e5\u00c8\u00ef\u00c6\u00cd\u00fa \u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0,\n\n\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00ef\u00a8\u00ef\u00c7\u00be \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n2005 \u00a1\u00e2\u00a8 6 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb\u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba14\n\n\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c0\u00be\u00ba\u00e0 \u00ef\u00a8\u00b4\u00ea\u008a\u00c0\u00ba\u00e0\u00c9\u00c8 \u00cc\u00cd \u00c0\u00be\u00ba\u00e0\u00c9\u00c8 \u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00bc\u00e5\u00c6\u00a8 \u0095\u00ce (\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6) \u00c7\u00e6. 870 \u00a8\u00f8.(\u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6) \u00c7\u00e6. 1,160 \u00a8\u00f8. \u00a1\u00e2\u00a8 32, \u00b4\u00f2\u00e5\u00be\u00e0\u00cc\u00e0\u00c9\u00da\u00a8\u00e0\u00cc\u00e0 \u00c4\u00be\u00e0\u00bc\u00fa\u00c7\u00c6, \u00ef\u00c8\u00e5\u00e0\u00b4\u00cc\u00e0 \u00c0\u00e5\u00c7, \u00ef\u00a8\u00e5\u00ce\u00c5 01, \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be\u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00a1\u0093\u00a8\u00e5\u00d7 \u00ef\u00c9\u00ba \u00cc\u00e7\u00c4 \u00c9\u00da\u00cb\u00c6\u00a8\u00c4 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 15 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00aa\u00c9\u00e5\u00c0\u00cc\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0\u00c9\u00e5 \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8\u00c6."
