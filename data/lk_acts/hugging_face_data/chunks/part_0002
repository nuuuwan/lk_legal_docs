    "chunk_text": "(\u00a1) \u00a6\u00c4 \u00a1\u00e5\u00c0\u00cc\u00ea \u00aa\u00ef\u00d1\u00c4 \u00a4\u00bc\u00e0\u00aa\u00ba \u00c9\u00be\u00e0\u00ef\u00be\u00e0 165 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (7)\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6 \u00cc\u00c4\u00aa \u00c9\u00ec\u00a6\u00a8\u00ad\u00ba\u00e0\u00c9\u00c6\u00a8\u00e0 \u00a1\u00be\u00ea\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be\u00c8\u00bc \u00a1\u00c3\u00fa\u00c6\u00e5\u00ae\u00be\u00c6\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a1\u00be\u00ea\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00a8\u00c4\u00ea\u00bc\u00c8 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00f2\u00bb\u00fc\u00c1\u00c8\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00be\u008a, \u00a6\u00e0 \u00a6\u00a8\u00ad\u00ba\u00e0\u00c9\u00ef\u00c6\u00e0\u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00cd\u00b4 \u00bc\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c4\u00e5\u00cc \u00cd\u00c6\u00a8 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba ; \u00ef\u00cd\u00e5\u00e0\n\n\u00a6\u00c4 \u00c4\u00ea\u00bc\u00c8 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00a1\u00e5\u00c0\u00cc\u00ea\u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u00c2 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, (\u00a1) \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c9\u00c8\u00e8\u00be\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00c4\u00e5\u00cc \u00cd\u00c6\u00a8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a6\u00a8\u00f9 \u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c4\u00ea\u00bc\u00ef\u00c8\u00be\u00e0\u00ef\u00be\u00e5\u00ef\u00aa\u00c9\u00e5 \u00a2\u00ba\u00f8\u00d6\u00c9 \u00a1\u00e6\u00ba\u00f8 \u00c4\u00ea\u00bc\u00c8 \u00ef\u00be\u00e5\u00ef\u00aa\u00c9\u00e5 \u00a2\u00ba\u00f8\u00d6\u00c9 \u00c0\u00c9\u00ba\u00f8\u00be \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00c4\u00e5\u00cc\u00c6\u00a8 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00a8\u00f9 \u00ef\u00be\u00e5\u00ef\u00aa\u00c9\u00e5 \u00a2\u00ba\u00f8\u00d6\u00c9 \u00c0\u00c9\u00ba\u00f8\u00be \u00c4\u00ea\u00bc\u00c8 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00b4 \u00a6\u00a8\u00a8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00c4\u00ba \u00aa\u00b8\u00be\u00e0 \u00c2\u00c8\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6\u00a8\u00b4, \u00a6\u00c4\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00cd\u00b4 \u00cd\u00fa\u0095\u00a8\u008a \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nXXIX \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00c9\u00e6\u00c7\u00bc\u00fa \u00cc\u00cd \u00bc\u00b8\u00e0\u00b6\u00be\n\n202. (1)(\u00a1) 70 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 73\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 76\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 95 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 106 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (7) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 106 \u00c9\u00be\n\n\u00c9\u00e5\u00da\u00ba\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d7\u00c4,\u00cc\u00e5\u00c9\u00bc\u00f1 \u00c9\u00e5\u00da\u00ba\u00e5\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00a1\u00e5\u00bc\u00fa\u00c6\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00bc\u00b9\u00ea\u00c9\u008a.\n\n\u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00bc\u00fb\u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u00c9\u00be \u00c4\u00ea\u00bc\u00c8\u00e0\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ef\u00aa\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6.\n\n2722006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (12) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 106 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (13) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 106 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (14) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 107 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 109 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 110 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 111 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 190 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ba\u00c4\u00e5\u00b4\u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8 \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00a1\u00be\u00ea\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d6\u00c4\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00e0\u00be\u00e5\u00c9\u00ec: \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5) 112 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (ii)\u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00c4\u00e5\u00b4 \u00a8\u00c7\u00be \u00c8\u00bc \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00a1\u00be\u00ea\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00e0\u00be\u00e5 \u00c9\u00ec; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e6) 106 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (13) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0106 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (14) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0165 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (9) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0169 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (7) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0\u00c6\u00b4\u00ef\u00ba\u00e0 \u00ba\u00c4\u00e5\u00b4 \u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u00c0\u00e6\u0095\u00b8 \u00ef\u00be\u00e5\u00cc\u00e8\u0090\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00c6\u008a \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00b4\u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c0\u00e6\u0095\u00e8\u00b8 \u00cc\u00e8\u00b4, \u00be\u00e9\u00ba\u00f1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00ba\u00c4\u00e5\u00ef\u00aa\u00be\u00e0\u00a1\u00cc\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00c0\u00f2\u00ca\u00e0\u00be\u00c9\u00c8\u00b4 \u00c0\u00e8\u00ce\u00e8\u00ba\u00eb\u00c7\u00e6 \u00bc\u00fb\u00c4 \u00cc\u00e7\u00ef\u00cd\u00be\u00ef\u00cd\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00e0\u00be\u00e5 \u00c9\u00ec; \u00ef\u00cd\u00e5\u00e0"
