c7\u00dd\u00c1\u00bc\u00c7\u00be\u00c6 \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00bd\u00c6\u00bd\u00c8\u00bc\u00c7\u00b6\u00c1\u00dd\u00ba\u00c6 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4)\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00db\u00b7\u00c6\u00b6\u00c8\u00bb \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0 \u00a3\u00c1\u00bc\u00d7\u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00c1\u00dd\u00af\u00c6\u00d0\u00b9\u00c6 \u0089\u00bf\u00c6\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00dd\u00b9\u00c6\u0089\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7\u00ba\u00c6 \u008c\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u00ce\u00b4\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u008c\u008a\u00be\u00c6\u00be\u00c7\u00b6\u00c1\u00dd\u00ba\u00c7\u00b8\"\n\n\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00b6\u00b8\u00c8\u00bb\u00c7\u00bf\u00c6 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0 \u00a3\u00c1\u00bc\u00d7 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00c1\u00dd\u00af\u00c6\u00d0\u00b9\u00c6 \u0089\u00bf\u00c6\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7\u00ba\u00c6 \u008c\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u00ce\u00b4\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6