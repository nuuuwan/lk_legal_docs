    "chunk_text": "(\u00a1)\u00ef\u008a \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9\u00b4 \u00c2\u00c8\u00c6 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0\u00be\u00f8\u00c6\u00c4\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa \u00cc\u00e7\u00bc\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a8\u00e5\u00c7\u00b8 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0;\n\n(\u00a1\u00e5)\u00a1\u00c9\u00c4 \u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u0097\u0097\u00bd \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00cc\u00cd \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00be\u00e0 \u00c2\u00bf\u00c9\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c4\u00e5\u00da\u00ef\u00aa\u00e5\u00e0\u00c0\u00ef\u00bc\u00e0\u00ca\u00cc\u00cd \u00a8\u00e5\u00da\u00c6 \u00c0\u0090\u00c0\u00e5\u0090\u00c6;\n\n(\u00a1\u00e6)\u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00a1\u00c6\u00c9\u00e6\u00c6 \u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00cc\u00cd \u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00cc\u00e6\u00c8\u00cc\u00ea\u00ef\u008a\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00a8\u00e5\u00c7\u00b8 ;\n\n(3) \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e7\u00c4 \u00be\u00e8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8\u00e0 \u00c4 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 \u00a6\u00c4 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce \u00a8\u00ce \u00bc\u00fa\u00be \u00cc\u00e8\u00b4\u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00ef\u00c6\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00a8\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c0\u00cc\u00ea \u00bc\u00fa\u00be\u00c6\u00a8 \u00cc\u00e8\u00b4\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb\u00b4 \u00ef\u00cd\u00e5\u00e0\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0\u00ef\u00bc\u00e0\u00c0\u00c8\u00a8\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9\u00a8\u00f8\u00cc\u00e8\u00c4 \u00d7 \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\n\n2005 \u00a1\u00e2\u00a8 27 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00aa\u00c4\u00be\u00e5\u00aa\u00c4\u00be \u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ba 19\n\n(4) \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e7\u00c4 \u00be\u00e8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8\u00e0 \u00c4 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce \u00a8\u00ce \u00c0\u00cc\u00ea \u00cd\u00e6\u00a8\u00f8 \u00c0\u00cd\u00cc\u00ea \u00a2\u00a8\u00e0\u00c4\u00b8\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba\u00c6 \u00cc\u00bf\u00cd\u00e5\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u00b4 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6. \u00a6\u00ef\u00cc\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00ef\u00be\u00e5\u00c9\u00ec \u00cc\u00e7\u00c4\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8\u00e0 \u00c4 \u00a6\u00c4 \u00a1\u00be\u00be\u00ea\u00c4\u00ba\u00ef\u00c6\u00e0 \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c0\u00d6\u0083\u00d2\u00be\u00e0\u00be \u00c9\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00be\u00c4\u00ea\u00ba\u00e0, \u00a6\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00b4 \u00a2\u00be\u00e0 \u00a1\u00aa\u00ba\u00f8\u00c6\u00a8\u00e0\u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(5) \u00c6\u008a \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8\u00e0 \u00c0\u00d6\u0083\u00d2\u00be\u00e0\u00be \u00c9\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00c2\u00be \u00bc\u00fa\u00be\u00c6\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nVI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a1\u00be\u00e0\u00ba\u00da\u00a8\u00e5\u00c8\u00e9\u00be\n\n32.1978 \u00a1\u00e2\u00a8 19 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00c9\u00e5\u00cd\u00be \u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ba \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n33.\u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb,\u2014\n\n(1) \u00a6\u00c4 \u00bc\u00e8\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c4 \u00c9\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00bd\u00f1\u00c4 \u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0, \u00a4\u00ba\u00eb\u00c7\u00e6 \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00f2\u00c9\u00e5\u00cd\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0, \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0, \u00cc\u00e9\u00c4\u00e5\u00cc\u00cd\u00fa\u00ba \u00c9\u008c\u00be\u00f8\u00c6\u00e5\u00c9 \u00b0\u00be\u00ba\u00e5 \u00cc\u00be\u00e0\u00ba\u00a8 \u00c4\u00aa\u00fb \u00c0\u00f2\u00c9\u00e5\u00cd\u00be \u00ef\u00cc\u00e0\u00c9\u00c6,\u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00b0\u00be\u00ba\u00e5 \u00cc\u00be\u00e0\u00ba\u00a8 \u00c2\u00cc\u00e0 \u00cc\u00c4\u00e5\u00aa\u008a\u00c9\u00c8 \u00cc\u00cd \u00cc\u00e9\u00c4\u00e5\u00cc\u00cd\u00fa\u00ba \u00a4\u00ba\u00eb\u00c7\u00e6 \u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00e0 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba \u00cc\u00e8\u00c6\u00f5 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00be\u00e0,\u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00bc\u00e5\u00ce \u00a1\u00e5\u00c6\u00ba\u00be \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00be\u00f8\u00c6\u00c4\u00cc\u00cd \u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8\u00c9\u00c8\u00b4 \u00c9\u00b6\u00e5 \u00c9\u00e5\u00cc\u00e8\u00bc\u00e5\u00c6\u00a8 \u00c3\u00e5\u00c9\u00ef\u00c6\u00be\u00e0 \u00a1\u00b6\u00ea \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00be\u00f8\u00c6\u00c4\u00cd\u00e5 \u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00c4\u00b8\u00e0\u00b6\u00c8 \u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u008c \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00be\u00e0 \u00ef\u00c8\u00cc\u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00a6\u00c4 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00cc\u00e0\u00c9\u00c6 \u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8 \u00a1\u00be\u00ea\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e0\u00ef\u008c\u0083\u00af\u00e5\u00ef\u00c9\u00be\u00e0 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c6\u00e7\u00ef\u008a\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00cd\u00c7\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u0097\u00be\u00c6\u00e5\u00be\u00ea\u00a8\u00ed\u00c8 \u00ef\u00cd\u00e0\u00ba\u00eb \u00c4\u00ba \u00cd\u00e6\u00c7 \u00ef\u00c9\u00be\u00ba\u00e0\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00b4 \u00a1\u00c9\u00cc\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
