    "chunk_text": "(8)XXIII \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00c3\u00fa\u00c6\u00e5\u00ae\u00be\u00c6\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00a1\u00c9\u00cc\u00e5\u00be\u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00a1\u00be\u00ea\u00c9 \u00ef\u00cd\u00e5\u00e0, (6) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u00d1\u00c4\u00a1\u00ba\u00e0\u00cd\u00fa\u00b4\u00ea\u00c9\u00e5 \u00ba\u00c2\u00be \u00c8\u00bc \u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00c8\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00ef\u00c9\u00be\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be \u00c8\u00bc \u00c2\u00bc\u00e0\u00bc \u00c9\u00e6\u0091\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00bc\u00e0\u00bc\u00a8 \u00ef\u00ca\u00e0\u00cb\u00c6\u00a8\u00e0 \u00c6\u008a \u00bc\u00fa\u00be\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4\u00ef\u00c0\u00c7 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00bc \u00a6\u00e0 \u00bc\u00fa\u00be\u00c6 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u0095\u00be\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00c3\u00fa\u00c6\u00e5\u00ae\u00a8 \u00ef\u00c9\u00ba \u00c8\u00e8\u008d\u00ba \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00c6\u00e6\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00a6\u00e0 \u00a1\u00be\u00ea\u00c9 \u00ef\u00aa\u00c9\u00be\u00ea\u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0, \u00ef\u00aa\u00d1\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be \u00c8\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n2462006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba\n\n(10)\u00ef\u00aa\u00d1\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00c7 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc \u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 XXIII \u00c9\u00be\u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00a1\u00c3\u00fa\u00c6\u00e5\u00ae\u00be\u00c6\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00c9\u00ec \u00a1\u00c9\u00cc\u00e5\u00be \u00ba\u00f9\u00c7\u00b8\u00c6\u00a8\u00e0\u00a1\u00be\u00ea\u00c9 \u00a1\u00c9\u00a8\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00a6\u00e0 \u00c4\u00ea\u00bc\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00aa\u00b8\u00be\u00e0\u00a6\u00ef\u00cc\u00e0 \u00a1\u00c9\u00a8\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c2\u00bc\u00e0\u00bc \u00c4\u00ba \u00aa\u00b8\u00be\u00e0 \u00c2\u00c8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(11)\u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00aa\u00d1\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00ba\u00c4\u00e5\u00b4 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a2\u00ba\u00f8\u00d6 \u00a8\u00f8\u00d7\u00ef\u008a\u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u00c9\u00cd\u00fa \u00ba\u00c4\u00e5\u00ef\u00aa\u00e0 \u00c2\u00e6\u00c7\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00ce \u00c6\u008a \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00a8\u00f8\u00be\u00e0 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a1\u00da\u00bb\u00cc\u00e5\u00bd\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00f8\u00be\u00e0\u00ba\u00c4\u00e5\u00b4 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u00d6\u00a8\u00c6\u00a8\u00e0\u00ef\u00aa\u00d1\u00c4\u00b4 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00ce \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4 \u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u00d6\u00a8\u00c6 \u00ef\u00aa\u00d1\u00c4\u00b4\u00be\u00f8\u00c6\u00c4 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00cc\u00e7\u00cd\u00fb\u00c4\u00b4\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00a6\u00c4 \u00c2\u00bc\u00e0\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u00d6\u00a8\u00c6 \u00ef\u00aa\u00d1\u008a \u00cc\u00bf\u00cd\u00e5 \u00c9\u00e6\u0091\u00c0\u00ea\u00c7\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a7\u00cd\u00ea\u00b4 \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00e8 \u00c6.\u00a6\u00c4 \u00c9\u00e6\u0091\u00c0\u00ea\u00c7 \u00ef\u00bc\u00be \u00c8\u00bc \u00a8\u00e5\u00c8\u00c6 \u00a2\u00a8\u00eb\u00ba\u00e0 \u00c9\u00be\u00ba\u00eb\u00c7\u00e6 \u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u00d6\u00a8\u00c6,\u00ef\u00aa\u00d1\u008a \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be \u00c8\u00bc \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00c8\u00cc \u00ef\u00be\u00e5\u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(12)\u0095\u00c6\u00aa\u00fa\u00c6 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00c2\u00ec\u00bc\u00c8\u00ef\u00c6\u00be\u00e0 \u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00a1\u00c6\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c9\u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc, \u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00c6\u008a \u00c9\u00e5\u00d6\u00a8\u00c6\u00a8\u00e0 \u00ef\u00aa\u00e5\u00d1\u00c4\u00b4 \u00a6\u00e0 \u0095\u00c6\u00aa\u00fa\u00c6\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e0\u00c4\u00e3\u00a8\u00c7\u00e6\u00b4 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4\u00ef\u00c0\u00c7 \u00a6\u00c4 \u00c2\u00bc\u00e0\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u00d6\u00a8\u00c6 \u00ef\u00aa\u00d1\u00c4, \u00ef\u00c0\u00f2\u00e5\u00ef\u00c2 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bc\u00e0\u0095\u00be\u00f8\u00cc\u00e0\u00ba\u00f2\u00e5\u00cc\u00e8\u00c2\u00c8\u00c0\u00ba\u00f2\u00c6 \u00ba\u00c4\u00e5 \u00ef\u00c9\u00ba \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7 \u00ef\u00be\u00e5\u00ba\u00f8\u009f\u00c4 \u00be\u00f8\u00cc\u00e5 \u00a6\u00e0 \u00bc\u00fa\u00be\u00ef\u00c6\u00cd\u00fa \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4\u00ef\u00c0\u00c7 \u00a8\u00ce \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00e8 \u00c2\u00c9\u00b4 \u00a6\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e0\u00c4\u00e3\u00a8\u00c7\u00e6 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00ef\u00c0\u00f2\u00e5\u00ef\u0089 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6 \u00ef\u00cd\u00e5\u00e0\u00a1\u00bc\u00e0\u0095\u00be\u00f8\u00cc\u00e0\u00ba\u00f2\u00e5\u00cc\u00e8 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6 \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00bc\u00fa\u00be\u00c6\u00b4 \u00c0\u00cc\u00ea \u00c4\u00e5\u00cc \u00ef\u00bc\u00a8\u00a8 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u00d6\u00a8\u00c6 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u009f \u00be\u008a, \u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u00d6\u00a8\u00c6\u00ef\u00aa\u00d1\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be \u00c8\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00cc\u00e0 \u00ef\u00be\u00e5\u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
