    "chunk_text": "(1) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00c6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2013\n\n\u201c(\u00a1)\u00c7\u00b4 \u00ba\u00eb\u00ce \u00c4\u00ba\u00e0\u00cc\u00f1 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00cc\u00cd \u00c4\u00ba\u00e0\u00cc\u00f1\u00c0\u00d6\u00ef\u00c3\u00e5\u00e0\u00b0\u00be\u00c6 \u00c9\u00e6\u0091 \u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00c7\u00c4\u00ea\u00b8\u00e8\u00be\u00e0, \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5\u00c9,\u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5 \u00ef\u00c4\u00ef\u00cd\u00c6\u00ea\u008a \u00cc\u00cd \u00be\u00f8\u00ba\u00f1 \u00cc\u00cd \u00a8\u00e5\u00c8\u00e9\u00be\u00b0\u00c8\u00e5\u00ca\u00c6\u00be\u00e0\u00cd\u00fa \u00c9\u00aa\u00e5\u00c9 \u00c0\u00bc\u00be\u008a \u00a8\u00c7\u00aa\u00ba\u00e0 \u009e\u00c9\u00c7\u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00c6 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4;\u201d ;\n\n(3) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00ef\u00c6\u00e0 (\u00a2) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c\u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea\u00a8\u00f8\u00d7\u00c4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00c0\u00cd\u00cc\u00ea\u00a8\u008a\u00cc\u00e6\u00c8\u00cc\u00e9\u00c4 \u00cc\u00cd \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0;\n\n(4) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a3), (\u00a4) \u00cc\u00cd (\u00a4\u00f0) \u00ef\u00d8\u00bc \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0:\u2013\n\n\u201c(\u00a3) \u00ef\u00ef\u00b0\u00c9 \u0097\u0097\u00bd\u00ba\u00e0\u00c9\u00c6 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00c9\u00be \u00c0\u00d6\u00bc\u00fa, \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5\u00c9\u00cc\u00cd \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5 \u00ef\u00c4\u00ef\u00cd\u00c6\u00ea\u008a \u00cc\u00bf\u00cd\u00e5 \u00ef\u00c6\u00e5\u00bc\u00e5\u00aa\u00be\u00ea\u00c8\u00c2\u00be \u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0 \u00cc\u00cd \u00be\u00e8\u00ba\u00f1 \u00cc\u00cd \u00a8\u00e5\u00c8\u00e9\u00be\u00b0\u00c8\u00e5\u00ca\u00c6\u00be\u00e0\u00cd\u00fa \u00c9\u00aa\u00e5\u00c9 \u00c0\u00bc\u00be\u008a \u00a8\u00c7\u00aa\u00ba\u00e0 \u009e\u00c9\u00c7\u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00c6, \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4,\u00cc\u00e2\u00c7\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4;\n\n(\u00a4)\u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb,\u00a1\u00c0\u00be\u00c6\u00be\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb,\u00a1\u00ef\u00ce\u0097\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00cc\u00c0\u00c6\u00be\u00e0\u00be\u00a8\u00eb \u00cd\u00e5 \u00ef\u00c2\u00bc\u00e5\u00cd\u00d6\u00be\u00e0\u00be\u00a8\u00eb\u00ef\u00c8\u00cc \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a8\u00c7\u00ef\u00aa\u00be\u00c6\u00e5\u00c4 \u00cc\u00cd \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5\u00ef\u00c9\u00cd\u00fa\u00ef\u00c6\u00bc\u00fb \u00cc\u00e8\u0090\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00cc\u00cd \u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0\u00a1 \u00e5 \u00be \u00c6 \u00be \u00a8 \u00c7 \u00e6 \u00c9 \u00a8 \u00eb , \u00a1 \u00c0 \u00be \u00c6 \u00be \u00a8 \u00c7 \u00e6 \u00c9 \u00a8 \u00eb ,\u00cc\u00c0\u00c6\u00be\u00e0\u00be\u00a8\u00eb, \u00ef\u00c2\u00bc\u00e5\u00cd\u00d6\u00be\u00e0\u00be\u00a8\u00eb \u00cc\u00cd \u00a1\u00ef\u00ce\u0097\u00a8\u00c7\u00be\u00e0\u00be\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6\u00a8\u00f8\u00d7\u00ef\u00c4\u00cd\u00fa \u00ef\u00c6\u00bc\u00fb \u00cc\u00e8\u0090\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00cc\u00cd\u00e5\u00c6 \u00d1\u00c4;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e011 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 23 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba4\n\n(\u00a4\u00f0)\u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5\u00c9 \u00cc\u00cd \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5 \u00ef\u00c4\u00ef\u00cd\u00c6\u00ea\u008a \u00cc\u00cd\u00be\u00e8\u00ba\u00f1 \u00cc\u00cd \u00a8\u00e5\u00c8\u00e9\u00be \u00b0\u00c8\u00e5\u00ca \u00ba\u00eb\u00ce \u00c9\u00aa\u00e5\u00c9 \u00c0\u00bc\u00be\u008a\u00a8\u00c7\u00aa\u00ba\u00e0 \u009e\u00c9\u00c7 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00c6, \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6\u00a8\u00f8\u00d7\u00c4, \u00cc\u00e2\u00c7\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00e8\u00c4\u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00cc\u00e6\u00c8\u00cc\u00ea\u008a \u00cc\u00cd \u00c9\u00e6\u00b6\u00cc\u00b4\u00cd\u00be\u00e0 \u00cc\u00a8\u00cc\u00e0 \u00a8\u00c7\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 ;\u201d ; \u00cc\u00cd\n\n(5) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a6) \u00ef\u00d8\u00bc\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n6.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 12 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089:\u2013\n\n(1) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c\u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cd\u00e5 \u00cc\u008a\u00c0\u00ba\u00e0 \u00cc\u00e4\u00a8\u00e0\u00cb\u00b8\u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00c7 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4;\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cd\u00e5\u00cc\u008a\u00c0\u00ba\u00e0 \u00cc\u00e4\u00a8\u00e0\u00cb\u00b8 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00c7 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4\u00b4 \u00cc\u00cd \u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4\u00b4 \u00cc\u00cd\u00e5\u00c6 \u00d1\u00c4;\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(2) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00c6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2013\n\n\u201c(\u00a1\u00e6) \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5\u00c9 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5 \u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4, \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be\u00c6\u00e5\u00c4 \u00cc\u00cd\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4. \u201d .\n\n7.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 13 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00a1\u00ba\u00c7, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2013"
