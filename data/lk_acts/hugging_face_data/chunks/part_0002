    "chunk_text": "(\u00a4) \u00ac\u0081\u00bd\u00c8\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u008c\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u0088\u0081\" \u00af\u00b5\u00af\u00c6\u00d0\u00b9\u00c6\u00da\u00b6\u00c6\u00b6\u00af+\u00c6\u00af\u00bf\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00a4\u00c1\u00b5\u00b6\u00c6\u00b6\u00c8\u0081\u00f2\u00be\u00b9\u00c6\u0089\u00bc\u00b6\u00c8\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u008c\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u0088\u00be\u00c6\"\u00af\u00b5\u00af\u00c6\u00d0\u00b9\u00c6 \u00da\u00b6\u00c6\u00b6\u00af+\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00a4\u00c1\u00b5\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u00a3\u00b4+\u00c6\u00af\u00c8\u00dc\u00bf\u00c6\u00bf \u008c\u00b9\u00bc+\u00c6\u00af\u00bf\u00c8\u0081 \u0089\u00bc\u00b6\u00c8\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00af\u00c7\u00ae\u0089\u00af\u00c6\u00d0\u00ba\u00c7\u00de \u00a9\u00c1\u00c6\u008c\u00b4\u00b6\u00c6\u00b6\u00c8\u00df\u00ba\u00c6\u00c1\u00df\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00c7\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c627\n\n17\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 83 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00bd\u00c6\u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n(1) \u201c\u00af\u00be\u00c6\u008c\u00b6\u00c6 \u00b6\u00c7\u00b9\u00b8\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00c1\u00ce\u00bc\u008c\u00be\u00af\u00c6\u00af\u00b5\u00b6\u00c6\u00b6\u00c8\u0081 \u00db\u0088\u008c\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c(\u00a6) \u00b6\u00af\u00c1\u00be\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00d9\u00b4\u00c6\u00b9\u008c\u00bb\u00be\u00c6\" \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b9\u008a\u00bd\u00c6\u00b1\u00c8\" \u00db\u00af\u00c7\u00ce\u00ba\u00b9\u00c6 \u00b9\u008a\u00bd\u00c6\u00b1\u00c8\" \u00cd\u00b6\u00bc\u00c6\u00b1\u00c6\u00b1\u00c8\u00af\u00bf\u00c6 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u00d5 \u00cd\u00c1\u00ce\u00be\u00c1\u00c7\u00bb\u00c6\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00b8 \u00b9\u008a\u00bd\u00c6\u00b1\u00c8\" \u00da\u00b4\u00ce\u00c1\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00df\u00ba\u00c6 \u00a4\u00ce\u00b4\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00df\u00ba\u00c6\" \u00b6\u00c7\u00b6\u00c8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\" \u00a7\u00b5\u00e2\u00b9\u00b6\u00b8\u00c8\u00d5\u00ce\u00af\" \u00af\u00ba\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\" \u00cc\u00b9\u00dd\u00b7\u00c6\u00cd\u00b6\u00c7\u00b4\u00c6\u00b4\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00ce\u00af\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00a9\u0081\u00bd \u00d7\u00ce\u00bd\u00af\u00bf\u00c8\u00be\u00c6 \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b9\u008a\u00bd\u00c6\u00b1\u00c8\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7\u00cc\u00b1\u00bb\u00be\u00c6\u00db\u00ce\u00bd\u00b9\u00c6 \u00b9\u008a\u00bd\u00c6\u00b1\u00c8\u00ce\u00bb \u00c1\u00c0+\u00c6\u00af\u00c8\" \u00b9\u00b6\u00c8\u00ce\u00b8\u00b7\u00c6\u00d7\u00ba\u00c8\u00be\u00c6\u008b\u00bb\u0081 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6 \u00a4\u00af\u00af\u00c6\u00d0\u00ce\u00bd\u00b7\u00c6\u00b6\u00cc\u00c1\u00c7\u00dd \u00db\u00b6\u0095\u00b4\u00c6\u00d5\u00b4\u0081\" 1978 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u00814\u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af \u00db\u00b6\u0095\u00b4\u00c6\u00d5\u00b1\u00c6 \u00b1\u00ce\u00b9\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 17 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u00db\u00b6\u0095\u00b4\u00c6\u00d5\u00b1\u00c6 \u00b1\u00ce\u00b9\u00dc\u00b4\u0081 \u00a7\u00b4\u0081\u00b9\u0088\u00af\u00c6\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00d7\u00cc\u00af\u00c7\u00ae\u00d5\u00bf\u00c6\u00bf \u00b7\u00c8\u00de\u00c1\u00b8\u00cc\u00ba\u00c7\u0081\u00de\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\u201d\n\n(2) \u201c\u00b7\u00c8\u00bb\u00ba \u0096\u00b6\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00b6\u0081 \u00c1\u00ce\u00bc\u008c\u00be\u00af\u00c6\u00af\u00b5\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u201c\u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u201c\u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00df\u00ba\u00c6\" \u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00df\u00ba\u00c6\"\u00b7\u00c7\u0081\u00af\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00df\u00ba\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 ;\n\n(3) \u201c\u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u201d \u00a9\u0081\u00b9\u00b6\u0081\u00c1\u00ce\u00bc\u008c\u00be\u00af\u00c6\u00af\u00b5\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\" \u00b9\u00b7\u00c6\u00b6\u00c8 (\u00a3)\u008c\u0081 (v) \u00a4\u00ba\u00c6\u008c\u00b4\u00bb\u00b6\u00c6\u00ce\u00b6 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8\u00b1\u00c6\u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :-\n\n\u201c(vi) \u008c\u00b4\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00cd\u00af\u00bd\u00c6\u00b9\" \u00da\u00b4\u00ce\u00c1\u00b9\u00c6 \u00b9+\u00c6\u00af\u00c9\u00b4\u00c6\u00d5\u00b1\u00c6 \u00b1\u00ce\u00b9\u00dc\u00b4\u0081\u00a3\u00be\u00c6\u00be\u00d7 \u00aa\u00bd\u00c6\u00de\u00ba\u00b6\u00c8 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00b1\u00c6 \u00b1\u00ce\u00b9\u00dc\u00b4\u0081\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008183 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c628\n\n\u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c7\u00bf\u00c6\" 2 \u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u0081 (2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a5) \u00a3\u00be\u00c6\u00be\u00d7 (\u00a6)\u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00da\u00b4\u00ce\u00c1\u00b9\u00c6 \u00b9+\u00c6\u00af\u00c9\u00b4\u00c6\u00d5\u00b1\u00c6 \u00b1\u00ce\u00b9\u00dc\u00b4\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00aa\u00bd\u00c6\u00de\u00ba\u00b6\u00c8\u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00b1\u00c6 \u00b1\u00ce\u00b9\u00dc\u00b4\u0081 \u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00aa\u00bd\u00c6\u00de\u00ba\u00b6\u00c8\u00bb\u00c7\u00bf\u00cc\u00bc\u00c7\u00dd\u00c1\u00dd\u00af\u00c6\u00d0 \u00c1\u00c0+\u00c6\u00af\u00be\u00c6\u00af\u00ce\u00bf\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd\u008c\u00b4\u00b6\u00c6\u00d7\"\u201d\u00b0\n\n18\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b8 \u00db\u00b6\u00be\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\"II \u00a4\u00ba\u00c6 \u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00bd\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n(1) (\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\"\u2013"
