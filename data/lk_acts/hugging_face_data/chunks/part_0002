af\u00ba\u00c6 \u00a6\u00bc\u00c7\u008a\u00bc\u00ba\u00c7\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00b1\u00b8\u00c1\u00bc\u00c8\u00ba\u00c7\u00b6\u00ba\u00c6 \u00b9\u00b6\u00c6\u00b6\u00c7\u00ba\u00c6 \u00b7\u00c7\u00bf\u0081\u00de \u00cd\u00ba\u00bd\u00c6\u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00ba\u00c1\u00c7\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b8\u00ce\u00af\u00cc\u00bb\u00c7\u00b9\u00c6\u00b9\u00b6\u00c7\u00bc\u00bc\u00c7\u00af \u00c1\u00b7\u00c6\u00d7 \u00a6\u00bc\u00c7\u008a\u00bc\u00ba\u00c7\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00cc\u00b1\u00b6\u00c6\u00cc\u00b6\u00ba\u00c6\u00b9\u00bc\u00c6\u00ba\u00c7\u00b6\u00ba\u00c6 \u00a9\u00b4\u00c6\u00b4\u00c7\u00ba\u00c6 \u00b7\u00c7\u00bf\u0081\u00de \u00a3\u00b6\u00ce\u00b8 \u00a7\u00de\u00b6\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8\u00bb\u00b6\u00c7\u00b6\u00be\u00c7\u00df\u00ba\u00c6:\n\n\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00cd\u00ba\u00bd\u00c6\u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00ba\u00c1\u00c7\u00bb\u00ba\u00c6\" \u00a6\u00bc\u00c7\u008a\u00bc\u00b6\u00c6\u00d7 \u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6\u00a4\u00ae\u00d5 \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 \u00ba\u00c7\u00b6\u00ba\u00c6 \u00b9\u00b6\u00c6\u00b6\u00c7\u00ba\u00c6 \u00b7\u00c7\u00bf\u0081\u00de \u00a5\u00be+\u00c6\u00ce\u00af \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6\u00c1\u00df\u00e2\u00af\u00c6\u00d0 \u00c1\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf\u00b6\u00c7\u00b6\u00be\u00c7\u00df\u00ba\u00c6 :\n\n\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00cd\u00ba\u00bd\u00c6\u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00ba\u00c1\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0\u00bf\u00c6\u00bf\u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00bb\u0081\u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0 \u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bc\u00b1