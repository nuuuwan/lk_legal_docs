    "chunk_text": "(\u00a4) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a8) \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 2002\"\u00b7\u00cc\u00c1\u00ba\u00c6\u00b9\u00bc\u00c6 06 \u00a4\u00b7\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081\u0089\u0081\u00b8\u00bc\u00c6\u008c\u00be\u00af\u00c6\u00af\u00bf\u00c8\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00de\u00af\u00c6\u00d0 \u00b6\u00ce\u00af\u00ce\u00ba\u00dc\u00ce\u00b4\u00bb\u00b6\u00c7\u00af \u00a3\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00b8\u00c7\u00be\u00c62004\" \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 01 \u00a4\u00b7\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081\u0089\u0081\u00b8\u00bc\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9+\u00c6\u00af\u00c8\u00be\u00c7\u00b9\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b6\u00c7\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c640\n\n11\u00b0 (1) \u0089\u0081\u00c1\u00dd\u00c1\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8 \u00c1\u00bc\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u008c\u00be\u00af\u00c6\u00af\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\u2013\n\n(\u00a4)\u00a9\u00b7\u00c6\u00b6 \u0096\u00b4\u00c6\u0088\u008b\u00dd\u00b7\u00c6\u00d7 \u00af\u00c8\u00ce\u00b4\u00af\u00c6\u00d0\u00ba\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00ba\u00c6\" \u00a5\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a4) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081\u00af\u00c9\u00c0\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8 \u00c1\u00bc\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7\u008c\u00be\u00af\u00c6\u00af\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c7\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u008c\u00be\u00af\u00c6\u00af\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00bc\u00c7\u00d7\u00a7\u00bf\u00c6\u00bf\u00cd\u00b6\u00c7 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a9\u00b7\u00c6\u00b6 \u0096\u00b4\u00c7\u00b8\u00d7 \u00a5\u00bc\u00ae\u00d5 \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00c1\u00bd\u00c6\u00de\u00af\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00b6\u00c8\u008c\u00b4+\u00c6\u00af\u00bf\u00c7\u00af \u00ba\u00c7\u00bd\u00c6\u00bd\u00c8\u00bb\u00ce\u00ba\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6 \u0096\u00b4\u00c6\u0088\u0081 \u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00af\u00c6\u00af\u00c7\u00bc\u00dd\u00af\u00c6\u00d0\u00b1\u00c6\u00cd\u00b1\u00dd\u00ba\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00db\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00b6\u00c8\u008c\u00b4\u00ba\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u0081\u00de\u00ba\u00c6 \u0096\u00b6\u00c1\u00bc\u00c8\u00af\u00bf\u00c8\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af \u00b6\u00b8\u00c8\u00b6\u00c6\u00b6\u00b8\u00c8\u00bb\u00c7\u00af\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00b6\u00c8\u008c\u00b4\u00ba\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u0081\u00bd\u00c8\u00df\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7 \u00cd\u00b1\u00dd\u00ba\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00ba\u00c7\u00b8\u00d7\"\n\n(i) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00b6\u00c8\u008c\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b6\u00bf\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00da \u00a4\u008a\u00bc\u00ba\u00c6\u00b1\u00d7\u00bc \u00a3\u0088\u00af\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c7\u00b6\u00c8\u00dd\u00b9\u00c6\u0089\u0081\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00ba\u00c7\u00bd\u00c6\u00bd\u00c8\u00bb\u00ce\u00ba\u00b6\u00c6\u00b6\u00be\u00c6 \u00a9\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00be\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00d5\u00af\u00c6\u00af\u00c7\u00b8\u00b6\u00c7\u00af\u00e2\u00ba\u00c6\" \u00a3\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00ce\u00b4\u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00c1\u00dd\u00ba\u00c6\" \u00ab\u00b7\u00c6\u00d7 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c7\u00b8\u00b6\u00c7\u00af\u00e2\u00ba\u00c7\u00b8 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(ii) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00b6\u00c8\u008c\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00bf\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00da \u00a4\u008a\u00bc\u00ba\u00c6\u00b1\u00d7\u00bc \u00a3\u0088\u00af\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00af\u00e2\u00ba\u00c6 \u00a4\u00b8\u00c7\u00be\u00c6\u00a5\u00bc\u00ae\u00b4\u00c7\u008a\u00bc\u00ba\u00c6 \u00b1\u00d7\u00bc \u00a3\u0088\u00af\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c7\u00b6\u00b6\u00c7\u00af\u00e2\u00ba\u00c8\u00dd\u00b9\u00c6\u0089\u0081\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00ba\u00c7\u00bd\u00c6\u00bd\u00bb\u00ce\u00ba\u00b6\u00c6\u00b6\u00be\u00c7\u00b8\u00d7\u00a9\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00c7\u00a3\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00d5\u00af\u00c6\u00af\u00c7\u00b8\u00b6\u00c7\u00af\u00e2\u00ba\u00c6\" \u00a3\u00b7\u00c6\u00b6\u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00ce\u00b4 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00c1\u00dd\u00ba\u00c6 \u00f2\u0081\u00de\u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8\u00b6\u00c7\u00af\u00e2\u00ba\u00c7\u00b8\"\n\n\u00a3\u00b7\u00c6\u00b6 \u0096\u00b4\u00c6\u0088\u0081 \u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00af\u00c6\u00af\u00c7\u00bc\u00dd\u00af\u00c6\u00d0\u00b1\u00c6 \u00cd\u00b1\u00dd\u00ba\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00db\u00ba\u00c6\u00b0\n\n(\u00a5)1973 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 25 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u008c\u00ce\u00bf\u00bb\u00c7\u00b4\u00c6\u00d5\u00af\u00c6\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u008c\u00ce\u00bf\u00bb\u00c7\u00b4\u00c6\u00cc\u00b4\u00c7\u0081\u00cc\u00bd\u00b8\u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u008c\u00ce\u00bf\u00bb\u00c7\u00b4\u00c6\u00ce\u00b4 \u00a8\u00af\u00c6\u00d0\u008c\u00b6\u00c6\u00b6\u00ce\u00be \u00a3\u0088\u00b9\u00c6\u00b9\u00ce\u00b4\u00af\u00c6 \u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c7\u00af\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u00b4 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6\n\n\u00af\u00c7\u00b5\u00c8\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00ba\u00c6\u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u0081 \u00ba\u00c9\u00b6\u00c7\u00b8\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00ba\u00c6\u00af\u00c8\u00ce\u00b4\u00b6\u00c6\u00b6\u00d0\u00bd\u00c8\u00b6\u00c6\u00b6\u00b1\u00c8\u00be\u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00e0\u00ba\u00c6\u00c1\u00dd\u00ba\u00c7\u00b8\u00db\u00ba\u00c6\u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7\u008c\u00be\u00af\u00c6\u00af\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c641\n\n\u00d0\u00e1\u00cc\u00c1\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00ba\u00c7\u00b8\u00ce\u00c1\u00dc\u00ba\u00c6\" \u00a3\u00af\u00c6\u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00e0\u00af\u00c6\u00af\u00c7\u00af \u00a3\u00b7\u00c6\u00b6 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00d0\u00e1\u008c\u00b8\u00c7\u00be\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b9\u00ce\u00c1\u00dc\u00ba\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00c7\u00b5\u00c8\u008a\u00b8\u00d7\u00ba\u00c6 \u00a3\u00b6\u0081\u00ba\u00c9\u00b6\u00c7\u00b8\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6+\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00cd\u00b6\u00bd\u00c8\u00bb \u00a4\u00ae\u00d5\u00b9\u00c6 \u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00b0"
