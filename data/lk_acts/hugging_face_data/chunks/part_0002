    "chunk_text": "(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9,\u201c\u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u201d \u00c6\u00be\u00e0\u00be \u00ef\u00c6\u00ef\u00bc\u00be \u0097\u00b4, \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be\u00c6\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u0097\u00f3\u00c8\u00e8\u00c2\u00c8 \u00a4\u00ba\u00e0\u00c0\u00e5\u00bc\u00be\u00c6, \u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6, \u0097\u00ef\u00be\u00e5\u00e0\u00bc \u00a8\u00f2\u00e9\u00b6\u00e5,\u00aa\u00eb\u00bc\u008a \u00aa\u00ba\u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00ca\u00fb\u00ba \u00aa\u00c2\u00b6\u00e5, \u00a8\u00eb\u00b8\u00ea \u00a8\u00cc\u00c8 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7\u00a8\u00f8\u00d7\u00c4, \u00be\u00f8\u00c9\u00e5\u00cc \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8\u00e0 \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u00c4 \u00c6\u00be \u00c6\u0090\u00ba\u00c8 \u00c0\u00cd\u00cc\u00ea\u00a8\u008a\u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00ef\u00c6\u00cd\u00fa \u00ef\u00c6\u00bc\u00fb \u00cc\u00e8\u0090\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00cc\u00cd \u00a6\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fa\u00be\u00cc\u00e8\u00b4 \u00a6\u00a8\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a6\u00cd\u00fa \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00ce \u00c4\u00ea\u00dd \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0095\u00c8\u00e8\u00c6\u00be \u00bc\u00cd\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00a6\u00ef\u00cd\u00ba\u00e0 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0095\u00c8\u00e8\u00c6\u00be \u00c0\u00be\u00cd\u00a8\u00b4\u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n\u00c6\u0090\u00ba\u00c8 \u00c0\u00cd\u00cc\u00ea\u00a8\u008a\u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec\u00a1\u00e6\u00ba\u00e6\u008a \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0\u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n\u00cc\u00ea\u00dd \u00c0\u00d6\u00c4\u00e5\u00b8 \u00c6\u0090\u00ba\u00c8\u00c0\u00cd\u00cc\u00ea\u00a8\u008a\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00c6\u00be\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0\u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba44\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00b4 \u00cc\u00cd\u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00c8\u00c9 \u201c\u00be\u00c9 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u2013\n\n(\u00a1)\u00a6\u00c4 \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc;\n\n(\u00a1\u00e5)\u00ef\u00a8\u00e5\u00ce\u00c5 \u00cc\u00cd \u00aa\u008a\u00c0\u00cd \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8 \u00c9\u00c8\u00e8\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00c6\u008a\u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8 \u00c0\u00e8\u00cd\u00fa\u0090\u00c6\u00e5 \u00c9\u00ec \u00bc \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0\u201c\u00a1\u201d \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00ef\u00cd\u00e5\u00e0 \u201c\u00a1\u00e5\u201d\u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00e0\u00be\u00e5\u00c9\u00ec \u00bc;\n\n(\u00a1\u00e6)2008 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u2013\n\n(i)\u00a6\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6 \u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00c9\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e5\u00ef\u00c6\u00e0 \u00c3\u00e5\u0097\u00ba\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a\u00c0\u00e8\u00d6\u00c6\u00ba, \u00c6\u00be\u00e0\u00ef\u00ba\u00f2\u00e5\u00e0\u00c0\u00a8\u00c7\u00b8, \u00aa\u00ee\u00cd\u00c3\u00e5\u00b8\u00e0\u00b6, \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8\u00ef\u00cd\u00e5\u00e0 \u00a2\u00b6\u008a \u00cc\u00bf\u00cd\u00e5 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00c4\u00ea\u00bc\u00c8; \u00ef\u00cd\u00e5\u00e0\n\n(ii)\u00a6\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6, \u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be\u00ef\u00c9\u00be\u00ba\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e5\u00ef\u00c6\u00e0\u00c3\u00e5\u0097\u00ba\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00c0\u00e8\u00d6\u00c6\u00ba, \u00c6\u00be\u00e0\u00ef\u00ba\u00f2\u00e5\u00e0\u00c0\u00a8\u00c7\u00b8,\u00aa\u00ee\u00cd\u00c3\u00e5\u00b8\u00e0\u00b6 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00a8\u00c7\u00be \u00c8\u00bc \u00c4\u00ea\u00bc\u00c8,\n\n\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0095\u00c8\u00e8\u00c6\u00be \u00ba\u00f8\u00cd\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc;\n\n(\u00a1\u00e7)\u00a8\u00c8\u00e8\u00be\u00e0 \u00c0\u00e6\u00c9\u00ba\u00f8 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00a8\u00e6\u009c\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ba\u00f8\u00be\u00f8\u00da\u00c4\u00e5\u00be\u00c6\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u00c4\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec \u00bc;\n\n(\u00a2) 2008 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00c6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00bc\u00fb \u00cc\u00cd\u00a2\u00be\u00e0\u00c0\u00cc\u00ea \u00a6\u00c4 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00ba\u00eb\u00c8\u00bc\u00e8\u00c4 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00e0 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c9 \u00cc\u00e8\u0090\u00ef\u00cc\u00e0\u00c9\u00a8 \u00cc\u00e2\u00a9\u00f1\u00e5\u00c9 \u2013\n\n(i)\u00a6\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6, \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00c6 \u00c8\u00c2\u00e5 \u00ef\u00bc\u00be\u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00be\u00e0 \u00cc\u00c0\u00c6\u00be \u00a8\u00b6\u00bc\u00e5\u00cc\u00e8 \u00c4\u00ba \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0\u00c6\u008a \u00a1\u00e6\u00cc\u00ea\u00c7\u00e6\u008a \u00f7\u00c9\u00f1\u00c6\u00be\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00c9\u00be \u0097\u00b4, \u00c0\u00be\u00cd\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00c9\u00be\u00e0\u00be\u00e5\u00c9\u00ec \u00bc;\n\n\u00c6\u008a \u00be\u00c9 \u00a8\u00e5\u00da\u0095\u00a8\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8 \u00c8\u00e5\u00c3\u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u008a\u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba45\n\n(ii)\u00a6\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6 \u00a2\u00cd\u00ba (i) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0\u00ef\u00be\u00e5\u00c9\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00c9\u00be \u0097\u00b4, \u00ef\u00bc\u00cc\u00e9\u00c6\u00a8\u00b4\u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc,\n\n\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c."
