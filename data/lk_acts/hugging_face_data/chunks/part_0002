    "chunk_text": "6.\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00a1\u00e5\u00a8\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00a8\u00b8\u00e8\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00c4\u00e6\u00b8\u00e8\u00a8\u00e0 \u00aa\u00c8\u00e0,\u00ef\u00c8\u00e5\u00e0\u00cd \u00ef\u00cd\u00e5\u00e0 \u00a9\u00be\u00f8\u00b0\u00ef\u00ba\u00c8\u00e0 \u00aa\u00e7\u00cc\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a9\u00be\u00f8\u00b0\u00ef\u00ba\u00c8\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00ef\u00cd\u00e5\u00e0\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00a1\u00be\u00ea\u00c4\u00ba \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00c8\u00e8\u00c6\u00a8\u00b4 \u00a6\u00c4 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00c6\u00b4\u00ba\u00e0\u00ef\u00be\u00e5\u00a8\u00c7 \u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00f2\u00cd\u00fa\u00ba\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3\u00fa\u00c6\u00a8\u00eb\u00a4\u00c0\u00bc\u00fa\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00e0\u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (42 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\u00cc\u00e8\u00c6\u00c6\u00b4 10\n\n3132006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba\n\n8.\u00cc\u00c4\u00e5\u00aa\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0, \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00c2\u00c8\u00c0\u00ba\u00f2 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e6\u009f\u008a\u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00e0 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (44\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00cc\u00e8\u00c6\u00c6\u00b4 10 \u00a8\u00b4\u00c0\u00c4\u00b8\u00a8\u00e0 \u00c6\u00b4\u00ba\u00e0 \u00c9\u00be\u00e0\u00ef\u00be\u00e0\u00be\u008a \u0095\u00cc, \u00cc\u00e8\u00c6\u00c6\u00b4 15\n\n9.\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea\u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec\u00bc 217 \u00c9\u00be \u00cc\u00cd 45 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c0\u00d6\u00bc\u00fa \u00a8\u00ee\u00cb\u00e8\u00a8\u00da\u00c4\u00c6, \u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6\u00ef\u00cd\u00e5\u00e0 \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00c9\u00e6\u00b6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00f8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c8\u00e5\u00c3 \u00c4\u00ba\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (45 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\n\n\u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00b4 \u00a1\u00be\u00ea\u00c9\u00a6\u00ef\u00cd\u00ba\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 15\u00a8\u00a4\u00c0\u00d6\u00c4\u00c6\u00a8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9\n\n10.\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec\u00bc 217 \u00c9\u00be \u00cc\u00cd46 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c0\u00d6\u00bc\u00fa \u00a8\u00ee\u00cb\u00e8\u00a8\u00da\u00c4\u00c6,\u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00c9\u00e6\u00b6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00f8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c8\u00e5\u00c3 \u00c4\u00ba \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (46\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\u00cc\u00e8\u00c6\u00c6\u00b4 15\n\n11.\u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba \u00be\u00f8\u00c9\u00e5\u00cc \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8 (47\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\u00cc\u00e8\u00c6\u00c6\u00b4 20\n\n12.17 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 19 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0\u00a8\u00c7\u00be \u00c8\u00bc \u00a1\u00e6\u00ba\u00e6\u008a \u00cc\u00c4\u00e5\u00aa\u008a\u00c9\u00c8\u00b4 \u00a6\u00c4 \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0\u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00a6\u00ce\u00ef\u00c5\u00be \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ef\u00bc\u00a8\u00a8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0\u00cc\u00bf\u00cd\u00e5 \u00a1\u00bc\u00e5\u00ce \u00c9\u00be \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (48 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\u00cc\u00e8\u00c6\u00c6\u00b410\n\n13.\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4 18 \u00ef\u00cd\u00e5\u00e0 22 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4 \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00c9\u00cc\u00be\u00e0 \u00d1\u00ef\u00c4\u00be\u00e0\u00c0\u00cc\u00ea\u00c9 \u00a1\u00e6\u00ba\u00e6\u008a \u00cc\u00c4\u00e5\u00aa\u008a\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c9\u00be \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00be\u00ea \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6(48 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\u00cc\u00e8\u00c6\u00c6\u00b4 15\n\n14.\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4 17 \u00ef\u00cd\u00e5\u00e0 19 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c9\u00be \u00cc\u00cd \u00cc\u00e8\u00c6\u00c6\u00b4 10 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 15 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u00c9\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00bc\u00fb \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a2\u00a8\u00eb\u00ba\u00e0 \u00c9\u00ec \u00c0\u00cc\u00ea\u00c9 \u00a1\u00e6\u00ba\u00e6\u008a\u00cc\u00c4\u00e5\u00aa\u008a\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c9\u00be \u00c6\u008a \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00be\u00ea \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (48\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\u00cc\u00e8\u00c6\u00c6\u00b4 20\n\n3142006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba\n\n15.46 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00ca\u00f2\u00e9\u00c8\u00e2\u00a8\u00e5\u00c9\u00b4 \u00c2\u00e6\u00cd\u00e6\u00d6\u00be\u00e0 \u00c8\u00e6\u009f \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c9\u00c8\u00b4 \u00cc\u00cd 54\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3\u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (49 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 54 \u00cc\u00cd 55 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8)\n\n2003 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00e5\u00c7\u008a\u00c3\u00c9\u00be \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00cc\u00e8\u00c6\u00c6\u00b4 10"
