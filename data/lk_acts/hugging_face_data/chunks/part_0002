0b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n2\u00b0 (1) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00cd\u00bc \u00b6\u00d0\u00b6\u00c8\u00c1\u00c7\u00bb\u00c6\u00b7\u00c6\u00b6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00c8\u00bb\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00d0\u00b6\u00c8\u00c1\u00c7\u00bb\u00c6\u00b7\u00c6\u00b6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00d0 \u00a3\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a3\u00be\u00c6\u00be\u00d7 \u00d2\u00ba\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00bd\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00d7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00b6\u00b6\u00c6\u00d7\u00c1\u00b6\u00c6\u00ce\u00b6\" \u00b9\u00b5\u00c8\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00b4\u00ce\u00ba\u00ce\u00bb\" \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00b6\u00c8\u00ce\u00b5\u00af\u00c6\u00af\u00bf\u00b6\u00c6\u00b6\u00c8\u0081 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a3\u00df\u00c1\u00be\u00dd\u00af\u00c6\u00d0\u00b6\u00c6 \u00b6\u00d0\u00b6\u00c8\u00c1\u00c7\u00bb\u00c6\u00b7\u00c6\u00b6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00c8\u00ce\u00af\u00bb\u00bf\u00c8\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n3\u00b0 (1) \u00a5\u00bc\u00ae\u00b4\u00c7\u008a\u00bc\u00b6\u00c6\u00ce\u00b6\u00b7\u00c6\u00b6\u00c7\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00ad\u00af\u00b6\u00c6\u00d7 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00cc\u00b6\u00c7\u00b4\u00af\u00c6\u00af\u00ba\u00c6\" \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00df\u00bf\u00c6\u00bf \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00b6\u00dd\u00b7\u00bc\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00c1\u00dd\u00ba\u00c6\" \u00a3\u00c1\u00bc\u00c7\u00be\u00c6 \u00cd\u00c1\u00ce\u00be\u00af\u00c6\u00af\u00ba\u00bc\u00c6\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00cd\u00c1\u00ce\u00be\u00bb\u00c7\u00bf\u00c6\u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00c1\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00ba\u00c7\u00b6\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00df\u00ba\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6\u00a3\u0088\u00b9\u00c6\u00b9\u00ce\u00b4\u008a\u00be\u00c6 \u00af\u00b5\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00bc\u00e2 \u00cc\u00b1\u00be\u00e2\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4 \u00b7\u00c8\u00c1\u00c7\u00bc\u00b5\u00b9\u00c6\u00b9\u0088\u00cc\u00bb\u00c7\u0081\u00ce\u00bd (\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u201c\u00b9\u0088\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\u2013\n\n(\u00a3)\u00a5\u00dd\u00b9\u00b6\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00c1\u00c7\u00b8\u00cc\u00b6\u00c7\u00ce\u00af\u00ce\u00bb \u00a8\u00b6\u00c8\u00bb\u00ba\u00c7\u00af\u00b9\u00c6 \u00cc\u00b9\u00de\u00ba\u00c6 \u00cd\u00c1\u00ce\u00be\u00bb\u00c7\u00bf\u00c6\u00ac\u00dd\u00c1\u00bc\u00c8\u0081 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00b9\u0088\u00a4\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00c1\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\n\n\u00b6\