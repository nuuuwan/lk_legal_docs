    "chunk_text": "\u00ef\u00c0\u00f2\u00e0\u00cb\u00be\u00c6 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00be\u008a, \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c0\u00d6\u00bc\u00fa \u00c9\u00ec \u00a6\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0\u00c2\u00e6\u00cd\u00e6\u00c7\u00c9 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00c0\u00c6\u00be \u00c8\u00bc \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0\u00c2\u00e6\u00cd\u00e6\u00c7\u00c9 \u00bc\u00c7\u00be \u00c8\u00bc \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u0097\u00c6\u00bc\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00cc\u00e5\u00bd\u00e5\u00c7\u00b8\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea \u00a2\u00ba\u00f8\u00d6 \u00a6\u00e0 \u00c8\u00e5\u00c3 \u00cc\u00cd\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 ;\n\n(\u00a2)\u00c6\u008a \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u00a8, \u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u00a8, \u00c0\u00e5\u00b5\u00ca\u00e5\u00c8\u00e5\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be\u00f8\u00a8 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00a2\u00ef\u00aa\u00be\u00f9\u00c4 \u00c8\u00c2\u00be\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00ca\u00fa\u00cb\u00f1\u00ba\u00e0\u00c9\u00c6\u00a8\u00f8\u00be\u00e0, \u00a1\u00be\u00ea \u00ca\u00fa\u00cb\u00f1\u00ba\u00e0\u00c9\u00c6\u00a8\u00f8\u00be\u00e0, \u00a1\u00e5\u00bd\u00e5\u00c7\u00ca\u00fa\u00cb\u00f1\u00ba\u00e0\u00c9\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c4\u00e5\u00be \u00a1\u00bd\u00f1\u00e5\u00c0\u00be\u00f8\u00a8 \u00c0\u00d6\u00ba\u00f1\u00e5\u00aa\u00c6\u00a8\u00f8\u00be\u00e0\u00a4\u00c0\u008e\u00ba \u00c9\u00be \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 ;\n\n(\u00a3)\u00c4\u00c7\u00b8 \u00c0\u00e5\u00d6\u00ef\u00ba\u00e5\u00e0\u00cb\u00e8\u00a8\u00c6\u00be\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0, \u00c4\u00c7\u00b8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00eb\u00c9\u00e5\u00c8\u00cc\u00e8\u00f3\u00d1\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be\u00e0\u00bc\u00fa\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c8\u00c2\u00e5\u00aa\u00ba\u00e0 \u00c6\u008a\u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 ;\n\n(\u00a4)\u00a6\u00a8\u00e0\u00cc\u00ba\u00e0 \u00c7\u00e5\u00b0\u00bd\u00e5\u00be\u00f8\u00ef\u00c6\u00e0 \u00c4\u00cd\u00e5 \u00c7\u00e5\u00d4\u00be\u00f8\u00c6\u00ef\u00aa\u00e0 \u00cd\u00c4\u00ea\u00bc\u00e5\u00c9\u00c8\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00fa\u00b4\u00c0\u00ea \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00b4 \u00ef\u00bc\u00be\u00ea \u00c8\u00c2\u00be\u00ba\u00eb\u00c9\u00e5\u00c8 \u00cd\u00e5 \u00a1\u00ca\u00a8\u00e0\u00be\u00ea\u00ba\u00e5 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 ;\n\n(\u00a4\u00f0)\u00a6\u00a8\u00e0\u00cc\u00ba\u00e0 \u00b0\u00be\u00c0\u00bc \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a1\u00ca\u00a8\u00e0\u00be\u00ea\u00ba\u00e5 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 ;\n\n(\u00a6)\u00c7\u00be\u00e0, \u00c4\u00e6\u00b8\u00e8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e0\u00c9\u00da\u00b8\u00e5\u00c3\u00c7\u00b8 \u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a4\u00c0\u008e\u00ba \u00c9\u00be 3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1)\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c9\u00ec \u00c6\u008a \u00c8\u00e5\u00c3 \u00cd\u00e5 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a ;\n\n(\u00a6\u00e0)\u00c4\u00e6\u00b8\u00e8\u00a8\u00e0 \u00cd\u00e5 \u00cc\u00e0\u00c9\u00da\u00b8\u00e5\u00c3\u00c7\u00b8 \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0 \u0097\u00ef\u00bc\u00e0\u00ca \u00c9\u00f1\u00c9\u00cd\u00e5\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8\u00e8\u00be\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00c2\u00c8\u00c6 \u00c0\u00c9\u00c7\u00be \u00c8\u00bc \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4, \u0097\u00ef\u00bc\u00e0\u00ca \u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0\u00c8\u00e6\u00ef\u00c2\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc ;\n\n(\u00a7)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00b0\u00be\u00e5\u0093\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00bc \u00c6\u008a \u00ba\u00f1\u00e5\u00aa\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 ;\n\n(\u0081)\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00be\u00c9 \u00be\u00f8\u00c0\u00e6\u00c6\u00ea\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c3\u00e5\u00c7\u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00c6\u008a \u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8\u00c6\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00aa\u00e6\u00be\u00f9\u00c4\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00c2\u00e5\u00aa\u00ba\u00e0 \u00ba\u00f1\u00e5\u00aa \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 ;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba35\n\n(\u00a8)1978 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00b0\u00be\u00e5\u0093\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba\u00f8\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00b0\u00be\u00e5\u0093\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00bc \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 ;\n\n(\u00aa)1985 \u00a1\u00e2\u00a8 9 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00c0\u00be\u00ba\u00f8\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00bc \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 ;\n\n(\u00ae)1985 \u00a1\u00e2\u00a8 21 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u0097\u00ef\u00bc\u00e0\u00ca \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00c6 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u0097\u00ef\u00bc\u00e0\u00ca \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8 \u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00e5\u00c4\u00b4\u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00ef\u00cd\u00e5\u00e0\u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00b4 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6 \u00c8\u00c2\u00e5\u00ef\u00bc\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c8\u00cc\u00e5 \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00ca\u00f2\u00e9 \u00c8\u00e5\u00e2\u00a8\u00e8\u00a8\u00c6\u00a8\u00eb \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00c0\u00e5\u00c7\u00c6\u00a8\u00b4 \u00a6\u00a8\u00f9 \u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ba\u00eb\u00be\u00e0\u00bc\u00cd\u00cc\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc ;"
