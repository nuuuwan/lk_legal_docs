    "chunk_text": "\u00a4\u008a\u00d9\u00ba\u00c6\" \u00b1\u00ce\u00b9\u008a\u0081 \u00b1\u00c7\u00ce\u00be\u00cc\u00bb\u00c7\u0081\u00de\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00d2\u00c1\u00ae\u0088\u00b7\u00c8\u00ce\u00be\u00bb\u00cc\u00ba\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00b8 \u00a3\u00df\u00c1\u00be\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c8\u0081 \u00b9\u00b6\u008c\u00c1\u00bc\u00c8\u00ce\u00b1\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6 \u00b1\u00ce\u00b9\u008a\u0081 \u00a3\u00be\u00c1\u00be\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00a4\u00bf\u00c6 \u00db\u00bd\u00c8\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00de\u00c1\u00b6\u0081\u00ba\u00c9\u00d7 \u00a3\u00b7\u00c6\u00b6 \u00a3\u00df\u00c1\u00be\u00bc\u00c6\u00b9\u00b5\u00c8\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00de \u0089\u00ce\u00b5\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00de\u00b4\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u0089\u00ce\u00b5\u008a\u00be\u00c6\u00be\u00c7\u00ba\u00be\u00c6 \u00a3\u00c1\u00bc\u00c6 \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u0088\u0081 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7 \u00b7\u00c9\u00b6\u00c8\u00c1\u00c7\u00cc\u00b8\u00c7\u00dd\u00c1\u00bc\u00c6 \u00db\u0081\u00b8\u00c8\u00ce\u00be\u008a\u00be\u00c6\u00cd\u00b6\u00c7\u00bd\u00c6\u00de\u00c1\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u008c\u00d5\u008c\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n\u00b6\u00c1\u00bd\u00c7\u00bf\u00bc\u00c6\u00af\u00ce\u00bf\u00af\u00c6\u00ce\u00af\u00d7 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 27 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b9\u00c6\u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00d7\u00b1\u00c6 \u00b1\u00ce\u00b9\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c622\n\n\u00b9\u00c7\u00af\u00ba\u00c6 V\n\n\u00cc\u00b9\u00c7\u00d7\n\n29\u00b0 (1)(\u00a3)\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00b1\u00ce\u00b9\u00bb\u00c7\u00be\u00c6 \u00b7\u00be\u00c6\u00cc\u00be\u00ae\u00b5\u00b6\u00c6\u00d7\u00b4\u0081 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b1\u00bb\u00df\u00af\u00c6\u00af\u00c7\u00af\u00b1\u00ce\u00b9\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4)\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b1\u00ce\u00b9\u008a\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00b5\u00c8\u00b9\u00c6\u0089\u0081\u00ba\u00c9\u00d7 \u00b1\u00ce\u00b9\u008a\u0081 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c7\u00be\u00c6\" \u00a3\u00df\u00c1\u00be\u00bc\u00c7\u00be\u00c6\" \u00cd\u00b1\u00ce\u00c1\u00bb\u00c7\u00bf\u00bc\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00db\u00af\u00c1\u00bc\u00c7\u00be\u00c6 \u00b7\u00be\u00c6\u00cc\u00be\u00ae\u00b5\u00b6\u00c6\u00d7\u00b4\u0081 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b1\u00bb\u00df\u00af\u00c6\u00af\u00c7\u00af \u00a3\u00c1\u00dd\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\"\n\n\u00d0\u00bd\u00c6\u00bd\u00c1\u00c0\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00d7\u00b4\u00bc\u00c6\u00b1\u00c6\u00b1\u00c8 \u00a9\u00d7\u00e2\u00ba\u00c6 \u00a5\u00dd\u00b6\u00c6\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n(2) \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00db\u0081\u00b8\u00c8\u00ce\u00be\u008a\u00be\u00c6 \u00b1\u00ce\u00b9\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u00af\u00c6\u00cc\u00af\u00c7\u00b5\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00d0\u00bd\u00c6\u00bd\u00c1\u00c0\u00af\u00c6\u00af\u00c8\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00d7\u00b4\u00bc\u00c6\u00b1\u00c6\u00b1\u00c8\u008a\u00be\u00c6\u00b1\u00ce\u00b9\u00bb\u00c7\u00be\u00c6 \u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b1\u00be\u00e2 \u00b1\u00ce\u00b9\u008a\u0081 \u00b7\u00c8\u00b6\u00c8\u00bb+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00d7\u00b4\u00bc\u00c6\u00b1\u00c6\u00b1\u00c8\u008a\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00bd\u00c6\u00bd\u00c1\u00c0\u00af\u00c6\u00af\u00c8\u00be\u00c6 \u00b1\u00ce\u00b9\u00af\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00b8\u00c7\u00be\u00c6 \u00a3\u00bd\u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00cc\u00b1\u00be\u00e2\u00af\u00bf\u00c6\u00b1\u00ce\u00b9\u008a\u0081 \u00b7\u00c8\u00b6\u00c8\u00bb+\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00c1\u00bc\u00e2\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(3) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b1\u00ce\u00b9\u008a\u0081 \u00b9\u00b5\u00c8\u00b9\u00c6\u0089\u0081\u00ba\u00c9\u00d7\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00af\u00af\u00c6\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b1\u00bb\u00be\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a3\u00c1\u00dd\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00db\u0081\u00b8\u00c8\u00ce\u00be\u008a\u00be\u00c6 \u00cc\u00af\u00c7\u00b5\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00d7\u00b4\u00bc\u00c6\u00b1\u00c6\u00b1\u00c8\u008a\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00bd\u00c6\u00bd\u00c1\u00c0\u00af\u00c6\u00af\u00c8\u00be\u00c6 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6\n\n\u00b1\u00ce\u00b9\u00dc\u00b4\u0081\u00ac\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6+\u00c6\u00af\u00bf\u00c6\u00cc\u00b1\u00bb\u00c6\u00d7\u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00af\u00c6\u00af\u00ba\u00c6\u00b9\u00b8\u00c8\u00af\u00e0\u00af\u00c6\u00d0\u00bf\u00c6\u00bf\u00b6\u00b6\u00c6\u00d7\u00c1\u00ba\u00c6\u00b0\n\n\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00c9\u00c0\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00b1\u00ce\u00b9\u008a\u0081\u00b9\u00b5\u00c8\u00b9\u00c6\u0089\u0081\u00ba\u00c9\u00d7\u00a9\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00c6\u00af\u00c7\u00b8 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 27 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b9\u00c6\u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00d7\u00b1\u00c6 \u00b1\u00ce\u00b9\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c623\n\n(\u00a4) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00de \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b1\u00be\u00e2\" \u00a3\u00b1\u00c6\u00cc\u00b1\u00bb\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b1\u00bb\u00be\u00c6 \u00b7\u00be\u00c6\u00cc\u00be\u00ae\u00b5\u00b6\u00c6\u00d7\u00b4\u0081 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7 \u00a9\u00b8\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6 \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00c8\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b1\u00be\u00e2 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00d7\u00b4\u00bc\u00c6\u00b1\u00c6\u00b1\u00c8\u008a\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00bd\u00c6\u00bd\u00c1\u00c0\u00af\u00c6\u00af\u00c8\u00be\u00c6 \u00a3\u00c1\u00bc\u00c7\u00be\u00c6 \u00a3\u00bd\u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c7\u00be\u0081\u00bd\u00c8\u00b1\u00ce\u00b9\u008a\u0081 \u00b7\u00c8\u00b6\u00c8\u00bb+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n30\u00b0 \u00b1\u00ce\u00b9\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00b5\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00c0\u00af\u00c6\u00af\u00c8\u00be\u00c6\u00b1\u00ce\u00b9\u008a\u0081 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00cc\u00bc\u00c7\u00dd\u00c1\u00dd\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af \u00a4\u00e0\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00b6\u00b8\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00b8 \u00a4\u00ce\u00b5 \u00a9\u00d7\u00e2\u00ba\u00c6 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0"
