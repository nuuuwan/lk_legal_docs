    "chunk_text": "\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00a6\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00e5 40 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c0\u00e0\u00c8\u00e6\u00aa\u00e0\u00cb\u00e8\u00c0\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00cd\u00fa \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u00c9\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a7\u00cd\u00ea \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00cd\u00fa \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00ce \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4\u00aa\u00b8\u00be\u00e0 \u00c2\u00c8\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00c0\u00cd\u00a8 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5, \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8\u00c6\u00a8\u00eb \u00ef\u00c8\u00cc\u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00a3_\u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00e0 \u00c2\u00e6\u00bf\u00fb\u008a\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u0097\u00a8\u00eb\u00b8\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00bc\u00e0\u00c0\u00ce \u00a6\u00e0 \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00bc\u00fb \u00cc\u00e5\u00bc\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00c7\u00be \u00c8\u00bc \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c8\u00c2\u00be \u00c8\u00e5\u00c3_\n\n\u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00e0\u00a1\u00e6\u00ba\u00e6\u008a \u00c8\u00e5\u00c3 \u00a1\u00c6\u00a8\u00c7\u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c2\u00c9.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba144\n\n(\u00a1)\u00a6\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00ba\u00e5\u00aa \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00be\u008a, \u00ef\u00bc\u00e0\u00c0\u00ce \u00ef\u00ba\u00e5\u00aa \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u0097\u00a8\u00eb\u00b8\u00be \u00ef\u00c9\u00ef\u00ce\u00be\u00e0\u00bc\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00ef\u00c8\u00cc \u00c8\u00e6\u009f\u00c4\u00b4 \u00a1\u00ef\u00c0\u00e0\u00a8\u00e0\u00cb\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00c8\u00e5\u00c3\u00c9\u00c8\u00b4 \u00c9\u00e6\u0091 \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00be\u00e5\u00a8\u00e0 \u00ef\u00cc\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00a6\u00e0 \u0097\u00a8\u00e8\u00b8\u00e9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00e8\u00c8\u00e0\u00c8\u00c7 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c\u00be\u008a, \u00ef\u00bc\u00e0\u00c0\u00ce \u00cc\u00e8\u00c8\u00e0\u00c8\u00c7 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u0097\u00a8\u00eb\u00b8\u00be \u00ef\u00c9\u00ef\u00ce\u00be\u00e0\u00bc\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00ef\u00c8\u00cc \u00c8\u00e6\u009f\u00c4\u00b4 \u00a1\u00ef\u00c0\u00e0\u00a8\u00e0\u00cb\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c8\u00e5\u00c3\u00c9\u00c8\u00b4\u00c9\u00e6\u0091 \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00be\u00e5\u00a8\u00e0 \u00ef\u00cc\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n81.\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9 \u00ba\u00eb\u00ce \u00a1\u00e6\u00ba\u00f8\u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00cc\u00e8\u00c6\u00f5 \u00c8\u00e5\u00c3 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a6\u00e0 \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00a8\u00c8\u00e8\u00be\u00e0\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5 \u00a6\u00e0 \u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00c8\u00e6\u00c2\u00c9 \u00bc,\u00e0 \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ea\u00c9 \u00bc, \u00a6\u00e0 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5\u00ef\u00aa\u00e0 \u00be\u00e5\u00c4\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 \u00a6\u00ef\u00cc\u00e0 \u00ef\u00a8\u00ce\u00e8\u00be\u00e0\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5\u00ef\u00aa\u00e0 \u00be\u00e5\u00c4\u00ef\u00c6\u00be\u00e0\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00c9\u00ba\u00e0\u00a8\u00ef\u00c4\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5\u00ef\u00aa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00c8\u00cc\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00a1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6. \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00ef\u00a8\u00be\u00a8\u00eb\u00b4 \u00c9\u00e6\u0091\u00aa\u00b8\u00be\u00a8\u00e0 \u00cc\u00e8\u0090\u00ba\u00e0 \u00be\u008a, \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a7\u00c9\u00ea\u00be\u00e0 \u00a6\u00a8\u00e0\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00e0 \u00ef\u00c9\u00be\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9 \u00a1\u00be\u00ea\u00c9, \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00b4 \u00a7\u00c9\u00ea\u00be\u00e0 \u00a6\u00a8\u00e0\u00c9 \u00cd\u00e5\u00ef\u00c9\u00be\u00e0 \u00ef\u00c9\u00be\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n82.(1) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u2014"
