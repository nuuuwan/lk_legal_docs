    "chunk_text": "\u00a4\u008a\u0081\" \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c7\u008a\u00d9\u00ba\u00c6\" \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00af\u00c7\u00b8 \u00b6\u00b8\u00c8\u00bb\u00c7\u00bf\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c8\u0081 \u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00ba\u00c7\u00b8\u00d7\" \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba \u00a3\u00b6\u00c8\u00b9\u00b6\u00c8\u008a\u0081 \u00af\u00dd\u00b6\u00c6\u00d7\u00b9\u00c6\u00b9\u0088\"\u00a3\u00b7\u00c6\u00b6\u00b6\u00c6 \u00b6\u00b8\u00c8\u00bb\u00c7\u00bf\u00c8\u0081 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00b6\u00dd\u00b7\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00cd\u00c1\u00ce\u00be\u00af\u00c6\u00af\u00ba\u00bc\u00c6\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a9\u00be\u00c6\u00be\u00c7\u00b6\u00c6 \u00b6\u00b8\u00c8\u00bb\u00c7\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00ac\u00dd \u00b1\u00c9\u00bc\u00c7\u00af \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00b6\u00c6\u00b6\u00c7\u00af\u00c7\u00b6\u00b6\u00c7\u00b8 \u00ac\u00dd\u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c8\u00b5+\u00c6\u00af \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b6\u00b8\u00c8\u00bb\u00c7\u00e0\u00af\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00b8(\u00a5) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00ce\u00bb \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00af\u00c8\u0081\u00bd\u008c\u00b4\u00b6\u00c6\u00d7\" \u00a3\u00b6\u00c6\u00b6