    "chunk_text": "(4)\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00bc\u00b8\u00e0\u00b6\u00c8 \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00c0\u00be\u00c9\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 202 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa (\u00a1)\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 204 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa (\u00a1)\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00c9\u00c7\u00bc\u00a8\u00b4 \u00be\u00b6\u00ea \u00c0\u00c9\u00c7\u00be\u00ea\u00c8\u00e6\u009f\u00c4\u00b4 \u00a7\u00cd\u00ea \u00c6\u00b4\u00ba\u00e0 \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nXXV \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c2\u00bc\u00e0\u00bc \u00cc\u00cd \u00a6\u00c6\u00b4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c4\u00ea\u00bc\u00c8\u00e0\n\n\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00c2\u00bc\u00e0\u00bc \u00cd\u00e5 \u00a6\u00c6\u00b4\u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00c4\u00ea\u00bc\u00c8\u00e0\n\n2432006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba\n\n\u00bc\u00fa\u00be\u00c6\u00a8\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.) \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7 \u00ef\u00aa\u00d1\u00c4\u00b4 \u00be\u00f8\u00c6\u00c4\u00c9 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc\u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00bc\u00e0\u00bc\u00a8\u00f8\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00aa\u00c9\u00e5 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00a6\u00c4 \u00c2\u00bc\u00e0\u00bc\u00ef\u00cd\u00e5\u00e0 \u00c2\u00bc\u00e0\u00ef\u00bc\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc \u00ef\u00aa\u00d1\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00c7 _\n\n(\u00a1) \u00a6\u00c4 \u00c2\u00bc\u00e0\u00bc \u00a6\u00a8\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00bc ;\n\n(\u00a1\u00e5) \u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00a6\u00a8\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00c9\u00e6\u0091 \u00aa\u00b8\u00be\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00a6\u00e0 \u00a6\u00a8\u00e0\u00a6\u00a8\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00cc\u00cd \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6 \u00bc,\n\n\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00aa\u00d1\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00e0\u00be\u00a8\u00eb \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2)113 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 (4) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c2\u00bc\u00e0\u00bc \u00ef\u00aa\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00bc\u00fa\u00be\u00ef\u00c6\u00cd\u00fa\u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00c2\u00bc\u00e0\u00bc \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00ef\u00cc\u00e0 \u00ef\u00aa\u00c9\u00e5 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00ef\u00cd\u00e5\u00e0\u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 \u00ef\u008a\u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00e0\u00be\u00a8\u00eb \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3)\u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00d6\u00be\u00e0\u00be\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c2\u00bc\u00e0\u00bc\u00b4 \u00a1\u00ba\u00f8\u00ef\u00da\u00a8\u00c9 _\n\n(\u00a1) \u00a6\u00e0 \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00bc\u00cd\u00c6\u00a8\u00b4 \u00cc\u00c4\u00e5\u00be \u00c4\u00ea\u00bc\u00c8\u00a8 \u00bc\u00b8\u00e0\u00b6\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0;\u00cc\u00cd\n\n(\u00a1\u00e5) \u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9 \u00bc\u00fa\u00be \u00ba\u00f8\u00cd\u00a8\u00e0 \u00a2\u00a8\u00eb\u00ba\u00e0\u00d1\u00c4\u00b4\u00ef\u00c0\u00c7 \u00c2\u00bc\u00e0\u00bc \u00ef\u00aa\u00c9\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2\u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00a8\u00e5\u00c8\u00c6 \u00ba\u00eb\u00c8 \u00bc\u00fa\u00be \u00ba\u00f8\u00cd\u00a8 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00e6\u0091\u00c0\u00ea\u00c7 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00b4 \u00ef\u00bc\u00a8\u00a8\u00b4 \u00cc\u00c4\u00e5\u00be \u00c4\u00ea\u00bc\u00c8\u00a8 \u00c9\u00e6\u0091\u00c0\u00ea\u00c7 \u00bc\u00b8\u00e0\u00b6\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0,\n\n\u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc _\n\n(i) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a2\u00cd\u00ba\u00f8\u00be\u00e0 \u00c9\u00ec \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c6\u00b4\u00ef\u00ba\u00e0 \u00bc\u00b8\u00e0\u00b6\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0\u00ef\u00c8\u00cc \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c4\u00ea\u00dd \u00c4\u00ea\u00bc\u00c8 \u00a8\u00f8\u00cc\u00e8\u00c4 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00ef\u00aa\u00d1\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00d6\u00be \u00c8\u00bc \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00c0\u00be\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n2442006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba"
