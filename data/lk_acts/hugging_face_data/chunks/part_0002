    "chunk_text": "(2) \u00a6\u00ef\u00cc\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ef\u00be\u00e5\u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0\u00ef\u00be\u00e5\u00a8\u00c7\u00be \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00cc\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4\u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00c9\u00ec \u00bc\u00b8\u00e0\u00b6\u00be\u00c6\u00a8\u00b4 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nXX \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n160.\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00be\u00f9\u00ba\u00f8\u00c6\u00a8 \u00c0\u00b4\u00cd\u00e6\u00be\u00f8\u00c9 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00a8\u00f8\u00cc\u00e8\u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u2013\n\n(\u00a1)95 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00be \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c7\u00e5\u00b0\u00f1 \u00c3\u00e5\u00aa\u00c6\u00a8\u00e0 \u00cd\u00e6\u00c7 \u00c6\u008a \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00e5\u00b0\u00f1 \u00c3\u00e5\u00aa\u00c6\u00a8\u00e0 ;\u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00c6\u008a \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00c4\u00e5\u00be \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00ef\u00aa\u00c9\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c\u00bc\u00fb \u00a6\u00c4 \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c6, \u00c7\u00e5\u00b0\u00f1 \u00c3\u00e5\u00aa, \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00cc\u00c4\u00e5\u00be \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u008c\u00c8\u00e5\u00ef\u008c\u00bc\u00fb, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u0097\u00cc\u00e8\u00be\u00e0 :\u2013\n\n(i)\u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00bc\u00ce \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00e5\u00b0\u00f1 \u00c3\u00e5\u00aa\u00ef\u00c6\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00b4 \u00bc\u00cd\u00c6\u00a8 ; \u00cc\u00cd\n\n(ii)\u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00c6\u008a \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00e0\u00b8 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00cc\u00c4\u00e5\u00be \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00a8\u00f8\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4\u00c0\u00cd\u00a8,\n\n\u00a1\u00be\u00ea\u00c0\u00e5\u00ba\u00c6\u00b4 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n\u00ef\u00c8\u00e5\u00ba\u00db\u00c6\u00fa, \u00a7 \u00b4\u00ea\u00a1\u00e6\u00c8\u00e0\u00c8\u00e9\u008a \u00cc\u00cd \u00cc\u00ec\u00f3\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7 \u00ef\u00aa\u00be\u00c6\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4.\n\n\u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00c7\u00e5\u00b0\u00f1\u00c3\u00e5\u00aa\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00be\u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4\u00cc\u00c4\u00e5\u00be \u00ef\u00aa\u00d1\u008a \u00a8\u00c7\u00be\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba224\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00ef\u00aa\u00d1\u00c4\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0, \u00c9\u00be \u0097\u00b4\u00a8 \u00bc\u00fb \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00b4 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00a6\u00a8\u00e0 \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00e5\u00b0\u00f1 \u00c3\u00e5\u00aa\u00c6, \u00c6\u008a \u00c4\u00e5\u00cc\u00c6\u00a8\u00bc\u00fb, \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00cc\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c9\u00da\u00cb\u00c6\u00a8 \u00bc\u00fb \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c8\u00a8\u00e0\u00cb \u00c0\u00cd\u00a8\u00e0\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8 \u00bc\u00fb \u00c0\u00c4\u00b8\u00a8\u00e0 \u00c2\u00f3 \u00a1\u00b6\u00ea \u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
