    "chunk_size_bytes": 3628,
    "chunk_text": "(\u00a1)\u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00ec \u00bc ; \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\n\n(\u00a1\u00e5)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9\u00b4 \u00ef\u00aa\u00be \u00a6\u00be\u00ea \u00c8\u00e6\u00c2, \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00cd\u00fa \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5\u00c9\u00ec \u00bc\n\n\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba25\n\n9.(\u00a1) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0, \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9\u00b4\u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c7\u00e5\u00b0\u00f1 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00b4\u00ef\u00cd\u00e5\u00e0 \u00ba\u00ba\u00e0 \u00a8\u00e5\u00c8\u00ef\u00c6\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00c9 \u00c0\u00c9\u00ba\u00f8\u00be \u00c6\u008a\u00c9\u00e5\u00be\u00f8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00b4 \u00ef\u00bc\u00be\u00c8\u00bc \u00b8\u00c6\u00a8\u00e0, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00c0\u00f2\u00aa\u00ba\u00f8\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00ba\u00f1\u00e5\u00c9\u00ca\u00f1\u00c6\u00e6\u00c6\u00fa \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e0\u00be\u008a,\u00a6\u00a8\u00f9 \u00b8\u00c6 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00b4, \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00b4 \u00ef\u00cd\u00e5\u00e0\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u00a4\u00c0\u0097\u00ba \u00c9\u00be \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6 ;\n\n(\u00a1\u00e5) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9\u00b4 \u0097\u00ef\u00bc\u00e0\u00ca \u00c9\u00f1\u00c9\u00cd\u00e5\u00c7\u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00ef\u00bc\u00be \u00c8\u00bc \u00b8\u00c6\u00a8\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00c0\u00f2\u00aa\u00ba\u00f8\u00c6\u00cc\u00bf\u00cd\u00e5 \u00a1\u00ba\u00f1\u00c9\u00ca\u00f1 \u00c6\u00c6\u00fa \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e0\u00be\u008a, \u00a6\u00e0 \u00b8\u00c6 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9\u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00cc\u00ea\u00db\u00a8\u00eb\u00c4\u00a8\u00f8\u00be\u00e0, \u00ef\u00be\u00e5\u00e0 \u00b4\u00ea\u00c9\u00a8\u00f8\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a8\u00ed\u00c0\u00be\u00c6\u00a8\u00f8\u00be\u00e0 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00b4\u00a4\u00c0\u008e\u00ba \u00c9\u00be \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6 ;\n\n(\u00a1\u00e6) \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9 \u00ba\u00f8\u00c2\u00ec \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6\u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00cd\u00ea\u00c9\u00c4\u00e5\u00c7\u00e6 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00c2\u00e5\u00aa\u00be\u00e0\u00be\u00e5\u00c4\u00ea\u00bc\u00c8\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00be\u00c9\u00be \u00c8\u00bc\u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00a1\u00be\u00ea\u00c4\u00e6\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9 \u00c9\u00e5\u00be\u00f8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u0097\u00c9\u00ee\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u0097\u00ef\u00ca\u00e0\u00cb \u00aa\u00fa\u00b8\u00ea\u00c4\u00a8\u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00c2\u00e6\u00c7\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00ba \u00a4\u00c0\u008e\u00ba \u00c9\u00be \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6 ;\n\n\u00c8\u00e6\u00c2\u00ea\u00b8\u00ea \u00a1\u00e6\u00ba\u00e6\u008a\u00ef\u00c0\u00e5\u00c8\u00e8 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0\u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba26\n\n(\u00a1\u00e7)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00a1\u00be\u00ea\u00c4\u00e6\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c6\u008a \u00c9\u00e5\u00be\u00f8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8, \u00c6\u008a \u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8 \u0097\u00c9\u00ee\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00aa\u00fa\u00b8\u00ea\u00c4\u00a8 \u0097\u00ef\u00bc\u00e0\u00ca \u00c9\u00f1\u00cd\u00e5\u00c7\u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00c2\u00e6\u00c7\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00ba \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00a4\u00c0\u0097\u00ba\u00c9\u00be \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6 ;\n\n(\u00a2)\u00a1\u00e6\u00c4\u00d6\u00a8\u00be\u00e0 \u00ef\u00b6\u00e5\u00c8\u00da \u00c9\u00c8\u00e8\u00be\u00e0 \u00c9\u0090\u00be\u00e5\u00a8\u00c4 \u00be\u00f8\u00c6\u00c4 \u00ef\u00a8\u00ef\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u00c8\u00e8 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00e2\u00d1\u00ef\u008a\u00c2\u00e6\u00df\u008a\u00a8\u00c7\u00c9\u00c8 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00ba \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4\u00a4\u00c0\u008e\u00ba \u00c9\u00be \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6 ;\n\n(\u00a3)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00e6\u00ef\u00c4\u00d6\u00a8\u00be\u00e0\u00ef\u00b6\u00e5\u00c8\u00da\u00c9\u00c8\u00e8\u00be\u00e0 \u00c9\u0090\u00be\u00e5\u00a8\u00c4 \u00be\u00f8\u00c6\u00c4 \u00ef\u00a8\u00ef\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c2\u00e6\u00df\u008a\u00a8\u00c7\u00c9\u00c8 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00ba \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4\u00a4\u00c0\u008e\u00ba \u00c9\u00be \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6 ;\n\n(\u00a4)\u00c6\u008a \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb \u00a6\u00e0\u00a8\u00a8\u00c6\u00a8\u00e0 \u00cc\u00c4\u00aa \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6\u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8\u00e8\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00c2\u00e6\u00c7\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c4\u00ea\u00bc\u00c8\u00e0\u00c4\u00ba \u00a7\u00cd\u00ea\u00b4 \u00a4\u00c0\u008e\u00ba \u00c9\u00be \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6 ;"
