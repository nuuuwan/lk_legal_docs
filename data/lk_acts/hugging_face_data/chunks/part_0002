    "chunk_text": "(\u00a1) \u00a6\u00c4 \u00c7\u00e5\u00b0 \u00cc\u00be\u00e0\u00ba\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c9\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9\u00a1\u00c3\u00fa\u00c6\u00e5\u00ae\u00be\u00e5\u0093\u00a8\u00c7\u00b8\u00c6 \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0 \u00ef\u00ca\u00f2\u00e0\u00cb\u00e0\u00b5\u00e5\u0093\u00a8\u00c7\u00b8\u00c6 \u00ef\u00c9\u00ba\u00a1\u00c3\u00fa\u00c6\u00e5\u00ae\u00be\u00c6\u00a8\u00e0 \u00a8\u00c7 \u00ba\u00f8\u00ef\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00a6\u00c4 \u00c7\u00e5\u00b0 \u00cc\u00be\u00e0\u00ba\u00a8\u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c9 \u00cc\u00e0\u00bb\u00fc\u00c7 \u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00ba\u00cd\u00c9\u00ea\u00c7\u00e6 \u00a8\u00c7\u00be \u00ba\u00f9\u00c7\u00b8\u00c6\u00a8\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4;\n\n\u00c4\u00ea\u00bc\u00c8\u00e0\u0097\u00ca\u00eb\u00bc\u00e0\u0093\u00a8\u00c7\u00b8 \u00c9\u00c7\u00bc \u00cd\u00e5\u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00ef\u00bc\u00e0\u00c0\u00ce\u00c7\u00e5\u00b0\u00cc\u00be\u00e0\u00ba\u00a8 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00ca\u00eb\u00bc\u00e0\u009e\u00a8\u00c7\u00b8\u00c6\u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00ef\u008a \u00c0\u00be\u00ba10\n\n\u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n(4) \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00ca\u00eb\u00bc\u00e0\u009e\u00a8\u00c7\u00b8 \u00c9\u00c7\u00bc\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4\u00a1\u00c6\u00fa\u00ba\u00f8 \u00c6\u008a \u00ae\u00e2\u00ae\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce, \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00c0\u00f2\u00a8\u00b4 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00f2\u00c3\u00c9\u00c6\u00be\u00e0\u00b4 \u00cc\u00c4\u00e5\u00be \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a\u00cc\u00cd \u00a6\u00c4 \u00ef\u00bc\u00e0\u00c0\u00ce \u00bc\u00e6\u00d7\u00c4 \u00cc\u008a\u00c3\u00e5\u0097\u00ba\u00e5\u00c9\u00ef\u00c6\u00e0 \u00c9\u00e6\u0091 \u00c2\u00c7 \u00a1\u00be\u00ea\u00c9 \u00c0\u00e6\u00cd\u00e6\u00bc\u00fa\u00ce\u00e8 \u00a8\u00ce\u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8 \u00be\u008a, \u00a6\u00c4 \u00ef\u00bc\u00e0\u00c0\u00ce \u00cc\u00ee\u00b0\u00ea\u00c9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00a8\u00f2\u00c9 \u00c6\u008a \u00be\u00f9\u00ba\u00f8\u0097\u00ef\u00c7\u00e5\u00e0\u009e\u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00c7\u00a8\u00c4\u00a8\u00f8\u00be\u00e0 \u00c9\u00f1\u00ea\u00ba\u00e0\u00c0\u00be\u00e0\u00be\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u00c8\u0089\u00bd\u00c9 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4, \u00c7\u00b0\u00c6\u00cc\u00be\u00e0\u00ba\u00a8\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c9 \u00a8\u00c7\u00be \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0, (1) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00ec\u00da\u00c9 \u00be\u00f8\u00aa\u00c4\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n14(1) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 13 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00c7\u00e5\u00b0\u00cc\u00be\u00e0\u00ba\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00f8\u00be\u00e0 \u00c2\u00c8\u00c0\u00e7\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00d1 \u00ba\u00f8\u00ef\u00c2\u00be \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0, \u00a6\u00e0 \u00a1\u00e5\u00b3\u00e5\u00ef\u008c \u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a7\u00cd\u00ea\u00b4 \u00a1\u00c8\u00e5\u00c3\u0097\u00bf\u00fa\u00be\u00e0\u00be\u00b4 \u00cc\u00e8\u00f3 \u00d1 \u00ba\u00f8\u00ef\u00c2\u00be \u00c2\u00c9 \u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00c7\u0095\u00be\u00e0 \u00a6\u00e0 \u00a1\u00e5\u00b3\u00e5\u00c9 \u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00e8\u00b4 \u00bc\u00c9\u00cc\u00e0\u00ba\u00f8\u00cd\u00a8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba, \u00a6\u00e0 \u00c7\u00e5\u00b0\u00cc\u00be\u00e0\u00ba\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c9 \u00a8\u00ce\u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00ef\u00c9\u00ba \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(2) \u00c7\u00e5\u00b0\u00cc\u00be\u00e0\u00ba\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c9 \u00a8\u00ce \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00ef\u00c9\u00ba (1) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00e0 \u00a1\u00e5\u00b3\u00e5\u00ef\u008c\u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a2\u00c8\u00e0\u00f5\u008a\u00a8\u00c7\u00e6\u00b4 \u00a1\u00c8\u00e5\u00c3 \u0097\u00bf\u00fa\u00be\u00e0\u00be\u00b4 \u00cc\u00e8\u00f3 \u00d1 \u00ba\u00f8\u00ef\u00c2\u00be \u00c2\u00c9\u00b4\u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00d1\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00c7\u00e5\u00b0 \u00cc\u00be\u00e0\u00ba\u00a8 \u00a8\u00ce \u00ef\u00bc\u00e0\u00c0\u00ce\u00e8\u00be\u00e0\u00c9\u00be\u00e0\u00bc\u00fa \u00ef\u00aa\u00c9\u00be \u00ef\u00c8\u00cc \u00a6\u00c4 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00b3\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n15.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 13 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u00c7\u00b0\u00c6 \u00cc\u00ba\u00eb\u00a8\u00c7 \u00ba\u00f8\u00ef\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00ef\u00cc\u00e0 \u00c7\u00b0\u00c6 \u00cc\u00ba\u00eb \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00bc\u00e0\u00c0\u00ce\u00c9\u00c8\u00c3\u00e5\u00c7\u00a8\u00e5\u00c7\u00ba\u00e0\u00c9\u00c6 \u00bc\u00e6\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5, \u00a6\u00c4 \u00c7\u00b0\u00cc\u00be\u00e0\u00ba\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c9 \u00a8\u00c7\u00be\u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00f2\u00ba\u00f8\u00aa\u00f2\u00e5\u00cd\u00a8\u00c6\u00a8\u00eb \u00c0\u00ba\u00e0 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n\u00cc\u00bc\u00e0\u00c3\u00e5\u00d1\u00cd\u00fa\u0095\u00a8\u008a\u00c0\u00e5\u00be\u00e0\u00be\u00be\u00e0\u00ef\u00aa\u00e0\u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a.\n\n\u00c7\u00b0\u00c6 \u00cc\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u00c0\u00cc\u00ea \u00c0\u00f2\u00ba\u00f8\u00aa\u00f2\u00e5\u00cd\u00a8\u00c6\u00a8\u00eb\u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00ca\u00eb\u00bc\u00e0\u009e\u00a8\u00c7\u00b8\u00c6\u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00ef\u008a \u00c0\u00be\u00ba11\n\n16.\u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00ef\u00cd\u00ce\u00e8\u00bc\u00c7\u008c \u00a8\u00f8\u00d7\u00c4 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00c6\u008a \u00c8\u00e8\u008d\u00ba \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c9 \u00c0\u00e6\u00be\u00d1 \u00ba\u00f8\u00ef\u00c2\u00be, \u00c7\u00cd\u00cc\u00f1\u00c3\u00e5\u00c9\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00c6\u008a \u00c2\u00e6\u00bf\u00fb\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e9\u00c4\u00e5 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00c0\u00e6\u00c9\u00ba\u00eb\u00be \u00bc, \u00a6\u00e0 \u00ef\u00be\u00e5\u00ba\u00a8\u00e5, \u00ef\u008a\u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00a1\u00be\u00ea\u00c9 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c0\u00f2\u00a8\u00e5\u00c7 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00a8\u00c7\u00be \u00c6\u008a \u00ef\u00cd\u00ce\u00e8\u00bc\u00c7\u008c \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00a6\u00a8\u00f9 \u00c2\u00e6\u00bf\u00fb\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e9\u00c4\u00e5 \u00a8\u00f8\u00d7\u00c4\u00a4\u00c8\u00e0\u00c8\u00e2\u00ab\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\nIII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00ef\u00c0\u00e5\u00f3 \u0097\u0093\u0097\u00bd\u00e5\u00be"
