    "chunk_text": "(\u00a9) \u008c\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00bf\u008c\u00bd\u00c6\u00d0 \u00b1\u00ba\u00ba\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b7\u00c8\u00b6\u00c8\u00b1\u00c7\u00bc\u00c6 \u00c1\u00c7+\u00c6\u00af\u00be\u00c6\u00af\u00bf\u00c7\u00be\u00c6\u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00c1\u00c7\u0088\u00af\u00c6\u00ce\u00af\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c6 \u00a5\u00ce\u00b5\u00bb\u00b6\u00c6\u00b6\u00bf\u00b6\u00c6\u00b6\u00c8\u00d9{\u00b4\u00c7\u00af \u00a6\u00d5\u00b9\u00d5\u00c1\u00b6\u00d9{\u00b4\u00c7\u00af \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00ac\u00dd \u00cc\u00b6\u00c7\u00c0\u00c8\u00ce\u00be\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6\u00a7\u00bf\u00c6\u00bf\u00b4+\u00c6\u00af\u00be\u00c7\u00af\" \u00af\u00b1\u00c8\u00cd\u00b8\u00c7\u0083\" \u00e9\u00b6\u00c7\u00b4\u00c6\u00b4 \u008c\u00d5\u00b6\u00c8\u00af\u00bf\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00be\u00c7\u00b6\u00c6\u00b6\u00bc\u00c6 \u00ac\u0081\u00bd\u00c8\u00ce\u00b8 \u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 ;\n\n(\u00ab) \u008c\u00ce\u00be\u00dc\u00bb\u00bc\u00c6\u00b7\u00c6\u00b6 \u00a7\u00cd\u00be\u00c7\u00af+\u00c6\u00af\u00bf\u00c8\u0081 \u00c1\u00b5\u00c8\u00af\u00bc\u00c6\u00af\u00bf\u00c6\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u008c\u00ce\u00be\u00dc\u00bb\u00bc\u00c6\u00b7\u00c6\u00b6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u008c\u00ce\u00be\u008a\u00bf\u00af\u00c6\u00af\u00af\u00c6 \u00af\u00bd\u00c6\u00af\u00bf\u00c8\u0081 \u00c1\u00b5\u00c8\u00af\u00bc\u00c6\u00af\u00bf\u00c6 1993 \u00a4\u00ba\u00c6\u00a4\u00ae\u0088\u0081 50 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00ba\u00c7\u00b5\u00c8\u00af\u00c6\u00af\u00af\u00c6\u00af\u00be\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00a4\u00b9\u00bc\u00b5+\u00c6\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00aa\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a7\u00cd\u00be\u00c7\u00af+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00af\u00bd\u00c6\u00af\u00bf\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b4\"\u00a4\u00b8\u00c7\u00be\u00c6 \u00a3\u00b6\u00bd\u00c6\u00d0 \u00ba\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00c7\u0088\u0081\u00bd\u00c8\" \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c6\u008c\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6 \u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00c6\u00d0\u00b1\u00c6 \u00b1\u00ba\u00ba\u00c7\u00af\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0 \u00cd\u00ba\u00be\u00c7\u00af \u00c1\u00c7\u0088\u00af\u00c6\u00ce\u00af\u00bb\u00c7\u00bf\u00bc\u00c6\u00ac\u00dd\u00c1\u00dd\u00b4\u0081 \u00af\u00c7\u00d2\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00be\u00c6 \u00c1\u00c7+\u00c6\u00af\u00be\u00c6\u00af\u00bf\u00c8\u00be\u00c6\u00a6\u00d5\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00ce\u00ba ;\n\n(\u00ac) \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6\u00b6\u00ba\u00d7 \u00c1\u00c7\u0088\u00af\u00c6\u00ce\u00af\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00bc\u00b5\u00c8\u00af\u00bf\u00c6 \u00cc\u00b7\u00c7\u00b6\u00c6\u00b6\u00c7\u00bc\u00c8\u00d2\u00ba\u00c7\u00bc\u00c6 \u00cd\u00c1\u00de \u00d2\u00bb\u00c7\u00b6\u00c9\u00b8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4 \u00a7\u00bb\u00bc\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00af\u00ce\u00bf \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00af\u00b5\u00af\u00c6\u00af\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c6 \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00d7 \u00c1\u00c7\u0088\u00af\u00c6\u00ce\u00af\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00be\u00c6\u00c1\u00c7+\u00c6\u00af\u00be\u00c6\u00af\u00ce\u00bf \u00b6\u00bb\u00c7\u00bc\u00c8\u00af\u00c6\u00af\u00c8\u0081\u00bd\u00cd\u00b9\u00c7\u00d7\" \u00cc\u00af\u00c7\u00ae\u00d5\u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd\u00ce\u00ba ;\n\n(i) \u00a3\u00ce\u00b1\u00c1\u00bd\u00c6\u00bd \u00cc\u00b1\u00c7\u00b6\u00c6\u00d7\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b8\u00e2\u00ba\u00c6\u008c\u00bd\u00c6\u00b9\u00b8\u00e2\u00ba\u00c6 ;\n\n(ii) \u00c1\u00c7\u0088\u00af\u00c6\u00ce\u00af\u00bb\u00c7\u00bf\u00bc\u00c8\u0081 \u00b9\u00b5\u00ba\u00c6\" \u0089\u00ce\u00b5\u00bb+\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00cc\u00b1\u00c7\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00bf\u00c6 \u00a9\u0081\u00b9\u00b8\u00c1\u00bd\u00c6\u00ce\u00bd \u00db\u00af\u00c7\u00ce\u00ba\u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6 ;\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 5 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00b9\u00b5\u00ba\u00c6\u00d7{\u00bb\u00c6\u00b6\u00c7\u00af\u00c6\u00af\u00be\u00c6 \u00b6\u00ce\u00b4\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c627\n\n(iii) \u00c1+\u00c6\u00af\u00c8 \u00cd\u00b1\u00ba\u00c8\u00b9\u00c6\u00da \u00a3\u00be\u00c6\u00be\u00d7 \u0089\u00ce\u00b5\u00bb\u00af\u00c6 \u00af\u00b5\u00af\u00c6\u00d0\u00af\u00bf\u00c6 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00ce\u00bd \u00db\u00af\u00c7\u00ce\u00ba \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6 ;\n\n(iv) \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c8\u0081 \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00db\u00af\u00c7\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1\u00ba\u00c6 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00de\u00af\u00c6\u00af\u00c7\u00b8 \u00a7\u00b6\u00e2\u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00bf\u00c6 \u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(v) \u00b1\u00b4\u00c6\u00b4 \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00a7\u00dd\u00c1\u00c7\u00af\u00c6\u00af\u00ba\u00c6\" \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00db\u00af\u00c7\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b6\u00c7\u00b9\u00b8+\u00c6\u00af\u00bf\u00c8\u0081 \u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b8\u00e2\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00ce\u00bd \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00cc\u00b1\u00bb\u00c6\u00b6\u00df\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u0081 \u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b8\u00e2\u00ba\u00c6 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8\u00dc\u00ba\u00c6 ;\n\n(\u00b3)\u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u00b6\u00c8\u00bd\u00b6\u00c6\u00b6\u00c1\u00dd\u00af\u00c6\u00d0\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00cd\u00b1\u00ce\u00c1\u00af\u00bf\u00c8\u00be\u00c6 \u00ac\u0081\u00ce\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u0081\u00de\u00af\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bd\u00c6\u00ce\u00bd \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c7\u00b8 \u00ac\u00dd\u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00b7\u00c6\u00b6 \u00c1\u00ce\u00bc\u008c\u00be\u00af\u00c6\u00af\u00b5\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00cd\u00c1\u00de\u00c1\u00ce\u00af\u008a\u00be\u00c6 \u00cd\u00ba\u00c1\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00be\u00c6\u00be\u00c7\u00b6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00cd\u00b1\u00ce\u00c1 \u00c1\u00c0+\u00c6\u00d0\u00b7\u00bc\u00c6 ;\n\n(i) \u00b1\u00b4\u00c6\u00b4 \u00c1\u00c7\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00a7\u00dd\u00c1\u00c7\u00af\u00c6\u00af\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00db\u00af\u00c7\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1\u00ba\u00c6 ;\n\n(ii) \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00cc\u00b1\u00bb\u00be\u00c7\u00bf\u00bc\u00c6\" \u00b9+\u00c6\u00af\u00c7\u00bf\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00b9+\u00c6\u00d0\u00ce\u00b4\u00ce\u00ba \u00ac\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7\u00cd\u00c1\u00ce\u00be \u00b1\u00b4\u00c6\u00b4 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a3\u00cd\u00b6\u00b9\u00b6\u008c\u00b7\u00c8\u00ce\u00be \u00ac\u0081\u00bd\u00c7\u00af\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c7\u00bd\u00c6\u00de\u00b6\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00cc\u00bd\u00c7\u00dd \u00a4\u00bf\u00c6 \u00a3\u00c1\u00c6\u00c1\u00c7\u00de\u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00d5\u00b6\u00c1\u00bd\u00c6\u00d0 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6 ;\n\n(iii) \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\" \u00b9+\u00c6\u00d0\u00ce\u00b4\u00ce\u00ba \u00ac\u0081\u00de\u00af\u00c6\u00af\u00c7\u00b8\u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00b1\u00b4\u00c6\u00b4 \u00a4\u00bf\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00e1+\u00c6\u00d0\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8 \u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00df\u00c1\u00be\u00af\u00ba\u00c6\" \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00db\u00af\u00c1\u00bc\u00c8\u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00b4\u00c1\u00b1\u00b6\u00c8\" \u00af\u0088\u00b6\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00c8\u00bc\u00c6\u00c1\u00c7\u00af\u00ba\u00c6 \u00db\u00af\u00c1\u00bc\u00c8 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00ce\u00bd\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6 ;"
