    "chunk_text": "\u00a4\u008a\u00d9\u00ba\u00c6\" \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c8\u008a\u00d9\u00ba\u00c6 (\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u008c\u0081\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\" \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00e0\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00b9+\u00c6\u00d0\u00ce\u00b4\u00ce\u00ba\u00af\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00ae\u00d5\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\n\n\u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u00af\u00c6\u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u008c\u00bd\u00c6\u00d0\u00a4\u00ae\u00d5\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u00a3\u00bc\u00d2\u00bc\u00c8\u00ce\u00ba\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6\"\u00db\u00af\u00c7\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00b5\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00ce\u00b6\u00cc\u00bb\u00c7\u00b6\u00c6\u00b6\u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00ce\u00c1\u00b1\u00c6\u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd\u00a4\u00b4\u00c6\u00af\u00bf\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6306\n\n161\u00b0 (1) \u00c1+\u00c6\u00af\u00c8\u00af\u00bf\u00c7\u00df\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8 \u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00af\u00bf\u00c7\u00df\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00b4\u00c6\u0088\u008a\u008b\u00dd\u00b7\u00c6\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u00af\u00c6\u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2\" \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u00af\u00c6\u00af\u00c7\u00b8 \u00c1\u00bc\u00e2\" \u00b9\u00b5\u00c8\u00b9\u00c6\u00da\u00ce\u00bc\u00af\u00bf\u00c8\u00ce\u00b8 \u00c1\u00c0+\u00c6\u00af\u00be\u00c6\" \u00c1+\u00c6\u00af\u00c8\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8 \u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6\u00af\u00b4\u00ce\u00ba\u00af\u00bf\u00c6\" \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u00af\u00c6 \u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u008c\u00be\u00c6 \u00b6\u00c1\u00ce\u00b5 \u00b6\u00c1\u00de\u00ce\u00af\"\u00c1+\u00c6\u00af\u00c8\u00af\u00bf\u00c6 \u00ba\u00c9\u00d7\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8\u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00af\u00bf\u00c6 \u00ba\u00c9\u00d7\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00d5\u00af\u00bf\u00c6\u00c1\u00c0+\u00c6\u00af\u00be\u00c6\" \u00cd\u00ba\u0081\u00db\u00ce\u00bd \u0094\u00d5\u00af\u00bf\u00c6\" \u00b6\u00c1\u00ce\u00b5 \u00b6\u00c1\u00de\u00ce\u00af\u00af\u00c6\u00af\u00c7\u00b8 \u00b6\u00ae\u00b4\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6 \u00a9\u0081\u00b9\u00b8 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c6 XVI \u00a5\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a4\u00ae\u00d5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u008a\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u00af\u00c6 \u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u008c\u00bd\u00c6\u00d0\u00ba\u00c6\" \u00a3\u00bc\u00d2\u00bc\u00c8\u00ce\u00ba\u00b9\u00c6 \u00b9\u00b5\u00ba\u00c6\"\u00db\u00af\u00c7\u00ce\u00ba\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00b5\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 160 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00de \u00a3\u00ce\u00b6\u00cc\u00bb\u00c7\u00b6\u00c6\u00b6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00c1\u00de \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00bf\u00c6\"\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a4\u00ae\u00d5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u008a\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00ce\u00bf\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9+\u00c6\u00d0\u00ce\u00b4\u00ce\u00ba \u00af\u00b4\u00ce\u00ba\u00af\u00bf\u00c6\" \u00a3\u00bc\u00d2\u00bc\u00c8\u00ce\u00ba\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6\" \u00db\u00af\u00c7\u00ce\u00ba\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00b5\u00ba\u00c6 \u00a3\u00ce\u00b6\u00cc\u00bb\u00c7\u00b6\u00c6\u00b6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00bf\u00c6\u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00dd\u00ba\u00c7\u00b8 \u00c1\u00bc\u00c8\u00af\u00c6\u00af\u00c7\u00b8 \u00c1\u00bc\u00e2\u00b9\u00b5\u00c8\u00b9\u00c6\u00da\u00ce\u00bc\u00af\u00bf\u00c6 \u00c1\u00c0+\u00c6\u00af\u00be\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u00af\u00c6 \u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u008c\u00be\u00c6 \u00b6\u00c1\u00ce\u00b5\u00b6\u00c1\u00de\u00ce\u00af\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00ba\u00c9\u00d7 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8 \u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00d5\u00af\u00bf\u00c6\u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6\" \u00cd\u00ba\u0081\u00db\u00ce\u00bd\u0094\u00d5\u00af\u00bf\u00c6\" \u00a5\u00c1\u00c6\u00c1\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00c1\u00ce\u00b5\u00b6\u00c1\u00de\u00ce\u00af\u00af\u00c6\u00af\u00c7\u00b8 \u00b6\u00ae\u00b4\u00ba\u00c6 \u00a9\u0081\u00b9\u00b8\u00c1\u00bd\u00c6\u00bd\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c6 XVI\u00a9\u0081\u00b9\u00b6\u00c8\u00be\u00c6 \u201c\u00c1+\u00c6\u00af\u00c8\u00af\u00e0\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8\u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00af\u00e0\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bf\u00bb \u00a4\u00ae\u00d5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00b8 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9+\u00c6\u00d0\u00ce\u00b4\u00ce\u00ba\u00af\u00bf\u00c6\"\u00a3\u00bc\u00d2\u00bc\u00c8\u00ce\u00ba\u00b9\u00c6 \u00b9\u00b5\u00ba\u00c6\" \u00db\u00af\u00c7\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00b5\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a3\u00ce\u00b6\u00cc\u00bb\u00c7\u00b6\u00c6\u00b6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00ba\u00c6\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u2018\u00c1\u00b4\u00c6\u0088\u2019 \u00a9\u0081\u00bd \u00cc\u00b1\u00c7\u00be\u00c6\u00df\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a4\u00ae\u00d5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\" \u00a3\u00bc\u00d2\u00ce\u00ba\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6\" \u00db\u00af\u00c7\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00b5\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a3\u00ce\u00b6\u00cc\u00bb\u00c7\u00b6\u00c6\u00b6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u201d \u00a9\u0081\u00bd \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00ba\u00c6\u00a3\u00ce\u00c1 \u00a3\u00c1\u00c6\u00c1\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a9+\u00c6\u00cc\u00af+\u00c6\u00d0 \u00af\u00c7\u00b5\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00b8\u00cd\u00c1\u00c7\u00a3+\u00c6\u00cc\u00af\u00be\u00c6\u00be\u00c7\u00ba\u00c6 \u00a5\u00b4\u00c6\u00b4\u00c7\u00bd\u00c6\u00cd\u00b9\u00c7\u0081\u00de\u00ba\u00c6 \u00aa\u00bd\u00c6\u00bd\u00ba\u00c7\u00bd\u00c6\u00bd+\u00c6\u00af\u00e0\u00b4\u0081 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00a5\u00c1\u00c6\u00c1\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c6XVI \u00a5\u0081\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b6\u00c7\u00af\u00c6\u00af\u00be\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6307"
