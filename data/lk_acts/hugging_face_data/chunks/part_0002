0c1\u00bd\u00c6\u00de\u00bf\u00c6 \u00a9\u00d7 \u0089\u00b7\u00c6\u00b6\u00c8\u00bb\u00cd\u00b6\u00c7 \u00a3\u00af\u00c6\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00bf\u00c6\u00bf\u00c7\u00af\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00e0\u00af\u00c6\u00d0 \u00ba\u00c9\u00bf\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\n\n\u00a4\u008a\u0081\" \u00cd\u00ba\u00df\u00ba\u00c6\" 22 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 5 \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a5)\"(\u00a6) \u00a3\u00be\u00c6\u00be\u00d7 (\u00a7) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00bf\u00c8\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00cd\u00ba\u0081\u00ba\u00c8\u00ce\u00af\u00bb\u00c7\u00af\u00b1\u00c6\u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b6\u00c7\u00ce\u00af\u00a9\u00af\u00c6\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u00be\u00c6 \u00a9\u00e1\u00b7\u00c6\u00b6\u00cd\u00b6\u00c7\" \u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00a3\u00af\u00c6\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081 \u00db\u0088\u008c\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7\u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00c7\u00b8 \u008c\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u00d5 \u00cc\u00b9\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7\" \u00a5\u00c1\u00bd\u00c6\u00de\u00bf\u00c6 \u00a9\u00d7\u0089\u00b7\u00c6\u00b6\u00c8\u00bb\u00cd\u00b6\u00c7 \u00a3\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00f2\u0081\u00de \u00ba\u00c7\u00b6\u00af\u00c6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00b1\u00c6\u00cc\u00b1\u00be\u00c6\u00df\u00b9\u0088\u00bb\u00c7\u00af\u00e2\u00bf\u00c6\u00bf \u00c1+\u00c6\u00af\u00c8 \u00a7\u00b6\u00c6\u00b6\u00bc\u00c1\u00c7\u00b6\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00c7\u00b9\u00c6\u00da\u00de\u00b6\u00c8 \u00db\u00bd\u00c8\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00e2\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c9\u00bf\u00bf\u00c8\u00b9\u00c6\u0089\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b6\u00c7\u00ce\u00af \u00a3\u00ce\u00ba\u00b7\u00c6\u00b6\u00b6\u00c7\u00af\u008c\u00dd\u00b9\u00c6\u0089\u0081\"\u00b9\u00b6\u00c8\u00ce\u00b8\u00b7\u00c6\u00d7 \u00b7\u00c7\u00b4\u00c6\u00af\u00bf\u00c8\u00d9\u00bf\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00e0\u00af\u00c6\u00d0\u00ba\u00c9\u00bf\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d\u00b0\n\n14\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 58 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u0089\u00bc\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cc\u00b6\u0081\u00b9\u00d7\u00b4\u0081\" \u00a3\u00d7\" \u00a3\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00c6 58\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u00c1\u00c7\u00af\u00b9\u00c6\u00b9\u00bb\u00d9\u00de\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\u2013\n\n58\u00a3\u00b0 (1) \u00a7\u00be\u00c6\u00be\u00c7\u00b1\u00b9\u00c6 \u00b9\u00bb\u00b5\u00c8\u00bb\u00c7\u00af\u008c\u00dd\u00b7\u00c6\u00d7\u00cc\u00af\u00c7\u00ae\u00d5\" \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u0088\u00c1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6 \u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u0081\u00f2\u00be\u00ba\u00c6 \u2013\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c658\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6\u0089\u00bc\u00c8\u00ce\u00c1\u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u201c\u00a7\u00be\u00c6\u00be\u00c7\u00b1\u00b9\u00c6\u00b9\u00bb\u00b5\u00c8\u00af\u00e0\u00af\u00c6\u00d0\u00c1\u00bc\u00c8\u00ce\u00bb\u00ba\u00c9\u00bf\u00bf\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c615\n\n(\u00a3) \u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00c8\u00be\u00c6\u00be\u00ce\u00bd \u008c\u00bd\u00c6\u00b9\u00ce\u00b8\u00bb\u00c7\u00bf\u00bc\u00c7\u00af\u00e2\u00bf\u00c6\u00bf \u00a9\u00c1\u00cd\