    "chunk_text": "5\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 7 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2\" \u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cd\u00b1\u00ce\u00c1\u00af\u00c6\u00af\u00c7\u00b8 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2 \u00db\u00e1\u00c1\u00d7\u00ba\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0 \u00cc\u00c1\u00bf\u00c8\u00cd\u00bb\u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00df\u00bf\u00c6\u00bf \u00c1+\u00c6\u00af\u00c8 \u00ac\u0081\u00bd\u00c8\u0081\u00f2\u00be\u00ba\u00c6 \u00cc\u00b9\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cd\u00b1\u00ce\u00c1\u00af\u00c6\u00af\u00c7\u00b8 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2 \u00db\u00e1\u00c1\u00d7\u00ba\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0 \u00cc\u00c1\u00bf\u00c8\u00cd\u00bb\u008a\u00dd\u00b7\u00c6\u00d7 \u00c1+\u00c6\u00af\u00c8 \u00ac\u0081\u00bd\u00c8\u0081\u00f2\u00be\u00ba\u00c6 \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u00d5 \u00b7\u00c7\u00b5\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00cc\u00b9\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6\u00a5\u00b6\u00c6\u00b6\u00c7\u00bd\u00c6\u00bd\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00813 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00816 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00817 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c67\n\n7\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 22 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00bd\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n(1) \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (3) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u2013\n\n(\u00a3) \u201c\u00c1\u00bc\u00c8 \u00a3\u00bd\u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u201d \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u201c\u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00b6\u00c7\u00b8\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 III \u00a3 \u00a9\u0081\u00d9\u00ba\u00c6\u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00bd\u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00c1\u00bc\u00c8 \u00b6\u008c\u00bc\u00c6\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8 \u00a3\u00bd\u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a9\u00ae\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be \u00db\u00ba\u00c6 ;\n\n(\u00a4) \u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00bc\u00c8\u00e2\u00af\u00c6\u00af\u00c7\u00b8 \u00b7\u00c7\u0081\u00af\u00c7\u00ba\u00c6 \u00af\u00c7\u00b9\u00c6\u00da\u00c1\u00c7\u00b1\u00af\u00b6\u00c6\u00ce\u00b6 \u00b7\u00c9\u00af\u00c6\u00af\u00c8\u008c\u00b4\u00c6\u00d5 \u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00af\u00c7\u00b9\u00c6\u00da \u00c1\u00c7\u00b1\u00af\u00b6\u00c6\u00ce\u00b6 \u00ba\u00c7\u00bd\u00c6\u00bd\u00c9\u00d5\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c\u00a4\u008a\u0081\" \u00cd\u00ba\u00df\u00ba\u00c6\" \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00d9\u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00bb \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c7\u00bf\u00c8\u00b8\u00c7\u00be\u00c6\u00b7\u00c7\u0081\u00af\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00be\u00c6 (\u00a4\u00b4\u00ba\u00c6\u00b9\u00bc \u0096\u00b6\u00ba\u00c6)\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00ae\u00b4+\u00c6\u00af\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7\u00cd\u00b1\u00ce\u00c1\u00af\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u0081\u00ba\u00c9\u00d7\u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a7\u00bf\u00c6\u00bf\u00c9\u00b4\u00c6\u00d5 \u00c1\u00bc\u00c8\u00b9\u00b6\u00c8\u00ce\u00b8\u00b7\u00c6\u00d7 \u00b1\u00b6\u0096\u00b6\u00b6\u00c6\u00d7\u00af\u00c6\u00d0 \u00ba\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d ;\n\n(2)\u00ab\u00b7\u00c6\u00b6\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00e2\u00af\u00c6\u00af\u00c7\u00b8 \u00a5\u00bc\u00ae\u00b4\u00c7\u00c1\u00d7 \u00af\u00c7\u00b9\u00c6\u00da\u00c1\u00c7\u00b1\u00af\u00b6\u00c6\u00b6\u00c8\u0081 (\u00a6) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u201c\u00ba\u00c8\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00de \u00a7\u00bf\u00c6\u00bf\u008c\u00b4\u00b6\u00c6\u00d7\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u201c\u00ba\u00c9\u00bf\u00bf\u00c8\u00b9\u00c6\u00da\u00b1\u00c6\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008120 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008122 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c68\n\n\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u0