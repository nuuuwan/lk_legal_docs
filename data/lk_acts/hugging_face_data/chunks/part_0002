    "chunk_text": "\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008120 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008132\u00a3 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 32\u00a4\u00a9\u0081\u00d9\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb\u0089\u00bc\u00c8\u00e2\u00af\u00ce\u00bf\u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u201c\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00c1\u00dd\u00b4\u00c7\u00b7\u00c6\u00b6\u00a3\u00bd\u00c8\u00af\u00c6\u00ce\u00af\u00af\u00ce\u00bf\u00b1\u00c6\u00b1\u00ba\u00bc\u00c6\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00a9\u0081\u00b9\u00d7\u00b0\n\n\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6\u00af\u00b4\u00c6\u0088\u00b4+\u00c6\u00af\u00ce\u00bf\u00a3\u00be\u00c6\u00be\u00d7\u00af\u00b4\u00c6\u00b4\u00ce\u00ba\u00b9\u00c6\u00da\u00af\u00ce\u00bf\u00a5\u0088\u00b6\u00c6\u00b6\u00c0\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n11\n\n\u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00af\u00b4\u00c6\u00b4\u00ce\u00ba\u00b9\u00c6\u00da \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u008c\u00b4\u00b6\u00c6\u00d7\" \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00d7\u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00bd\u00c6\u00bd\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a7\u00bc\u00c8\u00ba\u00ba\u00bf\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00a3\u00df\u00c1\u00be\u00bc\u00c6\" \u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u00b8 \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00cc\u00be\u00c7\u0081\u00bd\u00c8\u0081 \u00f2\u00be\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00a6\u00d5\u00b9\u00d5\u00ba\u00c6 \u00a4\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7\u00a4\u00b4\u00c6\u00af\u00ce\u00bf \u00a3\u00c1\u00c6\u00c1\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u008b\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0\u00db\u0081 \u00a3\u00b7\u00c6\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00ce\u00bb\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00c1\u00ce\u00b6 \u00b7\u00c8\u00de\u00b6\u00c6\u00d7\u00ba\u00c7\u00de \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c7\u00ba\u00c6\u00b0 \u00a3\u00b6\u00c6\u00cd\u00b6\u00b6\u00c8 \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c7\u008a\u00d9\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u008b\u00be\u00c6 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00aa\u00e1 \u00b7\u00c7\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00b6\u00c7\u00af \u00a5\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00db\u00b6\u00be\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a9\u00c1\u00c6\u00c1\u00c7\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00a9\u00c1\u00c6\u00c1\u00c7\u00b4\u00c6\u00af\u00bf\u00c6\u00ba\u00c9\u00d7 \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6 \u00ac\u0081\u00de \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u008c\u00b4\u00b6\u00c6\u00d7 \u00a3\u00c1\u00c6\u00c1\u00c7\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6\" \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u00bb\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a9\u00c1\u00c6\u00e2\u00bc\u00c8\u00ba\u00ba\u00bf\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00a3\u00df\u00c1\u00be\u00bc\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6\u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00cd\u00b6\u00c7 \u00a3\u00c1\u00c6\u00e2\u00bc\u00c8\u00ba\u00ba\u00bf\u00c8\u00af\u00c6\u00d0\u00ba\u00c6\u00a3\u00df\u00c1\u00be\u00bc\u00c7\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00c7\u00be\u00b6\u00c6\u00b6\u00c8\u00d9\u00bf\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00d9\u00ba\u00b6\u00c8\u00bb\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\u00c1\u00c7\u00bd\u00c7\u00b8\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00c7\u00be\u00b6\u00c6\u00b6\u00c8\u00d9\u00bf\u00c6 \u00a3\u00b6\u00b8\u00d7\u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00c7\u00d5\u00b4\u0081 \u00a5\u00b5+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u00e1\u00af\u00b6\u00c6 \u00b6\u00c1\u00de\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\"\u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00c