    "chunk_text": "\u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00ef\u00ba\u00f2\u00c4\u00e5\u00cc\u00e8\u00a8 \u00c0\u00bc\u00be\u00c4\u00a8\u00e0 \u00c4\u00ba \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00cc\u00e6\u00cc\u00df\u008a\u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00ba\u00e5\u00a8\u00e0 \u00a8\u00c8\u00e0,\u201d;\n\n(4)(3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00bc\u00c9\u00be \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0\u2014\n\n(\u00a1) \u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0, (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (iv) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6\u00b4\u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4, \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0:\u2014\n\n(vi)\u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00e6\u00ad\u00dd\u008a \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, 1996 \u00a1\u00e2\u00a8 33 \u00bc\u00c7\u00be \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8\u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc\u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0, \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba\u00c2\u00f3 \u0097\u00c8\u008a\u00c2\u00be\u00c6 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00d1 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc, \u00a1\u00e6\u00ad\u00dd\u008a\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00a8\u00eb\u00b4 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00c0\u00e8\u00b8\u00e8\u00cc \u00ef\u00cd\u00e5\u00e0\u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00c6\u008a \u00c3\u00e5\u00b8\u00e0\u00b6 \u00a1\u00e5\u00be\u00c6\u00be\u00c6\u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00c8\u00c2\u00be 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8\u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00ce \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be,\u00c2\u00be\u00e0\u0093\u00ba \u00ef\u00da\u00aa\u00eb \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00f8\u00be\u00e0 \u00c8\u00c2\u00be \u00c6\u008a \u00c3\u00e5\u00b8\u00e0\u00b6\u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00c6\u008a \u00c3\u00e5\u00b8\u00e0\u00b6 \u00c4\u00ba ;\n\n(vii) \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00c3\u00e5\u00b8\u00e0\u00b6 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00cc\u00bf\u00cd\u00e5 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(\u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00ef\u00cd\u00e5\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c3\u00e5\u0097\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc,\u00c2\u00be\u00e0\u0093\u00ba \u00ef\u00da\u00aa\u00eb \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00f8\u00be\u00e0 \u00c8\u00c2\u00be \u00c0\u00e8\u00d6\u00c6\u00ba \u00ef\u00cd\u00e5\u00e0\n\n2006 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba4\n\n\u00c6\u00be\u00e0\u00ba\u00f2\u00cc\u00ec\u00ba\u00f2 \u00a1\u00e6\u00ba\u00eb\u00dd \u00c0\u00e8\u00d6\u00c6\u00ba \u00ef\u00cd\u00e5 \u00c6\u00be\u00e0\u00ba\u00f2\u00cc\u00ec\u00ba\u00f2\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c9\u00be2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6)\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00a1\u00be\u00ea\u00c4\u00ba\u00a8\u00ce \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c0\u00e8\u00d6\u00c6\u00ba \u00ef\u00cd\u00e5\u00e0 \u00c6\u00be\u00e0\u00ba\u00f2 \u00cc\u00ec\u00ba\u00f2 \u00c4\u00ba ;\n\n(viii) \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c9\u00e6\u00be\u00f8\u00c3\u00e5\u00b8\u00e0\u00b6 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00c2\u00be\u00e0\u0093\u00ba \u00ef\u00da\u00aa\u00eb\u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00f8\u00be\u00e0 \u00c8\u00c2\u00be \u00c3\u00e5\u00b8\u00e0\u00b6 \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9, 2 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e7) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00a1\u00c0\u00be\u00c6\u00be \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00a1\u00be\u00ea\u00c4\u00ba\u00a8\u00ce \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c3\u00e5\u00b8\u00e0\u00b6 \u00c4\u00ba ;\n\n(ix)\u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00c3\u00e5\u00b8\u00e0\u00b6 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00cc\u00bf\u00cd\u00e5 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(\u00a1\u00e7) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5\u00c3\u00e5\u0097\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00c0\u00d6\u00c6\u00ba \u00ef\u00cd\u00e5\u00e0 \u00c6\u00be\u00e0\u00ba\u00f2\u00cc\u00ec\u00ba\u00f2\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e7) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a1\u00c0\u00be\u00c6\u00be\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00ce \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00c9\u00be \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be, \u00c2\u00be\u00e0\u0093\u00ba \u00ef\u00da\u00aa\u00eb \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00f8\u00be\u00e0 \u00c8\u00c2\u00be\u00c0\u00e8\u00d6\u00c6\u00ba \u00ef\u00cd\u00e5\u00e0 \u00c6\u00be\u00e0\u00ba\u00f2\u00cc\u00ec\u00ba\u00f2 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00c6\u008a \u00c0\u00e8\u00d6\u00c6\u00ba \u00ef\u00cd\u00e5\u00e0\u00c6\u00be\u00e0\u00ba\u00f2\u00cc\u00ec\u00ba\u00f2 \u00c4\u00ba ;\u201d"
