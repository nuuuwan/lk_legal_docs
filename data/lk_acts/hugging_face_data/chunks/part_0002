    "chunk_text": "\u201c\u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7 \u00a3\u00df\u00c1\u00be\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00b9\u00c6\u00b9\u00b5\u00c8\u00af\u00ce\u00bf\u00b9\u00c6 \u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00c8\u00b6\u00c6\u00b6\u00be\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\" \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00b9\u00c6 \u00b9\u00b5\u00c8\u00bb\u00af\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u0081\u00b6\u00ce\u00be\u00c1\u00bc\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c7\u00bf\u00c6 \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00b9\u00c6 \u00b9\u00b5\u00c8\u00bb\u00af\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00b6\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00df\u00c1\u00be\u00af\u00ba\u00c6\" \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00a3\u00df\u00c1\u00be\u00af\u00ba\u00c6\" \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7 \u00d7\u00ce\u00b5\u00bb\u00df\u00c1\u00be\u00af\u00ba\u00c6\"\u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7 \u00db\u00af\u00c1\u00bc\u00c6 \u00b7\u00c8\u00ce\u00be\u00bb\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00cc\u00af\u00bf\u00bc\u00c1\u00af\u00c6 \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7 \u00a3\u00df\u00c1\u00be\u00af\u00ba\u00c6 \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7 \u00c1\u00bf\u00e2\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00cc\u00b1\u00c7\u00b6\u00c6\u00b6\u00c7\u00ae\u00ce\u00ba\u00ce\u00bb\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00c7\u00d7\" \u00da\u00bd\u00b7\u00c9+\u00c6\u00af\u00be\u00c7\u00af \u00a3\u00df\u00c1\u00be\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\u00b9\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00af\u00b4\u00c6\u00b4\u0088\u00b4+\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00b4\u00c6\u0088\u00b4+\u00c6\u00af\u00bf\u00c8\u0081 \u00b9\u00c7\u00af+\u00c6\u00af\u00bf\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00c1\u00bd\u00c6\u00de\u00af\u00c6\u00d0\u00b6\u00c6 \u00d7\u00ce\u00b5\u00ce\u00ba\u00bb\u00c7\u00b8 \u00af\u00c7\u00b5\u00c8 \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6\u00b0\u201d.\n\n11\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8+\u00c6\u00af\u00bf\" \u00b6\u00ba\u00c8\u00c0\u00c6 \u00a7\u00ce\u00bc\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00ce\u00b4\u00cd\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00bb \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba\u008a\u0081\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf\u00a7\u00ce\u00bc \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 18 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00b9\u00c6\u00b9\u00b5\u00c8\u00af\u00bf\u00c6 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c619\n\n\u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00b4\u00c6\u00b4\u00f2\u00be+\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00b1\u00b4\u00c6\u00b4+\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00b6\u00ba\u00c8\u00c0\u00c6\u00b9\u00c6 \u0089\u00bc\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00c1\u00dd\u00b4\u00c7\u00b7\u00c6\u00b6\u00b1\u00b7\u00c6\u00b6\u00c7 (\u00a7\u00bf\u00c6\u00b7\u00c7\u00d5) \u00f4\u00b9\u00c7 1\"387 : (\u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00d5) \u00f4\u00b9\u00c7 1\"849 ; \u00ac\u00c1\u00c6\u00cd\u00c1\u00c7\u00bc\u00c7\u00ae\u00d5\u00ba\u00c6 \u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00bc\u00c6\u00ba\u00c7\u00b6\u00ba\u00c6 15 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u0081 \u00a9\u00b6\u00c8\u00bc\u00c6\u00c1\u00dd\u00ba\u00c6 \u00a4\u00ae\u00d5\u00af\u00c6\u00af\u00c7\u00b8 \u00b1\u00b7\u00c6\u00b6\u00c7\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00b4\u00c6\u00b1\u00af\u00bc\u00c6\"\u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00b4\u00df\u00c1\u00be\u00af\u00ba\u00c6\" \u00a5\u00be\u00b0 32\" \u00b6\u00c8\u00bc\u00c7\u0081\u0083\u00cd\u00c1\u00bc\u00c6\u00af\u00c6\u0083 \u00a5\u00be\u00c6\u00be\u00ba\u00c6\" \u00cd\u00be\u00c7\u00b4\u00c6\u00b4\u00c3\u00c6 \u00cd\u00bd\u00c7\u00b4\u00c6\"\u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da 01 \u00a9\u0081\u00bd \u008c\u00be\u00c7\u00b1\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a3\u00d9\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00b4 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6"
