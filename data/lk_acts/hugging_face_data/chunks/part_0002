    "chunk_text": "(ii)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00cc\u00e8\u0090\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00be\u008a \u00cc\u00cd \u00a6\u00c4\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cc\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00ef\u00c8\u00cc \u00c0\u00e8\u00c6\u00c9\u00c7 \u00ef\u00aa\u00be \u00a7\u00cd\u00ea\u00ef\u00cc\u00e5\u00c6\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8 \u00c9\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00be\u008a ; \u00ef\u00cd\u00e5\u00e0\n\n(iii) \u0094\u00c6 \u00be\u00f8\u00cc\u00e5 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00bc\u00fb\u00c4\u00b4 \u00a1\u00a8\u00c4\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00be\u00c4 ; \u00ef\u00cd\u00e5\u00e0\n\n(iv)\u00a6\u00ef\u00cc\u00e0 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00bc\u00fb\u00ef\u00c4\u00be\u00e0 \u00c9\u00ce\u00a8\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00be\u008a,\n\n\u00a6\u00c4 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00a1\u00e6\u00ba\u00e0\u00be\u008a \u00a6\u00c4 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00a1\u00e5\u00ef\u008c\u00ca\u00f1 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n22. 1995 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ef\u00ba\u00e0\u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00f8\u00be\u00e0 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00bc\u00e5\u00ce \u00c9\u00be \u00a8\u00f8\u00cc\u00e8\u00f3 \u00bc\u00ba\u00e0\u00ba\u00c0\u00b8\u00e8\u00c9\u00ea\u00b6\u00c6\u00a8\u00b4, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00b4, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8\u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00c6\u00a8\u00e0 \u00cc\u00cd \u00a6\u00e0 \u00c0\u00b8\u00e8\u00c9\u00ea\u00b6\u00c6\u00a8\u00e0, \u00ef\u00cd\u00e5\u00e0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0, \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n1995 \u00a1\u00e2\u00a814 \u00bc\u00c7\u00be\u00cc\u00e5\u00a8\u00e0\u00cb\u00e8(\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be)\u00c0\u00be\u00ef\u00ba\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00bc\u00e5\u00ce\u00ef\u00be\u00e5\u00c9\u00be \u00c2\u00c9.\n\n162006 \u00a1\u00e2\u00a8 19 \u00bc\u00c7\u00be \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c0\u00be\u00ba\n\nVI \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u0097\u0097\u00bd \u0097\u0093\u0097\u00bd\u00e5\u00be\n\n23. \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00ef\u00c4\u00cd\u00fa \u00c0\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6. \u00a6\u00be\u008a :\u2014\n\n(\u00a1)\u00a1\u00be\u00e0\u00ba\u00f8\u00c4 \u00a8\u00e6\u00c4\u00ba\u00f8 \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00cc\u00a8\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e8\u00c6\u00e5 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00f8\u00d7\u00c4\u00ef\u00cd\u00e5\u00e0 \u00a8\u00c9\u00c7 \u00be\u00e5\u00c4\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00e6\u00bf\u00fa\u00be\u00e0\u00ef\u00c9\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00ef\u00ba\u00cc\u00e0\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb \u00be\u00f9\u00c6\u00e5\u00bc\u00be\u00c6\u00a8\u00b4 ;\n\n(\u00a1\u00e5)1991 \u00a1\u00e2\u00a825 \u00bc\u00c7\u00be \u0097\u00f3\u00c8\u00e8 \u00cc\u00e2\u00ef\u00bc\u00e0\u00ca \u00c0\u00be\u00ef\u00ba\u00e0 17 \u00c9\u00e6\u00be\u00f8 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(6) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u0097\u00f3\u00c8\u00e8 \u00cc\u00e2\u00ef\u00bc\u00e0\u00ca\u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00b4 ;\n\n(\u00a1\u00e6)(82 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u0097\u00be\u00f8\u00c4\u00c6 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 3 \u00c9\u00e6\u00be\u00f8\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00c6 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8\u00c0\u00d6\u00bc\u00fa \u00c9\u00ec \u00be\u00f9\u00ba\u00f8\u00c4\u00c6 \u0094\u00c8\u00e0\u00c0\u00ba\u00f2\u00c6\u00a8\u00b4 ;\n\n(\u00a1\u00e7)(122 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00a1\u00e6\u00ef\u00b4\u00e5\u00e0\u00da\u00be\u00f8 \u00c2\u00c8\u00c0\u00ba\u00f2 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 2\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00c6 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c0\u00d6\u00bc\u00fa \u00c9\u00ec \u00a1\u00e6\u00ef\u00b4\u00e5\u00e0\u00da\u00be\u00f8\u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00b4 ;\n\n(\u00a2)(87 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00c3\u00e5\u00c7 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 \u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00c6 \u00a8\u00c7\u00a1\u00e6\u00ba\u00f8 \u00c0\u00d6\u00bc\u00fa \u00c9\u00ec \u00a1\u00be\u00ea\u0095\u00ba \u00c9\u00f1\u00e2\u00d4\u00ba \u00c0\u00f2\u00ba\u00f8\u00c1\u00e5\u00c8\u00e9\u00c6 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa ;\n\n(\u00a3)\u00c6\u008a \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00c6\u00a8\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00c9\u00c7\u00e5\u00bc\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec\u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a4)24 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00c2\u00be\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00ef\u00a8\u00e5\u00b4 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00b4\u00ef\u00cd\u00e5\u00e0 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u00a8\u00b4,\n\n\u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n24.(1) \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa \u00cc\u00e7\u00bc\u00fb\u00c4\u00b4 \u00ef\u008a \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00be\u00f8\u00c6\u0095\u00ba \u00ef\u00cd\u00e5\u00e0 \u00c2\u00c8\u00c6 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8\u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00e5\u00c7\u00b8\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6\u00ef\u00a8\u00e5\u00b4 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a1\u00c7\u00c4\u00ea\u00b8\u00ea \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8\u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0, \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00cc\u00cd\u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00c4\u00cc\u00e5 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa \u00cc\u00e5\u00bc\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa.\n\n\u00c0\u00be\u00ba \u00a1\u00bc\u00e5\u00ce\u00d1\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00cc\u00e9\u00c4\u00e5 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 19 \u00bc\u00c7\u00be \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c0\u00be\u00ba17"
