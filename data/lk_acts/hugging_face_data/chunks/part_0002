    "chunk_text": "24.\u00ef\u008a \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00ba\u00c4\u00e5 \u00ef\u00c9\u00ba \u00c0\u00c9\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00c2\u00c8\u00c6\u00a8\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00a8\u00e5\u00da\u00c6\u00c6\u00a8\u00e0 \u00a2\u00b4\u00ea \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00c0\u00cd\u00c7 \u00ef\u00bc\u00be, \u00a1\u00c9\u00cd\u00fa\u00c7 \u00a8\u00c7\u00be, \u00ba\u00da\u00b0\u00be\u00c6 \u00a8\u00c7\u00be, \u0094\u00c6\u00aa\u00be\u00e0\u00c9\u00be, \u00c0\u00d6\u00c3\u00c9 \u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c0\u00cd\u00e5\u00cc \u00a8\u00c7\u00be \u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00c4, \u00ef\u008a\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb\u00a2\u00bc\u00fa\u00d6\u00ef\u00c6\u00e0 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00ef\u00c9\u00be \u00c8\u00ab\u00ea \u00be\u00b6\u00ea \u0097\u00c3\u00e5\u00aa\u00c6\u00a8\u00f8\u00be\u00e0 \u00c0\u00cc\u00ea \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u0097\u00b4, \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ef\u00bc\u00a8\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0097\u00cc\u00e8\u00c0\u00be\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4\u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00bc\u00b6\u00c6 \u00c6\u00be \u00bc\u00b9\u00ea\u00c9\u008a\u00ef\u00bc\u00a8\u00b4\u00c4 \u00a7\u00cd\u00ea \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n25.\u00c0\u00bc \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00be\u00f1\u00e5\u00da\u00bb\u00c6\u00a8\u00e0 \u00a1\u00c9\u00ca\u00f1 \u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u0095\u00cc, \u00ef\u008a\u00c0\u00be\u00ef\u00ba\u00cd\u00fa_\n\n\u00c9\u00e6\u00c7\u00bc\u00e8 \u00cd\u00e5 \u00bc\u00b8\u00e0\u00b6\u00be.\n\n\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n\u00cc\u00bc\u00e0\u00c3\u00e5\u00c9\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be\u00c8\u00bc \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00be\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9.\n\n2005 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c9\u00f1\u00cc\u00be \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c0\u00be\u00ba17\n\n\u00c2\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00da\u00b0\u00be\u00c6\u00a8\u00e0 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00cc\u00e0\u00c9\u00e5\u00c3\u00e5\u0097\u00a8 \u00ef\u00cd\u00e5\u00e0 \u0095\u00be\u00e8\u00cc\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00cc\u00e8\u00bc\u00e0\u0093\u00c6\u00a8\u00e0, \u00cc\u00e6\u00c2\u00e6\u0097\u00be\u00e0\u00c4 \u00cc\u00e8\u00f3\u00d1\u00c4\u00ef\u00cd\u00e5\u00e0 \u00cc\u00e8\u00f3\u00d1\u00c4\u00b4 \u00a1\u00e5\u00cc\u00be\u00e0\u00be \u00d1\u00c4 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be \u00a1\u00ba\u00c7, \u00a3\u00b4_\n\n(\u00a1)\u00be\u00e5\u00c6\u00c6\u00e5\u00c4\u00a8\u00e0 ;(\u00a1\u00e5)\u00cc\u00ea\u00ce\u00e8 \u00cc\u00ea\u00ce\u00ad\u00a8\u00e0 ;(\u00a1\u00e6)\u00aa\u00e2 \u00c9\u00ba\u00eb\u00c7\u00a8\u00e0 ;(\u00a1\u00e7)\u00be\u00f8\u00c6\u00ad\u00c6\u00a8\u00e0 ;(\u00a2)\u00a8\u00e5\u00da\u0095\u00a8 \u00a4\u00c0\u00f7\u00c9\u00c6\u00a8\u00e0 ;(\u00a3)\u00cc\u00ea\u00be\u00e5\u0095\u00c6\u00a8\u00e0 (\u00c3\u00ed\u0095\u00a8\u008a\u00c0\u00be\u00e5\u00cc\u00be\u00e0\u00be \u00ae\u00c8\u00be\u00c6\u00a8\u00e0) ;(\u00a4)\u00c3\u00ed\u0095 \u00a8\u008a\u00c0\u00e5\u00c9\u00a8\u00e0 ;(\u00a4\u00f0)\u00aa\u00eb\u00c9\u00be\u00e0 \u00a4\u00c0\u00f7\u00c9\u00c6\u00a8\u00e0 ;(\u00a6)\u00cc\u00c4\u00ea\u00f7\u00e9\u00c6 \u00a4\u00c0\u00f7\u00c9\u00c6\u00a8\u00e0 ;(\u00a6\u00e0)\u00aa\u00fa\u00be\u00e0\u00be\u00a8\u00e0 ;(\u00a7)\u00c9\u00cc\u00e2\u00aa\u00ba\u00c6\u00a8\u00e0 ;(\u0081)\u00c0\u00e8\u00c0\u00e8\u00d7\u00c4\u00a8\u00e0 ;(\u00a8)\u00aa\u00eb\u00c9\u00be\u00e0 \u00c0\u00f2\u00cd\u00e5\u00c7\u00c6\u00a8\u00e0 ;(\u00aa)\u00cc\u00e8\u0097\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c3\u00f1\u00be\u00e0\u00ba\u00c7 \u00aa\u00e6\u00b4\u00ea\u00c4\u00a8\u00e0 ;(\u00ae)\u00c7\u00cc\u00e5\u00c6\u00be\u00f8\u00a8 \u00a1\u00be\u00ba\u00eb\u00c7\u00a8\u00e0 ;(\u00b0)\u0097\u00a8\u00f8\u00c7\u00b8\u00ca\u00fb\u00c8\u00e8\u00ba\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u00cd\u00b4\u00aa\u00ba\u00e0 \u00cd\u00bc\u00fa\u00cc\u00e8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00e0 ;(\u00b4)\u00ef\u00aa\u00e5\u00b6\u0094\u00c4 \u00cc\u00cd \u00c4\u00ea\u00cd\u00ea\u00ef\u00bc\u00e0 \u00cc\u00e8\u00f3\u00c9\u00be \u00ef\u00ba\u00c8\u00e0 \u00c0\u00e8\u00b4\u00e5\u00c7 \u00aa\u00e6\u00c8\u00e9\u008a\u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00ef\u00ba\u00c8\u00e0 \u00c0\u00e8\u00b4\u00e5\u00c7 \u00aa\u00e6\u00c8\u00e9\u00c4\u00a8\u00e0 ;(\u00b6)\u00be\u00f1\u00cb\u00e0\u0090\u00a8 \u00a1\u00e5\u00c0\u00bc\u00e5\u00c9\u00a8\u00e0 ;(\u00b8)\u00be\u00e5\u00aa\u00d6\u00a8 \u00cc\u00cd \u00c9\u00be\u00e5\u00be\u00e0\u00ba\u00c7 \u00aa\u00fa\u00be\u00f8\u00aa\u00e6\u00be\u00f9\u00c4\u00a8\u00e0 ;(\u00ba)\u00ef\u00c9\u00c7\u00ce \u00a9\u00e5\u00bc\u00be\u00c6 \u00d1\u00c4\u00a8\u00e0 ; \u00cc\u00cd(\u00bc)\u00ef\u00b4\u00e5\u00be\u00e5\u00ef\u00b6\u00e5\u00e0 \u00ae\u00b8\u00e0\u00b6 \u00c4\u00e5\u00c7\u00e6\u00ba\u00c6\u00a8\u00e0, \u00a1\u00a8\u00eb\u00b8\u00ea \u00cc\u00e6\u00c7 \u00c9\u00e6\u00bc\u00fb\u00c4\u00a8\u00e0\u00cc\u00cd \u00bc\u00c7\u00e6\u00b8\u00ea \u00aa\u00fa\u00aa\u00fa\u00c7\u00e6\u008a \u00cc\u00cd\u00fa\u00ba \u00a8\u00eb\u00b8\u00e5\u00b4\u00ea\u00c9\u00a8\u00e0,\n\n\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ;\n\n\u201c\u00c9\u00f1\u00cc\u00be \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00ba\u00f8\u00c0\u00e8\u00c6\u00c9\u00c7\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00cc\u00e8\u00f3\u00d1\u00c4\u00b4 \u00a1\u00e5\u00cc\u00be\u00e0\u00be \u00c9\u00f1\u00cc\u00be\u00c6\u00a8\u00c1\u00c8\u0097\u00c0\u00e5\u00a8 \u00c9\u00ce\u00a8\u00e0\u00c9\u00e5 \u00c8\u00e9\u00c4, \u00a1\u00c9\u00c4 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4\u00c0\u00f2\u00ba\u00f8\u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00cc\u00be\u00c6\u00a8\u00b4 \u00c0\u00cc\u00ea\u00c9\u00a1\u00e6\u00ba\u00f8\u00c9\u00be \u00c1\u00c8\u0097\u00c0\u00e5\u00a8 \u00b0\u00be\u00ba\u00e5\u00c9 \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb\u00b4 \u00a1\u00c6\u00ba\u00e0,\u00c7\u00b0\u00c6\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0 \u00c2\u00c8\u00c0\u00e7\u00c4 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00ca\u00f1 \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c6\u00e5\u00e0\u00aa\u00f1 \u00c9\u00be \u00c0\u00e8\u00c6\u00c9\u00c7 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be \u00a1\u00ba\u00c7,\u00ba\u00ba\u00e0\u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u008a \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00c9\u00e5\u00b4\u00cc\u00cd\u00c3\u00e5\u00aa\u00fb\u00d1\u00c4 \u00a3\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ;\n\n2005 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c9\u00f1\u00cc\u00be \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c0\u00be\u00ba18"
