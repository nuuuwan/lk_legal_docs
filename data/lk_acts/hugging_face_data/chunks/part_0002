    "chunk_text": "67' \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00ac\u0081\u00bd\u00c8\u0081 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6 \u00a3\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c6 \u00a9\u0081\u00cd\u00b9\u00c7\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00c7\u00ba\u00b6\u00ba\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00d0\u00ba\u00c6 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00b0\n\n68' \u00a5\u00c1\u00c6\u00c1\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00b6\u00dd\u00ba \u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00af\u00bf\u00c6\u00db\u00b6\u008b\u00bb\u00c1\u00bd\u00c6\u00bd\u00c8\u00bd\u00c6\u00d0 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n\u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c6 XI\n\n\u00b1\u00c8\u00bd\u00b9\u00c6\u00da \u008c\u00b4\u00bb+\u00c6\u00af\u00bf\u00c6\n\n69' \u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00ce\u00b6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0\n\n\u00a4 - \u00cc\u00b9\u00de\u00b7\u00bc\u00c6\u00af\u00bf\u00c6, \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c6,\u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00de\u00b7\u00bc\u00c6\u00af\u00bf\u00c6 \u00db\u00b6\u008b\u00cd\u00bb\u00c7\u00bc\u00c6\n\n70' \u00cc\u00b9\u00de\u00b7\u00bc\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00df\u00ba\u00c6 \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00df\u00ba\u00c6 \u008c\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00af\u00bf\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00df\u00ba\u00c6, \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c6\u00c1\u00bc\u00c8 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00ce\u00b4\u00bb\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u00b6\u00df\u00ba\u00c6\u00b0\n\n71' \u00a5\u00bb\u00be\u00c7\u00b6\u00c1\u00bc\u00c7\u00af\u00e2\u00bf\u00c6\u00bf \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00d7 \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00c1\u00bc\u00c8 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00b8\u00c1\u00bc\u00c7\u00b6\u00be\u00c6\u00b0\n\n72' \u00ba\u00bc\u00b5\u00cc\u00ba\u00bb\u00c6\u00b6\u00c8\u00bb \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00bc\u00c8\u00af\u00c6\u00d0\u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00de\u00b7\u00bc\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00ce\u00b4\u00bb\u00c1\u00bc\u00c7\u00b6\u00be\u00c6\u00b0\n\n73' \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00de\u00b7\u00bc\u00c6\u00af\u00bf\u00c7\u00be\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00c1\u00b9\u00c6\u00b9\u00b4 \u00cd\u00c1\u00ae\u0088\u00bb \u008c\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00d5\u00af\u00e0\u00ba\u00c6, \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00de\u00b7\u00bc\u00c6\u00af\u00bf\u00c6 \u00ba\u00c9\u00d7\u00ba\u00c6 \u00b9\u00bb\u0081 \u00cc\u00b9\u00de\u00b7\u00bc\u00c6\u00af\u00bf\u00c6 \u00ba\u00c9\u00d7\u00ba\u00c6 \u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00df\u00ba\u00c6\u00b0\n\n74' \u00e7\u00b4\u00c6\u00d5 \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00dd\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bd \u00cd\u00c1\u00bd\u00c6\u00de\u00b7\u00dd\u00ba\u00c6\u00b0\n\n\u00a5- \u00e7\u00de \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00bf\u00c6\u00b0\n\n75' \u00e7\u00de \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u0081\u00de\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00bb\u00c7\u00af\u00af\u00c6\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00a6- \u00b9+\u00c6\u00d0\u00b4\u00ce\u00ba\u00af\u00bf\u00c6\n\n76' \u00b9+\u00c6\u00d0\u00ce\u00b4\u00ce\u00ba \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00ce\u00b6 \u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\n\n170\n\n170\n\n171\n\n172\n\n174\n\n175\n\n176\n\n177\n\n178\n\n180\n\nix\n\n\u0089\u00bc\u00c8\u00e2\u00af\u00bf\u00c6\u00b9\u00af\u00c6\u00af\u00ba\u00c6\n\n77' \u00d0\u00bd\u00c8\u00b6\u00c6\u00b6 \u00b1\u00c8\u00be \u00b1\u00b7\u00c6\u00b6\u00bc\u00c6\u00b9\u00c6\u00b9+\u00c6\u00af\u00bf\u00c8\u0081 \u00b9+\u00c6\u00d0\u00ce\u00b4\u00ce\u00ba\u008a\u0081 \u00cc\u00b9\u00bb\u00bc\u00c8\u00be\u00c6\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n78' \u00b9+\u00c6\u00d0\u00ce\u00b4\u00ce\u00ba\u00af\u00bf\u00c8\u0081\u00ba\u00c9\u00d7 \u00a3\u00bd\u008c\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00bc\u00c8\u00b0\n\n\u00a7 -\u00c1\u00b6\u00c8\u00e2\n\n79' \u00a9\u00d7 \u00c1\u00b1\u00b6\u00c8\u00bb\u00c7\u00af \u00a3\u00ce\u00ba\u00dc\u00ba\u00c6 \u00a9\u00b8\u00c6\u00b9\u00d7\n\n\u00a8 - \u00c1\u00b6\u00c8\u00c1\u00bd\u00c6\u00bd \u00a4\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00bf\u00c6\u00bf \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\n\n80' \u00c1\u00b6\u00c8\u00c1\u00bd\u00c6\u00bd \u00a4\u00bf\u00c8\u0081 \u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6 \u00c1\u00bc\u00c8 \u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6\u00b0\n\n81' \u00c1\u00b6\u00c8\u00c1\u00bd\u00c6\u00bd \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00d0\u00bd\u00c8\u00b6\u00c6\u00b6\u00b1\u00c8\u00be \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6 \u00c1\u00bc\u00c8 \u00a5\u00de\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0 \u00a7\u00bc\u00c8\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c6\u00b0\n\n82' \u00d0\u00bd\u00c8\u00b6\u00c6\u00b6\u00b1\u00c8\u00be \u00c1\u00b6\u00c8\u00c1\u00bd\u00c6\u00bd \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00b0\n\n83' \u00d0\u00bd\u00c8\u00b6\u00c6\u00b6\u00b1\u00c8\u00be \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00af\u00bf\u00c8\u0081 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6 \u00cc\u00b9\u00de\u00c1\u00b8\u00e2\u00af\u00bf\u00c8\u0081\u0096\u00b6\u00cc\u00ba\u00c7\u0081\u00bd\u00c7\u00af\u00af\u00c6 \u00af\u00b5\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00b0\n\n84' \u00aa\u00bd\u00c6\u00de\u00ba\u00b6\u00c8 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c8\u0081 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8\u008a\u008b\u00dd\u00b7\u00c6\u00b6\u00c7\u00b8\u00c1\u00b6\u00c8\u00c1\u00bd\u00c6\u00bd \u00a4\u00bf\u00c8\u0081 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6\u00b0\n\n85' \u00c1\u00b6\u00c8\u00c1\u00bd\u00c6\u00bd \u00a4\u00bf\u00c8\u0081 \u00d0\u00bd\u00c8\u00b6\u00c6\u00b6\u00b1\u00c8\u00be \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c8\u0081 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u00af\u00c6\u00af\u00c7\u00b8 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00b0\n\n86' \u00d0\u00bd\