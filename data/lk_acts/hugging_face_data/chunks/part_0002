    "chunk_text": "10\u00b0 \u00aa\u00bd\u00c7\u00c1[\u00bc\u00c6\u00b9\u00c6\u00b9\u00bd\u00c6\u00de \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b911\u00b0 \u00ba\u00ae\u00db\u00ce\u00b8 \u00cd\u00ba\u00bd\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b912\u00b0 \u00ba\u00ae\u00db\u00ce\u00b8\u00b9\u00c6\u00b9\u00bd\u00c6\u00de \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b913\u00b0 \u00ba\u00ae\u00db\u00ce\u00b8 \u00cc\u00b6\u00bd\u00c6\u00d0 \u00a9\u00dd\u008c\u00be\u00c6\u00b9\u00bd\u00c6\u00de \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b914\u00b0 \u00ba\u00ae\u00db\u00ce\u00b8\u00b9\u00c6\u00b9\u00bd\u00c6\u00de \u00cc\u00b6\u0081\u00cd\u00ba\u00bd\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b915\u00b0 \u00b7\u00af\u00bc\" \u00e9\u00c0\u00be\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b916\u00b0 \u00d0\u00b1\u00c6\u00b1\u00cc\u00c1\u00bf\u00c8 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b917\u00b0 \u00b6\u00ba\u00c6\u00b9\u00be\u00af\u00c7\u00ba\u00ba\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b918\u00b0 \u00af\u00c8\u00ae\u00b5\u00c8\u00bb\u00c7 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b919\u00b0 \u00f2\u00d7{\u00bc\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b920\u00b0 \u00af\u00b7\u00c6\u00b6\u00bf\u00c7\u00bb\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b921\u00b0 \u00cd\u00af\u00c7\u00ba\u00bc\u0081\u00af\u00b4\u00c1\u00ce\u00be \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b922\u00b0 \u00cc\u00ba\u00c7\u00bc\u00cc\u00c1\u00c1 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b923\u00b0 \u00b9\u00b6\u008c\u00b1\u00c8\u00bd\u00c8\u00da\u00bc \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b924\u00b0 \u00cd\u00b1\u00dd\u008c\u00be \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b925\u00b0 \u00b1\u00c7\u00c1\u00af\u00b1\u00c6\u00cd\u00b1\u00bc\u00c8 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b926\u00b0 \u00cc\u00b7\u00d5\u00b7\u00c6\u00b6\u00c9\u00e2 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b927\u00b0 \u00cd\u00c1\u00be\u00ce\u00b5 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b928\u00b0 \u00a8\u00bc\u00c6\u00af\u00c7\u00c1\u00bd\u00c6\u00de\u00ce\u00bd \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b929\u00b0 \u00c1\u008b\u00af\u00c7\u00ba\u00ba\u00c6 \u00cd\u00ba\u00bd\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b930\u00b0 \u00c1\u008b\u00af\u00c7\u00ba\u00ba\u00c6 \u00cc\u00b6\u0081\u00cd\u00ba\u00bd\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b931\u00b0 \u00c1\u008b\u00af\u00c7\u00ba\u00ba\u00c6 \u00cc\u00b6\u00bd\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b932\u00b0 \u00c1\u008b\u00af\u00c7\u00ba\u00ba\u00c6 \u00c1\u00b4\u00af\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b933\u00b0 \u00c1\u008b\u00af\u00c7\u00ba\u00ba\u00c6 \u00af\u00c8\u00c0\u00af\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b934\u00b0 \u00c1\u00b4\u00ba\u00bc\u00c7\u00b4\u00c6\u00b1\u00c8 \u00cc\u00b6\u0081\u00cd\u00ba\u00bd\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b935\u00b0 \u00b9\u00dd\u00b6\u00c6\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bd \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b936\u00b0 \u00b7\u00be\u00c6\u00df{\u00bc\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b937\u00b0 \u00c1\u00e2\u00b8\u00c8\u00bb\u00c7 \u00cc\u00b6\u00bd\u00c6\u00d0 \u00b6\u00ba\u00c8\u00c0\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b938\u00b0 \u00c1\u00e2\u00b8\u00c8\u00bb\u00c7 \u00cc\u00b6\u00bd\u00c6\u00d0 \u00b1\u00c8+\u00c6\u00af\u00bf \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b939\u00b0 \u00c1\u00e2\u00b8\u00c8\u00bb\u00c7 \u00c1\u00b4\u00af\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b940\u00b0 \u00cc\u00c1\u00ae\u00af\u00be\u00b1\u00c6 \u00cc\u00b1\u00b4\u00c6\u0088\u00af\u00c6\u00d0\u00bf\u00ba\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b941\u00b0 \u00ba\u0081\u00b8\u00c7\u00bc\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b942\u00b0 \u00ba\u00c7\u00b7\u00c6\u00ce\u00b6 \u00cd\u00ba\u00bd\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b943\u00b0 \u00b7\u00c7\u00b8\u00c7\u00b4\u00c6\u00b4\u00c7\u0081 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b944\u00b0 \u00db\u00b1\u008b \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b945\u00b0 \u00af\u00b4\u00bd\u00c6\u00d7\u00ce\u00bd\u00b9\u00c6\u00b9\u00bd\u00c6\u00de \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b946\u00b0 \u00da\u00d7\u00af\u00c6\u00d0\u0088\u008a\u00dd\u00b9\u00c6\u00da \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b947\u00b0 \u00d7\u00d6\u00af\u00c6\u00af\u00c7\u00bb\u00c6 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b948\u00b0 \u00ba\u00c7\u00b7\u00c6\u00ce\u00b6 \u00af\u00c8\u00c0\u00af\u00c6\u00d0 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b949\u00b0 \u00af\u00ce\u00bc\u00b1\u00c6\u00b1\u00c8 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b950\u00b0 \u00b9[\u00b7\u00af\u00bc\u00c8 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b951\u00b0 \u00b9\u00b1\u00c6\u00b1\u00c8\u00ce\u00be\u00b9\u00c6\u00b9\u00bf\u00c6\u00bf\u00c8 \u0089\u00bc\u00cd\u00b6\u00b1 \u00b1\u00ce\u00b9\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 2 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00a7\u00bf\u00c6\u00f7\u00bc\u00c6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00af\u00bf\u00c6 (\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c66"
