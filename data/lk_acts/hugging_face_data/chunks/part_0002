    "chunk_text": "17.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nI \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6[3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6]\n\n1.1970 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 16 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e0\u00aa\u00e0 \u00be\u00ea\u00c9\u00c7 \u00bc\u00fb \u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00c8\u00bc, \u00aa\u00eb\u00c9\u00be\u00e0 \u00c6\u00e5\u00be\u00e5\u00be\u00f9\u00ba\u00f8 \u0097\u00ef\u00c7\u00e5\u00e0\u009e \u00ef\u00c8\u00cc \u00ba\u00cd\u00be\u00c4\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4 \u00c4\u00e6\u00b6\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00c6.\n\n3.1973 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 14 \u00c9\u00be \u00bc\u00fa\u00be \u00a6\u00a8\u00e0\u00cc\u00ba\u00e0 \u00b0\u00e5\u00ba\u00f9\u00be\u00e0\u00ef\u00aa\u00e0 \u00c4\u00cd\u00e5 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u008a\u00c4\u00ba \u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c7\u00e5\u00b0\u00f1 \u00f4\u00ba \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00a1\u00c0\u00c7\u00e5\u00bd \u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00c4 \u00cc\u00cd \u00bc\u00b9\u00ea\u00c9\u008a \u00bc\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec\u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00c6.\n\n4.1979 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 17 \u00c9\u00be \u00bc\u00fa\u00be \u00a6\u00a8\u00e0\u00cc\u00ba\u00e0 \u00b0\u00e5\u00ba\u00f9\u00be\u00e0\u00ef\u00aa\u00e0 \u00c4\u00cd\u00e5 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u008a\u00c4\u00ba \u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c0\u00f2\u00e5\u00b8 \u00a1\u00e6\u00c0\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00aa\u00f2\u00cd\u00b8\u00c6\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00c6.\n\n5.1980 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 3 \u00c9\u00be \u00bc\u00fa\u00be \u0097\u00c6\u00e5\u00be\u00e5 \u00be\u00ea\u00c9\u00c7 \u00bc\u00fb \u00cc\u008a\u00c4\u00ba \u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00be\u00f1\u00cb\u00e0\u0090\u00a8 \u00f7\u00c9\u00f1 \u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00c3\u00f0\u00ba\u00f8\u00a8 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00c6.\n\n6.1988 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00ef\u00c0\u00c2\u00c7\u00c9\u00e5\u00d6 \u00c4\u00cc 24 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00c4\u00e5\u00be\u00e0\u0090\u00f2\u00c6\u00c8\u00e0 \u00be\u00ea\u00c9\u00c7 \u00bc\u00fb \u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00c8\u00bc,\u00cc\u00e8\u0097\u00c8\u00e0 \u00aa\u00eb\u00c9\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00c8 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f9\u00ba\u00f8\u0097\u00ef\u00c7\u00e5\u00e0\u009e \u00a8\u00f2\u00e8\u00c6\u00e5\u00c4\u00e6\u00b6\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00cc\u008a\u00c4\u00ea\u00ba\u00e8\u00c6\u00b4 \u00a1\u00ba\u00f8\u00ef\u00da\u00a8\u00c9 \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00cc\u00e8\u0097\u00c8\u00e0 \u00aa\u00eb\u00c9\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5\u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00aa\u00eb\u00c9\u00be\u00e0 \u00ef\u00ba\u00e5\u00b4\u00ea\u00c0\u00c8\u00c9\u00c8 \u00bc\u00fb \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f9\u00ba\u00f8\u0097\u00ef\u00c7\u00e5\u00e0\u009e \u00c0\u00f2\u00ae\u00b8\u00e0\u00b6 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c4\u00e6\u00b6\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00c6.\n\n7.1988 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 10 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00c7\u00e5\u00e0\u00c4 \u00be\u00ea\u00c9\u00c7 \u00bc\u00fb \u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00c8\u00bc \u00cc\u00c4\u00ea\u00f7\u00e9\u00c6\u00cc\u00e2\u00ba\u00c7\u00b8\u00ef\u00c6\u00e0 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f9\u00ba\u00f8 \u0097\u00ef\u00c7\u00e5\u00e0\u009e \u00a8\u00f2\u00e8\u00c6\u00e5\u00c4\u00e6\u00b6\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00c6.\n\n8.1988 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 10 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00c7\u00e5\u00e0\u00c4 \u00be\u00ea\u00c9\u00c7 \u00bc\u00fb \u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00c8\u00bc, \u00c4\u00cd\u00e5\u00bc\u00e0\u00d1\u00c0\u00e8\u00a8\u00ba\u00b4\u00e5\u00a8\u00c9\u00c8 \u00c0\u00e8\u00cd\u00fa\u00b4\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00c9\u00e6\u00b6 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00c9\u00c8 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00be\u00f9\u00ba\u00f8 \u0097\u00ef\u00c7\u00e5\u00e0\u009e \u00a8\u00f2\u00e8\u00c6\u00e5 \u00c4\u00e6\u00b6\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00cc\u008a\u00c4\u00ea\u00ba\u00e8\u00c6.\n\n9.1997 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 15 \u00c9\u00be \u00bc\u00fa\u00be \u00a6\u00a8\u00e0\u00cc\u00ba\u00e0 \u00b0\u00e5\u00ba\u00f9\u00be\u00e0\u00ef\u00aa\u00e0 \u00c4\u00cd\u00e5 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u008a\u00c4\u00ba \u00a8\u00c7\u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ba\u00f2\u00cc\u00e0\u00ba\u00c9\u00e5\u00bc\u00fb \u00ef\u00c2\u00e5\u00e0\u008a\u00c2 \u00c0\u00f2\u00cd\u00e5\u00c7 \u00c4\u00e6\u00b6\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec\u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00c6.\n\n2005 \u00a1\u00e2\u00a8 25 \u00bc\u00c7\u00be \u00ba\u00f2\u00cc\u00e0\u00ba\u00c9\u00e5\u00bc\u00fb\u00be\u00e0\u00b4 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4\u00c4\u00e6\u00b6\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00ef\u008a \u00cc\u008a\u00c4\u00ea\u00ba\u00f8 \u00c0\u00be\u00ba10\n\nII \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6[ 8, 9, 10, 11 \u00cc\u00cd 13 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8]\n\n(1)(\u00a1) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 1 \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00aa\u00fa\u0097\u00cc\u00ea\u008a \u00c9\u00c8\u00e8\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c6\u008a\u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8 \u0097\u00cb\u00c6 \u00c0\u00bb\u00c6 \u00ba\u00eb\u00ce\u00b4 \u00ef\u00cd\u00e5\u00e0 \u0097\u00aa\u00f2\u00cd\u00c6 \u00ba\u00eb\u00ce\u00b4 \u00aa\u00e6\u00ef\u00be\u00be \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e2\u00c6\u00ea\u00a8\u00e0\u00ba\u00c9\u00be \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00c9\u00ec, \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5) \u00cc\u00be\u00e0\u00be\u00bc\u00e0\u00bd \u00aa\u00e6\u00b4\u00ea\u008a \u00c0\u00c9\u00ba\u00f8\u00be \u00ba\u00ba\u00e0\u00c9\u00c6\u00a8 \u00bc\u00fb \u00a6\u00e0 \u00a6\u00bc\u00fa\u00d6\u00c9\u00e5\u00bc\u00fa\u00a8\u008a\u00c9\u00c8\u00b4 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00d7\u00c9\u00cc\u00cd\u00c3\u00e5\u00aa\u00e8 \u00ef\u00be\u00e5\u00c9\u00be \u00cc\u00e8\u0097\u00c8\u00e0 \u00c9\u00e6\u00cc\u00e8\u00c6\u00a8\u00eb\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4\u00c4\u00c7\u00b8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00c7\u00e6\u00b8\u00ea \u00ca\u00e5\u00d7\u00d6\u00a8 \u00ba\u00eb\u00c9\u00e5\u00c8 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4 \u00a1\u00c7\u00c4\u00ea\u00b8\u00ea \u00a8\u00c7\u00aa\u00ba\u00e0\u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0 ,"
