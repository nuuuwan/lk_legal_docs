    "chunk_text": "(3) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00a8\u00ef\u00cc\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00c9 \u00ba\u00f8\u00c2\u00ea\u00b8 \u00bc \u00a6\u00ef\u00c4\u00be\u00e0\u00c4 (5)\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9, \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00a8\u00e0 \u00a1\u00b8\u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0\u00cc\u00cd \u0097\u00bc\u00e0\u00c6\u00ea\u00ba\u00e0\u00c9 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00b4 \u00bc \u00a6\u00c4\u00c2\u00e6\u00e2\u00a8\u00eb\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00d1\u008a \u00cc\u00bf\u00cd\u00e5 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00c4 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00ef\u00c8\u00cc \u00a6\u00c4\u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00e8\u00f3\u00a8\u00ce \u00c2\u00e6\u00e2\u00a8\u00eb\u00a8\u00c7\u00e6\u00ef\u00aa\u00be\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u0090\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(5)(\u00a1)\u00ef\u00aa\u00d1\u008a \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c0\u00f2\u00bb\u00c4 ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u0097\u00bc\u00e0\u00c6\u00ea\u00ba\u00e0\u00c9 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00a1\u00cc\u00e5\u00da\u00bb\u00a8 \u00d1 \u00ba\u00f8\u00ef\u00c2\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4\u00ef\u00ae\u00a8\u00e0\u00c0\u00ba \u00a1\u00b8\u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00b4 \u00bc \u00a6\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00b4 \u00ef\u00aa\u00d1\u008a \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00a6\u00c4 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00cd\u00fa\u00a1\u00b8\u00a8\u00c7\u00e6 \u00ef\u00c8\u00cc \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00a4\u00c0\u00ef\u00bc\u00cc\u00e0\u00c0\u00e8\u00ce\u00e8\u00c0\u00bc\u00fa\u00be\u00e0\u00ef\u00be\u00e0 \u00bc \u00c6\u00be \u00c9\u00aa \u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00ba\u00e0 \u00be\u00f8\u00c6\u00ba\u00c3\u00e5\u00c9\u00c6\u00a8\u00f8\u00be\u00e0\u00be\u00f8\u00aa\u00c4\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a6\u00c4 \u0097\u00bc\u00e0\u00c6\u00ea\u00ba\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00a1\u00be\u00ea\u00c9\u00cd\u00e6\u00a8\u00f8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 ; \u00cc\u00cd(\u00a1\u00e6)\u00a6\u00c4 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba \u00a1\u00b8\u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00b4 \u00bc \u00a6\u00e0\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00b4, \u00a6\u00c4 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00c4 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4 \u00a6\u00cd\u00fa\u00c0\u00bc\u00be\u00c4 \u00c4\u00ba \u00a6\u00a8\u00f9 \u00be\u00f8\u00aa\u00c4\u00be\u00c6\u00b4 \u00a6\u00ce\u00d0\u00c4\u00b4 \u00c9\u00e6\u0091 \u00a1\u00c9\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0\u00c8\u00e6\u00ef\u00c2\u00be \u00c2\u00e6\u008c \u0097\u00ca\u00e0\u00c9\u00e5\u00cc \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00ef\u00cd\u00e0\u00ba\u00eb \u00c0\u00c9\u00ba\u00e0\u00be\u00e5\u0097\u00b4,\u00c0\u00c4\u00b8\u00a8\u00e0, (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00c8\u00e2\u00aa\u00eb \u00a1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7, \u00a6\u00c4 \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4 \u00cc\u00c4\u00aa \u00a6\u00c6 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c0\u00e6\u00cd\u00e6\u00bc\u00fa\u00c8\u00e8 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00a6\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00cc\u00cd \u00a6\u00c6 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u0097\u00bc\u00e0\u00c6\u00ea\u00ba\u00e0\u00c9 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00bc\u00fa\u00be\u00b4 \u00c0\u00cc\u00ea\u00bc\u00fa\u00be\u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00be\u00f8\u00c4\u00a8\u00f8\u00d7\u00c4\u00b4 \u00c0\u00f2\u00bb\u00c4 \u00a6\u00c4 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0\u00a8\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00a8\u00c7\u00e6 \u00ef\u00c9\u00ba \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n2005 \u00a1\u00e2\u00a8 28 \u00bc\u00c7\u00be \u00ef\u00aa\u00d1\u00ef\u008a \u00cd\u00e5 \u00ef\u0089\u00c7\u00e6\u008a \u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00bc\u00e0\u00bd\u00ba\u00f8 \u00c0\u00be\u00ba39\n\n(6) \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00a8\u00c7\u00be \u00c9\u00c8\u00e2\u00aa\u00eb \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00a6\u00c4 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00b4 \u00ef\u00aa\u00d1\u008a \u00ef\u00be\u00e5\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00a1\u00aa\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00ef\u00c8\u00cc \u00ef\u00be\u00e5\u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(7) \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00a8 \u00c0\u00f2\u00ba\u00f8\u0094\u008a\u00c2\u00c6\u00a8\u00e0 \u00cc\u00cd \u0097\u00bc\u00e0\u00f1\u00ea\u00ba\u00e0 \u00ef\u00aa\u00d1\u008a \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 (1) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a8\u00c9\u00c7\u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00d1\u00c4\u00a8\u00e0, \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00cc\u00e5\u00c4\u00e5\u00be\u00f1 \u00c9\u00e5\u00f1\u00e5\u00c0\u00e5\u00d6\u00a8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00c8\u00e8\u00ef\u00c6\u00be\u00e0 \u00c2\u00e5\u00cd\u00fa\u00c7\u00c9,\u00a1\u00cc\u00bc\u00e0\u00c3\u00e5\u00c9\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e5\u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e8\u00c4\u00ba\u00e0\u00c9 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c8\u00cc \u00ef\u00be\u00e5\u00cc\u00e6\u00c8\u00a8\u00f8\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9 \u00cc\u00e6\u00a8 \u00f3\u00c7\u00e6\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00c7 \u00a1\u00e6\u00ba.\n\n(8) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5\u2014\n\n(\u00a1)\u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00a8 \u00c0\u00f2\u00ba\u00f8\u0094\u008a\u00c2\u00c6\u00a8\u00e0 \u00a6\u00c4 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00cc \u00cd\u00e5\u00c0\u00cc\u00ea\u00c0\u00e8\u00ef\u00b4\u00cd\u00fa \u00bc\u00da\u00ca\u00be\u00c6\u00a8\u00f8\u00be\u00e0 \u00cc\u00e2\u00c6\u00ea\u00a8\u00e0\u00ba \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00ba\u00c9 \u00bc\n\n(\u00a1\u00e5)\u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00a8 \u0097\u00bc\u00e0\u00c6\u00ea\u00ba\u00e0 \u00ef\u00aa\u00c9\u00ea\u008a \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6\u00c9\u00c8_\n\n(i)\u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00cd\u00fa \u00a1\u00be\u00ea\u00a8\u00f2\u0095\u00a8 \u00a1\u00e2\u00a8\u00c6 ;\n\n(ii)\u00a6\u00c4 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba \u00a1\u00b8\u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00b4 \u00bc \u00a6\u00c4\u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00cd\u00df\u00be\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00cc\u00e2\u00ef\u00a8\u00e0\u00ba\u00c6 ;\n\n(iii)\u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00cd\u00fa \u00a1\u00b8\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00aa\u00fa\u00b8\u00ea\u008a \u00a1\u00e2\u00a8\u00c6 ;\n\n(iv)\u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00cd\u00fa \u00a1\u00b8\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c0\u00d6\u00bc\u00fa\u00a6\u00c6 \u00a8\u00c9\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00bc \u00c6\u00be \u00c9\u00aa ; \u00cc\u00cd\n\n(v)\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa \u00c4\u00aa\u00fa\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00c8 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8\u00ef\u00c9\u00be\u00ba\u00e0 \u00a8\u00c7\u00e6\u00b8\u00ea,\n\n\u00a1\u00b6\u00e2\u00aa\u00eb \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
