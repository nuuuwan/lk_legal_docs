    "chunk_text": "(3) \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00aa\u00fa\u00b8\u00ea\u008a \u0097\u00aa\u00b8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0, \u00c7\u00e5\u00b0\u00f1\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8 \u00aa\u00fa\u00b8\u00ea\u008a \u0097\u00aa\u00b8\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00a1\u00bc\u00e5\u00ce \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00a8\u00f2\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c154 \u00c9\u00be \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00bc\u00e5\u00ce \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) 1971 \u00a1\u00e2\u00a8 38 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 II \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00a1\u00c9\u00ca\u00f1 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u008a \u00cc\u00cd\u00fa\u00ba\u00c9 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u00cc\u00cd \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00a1\u00bc\u00e5\u00ce \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nV \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00ef\u00c0\u00e5\u00f3 \u0097\u0093\u0097\u00bd\u00e5\u00be\n\n30.\u00c0\u00e5\u00c8\u00a8 \u00cc\u00c3\u00e5\u00ef\u008c \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00c6\u008a \u00a8\u0095\u00b4\u00ea\u00c9\u00a8 \u00cc\u00e7\u00c4 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb\u00c4\u00ef\u00cd\u00e5\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e7\u00c4 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00c4 \u00cd\u00e5 \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00a8\u00eb\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00cd \u00ef\u008a\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e7\u00c4 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00c4\u00a8\u00e5\u00da\u00c6 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c0\u00f2\u00bb\u00c4 _\n\n(\u00a1)\u00a6\u00ef\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8\u0097\u00b4 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c8\u00e8\u008d\u00ba \u00be\u00f9\u00ba\u00f8\u00c6\u00a8 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00b4\u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5, \u00ef\u00cd\u00e5\u00e0\n\n\u00cd\u00e6\u00c7, \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e8\u00c6 \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00cc\u00cd \u00a8\u00e5\u00da\u00c6\u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00ba\u00c4\u00e5\u00b4 \u00bc\u00e6\u00be\u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00c8\u00e6\u00c2\u00ea\u00b8\u00ea \u00c6\u008a \u00a8\u00c7\u00e6\u00b8\u00a8\u00e0 \u00ef\u00cd\u00ce\u00e8\u00ef\u00be\u00e5\u00a8\u00c7\u00be\u00c2\u00c9\u00b4 \u00ef\u00c0\u00e5\u00ef\u00c7\u00e5\u00be\u00e0\u00f3 \u00ef\u00c9\u0095\u00be\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00a1\u00ba\u00e0\u00cc\u00be\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n31.\u00c0\u00e5\u00c8\u00a8 \u00cc\u00c3\u00e5\u00ef\u008c \u00cc\u00e8\u00c6\u00f5\u00c4 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00bc, \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e8\u00c6\u00f5\u00c4\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0 \u00cc\u00cd \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00be\u00e0 \u00bc \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e8\u00c6\u00f5\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00bc \u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd \u00a6\u00cd\u00fa\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c7\u00b0\u00ef\u00c6\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n32.\u00a1\u00c8\u00e0\u00c8\u00cc\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00aa\u00ba\u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a6\u00e0\u00a1\u00be\u00ea\u00c9 \u00ef\u00ba\u00e0\u00c7\u00e6\u008a\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00e5\u00c8\u00a8 \u00cc\u00c3\u00e5\u00ef\u008c \u00cc\u00cd\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0.\n\n\u00c7\u00cd\u00cc\u00f1\u00c3\u00e5\u00c9\u00c6.\n\n\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00a1\u00c8\u00e0\u00c8\u00cc\u00e0\u00c0\u00be\u00ef\u00ba\u00e0\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00aa\u00ba\u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n152005 \u00a1\u00e2\u00a8 32 \u00bc\u00c7\u00be \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c0\u00f2\u00ba\u00f9\u00ba\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00c0\u00be\u00ba\n\n33. (1) (\u00a1) \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00bc\u00e0\u00c3\u00e5\u00c9\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be\u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00e6\u00c6\u00fa \u00a1\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0\u00cc\u00bf\u00cd\u00e5 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5) \u00c0\u00e5\u00c8\u00a8 \u00cc\u00c3\u00e5\u00ef\u008c \u00c6\u008a \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0\u00c6\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00a8\u0095\u00b4\u00ea\u00c9\u00a8\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0\u00ef\u00cd\u00e5\u00e0 \u00c0\u00e5\u00c8\u00a8 \u00cc\u00c3\u00e5\u00ef\u008c \u00ef\u00cd\u00e5\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u0097\u00bd\u00e5\u00be\u00c6 \u00c4\u00ba\u00cc\u00bc\u00e0\u00c3\u00e5\u00c9\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00e6\u00c6\u00fa \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00c2\u00be \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0, \u00a6\u00e0\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00e5\u00b4, \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5\u00b4, \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00e5\u00b4, \u00a8\u0095\u00b4\u00ea\u00ef\u008c\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9,\n\n\u00a8\u00e8\u00cc\u00e8\u00c4 \u00cc\u00e8\u0097\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea\u00c9\u00a8\u00e0 \u00c0\u00c9\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
