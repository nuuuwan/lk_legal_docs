    "chunk_text": "(\u00a1)\u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb \u00ef\u00c8\u00cc \u00c6\u008a \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u00ef\u00cc\u00e0\u00c9\u00e5\u00a2\u00b4\u00ea\u00a8\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb, \u00c6\u008a \u00cd\u00c9\u00ea\u00c8\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0, \u00c6\u008a \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a\u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00bc \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5, \u00a6\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6, \u00a6\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6 \u00bc ;\n\n(\u00a1\u00e5)4 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00c6\u008a \u00c8\u00e5\u00c3 \u00ef\u00aa\u00c9\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb,\u00c6\u008a \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0, \u00c6\u008a \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 ; \u00ef\u00cd\u00e5\u00e0\n\n\u00ef\u00c4\u00cd\u00fa \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be I \u00c9\u00be \u00ba\u00e9\u00c7\u00ef\u00c6\u00cd\u00fa \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00c4 \u00cc\u00bf\u00cd\u00be\u00e0\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0, \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u0097\u00b4 II \u00c9\u00be \u00ba\u00f9\u00c7\u00ef\u00c6\u00cd\u00fa \u00a1\u00be\u00ea\u00c7\u00e7\u00c0 \u00cc\u00b4\u00cd\u00ef\u00be\u00cd\u00fa\u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00a3\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba200\n\n\u201c\u00ef\u00aa\u00d1\u008a \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4 \u00c0\u00e5\u00d6\u00ca\u00f2\u0095\u00a8 \u00aa\u00b8\u00be\u00e0 \u00c2\u00c8\u00e5 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a\u00c4\u00e5\u00cc\u00c6\u00a8, \u00cc\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u00bc, \u00a6\u00e0 \u00c4\u00e5\u00cc\u00c6, \u00cc\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00c0\u00f2\u00bd\u00e5\u00be \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5\u201d \u00c6\u00be\u00e0\u00be, \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00cd\u00e5 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u00c6\u00ef\u00bc\u00be \u0097\u00b4, \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00cc\u00c4\u00aa \u00ba\u00c4\u00e5\u00ef\u00aa\u00e0 \u00a8\u00f8\u00cc\u00e8 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00c2\u00c9 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5 \u00c9\u00ec \u00ca\u00f2\u00e9\u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00ef\u00be\u00e0\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c2\u00c9 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0\u00a7\u00c0\u00e0\u00c0\u00ea \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u0095\u00cc, \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u00cd\u00e5 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ef\u008a \u00c0\u00da\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00c6\u008a \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0XXVI \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00c6\u008a \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0\u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00a2\u00be\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ; \u00ba\u00c9\u00bc\n\n\u201c\u00c0\u00e5\u00d6\u00ca\u00f2\u0095\u00a8\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 4 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00a1\u00ba\u00e0\u00c9\u00be \u00c8\u00e5\u00c3 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00ef\u00be\u00e5\u00c9\u00ec\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0\n\n\u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0\n\n\u0095\u00c6\u00aa\u00fa\u00c6 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0\u00c2\u00ec\u00bc\u00c8\u00c6\n\n\u00c3\u00e5\u00c7\u00c6\u00a8\u00e0\n\n\u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0\n\n\u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u00c4\u00cd\u00fa \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00cd\u00fa\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5, \u00ef\u00c8\u00e0\u00a8\u008a, \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00e6 \u00ef\u00cd\u00e5\u00e0\u00a1\u00be\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00cd\u00fa \u00c0\u00bc\u00fa\u00e2\u008e \u00c0\u00f2\u00c4\u00ea\u00a9 \u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6 \u00ef\u00cd\u00e5\u00e0\u00c6\u008a \u00cc\u00a8\u00f2\u00e9\u00c6 \u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb ; \u00c6\u008a \u00cc\u00a8\u00f2\u00e9\u00c6\u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00cd\u00fa \u00c9\u00e5\u00cc\u00e8\u00a8\u00c9\u00ef\u00be\u00e5\u00cc\u00e8\u0090\u00be \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u0097\u00b4 \u00a6\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00cd\u00fa \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00cd\u00fa \u00cc\u00e8\u0090\u00be\u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5.\n\n\u00c2\u00ec\u00bc\u00c8\u00ef\u00c6\u00cd\u00fa \u00ef\u00c0\u00e5\u00c8\u00e0\u00c4\u00e3\u00a8\u00c7\u00e6 \u00ef\u00cd\u00e5\u00e0\u00a1\u00bc\u00e0\u0095\u00be\u00f8\u00cc\u00e0\u00ba\u00f2\u00e5\u00cc\u00e8\u00a8\u00c7\u00e6.\n\n\u00c3\u00e5\u00c7\u00ef\u00c6\u00cd\u00fa \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6 \u00ef\u00cd\u00e5\u00e0 \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u00ef\u00c9\u00e5\u00e0.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00cd\u00fa \u00cc\u00e8\u0090\u00be \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0\u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00ef\u00b4\u00e5\u00e0\u00da\u00be\u00f8 \u00c2\u00c8\u00a8\u00c7\u00e6 ;\n\nI \u00c9\u00be \u00ba\u00f9\u00c7\u00c6II \u00c9\u00be \u00ba\u00e9\u00c7\u00c6\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba201\n\nXV \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00ef\u00aa\u00d1\u00c4\u00b4\u00a1\u00bc\u00e5\u00c8 \u0097\u0093\u0097\u00bd\u00e5\u00be"
  },
