    "chunk_text": "(2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00ba\u00c7\u00b1\u00c6\u00d2 \u00ba\u00c7\u00b6\u00ba\u00c6 31 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7)\n\n\u00a3\u00bc\u00b1\u00c8\u00b8\u00bc\u00c6 \u00a4\u00ce\u00b5\u00b9\u00c6\u00b9\u0088 \u00a3\u00b1\u00c6\u00b1\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\n\n\u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00a3\u00b1\u00c6\u00d2\u00b6\u00c6 \u00b6\u00c8\u00ce\u00b5\u00af\u00c6\u00af\u00bf\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00b9\u00b6\u00c8\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00bd\u00c6\u00bd\u00d7\u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da 1\" \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00b4\u00df\u00c1\u00be\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00be\u00c7\u00ba\u00c6\n\n\u008c\u00ce\u00be : \u00f4\u00b9\u00c7 6\u00b025\u00b6\u00b9\u00c7\u00bd\u00c6 \u00cc\u00b1\u00be\u00e2 : \u00f4\u00b9\u00c7 4\u00b050\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081\u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00ba\u00c6\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u00b8\u00c6 13 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc\u00b1\u00c6\u00cd\u00b1\u00ce\u00c1 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n2006\" \u00ba\u00c7\u00b1\u00c6\u00d2 \u00ba\u00c7\u00b6\u00ba\u00c6 31 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb \u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081\u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00b9\u00c6 \u00b9\u00b6\u00c6\u00b6\u00c8\u00bc\u00c8\u00ce\u00af\u008a\u0081 II \u00a4\u00ba\u00c6 \u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00b7\u00c8\u00bc\u00b9\u00c6\u0089\u00bb\u00c7\u00af \u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc\u00b1\u00c6\u00cd\u00b1\u00ce\u00c1 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c61\n\n\u00d2\u00dd\u00af\u00c6\u00af\u00b9\u00c6 \u00cc\u00b9\u00bb\u00bc\u00c6\u00b0\n\n2 \u2013PL 001065 \u2013 700 (2006/02)\n\n[2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00ba\u00c7\u00b1\u00c6\u00d2 \u00ba\u00c7\u00b6\u00ba\u00c6 31 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00b0]\n\n\u00b1\u00b0\u00c1\u00b0\u00ad\u00b0 11/2006\n\n2006 \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u0089\u0081\u00b8\u00bc\u00c6\u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00af\u00c8\u0081\u00bd \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u0081 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00af\u00c7\u00be\u00c7\u00ae\u00d5 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00b9+\u00c6\u00af\u00c7\u00ae\u00ce\u00ba\u008a\u0081 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8 \u00c1\u00bc\u00e2\u00ba\u00c9\u00d7\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc\u00b1\u00c6 \u00cd\u00b1\u00ce\u00c1 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00cc\u00c1\u00c7\u0081\u00ce\u00bd \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 ;2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 11 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00b7\u00c8\u00b6\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b9\u00c7\u00af\u00ba\u00c61 \u00a5\u00ce\u00b8\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u00cd\u00b8\u00c7\u00d5 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00e2\u00ba\u00c6 \u00a3\u00b6\u00bd\u00c6\u00d0 \u00a5\u00ce\u00b4\u00cd\u00b7\u00bc\u00c6\u008c\u00ce\u00bf\u00c1\u00c7\u00b8\u00ce\u00c1\u00dc\u00ba\u00c7\u00b8 \u00af\u00dd\u00ba+\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c7\u00b8\u00cc\u00b6\u00c7\u00dd \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081 \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b1\u00b4\u00c6\u00b4\u00ba\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00c7\u00d0\u00af :\n\n1\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc\u00b1\u00c6\u00cd\u00b1\u00ce\u00c1 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a9\u00b8 \u00a9\u00d5\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n\u00b9\u00c7\u00af\u00ba\u00c6 I\n\n\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc\u00b1\u00c6 \u00cd\u00b1\u00ce\u00c1 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00cc\u00c1\u00c7\u0081\u00ce\u00bd \u008c\u00b6\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\n\n2\u00b0 (1) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00c7\u00b6\u00c7\u00b8 \u0096\u00b6\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 2006\" \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u0081 \u0089\u0081\u00b8\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00d5 \u00a4\u00ae\u0088\u0081\u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00af\u00c7\u00be\u00c7\u00ae\u00d5\u00af\u00c6\u00af\u00c7\u00af (\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u00af\u00c7\u00be\u00c7\u00ae\u00d5\u201c\u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00af\u00c7\u00be\u00c7\u00ae\u00d5\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00ac\u00c1\u00c6\u00cd\u00c1\u00c7\u00bc\u00c6 \u00a4\u00bf\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9+\u00c6\u00af\u00c7\u00ae\u00ce\u00ba\u008a\u0081 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6\u008c\u00bd\u00c6\u00b9\u00b8\u00e2 \u00c1\u00bc\u008c\u0081 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00b9\u00c7\u00af\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00df\u00ba\u00c6\" \u00a3\u00b7\u00c6\u00b6 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00af\u00c7\u00be\u00c7\u00ae\u00d5\u00af\u00c6\u00d0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00d0 \u00a3\u00ce\u00ba\u00c1\u00c7\u00af(\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u201c\u00cd\u00b1\u00ce\u00c1 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc\u00b1\u00c6 \u00cd\u00b1\u00ce\u00c1 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00cc\u00c1\u00c7\u0081\u00de \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c8\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7\u00ba\u00c6 \u00b9+\u00c6\u00af\u00c7\u00ae\u00ce\u00ba\u008a\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7\u00ba\u00c6 \u00a3\u00bd\u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c8\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6\"\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00c7\u00be\u00c7\u00ae\u0088\u00bd\u00c6\u00d0 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9+\u00c6\n\n\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc\u00b1\u00c6\u00cd\u00b1\u00ce\u00c1 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00cc\u00c1\u00c7\u0081\u00ce\u00bd\u008c\u00b6\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc\u00b1\u00c6\u00cd\u00b1\u00ce\u00c1 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c62"
