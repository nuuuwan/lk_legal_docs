    "chunk_text": "(2) \u00c9\u00cc\u00e0\u00ba\u00eb \u00c3\u00e2\u00aa\u00ba\u00e0\u00c9\u00ef\u00c6\u00e0, \u00c2\u00e2\u00ef\u00a8\u00e5\u00ef\u00c8\u00e5\u00ba\u00e0\u00c3\u00e5\u00c9\u00ef\u00c6\u00e0 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a1\u00e7\u00c9\u00c7 \u00a8\u00f8\u00d7\u00ef\u008a\u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c9\u00ec \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00ba\u00e5\u00e0\u00c7\u00e5 \u00aa\u00be\u00ea \u00c8\u00c2\u00be,\u00a6\u00a8\u00e0 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00c6\u00c4\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c2\u00bc\u00e0\u00bc, \u00ef\u00bc\u00e0\u00c0\u00c8 \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0, \u00ba\u00c4\u00e5\u00ef\u00aa\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00ba\u00e0\u00a8\u008a\u00c9\u00c8\u00e8\u00be\u00e0, \u00a6\u00e0 \u00c9\u00ba\u00e0\u00a8\u008a\u00c9\u00c8 \u00c0\u00f2\u00bb\u00c4 \u00c9\u00e6\u00c6 \u00c2\u00c7\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00ba\u00c9 \u00bc, \u00a6\u00e0 \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c9\u00ec \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c6\u00c4\u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0, \u00a1\u00be\u00e5\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba\u00b8\u00c6\u00a8\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n177. (1) \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u0097\u0093\u0097\u00bd\u00e5\u00be\u00cc\u00c8\u00cc\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ef\u00c0\u00c7,\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0, (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 _\n\n(\u00a1)\u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u0097\u00cc\u00e0\u00ba\u00c7 ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00e8\u00d7\u00c4\u00b4 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00c2\u00c9\u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u0095\u00be\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00e0\u00be\u00e5 \u00ef\u00c9\u00ba \u00c8\u00e8\u00c6\u0097\u00c8\u00e0\u00c8\u00a8\u00f8\u00be\u00e0 \u00c9\u00ec \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00e0\u00be\u00e5\u00ef\u00c9\u00ba \u00bc\u00e6\u00be\u00e0\u00d1\u00c4.\n\n2502006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba\n\n(2) \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 (1) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00e5\u00da\u00c6 \u00c0\u0090\u00c0\u00e5\u0090\u00c6 \u00a1\u00be\u00ea\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00be\u00ec\u00a8\u00ed\u00c8 \u00ef\u00be\u00e5\u00c9\u00be \u00c2\u00c9 \u00cc\u00cd \u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00cd\u00e5\u00c4\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 \u00a1\u00c9\u00ca\u00f1 \u00c2\u00c9\u00b4 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00be\u00f8\u00c6\u0095\u00ba \u00c0\u00d6\u00bc\u00fa, \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00e0\u00be\u00e5 \u00ef\u00c9\u00ba\u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00ef\u00be\u00e5\u00ef\u00a8\u00e5\u00b4, \u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6. \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u008a \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00bc\u00fa\u00be \u00bc\u00cd\u00cd\u00ba\u00c7\u00a8\u00e0\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc \u00a6\u00e0\u00c2\u00bc\u00e0\u00bc \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u0097\u00cc\u00e0\u00ba\u00c7 \u00cc\u00cd \u00a6\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8 \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00c6 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00a8\u00ef\u00c7\u00be\u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00e0\u00be\u00e5 \u00ef\u00c9\u00ba \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6.\n\n(3) \u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00a1\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc \u00a6\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00c8\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00be\u00f8\u00cc\u00e8\u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00e0\u00be\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00c3\u00fa\u00c6\u00e5\u00ae\u00be\u00c6\u00a8\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4\u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00be\u008a, (1) \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00bc\u00fa\u00be \u00ba\u00f8\u00cd\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba, \u00a6\u00ef\u00cc\u00e0 \u00a1\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00c2\u00bc\u00e0\u00bc \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00c6\u008a \u0097\u00ef\u00c7\u00e5\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8\u00c6.\u00ba\u00c9 \u00bc 171 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00c9 \u00a1\u00e6\u00ba \u00bc\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u0097\u00ef\u00c7\u00e5\u00e0\u00bd\u00ba\u00e5\u00c9 \u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00c3\u00e5\u00b0\u00be\u00c6\u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0 \u0097\u00ef\u00c7\u00e5\u00e0\u00bd\u00ba\u00e5\u00c9 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00ba\u00f9\u00c7\u00b8\u00c6 \u00bc\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 \u00a6\u00c6\u00a1\u00c9\u00cc\u00e5\u00be\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :"
