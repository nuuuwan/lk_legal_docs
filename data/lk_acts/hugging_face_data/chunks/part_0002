    "chunk_text": "(3) I \u00c9\u00be, II \u00c9\u00be \u00cd\u00e5 III \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c9\u00c8 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a\u00c4\u00cd \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9\u00a8\u00b4, \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c9\u00a8\u00b4 \u00ef\u00ba\u00e5\u00e0\u00c7\u00e5\u00c0\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e0\u00c9\u00e5\u009e\u00be \u00a8\u00b8\u00e0\u00b6\u00e5\u00c6\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00a1\u00ef\u00c0\u00e0\u00a8\u00e0\u00cb\u00a8\u00c6\u00be\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 29 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb, \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 30 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00b4\u00cd\u00e6\u00be\u00f8\u00c9 \u00a8\u00eb\u00c4\u00a8\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9 \u00bc \u00a6\u00c6 \u00ef\u00be\u00e5\u00ba\u00a8\u00e5, \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 30 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (3) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ba\u00c4\u00be\u00e0 \u00ef\u00c9\u00ba \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c8\u00f3\u00c0\u00ba\u00a8\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8\u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00ba\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb\u00c9\u00a8\u00ce \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00bc\u00fa\u00be\u00c6 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00a8\u00e5\u00c8\u00c6\u00b4\u00c9\u00da\u00cb\u00c6\u00a8\u00b4 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00ef\u00bc\u00e5\u00ce\u00cd (12%) \u00c2\u00e6\u00aa\u00fa\u00be\u00e0 \u00c9\u00ec \u00ef\u00c0\u00e5\u00ce\u00e8\u00c6\u00a8\u00e0 \u00cc\u00c4\u00aa \u00a6\u00e0 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00e0\u00c4\u00ea\u00bc\u00c8 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00c9\u00ba \u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c4\u00cd \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5, \u00be\u00aa\u00c7\u00cc\u00c3\u00e5 \u00cc\u00cd \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6\u00cc\u00c3\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8\u00be\u00e5\u00c4\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u00cd\u00ba\u00c2\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00e6\u00c0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be.\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6.\n\n3.I \u00c9\u00be, II \u00c9\u00be \u00cd\u00e5 III \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c9\u00c8 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c4\u00cd\u00be\u00aa\u00c7 \u00cc\u00c3\u00e5, \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5 \u00cc\u00cd \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5 \u00af\u00be\u00e0\u00bc \u0097\u00c4\u00cc\u00e9\u008a \u00c0\u00e8\u00b8\u00e8\u00cc,\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00c6\u00c9\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9, \u00be\u00e5\u00c4\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0\u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00bc\u00fa\u00be\u00c6\u00a8 \u00bc\u00fb \u00bc \u00c0\u00ce \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6. \u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00a6\u00e0 \u00bc\u00fa\u00be\u00c6\u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00d1\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00c4\u00e5\u00cc \u00cd\u00c6\u00a8\u00b4 \u00c0\u00cc\u00ea\u00bc\u00fa\u00be\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n4.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00cd\u00fa \u201c\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 ( 262 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec)\u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00a1\u00e5\u00c6\u00ba\u00be \u00af\u00be\u00e0\u00bc \u0097\u00c4\u00cc\u00e9\u008a \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n5.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cd\u00e5 \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7, \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nI \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\n\u00c4\u00cd \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\n\n1.\u00c4\u00b6\u00a8\u00c8\u00c0\u00ea\u00c9 \u00c4\u00cd \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9\n\n2.\u00c6\u00e5\u00c0\u00be\u00c6 \u00c4\u00cd \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9\n\n3.\u00a8\u00c8\u00e0\u00c4\u00ea\u00ef\u00b8\u00e0 \u00c4\u00cd \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9\n\nII \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\n\u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\n\n1.\u00a8\u00e5\u00ba\u00e0\u00ba\u00be\u00e0\u00a8\u00eb\u0091 \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9\n\n2.\u00ae\u00e5\u00c9\u00e5\u00a8\u0083\u00ef\u0083\u00d6\u00c6 \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\n\n3.\u00ef\u00c0\u00e0\u00f3\u00c7\u00e6\u00ba\u00eb\u00b6\u00ea\u00c9 \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9\n\n4.\u00c9\u00e6\u00c8\u00e0\u00c9\u00e6\u0090\u00ba\u00eb\u00ef\u00da \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9\n\n5.\u00ba\u00f2\u00e8\u00a8\u00eb\u00b8\u00e5\u00c4\u00c8\u00c6 \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9\n\n6.\u00c9\u00c9\u00ea\u00be\u00f8\u00c6\u00e5 \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9\n\n\u00af\u00be\u00e0\u00bc \u0097\u00c4\u00cc\u00e9\u008a\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5\u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb\u00c0\u00e8\u00c6\u00c9\u00c7.\n\n\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5\u00c0\u00e5\u00b5\u00c6 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n2006 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00a1\u00e5\u00c6\u00ba\u00be(\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba4\n\nIII \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\n\u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\n\n1.\u00be\u00f8\u00be\u00e0\u00bc\u00c9\u00ea\u00da \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c9\n\n2.\u00cc\u00c4\u00be\u00e0\u00ba\u00eb\u00ef\u00da \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c9\n\n3.\u00a1\u00bc\u00e0\u00bc\u00c8\u0083\u00ef\u0083\u00be\u00c6\u00fa \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00e9\u00c6 \u00cc\u00c3\u00e5\u00c9\n\n4.\u00a1\u00a8\u00e0\u00a8\u00ef\u00c7\u00c6\u00fa\u00c0\u00ba\u00e0\u00ba\u00eb \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c9\n\n5.\u00ef\u00c0\u00e5\u00ba\u00eb\u0097\u00c8\u00e0 \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c9\n\n6.\u00ba\u00f8\u00c7\u00e6\u00a8\u00e0\u00ef\u00a8\u00e5\u00e0\u0097\u00c8\u00e0 \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c9\n\n7.\u00ef\u00a8\u00e5\u00e0\u00c7\u00ef\u00ce\u00c6\u00fa\u00c0\u00ba\u00e0\u00ba\u00eb \u00a4\u00ba\u00eb\u00c7\u00e6 \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c9\n\n8.\u00ef\u00a8\u00e5\u00e0\u00c7\u00ef\u00ce\u00c6\u00fa\u00c0\u00ba\u00e0\u00ba\u00eb \u00c2\u00b4\u00cd\u00fa\u00c7 \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c9"
