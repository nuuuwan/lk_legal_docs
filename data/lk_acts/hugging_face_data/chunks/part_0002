    "chunk_text": "\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa, \u00a6\u00e0\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c9\u00c8 \u00c9\u0090\u00be\u00e5\u00a8\u00c4 \u00c4\u00ba \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c9\u00c8\u00a1\u00b6\u00e2\u00aa\u00eb \u00c7\u00c2\u00da \u00c0\u00f2\u00ba\u00f8\u00ca\u00ba\u00c6 \u00c4\u00ba \u00aa\u00b8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a6\u00ef\u00cc\u00e0\u00aa\u00b8\u00be\u00c6 \u00a8\u00ce \u00ef\u00cc\u00cc\u00e0 \u00c2\u00bc\u00e0\u00bc \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00ef\u00c4\u00e5\u00ef\u00cd\u00e5\u00ef\u00ba\u00e0 \u00bc\u00fb \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6;\n\n437 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e07 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u201c\u00ef\u00cc\u00cc\u00e0 \u00c2\u00f3\u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4.\n\n2006 \u00a1\u00e2\u00a8 20 \u00bc\u00c7\u00be \u00c7\u00c2\u00da \u00be\u00e6\u00c9\u00ba \u00c9\u00aa\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00cd\u00be\u00e5\u00bd\u00e5\u00c7(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba2\n\n(\u00a1\u00e5)(i) \u00a1\u00c4\u00ea \u00cc\u00e0\u00c9\u00e5\u00c3\u00e5\u0097\u00a8 \u00c7\u00c2\u00da;\n\n(ii) \u0097\u00c6\u00c8\u00e8 \u00c7\u00c2\u00da; \u00cc\u00cd\n\n\u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb,\u00a6\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00ef\u00c6\u00e0 \u00a1\u00b6\u00e2\u00aa\u00eb \u00c7\u00c2\u00da\u00c0\u00f2\u00ba\u00f8\u00ca\u00ba\u00c6 \u00c4\u00ba \u00aa\u00b8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a6\u00ef\u00cc\u00e0 \u00aa\u00b8\u00be\u00c6\u00a8\u00ce \u00ef\u00cc\u00cc\u00e0 \u00c2\u00bc\u00e0\u00bc \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa, \u00c7\u00c2\u00da\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00c4\u00ea \u00c7\u00c2\u00da \u0095\u00c8\u00b4\u00aa\u00be\u00e0\u00be\u00e5 \u00ef\u00c4\u00e5\u00ef\u00cd\u00e5\u00ef\u00ba\u00e0 \u00bc\u00fb \u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be\u00ef\u00c4\u00e5\u00ef\u00cd\u00e5\u00ef\u00ba\u00e0 \u00bc\u00fb \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6;\n\n(\u00a1\u00e6) \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c0\u00d6\u00ef\u00c3\u00e5\u00e0\u00b0\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00fa\u00ba\u00c7\u00c2\u00da \u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00a6\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00ef\u00c6\u00e0 \u00a1\u00b6\u00e2\u00aa\u00eb \u00c7\u00c2\u00da\u00c0\u00f2\u00ba\u00f8\u00ca\u00ba\u00c6 \u00c4\u00ba \u00aa\u00b8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a6\u00ef\u00cc\u00e0\u00aa\u00b8\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00cc\u00cc\u00e0 \u00c2\u00bc\u00e0\u00bc \u00c7\u00b4 \u00ba\u00eb\u00ce\u0095\u00c8 \u00bc\u00fb \u00aa\u00be\u00e0\u00be\u00e5 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00bc\u00fb \u00ef\u00aa\u00c9\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cc\u00cc\u00e0 \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0\u00c0\u00ce\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00d6\u0083\u00d2\u00be\u00e0\u00be \u00a8\u00f8\u00d7\u00c4 \u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(4) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 (3) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8\u00e0 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00a6\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6 \u00c0\u00ce\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4\u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00cc\u00e7\u00c4 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8\u00e0 \u00c4, \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00c4\u00e5\u00cc \u00cd\u00ba\u00c7\u00a8\u00e0\u00a2\u00a8\u00eb\u00ba\u00e0\u00d1\u00c4\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00a6\u00c6\u00b4 \u00a1\u00be\u00ea\u00c4\u00ba\u00c6 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00cc\u00bf\u00cd\u00e5 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u00b4 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6. \u00a6\u00ef\u00cc\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00ef\u00be\u00e5\u00a8\u00c7\u00be \u00c8\u00bc \u00a8\u00f8\u00cc\u00e8\u00c6\u008a\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8\u00e0 \u00a6\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00cc\u00e8\u00f3\u00a8\u00c7\u00be \u00c8\u00bc\u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00b4 \u00a1\u00aa\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00a6\u00c6 \u00a1\u00be\u00ea\u00c4\u00ba\u00ef\u00be\u00e5\u00a8\u00ce \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c0\u00d6\u0083\u00d2\u00be\u00e0\u00be \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00c8\u00cc\u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n2006 \u00a1\u00e2\u00a8 20 \u00bc\u00c7\u00be \u00c7\u00c2\u00da \u00be\u00e6\u00c9\u00ba \u00c9\u00aa\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00cd\u00be\u00e5\u00bd\u00e5\u00c7(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba3\n\n(5) (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c6\u008a\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8\u00e0 \u00c0\u00d6\u0083\u00d2\u00be\u00e0\u00be \u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00fa\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(6) \u00a2\u00cd\u00ba \u00a8\u00f9 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0\u00b4 \u00a1\u00be\u00ea\u00c9\u00aa\u00b8\u00be\u00c6 \u00a8\u00ce \u00cc\u00cd \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00ef\u00cc\u00cc\u00e0 \u00c2\u00bc\u00e0\u00bc 2 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00c2\u00e6\u00c7\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(7) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u00a1\u00c6\u00a8\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00c4\u00ea\u00dd \u00c2\u00f3 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6,\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c7\u00c2\u00da \u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00cc\u00cd \u00c7\u00c2\u00da\u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00cc\u00ea\u00dd \u00cc\u00cd \u00c4\u00bd\u00f1 \u00c0\u00d6\u00c4\u00e5\u00b8 \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd \u00c7\u00c2\u00da \u00c9\u00aa\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e51969 \u00a1\u00e2\u00a8 36 \u00bc\u00c7\u00be \u00c8\u00e2\u00a8\u00e5 \u00a8\u00e5\u00da\u0095\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00a8\u00e5\u00da\u0095\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00c4\u00cc\u00e5 \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00b4\u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
