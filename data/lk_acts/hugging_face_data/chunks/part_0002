    "chunk_text": "(xlix) 1981 \u00a1\u00e2\u00a8 3 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a \u00cd\u00e5 \u00f7\u00c9\u00f1\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a \u00cd\u00e5 \u00f7\u00c9\u00f1 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 ;\n\n(l) 1971 \u00a1\u00e2\u00a8 38 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 IV \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ef\u00ba\u00e0, \u00c7\u00c2\u00da \u00cc\u00cd \u00ef\u00c0\u00e5\u00c8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec\u00cc\u00e0\u00bb\u00e5\u00c6\u00fa\u00a8\u00c7\u00b8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 ;\n\n(li) (96 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00c3\u00e5\u00c7 \u00a1\u00e5\u00b3\u00e5 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00b0\u00be\u00cc\u0097\u00c6 \u00c3\u00e5\u00c7\u00a8\u00e5\u00c7 \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 ;\n\n(liii) \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1976 \u00a1\u00e2\u00a8 24 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00cc\u00e0\u00c9\u00e5 \u00c0\u00e8\u00d6\u00cc\u00e0 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00a1\u00e5\u00c6\u00ba\u00be \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00c0\u00e8\u00d6\u00cc\u00e0 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00cd\u00fa ;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba15\n\n(liv) 1996 \u00a1\u00e2\u00a8 1 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c7\u00e5\u00b0\u00f1 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00c0\u00f2\u00ba\u00f8\u00cc\u00e2\u00cc\u00e0\u00a8\u00c7\u00b8 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5 \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c7\u00e5\u00b0\u00f1 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6 \u00c0\u00f2\u00ba\u00f8\u00cc\u00e2\u00cc\u00e0\u00a8\u00c7\u00b8 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0\u00cc\u00c3\u00e5\u00ef\u008c ;\n\n(lv) 1987 \u00a1\u00e2\u00a8 36 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00cc\u00cd \u0097\u00be\u00f8\u00c4\u00c6\u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5 \u00c0\u00be\u00ba \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00cc\u00cd \u0097\u00be\u00f8\u00c4\u00c6 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00ef\u008c ;\n\n(lvi) 1997 \u00a1\u00e2\u00a8 28 \u00bc\u00c7\u00be \u00c2\u00b8\u00e0\u00b6\u00e5\u00c7\u00be\u00e5\u00c6\u00a8 \u00ef\u00a8\u00f0\u00ba\u00eb\u00a8\u00e5\u00aa\u00e5\u00c7\u00a8\u008a\u00b4\u00ea\u00c9 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a) \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00c8\u00bc \u00c2\u00b8\u00e0\u00b6\u00e5\u00c7\u00be\u00e5\u00c6\u00a8 \u00ef\u00a8\u00f0\u00ba\u00eb\u00a8\u00e5\u00aa\u00e5\u00c7 \u00a8\u008a\u00b4\u00ea\u00ef\u008c ;\n\n(lvii) 1992 \u00a1\u00e2\u00a8 33 \u00bc\u00c7\u00be \u00c0\u00ba\u00c8\u00e0 \u00cd\u00e5 \u00a9\u00b8\u00e8\u00b0 \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00c3\u00ed \u0097\u00bc\u00f1\u00e5 \u00cc\u00e4\u00a8\u00e0\u00cb\u00b8 \u00cc\u00cd \u00c0\u00ba\u00c8\u00e0\u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00c6;\n\n(lviii) 2003 \u00a1\u00e2\u00a8 39 \u00bc\u00c7\u00be \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1973 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be\u00c2\u00bc\u00e0\u00bd \u00be\u00f8\u00c9\u00e5\u00cc \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u008a \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00cd\u00fa;\n\n(lix) 2000 \u00a1\u00e2\u00a8 21 \u00bc\u00c7\u00be, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c2\u00f3\u00a8\u00c7\u00b8 \u00a8\u00e5\u00da\u00c6\u00e5\u00c6\u00ba\u00be\u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c2\u00f3\u00a8\u00c7\u00b8\u00a8\u00e5\u00da\u00c6\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00cd\u00e8,\n\n\u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c9\u00c8\u00e8\u00be\u00e0 \u00cc\u00cd \u00ef\u00c0\u00e5\u00c8\u00e9\u00c9\u00c8\u00e8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00ef\u00be\u00e5\u00c9\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4;\n\n(\u00a1\u00e6) (i)\u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c\u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00cc\u00ba\u00eb \u00d1 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c3\u00e5\u00c7\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00bc\u00c6\u00a8\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00a6\u00e0 \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4 \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4 \u00a1\u00da\u00bb\u00c8\u00e5\u00c3\u00fb \u00cd\u00fa\u0095\u00a8\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00cd\u00e6\u00c7 ; \u00cc\u00cd\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba16\n\n(ii)1971 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ef\u00c9\u00ef\u00ce\u00bf \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 (\u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a)\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u00ef\u00c9\u00ba \u00cc\u00ba\u00eb \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00ef\u00c9\u00ef\u00ce\u00bf \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8,\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc, \u00a6\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ba\u00eb\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00da\u008a\u00c3 \u00c9\u00be \u00c6\u008a \u00a8\u00e5\u00c8\u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\u00a8\u00e0\u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00cd\u00e6\u00c7,\n\n\u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 ;"
