    "chunk_text": "(\u00a8) \u00c6\u008a \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00e8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c9\u00ca\u00f1\u00c9\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c4\u00ec\u00c8\u00e5\u00ca\u00f2\u00c9\u00c8\u00e8\u00be\u00e0 \u00b8\u00c6\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0\u00c8\u00c2\u00e5\u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00cd \u00c2\u00e6\u00bf\u00fb\u008a \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 ;\n\n(\u00aa) \u00c6\u008a \u00ae\u00e2\u00ae\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00c4 ;\n\n2005 \u00a1\u00e2\u00a8 26 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a4\u00b6\u00c7\u00b4 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba8\n\n(\u00ae) \u00a1\u00bc\u00e5\u00ce \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca \u00cc\u00c4\u00aa \u00a6\u00a8\u00e0\u00c9, \u00bc\u00fa\u00c6 \u00ef\u00c2\u00ba\u00e0\u00c4 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6\u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00c0\u00e5\u00e2\u00ca\u00eb \u00a9\u00e5\u00bc\u00be\u00c6 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c9\u00ca\u00f1 \u00c0\u00e8\u00c6\u00c9\u00c7\u00aa\u00e6\u00be\u00f9\u00c4 ;\n\n(\u00b4) \u00ef\u00c3\u00f0\u00ba\u00f8\u00a8 \u00c0\u00d6\u00cc\u00c7\u00ef\u00c6\u00e0 \u00c9\u00e6\u0097\u00c8\u00e8 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8 \u00a8\u00f2\u00c4, \u00b0\u00c8 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6,\u00c0\u00e5\u00e2\u00ca\u00eb \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00cc\u00cd \u00cc\u00e2\u00c7\u00a8\u00e0\u00cb\u00b8\u00c6 \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4\u00cc\u00bf\u00cd\u00e5 \u00a4\u00c0\u00ef\u00bc\u00e0\u00ca\u00a8 \u00cc\u00cd \u00ef\u00aa\u00e5\u0097 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00c0\u00c6\u00e5 \u00bc\u00fb\u00c4 ;\n\n(\u00b6) \u00c7\u00b0\u00ef\u00c6\u00e0 \u00cc\u00cd \u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00c2\u00e6\u00e2\u00a8\u00eb \u00cc\u00c4\u00aa \u00a6\u00a8\u00e0\u00c9 \u00ef\u00aa\u00e5\u0097\u00c6\u00be\u00b4 \u00a1\u009e\u00a8\u00e0\u00cb\u00e8\u00ba\u00b8\u00c6 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00a8\u00c7 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00b8) \u00ef\u00aa\u00e5\u0097\u00c6\u00be\u00b4 \u009f\u00b0 \u00f7\u00c9\u00f1, \u00ef\u00c0\u00e5\u00ef\u00cd\u00e5\u00c7, \u00a8\u00ee\u00cb\u00e8 \u00c7\u00cc\u00e5\u00c6\u00be \u00f7\u00c9\u00f1, \u0097\u00f3\u00c8\u00e8\u00c2\u00c8\u00c6, \u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8 \u00c6\u00be\u00e0\u00ef\u00ba\u00f2\u00e5\u00e0\u00c0\u00a8\u00c7\u00b8 \u00cc\u00cd \u00a4\u00c0\u00a8\u00c7\u00b8 \u00c9\u00e6\u00be\u00f8\u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8 \u00ef\u00c6\u00bc\u00c9\u00ea\u008a \u00cc\u00c0\u00c6\u00e5\u00bc\u00fb\u00c4 ;\n\n(\u00ba) \u00a1\u00bc\u00e5\u00ce \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca \u00cc\u00c4\u00aa \u00a6\u00a8\u00e0\u00c9, \u00a8\u00ee\u00cb\u00e8\u00a8\u00da\u00c4\u00c6 \u00cc\u00cd \u00a8\u00ee\u00cb\u00e8 \u00c4\u00ec\u00c8\u00e8\u00a8\u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a3\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00c9\u00ec \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00c9\u00c8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4\u00b4 \u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00cc\u00e6\u00c8\u00cc\u00e9\u00c4 \u00cc\u00cd \u00aa\u00fa\u0097\u00cc\u00ea\u008a \u00a1\u00e6\u00ba\u00f8\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00c4 ;\n\n(\u00bc) \u00a8\u00ee\u00cb\u00e8 \u00c4\u00ec\u00c8\u00e8\u00a8 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00e0\u00c9\u00e5\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00c9\u00ec \u00a8\u00e5\u00da\u0095\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u00b8\u00e8\u00b0\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00be) \u00ef\u00aa\u00e5\u0097\u00c0\u00c8\u00c9\u00c8 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u0095\u00c8\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4,\u00aa\u00c2\u00b6\u00e5 \u00a8\u00f8\u00d7\u00c4, \u00cc\u00a8\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00ef\u00c8\u0097 \u00ef\u00cc\u00e0\u00c9\u00e5\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00c0) \u0081\u00be\u00e7\u00c4 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00c6\u00be\u00e0\u00ba\u00f2\u00e5\u00aa\u00e5\u00c7, \u00c6\u00be\u00e0\u00ef\u00ba\u00f2\u00e5\u00e0\u00c0\u00a8\u00c7\u00b8, \u00ef\u00c4\u00c9\u00c8\u008a,\u00c3\u00e5\u00b8\u00e0\u00b6 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00bc\u00e0\u00c9\u00c8 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00cc\u00cd \u00a1\u00ef\u00c8\u0097\u00c6 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6\u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00c2) \u00c3\u00e5\u00b8\u00e0\u00b6, \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be, \u00f7\u00c9\u00f1 \u00cc\u00cd \u00ef\u00c9\u00ce\u00bf \u00f7\u00c9\u00f1 \u00a1\u00e5\u00be\u00c6\u00be\u00c6,\u00a1\u00c0\u00be\u00c6\u00be\u00c6, \u0095\u00c8\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4, \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00cc\u00cd \u00a6\u00e0\u00c9\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 ;\n\n2005 \u00a1\u00e2\u00a8 26 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a4\u00b6\u00c7\u00b4 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba9\n\n(\u00c4) \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0 \u00a1\u00c7\u00c4\u00ea\u00b8\u00ea \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cc\u00cd \u00be\u00e2\u00c9\u00e5\u00c8\u00e9\u00c4\u00b4 \u00a2\u00b6\u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8, \u00cc\u0095\u00ba\u00f8\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00c9\u00c8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e0\u00a8\u00be\u00e0\u00bd\u00c9\u00c8\u00b4 \u00bc\u00e5\u00c6\u00a8 \u00d1\u00ef\u00c4\u00be\u00e0, \u00a6\u00e0\u00c9\u00e5 \u0095\u00c8\u00b4\u00aa\u00e6\u00be\u00f9\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4, \u00aa\u00e6\u00be\u00f9\u00c4,\u00bc\u00e6\u00d7\u00c4 \u00cc\u00cd \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 ;\n\n(\u00c6) \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00b4 \u00a8\u00c7\u00be \u00c8\u00bc \u0097\u00a8\u00f8\u00b8\u00e9\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00f8\u00be\u00e0 \u00a1\u00c6\u00d1\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00b8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00ef\u00aa\u00d1\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00e0\u00be\u00a8\u00f8\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00aa\u00d1\u00c4\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00a6\u00c9\u00e6\u00be\u00f8 \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00cc\u00e0\u00a8\u00be\u00e0\u00bd \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\u00cc\u00ee\u00b8\u00c0\u00ba\u00f2 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e6\u00c0\u00a8\u00c7 \u00c0\u00e8\u00ce\u00e8\u00aa\u00e6\u00be\u00f9\u00c4 ;\n\n(\u00a1\u00a1) \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00c4\u00ea\u00f3\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00a1\u00c7\u00c4\u00ea\u00b8\u00e8\u00be\u00e0 \u00c0\u00e5\u00c8\u00e8\u00ba\u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00a6\u00e0\u00c9\u00e5\u00b4 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd\u00cc\u00cd\u00c3\u00e5\u00aa\u00fa \u00d1\u00c4 ; \u00cc\u00cd\n\n(\u00a1\u00e5\u00a1\u00e5) \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00a8\u00f2\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c8\u00e8\u008d\u00ba \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9, \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00c4\u00ea\u00f3\u00be\u00e0\u00c0\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a6\u00cd\u00fa \u00c2\u00c8\u00ba\u00c8\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c9\u00ca\u00f1 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00be\u00ea\u00cb\u00e2\u00aa\u00fa\u00a8 \u00cc\u00e8\u00c6\u00f5\u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4."
