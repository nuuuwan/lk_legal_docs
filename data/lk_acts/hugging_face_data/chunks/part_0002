    "chunk_text": "(4) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00a1\u00be\u00ea\u00c2\u00c8 \u00bc\u00fb\u00c4\u201d \u00cc\u00cd \u201c\u00a8\u00eb\u00c4\u00be\u00e0\u00ba\u00f2\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u201d \u00c6\u00be\u00ef\u00c6\u00f3\u008a\u00c9\u00c8\u00b4 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00e8\u00be\u00e0 \u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00ef\u00c6\u00e0 100, 101 \u00cc\u00cd 113\u00a1 \u00c6\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u00a3\u00b4 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00a1\u00da\u00bb\u00c6 \u00c4 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n2005 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00ef\u00ef\u00c9\u00ca\u00f1\u00e5 \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00e5\u00be\u00e0\u00ba\u00e5\u00c9\u00be\u00e0 \u00cc\u00cd\u00ce\u00c4\u00c6\u00fa\u00be\u00e0 \u00b0\u00e5\u00c9\u00e5\u00c7\u008a \u00a8\u00f8\u00d7\u00c4 \u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00c4 \u00cc\u00cd \u00a3\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 \u00c0\u00be\u00ba\n\n3\n\n(2) \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e2\u00c6\u00ea\u00a8\u00e0\u00ba \u00c9\u00be \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0\u00c0\u00e8\u00b4\u00ba \u00bc\u00fb \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8,\u2014\n\n(\u00a1) \u00a6\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9 \u00cc\u00e8\u00f3 \u00a8\u00ce \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00cc\u00e8\u009b \u00be\u008a ;\n\n(\u00a1\u00e5) \u00a6\u00c4 \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00be\u008a \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00be\u00f8\u00ba\u00c7 \u00c9\u00e5\u00cc\u00c6 \u00a8\u00c7\u00be \u00a1\u00ef\u00bc\u00e0\u00ca\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00be\u008a ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e6) \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c2\u00c9\u00b4 \u00a4\u00bc\u00e0\u00ef\u00bc\u00e0\u00ca\u00fa\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c\u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00ef\u00c6\u00a8\u00e0 \u00be\u008a,\n\n\u00a6\u00c4 \u00c9\u00c7\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00bc\u00fb \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c8\u00bc \u00c9\u00c7\u00bc\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00e5 \u0097\u00c3\u00e5\u00aa\u00a8\u00f8\u00d7\u00c4\u00b4 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c4\u00cd\u00e5\u0093\u00a8\u00c7\u00b8\u00c6\u00b4 \u00a1\u0093\u00a8\u00c7\u00b8 \u00c2\u00c8\u00c6\u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n4. (\u00a1) 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00cd\u00e5 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e8\u00f3\u00a8\u00c7\u00be \u00c8\u00bc \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00c9\u00c7\u00bc\u00a8\u00c7\u00e6\u201d\u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb -\n\n(i)\u00a8\u00e5\u00be\u00e0\u00ba\u00e5\u00c9\u00be\u00e0 \u00cc\u00cd \u00ce\u00c4\u00c6\u00fa\u00be\u00e0 \u00b0\u00c9\u00e5\u00c7\u008a \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a1\u00c0\u00c7\u00e5\u00bd \u00a8\u00b8\u00e0\u00b6\u00e5\u00c6\u00c4\u00a8 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ef\u00c6\u00a8\u00e0\u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00c9\u00be ;\n\n(ii) \u00ef\u00c9\u00be\u00ba\u00e0 \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a1\u00c0\u00c7\u00e5\u00bd \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00d1 \u00cc\u00e8\u0090\u00be ;\n\n(iii) \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00c0\u00f2\u00ae\u00b8\u00e0\u00b6 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00cc\u00e8\u00f3 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00e8 \u00ef\u00cd\u00e5\u00e0\u00a1\u0097 \u00a1\u00e5\u00c6\u00ea\u00bd \u00c3\u00e5\u0097\u00ba \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 ;\n\n(iv) \u00c7\u00b0\u00ef\u00c6\u00e0 \u00be\u00f8\u00c8\u00c6\u00a8\u00e0 \u00bc\u00c7\u00be \u00a1\u00ba\u00c7\u00c4 \u00a6\u00c4\u00aa\u00fa\u00be\u00e0 \u00a6\u00c4 \u00bd\u00ea\u00c7\u00ef\u00c6\u00e0\u00c2\u00c8\u00ba\u00c8 \u00cc\u00cd \u00a1\u0093\u00a8\u00e5\u00d6 \u00c2\u00c8\u00c6 \u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00ef\u00c6\u00be\u00e0\u00c4 \u00a1\u00be\u00f8\u00cc\u00e8\u00ef\u00c8\u00cc \u00c3\u00e5\u0097\u00ba \u00a8\u00c7\u00be ;\n\n\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec\u00c9\u00e6\u00c7\u00bc\u00fa \u00c4\u00cd\u00e5\u0093\u00a8\u00c7\u00b8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u0097\u00c3\u00e5\u00aa \u00a8\u00ce\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00c2\u00c7\u00c0\u00ba\u00c8\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00be\u00ea\u00aa\u00ba\u00a8\u00c7\u00e6\u00b8\u00ea.\n\n2005 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00ef\u00ef\u00c9\u00ca\u00f1\u00e5 \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00e5\u00be\u00e0\u00ba\u00e5\u00c9\u00be\u00e0 \u00cc\u00cd\u00ce\u00c4\u00c6\u00fa\u00be\u00e0 \u00b0\u00e5\u00c9\u00e5\u00c7\u008a \u00a8\u00f8\u00d7\u00c4 \u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00c4 \u00cc\u00cd \u00a3\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 \u00c0\u00be\u00ba\n\n4\n\n(v)\u00ce\u00c4\u00c6\u00fa\u00be\u00e0\u00b4 \u00cd\u00fa\u00d6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00ce\u00c4\u00c6\u00fa\u00be\u00e0 \u00b0\u00e5\u00c9\u00e5\u00c7\u008a \u00a8\u00f8\u00d7\u00ef\u008a\u00be\u00f8\u00c6\u00e6\u00c8\u00e9 \u00a1\u00e6\u00ba\u00f8 ; \u00cc\u00cd\n\n(vi) \u0097\u00ef\u00ca\u00e0\u00cb\u00ef\u00c6\u00be\u00e0\u00c4 \u00cc\u00c4\u00e5\u00be \u00c9\u00e6\u00c7\u00bc\u00fa\u00c9\u00c8\u00b4 \u00a8\u00c8\u00e8\u00be\u00e0 \u00c9\u00e6\u00c7\u00bc\u00fa\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00d1 \u00cc\u00e8\u0090\u00be, \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5) \u00c3\u00e5\u00c7\u00a8\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00bc\u00fb\u00ef\u00cd\u00e5\u00e0 \u00cc\u00c4\u00e5\u00b0\u00c6\u00b4 \u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00cc\u00c8\u00cc\u00be \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8 \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00c9\u00e5\u00b4\u00a2\u00ba\u00e5 \u00a1\u00e5\u00cc\u00be\u00e0\u00be \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8 \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be, \u00a8\u00f2\u00e9\u00b6\u00e5, \u00cc\u00c4\u00e5\u00b0\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u00cd \u00cc\u00e2\u00cc\u00e0\u00a8\u00ee\u00ba\u00f8\u00a8 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u00bf\u00cd\u00e5 \u00ce\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00cd\u00ca\u00fa\u00cb\u00f1\u00c6\u00be\u00e0 \u00c0\u00e6\u0095\u00ef\u00b8\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8 \u00bc\u00fb,\n\n2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00cc\u00cd (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00e6\u00c7\u00bc\u00fa\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c8\u00bc \u00c9\u00c7\u00ef\u00bc\u00cd\u00fa \u00c2\u00c7\u00c0\u00ba\u00c8 \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00c6 \u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4\u00ef\u00aa\u00be \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00a1\u0093\u00a8\u00c7\u00b8 \u00c2\u00c8\u00c6 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00c4\u00cd\u00e5\u0093\u00a8\u00c7\u00b8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4 \u00a8\u00c7\u00e6\u00b8\u00ea \u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n5.\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c6\u00a8\u00eb \u00ef\u00be\u00e5\u00c9\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0\u00c9\u00ec \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e8\u00c7\u00c3\u00e5\u00c7\u00c6\u00b4 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ea \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u2014"
