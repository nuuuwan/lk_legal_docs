    "chunk_text": "\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9\u00bc, \u00c6\u008a \u0097\u00ef\u00ca\u00e0\u00cb \u00a8\u00e5\u00da\u00c6 \u00c0\u00f2\u00c9\u00e5\u00cd\u00a8\u00c6\u00a8\u00e0 \u00ef\u00c9\u00ba\u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c3\u00e5\u00c7 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4\u00a8 \u00bc\u00fb, \u00a6\u00c4\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6.\n\n2000 \u00a1\u00e2\u00a8 56 \u00bc\u00c7\u00be\u00c0\u00be\u00ef\u00ba\u00e0 4 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e021 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00e8\u00ef\u00c6\u00e024 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n22005 \u00a1\u00e2\u00a8 24 \u00bc\u00c7\u00be \u00a8\u00c8\u00e0\u00c2\u00f3 \u00c4\u00ea\u00c8\u00f1\u00a8\u00c7\u00b8(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n\u00c0\u00e6\u00c9\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c3\u00e5\u00c7\u00a8\u00f8\u00d7\u00c4 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00a8\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6\u00cc\u00bf\u00cd\u00e5\u00c4 \u00c0\u00c4\u00b8\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00a8\u00c7\u00b8\u00c9\u00f1\u00ea\u00cd\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00cc\u00e6\u00c8\u00e6\u00cc\u00e0\u00c4 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba\u00a8\u00c7\u00be \u00c8\u00bc \u00c0\u00d6\u00bc\u00fa \u00c9\u00ec \u00a6\u00a8\u00a8\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7\u00be \u00c8\u00bc \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb\u00a8\u00e5\u00da\u00c6 \u00c0\u00f2\u00c9\u00e5\u00cd\u00a8\u00c6\u00a8\u00e0, \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00c8\u00bc \u00c9\u00f1\u00ea\u00cd\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00cc\u00cd \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0\u00a8\u00c8\u00b4 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00be\u00e8\u00ef\u00c6\u00e5\u00e0\u00aa \u00cc\u00cd\u00c4\u00e5\u00da\u00ef\u00aa\u00e5\u00e0\u00c0\u00ef\u00bc\u00e0\u00ca\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c0\u00c4\u00b8\u00a8\u00e0 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00a8\u00c7\u00b8\u00c6\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00c0\u00e6\u00c9\u00c7\u00e6\u00c4\u00a8\u00f8\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00c3\u00e5\u00c7\u00a8\u00f8\u00d7\u00c4\u00a8\u00f8\u00be\u00e0, \u00c0\u00e6\u00c9\u00c7\u00e6\u008a\u00a8\u00c7\u00e6 \u00ef\u00cd\u00e5\u00e0 \u00c3\u00e5\u00c7\u00a8\u00c7\u00be\u00e0\u00be\u00e5\u2014\n\n(\u00a1)\u00a8\u00c8\u00e0\u00c2\u00f3 \u00c4\u00ea\u00c8\u00f1\u00a8\u00c7\u00b8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6\u00a8\u00e5\u00da\u00c6\u00c9\u00c8\u00e8\u00be\u00e0 \u00c4\u00ea\u00bc\u00e5\u00cd\u00e6\u00d7\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00a8\u00c8\u00e0\u00c2\u00f3\u00c4\u00ea\u00c8\u00f1\u00a8\u00c7\u00b8\u00ef\u00c6\u00e0 \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f9\u00ba\u00f8\u00ef\u00c6\u00e0\u00c2\u00c8\u00c0\u00e7\u00ef\u008a \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00e8\u00d7\u00c4\u00a8\u00e0 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00a8\u00c8\u00e0\u00c2\u00f3 \u00c4\u00ea\u00c8\u00f1\u00a8\u00c7\u00b8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00c0\u00c6\u00be \u00c8\u00bc\u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00a4\u00c0\u00a8\u00c7\u00b8\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c9\u00be\u00ba\u00e5\u00a8\u00e0 \u00f3\u00c7\u00b4\u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00a8\u00e5\u00da\u00c6\u00c6\u00c9\u00c8\u00e8\u00be\u00e0 \u00c4\u00ea\u00bc\u00e5\u00cd\u00e6\u00d7\u00c4\u00a8\u00e0,\n\n\u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n(4) (203 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c7\u00bb\u00c9\u00e5\u00cd\u00be\u00c0\u00be\u00ef\u00ba\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9, \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c7\u00bb\u00c6\u00a8\u00e0 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00c2\u00f3\u00bc\u00fb\u00c4\u00be\u00e5\u00a8\u00c7\u00e6 \u00cc\u00ba\u00eb \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00c8\u00cc\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c0\u00d6\u00bc\u00fa \u00c2\u00f3 \u00bc\u00fb\u00c4\u00be\u00e5\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0\u0097\u00ef\u00ca\u00e0\u00cb \u00a8\u00e5\u00da\u00c6 \u00c0\u00f2\u00c9\u00e5\u00cd\u00a8\u00c6\u00a8\u00e0 \u00ef\u00c9\u00ba \u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c3\u00e5\u00c7\u00a8\u00f8\u00d7\u00c4\u00a8\u00f8\u00be\u00e0 \u00c0\u00cc\u00ea\u2014\n\n(\u00a1) (203 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c7\u00bb\u00c9\u00e5\u00cd\u00be\u00c0\u00be\u00ef\u00ba\u00e0 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9\u00bc,\u00c0\u00e6\u00c9\u00c7\u00e6\u008a\u00c8\u00e5\u00c3\u00e8\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00c3\u00e5\u00c7\u00aa\u00be\u00e0\u00be\u00e5 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c7\u00bb\u00ef\u00c6\u00e0\u00c0\u00c7\u00c4 \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00c7, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa \u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c3\u00e5\u00c7\u00a8\u00f8\u00d7\u00c4\u00a8\u00f8\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00bc\u00fa\u00be \u00cd\u00ba\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba,\n\n32005 \u00a1\u00e2\u00a8 24 \u00bc\u00c7\u00be \u00a8\u00c8\u00e0\u00c2\u00f3 \u00c4\u00ea\u00c8\u00f1\u00a8\u00c7\u00b8(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba"
