    "chunk_text": "(\u00a6)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00aa\u00c4\u00be\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0,\u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00e5\u00b4 \u00aa\u00c4\u00be\u00e0, \u00c6\u00e6\u00c0\u00e9\u008a\u00ef\u00cd\u00e5\u00e0 \u00c8\u00e6\u00aa\u00eb\u008a \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00a8\u00e0 ;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba23\n\n\u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00cd\u00e5\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00bc\u00fb-\n\n(i)\u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00ba\u00eb\u00ce\u00bc\u00fb \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00a8\u00e0 ;\u00ef\u00cd\u00e5\u00e0\n\n(ii)\u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00c6\u00ef\u00aa\u00e0 \u00cc\u00e0\u00c9\u00e5\u0095 \u00c0\u00ea\u00c7\u00e6\u00cb\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0\u00c3\u00e5\u00da\u00c6\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c0\u00cc\u00ea\u00aa\u00fa\u00c6 \u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00be\u00e0,\n\n\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0, \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00a4\u00c0\u00c6\u00be \u00c8\u00bc \u00c0\u0091 \u00be\u0091\u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00c6\u00ef\u00aa\u00e0 \u00cc\u00e0\u00c9\u00e5\u0095\u00c0\u00ea\u00c7\u00e6\u00cb\u00c6\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c3\u00e5\u00da\u00c6\u00e5\u00c9\u00b4 \u00a1\u00ba\u00e0\u00c9\u00be\u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0 \u00a6\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00e5\u00b4 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c\u00bc\u00fb \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0\u00be\u008a \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c0\u0091\u00be\u0091 \u00ef\u00cd\u00e5\u00e0 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0, (\u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u0097\u00c6\u00bc\u008a \u00c6\u00c6\u00fa\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00cc\u00c8\u00a8\u00be, \u00a6\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ca\u00f2\u00e9\u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba\u00bc\u00fb \u0097\u00c6\u00bc\u008a \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00a1\u00b6\u00ea \u00a8\u00c7) \u00a7\u00cd\u00ea\u0097\u00cc\u00e8\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9\u00b4 \u00ef\u00c0\u00f2\u00e0\u00cb\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a, \u00a6\u00e0 \u00c0\u0091 \u00be\u0091\u00cd\u00e5 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0 ;\n\n(\u00a7)\u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb \u00c0\u00bc\u00fa\u00e2\u008e \u00cc\u00e0\u00bb\u00e5\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00c9\u00e6\u00b6 \u00a8\u00c7\u00be\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea \u00c9\u00e6\u00b6 \u00a8\u00c7\u00be \u00cc\u00e0\u00bb\u00e5\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00c0\u00bc\u00fa\u00e2\u008e\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00c4\u00be\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0\u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00e5\u00b4 \u00cc\u00c0\u00c6\u00be \u00c8\u00bc \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00ef\u00a8\u00e5\u00e0\u0083 \u00c7\u00bb\u00c6\u00a8\u00f8\u00be\u00e0\u00ef\u00be\u00e5\u0095\u00ef\u00c8\u00e0 \u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c9\u0090\u00be\u00e5\u00a8\u00c4 ;\n\n(\u0081)\u00c6\u008a \u00a1\u00da\u00bb\u00cc\u00e5\u00bd\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00f8\u00be\u00e0, \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e01980 \u00a1\u00e2\u00a8 46 \u00bc\u00c7\u00be \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c3\u00e5\u00c7 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00c0\u00be\u00ba\u00f8\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c3\u00e5\u00c7 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4 \u00a7\u00cd\u00ea \u0097\u00ca\u00f2\u00e5\u00c4 \u00aa\u00be\u00e0\u00be\u00e5 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c\u00bc\u00fb \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5\u00c9\u00ea \u00c4\u00ea\u00bc\u00ef\u00c8\u00cd\u00fa, \u00a6\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c9\u00c8\u00e8\u00be\u00e0 1987 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0\u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00c6\u008a \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0\u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00c9\u00f1\u00ea\u00ba\u00e0\u00c0\u00be\u00e0\u00be \u00c9\u00ec \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00ef\u00a8\u00e5\u00b4\u00cc ;\n\n(\u00a8)1987 \u00a1\u00e2\u00a8 23 \u00bc\u00c7\u00be \u00c7\u00e5\u00b0\u00f1 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00a1\u00e5\u00c6\u00ba\u00be \u00ef\u00c0\u00e5\u00f3 \u00cc\u00c4\u00e5\u00aa\u008a \u00c2\u00c9\u00b4 \u00c0\u00d6\u00c9\u00da\u00ba\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0\u00a1\u00e6\u00ba\u00f8 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6\u00a8\u00f8\u00be\u00e0 \u00c6\u008a\u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb \u0097\u00ca\u00f2\u00e5\u00c4 \u00aa\u00be\u00e0\u00be\u00e5 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c\u00bc\u00fb \u00a7\u00cd\u00ea\u00b4 \u00ef\u00aa\u00c9\u00be\u00c8\u00bc 4 (1) \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba\u00c0\u00d6\u00bc\u00fa, \u00c6\u008a \u00c7\u00e5\u00b0\u00f1 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8, 1997 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00ef\u00cc\u00e0\u00c9\u00e5\u00a8\u00e5\u00c8\u00c6\u00b4 \u00a1\u00e5\u00ef\u00c7\u00e5\u00e0\u00c0\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 ;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba24"
