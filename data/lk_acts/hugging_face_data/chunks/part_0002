    "chunk_text": "2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 4 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cc\u00b2\u00b8\u00c9\u00c1\u00c7\u00b1\u00ba\u00c1\u00c7\u00bb+\u00c6\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c616\n\n(2) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00ac\u00e1+\u00c6\u00d0\u008c\u00b6\u00c8 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u0081\u00de\u00ba\u00c6 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00c8\u008a\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00d5\u00b6\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de\u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00af\u00c6\u00d0 \u00c1\u00dd\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(4) \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ac\u00e1+\u00c6\u00d0\u008c\u00b6\u00c8 \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00a5\u00be\u00c6\u00be\u00c7\u00cc\u00b6\u00c7\u00c0\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00a3\u00bd\u00c8\u008c\u00b9\u00c6\u00da \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00c8\u008a\u00be\u00c6\u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n13\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8+\u00c6\u00af\u00bf\" \u00b6\u00ba\u00c8\u00c0\u00c6 \u00a7\u00ce\u00bc\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00ce\u00b4\u00cd\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00bb \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n14\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00b7\u00c6\u00b6\u00bc\u00c6\u00b9\u00c6\u00b9\u00ba\u00c6 \u00cd\u00c1\u00de\u00c1\u00ce\u00af\u00bb\u00c7\u00af\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00cc\u00be\u00c7\u00c0\u00c8\u00bb \u2013\n\n\u201c\u00b1\u00ba\u00c1\u00c7\u00bb+\u00c6\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b8 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 I\"\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 II\" \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 III \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5IV \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00bd\u00c8\u00be\u00c6 \u00b6\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00db\u00b6\u00be\u00c7\u00c1\u00d7 \u00b1\u00ba\u00c1\u00c7\u00bb\u00ba\u00c6\"\u00a5\u00bc\u00ae\u00b4\u00c7\u00c1\u00d7 \u00b1\u00ba\u00c1\u00c7\u00bb\u00ba\u00c6\" \u00f2\u0081\u00bd\u00c7\u00c1\u00d7 \u00b1\u00ba\u00c1\u00c7\u00bb\u00ba\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b7\u00c7\u0081\u00af\u00c7\u00c1\u00d7 \u00b1\u00ba\u00c1\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8\u00a7\u00de\u00b9\u00c6\u00da\u00af\u00bf\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00db\u00ce\u00bd\u00cd\u00bb (357 \u00a4\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8)\u00b6\u00ce\u00bc\u00b9\u00c6\u00b9\u00ce\u00b4\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\" (358 \u00a4\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8)\u00af\u00b4\u00bd\u00c6\u00b9\u00ce\u00b4\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 (359 \u00a4\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8)\u00c1\u00c7\u0081\u00b9\u00ce\u00b4\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00bd\u00c8\u0081 \u00af\u00dd\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00b4\u00c6\u00b9\u00b4\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a5\u00bc\u00c7\u00d6\u00c1 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\n\n\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u00cd\u00af\u00c7\u00b4\u00be\u00c6\u00b0\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba\u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6\u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf\u00a7\u00ce\u00bc \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 4 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cc\u00b2\u00b8\u00c9\u00c1\u00c7\u00b1\u00ba\u00c1\u00c7\u00bb+\u00c6\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c617\n\n\u201c\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ba\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\"\u00b7\u00c7\u0081\u00af\u00c7\u00c1\u00d7 \u00b1\u00ba\u00c1\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00ba\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00b9\u00bf\u00c8 \u00a3\u00bc\u00d2\u201d \u00a9\u0081\u00b9\u00d7\" \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00ba\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00b9\u00c7\u00bc\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c8\u00ac\u00dd\u00c1\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\" \u00a3\u00c1\u00bc\u00c6 \u00a9\u00b7\u00c6\u00b6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00c1\u00bc\u00b1\u00c8\u0081 \u00b7\u00c7\u00b4\u00c6\u00b4\u00c1\u00bc\u00c7\u00af\u00e2\u00bf\u00c6\u00bf\u00c7\u00cd\u00bc\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00c6 \u00a9\u00b7\u00c6\u00b6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00c1\u00bc\u00b1\u00c8\u0081 \u00a4\u00dc\u00b6\u00b7\u00c6\u00b6\u00c7+\u00c6\u00af\u00c8\u00bb \u00b9\u00ce\u00b4\u00af\u00bf\u00c8\u00b8\u00d7 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c7\u00af \u00db\u00af\u00c6\u00af\u00c8\u00bb\u00ba\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cd\u00b7\u00bc\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a5\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\u00c7\u00cd\u00bc\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00dd\u00b7\u00c6\u00b6\u00c7\u00cd\u00bc\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00c1\u00bc\u00b1\u00c8\u0081\u00b7\u00be\u0081\u00af\u00dd\u00b6\u00c8\" \u00f2\u0081\u00bd\u00c7\u00c1\u00d7 \u00b1\u00ba\u00c1\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00af\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00af \u00b7\u00c7\u0081\u00af\u00c7\u00c1\u00d7 \u00b1\u00ba\u00c1\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00b4\u0081\u00b9\u0088\u00af\u00c6\u00ce\u00af \u00db\u00b6\u00bd\u00c6\u00d0\u00bd\u00c8\u00b9\u00c6\u00da 1 \u00a5\u0081\u00af\u00c9\u00c0\u00c6\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00b9\u00bf\u00c8 \u00a3\u00bc\u00d2\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00b6\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00af\u00b4\u00ce\u00ba\u00af\u00ce\u00bf \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00de\u00af\u00c8\u0081\u00bd \u00a3\u00bc\u00d2 \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00e1+\u00c6\u00af\u00ce\u00ba\u00b9\u00c6\u00da\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b9\u00c7\u00bc\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c8\u201d \u00a9\u0081\u00b9\u00d7\" \u00f2\u0081\u00bd\u00c7\u00c1\u00d7\u00b1\u00ba\u00c1\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00c1\u00c7\u00bc\u00c6 \u00a4\u00bf\u00c6\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6\u00b0\n\n\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 I(\u0089\u00bc\u00c8\u00e2 2\" 11 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 13)\n\n1949 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00ad\u00af\u00b6\u00c6\u00d7 12 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\" \u00cd\u00b9\u00c7\u00bc\u00c6\u00af\u00c6\u00af\u00bf\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00cd\u00b9\u00c7\u00bc\u00c6\u00da\u00bc\u00c8\u00dc\u00ba\u00c6\u00a4\u00dc\u00b6\u00b7\u00c6\u00b6\u00c7+\u00c6\u00af\u00c8\u00bb \u00b9\u00ce\u00b4\u008a\u00b8\u00dd\u00bf\u00c6 \u00af\u00c7\u00bb\u00db\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c8\u00b8\u00d7\u00ba\u00c6 \u00cd\u00b7\u00c7\u00bb\u00c6\u00c1\u00c7\u00bb\u00c6\u00b9\u00c6\u00b9\u00b4\u00c6\u00cd\u00b4\u00c7\u00bc\u00c8\u00b8\u00d7\u00ba\u00c6 \u00b7\u00c8\u00ce\u00be\u00ce\u00ba\u00ce\u00bb \u00b7\u00c8\u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00c8\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00cc\u00b2\u00b8\u00c9\u00c1\u00c7 \u00b1\u00ba\u00c1\u00c7\u00bb\u00ba\u00c6"
  },
