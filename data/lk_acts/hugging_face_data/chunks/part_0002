    "chunk_text": "\u201c\u00c0\u00d6\u00c0\u00e5\u00c8\u00e8\u00ba \u00a1\u00da\u00bb\u00cc\u00e5\u00bd\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 _\n\n(\u00a1)\u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00c8\u00e5\u00c3 \u00cd\u00e5 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c6\u008a \u00c8\u00e8\u008d\u00ba \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00e0\u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c8\u00e8\u008d\u00ba \u00be\u00f9\u00ba\u00e8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00d6\u00c0\u00e5\u00c8\u00e8\u00ba \u00ef\u00a8\u00e5\u00b4 \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be,\n\n\u201c\u00c9\u00e5\u00cc\u00e8\u00a8\u201d \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00e9 \u201c\u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c9\u00e5\u00cc\u00e8\u00a8\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 79 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00bc\u00fa\u00e2\u008e\u00c9 \u00cc\u00e8\u0090\u00be \u00c2\u00c9 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n3032006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba\n\n\u201c\u00cc\u00ea\u00db\u00a8\u00eb\u008a \u00c0\u00ba\u00e0 \u00cc\u00cd \u0097\u00be\u00f8\u00c4\u00c6 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00c9\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 1987 \u00a1\u00e2\u00a836 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00cc\u00cd \u0097\u00be\u00f8\u00c4\u00c6 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00cc\u00cd \u0097\u00be\u00f8\u00c4\u00c6\u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00c9 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00a8\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00be\u00b4 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00c6 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00c9\u00c8\u00b4 \u00ef\u00c2\u00bc\u00be\u00ea\u00c8\u00e6\u00c2\u00ea\u00c9 \u00bc \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec \u00bc, \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00ef\u00c6\u00cd\u00fa \u00ef\u00cd\u00e5\u00e0\u00c8\u00e5\u00c3\u00c9\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u00c4\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa\u00c8\u00e5\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c6\u008a \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ef\u00c6\u00a8\u00e0\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ;\n\n\u201c\u00ef\u00a8\u00e5\u00b4\u00cc\u201d \u00c6\u00be\u00e0\u00be\u00b4, \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00ef\u00c6\u00cd\u00fa \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e5\u00c3\u00c9\u00c8 \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u00c4\u00cd\u00fa \u00c6\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ;\n\n\u201c\u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, 28 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00be\u00ea\u00c9\u00a1\u00e5\u00aa\u00b8\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00c3\u00c9\u00c6\u00a8\u00f8\u00be\u00e0 \u00c8\u00e6\u00c2\u00ea\u00b8\u00ea \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, 33 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00cd\u00fa\u0095\u00a8\u008a \u00c8\u00c2\u00be \u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00c8 \u00cc\u00c4\u00cc\u00e0\u00ba\u00c6 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00e8 \u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u008a\u00ef\u00ca\u00e0\u00cb\u00c6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00ef\u00c9\u00ef\u00ce\u00bc\u00e5\u00c4\u201d \u00c6\u00be\u00e0\u00be\u00b4, \u00cc\u00e7\u00c4 \u00ef\u00c9\u00ef\u00ce\u00bc\u00e5\u00c4\u00a8\u00e0 \u00cd\u00e5 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00e0 \u00bc \u00ef\u00c9\u00ef\u00ce\u00bf\u00cc\u00e0\u00c9\u00e5\u00c3\u00e5\u00c9\u00c6 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00e7\u00c4 \u00c0\u00f2\u00c6\u00ba\u00e0\u00be\u00c6\u00a8\u00e0 \u00cd\u00e5 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00bc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00ef\u008c ;\n\n\u201c\u00ef\u00bc\u00e0\u00c0\u00ce \u00c0\u00e6\u00c9\u00d7\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c6\u008a \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0, \u00cc\u00c4\u00da\u00c0\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0,\u00ef\u00c9\u00be\u00e0\u00a8\u00c7 \u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00e0, \u00be\u00f8\u00c7\u00c9\u00ea\u00c8\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0, \u00c3\u00e5\u00c7\u00bc\u00fb\u00c4\u00a8\u00e0, \u00ef\u00aa\u00d1\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00be\u00e0\u00bc\u00c4\u00a8\u00f8\u00be\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00a1\u00be\u00e0\u00cc\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be \u00a1\u00ba\u00c7_\n\n(\u00a1) \u00ef\u00bc\u00e0\u00c0\u00ce \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00f8\u00d7\u00c4 ; \u00cc\u00cd\n\n(\u00a1\u00e5) \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00c8\u00a8 \u00c6\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0\u00a1\u00e6\u00ba\u00f8 \u00a8\u00f8\u00d7\u00c4 \u00bc ;\n\n\u00a6\u00c6\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ;\n\n\u201c\u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00be\u00b4, \u00c6\u008a \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u00ef\u00c9\u00a8\u00e0, \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8\u00ef\u00c6\u00a8\u00e0, \u00ef\u00bc\u00e0\u00c0\u00ce\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8\u00ef\u00c6\u00a8\u00e0, \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00e6\u00ef\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00c8\u00a8 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6, \u00c0\u00e5\u00c8\u00be\u00c6 \u00ef\u00cd\u00e5\u00e0\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00cc\u00ba\u00eb\u00c9 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00bc ; \u00c6\u008a\u00a6\u00e0\u00a8\u00a8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00c7\u00be \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a6\u00e0 \u00a6\u00e0\u00a8\u00a8\u00c3\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00ba\u00e0\u00a8\u00c7\u00be \u00c8\u00bc \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00bc,\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00be \u00be\u00c4\u00ea\u00ba\u00e0, \u00ef\u00c0\u00e5\u00c8\u00e0\u00c4\u00e3\u00a8\u00c7\u00e6\u00ef\u00c9\u00a8\u00e0 \u00a3\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00be\u00e5\u00ef\u008c ;\n\n3042006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba\n\n\u201c\u00a6\u00e0\u00a8\u00a8 \u00c3\u00e5\u00c7\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00cc\u00cd \u0097\u00be\u00f8\u00c4\u00c6 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0\u00cc\u00c3\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0\u00a8\u00a8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00ef\u00bc\u00be \u00c8\u00bc\u00c6\u008a \u00a6\u00e0\u00a8\u00a8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c;"
