u00af\u00c6\u00af\u00c7\u00af \u201c\u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8\u00c1\u00bc\u00e2\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00be\u00c6\u00be\u00ce\u00ba\u00b9\u00c6\u00da 26 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00b6) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00bb\u00c7\u00be\u00c6 \u00a3\u00b6\u00bd\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00d7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00cd\u00b6 \u00af\u00dd\u00b6\u00c6\u00ce\u00b6\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 ;\n\n(\u00a5) \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\u00cc\u00b9\u00c7\u00d7\u00b7\u00be\u00c1\u00c7\u00bb \u00b7\u00c7\u00d5\u00af\u00bf\u00c8\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c6\u00da\u00be\u00b6\u00c6\u00b6\u00c8\u0081\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c6\u00da\u00be\u00b6\u00c6\u00b6\u00c8\u0081 \u00c1\u00dd\u00ba\u00c7\u00b8 \u00c1\u00bc\u00c8 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00c8\u008a\u00b8\u00c7\u00be\u00c6\u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8 \u00c1\u00bc\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00b7\u00c8\u00c1\u00c7\u00bc\u00b5\u00ba\u00c6 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00ce\u00b8 \u00a5\u00bb\u00be\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00b8\u00cc\u00b6\u00b8 \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6\u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u00bb\u00c7\u00b8\u00c1\u00bc\u00c6\u00af\u00dd\u00b6\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00ad\u00bc\u00c6 \u00a3\u00bf\u00e2\u00af\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00d7\u00b7\u00be\u00c1\u00c7\u00bb \u00b7\u00c7\u00d5\u00af\u00bf\u00c8\u0081 \u00a4\u00bf\u00c6\u00da\u00be\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00d0 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a6) \u00a5\u00bc\u00b4\u00c6\u0088\u00b9\u00c6\u00da \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0089\u008b\u00dd\u00b7\u00c6\u00d7 \u00b7\u00c8\u00c1\u00c7\u00bc\u00b5\u00ba\u00c6 \u00c1\u00c0+\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00a7\u00b4\u0081\u00b9\u0088\u00af\u00c6\u00ce\u00af \u00cc\u00b1\u00bb\u00c6\u00d7 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00b8\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c7\u00b4\u00c6\u0088\u0081 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00d0\"\n\n\u00cc\u00b6\u00bc\u00c8\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c7\u00ba\u00c6\u00b0 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a4\u00ce\u00b5\u00bb\u00c7\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u00bb\u00c7\u00b8\u00c1\u00bc\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00c9\u00c0\u00c7\u00b8 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c8\u00be\u00c6\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00c9\u00c0\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00c7\u00be\u00c6\u00b7\u00c8\u00dd\u00c1\u00af\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00c7\u00b8 \u00cd\u00c1\u00de \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00c9\u00c0\u00c6 \u00a3\u00c1\u00dd\u00af\u00c6\u00d0\u00af\u00c6\u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de\u00c1\u00ce\u00af\u008a\u00be\u00c6 \u00a3\u00c1\u00bc\u00d7 \u00a7\u00b4\u00ce\u00ba\u008a\u00df\u00bf\u00c6\u00bf\u00b6\u00c7\u00b8 \u008c\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u0088\u00df\u00bf\u00c6\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00c1\u00b5\u00b6\u00c6\u00b6\u00c8\u00df\u00bf\u00c6\u00bf\u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u008c\u00c1\u00bc+\u00c6\u00af\u00bf\u00c8\u00b8\u00d7 \u00b1\u00bc\u00c8\u00bb\u00c7\u00b8 \u00ac\u00dd \u0089\u00bc\u00b6\u00c8 \u00a9\u00b8 \u00a3\u00c1\u00bc\u00c7\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00c6 \u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6 \u00b1\u00c7\u0081\u00de\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u008c\u00c1\u00bc+\u00c6\u00af\u00bf\u00c8\u0081 \u00a7\u00ae\u00ce\u00ba\u00b9\u00c6 \u0089\u00bc\u00b6\u00c8\u00ce\u00bb \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00c9\u00c0\u00c7\u00b8 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c8\u00be\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00af\u00c7\u00ae\u0089\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00c7\u00ae\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00be\u00c7\u00ba\u00c6\u00b0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af \u0089\u00bc\u00b6\u00c8\u00bb\u00c7\u0