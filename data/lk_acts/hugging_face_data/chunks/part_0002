    "chunk_text": "\u00a7\u00ef\u0089 \u00c3\u00e5\u00c7\u00a8\u00e5\u00c7\u00ba\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u00a7\u00cd\u00ea/\u00a1\u00e6\u00c6 \u00a2\u00c9\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00c2\u00c8\u00c6 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8.................................(\u00c2\u00c8\u00c6\u00c8\u00ba\u00e0 \u00cc\u00e4\u00a8\u00e0\u00cb\u00b8 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00be\u00c4) \u00c6\u00be \u00a1\u00c6\u00b4 \u00ef\u00be\u00e5\u00c0\u00c4\u00e5\u00c9 \u00a6\u00a8\u00f9\u00ce\u00c4\u00c6\u00e5\u00ef\u00aa\u00e0/\u00ef\u00c6\u00f0\u00c9\u00be\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c3\u00e5\u00c7\u00a8\u00e5\u00c7\u00ba\u00e0\u00c9\u00c6 \u00c0\u00c9\u00c7\u00be \u00ef\u00c8\u00cc\u00b4 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n\u00bc\u00fa\u00be\u00c6 :\u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00ba\u00e0\u00cc\u00be \u00cc\u00cd \u00c4\u00ea\u00f7\u00e5\u00c9.\n\n2005 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00cc\u00ea\u00be\u00e5\u0095 (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba30"
