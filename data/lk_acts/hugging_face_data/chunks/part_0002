    "chunk_text": "(v)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c9\u00e5\u00cc\u00c6 \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c6\u00a8\u00eb\u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec\u00bc, \u00a6\u00a8\u00e0\u00cc\u00ba\u00e0 \u00b0\u00e5\u00ba\u00f9\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 \u00c6\u008a\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 ;\n\n(vi)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4 \u00c0\u00e8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00ad\u00ba\u00e0\u00c9\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00cc\u00e8\u0090\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00ef\u00be\u00e5\u00c9\u00be \u00ef\u00c9\u00be\u00ba\u00e0\u00c7\u00b4\u00a8 \u00be\u00e5\u00c9\u00ea\u00a8, \u00c6\u00ea\u00bc\u00e0\u00bd \u00ef\u00cd\u00e5\u00e0 \u00aa\u00eb\u00c9\u00be\u00e0 \u00cd\u00c4\u00ea\u00bc\u00e5\u00c9\u00a8\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 ;\n\n(viii)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c6\u00a8\u00eb \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec\u00bc \u00a1\u00e5\u00cc\u00e8\u00c6\u00e5 \u00c0\u00bc\u00be\u00c4\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00b0\u00c0\u00e5\u00be\u00ef\u00c6\u00e0 \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00cc\u00cd\u00ef\u00c6\u00e5\u00e0\u00aa\u00fa\u00ba\u00e5\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00a8\u00e5\u00da\u0095\u00a8 \u00cc\u00cd\u00ef\u00c6\u00e5\u00e0\u00aa\u00fa\u00ba\u00e5\u00c9\u00cc\u00c8\u00cc\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00a6\u00cd\u00fa \u00c9\u00e6\u00b6\u00cc\u00b4\u00cd\u00be\u00a8 \u00bc\u00fb \u00ef\u00c0\u00e5\u00f3\u00c7\u00e5\u00b0\u00f1\u00c4\u00b8\u00e0\u00b6\u00c8\u00e9\u00c6 \u00ef\u00c8\u00e0\u00a8\u008a \u00a8\u00e5\u00da\u00c6\u00e5\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c0\u00e5\u00f3 \u00c7\u00e5\u00b0\u00f1\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00cd\u00fa \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00e0 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec\u00bc \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 :\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba22\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9\u00bc, (i) \u00c9\u00be, (ii) \u00c9\u00be, (iii) \u00c9\u00be, (iv) \u00c9\u00be,\u00ef\u00cd\u00e5\u00e0 (v) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c9\u00c8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c\u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c8\u00c2\u00e5\u00aa\u00be\u00ea \u00c8\u00c2\u00be\u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00bc\u00e0\u00bc\u00b4 \u00c6\u00b4\u00ba\u00e0\u00d1\u00c4, \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c2\u00bc\u00e0\u00bc\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9\u00be\u00e0\u00be\u00e5\u00a8\u00e0 \u00ef\u00c4\u00be\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(\u00a3)\u00a6\u00a8\u00e0\u00cc\u00ba\u00e0 \u00b0\u00e5\u00ba\u00f9\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0\u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00a8\u00eb, \u00a8\u00e5\u00da\u0095\u00a8\u00ca\u00fa\u00c8\u00e0\u00c0\u00e8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00e0 \u00be\u00e8\u00c6\u00ea\u00a8\u00e0\u00ba \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00be\u00f8\u00c8 \u00c0\u0091 \u00be\u0091 ;\n\n(\u00a4)\u00ef\u00c8\u00e5\u00e0\u00a8 \u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6, \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00c9\u00e5\u00d6\u00c4\u00e5\u00da\u00aa\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6, \u00ef\u00a8\u00e5\u00ce\u00c5 \u00a8\u00f2\u00c4\u00c6 \u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00c6,\u00a1\u00e5\u00cc\u00e8\u00c6\u00e5\u00be\u00ea \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9, \u00ef\u00c8\u00e5\u00e0\u00a8 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9, \u00c7\u00ba\u00eb\u00a8\u00eb\u00c7\u00e6\u00cc \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0\u00a1\u00be\u00e0\u00ba\u00da \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a8\u0095\u00b4\u00ea\u00c9, \u00ef\u00c8\u00e5\u00e0\u00a8 \u00cc\u00e2\u00c7\u00a8\u00e0\u00cb\u00b8 \u00cc\u00e2\u00aa\u00c4\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00ea\u00ef\u00c7\u00e5\u00e0\u00c0\u00e9\u00c6\u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00e0 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00be\u00f8\u00c8 \u00c0\u0091 \u00be\u0091 ;\n\n(\u00a4\u00f0)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c6\u00a8\u00eb \u00ef\u00be\u00e5\u00c9\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4, \u00c7\u00e5\u00b0\u00a8\u00e5\u00d6\u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9\u00b4 \u00c0\u00e6\u0095\u00b8\u00e9\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00b4\u00c7\u00b4 \u00c9\u00ec \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00be\u00f8\u00c9\u00cc\u00b4 \u00c6\u00e7\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c6\u00e7\u00ef\u008a\u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c9\u00ea\u00c9\u00bc \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00ef\u00cc\u00e0\u00c9\u00c6 \u00a1\u00c9\u00cc\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u008a\u00bc\u00fb \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00a1\u00e5\u00c0\u00cc\u00ea\u00c6\u00e7\u00c4\u00b4 \u00cd\u00e6\u00a8\u00f8\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00bc\u00be \u00c8\u00bc \u00c6\u008a \u00aa\u00c4\u00be\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0\u00c6\u00e5\u00be \u00c0\u00ba\u00f2\u00c6\u00a8 \u00c9\u0090\u00be\u00e5\u00a8\u00c4, \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9\u00b4 \u00c0\u00e6\u0095\u00b8\u00e9\u00c4\u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00c3\u00e5\u00da\u00c6\u00e5\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ea\u00ba\u00f2\u00c6\u00a8\u00eb\u00b4, \u00f3\u00c9\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0\u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00ef\u00aa\u00e0 \u00c0\u00e8\u00b4\u00c7\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00be\u00f8\u00c9\u00cc\u00b4 \u00c6\u00e5\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00ef\u00cc\u00e0\u00c9\u00c6 \u00a1\u00c9\u00cc\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u008a\u00bc\u00fb \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0\u00a1\u00e5\u00c0\u00cc\u00ea \u00c6\u00e7\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00bc\u00be \u00c8\u00bc \u00c6\u008a \u00aa\u00c4\u00be\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00e5\u00be\u00c0\u00ba\u00f2\u00c6\u00a8 \u00c9\u0090\u00be\u00e5\u00a8\u00c4 ;\n\n(\u00a6)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00aa\u00c4\u00be\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0,\u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00e5\u00b4 \u00aa\u00c4\u00be\u00e0, \u00c6\u00e6\u00c0\u00e9\u008a\u00ef\u00cd\u00e5\u00e0 \u00c8\u00e6\u00aa\u00eb\u008a \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00a8\u00e0 ;"
