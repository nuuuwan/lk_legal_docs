    "chunk_text": "(\u00ab) \u008c\u00dd\u00b7\u00c6\u00cd\u00b6\u00c7\u00ba\u00c6\u00b9\u00be\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00d7\u00ce\u00bd \u00a7\u00b4\u00c6\u00b9\u00b4 \u00cd\u00b9\u00c7\u00b6\u00c8\u00bb\u00b6\u00c7\u00b8\u00af\u00c1\u00bc\u00c6\u00b1\u00c6\u00b1\u00c8\u00af\u00bc\u00ba\u00c7\u00b8 \u008c\u00ce\u00b8\u00b6\u00c6\u00b6\u00c8\u00bd\u00ce\u00ba\u00bb\u00c7\u00b8 \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6\u00b9\u00bb\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd\u00b1\u00c6 \u00cd\u00b1\u00ce\u00c1\u00af\u00ce\u00bf \u00b7\u00c8\u00ce\u00be\u00cd\u00b9\u00bd\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd\u00db\u00ce\u00bd\u008a\u00be\u00c6 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00cc\u00b1\u00bb\u00c6\u00b6\u00df\u00ba\u00c6\" \u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00df\u00ba\u00c6 ;\u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00ac) \u00b9\u00b5\u00c8\u00bb\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00ce\u00bf \u00a9\u00bb\u00c6\u00d7\u00c1\u00b6\u0081 \u00a5\u00ce\u00b4\u00cd\u00b7\u00bc\u00c6\u008c\u00ce\u00bf\u00c1\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0 \u00a7\u00af\u00b7\u00c6\u00b6\u00b8\u00c1\u00c7\u00b8\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a9\u00be\u00c6\u00be\u00c7\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00af\u00c7\u00bc\u00c8\u00bb+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00cc\u00bd+\u00c6\u00cd\u00af\u00d9\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0\n\n(2) \u0089\u0081\u00c1\u00dd\u00cd\u00c1\u00c7\u00bc\u00c6 \u00db\u00af\u00c7\u00ce\u00ba\u00b1\u00c6 \u00b1\u00ce\u00b9\u008a\u0081 \u00cc\u00b9\u00bb\u00bc\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00bf\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\u2013\n\n(i) \u00b9\u00ae\u00b4\u00c7\u00bc\u00b7\u00c7\u00bb\u00af\u00c6\u00af\u00c7 \u00b3\u00c7\u00b9\u00af\u00c7\u00bc\u00c6\u00b6\u00c6\u00b6 \u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1 \u00ba\u00c7\u00b7\u00c7\u00b4\u00c6\u00d5\u00ba\u00ae\u00b4\u00b9\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7\u00ba\u00c6 \u00af\u00ae\u00af\u00c7\u00b4\u00c6\u00b1\u00c8 \u00b7\u00c8\u00ce\u00be\u00bb\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7\u00ba\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00d7 \u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8 ;\n\n(ii) \u00a5\u00be+\u00c6\u00ce\u00af \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6\u00b9\u00bb\u00b5 \u00cd\u00c4\u00c7\u00b4\u00c6\u00b4\u00be\u00c6\u00af\u00bf\u00c6 \u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00b6\u00ce\u00be\u00c1\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00d7 \u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8 ;\n\n(iii) \u00a5\u00be+\u00c6\u00ce\u00af \u00a7\u00bf\u00c6\u00c1\u00dd\u00ce\u00af\u00b1\u00c6 \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6 \u00b9\u00bb\u00b5\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b7\u00bc\u00c6\u00af\u00bf\u00c6 \u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00c1\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00d7\u00ce\u00b5\u00b6\u00c6\u00b6\u00ce\u00be\u00c1\u00bc\u00c6 ;\n\n\u00b1\u00ba\u00c1\u00c7\u00bb\u00b9\u00c6\u00b9\u00b5\u00c8\u00bb\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00db\u00af\u00c7\u00ce\u00ba\u00b1\u00c6\u00b1\u00ce\u00b9\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 38 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6\u00b9\u00bb\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c644\n\n(iv) \u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da \u00ba\u00c7\u00b7\u00af\u00bc\u00b1\u00c6 \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6\u00b9\u00bb\u00b5 \u00cd\u00c4\u00c7\u00b4\u00c6\u00b4\u00be\u00c6\u00af\u00bf\u00c6\u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00c1\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00d7 \u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8 ;\n\n(v) \u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bd\u00c8\u008c\u00bb\u00be\u00c6 \u00db\u0081\u00cd\u00b8\u00bd\u00c6\u00bd\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b8 \u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00cc\u00b9\u00c7\u00d7\u00b6\u00c6\u00b6\u00ce\u00be\u00c1\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00d7\u00ce\u00b5\u00b6\u00c6\u00b6\u00ce\u00be\u00c1\u00bc\u00c6 ;\n\n(vi) \u00a5\u00be+\u00c6\u00ce\u00af \u00a7\u00bb\u00bc\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00b1\u00c7\u00bc\u00c6 \u00af\u00c0\u00af+\u00c6\u00af\u00bf\u00c8\u0081 \u00ac\u00e1+\u00c6\u00af\u00ce\u00ba\u00b9\u00c6\u0089\u00b8\u00d7 \u00b6\u00ce\u00be\u00c1\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00d7\u00ce\u00b5\u00b6\u00c6\u00b6\u00ce\u00be\u00c1\u00bc\u00c6 ;\n\n(vii) \u00a5\u00be+\u00c6\u00ce\u00af \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00af\" \u00ce\u00af\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6 \u00e7\u00b4\u00c6\u00b4+\u00c6\u00af\u00bf\u00c8\u0081\u00b1\u00ba\u00c6\u00cd\u00ba\u00bf\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7 \u00b6\u00ce\u00be\u00c1\u00bc\u00c6 ;\n\n(viii) \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6\u00b9\u00bb\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u008a\u0081 \u00b7\u00c8\u00b6\u00c8\u00bb\u00ce\u00ba\u00b1\u00c6\u00ce\u00b1\u00b9\u00c6 \u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c6\u00d7\u00c1\u00ba\u00c6 \u00c1\u00af\u00c8\u00af\u00c6\u00af\u00c8\u0081\u00bd \u00a4\u00bf\u00c6 ;\n\n(ix) 10 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6 \u00b9\u00bb\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u008a\u0081 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 ;\n\n(x) \u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00be+\u00c6\u00ce\u00af \u008c\u00ba\u00c7\u00b8\u00b1\u00c6 \u00cd\u00b1\u00ce\u00c1\u00af\u00bf\u00c8\u0081\u00db\u00af\u00c7\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b9\u00bb\u00bc\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00be+\u00c6\u00ce\u00af \u008c\u00ba\u00c7\u00b8\u00b1\u00c6 \u00cd\u00b1\u00ce\u00c1\u00af\u00bf\u00c8\u0081\u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00bd\u00df\u00c1\u00be\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b1\u00c8\u00cd\u00bc\u0082\u00b4 \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00bd\u00df\u00c1\u00be\u00bc\u00c6 \u00b9\u00b6\u008c\u00c1\u00bc\u00c8\u00ce\u00b1\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6 \u00b9\u00b6\u008c\u008a\u00df\u00bf\u00c6\u00bf \u00a3\u00df\u00c1\u00be\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(xi) \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6\u00b9\u00bb\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd \u00a9\u0081\u00d9\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00af\u00e2\u00bf\u00c6\u00bf \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c8\u0081 \u00b7\u00c8\u00bb\u00ba\u00b6\u00c6\u00b6\u00bc\u00c6\u00af\u00bf\u00c6\u00a5\u00dd\u00c1\u00bc\u00c6 ; \u00a3\u00c1\u00bc\u00c6\u00af\u00e0\u00bf\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 \u00a3\u00c1\u00c6\u00c1\u00ce\u00ba\u00b1\u00c6\u00b1\u00c8\u0081 \u00a3\u00df\u00c1\u00be\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c7\u00af\u008c\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00b9\u00b5\u00c8\u00bb\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u008c\u00b1\u00c7\u00bf\u00bc\u00c6\" (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00ce\u00b9\u00dc\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00bf\u00c7\u00af\u00e2\u00bf\u00c6\u00bf \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u00ce\u00b4\u00cd\u00bb\u008a\u00dd\u00b7\u00c6\u00d7\u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6\u00b9\u00bb\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd \u00a9\u0081\u00d9\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00af\u00e2\u00bf\u00c6\u00bf \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b9\u00bb\u00bc\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00b6\u008c\u00b1\u00c7\u00bf\u00bc\u00c6 \u00f2\u0081\u00bd\u00c7\u00ae\u00d5\u00af\u00c6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00cc\u00bb\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u008c \u00c1\u00af\u00c8\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 38 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6\u00b9\u00bb\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c645"
