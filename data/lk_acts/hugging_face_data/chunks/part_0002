    "chunk_text": "\u00c1\u00bf\u00e2\u00af\u00bf\u00c6\u0089\u00bf\u00c6\u00ce\u00bf\u00b6\u00c6\u00d7\u0082\u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00c1\u00ce\u00b6\u00b9\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00a3\u00bd\u00c8\u008c\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00af\u00b4\u00ce\u00ba\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c65\n\n5\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 345 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00c1\u00c7\u00b8\u00d7 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n\u201c\u008c\u00bf\u00af\u00c6\u00af\u00ba\u00c6 2 : \u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u00b6\u00c7\u00af\u00c6\u00d0\u00b6\u00be\u00c6 \u00a9\u0081\u00b9\u00d7\" 363 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\u00af\u00bd\u00c6\u00b9\u00c0\u00c8\u00b9\u00c6\u00da \u00a3\u00be\u00c6\u00be\u00d7 365\u00a4 \u00a9\u0081\u00d9\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b9\u00c7\u00bc\u00d7{\u00bc\u00ba\u00c7\u00b8 \u00b9\u00c7\u008b\u00bb\u00be\u00c6\u00d7\u0082\u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00ba\u00c6 \u00a9\u00b8\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b6\u00c6\u00b6\u00af\u00c6\u00af\u00b6\u00be\u00c6\u00be\u00c7\u00b6 \u00cc\u00b1\u00bb\u00be\u00c6 \u00a9\u00b6\u00ce\u00b8\u00dc\u00ba\u00c6\u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\u201d ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(2) \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u008c\u00bf\u00af\u00c6\u00af\u00ba\u00c6 2 \u00a5\u00ce\u00b8 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6\u008c\u00bf\u00af\u00c6\u00af\u00b6\u00c6\u00ce\u00b6\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c\u008c\u00bf\u00af\u00c6\u00af\u00ba\u00c6 3 : \u201c\u00a8\u00de\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7 \u00a7\u00bf\u008c\u00bb\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00ba\u00b8\u00af\u00c6\u00af\u00c8\u00cd\u00be\u00b1\u00b6\u00c6\u00ce\u00b6 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6\u00b0\u201d\u00b0\n\n6\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 350 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2\u00af\u00c6\u00d0 \u00a7\u00b4\u0081\u00cd\u00ba\u00cd\u00be \u00af\u00c7\u00b5\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b6\u00ce\u00be\u00bb+\u00c6\u00af\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b7\u00c9\u00af\u00c6\u00af\u00b3\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u00b6\u00ce\u00be\u00bb+\u00c6\u00af\u00ba\u00c6 \u00a5\u00b4\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n\u201c\u00a4\u00b4\u00c6\u00af\u00c1\u00bc\u00c6\u00b6\u00be\u00c6\" \u00a4\u00b4\u00c6\u00af\u00b4\u00b6\u00c6\u00b6\u00be\u00c6 \u00a3\u0088\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1\u00ba\u00c6 \u00db\u00b6\u008b\u00bb\u00b8\u201d\n\n7\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 358 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u0089\u00bc\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7\u00a9\u0081\u00b9\u00d7\u00b4\u0081\" \u00a3\u00d7 \u00a3\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u0089\u00bc\u00c8\u00e2 358\u00a3 \u00a9\u0081\u00bd\u00c7\u00bd\u00c6\u00cd\u00b9\u00c7\u0081\u00de \u00b9\u00bb\u00d9\u00de\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\u2013\n\n358\u00a3\u00b0 (1) (\u00a3)\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00ce\u00bf \u00b6\u00b8\u00c8\u00d2\u00b6\u00c6\u00b6\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u0089\u00b5\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00d0\u00a7\u00b4\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7\u00a7\u00b4\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u008c\u00af\u00c6\u00af\u00c8\u0081\u00bd ;\n\n(\u00a4)\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00ce\u00bf \u00c1\u00cd\u00be\u00c7\u00bd\u00c6\u00af\u00c7\u00bc\u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00b4\u00c6\u00b4\u00c7\u00bb \u00a8\u00c0\u00c8\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00b4\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7\u00a7\u00b4\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u008c\u00af\u00c6\u00af\u00c8\u0081\u00bd ;\n\n\u201c\u00a4\u00b4\u00c6\u00af\u00b4\u00b6\u00c6\u00b6\u00df\u00ba\u00c6\u00af\u00b4\u00b6\u00c6\u00b6\u00c8\u00b1\u00c6\u00cc\u00b1\u00be\u00c6\u00df\u00ba\u00c6\u201d\u00a9\u0081\u00d9\u00ba\u00c6\u00b6\u00ce\u00be\u00bb+\u00c6\u00af\u00b6\u00c6\u00ce\u00b6\u00ba\u00c7\u00bd\u00c6\u00bd\u00c9\u00d5 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081358\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6\u00da\u00b6\u00c8\u00bb \u0089\u00bc\u00c8\u00ce\u00c1\u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u201c\u00b6\u00b8\u00c8\u00d2\u00b6\u00c6\u00b6\u00ce\u00bf\"\u0089\u00b5\u00c8\u00b9\u00c6\u00da\"\u00c1\u00cd\u00be\u00c7\u00bd\u00c6\u00af\u00c7\u00bc\u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00b4\u00c6\u00b4\u00c7\u00bb\u00a8\u00c0\u00c8\u00bb\u00ba\u00c6\"\u00a3\u0088\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1\u00ba\u00c6\u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u00a4\u00dc\u00b6\u00b7\u00c6\u00b6\u00c7+\u00c6\u00af\u00c8\u00bb\u00cd\u00b9\u00c7\u00bc\u00c7\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00af \u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00bf\u00c8\u0081\u00a4\u00b4\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u00b4\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081345 \u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u00ce\u00b8\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c66\n\n(\u00a5)\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00ce\u00bf \u00a3\u0088\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1\u00b6\u00c6\u00d7\u00af\u00c6\u00d0 \u00a7\u00b4\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00b4\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u008c\u00af\u00c6\u00af\u00c8\u0081\u00bd ;\u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a6)\u00ac\u00dd \u0089\u00bf\u00c6\u00ce\u00bf\u00ce\u00bb \u00a4\u00dc\u00b6\u00b7\u00c6\u00b6\u00c7+\u00c6\u00af\u00c8\u00bb\u00cd\u00b9\u00c7\u00bc\u00c7\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a6\u00d5\u00b9\u00d5\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c8\u00be\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00a4\u00b4\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00af\u00c8\u0081\u00bd\"\n\n\u00a4\u00cc\u00bf\u00c1\u00dd\u00ba\u00c6 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c6\u00bd\u00c1\u00c7\u00bf\u00c8\u00bb\u00c7\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0"
