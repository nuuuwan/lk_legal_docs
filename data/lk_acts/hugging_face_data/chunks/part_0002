    "chunk_text": "(\u00a1)\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u009e\u00c9\u00c7 \u00cc\u00cd \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5 \u00a8\u00e0\u00ef\u00cb\u00e0\u00ba\u00f2\u00c6, \u0097\u00bc\u00f1\u00e5\u00cc\u00cd \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00c6, \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba, \u00ef\u00c9\u00ef\u00ce\u00bf \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb,\u00c4\u00ea\u00bc\u00c8\u00e0, \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f9\u00ba\u00f8\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00ea\u00dd\u00c8\u00e0\u00c0\u00ce\u00c0\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc\u00a8\u00e0 \u00cc\u00cd \u00cd\u00e6\u00a8\u00f8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00ef\u00c0\u00be\u00e0\u00be\u00e5 \u00a1\u00e6\u00ba\u00f8\u00a1\u00c9\u00e2\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00a1\u00ba\u00eb\u00d6\u00be\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00c0\u00ba\u00e0\u00a8\u00ce\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be)\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00e6\u00be\u00e0 \u00c0\u00cc\u00e0 \u00ef\u00bc\u00ef\u00be\u00a8\u00e0; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00c0\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00be\u00f8\u00c8 \u00c2\u00c8\u00ef\u00c6\u00be\u00e0 \u00c0\u00ba\u00e0\u00c9\u00be\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00e6:\u2013\n\n(i)\u009e\u00c9\u00c7 \u00cc\u00cd \u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 3\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n1998 \u00a1\u00e2\u00a8 53 \u00bc\u00c7\u00be\u00c0\u00be\u00ef\u00ba\u00e0 \u00bc\u00fb\u00da\u00ab \u00be\u00e5\u00c4\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u201c\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6.\n\n(ii)1957 \u00a1\u00e2\u00a8 49 \u00bc\u00c7\u00be \u00c7\u00e5\u00b0\u00f1 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00c8\u00e2\u00a8\u00e5\u009e\u00c9\u00c7 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5;\n\n(iii)1981 \u00a1\u00e2\u00a8 54 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0\u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cd\u00e5 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00e5\u00c6\u00ba\u00be \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00c8\u00bc \u00b0\u00e5\u00ba\u00f8\u00a8 \u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0 \u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cd\u00e5\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00be\u00e8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00c0\u00e5\u00c8\u00a8\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00c3\u00e5\u00c0\u00ba\u00e8\u00c9\u00c7\u00c6\u00e5;\n\n(iv)\u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00cb\u00c6\u00c6\u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0, \u00a6\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb;\n\n(v)\u00c9\u00e5\u00d6\u00c4\u00e5\u00da\u00aa \u0097\u00cb\u00c6\u00c6\u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0, \u00a6\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb;\n\n(vi)\u00c4\u00cd\u00c9\u00e6\u00c8\u00e8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0, \u00a6\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb;\n\n(vii)\u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0, \u00a6\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb; \u00cc\u00cd\n\n(viii) \u00c0\u00e5\u00d6\u00cc\u00d6\u00a8 \u00cc\u00cd \u00cc\u00e0\u00c9\u00c3\u00e5\u0097\u00a8 \u00cc\u008a\u00c0\u00ba\u00e0 \u0097\u00cb\u00c6\u00c6\u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0,\u00a6\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb. \u201d.\n\n4.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 6 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a1\u00c9\u00cc\u00e5\u00be\u00c6\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00a1\u00f5\u00ba\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089:\u2013\n\n\u201c(4)\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00b4 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00db\u00cc\u00e0\u00d1\u008a\u00c9\u00c8\u00b4\u00c0\u00e6\u0095\u00b8 \u00cc\u00e8\u009b\u00c4\u00b4 \u00cc\u00cd \u00a6\u00c9\u00e6\u00be\u00f8 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8\u00e0 \u00a1\u00e6\u00c4\u00ba\u00f9\u00c4\u00b4\u00cd\u00fa\u0095\u00a8\u008a \u00ba\u00f8\u00ef\u00c2\u00be \u00be\u00c4\u00ea\u00ba\u00e0, \u00a6\u00c9\u00e6\u00be\u00f8 \u00db\u00cc\u00e0\u00d1\u008a\u00c9\u00c8 \u00bc\u00fb \u00af\u00be\u00e0\u00bc\u00c6\u00c0\u00e5\u0097\u0083\u008e \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4\u00a8\u00e0 \u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6. \u201d.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 6\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 23 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba3\n\n5.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 11 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089:\u2013\n\n(1) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00c6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2013\n\n\u201c(\u00a1)\u00c7\u00b4 \u00ba\u00eb\u00ce \u00c4\u00ba\u00e0\u00cc\u00f1 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00cc\u00cd \u00c4\u00ba\u00e0\u00cc\u00f1\u00c0\u00d6\u00ef\u00c3\u00e5\u00e0\u00b0\u00be\u00c6 \u00c9\u00e6\u0091 \u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00c7\u00c4\u00ea\u00b8\u00e8\u00be\u00e0, \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5\u00c9,\u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5 \u00ef\u00c4\u00ef\u00cd\u00c6\u00ea\u008a \u00cc\u00cd \u00be\u00f8\u00ba\u00f1 \u00cc\u00cd \u00a8\u00e5\u00c8\u00e9\u00be\u00b0\u00c8\u00e5\u00ca\u00c6\u00be\u00e0\u00cd\u00fa \u00c9\u00aa\u00e5\u00c9 \u00c0\u00bc\u00be\u008a \u00a8\u00c7\u00aa\u00ba\u00e0 \u009e\u00c9\u00c7\u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00c6 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4;\u201d ;"
