    "chunk_text": "185\u00b0 \u00b9\u00bb\u0081\u00cc\u00b9\u00de\u00b7\u00dd\u00af\u00c6\u00d0 \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u008b\u00dd\u00b7\u00c6\u00d7 \u00a7\u00bc\u00c8\u00b6\u00c6\u00d7\u00ce\u00b4\u00bb\u00b6\u00c7\u00b8 \u00a3\u00c1\u00bc\u00c8\u0081 \u00c1\u00dd\u00ba\u00c7\u00b8\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00e7\u00de\u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00c7\u00b6 \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00bd\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00b9\u00bb\u0081\u00cc\u00b9\u00de\u00b7\u00bc\u00c6 \u00cd\u00ba\u00be\u00c6 \u008c\u00b6\u00c8\u00af\u00c6\u00af\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00c7\u00af\u00b6\u00c6\u00ce\u00b6\" \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c8\u0081 \u00cd\u00ba\u00be\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00d5 \u00a9\u00d7\u00e2\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u008c\u00be\u00c6\u00ce\u00be \u00a9\u0081\u00b9\u00d7\u00a9\u00b9\u00c6\u00b9\u0088\u008a\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6\" \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u0081 \u00b7\u00ba\u00c6\u00b9\u00c8\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c8\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7 \u00a3\u00bd\u008c\u00b4\u00be\u00c7\u00ba\u00c6\u00b0 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00c1\u00bc\u00c8\u008a\u00ce\u00b8\u00cd\u00b1\u0