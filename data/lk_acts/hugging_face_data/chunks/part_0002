v) 1990 \u00a1\u00e2\u00a8 18 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b8\u00c6 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6\u00a8\u00e5\u00da\u00f1\u00e5\u00e2\u00ca\u00c6 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b8\u00c6\u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 ;\n\n(xlvi) (439 \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00c7\u00c2\u00da \u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00a1\u00e5\u00b3\u00e5 \u00c0\u00be\u00ba\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00c7\u00c2\u00da \u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 ;\n\n(xlvii) 1990 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00c2\u00ea\u00bc\u00e0\u00bd \u00ca\u00e5\u00cc\u00be \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00c0\u00be\u00ba\u00f8\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00c2\u00ea\u00bc\u00e0\u00bd \u00ca\u00e5\u00cc\u00be \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 ;\n\n(xlviii) 1988 \u00a1\u00e2\u00a8 77 \u00bc\u00c7\u00be \u00ef\u00d9. \u00a1\u00e5\u00da. \u00b0\u00c6\u00c9\u00da\u00bd\u00be \u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ef\u00d9. \u00a1\u00e5\u00da. \u00b0\u00c6\u00c9\u00da\u00bd\u00be\u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00ef\u00c6\u00e0 ;\n\n(xlix) 1981 \u00a1\u00e2\u00a8 3 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a \u00cd\u00e5 \u00f7\u00c9\u00f1\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc\u00ca