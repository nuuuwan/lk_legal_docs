    "chunk_text": "1971 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 4 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00c1\u00c7\u00af\u00b8+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00af\u00ba\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00a7\u00b9\u00af\u00bc\u00b5+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cd\u00b6\u00ce\u00c1\u00af\u00c6\u00cc\u00af\u00d5\u00b6\u00c6\u00b6\u00be\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n1992 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 59\u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u008c\u00be+\u00c6\u00d0\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\u00b0\n\n1986 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 15\u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u008c\u00be+\u00c6\u00d0 \u00a7\u00b5\u00e2\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n1969 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 19\u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a3\u00d6\u00b1\u00af\u00c6\u00b6\u00c8 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00aa\u00be\u00b6\u00c7\u00bc\u00bc\u00c6\u00af\u00e0\u00ba\u00c6 \u00b6\u00bc\u00af\u00bc\u00c6\u00af\u00e0\u00ba\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 (\u00a3\u00b6\u00c6\u00b6\u00c8\u00b0 109)\n\n\u201c\u00a4\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00a4\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6 \u00cc\u00b6\u00c7\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00b8\u00b6\u00c7\u00b8 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00c1\u00ce\u00bc \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00d8{\u00de \u00f4\u00b9\u00c7 \u00c1\u00ce\u00bc \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00a5\u00dd\u00d8{\u00de \u00f4\u00b9\u00c7\u00c1\u00ce\u00bc \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00ab\u00b7\u00c6\u00d8{\u00de \u00f4\u00b9\u00c7\u00c1\u00ce\u00bc \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00ab\u00b7\u00c6\u00d8{\u00de \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00a9\u00e1\u00d8{\u00bd\u00c6\u00ce\u00bd\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00a4\u008a\u00bc\u00b6\u00c6\u00d7\u00ab\u00b7\u00c6\u00d8{\u00de \u00f4\u00b9\u00c7 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00a4\u008a\u00bc\u00b6\u00c6\u00d7 \u00ab\u00b7\u00c6\u00d8{\u00de \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6 \u00cc\u00b6\u00c7\u00ce\u00af\u008a\u00b8\u00b6\u00c7\u00b8 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00d8{\u00de \u00f4\u00b9\u00c7\u00c1\u00ce\u00bc \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00a5\u00dd\u00d8{\u00bd\u00c6\u00de \u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00c1\u00ce\u00bc \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00ab\u00b7\u00c6\u00d8{\u00de \u00f4\u00b9\u00c7\u00c1\u00ce\u00bc \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00a9\u00e1\u00d8{\u00bd\u00c6\u00bd\u00c8 \u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00c1\u00ce\u00bc \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00a9\u00e1\u00d8{\u00bd\u00c6\u00bd\u00c8 \u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5+\u00c6\u00af\u00bf\u00c8\u0081\u00a3\u00b6\u00c8\u00af\u00bc\u00c8\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c633\n\n\u00b7\u00c8\u00ce\u00bc I\u00b7\u00c8\u00ce\u00bc II\u00b7\u00c8\u00ce\u00bc III\u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\n\n\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00b9\u00c6\u00da\u00b6\u00bd\u00c6\u00cd\u00b9\u00c7\u00ce\u00b6\u00bb \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00bf\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00bf\u00c6\n\n1961 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 31 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a4\u00dc\u00bc\u00c6\u00cd\u00c1\u00b6\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\u00b0\n\n\u00b9\u00b4\u00d0\u00af\u00bf\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 (\u00a3\u00b6\u00c6\u00b6\u00c8\u00b0 198)\n\n\u00b6\u00c7\u00c1\u00bc\u008c\u00bb\u00be\u00c6 \u00b9[+\u00c6\u00af\u00c7 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6(\u00a3\u00b6\u00c6\u00b6\u00c8\u00b0 446)\n\n\u00b9\u00c7\u00ae \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\u00b0 (\u00a3\u00b6\u00c6\u00b6\u00c8\u00b0 217)\n\n1987 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 7 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b9\u00c6 \u00cc\u00b9\u00bb\u00bc\u00c6\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\u00b0\n\n1957 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 34\u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00b1\u00c9\u00b4\u00c6\u00d5\u00af\u00c6\u00af\u00bf\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 (\u00a3\u00b6\u00c6\u00b6\u00c8\u00b0 159)\n\n1988 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 64\u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00af\u00ce\u00b4\u00b1\u00c8\u00bb\u00c7\u00af\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 1971\u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 46\u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00cc\u00b6+\u00c6\u00d0 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n1967 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 17\u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00af\u00ce\u00b4\u00b1\u00c8\u00bb\u00c7\u00af\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b6+\u00c6\u00d0\u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6(\u00a3\u00b6\u00c6\u00b6\u00c8\u00b0 160)\n\n\u201c\u00a4\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00b9\u00b6\u00c6\u00d7 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6\u201d\n\n\u201c\u00a5\u00dd\u00b9\u00d7 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00a5\u00dd\u00b9\u00b6\u00c6\u00ce\u00b6\u00b7\u00c6\u00d7 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6\u201d\n\n\u201c\u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d\n\n\u201c\u00d8{\u00de \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6\u201d\n\n\u201c\u00d8{\u00bd\u00c6\u00bd\u00c8 \u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6\u201d\n\n\u201c\u00a5\u00dd\u00d8{\u00de \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6\u201d\n\n\u201c\u00a4\u008a\u00bc\u00b6\u00c6\u00d7 \u00ab\u00b7\u00c6\u00d8{\u00de \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u201d"
