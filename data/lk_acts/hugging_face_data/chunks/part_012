    "chunk_text": "(30 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec)\u00a1\u00cc\u00c3\u00f1 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba.\n\n1979 \u00a1\u00e2\u00a8 41 \u00bc\u00c7\u00be\u009f\u00c4\u00ba\u00e0\u00c9 \u00a8\u00c7\u00be \u00c8\u00bc \u00c9\u00e6\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf (\u0097\u00ef\u00ca\u00e0\u00cb\u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba.\n\n(222) \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6\u00c9\u00ec) \u00be\u00f8\u00ef\u00c7\u00e5\u00e0\u00bd\u00e5\u00c6\u00be \u00cc\u00cd\u00ef\u00c7\u00e5\u00e0\u00aa \u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba.\n\n2005 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00bc\u00b6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00e6\u0091\u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00be\u00ba21\n\nI \u00c9\u00be \u00ba\u00f9\u00c7\u00c6II \u00c9\u00be \u00ba\u00f9\u00c7\u00c6\n\n\u00c0\u00be\u00ef\u00ba\u00cd\u00fa \u00be\u00e5\u00c4\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\n\n2. 12 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00bc\u00cd\u00cc\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n3. 18 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a6\u00e0 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00c7\u00bc \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00cc\u00e9\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be\u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a6\u00e0 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00c7\u00bc \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5 \u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n4. 20 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00cc\u00e7\u00c4 \u00c2\u00b6\u00ea \u00ef\u00b4\u00e5\u00be\u00e0 \u00a6\u00a8\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c4\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4 \u00cc\u00cd \u00ef\u00b4\u00e5\u00be\u00e0\u00a6\u00a8\u00a8\u00b4 \u00a1\u00b6\u00ea \u00c6\u008a \u00c2\u00b6\u00ea \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u0097\u00cc\u00e0\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00cc\u00e7\u00c4 \u00c2\u00b6\u00ea \u00ef\u00b4\u00e5\u00be\u00e0 \u00a6\u00a8\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00ef\u00bc\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4 \u00cc\u00cd \u00ef\u00b4\u00e5\u00be\u00e0 \u00a6\u00a8\u00a8\u00b4 \u00a1\u00b6\u00ea \u00c6\u008a\u00c2\u00b6\u00ea \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4\u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ba\u00eb\u00be\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n5. 23 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00bc\u00cd\u00cc\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n6. 24 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1 ) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ba\u00eb\u00be\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be\u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n7. 24 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00c0\u00be\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be\u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n(200 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6\u00c9\u00ec) \u00f3\u008a\u00d6\u00c6 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n2005 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00bc\u00b6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00e6\u0091\u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00be\u00ba22\n\nI \u00c9\u00be \u00ba\u00f9\u00c7\u00c6II \u00c9\u00be \u00ba\u00f9\u00c7\u00c6\n\n\u00c0\u00be\u00ef\u00ba\u00cd\u00fa \u00be\u00e5\u00c4\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\n\n8. 25 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00bc\u00cd\u00cc\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n9. 26 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00ba\u00eb\u00be\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u201d \u00c6\u00be\u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0."
