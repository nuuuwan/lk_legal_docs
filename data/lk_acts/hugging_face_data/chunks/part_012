    "chunk_text": "\u201c(\u00a3)\u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00c9\u00da\u00cb\u00ef\u00c6\u00be\u00e0\u00a2\u00bc\u00fa\u00d6\u00c6\u00b4 \u00ef\u00aa\u00be \u00a6\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec \u00bc, \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a1\u00b6\u00ea \u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec \u00bc,\u00c6\u008a \u00c0\u00e5\u00b6\u00ea\u00c9\u00a8\u00e0 \u00cc\u00cd (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(\u00a1\u00a1\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 (ii)\n\n2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba28\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc\n\n(i) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 38\u00a1\u00e7 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0, \u00a1\u00c6\u00e8\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a\u00ef\u00cd\u00e5\u00e0 \u00a1\u0093\u00a8\u00e5\u00c7 \u00c0\u00ba\u00f2 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4 \u00c4\u00ba\u00cc\u00e8\u00f3 \u00c9\u00ec \u00a8\u00f8\u00cc\u00e8\u00c4 \u00c0\u00e5\u00b6\u00ea\u00c9\u00a8\u00e0 \u00ef\u008a \u00ef\u00d8\u00bc\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00b6\u00ea \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c0\u00e5\u00b6\u00ea\u00c9\u00a8\u00e0\u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(ii) \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4,\u00a6\u00c4 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c4\u00c7\u00b8\u00c6 \u00cc\u00e8\u00f3 \u00c9\u00ec\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00ef\u00c6\u00be\u00e0 \u00a7\u0089\u00c2\u00b4 \u00ef\u00cd\u00e5\u00e0\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0\n\n2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba29\n\n\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00a1\u00e7\u00c9\u00c7 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00e8\u00f3\u00ef\u00a8\u00c7\u00e6\u00be\u00ea \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00ef\u00c6\u00be\u00e0 \u00a7\u0089\u00c2\u00b4, \u00a6\u00c4 \u00c0\u00e5\u00b6\u00ea\u00c9\u00a2\u00bc\u00fa\u00d6\u00c6\u00b4 \u00ef\u00aa\u00be \u00c6\u00e5 \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(iii) \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00be\u00f8\u00cc\u00e8 \u00a1\u0093\u00a8\u00c7\u00b8 \u00c2\u00c8\u00c6\u00a1\u00e6\u00ba\u00f8 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c2\u00ea\u00be\u00e0\u00c9\u00ba\u00e0 \u00c2\u00c9\u00b4\u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00b4 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00ef\u00cd\u00e5\u00e0\u0097\u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8,\u00c2\u00e2\u00ef\u00a8\u00e5\u00ef\u00c8\u00e5\u00ba\u00e0\u00c3\u00e5\u00c9\u00c6\u00b4 \u00c0\u00ba\u00e0 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00c2\u00ea\u00be\u00e0\u00c9\u00ba\u00e0\u00c3\u00e5\u00c9\u00c6\u00b4 \u00c0\u00ba\u00e0 \u00c9\u00ec \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00cc\u00e8\u00f3 \u00c9\u00ec\u00a8\u00f8\u00cc\u00e8\u00c4 \u00c0\u00e5\u00b6\u00ea\u00c9\u00a8\u00e0 \u00a6\u00c4 \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00c0\u00cc\u00ea \u00a4\u00c0\u008e\u00ba\u00c9\u00be \u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u00c4\u00be\u00e0 \u00a1\u00b6\u00ea \u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(iv)\u00a1\u00be\u00e0\u00ba\u00f8\u00c4 \u00a8\u00e6\u00c4\u00ba\u00f8 \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00a1\u00be\u00e0\u00ba\u00f8\u00c4 \u00a8\u00e6\u00c4\u00ba\u00f8 \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00cc\u00e8\u00f3\u00c9\u00ec \u00a1\u00be\u00ea\u00c0\u00f2\u00e5\u00c0\u00e0\u00ba\u00f8\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00be\u00e5\u00c9\u00be\u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00a1\u00c6\u00fa\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00c9\u00be\u00cc\u00a8\u00e0 \u00cc\u00e8\u00f3\u00d1 \u00ba\u00f8\u00ef\u00c2\u00be \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00c7\u00be \u00c8\u00bc\u00c0\u00e5\u00b6\u00ea\u00c9\u00a8\u00e0, \u00a6\u00e0 \u00c0\u00e5\u00b6\u00ea\u00c9 \u00bc\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a6\u00c4\u00cc\u00c4\u00e5\u00aa\u00ef\u00c4\u00cd\u00fa, \u00ef\u00c9\u00ce\u00bf\u00e5\u00ef\u00c4\u00cd\u00fa \u00ef\u00cd\u00e5\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba \u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u00c4\u00be\u00e0\u00cd\u00e6\u00c7, \u00a1\u00b6\u00ea \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00ef\u008a \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00b6\u00ea \u00a8\u00e8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u00cd\u00fa\u0095\u00a8\u00c4 \u00a8\u00f8\u00c6\u00e5 \u00cc\u00e8\u0090\u00be \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u0081\u00be\u00e7\u00c4\u00ef\u008c\u00c8\u00e5\u00c9\u00a8 \u00bc\u00fb, \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00ce \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00ef\u00c6\u00be\u00e0 \u00ba\u00eb\u00ef\u00be\u00be\u00e0 \u00a6\u00a8\u00a8\u00b4 \u00c9\u00e6\u0091\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0, \u00a6\u00c4 \u00c0\u00e5\u00b6\u00ea\u00c9 \u0097\u00bf\u00fa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u0081\u00be\u00e7\u00c4 \u00ef\u008c\u00c8\u00e5\u00c9\u00a8 \u00bc\u00fb \u00ef\u00be\u00e5\u00bc\u00e6\u00c7\u00e7\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00ee\u00b0\u00ea\u00c9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00be\u00e5\u0095\u00a8\u00c6\u00a8\u00eb\u00c4\u00aa\u00fa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00a1\u00c6\u00fa\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u00ef\u00c9\u00be\u00cc\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00d1 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c8\u00cc\u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\u201d\n\n(4)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba30\n\n\u201c(2\u00a1) (2) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5), (\u00a1\u00e6), (\u00a1\u00e7) \u00cc\u00cd (\u00a2) \u00ef\u00d8\u00bc\u00c9\u00c8\u0097\u0093\u0097\u00bd\u00e5\u00be 2004 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\u201d;"
  },
