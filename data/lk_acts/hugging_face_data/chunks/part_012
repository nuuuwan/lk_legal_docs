    "chunk_text": "(ii)\u201c\u00a8\u00ee\u00cb\u00e8 \u00c0\u00e8\u00d6\u00cc\u00e6\u00a8\u00cc\u00ea\u008a\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00aa\u00e6\u00c5\u00ea\u00c7\u00e6 \u00c4\u00ea\u00cd\u00ea\u00ef\u00bc\u00e0\u00c4\u00cc\u00ea\u00be\u00e0 \u00a1\u00e6\u00c8\u00e0\u00c8\u00e9\u00c4 \u00a1\u00e6\u00ba\u00eb\u00f5 \u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00ef\u00cd\u00e5\u00e0 \u00c4\u00ba\u00e0\u00cc\u00f1 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00c0\u00e8\u00d6\u00cc\u00e6\u00a8\u00cc\u00ea\u008a \u00a8\u00f8\u00d7\u00c4 \u00a1\u00bc\u00cd\u00cc\u00e0\u00c9\u00be \u00be\u00c4\u00ea\u00ba\u00e0, \u0097\u00ca\u00e5\u00c8 \u00c0\u00f2\u00c4\u00e5\u00b8\u00ef\u00c6\u00be\u00e0 \u00a8\u00f5 \u00ef\u00ba\u00e0\u00cc\u00e6\u00a8\u00cc\u00ea\u008a \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00c4\u00ba\u00e0\u00c0\u00e6\u00be\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00a3\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00be\u00e5\u00ef\u008c ;\n\n(iv)\u201c\u00a4\u00bc\u00e0\u00ef\u00bc\u00e0\u00ca\u00e8\u00ba \u00a1\u00c0\u00be\u00c6\u00be\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 (\u00ef\u00ba\u00e5\u00aa\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00a8\u00f5 \u00ef\u00ba\u00e0, \u00ef\u00a8\u00f2\u00e0\u00c0\u00e0 \u00c7\u00c2\u00da, \u00cb\u00e9 \u00c7\u00c2\u00da,\u00cc\u00e0\u00a8\u00f2\u00e6\u00c0\u00e0 \u00c7\u00c2\u00da, \u00c7\u00c2\u00da \u00a8\u00f8\u00d6 \u00cc\u00cd \u00a1\u00f5\u00ba\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00cd\u00e6\u00c7)\u00c6\u008a \u00ef\u00c9\u00ce\u00bf \u00f7\u00c9\u00f1 \u00c9\u00e6\u0091\u00c4\u00be\u00ba\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00f8\u00d7\u00c4\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e7\u00bc\u00fb\u00c4\u00a8\u00f8\u00be\u00e0 \u00ef\u00ba\u00e5\u00c7\u00c9 \u00c6\u008a \u00a1\u00c0\u00be\u00c6\u00be\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00b4 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e5\u00bc\u00e5\n\n2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba10\n\n\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4, \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00cc\u00e5\u008a\u00c0\u00f2\u00bc\u00e5\u00c6\u00fa\u00a8 \u00ef\u00be\u00e5\u00c9\u00be \u00c6\u008a\u00c3\u00e5\u00b8\u00e0\u00b6\u00c6\u00a8\u00e0 \u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c0\u00bc\u00d1\u00c4,\u00cc\u00e7\u00bc\u00fb\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00cc\u00e8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c0\u00bc\u00d1\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e7\u00bc\u00fb\u00c4\u00cc\u00cd \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\u201d\n\n10.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 21\u00a1\u00e7 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8\u00cd\u00e5 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8 \u00ef\u00c6\u00ef\u00bc\u00be \u00be\u00c9 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cd\u00e5 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8 \u00c0\u00c4\u00b8\u00a8\u00e0\u00ef\u00c6\u00ef\u00bc\u00be \u00be\u00c9 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c6\u00bc\u00fb\u00ef\u00c4\u00be\u00e0\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n11.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 21 \u00a2 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00cc\u00cd \u00a6\u00e0\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00cc\u00c7 \u00ba\u00eb\u00be\u00a8\u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u2014\n\n(\u00a1)\u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c8\u00e5\u00c3 \u00a2\u00c0\u00c6\u00fb\u00c4\u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00c7\u00be \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00c9\u00e5\u00b8\u00e8\u00b0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00ce \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00aa\u00b8\u00be\u00e0 \u00c2\u00c8\u00be\u00ea \u00c8\u00c2\u00be\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ef\u00bc\u00a8\u00a8\u00b4 \u00c9\u00b6\u00e5 \u00c0\u00cc\u00ea \u00ef\u00be\u00e5\u00c9\u00ec \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00c6\u00a8 \u00cc\u00e8\u00b4,\n\n\u00c6\u00be \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a6\u00ce\u00ef\u00c5\u00be \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00aa\u00b8\u00be\u00e0\u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d.\n\n(2)\u201c\u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u201d \u00c6\u00be \u00ef\u00c6\u00f3\u00ef\u008a \u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00c6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00da\u00bb \u00a8\u00bb\u00be\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c \u201c\u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0\u2014\n\n(i)\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6, \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 ;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e021\u00a1\u00e7 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e021 \u00a2 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba11\n\n(ii)\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00c6\u00a8\u00eb \u00cc\u00c4\u00ad\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00c0\u00be\u00cc\u00e0 \u00a6\u00a8\u00a8\u00b4\u00a1\u00b6\u00ea \u00ef\u00be\u00e5\u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6\u00a8\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 ; \u00ef\u00cd\u00e5\u00e0\n\n(iii)\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c4\u00e5\u00da\u00aa\u00c6 \u00cd\u00e6\u00c7 (\u00c9\u00ba\u00e0\u00a8\u008a, \u00c9\u00aa\u00a8\u00f9\u008a, \u00cc\u00cd\u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00a8\u00c6\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9) \u00a7\u00c0\u00e0\u00c0\u00ea\u00c9\u00a8\u00e0\u00c4\u00e5\u00da\u00aa\u00ef\u00c6\u00be\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00c4,\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\u201d."
