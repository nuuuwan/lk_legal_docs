    "chunk_text": "(3) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00c6\u008a \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00bc\u00fa\u00be\u00c6\u00a8 \u00bc, \u00a6\u00e0 \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c4 \u00c9\u00ec \u00bc\u00fa\u00be\u00c6\u00a8 \u00cc\u00e8\u00b4 \u00a6\u00c6\u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6\u00c6\u00fa \u00a6\u00cd\u00fa \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba\u00c9 \u00c4 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a, \u00a6\u00ef\u00cc\u00e0\u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00a6\u00c6 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00ec \u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n8.\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0, \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0, \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00cd\u00fa \u00a4\u008e\u00ba \u00ba\u00f9\u00c7\u00c9\u00c8\u00b4 \u00c6\u008a \u00a8\u00b4\u00c6\u00ea\u00ba\u00e0\u00ba\u00a8\u00e0 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u00cc\u00cd\u2014\n\n(\u00a1)\u00a6\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00e0\u00ba \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00cc\u00e8\u00c6\u00f5\u00c4 \u00a4\u00c0\u00d6\u00c4 \u00cc\u00e9\u00c4\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0\u00c6\u008a \u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0 ;\n\n\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u00bc\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9 \u00cc\u00ba\u00eb\u00c2\u00c8\u00c6.\n\n\u00a8\u00c8\u00e8\u00be\u00e0 \u00c2\u00c8\u00c6 \u00ef\u00bc\u00be\u00ea\u00c8\u00e6\u00c2\u00ec\u0097\u00c6\u00bc\u008a \u00cc\u00e9\u00c4\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u00cc\u00ba\u00eb\u00c2\u00c8\u00c6.\n\n2004 \u00a1\u00e2\u00a8 15 \u00bc\u00c7\u00be \u0097\u00cc\u00da\u00b0\u00be \u00c0\u00be\u00ba5\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00e0\u00ba \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00a1\u00c9\u00c4 \u00cc\u00e9\u00c4\u00e5\u00c9,\n\n\u00cc\u00bf\u00cd\u00e5 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00e6\u00c8\u00cc\u00e9\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n9. \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cd\u00e5 \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 , \u00a6\u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n62004 \u00a1\u00e2\u00a8 15 \u00bc\u00c7\u00be \u0097\u00cc\u00da\u00b0\u00be \u00c0\u00be\u00ba\n\n\u00ca\u00fb\u00da\u00cb\u00c0\u00ea\u00be\u00c7\u00e5\u00c9\u00da\u00ba\u00be\u00c4\u00ec\u00c8\u00bd\u00be\u00a1\u00e2\u00a8\u00c6\u0097\u00c6\u00bc\u008a\u0097\u00c6\u00bc\u008a\u00c7\u00e6.\u00c7\u00e6.\n\n\u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\n\u00ef\u00c0\u00e5\u00f3 \u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c4\u00ea\u00bc\u00c8\u00e0\n\n\u00ca\u00fb\u00da\u00cb\u00c0\u00ea\u00be\u00c7\u00e5\u00c9\u00da\u00ba\u00be\u00c4\u00ec\u00c8\u00bd\u00be\u00a1\u00e2\u00a8\u00c6\u0097\u00c6\u00bc\u008a\u0097\u00c6\u00bc\u008a\u00c7\u00e6.\u00c7\u00e6.\n\n\u00ca\u00fb\u00da\u00cb 101 - 122,703 \u00cc\u00cd 813\n\n\u00c0\u00ea\u00be\u00c7\u00e5\u00c9\u00da\u00ba\u00be224,90,14,000\u00c4\u00ec\u00c8\u00bd\u00be102,67,58,000\n\n\u00c0\u00cd\u00ba \u00c0\u00d6\u00bc\u00fa \u0097\u00c6\u00bc\u008a \u00cc\u00e6\u00a8\u00cc\u00e9 \u00a1\u00e6\u00ba :-\n\n\u00ca\u00fb\u00da\u00cb 101\u00a1\u00ba\u00f8\u00aa\u00c7\u00e6 \u00b0\u00be\u00e5\u0093\u00c0\u00ba\u00f8\u00c9\u00e6\u00b6 \u00cc\u00b4\u00cd\u00be 01 \u00cc\u00e5\u00c4\u00e5\u00be\u00f1 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00c656,38,38,0009,37,60,000\u00c9\u00e6\u00b6 \u00cc\u00b4\u00cd\u00be 16 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c62,76,40,0002,00,00,000\u00c9\u00e6\u00b6 \u00cc\u00b4\u00cd\u00be 56 \u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cd\u00e5 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb (\u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00c9)_20,00,00,000\n\n\u00ca\u00e9\u00da\u00cb 102\u00a1\u00aa\u00f2\u00e5\u00c4\u00e5\u00ba\u00f1 \u00a8\u00e5\u00da\u00c6\u00e5\u00c8\u00c6\u00c9\u00e6\u00b6 \u00cc\u00b4\u00cd\u00be 01 \u00cc\u00e5\u00c4\u00e5\u00be