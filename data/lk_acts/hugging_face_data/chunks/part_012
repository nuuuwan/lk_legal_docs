    "chunk_text": "(4) \u00a6\u00cd\u00fa II\u00a1 \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 (x) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4, \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(xi) \u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8 \u009f\u00b0, \u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8 \u00c0\u00e6\u00c8, \u00a2\u00cc\u00e0\u00cc\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5\u00a1\u00e5\u00cd\u00e5\u00c7 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00a8\u00ed\u00b8\u00e8\u00cc\u00e0\u00cc\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00e5\u00cd\u00e5\u00c7 \u00cc\u00cd \u00a8\u00eb\u00a8\u00eb\u00dd\u00a1\u00e5\u00cd\u00e5\u00c7 \u00cd\u00e6\u00c7 \u00cc\u00ba\u00e0\u00c9 \u00a1\u00e5\u00cd\u00e5\u00c7 ;\u201d\n\n(6) \u00a6\u00cd\u00fa II (\u00a1\u00e5) \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 (iii) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00e0 \u201c\u0097\u00f3\u00c8\u00e8 \u00c2\u00c8\u00c6\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4,\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u0097\u00f3\u00c8\u00e8 \u00c2\u00c8\u00c6 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00cc\u00cd \u00b0\u00c8\u0097\u00f3\u00c8\u00e8 \u00c2\u00c8\u00c6 \u00cd\u00e5 \u00ba\u00e5\u00c0 \u00c2\u00c8\u00c6 \u00ef\u00be\u00e5\u00c9\u00be \u0097\u00a8\u00c8\u00e0\u00c0 \u00c4\u00aa\u00fa\u00be\u00e0 \u0097\u00f3\u00c8\u00e8 \u00c2\u00c8\u00c6\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00c0\u00ce\u00c4\u00ea\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2005 \u00a1\u00e2\u00a8 6 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb\u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba10\n\n(7) \u00a6\u00cd\u00fa II (\u00a1\u00e6) \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 (viii)\u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(ix) \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0095\u00c8\u00e8\u00c6\u00be \u00a6\u00a8 \u00cc\u00e8\u00c6\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00a8\u00e0 \u00c2\u00c9\u00b4 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00ce \u00c6\u008a \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5, \u00a6\u00c6 \u00a1\u00e5\u00c7\u008a\u00c3\u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00e8\u00b4 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ba\u00eb\u00be\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb, \u00a6\u00e0\u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00b4 \u00be\u00e6\u00e2\u00d1\u00ef\u008a \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00c0\u00ce \u00a8\u00c7\u00be \u00a1\u00a8\u00e5\u00da\u00c6\u00c8\u00e6\u00c6\u00fa\u00cc\u00e0\u00ba\u00eb\u00ef\u008c \u00c3\u00e5\u00b8\u00e0\u00b6 \u00ef\u00be\u00e5\u00c9\u00be \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u0093\u00ba\u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00c3\u00e5\u00b8\u00e0\u00b6 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00ef\u00a8\u00be \u00c3\u00e5\u00b8\u00e0\u00b6,\u00a6\u00e0 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00c9\u00ec \u00c0\u00cc\u00ea \u00a6\u00c4\u00aa\u00fa\u00be\u00e0 \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce\u00cd\u00e6\u00a8\u00f8\u00cc\u00e6\u00c0\u00c6\u00ea\u008a \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9, \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4. (2005.01.01 \u00bc\u00fa\u00be\u00cc\u00e8\u00b4 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0 \u00ef\u008c.)\n\n(x) 1996 \u00a1\u00e2\u00a8 33 \u00bc\u00c7\u00be \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00c0\u00be\u00ba\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00e8\u00cd\u00fa\u0090 \u00c6\u008a \u00a1\u00e6\u00ad\u00dd\u008a \u0095\u00c8 \u00bc\u00fb\u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00e5\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00d6\u00a8 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5\u00cc\u00c0\u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00e6\u00ad\u00dd\u008a \u00cc\u00e5\u008a\u00c0\u00c8, \u00a6\u00e0 \u00a1\u00c6\u00fa\u00ba\u00c4 \u0097\u00a8\u00eb\u00b8\u00be\u00ea\u00ef\u00be\u00e5\u00c8\u00c2\u00be \u00ba\u00e5\u00a8\u00e0 \u00a8\u00c8\u00e0 ;\u201d\n\n(8)\u00a6\u00cd\u00fa II (\u00a1\u00e7) \u00ef\u00a8\u00e5\u00b4\u00cc\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(\u00a2) \u0097\u00ef\u00bc\u00e0\u00ca \u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00ef\u00aa\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5, \u00ba\u00f9\u00c7\u00e6\u00c2\u00f3 \u00c7\u00cd\u00fa\u00ba\u00cc\u00e5\u00c0\u00e0\u00c0\u00ea\u00c9\u00c8\u00b4 \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00fa\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 ;\u201d.\n\n14.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00ef\u00c4\u00cd\u00fa\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00e0\u00c9\u00e5\u00a6\u00c4 \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ba\u00eb\u00be\u00e0\u00c9\u00be \u00cd\u00e5 \u00cd\u00ba\u00c7\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be \u00ef\u00c8\u00cc \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\u2014\n\n\u201c\u00ba\u00eb\u00be\u00e0\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6(2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\n\n\u00c4\u00ec\u00c8\u00e8\u00a8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\n\n\u00c0\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00f7\u00c9\u00f1 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 _\n\n(i)\u00cc\u00e9\u00be\u00f8 ;(ii)\u00c0\u00d6\u00c0\u00e0\u00c0\u00ea ;(iii)\u00a1\u00da\u00ba\u00e5\u00c0\u00c8\u00e0 ;(iv)\u00dd\u00e7\u00be\u00ea ;(v)\u00a8\u00c7\u00c9\u00c8 ;(vi)\u00ce\u00bc\u00c7\u00e6 \u00a8\u00f8\u00d6\u00c0\u00e8\u0090 \u00cd\u00e6\u00c7 \u00a8\u00f8\u00d6\u00c0\u00e8\u0090 ;(vii)\u0095\u00d6\u00cc\u00e0 ;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00b4\u00a1\u00f5\u00ba\u00f8\u00be\u00e0 \u00ba\u00eb\u00be\u00e0\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0 \u00cc\u00cd\u00cd\u00ba\u00c7\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n2005 \u00a1\u00e2\u00a8 6 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb\u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba11\n\n\u00ef\u008a \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (i) \u00cc\u00cd (ii) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c9\u00c8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00ef\u00cd\u00e5\u00e0\n\n\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4, 2004 \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u00c2\u00da 1 \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 2004 \u00ef\u00be\u00e5\u00c9\u00e6\u008a\u00c2\u00da 18 \u00bc\u00fa\u00be \u00bc\u00a8\u00e0\u00c9\u00e5, \u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00da\u00c6"
