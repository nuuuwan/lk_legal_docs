    "chunk_text": "(3) \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00a8\u00e0\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00e0\u00ef\u00ba\u00e0 1967 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00a2\u00be\u00e0\u00f3-\u00c8\u00e2\u00a8\u00e5 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4(\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a) \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00cd 1988 \u00a1\u00e2\u00a8 39 \u00bc\u00c7\u00be\u00a1\u00ef\u00bc\u00e0\u00ca\u00fa\u00a8\u00c6\u00be\u00e0\u00b4 \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba\u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00c0\u00c4\u00b8\u00a8\u00f8.\n\n5.\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00be\u00f9\u00ba\u00f8\u00c6\u00a8 \u00c0\u00b4\u00cd\u00e6\u00be\u00f8\u00c9 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9\u00bc, \u00a6\u00c4 \u00be\u00f9\u00ba\u00f8\u00c6 \u00a1\u00c3\u00e8\u00c2\u00c9\u00e5 \u00ef\u008a \u00c0\u00be\u00ba\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00cc\u00bf\u00cd\u00e5 \u00a2\u00c8\u00e0\u00f5\u008a\u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00be\u00ba \u00ef\u00c9\u00be\u00ba\u00e0 \u00be\u00f9\u00ba\u00f8\u00a1\u00c3\u00fa\u00c2\u00c9\u00e5\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n2003 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00a2\u00be\u00e0\u00bc\u00fa\u00c6\u00e5\u00be\u00ea \u00cc\u008a\u00c3\u00c9\u00c6\u00a8\u00e0 \u00cc\u00cd\u00fa\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba4\n\n6.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00cd\u00fa \u201c\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, 1967 \u00a1\u00e2\u00a8 14\u00bc\u00c7\u00be \u00a2\u00be\u00e0\u00f3 \u00c8\u00e2\u00a8\u00e5 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4 (\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a) \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ec, \u00a2\u00be\u00e0\u00bc\u00fa\u00c6\u00e5\u00be\u00ea \u00cc\u008a\u00c3\u00c9\u00c6\u00a8\u00e0 \u00cc\u00cd\u00fa\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n7.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u2018\u00a1\u2019 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\n(2 \u00c9\u00be \u00cc\u00cd 4 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8)\n\n2003 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00a2\u00be\u00e0\u00bc\u00fb\u00c6 \u00cc\u008a\u00c3\u00c9\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00be\u00e0\u00b4 \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6\u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba\n\n\u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00a8\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a2\u00c8\u00e0\u00f5\u008a \u00c0\u00ba\u00f2\u00c6\n\n1. \u00a1\u00c6\u00f3\u008a\u00a8\u00c7\u00e6 \u00c9\u00be*/ \u00c2\u00e5\u00c8\u00c9\u00c6\u00cc\u00e0\u00a8\u00e5\u00c7 \u00ce\u00c4\u00c6\u00a8\u00eb \u00c9\u00be \u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026 \u00ef\u00aa\u00e0\u00ef\u00bc\u00c4\u00e5\u00c0\u00e8\u00c6\u00a8\u00eb \u00c9\u00be*/ \u00c4\u00e5\u00ef\u00aa\u00e0*/ \u00a2\u00cd\u00ba \u00be\u008a \u00cc\u00bf\u00cd\u00be\u00e0 \u00c4\u00e5\u00ef\u00aa\u00e0 \u00ce\u00c4\u00c6\u00e5\u00ef\u00aa\u00e0* \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00a8\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a2\u00cd\u00ba \u00a8\u00f9 \u00c0\u00be\u00ef\u00ba\u00e0 4 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00a2\u00c8\u00e0\u00f5\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n2 \u00a2\u00cd\u00ba \u00a8\u00f9 \u00c0\u00be\u00ef\u00ba\u00e0 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9, \u00c4\u00c4*/\u00a2\u00cd\u00ba \u00be\u008a \u00cc\u00bf\u00cd\u00be\u00e0\u00c4\u00e5\u00ef\u00aa\u00e0 \u00ce\u00c4\u00c6\u00e5 *\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c6\u00a8\u00eb \u00c2\u00c9 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n3. \u00c4\u00b4*/ \u00c4\u00e5\u00ef\u00aa\u00e0 \u00ce\u00c4\u00c6\u00e5\u00b4* \u00a1\u00bc\u00e5\u00ce \u0097\u00cc\u00e0\u00ba\u00c7 \u00c4\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0\u00a8\u00c7\u0095.\n\n(\u00a1)\u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00be\u00c4 :\n\n(\u00a1\u00e5)\u00c8\u00e8\u00c0\u00e8\u00be\u00c6 :\n\n(\u00a1\u00e6)\u00cc\u00e0\u00ba\u00f2\u00e9 \u00c0\u00ea\u00c7\u00e6\u00cb \u00c3\u00e5\u00c9\u00c6 : \u00c0\u00ea\u00c7\u00e6\u00cb/\u00cc\u00e0\u00ba\u00f2\u00e9\n\n(\u00a1\u00e7)\u00a4\u00c0\u00be\u00e0 \u00bc\u00fa\u00be\u00c6 :\n\n(\u00a2)\u00a4\u00c0\u00be\u00e0 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6 :\n\n(\u00a3)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00bc\u00fb \u00a4\u00c0\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u00a4\u00c0\u00ba \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00ce \u00cc\u00e0\u00bb\u00e5\u00be\u00c6 :\n\n(\u00a4)\u00ef\u00bc\u00c4\u00e5\u00c0\u00e8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u0097\u00cc\u00e0\u00ba\u00c7 :\n\n\u00c0\u00e8\u00c6\u00e5\u00c4\u00c9\n\n\u00be\u00c4 :\u00be\u00c4 :\n\n\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n2003 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00a2\u00be\u00e0\u00bc\u00fa\u00c6\u00e5\u00be\u00ea \u00cc\u008a\u00c3\u00c9\u00c6\u00a8\u00e0 \u00cc\u00cd\u00fa\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba5\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c6\u00a8\u00eb \u00bc\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c6\u00a8\u00eb \u00bc\u00c6\u00be \u00c9\u00aa :\u00c6\u00be \u00c9\u00aa :\n\n\u00b0\u00e5. \u00cd\u00e6. \u00c0. \u00a1\u00e2\u00a8\u00c6 (\u00a1\u00e6\u00ba\u00e0\u00be\u008a) :\u00b0\u00e5.\u00cd\u00e6.\u00c0. \u00a1\u00e2\u00a8\u00c6 (\u00a1\u00e6\u00ba\u00e0\u00be\u008a) :\n\n\u00c0\u00bc\u00fa\u00e2\u008e \u00c8\u00e8\u00c0\u00e8\u00be\u00c6 :\u00c0\u00bc\u00fa\u00e2\u008e \u00c8\u00e8\u00c0\u00e8\u00be\u00c6 :\n\n\u00ef\u00c0\u00e5\u00f3 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be \u00c0\u00ba\u00f2\u00c6\n\n4. \u00c4\u00c4*/\u00a2\u00cd\u00ba \u00be\u00c4 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c4\u00e5\u00ef\u00aa\u00e0 \u00ce\u00c4\u00c6\u00e5 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c2\u00c9\u00ba\u00e0, \u00ef\u00c9\u00be\u00ba\u00e0\u00c7\u00b4\u00a8 \u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00be\u00e5\u00c9\u00be \u00c2\u00c9\u00ba\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00c7\u0095."
