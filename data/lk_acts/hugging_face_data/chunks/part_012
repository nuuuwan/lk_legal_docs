    "chunk_text": "(3)\u00a3\u00c1\u00c6\u00c1\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 (xxviii) \u00a9\u0081\u00d9\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u201c\u00d0\u00dd\u00b4\u00dd\u00af\u00c6\u00af\u00c7\u00b8 \u00cc\u00c1\u00ae \u0089\u00bc\u00ba\u00c6\u00da\u00af\u00bf\u00c6\" \u0089\u00cc\u00bd\u00bb\u00c6\u008b \u00b6\u00b4\u00c6\u00b4\u00b1\u00c6\u00d2\u00b9\u00c6\u00cc\u00b9\u00c7\u00bd\u00c8\u00af\u00bf\u00c6\" \u00a7\u00de\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00d0\u00dd\u00b4\u00dd\u00af\u00c6\u00af\u00c7\u00b8 \u00cc\u00c1\u00ae \u0089\u00bc\u00ba\u00c6\u00da\u00af\u00bf\u00c6\" \u0089\u00cc\u00bd\u00bb\u00c6\u008b\u00b6\u00b4\u00c6\u00b4\u00b1\u00c6\u00d2\u00b9\u00c6 \u00cc\u00b9\u00c7\u00bd\u00c8\u00af\u00bf\u00c6\" \u00a7\u00de\u00b9\u00c6\u00da\u00af\u00bf\u00c6\" \u0089\u00cc\u00bd\u00bb\u00c6\u008b \u00a9\u00e1\u00d7\u00af\u00b4\u00b6\u00c7\u00b1\u00c8\u00af\u00bf\u00c6\" \u0089\u00cc\u00bd\u00bb\u00c6\u008b \u00a9\u00e1\u00d7 \u00b9\u00be\u00ce\u00af\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 ;\n\n\u201c(xxxiii) 1980 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 27 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00ac\u00b9\u00c6\u00b9\u00ce\u00b8\u00b1\u00c6 \u00b1\u00c7\u00b6\u00b8+\u00c6\u00af\u00bf\u00c6\" \u00a7\u00b9\u00c7\u00bb+\u00c6\u00af\u00bf\u00c6\" \u00ac\u00bf\u00b4\u00b6+\u00c6\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ac\u00b9\u00c6\u00b9\u00ce\u00b8\u00b1\u00c6 \u00b1\u00c7\u00b6\u00b8+\u00c6\u00af\u00bf\u00c6\" \u00a7\u00b9\u00c7\u00bb+\u00c6\u00af\u00bf\u00c6\" \u00ac\u00bf\u00b4\u00b6+\u00c6\u00af\u00bf\u00c6\" \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00bb\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b4 \u00ba\u00dd\u00b7\u00c6\u00b6\u00c7\u00af\u00c6\u00af\u00be\u00c6 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00ac\u00bf\u00b4\u00b6+\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 (\u00ac\u00b9\u00c6\u00b9\u00ce\u00b8\u00b1\u00c6 \u00b1\u00c7\u00b6\u00b8+\u00c6\u00af\u00ce\u00bf\u00b6\u00c6 \u00b6\u008c\u00bc)\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c624\n\n\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00bf\u00b4\u00b6+\u00c6\u00af\u00bf\u00c8\u0081 \u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u0089\u00bd\u00c6\u00af\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00af\u00c6\u00af\u00c7\u00b8 \u00f2\u00be\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00c1\u00c0+\u00c6\u00af\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8 ;\u201d;\n\n(5)\u00a3\u00c1\u00c6\u00c1\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 (xxxvi) \u00a9\u0081\u00d9\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u201c\u00c1\u00c0+\u00c6\u00af\u00df\u00ba\u00c6 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8\u00dc\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00c1\u00c0+\u00c6\u00af\u00df\u00ba\u00c6 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8\u00dc\u00ba\u00c6,\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n(6)\u008c\u00b4\u00bb\u00ba\u00c6 (xxxvi) \u00a9\u0081\u00b9\u00b6\u00ce\u00b8 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6\u00da\u00b6\u00c8\u00bb \u008c\u00b4\u00bb\u00b6\u00c6\u00ce\u00b6\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c(xxxvii) \u00a3+\u00c6\u00af\u0096\u00b8\u00db\u00bd\u00c6\u00bd \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c8\u0081 \u00b9\u00c7\u00c1\u00ce\u00b8\u00af\u00c6\u00cc\u00af\u00b8 \u008c\u00cd\u00b1\u00b4\u00ba\u00c7\u00af \u00c1\u0088\u00c1\u00ce\u00ba\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00c1\u00c7\u00af\u00b8\u00ba\u00c6\" \u0089\u00bc\u00b6\u00c6\u00b6\u00c8\u00cd\u00bb\u00af\u00ba\u00c7\u00af \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00a3+\u00c6\u00af\u0096\u00b8\u00db\u00bd\u00c6\u00bd \u00a4\u00bf\u00c8\u0081 \u00b9\u00c7\u00c1\u00ce\u00b8\u00af\u00c6\u00af\u00c7\u00b8\u00d7\u00a9\u00b8 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c6 \u00b6\u00c8\u00dd\u00b9\u00c6\u00b6\u00c8\u00dc\u00de\u00c1\u00b6\u0081\u00cd\u00b9\u00bc\u00c8\u00be\u00c6\u00a3\u00c1\u00bc\u00c7\u00be\u00c6 \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00c1\u00c7\u00af\u00b8\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u0081 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8 ;\n\n(xxxviii) \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ba\u00dd\u00b6\u00c6\u00d7\u00c1 \u00a5\u00bb\u00b7\u00c6\u00b6\u00c8\u00bc\u00ba\u00c6\" \u00ba\u00dd\u00b6\u00c6\u00d7\u00c1\u00a7\u00b9\u00af\u00bc\u00b5\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00ad\u00bc\u00c6 \u00a3\u00ba\u00c6\u0089\u00bb[\u00be\u0081\u0083\u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u0088\u00df\u00bf\u00c6\u00bf \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00e1+\u00c6\u00af\u00ce\u00ba\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c8\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7 \u00a3\u0081\u00b9\u00bf\u00c8\u00b9\u00c6\u00b9\u00c7\u00d0\u00ba\u00c6 \u00a9\u00b8\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b9\u00c6\u00b6\u00c8\u00dc\u00de\u00c1\u00b6\u0081\u00cd\u00b9\u00bc\u00c8\u00be\u00c6\u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c7\u00be\u00c6 \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ac\u00e1+\u00c6\u00af\u00ce\u00ba\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ba\u00dd\u00b6\u00c6\u00d7\u00c1 \u00a5\u00bb\u00b7\u00c6\u00b6\u00c8\u00bc\u00b6\u00c6\u00b6\u00c8\u0081 \u00ba\u00dd\u00b6\u00c6\u00d7\u00c1 \u00a7\u00b9\u00af\u00bc\u00b5\u00b6\u00c6\u00b6\u00c8\u0081\u00a3\u00be\u00c6\u00be\u00d7 \u00ad\u00bc\u00c6 \u00a3\u00ba\u00c6\u0089\u00bb[\u00be\u0081\u00b1\u00c8\u0081 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8 ;\n\n(xxxix)\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b9\u008a\u00bd\u00c6\u00b1\u00c8\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b1\u00bb\u00be\u00c6\u00db\u00ce\u00bd\u00b9\u00c6\u00b9\u008a\u00bd\u00c6\u00b1\u00c8\u00ce\u00bb \u00c1\u00c0+\u00c6\u00d0\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00ba\u00c6\u00b7\u00c8\u00b6\u00c8\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00a7\u00b6\u008c\u00ce\u00bb \u00c1\u00c0+\u00c6\u00af\u00c8\u00dc\u00bf\u00c6\u00bf\u008c\u00b4\u00b6\u00c6\u00d7\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00ba\u00c8\u00b6\u00ba\u00c8\u00b3\u00c6\u00b1\u00c8\u00bb \u00b7\u00c8\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00cd\u00b9\u00b5\u00df\u00af\u00c6\u00af\u00c7\u00af \u00ba\u00c9\u00bf\u00c6 \u00db\u00b6\u0095\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c625"
