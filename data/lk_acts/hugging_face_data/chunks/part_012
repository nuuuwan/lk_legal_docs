    "chunk_text": "\u00ba\u00c9\u00bc, \u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00be\u00ef\u00c0\u00e0\u00a8\u00e0\u00cb\u00e8\u00ba \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00be\u00ea\u00aa\u00ba \u00a8\u00c7\u00e6\u00b8\u00ea \u00ef\u00cd\u00e0\u00ba\u00eb \u00ef\u00a8\u00e5\u00b4 \u00ef\u00aa\u00be\u00a2\u00cd\u00ba \u00a8\u00f9 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4 \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00c3\u00e5\u00c7\u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c9\u00aa\u00a8\u00f9\u008a \u00a2\u00b4\u00ea \u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ec\u00ef\u00cd\u00c6\u00fa\u00be\u00e0 \u00bc 1986 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be \u00a1\u00ef\u00bc\u00e0\u00ca\u00fa\u00a8\u00c6\u00be\u00e0\u00b4 \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00be\u00ba \u00cc\u00cd 1988 \u00a1\u00e2\u00a8 39 \u00bc\u00c7\u00be \u00a1\u00ef\u00bc\u00e0\u00ca\u00fa\u00a8\u00c6\u00be\u00e0\u00b4 \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00f8\u00d7\u00ef\u008a (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9 \u00bc,\u00a2\u00be\u00e0\u00bc\u00fa\u00c6\u00e5\u00be\u00ea \u00cc\u008a\u00c3\u00c9\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 5,06,000 \u00a8\u00f8\u00be\u00e0 \u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c6\u00b4\u00a2\u00be\u00e0\u00bc\u00fa\u00c6\u00e5\u00be\u00ea \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ec \u00a1\u00ba\u00c7 \u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c6\u00b4\u00a2\u00be\u00e0\u00bc\u00fa\u00c6\u00e5\u00be\u00ea \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00be\u00c4\u00ea\u00ba\u00e0 \u00bc\u00fa\u00aa\u00b4\u00c4 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00cd\u00fa\u00c0\u00bc\u00fa\u00e2\u008e\u00c9 \u00cc\u00e8\u0090\u00be \u00ef\u00cd\u00c6\u00fa\u00be\u00e0 \u00bc :\n\n\u00a6\u00c4 \u00be\u00f8\u00cc\u00e5 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c4\u00ef\u00cc\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n1.\u00ef\u008a \u00c0\u00be\u00ba 2003 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00a2\u00be\u00e0\u00bc\u00fa\u00c6\u00e5\u00be\u00ea \u00cc\u008a\u00c3\u00c9\u00c6\u00a8\u00e0 \u00cc\u00cd\u00fa\u00ba\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea\u00c8\u00e6\u00ef\u0089.\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6.\n\n2003 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00a2\u00be\u00e0\u00bc\u00fa\u00c6\u00e5\u00be\u00ea \u00cc\u008a\u00c3\u00c9\u00c6\u00a8\u00e0 \u00cc\u00cd\u00fa\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba2\n\n2.\u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00ef\u008a \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb-\n\n(\u00a1)1964 \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u00c2\u00da \u00c4\u00cc 30 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00cc\u00e0\u00bb\u00fc\u00c7\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00b4 \u00a1\u00e6\u00ba\u00f8 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)1964 \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u00c2\u00da \u00c4\u00cc 30 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00cc\u00e0\u00bb\u00fc\u00c7\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00be\u00e0 \u00c0\u00e6\u00c9\u00ba\u00a6\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00bc\u00e6\u00be\u00b4 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00ec \u00bc,\n\n\u00a2\u00be\u00e0\u00bc\u00fa\u00c6\u00e5\u00be\u00ea \u00cc\u008a\u00c3\u00c9\u00c6\u00a8\u00e0 \u00cc\u00cd\u00fa\u00ba \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4, \u00a6\u00c4 \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4\u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00c7, \u00be\u00e9\u00ba\u00f8\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c6\u00a8\u00eb\u00b4 \u00cd\u00fa\u0095\u00a8\u008a \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6\u008a\u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00cc\u00cd \u00c9\u00c7\u00c0\u00f2\u00cc\u00e5\u00bc\u00c9\u00c8\u00b4 \u00bc, \u00a6\u00c4 \u00cc\u00e8\u00c6\u00f5\u00c4 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00cc\u00cd\u00c9\u00c7\u00c0\u00f2\u00cc\u00e5\u00bc\u00c9\u00c8\u00b4 \u00a6\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00b4 \u00c4 \u00cc\u00cd \u00a6\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4 \u00c4 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00bc\u00cd\u00fa\u0095\u00a8\u008a \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9\u00bc, \u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00a2\u00be\u00e0\u00bc\u00fa\u00c6\u00e5\u00be\u00ea \u00aa\u00c4\u00be\u00e0\u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00c4\u00e5\u00be \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0 \u00bc\u00c7\u00be \u00cc\u00e0\u00bb\u00fc\u00c7 \u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00b4\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0, \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c\u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6 \u00cc\u00e0\u00ef\u008c\u0083\u00af\u00e5\u00ef\u00c9\u00be\u00e0\u00c4 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00ef\u0083\u00ba\u00be\u00e5\u00c9\u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u0095\u00be\u00e0, \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00cd\u00fa \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u0097\u00ef\u00ca\u00e0\u00cb \u00c0\u00f2\u00a8\u00e5\u00ca\u00be\u00a1\u00e5\u00a8\u00ee\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u00c9\u00ec \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00cc\u00cd \u00a6\u00c4 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00e8\u008d\u00ba\u00c9 \u00c0\u00e8\u00ce\u00e8\u00aa\u00be\u00ea\u00c8\u00e6\u009f\u00ef\u008a \u00bc\u00fb \u00c0\u00c4\u00b8\u00a8\u00e0 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n3.2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c3\u00e5\u00c9\u00c6\u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0\u00c4 \u2014"
