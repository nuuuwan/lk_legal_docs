    "chunk_text": "(2) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 III \u00a1 \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00bc\u00e5\u00ce\u00c9\u00be \u00c6\u008a \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00cd\u00e6\u00c7, 2003 \u00b0\u00ec\u00c8\u00e8 \u00c4\u00cc 1\u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3\u00c9 \u00ef\u008a \u00c0\u00be\u00ba \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c\u00c0\u00be\u00ba\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c4\u00e5\u00cc\u00ef\u00c6\u00e0 \u00a1\u00c9\u00cc\u00e5\u00be\u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00be \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00ef\u00aa\u00d1\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u00aa\u00d1\u00c4\u00b4\u00c6\u00b4\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4 \u00c4\u00ea\u00bc\u00c8 \u00c0\u00be\u00ba \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00c4\u00e5\u00cc\u00ef\u00c6\u00e0 \u00a1\u00c9\u00cc\u00e5\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00ef\u00aa\u00c9\u00be\u00ea\u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u00a7\u00cd\u00ea \u00a6\u00c4 \u00c4\u00ea\u00bc\u00c8 \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0\u00a6\u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00ef\u00aa\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c8\u00cc \u00cc\u00ce\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u00a6\u00c4 \u00c4\u00ea\u00bc\u00c8 \u00ef\u00aa\u00c9\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a, \u00a6\u00c4 \u00c4\u00ea\u00bc\u00c8, \u00a6\u00c4\u00ef\u00aa\u00d1\u00c4 \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c8\u00cc\u00cc\u00ce\u00a8\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a6\u00c4 \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4\u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00aa\u00d1\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00c8\u00cc \u00cc\u00ce\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d;\n\n18.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 83 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n\u201c(\u00a1) \u00a6\u00a8\u00c4 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00cc\u00c4\u00be\u00e0\u0097\u00ba \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0\u00a6\u00a8\u00c4 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00e6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00c4 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0\u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00cd\u00e5 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec\u00cc\u00c4\u00e5\u00aa\u008a \u00ef\u00bc\u00a8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u0091 \u00cc\u00e2\u00a9\u00f1\u00e5\u00c9\u00a8\u00e0 ; \u00ef\u00cd\u00e5\u00e0\u201d\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e083 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2004 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba16\n\n(2) \u201c\u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00cd\u00fa \u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00c6 \u00a1\u00aa\u00b4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(\u00a1\u00e6) \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00e5\u00ef\u00c6\u00e5\u00e0\u00aa\u00fa\u00a8 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00c9 \u00cc\u00c0\u00c6\u00be\u00e0\u00be\u00e5 \u00c9\u00ec\u00cc\u00cd \u2014\n\n(i) \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00c0\u00c6\u00be \u00cd\u00e5\u00a6\u00c4 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00c9 \u00cc\u00c0\u00c6\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00c2\u00c9\u00b4 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u0097\u00c4\u00cc\u00e5 \u00ba\u00ee\u00ba\u00f8\u00c6\u00fa\u00a8 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00cd\u00e5 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00ef\u008a \u0097\u00cb\u00c6 \u00c3\u00e5\u00c7\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc;\n\n(ii) \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00a6\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00be\u00e6\u00c9\u00ba \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc,\u00c6\u008a \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n19.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6, \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(\u00a1) \u201c\u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u201d \u00c6\u00be \u00ca\u00fb\u00da\u00cb\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201cI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n2002 \u00a1\u00ef\u00aa\u00e5\u00e0\u00cc\u00e0\u00ba\u00eb \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00e5\u00c7\u008a\u00c3\u00c9 2004\u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00be, \u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00cc\u00bf\u00cd\u00e5 \u2013\u201d\n\n(\u00a1\u00e5) \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00a1\u00c9\u00cc\u00e5\u00be\u00c6\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a6\u00a8\u00ba\u00eb\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n(1) \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (xi) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00cd\u00fa (\u00a6) \u00c9\u00be \u00ef\u00d8\u00bc\u00c6\u00b4\u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(\u00a6\u00e0) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fb \u00c9\u00e5\u00b8\u00e8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8 \u00c0\u00f2\u00ba\u00f8\u00c9\u00f1\u00ea\u00cd\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5\u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4\u00c6\u00a8\u00e0\u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00a6\u00c4 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00a1\u00a8\u00f2\u00e9\u00c6 \u00b8\u00c6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00c0\u00e6\u00c9\u00d7\u00c4 ;\u201d;"
