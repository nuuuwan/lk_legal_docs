    "chunk_text": "(iii) 2004 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00c0\u00cc\u00ea\u00c9 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c6\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00c8\u00f1 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00cc\u00e8\u00c6\u00f5 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb \u00c4\u00ba \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4\u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00c7 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6, \u00a6\u00a8\u00e0 \u00c4\u00e5\u00cc\u00c6\u00a8 \u00bc\u00fb \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00be\u00c9 \u00bc\u00cd\u00cc\u00a8\u00b4 \u00c9\u00b6\u00e5 \u00a1\u00b6\u00ea \u00ef\u00be\u00e5\u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c4\u00e5\u00cc\u00ef\u00bc\u00e5\u00ce\u00cd\u00a8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0 \u00ba\u00eb\u00ce \u00bc\u00fb \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00c8\u00a8\u00e0\u00cb \u00a1\u00b4 \u00bc\u00cd\u00cc\u00a8\u00b4\u00c9\u00b6\u00e5 \u00a1\u00b6\u00ea \u00ef\u00be\u00e5\u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8.\u201d\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0119 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0122\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n(2)\u00a6\u00c4 \u00a4\u00c0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c \u00a6\u00e0 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb\u00c9 \u00c4\u00ba \u00ef\u00aa\u00c9\u00be\u00ea\u00c8\u00c2\u00be\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00c9\u00c8 \u00cc\u00e8\u00b4 \u201c \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea \u00a8\u00c7 \u00aa\u00ba\u00c6\u00ea\u00ba\u00eb \u00c6 : \u00c6\u00be \u00c9\u00ae\u00be \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :-\n\n\u201c2003 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 31 \u00c9\u00be \u00bc\u00fa\u00be \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00a8\u00e5\u00c8 \u00cc\u00e9\u00c4\u00e5\u00c9\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a6\u00e0 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb\u00c9 \u00c4\u00ba \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00c7 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00c4\u00ea\u00c8\u00ea \u00ef\u00c0\u00e5\u00c8\u00e9 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00bc\u00cd\u00ef\u00c6\u00e0 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00a1\u00be\u00ea\u00c9\u00cc\u00cd 2004 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00e5\u00c7\u008a\u00c3\u00c9\u00be \u00c6\u008a \u00a8\u00e5\u00c8 \u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00c8\u00f1 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00cc\u00c4\u00aa \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be \u00cc\u00e8\u00c6\u00f5 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb \u00c4\u00ba\u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00c7 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c4\u00ea\u00f5 \u00ef\u00c0\u00e5\u00c8\u00e9 \u00c0\u00f2\u00c4\u00e5\u00b8\u00ef\u00c6\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00b4 \u00bc\u00cd\u00ef\u00c6\u00e0 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00a1\u00be\u00ea\u00c9 \u00ef\u008a \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea\u00a8\u00c7 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00ef\u008a \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00a8\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00c9\u00e6\u0091\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00cc\u00e2\u00a9\u00f1\u00e5\u00c9\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00ef\u00c8\u00cc \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb\u00c9\u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4 \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb\u00c4\u00ba \u00a7\u00cd\u00ea\u00b4 \u00cd\u00fa\u0095\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4 \u00a6\u00c4 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb \u00c4\u00ba \u00a4\u00c0\u00c6\u00e5\u00aa\u00ba\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6\u00b4 \u00c8\u00e6\u00ef\u00c2\u00be\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb \u00c4\u00ba \u00c8\u00e6\u00ef\u00c2\u00be\u00ef\u00c0\u00e5\u00c8\u00e8\u00c6\u00b4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00ef\u008a \u00c0\u00bc\u00be\u00c4 \u00c4\u00ba \u00c6\u008a\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb\u00b4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be \u00c8\u00bc \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb \u00c4\u00ba \u00c9\u00ec \u00c6\u008a\u00ef\u00c0\u00e5\u00c8\u00e8\u00c6\u00a8\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00be\u00e6\u00c9\u00ba \u00c9\u00c7\u00a8\u00e0\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb\u00b4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5 \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00c6\u008a\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd\u00c9 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00a8\u00b8\u00e0\u00b6\u00e5\u00c6\u00c4\u00a8\u00e0\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c6\u008a \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb, \u00ef\u00bc\u00e0\u00c0\u00ce \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0\u00ef\u00c0\u00e5\u00c8\u00e0\u00c4\u00e3\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb, \u00a1\u00bc\u00e0\u0095\u00be\u00f8\u00cc\u00e0\u00ba\u00f2\u00e5\u00cc\u00e8\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb, \u00a1\u00e5\u00ef\u008c\u00a8\u00e0\u00cb\u00a8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0\u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cd\u00e5 \u00cc\u00c4\u00e5\u00be \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00a8 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00c4\u00ba\u00c9\u00ec \u00c6\u008a \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u008a \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00c8\u00cc\u00e5\u00a1\u00e6\u00ba\u00f8 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00b4 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\u201d.\n\n39.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 122\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6, \u00a6\u00cd\u00fa (2) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00ef\u00d8\u00bc\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00ef\u0089 :-"
