    "chunk_text": "(\u00a1) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u201c\u00c0\u00d7\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a2\u00b6\u00bc\u00fb\u00c4 \u00c6\u008a \u00af\u00be\u00e0\u00bc\u00bc\u00e5\u00c6\u00a8\u00c6\u00a8\u00eb \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0\u00a8\u00ce\u00ef\u00cd\u00e5\u00ba\u00e0 ; \u00ef\u00cd\u00e5\u00e0 \u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c \u00c0\u00d7\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4\u00a2\u00b6\u00bc\u00fb\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00c8\u00e2\u00aa\u00eb \u00a1\u00be\u00be\u00f1\u00ba\u00e5 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a2\u00b6\u00bc\u00fb\u00c4\u00c6\u008a \u00af\u00be\u00e0\u00bc\u00bc\u00e5\u00c6\u00a8\u00c6\u00a8\u00eb \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00ce\u00ef\u00cd\u00e5\u00ba\u00e0 ; \u00ef\u00cd\u00e5\u00e0 \u201d \u00c6\u00be \u00c9\u00ae\u00be\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n17.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cd\u00ba\u00e0\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6, \u00a6\u00cd\u00fa \u201c \u00af\u00be\u00e0\u00bc \u00c0\u00ba\u00f2\u00e8\u00a8\u00e5\u00c9\u00c3\u00e5\u00c7 \u00ef\u00be\u00e5\u00bc\u00fb\u00c4\u00b4 \u00ef\u00cd\u00e0\u00ba\u00eb\u00c9\u201d \u00c6\u00be \u00ca\u00fb\u00da\u00cb\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e6\u00ba\u00e8 \u00ba\u00f9\u00c7\u00e6\u00c9 \u00c6\u00b4\u00ba\u00b4 \u201c \u00c9\u00c8\u00e2\u00aa\u00eb\u00a1\u00be\u00be\u00f1\u00ba\u00e5 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00be\u00f1\u00ba\u00e5\u00c9 \u00ba\u00cd\u00c9\u00ea\u00c7\u00e6 \u00d1 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u201d\u00c6\u00be \u00ca\u00fb\u00da\u00cb\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00f5\u00ef\u00ba\u00be\u00e0 \u00ba\u00f9\u00c7\u00e6\u00c9\u00a8\u00e0 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\nVI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n1981 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00b0\u00be\u00c4\u00ba\u0097\u00ae\u00e5\u00c7\u00b8 \u00c0\u00be\u00ba \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\n\n18.\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c6\u00b4 \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00cd\u00fa \u201c \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u201d\u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be, 1981 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00b0\u00be\u00c4\u00ba\u0097\u00ae\u00e5\u00c7\u00b8\u00c0\u00be\u00ef\u00ba\u00e0 20 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a6\u00cd\u00fa (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00c6\u00b4\u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00ef\u00c4\u00cd\u00fa \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n\u201c (\u00a1\u00a1) \u00af\u00be\u00e0\u00bc\u00bc\u00e5\u00c6\u00a8\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c9\u00e2\u00c8\u00aa\u00eb \u00a1\u00be\u00be\u00f1\u00ba\u00e5 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0\u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00c7 \u00c2\u00c8\u00e5, \u00be\u00c4 \u00cc\u00cd \u00a1\u00be\u00be\u00f1\u00ba\u00e5\u00c9 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7\u00aa\u00ba\u00c6\u00ea\u00ba\u00eb \u00c6 ; \u201d.\n\n1981 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be\u00c0\u00be\u00ef\u00ba\u00e0 20 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00cd\u00ba\u00e0\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e053\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2004 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00af\u00be\u00e0\u00bc \u0097\u00c4\u00cc\u00e9\u008a(\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba8\n\n19.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 21 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6, \u00ef\u00c4\u00cd\u00fa \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(\u00a1) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c \u00a4\u008e\u00ba\u00c0\u00d7\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a2\u00b6\u00bc\u00e9\u00c4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c \u00a4\u008e\u00ba\u00c0\u00d7\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a2\u00b6\u00bc\u00fb\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00c8\u00e2\u00aa\u00eb \u00a1\u00be\u00be\u00f1\u00ba\u00e5 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a2\u00b6\u00bc\u00fb\u00c4 \u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(\u00a1\u00e5) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c\u00a6\u00e0 \u00c9\u00be\u0097\u00b4\u00ba\u00e0 \u00a4\u008e\u00ba \u00c8\u00a8\u00eb\u00b8\u00e8\u00be\u00e0 \u00cc\u00c8\u00a8\u00eb\u00b8\u00ea \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u201d \u00c6\u00be\u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c \u00a6\u00e0 \u00c9\u00be \u0097\u00b4\u00ba\u00e0 \u00a4\u008e\u00ba \u00c8\u00a8\u00eb\u00b8\u00e8\u00be\u00e0 \u00cc\u00c8\u00a8\u00eb\u00b8\u00ea \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00af\u00be\u00e0\u00bc\u00bc\u00e5\u00c6\u00a8\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00be\u00be\u00f1\u00ba\u00e5\u00c9\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00cc\u00e6\u00a8 \u00c4\u00ba\u00eb\u00c9\u00be \u00a8\u00c7\u00e6\u00b8\u00ea \u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00c2\u00c9\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n20.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ba\u00eb\u00be\u00e0\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6, \u00a6\u00cd\u00fa \u201c \u00a1\u00e5 \u201d \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8\u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u201c \u00af\u00be\u00e0\u00bc \u00c0\u00ba\u00f2\u00e8\u00a8\u00e5\u00c9 \u00c3\u00e5\u00c7 \u00ef\u00be\u00e5\u00bc\u00fb\u00c4\u00b4 \u00ef\u00cd\u00e0\u00ba\u00eb\u00c9 \u201d \u00c6\u00be \u00ca\u00fb\u00da\u00cb\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00a1\u00e6\u00ba\u00e8 \u00ba\u00f9\u00c7\u00e6\u00c9 \u00c6\u00b4\u00ba\u00b4 \u201c \u00c9\u00c8\u00e2\u00aa\u00eb \u00a1\u00be\u00be\u00f1\u00ba\u00e5 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba \u00ef\u00cd\u00e5\u00e0\u00a1\u00be\u00be\u00f1\u00ba\u00e5\u00c9 \u00ba\u00cd\u00c9\u00ea\u00c7\u00e6 \u00d1 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba \u201d \u00c6\u00be \u00ca\u00fb\u00da\u00cb\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00f5\u00ef\u00ba\u00be\u00e0 \u00ba\u00f9\u00c7\u00e6\u00c9\u00a8\u00e0\u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n21.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cd\u00e5 \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00ba\u00eb\u00be\u00e0\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00b8\u00ef\u00c6\u00e0\u201c\u00a1\u00e5\u201d \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8 \u00c0\u00ba\u00f2\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4."
