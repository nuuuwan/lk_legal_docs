    "chunk_text": "\u201c\u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c7\u00af\u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7\u00cc\u00b6\u00bc\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00db\u00b6\u008b\u00bb\u00c1\u00bd\u00c6\u00bd\u00c8\u00bd\u00c6\u00af\u00c7\u00b8\u00b6\u00d0\u00b6\u00c8\u0094\u00b8\u00ba\u00c6\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 2 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c627\n\n\u00bd\u00c8\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8\u00af\u00bd\u00c6\u00ce\u00af\u00b6\u00c6\u00d7\u00ce\u00bd\u008a\u00be\u00c6 \u00af\u00be\u00c6\u008c\u00b1\u00c7\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00bb\u00bc\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00af\u00be\u00c6\u008c\u00b1\u00c7\u00bc\u00c6 \u00b6\u00ce\u00af\u00ce\u00ba\u00af\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7\u00b9\u00bb\u00d9\u00de \u00b6\u00c8\u00bb\u00c7\u00b8 \u00a3\u00d9\u00b9\u00c1\u00b6\u00c6\u00ce\u00b6\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00af\u00c6\u00af\u00c8\u00bd\u00c7\u00bc\u00c6;\n\n(\u00a5) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u0088\u00be\u00c6\" \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ac\u00e1+\u00c6\u00d0\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u008a\u00b8\u00c7\u00be\u00c6\" \u00cd\u00ba\u00bd\u00c6\u00b9\u00c7\u00bc\u00c6\u00ce\u00c1 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u008a\u00b8\u00c7\u00be\u00c6\" \u00a7\u00bb\u00bc\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6 \u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6\"\u008c\u00b1\u00c7\u00bc\u00ce\u00b5 \u00a4\u00ce\u00b5\u00af\u00c6\u00d0\u00e1\u008c\u00b8\u00c7\u00be\u00c6\" \u00b7\u00c8\u00bb\u00c7\u00bb\u00b1\u00ce\u00b9\u008a\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00d0\u00e1\u008c\u00b8\u00c7\u00be\u00c6\u00cd\u00ba\u00c7\u00b1\u0088\u00ce\u00bb\" \u00c1\u00b3\u00c6\u00b1\u00ce\u00b8\u00ce\u00bb\" \u00cd\u00b7\u00bc\u00c6\u00ce\u00ba\u0094\u00b8\u00b6\u00c6\u00ce\u00b6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00a5\u00ce\u00b6\u00cc\u00bb\u00c7\u00b6\u00c6\u00b6\u00d0\u00bd\u00c6\u00bd\u008c\u00bb\u00bd\u00c6 \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00c7\u00b4\u00c6\u00ce\u00b4 \u00a7\u00b4\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd\u00d0\u00bd\u00c6\u00bd\u00b1\u00c6\u00b1\u00c7\u00b4\u00c6\u00d5 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u0081 \u008c\u00ce\u00bf\u00c1\u00c7\u00af \u00ac\u00dd \u00da\u00be\u00b8\u00c7\u00bb\u00c6\u00e2\u00af\u00c6\u00d0\u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c8\u00b1\u00c7\u00bc\u00ce\u00b5\u00af\u00c6\u00d0 \u00a7\u00b4\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bc\u00c7\u00af\u00a5\u00dd\u00af\u00c6\u00af\u008c\u00be\u00c6\u00ce\u00be \u00a9\u0081\u00b9\u00d7 ;\n\n(\u00a6) \u00b7\u00c8\u00b6\u00c8 \u00db\u00af\u00c7\u00ce\u00ba \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00da\u00bc\u00c8\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d0\u00bd\u00c6\u00bd\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00be\u00c6\u00cc\u00be\u00c7\u00e1\u00af\u00c6\u00af\u00b9\u00c6 \u0089\u00bd\u00c0\u00c6\u00ce\u00c1 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b6\u00c1\u00de\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 2 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c628\n\n\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u0088\u00be\u00c6 \u00a7\u00bf\u00c6\u00bf \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c6 \u00d0\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6\u00c1\u00bc\u00c6 ;\n\n(\u00a7) \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u0088\u00be\u00c6\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c6 \u00af\u00b4\u0081\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u008c\u00d5\u008c\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6 \u00af\u00b4\u00b8\u00c8\u00de\u00af\u00c6\u00af \u00c1\u00ce\u00af\u00bb\u00bd\u00c6\u00bd\u00c1\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00bc\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00c1+\u00c6\u00d0\u00cd\u00bd\u00c7\u00b6\u00c6\u00b6\u00c7\u00b8\u00c1\u00bc\u00c7\u00af \u00cc\u00c1\u00bf\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6\u00c1\u00bc\u00c6 ;\n\n(\u00a8) \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u0088\u00be\u00c6\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c9\u