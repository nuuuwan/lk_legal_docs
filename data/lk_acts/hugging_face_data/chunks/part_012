    "chunk_text": "(2)\u00a6\u00c4 \u00a4\u00c0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00a1\u00f5\u00ba\u00e0 \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(\u00a1\u00e5\u00a1\u00e5)2005 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00c0\u00cc\u00ea\u00c9\u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c8\u00c0\u0091\u00be\u0091 \u00c9\u00c8\u00e8\u00be\u00e0 \u00cd\u00d6 \u00a1\u00b6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u2014\n\n(i)\u00b0\u00be\u00c7\u00b0\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00c8\u00c2\u00be \u00bd\u00ea\u00c7\u00c6\u00a8\u00e0\u00bc\u00c7\u00be \u00c6\u008a \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb\u00b4 \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0\u00ef\u00aa\u00d1\u00c4 ;\n\n(iii)\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00a8\u00f2\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c 154 (\u00a1\u00e5) \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00c0\u00c8\u00e5\u00ba\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00a8\u00e5\u00c7\u00c9\u00c7\u00c6\u00e5\u00b4 \u00ef\u00aa\u00d1\u008a ;\n\n(iv)\u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00e0 \u00cc\u00c3\u00e5\u00c9\u00a8 \u00c6\u008a \u00c4\u00be\u00e0\u00ba\u00f2\u00e9\u00c9\u00c7\u00c6\u00a8\u00eb\u00b4\u00ef\u00aa\u00d1\u008a ;\n\n(v)\u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00e0 \u00cc\u00c3\u00e5\u00c9\u00a8 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4\u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c7\u00e5\u00b0\u00f1 \u00ef\u00cc\u00e0\u00c9\u00c6\u00a8 \u00c6\u008a\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00b4 \u00ef\u00aa\u00d1\u008a ;\n\n(vi)\u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00c6\u008a\u00cc\u00c3\u00fa\u00a8\u00c6\u00a8\u00eb\u00b4 \u00ef\u00aa\u00d1\u008a ;\n\n(vii)\u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4 \u00ef\u00aa\u00d1\u008a ;\n\n(viii)1978 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8 \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc\u00e6\u00c6\u00fa \u00cc\u00ce\u00a8\u00be\u00ea\u00c8\u00c2\u00be \u00c6\u008a \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u00a8 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4 \u00ef\u00aa\u00d1\u008a ;\n\n42005 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(ix)1988 \u00a1\u00e2\u00a8 53 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8\u00a1\u00bd\u00f1\u00c6\u00be \u00a1\u00e5\u00c6\u00ba\u00be \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8 \u00a1\u00bd\u00f1\u00c6\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4 \u00ef\u00aa\u00d1\u008a ;\n\n(x)\u00cc\u00e8\u00c6\u00f5\u00c4 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00b0\u00be\u00e5\u0093\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ba\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00d7\u00a8\u00e0\u00cb\u00b8 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00c9\u00a8\u00e0\u00c9\u00be, \u00c6\u008a \u00c0\u00be\u00ba\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c0\u00be\u00ba\u00a8\u00e0\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00c6\u008a \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0\u00c0\u00d7\u00a8\u00e0\u00cb\u00b8 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00c9\u00a8 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb\u00b4\u00ef\u00cd\u00e5\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4 \u00ef\u00aa\u00d1\u00c4 ;\u201d.\n\n\u00cc\u00cd \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 (i) \u00c9\u00be, (iii) \u00c9\u00be, (iv) \u00c9\u00be, (v)\u00c9\u00be, (vi) \u00c9\u00be, (vii) \u00c9\u00be, (viii) \u00c9\u00be, \u00ef\u00cd\u00e5\u00e0 (ix) \u00c9\u00be \u0097\u00cb\u00c6\u00c6\u00be\u00e0\u00cd\u00fa \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00a8\u00e5\u00c7\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u008a\u00c0\u00be\u00ba \u00a1\u00e5\u00c7\u008a\u00c3\u00d1\u00c4\u00b4 \u00ef\u00c0\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00ea\u00c9\u00bc \u00a2\u00b4\u00ea\u00a8\u00c7\u00be \u00c8\u00bc \u00a2\u00a8\u00eb\u00ba\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4\u00c8\u00e6\u00c2\u00ea\u00be\u00ea \u00a6\u00c9\u00e6\u00be\u00f8 \u00c6\u008a \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c8\u00e5\u00c3\u00c6\u00a8\u00e04 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6)\u00ef\u00d8\u00bc\u00ef\u00c6\u00cd\u00fa \u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00c8\u00e6\u00c2\u00ea\u00be\u00ea \u00c6\u008a\u00c8\u00e5\u00c3, \u201d;\n\n(3)\u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00b0) \u00ef\u00d8\u00bc\u00ef\u00c6\u00cd\u00fa \u201c\u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00ef\u00c6\u00e5\u00e0\u00b0\u00a8 \u0097\u00cc\u00e8\u00be\u00e0\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201c2005 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00c6\u008a\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0\u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00a8 \u0097\u00cc\u00e8\u00be\u00e0 -\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\u00cc\u00cd\n\n(4)\u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00b0) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00a1\u00f5\u00ba\u00e0 \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e6\u00ba\u00eb\u00c8\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :_\n\n\u201c(\u00b0\u00b0) 2005 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00e5\u00c7\u008a\u00c3\u00c9\u00be \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 -\n\n52005 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba"
