    "chunk_text": "\u201c10\u00b0 1971 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 35 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00bf\u00c6 (\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00bc\u00c8\u00b6\u00c6\u00b6\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00bf\u00c6 \u2013\n\n\u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8\u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00ba\u00c9\u00d7 30 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\n\n(i) \u00a4\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081\u00af\u00c9\u00c0\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00bc\u00c8 \u008a\u00ce\u00b8 \u00af\u00c0\u00c8\u00b6\u00c6\u00b6 \u0089\u0081\u00b8\u00bc\u00c6 \u00a3\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00b6\u00c7\u00b8 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c8\u0081 \u00ba\u00c9\u00b6\u00c8\u00af\u00c6\u00d0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00f2\u0081\u00bd\u00c7\u00ba\u00c6\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00ce\u00bb\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n25 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\n\n59\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a4\u00bd\u00c7\u00c1\u00d7 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00bb\u00c7\u00b8\u00d7 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n(1) \u00a3\u00c1\u00c6\u00c1\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 5 \u00a4\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u201c\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00af\u00ce\u00bc\u008a\u00df\u00bf\u00c6\u00bf \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u00d5 \u00b7\u00c7\u00b5\u00bb \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00be\u00c6 \u00c1\u00c7+\u00c6\u00af\u00be\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a9\u00e1\u00af\u00c8\u0081\u00bd (\u0089\u00bc\u00c8\u00e238)\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c2002\" \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u00bd\u00c6\u00d0 \u00db\u0081\u00b8\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00ce\u00bc\u008a\u00df\u00bf\u00c6\u00bf \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u00d5\u00b7\u00c7\u00b5\u00bb \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00be\u00c6 \u00c1\u00c7+\u00c6\u00af\u00be\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a9\u00e1\u00af\u00c8\u0081\u00bd\u00d7\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 2003\" \u00bb[\u0081 30 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00a7\u00bf\u00c6\u00bf\u00b4+\u00c6\u00af\u00c8\u00bb \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8 \u00c1\u00ce\u00bc\u00af\u00c6\u00d0\u00ba\u00c7\u00b8 \u00a5\u00be\u00c7\u00b9\u00ba\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00ba\u00c6\u00ba\u00c9\u00d7 (\u0089\u00bc\u00c8\u00e2 38)\u201d ; \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6\u00b0\n\n(2) \u00a3\u00c1\u00c6\u00c1\u00b4\u00c6\u00b4\u00ce\u00b5\u008a\u0081 5 \u00a4\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00ce\u00b6 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u008c\u00b4\u00bb+\u00c6\u00af\u00ce\u00bf \u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00c1\u00b6\u0081 \u00f2\u00be\u00ba\u00c6 :\u2013\n\n5\u00a3\u00b0 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u00d5 \u00b7\u00c7\u00b5\u00bb\u00c1+\u00c6\u00af\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00e7\u00bd\u00c8\u0081 \u00af\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00c7\u00df\u00bf\u00c6\u00bf \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u00d5 \u00b7\u00c7\u00b5\u00bb\u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00be\u00c6 \u00c1\u00c7+\u00c6\u00af\u00be\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00b6\u00c7\u00b8 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00ce\u00bf \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00ba\u00c6 \u00ba\u00c9\u00b6\u00c7\u00b8\u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u0096\u00b6\u00ba\u00c6(\u0089\u00bc\u00c8\u00e2 38\u00a3)\n\n5\u00a4\u00b0 \u00a3\u00dd+\u00c6\u00af\u00bd\u00c6\u00af\u00bf\u00c6\" \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00a3\u00af\u00c0\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6 \u00a7\u00cd\u00be\u00c7\u00af+\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u008b\u00bb\u00ba\u00c6\" \u00c1\u00c7\u00dc \u00a3\u00be\u00c6\u00be\u00d7\u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u008b\u00bb \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00c1\u00de \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b9\u00b4\u00c6\u00b4 \u00af\u00bf\u00b3\u00c6\u00b1\u00c8\u00bb \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b1\u00bc\u00af\u00c6\u00d0 \u00a3\u00d9\u00b9\u00c6\u00da\u00b7\u00dd\u00af\u00c6\u00d0\u00a3\u00be\u00c6\u00be\u00d7 \u00b1\u00bc\u00af\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00de\u00b7\u00dd\u00af\u00c6\u00d0 \u00a9\u00e1\u00af\u00c8\u0081\u00bd \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00ba\u00c9\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u0096\u00b6\u00ba\u00c6 (\u0089\u00bc\u00c8\u00e2 38\u00a4)\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8\u00a4\u00bd\u00c7\u00c1\u00d7\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 \u00ce\u00bb\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n20 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\n\n10 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c692\n\n5\u00a5\u00b0 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00af\u00bf\u00b3\u00c6\u00b1\u00c8\u00bb\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00af\u00bf\u00b3\u00c6\u00b1\u00c8\u00bb \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00c1\u00b1\u00b6\u00c8\u00af\u00ce\u00bf \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00b9\u00bc\u00c7\u00ba\u00bc\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u00bd\u00c6\u00d0\u00a9\u00e1\u00af\u00c8\u0081\u00bd \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00c1\u00dd\u00ba\u00c7\u00b8\u00ba\u00c6 \u00ba\u00c9\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u0096\u00b6\u00ba\u00c6 (\u0089\u00bc\u00c8\u00e2 38\u00a5)5\u00a6\u00b0 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00b9\u00c6 \u00b9+\u00c6\u00d0\u00af\u00bf\u00c8\u0081 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8\"\u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00ce\u00b5\u00b9\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00bc\u00b6\u00c6\u00b6\u00c8\u0081\u00ba\u00c9\u00d7 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00dd\u00c1\u00c7\u00bb\u00c6\u00af\u00bf\u00c8\u00bd\u00c6\u00d0 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u0096\u00b6\u00ba\u00c6(\u0089\u00bc\u00c8\u00e2 38\u00a6)"
