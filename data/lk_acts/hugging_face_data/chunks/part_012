    "chunk_text": "2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 5 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b7\u00c8\u00b6\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c616\n\n\u201c\u00a4\u008a\u0081\" \u00cd\u00ba\u00cd\u00be \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00cc\u00b9\u00c7\u00dd\u00bf\u00c8\u0081 \u00a4\u00d0\u00cc\u00b1\u00be\u00e2\" \u00af\u00c7\u00b9\u00c6\u00da\u00de\u00b6\u00c8\" \u00af\u00b9\u00c6\u00b9\u00bd\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b9\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00a9\u0081\u00b9\u00b8 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6\" 2004 \u00b7\u00cc\u00c1\u00ba\u00c6\u00b9\u00bc\u00c6 19 \u00a4\u00ba\u00c6\u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 1\u00b05 \u00b1\u00b6\u0096\u00b6\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u00b8 \u00a3\u00bd\u0096\u00cc\u00b4\u00c7\u0081\u00de \u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5 \u00a3\u00bd\u008c\u00b4\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(\u00a3)2003\" \u00b1\u00b8\u00c1\u00bc\u00c8 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00c8\" 2004\u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00bc\u00c6 31 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00db\u0088\u00c1\u00ce\u00b4\u00af\u00c8\u0081\u00bd \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00c7\u00af 0\u00b05 \u00b1\u00b6\u0096\u00b6\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5 \u00a3\u00bd\u008c\u00b4\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a4)2005 \u00b1\u00b8\u00c1\u00bc\u00c8 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00af\u00c8\u0081\u00bd\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00c7\u00af 0'25 \u00b1\u00b6\u0096\u00b6\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00a3\u00bd\u008c\u00b4\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d\u00b0\n\n24' \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b9\u00c7\u00dd\u00bf\u00c8\u0081 \u00a4\u00d0\u00cc\u00b1\u00be\u00e2\" \u00af\u00c7\u00b9\u00c6\u00da\u00de\u00b6\u00c8 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00af\u00b9\u00c6\u00b9\u00bd\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b9\u00c6 \u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00bd\u00c8\u0081\u00ba\u00c9\u00d7 \u00ac\u00dd \u00b1\u00b6\u0096\u00b6\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00b1\u00c6\u00b1\u00ba\u00ba\u00c7\u00b8 \u00cc\u00b6\u00c7\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00de\" 2002 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 11 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00b7\u00c8\u00b6\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 I \u00a4\u00ba\u00c6 \u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00c1\u00c7\u00bd\u00c7\u00b8 \u00cc\u00b9\u00c7\u00dd\u00cc\u00bf\u00c7\u0081\u00ce\u00bd \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8 \u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6\u00a4\u00bf\u00c8\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7\" 2004 \u00b7\u00cc\u00c1\u00ba\u00c6\u00b9\u00bc\u00c6 19 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00c8\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00db\u0088\u00c1\u00ce\u00b4\u00af\u00c8\u0081\u00bd \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081\u00cd\u00b9\u00c7\u00d7 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00a5\u00b9\u00c6\u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b7\u00c8\u00bb\u00b6\u00c8\u00af\u00bf\u00c8\u0081\u00b9\u0088\u00d7\u00ce\u00bd\u00db\u00af\" \u00c1\u00c7\u00d9{\u00bc\u00c6\u00b6\u00c8 \u00b7\u00c8\u00ce\u00be\u00bb \u00a3\u00bd\u0096\u00b4\u00c7\u00af\u00b1\u00c6 \u00d2+\u00c6\u00af\u00b9\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u008a\u00b8\u00c7\u00bd\u00c6 \u00cd\u00b1\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u008c\u00b4\u00b6\u00c6\u00d7\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cd\u00b1\u00af\u00bc\u00c8\u00b9\u00c6\u00b9\u00c7\u00b8\u00d7\" \u00a9\u00be\u00c6\u00be\u00c7 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6\" \u00cc\u00b1\u00be\u00c6\u00df\u00b9\u0088\u00bb\u00c7\u00af\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00b6\u00c7\u00af\u00e2\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00c7\u00af\u00e2\u00ba\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081\" \u00d2+\u00c6\u00af\u00b9\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u00af\u00c6\u00d0\"\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00b1\u00af\u00bc\u00c8\u00b9\u00c6\u00da\u00b6\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6\" \u00a9\u00be\u00c6\u00be\u00c7\u00af\u00c6 \u00d0\u0088\u008a\u00bb\u00be\u00c6\" \u00a3\u00be\u00c6\u00be\u00d7\u00d0\u00bd\u00c6\u00bd\u008c\u00bb\u00be\u00c6 \u00c1\u00c0\u00af\u00c6\u00d0\u00af\u00e0\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u00e2\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b7\u00b4\u00c6\u00cd\u00b4\u00c7\u00b6\u00c6\u00b6\u00bc\u00c1\u00c7\u00b6\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00e2\u00ba\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7\u00b0\n\n\u00b7\u00b4\u00c6\u00cd\u00b4\u00c7\u00b6\u00c6\u00b6\u00bc\u00c1\u00c7\u00b6\u00ba\u00c6\u00b0\n\n172005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 5 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b7\u00c8\u00b6\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00b9\u00c7\u00af\u00ba\u00c6 V\n\n\u00cc\u00b9\u00c7\u00d7\n\n25' (1) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u00b8\u00b6\u00c6\u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6\u00a3\u00ce\u00c1\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00ac\u00e1+\u00c6\u00d0\u008c\u00b6\u00c8\u00af\u00bf\u00c6 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00c1\u00b6\u00bd\u00c6\u00d0\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a9\u00be\u00c6\u00be\u00c7\u00af\u00c6 \u00af\u00dd\u00ba+\u00c6\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00df\u00ba\u00c6 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c6 \u00ac\u00e1+\u00c6\u00d0\u008c\u00b6\u00c8\u00af\u00bf\u00c6 \u00a4\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n(2) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00ac\u00c1\u00c6\u00cd\u00c1\u00c7\u00bc\u00c6 \u00ac\u00e1+\u00c6\u00d0\u008c\u00b6\u00c8\u00dc\u00ba\u00c6 \u00af\u00cc\u00b1\u00bd\u00c6\u00bd\u00c8\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081\"\u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00d5\u00b6\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de\" \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081\u00af\u00ae \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u0089\u00b7\u00c6\u00b6\u00c8\u00bb \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00af\u00c6\u00d0\u00c1\u00dd\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0"
