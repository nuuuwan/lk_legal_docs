    "chunk_text": "(3)\u201c\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u201d \u00c6\u00be \u00ef\u00c6\u00f3\u00ef\u008a \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u201d \u00c6\u00be\u00e0\u00be\u00b4 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00be \u00be\u00c4\u00ea\u00ba\u00e0, \u00a3\u00b4\u2014\n\n(\u00a1)\u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1972 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be\u00cc\u00c4\u00ea\u00c0\u00a8\u00e5\u00c7 \u00cc\u0095\u00ba\u00f8 \u00c0\u00be\u00ef\u00ba\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9, \u00c6\u008a\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00cc\u0095\u00ba\u00f8\u00c6\u00a8\u00e0;\n\n\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00be\u00e5\u00ef\u008c.\n\n7.(1) (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 1 \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be 2005 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be \u00c2\u00c9\u00b4 \u00cc\u00e8\u00c6\u00f5\u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u0097\u0093\u0097\u00bd\u00e5\u00be, \u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 2004 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0\u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00ec \u00c2\u00c9\u00b4 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\u2014\n\n(\u00a1)\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1), (2), (3), (4), (5), \u00cc\u00cd(6) \u00c6\u00be \u00a1\u00c6\u00fa\u00ba\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4\u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 6 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 12 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6.\n\nII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00a1\u00f5\u00ba\u00e0 III\u00a1 \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 2004 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n8.2004 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 28 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7,\u00a6\u00c6 \u00a6\u00c4 \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 III\u00a1 \u00ef\u00a8\u00e5\u00b4\u00cc (28\u00a1, 28\u00a1\u00e5, 28\u00a1\u00e6 \u00cc\u00cd 28\u00a1\u00e7 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8)\u00ef\u00c8\u00cc \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\u2014\n\n1\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00c4 \u00cc\u00cd\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a1\u00ba\u00f9\u00ba\u00c6\u00b4\u00c2\u00c8\u00c0\u00e5\u00be \u00c0\u00d6\u00bc\u00fa\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00c4.\n\n2004 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba\u00b4\u00a1\u00f5\u00ba\u00f8\u00be\u00e0 III\u00a1\u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4.\n\n2005 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba8\n\n\u201cIII\u00a1 \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00db\u00bf\u00c9\u00ea\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00c0\u00e6\u00be\u00d1\u00c4\n\n28\u00a1. (1) \u00ef\u00c0\u00e5\u00f3 \u00c0\u00f2\u00c9\u00e5\u00cd\u00be \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00c4\u00b8\u00a8\u00e0\u00c4 \u00c3\u00e5\u0097\u00ba\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ba\u00f2\u00e9\u00ef\u00c7\u00e5\u00e0\u00bc \u00c7\u00bb, \u00ef\u00c8\u00e5\u00d6 \u00cc\u00cd \u00c2\u00cc\u00e0 \u00c7\u00bb\u00cd\u00e6\u00c7, (203 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be \u00c0\u00be\u00ef\u00ba\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e7\u00c4\u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00c4 2005 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1\u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa, 28\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00db\u00bf\u00c9\u00ea\u008a\u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u201c\u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be\u00c6\u201d\u00c6\u00be\u00e0\u00be\u00b4 (203 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c9\u00ec) \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be \u00c0\u00be\u00ef\u00ba\u00e0\u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00a1\u00da\u00bb\u00c6 \u00c4 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00db\u00bf\u00c9\u00ea\u008a \u00c2\u00bc\u00e0\u00bc\u00a2\u00c8\u00e0\u00f5\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e0\u00be\u008a \u0095\u00cc \u00ef\u00c4\u00e5\u00e0\u00b4\u00da\u00c9\u00e5\u00cd\u00be \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c6\u008a \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0\u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6. \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00c6\u008a\u00c2\u00f3 \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0, \u00a2\u00c8\u00e0\u00f5\u008a\u00a8\u00c7\u00e6 \u00ef\u00c9\u00ba \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00c4\u00aa\u00fa\u00be\u00e0 \u00c6\u00bb\u00e5 \u00c0\u00d6\u00bc\u00fa \u00c3\u00e5\u00c7 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6."
