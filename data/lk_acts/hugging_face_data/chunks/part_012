    "chunk_text": "(4) \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d5 2004 \u00a5\u0081 \u00db\u0088\u008c\u00be\u00c6\" \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8\u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 I \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00b7\u00c8\u00df\u00ce\u00c1\u00bb\u00c7\u00af\u00e2\u00bf\u00c6\u00bf\u00b9\u00bd\u00c6\u00de\u00ba\u00c9\u00b6\u00c8\" \u00a3\u00b7\u00c6\u00b6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 IV \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00df\u00bf\u00c6\u00bf\u00cd\u00b7\u00cc\u00bc\u00c7\u00b6\u00c6\u00b6 \u00b9\u00b6\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00a4\u00af\u00af\u00c6 \u00e7\u0088\u00bb\u00a9\u00be\u00c6\u00ce\u00be\u00ce\u00bb \u008c\u00b3\u00c6\u00d2\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b7\u00c6\u00b6 \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u0088\u0081\u00a5\u00de\u00b6\u00c8\u008a\u00be\u00c6 \u00a3\u00b7\u00c6\u00b6 \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u0081 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6 \u00a3\u00b7\u00c6\u00b6\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 V \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00be\u00c6 \u00a7\u00bf\u00c6\u00bf \u00cd\u00b7\u00cc\u00bc\u00c7\u00b6\u00c6\u00b6 \u00b9\u00b6\u00c8\u008c\u00be\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u