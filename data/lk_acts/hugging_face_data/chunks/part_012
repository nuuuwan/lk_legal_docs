    "chunk_text": "(1) \u00a3\u00c1\u00c6\u00c1\u00b4\u00c6\u00b4\u00ce\u00b5\u008a\u0081 \u00b9\u00c7\u00af\u00ba\u00c6 I\u00a4 \u008c\u00be\u00c6 \u201c\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00bd \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\"\u201c\u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00bd \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n(2) \u00a3\u00c1\u00c6\u00c1\u00b4\u00c6\u00b4\u00ce\u00b5\u008a\u0081 \u00b9\u00c7\u00af\u00ba\u00c6 I\u00a4 \u00ce\u00c1 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00ce\u00b8 \u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c\u00b9\u00c7\u00af\u00ba\u00c6 I\u00a5\n\n\u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00db\u00b6\u00be\u00c6 2\"40\"000 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d010 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\n\n\u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00a3\u00d5\u00b6\u00c6\u00b6 2\"40\"000 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d020 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\n\n\u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00ba\u00c9\u00b6\u00c8\u00af\u00c6\u00d030 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\u00b0\n\n(3) \u00a3\u00c1\u00c6\u00c1\u00b4\u00c6\u00b4\u00ce\u00b5\u008a\u0081 \u00b9\u00c7\u00af\u00ba\u00c6 III \u00a3 \u00a5\u00be\u00c6 \u201c\u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u0081 \u0089\u0081\u00b8\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4\u00b4+\u00c6\u00d0\u00af\u00c8\u0081\u00bd \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00bd \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00af\u00c8\u0081\u00bd \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00ce\u00b4 \u00a7\u00b4\u0081 \u00a3\u00d5\u00b6\u00c6\u00d7\u00c1\u00dd\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0\u00ba\u00c6\u201d \u00a9\u0081\u00de \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(4) \u00a3\u00c1\u00c6\u00c1\u00b4\u00c6\u00b4\u00ce\u00b5\u008a\u0081 \u00b9\u00c7\u00af\u00ba\u00c6 III\u00a3 \u00ce\u00c1 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00ce\u00b8\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00db\u00b6\u00be\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00ce\u00bb\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c690\n\n\u201c\u00b9\u00c7\u00af\u00ba\u00c6 III\u00a4\n\n2004\" \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0\n\n\u00db\u00b6\u00be\u00c6 2\"000\"000 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0 \u00a5\u00be\u00c6\u00ce\u00be\u00a3\u00d5\u00b6\u00c6\u00b6 500\"000 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d05 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\u00a3\u00d5\u00b6\u00c6\u00b6 500\"000 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d010 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\u00ba\u00c9\u00b6\u00c8\u00af\u00c6\u00d015 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\n\n58\u00b0 2003 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 37 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00de \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 \u00cd\u00ba\u00df\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n(1)\u00a3\u00b6\u0081 5 \u00a4\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00ce\u00b8 \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c5 \u00b9+\u00c6\u00d0\u00ce\u00b4\u00ce\u00ba\u00af\u00bf\u00c6 (\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u0088\u0081 \u00ba\u00c9\u00d7) 30 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6 \u201d\n\n(2)\u00a3\u00b6\u0081 6 \u00a4\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u201c1972 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 5 \u00a4\u00ba\u00c6\u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\u201d \u00a9\u0081\u00bd \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c1972 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 5 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 96 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00bf\u00bc\u00c8\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b1+\u00c6\u00af+\u00c6\u00af\u00bf\u00c6\" 2003\" \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c61 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u0089\u0081\u00b8\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0 \u201d ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(3)\u00a3\u00b6\u0081 10 \u00a4\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6\u008c\u00b4\u00bb\u00b6\u00c6\u00ce\u00b6 \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c10\u00b0 1971 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 35 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00bf\u00c6 (\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00bc\u00c8\u00b6\u00c6\u00b6\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00bf\u00c6 \u2013\n\n\u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8\u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00ba\u00c9\u00d7 30 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\n\n(i) \u00a4\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081\u00af\u00c9\u00c0\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00bc\u00c8 \u008a\u00ce\u00b8 \u00af\u00c0\u00c8\u00b6\u00c6\u00b6 \u0089\u0081\u00b8\u00bc\u00c6 \u00a3\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00b6\u00c7\u00b8 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c8\u0081 \u00ba\u00c9\u00b6\u00c8\u00af\u00c6\u00d0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00f2\u0081\u00bd\u00c7\u00ba\u00c6\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00ce\u00bb\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n25 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6"
