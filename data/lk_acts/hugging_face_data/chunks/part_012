    "chunk_text": "(2) \u00c9\u00d6\u00be\u00e0\u00c9\u00c7 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c0\u00d6\u00bc\u00fa \u00c9\u00ec 1963 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0VI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be, (58 \u00cc\u00e8\u00b4 66 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00c9\u00aa\u00be\u00e0\u00ba\u00f8) \u00ef\u008a\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00ec\u0097\u00b4, \u00c9\u00d6\u00be\u00e0 \u00c9\u00c7 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c0\u00d6\u00bc\u00fa \u00c9\u00ec \u00a2\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 VI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00c9 \u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00e6\u00c2 \u00ba\u00f8\u00ef\u00c2\u00be \u00cc\u00e8\u00c6\u00f5 \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0, \u00be\u00f8\u00ef\u008c\u00bc\u00be, \u00d7\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa, \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00d1\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4\n\n2002 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be\u00c0\u00be\u00ba \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\u00a8\u00f8\u00d7\u00c4.\n\n1963 \u00a1\u00e2\u00a8 11\u00bc\u00c7\u00be\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0VI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00c9 \u00c0\u00e6\u00c9\u00ba\u00f8\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa, VI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00be\u00e6\u00c9\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00d1\u00c4\u00ba\u00e0\u00cc\u00c4\u00aa, \u00a6\u00e0 \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0, \u00be\u00f8\u00ef\u008c\u00bc\u00be, \u00d7\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa \u00ef\u00c4\u00cd\u00fa \u00c8\u00e5 \u00c0\u00be\u00c9\u00be\u00ea\u00c8\u00e6\u00c2\u00ea\u00c9\u00e5\u00a8\u00e0 \u00ef\u00cc\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n4.1963 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 VI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc, \u00ef\u00c4\u00cd\u00fa \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u0095\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u00a6\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 58 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u2014\n\n(\u00a1)\u00a6\u00cd\u00fa (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(1\u00a1) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c6\u00a8\u00eb \u00ef\u00be\u00e5\u00c9\u00be\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00a8\u00f8\u00cc\u00e8\u00c4 \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6\u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00e0 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa \u00c6\u008a \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00c6\u00a8, \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00ef\u00c8\u00e0\u00a8\u008a \u00ef\u00a8\u00e5 \u00b5\u00e5\u00cc\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0\u00aa\u00f2\u00e5\u00c4 \u00be\u00f8\u00c8\u00bd\u00e5\u00d6 \u00ef\u00a8\u00e5 \u00b5\u00e5\u00cc\u00c6\u00a8 \u00a2\u00b6\u008a\u00c9\u00c8\u00b4 \u00c0\u00c9\u00ba\u00e0\u00be\u00e5\u0095\u00ce \u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00ef\u00aa\u00be, \u00a2\u00b6\u008a \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00cc\u00cd\u00c0\u00f2\u00bd\u00e5\u00be \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00a6\u00a8\u00ad\u00ba\u00e0\u00c9\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9 \u00c4\u00ea\u00bc\u00c8\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00ba\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e5\u00bc\u00be\u00ea\u00c8\u00c2\u00be \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa \u00c4\u00aa\u00fa\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be \u00c6\u008a\u00c9\u0090\u00be\u00e5\u00a8\u00c4\u00a8\u00b4 \u00a1\u00b6\u00ea \u0095\u00ce\u00a8\u00b4, \u00cc\u00e8\u00f3 \u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d;\n\n(\u00a1\u00e5)\u00a6\u00cd\u00fa (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4, \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(3\u00a1) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c0\u00e8\u00cd\u00fa\u0090 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00a1\u00c6\u00fa\u00ba\u00f8\u00c6 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00b4 \u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00e0 \u00cc\u00e8\u00f3\u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00bc\u00fb, \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00ce \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00c9\u00c8\u00e8\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4\u0097\u00cc\u00e8\u00c0\u00cd\u00a8\u00b4 \u00c9\u00e6\u0091 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c6\u00be\u00e0\u00ef\u00be\u00e5\u00c9\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00a1\u00c6\u00ba\u00e0\u00c9 \u00a1\u00e6\u00ba\u00e0\u00be\u008a, \u00a6\u00e0\u00ef\u00bc\u00e0\u00c0\u00ef\u00ce\u00cd\u00fa \u00c9\u0090\u00be\u00e5\u00a8\u00c4\u00b4 \u00cc\u00c4\u00e5\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00c2\u00bc\u00e0\u00bc\u00a8\u00e0, \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ef\u00ce\u00cd\u00fa \u00c0\u00e6\u00c9\u00c7\u00e6\u008a\u00c8\u00e5\u00c3\u00fa\u00c6\u00e5\u00ef\u00aa\u00be\u00e0 \u00a1\u00c6\u00a8\u00c7\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d. ;\n\n(\u00a1\u00e6) \u00a6\u00cd\u00fa (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a4) \u00ef\u00d8\u00bc\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7 \u00a6\u00e0\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(\u00a4) \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0\u00c4\u00aa\u00fa\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00a6\u00c9\u00e6\u00be\u00f8\u00c6\u008a \u00c0\u00be\u00e0\u00ba\u00f8\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u0097\u00cc\u00e0\u00ba\u00c7\u00c6\u00a8\u00b4 \u00a1\u00c6\u00ba\u00e0\n\n1963 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be\u00c0\u00be\u00ba \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\u00a8\u00f8\u00d7\u00c4.\n\n2004 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba3\n\n\u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u00c0\u00e6\u00c9\u00d7\u00c4 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00ef\u00cd\u00e5\u00e0 \u00a6\u00ef\u00cc\u00e0\u00be\u00f8\u00c6\u00c4 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4, \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00aa\u00b8\u00c6\u00a8\u00b4\u00ef\u00bc\u00e0\u00c0\u00ce \u00c0\u00e6\u00c9\u00d7\u00c4. \u00a6\u00e0 \u00cc\u00e7\u00c4 \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0\u00c4 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00cd\u00fa \u00c0\u00ce \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d. ; \u00cc\u00cd"
