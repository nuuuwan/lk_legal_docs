0bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u00d1\u00c4.\n\n2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba54\n\n\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e8\u00c6 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00ef\u00a8\u00e5\u00b4 123\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c4\u00ba\u00f8\u00c4\u00e5\u00ba\u00f2 \u00c2\u00e6\u00c7 \u00a8\u00f8\u00d7\u008a\u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00a6\u00c4 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00ba\u00c4\u00e5\u00ef\u00aa\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00f3 \u00c9\u00aa\u00a8\u00f9\u00c4\u00b4 \u00c9\u00b6\u00e5 \u00c9\u00e6\u0091 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00aa\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4 \u00c9\u00e6\u0091\u00c0\u00ea\u00c7 \u00c4\u00ea\u00bc\u00c8 \u00c6\u008a \u00a2\u00bc\u00fa\u00d6 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00c6\u00a8 \u00bc\u00e9 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00c9\u00aa\u00a8\u00f9\u00c4\u00a8\u00b4 \u00a6\u00ef\u00c7\u00cd\u00e8\u00c9 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00c4\u00cc\u00bf\u00cd\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c6\u00b4 \u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00be\u00c4\u00ea\u00ba\u00e0, \u00a6\u00c4 \u00c9\u00e6\u0091\u00c0\u00ea\u00c7\u00c4\u00ea\u00bc\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00a1\u00e5\u00c0\u00cc\u