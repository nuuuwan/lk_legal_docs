    "chunk_text": "(\u00a1) \u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (xi) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0\u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e6\u00c0\u00c6\u00ea\u008a \u00ef\u00be\u00e5\u00c9\u00be \u00a6\u00ef\u00cd\u00ba\u00e0 \u00ef\u008a \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8, \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00c9\u00c8\u00b4 ;\n\n(\u00a1\u00e5) \u00ca\u00eb\u00be\u00f1 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8 \u00aa\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00c9\u00c8\u00b4 ;\n\n(\u00a1\u00e6) \u00ef\u008a \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00a1\u00aa\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e6\u00c7 \u00ef\u00c4\u00c4 \u00c0\u00be\u00ba \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00c2\u00f3 \u00ef\u00aa\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0\u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb, \u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00c9\u00c8\u00b4 ;\n\n(\u00a2) \u00ef\u008a \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u201c\u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u201d\u00ef\u00be\u00e5\u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd\u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ef\u00be\u00e5\u00c9\u00ec \u00a6\u00ef\u00cd\u00ba\u00e0\u00c0\u00f2\u00bd\u00e5\u00be \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c4\u00ea\u00c8\u00f1 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c0\u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00cc\u00e0\u00c9\u00e5\u00cc\u00e6\u00c0\u00c6\u00fb\u00ef\u008a \u00ef\u00c6\u00bc\u00e9 \u00cc\u00e8\u0090\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a4\u00c0\u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u008e\u00ba \u00c9\u00be\u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00cd\u00e6\u00c7, \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00a8\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c4\u00b8\u00a8\u00e0\u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00aa\u00c9\u00be, \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8 \u00c3\u00e5\u00c7 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00a1\u00e6\u00ba\u00eb\u00dd\u0081\u00be\u00e7\u00c4 \u00a1\u00be\u00ea\u00c4\u00ba \u00a1\u00da\u00bb \u00cc\u00e5\u00bd\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u0097\u00ca\u00f2\u00e5\u00c4\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00a8\u00cc\u00ea\u00c7\u00e6\u00c9\u008a, \u00a2\u00ba\u00f8\u00d6 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8\u00cc\u0095\u00ba\u00f8\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00a8\u00c6\u00be\u00e0 \u00c0\u00c4\u00b8\u00a8\u00e0 \u00bc\u00e5\u00c6\u00a8 \u00c9\u00be\u00ea\u00c8\u00c2\u00be \u00ca\u00eb\u00c3 \u00cc\u00e5\u00bd\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00b4 \u0081\u00be\u00e7\u00c4 \u00a1\u00be\u00ea\u00c4\u00ba \u0097\u00ca\u00f2\u00e5\u00c4\u00c0\u00e5\u00d6\u00ef\u00ba\u00e5\u00e0\u00cb\u00e8\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00b4 \u00a4\u00c0\u008e\u00ba \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u00bc\u00e5\u00be \u00ef\u00c0\u00e5\u00ce\u00e9\u00c4\u00ba \u00c8\u00e5\u00c3 \u00cd\u00e5 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00be\u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u008e\u00ba \u00c9\u00be (\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c8\u00e5\u00c3 \u00ef\u00be\u00e5\u00c9\u00be) \u00ef\u00c0\u00e5\u00ce\u00e9\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00b4 ;\n\n(\u00a3) \u00ef\u008a \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u201c\u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0\u201d\u00ef\u00be\u00e5\u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ef\u00be\u00e5\u00c9\u00ec \u00a6\u00ef\u00cd\u00ba\u00e0\u00c0\u00f2\u00bd\u00e5\u00be \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c4\u00ea\u00c8\u00f1 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c0\u00c6\u00be\u00ea \u00c8\u00c2\u00be\u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00c8\u00b4 \u00cc\u00c4\u00e5\u00be \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00ef\u008a \u00ef\u00c6\u00bc\u00fb \u00cc\u00e8\u0090\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4\u00a4\u00c0\u00bc\u00fa\u00be \u00c6\u008a \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00a8\u00e0 \u00cd\u00e6\u00c7, \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a4\u00c0\u00bc\u00fa\u00be \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00b4 ;\n\n2004 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba11\n\n(\u00a4) (i) 2002 \u00b0\u00ec\u00c8\u00e8 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be,2004 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00be \u00c6\u008a \u00c2\u00f3\u00a1\u00c6\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a8\u00e5\u00c8 \u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0,\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u0095\u00c8\u00bc\u00e9 \u00ef\u00aa\u00be \u0097\u00a8\u00eb\u00b8\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00b4 \u00a4\u00c0\u00a8\u00e5\u00d7 \u00c9\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4\u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u00bc\u00fa\u00be \u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c9\u00be, \u00ef\u008a \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00be\u00e0\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8 \u00c6\u008a \u201c\u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00b4\u201d \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ef\u00be\u00e5\u00c9\u00ec \u00a6\u00ef\u00cd\u00ba\u00e0 \u00c4\u00ea\u00c8\u00f1 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0\u00cc\u00c0\u00c6\u00be \u00a6\u00c9\u00e6\u00be\u00f8 \u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00c8\u00b4 \u00cc\u00c4\u00e5\u00be \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00ef\u008a \u00ef\u00c6\u00bc\u00fb \u00cc\u00e8\u0090\u00be\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a4\u00c0\u00bc\u00fa\u00be \u00a6\u00c9\u00e6\u00be\u00f8 \u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00ef\u00be\u00e5\u00c9\u00be\u00c8\u00e5\u00c3\u00c9\u00c8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00b4;"
