    "chunk_text": "(xxxix)\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b9\u008a\u00bd\u00c6\u00b1\u00c8\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b1\u00bb\u00be\u00c6\u00db\u00ce\u00bd\u00b9\u00c6\u00b9\u008a\u00bd\u00c6\u00b1\u00c8\u00ce\u00bb \u00c1\u00c0+\u00c6\u00d0\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00ba\u00c6\u00b7\u00c8\u00b6\u00c8\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00a7\u00b6\u008c\u00ce\u00bb \u00c1\u00c0+\u00c6\u00af\u00c8\u00dc\u00bf\u00c6\u00bf\u008c\u00b4\u00b6\u00c6\u00d7\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00ba\u00c8\u00b6\u00ba\u00c8\u00b3\u00c6\u00b1\u00c8\u00bb \u00b7\u00c8\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00cd\u00b9\u00b5\u00df\u00af\u00c6\u00af\u00c7\u00af \u00ba\u00c9\u00bf\u00c6 \u00db\u00b6\u0095\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c625\n\n(\u00a5)\u00db\u00b6\u00be\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 \u00b9\u00c7\u00af\u00ba\u00c6 \u2013 I \u00a5\u00be\u00c6 xxxix \u00a4\u00ba\u00c6\u008c\u00b4\u00bb\u00b6\u00c6\u00ce\u00b6 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u00b9\u00c7\u00af\u00b6\u00c6\u00ce\u00b6\u00b1\u00c6\u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081 \u00f2\u00be\u00ba\u00c6 :\u2013\n\n\u201c\u00b9\u00c7\u00af\u00ba\u00c6 \u2013 II\n\n2004\" \u00b1\u00b8\u00c1\u00bc\u00c8 1 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00af\u00c8\u0081\u00bd \u00c1\u00bc\u00c8 \u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00c7\u00af \u2013\n\n(\u00a3) (i)\u00cc\u00b7\u00be\u00c6\" \u008c\u00ce\u00b6\u00cc\u00b7\u00be\u00c6\" \u00a3\u00bc\u00c8\u00b1\u00c8\" \u00cd\u00af\u00c7\u00d7\u00ce\u00ba\" \u00aa\u00be\u00ba\u00c6\" \u00af\u00de\u00c1\u00c7\"\u00af\u00bc\u00c7\u00ba\u00c6\u00da\" \u00b1\u00c7\u00b6\u00c8\u00af\u00c6\u00af\u00c7\u00bb\u00c6\" \u00cd\u00b1\u00c7\u00bf\u00ba\u00c6\" \u00ba\u00c8\u00bf\u00d0\" \u00a7\u00be\u00bc\u00c6\u00b6\u00c6\u00b6\u00c8\u00bb\u00cd\u00b6+\u00c6\u00af\u00c7\u00bb\u00c6\" \u00a5\u00bd\u00b9\u00c6\u00b9\u00bc\u00c6\" \u00a7\u00b4\u0081\u00cd\u00b6+\u00c6\u00af\u00c7\u00bb\u00c6\" \u00af\u00c9\u00ce\u00bc\" \u00a3\u00bc\u00c8\u00b1\u00c8\u00ba\u00c7\"\u00cd\u00af\u00c7\u00d7\u00ce\u00ba \u00ba\u00c7\" \u00b9\u00c7\u00ae\" \u00d0\u00c0\u00b7\u00c6\u00ce\u00b6\u00af\u00bf\u00c6 \u00b9\u00c7\u00be\u00c6\u00ba\u00c7\"\u00db\u00b4\u00c6\u00ce\u00b4\u00dc\u00ba\u00c6 \u00b6\u00c8\u00bc\u00c1\u00b9\u00c6 \u00b9\u00c7\u00df\u00ba\u00c6 (\u00b9\u00c7\u00be\u00c6\u00ba\u00c7\u008c\u008b\u00dd\u00b7\u00c6\u00d7\u00a3\u00be\u00c6\u00be\u00d7 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b6\u00c7\u00b8\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6\u00d7) ;\n\n(ii)1980 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 27 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00ac\u00b9\u00c6\u00b9\u00ce\u00b8\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c6\" \u00a7\u00b9\u00c7\u00bb+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00ac\u00bf\u00b4\u00b6+\u00c6\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ac\u00b9\u00c6\u00b9\u00ce\u00b8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c6\"\u00a7\u00b9\u00c7\u00bb+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00ac\u00bf\u00b4\u00b6+\u00c6\u00af\u00bf\u00c6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u008a\u00b8\u00c7\u00be\u00c6 \u00b1\u00c7\u0081\u00de\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00e0\u00ba\u00c6 \u00ac\u00bf\u00b4\u00b6+\u00c6\u00af\u00e0\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b4 (\u00ac\u00b9\u00c6\u00b9\u00ce\u00b8\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c6 \u00b6\u008c\u00bc\u00c6\u00b7\u00c6\u00b6) \u00ba\u00dd\u00b7\u00c6\u00d7 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00e0\u00ba\u00c6\u00ac\u00bf\u00b4\u00b6+\u00c6\u00af\u00e0\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00bf\u00b4\u00b6+\u00c6\u00af\u00bf\u00c8\u0081 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00b8 \u00f2\u00be\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00e0\u00ba\u00c6 ;\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c626\n\n(iii) \u00a4\u00dc\u00bc\u00c6\u00cd\u00c1\u00b6 \u00c1\u00ce\u00af\u00ce\u00bb\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b7\u00c6\u00b6 \u00a3\u00be\u00c6\u00be\u00d7 (\u00ac\u00b9\u00c6\u00b9\u00ce\u00b8\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00c7\u00b6) \u00a4\u00dc\u00bf\u00c6\u00cd\u00c1\u00b6\u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00ce\u00bf\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b7\u00c6\u00b6 \u00a4\u00dc\u00bf\u00c6\u00cd\u00c1\u00b6 \u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00dc\u00b8\u00c7\u00b8\u00c8\" \u00b1\u00c8\u00b6\u00c6\u00b6\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00bb \u00a3\u00be\u00c6\u00be\u00d7 (\u00ac\u00b9\u00c6\u00b9\u00ce\u00b8\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00c7\u00b6) \u00cd\u00c4\u00c7\u00ba\u00c8\u00cd\u00bb\u00c7\u00b9\u00b6\u00c8 \u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8 \u00f2\u00be\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c6 ;\n\n(iv) \u00c1\u00c7\u00d9{\u00bc\u00c6\u00b6\u00c8\u00af\u00bf\u00c6\" \u00a7\u00be+\u00c6\u00d0 \u00c1\u00c7\u00d9{\u00bc\u00c6\u00b6\u00c8\u00af\u00bf\u00c6\" \u00db\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00bf\u00c6\"\u00ce\u00c1\u00bc+\u00c6\u00af\u00bf\u00c6 \u00a5\u00bb\u00bd\u00c6\u00ce\u00af\u00bb\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b1\u00bb\u00bd\u00c6\u00ce\u00af\u00bb\u00c7\u00b8\u00a3\u00dd+\u00c6\u00af\u00bd\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00ba\u00dd\u008c\u00bb \u00a3\u00dd+\u00c6\u00af\u00bd\u00c6\u00af\u00bf\u00c6\"\u00ce\u00c1\u00b6\u00c6\u00d7{\u00bf\u00c6\" \u00a3\u00dd\u00ba\u00c6 \u00a7\u00cd\u00be\u00c7\u00af+\u00c6\u00af\u00bf\" \u00a3\u00dd\u00ba\u00c6 \u00a7\u00cd\u00be\u00c7\u00af+\u00c6\u00af\u00bf\u00c6\u00cd\u00b6\u00c7\u00bb\u00c6\u00b7\u00c6\u00b6 \u00a7\u00cd\u00be\u00c7\u00af+\u00c6\u00af\u00bf\u00c6\" \u00b6+\u00c6\u00af \u00b7\u00c7\u00b5\u00bb+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00cc\u00b9\u00c7\u00bd\u00c8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00d0\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00b9\u00af\u00bc\u00b5\u00ba\u00c6 \u00a9\u00b6\u00b8\u00c8\u00b8\u00d7\u00ba\u00c6\u00b6\u00bd\u00c6\u00af\u00c7\u008b\u00af \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c7\u00af\u00b9\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb \u00a3\u00be\u00c6\u00be\u00d7\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00d9\u00b4\u00c6\u00b9 \u008c\u00bf\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c7\u00af\u00b9\u00c6\u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4 \u00cd\u00c1\u00ae\u0088\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c6 ;"
  },
