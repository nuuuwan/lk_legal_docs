    "chunk_text": "(1) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0\u201c\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ba\u00eb\u00be\u00a8\u00b4 \u00a1\u00b6\u00ea \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00c8\u00e0\u00c2\u00f3 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4 \u00c6\u00b4\u00ef\u00ba\u00e0\u00cc\u00c0\u00c6\u00be \u00c8\u00bc \u00c3\u00e5\u00b8\u00e0\u00b6 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00c9\u00c8 \u00cc\u00e8\u00b4 \u00a6\u00cd\u00fa\u00a1\u00c9\u00cc\u00e5\u00be\u00c6 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c2003 \u00b0\u00ec\u00c8\u00e8 \u00c4\u00cc 1 \u00c9\u00be\u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9, \u00a6\u00ef\u00cd\u00ba\u00e0 2004 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00b4\u00c0\u00f2\u00bb\u00c4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00be \u00c8\u00bc \u00a8\u00c8\u00e0\u00c2\u00f3 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00c0\u00c6\u00be\u00c8\u00bc \u00c3\u00e5\u00b8\u00e0\u00b6 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ef\u00c6\u00bc\u00c9\u00ea\u008a \u00c2\u00bc\u00e0\u00bc, \u00a6\u00c9\u00e6\u00be\u00f8 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00cc\u00bf\u00cd\u00e5\u00a1\u00c6\u00a8\u00c7\u00be \u00c2\u00bc\u00e0\u00bc \u00cc\u00e8\u00c6\u00c6\u00b4 \u00bc\u00cd\u00c6\u00b4 \u00c9\u00e6\u0091\u00c9\u00ea\u00c9\u00ba\u00e0, \u00cc\u00e8\u00c6\u00c6\u00b4 \u00bc\u00cd\u00c6\u00a8\u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00a1\u00b6\u00ea \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00a1\u00be\u00ea\u00c9 \u00aa\u00b8\u00be\u00c6 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6:\n\n\u00ef\u00c4\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 _\n\n\u201c \u00ef\u00c8\u00e5\u00d6\u00c6\u201d \u00cc\u00cd \u201c \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00ef\u00a8\u00e5\u00e0\u0083 \u00c7\u00bb\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0,(203 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be \u00c0\u00be\u00ef\u00ba\u00e0\u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00e8\u00be\u00e0 \u00a6\u00c4 \u00ef\u00c6\u00f3\u008a\u00c9\u00c8 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00a1\u00da\u00bb\u00c6 \u00c4\u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6;\n\n\u201c \u00c9\u00e6\u00aa\u00be\u00e0 \u201d \u00c6\u00be \u00ef\u00c6\u00f3\u00c4\u00b4 1995 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0\u00c0\u00be\u00ef\u00ba\u00e0 \u00a3\u00b4 \u00c8\u00c2\u00e5 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00a1\u00da\u00bb\u00c6 \u00c4 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6.\u201d\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e022 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e021\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2004 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba6\n\n(2) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(4) \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00a2\u00b6\u00c4 \u00cd\u00e5 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8, \u00a8\u00eb\u00c8\u00e9 \u00be\u00f8\u00c9\u00e6\u00cc\u00e8 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4 \u00a1\u00be\u00ea\u00c9,\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00c2\u00bc\u00e0\u00bc\u00b4 \u00f3\u00be\u00e0 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00e0\u00a2\u00b6\u00ef\u008a \u00cc\u00cd \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00ef\u00c8\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c0\u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00bf\u00cd\u00e5 \u00bc\u00c7\u00be\u00c8\u00bc \u00c6\u008a \u0097\u00c6\u00bc\u00c4\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8 \u00ef\u00c6\u00bc\u00c9\u00ea\u008a \u00c2\u00bc\u00e0\u00bc\u00a8\u00b4\u00cd\u00fa\u0095\u00a8\u008a \u00a8\u00f8\u00c6\u00e5 \u00cc\u00e8\u009b\u00c4\u00b4 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00c6 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00c9\u00ea\u00c9 \u00bc, \u00c0\u00ce\u00c4\u00ea \u00a8\u00f9\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u009b\u00c4\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4 \u00ba\u00f8\u00ef\u00c2\u00be\u00ef\u00c6\u00bc\u00c9\u00ea\u008a \u00c2\u00f3 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00b4 \u00cd\u00e6\u00a8\u00f8\u00c9\u00be\u00ea \u00c0\u00e8\u00b8\u00e8\u00cc, \u00a7\u00cd\u00ea\u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be \u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00ba\u00e0 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00cc\u00e6\u00c0\u00c6\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00c4\u00a2\u00b6\u00ef\u008a \u00cc\u00cd \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00e8\u00c8\u00e0\u00ef\u00c8\u00e0 \u00cc\u00c0\u00c6\u00be \u00ef\u00cc\u00e0\u00c9\u00e5\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4 \u00a8\u00eb\u00c8\u00e9 \u00be\u00f8\u00c9\u00e6\u00cc\u00e8 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00c0\u00c9\u00ba\u00f8\u00be \u00a8\u00e5\u00c8\u00c6 \u00ba\u00eb\u00ce \u00bc\u00c7\u00be \u00c8\u00bc \u0097\u00c6\u00bc\u008a \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be \u00ef\u00c6\u00bc\u00c9\u00ea\u008a \u00c2\u00f3\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u009b\u00c4\u00b4 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4 \u00ba\u00f8\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\u201d\n\n(3) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (5) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00c9\u00c8 \u00cc\u00e8\u00b4 \u201c\u00a7\u00cd\u00ea\u00b4 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6\u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6. \u201d\u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014"
