    "chunk_text": "\u00a6\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e5\u00a8\u00c7 \u00cd\u00e6\u00d7\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c.\n\n6.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 10 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6, \u00a6\u00cd\u00fa (2), (3), (4), (5),(6), (7), (8) \u00cc\u00cd (9) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00ef\u0089 :_\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e010 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2004 \u00a1\u00e2\u00a8 1 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba6\n\n(3) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 9 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (3) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00aa\u00d1\u008a\u00c9\u00c8\u00b4 \u00a1\u00c4\u00ba\u00c7\u00c9, \u00a6\u00c4 \u00a1\u00ef\u00c8\u0097\u00a8\u00e5\u00c7 \u00cc\u00ee\u00b0\u00ea\u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00aa\u00fa\u00b8\u00ea\u008a\u00c9\u00c8, \u00a6\u00c4 \u00a8\u00c8\u00e0\u00c0\u00e8\u00d7\u00ef\u008a \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00c6\u008a \u00cc\u00cd\u00ba\u00f8\u00a8\u00c7\u00cd\u00fa\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00a1\u00c6\u00fa\u00ba\u00e8\u00a8\u00c7\u00e6 \u00ef\u00c8\u00cc \u00a6\u00e0 \u00a1\u00ef\u00c8\u0097\u00a8\u00e5\u00c7 \u00cc\u00ee\u00b0\u00ea\u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00c6\u008a \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00e5\u00da\u00ba\u00e5\u00aa\u00ba\u00c9 \u00cc\u00e8\u009b \u00bc \u00a6\u00c4\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00b4 \u00cd\u00fa\u0095 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00c7\u00cd\u00fa\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0\u00c9\u00c8 \u00a8\u00c8\u00e0\u00c0\u00e8\u00d7\u00ef\u008a\u00c4\u00ea\u00bc\u00c8 \u00cc\u00ee\u00b0\u00ea \u00a1\u00ef\u00c8\u0097\u00a8\u00e5\u00c7 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6\u00b4 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) \u00a1\u00ef\u00c8\u0097\u00a8\u00e5\u00c7 \u00cc\u00ee\u00b0\u00ea \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00be\u00e5\u00c9\u00be \u00a8\u00f8\u00cc\u00e8\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0, \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00c7\u00cd\u00fa\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7\u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6. \u00cc\u00cd\u00ba\u00f8\u00a8 \u00c7\u00cd\u00fa\u00ba\u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00f2 \u00c0\u00e6\u00c9\u00d7\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00c4\u00be\u00e0 \u00ef\u00c9\u00ba \u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00e0 \u00c8\u00c2\u00e5\u00aa\u00e6\u00be\u00f9\u00c4\u00b4\u00a1\u00ef\u00c0\u00e0\u00a8\u00e0\u00cb\u00e5 \u00a8\u00c7\u00be, \u00cc\u00ee\u00b0\u00ea \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00cc\u00cd \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00ef\u00be\u00e5\u00c9\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c6 \u00a1\u00ef\u00c8\u0097\u00a8\u00e5\u00c7 \u00cc\u00ee\u00b0\u00ea \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00c4\u00b8\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(5) \u00a1\u00ef\u00c8\u0097\u00a8\u00e5\u00c7 \u00cc\u00ee\u00b0\u00ea \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0\u00ba\u00c4 \u00a8\u00e5\u00da\u00c6 \u00cd\u00e5 \u00a8\u00da\u00ba\u00c9\u00f1 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cd\u00e5 \u00a2\u00b4\u00ea\u00a8\u00f8\u00d7\u00c4\u00b4 \u00cd\u00e6\u00a8\u00f8\u00c9\u00be\u00ea\u00c0\u00e8\u00b8\u00e8\u00cc \u00cc\u00cd \u00a6\u00cd\u00fa \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00ef\u00c9\u00ba\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00e6\u00bf\u00fb\u008a \u00a2\u00b4\u00ea\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8\u00c9\u00be\u00ea \u00c0\u00e8\u00b8\u00e8\u00cc \u00ef\u00c0\u00e5\u00ba\u00e0\u00c0\u00ba\u00e0 \u00cd\u00e5 \u00c9\u00e5\u00da\u00ba\u00e5 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6\u00cc\u00bf\u00cd\u00e5 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00ce \u00c6\u008a \u0097\u00bd\u00e5\u00be \u00a1\u00e6\u00ba\u00e0\u00be\u008a, \u00a6\u00e0\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00c9 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(6) \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00ef\u00aa\u00e0 \u00aa\u00fa\u00b8\u00ea\u00c4\u00a8 \u00bc\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00cd\u00ba\u00f8\u00a8 \u00c7\u00cd\u00fa\u00ba\u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u00c9\u00be\u00e0 \u00ef\u00aa\u00d1\u00c4\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0\u00a1\u00ef\u00c8\u0097\u00a8\u00e5\u00c7 \u00cc\u00ee\u00b0\u00ea \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00b4 \u00c8\u00e6\u00c2\u00ea\u00b8\u00ea \u0097\u00b4\u00a8, \u00a1\u00ef\u00c8\u0097\u00a8\u00e5\u00c7 \u00cc\u00ee\u00b0\u00ea\u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4 \u00c4\u00ea\u00bc\u00c8 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7 \u00ba\u00f8\u00ef\u00c2\u00be\u00c6\u008a \u0097\u00bd\u00e5\u00be\u00c6\u00a8 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a8\u00e5\u00c8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a1\u00bc\u00e5\u00ce\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00ef\u00aa\u00d1\u00c4 \u00c8\u00e6\u009f\u00c4\u00b4 \u00be\u00f9\u00ba\u00f8\u00c6 \u00a1\u00be\u00ea\u00c9 \u00cd\u00fa\u0095\u00a8\u00c4 \u00ba\u00f8\u00ef\u00c2\u00be\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c0\u00e5\u00da\u00ca\u00e0\u00c9\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ee\u00b0\u00ea \u00a1\u00ef\u00c8\u0097\u00a8\u00e5\u00c7 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6 \u00cc\u00cd\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6 \u00c0\u00e5\u00da\u00ca\u00e0\u00c9\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00c9\u00be \u00c6\u008a \u00c8\u00e8\u008d\u00ba \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(7) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00ce \u0097\u00bd\u00e5\u00be\u00c9\u00c8 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a8\u00e5\u00c8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00b4 \u00ef\u00cd\u00e5\u00e0 (6) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00cd\u00fa\u0095\u00a8\u00c4 \u00ba\u00f8\u00ef\u00c2\u00be \u00c0\u00e5\u00da\u00ca\u00e0\u00c9\u00c6\u00a8\u00b4 \u00ef\u00aa\u00d1\u008a"
