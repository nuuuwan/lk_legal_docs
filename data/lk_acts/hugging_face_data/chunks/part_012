d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb\u00b6\u00c7\u00b8\u00cc\u00b6\u00c7\u00dd \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00b6\u00ba\u00af\u00c6\u00d0 \u00db\u0081\u00da \u00cd\u00b6\u00c7\u0081\u00de\u00ba\u00c6\u00b9\u0088\u00dc\u00ba\u00c6 \u00a3\u00bd\u0096\u00b4\u00c6\u00d5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00ce\u00bb \u00a3\u00b6\u0081\u00ba\u00c9\u00d7 \u00ac\u0081\u00de\u00cd\u00b1\u00bc\u00c6\u00b7\u00c6\u00b6 \u00ba\u00c8\u00ce\u00af\u008a\u00de\u00b9\u00c6\u00b9\u00b8\u00e2\u00b4\u0081\u00cd\u00b1\u00bc\u00c6\u00b6\u00c6\u00d7 \u00ba\u00c9\u00bf\u00b9\u00c6 \u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00c1\u00dd\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af \u00a9\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c7\u00af\u00c7\u00d7 \u00a9\u0081\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00aa\u00d7\u00ce\u00c1\u00af\u00c6 \u00af\u00c7\u00b4\u00c6\u00d5\u00ba\u00c6\u00b9\u0088\u00dc\u00ba\u00c6 \u00b6\u00c1\u00ce\u00b5\u00b6\u00c1\u00de\u00b7\u00ce\u00bc\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8 \u00a3\u00ce\u00c0\u00b9\u00c6\u00b9\u00c7\u00ce\u00b5\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00a3\u00c1\u00dd\u00af\u00c6\u00d0\u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00af\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00aa\u00d7 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c7\u00ce\u00ba\u00af\u00c6\u00af\u00c7\u00b8 \u00af\u00c7\u00bc\u00b5\u00b6\u00c6\u00ce\u00b6 \u008c\u00ce\u00bf\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00a3\u00bf\u00e2\u00af\u00c6\u00d0\u00b9\u00c6\u00cd\u00b9\u00c7\u00d7\u00ba\u00c7\u00b8\u00b6\u00be\u00c6\u00be\u00cc\u00c1\u00b8 \u00b7\u00c9\u00b6\u00c8\u00c1\u00c7\u00d9\u00af\u00c6\u00d0\u00b6\u00c6 \u00cd\u00b6\u00c7\u0081\u00de\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\"\u00b7\u00c9\u00b6\u00c8\u00c1\u00c7\u0081\" \u00a3\u00b6\u00ce\u00b8\u00b9\u00c6 \u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00b6\u0089\u0081 \u00b7\u00c9\u00b6\u00c8\u00c1\u00c7\u00b8\u00c7\u00be\u00c6 \u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cc\u00b6\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6 \u00a9\u0081\u00bd\u00c7\u00bd\u00c6\u00cd\u00b9\u00c7\u0081\u00de\" \u00b6\u00c1\u00ce\u00b5\u00b6\u00c1\u00de\u00b7\u00bc\u00c8\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7 \u00b6\u00c1\u00ce\u00b5 \u00b6\u00c1\u00de\u00ce\u00af\u008a\u00be\u00c7\u00b8 \u00a3\u00bd\u0096\u00b4\u00c6\u00d5\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u00ce\u00bb\u00a3\u00b6\u0081\u00ba\u00c9\u00d7 \u00b6\u00c8\u00bc\u00ae\u00b4 \u00ba\u00c8\u00ce\u00af\u008a\u00de\u00b9\u00c6\u00b9\u00b8\u00e2\u00b4\u0081 \u00cd\u00b1\u00bc\u00c6\u00b6\u00c6\u00d7 \u00ba\u00c9\u00bf\u00b9\u00c6\u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00ce\u00bb \u00a4\u00af\u00c6\u00d0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00ba\u00c9\u00bf\u00b9\u00c6\u00cc\u00b9\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00b5\u00ba\u00c6 \u00a4\u00ce\u00b5\u00af\u00c6\u00d0\u00e1\u008c\u00b4\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a3\u00d7 \u00a3\u00b6\u00ce\u00b8\u00b6\u00c6 \u00b6\u00c8\u00bc\u00b4\u00c6\u00d5 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00c1\u00bc\u00e2\u00ce\u00c1\u00b6\u00c6\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n19\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00a5\u00b9\u00c6\u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf