    "chunk_text": "\u201c\u00c9\u00da\u00cb\u00c6\u00a8\u00b4 \u00cc\u00e8\u00c6\u00c6\u00b4 \u0097\u00cc\u00e8\u00c0\u00cd\u00a8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4;\u201d, \u00c6\u00be\u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c\u00c9\u00da\u00cb\u00c6\u00a8\u00b4 \u00cc\u00e8\u00c6\u00c6\u00b4 \u0097\u00cc\u00e8\u00c0\u00cd\u00a8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4 :\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, 2005 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4\u00c0\u00cc\u00ea\u00c9 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00ba\u00e0 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4_\n\n(\u00a1\u00e5) \u00a6\u00c4 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00fa\u00ba\u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00ef\u00be\u00e5\u00c9\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00c9\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00cc\u00e8\u00c6\u00c6\u00b4 \u0097\u00cc\u00e8\u00c0\u00cd\u00a8\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e021 \u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e023 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e021 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n102005 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(\u00a1\u00e5)\u00a6\u00c4 \u00ef\u00d9\u00bc\u00ef\u00c6\u00e0 (vi) \u00c9\u00be \u00a4\u00c0 \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c1978 \u00a1\u00e2\u00a8 41\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00c9\u00c8 \u00cc\u00e8\u00b4 \u201c\u00ba\u00eb\u00ef\u00be\u00be\u00e0 \u00ef\u00bc\u00a8\u00a8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6:\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00cc\u00e8\u00c6\u00f5\u00c4 \u00c9\u00ae\u00be \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(vi)\u00c6\u008a \u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a \u00c8\u00e6\u00c2\u00ec \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8\u00a8\u00e0 1978\u00a1\u00e2\u00a8 41 \u00bc\u00c7\u00be \u00be\u00e5\u00aa\u00d6\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c0\u00be\u00ba\u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00be\u00e5\u00aa\u00d6\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00c9\u00e5 \u00c9\u00ec\u00bc, \u00c9\u00e5\u00b8\u00e8\u00b0 \u00a6\u00e0\u00a8\u00a8\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00c3\u00e5\u0097\u00ba\u00e5 \u00a8\u00f8\u00d7\u00c4\u00cc\u00bf\u00cd\u00e5 \u00a2\u00bc\u00fa \u00a8\u00c7\u00be \u00c8\u00f3\u00c9 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc,\u00cc\u00cd\u00e5\u0093\u00c0\u00ba\u00f1 \u00ef\u00bc\u00e0\u00c0\u00c8\u00a8\u00b4 \u00c6\u008a \u00a6\u00e0\u00a8\u00a8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c6\u008a \u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00a6\u00c4 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8 \u00c3\u00e5\u0097\u00ba\u00e5 \u00a8\u00ce\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00be\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00ba\u00e0 \u00c6\u008a (\u00ef\u00cd\u00e5\u00e0\u00b4\u00c8\u00e0\u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8 \u00cc\u00e2\u00a8\u00f9\u00da\u00b8\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9) \u00ef\u00cd\u00e5\u00e0\u00b4\u00c8\u00e0\u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 (\u00a8\u00e5\u00da\u0095\u00a8\u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8 \u00cc\u00e2\u00a8\u00f9\u00da\u00b8\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9) \u00c6\u008a\u00a8\u00e5\u00da\u0095\u00a8 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8\u00a8\u00e0 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba\u00c0\u00d6\u00bc\u00fa, \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u00ef\u008a \u0097\u00c6\u00bc\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00e6\u00be\u00e9\u00ef\u008a \u0097\u00c6\u00bc\u00c4 \u00c4\u00ba \u00cc\u00e8\u00c6\u00c6\u00b4 \u00cd\u00c6\u00c6\u00fa \u00ba\u00eb\u00ef\u00be\u00be\u00e0\u00ef\u00bc\u00a8\u00a8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 :\u201d; \u00cc\u00cd\n\n(\u00a1\u00e6)\u00a6\u00c4 \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00cd\u00fa \u201c(v) \u00c9\u00be\u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c9\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00ef\u008a \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201c(v) \u00ef\u00cd\u00e5\u00e0 (vi) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c9\u00c8\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(2)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00ef\u00c6\u00e0 (\u00a8)\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6\u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 (1\u00a1\u00e7) \u00a1\u00be\u00ea \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c(1\u00a1)(1\u00a1\u00e5), (1\u00a1\u00e6) \u00a1\u00be\u00ea \u00ef\u00d8\u00bc\u00c9\u00c8\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c(1\u00a1),(1\u00a1\u00e5) \u00cc\u00cd (1\u00a1\u00e6) \u00a1\u00be\u00ea \u00ef\u00d8\u00bc\u00c9\u00c8 \u00cc\u00cd \u00ef\u008a \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u201d \u00c6\u00be\u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(3)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 3 (\u00a1\u00e5) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6, (3 \u00a1\u00e5) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00ef\u00c8\u00cc \u00be\u00e6\u00c9\u00ba \u00a1\u00e2\u00a8 \u00ef\u00c6\u00bc\u00fb\u00ef\u00c4\u00be\u00e0,\n\n15.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 24 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u2013\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e024 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n112005 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(\u00a1)\u201c23 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u201d \u00c6\u00be\u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c2004 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 31 \u00c9\u00be \u00bc\u00fa\u00be\u00b4\u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 23 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd"
