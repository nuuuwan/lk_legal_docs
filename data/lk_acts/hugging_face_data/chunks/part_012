    "chunk_text": "(\u00a5) \u00c1+\u00c6\u00af\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00c8\u00b6\u00c8\u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c6 \u00ac\u0081\u00bd\u00c8\u00bd\u00c6\u00d0\u0089\u00ce\u00c0\u00bb\u00c7\u00b8 \u00b6\u00af\u00c1\u00ce\u00be \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u008c\u00dc\u00bf\u00c6\u00bf \u00a3\u00be\u00c6\u00be\u00d7\u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6 \u00b7\u00c8\u00c1\u00c7\u00bc\u00b5\u00b6\u00c6\u00ce\u00b6\u00b9\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00bf\u00c6\u00bf \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00b6\u00b8\u00c8 \u00a4\u00bf\u00c6 122\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00de \u00c1\u00b4\u00c6\u0088 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00ba\u00c9\u00d7 \u00a7\u00bc\u00c8\u00bb\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00bc\u00c8\u00dc\u00b4\u0081 \u00a3\u00b6\u0081 \u00ba\u00c9\u00b6\u00c7\u00b8 \u00d8{\u00de\u0096\u00b6\u00b6\u00ae\u00b4\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a4\u00bf\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00bc\u00c8 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b6\u00ae\u00b4\u00ba\u00c6\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c674\n\n\u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u201c\u00a5\u00ce\u00bb\u00b9\u00c7\u00b8\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00c8\u201d \u00a9\u0081\u00b9\u00d7 \u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00d5 \u00a3\u00bc\u00b1\u00c8\u00ce\u00bd \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 \u00a9\u00b8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6\u00b0\n\n44\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 129 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u0089\u00bc\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7\u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00a3\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 129\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u00c1\u00c7\u00af\u00b9\u00c6\u00b9\u00bb\u00d9\u00de\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :-\n\n129\u00a3\u00b0 \u00a5\u00c1\u00c6\u00c1\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c8\u0081\u00af\u00c9\u00c0\u00c6\u00c1+\u00c6\u00af\u00c8 \u00ac\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00c8\u00b6\u00c8\u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c6 \u00ac\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u00a9\u00d7\u00e2\u00ba\u00c6 2004\" \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8 \u00a3\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u0089\u0081\u00b8\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00af\u00c7\u00af \u00b6\u00c1\u00ce\u00b5\u00b6\u00c1\u00de\u00ce\u00af\u00bb\u00c7\u008a\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1+\u00c6\u00af\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00c8\u00b6\u00c8 \u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c6129 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00a9\u00b9\u00c6\u00b9\u0088\u008a\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6144 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (3\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00db\u00ce\u00bd\u008a\u00be\u00c6 \u00b6\u00ae\u00b4\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00c1\u00b4\u00c6\u0088 \u00ac\u0081\u00ce\u00bd \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00bc\u00c8\u00af\u00c6\u00d0 \u00cd\u00ba\u00be\u00b6\u00c8\u00af\u00ba\u00c7\u00af\u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d.\n\n45\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 130\u00a4 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00ce\u00b8\u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u0089\u00bc\u00c8\u00e2 \u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7\"\u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00a3\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 130\u00a5 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u00c1\u00c7\u00af\u00b9\u00c6\u00b9\u00bb\u00d9\u00de\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :-\n\n130\u00a5\u00b0 (1) 2004\" \u00b1\u00b8\u00c1\u00bc\u00c8 1 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u0089\u0081\u00b8\u00bc\u00c6 \u00a5\u00c1\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1+\u00c6\u00af\u00c8\u00bb\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00c8\u00b6\u00c8\u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00b4\u00c6\u0088\u008a\u008b\u00dd\u00b7\u00c6\u00d7\u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u00ce\u00bb\u00af\u00c6 \u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00dc\u00bf\u00c6\u00bf\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6129\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6\u00da\u00b6\u00c8\u00bb \u0089\u00bc\u00c8\u00ce\u00c1\u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u201c\u00b6\u00c1\u00ce\u00b5\u00b6\u00c1\u00de\u00ce\u00af\u00ba\u00c9\u00b6\u00c7\u00b8\u00b6\u00ae\u00b4\u00db\u00ba\u00c6\u00c1\u00b4\u00c6\u0088\u00dc\u00ba\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6130\u00a5 \u00a9\u00d9\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb\u0089\u00bc\u00c8\u00ce\u00c1\u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n\u201c\u00c1+\u00c6\u00af\u00c8\u00af\u00bf\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8\u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00af\u00ce\u00bf\u00b9\u00c6\u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c675\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6130\u00a6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6130\u00a7 \u00a9\u0081\u00d9\u00ba\u00c6\u00da\u00b6\u00c8\u00bb \u0089\u00bc\u00c8\u00e2\u00af\u00ce\u00bf\u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u201c\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a4\u00b4\u00c6\u00af\u00ce\u00bf\u00b9\u00c6\u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0"
