    "chunk_text": "(1) \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (xi) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00cd\u00fa (\u00a6) \u00c9\u00be \u00ef\u00d8\u00bc\u00c6\u00b4\u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(\u00a6\u00e0) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fb \u00c9\u00e5\u00b8\u00e8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8 \u00c0\u00f2\u00ba\u00f8\u00c9\u00f1\u00ea\u00cd\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5\u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4\u00c6\u00a8\u00e0\u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00a6\u00c4 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00a1\u00a8\u00f2\u00e9\u00c6 \u00b8\u00c6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00c0\u00e6\u00c9\u00d7\u00c4 ;\u201d;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00c0\u00ce\u00c4\u00ea\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2004 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba17\n\n\u201c(xxii) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00cc\u00e8\u0090\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0\u00c0\u00e8\u00b4\u00ba \u00cc\u00e8\u0090\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00cd\u00b4 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0\u00c0\u00e8\u00b4\u00ba \u00bc\u00fb \u00c0\u00d6\u00ef\u00c3\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4\u00c0\u00e8\u00b8\u00e8\u00cc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00aa\u00d1\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00cc\u00e0\u00c9\u00e5\u00cc\u00e6\u00c0\u00c6\u00ea\u00c4 ;\u201d\n\n(3) \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (xxviii) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00cd\u00fa \u201c\u00a1\u00be\u00e0\u00bd\u00c6\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5\u00cc\u00ea\u00f3 \u00cc\u00e6\u00c7\u00c6\u0090 \u00cc\u00cd \u00ef\u0089\u00f2\u00c8\u00e0 \u00c6\u00ba\u00eb\u00c7\u00e6 \u00c8\u00e8\u00c6\u00be \u00cd\u00e5 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c \u00a1\u00be\u00e0\u00bd\u00c6\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00ea\u00f3 \u00cc\u00e6\u00c7\u00c6\u0090 \u00cc\u00cd \u00ef\u0089\u00f2\u00c8\u00e0 \u00c6\u00ba\u00eb\u00c7\u00e6 \u00c8\u00e8\u00c6\u00be\u00cc\u00cd \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00bc \u00ef\u0089\u00f2\u00c8\u00e0 \u00c8\u00e8\u00c6\u00be \u00a8\u00b6\u00bc\u00e5\u00cc\u00e8 \u00cc\u00cd \u00ef\u0089\u00f2\u00c8\u00e0 \u00c8\u00e8\u00c6\u00be \u00ef\u00c2\u00e5\u00e0\u0086 \u00bc\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(4) \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (xxxiii) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(xxxiii) 1980 \u00a1\u00e2\u00a8 27 \u00bc\u00c7\u00be \u00cc\u00ea\u00c9\u00bf \u0097\u00ce\u00c9\u00ea\u00be\u00e0 \u00a4\u00c0\u00a8\u00c7\u00b8 \u00cc\u00cd\u00a7\u00f0\u00cb\u00bd \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00cc\u00ea\u00c9\u00bf \u0097\u00ce\u00c9\u00ea\u00be\u00e0\u00a4\u00c0\u00a8\u00c7\u00b8 \u00cc\u00cd \u00a7\u00f0\u00cb\u00bd \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00c7\u00be\u00c8\u00bc \u00a7\u00f0\u00cb\u00bd \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00cd\u00e5 \u00ef\u00c2\u00ef\u00cd\u00ba\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd (\u00cc\u00ea\u00c9\u00bf \u0097\u00ce\u00c9\u00ea\u00be\u00e0\u00cd\u00e6\u00c7) \u00a7\u00f0\u00cb\u00bd \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be, \u00ef\u00c2\u00ef\u00cd\u00ba\u00e0 \u00cc\u00cd \u00a6\u00c4 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00cd\u00e5 \u00ef\u00c2\u00ef\u00cd\u00ba\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00b4 \u00a1\u00c9\u00ca\u00f1 \u00a1\u00c4\u00ea\u00f7\u00c9\u00f1 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00be\u00c6\u00be\u00c6 ;\u201d\n\n(5) \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (xxxvi) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00cd\u00fa \u201c \u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8\u00c6\u00be\u00e0\u00ba\u00f2 \u00cc\u00ec\u00ba\u00f2 \u00cc\u00e6\u00c0\u00c6\u00ea\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6.\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201c\u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8 \u00c6\u00be\u00e0\u00ba\u00f2 \u00cc\u00ec\u00ba\u00f2 \u00cc\u00e6\u00c0\u00c6\u00ea\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6;\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(6) \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (xxxvi) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a1\u00c6\u00fa\u00ba\u00c4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(xxxvii) \u00c6\u008a \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0 \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00c3\u00e5\u0097\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u0097\u00ef\u00ca\u00e0\u00cb\u00ef\u00c6\u00be\u00e0\u00cc\u00e6\u00c8\u00cc\u00ea\u008a \u00a8\u00c7\u00be \u00c8\u00bc \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0 \u00c2\u00c9\u00b4 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0 \u00d1\u00ef\u008a \u00bc\u00fb \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00a6\u00e0 \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00c3\u00e5\u0097\u00ba \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u0097\u00ef\u00ca\u00e0\u00cb\u00ef\u00c6\u00be\u00e0 \u00be\u00f8\u00da\u00c4\u00e5\u00b8 \u00a8\u00c7\u00be\u00c8\u00bc\u00e0\u00bc\u00e5 \u00c9\u00ec \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n2004 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba18\n\n(xxxviii) \u00c6\u008a \u00ef\u00ef\u00c9\u00bc\u00f1 \u00c6\u00be\u00e0\u00ef\u00ba\u00f2\u00e5\u00e0\u00c0\u00a8\u00c7\u00b8, \u00ef\u00ef\u00c9\u00bc\u00f1 \u00a4\u00c0\u00a8\u00c7\u00b8 \u00ef\u00cd\u00e5\u00e0\u00aa\u00fa\u00c8\u00be\u00e0\u00c7\u00bb\u00c6\u00a8\u00e0 \u00c0\u00e8\u00b4\u00c7\u00b4 \u00cc\u00e8\u0090\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00cc\u00e2\u0097\u00bd\u00e5\u00be \u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00ba\u00f1\u00e5\u00aa \u00c2\u00c9\u00b4\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00d1\u00ef\u008a \u00bc\u00fb \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4\u00c6\u00be\u00e0\u00ef\u00ba\u00f2\u00e5\u00e0\u00c0\u00a8\u00c7\u00b8, \u00ef\u00ef\u00c9\u00bc\u00f1 \u00a4\u00c0\u00a8\u00c7\u00b8 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00fa\u00c8\u00be\u00e0\u00c7\u00bb\u00c6\u00a8\u00e0\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;"
