    "chunk_text": "(iv)\u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1978 \u00a1\u00e2\u00a8 4 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ef\u00ba\u00e0 17 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00cc\u00c4\u00ad _\n\n(\u00a1) 1996 \u00c4\u00e6\u00c6\u00fa \u00c4\u00cc 16 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00ef\u00cd\u00e5\u00e0 ;\n\n(\u00a1\u00e5) \u00c4\u00ea\u00dd \u00c0\u00e8\u00d6\u00c9\u00e6\u00c6 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0095\u00c8\u00e8\u00c6\u00be 500 \u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea\u00c0\u00e8\u00d6\u00c9\u00e6\u00c6\u00a8\u00e0 \u00cc\u00cd\u00fa\u00ba \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0,1998 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00ef\u00c9\u00be\u00f8 \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7,\n\n2004 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba24\n\n(i) \u00a6\u00e0 \u00aa\u00fa\u0097\u00cc\u00ea\u00ef\u008a \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be, \u00a6\u00e0 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba ; \u00ef\u00cd\u00e5\u00e0\n\n(ii) \u00a6\u00e0 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00a8\u00c7\u00be \u00ef\u00ba\u00a8\u00e0 \u00c6\u00be \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00a8\u00c8\u00e8\u00be\u00e0 \u00a6\u00ce\u00ef\u00c5\u00be \u00bc\u00fa\u00be\u00c6 \u00bc\u00a8\u00e0\u00c9\u00e5 (\u00a6\u00e0 \u00bc\u00fa\u00be\u00c6 2003\u00ef\u00be\u00e5\u00c9\u00e6\u008a\u00c2\u00da \u00c4\u00cc 19 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00c9\u00ec \u00a1\u00c9\u00cc\u00be\u00e0 \u00aa\u00fa\u0097\u00cc\u00ea\u00ef\u008a \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00c4\u00e5\u00cc \u00ba\u00f8\u00cc\u00e0 \u00cd\u00c6\u00a8\u00b4\u00c9\u00b6\u00e5 \u00c0\u00cc\u00ea \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.) \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba,\n\n\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(v)\u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1978 \u00a1\u00e2\u00a8 4 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ef\u00ba\u00e0 17 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00cc\u00c4\u00ad \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4 \u00a6\u00ce\u00c5\u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0, \u00a6\u00e0 \u00aa\u00fa\u0097\u00cc\u00ea\u00ef\u008a \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea,\u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00cc\u00e6\u00c0\u00c6\u00ea\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00cd\u00fa \u00c0\u00c4\u00b8\u00a8\u00e0\u00ef\u00c6\u00ef\u00bc\u00be \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc\u00c9\u00f1\u00c0\u00ee\u00ba\u00f8\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c3\u00e5\u00b8\u00e0\u00b6\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00be\u00f8\u00c6\u00c4\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ef\u008a\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5\u00c0\u00ce \u00a8\u00c7 \u00ba\u00f8\u00ef\u00c2\u00be \u00cc\u00ee\u00b8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c8\u00e6\u00c6\u00fa\u00cc\u00e0\u00ba\u00eb\u00ef\u008c \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00c3\u00e5\u00b8\u00e0\u00b6\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00c3\u00e5\u00b8\u00e0\u00b6 \u2013\n\n(\u00a1) 2002 \u00a1\u00ef\u00aa\u00e5\u00e0\u00cc\u00e0\u00ba\u00eb \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3\u00ef\u00bc\u00a8\u00a8 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 ;\n\n(\u00a1\u00e5) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00c0\u00d6\u00bc\u00fa \u00a6\u00e0 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00a8\u00c7\u00be \u00ef\u00ba\u00a8\u00e0,\n\n\u00c6\u00be \u00bc\u00fa\u00be \u00ef\u00bc\u00ef\u00a8\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a6\u00ce\u00ef\u00c5\u00be \u00bc\u00fa\u00be\u00c6 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(vi)\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00bc\u00cc\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00c9\u0090\u00be\u00e5\u00a8\u00c4\u00a8\u00f8\u00be\u00e0 \u00c6\u00ea\u00ba\u00e0\u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00a1\u00c6\u00fa\u00ba\u00c4 \u00cc\u00cd \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00cc\u00e5\u008a\u00c0\u00c8\u00e0,\u00c0\u00e5\u00da\u00cc\u00c8\u00e0 \u00ba\u00e6\u00c0\u00e7\u00ef\u00c8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u201c\u00a8\u00eb\u00d6\u00c6\u00da\u201d \u00ef\u00cc\u00e0\u00c9\u00e5 \u00c4\u00aa\u00fa\u00be\u00e0\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(vii) \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00e0 \u00c0\u00e5\u0097\u0083\u008e\u00c6 \u00cc\u00bf\u00cd\u00e5 \u0097\u00ef\u00ca\u00e0\u00cb\u00ef\u00c6\u00be\u00e0\u00cc\u00e6\u00ce\u00cc\u00ea\u008a \u00a8\u00ce \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00e0 \u00a6\u00e0 \u00c9\u00e5\u00cd\u00be\u00c6 \u00c6\u008a\u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00c4 \u00c0\u00e5\u0097\u0083\u008e\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c2\u00c9\u00b4\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u00cc\u00e7\u00cd\u00e9\u00c4\u00b4 \u00c0\u00ba\u00e0\u00d1\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6\u00a8\u00f8\u00d7\u00c4 ;\n\n2004 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba25\n\n(viii) \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00c0\u00c6\u00be\u00ea\u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc, \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00a6\u00e0\u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5 \u00ef\u00aa\u00be \u00c6\u00e5\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4\u00cc\u00bf\u00cd\u00e5 \u00be\u00e6\u00c9\u00ba \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u0097\u00c4\u00cc\u00e5 \u00ba\u00ee\u00ba\u00f9\u00c6\u00fa\u00a8 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00cd\u00e5 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00c9 \u00ef\u00cd\u00e5\u00e0\u00c0\u00f2\u00e5\u00ef\u00c6\u00e5\u00e0\u00aa\u00fa\u00a8 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00c9 \u00cc\u00c0\u00c6\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00c9\u00cc\u00e6\u00c0\u00c6\u00fb\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c9\u00ca\u00f1 \u00c6\u008a \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4."
  },
