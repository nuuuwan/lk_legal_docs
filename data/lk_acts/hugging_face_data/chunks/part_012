    "chunk_text": "(5) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 20 \u00c9\u00be \u00cc\u00cd 38 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e08 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 (lxxviii) \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00cc\u00cd \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 39 \u00cc\u00cd 134 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8\u00b4\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00cd\u00c6 \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00a1\u00ba\u00f9\u00ba\u00c6\u00b4 \u00c2\u00c8\u00c0\u00e7\u00c4.\n\n\u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be \u00cc\u00cd \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 10 \u00cc\u00cd 27 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00c4\u00aa\u00fa\u00be\u00e0\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00f5\u00ba\u00f8\u00be\u00e0 16\u00a1 \u00cc\u00cd 96\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a1\u00e6\u00ba\u00eb\u00c8\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00e8\u00c6\u00f5,\u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 2005 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be \u00c2\u00c9\u00b4\u00cc\u00ce\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n44.2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ef\u00ba\u00e0 61\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00ef\u0089 :_\n\n(1)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u201c15 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00ba)\u00ef\u00d8\u00bc\u00c6\u00b4 \u00cc\u00cd 48(\u00a1)\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00cc\u00cd \u201c6(5), 20,24,\u201d \u00c6\u00be \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00e8\u00be\u00e0 \u201c48\u00a1,\u201d \u00cc\u00cd \u201c21,25,\u201d \u00c6\u00be \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(2)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u201c11 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c4\u00aa\u00fa\u00be\u00e0 \u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c12 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c4\u00aa\u00fa\u00be\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(3)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c(\u00a1) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00cc\u00cd(\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00c6\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c(\u00a1)\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(4)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (5) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0_\n\n(\u00a1)\u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c9, 10, 12, 18 \u00cc\u00cd 21\u201d\u00c6\u00be \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c10, 11, 13, 19 \u00cc\u00cd 22\u201d \u00c6\u00be\u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6 \u00a2\u00c9\u00ba\u00e0\u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(\u00a1\u00e5) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 2(2) \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00cc\u00cd 6(5)\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 15 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(\u00ba) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00cc\u00cd 3 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00e6\u00ba\u00eb\u00c8\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc (\u00a4\u00f0\u00a4\u00f0) \u00a1\u00f5\u00ba\u00e0 \u00ef\u00d8\u00bc\u00c6;\u201d;\n\n(5)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (6) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 :\u2014\n\n(\u00a1)\u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c15(2) \u00cc\u00cd (3), 17,21, 22, 23,\u201d \u00c6\u00be \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c16(2) \u00cc\u00cd (3),18, 23, 24,\u201d \u00c6\u00be \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be\u00c0\u00be\u00ef\u00ba\u00e0 61 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n332005 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(\u00a1\u00e5)\u201c131\u00a1, 131\u00a1\u00e5, 132\u00a1\u00e6\u201d \u00c6\u00be \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00cc\u00cd \u201c19, 25,28\u201d \u00c6\u00be \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00e8\u00be\u00e0 \u201c130\u00a1\u00e7,130\u00a2\u201d \u00c6\u00be \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00cc\u00cd \u201c20, 26, 29\u201d \u00c6\u00be \u00a2\u00c8\u00a8\u00e0\u00a8\u008a\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n45.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n342005 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba"
  },
