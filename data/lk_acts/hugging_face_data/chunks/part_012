    "chunk_text": "\u00ef\u00be\u00e5 \u00c8\u00c2\u00be \u0097\u00b4\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00c8\u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c0\u00d6\u00bc\u00fa \u00a1\u00e6\u00c0\u00c6\u00a8\u00f8\u00be\u00e0 \u00a6\u00c4\u00a1\u00be\u00ea\u00aa\u00f2\u00cd\u00c6 \u00cc\u00ea\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00be\u008a \u00bc \u0095\u00cc,\u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00e9 \u00c9\u00e5\u00b8\u00e8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00cd\u00fa \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c6\u008a \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00cc\u00e4\u00c0 \u00b3\u00e5\u00ba\u00f8\u00c9\u00c7\u00c6\u00a8\u00eb\u00b4 \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0\u00a1\u00be\u00ea\u00aa\u00f2\u00cd\u00c6\u00a8\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(5) \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00c8 \u00a1\u00be\u00ea\u00c4\u00ba\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c0\u00d6\u00bc\u00fa \u00a1\u00e6\u00c0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u00ea\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u0095\u00cc \u00cc\u00cd \u00a6\u00e0 \u00a1\u00be\u00ea\u00aa\u00f2\u00cd\u00c6 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fb \u00c9\u00e5\u00b8\u00e8\u00b0\u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00cc\u00c4\u00be\u00e0\u0097\u00ba \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00e6 \u00cc\u00e2\u00a9\u00f1\u00e5\u00ef\u00c9\u00be\u00e0 \u00ba\u00eb\u00ef\u00be\u00be\u00e0 \u00ef\u00bc\u00a8\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea\u00cc\u00e2\u00a9\u00f1\u00e5\u00c9\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 (\u00a1\u00bc\u00e5\u00ce \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u00cd\u00e6\u00c7) \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00e9 \u00a6\u00e0 \u00a1\u00be\u00ea\u00aa\u00f2\u00cd\u00c6\u00b4 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00c0\u00f2\u00a8\u00e5\u00ca\u00a8\u00c7\u0095\u00be\u00e0 \u00af\u00be\u00e0\u00bc\u00c6 \u00bc\u00fb\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0 \u00a1\u00be\u00ea\u00aa\u00f2\u00cd\u00c6 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u00bc \u0095\u00cc, \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00c8\u00cc \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00cc\u00e7\u00ef\u00cd\u00be\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a6\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00c6\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00b4 \u00a6\u00e0 \u00c9\u00e5\u00b8\u00e8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0\u00a1\u00be\u00ea\u00aa\u00f2\u00cd\u00c6\u00a8\u00e0 \u00cc\u00c8\u00cc\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d ;\n\n(2)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (11) \u00cc\u00cd (11\u00a1) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 : \u2014\n\n\u201c(11) (3) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 (5) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fb \u00c9\u00e5\u00b8\u00e8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00a1\u00be\u00ea\u00aa\u00f2\u00cd\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00a1\u00be\u00ea\u00aa\u00f2\u00cd\u00c6\u00a8\u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c4\u00ba \u00a1\u00c6\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6\u008a \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6\u00a8\u00e0,\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c0\u00ec\u00da\u00b8 \u00a1\u00be\u00ea\u00c4\u00ba\u00f8\u00c6 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00ef\u00c0\u00f2\u00e0\u00cb\u00b8\u00c6\u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 \u00a6\u00c9\u00e6\u00be\u00f8 \u00a1\u00be\u00ea\u00c4\u00ba\u00f8\u00c6 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00a8\u00c7\u00be\u00c8\u00bc \u00c6\u008a \u00ef\u00c0\u00f2\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00ca\u00eb\u00be\u00f1 \u00cc\u00cd \u00c2\u00c8\u00c7\u00cd\u00fa\u00ba \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n392005 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(11\u00a1) \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00ba\u00eb\u00ce \u00bc\u00fb (3) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 (5) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00e9 \u00c9\u00e5\u00b8\u00e8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c6\u008a \u00a1\u00be\u00ea\u00aa\u00f2\u00cd\u00c6\u00a8\u00e0\u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb \u00a6\u00e0 \u00a1\u00be\u00ea\u00aa\u00f2\u00cd\u00c6 \u00a6\u00e0\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00be \u00aa\u00fa\u00b8\u00ea\u008a\u00c9\u00c8 \u00cc\u00cd \u00a6\u00e0 \u00a1\u00be\u00ea\u00aa\u00f2\u00cd\u00c6\u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00ef\u00c6\u00be\u00e0 \u00c4 \u00ef\u00aa\u00c9\u00e5 \u00be\u00f8\u00c4 \u00a8\u00c7\u00be \u00ba\u00eb\u00c7\u00e6 \u00a3\u00b4 \u00c0\u00cc\u00ea\u00c9\u00a6\u00ce\u00ef\u00c5\u00be \u00cc\u00e7\u00c4 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c4 \u00c9\u00be \u00aa\u00fa\u00b8\u00ea\u008a\u00c9\u00c8\u00bc \u00ef\u00cd\u00ce\u00e8 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d.\n\n21.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 49 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00c6 \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u201c\u00c4\u00ea\u00bc\u00c8\u00e0\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c2\u00e6\u00e2\u00a8\u00eb \u00a1\u009e\u00a8\u00e0\u00cb\u00b8 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u201d \u00c6\u00be\u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n22.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 58 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a6\u00cd\u00fa (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c8\u00cc \u00be\u00e6\u00c9\u00ba \u00a1\u00e2\u00a8\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(2)\u00be\u00e6\u00c9\u00ba \u00a1\u00e2\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014"
