    "chunk_text": "(3) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u201c\u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00b7\u00c8\u00de\u00c1\u00b8\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u0081 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a8\u00c0\u00c8\u00bb\u00bc\u00c8\u0081 \u00a3\u00df\u00c1\u00be\u00af \u00db\u00ce\u00bd\u00bb\u00c7\u00b8 \u00cd\u00c1\u00b6\u00b8\u00c7\u00b6\u00c8\u00af\u00bf\u00c8\u0081\u00a3\u00ce\u00bc\u00c1\u00c7\u00b1\u00c8\u00af\u00c6\u00d0 \u00aa\u00bd\u00c6\u00bd\u00c8\u00af\u00c6\u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8\u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u201d \u00a9\u0081\u00b9\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a8\u00c0\u00c8\u00bb\u00bc\u00c8\u0081\u00cd\u00c1\u00b6\u00b8\u00c7\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00a3\u00ce\u00bc\u00c1\u00c7\u00b1\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 30 \u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u008c\u00d5\u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00c6\u00d0\u00b1\u00c6\u00b1\u00ba\u00ba\u00c7\u00b8 \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00ce\u00bb\u00af\u00c6 \u00af\u00c0\u00c8\u00b6\u00c6\u00b6\u0089\u0081\u00b8\u00bc\u00c6\u00a3\u00b6\u0081\u00ba\u00c9\u00d7 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00db\u00b6\u00be\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 1\u00a6 \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u0096\u00b6+\u00c6\u00af\u00bf\u00c8\u0081\u00b9\u0088 \u00af\u00b5\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6\n\n(4) \u00a5\u00c1\u00c6\u00c1\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u2013\n\n\u201c\u00a3\u00df\u00c1\u00be\u00af\u00db\u00ce\u00bd\u00bb\u00c7\u00b8 \u00cd\u00c1\u00b6\u00b8\u00c7\u00b6\u00c8\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7\u00ad\u00bb\u00c6\u00c1[\u00b6\u00c8\u00bb\u00ba\u00c6 \u00da\u00bd\u00b7\u00c9+\u00c6\u00af\u00be\u00c7\u00af\" \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00cd\u00b1\u00ce\u00c1\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\u00b9\u00c6 \u00cc\u00b9\u00bd\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 4 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (1 \u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00de \u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00be\u00c6 \u00b7\u00c8\u0081\u00cc\u00bd\u00e1\u00af\u00c8\u0081\u00bd\u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6\u00b0\n\n31\u00b0 2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u00af\u00ce\u00b4\u00b1\u00c8\u00bb\u00c7\u00af\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081122\u00a4 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2\" (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2 2002 \u00b7\u00cc\u00c1\u00ba\u00c6\u00b9\u00bc\u00c6 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u0081\u0089\u0081\u00b8\u00bc\u00c6 \u00a5\u00b4\u00ba\u00c6\u00cc\u00b9\u00de\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2 2002 \u00b7\u00cc\u00c1\u00ba\u00c6\u00b9\u00bc\u00c6 1 \u00a4\u00ba\u00c6\u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u0089\u0081\u00b8\u00bc\u00c6 \u00a4\u00b8\u00c7\u00be\u00c6 2005 \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c61 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u0081 \u00a5\u00b4\u00ba\u00c6\u00cc\u00b9\u00de\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6\" \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00cd\u00ba\u00df\u00ba\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u00bd\u00d7\u00b0\n\n372005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n32\u00b0 2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00af\u00ce\u00b4\u00b1\u00c8\u00bb\u00c7\u00af\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 123\u00a3\u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2\" \u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u0089\u00ce\u00b5\u00bb\u00ba\u00c6\" \u00db\u00bd\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00ae\u0088\u00bb\u00be\u00c62002 \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u0081\u00b8\u00bc\u00c6 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u008c\u00b4\u00b6\u00c6\u00d7\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00b4\u00c6\u0088 \u00c1\u00dd\u00ba\u00c7\u00b8\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u0089\u00ce\u00b5\u00bb\u00ba\u00c6\" \u00db\u00bd\u00c8 \u00a3\u00be\u00c6\u00be\u00d7\u00a7\u00ae\u0088\u00bb\u00be\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00b4\u00c6\u0088\u00c1\u00dd\u00ba\u00c7\u00b8\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7\u00b0\n\n33\u00b0 2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00af\u00ce\u00b4\u00b1\u00c8\u00bb\u00c7\u00af\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 123\u00a4\u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2\u201d\u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (3) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6\" \u201c\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cd\u00af\u00bd\u00c6\u00b9 122\u00a3 \u00a3\u00be\u00c6\u00be\u00d7 122\u00a4 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00b4\u00c6\u0088 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00bc\u00e2 \u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cd\u00af\u00bd\u00c6\u00b9 122\u00a3\u00a3\u00be\u00c6\u00be\u00d7 122\u00a4 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00cd\u00ba\u00df\u00ba\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u00bd\u00d7\u00b0"
