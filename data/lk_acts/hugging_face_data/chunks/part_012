    "chunk_text": "\u00a4\u008a\u0081\" \u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\" \u201c\u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00be\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da \u00a5\u00bb\u00af\u00c6\u00d0\u00b7\u00bc\u00c6\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7 1991 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u008125 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00be\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u008117 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00be\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b1\u00c6\u00cd\u00b1\u00ce\u00c1\u00af\u00e0\u00af\u00c6\u00d0 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00a7\u00bc\u00c8\u00ba\u00ba\u00c6\u00cc\u00b9\u00bd\u00c6\u00bd \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6\u00a5\u00bb\u00af\u00c6\u00d0\u00b7\u00bc\u00c6 \u00a9\u00b8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\n\n\u00a4\u008a\u0081\" \u00cd\u00ba\u00df\u00ba\u00c6\" 2003\" \u00ba\u00c7\u00b1\u00c6\u00d2 3 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00af\u00c8\u0081\u00bd\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00a5\u00bb\u00af\u00c6\u00d0\u00b7\u00bc\u00c6\u00af\u00bf\u00c6 \u00a3\u00bd\u0096\u00d5\"26 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00ac\u00e1+\u00c6\u00d0\u008c\u00b6\u00c8\u00af\u00bf\u00c6 \u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00af\u00c6\u00d0\u00c1\u00dd\u00ba\u00c6\u00c1\u00ce\u00bc \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u0096\u00b6\u00b9\u00c6\u00b9\u0088 \u00af\u00b5\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u2013\n\n\u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1\u00cc\u00b6\u00c7\u00ce\u00be\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00a5\u00bb\u00af\u00c6\u00d0\u00b7\u00bc\u00c6\u00af\u00bf\u00c6\u00a3\u00bd\u0096\u00b4\u00c6\u00ce\u00b4\u008c\u00b6\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 11 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00b7\u00c8\u00b6\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c617\n\n(\u00a4) 2004\" \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6\u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a4\u00ae\u0088\u0081\u00cd\u00b9\u00c7\u00d7\" \u00a7\u00bf\u00c6\u00c1\u00dd\u00ba\u00c6 \u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1\u00a3\u00ce\u00c0\u00b9\u00c6\u0089\u0081 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081 \u00b7\u00c8\u00ba\u00c8\u00b4\u00cc\u00ba\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00a3\u00cc\u00ba\u00bc\u00c8\u00af\u00c6\u00af \u00ab\u00af\u00c6\u00af\u00c8\u00bb \u00a3\u00bc\u00d2 \u00cc\u00b4\u00c7\u00be\u00bc\u00c8\u00be\u00c6 \u00ac\u0081\u00b9\u00d7 \u00b1\u00b6\u00db\u00ba\u00c6\"\u00cc\u00c1\u00bf\u00c8\u00b1\u00c6\u00cc\u00b1\u00be\u00c6\u00df\u00ba\u00c6 \u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1 \u00a3\u00ce\u00c0\u00b9\u00c6\u0089\u0081 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081 \u00b7\u00c8\u00ba\u00c8\u00b4\u00cc\u00ba\u00c7\u0081\u00de\u00af\u00c6\u00d0 \u00a5\u00be+\u00c6\u00ce\u00af \u00b7\u00c7\u00b5\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00f4\u00b9\u00c7\u00f2\u0081\u00de \u00b1\u00b6\u00ba\u00c6 \u00cc\u00b6\u00c7\u0081\u00d6{\u00de \u00a9\u0081\u00bd \u0096\u00b6\u00b9\u00c6\u00b9\u0088\u00b0\n\n(2) \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00ce\u00c1\u00b9\u00c6 \u00b9\u00bb\u00d9\u00de\u00b6\u00c6\u00d7\u00ba\u00c6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00af \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2 \u00a3\u00cc\u00ba\u00bc\u00c8\u00af\u00c6\u00af \u00ab\u00af\u00c6\u00af\u00c8\u00bb \u00a3\u00bc\u00d2 \u00cc\u00b4\u00c7\u00be\u00bc\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a5\u00be+\u00c6\u00ce\u00af\u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0 \u00ba\u00c7\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b4\u00e2\u00bf\u00c6\u00bf\u008c\u00b4\u00b6\u00c6\u00d7\" \u00a9\u00b7\u00c6\u00b6 \u00b7\u00c7\u00bf\u0081\u00de \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00b7\u00c7\u00e0\u00af\u00c6\u00d0 \u00db\u00b7\u00c6\u00b6\u00c8\u00bb \u00b7\u00c7\u00bf\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u00ba\u00b6\u00c6\u00b6\u00c8\u00bb \u00c1+\u00c6\u00af\u00c8\u00bb\u00c7\u00be\u00c6 \u00b7\u00c8\u00bc\u00c6\u00b5\u008a\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u008c\u00bd\u00c6\u00b9\u00b8\u00e2 \u00ba\u00c7\u00bd\u00c6\u00de\u0096\u00b6\u00ba\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a5\u00b7\u00c6\u00b6 \u00ba\u00c7\u00bd\u00c6\u00de\u0096\u00b6\u00ba\u00c6\u00a5\u00be+\u00c6\u00ce\u00af \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb \u00c1+\u00c6\u00af\u00c8 \u00a5\u00ce\u00b5\u00bb\u00b6\u00c6\u00b6\u00bf\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00af\u00c8\u00ce\u00b4\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00af\u00c6\u00af\u00b6\u00c7\u00af\u00e2\u00bf\u00c6\u00bf\u00d7\" \u00a3\u00b7\u00c6\u00b6\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00bf\u00c6 \u00db\u0081\u00ce\u00b8\u00bb \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00bf\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00af\u00c6\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00c7\u00b8\u008c\u00bd\u00c6\u00b9\u00ce\u00b8 \u0096\u00b6\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00bc\u00c7\u00b1\u00bc\u00c8\u00bb\u00c7\u00b8\u00d7 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n22\u00b0 (1) \u00a5\u00bb\u00af\u00c6\u00d0\u00b7\u00bc\u00c6\u00af\u00bf\u00c6 \u00a3\u00bd\u0096\u00d5\" 2003 \u00ba\u00c7\u00b1\u00c6\u00d2 3 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u008a\u00be\u00c6\u00b9\u00bb\u00d9\u00de\u00ba\u00c6 \u00c1\u00ce\u00af\u008a\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00a9\u0081\u00b9\u00d7\u00b4\u0081\" \u00a7\u00bc\u00c8\u00ba+\u00c6\u00cc\u00af\u00c7\u00bf\u00c8\u00bb\u00c7\u00b8 \u00a5\u00bb\u00af\u00c6\u00d0\u00b7\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c7\u00be\u00c6\u00c1\u00b1\u00b6\u00c8\u00bb\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00a7\u00bf\u00c6\u00c1\u00dd\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00cc\u00c1\u00bf\u00c8\u00b1\u00c6\u00cc\u00b1\u00be\u00c6\u00df\u00ba\u00c6\u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1 \u00a3\u00ce\u00c0\u00b9\u00c6\u0089\u00b8\u00d7\u00ba\u00c6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00ba\u00c9\u00d7\u00ba\u00c6\u00ac\u00e1+\u00c6\u00d0\u008c\u00b6\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u008c\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u0096\u00b6+\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00af\u00b5\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00d5\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\n\n\u00a4\u008a\u0081 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c7\u00b8\u00c1\u00bc\u00c6 \u2013\n\n(\u00a3) \u00cc\u00b9\u00dd\u00ba\u00c6\u00b9\u00c7\u00be\u00c7\u00b8 \u00cc\u00b6\u00c7\u00ce\u00be\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da \u00a5\u00bb\u00af\u00c6\u00d0\u00b7\u00bc\u00c6\u00af\u00bf\u00c6\u00a7\u00bc\u00c8\u00ba+\u00c6\u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00bf\u00c7\u00be\u00c6 \u0096\u00b6+\u00c6\u00af\u00ce\u00bf \u00ba\u00c9\u00bf\u00c7\u00bb\u00c6\u00e2 \u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6\u00b9\u0088 \u00cd\u00c1\u00ae\u0088 \u00a3\u00c1\u00dd\u00af\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u00b8\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a5\u00dd\u00b9\u00c6\u0089\u0081 \u00a3\u00b6\u00ce\u00b8 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4) \u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00d5\" \u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00be\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b1\u00c6 \u00b1\u00b7\u00c6\u00ce\u00b6\u008a\u00be\u00c6 \u00b7\u00c8\u00be\u00e2\u00ba\u00c6 \u00b7\u00c8\u00ce\u00be\u00ce\u00ba\u00af\u00ce\u00bf\u00af\u00c6\n\n\u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cc\u00af\u00c7\u00ae\u00d5\"\n\n\u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00b7\u00c8\u00bb\u00b6\u00c8\u00af\u00bf\u00c8\u0081\u00b9\u0088 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ac\u00e1+\u00c6\u00d0\u008c\u00b6\u00c8\u008a\u00be\u00c6 \u00b6\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u0096\u00b6\u00b6\u00c6\u00ce\u00b6\u00af\u00c6 \u00af\u00c7\u00be\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00af\u00c6\u00af\u00c7\u00be\u00ba\u00c6 \u00cd\u00c1\u00de\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c7\u00ba\u00c6\u00b0\n\n\u00a5\u00bb\u00af\u00c6\u00d0\u00b7\u00bc\u00c6\u00af\u00bf\u00c8\u0081\u00a3\u00bd\u0096\u00b4\u00c6\u00d5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00b0"
