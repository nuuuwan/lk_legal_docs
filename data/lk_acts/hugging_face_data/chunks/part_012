    "chunk_text": "\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\n\n2005 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00bc\u00b6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00e6\u0091\u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00be\u00ba\n\n\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00be\u00f8\u00c6\u00c4\u00c6 \u00c0\u00d6\u00bc\u00fa \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00fb\n\n[\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00ef\u00ce\u00e0 2005 \u00c4\u00e6\u00c6\u00fa \u00c4\u00cc 11 \u00c9\u00be \u00bc\u00fa\u00be]\n\n2005 \u00c4\u00e6\u00c6\u00fa \u00c4\u00cc 13 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0II \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00a1\u00ba\u00f8\u00ef\u00da\u00a8\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00ce \u00a8\u00c7\u00be \u00c8\u00bc\u00fb.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c4\u00ea\u00f7\u00b8 \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00fb.\n\n\u00ef\u00a8\u00e5\u00ce\u00c5 1, \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be \u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00ef\u00c6\u00be\u00e0 \u0095\u00ce\u00bc\u00fb \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u00c6.\u0095\u00ce : \u00c7\u00e6. 23.00 \u00c6\u00fa. \u00ba\u00e6\u00c0\u00e6\u00c8\u00e0 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 : \u00c7\u00e6. 10.00 \u00c6\u00fa\n\n2005 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00bc\u00b6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00e6\u0091\u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00be\u00ba1\n\nI \u00c9\u00be \u00ba\u00f9\u00c7\u00c6II \u00c9\u00be \u00ba\u00f9\u00c7\u00c6\n\n\u00c0\u00be\u00ef\u00ba\u00cd\u00fa \u00be\u00e5\u00c4\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6.\n\n2P L 00003911 050 (2005/02)\n\n\u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00cd\u00e5 \u00ef\u00bc\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c9\u00c8 \u00bc\u00a8\u00e0\u00c9\u00e5\u00a1\u00e6\u00ba\u00f8 \u00a1\u00e6\u00ba\u00e6\u008a \u00be\u00f9\u00ba\u00f8\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n1979 \u00a1\u00e2\u00a8 15 \u00bc\u00c7\u00be\u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea\u0097\u00bd\u00e5\u00be\u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 \u00c0\u00be\u00ef\u00ba\u00e0 11\u00cd\u00e5 14 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u00a8\u00eb\u00c4\u00a8\u00e0\u00cc\u00bf\u00cd\u00be\u00e0\u00c9 \u00ba\u00f8\u00c2\u00ea\u00b8 \u00bc\u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00b4\u00a1\u0093\u00a8\u00c7\u00b8 \u00c2\u00c8\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c2\u00c9.\n\n[\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00ef\u00ce\u00e0 2005 \u00c4\u00e6\u00c6\u00fa \u00c4\u00cc 11 \u00c9\u00be \u00bc\u00fa\u00be]\n\n\u00a6\u00c8\u00e0. \u009c._\u0081. 054/2004\n\n\u00a1\u00e6\u00ba\u00e6\u008a \u00be\u00f9\u00ba\u00f8 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c9\u00e6\u00c7\u00bc\u00fa \u00cc\u00bf\u00cd\u00e5 \u00c0\u00be\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00bc\u00b6\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00e6\u0091\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00bc \u00a6\u00e0 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00a1\u00e5\u00be\u00ea\u00cb\u00e2\u00aa\u00fa\u00a8\u00a8\u00c7\u00e6\u00b8\u00ea \u00cc\u00bf\u00cd\u00e5 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00e6\u00c8\u00e6\u00cc\u00e0\u00d1\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00bc \u00c9\u00ec \u00c0\u00be\u00ba\u00a8\u00f8.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00c4\u00ef\u00cc\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n1.\u00ef\u008a \u00c0\u00be\u00ba 2005 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00bc\u00b6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00e6\u0091\u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba\u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n2.(1) \u00a1\u00e6\u00ba\u00e6\u008a \u00be\u00f9\u00ba\u00f8 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00be\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00bc\u00b6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00e6\u0091 \u00a8\u00f8\u00d7\u00ef\u008a\u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5_\n\n(\u00a1)\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 I \u00c9\u00be \u00ba\u00f9\u00c7\u00ef\u00c6\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8\u00be\u00f9\u00ba\u00f8, \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 II \u00c9\u00be \u00ba\u00f9\u00c7\u00ef\u00c6\u00e0 \u00a1\u00be\u00ea\u00c7\u00e7\u00c0 \u00cc\u00b4\u00cd\u00ef\u00be\u00e0\u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00b4 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 ;\u00cc\u00cd\n\n(\u00a1\u00e5)\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 I \u00c9\u00be \u00ba\u00f9\u00c7\u00ef\u00c6\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8\u00be\u00f9\u00ba\u00f8\u00c9\u00c8 \u00a8\u00c9\u00c7 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c6\u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 II\u00c9\u00be \u00ba\u00f9\u00c7\u00ef\u00c6\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4, \u00a6\u00e0 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 III\u00c9\u00be \u00ba\u00f9\u00c7\u00ef\u00c6\u00e0 \u00a1\u00be\u00ea\u00c7\u00e7\u00c0 \u00cc\u00b4\u00cd\u00ef\u00be\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00c4 \u00be\u00f9\u00ba\u00f8 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n(2) 1984 \u00a1\u00e2\u00a8 40 \u00bc\u00c7\u00be \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba (203\u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c9\u00e5\u00cd\u00be \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00cd\u00fa \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be153, 156 \u00cc\u00cd 166 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8\u00b4, \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00c0\u00ce\u00c4\u00ea\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00cd\u00fa \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be, 2006 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 01 \u00c9\u00be\u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
