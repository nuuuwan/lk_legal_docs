    "chunk_text": "\u00a1\u00be\u00ea\u00c9 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00e0, \u00a7\u00b6\u00c0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0,\u00c2\u00e6\u00bf\u00e9\u00c4\u00a8\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0, \u00b8\u00c6\u00b4 \u00bc\u00fa\u00c4\u00a8\u00e0, \u00b8\u00c6\u00b4\u00aa\u00e6\u00be\u00f9\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0, \u00c8\u00e8\u008d\u00ba\u00cc\u00cd\u00ba\u00f8\u00a8 \u00cc\u00e0\u00c9\u00c7\u00e7\u00c0\u00ef\u00c6\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7\u00c2\u00e6\u00df\u008a\u00a8\u00c7 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00be\u00f9\u00ba\u00f8\u00c6\u00a8 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00c9 \u00ba\u00f8\u00c2\u00ea\u00b8 \u00bc \u00c9\u00c8\u00e2\u00aa\u00eb \u00cd\u00e5 \u00c2\u00c8\u00cc\u00cd\u00fa\u00ba \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6. \u201d.\n\n10. \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 56\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6, \u00a6\u00cd\u00fa (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(3) \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0\u00a8\u00c9\u00c7 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00bc \u00c6\u00be \u00a8\u00e5\u00c7\u00b8\u00c6\u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00ef\u00aa\u00be, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0,\u00a1\u0093\u00a8\u00c7\u00b8\u00ef\u00c6\u00e0 \u00a6\u00a8\u00ad\u00ba\u00e0\u00c9\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9, \u00a6\u00c4 \u00c9\u00c7\u00bc \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0095\u00c8\u00e8\u00c6\u00be\u00c0\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00c9\u00c7\u00ef\u00bc\u00cd\u00fa\u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00c4\u00ea\u00c8\u00f1\u00c4\u00c6\u00a1\u00c8\u00e5\u00c3\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00c8\u00f1\u00c4\u00c6 \u00c8\u00e5\u00c3\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a1\u00c8\u00e5\u00c3\u00c6\u00a8\u00e0 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00c8\u00e5\u00c3\u00c6\u00a8\u00e0 \u0097\u00bf\u00fa\u00be\u00e0\u00be\u00b4 \u00cc\u00e8\u00f3\u00d1 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4 \u00a1\u00c8\u00e5\u00c3\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e5\u00c3\u00ef\u00c6\u00e0 \u00a1\u00aa\u00c6\u00ef\u00c4\u00be\u00e0 \u00a6\u00a8\u00cd\u00c4\u00e5\u00c7\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00b4 \u00cc\u00c4\u00e5\u00be \u00c4\u00ea\u00bc\u00c8\u00e0\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00b4 \u00cc\u00c4\u00bb\u00c6\u00b4 \u00c0\u00ba\u00e0 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(4) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00c4\u00bb\u00c6\u00b4 \u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00be\u00f8\u00ef\u00bc\u00e5\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00ef\u00c8\u00cc \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e056\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2004 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00cc\u00e0\u00a8\u00be\u00e0\u00bd \u00cd\u00e5 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba12\n\n11.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 58 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1) \u201c\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00cd\u00fa \u00a1\u00da\u00bb \u00a8\u00bb\u00be\u00c6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4, \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00da\u00bb \u00a8\u00bb\u00be\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00be, \u00a1\u00ef\u00c8\u0097\u00a8\u00e5\u00c7 \u00cc\u00ee\u00b0\u00ea \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u00c6\u00ef\u00bc\u00be \u0097\u00b4, \u00a6\u00e0 \u00a1\u00ef\u00c8\u0097\u00a8\u00e5\u00c7 \u00cc\u00ee\u00b0\u00ea\u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00c7\u00cd\u00fa\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00c7 \u00c2\u00e6\u00df\u008a\u00a8\u00c7\u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00c9\u00e5\u00ef\u00c6\u00e0 \u00c6\u008a \u00c2\u00e6\u00bf\u00fa\u00c6\u00e5\u00c9\u00a8\u00e0 \u0095\u00c8 \u00bc\u00fb \u00aa\u00be\u00e0\u00be\u00e5 \u00ef\u00cd\u00e5\u00e0 \u0097\u00a8\u00eb\u00b8\u00be\u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00c7\u00be\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c2\u00e6\u00df\u008a\u00a8\u00c7 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00e0\u00c9\u00e5\u00ef\u00c6\u00e0\u00c6\u008a \u00c2\u00e6\u00bf\u00fa\u00c6\u00e5\u00c9\u00a8\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00ef\u008a\u00cd\u00e6\u00a8\u00f8\u00c6\u00e5\u00c9 \u00aa\u00e6\u00be \u00a6\u00e0 \u00a1\u00ef\u00c8\u0097\u00a8\u00e5\u00c7 \u00cc\u00ee\u00b0\u00ea \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6 \u00cc\u00c4\u00ad\u00c0\u00f2\u00c4\u00be\u00e0\u00ba\u00f2\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00a2\u00be\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0\u00c9\u00be \u00a1\u00ba\u00c7, \u00c0\u00bc \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00c6 \u00a1\u00be\u00ea\u00c9 \u00a1\u00c9\u00ca\u00f1 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8 \u00bc\u00fb \u00a6\u00e0\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00be\u00f9\u00ba\u00f1\u00be\u00ea\u00a8\u00ed\u00c8 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00ef\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00c2\u00ec\u00bc\u00c8\u00ef\u00c6\u00e0 \u00be\u00f9\u00ba\u00f1\u00be\u00ea\u00a8\u00ed\u00c8 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00b0\u00e8\u00ba\u00ef\u00c6\u00a8\u00e0\u00a3\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c. \u201d\n\n(2) \u201c\u00c4\u00ea\u00bc\u00c8\u00e0 \u00be\u00f9\u00ba\u00f8 \u00c0\u00be\u00ba\u201d \u00c6\u00be \u00ef\u00c6\u00f3\u00ef\u00c4\u00cd\u00fa \u00a1\u00da\u00bb \u00a8\u00bb\u00be\u00c6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00da\u00bb \u00a8\u00bb\u00be\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014"
