    "chunk_text": "2\u00b0 \u00a4\u008a\u00bc\u00b6\u00c6\u00d7\u00b6\u00c6 \u00cc\u00b6\u00c7\u00bf\u00c7\u008a\u00bc\u00b6\u00c6\u00d7 \u00a9\u00e1\u00b9\u00b6\u00c6\u00cc\u00b6\u00c7\u0081\u00b9\u00b6\u00c7\u00ba\u00c6 \u00a4\u00ae\u0088\u00812 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b6\u00c6 \u00cd\u00b6\u00b1\u00c8\u00bb \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00c1+\u00c6\u00af\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c7\u00be\u00c6 \u00af\u00cc\u00b1\u00bd\u00c6\u00bd\u00c8\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008a\u0081 \u00f2\u00be\u00ba\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7(\u00a5\u00d7 \u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00b8\u00bc\u00c6 \u201c\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u201d \u00a9\u00b8\u00af\u00c6\u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00b7\u00c9\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cd\u00b6\u00b6\u00c8\u00bb\u00c7\u00b8\u00d7\" \u00a3\u00bc\u00b1\u00c8\u00bb\u00be\u00ce\u00ba\u00b9\u00c6\u0089\u0081 79 \u00a4\u00ba\u00c6 \u00a7\u00de\u00b9\u00c6\u00da\u00ce\u00bc\u008a\u0081\u00af\u00c9\u00c0\u00c6\u00b1\u00b9\u00c7\u00b7\u00c7\u00bb\u00af\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00cc\u00ba\u00c7\u0081\u00bd\u00c7\u00af \u00b1\u00b4\u00c6\u00b4\u00f2\u00be\u00ba\u00c6\u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00a4\u00de \u00ba\u00c7\u00b6+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6\u0089\u00b7\u00c6\u00b6\u00c7\u00b6 \u00ac\u00dd \u00cd\u00b6\u00b6\u00c8\u00bb\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u00b6\u00c6 \u00cd\u00b6\u00b1\u00c8\u00bb\u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00c1+\u00c6\u00af\u00c8\u00ce\u00bb\u00b9\u00c6\u00b9\u00af\u00c8\u00bc+\u00c6\u00af\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00af\u00b9\u00c6\u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0\n\n22005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 1 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b6\u00c6 \u00cd\u00b6\u00b1\u00c8\u00bb\u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00c1+\u00c6\u00af\u00c8 (\u008c\u00ce\u00bf\u00c1\u00c7\u00b7\u00c6 \u00b6\u0081\u00ce\u00ba\u008a\u00b8\u00c1\u00c7\u00b8\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(2) \u00a4\u008a\u00bc\u00b6\u00c6\u00d7\u00b6\u00c6\u00cc\u00b6\u00c7\u00bf\u00c7\u008a\u00bc\u00b6\u00c6\u00d7 \u00a9\u00ae\u00b9\u00b6\u00c6\u00b6\u00c8\u00cc\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a4\u00ae\u0088\u008117 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00b4+\u00c6\u00af\u00c8\u00dc\u00bf\u00c6\u00bf \u00a9\u00d7\u00a9\u00c1\u00c6\u008c\u00b6\u00ba\u00c8\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6 \u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00bc\u00c6\" (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00af\u00c9\u00c0\u00c7\u00b8 \u00b9\u00b5\u00c8\u00b9\u00c6\u00ce\u00b9\u00b9\u00c6 \u00cc\u00b9\u00bd\u00c6\u00bd\u00b6\u0081\u00cd\u00ba\u00be\u00c6 -\n\n(\u00a3) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00af\u00c9\u00c0\u00c7\u00b8 \u00b9\u00b5\u00c8\u00b9\u00c6\u0089\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b9\u00bb\u00bc\u00c8\u00be\u00c6\" \u00cd\u00ba\u00bd\u00c6\u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 15 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00af\u00c9\u00c0\u00c6 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00c7\u0081\u00bd\u00b6\u00cc\u00c0\u00c7\u0081\u00ce\u00bd\u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a4) \u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b9\u00d5 \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00af \u00a5\u00be+\u00c6\u00ce\u00af\u00b6\u00c6 \u00cd\u00b6\u00b1\u00c8\u00bb\u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00c1+\u00c6\u00af\u00c8\u008a\u0081 \u00cc\u00b6\u00c7\u00c0\u00c8\u00ce\u00be\u00af\u00c6 \u00ce\u00af\u00cd\u00bb\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u00d5\u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00af\u00c9\u00c0\u00c7\u00b8\u00b9\u00b5\u00c8\u00b9\u00c6\u0089\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b9\u00bb\u00bc\u00c8\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af\u00af\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de(\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u201c\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cc\u00b6\u00b8 \u00cc\u00c1\u00bf\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8 \u00af\u00cc\u00b1\u00bd\u00c6\u00bd\u00c8\u00be\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00cc\u00c1\u00bf\u00c8\u008a\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n4\u00b0 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7\" 1979 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u00812 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b6\u00c6 \u00cd\u00b6\u00b1\u00c8\u00bb \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00c1+\u00c6\u00af\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00812 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00b8\u00c7\u00be\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00be+\u00c6\u00ce\u00af\u00b6\u00c6 \u00cd\u00b6\u00b1\u00c8\u00bb \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00c1+\u00c6\u00af\u00c8\u008a\u0081 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\" 3 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00af\u00c9\u00c0\u00c6\u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008a\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00c6\u00d0\u00db\u00e1\u00ce\u00ba\u00bb\u00c7\u00af \u00a7\u00bc\u00c8\u00b6\u00c6\u00b6\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n5\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 2 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00af\" 1979 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 2 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b6\u00c6 \u00cd\u00b6\u00b1\u00c8\u00bb\u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00c1+\u00c6\u00af\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00b7\u00c9\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u0081\u00cd\u00ba\u00be\u00c6\"\u2013\n\n(\u00a3)\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0 \u00cd\u00b7\u00bc\u00c6\u00db\u00bd\u00c6\u00cd\u00b9\u00c7\u00b7\u00c6\u00b6 \u00b7\u00c7\u00bf\u0081\u00de\u00bf\u00c6\u00bf\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a5\u00be+\u00c6\u00ce\u00af\u00b6\u00c6 \u00cd\u00b6\u00b1\u00c8\u00bb \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00c1+\u00c6\u00af\u00c8\u008a\u0081 \u00b9+\u00c6\u00d0 \u00f2\u00be\u00b6\u00b8\u00ba\u00c6\" \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u008a\u00df\u00bf\u00c6\u00bf\u00c1\u00c7\u00bd\u00c7\u00b8 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00b9+\u00c6\u00d0\u00f2\u00be\u00b6\u00b8\u00ba\u00c7\u00af\u00af\u00c6\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\n\n\u00a5\u00be+\u00c6\u00ce\u00af \u00cd\u00b6\u00b1\u00c8\u00bb\u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00c1+\u00c6\u00af\u00c8\u008a\u0081\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\"\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00c6\u00d0\u00a7\u00bc\u00c8\u00b6\u00c6\u00b6\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00b0\n\n\u00b7\u00c8\u00ce\u00be\u00cc\u00b9\u00bb\u00bc\u00c6 \u00af\u00c7\u00be\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00b0"
  },
