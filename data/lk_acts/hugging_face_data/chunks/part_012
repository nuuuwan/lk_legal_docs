    "chunk_text": "\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00bc\u00cd\u00cc\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00c0\u00cd\u00ef\u00ce\u00e5\u00cc\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ba\u00eb\u00be\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00cd\u00ef\u00ce\u00e5\u00cc\u00e0\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n2005 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00bc\u00b6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00e6\u0091\u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00be\u00ba26\n\n\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\nI \u00c9\u00be \u00ba\u00f9\u00c7\u00c6II \u00c9\u00be \u00ba\u00f9\u00c7\u00c6III \u00c9\u00be \u00ba\u00f9\u00c7\u00c6\u00c0\u00be\u00ef\u00ba\u00cd\u00fa \u00be\u00e5\u00c4\u00c6\u00bc\u00e6\u00be\u00b4 \u00ef\u00c6\u00ef\u00bc\u00be \u00c9\u00ae\u00be\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c9\u00ae\u00be\n\n1988 \u00a1\u00e2\u00a8 36 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba 1971 \u00a1\u00e2\u00a8 20 \u00bc\u00c7\u00be \u00ef\u00c9\u00ef\u00ce\u00bf \u00be\u00e6\u008c\u00c0\u00be\u00ba\n\n1992 \u00a1\u00e2\u00a8 33 \u00bc\u00c7\u00be \u00c0\u00ba\u00c8\u00e0 \u00cd\u00e5 \u00a9\u00be\u00f8\u00b0 \u00f7\u00c9\u00f1\u00c0\u00be\u00ba\n\n2000 \u00a1\u00e2\u00a8 53 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba 1980 \u00a1\u00e2\u00a8 47 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c0\u00e5\u00d6\u00cc\u00d6\u00a8\u00c0\u00be\u00ba\n\n1980 \u00a1\u00e2\u00a8 45 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba 1971\u00a1\u00e2\u00a8 47 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u008e\u00ba\u00f2\u00c0\u00b4 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00ba\n\n1993 \u00a1\u00e2\u00a8 50 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c4\u00e6\u00b8\u00e8\u00a8\u00e0 \u00cd\u00e5\u00cc\u00e0\u00c9\u00da\u00b8\u00e5\u00c3\u00c7\u00b8 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba1988 \u00a1\u00e2\u00a8 3 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a4\u00c7\u00e6\u00c4\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c0\u00f2\u00ef\u00bc\u00e0\u00ca \u00c0\u00be\u00ba\n\n2003 \u00a1\u00e2\u00a8 38 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba 1979 \u00a1\u00e2\u00a8 45 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c9\u00ba\u00eb\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00a1\u00e5\u00c6\u00ba\u00be \u00c0\u00be\u00ba\n\n1983 \u00a1\u00e2\u00a8 25 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba (180 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00c0\u00ea\u00c9\u00ba\u00e0\u00c0\u00ba\u00e0\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00bc\u00cd\u00cc\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0097\u00cc\u00e8\u00c0\u00be\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cd\u00e5 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00c0\u00b8\u00cc\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00bc\u00cc\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00c8\u00a8\u00e0\u00cb\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ba\u00eb\u00be\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ba\u00f8\u00cc\u00e0\u00bc\u00cd\u00cc\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cd\u00c6\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cd\u00e6\u00b4\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00cd\u00ef\u00ce\u00e5\u00cc\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00a6\u00a8\u00e0\u00c8\u00a8\u00e0\u00cb \u0097\u00cc\u00e8\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n2005 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00bc\u00b6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00e6\u0091\u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00be\u00ba27\n\n\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6I \u00c9\u00be \u00ba\u00f9\u00c7\u00c6II \u00c9\u00be \u00ba\u00f9\u00c7\u00c6III \u00c9\u00be \u00ba\u00f9\u00c7\u00c6\n\n\u00c0\u00be\u00ef\u00ba\u00cd\u00fa \u00be\u00e5\u00c4\u00c6\u00bc\u00e6\u00be\u00b4 \u00ef\u00c6\u00ef\u00bc\u00be \u00c9\u00ae\u00be\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c9\u00ae\u00be\n\n(17 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00bc\u00fa\u00c9\u00ea\u00c7\u00e6\u008a \u00cd\u00e5 \u00c0\u00f2\u00ba\u00f8\u00b3\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n\u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1973 \u00a1\u00e2\u00a8 23 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0\u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba (90 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00a4\u00a8\u00cc\u00e0\u00ba\u00e6\u00db\u008c\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n(371 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00aa\u00eb\u00c9\u00be\u00e0 \u00be\u00f8\u00c6\u00c4\u00ea\u00c9\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n1999 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba (447 \u00c9\u00be\u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ca\u00e5\u00a8 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n(190 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ba\u00e6\u00c0\u00e6\u00c8\u00e0 \u00a8\u00e5\u00da\u00c6\u00e5\u00c8 \u00a1\u00e5\u00b3\u00e5 \u00c0\u00be\u00ba\n\n1971 \u00a1\u00e2\u00a8 18 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba 1957 \u00a1\u00e2\u00a821 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00b0 \u00a1\u00cc\u00a8\u00e0\u00b3\u00ba\u00e5 \u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00ef\u008a \u00c0\u00be\u00ba\n\n(24 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00c9\u00e6\u00c7\u00bc\u00fa\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00c0\u00d6\u00c9\u00e5\u00cc\u00c6\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n1998 \u00a1\u00e2\u00a8 20 \u00bc\u00c7\u00be \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00a1\u00e5\u00c6\u00ba\u00be \u00ba\u00eb\u00ce \u00be\u00c9\u00a8\u00c9\u00bc\u00c6 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c9\u00c8 \u00c0\u00f2\u00ae\u00b8\u00e0\u00b6 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00ef\u008a\u00c0\u00be\u00ba\n\n1958 \u00a1\u00e2\u00a8 41 \u00bc\u00c7\u00be \u0095\u00ba\u00f1\u00e5 \u00bc\u00ee\u00cb\u00e0\u00b5\u00fc\u00a8 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n1996 \u00a1\u00e2\u00a8 28 \u00bc\u00c7\u00be \u00ca\u00e5\u00d7\u00d6\u00a8 \u00a1\u00e5\u00c2\u00e5\u00bd \u00a1\u00e6\u00ba\u00f8\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba"
  },
