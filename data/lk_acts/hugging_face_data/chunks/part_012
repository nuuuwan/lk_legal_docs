    "chunk_text": "2003 \u00a1\u00e2\u00a8 34 \u00bc\u00c7\u00be \u00a8\u00eb\u00b6\u00e5 \u00ef\u00ba\u00e0 \u00c9\u00ba\u00eb \u00cc\u00e2\u00c9\u00da\u00bd\u00be(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba2\n\n\u00ef\u00c8\u00cc \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8\u00ef\u00ba\u00e0 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00ca\u00e5\u00c8\u00e5 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00e2\u00aa\u00c4\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00ef\u00ba\u00e0 \u00cc\u00e2\u00aa\u00c4\u00c6 (\u009b.\u00a6\u00e0. \u00a6\u00cc\u00e0.\u00a6\u00c8\u00e0.) \u00a1\u00c4\u00ba\u00e5 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00ef\u00ba\u00e0 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00ca\u00e5\u00c8\u00e5\u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00ef\u00c6\u00a8\u00e0 ;\n\n(v)\u00c9\u00e6\u0097\u00c8\u00e8 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u0097\u00cb\u00c6 \u00c3\u00e5\u00c7\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00be\u00f8\u00da\u00be\u00e5\u00c6\u00be \u00c0\u00bc\u00be\u008a\u00ef\u00a8\u00e5\u00b4 \u00ef\u00ba\u00e5\u00e0\u00c7\u00e5\u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00cc\u0095\u00ba\u00f8\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00bc\u00ef\u00bc\u00be\u00a8\u00eb :\n\n\u00ef\u008a \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5\u201c\u00c9\u00ee\u00ba\u00e0\u00ba\u00e9\u00c6 \u00cc\u0095\u00ba\u00f8\u00c6\u00a8\u00e0\u201d \u00c6\u00be\u00e0\u00be\u00b4 (138\u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00be) \u00c9\u00ee\u00ba\u00e0\u00ba\u00e9\u00c6 \u00cc\u0095\u00ba\u00f8\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 \u00a6\u00c6\u00b4 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00a1\u00da\u00bb\u00c6\u00c4\u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6 ;\n\n(vi)\u00c9\u00e6\u0097\u00c8\u00e8 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u0097\u00cb\u00c6 \u00c3\u00e5\u00c7\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00be\u00e0 \u00ef\u00bc\u00ef\u00bc\u00ef\u00be\u00a8\u00e0 ;\n\n( vii)\u00c9\u00e6\u0097\u00c8\u00e8 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u0097\u00cb\u00c6 \u00c3\u00e5\u00c7\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00c4\u00cc\u00e5 \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00cb\u00c6 \u00c3\u00e5\u00c7\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00a6\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00ef\u00c6\u00a8\u00e0 ;\n\n(viii)(291 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00c8\u00e2\u00a8\u00e5\u00c9\u00e6\u0097\u00c8\u00e8\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00e2\u00aa\u00c4\u00c6 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c8\u00e2\u00a8\u00e5\u00c9\u00e6\u0097\u00c8\u00e8\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00e2\u00aa\u00c4\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ca\u00f2\u00e9\u00c8\u00e2\u00a8\u00e5 \u00ef\u00ba\u00e0 \u00cc\u00e2\u00aa\u00c4\u00c6 (\u009b. \u00a6\u00e0. \u00a6\u00cc\u00e0. \u00a6\u00c8\u00e0)\u00a1\u00c4\u00ba\u00e5 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a6\u00e0 \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00ef\u00c6\u00a8\u00e0. \u201d.\n\n2003 \u00a1\u00e2\u00a8 34 \u00bc\u00c7\u00be \u00a8\u00eb\u00b6\u00e5 \u00ef\u00ba\u00e0 \u00c9\u00ba\u00eb \u00cc\u00e2\u00c9\u00da\u00bd\u00be(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba3\n\n3.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 5 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u201c\u00ba\u00eb\u00be\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00c6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201c\u00c0\u00cd\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n4.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 6 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u201c\u00cc\u00e7\u00c4 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00ba\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00c4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c4 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e7\u00c4 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ef\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c4\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00ef\u0089.\n\n5.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 7 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2013\n\n(1)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2013\n\n\u201c(2) (\u00a1) \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00ba\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e0\u00ba\u00eb \u00bc\u00a8\u00e0\u00c9\u00e5-\n\n(i)4 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (vi) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00b4 \u00be\u008a \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00cd\u00e6\u00c7\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ef\u00c6\u00a8\u00e0 ;\n\n(ii)4 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (vi) \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c6\u008a \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00be\u008a \u00a8\u00ce \u00a1\u00bc\u00e5\u00ce \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0\u00a6\u00a8\u00ad\u00ba\u00e0\u00c9\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9 \u00a6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00e5\u00ef\u00aa\u00e0,\n\n\u00bd\u00ea\u00c7\u00ef\u00c6\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(\u00a1\u00e5)(1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc \u00a6\u00e0\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb, \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00be\u00f8\u00c6\u00c4\u00c6 \u00c0\u00ce \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00bd\u00ea\u00c7\u00c6 \u00a1\u00ba\u00e0\u00cd\u00e6\u00c7 \u00aa\u00fa\u00c6 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6."
