    "chunk_text": "32 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(\u00a1), (\u00a1\u00e5), (\u00a1\u00e6), (\u00a1\u00e7), (\u00a2), \u00ef\u00cd\u00e5\u00e0 (\u00a3) \u00c6\u00be\u00ef\u00d8\u00bc\u00c9\u00c8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00ef\u00aa\u00d1\u008a \u00c9\u00da\u00aa\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9\u00ec \u00bc\u00e5\u00c6\u00a8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 20\u00b4 \u00c9\u00b6\u00e5 \u00a1\u00b6\u00ea\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a, \u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00c7\u00e6. 10,00,000\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u2014\n\n\u00a3\u00c8\u00ad \u00c7\u00e6. 5,00,000 \u00c4\u00ba\u00cc\u00e8\u00c6\u00c6\u00b4 5\u00a3\u00c8\u00ad \u00c7\u00e6. 5,00,000 \u00c4\u00ba\u00cc\u00e8\u00c6\u00c6\u00b4 10\u00a2\u00ba\u00f8\u00d6 \u00ef\u00a8\u00e5\u00b4\u00cc \u00c4\u00ba\u00cc\u00e8\u00c6\u00c6\u00b4 15\n\n\u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00be\u00e6\u00ba.\n\n312005 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n42.2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00c0\u00f2\u00bd\u00e5\u00be\u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cd\u00c6\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00ba\u00c9\u00f3\u00c7\u00b4\u00ba\u00e0 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n(1)\u00a6\u00e0 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 20 \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00e0 \u201c\u00cc\u00e8\u00c6\u00c6\u00b4 15\u00a8 \u00a4\u00c0\u00d6\u00c4\u00c6\u00a8\u00b4\u00c6\u00b4\u00ba\u00e0\u00c9\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00cc\u00e8\u00c6\u00c6\u00b4 \u00bc\u00cd\u00c6\u00a8 \u00a4\u00c0\u00d6\u00c4\u00c6\u00a8\u00b4\u00c6\u00b4\u00ba\u00e0\u00c9\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(2)\u00a6\u00e0 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 23 \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c24.\u00c7\u00e5\u00b0\u00f1 \u00ef\u00be\u00e5\u00c9\u00be \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00c6\u008a\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00b4 \u00c8\u00e6\u00c2\u00ea\u00be\u00ea \u00ef\u00cd\u00e5\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8\u00e8\u00be\u00e0\u00c9\u00ec \u00c8\u00e6\u009f\u008a \u00c4\u00ba \u00c9\u00ec \u00c8\u00e5\u00c3\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00a8\u00c7\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00f3 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (96 \u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6) \u00cc\u00e8\u00c6\u00c6\u00b4 30\u201d.\n\n43.(1) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 17 (1) \u00cc\u00cd (2) \u00cc\u00cd 32 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00c4\u00aa\u00fa\u00be\u00e0\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 29 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1\u00a1) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00c6\u00b4\u00cc\u00cd (1\u00a1\u00e5) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00cc\u00cd 123\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 2002 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be\u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 37 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 132\u00a1\u00e5\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be \u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 2003 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc1 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 14 (1) (\u00a1\u00e5), 17 (3) \u00cc\u00cd (4), 26, 39, \u00cc\u00cd 40 \u00c6\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 23 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (vi) \u00a1\u00be\u00ea \u00ef\u00d8\u00bc\u00c6\u00b4 \u00cc\u00cd 29 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(\u00a1\u00a1\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (iv) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u201c\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u201d \u00c6\u00be\u00c9\u00ae\u00be\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00be\u00c6 \u00cc\u00cd 29 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(\u00a3) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00cc\u00cd 29, 72\u00a1, 144\u00a1 \u00cc\u00cd 162\u00a1 \u00c6\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8\u00b4 \u00a8\u00c7\u00be \u00c8\u00bc\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be \u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 2004 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8\u00c9\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 6(1) \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 10 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a2) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be 2005 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 1 \u00c9\u00be\u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00ec \u00ef\u00c8\u00cc \u00cc\u00ce\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(5) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 20 \u00c9\u00be \u00cc\u00cd 38 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e08 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 (lxxviii) \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00cc\u00cd \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 39 \u00cc\u00cd 134 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8\u00b4\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00cd\u00c6 \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00a1\u00ba\u00f9\u00ba\u00c6\u00b4 \u00c2\u00c8\u00c0\u00e7\u00c4."
