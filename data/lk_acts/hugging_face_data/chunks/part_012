    "chunk_text": "(3)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u201c(1) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9\u00ef\u00ca\u00e0\u00cb\u00c6\u00a8\u00e0 \u00ef\u00c9\u00ef\u00ba\u00e5\u00ba\u00e0, \u00a6\u00c6 (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00c0\u00ce\u00c4\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be\u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be)\u00c0\u00ce\u00c4\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00ce \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00b4 \u00c0\u00cc\u00ea\u00c9\u00a6\u00ce\u00ef\u00c5\u00be \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0\u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u0097\u00cc\u00e8\u00be\u00e0, \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c(1) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc\u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00ef\u00ca\u00e0\u00cb\u00c6\u00a8\u00e0 \u00ef\u00c9\u00ef\u00ba\u00e5\u00ba\u00e0, \u00a6\u00c6 (\u00ef\u00c4\u00cd\u00fa\u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00c0\u00ce\u00c4\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u00c0\u00ce\u00c4\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00ce \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00c6\u00b4 \u00c0\u00cc\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(4)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4, \u00a6\u00c4\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2\u00a1) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c8\u00cc \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n2005 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba3\n\n(5)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c(2) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00c9\u00c8 \u00cc\u00e8\u00b4 \u201c\u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00a8\u00e5\u00b4\u00cc \u00a2\u00c9\u00ba\u00e0\u00a8\u00c7 \u00a6\u00e0\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 (2\u00a1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8\u00e8\u00be\u00e0 \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00a8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa \u00a6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00ef\u008c\u00ef\u00ca\u00e0\u00cb\u00ef\u00c6\u00e0 \u00a2\u00ba\u00f8\u00d6 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00c9\u00ef\u00ba\u00e5\u00ba\u00e0 \u00a6\u00c6 (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb\u201c\u00ef\u00bc\u00c9\u00be\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u00c0\u00ce\u00c4\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00b4\u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00a6\u00ce\u00ef\u00c5\u00be \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00cd\u00c9\u00ea\u00c8\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00a6\u00c4 \u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u201d;\n\n(6)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (5) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a2\u00c9\u00ba\u00e0\u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(5) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd \u00c6\u008a \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4,\u2014\n\n\u201c\u00c6\u00b4\u00ba\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00c4\u00b4 \u00a1\u00e5\u00ef\u00c7\u00e5\u00e0\u00c0\u00b8\u00c6 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0\u00c6\u008a \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8 \u00c6\u008a \u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00c2\u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c8\u00e5\u00c3\u00c9\u00c8 \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be\u0097\u00b4, \u00c6\u008a \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00cd\u00c9\u00ea\u00c8\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8 \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00c4\u00b4 \u00a6\u00c4 \u00a1\u00bc\u00e5\u00c8 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c6\u00b4\u00ba\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00c4\u00a8\u00c9\u00c7 \u00a1\u00be\u00ea\u00c0\u00e5\u00ba\u00c6\u00a8\u00e0 \u00bc\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00bc, \u00a6\u00c4 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00a6\u00c4 \u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6 \u00c8\u00c2\u00be \u00ef\u00c2\u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c8\u00e5\u00c3\u00c9\u00c8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00b4\u00a1\u00bc\u00e5\u00ce\u00c9 \u00a3\u00b4 \u00cc\u00c4\u00e5\u00be \u00a1\u00be\u00ea\u00c0\u00e5\u00ba\u00c6\u00a8\u00e0 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00bc\u00e5\u00ce \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0-\n\n2005 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba4"
