    "chunk_text": "\u00b9\u00b5\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00bf\u00c6\" \u00db\u0081\u00b9\u00b6\u00c7\u00af\u00cd\u00c1 \u00b6\u00c9\u00bc\u00c6\u00b6\u00c6\u00b6\u00bd\u00c6 \u00af\u00b4\u00c6\u00b4\u00b5+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00a5\u00b6\u00ce\u00b8\u00cc\u00bb\u00c7\u00b6\u00c6\u00b6 \u00cd\u00c1\u00de \u00a9\u00be\u00c6\u00be\u00c7\u00b9\u00c6 \u00cc\u00b9\u00de\u00b6\u00c8\u00af\u00e0\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b4 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00d0\u00b6\u00c6\u00b6\u00ce\u00af\u00a7\u00b4\u0081\u00b9\u0088\u00af\u00c6\u00ce\u00af\u008a\u0081\u00af\u00c9\u00c0\u00c6 \u00a9\u00be\u00c6\u00be\u00c7\u00b9\u00c6\u00cc\u00b9\u00de\u00b6\u00c8\u00af\u00e0\u00ba\u00c6 \u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00cc\u00b9\u00de\u00ce\u00af\u00af\u00bf\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00b8 \u00a9\u00b8 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00bf\u00bc\u00c6 \u00b6\u00c8\u00dd\u00b9\u00c6\u00b6\u00c8\u00dc\u00de\u00ba\u00c6 \u00c1\u00ce\u00af\u008a\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00d0\u00b6\u00c6\u00b6\u00ce\u00af\u00cc\u00af\u00c7\u00d5\u00b7\u00bc\u00c6 \u00a9\u00ae\u0089\u00b6\u00c6\u00b6\u00c7\u00be\u0081\u00bd\u00c8 \u00d0\u00b6\u00c6\u00b6\u00ce\u00af\u00cc\u00af\u00c7\u00d5\u00b7\u00bc\u00c8\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00af\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00cc\u00b9\u00de\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(vii) \u00d0\u00b6\u00c6\u00b6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00de\u00b7\u00bc\u00c6 \u00a9\u00c1\u00dd\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\" \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\" \u00a7\u00bb\u00bc\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c626\n\n\u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00be\u00c6 \u00a3\u00c1\u00bc\u00c7\u00be\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00b6\u00c6\u00ce\u00b6\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00e0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00be\u00c7\u00b8\u00d7\u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ba\u00b6\u00c8\u00b9\u00c6\u0089\u00bd\u00af\u00c6\u00af\u008c\u00d5\u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00c6\u00d0\u00b6\u00c6 \u00b6\u00ce\u00af\u00ce\u00ba\u00cc\u00b9\u00de\u00ba\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00cc\u00be\u00c7\u0081\u00bd\u00c7\u00b6\u00be\u00c7\u00af\u00c7\u00d7 \u00a9\u0081\u00b9\u00d7\u00b4\u0081\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b1\u00c7\u00b6\u00c6\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00d0\u00b6\u00c6\u00b6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00de\u00b7\u00bc\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00d0\u00b6\u00c6\u00b6\u00ce\u00af \u00a7\u00b4\u0081\u00b9\u0088\u00af\u00c6\u00ce\u00af\u008a\u0081\u00af\u00c9\u00c0\u00c6\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b1\u00c7\u00b6\u00c6\u00b6\u00c8\u0081 \u00f2\u00be\u00b6\u00b8\u00b9\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u008a\u0081 \u00ba\u00c9\u00bf\u00c6\u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u008c\u0081\u00a3\u00bf\u00e2\u00af\u00c6\u00d0 \u00a9\u00b7\u00c6\u00b6\u00b1\u00c6 \u00cc\u00b1\u00c7\u00b6\u00c6\u00b6\u00c8\u0081\u00ba\u00c9\u00d7\u00ba\u00b6\u00c8\u00b9\u00c6\u0089\u00bd\u00af\u00c6\u00af\u00ba\u00c6 \u00a3\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00cd\u00b6\u00c7\u00a3\u00b7\u00c6\u00b6\u00b1\u00c6 \u00cc\u00b1\u00c7\u00b6\u00c6\u00cc\u00b6\u00c7\u0081\u00bd\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d\u00b0\n\n15\u00b0 \u00a5\u00bc\u00ae\u00b4\u00c7\u008a\u00bc\u00b6\u00c6\u00d7 \u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 19 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00af\u00ce\u00b4\u00b1\u00c8\u00bb\u00c7\u00af\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 24 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00cd\u00ba\u00df\u00ba\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n(1)\u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u2013\n\n(\u00a3)\u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00ac) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\"\u201c\u00c1\u00dd\u00ba\u00c7\u00b8\u00ba\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c7\u008c\u0088\u00be\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00af\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\" \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\" \u00a7\u00bb\u00bc\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u008b\u00dd\u00b7\u00c6\u00d7 \u00cc\u00b9\u00de\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c7\u008c\u0088\u00be\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n(\u00a4)\u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00b1) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00ce\u00bb \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c (\u00b1)\u00b7\u00c7\u00be\u00c7\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 \u00af\u00dd\u00b6\u00c6\u00cc\u00b6\u00be\u00c6\u00ce\u00be\u00af\u00c6\u00d0\u00bf\u00c6\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a8\u00c0\u00c8\u00bb\u00bc\u00c8\u0081 \u00a8\u00c0\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00cd\u00b1\u00bc\u00c6\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00b6\u00c8\u008c\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00c1\u00c7\u00b4\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00af\u00c6\u00d0 \u00cd\u00ba\u00be\u00c7\u00af \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c8\u0081 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a8\u00c0\u00c8\u00bb\u00dd\u00af\u00c6\u00d0\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a8\u00c0\u00c8\u00bb\u00bc\u00c8\u0081\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008124 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c627\n\n\u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6\u00d7\u00ce\u00b5\u00af\u00c6\u00d0\" \u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00c6\u00d0\u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00dd\u00af\u00c6\u00d0 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00c1\u00b6\u00c8\u008c\u00b4\u00b6\u00c6\u00ce\u00b6 \u00c1\u00c0+\u00c6\u00d0\u00c1\u00b6\u00c8\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u2013\n\n(i) \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00de \u00a3\u00df\u00c1\u00be\u00bc\u00c6\u00ac\u00dd\u00c1\u00bc\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b4 \u00a4\u00b8\u00c7\u00be\u00c6 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00b1\u00c8\u00cd\u00bc\u0082\u00b4 \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00de \u00a3\u00df\u00c1\u00be\u00bc\u00c6 \u00da\u00bd\u00b7\u00c9+\u00c6\u00af\u00be\u00c7\u00af \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6\u00a8\u00c0\u00c8\u00bb\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b1\u00be\u008c\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00ba\u00c8\u00ce\u00af\u008a\u0081 \u00a3\u00ce\u00bc\u00c1\u00c7\u00b1\u00c8 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081"
  },
