    "chunk_text": "7\u00a1. \u00c8\u00e8\u008d\u00ba \u00cc\u00cd\u00ba\u00f8\u00a8 \u00cc\u00c9\u00c7\u00e7\u00c0\u00ef\u00c6\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00c0\u00f2\u00e5\u00bb\u0095\u00a8\u00a1\u00ef\u00c8\u0097\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00cc\u00cd \u00be\u00e5\u00ef\u00c4\u00e5\u00e0\u00bc\u00e0\u00bc\u00fa\u00cb\u00e0\u00b4 \u00a1\u00ef\u00c8\u0097\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00be\u00e5\u00c9\u00be \u00c8\u00e2\u00cc\u00ea \u00ba\u00c2\u00be\u00e0\u00be\u00be\u00e0 \u0097\u0093\u00c4\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4, \u00a1\u009e\u00a8\u00e0\u00cb\u00b8\u00c6\u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00cc\u00e4\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0\u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00b4 \u00a1\u00aa\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9, \u0097\u00ef\u00ca\u00e0\u00cb\u00ef\u00c6\u00be\u00e08, 9, 10 \u00cc\u00cd 11 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4\u00a1\u00aa\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n7\u00a1\u00e5. \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7\u00c6 \u0097\u00cc\u00e8\u00be\u00e0, \u00cc\u00cd\u00ba\u00f8\u00a8 \u00c7\u00cd\u00fa\u00ba\u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00cc\u00e0\u00c9\u00c7\u00e7\u00c0\u00ef\u00c6\u00be\u00e0 \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00e0\u00ef\u00a8\u00e0 \u00c6\u008a \u00bc\u00fa\u00be\u00c6\u00a8 \u00cc\u00e8\u00b4 \u00bc \u00a6\u00e0\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e07\u00a1, 7\u00a1\u00e5 \u00cc\u00cd 7\u00a1\u00e6\u00c6\u00be \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\u201c\u00c0\u00f2\u00e5\u00bb\u0095\u00a8\u00a1\u00ef\u00c8\u0097\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00cc\u00cd \u00a1\u00ef\u00c8\u0097\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00be\u00e5\u00c9\u00be \u00c8\u00e2\u00cc\u00ea\u00ba\u00c2\u00be\u00e0\u00be\u00be\u00e0\u00ef\u00aa\u00e0\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea, \u00ca\u00f2\u00e9\u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00a1\u009e\u00a8\u00e0\u00cb\u00b8\u00c6 \u00cd\u00e5\u00cc\u00e4\u00a8\u00e0\u00cb\u00b8\u00c6\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00cc\u00cd\u00ba\u00f8\u00a8 \u00c7\u00cd\u00fa\u00ba\u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7\u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4.\n\n2004 \u00a1\u00e2\u00a8 1 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba2\n\n\u00bc\u00fa\u00be\u00c6, \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00cc\u00cd \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6\u00c0\u00ea\u00c9\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00ef\u00bc\u00a8\u00a8, \u00cc\u00e8\u00e2\u00cd\u00c8, \u00ef\u00bc\u00c4\u00ce \u00cc\u00cd \u00a2\u00e2\u00aa\u00f2\u00e9\u00cc\u00e8 \u00c3\u00e5\u00cb\u00e5\u00c9\u00c8\u00e8\u00be\u00e0\u00c0\u00ce\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0, \u00c4\u00cd\u00b0\u00be\u00c6\u00e5 \u00ef\u00c9\u00ba\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n7\u00a1\u00e6. (1) \u00c8\u00e8\u008d\u00ba \u00cc\u00cd\u00ba\u00f8\u00a8 \u00cc\u00e0\u00c9\u00c7\u00e7\u00c0\u00ef\u00c6\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00ce,\u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00a8\u00c8\u00e0\u00c0\u00e8\u00d7\u00ef\u008a \u00bc\u00fa\u00be\u00c6\u00a8\u00e0 \u00cc\u00cd\u00fa\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0\u00bc\u00c7\u00be\u00e0\u00be\u00be\u00e0\u00b4 \u00a6\u00c4 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a8\u00e5\u00da\u00c6\u00c0\u0090\u00c0\u00e5\u0090\u00c6\u00a8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00c7\u00cd\u00fa\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7\u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00c2\u00c9\u00b4 \u00c0\u00d6\u00c9\u00da\u00ba\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5, \u00a7\u00c9\u00ea\u00be\u00e0 \u00a6\u00c4 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0\u00a6\u00ef\u00cc\u00e0 \u00c0\u00d6\u00c9\u00da\u00ba\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00be\u008a, \u00a1\u00e5\u00c0\u00cc\u00ea \u00c3\u00e5\u00c7\u00ef\u00bc\u00be \u00ef\u00c8\u00cc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0\u00cc\u00cd \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c0\u00ea\u00c9\u00ba\u00e0\u00c0\u00ba\u00e0 \u00ef\u00bc\u00a8\u00a8 \u00cc\u00e8\u00e2\u00cd\u00c8, \u00ef\u00bc\u00c4\u00ce \u00cd\u00e5 \u00a2\u00e2\u00aa\u00f2\u00e9\u00cc\u00e8\u00c3\u00e5\u00cb\u00e5\u00c9\u00c8\u00e8\u00be\u00e0 \u00c0\u00ce\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00be\u00f8\u00c6\u00c4\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6. \u00a6\u00c4 \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00a6\u00ef\u00cc\u00e0 \u00c0\u00d6\u00c9\u00da\u00ba\u00be\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4, \u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00c8\u00bc \u00cc\u00cd\u00ba\u00f8\u00a8 \u00c7\u00cd\u00fa\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00c8\u00cc\u00e5 \u00a1\u00e6\u00ba\u00f8\u00c0\u00d6\u00bc\u00fa, \u00cc\u00cd\u00ba\u00f8\u00a8 \u00c7\u00cd\u00fa\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0 \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00c2\u00c9\u00b4\u00c0\u00d6\u00c9\u00da\u00ba\u00be\u00c6 \u00ef\u00be\u00e5\u00a8\u00ce \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9\u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00c2\u00e6\u00bf\u00fb\u00c4 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa\u00c2\u00c8\u00c0\u00e5\u00be \u00ef\u00c8\u00cc \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00c2\u00e6\u00bf\u00fb\u00c4 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00ef\u00c8\u00cc (1)\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00a1\u00da\u00bb \u00a8\u00bb\u00be\u00c6\u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n4.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 8 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(\u00a1\u00e5) \u00cc\u00cd\u00ba\u00f8\u00a8 \u00c7\u00cd\u00fa\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00a8\u00c8\u00e0 \u00c0\u00e8\u00d7\u00ef\u008a \u00bc\u00fb\u00a6\u00c9\u00e6\u00be\u00f8 \u00aa\u00fa\u00b8\u00ea\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c4\u00ea\u00bc\u00c8\u00e0 \u00a6\u00e0 \u00cc\u00bf\u00cd\u00e5\u00cd\u00fa\u0095\u00a8\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4\u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a8\u00e5\u00c8 \u00cc\u00e9\u00c4\u00e5\u00c9\u201d;"
