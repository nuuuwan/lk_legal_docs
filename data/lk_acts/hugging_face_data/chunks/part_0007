    "chunk_text": "(\u0d88) \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dbd\u0dcf\u0dcf\u0db7\u0dd3\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dd4\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0db6\u0dc0, \u0dc3\u0dd4\u0dc0\u0db4\u0dc4\u0dc3\u0dd4 \u0db6\u0dc0, \u0dc3\u0dc4 \u0dc3\u0db1\u0dd3\u0db4\u0dcf\u0dcf\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dcf\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2, \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dcf\u0dc0, \u0dc0\u0dd2\u0db1\u0dba \u0dc3\u0dc4 \u0dc0\u0d82\u0d82\u0da0\u0dcf\u0dcf \u0dc0\u0dd0\u0dd0\u0dc5\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0db8 \u0d87\u0dad\u0dd4\u0dbd\u0dd4 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0db8 \u0d85\u0d82\u0d82\u0dc1\u0dc0\u0dbd \u0daf\u0dd3\n\n\u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0dda\u024f \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0dc3\u0dc4 \u0d9a\u0dbb\u0dca\u0dad\u0dc0\u0dca\u200d\u0dba\u0dba\n\n2025 \u0d85\u0d82\u0d82\u0d9a 17 \u0daf\u0dbb\u0db1 2025 \u0d85\u0d82\u0d82\u0d9a 17 \u0daf\u0dbb\u0db1 \u0dc3\u0dd6\u0daf\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0db1\u0dd2\u0dba\u0dcf\u0dcf\u0db8\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba \u0db4\u0db1\u0dad\u0dc3\u0dd6\u0daf\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0db1\u0dd2\u0dba\u0dcf\u0dcf\u0db8\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba \u0db4\u0db1\u0dad\n\n7\n\n\u0dc3\u0dca\u0dc0\u0d9a\u0dd3\u0dba \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0dca \u0db5\u0dbd\u0daf\u0dcf\u0dcf\u0dba\u0dd3 \u0dbd\u0dd9\ufffd\u0dc3 \u0d89\u0da7\u0dd4 \u0d9a\u0dbb\u0db1 \u0db6\u0dc0\u0da7 \u0dc0\u0d9c\u0db6\u0dbd\u0dcf\u0dcf \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8;\n\n(\u0d8a) \u0dc3\u0dd6\u0daf\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf\u0dc0\u0da7 \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0dba\u0db8\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0dc0\u0dd2\u0dbb\u0ddd\ufffd\u0ddd\u0db0\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0d9a\u0dcf\u0dcf\u0dbb\u0