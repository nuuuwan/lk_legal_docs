0b99\u0bcd\u0b95\u1fa6\u0b9f\u0ba9\u0bcd \u0bc7\u0b9a\u0bb0\u0bcd\u0ba4\u0bcd\u1f90 \u0b87\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b86\u0bc8\u0ba3\u0bc8\u0baf\u0b9a\u0bcd \u0bc7\u0b9a\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd\u0baa\u1f8a\u1f9c\u0bae\u0bcd \u0bc7\u0b9a\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u1f97\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b92\u1f9e \u0b95\u0bc2\u0bb1\u0bcd\u1fa0 \u0b87\u0ba4\u0ba9\u0bcd\u0bae\u0bc0\u1f90 \u1f97\u0bb1\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c, \u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0bb5\u0bb3\u0bbf\u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u1fa4\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bc8\u0bae\u0b9a\u0bcd\u0b9a\u0bbf\u0ba9\u0bcd \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bbe\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0bc8\u0b95\u0bc6\u0baf\u0bbe\u0baa\u0bcd\u0baa\u0bae\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c \u2026\u2026\u2026..\u2026\u2026\u2026\u2026\u2026\u2026....\u2026.. \u0ba8\u0bc0\u0ba4\u0bbf \u0bae\u0ba9\u0bcd\u0bb1\u0ba4\u0bcd\u1f90\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0baa\u0bcd\u0baa\u1f8a\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0bc8\u0baf\u0ba4\u0bcd \u0ba4\u0bbf\u1f9e\u0baa\u0bcd\u0baa\u0bbf\u0baf\u1f94\u0baa\u0bcd\u1f97\u0bae\u0bcd\u0baa\u1f8a\u1f9c\u0bae\u0bcd \u0bc6\u0bb5\u0bb3\u0bbf\u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u1fa4\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bc8\u0bae\u0b9a\u0bcd\u0b9a\u0bbf\u0ba9\u0bcd \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0bc7\u0b95\u0bbe\u0bb0\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bbe\u0bb0\u0bcd.\n\n\u1f97\u0bb1\u0b95\u0bcd\u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u1f97:\n\n\u0bc7\u0ba4\u0ba4\u0bbf \u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026 \u0bc8\u0b95\u0bc6\u0baf\u0bbe\u0baa\u0bcd\u0baa\u0bae\u0bcd\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\n\n\u0b87\