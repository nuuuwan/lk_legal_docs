    "chunk_text": "\u0b87\u0bb5\u0bcd\u0bb5\u0bb0\u0bc8\u0bb5\u0bbf\u0bb2\u0b95\u0bcd\u0b95\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd (\u0b85) \u0bae\u0bc1\u0ba4\u0bb2\u0bcd (\u0baa)\n\n\u0bb5\u0bb0\u0bc8\u0baf\u0bbf\u0bb2\u0bbe\u0ba9 \u0baa\u0ba8\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb0\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\n\n\u0b8e\u0bb5\u0bc8\u0baf\u0bc7\u0ba9\u0bc1\u0bae\u0bcd \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bb2\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b88\u0b9f\u0bc1\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\n\n\u0b8e\u0bb5\u0bb0\u0bc7\u0ba9\u0bc1\u0bae\u0bbe\u0bb3\u0bcd;\n\n(\u0bb0) \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0bae\u0b9a\u0bcd \u0b9a\ufffd\u0bca\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bc7\u0bb5\u0bc8\u0b95\u0bb3\u0bc8\n\n\u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0ba4\u0bb2\u0bcd; \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd\n\n(\u0bb2) \u0ba8\u0bbf\u0ba4\u0bbf\u0b9a\u0bbe\u0bb0\u0bcd \u0b95\ufffd\u0bca\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb2\u0bcd\u0bb5\u0bbe\u0b99\u0bcd\u0b95\u0bb2\u0bcd\u0b95\u0bb3\u0bc8 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0bc8\n\n\u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b95\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bb2\u0bae\u0bcd\n\n\u0bb5\u0bbf\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb0\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b85\u0ba4\u0bcd\u0ba4\u0b95\u0bc8\u0baf\n\n\u0bb5\u0bc7\u0bb1\u0bc1 \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bb2\u0bcd;\n\n\u201c\u0ba8\u0bbf\u0ba4\u0bbf \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0bae\u0bcd\u201d \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0ba8\u0bbf\u0ba4\u0bbf\u0b9a\u0bbe\u0bb0\u0bcd \u0b95\ufffd\u0bca\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb2\u0bcd \u0bb5\u0bbe\u0b99\u0bcd\u0b95\u0bb2\u0bcd\u0b95\u0bb3\u0bc8\n\n\u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u