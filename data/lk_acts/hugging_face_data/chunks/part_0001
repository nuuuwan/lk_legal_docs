    "chunk_text": "19\u00b0\u0089\u00bc\u00c8\u00e2 224 \u00a5\u00be\u00c6 \u201c\u00a5\u00dd\u00d8{\u00bd\u00c6\u00bd\u00c8 \u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6\"\u00a5\u00bc\u00ae\u00b4\u00c7\u00c1\u00d7 \u00d0\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00bd\u00c8\u0081\u00ba\u00c9\u00d7\u00ab\u00b7\u00c6\u00d8{\u00de \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6 \u00f2\u0081\u00bd\u00c7\u00c1\u00d7 \u00a3\u00be\u00c6\u00be\u00d7\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5+\u00c6\u00af\u00bf\u00c8\u0081\u00a3\u00b6\u00c8\u00af\u00bc\u00c8\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c623\n\n\u00b7\u00c8\u00ce\u00bc I\n\n\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00b9\u00c6\u00da\n\n\u00b7\u00c8\u00ce\u00bc II\n\n\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6+\u00c6\u00af\u00bf\u00c6\n\n20\u00b0\u00a5\u00bc\u00ae\u00b4\u00c7\u00c1\u00d7 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6\u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00ce\u00bb \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c\u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5(\u0089\u00bc\u00c8\u00e2 215\u00a3)\n\nIIIIII\n\n\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u0089\u00bc\u00c8\u00e2\u00cc\u00b6\u00c7\u00ce\u00af\n\n21\u00a3\u00ce\u00b4\u00bb\u00c7\u00bf\u00b6\u00c6\u00b6\u00af\u00d5\u00af\u00bf\u00c6500\u00b000\n\n22\u00a3\u00ce\u00b4\u00bb\u00c7\u00bf\u00b6\u00c6 \u00b6\u00af\u00d5\u00af\u00bf\u00c8\u0081\u00c1\u0088\u00c1\u00ba\u00c6100\u00b000\n\n38\u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00c1\u00c7\u00af\u00b8+\u00c6\u00af\u00bf\u00c8\u00be\u00c6\u00a9\u00d5\u00b6\u00c6\u00d7\u00b1\u00c6 \u00cc\u00b1\u00be\u00c6\u00be\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb\u00d7\u00ba\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6 \u00b9\u00d5\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7 \u00db\u0081\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6 \u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb\u00d7\u00ba\u00c7\u00b8 \u00a5\u00ce\u00bd\u00c1\u00bc\u00c8 \u00a7\u00bc\u00c8\u00ba\u00ba\u00c6500\u00b000\n\n45\u00a5\u00ce\u00bd\u00c1\u00bc\u00c8 \u00a7\u00bc\u00c8\u00ba\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00db\u00bc\u00b5\u00c7\u00af \u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6\u00c1\u00c7\u00af\u00b8+\u00c6\u00af\u00bf\u00c8\u0081 \u00b9\u00bb\u0081\u00b9\u00c7\u00d5 \u00ba\u00c9\u00b6\u00c7\u00b8 \u00ba\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00c7\u00d51000\u00b000\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5+\u00c6\u00af\u00bf\u00c8\u0081\u00a3\u00b6\u00c8\u00af\u00bc\u00c8\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c624\n\n\u00b7\u00c8\u00ce\u00bc I\n\n\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00b9\u00c6\u00da\n\n\u00b7\u00c8\u00ce\u00bc II\n\n\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6+\u00c6\u00af\u00bf\u00c6\n\n123 (1)\u00a7\u00bc\u00c8\u00ba\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u00be\u00c6\u00be\u00c7\u00ba\u00be\u00c6(\u00a3)\u00c1\u00c7\u00af\u00b8\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00c1\u00b6\u00ce\u00b8\u00b6\u00c6 \u00b6\u00ce\u00b4\u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c62500\u00b000\n\n123 (1)\u00b1\u00c7\u00bc\u00b6\u00c8 \u00a7\u00bc\u00c8\u00ba\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u00be\u00c6\u00be\u00c7\u00ba\u00be\u00c6(\u00a4)\u00a4\u00b4\u00c6\u00af\u00ce\u00bf\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00df\u00af\u00c6\u00af\u00ba\u00bc\u00c6\u00d7\u00b6\u00be\u00c63000\u00b000\n\n123 (2)18 \u00c1\u00bb\u00d7\u00af\u00c6\u00d0\u00af\u00c6 \u00af\u00c9\u00c0\u00c6 \u00c1\u00c7\u00af\u00b8\u00cd\u00ba\u00c7\u00b4\u00c6\u00d5\u00b6\u00be\u00c65000\u00b000\n\n140\u00cd\u00c1\u00af\u00ba\u00c7\u00af\u00b1\u00c6 \u00cc\u00b1\u00be\u00c6\u00df\u00b6\u00be\u00c61000\u00b000\n\n148\u0096\u00b6\u00c8 \u00ac\u00e1+\u00c6\u00d0\u00af\u00bf\u00c6500\u00b000\n\n152\u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00c1\u00c7\u00af\u00b8\u00ba\u00c6\u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7 \u00b1\u00c7\u00bc\u00b6\u00c8\u008a\u0081\u00b7\u00c8\u00ce\u00be100\u00b000\n\n153\u00c1\u00c7\u00af\u00b8\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7\u00b1\u00c7\u00bc\u00b6\u00c8\u008a\u0081 \u00b1\u00ba\u00c8\u00af\u00c6\u00ce\u00b3\u00af\u00bf\u00c6\u00db\u00b6\u008b\u00bb\u00b8500\u00b000\n\n154\u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00c1\u00c7\u00af\u00b8+\u00c6\u00af\u00ce\u00bf\u0089\u0081\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00c8\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b6\u00be\u00c620\u00b000\n\n155\u00ac\u008b \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00bf\u00c8\u00a9\u00b1\u00c6\u00b1\u00bc\u00c8\u00af\u00c6\u00ce\u00af100\u00b000\n\n156\u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00c1\u00c7\u00af\u00b8+\u00c6\u00af\u00bf\u00c8\u0081\u00ad\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00be\u00ce\u00af\u00af\u00bf\u00c6 \u00db\u00b6\u008b\u00bb\u00c1\u00bd\u00c6\u00bd\u00c8\u00be\u00c6 \u00b1\u00c1\u00c7\u00bc\u00c8\u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00b1\u00c1\u00c7\u00bc\u00c8 \u00cc\u00b1\u00bb\u00c6\u00bb \u00a3\u00d9\u00ba\u00b6\u00c8\u00b6\u00c6\u00b6\u00be\u00c6 100\u00b000\n\n157\u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00af\u00c7\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00db\u0081\u00a4\u00b1\u00b8+\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u0081\u00a9\u00ae\u00b5\u00c8\u00af\u00c6\u00ce\u00af100\u00b000\n\n158 (2)\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00b6\u00c6 \u00b6\u00ce\u00be\u00af\u00c6\u00af\u00c1\u00b1\u00ba\u00c6\u00a3\u00b5\u00c8\u00bb\u00b6\u00c6 \u00b6\u00c1\u00de\u00b6\u00be\u00c6500\u00b000\n\n159\u008c\u00bf\u00ba\u00c6\u00b9\u00bc+\u00c6\u00af\u00bf\u00c6 \u008c\u00b7\u00c8\u00cd\u00bb\u00c7\u00af\u00c8\u00b6\u00c6\u00b6\u00be\u00c6100\u00b000\n\nIIIIII\n\n\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u0089\u00bc\u00c8\u00e2\u00cc\u00b6\u00c7\u00ce\u00af\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5+\u00c6\u00af\u00bf\u00c8\u0081\u00a3\u00b6\u00c8\u00af\u00bc\u00c8\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c625\n\n\u00b7\u00c8\u00ce\u00bc I\n\n\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00b9\u00c6\u00da\n\n\u00b7\u00c8\u00ce\u00bc II\n\n\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6+\u00c6\u00af\u00bf\u00c6\n\n162\u00cc\u00b9\u00c7\u008b\u00d2 \u00a3\u00df\u00c1\u00be\u00bc\u00c6\u00af\u00bf\u00c8\u0081\u00c1\u00c7\u00af\u00b8\u00b9\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00da\u00af\u00e0\u00ba\u00c6\u00b1\u00ba\u00c8\u00af\u00c6\u00ce\u00b3\u00af\u00e0\u00ba\u00c61000\u00b000\n\n165\u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00c1\u00c7\u00af\u00b8\u00b6\u00c7+\u00c6\u00af\u00c8\u00af\u00c6\u00d0\u00bf\u00c6\u00a9\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00cc\u00b9\u00c7\u00e1\u00d7\u00a9\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb\u00db\u00bd\u00c6\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00af\u00bf\u00c620\u00b000\n\n166\u00cc\u00b9\u00dd\u00b7\u00c6\u00cc\u00b6\u00dd\u008c\u00be\u00c6 \u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6\u00c1\u00c7\u00af\u00b8+\u00c6\u00af\u00ce\u00bf \u00b7\u00c8\u00de\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00bc\u00c8\u00b6\u00c6\u00d7\u00ce\u00c1\u00b6\u00c6\u00b6\u00be\u00c6500\u00b000\n\n167\u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00c1\u00c7\u00af\u00b8\u00ba\u00c6\u00cc\u00b9\u00dd\u00b7\u00c6\u00cc\u00b6\u00dd\u008c\u00be\u00c6 \u00b7\u00c8\u00de\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00d0\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u008c\u00b4\u00c6\u00d5\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00d0\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7\u00a9\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb\u00db\u00bd\u00c6\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00af\u00bf\u00c6500\u00b000\n\n178\u00a3\u00bf\u00e2\u00af\u00c6\u00d0 \u00ba\u00c8\u00b3\u00c6\u00b1\u00c8\u00bb\u00b9\u00bb\u00b5\u00c8\u00af\u00ce\u00bf \u00aa\u00bd\u00c6\u00bd\u00c8\u00b1\u00c6\u00cc\u00b1\u00be\u00c6\u00be\u00be\u00c6150\u00b000\n\n189\u00cc\u00be\u00c7\u00bd\u00c8\u008a\u00be\u00c6 \u00aa\u00bd\u00c6\u00bd\u00c8\u00b1\u00c6\u00cc\u00b1\u00be\u00c6\u00be\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00a4\u00b4\u00c6\u00af\u00bf\u00c6150\u00b000\u201d"
