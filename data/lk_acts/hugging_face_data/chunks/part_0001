    "chunk_text": "(iv) \u00c1\u00c7\u00d9{\u00bc\u00c6\u00b6\u00c8\u00af\u00bf\u00c6\" \u00a7\u00be+\u00c6\u00d0 \u00c1\u00c7\u00d9{\u00bc\u00c6\u00b6\u00c8\u00af\u00bf\u00c6\" \u00db\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00bf\u00c6\"\u00ce\u00c1\u00bc+\u00c6\u00af\u00bf\u00c6 \u00a5\u00bb\u00bd\u00c6\u00ce\u00af\u00bb\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b1\u00bb\u00bd\u00c6\u00ce\u00af\u00bb\u00c7\u00b8\u00a3\u00dd+\u00c6\u00af\u00bd\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00ba\u00dd\u008c\u00bb \u00a3\u00dd+\u00c6\u00af\u00bd\u00c6\u00af\u00bf\u00c6\"\u00ce\u00c1\u00b6\u00c6\u00d7{\u00bf\u00c6\" \u00a3\u00dd\u00ba\u00c6 \u00a7\u00cd\u00be\u00c7\u00af+\u00c6\u00af\u00bf\" \u00a3\u00dd\u00ba\u00c6 \u00a7\u00cd\u00be\u00c7\u00af+\u00c6\u00af\u00bf\u00c6\u00cd\u00b6\u00c7\u00bb\u00c6\u00b7\u00c6\u00b6 \u00a7\u00cd\u00be\u00c7\u00af+\u00c6\u00af\u00bf\u00c6\" \u00b6+\u00c6\u00af \u00b7\u00c7\u00b5\u00bb+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00cc\u00b9\u00c7\u00bd\u00c8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00d0\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00b9\u00af\u00bc\u00b5\u00ba\u00c6 \u00a9\u00b6\u00b8\u00c8\u00b8\u00d7\u00ba\u00c6\u00b6\u00bd\u00c6\u00af\u00c7\u008b\u00af \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c7\u00af\u00b9\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb \u00a3\u00be\u00c6\u00be\u00d7\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00d9\u00b4\u00c6\u00b9 \u008c\u00bf\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c7\u00af\u00b9\u00c6\u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4 \u00cd\u00c1\u00ae\u0088\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c6 ;\n\n(vi) \u00d2\u00b6\u00c6\u00b6\u00c8\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u008b\u00bb \u00a9\u00ae\u00cc\u00b5\u00bb\u00c6\"\u00ba\u00ae\u00cc\u00b5\u00ae\u00cc\u00b5\u00bb\u00c6\" \u00c1\u00c7\u00d9{\u00bc\u00c6\u00b6\u00c8 \u00a9\u00bc\u00c8\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00af\u00b9\u00c6\u00b9\u00be\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8 \u00a9\u00bc\u00c8\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 ;\n\n(vii) \u00cc\u00b1\u00bb\u00bd\u00c6\u00ce\u00af \u00a3\u00c1\u00bb\u00c1+\u00c6\u00af\u00bf\u00c6\" \u00a8\u0081\u00de\u00cd\u00af\u00c7\u00be\u00c6\u00af\u00bf\u00c6\" \u00b1\u00c8\u00be\u00c6\u00df\u00af\u00c6\u00af\u00b6\u00c8\u00ce\u00bc\u00af\u00bf\u00c6\" \u00cd\u00af\u00b4\u00c6\u00d0\u00ba\u00c6 \u00a7\u00b9\u00af\u00bc\u00b5+\u00c6\u00af\u00bf\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00a7\u00b6\u008c\u00b1\u00c6 \u00b1\u00c7\u00b6\u00b8+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8 \u00d7\u00ce\u00b5\u00dc\u00de\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00ce\u00bd\u00b9\u00c7\u00d5 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bb\u00be\u00c7\u00ce\u00ba \u00ac\u0081\u00ce\u00bd \u00a6\u00d5\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af \u00ba\u00b8\u00c8\u00b6 \u00a7\u00b4\u008b\u00be\u00c6 \u00a3\u00b5\u00c8\u00bb\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7\u00a9\u00d5\u00b6\u00c6\u00d7\u00b1\u00c6 \u00cc\u00b1\u00be\u00c6\u00be\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c627\n\n\u00af\u00c8\u0081\u00bd \u00b1\u00c7\u00b6\u00b8+\u00c6\u00af\u00bf\u00c6\" \u00d0\u00dd\u00b4\u00dd\u00af\u00c6\u00af\u00c7\u00b8 \u00cc\u00c1\u00ae \u0089\u00bc\u00ba\u00c6\u00da\u00af\u00bf\u00c6\"\u0089\u00cc\u00bd\u00bb\u00c6\u008b \u00b6\u00b4\u00c6\u00b4\u00b1\u00c6\u00d2\u00b9\u00c6 \u00cc\u00b9\u00c7\u00bd\u00c8\u00af\u00bf\u00c6 \u0089\u00cd\u00bd\u00bb\u00c6\u008b \u00a9\u00e1\u00d7\u00ba\u00c6\u00b6\u00c7\u00bf\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u0089\u00cc\u00bd\u00bb\u00c6\u008b \u00a9\u00e1\u00d7\u00ba\u00c6 \u00b9\u00be\u00ce\u00af\u00af\u00bf\u00c6 ;\n\n(viii) \u00af\u00ba\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00b4\u00c6\u00bc\u00af\u00c6\u00b4\u00bc\u00c6\u00af\u00bf\u00c6 ;\n\n(ix) \u00cc\u00b1\u00df{\u00be\u00bc\u00c6 \u00b7\u00b4\u00ba\u00c7\u00d5\u00ba\u00c6 \u00cc\u00b6\u00c7\u00ce\u00be\u00cd\u00b9\u00b1\u00c8\u00af\u00bf\u00c6 ;\n\n(x)\u00af\u00ba\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00a5\u00bb\u00b7\u00c6\u00b6\u00c8\u00bc\u00b6\u00c6\u00cc\u00b6\u00c7\u00d0\u00b6\u00c8 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a7\u00bc+\u00c6\u00af\u00bf\u00c6(01\u00b007\u00b02004 \u00a5\u008b\u00dd\u00b7\u00c6\u00d7 \u00b9\u00bb\u00d9\u00de\u00ba\u00c6)\n\n\u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00bd\u00c8\u0081 \u00c1\u00c0+\u00c6\u00af\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8\"\n\n\u0089\u0081\u00c1\u00dd\u00c1\u00b8\u00c1\u00bd\u00c6\u00ce\u00bd \u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6\u00b0\n\n(\u00a4) (i)\u00af\u00be\u00c6\u008c\u00b6\u00c6 \u00b6\u00c7\u00b9\u00b8\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b9\u00c6\u00b9\u00c7\u00b4\u00b1\u00c7\u00ce\u00be\u00bb\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b7\u00c8\u00b6\u00c8\u00dc\u00b6\u008c\u00bb\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00c7\u00b4\u00b1\u00c7\u00ce\u00be\u00af\u00bf\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b9\u00c6\u00b9\u00c7\u00b4\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00ce\u00b6\u00b9\u00c6 \u0089\u0081\u00b9\u00bd\u00c6\u00de\u00af\u00c8\u0081\u00bd\u00d7\u00b4\u0081 \u00af\u00be\u00c6\u008c\u00a3\u00ce\u00ba\u00b1\u00c6\u00d2\u00b4\u0081 2004\u00b007\u00b001 \u00a5\u008b\u00dd\u00b7\u00c6\u00d7 \u00b9\u00bb\u0081\u00b9\u00b4 \u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00b9\u00c7\u00b4\u00b1\u00c7\u00ce\u00be\u00af\u00bf\u00c7\u00be\u00c6 \u00af\u00be\u00c6\u008c\u00b1\u00c6 \u00cd\u00b1\u00ce\u00c1\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6\" \u00ba\u00c7\u00af\u00c7\u00b5\u00b1\u00ce\u00b9 \u00ac\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00bf\u00c6\u00f7\u00bc\u00c6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc \u00b1\u00ce\u00b9 \u00ac\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6\u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00d8{\u00be\u00af \u00cd\u00b1\u00ce\u00c1\u00af\u00bf\u00c6;\n\n(ii)\u00c1\u00c7\u0081\u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00d7\" \u00b7\u00c9\u00bc\u00c6\u00b9\u00c6 \u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7\u00a7\u00be\u00c6\u00be\u00c7\u00b1\u00b9\u00c6 \u00b9\u00bb\u00b5\u00c8\u00af\u00bf\u00c8\u0081 \u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00d7\" \u00af\u00be\u00c6\u008c\u00b1\u00c6\u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00af\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b4\u00c7\u00af\u00c6\u00b1\u00c8 \u00cd\u00b1\u00ce\u00c1\u00af\u00bf\u00c6 \u00b6\u008c\u00bc\u00c6\u00b7\u00c6\u00b6)\u00a5\u00dd\u00b9\u00b6\u00c6\u00cc\u00b6\u00b4\u00c6\u00d5\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6 \u00b9\u00bb\u00b5\u00c8\u00af\u00bf\u00c8\u0081\u00a4\u00b1\u00b8+\u00c6\u00af\u00bf\u00c8\u0081 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00bf\u00e2\u00ce\u00b4\u00bb\u00ce\u00c1\u00dc\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00d0\u00b6\u00c6\u00b6\u00ce\u00af \u00a7\u00b4\u0081\u00b9\u0088\u00af\u00c6\u00ce\u00af 2004\" \u00b1\u00b8\u00c1\u00bc\u00c8 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0\u00db\u0081\u00b8\u00bc\u00c6 \u00cc\u00b1\u00bb\u00c6\u00d7\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u0088\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00af\u00c8\u00bc+\u00c6\u00af\u00b9\u00bb\u00b5\u00c8\u00af\u00bf\u00c8\u0081 \u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00d7\u00b9\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00c1\u00b8\u00e2\u00ba\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00cd\u00af\u00c7\u00b1\u00c6\u00d2\u00af\u00e0\u00af\u00c6\u00d0 \u00d0\u00b6\u00c6\u00b6\u00ce\u00af\u00c1\u00b1\u00b6\u00c8\u00af\u00ce\u00bf \u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6 \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00af\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b4\u00c7\u00af\u00c6\u00b1\u00c8\u00cd\u00b1\u00ce\u00c1\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b9\u00c7\u00d7\u00b9\u00bb\u00b5\u00c8\u00af\u00bf\u00c6 \u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00d7\u00b1\u00c6\u00cd\u00b1\u00ce\u00c1\u00af\u00bf\u00c6;\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c628"
