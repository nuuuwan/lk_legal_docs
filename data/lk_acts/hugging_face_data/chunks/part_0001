    "chunk_text": "(14) \u00c4\u00e5\u00be\u00ea\u00cb\u00e8\u00a8 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00cd\u00e5 \u00c4\u00ec\u00c8\u00e8\u00a8 \u00be\u00f8\u00bc\u00cd\u00cc \u00c0\u00e8\u00ce\u00e8\u00c0\u00e6\u00bc\u00fb\u00c4\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u0097\u00ca\u00e0\u00c9 \u00aa\u00c7\u00e6\u00ba\u00e0\u00c9\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00bc \u00b0\u00e5\u00ba\u00f8\u00a8\u00c9\u00ec \u00cd\u00e5 \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00c9\u00ec \u00a8\u00f8\u00f2\u00c6\u00e5\u00ca\u00e9\u00c8\u00e9 \u00c0\u00e8\u00c6\u00c9\u00c7 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a6\u00e0 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a\u00cd\u00e5 \u00be\u00f8\u00bc\u00cd\u00cc \u0097\u00ca\u00e0\u00c9\u00c4\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00aa\u00e6\u00be\u00f9\u00c4 \u00cd\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c0\u00e6\u00bc\u00fb\u00c4 \u00cc\u00cd\u00ba\u00f8\u00a8\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00bc, \u00a4\u00ba\u00e0\u00cc\u00e5\u00cd \u00bc\u00e6\u00d7\u00c4 ; \u00cc\u00cd\n\n3. \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 4 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00f8\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :_\n\n(\u00a1) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u201c\u00be\u00f8\u00c8\u00bd\u00e5\u00d7\u00be\u00e0\u00ef\u00aa\u00be\u00e0\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00be\u00f8\u00c8\u00bd\u00e5\u00d6 \u00a8\u0095\u00b4\u00ea\u00c9\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(\u00a1\u00e5) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u201c\u00a8\u00da\u00ba\u00c9\u00f1\u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a8\u00da\u00ba\u00c9\u00f1 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00be\u00f8\u00c8\u00bd\u00e5\u00d6\u00a8\u0095\u00b4\u00ea\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n4. \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 6 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa\u201c\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00be\u00f8\u00c8\u00bd\u00e5\u00d7\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00cd \u0097\u00bd\u00e5\u00c6\u00a8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a8\u00e5\u00da\u00c6 \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201c\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00be\u00f8\u00c8\u00bd\u00e5\u00d6 \u00a8\u0095\u00b4\u00ea\u00ef\u008c \u00cc\u00cd \u0097\u00bd\u00e5\u00c6\u00a8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a8\u00e5\u00da\u00c6 \u00a2\u00b4\u00ea \u00a8\u00e8\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc, \u00cc\u00da\u00ef\u00c9\u00e5\u00e0\u00bc\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce\u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6 \u00cd\u00e5 \u00ca\u00eb\u00c3 \u00cc\u00e5\u00bd\u00a8 \u00a6\u00e0\u00a8\u00a8 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc,\u00be\u00f8\u00c8\u00bd\u00e5\u00d6 \u00a8\u0095\u00b4\u00ea\u00ef\u008c \u00cc\u00e2\u00c6\u00ea\u00ba\u00f8\u00c6 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00e8\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n5. \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e04 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e06 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00eb\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9\n\n41999 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00da\u00ef\u00c9\u00e5\u00e0\u00bc\u00c6 \u00ca\u00f2\u00c4\u00bc\u00e5\u00be\u00cc\u00e2\u00aa\u00c4\u00c6 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a) (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n6. \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00ef\u00c4\u00c6\u00e8\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00a1\u00ba\u00c7, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :_\n\n\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\n\u00c0\u00ec\u00da\u0097\u00a8\u00e5\u00c9"
