    "chunk_text": "4.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 5 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00cc\u00e8\u00c6\u00c6\u00b4 \u00cd\u00c6\u00a8\u00e0\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00cc\u00e8\u00c6\u00c6\u00b4 \u00a1\u00b4\u00a8\u00e0\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00e8\u00d7\u00ef\u00c4\u00be\u00e0\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e05 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n434 \u00c9\u00be\u00a1\u0093\u00a8\u00e5\u00c7\u00ef\u00c6\u00e0 2 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e04 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\nH-022545\n\n5. (1)\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00b4\u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6, -\n\n(\u00a1) \u00f3\u008a\u00d6\u00c6 \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00a4\u00c0 \u00f3\u008a\u00d6\u00c6 \u00cc\u00e0\u00bb\u00e5\u00be\u00e5\u0093\u00c0\u00ba\u00f8\u00ba\u00be\u00ba\u00eb\u00c7 \u00bc\u00c7\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c9\u00be \u00ba\u00e5\u00a8\u00e0 \u00f3\u00c7\u00b4, \u00a6\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6, \u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5, 1983 \u00c4\u00e6\u00c6\u00fa \u00c4\u00cc 01\u00c9\u00be \u00bc\u00fa\u00be \u00bc\u00fb \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00c7, 1983 \u00c4\u00e6\u00c6\u00fa \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00ef\u008a \u00c0\u00be\u00ba\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00ba\u00a8\u00e0, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0\u00c9\u00e6\u00b4\u00ea\u00ef\u00c0\u00be\u00e0 \u00a1\u00b6\u00ea \u00a8\u00c7 \u00ef\u00aa\u00be \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00a1\u00be\u00f8\u00c9\u00e5\u00da\u00c6\u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00c8\u00e2\u00aa\u00eb \u00ef\u00c8\u00cc \u00a1\u00b6\u00ea \u00a8\u00c7 \u00ef\u00aa\u00be \u00a6\u00ef\u00cc\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(\u00a1\u00e5) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00a4\u00c0 \u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u008c \u00ba\u00be\u00ba\u00eb\u00c7\u00a8\u00e0 \u00bc\u00c7\u00be\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c9\u00be \u00ba\u00e5\u00a8\u00e0 \u00f3\u00c7\u00b4, \u00a6\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6,\u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 1991 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be \u00bc\u00fb\u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, 1991\u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00c4\u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00ba\u00a8\u00e0, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00c9\u00e6\u00b4\u00ea\u00ef\u00c0\u00be\u00e0\u00a1\u00b6\u00ea \u00a8\u00c7 \u00ef\u00aa\u00be \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00a1\u00be\u00f8\u00c9\u00e5\u00da\u00c6 \u00bc\u00e5\u00c6\u00a8\u00c4\u00ea\u00bc\u00c8\u00e0, \u00c9\u00c8\u00e2\u00aa\u00eb \u00ef\u00c8\u00cc \u00a1\u00b6\u00ea \u00a8\u00c7 \u00ef\u00aa\u00be \u00a6\u00ef\u00cc\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00c8\u00cc\u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 4 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c4\u00aa\u00fa\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6, \u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5,1995 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00ef\u00cc\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c0\u00d6\u00bc\u00fa \u00c9\u00ec \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa\u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8 \u00a1\u00be\u00ea\u00c9, \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00a1\u00cd\u00e8\u0095\u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00c9\u00c8\u00e8\u00be\u00e0 \u00a1\u00b6\u00ea \u00a8\u00c7 \u00ef\u00aa\u00be 1995 \u00b0\u00be\u00c9\u00e5\u00d6\u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00bc\u00fa\u00be\u00c6\u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00a8\u00e5\u00c8\u00c6 \u00ba\u00eb\u00ce \u00bc\u00fb \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8 \u00c9\u00c8\u00e2\u00aa\u00eb \u00ef\u00c8\u00cc\u00a1\u00b6\u00ea \u00a8\u00c7 \u00ef\u00aa\u00be \u00a6\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n6.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00a1\u00ba\u00f9\u00ba\u00c6\u00b4 \u00c2\u00c8\u00c0\u00e7\u00c4\u00cc\u00cd \u00c9\u00c8\u00e2\u00aa\u00eb \u00a8\u00f8\u00d7\u00c4.\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n31999 \u00a1\u00e2\u00a8 45 \u00bc\u00c7\u00be \u00c7\u00e5\u00b0\u00f1 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00a1\u00da\u00bb\u00cc\u00e5\u00bd\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba"
