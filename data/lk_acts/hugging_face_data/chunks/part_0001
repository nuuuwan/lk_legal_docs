    "chunk_text": "\u201c\u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb\u00c9\u201d \u00c6\u00be\u00e0\u00be\u00b4, \u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u0090 \u0097\u00ef\u00b4\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c4\u00ba\u00eb \u00bc\u00fa\u00be\u00c6\u00a8\u00bc\u00e9 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00ef\u00aa\u00d1\u00c4 \u00a8\u00c7\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00cc\u00cd \u00ef\u00aa\u00d1\u008a\u00c3\u00e5\u00c7\u00aa\u00be\u00e0\u00be\u00e5 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00a6\u00a8\u00ad \u00c9\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00be\u00e0 \u00c4\u00ba \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\n\n542005 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(\u00a1) \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4, \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a\u00ef\u00aa\u00c9\u00e5 \u00be\u00f8\u0095 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00bc\u00cd\u00c6\u00a8\u00e0\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00aa\u00c9\u00e5 \u00be\u00f8\u0095 \u00a1\u00aa\u00ef\u00c6\u00be\u00e0 \u00c6\u00ea\u00ba\u00e0\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00ef\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00cc\u00e4\u00c0 \u00b3\u00e5\u00ba\u00f8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00ba\u00be\u00f8 \u00ba\u00be\u00f8\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00e0\u00c9 \u00c9\u00e6\u00b6\u00bc\u00e5\u00c6\u00fb\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00c6\u00a8\u00e0 \u00bc\u00e6\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c6\u008a \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00cc\u00e4\u00c0\u00b3\u00e5\u00ba\u00f8\u00c6\u00a8 \u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 , \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00aa\u00c9\u00e5 \u00be\u00f8\u0095\u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00bc\u00cd\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00c4\u00ea\u00bc\u00c8\u00e0\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00b4 \u00ef\u00bc\u00be \u00c8\u00bc \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u00ef\u00c4\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u00c9\u00ec \u00a1\u00e6\u00c0\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00e5\u00be\u00f8 \u00c0\u00ec\u00c7\u00b8\u00c6\u00a8\u00e0 \u00c0\u00e6\u00c9\u00ba\u00f9\u00c4 \u00a1\u00bc\u00cd\u00cc\u00e0\u00ef\u008c.\u201d ;(\u00a1\u00e5) \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4,\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00cc\u00e4\u00c0 \u00b3\u00e5\u00ba\u00f8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00ba\u00be\u00f8 \u00ba\u00be\u00f8\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00e0\u00c9 \u00a6\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00cd\u00fa\u00bc\u00c7\u00be\u00ea \u00c8\u00c2\u00be, \u00a6\u00a8\u00f9 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00c6\u00f5\u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00e5\u00c6\u00a8 \u00c9\u00ec \u00c4\u00ea\u00dd\u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00bc\u00cd\u00c6\u00a8\u00b4 \u00c9\u00e6\u0091 \u00c9\u00ec\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00ef\u00a8\u00ef\u00c7\u00be \u00c9\u00e6\u00b6\u00bc\u00e5\u00c6\u00fb\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00a8\u00c8\u00ba\u00f2\u00c6\u00e5, \u00c4\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0, \u00bc\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00a6\u00cd\u00fa \u00ef\u00aa\u00c9\u00e5 \u00be\u00f8\u0095\u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00bc\u00cd\u00c6\u00a8\u00b4 \u00a1\u00b6\u00ea \u00ef\u00be\u00e5\u00c9\u00ec\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00be \u00c8\u00bc \u00a1\u00e6\u00c0\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00e5\u00be\u00f8\u00c0\u00ec\u00c7\u00b8\u00c6\u00a8\u00e0 \u00c0\u00e6\u00c9\u00ba\u00f9\u00c4 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\u201d.\n\n552005 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n41.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 II \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6, \u00a6\u00cd\u00fa (\u00c2) \u00ef\u00d8\u00bc\u00c6\u00b4\u00a2\u00a8\u00e0\u0094\u00ba\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00ef\u00d8\u00bc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0, \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n\u201c(\u00c4)\u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0, \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a8\u00b4\u00c6\u00ea\u00ba\u00e0\u00ba\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc, \u00a6\u00c4 \u00c4\u00ea\u00bc\u00c8 \u00c8\u00c2\u00e5 \u00aa\u00be\u00e0\u00ef\u00be\u00e0 \u00a8\u00c9\u00c7\u00a8\u00eb\u00ef\u00aa\u00be\u00e0\u00bc \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00cc\u00c4\u00aa \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e5\u00b6\u00ea, \u00c4\u00ea\u00bc\u00c8\u00e0\u00c8\u00c2\u00e5\u00aa\u00ba\u00e0 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00bc\u00fb \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00b4\u00ef\u00c2\u00bc\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c0\u00bc\u00be\u00c4 \u00c4\u00ba \u00a8\u00c9\u00c7 \u00c9\u00ec \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00c9\u00c7\u00c9\u00ec \u0097\u0093\u00a8\u00f2\u00c4\u00c6\u00a8\u00b4 \u00c6\u008a \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00a8\u00e5\u00c8 \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00be\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 ;\n\n(\u00c6)\u00c6\u008a \u00c3\u00e5\u00b8\u00e0\u00b6\u00c9\u00c8 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00cc\u00cd \u00a6\u00e0\u00c3\u00e5\u00b8\u00e0\u00b6\u00c9\u00c8 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9\u00b4\u00bc \u00cc\u00cd \u00a6\u00e0 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00b4 \u0097\u00a8\u00eb\u00b8\u00be\u00ea \u00c8\u00c2\u00be \u0095\u00c8 \u00cc\u00cd \u00c0\u00f2\u00c4\u00e5\u00bc\u00d1 \u00ef\u00aa\u00d1\u00ef\u008a \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0, \u00a6\u00a8\u00f9 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00b4 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4\u00cc\u00bf\u00cd\u00e5 \u0095\u00c8\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u00cc\u00c4\u00aa\u00a6\u00a8\u00ad\u00c9\u00be \u00ef\u008c\u00c8\u00e5\u00ef\u008c \u00bc\u00fb \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00ef\u00a8\u00e5\u00b4 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9\u00b4 \u00bc\u00c6\u00b4\u00ba\u00e0 \u00c9, \u0095\u00c8 \u00bc\u00fb \u00aa\u00ba\u00e0 \u00c9\u00cd\u00e5\u00c4 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00c4\u00e5\u00bc \u00d1 \u00ef\u00aa\u00d1\u00ef\u008a\u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u00c4\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6 \u0095\u00c8\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4.\u201d."
