10 \u0db8\u0db1\u0ddc\u0da9\u0d9a\u0db8\u0dc0\u0dbd \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 11 \u0d9a\u0dc4\u0dc0\u0dad\u0dca\u0dad \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 12 \u0dc0\u0dd0\u0dbd\u0dd2\u0db8\u0db1\u0db8\u0db4\u0ddc\u0dbd \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 13 \u0db1\u0dd2\u0dc0\u0dd2\u0dad\u0dd2\u0db1\u0dbd \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 14 \u0d85\u0dba\u0db1\u0dd9 \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 15 \u0d9a\u0dbd\u0dc0\u0dcf\u0db1 \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 16 \u0d87\u0db9\u0dd2\u0dbd\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 17 \u0db8\u0d9a\u0ddc\u0db8\u0dbd\u0ddc\u0db1\u0dca\u0db1 \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 (25) \u0d9a\u0dd1\u0d9c\u0dbd\u0dca\u0dbd 1 \u0d9a\u0dd1\u0db1\u0dbd\u0dca\u0dbd \u0dd9\u0dc4\u0dcf \u0db1\u0db1\u0d9c \u0dc3\u0dcf\u0dcf\u0dc0 2 \u0dc0\u0d9c\u0d9a\u0dcf\u0db8\u0db4\u0ddc\u0dc5 \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 3 \u0db1\u0dbd\u0dd2\u0db1\u0db8\u0dd4\u0dc0 \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 4 \u0d9a\u0dd1\u0db1\u0dbd\u0dca\u0dbd \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 5 \u0d9c\u0db9\u0dd4\u0d9a\u0dca\u0d9a\u0db1 \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 6 \u0dd9\u0dcf\u0dc0\u0db1\u0dd0\u0dbd\u0dca\u0dbd \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 7 \u0d85\u0d9c\u0dab\u0dcf\u0dba\u0d9a \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 8 \u0dba\u0da7\u0dd2\u0dba\u0db1\u0dca\u0db8\u0dad\u0ddc \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 9 \u0db6\u0dd4\u0dbd\u0dad\u0dca\u0db8\u0d9a\u0ddc\u0dc4\u0dd4\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 10 \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 11 \u0daf\u0dd0\u0d9c\u0dab\u0dd2\u0dba\u0db1\u0dbd \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 12 \u0db8\u0daf\u0dc4\u0dd2\u0d95\u0dc0\u0dd2 \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0\n\n\u0daf\u0dd2\u0dc3\u0dca\u0dad \u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dba \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\n\n11\n\n2025 \u0d85\u0d82\u0d9a 1 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\n\n\u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca (\u0dc0\u0dd2\u0dc1 \u0dda\u0dc2 \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1) \u0db4\u0db1\u0dad\n\n\u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\u0dca \u0dd2\u0db1\u0dd2\u0d82\u0dc4\u0dbd \u0db4\u0db1\u0dad\u0dca, \u0d85\u0dd2\u0d82\u0d9a 118, \u0db8\u0daf\u0ddc\u0dc3\u0dca\u0dad\u0d9c \u0da9\u0dd0\u0db1\u0dd2\u0dc3\u0dca \u0dbb\u0dca \u0daf \u0dd2\u0db1\u0dbd\u0dca\u0dc0\u0dcf \u0dd9\u0dcf\u0dc0\u0dad, \u0db8\u0d9a\u0ddc\u0dc5\u0db9 08,\n\n\u0d9c\u0da2\u0db8\u0dda \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab\u0dcf\u0dbd\u0db8\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u201c\u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0db1 \u0db4\u0dd2\u0dba\u0dc3\u201d \u0dc4\u0dd2 \u0daf\u0dd3 \u0db8\u0dd2\u0dbd \u0daf\u0dd3 \u0db1\u0dad \u0dc4\u0dd0\u0d9a\u0dd2 \u0dba."
