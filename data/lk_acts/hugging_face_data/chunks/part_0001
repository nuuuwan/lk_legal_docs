    "chunk_text": "\u201c\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00ef\u00c9\u00ce\u00bf\u00c0\u00c8\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00a6\u00c4 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00c6\u008a\u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00be\u00e0 \u00bc \u00a1\u00e6\u00ba\u00eb\u00f5\u00c9 \u00cc\u00ea\u00db\u00a8\u00eb\u008a \u00c0\u00ba\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4, \u0095\u00c8 \u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0\u00cd\u00ea\u00c9\u00c4\u00e5\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00ba\u00f8\u00c0\u00ba\u00e5 \u00a1\u00da\u00c0\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00ef\u00c9\u00ce\u00bf\u00c0\u00c8\u00a8\u00e0, \u00cd\u00ea\u00c9\u00c4\u00e5\u00c7\u00e6 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0\u00ef\u008c.\n\n12.(1) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00e8\u00c6\u00dd \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e52005 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\nIII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00c2\u00bc\u00e0\u00bc\n\n13.2005 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00cc\u00cd \u00a2\u00be\u00e0\u00c0\u00cc\u00ea \u00a6\u00ce\u00ef\u00c5\u00be \u00cc\u00e7\u00c4\u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c4 \u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0\u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00c9 \u00aa\u00b8\u00be\u00e0 \u00c2\u00c8\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00a6\u00c4\u00bc\u00fa\u00be\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00c0\u00cc\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be \u00c6\u008a \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00f8\u00be\u00e0 \u00a4\u00c0\u008e\u00ba \u00c9\u00be\u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0 \u00c9\u0090\u00be\u00e5\u00a8\u00c4 \u00c4\u00ba \u00cc\u00e7\u00c4 \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a\u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c4 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00cd\u00fa \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\n\n\u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00d1\u00ef\u008a\u00bc\u00fa\u00be\u00c6 \u00cc\u00cd\u00c9\u00aa\u00a8\u00f9\u00ef\u00c4\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0\u00a8\u00f8\u00d7\u00c4.\n\n\u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00cc\u00cd\u00ba\u00f8\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0\u00c2\u00bc\u00e0\u00bc \u00c0\u00e6\u00be\u00d1\u00c4.\n\n2005 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba8\n\n\u00cc\u00e7\u00c4 \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00c4\u00ba \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0\u00c2\u00bc\u00e0\u00bc \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00a6\u00ef\u00cc\u00e0\u00aa\u00b8\u00be\u00e0 \u00c2\u00c8\u00be\u00ea \u00c8\u00c2\u00be \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c2\u00bc\u00e0\u00ef\u00bc\u00e0\u00c0\u00f2\u00ba\u00f8\u00ca\u00ba\u00c6, \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4\u00c9\u00b6\u00e5 \u00ba\u00be\u00f8 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00a4\u00c0\u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0 \u00c9\u0090\u00be\u00e5\u00a8\u00c4 \u00a1\u00b6\u00ea \u00c9\u00ea\u00c9 \u00bc \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba\u00c0\u00d6\u00bc\u00fa \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00a8\u00c7\u00e6 \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00c0\u00e8\u00d6\u00c9\u00e6\u00c6 \u00c4\u00ba \u00c0\u00bc\u00be\u008a \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n14.13 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00cc\u00cd\u00ba\u00f8\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c2\u00bc\u00e0\u00bc, \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0, \u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00a8\u00c7\u00e6\u00b4\u00c8\u00e6\u00ef\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00bc\u00fb \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb\u201c\u00a1\u00c6\u00fa.\u00cc\u00e9.\u009b.\u00a6\u00e0.\u009c\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00cc\u00cd\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n15.13 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00cc\u00e7\u00c4 \u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c4 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u201c\u00a1\u00c6\u00fa.\u00cc\u00e9.\u009b.\u00a6\u00e0.\u009c\u201d \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00a8\u00ba\u00eb\u00a8\u00c7\u00aa\u00be\u00ea \u00c8\u00c2\u00be \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c2\u00bc\u00e0\u00bc, \u00a6\u00c4 \u00c2\u00bc\u00e0\u00bc\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c4\u00ea\u00bc\u00c8 \u00aa\u00b8\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00bc\u00be\u00c4 \u00ef\u00c0\u00be\u00e0\u00be\u00ea\u008a \u00a8\u00c7\u00be\u00c4\u00e5\u00cc\u00e8\u00a8 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00bc \u00cc\u00c4\u00aa 13 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00c8\u00cc\u00e5 \u00a1\u00e6\u00ba\u00f8\u00c0\u00d6\u00bc\u00fa \u00cc\u00e7\u00c4 \u00c4\u00e5\u00cc\u00c6\u00a8 \u00c4 \u00a1\u00c9\u00cc\u00e5\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00bc\u00fa\u00be \u00c0\u00cd\u00ef\u00ce\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00c2\u00e6\u00c7 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n16.\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c2\u00bc\u00e0\u00bc\u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00ef\u00c0\u00f2\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c4\u00e5\u00da\u00ef\u00aa\u00e5\u00e0\u00c0\u00ef\u00bc\u00e0\u00ca \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7\u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00ce \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6."
