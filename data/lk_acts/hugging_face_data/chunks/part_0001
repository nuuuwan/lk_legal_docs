    "chunk_text": "81999 \u00a1\u00e2\u00a8 22 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a2\u00ba\u00f8\u00d6\u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\n\n1999 \u00a1\u00e2\u00a8 22 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a2\u00ba\u00f8\u00d6\u00a8\u00f8\u00d7\u00ef\u008a\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n[\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00ef\u00ce\u00e0 1999 \u00a1\u00ef\u00aa\u00e5\u00e0\u00cc\u00e0\u00ba\u00eb \u00c4\u00cc 12 \u00c9\u00e6\u00be\u00e8 \u00bc\u00fa\u00be]\n\n\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00be\u00f8\u00c6\u00c4\u00c6 \u00c0\u00d6\u00bc\u00fa \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00e9.\n\n1999 \u00a1\u00ef\u00aa\u00e5\u00e0\u00cc\u00e0\u00ba\u00eb \u00c4\u00cc 13 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0\u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 II \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00a1\u00ba\u00f8\u00ef\u00da\u00a8\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00ce\u00a8\u00c7\u00be \u00c8\u00bc\u00fb\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c4\u00ea\u00f7\u00b8 \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00fb.\n\n\u00ef\u00a8\u00e5\u00ce\u00c5 1, \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be \u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00ef\u00c6\u00be\u00e0 \u0095\u00ce\u00bc\u00fb \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8\u00c6.\n\n\u0095\u00ce : \u00c7\u00e6. 5. 75\u00ba\u00e6\u00c0\u00e6\u00c8\u00e0 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9: \u00c7\u00e6.3.50 \u00c6\u00fa.\n\n[\u00a1\u00be\u00e0\u00ba\u00da\u00b0\u00e5\u00c8 \u00a1\u00be\u00ea\u00c9\u00e5\u00bc\u00c6]\n\n;\n\n11999 \u00a1\u00e2\u00a8 22 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a2\u00ba\u00f8\u00d6\u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n[\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00ef\u00ce\u00e0 1999 \u00a1\u00ef\u00aa\u00e5\u00e0\u00cc\u00e0\u00ba\u00eb \u00c4\u00cc 12 \u00c9\u00be \u00bc\u00fa\u00be.]\n\n\u00a6\u00c8\u00e0. \u009c. - \u0081. 8/98\n\n1971 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a2\u00ba\u00f8\u00d6\u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00e6\u00e2\u00a8\u00eb \u00c0\u00be\u00ba\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c0\u00be\u00ba\u00a8\u00f8.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00c4\u00ef\u00cc\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089:-1.\u00ef\u008a \u00c0\u00be\u00ba 1999 \u00a1\u00e2\u00a8 22 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a2\u00ba\u00f8\u00d6\u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089\n\n2.(\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be) 1971 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a2\u00ba\u00f8\u00d6\u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00e6\u00e2\u00a8\u00eb \u00c0\u00be\u00ef\u00ba\u00e0 3 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :(1) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u201c\u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c4\u00ea\u00f7\u00e5\u00c9\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c(4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4\u00c6\u00b4\u00ba\u00e0\u00c9 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c4\u00ea\u00f7\u00e5\u00c9\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(2) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ,\n\n\u201c(4) \u00a1\u00cc\u00be\u00f9\u00c0\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e5\u00c9\u00a8\u00e5\u00c8\u00e8\u00a8\u00c9 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0\u00c2\u00e6\u00cd\u00e6\u00c7\u00c9 \u00cc\u00e8\u009b\u00c4 \u00be\u00f8\u00cc\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ba\u00e0\u00c9\u00ef\u00c6\u00e0\u00c0\u00ea\u00c7\u00c0\u00e0\u00c0\u00e5\u00b6\u00ea\u00c9\u00a8\u00e0 \u00ba\u00f8\u009f\u00c4 \u00be\u00f8\u00cc\u00e5 \u00ef\u00cd\u00e5\u00e0 (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0. \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00ef\u00bc\u00ef\u00bc\u00be\u00a8\u00eb \u00a2\u00bc\u00fa\u00d6\u00c0\u00e8\u00b4 \u00bc\u00fb \u00c4\u00ea\u00f7\u00e5\u00c9 \u00ba\u00e6\u0094\u00c6\u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8 \u00c9\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00a6\u00a8\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb\u00cc\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u00e5\u0093\u00a8\u00e5\u00d6\u00c9\u00c7\u00c6\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00e8\u00b4 \u00bc\u00fb \u0081\u00be\u00e7\u00c4\u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e8\u00c6\u0097\u00c8\u00e0\u00c8\u00a8\u00b4 \u00c4\u00ea\u00f7\u00e5\u00c9 \u00ba\u00e6\u009f\u00c4 \u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00ef\u008c\u201d.\n\n3.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 4 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :-\n\n(1) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a2\u00c9\u00ba\u00e0\u00ef\u00a8\u00e5\u00b4\u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :-\n\n\u201c(1) \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u00c9\u00cd\u00fa \u00c0\u00f2\u00bd\u00e5\u00be \u00c9\u00f1\u00e5\u00c0\u00e5\u00d6\u00a8 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6 \u00ef\u00a8\u00e5\u00ce\u00c5 \u00c0\u00e8\u00cd\u00fa\u00b4\u00e5 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\n\nH- 022545\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e04 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n1971 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be\u00c0\u00be\u00ef\u00ba\u00e0 3 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6.\n\n21999 \u00a1\u00e2\u00a8 22 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a2\u00ba\u00f8\u00d6\u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba"
