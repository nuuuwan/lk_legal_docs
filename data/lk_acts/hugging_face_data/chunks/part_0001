    "chunk_text": "(3) \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d5 2005 \u00a5\u0081\u00cd\u00b9\u00c7\u00d7 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 I\u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u0081 \u00cd\u00b9\u00bc\u00c8\u00df\u00ba\u00c6\" \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cc\u00b1\u00be\u008c\u00b8\u00ba\u00c6\" \u00a3\u00b7\u00c6\u00b6 \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u0088\u0081\u00cd\u00b9\u00c7\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\n\n2005 \u00a4\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8\u00a4\u00ae\u00d5\u00af\u00c6\u00af\u00c7\u00b8\u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00d0\u00bd\u00c8\u00b6\u00c6\u00b6 \u00b1\u00c8\u00be\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00bf\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c7\u00b8\u00b7\u00c8\u00b6\u00c8 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00b0\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 15 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00ac\u00d7\u00af\u00c6\u00af\u00c9\u00b4\u00c6\u00d5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c63\n\n(4) \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d5 2005 \u00a5\u0081 \u00db\u0088\u008c\u00be\u00c6\" \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8\u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 I \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00b7\u00c8\u00df\u00ce\u00c1\u00bb\u00c7\u00af\u00e2\u00bf\u00c6\u00bf\u00b9\u00bd\u00c6\u00de\u00ba\u00c9\u00b6\u00c8\" \u00a3\u00b7\u00c6\u00b6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 IV \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00df\u00bf\u00c6\u00bf\u00cd\u00b7\u00cc\u00bc\u00c7\u00b6\u00c6\u00b6 \u00b9\u00b6\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00a4\u00af\u00af\u00c6 \u00e7\u0088\u00bb\u00a9\u00be\u00c6\u00ce\u00be\u00ce\u00bb \u008c\u00b3\u00c6\u00d2\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b7\u00c6\u00b6 \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u0088\u0081\u00a5\u00de\u00b6\u00c8\u008a\u00be\u00c6 \u00a3\u00b7\u00c6\u00b6 \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u0081 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c6 \u00a3\u00b7\u00c6\u00b6\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 V \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00be\u00c6 \u00a7\u00bf\u00c6\u00bf \u00cd\u00b7\u00cc\u00bc\u00c7\u00b6\u00c6\u00b6 \u00b9\u00b6\u00c8\u008c\u00be\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00a4\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00a9\u00be\u00c6\u00ce\u00be\u00ce\u00bb \u008c\u00b3\u00c6\u00d2\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n4\u00b0 \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d5 2005 \u00a5\u0081\u00cd\u00b9\u00c7\u00d7 \u00a9\u00b9\u00c6\u00cd\u00b9\u00c7\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 I \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00ba\u00c6 \u00cc\u00b9\u00de\u00ba\u00c6\u00cc\u00b9\u00de\u00ce\u00af\u00af\u00bf\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u0081 \u00ba\u00c9\u00d7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6\u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b1\u00be\u008c\u00b8+\u00c6\u00af\u00ce\u00bf\u00b1\u00c6 \u00b1\u00ba\u00c7\u00bf\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00cd\u00b9\u00c7\u00b6\u00c8\u00bb\u00b8\u00c1\u00c7\u008a\u00bc\u00c7\u008c\u0088\u0081\" \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b1\u00be\u008c\u00b8\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a3\u00c1\u00b1\u00c8\u00bb\u00cc\u00ba\u00b8 \u00a3\u00c1\u00bc\u00c6 \u00af\u00dd\u00d7\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00bf\u00c6 \u00db\u00bd\u00c6\u00b9\u00b5\u00ba\u00c7\u00af \u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b7\u00c6\u00b6 \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u00b8\u00c8\u00b4\u00db\u00bf\u00c6\u00bf \u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7\u00b9\u00b5+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u00b8\u00af\u00c6\u00af\u00c7\u00be\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00af\u00c6\u00af\u00c7\u00be\u00ba\u00c6\" \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00f2\u00be\u00ba\u00c6 \u00b9\u00b5\u00c8\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0 \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c7\u008a\u00d9\u00ba\u00c6\" \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00db\u00bd\u00c6\u00b9\u00b5\u00ba\u00c7\u00af \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00af\u00bf\u00c8\u0081 \u00e7\u00b4\u00c6\u00d5\u00cc\u00ba\u00c7\u00b6\u00c6\u00b6\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\" \u00a3\u00b7\u00c6\u00b6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 II \u00a4\u00ba\u00c6\u00b7\u00c8\u00ce\u00bc\u008a\u00df\u00bf\u00c6\u00bf \u00cd\u00b7\u00cc\u00bc\u00c7\u00b6\u00c6\u00b6 \u00b9\u00b6\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00cc\u00b1\u00be\u008c\u00b8+\u00c6\u00af\u00bf\u00c8\u0081 \u00a4\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00a9\u00be\u00c6\u00ce\u00be\u00ce\u00bb \u008c\u00b3\u00c6\u00d2\u00b6\u00be\u00c6 \u00a4\u00af\u00c7\u00d7\u00b0\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00db\u00bb\u00bd\u00c6\u00b1\u00c8 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00db\u00bd\u00c6\u00b9\u00b5\u00ba\u00c7\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c7\u00be\u00c6\" \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00f2\u00be\u00ba\u00c6\u00b9\u00b5\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00db\u00ce\u00bd\u008a\u00be\u00c6 \u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c9\u00bf\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d52005 \u00a5\u0081\u00cd\u00b9\u00c7\u00d73 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6\u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00bf\u00c8\u0081\u00cc\u00b1\u00be\u008c\u00b8\u00b6\u00c6\u00d7\u00af\u00c6\u00cc\u00af\u00b8 \u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6\u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u00b8\u00c8\u00b4\u00db\u00bf\u00c6\u00bf\u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00b5+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00db\u00bd\u00c6\u00b9\u00b5\u00ba\u00c6\u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n42004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 15 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00ac\u00d7\u00af\u00c6\u00af\u00c9\u00b4\u00c6\u00d5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6"
