    "chunk_text": "5\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 21 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081(1)\u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u201c\u00b9\u00b6\u00c8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00bf\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00c1\u00dd\u00ba\u00c6\u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00c1\u00bc\u00c8 \u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00dc\u00ba\u00c6 \u00db\u0088\u00e2\u00bd\u00c6\u00bd\u0089\u0081\u00b8\u00bc\u00c6 \u00c1\u00dd\u00ba\u00c6 \u00ba\u00c7\u00b6\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00ce\u00b4\u00b1\u00c8 \u00b7\u00c7\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u0089\u00b7\u00c6\u00b6\u00c7\u00ba\u00be\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00b9\u00b6\u00c8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00bf\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00c1\u00dd\u00ba\u00c6 \u00c1\u00bc\u00c8 \u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8 \u00db\u0088\u00e2\u00bd\u00c6\u00bd\u00ba\u00c7\u00b6\u00b6\u00c6\u00b6\u00c8\u0081 \u00b9\u00b6\u00c8\u00ce\u00b8\u00b7\u00c6\u00b6\u00c7\u00ba\u00c6 \u00b7\u00c7\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00c8\u00b7\u00c6\u00b6\u00c7\u00ba\u00be\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7\u00b0\n\n6\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 22 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 : \u2013\n\n\u00a4\u008a\u00b8\u00c6 \u00cd\u00ba\u00df\u00ba\u00c6\" \u00b6\u00ba\u00d7 \u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8\u00a9\u00be\u00c6\u00be\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00d0\u00b6\u00c8\u00bb\u00bf\u008c\u00be\u00c7\u00b8 \u00c1\u00c0+\u00c6\u00af\u00be\u00c6\u00af\u00bf\u00c6\u00ba\u00c9\u00d7\u00ba\u00c6\u00b9\u00b6\u00c6\u00d7\u00b1\u00b6\u0096\u00b6\u00b9\u00c6\u00b9\u0088 \u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00d5 \u00c1\u00bc\u00c8\u00af\u00c6\u00d0 \u00af\u00b5\u00af\u00c6\u00af\u00c9\u00d5\u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00dd\u00ba\u00c6 \u00a3\u00c1\u00bc\u00c7\u00be\u00c6 \u00cc\u00b9\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008122 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008121 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c67\n\n\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00c0+\u00c6\u00af\u00be\u00c6\u00af\u00bf\u00c8\u0081 \u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u008a\u0081 \u00ba\u00c9\u00d7 \u00b9\u00b6\u00c6\u00d7\u00b1\u00b6\u0096\u00b6\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00ba\u00c6 \u00e7\u00d5\u00b6\u00be\u00c7\u00b8 \u0096\u00b6\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u00be\u00c6 \u00a7\u00bf\u00c6\u00bf\u00c9\u00b4\u00c6\u00d5\u00c1\u00bc\u00c8\u00ce\u00bb\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00c8\u008a\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6\" \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6\u00a3\u00d9\u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8\u00c1\u00c7\u00de \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00c1\u00c0+\u00c6\u00af\u00be\u00c6\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a7\u00bf\u00c6\u00bf\u00c9\u00b4\u00c6\u00d5 \u00c1\u00bc\u00c8\u00bb\u00c7\u00af \u00cc\u00be\u00c7\u00bd\u00c8\"\u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00cd\u00af\u00c7\u00b1\u00c6\u00d2 \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c7\u00af\u00b8\u00ba\u00c6 \u00ac\u0081\u00bd\u00c8\u0081\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00bd\u008c\u00bc\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c6 \u00b9\u00b6\u00c6\u00d7\u00b1\u00b6\u0096\u00b6\u00b9\u00c6\u00b9\u0088\u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a7\u00bc\u00c8\u00b6\u00c6\u00d7\u00ce\u00b4\u00bb\u00c1\u00bc\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00a5\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u201c\u00cc\u00be\u00c7\u00bd\u00c8\u201d \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u201c\u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00cd\u00af\u00c7\u00b1\u00c6\u00d2\u201d \u00a9\u0081\u00b9\u00b8 (203 \u00a4\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8) \u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00c7\u00c6 \u00c1\u00c7\u00af\u00b8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00db\u00ce\u00bd\u00cd\u00bb \u00a3\u00c1\u00bd\u00c6\u00de\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00d7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00cd\u00b6\u00cc\u00b9\u00c7\u00dd\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u201c\u00c1\u00af\u0081\u201d \u00a9\u0081\u00b9\u00d7 1995 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b7\u00c8\u00b6\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00b6\u00bd\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00d7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00cd\u00b6 \u00cc\u00b9\u00c7\u00dd\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d\u00b0\n\n(2)\u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (4) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00ce\u00c1 \u00b7\u00c9\u00af\u00c6\u00af\u00c8\u008c\u00b4\u00c6\u00d5 \u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00ce\u00c1 \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 :"
