    "chunk_text": "(\u00a4)1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00ba\u00c6\u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u0089\u0081\u00b8\u00c7\u00c6\u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00c7\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00ba\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00be\u00c6\u00be\u00c7\u00b1\u00b9\u00c6\u0089\u00bc\u00bb\u00c7\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd\u00ce\u00bb \u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6 \u00af\u00c7\u00b8\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7\u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00c8\u00c7\u00c6\u00ba\u00c7\u00b5 \u00cd\u00c1\u00ce\u00be\u00af\u00c6\u00af\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 (3(\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6\u0089\u00c7\u00c8\u008c\u0081 \u00af\u00dd\u00b6\u00c6\u00cc\u00b6\u00be\u00c6\u00ce\u00be\u00af\u00c6\u00d0\u00bf\u00c6) \u00af\u00c8\u00ce\u00b4\u00af\u00c6\u00d0\u00ba\u00c6\u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6\u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0 \u00af\u00c8\u0081\u00bd\u008c\u00b4\u00b6\u00c6\u00d7\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008132 \u00a6\u00a6\u00a6\u00a6 \u00a9\u0081\u00d9\u00ba\u00c6\u0089\u00c7\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n121999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 41 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(2)\u00a3\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081 (2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u00be\u00c6 \u201c\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00af\u00ba\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u00be\u00c6 \u00a5\u00dd\u00b7\u00c6\u00d7\u00af\u00c8\u00ce\u00b4\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00ba\u00c6\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af, \u201c\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00af\u00ba\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u008b\u00dd\u00bd\u00c6\u00d7 \u00af\u00c8\u00ce\u00b4\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u00b7\u00c8\u00c7\u00c6\u00ba\u00c7\u00b5 \u00cd\u00c1\u00ce\u00be\u00af\u00c6\u00af\u00c7\u00b8 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6\u00b0\n\n11\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 32 \u00a7\u00a7\u00a7\u00a7 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00c7\u00c8\u00e2\u00a3\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081 (3) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u00be\u00c6, \u201c\u00c1\u00c7\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00bf\u00c7\u00c6\u00b6\u00c8\u00dd\u00b9\u00c6\u00b6\u00c8\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u008c\u00b4\u00b6\u00c6\u00d7\u201d \u00a9\u0081\u00b9\u00d7 \u00cc\u00b6\u00c7\u00b4\u00af\u00c6\u00af\u00ba\u00c6 \u00a3\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u00db\u0088\u00e2\u00de\u00ba\u00c6 \u00c1\u00ce\u00bc\u008a\u00be\u00c7\u00b8 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8 \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c\u00c1\u00c7\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00bf\u00c7\u00c6 \u00b6\u00c8\u00dd\u00b9\u00c6\u00b6\u00c8\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u008c\u00b4\u00b6\u00c6\u00d7,\u00a3\u00af\u00c6\u00af\u00ba\u00c6\u00b9\u00b8\u00c8 \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u0089\u00be\u00c6,\n\n(1)\u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u00c1\u00c7\u00b8\u00d7, 1997, \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6\u00c1\u00c7\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00d0 \u00a3\u00af\u00c6 \u00af\u00ba\u00c6\u00b9\u00b8\u00c8\u00af\u00c6\u00d0 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6\u00b0\n\n12\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 32 \u00a7\u00a7\u00a7\u00a7\u00a7 \u00a9\u0081\u00d9\u00ba\u00c6\u0089\u00c7\u00c8\u00e2 \u00a3\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081 (3) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u0081 (\u00a4) \u00a9\u0081\u00d9\u00ba\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u201c\u00b9\u00b6\u00c8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00a9\u00ae\u00b5\u00c8\u00af\u00c6\u00ce\u00af\u201d\u00a9\u0081\u00b9\u00b6\u00c8\u00be\u00c8\u00dd\u00b7\u00c6\u00d7 \u00a3\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081 \u00a5\u00de\u00b6\u00c8\u00c1\u00ce\u00bc\u008a\u00be\u00c7\u00b8 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6\u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8 \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6\u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008132 \u00a7\u00a7\u00a7\u00a7\u00a7\u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00c7\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00bc\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 32\u00a7\u00a7\u00a7\u00a7 \u00a9\u0081\u00d9\u00ba\u00c6\u0089\u00c7\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 41 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c613\n\n\u201c\u00b9\u00b6\u00c8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00a9\u00ae\u00b5\u00c8\u00af\u00c6\u00ce\u00af\u00db\u00b7\u00c6\u00d8{\u00de \u00cd\u00b9\u00c7\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00ba\u00be\u00c6 \u00a5\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\u00cc\u00b6\u00b8\u00c1\u00c7\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00bf\u00c7\u00c6 \u00b6\u00c8\u00b9\u00c6\u00b6\u00c8\u00dc\u00de\u00af\u00c8\u0081\u00bd\u008c\u00b4\u00b6\u00c6\u00d7,\n\n(1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u00c1\u00c7\u00b8\u00d7,1997, \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6\u00c1\u00c7\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0, \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00a5\u00bc\u00ae\u00b4\u00ce\u00bc\u00b1\u00c6\u00b1\u00b6\u0096\u00b6\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b1\u00c6 \u00b1\u00ba\u00ba\u00c7\u00b8 \u00cc\u00b6\u00c7\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00af \u00a3\u00af\u00c6\u00af\u00ba\u00c6\u00b9\u00b8\u00c8\u00af\u00c6\u00d0\u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b6\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u201d\u00b0"
  },
