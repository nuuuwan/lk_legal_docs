    "chunk_text": "\u201c\u00ba\u00ee\u00ba\u00e9\u00c6\u00fa\u00a8 \u00cd\u00e5\u00c9\u00ee\u00ba\u00e0\u00ba\u00e9\u00c6\u00a1\u00bd\u00f1\u00e5\u00c0\u00be\u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0\u00cc\u00c3\u00e5\u00c9\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e04 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n21999 \u00a1\u00e2\u00a8 50 \u00bc\u00c7\u00be \u00ba\u00ee\u00ba\u00f9\u00c6\u00fa\u00a8 \u00cd\u00e5 \u00c9\u00ee\u00ba\u00e0\u00ba\u00e9\u00c6 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(\u00a6) \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be\u00c6 \u00cd\u00e5 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00c9 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00a8\u00c7\u00be\u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cd\u00e5 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00bc \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00c7\u00a8\u008a \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00f9\u00c4\u00b4 ;\n\n(\u00a7) \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00be\u00f8\u00c0\u00ea\u00b8\u00ba\u00e5\u00c9\u00c6\u00be\u00e0, \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00c9\u00e6\u00b6\u00cc\u00b4\u00cd\u00be\u00e0,\u00c0\u00d7\u00a8\u00e0\u00cb\u00b8 \u00cc\u00cd \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00a8\u00f2\u00c4\u00c6\u00be\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00cc\u008a\u00c4\u00ba\u00c6\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00c9 \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6\u00a1\u00bd\u00f1\u00e5\u00c0\u00be\u00c6 \u00cd\u00e5 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00c9 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6 \u00cc\u00cd\u00ba\u00f8\u00a8\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00a8\u00f2\u00c4\u00c6\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4 \u00cc\u00cd \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c4\u00b4 ;\n\n(\u00a1) \u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a4\u00f0) \u00ef\u00d8\u00bc\u00c6 \u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u0081) \u00ef\u00d8\u00bc\u00c6\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00be\u00e6\u00c9\u00ba \u00a1\u00a8\u00e0\u00cb\u00c7 \u00ef\u00c6\u00bc\u00fb\u00ef\u00c4\u00be\u00e0 .\n\n4.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 6 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :-\n\n6. (1) \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00c9 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00cc\u00c4\u00be\u00e0\u0097\u00ba \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :-\n\n(\u00a1) 10 (1) (\u00a1) \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00ba\u00ee\u00ba\u00f9\u00c6\u00fa\u00a8 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be\u00c6 \u00cd\u00e5 \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6\u00a1\u00bd\u00f1\u00e5\u00c0\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 ;\n\n(\u00a1\u00e5) VI \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u00e5\u00bd\u00ea\u00be\u00f8\u00a8\u00ba\u00e0\u00c9 \u00cd\u00e5 \u00a8\u00e5\u00da\u0095\u00a8 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0 \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5 ;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e06 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0\u00cc\u00c3\u00e5\u00ef\u008c\u00cc\u00e2\u00c6\u00ea\u00ba\u00f8\u00c6.\n\n31999 \u00a1\u00e2\u00a8 50 \u00bc\u00c7\u00be \u00ba\u00ee\u00ba\u00e9\u00c6\u00fa\u00a8 \u00cd\u00e5 \u00c9\u00ee\u00ba\u00e0\u00ba\u00e9\u00c6 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(\u00a1\u00e6) 1995 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6\u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0\u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5 ;\n\n(\u00a1\u00e7) \u00a8\u00e5\u00da\u0095\u00a8 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00cd\u00e5 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 ;\n\n(\u00a2) 1995 \u00a1\u00e2\u00a8 29 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a4\u00cc\u00cc\u00e0 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a4\u00cc\u00cc\u00e0 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 ;\n\n(\u00a3) \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00c4\u00cc\u00e5 \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c4\u00ea\u00bc\u00c8\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00ef\u00c6\u00a8\u00eb ;\n\n(\u00a4) \u00b0\u00be\u00e5\u0093\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00c4\u00cc\u00e5\u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00cc\u0095\u00ba\u00f8 \u00c4\u00aa\u00fa\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00a1\u00ba\u00eb\u00d6\u00be\u00e0 \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00cc\u0095\u00ba\u00f8\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb ;\n\n(\u00a4\u00f0) \u00b0\u00be\u00e5\u0093\u00c0\u00ba\u00e8\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00c4\u00cc\u00e5\u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00a1\u00e2\u00ca\u00ef\u00c6\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00c6\u00be\u00e0 \u00a1\u00ba\u00eb\u00d6\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be)\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00bc\u00cd \u00ef\u00bc\u00ef\u00be\u00a8\u00e0, \u00a2\u00be\u00e0 \u00a1\u00c9\u00c4 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00a1\u00b4 \u00ef\u00bc\u00be\u00a8\u00eb\u00c9\u00ba\u00e0 \u00c9\u00e5\u00b8\u00e8\u00b0 \u00cd\u00e5 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00cd\u00e5 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e2\u00aa\u008a\u00c4\u00aa\u00fa\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
