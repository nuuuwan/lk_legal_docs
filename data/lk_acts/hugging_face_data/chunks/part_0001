    "chunk_text": "\u201c\u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00ef\u00c6\u00e0\u00cc\u00e9\u00c4\u00e5\u00c9\u00be\u00e0\u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4\u00bc \u00cc\u00c3\u00fa\u00a8\u00c6\u00be\u00e0\u00cc\u00e2\u00a9\u00f1\u00e5\u00c9 \u00ef\u00c9\u00be\u00cc\u00e0\u00a8\u00f8\u00d7\u00c4\u00b4 \u00bc\u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c9\u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5\u00cd\u00e6\u00d7\u00c4\u00b4 \u00cc\u00cd\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00a8\u00f8\u00d7\u00c4\u00b4 \u00bc\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00b4\u00a1\u00e6\u00ba\u00f8 \u00c2\u00c8\u00c6.\n\n21999 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n\u00be\u00c9 \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00e9\u00c6 \u00cc\u00c3\u00e5\u00c9\u00bc\u00e6\u00be\u00b4 \u00c0\u00c9\u00ba\u00e0\u00be\u00e5\u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00ef\u008c\u00a1\u00be\u00ea\u00c0\u00f2\u00e5\u00c0\u00e0\u00ba\u00f8\u00a8\u00c6\u00e5 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9\u00bc, \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00a8\u00f8\u00cc\u00e8\u00f3 \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0, \u00a6\u00e0 \u00be\u00f8\u00c6\u00c4\u00ef\u00c6\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00bc\u00e6\u00be\u00b4 \u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00c6\u008a \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c9\u00a8\u00cc\u00c3\u00fa\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00bd\u00ea\u00c7 \u00a8\u00e5\u00c8\u00c6 \u00a2\u00a8\u00eb\u00ba\u00e0\u00c9 \u00c6\u00be \u00ef\u00ba\u00a8\u00e0\u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n9 \u00a1\u00e5. \u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00d6\u00b8\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00cc\u00c3\u00e5\u00c9\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b49\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00be\u00c9 \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c9\u00a8\u00e0 \u00cc\u00e2\u00c6\u00ea\u00a8\u00e0\u00ba\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb -\n\n(\u00a1) \u00be\u00c9 \u00cc\u00c3\u00e5\u00c9 \u00cc\u00e2\u00c6\u00ea\u00a8\u00e0\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00ef\u008c\u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00cc\u00e9\u00c4\u00e5\u00c9\u00c8\u00b4, \u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00d6\u00be \u00c8\u00bc \u00cc\u00c3\u00e5\u00c9\u00cc\u00e2\u00c6\u00ea\u00a8\u00e0\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5 \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6 \u00ef\u00cd\u00e5\u00e0\u00a2\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00be \u00ba\u00e5\u00a8\u00e0 \u00f3\u00c7\u00b4, \u00a6\u00e0\u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc\u00b4 \u00a1\u00bc\u00e5\u00ce \u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00da\u00c6\u00cc\u00bf\u00cd\u00e5 \u00be\u00c9 \u00cc\u00c3\u00e5\u00c9, \u00a6\u00c6 \u00cc\u00e2\u00c6\u00ea\u00a8\u00e0\u00ba \u00a8\u00ce \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4,\u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00d6\u00be \u00c8\u00bc \u00cc\u00c3\u00e5\u00ef\u008c \u00a1\u00be\u00ea\u00c0\u00f2\u00e5\u00c0\u00e0\u00ba\u00f8\u00a8\u00c6\u00e5 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6;\n\n(\u00a1\u00e5) \u00be\u00c9 \u00cc\u00c3\u00e5\u00ef\u008c \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00cc\u00e9\u00c4\u00e5 \u00ba\u00eb\u00ce \u00c0\u00e8\u00cd\u00fa\u0090,\u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00d6\u00b8\u00ea \u00c8\u00e6\u00c2\u00ec \u00cc\u00c3\u00e5\u00ef\u008c \u00cc\u00e8\u00c6\u00f5 \u00ef\u00bc\u00e0\u00c0\u00ce\u00bc, \u00a6\u00e0 \u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00d6\u00be \u00c8\u00bc \u00cc\u00c3\u00e5\u00ef\u008c \u00cc\u00e8\u00c6\u00f5\n\n31999 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8 \u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0\u00a6\u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5\u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n\u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a, \u00c2\u00c8\u00ba\u00c8, \u00a8\u00e5\u00da\u00c6, \u00b8\u00c6, \u00c2\u00e6\u00c7\u00a8\u008a \u00cd\u00e5\u00c9\u00aa\u00a8\u00f9\u008a, \u00be\u00c9 \u00cc\u00c3\u00e5\u00ef\u008c \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00cc\u00e9\u00c4\u00e5 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c6\u008a\u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c9\u00be \u00ba\u00e5\u00a8\u00e0 \u00f3\u00c7\u00b4 \u00be\u00c9 \u00cc\u00c3\u00e5\u00c9\u00cc\u00e2\u00c6\u00ea\u00a8\u00e0\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00a6\u00e0 \u00be\u00c9 \u00cc\u00c3\u00e5\u00c9 \u00ef\u00c9\u00ba\u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6;\n\n(\u00a1\u00e6) \u00c6\u008a \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e5\u00bc\u00be \u00c8\u00bc \u00c6\u008a\u00be\u00f8\u00c6\u00c4\u00c6\u00a8, \u00d7\u00ba\u00f8\u00c6\u00a8, \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6\u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6 \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00c8\u00e8\u00c6\u00e5 \u00a1\u00ba\u00e0\u00cc\u00be\u00e0\u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0\u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8 \u00a6\u00c9\u00e6\u00be\u00f8 \u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00d6\u00be \u00c8\u00bc \u00cc\u00c3\u00e5\u00c9\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e8\u00c6\u00f5 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00f8\u00d7\u00c4, \u00be\u00c9\u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00ef\u008c \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00cc\u00e9\u00c4\u00e5\u00c9\u00c8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a6\u00e0 \u00cc\u00c3\u00e5\u00ef\u008c \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00cc\u00e9\u00c4\u00e5\u00c9\u00c8\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00c6\u008a \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00be\u00c9\u00cc\u00c3\u00e5\u00c9\u00b4 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00f8\u00d7\u008a \u00c9\u00ec\u00c9\u00e5\u00a8\u00e0 \u00ef\u00c4\u00be\u00e0 \u00ef\u00ba\u00e0\u00c7\u00e6\u008a\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d\n\n3.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00e8 \u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n41999 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba"
