    "chunk_text": "(2)\u201c\u008c\u00bd\u00c6\u00b9\u00ce\u00b8 \u00c1\u00bc\u00e2\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00be\u00c6\u00be\u00ce\u00ba\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00b8 \u00c1\u00ce\u00bc\u008c\u00be\u00af\u00c6\u00af\u00b5\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\" \u00a3\u00b6\u0081 (ii) \u00a4\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00ce\u00bb \u00b7\u00c9\u00af\u00c6\u00af\u00c8\u008c\u00b4\u00c6\u00d5\u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00ce\u00bb \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n2004 \u00a4\u00ba\u00c6\u00a4\u00ae\u0088\u008111 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 I \u00a4\u00ba\u00c6\u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081 2 \u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00813 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u201c(ii) \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00f2\u00be\u00b6\u00b8\u00b1\u00c6 \u00cc\u00b1\u00c7\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00ce\u00bf\u00af\u00c6\u00ce\u00af\u00dc\u00b6\u00c8\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00b6\u00c7\u00b8 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u00c1\u00dd\u00ba\u00c6\u00b9\u0088\u00af\u00ce\u00bf\u00af\u00c6 \u00af\u00c0\u00c8\u00b6\u00c6\u00b6 \u0089\u0081\u00b8\u00dd\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u201d.\n\n3\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 3 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n(1) \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u201c\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6\u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9+\u00c6\u00af\u00c7\u00ae\u00ce\u00ba\u008a\u00b8\u00c7\u00be\u00c6\u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cd\u00b1\u00ce\u00c1 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u00bb\u00c7\u00b8\u00d7 (\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u201c\u00db\u00b6\u008b\u00bd\u00c6 \u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00d5\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00a3\u00b7\u00c6\u00b6 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00af\u00c7\u00af \u00a3\u00b7\u00c6\u00b6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9+\u00c6\u00af\u00c7\u00ae\u00ce\u00ba\u008a\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00af\u00c0\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6)\u00b0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cd\u00b1\u00ce\u00c1 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u00bb\u00c7\u00b8\u00d7 \u00a3\u00b7\u00c6\u00b6\u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00af\u00c7\u00af \u00a3\u00b7\u00c6\u00b6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8 \u00aa\u00d7\u00ba\u00c8\u00dd\u00b9\u00c6\u0089\u0081 \u00a3\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6\n\n(2) \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00ce\u00c1 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00ce\u00c1 \u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 ;\u00a5\u00d7 \u00a3\u00b6\u0081 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00e2 (1\u00a3) \u00a9\u0081\u00bd\u00c7\u00bd\u00c6\u00cd\u00b9\u00c7\u0081\u00de\u00b9\u00bb\u00d9\u00de\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :-\n\n\u201c(1\u00a3) \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00af\u00c7\u00af \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9+\u00c6\u00af\u00c7\u00ae\u00ce\u00ba\u00bb\u00c7\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cd\u00b1\u00ce\u00c1 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u00bb\u00c7\u00b8\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9+\u00c6\u00af\u00c7\u00ae\u00ce\u00ba\u008a\u0081 \u00b9+\u00c6\u00af\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c6 \u00a3\u00b7\u00c6\u00b6 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00af\u00c7\u00af \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9+\u00c6\u00af\u00c7\u00ae\u00ce\u00ba\u008a\u0081 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00b4\u00c6\u00b4+\u00c6\u00af\u00ce\u00bf \u00a9\u00b7\u00c6\u00b6\u008c\u00af\u00c8\u00b6\u00c7\u00b1\u00c7\u00bc\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b9\u00af\u00c8\u00bc\u00c6\u00b7\u00c6\u00d7\u00cc\u00af\u00c7\u00bf\u00c6\u00af\u00c8\u0081\u00bd\u00c7\u00bc\u00c6\u00af\u00cd\u00bf\u00c7 \u00a3\u00b7\u00c6\u00b6\u008c\u00af\u00c8\u00b6\u00c7\u00b1\u00c7\u00bc\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9+\u00c6\u00af\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c8\u00ce\u00b4\u00cd\u00bb\u00b9+\u00c6\u00af\u00c8\u00b4\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ; \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00b9+\u00c6\u00af\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b1\u00ce\u00c1 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u00bb\u00c7\u00b8\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\n\n32005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 7 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b7\u00c8\u00b6\u00c8 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6)\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00b9+\u00c6\u00af\u00c7\u00bf\u00bc\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0 (\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u201c\u00db\u00b6\u008b\u00bd\u00c6 \u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00d5\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9+\u00c6\u00af\u00c7\u00ae\u00ce\u00ba\u008a\u00b8\u00c7\u00be\u00c6\u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d\u00b0"
