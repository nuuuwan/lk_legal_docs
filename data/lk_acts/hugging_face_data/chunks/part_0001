    "chunk_text": "(vii) \u00ef\u00c4\u00e5\u00c7\u00b4\u00ea\u00c9 \u0097\u00ca\u00e0\u00c9\u0097\u00bc\u00f1\u00e5\u00c8\u00ef\u00c6\u00e0 \u00be\u00e5\u0095\u00a8 \u00a2\u00e2\u00d4\u00ef\u00be\u00e0\u00c7\u00e6 \u00c0\u00e9\u00b5\u00ef\u00c6\u00e0\u00c0\u00e9\u00b5\u00e5\u0093\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5 ;\n\n\u00cc\u00c3\u00e5\u00ef\u008c\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00c0\u00e5\u00d6\u00ca\u00f2\u0095\u00a8.\n\n\u00ca\u00e5\u00cc\u00e0\u00ba\u00f2\u00e9\u00c6 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6.\n\n91999 \u00a1\u00e2\u00a8 36 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u009e\u00c9\u00c7 \u00cd\u00e5 \u00be\u00e5\u0097\u00a8 \u00a2\u00e2\u00d4\u00ef\u00be\u00e0\u00c7\u00e6\u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c0\u00be\u00ba\n\n(viii) \u00ef\u00a8\u00e5\u00ce\u00c5 \u0097\u00ca\u00e0\u00c9\u0097\u00bc\u00f1\u00e5\u00c8\u00ef\u00c6\u00e0 \u00cc\u00c4\u00e5\u00b0 \u0097\u00bc\u00f1\u00e5 \u00c0\u00e9\u00b5\u00ef\u00c6\u00e0 \u00c0\u00e9\u00b5\u00e5\u0093\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5\u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5 ;\n\n(x) 1981 \u00a1\u00e2\u00a8 54 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0 \u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cc\u00cd\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00e5\u00c6\u00ba\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00b0\u00e5\u00ba\u00f8\u00a8\u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0 \u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cc\u00cd \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb- \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 ;\n\n(xi) 1990 \u00a1\u00e2\u00a8 20 \u00bc\u00c7\u00be \u00ba\u00ee\u00ba\u00e9\u00c6\u00fa\u00a8 \u00cd\u00e5 \u00c9\u00ee\u00ba\u00e0\u00ba\u00e9\u00c6 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u00e5\u00bd\u00ea\u00be\u00f8\u00a8\u00ba\u00e0\u00c9 \u00cc\u00cd \u00a8\u00e5\u00da\u0095\u00a8 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00a8\u00f8\u00d7\u008a \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb- \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5 ;\n\n(xii) \u00c4\u00cd\u00ef\u00c0\u00e5\u00ce \u00a1\u00c3\u00f1\u00e5\u00cc \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00ef\u00c6\u00a8\u00e0 ;\n\n(xiii) \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00ca\u00e5\u00cc\u00e0\u00ba\u00f2\u00e9\u00c6 \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u00c8 \u00c0\u00f2\u00bd\u00e5\u00be\u00f9\u00be\u00e0.\n\n13.(1) \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00cc\u00c3\u00e5\u00c9\u00b4 \u00c9\u00aa\u00a8\u00e8\u00c9 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a8\u00da\u00ba\u00c9\u00f1 \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00c4 \u00a6\u00c6 \u0097\u00cc\u00e8\u00be\u00e0\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6 :-\n\n(\u00a1) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9, \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a8\u00e5\u00c7\u00b8\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00cc\u00c3\u00e5\u00c9\u00b4\u00a4\u00c0\u00ef\u00bc\u00cc\u00e0 \u00bc\u00fb\u00c4 ;\n\n(\u00a1\u00e5) \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00d7\u00ba\u00f8\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u0097\u00c3\u00e5\u00aa \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00cd\u00a6\u00e0 \u0097\u00c3\u00e5\u00aa\u00c9\u00c8\u00e8\u00be\u00e0 \u00cc\u00c4\u00da\u00bb \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0\u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8 \u00a2\u00b4\u00ea\u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5\u00c9\u00ec \u00bc \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u0091\u00c0\u00e0\u00ef\u00c8\u00e5\u00e0\u00c4\u00e5, \u00cc\u00cd\u00ba\u00f8\u00a8 \u00c0\u00ba\u00f2 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0\u00ca\u00e5\u00cc\u00e0\u00ba\u00f2\u00e9\u00c6 \u0097\u00ca\u00fa\u00cb\u00e0\u00b4\u00ba\u00e5 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00ea\u00f3\u00cc\u00ea \u00c9\u00be\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00cc\u00c3\u00e5\u00c9 \u00ef\u00c9\u00ba \u00be\u00f8\u00da\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a1\u00e6) \u00cc\u00c3\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c6 \u00ef\u00c9\u00ba \u00ef\u00c6\u00e5\u00c4\u00ea \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00a8\u00e5\u00c7\u00b8\u00c6\u00a8\u00e0\u00aa\u00e6\u00be \u00cc\u00c8\u00a8\u00e5\u00c2\u00c8\u00e5 \u00c9\u00e5\u00da\u00ba\u00e5 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a1\u00e7) \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00c0\u00e5\u00b5\u00c4\u00e5\u00c8\u00e5, \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00d1\u00ef\u008a \u00c9\u00e6\u00b6\u00cc\u00b4\u00cd\u00be\u00e0 \u00cd\u00e5\u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u0097\u00c3\u00e5\u00aa \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00c7\u00b8\u00e5\u00c4\u00ba \u00be\u00f8\u00da\u00ef\u00bc\u00e0\u00ca \u00cd\u00e5 \u00c9\u00e5\u00da\u00ba\u00e5 \u00cc\u00c3\u00e5\u00c9 \u00ef\u00c9\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 ;\n\n\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c2\u00c8\u00ba\u00c8.\n\n101999 \u00a1\u00e2\u00a8 36 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u009e\u00c9\u00c7 \u00cd\u00e5 \u00be\u00e5\u0097\u00a8 \u00a2\u00e2\u00d4\u00ef\u00be\u00e0\u00c7\u00e6\u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c0\u00be\u00ba\n\n(\u00a2) \u00a1\u00bd\u00f1\u00c6\u00be \u00c0\u00e5\u00b5\u00c4\u00e5\u00c8\u00e5\u00c9\u00c8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00d1\u00ef\u008a \u00c9\u00e6\u00b6\u00cc\u00b4\u00cd\u00be\u00e0\u00c9\u00c8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea\u00c8\u00c2\u00be \u0097\u00c3\u00e5\u00aa \u00cc\u00bf\u00cd\u00e5 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0\u00cc\u00c3\u00e5\u00c9 \u00ef\u00c9\u00ba \u00be\u00f8\u00da\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a3) \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00bd\u00f1\u00c6\u00be \u00c0\u00e5\u00b5\u00c4\u00e5\u00c8\u00e5\u00c9\u00c8\u00b4, \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00d1\u00ef\u008a \u00c9\u00e6\u00b6\u00cc\u00b4\u00cd\u00be\u00e0 \u00c9\u00c8\u00b4 \u00cd\u00e5 \u0097\u00c3\u00e5\u00aa\u00c9\u00c8\u00b4\u00a1\u00bc\u00e5\u00ce \u00c9\u00be \u00d7\u00ba\u00f8 \u00cc\u00e7\u00bc\u00fb\u00c4 ;\n\n(\u00a4) \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u0097\u00c3\u00e5\u00aa\u00c9\u00c8 \u00bc\u00fb\u00c0\u00d7\u00a8\u00e0\u00cb\u00a8\u00c9\u00c7\u00c6\u00be\u00e0 \u00ef\u00c8\u00cc \u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00c6\u00e5\u00e0\u00aa\u00f1\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00e0 \u00be\u008a \u00cc\u00c3\u00e5\u00c9 \u00ef\u00c9\u00ba \u00be\u00f8\u00da\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00c4 ;"
