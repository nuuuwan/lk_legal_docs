    "chunk_text": "(\u00a1\u00e6) \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6 \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00a6\u00e0 \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0(iii) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00be\u008a, \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4\u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb \u00c9\u00be \u00a1\u00ba\u00c7, \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00be\u00e0\u00c0\u00cd\u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0 \u00ef\u00be\u00e5\u00c9, \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00a1\u00e6\u00ba\u00f8\u00c9\u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00a1\u00c9\u00cc\u00e5\u00be \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a7\u00cd\u00ea \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0\u00c9\u00ec \u00ef\u00c8\u00cc \u00c7\u00e5\u00b0\u00f1 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00a1\u00da\u00bb\u00cc\u00e5\u00bd\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5\u00cc\u00ce\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\n\n(i) \u00a7\u00cd\u00ea \u00a6\u00e0 \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (i) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00e2\u00ba\u00f8\u00c6\u00b4 \u00ef\u00cd\u00e5\u00e0\u0097\u00cc\u00e0\u00ba\u00c7\u00c6\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00c7\u00e5\u00b0\u00f1 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00be\u008a, \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb\u00c7\u00b0\u00ef\u00c6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c8\u00e6\u00c2\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00c7, \u00a6\u00e0 \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00bd\u00ea\u00c7\u00c6 \u00a1\u00ef\u00cd\u00e5\u00e0\u00cc\u00e8 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00c9 \u00c4\u00ba \u00a7\u00cd\u00ea\u00c7\u00b0\u00ef\u00c6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00be\u008a \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0\u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a7\u00cd\u00ea\u00b4 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u0097\u00ca\u00f2\u00e5\u00c4\u00c9\u00e6\u00b4\u00ea\u00c0 \u00c4 \u00c8\u00e6\u009f\u00c4\u00b4 \u00a7\u00cd\u00ea \u00cd\u00fa\u0095\u00a8\u008a \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n(ii) \u00a7\u00cd\u00ea \u00a6\u00e0 \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (ii)\u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00e2\u00ba\u00f8\u00c6\u00b4 \u00ef\u00cd\u00e5\u00e0\u0097\u00cc\u00e0\u00ba\u00c7\u00c6\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00c7\u00e5\u00b0\u00f1 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00be\u008a, \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb\u00c7\u00b0\u00ef\u00c6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u00a1\u00cc\u00e0 \u00c9\u00ec \u00ef\u00c8\u00cc \u00cc\u00ce\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00e0\u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00bd\u00ea\u00c7\u00c6 \u00a1\u00ef\u00cd\u00e5\u00e0\u00cc\u00e8 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00c9 \u00c4\u00ba \u00a7\u00cd\u00ea \u00c7\u00b0\u00ef\u00c6\u00e0\u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00c9\u00ec\u00ef\u00c6\u00e0 \u00be\u008a, \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9 \u00c6\u00b4\u00ef\u00ba\u00e0\u00a7\u00cd\u00ea\u00b4 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00bc\u00e9\u00c4\u00be\u00e5\u00c9 \u00c4 \u00c8\u00e6\u009f\u00c4\u00b4 \u00a7\u00cd\u00ea \u00cd\u00fa\u0095\u00a8\u008a\u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6 ; \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\n\n(iii) \u00a7\u00cd\u00ea \u00a6\u00e0 \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (iii) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00e2\u00ba\u00f8\u00c6\u00b4\u00ef\u00cd\u00e5\u00e0 \u0097\u00cc\u00e0\u00ba\u00c7\u00c6\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00c7\u00e5\u00b0\u00f1 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00be\u008a, \u00c7\u00e5\u00b0\u00f1\u00ef\u00cc\u00e0\u00c9\u00e5 \u00a1\u00da\u00bb\u00cc\u00e5\u00bd\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00e5\u00da\u00c6\u00cc\u00bf\u00cd\u00e5 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u00c0\u00cd\u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00c9 \u00c4\u00ba \u00ef\u00be\u00e5\u00c9,\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00a1\u00e6\u00ba\u00f8\u00c9 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00a1\u00c9\u00cc\u00e5\u00be\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a7\u00cd\u00ea \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c\u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u00a1\u00cc\u00e0 \u00c9\u00ec \u00ef\u00c8\u00cc \u00cc\u00ce\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n161999 \u00a1\u00e2\u00a8 36 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u009e\u00c9\u00c7 \u00cd\u00e5 \u00be\u00e5\u0097\u00a8 \u00a2\u00e2\u00d4\u00ef\u00be\u00e0\u00c7\u00e6\u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c0\u00be\u00ba\n\n(2) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00cd \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00ba\u00c7 \u00c6\u008a \u00aa\u00e6\u00b4\u00ea\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u0097\u00b4\u00a8, \u00a6\u00e0 \u00aa\u00e6\u00b4\u00ea\u00ef\u008a \u00ef\u00cd\u00e5\u00e0\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00ef\u008c \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4 \u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a6\u00e0\u00ef\u00c9\u00be\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00c3\u00fa\u00c2\u00c9\u00e5 \u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n21. 20 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00d1\u00ef\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0\u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb \u00c2\u00c9\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be\u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00a8\u00eb\u00b4 \u00a6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00a8\u00eb \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u00c4\u00cd\u00fa \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00bc\u00e5\u00ce \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :-\n\n(\u00a1) \u00a6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00e5, \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00cc\u00cd \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00e5 \u00a1\u00ba\u00c7\u00a6\u00a8\u00ad\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00cd\u00e5 \u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8 \u00c4\u00ba\u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00e0 \u00ef\u00c6\u00bc\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc \u00a6\u00e0 \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u00cd\u00e5 \u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8, \u00a6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u009e\u00c9\u00c7 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00e0 \u00be\u00e8\u00c6\u00ea\u00a8\u00e0\u00ba\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00cc\u00e8\u0090\u00ef\u00c6\u00e0 \u00c6\u008a \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u00cd\u00e5 \u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8 \u00c4\u00ba \u00bc,\u00a3\u00b4 \u00c9\u00b6\u00e5 \u00a1\u00b6\u00ea \u00c9\u00e5\u00cc\u00e8\u00bc\u00e5\u00c6\u00a8 \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;"
