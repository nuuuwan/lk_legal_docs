    "chunk_text": "(2003 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00bc\u00c6 \u00ba\u00c7\u00b6\u00ba\u00c6 31 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7)\n\n\u00a3\u00bc\u00b1\u00c8\u00b8\u00bc\u00c6 \u00a4\u00ce\u00b5\u00b9\u00c6\u00b9\u0088 \u00a3\u00b1\u00c6\u00b1\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\n\n\u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00a3\u00b1\u00c6\u00d2\u00b6\u00c6 \u00b6\u00c8\u00ce\u00b5\u00af\u00c6\u00af\u00bf\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00b9\u00b6\u00c8\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00bd\u00c6\u00bd\u00d7\u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da 1\" \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00b4\u00df\u00c1\u00be\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00be\u00c7\u00ba\u00c6\n\n\u008c\u00ce\u00be : \u00f4\u00b9\u00c7 47\u00b000\u00b6\u00b9\u00c7\u00bd\u00c6 \u00cc\u00b1\u00be\u00e2 : \u00f4\u00b9\u00c7 11\u00b025\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081\u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00ba\u00c6\n\n2003 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u00b8\u00c6 44 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00ac\u00d7\u00af\u00c6\u00af\u00c9\u00b4\u00c6\u00d5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n2004\" \u00b1\u00b8\u00c1\u00bc\u00c8 \u00ba\u00c7\u00b6\u00ba\u00c6 02 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb \u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6\u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00b9\u00c6 \u00b9\u00b6\u00c6\u00b6\u00c8\u00bc\u00c8\u00ce\u00af\u008a\u0081 II \u00a4\u00ba\u00c6 \u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00b7\u00c8\u00bc\u00b9\u00c6\u0089\u00bb\u00c7\u00af\u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\n\n12003 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 44 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00ac\u00d7\u00af\u00c6\u00af\u00c9\u00b4\u00c6\u00d5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00d2\u00dd\u00af\u00c6\u00af\u00b9\u00c6 \u00cc\u00b9\u00bb\u00bc\u00c6\u00b0\n\n2 \u2013H 019527 \u2013 1,250 (2003/10)\n\n[2003 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00bc\u00c6 \u00ba\u00c7\u00b6\u00ba\u00c6 31 \u00a4\u00b7\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00b0]\n\n\u00b1\u00b0 \u00c1\u00b0 \u00ad\u00b0 -153/34\n\n2004 \u00a4\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u0088\u0081 \u00cd\u00b1\u00ce\u00c1\u00af\u00c6\u00d0 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6\"\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00b1\u00ce\u00c1\u008a\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00af \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00cd\u00be\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0 \u00cc\u00c1\u00bf\u00c8\u008a\u00cd\u00be\u00c7 \u00af\u00b4\u0081\u00af\u00ce\u00bf\u00b6\u00c6 \u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6\" \u00a3\u00b7\u00c6\u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u0088\u0081\u00cd\u00b9\u00c7\u00d7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00d0\u00bd\u00c8\u00b6\u00c6\u00b6 \u00b1\u00c8\u00be \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00b7\u00c8\u00b6\u00c8 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8 \u00cc\u00b1\u00be\u008c\u00b8\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a3\u00b7\u00c6 \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u0088\u0081\u00cd\u00b9\u00c7\u00d7 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b5+\u00c6\u00af\u00ce\u00bf\u00b6\u00c6 \u00b6\u00c8\u00bc\u00b4\u00c6\u00d5 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00af\u00c8\u00ce\u00b4\u00af\u00c6\u00af\u00af\u00c6 \u00e7\u0088\u00bb\u00b6\u00c7\u00af\u00e2\u00bf\u00c6\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00b8\u00c8\u00b4\u00db\u00bf\u00c6\u00bf \u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00b5+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00db\u00bd\u00c6\u00b9\u00b5\u00ba\u00c7\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00ce\u00b6\u00a5\u00bb\u00be\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6\" \u00b6\u00c8\u00bc\u00b4\u00c6\u00d5 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00b5+\u00c6\u00af\u00ce\u00bf \u00ba\u00c9\u00bf\u00bf\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00c1\u00bd\u00c6\u00de\u00b4\u0081 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u0081 \u00a5\u00ce\u00b4\u00cd\u00b7\u00bc\u00c6 \u008c\u00ce\u00bf\u00c1\u00c7\u00b8\u00af\u00dd\u00ba+\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c7\u00b8\u00cc\u00b6\u00c7\u00dd \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081 \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b1\u00b4\u00c6\u00b4\u00ba\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00c7\u00d0\u00af :\u2013\n\n1\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\" 2003 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 44 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00ac\u00d7\u00af\u00c6\u00af\u00c9\u00b4\u00c6\u00d5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a9\u00b8 \u00a9\u00d5\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n2\u00b0 (1) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d5 2004 \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00c1\u00d7\u00ba\u00c6\" 2004 \u00b1\u00b8\u00c1\u00bc\u00c8 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00c8 2004\u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00bc\u00c6 31 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00db\u0088\u00c1\u00ce\u00b4\u00c1\u00d7\u00ba\u00c7\u00b8 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00c7\u00b8 \u00cd\u00b1\u00ce\u00c1\u00af\u00c6\u00af\u00c7\u00af \u00db\u00b7\u00c6\u00d8{\u00bd\u00c6\u00bd\u00c8 \u00a9\u00e1\u00b9\u00b6\u00c6\u00cc\u00b6\u00ae\u00b5\u00c7\u008a\u00bc\u00b6\u00c6\u00d7 \u00d8{\u00bd\u00c6\u00de\u00a3\u00de\u00b9\u00b6\u00c6\u00cc\u00b6\u00c7\u0081\u00b9\u00d7 \u00ba\u00c8\u00be\u00c6\u008b\u00bb\u0081 \u00a3\u00de\u00d8{\u00bd\u00c6\u00de \u00a3\u00de\u00b9\u00b6\u00c6\u00cd\u00b6\u00c7\u00bc\u00c7\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00c1\u00c7\u00af \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00cc\u00b1\u00be\u008c\u00b8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u00bb\u00c7\u00b8\u00d7\"\u00cc\u00b1\u00be\u008c\u00b8\u00ba\u00c6 \u00a9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00cd\u00c1\u00de \u00b1\u00b4\u00c6\u00b4\u00cc\u00ba\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6\u00b9+\u00c6\u00af\u00ba\u00c8\u0081\u00bd\u00c8 \u2013\n\n(\u00a3)\u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00b8\u00c8\u00b4\u00db\u00bf\u00c6\u00bf \u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00b5+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u00b8 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00d7\u00b4\u0081"
