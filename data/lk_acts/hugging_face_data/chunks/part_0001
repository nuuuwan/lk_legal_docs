    "chunk_text": "(4)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (5) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c(\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0, (\u00a1\u00e5)\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0, \u201d , \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c(\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0, (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0,(\u00a1\u00e5\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0, \u201d\u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(5)\u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (7) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u2014\n\n(\u00a1)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (i) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c(\u00a1)\u00ef\u00d8\u00bc\u00c6 \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c(\u00a1) \u00ef\u00d8\u00bc\u00c6,(\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6, (\u00a1\u00e5\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(\u00a1\u00e6)(\u00a3) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (iii) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u201c14 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (xv) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00b4\u201d, \u00c6\u00be\u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c0\u00f2\u00bd\u00e5\u00be \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a6\u00c4 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0\u00c9\u00ba\u00e0\u00a8\u008a \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(\u00a1\u00e7)(\u00a3) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (iv) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a1\u00be\u00ea\u00ef\u00d8\u00bc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(v)\u00a8\u00c8\u00e0\u00c2\u00f3 \u00ef\u00ba\u00e5\u00aa\u00c9\u00c8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a8\u00c8\u00e0\u00c2\u00f3\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00bc\u00fb \u00c3\u00e5\u0097\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a\u00c9\u00ba\u00e0\u00a8\u00c4\u00a8\u00e0 \u00a8\u00c8\u00e0\u00c2\u00f3 \u00cc\u00e0\u00a8\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba\u00b4 \u00ef\u00cd\u00e5\u00e0\u00a8\u00c8\u00e0 \u00c2\u00f3 \u00cc\u00e0\u00a8\u00be\u00e0\u00bd\u00c6 \u00c2\u00f3 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u00ef\u00c9\u00ba\u00c4\u00e5\u00c7\u00e6\u00a8\u00f8\u00d7\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a6\u00c4 \u00c9\u00ba\u00e0\u00a8\u00c4 \u00c0\u00cc\u00ea\u00c9 \u00c2\u00e6\u00cd\u00e6\u00c7\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00cd\u00e5 \u00c8\u00e6\u00c2\u00ea\u00be\u00a8\u00eb\u00c8\u00e8\u00c6, \u00c8\u00e6\u00c2\u00ea\u00be \u00a1\u00ba\u00e0\u00ba\u00f8\u00a8\u00e5\u00c7\u008a \u00ef\u00aa\u00d1\u008a, \u00a8\u00c8\u00e8\u00be\u00e0\u00ef\u0089\u00c7\u00e6\u008a \u00a8\u00f8\u00d7\u00ef\u008a \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e8\u00c6\u00f5\u00c4\u00c8\u00e6\u009f\u008a, \u00a1\u00e6\u00ba\u00eb\u00dd \u00a6\u00c4 \u00c2\u00f3 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec\u00cc\u00e8\u00c6\u00f5\u00c4 \u00c8\u00e6\u009f\u008a \u00a6\u00c4 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00c8\u00e6\u00c2\u00ea\u00be \u00c8\u00e5\u00c3\u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00aa\u00b8\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00c8\u00e6\u009f\u008a \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c9\u00b4\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6 \u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00a6\u00c4 \u00c2\u00f3\u00bc\u00fb\u00c4\u00be\u00e5\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a7\u00c0\u00e0\u00c0\u00ea \u00a8\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u0095\u00cc,\u00a6\u00c4 \u00c9\u00ba\u00e0\u00a8\u00c4 \u00a6\u00ef\u00cc\u00e0 \u00c4\u00e5\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\n\n2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba19\n\n\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00bc\u00fb \u00a6\u00cd\u00fa \u00ef\u00c9\u00ef\u00ce\u00bf\u00ef\u00c0\u00e5\u00c8 \u00c9\u0090\u00be\u00e5\u00a8\u00c4\u00c2\u00f3 \u00bc\u00fb\u00c4\u00be\u00e5\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00c8\u00e6\u00c2\u00ea\u00be \u00ef\u00bc\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(vi)\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c2\u00f3 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a\u00c9\u00ba\u00e0\u00a8\u00c4\u00a8\u00e0 \u00c8\u00c2\u00e5\u00ef\u00aa\u00be \u00a1\u00bc\u00e5\u00ce \u00a8\u00c8\u00e0\u00c2\u00f3 \u00c9\u00e5\u00d6\u00a8 \u00c6\u008a\u00ef\u00c9\u00ce\u00bc\u00e5\u00c4\u00a8, \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8, \u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0\u00db\u00a8\u00f8\u00c6\u00e5\u00c9\u00a8 \u0097\u00c6\u00bc\u008a \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00ef\u00c6\u00be\u00e0\u00c4\u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00c0\u00be\u00e0\u00d1\u00c4\u00b4 \u00a2\u00b6\u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4 \u00c9\u00ba\u00e0\u00a8\u00c4 \u00ef\u00a8\u00c8\u00e8\u00be\u00e0\u00c4\u00ef\u00cd\u00e5\u00e0 \u00be\u00e5\u0095\u00a8\u00c6\u00a8\u00eb \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4 \u00c9\u00ba\u00e0\u00a8\u00c4 \u00c4\u00ba\u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00a8\u00c8\u00e0\u00c2\u00f3 \u00c9\u00e5\u00d6\u00a8 \u00cd\u00e6\u00c7 \u00a6\u00c4 \u00c9\u00ba\u00e0\u00a8\u00c4\u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c4\u00ea\u00bc\u00c8, \u00a6\u00c4 \u00c2\u00f3\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u00ef\u00c4\u00be\u00e0, \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00be\u00e0,\u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00db\u00a8\u00f8\u00c6\u00e5\u00ef\u00c9\u00be\u00e0 \u00c8\u00e6\u00c2\u00ea\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0\u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;"
