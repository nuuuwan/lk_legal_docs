    "chunk_text": "\u00a7\u00b1\u00c6\u00b1 \u00db\u00b9\u00c6\u00b9\u00b6\u00c6\u00ce\u00b6\u00b7\u00c6\u00d7 \u00b1\u00b6\u0096\u00b6\u00ba\u00c7\u00b8\u00c1\u00bc\u00ba\u00c6\u00da\u00c1\u00ce\u00bc\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\"\u201c\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00af\u00c0\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4 \u00db\u0088\u00bb\u00c7\u00b6 \u00b7\u00b4\u00c6\u00b4\u00ba\u00c6\u00a3\u00d5\u00b6\u00c6\u00d7\u00c1\u00dd\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u0081\u00cd\u00b9\u00c7\u00d7\u00ba\u00c6 \u0089\u0081\u00b8\u00dd\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00db\u00ce\u00bd\u00cd\u00bb \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00ba\u00c6\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c624\n\n(4)\u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (2\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u201c\u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00bf\u00c6 (\u00a4)\" (\u00a5)\" (\u00a6) \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 (\u00a7)\u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00bd\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00bf\u00c6 (\u00a4)\" (\u00a5)\"(\u00a6) \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 (\u00a7) \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00bd\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 (4) \u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00a3\u00be\u00c6\u00be\u00d7 (5) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a6) \u00a9\u0081\u00d9\u00ba\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 (i) \u00a4\u00ba\u00c6\" (ii) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7(8) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (6) \u00a4\u00ba\u00c6\" (7) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00e2\u00af\u00bf\u00c8\u0081\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00ba\u00c6\u00b0\n\n18\u00b0 2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u00af\u00ce\u00b4\u00b1\u00c8\u00bb\u00c7\u00af\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008131 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\n\n(1) \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00e2\u00af\u00c6\u00af\u00c7\u00b8 \u00af\u00c7\u00b9\u00c6\u00da \u00c1\u00c7\u00b1\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u201c\u00a5\u00bc\u00ae\u00d5 \u00ba\u00c8\u00be\u00c6\u008b\u00bb\u0081 \u00f4\u00b9\u00c7\u008c\u00df\u00ba\u00c6 \u00a3\u00b6\u00c8\u00af\u00ba\u00c7\u00dc\u00bf\u00c6\u00bf\u00c1\u00c7\u00bd\u00c7\u00b8\" 2004\" \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u0081 \u0089\u0081\u00b8\u00bc\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00b5\u00ba\u00c6 \u00b6\u008c\u00bc\u00c6\u00b7\u00c6\u00b6 \u00cd\u00c1\u00de\u00c1\u00ce\u00af\u00bb\u00c7\u00b8\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a5\u00bc\u00ae\u00d5 \u00ba\u00c8\u00be\u00c6\u008b\u00bb\u0081 \u00f4\u00b9\u00c7\u008c\u00df\u00ba\u00c6 \u00a3\u00b6\u00c8\u00af\u00ba\u00c7\u00dc\u00bf\u00c6\u00bf\u00c1\u00c7\u00bd\u00c7\u00b8 2004\" \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u0089\u0081\u00b8\u00bc\u00c6 \u00a4\u00b8\u00c7\u00be\u00c6 2005\" \u00b1\u00b8\u00c1\u00bc\u00c8 1 \u00a4\u00ba\u00c6\u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u0081\u00b8\u00bc\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00b5\u00ba\u00c6 \u00b6\u008c\u00bc\u00c6\u00b7\u00c6\u00b6 \u00cd\u00c1\u00de\u00c1\u00ce\u00af\u00bb\u00c7\u00b8 \u201d ;\n\n(2) \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (4) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u2013\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008131 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c625\n\n(\u00a3)\u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 :\u2013\n\n(\u00a3)\u00a3\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 (i) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6\n\n\u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u00ce\u00bb \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00ba\u00c6 :\u2013\n\n\u201c (i)(\u00a3) \u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 \u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00bf\u00c6\n\n(\u00a4)\"(\u00a5)\" (\u00a9)\" (\u00aa)\" (\u00ab)\" (\u00ac)\" (\u00ad)\n\n\u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00bd\u00c8\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bd\u00c6\n\n\u00ce\u00bd\u00b6\u00c6 \u00b6\u008c\u00bc\" 2004\" \u00ba\u00c7\u00b1\u00c6\u00d2 31 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\n\n\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0 \u00db\u0081 \u00db\u0088\u00e2\u00bd\u00c6\u00bd\n\n\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00be\u00c6 \u00a3\u00c1\n\n\u00bc\u00c7\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\n\n\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a4) \u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00bf\u00c6 (\u00a3)\"\n\n(\u00a4)\"(\u00a5)\"(\u00a7)\"(\u00a9)\"(\u00aa)\"(\u00ab)\"(\u00ac)\"(\u00ad)\n\n\u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00bd\u00c8\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\n\n\u00c1\u00bd\u00c6\u00ce\u00bd\u00b6\u00c6 \u00b6\u008c\u00bc 2004\" \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00ba\u00c6\n\n\u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u0089\u0081\u00b8\u00bc\u00c6\n\n\u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00af\u00c8\u0081\u00bd \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\n\n\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00be\u00c6 \u00a3\u00c1\u00bc\u00c7\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\n\n\u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\n\n\u00a9\u00be\u00c6\u00be\u00c7\u00b6\u00c6 \u00b6\u00ce\u00af\u00ce\u00ba \u00cc\u00b9\u00de\u00ba\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00bf\u00c6\n\n\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00df\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0089\u00b4\u00bd\u00c6\n\n\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00f2\u0081\u00bd\u00c8\u00cc\u00be\u00c7\u00dd \u00b9+\u00c6\u00d0\n\n\u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00dd\u00b9\u00b6\u00c6\u00ce\u00b6\u00bb\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7 \u00a9\u0081\u00b9\n\n\u00c1\u00bd\u00c6\u00de\u00bf\u00c6 \u00a9\u00b7\u00c6\u00b6\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\" \u00d0\u00ce\u00bd\u00c1\u00c7\u00b8\u00cd\u00b6\u00c7"
