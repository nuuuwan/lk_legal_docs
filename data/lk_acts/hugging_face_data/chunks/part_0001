    "chunk_text": "\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00bc\u00cd\u00cc\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ba\u00eb\u00be\u00e0\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n2005 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00bc\u00b6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00e6\u0091\u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00be\u00ba25\n\n\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6I \u00c9\u00be \u00ba\u00f9\u00c7\u00c6II \u00c9\u00be \u00ba\u00f9\u00c7\u00c6III \u00c9\u00be \u00ba\u00f9\u00c7\u00c6\n\n\u00c0\u00be\u00ef\u00ba\u00cd\u00fa \u00be\u00e5\u00c4\u00c6\u00bc\u00e6\u00be\u00b4 \u00ef\u00c6\u00ef\u00bc\u00be \u00c9\u00ae\u00be\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c9\u00ae\u00be\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cd\u00e5\u00c7\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00bc\u00cc\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0097\u00cc\u00e8\u00c0\u00be\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0 \u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00b8\u00cc\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00c8\u00a8\u00e0\u00cb\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00bc\u00cc\u00c8\u00a8\u00e0\u00cb\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00cc\u00e9\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u0097\u00cc\u00e8\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00bc\u00cc\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00bc\u00cd\u00cc\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00bc\u00cc\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n1995 \u00a1\u00e2\u00a8 23 \u00bc\u00c7\u00be \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0\u00c9\u00c7\u00b4\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba (451 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00a8\u00e6\u00c8\u00e7\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n(29 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00be\u00b6\u00ea \u00c0\u00c9\u00c7\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4\u00c4\u00e6\u00bc\u00fa\u00cd\u00ba\u00e0 \u00c9\u00be\u00e0\u00be\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n1994 \u00a1\u00e2\u00a8 43 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0\u00c9\u00c7\u00b4\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba (453 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00c9\u00e5\u00d6\u00c4\u00e5\u00da\u00aa\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n1986 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba (460 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00a2\u00b6\u008a \u00a1\u00ba\u00e0\u00c0\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00e9\u00ef\u008a \u00c0\u00be\u00ba\n\n\u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1\u00cc\u00c3\u00e5\u00ef\u008c 1976 \u00a1\u00e2\u00a8 28 \u00bc\u00c7\u00be \u00a2\u00b6\u008a\u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00ef\u008a \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00c0\u00be\u00ba\n\n(120 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00a2\u00b6\u008a \u00ef\u00c8\u00e0\u00a9\u00be (\u00be\u00e6\u00c9\u00ba\u00cc\u00a8\u00cc\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c0\u00e8\u00b4\u00ea) \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n(458 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00a2\u00b6\u008a \u00c4\u00e6\u00be\u00f9\u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n1987 \u00a1\u00e2\u00a8 38 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1975 \u00a1\u00e2\u00a8 17\u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00b0\u00ca\u00e5\u00c8\u00e5\u00c9\u00c8\u00b4 \u00c2\u00c8\u00c0\u00ba\u00f2 \u00c8\u00c2\u00e5\u00bc\u00fb\u00ef\u008a \u00c0\u00be\u00ba\n\n1979 \u00a1\u00e2\u00a8 9 \u00bc\u00c7\u00be \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00ba\u00e6\u00db\u008c\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00b4\u00c2\u00c8\u00c0\u00ba\u00f2 \u00c8\u00c2\u00e5\u00bc\u00fb\u00ef\u008a \u00c0\u00be\u00ba\n\n2002 \u00a1\u00e2\u00a8 18 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba 1972 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00be\u00e6\u008c \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00be\u00e0\u00b4\u00c2\u00c8\u00c0\u00ba\u00f2 \u00c8\u00c2\u00e5\u00bc\u00fb\u00ef\u008a \u00c0\u00be\u00ba\n\n(42 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u0097\u00f3\u00c8\u00e8\u00c0\u00cd\u00be\u00e0 \u00c0\u00e5\u00c8\u00be\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00bc\u00cd\u00cc\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cd\u00c6\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00cd\u00ef\u00ce\u00e5\u00cc\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ba\u00f8\u00cc\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cd\u00e6\u00b4 \u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cd\u00c6\u00c8\u00a8\u00e0\u00cb\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00e5\u00ef\u00ce\u00e5\u00cc\u00e0 \u00c8\u00a8\u00e0\u00cb\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u0097\u00cc\u00e8\u00c0\u00be\u00e0\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00bc\u00cd\u00cc\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00c0\u00cd\u00ef\u00ce\u00e5\u00cc\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ba\u00eb\u00be\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00cd\u00ef\u00ce\u00e5\u00cc\u00e0\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n2005 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00bc\u00b6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00e6\u0091\u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00be\u00ba26\n\n\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\nI \u00c9\u00be \u00ba\u00f9\u00c7\u00c6II \u00c9\u00be \u00ba\u00f9\u00c7\u00c6III \u00c9\u00be \u00ba\u00f9\u00c7\u00c6\u00c0\u00be\u00ef\u00ba\u00cd\u00fa \u00be\u00e5\u00c4\u00c6\u00bc\u00e6\u00be\u00b4 \u00ef\u00c6\u00ef\u00bc\u00be \u00c9\u00ae\u00be\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c9\u00ae\u00be"
