u0baa\n\n(08) \u0bab\u0bba\u0ba4\u0bcd\u0ba4\u0baa\u0bae 1 \u0bab\u0bba\u0ba4\u0bcd\u0ba4\u0baa\u0bae \u0bab\u0bba\u0ba8\u0b95\u0bad \u0b9a\u0baa\u0baa 2 \u0ba4\u0bb2\u0bb2\u0bbf\u0b95\u0bab \u0ba8\u0b95\u0bad \u0b9a\u0baa\u0baa 3 \u0baa\u0bbb\u0b9f\u0bcd\u0b9f\u0ba4\u0baa\u0ba4\u0bcd\u0ba4\u0bad \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 4 \u0ba4\u0b95\u0bba\u0b9f\u0bcd\u0b9f\u0ba4\u0baa\u0bba\u0baf \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 5 \u0b95\u0bbb\u0bba\u0bbb\u0ba8\u0bcd\u0ba4 - \u0baa\u0bc1\u0bb9\u0bc2\u0bb2\u0bcd\u0ba4\u0bb2\u0bb2\u0bcd\u0baf \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 6 \u0baa\u0bc3\u0baf\u0b9f\u0bcd\u0b9f\u0bbf\u0bac\u0ba9 \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 7 \u0baa\u0bb8\u0bcd\u0ba4\u0b95\u0bba\u0b9f \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa\n\n\u0bab\u0bba\u0bb2\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb2\u0bc4\u0bb0\u0bcd \u0b85\u0ba4\u0bbb\u0b95\u0bba\u0bad\u0b9a\u0baa\u0baa\n\n2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 1 \u0b86\u0bae\u0bcd \u0b87\u0baf\u0b95\u0bcd\u0b95, \u0b89\u0bb3\u0bcd\u0bb2\u0bc4\u0bad\u0bba\u0b9f\u0bcd\u0b9a\u0bbb \u0b85\u0ba4\u0bbb\u0b95\u0bba\u0bad\u0b9a\u0baa\u0baa\u0b95\u0bb3\u0bcd \u0ba4\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bcd (\u0bb2\u0bbb\u0ba4\u0b9a\u0b9f \u0b8c\u0bb1\u0bcd\u0baa\u0bba\u0b9f\u0bc1\u0b95\u0bb3\u0bcd)\n\n\u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\n\n8\n\n8 \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0bad\u0bb2\u0bbf\u0bac \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 9 \u0b85\u0b95\u0bcd\u0b95\u0bc1\u0bad\u0bb8\u0bcd\u0bb8 \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 10 \u0bab\u0bba\u0bb2\u0bbf\u0bae\u0bcd\u0baa\u0b9f \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 11 \u0bb9\u0b95\u0bcd\u0bab\u0ba9 \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 12 \u0b95\u0bae\u0bcd\u0baa\u0bc1\u0bb1\u0bc1\u0baa\u0bbb\u0b9f\u0bcd\u0b9f\u0bbf\u0bac \u0baa\u0bbb\u0