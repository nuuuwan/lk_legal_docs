    "chunk_text": "\u201c\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u201d \u00c6\u00be\u00e0\u00be\u00b4\u2014\n\n(\u00a1) \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00ba\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be \u00c8\u00bc\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00bc ;\n\n\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa.\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n\u00a1\u00da\u00bb \u00be\u00e8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n(\u00a1\u00e5) \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c (\u00c4\u00ea\u00bc\u00c8\u00e0\u00ef\u00ca\u00e0\u00cb, \u00cc\u00e2\u008e\u00ba \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0, \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00cc\u00cd \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9)\u00cc\u00e8\u00c6\u00f5 \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00cd\u00e5 \u00ae\u00e2\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce \u00bc ;\n\n(\u00a1\u00e6) \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb\u00cd\u00e5 \u00cc\u008a\u00c3\u00e5\u00c9\u00f1 \u00c2\u00e6\u00c7\u00a8\u008a \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00cc\u00e8\u00c6\u00f5 \u00c2\u00e6\u00c7\u00a8\u008a \u00bc ; ;;;\n\n(\u00a1\u00e7) \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0, \u00c2\u00e6\u00e2\u00a8\u00eb \u00c0\u00be\u00ef\u00ba\u00e0 76\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (3)\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00ef\u00c9\u00ba \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00ce \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6 \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9, \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb\u00a2\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00cc\u00cd \u00be\u00e8\u00ca\u00e0\u008e\u00ba\u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00c0\u00e6\u00c9\u00ba\u00f8 \u00cd\u00fa\u0095\u00a8\u00e5\u00c7\u00a8\u008a \u00cd\u00e5 \u00c2\u00e6\u00c7\u00a8\u008a \u00c9\u00c8\u00e8\u00be\u00e0 \u00a4\u00bc\u00e0\u00aa\u00ba\u00c9\u00be\u00cc\u00e8\u00c6\u00f5 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a, \u00c2\u00c8\u00ba\u00c8, \u00c9\u00c7\u00c0\u00f2\u00cc\u00e5\u00bc, \u00a1\u0093\u00a8\u00e5\u00c7, \u00c2\u00e6\u00bf\u00fb\u008a,\u00c6\u00ea\u00ba\u00eb\u00a8\u008a \u00cc\u00cd \u00cc\u00e0\u00c9\u00e5\u00da\u00bb \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00bc ; ;;;\n\n(\u00a2) \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00ef\u00cd\u00e5\u00e0\u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00c2\u00bc\u00e0\u00bd \u00cc\u00e8\u00c6\u00f5 \u00ef\u00c0\u00e5\u00ba\u00e0\u00c0\u00ba\u00e0, \u00aa\u00fa\u00b8\u00ea\u008a\u00cc\u00cd \u00ef\u00c8\u00e0\u00a9\u00be \u00bc , ;;;\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c.\n\n\u201c\u00c2\u00e6\u00e2\u00a8\u00eb \u00c0\u00be\u00ba\u201d\u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c9\u00d6\u00be\u00e0 \u00c9\u00c7 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c0\u00d6\u00bc\u00fa \u00c9\u00ec 1988 \u00a1\u00e2\u00a830 \u00bc\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb \u00c0\u00be\u00ba \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ; ;;;\n\n\u201c\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, 1979 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc\u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n2005 \u00a1\u00e2\u00a8 1 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9(\u00a1\u00e5\u00be\u00ea\u00cb\u00e2\u00aa\u00fa\u00a8 \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba7\n\n\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c0\u00be\u00ba\u00e0 \u00ef\u00a8\u00b4\u00ea\u008a\u00c0\u00ba\u00e0\u00c9\u00c8 \u00cc\u00cd \u00c0\u00be\u00ba\u00e0\u00c9\u00c8 \u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00bc\u00e5\u00c6\u00a8 \u0095\u00ce (\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6) \u00c7\u00e6. 870 \u00a8\u00f8.(\u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6) \u00c7\u00e6. 1,160 \u00a8\u00f8. \u00a1\u00e2\u00a8 32, \u00b4\u00f2\u00e5\u00be\u00e0\u00cc\u00e0\u00c9\u00da\u00a8\u00e0\u00cc\u00e0 \u00c4\u00be\u00e0\u00bc\u00fa\u00c7\u00c6, \u00ef\u00c8\u00e5\u00e0\u00b4\u00cc\u00e0 \u00c0\u00e5\u00c7, \u00ef\u00a8\u00e5\u00ce\u00c5 01, \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be\u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00a1\u0093\u00a8\u00e5\u00d7 \u00ef\u00c9\u00ba \u00cc\u00e7\u00c4 \u00c9\u00da\u00cb\u00c6\u00a8\u00c4 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 15 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00aa\u00c9\u00e5\u00c0\u00cc\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0\u00c9\u00e5 \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8\u00c6."
