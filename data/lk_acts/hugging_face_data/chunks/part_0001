    "chunk_text": "\u201c\u00a1\u00be\u00c9\u00cc\u00c7 \u00cc\u00be\u00e0\u00ba\u00a8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00bc\u00fa\u00e2\u008e\u00c6\u201d \u00c6\u00be\u00e0\u00be\u00b4 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00cc\u00c4\u00aa \u00ef\u00cd\u00e5\u00e0\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00a6\u00a8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u0091 \u00aa\u00b8\u00be\u00a8\u00e0\u00cc\u00c4\u00aa \u00c0\u00e5\u00c8\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00bc\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00cc\u00c4\u00ad\u00c8\u00e8\u00c6\u0097\u00c8\u00e0\u00c8\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00ec \u00c9\u00c8\u00e2\u00aa\u00eb \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00c4\u00ba \u00c9\u00be \u00cc\u00be\u00e0\u00ba\u00a8\u00c6\u00cd\u00e5 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00c4\u00c7\u00b8\u00e8\u00be\u00e0 \u00c0\u00cc\u00ea \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00a4\u00c7\u00e6\u00c4\u00a8\u00e0\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00c0\u00bc\u00fa\u00e2\u008e\u00c6 \u00cd\u00e6\u00c7, \u00cc\u00e7\u00c4 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00c4 \u00cc\u00be\u00e0\u00ba\u00a8\u00c6\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00c0\u00bc\u00fa\u00e2\u008e\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c.\n\n\u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be \u00ef\u008a\u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c9\u00be\u00ba\u00e0 \u00c8\u00e8\u008d\u00ba\u00be\u00f9\u00ba\u00f8\u00c6\u00a8 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00c3\u00fa\u00c2\u00c9\u00e5\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00cc\u00bf\u00cd\u00e5 \u00a1\u00da\u00bb\u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n91999 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00be\u00f8\u00c9\u00e5\u00cc \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n4.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 82 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u201c\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u201d \u00c6\u00be\u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n5.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4, \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00c6, \u00c0\u00f2\u00bd\u00e5\u00be\u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e082 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n101999 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00be\u00f8\u00c9\u00e5\u00cc \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n\u201c\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u2018\u00a1\u2019 \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8\u00c6\u00a1\u00cc\u00e0\u00a8\u00f8\u00d7\u00ef\u008a \u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6 (69 \u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\n\n\u00b0\u00e5\u00ba\u00f8\u00a8 \u00be\u00f8\u00c9\u00e5\u00cc \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0, \u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u00e5\u0093\u00a8\u00e5\u00d7..............................................................................................(\u00be\u00c4 \u00cd\u00e5\u00c0\u00bc\u0097 \u00be\u00e5\u00c4\u00c6 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00e0\u00be) \u00c9\u00be \u00c4\u00c4, ..........................................................................................................................................................(\u00be\u00c4 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00e0\u00be) \u00c9\u00be \u00a7\u00c2 \u00ef\u00c4\u00cd\u00fa \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u0097\u00cc\u00e0\u00ba\u00c7 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8\u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00ef\u00c8\u00e0/* \u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8 \u00a1\u00be\u00c9\u00cc\u00c7\u00ef\u00c6\u00be\u00e0 \u00cc\u00be\u00e0\u00ba\u00a8\u00c6/* \u00c0\u00bc\u00fa\u00e2\u008e\u00c6\u00c8\u00c2\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00e6\u008c \u0097\u00ca\u00e0\u00c9\u00e5\u00cc \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ba\u00c7\u008a \u00ef\u00cd\u00e0\u00ba\u00eb \u00a1\u00e6\u00ba\u00f8\u00c9, \u00b0\u00e5\u00ba\u00f8\u00a8 \u00be\u00f8\u00c9\u00e5\u00cc\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ef\u00ba\u00e0 69\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c4\u00e5 \u00ef\u00c9\u00ba \u00c0\u00e6\u00c9\u00d7 \u00a1\u00e6\u00ba\u00f8\u00c2\u00c8\u00ba\u00c8 \u00c0\u00f2\u00a8\u00e5\u00c7,.............................................................................(\u00be\u00c4\u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00e0\u00be) \u00c9\u00be \u00a7\u00c2\u00b4 -(\u00a1)\u00a7\u00ef\u0089 \u00c6\u00e6\u00ef\u00c0\u00be\u00e0\u00be\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00ef\u00c9\u00ef\u00ba\u00e5\u00ba\u00e0, \u00a7\u00c9\u00ea\u00be\u00e0\u00bc \u00cc\u00c4\u00aa \u00a6\u00e0 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8 \u00a1\u00ba\u00e0\u00cd\u00e6\u00c7 \u00c6\u00e5 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9\u00b4 ; \u00cc\u00cd"
