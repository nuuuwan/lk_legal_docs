    "chunk_text": "(iii) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6, \u00a5\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 (i) \u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00b8\u00d7\u00ba\u00c6 (ii) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00b8\u00d7\u00ba\u00c6\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6 \u00af\u00c8\u00b5+\u00c6\u00af \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00bf\u00c8\u0081\u00e7\u00b4\u00c6\u00d5\u00cc\u00ba\u00c7\u00b6\u00c6\u00b6\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00d0\u00ce\u00bd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00b8\u00a3\u00af\u00c6\u00af\u00c7\u00be\u00c7\u00ae\u0088\u00bd\u00c6\u00cc\u00af\u00b8 \u00a3\u00af\u00c6\u00af\u00c7\u00be\u00c7\u00ae\u0088\u0081 \u00a5\u00de\u00b6\u00c8\u00ce\u00bb\u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00de\u00ba\u00c6 \u00ba\u00c7\u00b6\u00b6\u00c6\u00b6\u00c8\u0081 \u00b9\u00b6\u00c8\u00ce\u00b8\u00b7\u00c6\u00b6\u00c7\u00ba\u00c6 \u00b7\u00c7\u00bf\u0081\u00de\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0 \u00db\u0081\u00b8\u00bc\u00c6 \u00a3\u00c1\u00bc\u00c7\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\n\n\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u008c\u0081 \u00cc\u00b6\u00c7\u00ce\u00af\n\n4 \u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7:-\n\n\u201c1997 \u00b1\u00b8\u00c1\u00bc\u00c8 1 \u00a4\u00b7\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8\u00bb\u0081\u00cd\u00bd\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081\n\n\u0089\u0081\u00b8\u00cd\u00bc\u00c7 \u00a4\u00b8\u00c7\u00be\u00c6 1998 \u00ac\u00bd\u00c6\u00cd\u00bd\u00c7\u00b9\u00bc\u00c6 1 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0\n\n\u00db\u0081\u00b8\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6 \u00ac\u00c1\u00c6\u00cd\u00c1\u00c7\u00bc\u00c7\u00ae\u0088\u00b8\u00d7\u00ba\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\n\n\u00af\u00c7\u00be\u00c7\u00ae\u0088\u00bd\u00c6\u00d0\u00ba\u00c6\u201c\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\n\n\u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00ba\u00c6\u00b0\u201d\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00af\u00c6\u00af\u00c7\u00b8\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00ba\u00c6\u00b0\n\n71999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 21 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00cd\u00b6\u00b1\u00c8\u00bb\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da \u00a3\u00bd\u0096\u00d5 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(2) \u00a3\u00c1\u00c6\u00c1\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 \u00a5\u00de\u00b6\u00c8\u008a\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u008c\u00b4\u00bb+\u00c6\u00af\u00ce\u00bf\u00b1\u00c6\u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081 \u00f2\u00be\u00ba\u00c6 :-\n\n\u201c8\u00b0 \u00a4\u008a\u00bc\u00b6\u00c6\u00d7\u00b6\u00c6 \u00cc\u00b6\u00c7\u00bf\u00c7\u008a\u00bc\u00b6\u00c6\u00d7\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ae\u00d6{\u00bd\u00c6\u00cc\u00bd\u00b4\u00c6\u00d5\u00ac\u00bd\u00c6\u00cd\u00bd\u00c7\u00b9\u00bc\u00c6 1 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6 \u00af\u00c7\u00be\u00c7\u00ae\u0088\u00bd\u00c6\u00d0-\n\n(i)(\u00a3) 1998 \u00ac\u00bd\u00c6\u00cd\u00bd\u00c7\u00b9\u00bc\u00c6 1 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00c8 1998\u00b7\u00cc\u00c1\u00ba\u00c6\u00b9\u00bc\u00c6 5 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8 \u00db\u0088\u00c1\u00ce\u00b4\u00dc\u00ba\u00c6\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0 \u00aa\u00bd\u00c6\u00b9\u00d5\u00c1\u00b6\u00c7\u00b8 \u00b9\u00b7\u00c6\u00b6\u00c8 (ii) \u00a5\u00be\u00c6\u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8 \u00c1\u00bc\u00e2\u00a3\u00be\u00c6\u00be\u00c7\u00b6 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8 \u00c1\u00bc\u008c\u0081\u00ba\u00c9\u00d7\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 4 1/2 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\u00b0\n\n(\u00a4) 1998 \u00b7\u00cc\u00c1\u00ba\u00c6\u00b9\u00bc\u00c6 6 \u00a4\u00b7\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00c8 1998\u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00bc\u00c6 31 \u00a4\u00b7\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8\u00bb\u0081\u00de \u00db\u0088\u00c1\u00ce\u00b4\u00dc\u00ba\u00c6\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0 \u00aa\u00bd\u00c6\u00b9\u00d5\u00c1\u00b6\u00c7\u00b8 \u00b9\u00b7\u00c6\u00b6\u00c8 (ii)\u00a5\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8\u00c1\u00bc\u00e2 \u00a3\u00be\u00c6\u00be\u00c7\u00b6 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8 \u00c1\u00bc\u008c\u0081\u00ba\u00c9\u00d7\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 5 1/2 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\n\n(ii) (203 \u00a4\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8) \u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00c1\u00c7\u00af\u00b8\u00b1\u00c6\n\n\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00dd\u00b6\u00c6\u00cc\u00b6\u00be\u00c6\u00ce\u00be\u00af\u00c6\u00d0\u00bf\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\n\n\u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00af\u00c7\u00bc\u00c6, \u00cd\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00bc\u00c6 \u00cd\u00af\u00c7\u00b1\u00c6\u00d2 \u00a3\u00be\u00c6\u00be\u00d7\n\n\u00cc\u00be\u00c7\u00bd\u00c8\u00bb\u00c7\u00af \u008c\u00bc\u00c7\u00b6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b9\u00c7\u00bd\u00c8\u008a\u0081, \u00cc\u00b9\u00c7\u00bd\u00c8\u00b6\u00c6\n\n\u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00b9\u00af\u00bc\u00b5\u00b6\u00c6\u00b6\u00c8\u0081\n\n\u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\n\n\u00b6\u00c8\u008a\u00b8\u00c8\u0081\u00de\u00ba\u00c6 \u00a9\u00e1\u00af\u00c8\u0081\u00bd\u00b6\u00c7\u00b8 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8\n\n\u00c1\u00bc\u008c\u0081\u00ba\u00c9\u00d7 \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b00\u00b05 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\u00b0\n\n9\u00b0 1999, \u00b1\u00b8\u00c1\u00bc\u00c8 1 \u00a4\u00b7\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u0089\u0081\u00b8\u00bc\u00c6\u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6 \u00ac\u00c1\u00c6\u00cd\u00c1\u00c7\u00bc\u00c6 \u00a4\u00ae\u0088\u00b8\u00d7\u00ba\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00af\u00c7\u00be\u00c7\u00ae\u0088\u00bd\u00c6\u00d0\u00ba\u00c6-\n\n(i) \u00a5\u00c1\u00c6\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u0081 (ii) \u00a4\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8 \u00c1\u00bc\u00e2 \u00a3\u00be\u00c6\u00be\u00c7\u00b6\u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8 \u00c1\u00bc\u008c\u0081\u00ba\u00c9\u00d7\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 5 1/2 \u00b1\u00b6\u0096\u00b6\u00ba\u00c6\u00b0\n\n81999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 21 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00cd\u00b6\u00b1\u00c8\u00bb\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da \u00a3\u00bd\u0096\u00d5 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6"
