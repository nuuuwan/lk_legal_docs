    "chunk_text": "(5) \u00b9\u00b5\u00b1\u00c6\u00b1\u00ce\u00b9\u008a\u00b8\u00c7\u00be\u00c6 \u00af\u00c7\u00be\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00af\u00c6\u00af\u00c7\u00be\u00ba\u00c6 \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u0089\u00ce\u00b5\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c7\u00cc\u00be\u00c7\u00c0\u00c8\u00bb\u00e2\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00b1\u00ba\u00c6\u00b9\u00b7\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b6\u008c\u00bc\u00c6\u00b7\u00c6\u00b6 \u00a3\u00b6\u0081 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00a9\u00ae\u00b5\u00c8\u00af\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00f2\u0081\u00bd\u00c8\u00be\u00c6 \u00a5\u00bc\u00ae\u00d5\u00af\u00c6\u00d0\u00af\u00c6\u00d0\u00ce\u00bd\u00bb\u00c7\u00cd\u00b6\u00c7\u00bc\u00c8\u0081 \u00c1\u00c7\u00af\u00c6\u00d0\u00af\u00bf\u00c6\u00f2\u00be\u00ba\u00c6 \u00a7\u00bc\u00c8\u00ba\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00af \u00c1+\u00c6\u00af\u00c8\u008a\u0081 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b1\u00ce\u00b9\u008a\u0081 \u00e7\u00b4\u00c6\u00b4\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00b4\u00d9\u00b6\u008c \u00a3\u00d9\u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c7\u00cc\u00be\u00c7\u00c0\u00c8\u00bb\u00e2\u00ba\u00c6\" \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c7\u00af \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0 \u00db\u0081\u00b8\u00bc\u00c7\u008a\u00d9\u00b3\u00c6\u00b1\u00bc\u00c8 \u00a3\u00b6\u0081 \u0089\u0081\u00b8\u00bc\u00c7\u008a\u00d9\u00b3\u00c6\u00b1\u00bc\u00c8 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00bb\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00d0\u00ba\u00c6\"\u00a9\u00b7\u00c6\u00b6\u00b6\u00c6 \u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a7\u00bc\u00c8\u00ba\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00af \u00c1+\u00c6\u00af\u00c8\u008a\u0081 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00af\u00b5\u00c8\u00b1\u00ba\u00c7\u00b8\u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00ce\u00bb\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00bf\u00c6\u00bf\u00c7\u00cd\u00bc\u00c7 \u00a3\u00b7\u00c6\u00b6\u00b6\u00c6 \u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00d7\u00af\u00c6\u00d0 \u00a7\u00bc\u00c8\u00ba\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00af \u00c1+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u0081\u00de\u00af\u00b4\u00d9\u00b6\u008c \u00a9\u00b6\u00ce\u00b8\u00dc\u00ba\u00c6 \u00c1\u00c0+\u00c6\u00d0\u00b6 \u00be\u00c7\u00af\u00c7\u00d7\u00b0\u201d\u00b0\n\n(2)\u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (11) \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 (11\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00e2\u00af\u00ce\u00bf \u00b7\u00c9\u00af\u00c6\u00af\u00b3\u00c6\u00cc\u00b1\u00bb\u00c6\u00d7\u008c\u00b4\u00c6\u00d5 \u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u00bd\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00e2\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 2 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c647\n\n(11\u00a3) \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u0088\u0081\u00cd\u00b9\u00c7\u00d7 (3) \u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 (5) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00b4\u00d9\u00b6\u008c \u00a7\u00bc\u00c8\u00ba\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00af \u00c1+\u00c6\u00af\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u008c\u00b4\u00b6\u00c6\u00d7\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00b4\u00d9\u00b6\u008c\u00a3\u00b7\u00c6\u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d5\u00af\u00c6\u00af\u00c7\u00b8 \u00af\u00b5\u00af\u00c6\u00d0\u00af\u00bf\u00c8\u00df\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00af\u00b4\u00d9\u00b6\u008c \u00db\u00e1\u00ce\u00ba\u00bb\u00c7\u00af\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00c1\u00ce\u00bc\u00a3\u00be\u00c6\u00be\u00d7 \u00b9[\u00bc\u00b5\u00ba\u00c7\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00c6 \u00b6\u00c9\u00bc\u00c6\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00c1\u00ce\u00bc\"\u0089\u0081\u00ce\u00b8\u00bb \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d5\u00af\u00c6\u00d0\u00ba\u00c7\u00b8 \u00af\u00b5\u00af\u00c6\u00d0\u00af\u00bf\u00c8\u00df\u00ba\u00c6 \u00cc\u00c1\u00bf\u00c8\u008a\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d\u00b0\n\n21\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 49 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2\" \u201c\u00b9\u00b5\u00b1\u00c6 \u00b1\u00ce\u00b9\u008a\u0081\u201d \u00a9\u0081\u00d9\u00b3\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00c1+\u00c6\u00af\u00c8 \u00cd\u00ba\u00bd\u00c6 \u00b9\u00c7\u00bc\u00c6\u00ce\u00c1\u00b9\u00c6\u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c8\u0081\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7\u00b0\n\n22\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 58 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n(1)\u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u00ce\u00c1\" \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00c1\u00c7\u00af\u00ba\u00c9\u00bf\u008c\u00be\u00af\u00c6\u00af\u00ba\u00c8\u00d5\u00b6\u00c1\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n(2)\u00ba\u00c9\u00bf\u008c\u00be\u00af\u00c6\u00af\u00ba\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00ce\u00c1 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00ce\u00c1\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c(2) \u00c1+\u00c6\u00af\u00c8 \u00cd\u00ba\u00bd\u00c6\u00b9\u00c7\u00bc\u00c6\u00ce\u00c1\u00b9\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00a7\u00bc\u00c8\u00ba\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00af \u00c1+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u0081 \u00af\u00b4\u00c6\u00b4\u00c7\u00bb\u00ac\u00d5\u00af\u00c6\u00d0\u00b6\u00cc\u00be\u00c7\u0081\u00bd\u00c8\u00be\u00c6 \u00af\u00ce\u00be\u00af\u00c6\u00d0\u00b7\u00dd\u00ce\u00b4\u00bb \u00b9\u00b5\u00c8\u00af\u00bf\u00c8\u0081\u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\u00b6\u00c6 \u00b6\u00ba\u00af\u00c6\u00d0\u00b6\u00c6 \u00d7\u00ce\u00b5 \u00da\u00bc\u00c8\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af \u00a7\u00bb\u00bc\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00b6\u00ce\u00af\u00ce\u00ba\u00cc\u00b9\u00bd\u00c6\u00bd \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u00b8\u00c6\u00cd\u00b1\u00ce\u00c1\u00ce\u00bb \u00a6\u00d5\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c7\u00ba\u00c6\u00b0\u201d\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008149 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008158 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 2 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c648"
