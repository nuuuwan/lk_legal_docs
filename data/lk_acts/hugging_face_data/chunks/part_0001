    "chunk_text": "111999 \u00a1\u00e2\u00a8 47 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\n\n1999 \u00a1\u00e2\u00a8 47 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n[ \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00ef\u00ce\u00e0 1999 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 10 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be.]\n\n\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00be\u00f8\u00c6\u00c4\u00c6 \u00c0\u00d6\u00bc\u00fa \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00e9.\n\n1999 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 10 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0\u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 II \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00a1\u00ba\u00f8\u00ef\u00da\u00a8\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00ce\u00a8\u00c7\u00be \u00c8\u00bc\u00fb.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c4\u00ea\u00f7\u00b8 \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00fb.\n\n\u00ef\u00a8\u00e5\u00ce\u00c5 01, \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be \u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00ef\u00c6\u00be\u00e0 \u0095\u00ce\u00bc\u00fb \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8\u00c6.\n\n\u0095\u00ce : \u00c7\u00e6. 8. 00\u00ba\u00e6\u00c0\u00e6\u00c8\u00e0 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 : \u00c7\u00e6.3.50\n\n[\u00a1\u00be\u00e0\u00ba\u00da\u00b0\u00e5\u00c8 \u00a1\u00be\u00ea\u00c9\u00e5\u00bc\u00c6\u00a8\u00f8.]\n\n11999 \u00a1\u00e2\u00a8 47 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\nH-022545\n\n[\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00ef\u00ce\u00e0 1999 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 10 \u00c9\u00e6\u00be\u00e8 \u00bc\u00fa\u00be.]\n\n\u00a6\u00c8\u00e0.\u009c. \u2013 \u0081. 33/99.\n\n1979 \u00a1\u00e2\u00a8 15 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 \u00c0\u00be\u00ba\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c0\u00be\u00ba\u00a8\u00f8\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c4\u00ef\u00cc\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :-\n\n1.\u00ef\u008a \u00c0\u00be\u00ba 1999 \u00a1\u00e2\u00a8 47 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be\u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7,\u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00bc\u00fa\u00be\u00c6\u00a8 \u00a6\u00c6 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n2. (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) 1979 \u00a1\u00e2\u00a8 15 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6\u00c0\u00be\u00ef\u00ba\u00e0 303 \u00c9\u00be \u00cc\u00cd 304 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00a1\u00ba\u00c7, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :-\n\n303. (1) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9,\u00c9\u00c7\u00bc\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00a8\u00e5\u00c8 \u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00b8\u00e0\u00b6\u00be \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a\u00bc\u00fb \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 :-\n\n(\u00a1) \u00bc\u00b8\u00e0\u00b6\u00be \u00be\u00f8\u00c6\u00c4\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00c6\u008a \u00c9\u00c7\u00bc\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc, \u00a6\u00e0 \u00c9\u00c7\u00bc \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c6\u0095\u00ba\u00a4\u00c0\u00d6\u00c4 \u00bc\u00b8\u00e0\u00b6\u00be\u00c6 ;\n\n(\u00a1\u00e5) \u00c9\u00c7\u00ef\u00bc\u00e0 \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00c6 \u00cc\u00cd \u00c9\u00c7\u00ef\u00bc\u00e0 \u00c2\u00c7\u00c0\u00ba\u00c8\u00a8\u00c4 ;\n\n(\u00a1\u00e6) \u00c9\u00c7\u00bc \u00cc\u00bf\u00cd\u00e5 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00cc\u00ef\u00bc\u00e5\u00e0\u00cb\u00ba\u00e0\u00c9\u00c6 \u00cc\u00cd\u00c9\u00aa\u00a8\u00f9\u00ef\u008a \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 ;\n\n(\u00a1\u00e7) \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00c0\u00ec\u00da\u00c9 \u00a8\u00c8\u00e0\u00a8\u00f2\u00e8\u00c6\u00e5\u00c9 ;\n\n(\u00a2) \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00ef\u00a8\u00c8\u00e8\u00be\u00e0\u00c4\u00cc\u00e8\u00f3 \u00c9\u00ec \u00c6\u008a \u00cd\u00e5\u00be\u00f8\u00c6\u00a8\u00e0, \u00c0\u00e5\u00b6\u00ea\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00a1\u00c8\u00e5\u00c3\u00c6\u00a8\u00e0 ;\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6 \u00cc\u00cd\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00ef\u008a\u00bc\u00fa\u00be\u00c6.\n\n1979 \u00a1\u00e2\u00a8 15\u00bc\u00c7\u00be \u00c0\u00be\u00ef\u00ba\u00e0303 \u00cc\u00cd 304\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00a8\u00f8\u00d7\u00c4.\u201c\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00ba\u00e0\u00cd\u00fa\u00b4 \u00c9\u00ec\u00bc\u00b8\u00e0\u00b6\u00be \u00be\u00f8\u00c6\u00c4\u00c6\n\n21999 \u00a1\u00e2\u00a8 47 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(\u00a3) \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00c9\u00ec \u00bc\u00b9\u00ea\u00c9\u00c4 \u00a4\u00aa\u00f2\u00a8\u00f8\u00d7\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e8\u00cd\u00fa\u00c8\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ba\u00eb\u00b6\u00ea \u00ef\u00bc\u00be \u00cc\u00e5\u00bd\u00a8\u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00ba\u00e8\u009f\u00c4 ;\n\n(\u00a4) \u00cc\u00e8\u00c6\u00f5 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00be\u00ea\u00aa\u00ba \u00a8\u00c7\u00e6\u00b8\u00ea \u00a1\u00be\u00ea\u00c9\u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00c9\u00be \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00b4 \u00cc\u00cd\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6\u00b4 \u00bc\u00b9\u00ea\u00c9\u008a\u00c0\u00e6\u0095\u00b8\u00d1\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00ca\u00f1\u00ba\u00e5\u00c9 ;"
