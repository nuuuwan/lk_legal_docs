    "chunk_text": "(\u00a1)2005 \u00c4\u00e5\u00da\u00ba\u00eb 31 \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00c8\u00e5\u00c3\u00c9\u00c8 \u00a6\u00a8\u00ba\u00eb\u00c9 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00c8\u00a8\u00e0\u00cb \u00c0\u00be\u00cc\u00e0 \u00bc\u00cd\u00cc\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00c8\u00a8\u00e0\u00cb \u0097\u00cc\u00e8\u00bc\u00cd\u00cc\u00a8\u00b4\u00c9\u00e6\u0091 \u00a8\u00eb\u00c8\u00e9 \u00c9\u0090\u00be\u00e5\u00a8\u00ef\u008a \u00c6\u008a \u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba\u00c6\u00a8\u00e0 ; \u00cc\u00cd\n\n\u00c8\u00ea\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6.\n\n2000 \u00a1\u00e2\u00a8 38 \u00bc\u00c7\u00be\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c0\u00be\u00ef\u00ba\u00e0 3 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n22005 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(\u00a1\u00e5)2004 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00c0\u00cc\u00ea\u00c9\u00a1\u00e5\u00c7\u008a\u00c3\u00c9\u00be \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00c8\u00e5\u00c3\u00c9\u00c8 \u00a6\u00a8\u00ba\u00eb\u00c9 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00c8\u00a8\u00e0\u00cb \u00c0\u00be\u00cc\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4 \u00c9\u00e6\u0091 \u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00c8\u00a8\u00e0\u00cb\u00a1\u00cc\u00ec \u00bc\u00cd\u00cc\u00a8\u00b4 \u00c9\u00e6\u0091 \u00a8\u00eb\u00c8\u00e9 \u00c9\u0090\u00be\u00e5\u00a8\u00ef\u008a \u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba\u00c6\u00a8\u00e0,\n\n\u00ef\u00be\u00e5\u00cc\u00c8\u00a8\u00e5 \u00cd\u00e6\u00d6\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00cc\u00cd ;\u201d\n\n(2)\u00a6\u00c4 \u00a4\u00c0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a2) \u00ef\u00d8\u00bc\u00ef\u00c6\u00cd\u00fa \u2014\n\n(\u00a1)\u00a6\u00c4 \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4\u00a1\u00e6\u00ba\u00f8 \u00ef\u00d8\u00bc\u00ef\u00c6\u00cd\u00fa \u201c\u00a6\u00c4 \u00c8\u00e5\u00c3 \u00a6\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5XII \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c9\u00ec \u00a6\u00a8\u00c4 \u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a6\u00c4 \u00c8\u00e5\u00c3\u00a6\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 VII \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c9\u00ec \u00a6\u00a8\u00c4 \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00c6\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n4.2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 8 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ba\u00c9 \u00f3\u00c7\u00b4\u00ba\u00e0 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089:\u2014\n\n(1)\u00a6\u00c4 \u00ef\u00d9\u00bc\u00ef\u00c6\u00e0 (Lxxvii) \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00cd\u00fa \u201c\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c2\u00f3\u00a8\u00c7\u00be\u00a8\u00e5\u00da\u00c6\u00e5\u00c6\u00ba\u00be\u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c2\u00f3\u00a8\u00c7\u00be\u00a8\u00e5\u00da\u00c6\u00e5\u00c6\u00ba\u00be\u00c6 ;\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(2)\u00a6\u00c4 \u00ef\u00d9\u00bc\u00ef\u00c6\u00e0 (Lxxvii) \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(Lxxviii) \u00bc \u00ef\u00be\u00e5\u00e0\u0091\u00a8\u00e0 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u201d\n\n5.2003 \u00a1\u00e2\u00a8 37 \u00bc\u00c7\u00be \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0\u00c9\u00c7\u00b4 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 9 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00c0\u00d6\u00bc\u00fa \u00ba\u00c9\u00f3\u00c7\u00b4\u00ba\u00e0 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n\u00eb(1)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c\u00be\u00f8\u00c8 \u00c0\u0091\u00be\u0091, \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u2013\u201d \u00c6\u00be\u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c2005 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4\u00ef\u00c0\u00c7 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00ec \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c8 \u00c0\u0091\u00be\u0091, \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 -\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 8\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 9\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n32005 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(2)\u00a6\u00c4 \u00a4\u00c0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00a1\u00f5\u00ba\u00e0 \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(\u00a1\u00e5\u00a1\u00e5)2005 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00c0\u00cc\u00ea\u00c9\u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c8\u00c0\u0091\u00be\u0091 \u00c9\u00c8\u00e8\u00be\u00e0 \u00cd\u00d6 \u00a1\u00b6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u2014\n\n(i)\u00b0\u00be\u00c7\u00b0\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00c8\u00c2\u00be \u00bd\u00ea\u00c7\u00c6\u00a8\u00e0\u00bc\u00c7\u00be \u00c6\u008a \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb\u00b4 \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0\u00ef\u00aa\u00d1\u00c4 ;"
