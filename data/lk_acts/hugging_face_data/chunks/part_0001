    "chunk_text": "(v)\u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a2\u00bc\u00fa\u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a\u00c0\u00e5\u00c8\u00c4\u00a8\u00e0, \u00f3\u008a\u00d6\u00c6 \u00c4\u00e5\u00da\u00aa\u00c6\u00a8\u00e0, \u00b0\u00c8\u00e5\u00ca\u00c6\u00a8\u00e0, \u0097\u00f3\u00c8\u00e8\u00c2\u00c8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00b0\u00c8\u00c6 \u00ef\u00c2\u00bc\u00e5 \u00cd\u00e6\u00d7\u00ef\u008a \u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00c6\u00a8\u00c7\u00be \u00c0\u00e5\u00c7\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00a8\u00e5\u00c8\u00c6\u00ba\u00eb\u00ce \u00bc\u00fb \u00a6\u00c4 \u00c9\u00ba\u00e0\u00a8\u008a \u00a2\u00bc\u00fa\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00be\u00e0\u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00ba\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00c9\u00ba\u00e0\u00a8\u008a, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa\n\n2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba14\n\n(vi)1978 \u00a1\u00e2\u00a8 41 \u00bc\u00c7\u00be \u00be\u00e5\u00aa\u00c7\u00e8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c0\u00be\u00ba\u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00be\u00e5\u00aa\u00d6\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec \u00bc\u00c9\u00e5\u00b8\u00e8\u00b0 \u00a6\u00e0\u00a8\u00a8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 (\u00ef\u00cd\u00e5\u00e0\u00b4\u00c8\u00e0 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8\u00cc\u00e2\u00a8\u00f9\u00da\u00b8\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9) \u00ef\u00cd\u00e5\u00e0\u00b4\u00c8\u00e0 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a8\u00e5\u00da\u0095\u00a8 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00e5\u00da\u0095\u00a8\u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8 \u00cc\u00e2\u00a8\u00f9\u00da\u00b8\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00c3\u00e5\u0097\u00ba \u00a8\u00f8\u00d7\u00c4\u00cc\u00bf\u00cd\u00e5 \u00a2\u00bc\u00fa\u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00ef\u00c9\u00ce\u00bf\u00e5\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8 \u00c3\u00e5\u0097\u00ba\u00a8\u00ce \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00be\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00ba\u00e0 \u00c6\u008a \u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a\u00c8\u00e6\u00c2\u00ec \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00cd\u00e5\u0093\u00c0\u00ba\u00f1\u00ef\u00bc\u00e0\u00c0\u00c8\u00a8 \u00c6\u008a \u00a6\u00e0\u00a8\u00a8\u00c6\u00a8\u00e0, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa\u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u00ef\u008a \u0097\u00c6\u00bc\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u0097\u00c6\u00bc\u00c4\u00c4\u00ba \u00cc\u00e8\u00c6\u00c6\u00b4 \u00cd\u00c6\u00c6\u00fa \u00ba\u00eb\u00ef\u00be\u00be\u00e0 \u00ef\u00bc\u00a8\u00a8\u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 :\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, (i), (ii), (iii), (iv), (v) \u00c9\u00be\u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c9\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c4\u00c4 \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00c9\u00ba\u00e0\u00a8\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c0\u00cc\u00ea\u00aa\u00fa\u00c6\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb \u00ba\u00eb\u00ce \u00bc\u00fb \u00ef\u00aa\u00d1 \u00c6\u00e5\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00bc\u00fb\u00c4\u00be\u00e5 \u00c4\u00ea\u00bc\u00c8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba\u00c0\u00d6\u00bc\u00fa, \u00a6\u00c4 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00c9\u00ba\u00e0\u00a8\u008a \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a\u00ef\u00cd\u00e5\u00e0 \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00c8\u00cc\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a \u0097\u00c6\u00bc\u00c4\u00b4\u00cc\u00c4\u00e5\u00be \u00be\u008a \u00a6\u00c4 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00c9\u00ba\u00e0\u00a8\u008a\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u008a \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a2\u00cd\u00ba\u00f8\u00be\u00e0\u00c4 \u00c9\u00ec \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c4 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a1\u00c9\u00cc\u00c7 \u00ef\u00bc\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d;\n\n(\u00a1\u00e7)\u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6 \u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c2002 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1\u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c2002 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4\u00c0\u00cc\u00ea\u00c9 \u00a6\u00ef\u00cd\u00ba\u00e0 2004 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 31 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4\u00ef\u00c0\u00c7\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba15\n\n(\u00a2)\u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e7) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c\u00a6\u00c4 \u00c0\u00d6\u00ab\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa\u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201c2004 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 31 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00a6\u00c4\u00c0\u00d6\u00ab\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd\u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(\u00a3)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a3) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00c6\u00b4\u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00c6\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c\u00a6\u00ef\u00cc\u00e0\u00c4 \u00ba\u00c9\u00f3\u00c7\u00b4\u00ba\u00e0 2004 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0\u00a6\u00bc\u00fa\u00be\u00b4 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00a2\u00cd\u00ba (ii) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c6\u008a \u00c0\u00d6\u00ca\u00f2\u00c6\u00a8\u00e0\u00a8\u00eb\u00c8\u00e8\u00c6\u00b4 \u00bc\u00fb\u00ef\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6\u201d;"
