    "chunk_text": "43.1995 \u00a1\u00e2\u00a8 33 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00cc\u00cd \u00ef\u008a \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba\u00c0\u00d6\u00bc\u00fa \u00c9\u00ec \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00cd \u00a6\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00be\u00f8\u00c6\u0095\u00ba \u00c9\u00ec \u00c6\u008a \u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00a8\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00ef\u008c \u00c6\u008a \u00c8\u00e8\u008d\u00ba \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c8\u00e8\u008d\u00ba \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00bc, \u00a6\u00c9\u00e6\u00be\u00f8\u00c6\u008a \u00c8\u00e8\u008d\u00ba \u00be\u00f9\u00ba\u00f8\u00c6\u00a8 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00bc \u00a1\u00ba\u00c7 \u00aa\u00e6\u00b4\u00ea\u00c4\u00a8\u00e0 \u00ba\u00f8\u00c2\u00ea\u00be \u00bc, \u00a6\u00e0 \u00c8\u00e8\u008d\u00ba \u00be\u00f9\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00cd \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c2\u00c8\u00e5\u00ef\u00c0\u00e5\u00ef\u00c7\u00e5\u00ba\u00e0\u00ba\u00eb \u00c9\u00be\u00cc\u00cd \u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00ef\u00a8\u00e5\u00b4\u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00cc\u00e8\u00c6\u00f5 \u00a8\u00f2\u00e8\u00c6\u00e5, \u00ba\u00f9\u00c7\u00b8 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb, \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a6\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00c0\u00d6\u00bc\u00fa \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00ef\u00a8\u00e5\u00b4, \u00a8\u00c7 \u00ef\u00aa\u00be \u00c6\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n\u00ef\u00ca\u00e0\u00cb \u00a8\u00f8\u00d7\u008a.\n\n572005 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba"
