    "chunk_text": "(10) \u0097\u00bc\u00f1\u00e5\u00b3\u00e5\u00be\u00c6 \u00cd\u00e5 \u00a1\u00e5\u00bd\u00f1\u00e5\u00ba\u00e0\u0095\u00a8 \u00aa\u00eb\u00b8 \u00c9\u00aa\u00e5\u00c9 \u00cc\u00e8\u00c6\u00c8\u00e0\u00c8\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00cd\u00c0\u00ba \u00c0\u00e8\u00b8\u00e8\u00cc\u00cc\u00c4\u00ba\u00eb\u00c8\u00e8\u00ba \u00ef\u00c8\u00cc \u00a6\u00a8\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00a1\u00e5\u00ba\u00e0\u00c4 \u00ca\u00a8\u00e0\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00c6\u00ea\u00ba\u00e0 \u00aa\u00f2\u00e5\u00e4\u00c6 \u00cd\u00e5 \u00be\u00e5\u00aa\u00d6\u00a8\u00c0\u00f2\u00b0\u00e5\u00c9\u00be\u00e0 \u00ef\u00c8\u00cc \u00b0\u00be\u00ba\u00e5\u00c9 \u00c7\u00b4\u00c9\u00c8\u00e0 \u00ba\u00eb\u00ce \u00a1\u00cd\u00fa\u00e2\u00cc\u00e5\u00c9\u00e5\u00bc\u00fb\u00c9 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6 \u00c9\u00ec \u0097\u00b4 \u00cc\u00cd \u00a6\u00a8\u00f9\u00c0\u00f2\u00b0\u00e5\u00c9\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00cc\u00c4\u00be\u00e0\u0097\u00ba \u00ef\u00c8\u00e5\u00e0\u00a8 \u00b0\u00be\u00ba\u00e5\u00c9, \u00cc\u00e5\u00c4\u00c6, \u00cc\u00cd\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6 \u00cc\u00cd \u00a6\u00a8\u00f9 \u00cc\u00e0\u00c9\u00e5\u009e\u00be\u00c0\u00f2\u00b0\u00e5\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00a1\u00e6\u00ba\u00f8 \u00a1\u00ef\u00be\u00f1\u00e5\u00be\u00f1 \u00c3\u00a8\u00e0\u00ba\u00f8\u00c6 \u00c9\u00e6\u00bc\u00aa\u00ba\u00e0 \u00c8\u00a8\u00e0\u00cb\u00b8\u00ef\u00a8\u00e5\u00b4\u00aa\u00ba\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00b0\u00e5\u00ba\u00f9\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00c0\u00e5\u00f3 \u00c7\u00e5\u00b0\u00f1 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6 \u00c9\u00ec\u0097\u00b4 \u00c0\u00c4\u00b8\u00a8\u00e0 \u00c4\u00be\u00ea\u00cb\u00f1 \u00cc\u00e2\u00cd\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a4\u00c0\u00d6\u00c4 \u00cc\u00ba\u00eb\u00b4 \u00cd\u00e5 \u00c4\u00be\u00e5 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00c4 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00be \u00c2\u00c9\u00a1\u00c9\u00ef\u00c2\u00e5\u00e0\u00bd \u00a8\u00c7 \u00ef\u00aa\u00be \u00a6\u00e0 \u00a1\u00c7\u00c4\u00ea\u00b8\u00ea \u00cc\u00e5\u00a8\u00e0\u00cb\u00e5\u00ba\u00e0 \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00e6\u00c7 \u00c9\u00e6\u009c\u00c4.\n\n7 \u00c9\u00be \u00d7\u00ba\u00f8\u00c6 - \u00c0\u00f2\u00ba\u00f8\u00b3\u00e5\u00c9 :\n\n(1) \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ba\u00e0\u00c9\u00c6 \u00a2\u00c8\u00e0\u00f5\u008a \u00a8\u00c7\u00be \u00cc\u00e7\u00c4 \u00ef\u00bc\u00be\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c4 \u00c0\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0\u00c0\u00f2\u00ba\u00f8\u00b3\u00e5\u00c9 \u00bc\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00cc\u00e7\u00c4 \u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00c4\u00cd\u00e5 \u00cc\u00c3\u00e5 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb \u00c4 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e5\u00c4\u00ec\u00cd\u00fa\u00a8\u00c9 \u00ef\u008a \u00c0\u00f2\u00ba\u00f8\u00b3\u00e5\u00c9 \u00a1\u00f5\u00ba\u00e0 \u00a8\u00c7\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb\u00c6 :\n\n81999 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00da\u00ef\u00c9\u00e5\u00e0\u00bc\u00c6 \u00ca\u00f2\u00c4\u00bc\u00e5\u00be\u00cc\u00e2\u00aa\u00c4\u00c6 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a) (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(2) \u201c\u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00da\u00ef\u00c9\u00e5\u00e0\u00bc\u00c6 \u00ca\u00f2\u00c4\u00bc\u00e5\u00be \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00cd\u00e5 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8\u00c9\u00c8\u00b4\u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00be\u00f8\u00cc\u00e0\u00cc\u00c7\u00b8\u00bd\u00f1\u00e5\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00c6 \u00a8\u00c7\u00be \u00c2\u00c9\u00b4\u00ba\u00e0, \u00c4\u00e5\u00ef\u00aa\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ba\u00e0\u00c9\u00c6\u00cd\u00e5 \u0097\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u00e8\u00c6\u00f5\u00c4 \u00c0\u00f2\u00ca\u00e0\u00be\u00c9\u00c8 \u00bc\u00fb \u00c9\u00e6\u0091\u00cd\u00fa\u0090 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00cd \u0097\u00bd\u00e5\u00c6\u00a8\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00ba\u00e9\u00c7\u00b8 \u00a1\u00c9\u00cc\u00e5\u00be \u00ba\u00f9\u00c7\u00b8 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00aa\u00be\u00e0\u00be\u00e5 \u00c2\u00c9\u00b4\u00ba\u00e0 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00c0\u00f2\u00ba\u00f8\u00b3\u00e5\u00ef\u00bc\u0095. \u00ba\u00c9 \u00bc \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0 \u00be\u00f9\u00ba\u00f8 \u00d7\u00ba\u00f8 \u00a1\u00be\u00ea\u00c9 \u00c4\u00e5\u00ef\u00aa\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ba\u00e0\u00c9\u00c6 \u00c6\u008a \u0097\u00b4\u00a8 \u00bc\u00fb \u00c4\u00b4\u00a1\u00cd\u00e8\u0095 \u00c9\u00ec\u00ef\u00c6\u00e0 \u00be\u008a \u00a6\u00e0 \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0 \u00c4\u00b4 \u00a8\u00f8\u00cc\u00e8\u00c4 \u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00cd\u00e5\u00be\u00f8\u00c6\u00a8\u00e0 \u00cc\u00e8\u00f3\u00c9\u00ec\u00ef\u00c6\u00e0 \u00c6\u00c6\u00e8\u00ef\u00be\u00e5\u00cc\u00c8\u00a8\u00be \u00a1\u00ba\u00c7, \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ba\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u00a1\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00eb\u00b4\u00a6\u00c4 \u00a1\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8\u00c9 \u00a7\u00cd\u00ea\u00b4 \u00a8\u00e6\u00ce\u00c8\u00a8\u00e0 \u00c9\u00be \u00ef\u00bc\u00c6\u00a8\u00e0 \u00ef\u00cc\u00e0 \u00ef\u00be\u00e5\u00c0\u00e8\u00ce\u00e8\u00aa\u00e6\u00be\u00f9\u00c4\u00b4\u00ba\u00e0\u00c0\u00f2\u00ba\u00f8\u00b3\u00e5 \u00ef\u00bc\u0095. \u00c4\u00e5 \u00a1\u00ba\u00f8\u00be\u00e0 \u00cc\u00e8\u00f3 \u00c9\u00ec \u00c0\u00f2\u00c4\u00e5\u00bc \u00ef\u00bc\u00e5\u00e0\u00cb \u00cd\u00e5 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d7\u00c4 \u00a1\u00e5\u00bc\u00fb\u00f3\u00da\u00c9\u00c8\u00a8\u008a\u00c9\u00c8\u00e8\u00be\u00e0 \u0095\u00bc\u00fb \u00be\u00e6\u00c9\u00ba \u00c6\u008a \u00bc\u00fa\u00be\u00c6\u00a8 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ba\u00e0\u00c9\u00c6 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00cc\u00ea\u00f3\u00cc\u00e0\u00cc\u00a8\u00eb\u00d1\u00c4\u00b4 \u00bc \u00c0\u00f2\u00ba\u00f8\u00b3\u00e5 \u00ef\u00bc\u0095.\n\n8 \u00c9\u00be \u00d7\u00ba\u00f8\u00c6 - \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ba\u00e0\u00c9\u00c6 :\n\n(1) \u00c9\u00c6\u00cc \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 16 \u00b4 \u00a1\u00b6\u00ea \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8, \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00cd\u00e5\u00c0\u00f2\u00ba\u00f8\u00b3\u00e5\u00c9 \u00c0\u00e8\u00ce\u00e8\u00ef\u00aa\u00be \u00a6\u00e0 \u00a1\u00be\u00ea\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a6\u00a8\u00ad\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u0097\u00bd\u00e5\u00c6\u00a8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00ef\u00c8\u00cc \u00c2\u00bf\u00c9\u00e5 \u00aa\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00ba\u00a8\u00e0 20 \u00c9\u00be\u00d7\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00cd\u00c9\u00ea\u00c8\u00a8 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00ce\u00c4\u00ea \u00ef\u00a8\u00e5\u00b4 \u00cc\u00e8\u0090\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(1\u00a1) (123 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00cc\u0095\u00ba\u00f8 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a\u00cc\u00da\u00ef\u00c9\u00e5\u00e0\u00bc\u00c6 \u00ca\u00f2\u00c4\u00bc\u00e5\u00be \u00cc\u0095\u00ba\u00f8\u00c6\u00a8\u00b4, \u00cc\u00da\u00ef\u00c9\u00e5\u00e0\u00bc\u00c6 \u00cc\u0095\u00ba\u00f8\u00c6\u00a8\u00b4/ \u00cc\u00da\u00ef\u00c9\u00e5\u00e0\u00bc\u00c6 \u00cc\u00e2\u00cc\u00bc\u00c6\u00a8\u00b4\u00a6\u00a8\u00f9 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a6\u00c4 \u00cc\u0095\u00ba\u00f8\u00c6/\u00cc\u00e2\u00cc\u00bc\u00c6 \u00a1\u00c9\u00cc\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00ef\u00ba\u00a8\u00e0, \u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00d6\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00ba\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00c4\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00ba\u00a8\u00e0\u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u0097\u00c6 \u00cd\u00e6\u00a8."
