    "chunk_text": "\u201c\u00c1\u00af\u0081\u201d \u00a9\u0081\u00b9\u00d7 1995 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b7\u00c8\u00b6\u00c8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00b6\u00bd\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00d7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00cd\u00b6 \u00cc\u00b9\u00c7\u00dd\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d\u00b0\n\n(2)\u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (4) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00ce\u00c1 \u00b7\u00c9\u00af\u00c6\u00af\u00c8\u008c\u00b4\u00c6\u00d5 \u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00ce\u00c1 \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 :\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c68\n\n\u00bb\u00bf\u00e2 \u00b1\u00c7\u0081\u00ce\u00bd \u00c1\u00c0+\u00c6\u00d0\u00c1\u00c7\u00bc\u00c7\u008a\u0081\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00c7\u00b4\u00ce\u00af\u00af\u00c6 \u00d0\u0088\u008a\u00dd\u00b9\u00c6\u00da \u00a7\u00b4\u0081\u00b9\u0088\u00af\u00c6\u00ce\u00af\u008a\u0081 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081\u00cd\u00b9\u00c7\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00c7\u00b5\u00c8\u008a\u00df\u00ba\u00c6 \u00af\u00b4\u00c6\u0088\u00b4+\u00c6\u00af\u00bf\u00c8\u00df\u00ba\u00c6\u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00b1\u00ce\u00c1\u00af\u00bf\u00c6 \u00ba\u00c9\u00d7 \u00a3\u00c1\u00bc\u00c7\u00be\u00c6\u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b1\u00be\u00e2\u00af\u00e0\u00af\u00c6\u00d0 \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u00bb\u00c7\u00be\u00c6 \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00a7\u00bf\u00c6\u00bf\u00c9\u00b4\u00c6\u00d5 \u00c1\u00bc\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00c6\u00d0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00b6\u00c8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00bf\u00c6 \u00a7\u00bc\u00c8\u00b6\u00c6\u00d7\u00ce\u00b4\u00bb\u00c1\u00bc\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d\n\n(3)\u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (5) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u201c\u00b9\u00b6\u00c8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6\u201d\u00c6 \u00a9\u0081\u00b9\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u201c\u00a7\u00bc\u00c8\u00b6\u00c6\u00d7\u00ce\u00b4\u00bb\u00c1\u00bc\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\u201d \u00a9\u0081\u00b9\u00d7 \u00c1\u00ce\u00bc\u008a\u00be\u00c7\u00b8 \u00a9\u00be\u00c6\u00be\u00c7\u00b1\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8 \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c(5) \u00a5\u00dd\u00b9\u00b6\u00c6\u00cd\u00b6\u00c7\u00bc\u00c7\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 (2)\u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u008c\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u00d5 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00c1\u00b9\u00c6\u00b9\u00d5\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u008c\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00de\u00b6\u00c6\u00d7\u00ba\u00c6 \u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081 \u00db\u0088\u008c\u00be\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00d9\u00ba\u00b6\u00c8\u00bb\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00bc\u00c8 \u00a7\u00bf\u00c6\u00bf\u00c9\u00b4\u00c6\u00d5 \u00c1\u00bc\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00d5 \u00c1\u00bc\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00ce\u00bb \u008c\u00b3\u00c6\u00d2\u00ba\u00c7\u008a\u0081\"\u00a7\u00bf\u00c6\u00bf\u00c9\u00b4\u00c6\u00d5\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u008a\u0081 \u00ba\u00c8\u00ce\u00af \u00ba\u00c9\u00bf\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c7\u00af\u00c7\u00d7 \u00a4\u00b8\u00c7\u00be\u00c6 \u00a3\u00d5\u00b6\u00c6\u00b6\u00d5\u00b6\u00c6\u00d7\u00de\u00ba\u00c6 \u00c1\u00bc\u00c8 \u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081 \u00cd\u00b9\u00c7\u00d7\u00ba\u00c6 \u0089\u0081\u00b8\u00dd\u00ba\u00c6\u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00d5 \u00c1\u00bc\u00c8\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00b8 \u00a3\u00c1\u00c6\u00c1\u00c7\u00cd\u00bd \u00a9\u00b6\u00c8\u00bc\u00c9\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00ba\u00c8\u00ce\u00af \u00a9\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u00be\u00c6 \u00db\u00b6\u00be\u00c7\u00c1\u00b6\u00c7\u00af \u00a9\u00e1\u00b7\u00c6\u00b6\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8 \u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081 \u00db\u0088\u008c\u008b\u00dd\u00b7\u00c6\u00d7 \u00a4\u00de \u00ba\u00c7\u00b6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u00be\u00c6 \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00a9\u00b6\u00c8\u00bc\u00c9\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00ba\u00c8\u00ce\u00af\u008a\u0081 \u00a9\u00b1\u00c6\u00b1\u00ba\u00c6 \u00a9\u00d7\u00e2\u00ba\u00c6 58 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (3) \u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00ce\u00ba\u00bb \u00ba\u00c9\u00bf\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00d7 \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00ba\u00c9\u00bf\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6\u008c\u00b4\u00b6\u00c6\u00d7\" \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\"59\u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00bd\u00c6\u00af\u00c7\u00b8 \u00af\u00c7\u00b9\u00c6\u00da \u00c1\u00c7\u00b1\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00ce\u00ba\u00bb\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00ba\u00c9\u00bf\u00bf\u00c8\u00b9\u00c6\u00da \u00cc\u00af\u00c7\u00d5\u00ba\u00b6\u00c8\u00bb\u00c7\u00af \u00c1\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081 \u00db\u0088\u008c\u00be\u00c6\u00a5\u00dd\u00b7\u00c6\u00d7 \u00ac\u00dd\u00ba\u00c7\u00b6 \u00db\u0088\u008c\u00bd\u00c6 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00c8 \u00ba\u00c9\u00bf\u00bf\u00c8\u00b9\u00c6\u00da\u00b6\u00c6\u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00db\u0088\u00c1\u00ce\u00b4\u00dc\u00ba\u00c6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 13 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c69\n\n\u00cc\u00b6\u00c7\u00ce\u00af\u008a\u0081 \u00ba\u00c9\u00d7 59 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u008c\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u0096\u00b6\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00c1\u00b4\u00c6\u0088 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0"
