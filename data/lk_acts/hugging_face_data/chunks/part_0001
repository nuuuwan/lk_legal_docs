    "chunk_text": "(viii) \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00c0\u00c6\u00be\u00ea\u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc, \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00a6\u00e0\u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5 \u00ef\u00aa\u00be \u00c6\u00e5\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4\u00cc\u00bf\u00cd\u00e5 \u00be\u00e6\u00c9\u00ba \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u0097\u00c4\u00cc\u00e5 \u00ba\u00ee\u00ba\u00f9\u00c6\u00fa\u00a8 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00cd\u00e5 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00c9 \u00ef\u00cd\u00e5\u00e0\u00c0\u00f2\u00e5\u00ef\u00c6\u00e5\u00e0\u00aa\u00fa\u00a8 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00c9 \u00cc\u00c0\u00c6\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea\u00c9\u00cc\u00e6\u00c0\u00c6\u00fb\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c9\u00ca\u00f1 \u00c6\u008a \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n20.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(\u00a1) \u201c \u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u201d \u00c6\u00be \u00ca\u00fb\u00da\u00cb\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n\u201c 2002 \u00a1\u00ef\u00aa\u00e5\u00e0\u00cc\u00e0\u00ba\u00eb \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00e5\u00c7\u008a\u00c3\u00c9 2004\u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0, \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00cc\u00bf\u00cd\u00e5\u2013\n\n(1) \u00a6\u00e0 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (xviii) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(xviii) \u00cc\u00c0\u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00a8\u00c8\u00e0\u00c2\u00f3 \u00c0\u00cd\u00cc\u00ea\u00a8\u00c4\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00a8\u00c7 \u00aa\u00ba\u00cd\u00e6\u00a8\u00f8 \u00c9\u00ec \u00bc, \u00a6\u00ef\u00cd\u00ba\u00e0 \u00a1\u00bc\u00e5\u00ce \u00a8\u00c8\u00e0\u00c2\u00f3 \u00aa\u00fa\u0097\u00cc\u00ea\u00ef\u008a \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00a8\u00c7 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00c9\u00ec \u00bc, \u00c8\u00e6\u00c2\u00ea\u00b8\u00ea \u00c6\u008a \u00ef\u00aa\u00d1\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 2003\u00b0\u00ec\u00c8\u00e8 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00ec \u00c6\u008a \u00a8\u00c8\u00e0\u00c2\u00f3\u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0\u00ef\u0089\u00c7\u00e6\u008a \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00bc \u00ef\u00c4\u00c4 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4 \u00c4\u00ba \u00a1\u00c6\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c9\u0090\u00be\u00e5\u00a8\u0095\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00bc\u00cd\u00c6\u00a8\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00c6\u008a \u00ef\u00aa\u00d1\u00c4\u00a8\u00e0 \u00cd\u00e6\u00c7, 2000\u00a1\u00e2\u00a8 56 \u00bc\u00c7\u00be \u00a8\u00c8\u00e0\u00c2\u00f3 \u00c4\u00ea\u00c8\u00f1\u00a8\u00c7\u00b8 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c4\u00ea\u00c8\u00f1\u00a8\u00c7\u00b8 \u00a8\u00c8\u00e0\u00c2\u00f3\u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00cc\u00e6\u00c0\u00c6\u00ea\u00c4 ;\u201d\n\n(2) \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (xxiii) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(xxiii) \u00ef\u00c7\u00bc\u00fa \u00c0\u00e8\u00ce\u00e8 \u00cc\u00cd \u00a1\u00ba\u00e0 \u00c6\u00be\u00e0\u00ba\u00f2 \u00ef\u00c7\u00bc\u00fa \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c7\u00bc\u00fa \u00c0\u00e8\u00ce\u00e8 \u00b6\u00c6\u00fa \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00c4\u00ea\u00f7\u00b8\u00c6\u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00ea\u00c4 ;\u201d;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2004 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba26\n\n(3) \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (xxvi) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(xxvi) \u00c2\u00b6 \u00a2\u00d6\u00ad\u00eb , \u00ef\u00cc\u00e5\u00e0\u00c6\u00e5 \u00ef\u00c2\u00e5\u00e0\u00e2\u008e \u00a1\u00e5\u00cd\u00e5\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ba\u00e0\u00cc\u00f1 \u00a1\u00e5\u00cd\u00e5\u00c7\u00cc\u00e6\u00c0\u00c6\u00ea\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\u201d;\n\n(4) \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (xxvii) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00e0 \u201c\u00a4\u00c0\u00e5\u00e2\u00aa \u00cc\u00e6\u00c0\u00c6\u00ea\u00c4\u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a4\u00c0\u00e5\u00e2\u00aa \u00cc\u00e6\u00c0\u00c6\u00ea\u00c4 \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00be\u00c6\u00be\u00c6;\u201d; \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(5) \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (xxx) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00e0 \u201c \u00a2\u00b6\u008a \u00cd\u00e5 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea\u00a8\u00f8\u00d7\u008a \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4.\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a2\u00b6\u008a \u00cd\u00e5 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4;\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\u201d.\n\n(6) \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (xxx) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014"
