    "chunk_text": "\u008c\u00b6\u00c8 9 - \u00a7\u00de\u00b9\u00c6\u00b9\u00c7\u00ae\u00ce\u00ba\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00b5+\u00c6\u00af\u00bf\u00c6:(1) \u00c1\u00c7\u008b\u00b9 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6 \u00a4\u00ae\u00d5\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00b5\u00ba\u00c7\u00af \u00a4\u00ae\u00d5\u00af\u00c6\u00d0 \u00ab\u00b7\u00c6\u00d7 \u00f4\u00b9\u00c7\u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00b1\u00c7\u00b6\u00c7\u00bc\u00b5 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6 \u00a4\u00ae\u00d5\u00af\u00c6\u00d0\u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6 \u00a5\u00dd\u00b9\u00b6\u00c6\u00ce\u00b6\u00b7\u00c6\u00d7 \u00f4\u00b9\u00c7 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u00c1\u00c0+\u00c6\u00d0 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6 \u00a4\u00ae\u00d5\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00b5\u00ba\u00c7\u00af \u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00cd\u00c1\u00c7\u00a3\u00be\u00c6\u00be\u00d7 \u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00c1\u00c7\u00c6\u00af\u00bf\u00c6 \u008c\u00dd\u00ba\u00c6\u00da\u00ba\u00c6 \u00cd\u00c1\u00de\u00cc\u00b6\u00c7\u00ce\u00af\u00ce\u00bb\u00cd\u00bb\u00c7 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(4) \u00cc\u00af\u00bf\u00bc\u00c1 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00e0\u00ba\u00c6 \u00b1\u00c7\u00c6\u00c1\u00cd\u00b6\u00b1 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00e0\u00ba\u00c6\u00a7\u00de\u00b9\u00c6\u00b9\u00c7\u00ae\u00ce\u00ba\u00af \u00af\u00b4\u00c6\u00b4\u00b5\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00af\u00c6 \u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00d5\u00ce\u00ba\u00bb\u00c1\u00c7\u00c6 \u00a3\u00be\u00c6\u00be\u00c7\u00c6\u00b0\n\n(4\u00a3) \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b9\u00c6\u00da \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00bf\u00c6 \u00a4\u00ae\u00d5\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00b5\u00ba\u00c7\u00af \u00a5\u00dd\u00d8{\u00de\u00f4\u00b9\u00c7\u00ce\u00c1\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(5) \u00c1\u00c7\u008b\u00b9, \u00b1\u00c7\u00b6\u00c7\u00bc\u00b5, \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00c1\u00c0+\u00c6\u00d0 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00da\u00c1\u00d0\u00b6\u00c8\u008a\u00b8\u00bc\u00c7\u00b8 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00bf\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00da\u00b6\u00c8\u00bb \u00b9\u00b3\u00c6\u00b1\u00c7+\u00c6\u00af\u00a4\u00ae\u00d5\u00af\u00c6\u00d0\u00ba\u00c7\u00b8 \u00b6\u00ba\u00d7 \u00a7\u00de\u00b9\u00c6\u00b9\u00c7\u00ae\u00ce\u00ba\u00ce\u00bb \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00b9\u00b3\u00c6\u00b1\u00c7+\u00c6\u00af \u00a4\u00ae\u0088\u00b8\u00d7\u00ba\u00c6 \u00ba\u00c7\u00b1\u00c6\u00d2 \u00ba\u00c7\u00b6\u00ba\u00c6 31 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u0081\u00b8\u00c7\u00c6\u00a7\u00de\u00b9\u00c6\u00b9\u00c7\u00ae\u00ce\u00ba\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00b5\u00b6\u00c6\u00ce\u00b6\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6 \u00da\u00d7\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(6) \u008c\u00be\u00d0\u00b6\u00c1\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00ce\u00af\u00bb\u00c7\u00af\u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00bd\u00ce\u00c1\u008a\u0081 \u00db\u0088 \u00cc\u00c1\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00ba\u00d7 \u00a7\u00de\u00b9\u00c6\u00b9\u00c7\u00ae\u00ce\u00ba\u00ce\u00bb\u00a5\u00c0\u00af\u00c6\u00d0\u00ba\u00c6 \u00af\u00c0\u00af \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00bf\u00c6 \u00a3\u00c1\u00c7\u00c6\u00af\u00bf\u00c8\u0081 \u00a7\u00de\u00b9\u00c6\u00b9\u00c7\u00ae\u00ce\u00ba\u00af\u00c6\u00af\u00c7\u00be\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00af\u00c0\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00c8\u00bb \u00ac\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u0081\u00cc\u00af\u00c7\u00ce\u00b4\u00a9\u00b6\u00ce\u00b8\u00dc\u00ba\u00c6 \u00b6\u00c8\u00dd\u00ba\u00c6\u00b9\u00b6\u00c6 \u00b6\u00dd\u00ba\u00c6\u00b9\u0088 \u00cd\u00af\u00c7\u00dd\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00a7\u00c7\u00c8\u00b6\u00c6\u00ce\u00b6\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00a4\u00af\u00c7\u00d7\u00b0\n\n121999\u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af,\u00a5\u00be+\u00c6\u00ce\u00af \u00b2\u00c7\u00b6\u00c8\u00af\u00b1\u00c7\u00c6\u00cd\u00c1\u00c7\u00b6\u00bb \u00b1\u00c8\u00bc\u00ba\u00b6\u00c7\u00b8\u00b1\u00c6 \u00b1+\u00c6\u00af\u00ba\u00c6 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6)(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00c1\u00c8\u00b6\u00c8 10 - \u00a7\u00de\u00b9\u00c6\u00b9\u00c7\u00ae\u00ce\u00ba \u00a5\u00b4\u00c7\u00b9\u00c6\u00da :\n\n\u00cc\u00b9\u00c7\u00d7\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c7\u00bf\u00c7\u00c6 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00bf\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00a5\u00b4\u00c7\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00cd\u00b9\u00d6\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ; \u00a3\u00b6\u00c8\u00be\u00c6, \u00a3\u00c1\u00c7\u00c6\u00af\u00bf\u00c8\u0081 \u00cc\u00b9\u00bb\u00c7\u00c6\u00af\u00e0\u00ba\u00c6, \u00a7\u00de\u00b9\u00c6\u00b9\u00c7\u00ae\u00ce\u00ba\u008a\u0081 \u00c1\u00d0\u00b6\u00c8\u00dc\u00ba\u00c6,\u00b7\u00c8\u00bc\u00b6\u00c6\u00b6\u00bc \u00db\u00af\u00c1\u00c7\u00c8\u00dc\u00ba\u00c6, \u00a7\u00de\u00b9\u00c6\u00b9\u00c7\u00ae\u00ce\u00ba \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00c8\u00af\u00b6\u00c8\u00dc\u00ba\u00c6, \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00c7\u00c6\u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c7\u008a\u00be\u00c6\u00be\u00c7\u00cc\u00b6\u00c7\u00c0\u00c8\u00b7\u00c6\u00b6 \u00b6\u00c8\u00af\u00b6\u00c8\u00bb\u00ba\u00c6, \u00cc\u00b9\u00c7\u00d7\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c7\u00bf\u00c7\u00c6 \u00a3\u00c1\u00b1\u00c8\u00bb\u00cc\u00ba\u00b8\u00af\u00c6\u00af\u00dd\u00b6\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00b6\u00af\u00c1\u00df\u00ba\u00c6 \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u008c\u00b6\u00c8 11 - \u00db\u00b6\u00c8\u00cd\u00bb\u00c7\u00c7\u00c6 \u00a3\u00ce\u00c1 :\n\n(1) \u00db\u00b6\u00c8\u00cd\u00bb\u00c7\u00bc\u00ce\u00c1 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b9\u00c6\u00da \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00bf\u00c7\u00af\u008c\u00bc\u00c7\u00b6 \u00a5\u00dd\u00b9\u00d7\u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a3\u00c1\u00c7\u00c6\u00af\u00bf\u00c6 \u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00a4\u00ae\u00d5\u00b9\u00c6 \u00cc\u00b9\u00c7\u00d7\u00d7\u00af\u00c6\u00e7\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00cc\u00b6\u00c7\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00a4\u00ae\u00d5\u00b9\u00c6 \u00cc\u00b9\u00c7\u00d7\u00af\u00c6\u00e7\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c8\u0081 \u00db\u00e1\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00dc\u00ba\u00c6\u00cd\u00b6\u00c7\u00c6\u00b7\u00c6\u00cc\u00b6\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4 \u00db\u0088\u00bb\u00c7\u00ce\u00ba \u00af\u00c7\u00bc\u00b5\u00ba\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00ae\u0088\u0081\u00cc\u00b9\u00c7\u00e1\u00d7 \u00b9\u00b6\u008c\u00d7\u00bd\u00b6\u00c6\u00b6\u00be\u00c6 \u00af\u00c7\u00bc\u00b5\u00ba\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00af\u00c7\u00bc\u00b5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00a7\u00de\u00b9\u00c6\u00b9\u00c7\u00ae\u00ce\u00ba \u00db\u0088\u00e2\u00de\u00b6\u00be\u00c6 \u00af\u00c7\u00bc\u00b5\u00ba\u00c7\u00af\u00db\u00b6\u00c8\u00cd\u00bb\u00c7\u00bc\u00ce\u00c1\u008a\u00be\u00c6 \u00aa\u00bd\u00c6\u00b9\u00b4\u00af\u00c6\u00ae\u0088\u00bb \u00a9\u00ce\u00c1\u00bb\u00cd\u00d9\u00ba\u00c6 \u00cc\u00c1\u00bd\u00c6\u00bd\u00c8\u00b4+\u00c6\u00af\u00ce\u00bf\u00b7\u00c8\u00bc\u00b9\u00c6\u00b9 \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00bd\u00ce\u00c1 \u00b6\u00b6\u00c6\u00d7\u00d7\u00c1\u00db\u00ce\u00b4\u00bb\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0"
  },
