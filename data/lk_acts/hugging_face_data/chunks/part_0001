    "chunk_text": "(xxxviii) \u00c6\u008a \u00ef\u00ef\u00c9\u00bc\u00f1 \u00c6\u00be\u00e0\u00ef\u00ba\u00f2\u00e5\u00e0\u00c0\u00a8\u00c7\u00b8, \u00ef\u00ef\u00c9\u00bc\u00f1 \u00a4\u00c0\u00a8\u00c7\u00b8 \u00ef\u00cd\u00e5\u00e0\u00aa\u00fa\u00c8\u00be\u00e0\u00c7\u00bb\u00c6\u00a8\u00e0 \u00c0\u00e8\u00b4\u00c7\u00b4 \u00cc\u00e8\u0090\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00cc\u00e2\u0097\u00bd\u00e5\u00be \u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00ba\u00f1\u00e5\u00aa \u00c2\u00c9\u00b4\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00d1\u00ef\u008a \u00bc\u00fb \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4\u00c6\u00be\u00e0\u00ef\u00ba\u00f2\u00e5\u00e0\u00c0\u00a8\u00c7\u00b8, \u00ef\u00ef\u00c9\u00bc\u00f1 \u00a4\u00c0\u00a8\u00c7\u00b8 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00fa\u00c8\u00be\u00e0\u00c7\u00bb\u00c6\u00a8\u00e0\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a1\u00e6) \u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 1 \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00b4 [(xxxix) \u00c9\u00be\u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00b4] \u00c0\u00cc\u00ea\u00c9 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00a6\u00a8\u00ba\u00eb\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201cII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n2004 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00cc\u00bf\u00cd\u00e5 \u2013\n\n(\u00a1) (i)\u00d1, \u0094\u00ba\u00e0\u00ba\u00c7 \u00d1, \u00cc\u00cd\u00c8\u00e0, \u00ba\u00f8\u00d6\u00ad\u00eb, \u00a8\u00c7\u00bf\u00c4\u00ea\u00e2\u00aa\u00eb, \u00a8\u00c7\u00e5\u00c2\u00ea\u00be\u00e6\u0090,\u00cc\u00e5\u00bc\u00fa\u00a8\u00e0\u00a8\u00e5, \u00c9\u00cc\u00e5\u00c9\u00e5\u00cc\u00e8, \u00aa\u008a\u0095\u00d6\u00cc\u00e0, \u00a8\u00c0\u00e5\u00c0\u00ea \u00ef\u00c0\u00e5\u00c8\u00e0, \u00c7\u00c2\u00da,\u00c7\u00c2\u00da \u00a8\u00f8\u00d6, \u00a1\u00c4\u00ea\u00ef\u00c0\u00e5\u00c8\u00e0, \u00c0\u00c8\u00e5\u00c9\u00da\u00aa, \u00cd\u00e5\u00c8\u00e0\u00c0\u00e8\u0090, \u00ba\u00f8\u00d6\u00ad\u00eb \u00c0\u00e8\u0090,\u00c0\u00e5\u00be\u00e0, \u00ce\u00bc\u00c7\u00e6 \u00a8\u00f8\u00d6\u00c0\u00e8\u0090, \u0094\u00ba\u00e0\u00ba\u00c7, \u00a8\u00f8\u00d6 (\u00a8\u00f8\u00d6\u00c0\u00e8\u0090\u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c6\u008a \u00bd\u00e5\u00be\u00f1 \u00c9\u00da\u00aa\u00c6\u00a8\u00f8\u00be\u00e0 \u00cc\u00a8\u00cc\u00e0 \u00ef\u00be\u00e5\u00a8\u00ce) ;\n\n(ii)1980 \u00a1\u00e2\u00a8 27 \u00bc\u00c7\u00be \u00cc\u00ea\u00c9\u00bf \u0097\u00c8\u00c9\u00ea\u00be\u00e0, \u00a4\u00c0\u00a8\u00c7\u00b8 \u00cc\u00cd \u00a7\u00f0\u00cb\u00bd\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u0097\u00c8\u00c9\u00ea\u00be\u00e0, \u00a4\u00c0\u00a8\u00c7\u00b8 \u00cc\u00cd\u00a7\u00f0\u00cb\u00bd \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00ce \u00c6\u008a \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00cd\u00e5 \u00a7\u00f0\u00cb\u00bd\u00a1\u00e6\u00ba\u00eb\u00dd (\u00cc\u00ea\u00c9\u00bf \u0097\u00c8\u00c9\u00ea\u00be\u00e0 \u00ef\u00be\u00e5\u00c9\u00be) \u00ef\u00c2\u00ef\u00cd\u00ba\u00e0 \u00f7\u00c9\u00f1 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00ef\u00cd\u00e5\u00e0 \u00a7\u00f0\u00cb\u00bd \u00cc\u00cd \u00a6\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00ef\u00cd\u00e5\u00e0 \u00a7\u00f0\u00cb\u00bd \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00c0\u00e6\u00c6\u00ea\u008a \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c4\u00ea\u00f7\u00c9\u00f1 ;\n\n2004 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba19\n\n(iii) \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00a7\u00f0\u00cb\u00bd \u00be\u00f8\u00aa\u00be\u00e0\u00b4\u00ea\u00c9\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u00e9\u00c6\u00cc\u00e2\u00ef\u00c6\u00e5\u00e0\u00aa \u00ef\u00cd\u00e5\u00e0 (\u00cc\u00ea\u00c9\u00bf \u0097\u00c8\u00c9\u00ea\u00be\u00e0 \u00cc\u00e2\u00ef\u00c6\u00e5\u00e0\u00aa \u00ef\u00be\u00e5\u00c9\u00be)\u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u00e9\u00c6 \u00cc\u00e2\u00ef\u00c6\u00e5\u00e0\u00aa \u00ef\u00cd\u00e5\u00e0 (\u00cc\u00ea\u00c9\u00bf \u0097\u00c8\u00c9\u00ea\u00be\u00e0 \u00cc\u00e2\u00ef\u00c6\u00e5\u00e0\u00aa\u00ef\u00be\u00e5\u00c9\u00be) \u00c6\u00ea\u00be\u00e5\u00be\u00f8, \u00cc\u00e8\u00bc\u00e0\u00bc \u00ef\u00cd\u00e5\u00e0 \u00ef\u00cd\u00e5\u00e0\u0095\u00ef\u00c6\u00e5\u00e0\u00c0\u00ba\u00f8\u00a8 \u00cc\u00e2\u00ef\u00c6\u00e5\u00e0\u00aa\u00cc\u00cd \u00a6\u00c9\u00e6\u00be\u00f8 \u00cc\u00e2\u00ef\u00c6\u00e5\u00e0\u00aa \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c4\u00ea\u00f7\u00c9\u00f1 ;\n\n(iv)\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c4\u00e5\u00cc 12\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00c0\u00f2\u00ba\u00f8\u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00aa\u00eb\u00c9\u00be\u00e0 \u00c6\u00e5\u00be\u00e5,\u00ef\u00cd\u00c8\u00e8\u00ef\u00a8\u00e5\u00c0\u00e0\u00b4\u00da, \u00c4\u00ea\u00ba\u00eb, \u00bc\u00fa\u00c6\u00c4\u00be\u00e0\u00ba\u00f8, \u00cc\u00e0\u00c9\u00c3\u00e5\u0097\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00ee\u00ba\u00f2\u00e8\u00c4\u00c4\u00e6\u00b8\u00e8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e5\u00c8 \u00c4\u00e6\u00b8\u00e8\u00a8\u00e0, \u00bc\u00fa\u00c6\u00c4\u00be\u00e0\u00ba\u00f8 \u00a8\u00eb\u00b6\u00ea, \u00a1\u00aa\u00be\u00e5 \u00ef\u00c8\u00e5\u00e0\u00cd,\u00a1\u00aa\u00be\u00e5 \u00ef\u00c8\u00e5\u00e0\u00cd \u00a1\u00e5\u00ef\u00c8\u00e0\u00c0\u00e8\u00ba \u00ef\u00c8\u00e5\u00e0\u00cd, \u00c7\u00be\u00e0\u00a8\u00e5\u00cc\u00e8, \u00cc\u00cd \u00c6\u008a\u00c0\u00e8\u00d6\u00c6\u00ba, \u00c6\u00be\u00e0\u00ba\u00f2 \u00cc\u00ec\u00ba\u00f2 \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u00a8\u00c7\u00b8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00bc\u00da\u00ca\u00be\u00c3\u00e5\u00b8\u00e0\u00b6 \u00ef\u00c8\u00cc \u00cc\u00cd \u00c6\u008a \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00e8\u00a8 \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00ef\u00c6\u00e5\u00bc\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00b4 \u00aa\u00be\u00e0\u00be\u00e5 \u00c3\u00e5\u00b8\u00e0\u00b6\u00ba\u00e5\u00c9\u00a8\u00e5\u00c8\u00e8\u00a8\u00c9 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(v)\u00ef\u00c0\u00e5\u00ba\u00e0\u00c0\u00ba\u00e0 (\u00ef\u00ae\u00a8\u00e0\u00ef\u00c0\u00e5\u00ba\u00e0, \u00c9\u00e5\u00c7 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be, \u00cc\u00ad\u00c7\u00e5,\u00c0\u00ea\u00c9\u00ba\u00e0\u00c0\u00ba\u00e0, \u00bc\u00fa\u00be\u00ef\u00c0\u00e5\u00ba\u00e0, \u00ef\u00c8\u00b0\u00da \u00ef\u00c0\u00e5\u00ba\u00e0 \u00cc\u00cd \u00a1\u00c3\u00f1\u00e5\u00cc \u00ef\u00c0\u00e5\u00ba\u00e0\u00cd\u00e6\u00c7) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ce\u00e5\u00ba\u00e0 \u00cc\u00c3\u00e5\u00c9\u00c8\u00c0\u00e5\u0097\u0083\u008e \u00ef\u00be\u00e5\u00a8\u00ce \u00ba\u00e6\u00c0\u00e6\u00c8\u00e0 \u00c4\u00ea\u00bc\u00e0\u00bc\u00c7 \u00cd\u00e5 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c4\u00ea\u00bc\u00e0\u00bc\u00c7 ;\n\n(vi)\u00ef\u00c2\u00e5\u00c7 \u00a9\u00be\u00f8\u00b0 \u00ef\u00ba\u00c8\u00e0, \u00c3\u00ed\u0095\u00ef\u00ba\u00c8\u00e0, \u00aa\u00eb\u00c9\u00be\u00e0 \u00c6\u00e5\u00be\u00e5 \u00a2\u00be\u00e0\u00bd\u00be\u00cc\u00cd \u00be\u00e6\u008c \u00cc\u00bf\u00cd\u00e5 \u00ef\u00ba\u00c8\u00e0 ;"
