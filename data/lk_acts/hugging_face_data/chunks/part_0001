    "chunk_text": "3. \u00b1\u00ce\u00b9\u008a\u0081 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00cc\u00bc\u00c7\u00dd\u00c1\u00c7\u00c6 \u00b1\u00b8\u00c7\u00b6\u00c8\u00b9\u00b6\u00c8\u00af\u00c6\u00d0\u00db\u00af\u00c1\u00c7\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5 \u00a9\u00e1\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u0088\u00b6\u00b6\u00c6\u00b6\u00c8\u0081\u00f2\u00be\u00ba\u00c6 \u00b6\u00ba\u00d7 \u00b9\u00b6\u008c\u00ce\u00bb\u00b6\u00c6 \u00d7\u00bd\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00a9\u0081\u00b9\u00d7\u00b4\u0081 ; \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00b6\u008c\u00d7\u00bd\u00b6\u00c6\u00b6\u00be\u00c7\u00b8\u00d7 \u00a3\u00af\u00c6\u00af\u0088\u00b6\u00ba\u00c6 \u00b1\u00b8\u00c7\u00b6\u00c8\u00b9\u00b6\u00c8\u00bb\u00c7\u00be\u00c6\u00a9\u00e1\u00b6\u00c6\u00b6\u00be\u00c6 \u00aa\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u0081\u00ba\u00c9\u00d7 \u00b9\u00bb\u00d9\u00de\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(\u0089\u00c7\u00c8\u00e2 3(3)]\n\n1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 54 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00bc\u00b5\u008c\u00dd\u00cd\u00b1\u00c1\u00c7 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c613\n\n5\u00b0 \u00b1\u00ce\u00b9\u008a\u0081 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00cc\u00bc\u00c7\u00dd\u00c1\u00c7\u00c6 \u00d2\u00af\u0094\u00b8\u00ba\u00c6, \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u008b\u0081\u00ce\u00ba \u00af\u00c7\u00bc\u00b5\u00ba\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00af\u00c7\u00bc\u00b5\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00c1\u00bc\u00d7 \u00b9\u00b6\u008c\u00af\u00c6\u00d0\u00c7\u00c8\u00bb\u00af\u00b4\u00ce\u00ba\u00af\u00ce\u00bf\u00b6\u00c6 \u00b6\u00bd\u00c6\u00af\u00c7\u008b\u00af\u00ba\u00c7\u00af \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00bd \u00a5\u00bb\u00be\u00c7\u00b6\u00c1\u00bc\u00c7\u00af \u00a5\u00dd\u00b9\u00c6\u0089\u0081 \u00a3\u00c1\u00bc\u00d7\u00a5\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00cc\u00b1\u00bb\u00be\u00c7\u00bd\u00c6\u00de\u00c1\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00b1\u00b8\u00c7\u00b6\u00c8\u00b9\u00b6\u00c8\u00cd\u00c1\u00de \u00a4\u00ce\u00bf \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n6\u00b0 \u00b1\u00b8\u00c7\u00b6\u00c8\u00b9\u00b6\u00c8\u00bb\u00c7\u00b8\u00c1\u00c7\u00c6\u00b6\u008c\u00b1\u00c7\u00bf\u00c7\u00c6, \u00a7\u00b9\u2013\u00b6\u008c\u00b1\u00c7\u00bf\u00c7\u00c6 \u00b9\u00b6\u008c\u00af\u00bf\u00c8\u008b\u00f4\u00b7\u00c6\u00d7\u00db\u00ce\u00bd\u00cd\u00bb \u00b6\u008c\u00b1\u00c7\u00bf\u00ce\u00bc\u00dc\u00ba\u00c6 \u00a7\u00b9\u2013\u00b6\u008c\u00b1\u00c7\u00bf\u00ce\u00bc\u00dc\u00ba\u00c6 \u00a9\u00b7\u00c6\u00cd\u00b7\u00bc\u00b6\u00c6\u00b6\u00c8\u00df\u00ba\u00c6\u00a9\u00d5\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00af\u00c7\u00bc\u00b5+\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u00b9\u00b6\u008c\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00af\u00bd\u00c6\u00bd\u00be\u00c7\u00ba\u00c6 \u00b0\n\n7\u00b0 \u00b6\u008c\u00b1\u00c7\u00bf\u00dd\u00ba\u00c6 \u00a7\u00b9\u2013\u00b6\u008c\u00b1\u00c7\u00bf\u00dd\u00ba\u00c6 \u00b1\u00b8\u00c7\u00b6\u00c8\u00b9\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u00af\u00c1\u00c7\u00c8\u008a\u00b4\u00c6\u00d5 \u00a3\u00d7\u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u00b9\u00c7\u00af \u00a9\u00e1\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00af\u0088\u00b6\u00b6\u00c6\u00b6\u00c8\u0081\u00f2\u00be\u00ba\u00c6 \u00a9\u00b7\u00c6\u00cd\u00b7\u00bc\u00b6\u00c6\u00b6\u00c8\u00df\u00ba\u00c6 \u00db\u00ce\u00bd\u00cd\u00bb \u00b6\u008c\u00b1\u00c7\u00bf\u00c7\u00c6,\u00a7\u00b9\u2013\u00b6\u008c\u00b1\u00c7\u00bf\u00c7\u00c6 \u00b9\u00b6\u008c\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u008c\u00be\u00af\u00be\u00c7\u00ba\u00c6 ; \u00a3\u00b6\u00b6\u00ce\u00af\u00bb \u00b9\u00b6\u008c\u00d7\u00bd\u00b6\u00c6\u00b6\u00be\u00c6\u00b1\u00b8\u00c7\u00b6\u00c8\u00b9\u00b6\u00c8\u00bb\u00c7\u00be\u00c6 \u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00aa\u00bd\u00c6\u00de\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00b9\u00c6\u00d5\u00c1\u00b6\u0081\u00cd\u00ba\u00be\u00c6 \u00b9\u00bb\u00d9\u00de\u00b6\u00df\u00ba\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n8. \u00b6\u008c\u00b1\u00c7\u00bf\u00c7\u00c8\u00b8\u00dd\u00ba\u00c6 \u00a7\u00b9\u2013\u00b6\u008c\u00b1\u00c7\u00b8\u00dd\u00ba\u00c6 \u00b9\u00b6\u008c\u00af\u00c6\u00af\u00c7\u00be\u00ba\u00c7\u00b8\u00d7 6 \u00a4\u00ba\u00c6\u00b0 7 \u00a4\u00ba\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00ce\u00ba\u00bb \u00b1\u00ce\u00b9\u008a\u0081 \u00db\u00ce\u00bd\u00cd\u00bb \u00a3\u00c1\u00c7\u00c6\u00af\u00bf\u00c8\u0081\u00a7\u00de\u00b9\u00c6\u00b9\u00c7\u00ae\u00ce\u00ba\u00af\u00c6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00bb\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n9. \u00b1\u00ce\u00b9\u008a\u00b8\u00d7 \u00a9\u00be\u00c6\u00be\u00c7 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6\u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00dd\u00af\u00c6\u00d0 \u00b7\u00c8\u00b6\u00c8 \u00a9\u00d9\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00b8 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00c7\u00c8\u0081\u00a4\u00cd\u00be\u00c7\u00b1\u00ce\u00bf\u008a\u0081\u00ba\u00c9\u00d7 \u00b1\u00b8\u00c7\u00b6\u00c8\u00b9\u00b6\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00b6\u00c9\u00c7\u00c6\u00ba\u00c7\u00b8\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00b6\u00c7\u00b8\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a8\u00b6\u00c8\u00bb\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n10. \u00b1\u00ce\u00b9\u008a\u0081 \u00b6\u008c\u00b1\u00c7\u00bf\u00c7\u00c6 \u00b1\u00db\u00af\u00ba\u00bf\u00c8\u00b6\u00c6\u00b6\u00c8\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u00c6 \u00b1\u00ce\u00b9\u008a\u0081 \u00a9\u00be\u00be\u00c7\u00af\u00c6\u00e7\u00b4\u00c6\u00b4+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00b6\u00c7+\u00c6\u00d0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00b6\u008c\u00b1\u00c7\u00bf\u00c7\u00c6 \u00b1\u00db\u00af\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00c7\u00b6\u008c\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6, \u00a7\u00b9\u2013\u00b6\u008c\u00b1\u00c7\u00bf\u00c7\u00c6 \u00e7\u00b4\u00c6\u00b4+\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00b6\u00ce\u00be\u00ce\u00ba\u00b6\u00c7+\u00c6\u00d0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00e7\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u00b6\u008c\u00b1\u00c7\u00bf\u00c7\u00c6 \u00a7\u00b9\u2013\u00b6\u008c\u00b1\u00c7\u00bf\u00c7\u00c6 \u00a4\u00af\u00c8\u00bb \u00a5\u00dd\u00c1\u00dd\u00ba\u00c6\u00b1\u00db\u00af\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00c7\u00b6\u008c\u00b4\u00b6\u00c6\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00e7\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00db\u00af\u00ba\u00bf\u00c8\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00bf\u00c6, \u00a3\u00c1\u00c7\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00ac\u00dd\u00c1\u00ce\u00bc \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00e7\u00b4\u00c6\u00b4\u00b6\u00c6\u00ce\u00b6 \u00b6\u00ce\u00be\u00ce\u00ba\u00b6\u00c7+\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00d0\u00b6\u00c6\u00cd\u00b6\u00c7\u00c6\u00b7\u00c6\u00cc\u00b6\u00d5\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n11. \u00b1\u00ce\u00b9\u008a\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00e7\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00e7\u00b4\u00c6\u00b4\u00b7\u00b4\u00b9\u00c6\u00cc\u00b9\u00ae \u00a9\u00e1 \u00a4\u00af \u00a5\u00dd\u00b6\u00c6\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n12. \u00b1\u00ce\u00b9\u008a\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00e7\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00b6\u00c7+\u00c6\u00d0\u00ba\u00c6 \u00a4\u00bf\u00c6 \u00a3\u00c1\u00dd\u00ce\u00b4\u00bb\u00c1\u00c7\u00af\u00c6\u00d0\u00af\u00c6\u00d0 \u00cd\u00ba\u00be\u00b6\u00c8\u00af\u00ba\u00c7\u00af \u00a3\u00de\u00b6\u00c8\u008a\u00d5\u00ba\u00c6 \u00c1\u00c7\u00af\u00c6\u00cc\u00af\u00c7\u0081\u00ce\u00bd\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n13. \u00b1\u00ce\u00b9\u00bb\u00c7\u00b8\u00d7, 10, 11 \u00a3\u00b6\u00b6\u00b4\u0081 12 \u00a4\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00a3\u00ce\u00ba\u00bb \u00a3\u00b6\u00b8\u00d7 \u00e7\u00b4\u00c6\u00b4+\u00c6\u00af\u0081 \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u00b9\u00c7\u00b8 \u00a3\u00b6\u0081 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af \u00db\u00ce\u00bd\u00ce\u00bb\u00dc\u00ba\u00c6\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00e7\u00b4\u00c6\u00b4+\u00c6\u00af\u00bf\u00c8\u0081 \u00cd\u00b9\u00c7\u00b6\u00c7\u00b8 \u00a3\u00df\u00c1\u00be\u00c6\u00af\u00bf\u00c8\u0081 \u00ce\u00af\u00bb\u00c7\u00e0\u00ce\u00af\u00ce\u00bb\u00dc\u00ba\u00c6\u00ac\u00e1+\u00c6\u00d0\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c7\u00ba\u00c6\u00b0\n\n141999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 54 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00bc\u00b5\u008c\u00dd\u00cd\u00b1\u00c1\u00c7 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6"
  },
