    "chunk_text": "(3)\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00c9\u00c0\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b1\u00ce\u00b9\u008a\u0081 \u00b9\u00b5\u00c8\u00b9\u00c6\u0089\u0081 \u00ba\u00c9\u00d7,(1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b1\u00bb\u00be\u00c6 \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u0089\u00be\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00db\u0081 \u00a3\u00c1\u00dd\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5 \u00c1\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00c0\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c0\u00af\u00c6\u00d0\u00b6\u00c6 \u00cc\u00b6\u00c7\u00d5\u00b9\u00c6\u0089\u00be\u00c6 \u00a7\u00bd\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00cc\u00b1\u00be\u00e2 \u00a9\u00d7\u00e2\u00ba\u00c6, \u00a3\u00b1\u00c6\u00cc\u00b1\u00bb\u00be\u00c6 \u00b7\u00be\u00c6\u00cc\u00be\u00ae\u00b5\u00b6\u00c6\u00d7\u00b4\u0081\n\n131999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 38 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u008c\u00ab\u00bb \u00d0\u00ba\u00c7\u00bc\u00d7+\u00c6\u00af\u00b3\u00c7\u00b9\u00af\u00c7\u00c7\u00c6\u00b6\u00c6\u00b6 \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00bb\u00b1\u00c7\u00ce\u00be\u00b1\u00c6 \u00b1\u00ce\u00b9 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cc\u00b6\u00b8 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6 \u00af\u00dd\u00b6\u00c8\u00b8\u00c7\u00be\u00c6, \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00c0\u00af\u00c6\u00d0\u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c0\u00af\u00c6\u00d0\u00b6\u00c6 \u00cc\u00b6\u00c7\u00d5\u00b9\u00c6\u0089\u00be\u00c6 \u00a3\u00c1\u00c7\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cc\u00b1\u00be\u00e2 \u00a3\u00bd\u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c7\u00cc\u00be\u00c7\u00c0\u00c8\u00bb \u00b1\u00ce\u00b9\u008a\u0081 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n18\u00b0\u00b1\u00ce\u00b9\u008a\u0081 \u00a9\u00be\u00c6\u00be\u00c7 \u00a3\u00df\u00c1\u00be\u00c7\u00c6\u00af\u00e0\u00ba\u00c6 \u00cd\u00b1\u00ce\u00c1\u00bb\u00c7\u00bf\u00c7\u00c6\u00af\u00e0\u00ba\u00c6\u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u008a\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6 \u00a3\u00b6\u0081\u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00bf\u00c6\u00e0\u00ba\u00c6 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00cd\u00b1\u00ce\u00c1\u00bb\u00c7\u00bf\u00c7\u00c6\u00af\u00bf\u00c7\u00af \u00a5\u00dd\u00b6\u00c6\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u00b8\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n19\u00b0\u00b1\u00ce\u00b9\u00bb\u00c7\u00b8\u00d7 \u00a5\u00be\u00b3\u00c6\u00b1\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00bf\u00c6\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b7\u00c8\u00de\u00c1\u00b8\u00cc\u00ba\u00c7\u0081\u00bd\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00a3\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00a3\u00b6\u00bd\u00c6\u00af\u00c8\u00b5+\u00c6\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n20\u00b0\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00af\u00c6\u00d0\u00ba\u00c6, \u00b6\u00ba\u00c8\u00c0\u00c6 \u00a7\u00ce\u00bc\u00af\u00c6\u00d0\u00ba\u00c6\u00a5\u00ce\u00b4\u00cd\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf\u00a7\u00ce\u00bc\u00cd\u00bb \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8 \u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n21\u00b0\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00b7\u00c6\u00b6\u00c7\u00c6\u00b9\u00c6\u00b9\u00ba\u00c6 \u00cd\u00c1\u00de \u00c1\u00ce\u00af\u00bb\u00c7\u00af\u00b6\u00c6\u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u0081\u00bd\u00c8, \u201c\u008c\u00ab\u00bb \u00d0\u00ba\u00c7\u00bc\u00d7+\u00c6\u00af \u00b3\u00c7\u00b9\u00af\u00c7\u00c7\u00c6\u00b6\u00c6\u00b6\u00ba\u0081\u00bd\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00d7, 1998 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 31 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u008c\u00ab\u00bb\u00d0\u00ba\u00c7\u00bc\u00d7+\u00c6\u00af \u00b3\u00c7\u00b9\u00af\u00c7\u00c7\u00c6\u00b6\u00c6\u00b6 \u00ba\u0081\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u008c\u00b2\u00bb\u00d0\u00ba\u00c7\u00bc\u00d7+\u00c6\u00af \u00b3\u00c7\u00b9\u00af\u00c7\u00c7\u00c6\u00b6\u00c6\u00b6 \u00ba\u0081\u00bd\u00ba\u00c6 \u00a9\u00b8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6\u00b0\n\n\u00b1\u00ce\u00b9\u008a\u0081\u00a3\u00df\u00c1\u00be\u00c7\u00c6\u00af\u00bf\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00cd\u00b1\u00ce\u00c1\u00bb\u00c7\u00bf\u00c7\u00c6\u00af\u00bf\u00c6\u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u008a\u0081 \u00af\u00c9\u00c0\u00c6 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af\u00cd\u00b1\u00ce\u00c1\u00bb\u00c7\u00bf\u00c7\u00c6\u00af\u00bf\u00c7\u00af\u00af\u00c6\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00b0\u00c6\n\n\u00a5\u00be\u00b3\u00c6\u00b1\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00bf\u00c6\u00b1\u00ce\u00b9\u00bb\u00c7\u00b8\u00d7\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b7\u00c8\u00de\u00c1\u00b8\u00cc\u00ba\u00c7\u0081\u00bd\u00c7\u00af\u00af\u00c6\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba\u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6\u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf\u00a7\u00ce\u00bc \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u00cd\u00af\u00c7\u00b4\u00be\u00c6\u00b0\n\n141999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 38 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u008c\u00ab\u00bb \u00d0\u00ba\u00c7\u00bc\u00d7+\u00c6\u00af\u00b3\u00c7\u00b9\u00af\u00c7\u00c7\u00c6\u00b6\u00c6\u00b6 \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00bb\u00b1\u00c7\u00ce\u00be\u00b1\u00c6 \u00b1\u00ce\u00b9 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 (\u00b9\u00c8\u00c7\u00c8\u00e2 2,7,9)"
