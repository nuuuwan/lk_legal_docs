\u00c0+\u00c6\u00af\u00be\u00c6\u00b0\u201d\u00b0\n\n14\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00ce\u00bb\u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00af\u00bf\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00b8 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00a3\u00ce\u00c1 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u00b7\u00c7\u00be\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00af\u00bf\u00c7\u00af\u00b9\u00c6 \u00b9\u00bb\u00d9\u00de\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u201c\u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5(\u0089\u00bc\u00c8\u00e2 2)\n\n(1) \u0089\u0081\u00c1\u00dd\u00c1\u00b8\u00c1\u00bd\u00c6\u00bd\u00c8\u00be\u00c6 \u00c1\u00c0+\u00c6\u00af\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8\n\n(i) \u00b1\u00c9\u00b8\u00c8(ii) \u00b9\u00dd\u00b9\u00c6\u00da(iii) \u00a7\u00dd\u00ce\u00bf\u00af\u00c6\u00af\u00c8\u00c0+\u00c6\u00d0(iv) \u00cc\u00c1+\u00c6\u00af\u00c7\u00bb\u00ba\u00c6(v) \u00af\u00dd\u00c1\u00c7\u00d5(vi) \u00d0\u00c0\u00b7\u00c6\u00ce\u00b6\u00b9\u00c6 \u00b9\u00c7\u00be\u00c6\u00ba\u00c7 \u00b6\u008c\u00bc\u00c6\u00b7\u00c6\u00b6 \u00aa\u00ce\u00b8\u00bb \u00b9\u00c7\u00be\u00c6\u00ba\u00c7(vii) \u00ba\u00c8\u00bf\u00af\u00c7\u00bb\u00c6\n\n(2) \u00a5\u00c1\u00c6\u00c1\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 (i) \u00a4\u00ba\u00c6 (ii) \u00a4\u00ba\u00c6 \u008c\u00b4\u00bb+\u00c6\u00af\u00bf\u00c