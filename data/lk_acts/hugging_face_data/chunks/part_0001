    "chunk_text": "\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e023 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e025 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e036 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e038 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n212005 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(2) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e7\u00c4\u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fb \u00c9\u00e5\u00b8\u00e8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c4 \u00a6\u00cd\u00fa \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00da\u00cb\u00c6\u00c0\u00e8\u00c6\u00c9\u00e5 \u00c4\u00e5\u00cc \u00c0\u00cd\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a6\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00a1\u00a8\u00e0\u00ef\u00c9\u00c7\u00ce \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00a6\u00c6 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9 \u00ba\u00eb\u00ce \u00a8\u00c7\u00ef\u00aa\u00be\u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a6\u00cd\u00fa \u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00da\u00cb\u00c6 \u00a1\u00c9\u00cc\u00e5\u00be\u00c6\u00b4 \u00c9\u00ec \u00ef\u00ca\u00e0\u00cb \u00c0\u00ba\u00f2\u00c6 \u00cc\u00cd \u00a6\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00da\u00cb\u00c6\u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00a6\u00cd\u00fa \u00c8\u00e5\u00c3 \u00a1\u00c8\u00e5\u00c3 \u00aa\u00fa\u00b8\u00ea\u00c4 \u00c2\u00e6\u00e2\u00a8\u00eb \u00a1\u009e\u00a8\u00e0\u00cb\u00b8\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00c6\u00e6\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00c4 \u00ef\u00ca\u00e0\u00cb \u00c0\u00ba\u00f2\u00c6\u00cc\u00cd \u00a6\u00cd\u00fa \u00c8\u00e5\u00c3 \u00a1\u00c8\u00e5\u00c3 \u00aa\u00fa\u00b8\u00ea\u00c4, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00cd\u00fa \u00ef\u00c2\u00bc\u00e5 \u00cd\u00d6\u00be\u00ea\u00c8\u00c2\u00be \u00cc\u00e8\u00e2\u00cd\u00c8, \u00ef\u00bc\u00c4\u00ce \u00cc\u00cd \u00a2\u00e2\u00aa\u00f2\u00e9\u00cc\u00e8 \u00bc\u00fa\u00be\u00c0\u00ba\u00e5 \u00c0\u00ea\u00c9\u00ba\u00e0\u00c0\u00ba\u00a8\u00c6\u00b4\u00ba\u00e0 \u00c0\u00e8\u00d6\u00ef\u00cc\u00c6\u00fa\u00be\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00c7\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c0\u00ce \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00ba\u00c9 \u00bc, \u00a6\u00ce\u00ef\u00c5\u00be \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00ef\u00bc\u00e0 \u00ef\u00ca\u00e0\u00cb \u00c0\u00ba\u00f2\u00c6\u00cc\u00cd \u00c8\u00e5\u00c3 \u00a1\u00c8\u00e5\u00c3 \u00aa\u00fa\u00b8\u00ea\u00c4 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00ef\u00a8\u00e5\u00b4 \u00c0\u00f2\u00bc\u00da\u00ca\u00be\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00ef\u00ba\u00a8\u00e0 \u00a2\u00cd\u00ba \u00a8\u00f9 \u00ef\u00ca\u00e0\u00cb \u00c0\u00ba\u00f2\u00c6 \u00cc\u00cd \u00c8\u00e5\u00c3 \u00a1\u00c8\u00e5\u00c3 \u00aa\u00fa\u00b8\u00ea\u00c4\u00a6\u00cd\u00fa \u00c9\u00f1\u00e5\u00c0\u00e5\u00d6\u00a8 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7\u00be \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00cc\u00e0\u00bb\u00e5\u00be\u00ef\u00c6\u00e0 \u00c0\u00f2\u00a8\u00b4\u00c9\u00ef\u00c0\u00ef\u00be\u00be \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8 \u00c0\u00f2\u00bc\u00da\u00ca\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0, \u00c6\u008a \u00ef\u00cd\u00ce\u00e8\u00a8\u00f8\u00d7\u008a\u00c9\u00c8\u00b4\u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00cd\u00fa \u00cc\u00bf\u00cd\u00be\u00e0\u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00ca\u00e0\u00cb \u00c0\u00ba\u00f2 \u00cc\u00cd \u00c8\u00e5\u00c3 \u00a1\u00c8\u00e5\u00c3 \u00aa\u00fa\u00b8\u00ea\u00ef\u00c4\u00cd\u00fa \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8\u00c6\u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7, \u00a6\u00ef\u00cc\u00e0 \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8\u00c6\n\n\u201c \u00ef\u00ca\u00e0\u00cb \u00c0\u00ba\u00f2\u00c6\u00cc\u00cd \u00c8\u00e5\u00c3 \u00a1\u00c8\u00e5\u00c3\u00aa\u00fa\u00b8\u00ea\u00c4\u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00b4\u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4.\n\n222005 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n\u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00cc\u00e7\u00c4\u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fb \u00c9\u00e5\u00b8\u00e8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8 \u00c4 \u00ef\u00ca\u00e0\u00cb \u00c0\u00ba\u00f2\u00c6 \u00cc\u00cd \u00c8\u00e5\u00c3\u00a1\u00c8\u00e5\u00c3 \u00aa\u00fa\u00b8\u00ea\u00c4, \u00a6\u00ef\u00cc\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00a1\u00e5\u00a8\u00ee\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) \u00cc\u00e7\u00c4 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fb \u00c9\u00e5\u00b8\u00e8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c4 \u00cc\u00e8\u00c6\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00da\u00cb\u00c6 \u00c0\u00e8\u00c6\u00c9\u00e5 \u00c4\u00e5\u00cc \u00cd\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba, \u00a6\u00cd\u00fa \u00a6\u00ce\u00ef\u00c5\u00be\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00ef\u00ca\u00e0\u00cb \u00c0\u00ba\u00f2\u00c6 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00ef\u00a8\u00e5\u00b4\u00c0\u00f2\u00bc\u00da\u00ca\u00be\u00c6 \u00a8\u00c7\u00be \u00ef\u00ba\u00a8\u00e0 \u00a6\u00e0 \u00c9\u00e5\u00b8\u00e8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00cc\u00cd \u00a6\u00cd\u00fa\u00c0\u00e5\u00c8\u00e8\u00ba \u00cc\u008a\u00aa\u008a\u00c9\u00c8 \u00cc\u00cd \u00a6\u00cd\u00fa \u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00cc\u00c4\u00e5\u00aa\u008a\u00c9\u00c8 \u00bc\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8 \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u0095\u00be\u00e0 \u00a6\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00da\u00cb\u00c6\u00a1\u00c9\u00cc\u00e5\u00be\u00c6 \u00ef\u00ba\u00a8\u00e0 \u00c9\u00ec \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00ef\u00ca\u00e0\u00cb \u00c0\u00ba\u00f2\u00c6 \u00a6\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c\u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00d6\u00a8 \u00cc\u00e0\u00bb\u00e5\u00be\u00ef\u00c6\u00cd\u00fa \u00c0\u00f2\u00a8\u00b4\u00c9 \u00ef\u00c0\u00ef\u00be\u00be\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8 \u00c0\u00f2\u00bc\u00da\u00ca\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
