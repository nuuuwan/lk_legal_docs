    "chunk_text": "(v)\u00ef\u00c0\u00e5\u00ba\u00e0\u00c0\u00ba\u00e0 (\u00ef\u00ae\u00a8\u00e0\u00ef\u00c0\u00e5\u00ba\u00e0, \u00c9\u00e5\u00c7 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be, \u00cc\u00ad\u00c7\u00e5,\u00c0\u00ea\u00c9\u00ba\u00e0\u00c0\u00ba\u00e0, \u00bc\u00fa\u00be\u00ef\u00c0\u00e5\u00ba\u00e0, \u00ef\u00c8\u00b0\u00da \u00ef\u00c0\u00e5\u00ba\u00e0 \u00cc\u00cd \u00a1\u00c3\u00f1\u00e5\u00cc \u00ef\u00c0\u00e5\u00ba\u00e0\u00cd\u00e6\u00c7) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ce\u00e5\u00ba\u00e0 \u00cc\u00c3\u00e5\u00c9\u00c8\u00c0\u00e5\u0097\u0083\u008e \u00ef\u00be\u00e5\u00a8\u00ce \u00ba\u00e6\u00c0\u00e6\u00c8\u00e0 \u00c4\u00ea\u00bc\u00e0\u00bc\u00c7 \u00cd\u00e5 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c4\u00ea\u00bc\u00e0\u00bc\u00c7 ;\n\n(vi)\u00ef\u00c2\u00e5\u00c7 \u00a9\u00be\u00f8\u00b0 \u00ef\u00ba\u00c8\u00e0, \u00c3\u00ed\u0095\u00ef\u00ba\u00c8\u00e0, \u00aa\u00eb\u00c9\u00be\u00e0 \u00c6\u00e5\u00be\u00e5 \u00a2\u00be\u00e0\u00bd\u00be\u00cc\u00cd \u00be\u00e6\u008c \u00cc\u00bf\u00cd\u00e5 \u00ef\u00ba\u00c8\u00e0 ;\n\n(viii) \u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8 \u00b4\u00f2\u00e6\u00a8\u00e0\u00b4\u00da ;\n\n(ix) \u00ef\u00cc\u00c8\u00e8\u00c6\u00ea\u00c8\u00da \u00b0\u00e2\u00aa\u00c4 \u00f3\u00c7\u00a8\u00bb\u00be ;\n\n(x)\u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8 \u00c6\u00be\u00e0\u00ef\u00ba\u00f2\u00e5\u00e0\u00c0\u00a8\u00c7\u00b8 \u00cd\u00e5 \u00ef\u00c0\u00e5\u00ef\u00cd\u00e5\u00c7(2004.07.01 \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00ef\u008c)\u00cc\u00e6\u00c0\u00c6\u00ea\u00c4 \u00cc\u00cd \u00a1\u00e5\u00be\u00c6\u00be\u00c6.\n\n(\u00a1\u00e5) (i)\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u00c9\u00be\u00e0, \u00c0\u00ce\u00e5\u00ba\u00e0 \u00cc\u00c3\u00e5\u00c9\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be\u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00f8\u00be\u00e0 \u00c0\u00ea\u00cc\u00e0\u00ba\u00a8\u00e5\u00c8 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00c0\u00c6\u00be\u00ea \u00c8\u00c2\u00be,\u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00cd\u00e5 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c\u0097\u00cb\u00c6 \u00c4\u00e5\u00c8\u00e5\u00c9 \u00a1\u00be\u00ea\u00aa\u00c4\u00be\u00c6 \u00a8\u00c7\u00be \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00e5\u00cc\u00c8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00b0\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00c8\u00c2\u00be \u00c0\u00e5\u00cc\u00c8\u00e0\u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4. (2004.07.01 \u00bc\u00fa\u00be \u00cc\u00e8\u00b4\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00ef\u008c) ;\n\n2004 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba20\n\n(ii)\u00ef\u00c0\u00e5\u00f3 \u00c4\u00aa\u00fb \u00c0\u00f2\u00c9\u00e5\u00cd\u00be \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 (\u00aa\u00eb\u00c9\u00be\u00e0 \u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00c6,\u00b0\u00c8\u00c6 \u00c4\u00aa\u00e8\u00be\u00e0 \u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00c6, \u00cc\u00e2\u00ae\u00e5\u00c7\u00a8\u00c6\u00fa\u00be\u00e0 \u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00c6,\u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00aa\u00c4\u00be\u00e0 \u00cc\u00cd \u00a8\u00eb\u00c8\u00e9 \u00c7\u00bb \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cd\u00e6\u00c7) \u00ef\u00cd\u00e5\u00e0 2004\u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00a6\u00c9\u00e6\u00be\u00f8 \u00a8\u00c8\u00e0\u00c2\u00f3\u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4 \u00a6\u00ce\u00c5 \u00a1\u00e6\u00ba\u00e0\u00be\u008a \u00c4\u00aa\u00e9 \u00a1\u00e5\u00cc\u00be 28 \u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea\u00a1\u00e5\u00cc\u00be \u00bd\u00e5\u00d6\u00ba\u00e5\u00c9\u00a8\u00e0 \u00cc\u00cd\u00fa\u00ba \u00ef\u00c0\u00e5\u00f3 \u00c4\u00aa\u00fb \u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5\u00ef\u00c6\u00e5\u00bc\u00e5 \u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00ef\u00a8\u00e5\u00e0\u0083 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00c8\u00e0\u00c2\u00f3\u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 ;\n\n(iii) (205 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u0097\u00f3\u00c8\u00e8\u00c2\u00c8 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0\u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00c6 \u00a8\u00c7 \u00ba\u00f8\u00ef\u00c2\u00be \u00c0\u00d6\u00bc\u00fa \u00a6\u00a8\u00e0 \u00c0\u00e5\u00d6\u00ef\u00c3\u00e5\u00e0\u00aa\u00fa\u00a8\u00c6\u00a8\u00eb\u00b4\u00c4\u00cc\u00a8\u00b4 \u00a8\u00f8\u00ef\u00c8\u00e5\u00e0 \u00ef\u00c9\u00e5\u00e0 \u00c0\u00e6. 40\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u0097\u00f3\u00c8\u00e8\u00c2\u00c8 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 ;\n\n(iv)\u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00be\u00e0\u00cc\u00bf\u00cd\u00e5 \u00ef\u00be\u00e5\u0095\u00ef\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00cd\u00be\u00e5\u00bd\u00e5\u00c7 \u00c4\u00ba \u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5\u00cc\u00e0\u00bb\u00e5\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00a1\u00e5\u00cd\u00e5\u00c7 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4, \u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00ef\u00a8\u00e5\u00e0\u0083\u00c7\u00bb\u00c6\u00a8\u00e8\u00be\u00e0 \u00c0\u00bc\u00fa\u00e2\u008e \u00cc\u00e0\u00bb\u00e5\u00be\u00c6 \u00cd\u00e5 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6 \u00a1\u00ba\u00c7\u00ef\u00be\u00e5\u0095\u00c8\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00cd\u00be\u00e5\u00bd\u00e5\u00c7 \u00c4\u00ba \u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00c6 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 ;\n\n(v)\u00c6\u008a \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c3\u00ed\u00c4\u00bc\u00e5\u00be \u00cc\u00cd\u00a1\u00e5\u00bc\u00e5\u00cd\u00be \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 ;\n\n(vi)\u00ca\u00fb\u00f2 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba\u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00bc\u00fb \u00c0\u00d6\u00ef\u00c3\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0\u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c9\u00c8\u00e8\u00be\u00e0\u00ef\u00aa\u00d1\u008a \u00c4\u00ba \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 ;\n\n(vii) \u00c2\u00b8\u00e0\u00b6\u00e5\u00c7\u00be\u00e5\u00c6\u00a8 \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00aa\u00eb\u00c9\u00be\u00e0 \u00ef\u00ba\u00e5\u00b4\u00ea\u00c0\u00ef\u00c8\u00cd\u00fa\u00a1\u00e5\u00aa\u00c4\u00be \u00a8\u00c9\u00ea\u00be\u00e0\u00b4\u00c7\u00ef\u00c6\u00be\u00e0 \u00a7\u0089\u00ef\u00c2\u00cd\u00fa \u00ef\u00c7\u00cc\u00e0\u00ef\u00b4\u00e5\u00e0\u00c7\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 ;"
