    "chunk_text": "\u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be\u00bc\u00fa\u00be\u00c6.\n\n182004 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba\n\n2003 \u00a1\u00e2\u00a8 25 \u00bc\u00c7\u00be\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 (II)\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 11\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00c9\u00be \u00bc\u00fa\u00be\u00c6.\n\n28.\u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00bc\u00e5\u00ce\u00c9\u00be \u00c6\u008a \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u0097\u00f3\u00c8\u00e8\u00cc\u00e2\u00ef\u00bc\u00e0\u00ca \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u2014\n\n(\u00a1\u00e5)2004 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 1 \u00c9\u00be \u00bc\u00fa\u00ef\u00be\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00ef\u00bc\u00c9\u00be \u00c9\u00da\u00cb\u00c6 \u00cc\u00cd\u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00bc\u00fa\u00be\u00c6 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a2\u00cd\u00ba\u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00be\u00ea\u00c9 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e6\u00ba\u00e0\u00ba \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00aa\u00c9\u00e5\u00ba\u00f8\u00ef\u00c2\u00be \u00a6\u00a8\u00e0\u00cc\u00ba\u00e0 \u00b0\u00be\u00c0\u00bc \u00ef\u00b6\u00e5\u00c8\u00da \u00ca\u00ba \u00c0\u00cd\u00a8\u00eb\u00ba\u00e0 \u00bc\u00ca\u00c4 \u00ef\u00bc\u00a8(5.2) \u00cc\u00cd \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a6\u00a8\u00e0\u00cc\u00ba\u00e0 \u00b0\u00be\u00c0\u00bc\u00ef\u00b6\u00e5\u00c8\u00da \u00ca\u00ba \u00be\u00c9\u00c6 (9) \u00a1\u00ba\u00c7 \u00ef\u00c9\u00be\u00cc \u00ef\u00aa\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0,\n\n\u00a7\u00cd\u00ea 21 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00bc\u00c9\u00be \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0,\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00be\u00ea\u00c9\u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9, \u00cc\u00e6\u00a8 \u00f3\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\nIV \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n2003 \u00a1\u00e2\u00a8 25 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba\u00b4 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\n\n29.2003 \u00a1\u00e2\u00a8 25 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 (II) \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 11 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00bc\u00e0\u00bc \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4, \u201c\u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00bc\u00e0\u00bc\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, 1968 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0\u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00ef\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00ba\u00e0 \u00c6\u008a \u00cc\u00e5\u00c4\u00e5\u00be\u00f1 \u00a1\u00ef\u00c8\u0097\u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00c4 \u00c4\u00ba, 2004 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00c0\u00b4\u00be\u00e0\u00a6\u00e0 \u00c2\u00bc\u00e0\u00bc \u00a1\u00c6\u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0, \u00a6\u00e0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n30.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be, 2004 \u00b0\u00be\u00c9\u00e5\u00d6 \u00c4\u00cc 1\u00c9\u00be \u00bc\u00fa\u00be \u00c0\u00b4\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00cc\u00e6\u00a8 \u00f3\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4.\n\n192004 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8\u00c9\u00ec \u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n\u00cc\u00e8\u00c6\u00c6\u00b4 0.25\n\n\u00cc\u00e8\u00c6\u00c6\u00b4 0.25\n\n\u00cc\u00e8\u00c6\u00c6\u00b4 0.5\n\n\u00cc\u00e8\u00c6\u00c6\u00b4 1.0\n\n31.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6(2(1) \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\n\n\u00c6\u00b4\u00ba\u00e0\u00c9\u00be \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9\u00be \u00ef\u00cc\u00e0\u00c9\u00e5\u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\n\n1. \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0\u00ef\u00a8\u00ef\u00c7\u00be \u00c6\u00c4 \u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u00c4\u00a8\u00f8\u00be\u00e0, \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0,\u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00c6\u00a8\u00f8\u00be\u00e0, \u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be\u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00ef\u008a \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00c6\u00b4\u00ba\u00e0\u00c9\u00be\u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00ef\u008a \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0.\n\n2. \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1978 \u00a1\u00e2\u00a8 4 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9\u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ef\u00ba\u00e0 17 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4 \u00a6\u00ce\u00c5 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a\u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u00c4\u00a8\u00f8\u00be\u00e0, \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0, \u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00c6\u00a8\u00f8\u00be\u00e0,\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00ef\u008a\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00c6\u00b4\u00ba\u00e0\u00c9\u00be \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00ef\u008a \u00c6\u008a\u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0."
