    "chunk_text": "(\u00a1\u00e5) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (10) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(\u00a1\u00e6) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (8) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 .\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e03 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6\n\n\u00c0\u00ec\u00da\u0097\u00a8\u00e5\u00c9\n\n21999 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00da\u00ef\u00c9\u00e5\u00e0\u00bc\u00c6 \u00ca\u00f2\u00c4\u00bc\u00e5\u00be\u00cc\u00e2\u00aa\u00c4\u00c6 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a) (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n\u201c(9) \u00db\u00a8\u00f8\u00c6\u00e5 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00cd \u00ca\u00eb\u00c3\u00cc\u00e5\u00bd\u00a8 \u00c9\u00e6\u00b6 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00c9\u00c8\u00e0,\u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8 \u00cc\u00cd \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00c7\u00a8\u008a \u00cc\u00bf\u00cd\u00e5 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00a4\u00ba\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00c7 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5 \u00ef\u00aa\u00be \u00c6\u00e5\u00ef\u008a \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9 \u00ba\u00eb\u00ce \u00cd\u00e5\u00a2\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00cd\u00e5 \u00c4\u00ea\u00c8\u00f1 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4,\u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00a6\u00e0\u00c9\u00e5\u00ef\u00c6\u00e0 \u00be\u00f8\u00c7\u00ba\u00d1\u00c4 \u00cc\u00cd \u00a6\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00e5\u00c4 ;\n\n(10) \u00cc\u00da\u00ef\u00c9\u00e5\u00e0\u00bc\u00c6 \u00bc\u00da\u00ca\u00be\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9, \u00b0\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00c9\u00c8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6\u00a1\u00e6\u00ba\u00f8 \u00a8\u00e8\u00d7\u00ef\u00c4\u00cd\u00fa \u00c8\u00e5 \u00a1\u00bd\u00f1\u00e5\u00ba\u00e0\u0095\u00a8, \u00cc\u00bc\u00e5\u00ae\u00e5\u00c7\u00e5\u00ba\u00e0\u00c4\u00a8, \u00cc\u00c4\u00e5\u00b0\u00c6\u00fb\u00c6,\u00a1\u00bd\u00f1\u00e5\u00c0\u00be\u00f8\u00a8, \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00cd\u00e5 \u00c4\u00ea\u00c8\u00f1 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc\u00be\u00f9\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba\u00e0 \u00c0\u00f2\u00b0\u00e5 \u00cc\u00e2\u0097\u00bd\u00e5\u00be \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4, \u00be\u00e2\u00c9\u00e5\u00c8\u00e9\u00c4 \u00cc\u00cd \u00a6\u00e0\u00c0\u00f2\u00b0\u00e5 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00cc\u00cd \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00e5\u00d7\u00ba\u00e0\u00c9 \u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00be\u00e0 \u00bc,\u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00bc \u00cc\u00e6\u00ce\u00cc\u00e9\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0\u00c9\u00e5\u00ef\u00c6\u00e0 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7\u00ef\u00aa\u00be\u00c6\u00e5\u00ef\u00c4\u00cd\u00fa \u00c8\u00e5 \u00a6\u00e0\u00c9\u00e5\u00b4 \u00cc\u00cd\u00e5\u00c6 \u00d1\u00c4 ;\n\n(11) \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0 \u0097\u0097\u00bd \u00c9\u00e6\u00b6\u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00c9\u00c8\u00e0 \u00cc\u00cd \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c9\u00ca\u00f1 \u00c9\u00be \u00ef\u00ef\u00be\u00ba\u00f8\u00a8 \u00a1\u00cc\u00e0\u00bb\u00fc\u00ba \u00c0\u00e8\u00cd\u00e8\u00b4\u00ea\u00d1\u00c4 \u00cc\u00cd \u00a6\u00e0\u00a1\u00cc\u00e0\u00bb\u00fc\u00ba\u00c9\u00c8 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7 \u00ef\u00aa\u00be \u00c6\u00e5\u00c4 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00d7\u00ba\u00f8\u00cc\u00e7\u00bc\u00fb\u00c4 \u00cc\u00cd \u00a1\u00c9\u00ca\u00f1 \u00c9\u00be \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00c2\u00c8\u00ba\u00c8 \u00cd\u00e5 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c2\u00c8\u00ba\u00c8 \u00a6\u00e0\u00c9\u00e5\u00b4 \u00c0\u00e6\u00c9\u00d7\u00c4 ;\n\n(12) \u00cc\u00e2\u00aa\u00c4\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00c7\u00ba\u00d1\u00c4\u00b4 \u00a1\u00bc\u00cd\u00cc\u00e0\u00a8\u00c7\u00be \u00c6\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u00a8\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5 \u00ef\u00aa\u00be \u00c6\u00be\u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00e0\u00be\u00a8 \u00ef\u00c6\u00bc\u00fb \u00cc\u00e8\u0090\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb, \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c9\u00ef\u00ce\u00bf \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00cc\u00c4\u00ad \u00c8\u00e5\u00c3 \u00ef\u00c2\u00bc\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4, \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00a6\u00a8\u00e0 \u00a8\u00f8\u00d7\u00c4, \u00cc\u00cd\u00ef\u00c6\u00e5\u00e0\u00aa\u00fb\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4, \u00cd\u00c9\u00ea\u00ef\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a1\u00ef\u00be\u00f1\u00e5\u00e0\u00be\u00f1 \u00cc\u00cd\u00be \u00cc\u00e6\u00ce\u00cc\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00c9\u00ec \u00c9\u00e6\u00b6 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00d1\u00c4 ;\n\n(13) \u00cc\u00ee\u00b0\u00ea \u00a8\u00f2\u00e8\u00c6\u00e5 \u00c4\u00aa\u00fa\u00be\u00e0 \u00bc \u00a1\u0097\u00cd\u00fa\u00e2\u00cc\u00be \u00c4\u00e6\u00bc\u00fa\u00cd\u00ba\u00e0\u00d1\u008a\u00c9\u00c8\u00b4 \u00cc\u00cd\u00c3\u00e5\u00aa\u00e8\u00d1\u00ef\u00c4\u00be\u00e0\u00cc\u00cd \u00cc\u00e5\u00c4 \u00c0\u00e5 \u00aa\u00c4\u00be\u00e0, \u00cc\u00e5\u00c4 \u00cc\u00e5\u00a8\u0083\u00af\u00e5, \u00cc\u00e5\u00c4 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00c9\u00e6\u00b6\u00cc\u00b4\u00cd\u00be\u00e0, \u00cc\u00e5\u00c4 \u00a8\u00bf\u00c9\u00ea\u00c7\u00e6 \u00c9\u00e6\u00be\u00f8 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00da\u00ef\u00c9\u00e5\u00e0\u00bc\u00c6\u00a1\u00cd\u00e8\u00e2\u00cc\u00e5\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00ba\u00e5 \u00cc\u00e5\u00c4 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8\u00b4 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00d1\u00ef\u00c4\u00be\u00e0 \u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u0097\u0097\u00bd \u00b0\u00be\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00a1\u00ba\u00c7 \u00cc\u00e5\u00c4\u00c6 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n31999 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00da\u00ef\u00c9\u00e5\u00e0\u00bc\u00c6 \u00ca\u00f2\u00c4\u00bc\u00e5\u00be\u00cc\u00e2\u00aa\u00c4\u00c6 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a) (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(14) \u00c4\u00e5\u00be\u00ea\u00cb\u00e8\u00a8 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00cd\u00e5 \u00c4\u00ec\u00c8\u00e8\u00a8 \u00be\u00f8\u00bc\u00cd\u00cc \u00c0\u00e8\u00ce\u00e8\u00c0\u00e6\u00bc\u00fb\u00c4\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u0097\u00ca\u00e0\u00c9 \u00aa\u00c7\u00e6\u00ba\u00e0\u00c9\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00bc \u00b0\u00e5\u00ba\u00f8\u00a8\u00c9\u00ec \u00cd\u00e5 \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00c9\u00ec \u00a8\u00f8\u00f2\u00c6\u00e5\u00ca\u00e9\u00c8\u00e9 \u00c0\u00e8\u00c6\u00c9\u00c7 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a6\u00e0 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a\u00cd\u00e5 \u00be\u00f8\u00bc\u00cd\u00cc \u0097\u00ca\u00e0\u00c9\u00c4\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00aa\u00e6\u00be\u00f9\u00c4 \u00cd\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c0\u00e6\u00bc\u00fb\u00c4 \u00cc\u00cd\u00ba\u00f8\u00a8\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00bc, \u00a4\u00ba\u00e0\u00cc\u00e5\u00cd \u00bc\u00e6\u00d7\u00c4 ; \u00cc\u00cd"
