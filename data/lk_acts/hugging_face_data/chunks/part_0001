    "chunk_text": "1\u00b0\u0089\u00bc\u00c8\u00e2 7 \u00a5\u00be\u00c6 \u201c\u00db\u00b7\u00c6\u00d8{\u00de \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a4\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6\u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00a4\u008a\u00bc\u00b6\u00c6\u00d7 \u00ab\u00b7\u00c6\u00d8{\u00de \u00f4\u00b9\u00c7\u00ce\u00c1\u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 ;\n\n2\u00b0\u0089\u00bc\u00c8\u00e2 12 \u00a5\u00be\u00c6 \u201c\u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a4\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6\u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00a5\u00bc\u00ae\u00b4\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 ;\n\n4\u00b0\u0089\u00bc\u00c8\u00e2 20 \u00a5\u00be\u00c6 \u201c\u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c8\u0081 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00cc\u00b6\u00c7\u0081\u00d9\u00af\u00c6\u00d0\u00ba\u00c6 \u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6 \u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c8\u0081\"\u00ac\u00dd \u00cc\u00b6\u00c7\u0081\u00d9\u00af\u00c6\u00d0\u00ba\u00c6 \u00d0\u00ce\u00bd\u00c1\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\n\n\u00b6 \u00ce \u00be \u00ce \u00ba \u00b9 \u00c6 \u00b9 \u00d5 \u00b6 \u00c6 \u00d7\u00b6\u00df\u00ba\u00c6 \u00cd\u00b7\u00c7\u00bb\u00c6\u00b6\u00c6\u00b6\u00d5\u00b9\u00c6\u00da\u00ba\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6(\u00a3\u00b6\u00c6\u00b6\u00c8\u00b0 222)\n\n\u00da\u00ce\u00af\u008a\u00bc\u00b6\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 (\u00a3\u00b6\u00c6\u00b6\u00c8\u00b0 200)\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5+\u00c6\u00af\u00bf\u00c8\u0081\u00a3\u00b6\u00c8\u00af\u00bc\u00c8\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c630\n\n\u00b7\u00c8\u00ce\u00bc I\n\n\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00b9\u00c6\u00da\n\n\u00b7\u00c8\u00ce\u00bc II\n\n\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6+\u00c6\u00af\u00bf\u00c6\n\n\u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00c6\u00d0 \u00a5\u00dd\u00b9\u00d7 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c8\u0081\u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00cc\u00b6\u00c7\u0081\u00d9\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00bc\u00ae\u00b4\u00c7\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00ab\u00bb\u00c7\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6 \u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c8\u0081 \u00ac\u00dd \u00cc\u00b6\u00c7\u0081\u00d9\u00af\u00c6\u00d0\u00ba\u00c6 \u00d0\u00ce\u00bd\u00c1\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00c6\u00d0\u00a4\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00f2\u00c1\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 ;\n\n5\u00b0\u0089\u00bc\u00c8\u00e2 23 \u00a5\u00be\u00c6 \u201c\u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00ce\u00c1\u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a4\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00a5\u00bc\u00ae\u00b4\u00c7\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n6\u00b0\u0089\u00bc\u00c8\u00e2 24 \u00a5\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u201c\u00a4\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a4\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00f2\u00c1\u00c7\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 ;\n\n7\u00b0\u0089\u00bc\u00c8\u00e2 24 \u00a5\u00be\u00c6 (2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u201c\u00ab\u00ba\u00c6\u00b9\u00d7\u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\"\u201c\u00a4\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6\u00a5\u00bc\u00ae\u00b4\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 ;\n\n8\u00b0\u0089\u00bc\u00c8\u00e2 25 \u00a5\u00be\u00c6 \u201c\u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a4\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6\u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00a5\u00bc\u00ae\u00b4\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1\u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 ;\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5+\u00c6\u00af\u00bf\u00c8\u0081\u00a3\u00b6\u00c8\u00af\u00bc\u00c8\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c631\n\n\u00b7\u00c8\u00ce\u00bc I\n\n\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00b9\u00c6\u00da\n\n\u00b7\u00c8\u00ce\u00bc II\n\n\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6+\u00c6\u00af\u00bf\u00c6"
