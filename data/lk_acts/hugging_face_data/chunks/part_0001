    "chunk_text": "(3) \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00b6\u00c6\u00d7\u00c1+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00af\u00b4\u00ce\u00ba\u00af\u00ce\u00bf\u00dc\u00ba\u00c6,\u00b9\u00b5\u00c8\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00c8\u00b9\u00c6\u00b9\u00b6\u00c8\u00df\u00ba\u00c6, \u00da\u00bc\u00c8\u00c1\u00b6\u00c8\u00df\u00ba\u00c6, \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00de \u00c1\u00b6\u00c8\u00df\u00ba\u00c6\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b1\u00be\u008c\u00b8+\u00c6\u00af\u00bf\u00c6 \u00bb\u00c7\u00e2\u00ba\u00c6\u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n10\u00b0 \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00ba\u00c7\u00b8\u00d7 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b8\u00e2, \u00a3\u008c\u00b9\u00c6\u00da,\u00b7\u0081\u00cc\u00af\u00c7\u00ce\u00b4, \u00a5\u00de\u00b6\u00c8\u008c\u00dd\u00b9\u00c6\u00b9\u00c7\u00c1\u00b5\u00af\u00c6 \u00ce\u00af\u00bb\u00bf\u00c8\u00b9\u00c6\u00da \u00a3\u00be\u00c6\u00be\u00d7\u00cd\u00c1\u00de \u00c1\u00ce\u00af\u00bb\u00c7\u00af \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a7\u00bc\u00c8\u00b6\u00c6\u00d7{\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00af\u00c6\u00e7\u0088\u00bb\u00a3\u00ce\u00b1\u00e2\u00bf\u00c6\u00bf\u00b0 \u00a3\u00ce\u00b1\u00c1\u00bd\u00c6\u00bd \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a4\u00b6\u00b8\u00b6\u00c6\u00ce\u00b6\u00b9\u00c6 \u00cc\u00b9\u00bd\u00e2\u00ba\u00c6\u00b0\n\n\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00d7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00a5\u00be\u00b1\u00c6\u00b1\u00c8\u00ce\u00b8\n\n\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00b7\u00c8\u00b6\u00c8\u00bb\u00ba\u00c6\u00b0\n\n\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00d7{\u00b9\u00b8\u00ba\u00c6\u00a3\u00ce\u00b1\u00e2\u00bf\u00c6\u00bf\u00a3\u00ce\u00b1\u00c1\u00bd\u00c6\u00bd\u00a4\u00b6\u00b8+\u00c6\u00af\u00ce\u00bf\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n71999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 23 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00ba\u00c4\u00d8\u00c1\u00bc \u00cc\u00b9\u00bf\u00b6\u00c6\u00b6\u008c\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7 \u0093\u00b4\u00c6\u00b4\u00bb (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00e2\u00ba\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00db\u00ce\u00bd\u00b9\u00c6\u00b9\u0088 \u00a5\u00bb\u00df\u00ba\u00c7\u00b8\u00b6\u00c7\u00b6\u00df\u00ba\u00c6\u00a4\u00bd\u00c6\u00bd\u00df\u00ce\u00b4\u00bb\u00b6\u00c7\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a9\u00be\u00c6\u00be\u00c7\u00a4\u00b6\u00b8+\u00c6\u00af\u00e0\u00ba\u00c6 \u00a3\u00c1\u00bd\u00c6\u00ce\u00bd \u008c\u00bd\u00c6\u00af, \u00a6\u00d5\u00ce\u00c1\u00af\u00c6\u00af, \u00d0\u00b6\u00c6\u00b6\u00ce\u00af\u00af\u00c6\u00d0\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af,\u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00ba\u00c7\u00bd\u00c6\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de\u00c1\u00ce\u00af\u008a\u00be\u00c6 \u00ce\u00af\u00bb\u00c7\u00bf\u00e2\u00bf\u00c6\u00bf\u00db\u00e1\u00b6\u00c6\u00b6\u00b6\u00c6\u00d7\u00c1\u00b6\u00c6\u00d7\u00b4\u0081 \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00df\u00ba\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n11\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00b4+\u00c6\u00af\u00c8\u00dc\u00bf\u00c6\u00bf \u00a9\u00d7\u00e2\u00ba\u00c6, \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081\u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00ce\u00bf\u00cd\u00bb\u00d9\u00ba\u00c6, \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a3\u00bc\u00b1\u00c8\u00bb\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00d0\u00e1\u008c\u00b8\u00d7 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00ce\u00bf\u00cd\u00bb\u00d9\u00ba\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bc\u00c6\u00af\u00e0\u00ba\u00c6 \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c6 \u00f2\u00be\u00ba\u00c6, \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00a5\u00dd\u00b7\u00c6\u00d7\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a7\u00bc\u00c8\u00ce\u00ba \u00cd\u00af\u00c7\u00dd\u00b9\u00c1\u00bc\u00c6\u00af\u00e0\u00ba\u00c6 \u00b6\u008c\u00bc\u00c6\u00b7\u00c6\u00b6 \u00cd\u00c1\u00de\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u00b8\u00d7 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00ce\u00bf\u00cd\u00bb\u00d9\u00ba\u00c6\u00b0 \u00b9+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00cd\u00be\u00c7\u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00c7\u00b6\u00c8\u00b6\u00c6\u00b6\u00cd\u00be\u00c7 \u00a4\u00af\u00c7\u00d7\u00b0\n\n12\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00af\u00c6\u00d0\u00ba\u00c6, \u00b6\u00ba\u00c8\u00c0\u00c6 \u00a7\u00ce\u00bc\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00ce\u00b4\u00cd\u00bb\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6, \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00bb \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00db\u00b6\u00be\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\n\n\u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b1\u00ce\u00b9\n\n\u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b7\u00c7\u00bb\u00af\u00ba\u00c6 :\n\n\u00c1\u00b5\u00b0 \u00af\u00be\u00c6\u00cc\u00af\u0088 \u00c1\u00be \u00b7\u00b7\u00c6\u00b6\u00bc\u00b6\u00c6\u00b8 \u00cd\u00b6\u00bc\u00bc\u00c6\n\n\u0089\u00bc\u00b6\u00c8\u00b9\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b7\u00c7\u00bb\u00af\u00ba\u00c6 :\n\n\u00cc\u00af\u00bf\u00bc\u00c1 \u00c4\u00bc\u00c9\u00b7\u00c6\u00b6\u00c8\u00bc\u00b7\u00c7\u00b6\u00c6 \u00d7\u00d6\u008c\u00be\n\n\u00a7\u00b6\u008c\u00b9\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b7\u00c7\u00bb\u00af\u00ba\u00c6 :\n\n1.\u00b6\u00c8\u00dd\u00b0 \u00cc\u00b1\u0081 \u00a3\u00be\u00c6\u008c\u00832.\u00b6\u00c8\u00dd\u00b0 \u00a9\u0081\u00b0 \u00cd\u00af\u00b0 \u00a4\u00bc\u00c6\u00b0 \u00b6\u00c8\u00be\u00af\u00bc\u00b6\u00c6\u00b83.\u00b6\u00c8\u00dd\u00b0 \u0093\u00b0 \u00b4\u0089\u00bf\u00c6\u00dc\u00b0 \u00b1\u00ba\u00bc\u00cd\u00af\u00c7\u0081\n\n\u00cc\u00af\u00bf\u00bc\u00c1 \u00cc\u00b1\u00bb\u00be\u00c7\u00bf\u00bc\u00c6 :\n\n\u00b6\u00c8\u00dd\u00b0 \u00cd\u00b2\u00b0 \u00cd\u00b9\u00c7\u0089\u00bd\u00c6\u00bd\u00bb\u00cd\u00af\n\n\u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u00b8\u00d7\u00ba\u00c6\u00aa\u00ce\u00b8\u00cd\u00bb\u00c7\u00bc\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6\u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00ce\u00bf\u00b9\u00c6\u00cd\u00b9\u00d6\u00b6\u00be\u00c6\u00b0\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba\u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6\u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf\u00a7\u00ce\u00bc \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n8 1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 23 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00ba\u00c4\u00d8\u00c1\u00bc \u00cc\u00b9\u00bf\u00b6\u00c6\u00b6\u008c\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7 \u0093\u00b4\u00c6\u00b4\u00bb (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00cc\u00af\u00bf\u00bc\u00c1 \u00a7\u00b9 \u00cc\u00b1\u00bb\u00be\u00c7\u00bf\u00bc\u00c6:\u00b6\u00c8\u00dd\u00b0 \u00a4\u00bc\u00c6\u00b0\u00a9\u00ba\u00c6\u00b0\u0088\u00b0\u0093\u00b0 \u00a4\u00b8\u00b7\u00c6\u00b6 \u0096\u00bc\u00e9\u00bc\u00c8\u00bb\n\n\u00cc\u00af\u00bf\u00bc\u00c1 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00bf\u00bc\u00c6 :\u00b6\u00c8\u00dd\u00b0 \u0091\u00b0\u0088\u00b0 \u00a9\u00be\u00c6\u00b0 \u0096\u00be\u00c7\u00bc\u00b6\u00c6\u00b8\n\n\u00d0\u00e1 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00bf\u00c6 :1. \u00b6\u00c8\u00dd\u00b0 \u0089\u00b0 \u0093\u00b0 \u00bc\u00c7\u00b1\u00c8+\u00c6\u00cc\u00af\u00c7\u00be\u00c6\u00be2. \u00b6\u00c8\u00dd\u00b0 \u00cc\u00b1\u00b8\u00bc\u00b6\u00c6 \u00af\u00be\u00c6\u00af\u00d5\u00c1 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00bc\u00b5\u00c83. \u00b6\u00c8\u00dd\u00b0 \u00bc\u00ba\u00c6\u00b9\u00ae\u00b4\u00c7 \u00b6\u00bc\u00c6\u00ba\u00b6\u00c7\u00b14. \u00b6\u00c8\u00dd\u00b0 \u00cd\u00af\u00b0 \u00aa\u00b0 \u00b6\u00c8\u00b8\u00b9\u00c7\u00be5. \u00b6\u00c8\u00dd\u00b0 \u00b6\u00bc\u00c6\u00ba\u00b6\u00c7\u00b1 \u0096\u00bc\u00bc\u00b6\u00c6\u00b86. \u00b6\u00c8\u00dd\u00b0 \u00a9\u0081\u00b0\u00a9\u00b1\u00c6\u00b0\u0091\u00b0 \u00b6\u00bc\u00c6\u00ba\u00b6\u00c7\u00b17. \u00b6\u00c8\u00dd\u00b0 \u00b4\u0089\u00bf\u00c6\u00dc\u00b0 \u00a9\u00ba\u00c6\u00b0 \u00bc\u00b5\u00d7+\u00c6\u00af \u00b9\u00ae\u00b4\u00c7\u00bc8. \u00b6\u00c8\u00dd\u00b0 \u00a9\u00ba\u00c6\u00b0\u0096\u00b0 \u00a9\u0083\u00b0 \u00b1\u00ba\u00bc\u00d7+\u00c6\u00af9. \u00b6\u00c8\u00dd\u00b0 \u00b4\u0089\u00bf\u00c6\u00dc\u00b0 \u00a9\u00ba\u00c6\u00b0 \u00b1\u00ba\u00bc\u00d7+\u00c6\u00af10. \u00b6\u00c8\u00dd\u00b0 \u00ba\u00af\u00c8\u00b7\u00c6\u00b6 \u00a9\u00af\u00c6\u00af\u00b7\u00c7\u00bb\u00af\u00c6\u00af"
  },
