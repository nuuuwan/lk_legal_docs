ca\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dcf\u0dad\u0dd3\u0db1\u0dca\u0d9c\u0dda\u0118 \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0dad\u0dd2\u0dba, \u0da2\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0db1\u0dca\u0dad\u0dbb \u0dc3\u0d82\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d85\u0db4\u0dbb\u0dcf\u0dcf\u0db0\u0dc0\u0dbd\u0da7 \u0d91\u0dbb\u0dd9\u0dd9\u0dc4\u0dd2 \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dcf\u0dad\u0dd3\u0db1\u0dca\u0d9c\u0dda\u0118 \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0dad\u0dd2\u0dba \u0dc3\u0dc4 \u0db8\u0dcf\u0dcf\u0daf\u0d9a \u0d96\u0dc2\u0db0 \u0dc3\u0dc4 \u0db8\u0db1\u0ddd\ufffd\u0ddd \u0dc0\u0dbb\u0dca\u0dad\u0d9a \u0db1\u0dd3\u0dad\u0dd2 \u0dc0\u0dd2\u0dbb\u0ddd\u02e1\u0ddd\u0db0\u0dd3 \u0dbd\u0dd9\ufffd\u0dc3 \u0da2\u0dcf\u0dcf\u0dc0\u0dcf\u0dcf\u0dbb\u0db8\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d91\u0dbb\u0dd9\u0dd9\u0dc4\u0dd2 \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dcf\u0dad\u0dd3\u0db1\u0dca\u0d9c\u0dda\u0118 \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0dc0\u0dd6 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db6\u0dd0\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db4\u0dd6\u0dbb\u0dca\u0dab \u0dbd\u0dd9\ufffd\u0dc3 \u0db6\u0dbd\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc3\u0dc4 \u0dc3\u0db8\u0d9a\u0dcf\u0dcf\u0dbd\u0dd3\u0db1 \u0da2\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0db1\u0dca\u0dad\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2 \u0dc3\u0dc4 \u0dba\u0dc4\u0db4\u0dad\u0dca \u0db4\u0dbb\u0dd2\u0da0\u0dba\u0db1\u0dca\u0da7 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d85\u0db4\u0dbb\u0dcf\u0dcf\u0db0\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0dd2\u0dad \u0daf\u0dda\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db1\u0dd3\u0dad\u0dd2 \u0db4\u0dd0\u0dd0\u0db1\u0dc0\u0dd3\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u0