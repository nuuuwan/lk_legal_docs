    "chunk_text": "\u00c6\u008a\u00c0\u00ea\u00c7\u00c0\u00e0\u00c0\u00e5\u00b6\u00ea\u00c9\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a\u00ef\u00bc\u00e5\u00e0\u00cb\u00c6\u00a8\u00e0\u00ba\u00e8\u009f\u00ef\u008a\u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0\u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0\u00a8\u00f2\u00e8\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a1\u00c9\u00c8\u00e2\u00aa\u00eb \u00c9\u00be\u00ef\u00cc\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea\u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00c0\u00e5\u00d6\u00ca\u00f2\u0095\u00a8.\n\n81999 \u00a1\u00e2\u00a8 31 \u00bc\u00c7\u00be \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c0\u00be\u00ba\n\n11.(1) \u00a1\u00c9\u00c4 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00e7\u00c4 \u00c4\u00cc\u00a8\u00b4 \u00a6\u00a8\u00e0 \u00c9\u00c7\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c3\u00e5\u00ef\u008c\u00db\u00cc\u00e0\u00d1\u008a \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00c9\u00ea\u00c9 \u00bc, \u00cc\u00c3\u00e5\u00ef\u008c \u0097\u00ef\u00ca\u00e0\u00cb \u00db\u00cc\u00e0\u00d1\u00c4\u00a8\u00e0 \u00a8\u00e6\u00bf\u00c9\u00be \u00ef\u00c8\u00cc \u00cc\u00c3\u00e5\u00ef\u008c \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00bc\u00ef\u00bc\u00be\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c8\u00e8\u008d\u00ba \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00f8\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9, \u00bc\u00fa\u00be \u00cd\u00ba\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c3\u00e5\u00ef\u008c \u0097\u00ef\u00ca\u00e0\u00cb \u00db\u00cc\u00e0\u00d1\u00c4\u00a8\u00e0 \u00a8\u00e6\u00bf\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) \u00cc\u00c3\u00e5\u00ef\u008c \u00c6\u008a \u00db\u00cc\u00e0\u00d1\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00aa\u00b8\u00c0\u00ec\u00c7\u00b8\u00c6 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00c0\u00cc\u00e0 \u00ef\u00bc\u00be\u00a8\u00eb \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(5) \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5 \u00cc\u00c3\u00e5\u00ef\u008c \u00db\u00cc\u00e0\u00d1\u008a\u00c9\u00c8 \u00c4\u00ec\u00c8\u00e5\u00cc\u00be\u00c6 \u00bc\u00e6\u00d6\u00c6 \u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00c7, \u00cc\u00c3\u00e5\u00ef\u008c \u00c6\u008a \u00db\u00cc\u00e0\u00d1\u00c4\u00a8\u00b4 \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5 \u00c0\u00e6\u0095\u00b8 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u0097\u00b4\u00a8\u00c0\u00e6\u0095\u00b8 \u00cc\u00e8\u0090\u00be \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00c9\u00e6\u0091\u00ef\u00bc\u00be\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00ba\u00e5\u00e0\u00c7\u00e5 \u00c0\u00ba\u00e0 \u00a8\u00c7 \u00aa\u00be\u00ea\u00c8\u00c2\u00be \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00a6\u00e0 \u00db\u00cc\u00e0\u00d1\u00ef\u008a \u00c4\u00ec\u00c8\u00e5\u00cc\u00be\u00c6 \u00bc\u00e6\u00d6\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(6) \u00ef\u00c7\u00e5\u00e0\u00aa\u00e5\u00ba\u00eb\u00c7 \u00d1\u00c4 \u00be\u00f8\u00cc\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00c2\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00be\u00f8\u00cc\u00e5 \u00ef\u00cd\u00e5\u00e0\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7\u00c9 \u00cc\u00e8\u009b\u00c4 \u00be\u00f8\u00cc\u00e5 \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5\u00b4 \u00ba\u00c4 \u00bd\u00ea\u00c7\u00ef\u00c6\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00ba\u00e5\u00c9\u00a8\u00e5\u00c8\u00e8\u00a8\u00c9 \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8 \u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c3\u00e5\u00ef\u008c \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00a7\u00cd\u00ea \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c9\u00e6\u00b6 \u00c2\u00e6\u00c8\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00ba\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(7) \u00cc\u00c3\u00e5\u00ef\u008c \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a\u00a8\u00e5\u00c7\u00b8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00bc\u00c6\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00af\u00be\u00e0\u00bc\u00c6 \u00cc\u00c4\u00e5\u00be\u00c9 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb\u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5\u00b4 \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00af\u00be\u00e0\u00bc\u00c6\u00b4 \u00a1\u00ba\u00f8\u00ef\u00da\u00a8\u00c9 \u00ba\u00f9\u00c7\u00a8 \u00af\u00be\u00e0\u00bc\u00c6\u00a8\u00e0\u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(8) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u0097\u0093\u0097\u00bd\u00e5\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00cc\u00c3\u00e5\u00c9\u0097\u00cc\u00e8\u00be\u00e0, \u00a6\u00cd\u00fa \u00db\u00cc\u00e0\u00d1\u008a \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00cc\u00cd \u00a6\u00e0 \u00db\u00cc\u00e0\u00d1\u008a \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7\u00ef\u00aa\u00be\u00c6\u00e5\u00ef\u008a \u00a8\u00e5\u00da\u00c6 \u00c0\u0090\u00c0\u00e5\u0090\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00cc\u00c3\u00e5\u00ef\u008c\u00db\u00cc\u00e0\u00d1\u008a.\n\n91999 \u00a1\u00e2\u00a8 31 \u00bc\u00c7\u00be \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c0\u00be\u00ba\n\nII \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u00cc\u00cd \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00cd\u00e5 \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00be\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\n\n12.(1) \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0, \u00a1\u00c6\u00ba\u00ba\u00be\u00ef\u00c6\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u0097\u00bd\u00e5\u00c6\u00a8\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4\u00c0\u00ba\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u0095\u00c6 \u00c6\u00e5\u00c4, \u00a2\u00c8\u00e0\u00c8\u00e5 \u00a1\u00cc\u00e0\u00d1\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00bd\u00ea\u00c7\u00ef\u00c6\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00be\u00f8\u00cc\u00e5 \u00a8\u00c8\u00e8\u00be\u00e0 \u00bd\u00ea\u00c7\u00c6 \u00a1\u00ba\u00e0 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u0095\u00cc, \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00c0\u00ba\u00e0\u00d1\u00ef\u008a \u00bc\u00fa\u00be \u00cc\u00e8\u00b4\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00c0\u00cd\u00a8 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00bd\u00ea\u00c7\u00c6 \u00bc\u00e6\u00d6\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00cc\u00c3\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ba\u00c8\u00cc\u00cd \u00a8\u00e5\u00da\u00ba\u00c9\u00f1 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00bc, \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00c4 \u00bc \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00bd\u00ea\u00c7\u00ef\u00c6\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6."
