    "chunk_text": "6.\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 1988 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb \u00c0\u00be\u00ef\u00ba\u00e0\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c6\u008a \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00c9\u00e5\u00b8\u00e8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8 \u201c\u00c6\u00ea\u00ef\u00be\u00cc\u00e0\u00ef\u00a8\u00e5\u00e0\u00ca\u00fa\u00cb\u00f1\u00ba\u00e0\u00c9 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00aa\u00fa\u00b8\u00ea\u00c4\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00aa\u00fa\u00b8\u00ea\u00c4\u00a8\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 -\n\n(\u00a1) 5 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00ef\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4\u00c0\u00e6\u00c9\u00ef\u00c7\u00be \u00cc\u00e8\u00c6\u00f5 \u00c4\u00ea\u00bc\u00c8\u00e0 ;\n\n(\u00a1\u00e5) \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00bc\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e8\u00c6\u00f5 \u00ba\u00f1\u00e5\u00aa \u00ef\u00cd\u00e5\u00e0\u00c0\u00d6\u00ba\u00f1\u00e5\u00aa ;\n\n\u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4\u00c4\u00e5\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c6\u00ea\u00ef\u00be\u00cc\u00e0\u00ef\u00a8\u00e5\u00e0\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00aa\u00fa\u00b8\u00ea\u00c4.\n\n51999 \u00a1\u00e2\u00a8 44 \u00bc\u00c7\u00be \u00c6\u00ea\u00ef\u00be\u00cc\u00e0\u00ef\u00a8\u00e5\u00e0 \u00ca\u00fa\u00cb\u00f1\u00ba\u00e0\u00c9\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00c0\u00be\u00ba\n\n(\u00a1\u00e7) \u00ef\u00c0\u00e5\u00ba\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c6\u008a \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u0097\u0097\u00bd \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00db\u00cc\u00e0\u00a8\u00f8\u00d7\u00ef\u008a\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8\u00e8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a ;\n\n(\u00a2) \u00ef\u008a \u00c0\u00be\u00ba \u00a1\u00e5\u00c7\u008a\u00c3\u00d1\u00ef\u008a \u00bc\u00fa\u00be\u00c6\u00b4 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00a4\u00c0\u008e\u00ba\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00cc\u00e8\u00c6\u00f5 \u00c4\u00ea\u00bc\u00c8\u00e0.\n\n\u00a6\u00c4 \u00aa\u00fa\u00b8\u00ea\u00c4\u00b4 \u00c2\u00e6\u00c7 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n7.\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u0097\u00bd\u00e5\u00be\u00c6\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c6\u00ea\u00ef\u00be\u00cc\u00e0\u00ef\u00a8\u00e5\u00e0 \u00b0\u00e5\u00ba\u00f8\u00a8\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a \u00b0\u00be\u00c7\u00e5\u00c8\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n8.\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00c0\u00da\u00c4\u00e5\u00da\u00bb \u00cc\u00bf\u00cd\u00e5 \u00ef\u00c6\u00bc\u00d1\u00c4 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :-\n\n(\u00a1) \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00cd\u00e5 \u00a1\u00cc\u00e0\u00bb\u00e5\u00be\u00aa\u00ba \u00ce\u00c4\u00c6\u00fa\u00be\u00e0\u00b4 \u00ca\u00fa\u00cb\u00f1\u00ba\u00e0\u00c9 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a1\u00e5) \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00c0\u00e5\u00ba\u00e0 \u00c0\u00ce\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00be \u0097\u00c6\u00bc\u008a\u00bc\u00e6\u00d7\u00c4.\n\n9. (1) \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00cc\u00cd \u0097\u00c6\u00bc\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00cc\u00e8\u00c6\u00f5 \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc \u00c6\u00bb\u00e5 \u00c0\u00d6\u00bc\u00fa \u00aa\u00fa\u00b8\u00ea\u008a \u00ef\u00c0\u00e5\u00ba\u00e0 \u00ba\u00e6\u009f\u00c4\u00cc\u00bf\u00cd\u00e5 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u00e6\u00c8\u00e6\u00cc\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00a8\u00f2\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c 154 \u00c9\u00be \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u0097\u0093\u0097\u00bd\u00e5\u00be\u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00aa\u00fa\u00b8\u00ea\u008a \u0097\u00aa\u00b8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00bc\u00e5\u00ce \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e7\u00c4 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00a1\u00c9\u00cc\u00e5\u00be\u00ef\u00c6\u00e0 \u00bc\u00e9 \u00c4 \u00a6\u00e0\u00c9\u00da\u00cb\u00c6 \u00ba\u00eb\u00ce \u00bc\u00fb \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00c6 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec\u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00c4 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00a6\u00c4 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a1\u00bc\u00e5\u00ce \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00c9\u00da\u00cb\u00c6\u00a8\u00b4 \u00bc \u00a6\u00e0 \u00c9\u00da\u00cb\u00c6\u00b4 \u00c0\u00cc\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be\u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00a1\u00c9\u00cc\u00e5\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u00b4 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u00e6\u00c8\u00e6\u00cc\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n10. \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00da\u00cb\u00c6 \u00c8\u00e8\u00ba\u00e0 \u00c9\u00da\u00cb\u00c6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be\u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5.\n\n\u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0\u00ef\u00c6\u00e5\u00bc\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8 \u00a8\u00e5\u00da\u00c6\u00c6\u00be\u00e0.\n\n\u0097\u00aa\u00b8\u00be\u00c6 \u00cc\u00cd\u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9.\n\n\u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00da\u00cb\u00c6.\n\n61999 \u00a1\u00e2\u00a8 44 \u00bc\u00c7\u00be \u00c6\u00ea\u00ef\u00be\u00cc\u00e0\u00ef\u00a8\u00e5\u00e0 \u00ca\u00fa\u00cb\u00f1\u00ba\u00e0\u00c9\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00c0\u00be\u00ba\n\n11. \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00cb\u00c6\u00c6\u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a6\u00a8\u00ad\u00ba\u00e0\u00c9\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00c4\u00aa\u00fa\u00be\u00e0\u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a4\u00c0\u00a8\u00e5\u00c7 \u00c9\u00be \u00c6\u008a \u00c3\u00e5\u00b8\u00e0\u00b6 \u00c4\u00ba \u00c6\u008a \u00ef\u00da\u00aa\u00eb \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6."
