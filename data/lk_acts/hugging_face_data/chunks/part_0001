    "chunk_text": "\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00cc\u00e9\u00c6\u00a8\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00f1\u00e5\u00c0\u00e0\u00ba \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8\u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00f1\u00e5\u00c0\u00e0\u00ba \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8\u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00bc\u00cd\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0097\u00cc\u00e0\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cd\u00ba\u00e0\u00cc\u00e8\u00c6 \u00c0\u00b8\u00cd\u00a8 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00bc\u00cd\u00cc\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cc\u00e8\u00c6\u00c6\u00a8\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00f1\u00e5\u00c0\u00e0\u00ba \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00cc\u00e8\u00c6 \u00c0\u00b8\u00cd\u00a8\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00f1\u00e5\u00c0\u00e0\u00ba \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8\u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00f1\u00e5\u00c0\u00e0\u00ba \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8\u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cd\u00ba\u00e0\u00cc\u00e8\u00c6 \u00c0\u00b8\u00cd\u00a8\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00f1\u00e5\u00c0\u00e0\u00ba \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8\u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cd\u00ba\u00e0\u00cc\u00e8\u00c6 \u00c0\u00b8\u00cd\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00bc\u00cd\u00cc\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00cc\u00e8\u00c6 \u00c0\u00b8\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00cc\u00e8\u00c6 \u00c0\u00b8\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n2005 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00bc\u00b6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00e6\u0091\u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00be\u00ba24\n\n\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\nI \u00c9\u00be \u00ba\u00f9\u00c7\u00c6II \u00c9\u00be \u00ba\u00f9\u00c7\u00c6III \u00c9\u00be \u00ba\u00f9\u00c7\u00c6\u00c0\u00be\u00ef\u00ba\u00cd\u00fa \u00be\u00e5\u00c4\u00c6\u00bc\u00e6\u00be\u00b4 \u00ef\u00c6\u00ef\u00bc\u00be \u00c9\u00ae\u00be\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c9\u00ae\u00be(446 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00a4\u00bc\u00e0\u00c3\u00fa\u00bc \u00a4\u00bc\u00f1\u00e5\u00be\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n(217 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00c0\u00e5\u00be\u00e0 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n1987 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00be\u00e5\u00c4 \u00c0\u00be\u00ba\n\n1957 \u00a1\u00e2\u00a8 34 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0\u00c9\u00c7\u00b4\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba (159 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec ) \u00cc\u00e9 \u00b4\u00ea\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n1988 \u00a1\u00e2\u00a8 64 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba 1971 \u00a1\u00e2\u00a8 46 \u00bc\u00c7\u00be \u00ef\u00c0\u00e5\u00c8\u00e0 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n1967 \u00a1\u00e2\u00a8 17 \u00bc\u00c7\u00be \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0\u00c9\u00c7\u00b4\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba (160 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ef\u00c0\u00e5\u00c8\u00e0\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n(49 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ea ) \u00a1\u00be\u00e0\u00ba\u00c7\u00e5\u00bc\u00e5\u00c6\u00a8 \u00cc\u00ba\u00eb\u00be\u00e0\u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\n\n1983 \u00a1\u00e2\u00a8 1 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba\u00a1\u00be\u00e0\u00ba\u00c7\u00e5\u00bc\u00e5\u00c6\u00a8 \u00c0\u00e8\u00cd\u00e8\u00c6\u00e5 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba (27 \u00c9\u00be\u00a1\u0093\u00a8\u00e5\u00c7\u00c6)\n\n(452 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00aa\u00cc\u00e0 \u00a8\u00c0\u00e5 \u00ef\u00cd\u00ce\u00e9\u00c4(\u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a) \u00c0\u00be\u00ba\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0097\u00cc\u00e8\u00c0\u00cd\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00b8\u00cd\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cc\u00e8\u00c6\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00cc\u00e8\u00c6 \u00c0\u00b8\u00cd\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00cc\u00e9\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00cc\u00e8\u00c6 \u00c0\u00be\u00cd\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00cc\u00e8\u00c6 \u00c0\u00b8\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00cc\u00e8\u00c6 \u00c0\u00b8\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00cc\u00e8\u00c6 \u00c0\u00b8\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cd\u00ba\u00e0\u00cc\u00e8\u00c6 \u00c0\u00b8\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00bc\u00cd\u00cc\u00e0 \u00c0\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n\u201c\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ba\u00eb\u00be\u00e0\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00be \u00bc\u00b6\u00c6\u00a8\u00e0\u201d\n\n2005 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00bc\u00b6 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00e6\u0091\u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00be\u00ba25\n\n\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6I \u00c9\u00be \u00ba\u00f9\u00c7\u00c6II \u00c9\u00be \u00ba\u00f9\u00c7\u00c6III \u00c9\u00be \u00ba\u00f9\u00c7\u00c6\n\n\u00c0\u00be\u00ef\u00ba\u00cd\u00fa \u00be\u00e5\u00c4\u00c6\u00bc\u00e6\u00be\u00b4 \u00ef\u00c6\u00ef\u00bc\u00be \u00c9\u00ae\u00be\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c9\u00ae\u00be"
