    "chunk_text": "\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c4 \u00c9\u00ec \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c9\u00c8 \u00bc\u00fb \u00c0\u00d6\u00aa\u00b8\u00a8\u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00c8 \u00a6\u00a8\u00ba\u00eb\u00c9\u00a6\u00e0 \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c0\u00e8\u00d6\u00c9\u00e6\u00c6\u00b4 \u00cc\u00c4\u00e5\u00be \u00be\u008a,\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ef\u008a \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u00c0\u00ec\u00da\u00c9\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00f8\u00cc\u00e8\u00f3 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00a2\u00b6 \u00ef\u00be\u00e5\u00bc\u00fa\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\u201d.\n\n(1) \u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ba\u00eb\u00be\u00e0\u00c9\u00be \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 \u201c1989 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc01 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cd\u00e5 \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c1989\u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cd\u00e5 \u00a2\u00c8\u00a8\u00e0\u00a8\u008a\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u201d;\n\n(2) \u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cd\u00ba\u00c7\u00c9\u00be \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 \u201c1989 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0\u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0\u00cc\u00cd 1997 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 31 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 1997 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 31 \u00c9\u00be\u00bc\u00fa\u00be \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00a8\u00e5\u00c8\u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cd\u00e5 \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c1989 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0\u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00a6\u00ef\u00cd\u00ba\u00e0 1997 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc01 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c9\u00ec \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00cd 1997 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0\u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 1997 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 31 \u00c9\u00be \u00bc\u00fa\u00be \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00a8\u00e5\u00c8\u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cd\u00e5 \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n8.1998 \u00a1\u00e2\u00a8 52 \u00bc\u00c7\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c0\u00f2\u00bd\u00e5\u00be\u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 31 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (6) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00e8\u00be\u00e0 \u00ba\u00c9\u00f3\u00c7\u00b4\u00ba\u00e0\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2013\n\n(1) \u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (i) \u00c9\u00be \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c(2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(\u00a1\u00e5), (\u00a1\u00e6), (\u00a8), \u00ef\u00cd\u00e5\u00e0 (\u00aa) \u00ef\u00d8\u00bc\u00c9\u00c8\u201d \u00c9\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a1\u00a8\u00eb\u00c7\u00e6\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c(2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5), (\u00a1\u00e6), (\u00a8), (\u00aa)\u00ef\u00cd\u00e5\u00e0(\u00b8) \u00ef\u00d8\u00bc\u00c9\u00c8\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a1\u00a8\u00eb\u00c7\u00e6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0;\n\n(2) \u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (ii) \u00c9\u00be \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c(\u00b4) \u00ef\u00cd\u00e5\u00e0 (\u00b8) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a1\u00a8\u00eb\u00c7\u00e6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c(\u00b4) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00cc\u00cd \u00a1\u00a8\u00eb\u00c7\u00e6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\u201d.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e030 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e031 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n1999 \u00a1\u00e2\u00a8 41 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba7\n\n9.1998 \u00a1\u00e2\u00a8 52 \u00bc\u00c7\u00be \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c0\u00f2\u00bd\u00e5\u00be\u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 32 \u00a1\u00e7\u00a1\u00e7\u00a1\u00e7 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2013\n\n(1) \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c1998 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01\u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a\u00c9\u00c8 \u00cc\u00e8\u00b4 \u201c\u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00c8\u00cc \u00aa\u00b8\u00be\u00c6 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec\u00ef\u00a8\u00e5\u00b4\u00cc \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c9\u00ae\u00be \u00cd\u00e5 \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2013\n\n\u201c(\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be) \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00b4 _\n\n(\u00a1)1998 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 (3 (\u00a1) \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9) \u00c6\u008a \u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c6\u008a\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00f8\u00be\u00e0 ; \u00ef\u00cd\u00e5\u00e0"
  },
