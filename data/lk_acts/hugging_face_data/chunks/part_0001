    "chunk_text": "(i) \u201c\u00af\u00ba\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u201d \u00a9\u0081\u00b9\u00d7 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u008c\u00c1\u00bc\u00b5\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u00b8 \u00b6\u00c7\u00c1\u00bc+\u00c6\u00af\u00e0\u00b4\u0081\u00af\u00c7\u00b5\u00c8\u00b9\u00c6 \u00b9\u008a\u00bc\u00c6\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00ce\u00af\" \u00cd\u00af\u00c7\u00c0\u00c8\u00b9\u00c6 \u00b9\u00ae\u00ce\u00b5\u00af\u00bf\u00c6\" \u00cc\u00b1\u00bb\u00bd\u00c6\u00ce\u00af \u00db\u00ce\u00bd\u008a\u00be\u00c6 \u00b1\u00c8\u00ce\u00b8\u00bb[\u00b4\u00c6\u00d5\u00b6\u00be\u00c6\"\u00ba\u00c8\u00dd\u00af \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00bb\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cd\u00c1\u00de \u00a4\u00b6\u00c7\u00bc\u00cd\u00b1\u00ce\u00c1\u00af\u00bf\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b4 \u00ba\u00c9\u00b8\u00c6 \u00c1\u00bf\u00bc\u00c6\u00b9\u00c6\u00da \u00a3\u00be\u00c6\u00be\u00d7\u008c\u00be+\u00c6\u00d0 \u00cd\u00c1\u00bf\u00c7\u00ae\u00ce\u00ba \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n(iii) \u201c\u00b9\u00c7\u00bc\u00ba\u00c6\u00b9\u00bc\u00c8\u00bb\u00ba\u00bd\u00c6\u00bd \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c6\u201d\u00a9\u0081\u00b9\u00d7 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u0081 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8\u00c1\u00bc\u008c\u00be\u00c6 \u00e7\u00b4\u00c6\u00d5\u00cc\u00ba\u00c7\u00b6\u00c6\u00b6\u00ba\u00c6 \u00a9\u00ae\u00b9\u00d7 \u00b1\u00b6\u0096\u00b6\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00af\u00c6\u00d0\u00ce\u00bd\u00bb\u00c7\u00ba\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00c7\u00bc\u00ba\u00c6\u00b9\u00bc\u00c8\u00bb\u00ba\u00bd\u00c6\u00bd\u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c8\u0081 \u00aa\u00bd\u00c6\u00de\u00ba\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c612\n\n\u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00bd\u00c6\u00de\u00ba\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00b6\u00b6\u00c7\u008a\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c8\u0081 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00bd\u00c6\u00de\u00ba\u00b6\u00c8 \u00a7\u00b4\u00c6\u00b9\u00b4(\u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u00a3\u00bf\u008c\u00be\u00c7\u00b8 \u00af\u00dd\u00b7\u00c6\u00cd\u00b6\u008a\u00ce\u00be\"\u00af\u00c8\u00cd\u00bd\u00b9\u00c6 \u00a5\u00bd\u00b9\u00c6\u00b9\u00bc\u00c6\" \u00b1\u00c9\u00b4\u00c6 \u00a5\u00bd\u00b9\u00c6\u00b9\u00bc\u00c6\" \u00af\u00c0\u00c8\u00e2\u00a5\u00bd\u00b9\u00c6\u00b9\u00bc\u00c6\" \u00a5\u00bd\u00b9\u00c6\u00b9\u00bc\u00c6 \u00b9\u00c7\u00be\u00c6\" \u00b9\u00d2\u00ce\u00ba\u00bb\u00c7\u00b8\u00cd\u00b6+\u00c6\u00af\u00c7\u00bb\u00c6 \u00a9\u0081\u00b9\u00b8 \u00b6\u008c\u00bc) \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6\u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c6 \u00a9\u00b8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n(iv) \u201c\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00bd\u00c6\u00de\u00ba\u00b6\u00c8\u201d \u00a9\u0081\u00b9\u00d7\u00b9\u00c7\u00bc\u00ba\u00c6\u00b9\u00bc\u00c8\u00bb\u00ba\u00bd\u00c6\u00bd \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00cc\u00bf\u00c7\u0081\u00bd\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b9\u00c6\u00b9\u00ae\u00b4\u00b6\u00c6\u00ce\u00b6 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af\"\u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00af\" \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b9\u00c7\u00b6\u00c8\u008a\u00be\u00ce\u00b4\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00af \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00aa\u00bd\u00c6\u00de\u00ba\u00b6\u00c8\u00bb\u00c7\u00bf\u00bc\u00c7\u00be\u00c6 \u00cd\u00ba\u00df\u00ba\u00c6 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7\u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u0089\u0081\u00bd\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6\u00aa\u00bd\u00c6\u00de\u00ba\u00b6\u00c8\u00bb\u00c7\u00bf\u00dd\u00af\u00c6\u00d0 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6\u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c8\u0081 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u00da \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00c1\u00c0+\u00c6\u00af\u00be\u00c6 \u00a5\u0081\u00bd\u00c8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c8\u0081 \u00aa\u00bd\u00c6\u00de\u00ba\u00b6\u00c8\u00bb\u00c7\u00bf\u00bc\u00c6 \u00a9\u00c1\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00b9+\u00c6\u00d0\u00ce\u00b4\u00ce\u00ba\u00bb\u00c7\u00be\u00c6 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b9\u00c6 \u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c8\u0081 (\u00cc\u00ba\u00c7\u00b6\u00c6\u00b6 \u00a3\u00bf\u008c\u00be\u00c7\u00b8 \u00af\u00dd\u00b7\u00c6\u00cd\u00b6\u008a\u00ce\u00be\" \u00af\u00c8\u00cd\u00bc\u00b9\u00c6 \u00a5\u00bd\u00b9\u00c6\u00b9\u00bc\u00c6\" \u00b1\u00c9\u00b4\u00c6\u00a5\u00bd\u00b9\u00c6\u00b9\u00bc\u00c6\" \u00af\u00c0\u00c8\u00e2 \u00a5\u00bd\u00b9\u00c6\u00b9\u00bc\u00c6\" \u00a5\u00bd\u00b9\u00c6\u00b9\u00bc\u00c6 \u00b9\u00c7\u00be\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b9\u00d2\u00ce\u00ba\u00bb\u00c7\u00b8 \u00cd\u00b6+\u00c6\u00af\u00c7\u00bb\u00c6\u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00ce\u00bd\u00b6\u00c6 \u00b6\u008c\u00bc) \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7\u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u00da \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00c1\u00c0+\u00c6\u00af\u00be\u00c6 \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n10\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u0089\u00bc\u00c8\u00e2 21\u00a6 \u00a9\u0081\u00b9\u00d7\u201c\u00a4\u00bc\u00c7\u00bb\u00c6\u00b1\u00c6\u00b1\u00c8\u008a\u00df\u00ba\u00c6 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u008a\u00df\u00ba\u00c6 \u00a6\u00d5\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00d7\u00ba\u00c6 \u00ac\u00dd \u00da\u00b6\u00c8\u00bb\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00ce\u00bb\u00b6\u00c6 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00c8\u00bb\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00ad\u00bc\u00c7\u00ae\u0088\u00d9\u00bf\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00bc\u00ae\u00d5 \u00ba\u00c8\u00be\u00c6\u008b\u00bb\u0081 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00db\u00b6\u0095\u00b4\u00c6\u00d5\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00da\u00b6\u00c8\u00bb \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00ce\u00bb\u00b6\u00c6\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008121\u00a6 \u00a9\u0081\u00d9\u00ba\u00c6\u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2004 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c613\n\n\u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00af\u00c8\u0081\u00bd \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00b6\u00b8\u00c8\u00cd\u00bb \u00a4\u00bc\u00c7\u00bb\u00c6\u00b1\u00c6\u00b1\u00c8\u008a\u00df\u00ba\u00c6 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u008a\u00df\u00ba\u00c6 \u00a6\u00d5\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00d7\u00ba\u00c6 \u00ac\u00dd \u00da\u00b6\u00c8\u00bb \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00ce\u00bb\u00b6\u00c6 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00c8\u00bb\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00ad\u00bc\u00c7\u00ae\u0088\u00d9\u00bf\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00bc\u00ae\u00d5 \u00ba\u00c8\u00be\u00c6\u008b\u00bb\u0081 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6\u00d0\u00ce\u00bd\u00bb\u00c7\u00b6 \u00db\u00b6\u0095\u00b4\u00c6\u00d5\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00da\u00b6\u00c8\u00bb \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00ce\u00bb\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00af\u00c8\u0081\u00bd \u00ac\u00dd \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u0081\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7\u00b0"
