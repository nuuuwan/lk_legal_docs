    "chunk_text": "(ii)\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00c6\u00a8\u00eb \u00cc\u00c4\u00ad\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00c0\u00be\u00cc\u00e0 \u00a6\u00a8\u00a8\u00b4\u00a1\u00b6\u00ea \u00ef\u00be\u00e5\u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6\u00a8\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 ; \u00ef\u00cd\u00e5\u00e0\n\n(iii)\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c4\u00e5\u00da\u00aa\u00c6 \u00cd\u00e6\u00c7 (\u00c9\u00ba\u00e0\u00a8\u008a, \u00c9\u00aa\u00a8\u00f9\u008a, \u00cc\u00cd\u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00a8\u00c6\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9) \u00a7\u00c0\u00e0\u00c0\u00ea\u00c9\u00a8\u00e0\u00c4\u00e5\u00da\u00aa\u00ef\u00c6\u00be\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00c4,\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\u201d.\n\n13.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 21 \u00a4\u00f0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 (\u00a1\u00e5)\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c1982 \u00a1\u00e2\u00a8 17 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c6\u00bc\u00fb\u00ef\u00c4\u00be\u00e0 ;\n\n(2)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 \u201c\u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00be\u008a \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201c\u00c8\u00e5\u00c3\u00e5\u00e2\u00ca \u00c0\u00f2\u00a8\u00e5\u00ca\u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00be\u008a \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00ba\u00eb\u00ce \u00bc\u00fb \u00a8\u00c7\u00be\u00c8\u00bc \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c9\u00c8\u00e8\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u0097\u00cc\u00e0\u00cc\u00a8\u00b4 \u00c9\u00e6\u0091\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00a6\u00c4 \u00a1\u00c9\u00bc\u00e5\u00be\u008a \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00cc\u00c4\u00e5\u00aa\u008a\u00a6\u00a8\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00c9\u00e6\u0091 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8 \u00cc\u00e8\u00f3\u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00be\u008a, \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c4\u00aa\u00fa\u00be\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(3)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a1\u00c9\u00cc\u00e5\u00be\u00c6\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(7) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u201c\u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0\u201d\u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00c4\u00c9\u00ea \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00cc\u00cd \u00a6\u00cd\u00fa \u00cc\u00e8\u00c6\u00f5\u00c4 \u00c0\u00e5\u00c8\u00e8\u00ba \u00cc\u00c4\u00e5\u00aa\u008a\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00cc\u00c4\u00ec\u00cd\u00c6\u00a8\u00e0 \u00ba\u00eb\u00ce \u00c0\u00e8\u00cd\u00fa\u0090 \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00be \u00a1\u00ba\u00c7, \u00a6\u00c4 \u00c4\u008c \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e5\u00c8\u00e8\u00ba \u00cc\u00c4\u00e5\u00aa\u00ef\u008a\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e021 \u00a3 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e021 \u00a4\u00f0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba12\n\n\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00e6\u00be\u00e0 \u00c9\u00e6\u0091 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00c0\u00e5\u00c8\u00e8\u00ba\u00cc\u00c4\u00e5\u00aa\u00c4 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00ef\u00c6\u00e0 \u00be\u00e5\u0095\u00a8 \u00c9\u0090\u00be\u00e5\u00a8\u0095\u00be\u00e0 \u00c3\u00e5\u00aa\u00c6\u00a8\u00b4\u00c9\u00e6\u0091 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00bc\u00e6\u00d7\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a6\u00c4 \u00c4\u008c \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e5\u00c8\u00e8\u00ba\u00cc\u00c4\u00e5\u00aa\u00c4 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00c4 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\u201d\n\n14.2003 \u00a1\u00e2\u00a8 19 \u00bc\u00c7\u00be \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00c7\u00b4 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00e0\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 23 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00ba\u00c9\u00f3\u00c7\u00b4\u00ba\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u2014\n\n(\u00a1)\u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c2003 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0\u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00c6\u008a\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be\u00c6\u00be\u00ea \u00c8\u00c2\u00be\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(\u00a1\u00e5)\u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6\u2014"
