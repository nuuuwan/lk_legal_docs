e\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c621\n\n(2) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 111\u00a3 \u00a9\u00b8\u00c6\u00d9\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\" \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00b7\u00c6\u00b6\u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b6\u00c7\u00af\u00c8\u0081\u00bd\u00b8\u00cd\u00c1\u00c7 \u00a3\u00b7\u00c6\u00b6\"\u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c6 \u00ac\u0081\u00ce\u00bd\u00b6\u00c6 \u00b6\u008c\u00bc 2003\" \u00bb[\u00ce\u00be 1 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00c8 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c7\u00b8\u00d7 \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6\u00b1\u00b4\u00c6\u00b4\u00cc\u00ba\u00c7\u0081\u00bd\u00c7\u00af \u00b1\u00c7\u0081\u00de\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ba\u00c7\u00b6\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00ce\u00b4\u00b1\u00c8\u00b6\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00db\u0088\u00c1\u00ce\u00b4\u00dc\u00ba\u00c6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u00af\u00c6\u00d0 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00ce\u00bb\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a4\u00bf\u00c7\u00b8 \u00a4\u00bf\u00c6 \u00a9\u00c1\u00dd\u00ba\u00c6\u00b0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00b