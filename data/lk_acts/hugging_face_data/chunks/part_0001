    "chunk_text": "(i)\u00a6\u00e0 \u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u00c4, \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6, \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00cd\u00e5\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00a6\u00e0 \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea\u00c9 \u00a8\u00c7\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00bc\u00fb, 2002 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6\u00c4\u00ba \u00c2\u00f3 \u00c0\u00be\u00ef\u00ba\u00e0 10 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e0\u00be\u008a \u00c0\u00c4\u00b8\u00a8\u00e0, \u00a6\u00e0 \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00bc\u00e0\u00bc \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00c9\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00c9\u00be, \u00a6\u00e0 \u00c4\u00ea\u00dd \u00c4\u00ea\u00bc\u00c8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 ;\n\n32004 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba\n\n(ii)\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ef\u00ba\u00e0 23 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00a8\u00e0\u00cb\u00c6 \u00d1\u008a \u00cc\u00bf\u00cd\u00e5 \u00bc\u00fb\u00c4\u00be\u00e5\u00c9\u00a8\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a\u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00c9\u00ba\u00e0\u00a8\u00c4\u00a8\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0, \u00c8\u00ba\u00e0 \u00c4\u00ea\u00dd\u00c4\u00ea\u00bc\u00c8 ; \u00cc\u00cd\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc,\n\n(\u00a1) \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4, \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6,\u00c9 \u00b4\u008a, \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca, \u0097\u00be\u00f8\u00c4\u00c6, \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00ef\u00a8\u00e5\u0095\u00cc\u00e0\u00c4\u00ea\u00bc\u00c8\u00e0 \u00ba\u00e6\u00db\u008c \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00cc\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c9\u00f1\u00e5\u00c0\u00e5\u00d6\u00a8\u00a8\u00f2\u00e8\u00c6\u00e5\u00c4\u00e5\u00da\u00aa \u00c9\u00c8\u00bc\u00fb \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00b4 \u00a4\u00c0\u00bc\u00fa\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0 \u00a6\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c\u00c8\u00e6\u009f\u008a, \u00a6\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00c4\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00c8\u00cc\u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00ba\u00c9 \u00bc\n\n(\u00a1\u00e5) \u00c7\u00a8\u00e0\u00cb\u00b8 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4, \u00c8\u00e6\u00c2\u00ea\u00b8\u00ea\u00c7\u00a8\u00e0\u00cb\u00b8 \u00c9\u00e5\u00d6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c7\u00a8\u00e0\u00cb\u00b8 \u00c9\u00e5\u00d6\u00a8\n\n(i) \u00d5\u0097\u00ba \u00c7\u00a8\u00e0\u00cb\u00b8 ; \u00cc\u00cd\n\n(ii) \u00c9\u00e6\u00b6 \u00c9\u00da\u00b0\u00be, \u00a8\u00e6\u00c7\u00c8\u00e8 \u00ef\u00a8\u00e5\u00e0\u00c8\u00e5\u00cd\u00c8, \u00b0\u00be \u00a8\u00e6\u00ce\u00d0\u008a\u00ef\u00cd\u00e5\u00e0 \u00ba\u00f2\u00cc\u00e0\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5 \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0 \u00a1\u00c8\u00e5\u00c3 \u00cd\u00e5\u00be\u00e8 \u00ef\u00cd\u00e5\u00e0\u0097\u00be\u00e5\u00ca\u00d1\u008a \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c7\u00a8\u00e0\u00cb\u00b8 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00c7\u00a8\u00e0\u00cb\u00b8\n\n\u00a6\u00e0 \u00c7\u00a8\u00e0\u00cb\u00b8 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00c4\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00ef\u00be\u00e5\u00c9\u00be \u00ef\u00c8\u00cc \u00cc\u00e6\u00ce\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n3.(1) \u00c6\u008a \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0\u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00a8 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6,(\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0\u00c4\u00ba\u00eb \u201c\u00c0\u00ce\u00c4\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00ce \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u201d\u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u00a6\u00e0 \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00bc\u00e5\u00ce \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0\u00a1\u00b6\u00ea \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n\u00a1\u00bc\u00e5\u00ce \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5\u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 \u00cd\u00fa\u00c8\u008c \u00a8\u00ce\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n42004 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u00c0\u00cc\u00ea\u00c9 \u00ef\u00ca\u00e0\u00cb\u00c6\u00a8\u00e0 \u00ef\u00c9\u00ef\u00ba\u00e5\u00ba\u00e0, \u00a6\u00c6 (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0\u00c4\u00ba\u00eb \u201c\u00c0\u00ce\u00c4\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be \u00a1\u00bc\u00e5\u00ce\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u00c0\u00ce\u00c4\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00a8\u00ce \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00b4 \u00c0\u00cc\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be \u00a1\u00bc\u00e5\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00bc\u00e5\u00ce\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00a1\u00b6\u00ea \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
