    "chunk_text": "\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081 \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b1\u00b4\u00c6\u00b4\u00ba\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00c7\u00d0\u00af:-\n\n1\u00b0\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6, 1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 26 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00cc\u00b9\u00c7\u00c8\u00bb\u00cc\u00ba\u00bf\u00be\u00c7\u00b8\u00c7, \u00cc\u00c3\u00bb\u00c6\u0081 \u00cc\u00ba\u00bf\u00be\u00c7\u00b8\u00c7 \u008e\u00bb\u00c7\u00bc+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b6\u00af\u00c6\u00af\u00c8\u00bb\u00c7\u00af\u00c6\u00af\u00bf\u00c6\u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00b1\u00c6\u00b1+\u00c6\u00af\u00ba\u00c6 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a9\u00b8 \u00a9\u00d5\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\nH-22545\n\n\u00db\u0081\u00d9\u00ce\u00bc\n\n\u00d2\u00dd\u00af\u00c6\u00af\u00b9\u00c6 \u00cc\u00b9\u00bb\u00c7\u00c6\u00b0\n\n\u00cc\u00b9\u00c7\u00c8\u00bb \u00cc\u00ba\u00bf\u00be\u00c7\u00b8\u00c7\u00cc\u00c3\u00bb\u00c6\u0081 \u00cc\u00ba\u00c7\u00c1\u00be\u00c7\u00b8\u00c7\u008e\u00bb\u00c7\u00bc+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00b6\u00af\u00c6\u00af\u00c8\u00bb\u00c7\u00af\u00c6\u00af\u00bf\u00c6\u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00b1\u00c6\u00b1+\u00c6\u00af\u00b6\u00c6\u00ce\u00b6\u00af\u00c6\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n21999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 26 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00cc\u00b9\u00c7\u00c8\u00bb \u00cc\u00ba\u00bf\u00be\u00c7\u00b8\u00c7,\u00cc\u00c3\u00bb\u00c6\u0081 \u00cc\u00ba\u00bf\u00be\u00c7\u00b8\u00c7 \u008e\u00bb\u00c7\u00bc+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b6\u00af\u00c6\u00af\u00c8\u00bb\u00c7\u00af\u00c6\u00af\u00bf\u00c6\u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00b1\u00c6 \u00b1+\u00c6\u00af\u00ba\u00c6 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00c6 \u00a5\u00ce\u00b4\u00bb\u00bd\u00c7\u00c1\u00c0\u00c8\u00dc\u00c7\u00c8\u00ce\u00ba\u00cc\u00af\u00c7\u00ae\u00b4 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00d0\u00c0\u00cc\u00c1\u00c7\u0081 \u00bd\u00c7\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 (\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00c7\u00c6 \u201c\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00ba\u00c6\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6)\u00b0 \u00a3\u00b9\u00c6\u00cc\u00b9\u00bb\u00c7\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5 \u00a9\u00be\u00c6\u00be\u00c7 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd+\u00c6\u00af\u00bf\u00c8\u00df\u00ba\u00c6 \u00a3\u00d7\u00c1\u00c0\u00af\u00c6\u00d0\u00b6\u00c6 \u00cc\u00b6\u00c7\u00d5\u00af\u00c6\u00af\u00be\u00c7\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081 \u00a3\u00b6\u00bd\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af \u00c1\u00c0\u00af\u00c6\u00d0\u00b6\u00c6\u00cc\u00b6\u00c7\u00d5\u00af\u00c6\u00af\u00e2\u00ba\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0 \u00cc\u00b9\u00c7\u00d7 \u00a5\u00be\u00b1\u00c6\u00b1\u00c8\u00ce\u00b8\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00e2\u00ba\u00c6\u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00e2\u00ba\u00c6 \u008c\u00dd\u00ba\u00c6\u0089\u00bb\u00c7+\u00c6\u00d0 \u00a3\u00b6\u00ce\u00b8 \u00ba\u00c7\u00bd\u00c6\u00bd\u00e2\u00ba\u00c6 \u00db\u00e1\u00b6\u00c6\u00b6\u00b6\u00c6\u00d7\u00c1\u00db\u00ba\u00c6\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00db\u00ba\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n3\u00b0\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00ba\u00c6 \u00a3\u00ce\u00ba\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00cc\u00b9\u00c7\u00d7\u00af\u00c6\u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00bf\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b8\u00c1\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u00b8 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n(\u00a3) \u008e\u00bb\u00c7\u00bc+\u00c6\u00af\u00bf\u00c6, \u00b6\u00af\u00c6\u00af\u00c8\u00bb\u00c7\u00af\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00db\u0083\u008b\u00ba\u00c6 \u00b1\u00ba\u00bb\u00bb\u00c7\u00b6\u00c6\u00b6\u00c8\u00ce\u00bc\u00af\u00c6\u00e7\u00b4+\u00c6\u00af\u00bf\u00c6 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00ce\u00bd \u00da\u00b8\u00bc\u00ce\u00ba\u00b6\u00c6\u00b6\u00be\u00c6 ,\u00cd\u00b9 \u00d6\u00b6\u00be\u00c6 , \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6 , \u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b6\u00c6\u00b6\u00df\u00af\u00c6\u00d0\u00a7\u00b6\u00e2\u00b6\u00be\u00c6 ;\n\n(\u00a4) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00bb\u00c7\u00b6\u00c6\u00b6\u00c8\u00ce\u00bc\u00b6\u00c6 \u00b6\u00be+\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u00a7\u00b6\u008c\u00dc\u00ba\u00c6 , \u00a7\u00b9\u00b1\u00c7\u00c8\u00b9\u00c6\u00da\u00ba\u00c6\u00a3\u00ce\u00ba\u00b6\u00c8\u00dc\u00ba\u00c6 \u00cd\u00b6\u0088\u00c1\u00dd\u00ba\u00c6 \u00bb\u00c7\u00b6\u00c6\u00b6\u00c8\u00c7\u00c8\u00af\u00c7\u00c6\u00af\u00bf\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7\u00a5\u0083\u00be\u00c7\u00ba\u00c8\u00bb \u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf\u00af\u00c6 \u00af\u00ce\u00b4\u00b9\u00c6\u0089\u0088\u00af\u00c6\u00d0\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00cc\u00b6\u00c7\u00e1\u00ce\u00af \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00c1\u00c0\u00c8\u00b9\u00c7\u00d5 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00ce\u00bd \u00a3\u00d9\u00b1\u00c7\u00c8\u00af\u00c6\u00af\u008c\u00dd\u00ba\u00c6\u00da\u00cd\u00c1\u00c7\u00c7\u00c8\u0081 \u00b7\u00be\u0081\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00c1\u00b1\u00b6\u00c8\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c6 ;\n\n(\u00a5) \u00cc\u00b9\u00c7\u00d7\u00c1\u00af \u00db\u0083\u008b\u00ba\u00c6\u00af\u00bf\u00c8\u0081 \u00ba\u00b6 , \u00af\u00be\u00c7\u00b1\u00c7\u00bc \u00af\u00be\u00c6\u008c \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc \u00b7\u00be\u0081\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00b7\u00be\u00cd\u00b8\u00c7\u00ba\u00c6\u00da\u008c\u00b4\u00bb+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c6 ;\n\n(\u00a6) \u008e\u00bb\u00c7\u00bc+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00b6\u00af\u00c6\u00af\u00c8\u00bb\u00c7\u00af\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6, \u008c\u00ab\u00bb\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6\u00db\u0083\u008b\u00ba\u00c6 \u00ba\u00c7\u00c7\u00c6\u00af\u00c6\u00af\u00b6\u00c6\u00ce\u00b6\u00b6\u00c6 \u00b6\u00e1\u008c\u00bb \u00aa\u00ce\u00c0\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00aa\u00ce\u00b8\u00bb\u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00b4\u00c6\u00cd\u00b4\u00c7\u00dd\u00af\u00c6\u00d0\u00ba\u00c6, \u00cd\u00b7\u00c7\u00bb\u00c7\u00bf\u00c8\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6, \u00c1\u00bb\u00d7\u00db\u00b6\u00c8\u00c7\u00c6\u00b7\u00c6\u00cd\u00b6\u00c7\u00c7\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6, \u00b7\u00c8\u00c1\u00c7\u00bc\u00b5+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a7\u00b6\u008c\u00ce\u00bb\u00dc\u00ba\u00c6\u00c1\u00c0+\u00c6\u00d0\u00c1\u00d7\u00b4\u0081 \u00cc\u00b9\u00c7\u00d7\u008c\u00be\u00c6 \u00db\u0083\u008b\u00ba\u00c6 \u00b1\u00f2\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b1\u00f2\u00af\u00cd\u00b1\u00ce\u00c1 \u00a3\u0088\u00b9\u00c6\u00b9\u00ce\u00b4\u008a\u00be\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00af\u00be\u00c6\u008c\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b9\u008a\u00bd\u00c6\u00b1\u00c8 \u00c1\u00b1\u00b6\u00c8\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00aa\u00ce\u00b8\u00bb \u00a9\u00be\u00c6\u00be\u00c7\u008c\u00b6\u008c\u00c1\u00bc\u00b5 \u00b7\u00c8\u00c1\u00c7\u00bc\u00b5+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6 ;\n\n(\u00a7) \u00da\u00b8\u00c8\u00b6 \u00d0\u00c7\u00c6\u00a4\u00ce\u00b8\u00dc\u00ba\u00c6, \u00a3\u00bd\u00ce\u00b9\u00dc\u00ba\u00c6 \u00af\u00bd\u00c6\u0089\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0 \u00db\u0083\u008b\u00ba\u00c6\u00b1\u00ba\u00bb\u00b9\u00c6 \u00b9\u00c7\u00b4\u00b1\u00c7\u00ce\u00be\u00af\u00ce\u00bf \u00b7\u00c8\u00de\u00e2\u00b6\u00df\u00ba\u00c6 \u00a3\u00c1\u00bd\u00c6\u00ce\u00bd\u00b9\u00c6\u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 ;\n\n\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00b9\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00cc\u00b9\u00c7\u00d7\u00af\u00c6\u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00bf\u00c6\u00b0\n\n31999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 26 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00cc\u00b9\u00c7\u00c8\u00bb \u00cc\u00ba\u00bf\u00be\u00c7\u00b8\u00c7,\u00cc\u00c3\u00bb\u00c6\u0081 \u00cc\u00ba\u00bf\u00be\u00c7\u00b8\u00c7 \u008e\u00bb\u00c7\u00bc+\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b6\u00af\u00c6\u00af\u00c8\u00bb\u00c7\u00af\u00c6\u00af\u00bf\u00c6\u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00b1\u00c6 \u00b1+\u00c6\u00af\u00ba\u00c6 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6"
  },
