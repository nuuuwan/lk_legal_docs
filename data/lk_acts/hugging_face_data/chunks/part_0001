    "chunk_text": "(\u00a4) \u00ad\u00bb\u00c6\u00e2[\u00b6\u00c8\u00bb\u00b6\u00c6 \u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a7\u00b6\u00e2 \u00cc\u00b6\u00c7\u00ce\u00af\n\n\u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b7\u00c7\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c7\u00af \u00a5\u00dd\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0 3\u00a4\u00ba\u00c6\n\n\u0089\u00c7\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 3\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00c8\u00c7\u00c8\u008c\u0081 \u00af\u00c9\u00c0\u00c6,\n\n\u008c\u00dd\u00b9\u00c6\u00da\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c8\u008c\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00c7\u00b6 \u00c1\u00dd\u00ba\u00c7\u00b8,\n\n\u00a4\u00cc\u00bf\u00c1\u00dd\u00ba\u00c6 \u00af\u00cc\u00b1\u00bd\u00c6\u00bd\u00c8\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00f2\u00be\u00ba\u00c6 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c7\u00be\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b6\u00c8\u00af\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u0081\u00b8\u00c7\u00c6\n\n\u00ad\u00bb\u00c6\u00e2[\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a7\u00b6\u00e2\u00cc\u00b6\u00c7\u00ce\u00af \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b7\u00c7\u00c6\n\n\u00ac\u00dd\u00c1\u00bc\u00c7\u00af \u00c1\u00dd\u00c1\u00b6\u00bd\u00c6\u00d0 \u008c\u00dd\u00b9\u00c6\u00da\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c8\u008c\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\n\n\u00a4\u008a\u00d9\u00ba\u00c6, \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c7\u008a\u00d9\u00ba\u00c6, \u00a5\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\n\n\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00a4\u00dc\u00b6\u00b7\u00c6 \u00b6\u00c7+\u00c6\u00af\u00c8\u00bb \u00b9\u00ce\u00b4\u00af\u00cf\u00c8\u0081 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\n\n\u00ac\u00dd\u00c1\u00c7\u00c6 \u00a5\u00b9\u00c6\u0089\u00c7\u00c8\u00e2 \u00c1\u00df\u00e2\u00af\u00c6\u00d0 \u00c1\u00dd\u00c1\u00b6\u00bd\u00c6\u00d0 \u00db\u0081\u00b8\u00c7\u00c6\n\n\u00a5\u00bd\u00b7\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u0081 \u00af\u00c9\u00c0\u00c6\n\n\u008c\u00dd\u00b9\u00c6\u00da\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c8\u00e2 \u00ac\u0081\u00ce\u00bd\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00c7\u00d7 \u00a5\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\n\n\u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00c8\u00af\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u0081\u00b8\u00c7\u00c6 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7,\n\n\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c6, \u00a3\u00c1\u00c7\u00c6 \u00ac\u00dd \u00ba\u00ce\u00b8\u008c \u00a3\u00be\u00c6\u00be\u00d7\n\n\u0089\u00cf\u00c6\u00ce\u00bf\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00dd \u00ba\u00ce\u00b8\u008c\u00ce\u00bb\u00dc\u00ba\u00c6\n\n\u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u008c\u00b4\u00c6\u00d5\u00b1\u00c6 \u00cc\u00b1\u0081\u00bd\u00c8\u00dd\u00b9\u00c6\u0089\u0081 \u00ad\u00bb\u00c6\u00e2[\u00b6\u00c8\u00bb\u00b6\u00c6\n\n\u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a7\u00b6\u00e2\u00cc\u00b6\u00c7\u00ce\u00af \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b7\u00c7\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c7\u00af\n\n\u00a5\u00dd\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0 \u008c\u00dd\u00b9\u00c6\u00da\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c8\u008c\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf\u00c7\u00cc\u00bc\u00b8\u00af\u00c6\n\n\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00ad\u00bb\u00c6\u00e2[\u00b6\u00c8\u00bb\u00b6\u00c6 \u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a7\u00b6\u00e2\u00cc\u00b6\u00c7\u00ce\u00af\n\n\u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b7\u00c7\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c7\u00af \u00c1\u00dd\u00c1\u00b6\u00bd\u00c6\u00d0 (1) \u00a4\u00ba\u00c6\n\n\u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u008c\u00dd\u00b9\u00c6\u00b9\u00ba\u00c6 \u00cc\u00b6\u00c7\u00c8\u008c\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf \u00a4\u00bf\u00c6\n\n\u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00c1\u00dd\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00ad\u00bb\u00c6\u00e2[\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\n\n\u00a7\u00b6\u00e2\u00cc\u00b6\u00c7\u00ce\u00af \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b7\u00c7\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c7\u00af \u00c1\u00dd\u00c1\u00b6\u00bd\u00c6\u00d0\n\n\u00c1\u00c8\u00dd\u00b9\u00c6\u00da\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c8\u008c\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf\u00c7\u00cc\u00bc\u00b8 \u00a5\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\n\n\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00c7\u00c8\u0081 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\n\n\u00a5\u00bd\u00b7\u00c6\u00b6 \u00a4\u00bf\u00c8\u00b8\u00c6 \u00a3\u00df\u00c1\u00be\u00c6\u00af\u00ce\u00bf \u00b7\u00c8\u00c7\u00c6\u00c1\u00af\u00c8\u00af\u00c6\u00d0\u00ba\u00c6\n\n\u00a4\u00bf\u00c6, 1968 \u00ac\u00bd\u00c6\u00cd\u00bd\u00c7\u00b9\u00c7\u00c6 1 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00c8\n\n\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cd\u00af\u00bd\u00c6\u00bd\u00c1\u00c7\u00de \u00a5\u00ce\u00bf\u00b9\u00c6\u00b9\u00c7\u00de\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8\u008a\u00be\u00c6\n\n\u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8\u00bb\u0081\u00de \u00db\u0088\u00c1\u00ce\u00b4\u00af\u00c8\u0081\u00bd\n\n\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00c7\u00b8 \u00a7\u00b6\u00e2\u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00cf\u00c8\u0081 \u00a9\u00be\u00c6\u00be\u00c7\n\n\u00b7\u00c8\u00df\u00ce\u00c1\u00af\u00ce\u00cf\u00dc\u00ba\u00c6 \u00a3\u00b6\u0081 \u00ba\u00c9\u00d7 \u00a4\u00ae\u00cc\u00b4\u00c7\u0081\u00de\u00af\u00c6\u00d0\n\n\u00b7\u00c7\u0081\u00d0 \u00b1\u00b6\u0096\u00b6\u00b9\u00c6\u00b9\u0088 \u00c1\u00b4\u00c6\u0088\u00dc\u00b4\u0081 \u00cd\u00b1\u00c7\u00c6\u00b6\u00c6\u00d7\n\n\u00ad\u00bb\u00c6\u00e2[\u00b6\u00c8\u00bb\u00b6\u00c6 \u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n31999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 55 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u008c\u00b6\u00ce\u00c1\u00af\u00bf\u00c6,\u00a3\u00b7\u00c7\u00ce\u00b6\u00af\u00bf\u00c6 \u00ad\u00bb\u00c6\u00e2[\u00b6\u00c8\u00bb\u00b6\u00c6 \u00b6\u00c8\u00b4\u00c6\u00b4\u00ba\u00c6 (\u00a4\u00dc\u00b6\u00b7\u00c6 \u00b6\u00c7+\u00c6\u00af\u00c8\u00bb\u00b9\u00ce\u00b4\u00af\u00bf\u00c6) (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6\u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf\u00a7\u00ce\u00bc \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n(3) \u00db\u00b6\u00be\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ac\u00dd \u008c\u00dd\u00b9\u00c6\u00da\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c8\u00c1\u00c7\u00b8\u00d7\u00db\u0088\u00c1\u00c7\u00b8\u00b6\u00c7\u00af\u008c\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(4) \u00a5\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6, 3 \u00a4\u00be\u00c6\u00be\u00d73\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00c7\u00c8\u00e2\u00af\u00e0\u00af\u00c6\u00d0 \u00db\u00bc\u00b5\u00c7\u00af \u00a9\u00d7 \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c8\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6, \u00b9\u00bb\u00d9\u00de\u00c1\u00b6\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\n\n3. \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00af\u00c6\u00d0\u00ba\u00c6 \u00b6\u00ba\u00c8\u00c0\u00c6 \u00a7\u00ce\u00bc\u00af\u00c6\u00d0\u00ba\u00c8\u00ce\u00b4\u00cd\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00af\u00c7\u00b5\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6,\u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00bb \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8 \u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0"
