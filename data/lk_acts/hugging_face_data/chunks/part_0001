    "chunk_text": "(\u00a1\u00e5) \u00cc\u00e0\u00c9\u00ef\u00bc\u00e0\u00ca \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u0097\u00cb\u00c6\u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0\u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a6\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00a8\u00eb ;\n\n21999 \u00a1\u00e2\u00a8 54 \u00bc\u00c7\u00be \u00c7\u00b8\u0097\u00c7\u00e6 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba\n\n(\u00a1\u00e6) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c6\u00ea\u00bc\u00e0\u00bd \u00cd\u00c4\u00ea\u00bc\u00e5\u00ef\u008c \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb (\u00ca\u00eb\u00c3\u00cc\u00e5\u00bd\u00be \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb) ;\n\n(\u00a2) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00aa\u00eb\u00c9\u00be\u00e0 \u00cd\u00c4\u00ea\u00bc\u00e5\u00ef\u008c \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb (\u00ca\u00eb\u00c3\u00cc\u00e5\u00bd\u00be \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb) ;\n\n(\u00a3) \u00ca\u00eb\u00c3\u00cc\u00e5\u00bd\u00be \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00c3\u00e5\u00c7 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1 \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0\u00c0\u00ba\u00e8\u00c9\u00c7\u00c6\u00e5 ;\n\n(\u00a4) \u00c7\u00e5\u00b0\u00f1 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0\u00ef\u00cc\u00e0\u00c9\u00e5 \u00c9\u00be\u00f8\u00ba\u00e5 \u00a6\u00e0\u00a8\u00a8\u00ef\u00c6\u00e0 \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8 ;\n\n(\u00a4\u00f0) \u00c7\u00e5\u00b0\u00f1 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0\u00c0\u00f2\u00bd\u00e5\u00be \u00aa\u00b8\u00a8\u00e5\u0093\u00a8\u00e5\u00d6\u00c9\u00c7\u00c6\u00e5 ;\n\n(\u00a6) \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00cb\u00c6\u00c6 \u00c3\u00e5\u00c7 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c4\u00cd\u00e5\u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7\u00ef\u00c6\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00a8\u00eb ;\n\n(\u00a6\u00e0) \u00b0\u00be\u00e5\u0093\u00c0\u00ba\u00e8\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ba\u00f8\u00ef\u00bc\u00be\u00a8\u00eb ; \u00a6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00a1\u00ba\u00eb\u00ef\u00c7\u00be\u00e0 \u00c6\u00b4\u00ba\u00e0 \u00c0\u00e8\u00d6\u00ef\u00cc\u00c6\u00e8\u00be\u00e0\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00ef\u00bc\u00ef\u00bc\u00be\u00a8\u00eb \u00ef\u00ef\u00c9\u00bc\u00f1 \u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u00cd\u00e5 \u00be\u00f8\u00ba\u00f9\u00b3\u00c9\u00ee\u00ba\u00e0\u00ba\u00e8\u00ef\u00c6\u00cd\u00fa \u00ef\u00c6\u00bc\u00fb \u00cc\u00e8\u0090\u00be \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00a1\u00ba\u00eb\u00ef\u00c7\u00be\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u00ef\u008a \u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0\u00c4\u00ba\u00eb \u201c\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00e5\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n(2) \u00b0\u00be\u00e5\u0093\u00c0\u00ba\u00e8\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00a1\u00ba\u00eb\u00ef\u00c7\u00be\u00e0\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00c3\u00e5\u00c0\u00ba\u00e8\u00c9\u00c7\u00c6\u00e5 \u00cc\u00cd \u00a4\u00c0\u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00cd\u00e8 \u00cc\u00bf\u00cd\u00be\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00bd\u00ea\u00c7 \u00a8\u00e5\u00c8\u00c6, \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00b4\u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c0\u00e5\u00d6\u00ca\u00f2\u0095\u00a8, \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00db\u00cc\u00e0\u00d1\u008a \u00cd\u00e5 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c4\u00ea\u00f7\u00e5\u00c9\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n4.\u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0 \u00a8\u00da\u00ba\u00c9\u00f1 \u2013\n\n(\u00a1) \u00a8\u00f2\u00e8\u00c6\u00e5\u00be\u00e0\u0097\u00ba\u00ef\u00c6\u00e0 \u00bc\u00e9 \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00c2\u00c9\u00b4 \u00c0\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00cc\u00be\u00e0\u00be\u00bc\u00e0\u00bd\u00cd\u00c4\u00ea\u00bc\u00e5\u00c9\u00c8 \u00cc\u00cd \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00cd\u00c4\u00ea\u00bc\u00e5\u00ef\u008c \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c0\u00cc\u00ea \u00a4\u00c9\u00b4\u00e6\u00be\u00cc\u00cd, \u00a7\u00c9\u00ea\u00be\u00e0 \u00c0\u00ea\u00be\u00c7\u00e6\u00ba\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00e8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00cc\u00e6\u00c8\u00e6\u00cc\u00e0\u00d1\u00c4 ;\n\n(\u00a1\u00e5) (i) \u00a8\u00f2\u00e8\u00c6\u00e5\u00be\u00e0\u0097\u00ba\u00ef\u00c6\u00e0 \u00bc\u00fb \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00c2\u00c9\u00b4 \u00c0\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00cc\u00be\u00e0\u00be\u00bc\u00e0\u00bd\u00cd\u00c4\u00ea\u00bc\u00e5\u00c9\u00c8 \u00cc\u00cd \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00cd\u00c4\u00ea\u00bc\u00e5\u00ef\u008c \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00b4 ; \u00cc\u00cd\n\n\u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0\u00a8\u00da\u00ba\u00c9\u00f1.\n\n1999 \u00a1\u00e2\u00a8 54 \u00bc\u00c7\u00be \u00c7\u00b8\u0097\u00c7\u00e6 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba3\n\n(ii) \u00a8\u00f2\u00e8\u00c6\u00e5\u00be\u00e0\u0097\u00ba\u00ef\u00c6\u00e0 \u00bc\u00e9 \u0095\u00c6\u00aa\u00fa\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00cc\u00e5\u00c6\u00e5\u00aa\u00ba \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8\u00c9\u00cc\u00e8\u0090\u00be \u00cc\u00be\u00e0\u00be\u00bc\u00e0\u00bd \u00cd\u00c4\u00ea\u00bc\u00e5\u00c9\u00c8 \u00cc\u00cd \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00cd\u00c4\u00ea\u00bc\u00e5\u00ef\u008c\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00c6\u00e6\u00ef\u00c0\u00be\u00e0\u00be\u00be\u00e0\u00b4 ;\n\n\u00be\u00f8\u00c9\u00e5\u00cc \u00cc\u00e6\u00c0\u00c6\u00e9\u00c4 \u00cc\u00cd \u00a6\u00cd\u00e8 \u00c8\u00e5 \u00cc\u00cd\u00e5\u00c6 \u00d1\u00c4 ;\n\n(\u00a1\u00e6)(i) \u00a8\u00f2\u00e8\u00c6\u00e5\u00be\u00e0\u0097\u00ba\u00ef\u00c6\u00e0 \u00bc\u00fb \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00c2\u00c9\u00b4 \u00c0\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00cc\u00be\u00e0\u00be\u00bc\u00e0\u00bd\u00cd\u00c4\u00ea\u00bc\u00e5\u00c9\u00c8 \u00cc\u00cd \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00cd\u00c4\u00ea\u00bc\u00e5\u00ef\u008c \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00b4 ; \u00cc\u00cd\n\n(ii) \u00a8\u00f2\u00e8\u00c6\u00e5\u00be\u00e0\u0097\u00ba\u00ef\u00c6\u00e0 \u00bc\u00fb \u0095\u00c6\u00aa\u00fa\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00cc\u00e5\u00c6\u00e5\u00aa\u00ba \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8\u00c9\u00cc\u00e8\u0090\u00be \u00cc\u00be\u00e0\u00be\u00bc\u00e0\u00bd \u00cd\u00c4\u00ea\u00bc\u00e5\u00c9\u00c8 \u00cc\u00cd \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00cd\u00c4\u00ea\u00bc\u00e5\u00ef\u008c\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00c6\u00e6\u00ef\u00c0\u00be\u00e0\u00be\u00be\u00e0\u00b4\n\n\u00ef\u00ef\u00c9\u00bc\u00f1 \u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00cc\u00cd \u00a6\u00cd\u00e8 \u00c8\u00e5 \u00cc\u00cd\u00e5\u00c6 \u00d1\u00c4 ;\n\n(\u00a1\u00e7)(i) \u00a8\u00f2\u00e8\u00c6\u00e5\u00be\u00e0\u0097\u00ba\u00ef\u00c6\u00e0 \u00bc\u00e9 \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00c2\u00c9\u00b4 \u00c0\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00cc\u00be\u00e0\u00be\u00bc\u00e0\u00bd\u00cd\u00c4\u00ea\u00bc\u00e5\u00c9\u00c8 \u00cc\u00cd \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00cd\u00c4\u00ea\u00bc\u00e5\u00ef\u008c \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00b4 ; \u00cc\u00cd"
