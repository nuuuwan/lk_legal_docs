    "chunk_text": "\u00a3\u00b6\u00c8\u00be\u00c6 \u00a6\u00d5\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00e0\u00b4\u0081, \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\n\n\u00af\u00ba\u00c6\u00b9\u00b8\u00c8\u00dc\u00b4\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00dc\u00b4\u0081\u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00ce\u00bf\u00b9\u00c6 \u00b9\u00af\u00c8\u00c7\u00c6\u00b6\u00be\u00c6, \u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00af\u00ce\u00bf \u00ac\u00b8\u00c6\u00de\n\n\u00cd\u00b1\u00c7\u00c6\u00b6\u00c6\u00b6\u00be\u00c6, \u00ac\u00b6\u00c6\u00d7\u00ce\u00c0\u00b6\u00c6\u00b6\u00be\u00c6, \u00e7\u00b4\u00c6\u00d5\u00db\u00bb\u00bd\u00c6\u00b1\u00c8, \u00b9\u00bc\u0083\u00b9\u00bc\u00b1\u00df\u00ce\u00af \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00de\u00af\u00c6\u00af\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de\u00c1\u00ce\u00af\u00bb\u00c7\u00af\n\n\u00a7\u00b4\u0081\u00b9\u00c7\u00b4\u00c6\u00cc\u00b4\u00c7\u00e1+\u00c6\u00d0\u00af\u00ce\u00bf\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00d7 \u00cc\u00af\u00c7\u00bf\u00c6\u00e0\u00b6\u00be\u00c6;\n\n\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af \u00f2\u00be\u00db\u00ba\u00c6,\u00a3\u00af\u00c8\u00ba\u00c6\u00ce\u00b1 \u00db\u00ce\u00bd \u00a5\u00ce\u00b4\u0094\u00d5\u00af\u00bf\u00c8\u00be\u00c6\u00b9+\u00c6\u00d0 \u00b9\u00bd\u00c6\u00de\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6,\u00b1\u00ba\u00c7\u00b6\u00c7\u00b8 \u00a8\u00c7\u00c6\u00c1\u00be+\u00c6\u00af\u00bf\u00c6,\n\n\u00b1\u00ba\u00c7\u00b6\u00c7\u00b8 \u00ba\u00c7\u00b7\u00c7\u00d5\u00af\u00bf\u00c6, \u00b1\u00ba\u00c7\u00b6\u00c7\u00b8\u00af\u00c6 \u00af\u00be\u00c6\u008c \u00b7\u00c8\u00af\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4+\u00c6\u00af\u00bf\u00c6, \u00b1\u00ba\u00c7\u00b6\u00c7\u00b8\u00b9\u00c6 \u00b9\u00c7\u00b1\u00ce\u00bd\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de\n\n\u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00cd\u00b9\u00c7\u0081\u00bd \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c8\u00be\u00c6\u00ba\u00ce\u00bd\u00db\u00af\u00ba\u00c7\u00af\u00b9\u00c6 \u00b9+\u00c6\u00d0\u00b9\u00bd\u00c6\u00de\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00df\u00bf\u00c6\u00bf \u00b9\u00be\u00c6\u00cd\u00c1\u00de \u00a5\u00b8\u00b6\u00c6\u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u00af\u00ce\u00bf\u00b1\u00c6\u00b1\u00c7\u00c7\u00c6\u00b7\u00c6\u00b6 \u00ba\u00af\u00c6\u00af\u00bf\u00c8\u00ce\u00b4\u00cd\u00bb \u00a3\u00ce\u00ba\u00b6\u00c8\u00ce\u00bb \u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c6 ;\n\n(14) \u00ba\u00b8\u00c8\u00b6 \u00a7\u00c7\u00c8\u00ce\u00ba\u00af\u00e0\u00ba\u00c6 \u00a3\u0088\u00b9\u00c6\u00b9\u00ce\u00b4\u00b1\u00c6 \u00d2\u00b6\u00b7\u00c6\u00b6\u00c8\u00bc+\u00c6\u00af\u00e0\u00ba\u00c6\n\n\u00a3\u00c1\u00b6\u00c7\u00b8\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00a3\u00ce\u00b8\u00b6\u00c6\u00d7\u00be\u00af \u00ba\u00b6\u00c8\u00b9\u00c6\u00ce\u00b9\u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00c7\u00d5\u00b9\u00d5\u00b6\u00df\u00ba\u00c6, \u00b1\u00c7\u00c6\u00c1\u00cd\u00b6\u00b1\n\n\u00ba\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00df\u00ba\u00c6 \u00db\u0081\u00cd\u00b8\u00bd\u00c6\u00bd\u00af\u00bc\u00ba\u00c7\u00b8 \u00c1\u00c0\u00c8\u00c1\u00ce\u00af\u00af\u00bf\u00c6 \u00f2\u00be\u00ba\u00c6\u00a3\u00ce\u00c1 \u00a3\u00ce\u00b8\u00b6\u00c6\u00d7\u00be\u00af\u00c8\u00df\u00ba\u00c6 \u00a3+\u00c6\u00af\u00c9\u00af\u00c7\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\n\n\u00a3\u00c1\u00b6\u00c7\u00b8\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00ce\u00b8 \u00a7\u00de\u00b6\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 ;\n\n(\u00a6) \u00a3\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081 \u00ba\u00c9\u00bf \u00a5\u00be\u00af\u00c6\u00af\u00ba\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 (15) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u00c1\u00c8\u00be\u00c6\u201c\u00a7\u00b5\u00e2, \u00af\u00ba\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00b9\u00b4\u00c6\u0088\u00b8\u00c8 \u00ac\u00c0\u00c8\u00b9\u00c6\u00da\n\n\u00a5\u00bb\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u201d \u00a9\u0081\u00bd \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af,\u201c\u00a9\u00c1\u00c6\u00b0\u00aa\u00b0\u00ad\u00b0,\u00dc[\u00b0\u00a9\u0081\u00b0\u0096.\u201d \u00a4\u00af\u00c8\u00bb \u00d2\u00dd\u00af\u00c6\u00af+\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\n\n\u00f2\u00be\u00db\u00ba\u00c6.\n\n41999\u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af,\u00a5\u00be+\u00c6\u00ce\u00af \u00b2\u00c7\u00b6\u00c8\u00af\u00b1\u00c7\u00c6\u00cd\u00c1\u00c7\u00b6\u00bb \u00b1\u00c8\u00bc\u00ba\u00b6\u00c7\u00b8\u00b1\u00c6 \u00b1+\u00c6\u00af\u00ba\u00c6 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6)(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n3 \u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 4 \u00a4\u00ba\u00c6 \u0089\u00c7\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n(\u00a3) \u00a3\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u00be\u00c6, \u201c \u00b9\u00b6\u008c\n\n\u00b6\u00c7+\u00c6\u00d0\u00b7\u00c7\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u201c\u00b9\u00b6\u008c\u00b6\u00c7+\u00c6\u00d0\u00b7\u00c7\u00c6 \u00d0\u00e1\u00ce\u00c1\u00dc\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6\n\n\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u008a\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a4) \u00a3\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081 (2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u00c1\u00c8\u00be\u00c6, \u201c\u00a3\u00b6\u0081 \u00b9\u00b5\u00c8\u00af\u00e0\u00bf\u00c6\u00a9\u00b6\u00ce\u00b8\u00dc\u00ba\u00c6 \u00ac\u0081\u00cd\u00bd\u00c7 \u00b9\u00be\u00cd\u00c1\u00c7\u00c1\u00c7\u00bb \u00b7\u00c8\u00ce\u00be\u008a\u00bb\u00bd\u00c6\n\n\u00d0\u00e1\u00af\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af,\u201c\u00a3\u00b6\u00b8\u00c6 \u00b9\u00b5\u00c8\u00af\u00e0\u00bf\u00c6 \u00a9\u00b6\u00ce\u00b8\u00dc\u00ba\u00c6 \u00b9\u00b6\u008c\u00b6\u00c7+\u00c6\u00d0\u00b7\u00c7\u00c6 \u00d0\u00e1\u00e2\u00af\u00c6\u00d0\n\n\u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u0081\u00cd\u00bd\u00c7 \u00b9\u00be\u00cd\u00c1\u00c7\u00c1\u00c7\u00bb \u00b7\u00c8\u00ce\u00be\u008a\u00bb\u00bd\u00c6\u00d0\u00e1\u00af\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u008a\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6.\n\n4 \u00b0 \u00db\u00b6\u00b8\u00c6\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 6 \u00a4\u00ba\u00c6 \u00b9\u00c8\u00c7\u00c8\u00e2,\u00a3\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081\n\n(1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u00be\u00c6 \u201c \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00bd\u00ce\u00c1\u008a\u0081\u00b9\u00b6\u008c\u00b6\u00c7+\u00c6\u00d0\u00b7\u00c7\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00aa\u00ce\u00b8\u00bb \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6\n\n\u00af\u00b4\u00ce\u00ba\u00af\u00ce\u00bf\u00b9\u00c6 \u00da\u00c7\u00c8\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af,\u201c\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00b9\u00b6\u008c\u00b6\u00c7+\u00c6\u00d0\u00ba\u00c6 \u00d0\u00e1\u008c\u00b8\u00d7\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bd \u00cd\u00c1\u00bd\u00c6\u00bd\u00ce\u00c1\u008a\u0081\n\n\u00aa\u00ce\u00b8\u00bb \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00af\u00b4\u00ce\u00ba\u00af\u00ce\u00bf\u00b9\u00c6\u00da\u00c7\u00c8\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6,\u00b1\u00c7\u00c6\u00cd\u00c1\u00c7\u00b6\u00bb\u00b6\u00c6\u00cd\u00b6\u00c7\u00d5 \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u00da\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc\n\n\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cd\u00b1\u00ba\u00b7\u00be\u00af\u00c6 \u00e7\u00de\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00b6\u00c7\u0089\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6, \u00b9\u00b6\u008c\u00b6\u00c7+\u00c6\u00d0\u00b7\u00c7\u00c6 \u00d0\u00e1\u00ce\u00c1 \u00a3\u00ce\u00ba\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6\n\n\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7."
  },
