    "chunk_text": "\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\n\n1999 \u00a1\u00e2\u00a8 34 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n[\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00ef\u00ce\u00e0 1999 \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u00c2\u00da \u00c4\u00cc 07 \u00c9\u00e6\u00be\u00e8 \u00bc\u00e8\u00be]\n\n\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00be\u00f8\u00c6\u00c4\u00c6 \u00c0\u00d6\u00bc\u00fa \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00e9.\n\n1999 \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u00c2\u00da \u00c4\u00cc 08 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00e9 \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0\u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 II \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00a1\u00ba\u00e8\u00ef\u00da\u00a8\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00ce\u00a8\u00c7\u00be \u00c8\u00bc\u00e9.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c4\u00ea\u00f7\u00b8 \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00e9.\n\n\u00ef\u00a8\u00e5\u00ce\u00c5 1, \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be \u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00ef\u00c6\u00be\u00e0 \u0095\u00c8\u00bc\u00fb \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8\u00c6.\n\n\u0095\u00ce : \u00c7\u00e6. 3.50\u00ba\u00e6\u00c0\u00e6\u00c8\u00e0 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 : \u00c7\u00e6. 3.50\n\n(\u00a1\u00be\u00e0\u00ba\u00da\u00b0\u00e5\u00c8 \u00a1\u00be\u00ea\u00c9\u00e5\u00bc\u00c6\u00a8\u00f8.)\n\n1999 \u00a1\u00e2\u00a8 34 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n[\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00ef\u00ce\u00e0 1999 \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u00c2\u00da \u00c4\u00cc 07 \u00c9\u00e6\u00be\u00e8 \u00bc\u00fa\u00be]\n\n\u00a6\u00c8\u00e0.\u009c.\u2013\u2013\u0081. 62/98.\n\n1979 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00c0\u00be\u00ba\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c0\u00be\u00ba\u00a8\u00f8\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00c4\u00ef\u00cc\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2013\u2013\n\n1. \u00ef\u008a \u00c0\u00be\u00ba 1999 \u00a1\u00e2\u00a8 34 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00e8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n2. (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00e8\u00c6\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be) 1979 \u00a1\u00e2\u00a8 02 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00c0\u00be\u00ef\u00ba\u00e0 6 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6, \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4,\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0, \u00ef\u00c4\u00c6\u00e8\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2013\u2013\n\n\u201c(\u00a1\u00e5\u00a1\u00e5) (i)\u00c0\u00bc\u00fa\u00e2\u008e\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00be\u00f8\u00c9\u00cc\u00a8\u00e0 \u00ba\u00e6\u00be\u00f9\u00c4\u00b4 \u00a2\u00b6\u00c4\u00a8\u00e0 \u0095\u00c8 \u00bc\u00fb\u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00bc\u00e0\u00bc\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 ;\n\n(ii) \u00c0\u00bc\u00fa\u00e2\u008e\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00be\u00f8\u00c9\u00cc\u00a8\u00e0 \u00ba\u00e6\u00be\u00f9\u00c4,\u00a1\u00f5\u00ba\u00e0\u00c9\u00e6\u0091\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4,\u00c0\u00f2\u00ba\u00f8\u00cc\u00e2\u00cc\u00e0\u00a8\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00a6\u00a8\u00ba\u00eb \u00a8\u00e8\u00d7\u00c4\u00cc\u00bf\u00cd\u00e5 ;\n\n(iii) \u00c0\u00bc\u00fa\u00e2\u008e\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00be\u00f8\u00c9\u00cc\u00a8\u00e0 \u0095\u00c8 \u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00bc\u00e0\u00bc\u00b4\u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 ;\n\n(iv) (i) \u00c9\u00be, (ii) \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 (iii) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c9\u00c8 \u00cc\u00bf\u00cd\u00be\u00e0\u00a8\u00e5\u00da\u00c6\u00c9\u00c8\u00b4 \u00a1\u00e5\u00be\u00ea\u00cb\u00e2\u00aa\u00fa\u00a8, \u00a1\u00ba\u00e8\u00ef\u00da\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00ea\u00c6\u00e5\u00ba \u00c9\u00be\u0081\u00be\u00e7\u00c4 \u00a8\u00e5\u00da\u00c6\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 ; \u00ef\u00cd\u00e5\u00e0\n\n(v) (i) \u00c9\u00be, (ii) \u00c9\u00be, (iii) \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 (iv) \u00c9\u00be\u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c9\u00c8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00a8\u00e5\u00da\u00c6\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00bc\u00e6\u00be\u00b4\u00c4\u00ba\u00e0\u00bc\u00c7\u00e5 \u00a1\u00e6\u00ba\u00e8 \u00b8\u00c6\u00a8\u00e0 \u00ef\u0089\u00c7\u00e6\u008a \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5,\n\n\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00eb\u00b4 \u00b8\u00c6 \u00cc\u00cd \u00a1\u00ba\u00e0\u00ba\u00f8\u00a8\u00e5\u00c7\u008a \u00c8\u00c2\u00e5\u00bc\u00fb\u00c4.\u201d.\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6.\n\n1979 \u00a1\u00e2\u00a8 02 \u00bc\u00c7\u00be\u00c0\u00be\u00ef\u00ba\u00e0 6 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\nH-022545\n\n1999 \u00a1\u00e2\u00a8 34 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n2\n\n\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c0\u00be\u00ba\u00e0 \u00ef\u00a8\u00b4\u00ea\u008a\u00c0\u00ba\u00e0\u00c9\u00c8 \u00cc\u00cd \u00c0\u00be\u00ba\u00e0\u00c9\u00c8 \u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00bc\u00e5\u00c6\u00a8 \u0095\u00c8 (\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6) \u00c7\u00e6. 870 \u00a8\u00f8. (\u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6)\u00c7\u00e6. 1,160 \u00a8\u00f8. \u00a1\u00e2\u00a8 32, \u00b4\u00f2\u00e5\u00be\u00e0\u00cc\u00e0\u00c9\u00da\u00a8\u00e0\u00cc\u00e0 \u00c4\u00be\u00e0\u00bc\u00fa\u00c7\u00c6, \u00ef\u00c8\u00e5\u00e0\u00b4\u00cc\u00e0 \u00c0\u00e5\u00c7, \u00ef\u00a8\u00e5\u00ce\u00c5 01, \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be \u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c9\u00ba \u00cc\u00e7\u00c4 \u00c9\u00da\u00cb\u00c6\u00a8\u00c4 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 15 \u00c9\u00e6\u00be\u00f8 \u00bc\u00e8\u00be\u00b4 \u00ef\u00c0\u00c7 \u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00aa\u00c9\u00e5 \u00c0\u00cc\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00da\u00cb\u00c6\u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0\u00c9\u00e5 \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8\u00c6."
