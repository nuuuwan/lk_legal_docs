    "chunk_text": "(25) \u0ba4\u0b95\u0b95\u0bba\u0baa\u0baf1 \u0ba4\u0b95\u0b95\u0bba\u0baa\u0baf \u0bab\u0bba\u0ba8\u0b95\u0bad \u0b9a\u0baa\u0baa 2 \u0bb2\u0bae\u0b95\u0bcd\u0b95\u0bba\u0ba4\u0baa\u0bba\u0baf \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 3 \u0b95\u0bb2\u0bbf\u0b95\u0baa\u0bc3\u0bb2 \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 4 \u0ba4\u0b95\u0b95\u0bba\u0baa\u0baf \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 5 \u0bae\u0bae\u0bcd\u0baa\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0ba9 \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 6 \u0bab\u0bba\u0bb2\u0ba4\u0ba9\u0bb2\u0bcd\u0baf \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 7 \u0b85\u0bad\u0ba9\u0bba\u0bac\u0b95\u0bcd\u0b95 \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 8 \u0bac\u0b9f\u0bcd\u0b9f\u0bbf\u0bac\u0bba\u0ba8\u0bcd\u0ba4\u0ba4\u0bba\u0b9f\u0bcd\u0baa\u0b9f \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 9 \u0baa\u0bc1\u0bb0\u0ba4\u0bcd\u0ba4\u0b95\u0bba\u0bb9\u0bc2\u0baa\u0bbb\u0b9f\u0bcd\u0b9f\u0bbf\u0bac \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a\n\n\u0b9a\u0baa\u0baa 10 \u0bb0\u0bc1\u0bb2\u0ba9\u0bcd\u0ba4\u0bb2\u0bb2\u0bcd\u0baf \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 11 \u0ba4\u0ba4\u0bad\u0bc8\u0bbb\u0bac\u0b95\u0baf \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa 12 \u0ba4\u0ba4\u0bb9\u0bbb\u0ba4\u0bac\u0bba\u0bb2\u0bbb\u0b9f\u0bcd\u0b9f \u0baa\u0bbb\u0bad\u0ba4\u0ba4\u0b9a \u0b9a\u0baa\u0baa"
