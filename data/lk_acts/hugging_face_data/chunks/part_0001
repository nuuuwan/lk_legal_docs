    "chunk_text": "\u201c10. 1971 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ef\u00c9\u00ef\u00ce\u00bf \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 (\u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00ef\u008a) \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u00cc\u00ba\u00eb \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00c9\u00ef\u00ce\u00bf\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\n\n\u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c4\u00ba\u00cc\u00e8\u00c6\u00c6\u00b4 30\n\n1 \u00c9\u00be \u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00bc\u00e0\u00bc, \u00a2\u00be\u00e0 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\n\n\u00c0\u00cc\u00ea\u00c9 \u00c8\u00e5\u00c3 \u00c9\u00c8 \u00a2\u00ba\u00f8\u00d6 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00c4\u00ba\u00cc\u00e8\u00c6\u00c6\u00b4 25.\u201d\n\n59.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cd\u00c6\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(2)\u00a6\u00e0 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 5 \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00a1\u00f5\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n5\u00a1.\u00c6\u008a \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb \u00a6\u00e0\u00a8\u00a8\u00c6\u00a8 \u0097\u00ef\u00bc\u00e0\u00ca\u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00cc\u00e8\u00f3 \u00ef\u00a8\u00ef\u00c7\u00be \u00a1\u00a8\u00e0\u00ef\u00c9\u00c7\u00ce\u00aa\u00b8\u00ea\u00ef\u00bc\u00b8\u00ea\u00c9\u00a8\u00f8\u00be\u00e0 \u00a4\u00c0\u00bc\u00fa\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00e0 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (38\u00a1\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6) . . . . \u00cc\u00e8\u00c6\u00c6\u00b4 20\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00cd\u00c6\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba72\n\n5\u00a1\u00e5.\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00a1\u00e5\u00a8\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00a8\u00b8\u00e8\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ec \u00c6\u008a\u00c4\u00e6\u00b8\u00e8\u00a8\u00e0 \u00aa\u00c8\u00e0, \u00ef\u00c8\u00e5\u00e0\u00cd \u00ef\u00cd\u00e5\u00e0 \u00a9\u00be\u00f8\u00b0\u00ef\u00ba\u00c8\u00e0 \u00aa\u00e7\u00cc\u00e0 \u00ef\u00cd\u00e5\u00e0\u00a9\u00be\u00f8\u00b0\u00ef\u00ba\u00c8\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00a1\u00be\u00ea\u00c4\u00ba\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00c6\u008a \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00c8\u00e8\u00c6\u00a8\u00b4 \u00a6\u00c4 \u00c3\u00e5\u00b8\u00e0\u00b6\u00c6\u00b4\u00ba\u00e0 \u00ef\u00be\u00e5\u00a8\u00c7 \u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00f2\u00cd\u00f8\u00ba\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00b4\u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00cd\u00fa\u00ba\u00c8\u00e5\u00c3\u00fa\u00c6\u00a8\u00eb\u00b4 \u00a4\u00c0\u00bc\u00fa\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00e0 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (38\u00a1\u00e5\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6) . . . . \u00cc\u00e8\u00c6\u00c6\u00b4 10.\n\n5\u00a1\u00e6.\u00c3\u00e5\u00b8\u00e0\u00b6 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00ef\u00ce\u00bf \u00c3\u00e5\u00b8\u00e0\u00b6 \u00aa\u00c2\u00b6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00cc\u00e6\u00c8\u00cc\u00e9\u00c4 \u00cc\u00cd \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec\u00c6\u008a \u00a1\u00be\u00ea\u00c4\u00ba \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00f8\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4\u00a4\u00c0\u00bc\u00fa\u00be \u00ef\u00c0\u00e5\u00ce\u00e8\u00c6 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00e0 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (38\u00a1\u00e6 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6) . . . . \u00cc\u00e8\u00c6\u00c6\u00b4 10\n\n5\u00a1\u00e7.\u00cc\u00c4\u00e5\u00aa\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0, \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00c8\u00e5\u00c3\u00ef\u00cd\u00e5\u00e0 \u00c8\u00e6\u009f\u008a \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00eb\u00b4 \u00a1\u00bc\u00e5\u00ce \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00e0\u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (38 \u00a1\u00e7 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6)\n\n(3)\u00a6\u00e0 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 20 \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c21.\u00ef\u00c2\u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c4\u00ba, \u00c6\u008a\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00c4\u00ba \u00cd\u00e6\u00c7 \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00cd\u00c9\u00ea\u00c8\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00e0\u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (72 \u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6) . . . . \u00cc\u00e8\u00c6\u00c6\u00b4 10\n\n22.\u0097\u00ef\u00be\u00e5\u00e0\u00bc\u00e5\u00cc\u00e0\u00c9\u00e5\u00bc\u00c6 \u00cc\u00c0\u00c6\u00be\u00e0\u00be\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ca\u00fa\u00c8\u00e0\u00c0\u00e8\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0\u00c9\u00ee\u00ba\u00e0\u00ba\u00e8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00db\u00a8\u00f8\u00c6\u00e5\u00c9 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c\u00c0\u00ea\u00c7\u00c9\u00e6\u00cc\u00e8\u00c6\u00a8\u00eb \u00ef\u00be\u00e5\u00c9\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a1\u00bc\u00e5\u00ce \u00a8\u00c8\u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00e0 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 (91 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6) . . . . \u00cc\u00e8\u00c6\u00c6\u00b4 15\n\n23.97\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00d6\u00bc\u00fa \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0\u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00a9\u00be\u00f8\u00b0 \u00ef\u00ba\u00c8\u00e0\n\n\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00cc\u00e8\u00c6\u00c6\u00b4 10 \u00a8\u00b4\u00c0\u00c4\u00b8\u00a8\u00e0 \u00c6\u00b4\u00ba\u00e0\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u0095\u00cc. . \u00cc\u00e8\u00c6\u00c6\u00b4 15\u201d.\n\n2004 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba73"
