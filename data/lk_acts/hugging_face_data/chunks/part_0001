    "chunk_text": "\u00a1\u0093\u00a8\u00c7\u00b8 \u00c2\u00c8\u00c6 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00e0\u00be\u00e5\u00ef\u00aa\u00e0\u00be\u00c4 \u00cc\u00cd \u00c8\u00e8\u00c0\u00e8\u00be\u00c6 \u00cc\u00cd \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c4\u00ea\u00dd \u00c4\u00ea\u00bc\u00c8 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00a8\u00e0\u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00be\u00f8\u00c6\u0095\u00ba \u00ef\u00aa\u00d1\u008a \u00a8\u00f8\u00d7\u00c4, \u00a6\u00ef\u00cc\u00e0 \u00be\u008a \u00a8\u00c7\u00be \u00c8\u00bc\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4 \u00c9\u00ec \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00bc \u00cc\u00c4\u00aa \u201c\u00a1\u00c6\u00fa.\u00cc\u00e9.\u009b.\u00a6\u00e0.\u009c\u201d\u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00e0\u00be\u00e5 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0 \u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0,\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00cd \u00cc\u00e7\u00c4 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c4 \u00be\u00c4 \u00cc\u00cd\u00ba\u00f8\u00a8\u00ef\u00c6\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n20.\u00c0\u00bc \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00be\u00f1\u00e5\u00da\u00bb\u00c6\u00a8\u00e0 \u00a1\u00c9\u00ca\u00f1 \u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u0095\u00cc, \u00ef\u008a\u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00cd\u00fa_\n\n\u201c\u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00a8\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00c6\u008a \u00c8\u00be\u00e0\u00cc\u00ea\u00c9\u00a8\u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00a8\u00c7\u00e6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u0097\u00bd\u00e5\u00be \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00c4\u00aa\u00fa\u0097\u00cc\u00ea\u00ef\u008a \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4, \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c4\u00cc\u00bf\u00cd\u00e5 \u00c9\u00aa\u00a8\u00f8\u00c9 \u00c6\u00ea\u00ba\u00eb \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00aa\u00be\u00ea \u00c8\u00c2\u00be\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0 \u00c9\u0090\u00be\u00e5\u00a8\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c8\u00e8\u00c0\u00e8\u00ef\u00c6\u00cd\u00fa \u00cc\u00bf\u00cd\u00be\u00e0\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00aa\u00fa\u0097\u00cc\u00ea\u00ef\u008a \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00a2\u00be\u00e0\u00c0\u00cc\u00ea \u00ef\u00c9\u00be\u00cc\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00c4\u00ea\u00bc\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c. \u00a6\u00c4\u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0 \u00c9\u0090\u00be\u00e5\u00a8\u00c4 \u00c9\u00be\u00ea\u00ef\u00c6\u00e0 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a6\u00ce\u00c5 \u00a1\u00e6\u00ba\u00f8 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0\u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00ba\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0 \u00a8\u00f9\u00c0\u00c6\u00a8 \u00c4\u00ea\u00f5 \u00a6\u00a8\u00ba\u00eb\u00c9 \u00c9\u00be \u00a1\u00ba\u00c7\n\nIII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00cc\u00bf\u00cd\u00e5 \u00a1\u00da\u00bb\u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n2005 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba11\n\n\u00a4\u00c0 \u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0 \u00c9\u0090\u00be\u00e5\u00a8\u00c4, \u00cc\u00e6\u00c0\u00c6\u00ea\u008a \u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0 \u00c9\u0090\u00be\u00e5\u00a8\u008a\u00cc\u00cd \u00c9\u00e6\u00b6 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00bc\u00e6\u00d7\u00c4\u00b4 \u00cc\u00e8\u00f3\u00c9\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a\u0097\u00c6\u00bc\u008a \u00bc \u00a3\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ; \u00cc\u00cd\n\n\u201c\u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u008a \u00c0\u00ea\u00cd\u00ea\u00b8\u00ea \u00cc\u00cd \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 (\u00a1\u00c6\u00fa.\u00cc\u00e9.\u009b.\u00a6\u00e0.\u009c.)\u201d\u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 1957 \u00a1\u00e2\u00a8 49 \u00bc\u00c7\u00be \u00c7\u00e5\u00b0\u00f1 \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00e6\u00c2 1992 \u00b0\u00ea\u00be\u00f8 \u00c4\u00cc10 \u00c9\u00be \u00bc\u00fa\u00be \u00a1\u00e2\u00a8 718/15 \u00bc\u00c7\u00be \u00a1\u00ba\u00f8\u0097\u00ef\u00ca\u00e0\u00cb \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0\u00c0\u00ce \u00a8\u00c7\u00be \u00c8\u00bc \u00be\u00f8\u00c6\u00c4\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be, \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00c7\u00be\u00c8\u00bc \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6 \u00a1\u00bc\