    "chunk_text": "(2) \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1973 \u00a1\u00e2\u00a8 27 \u00bc\u00c7\u00be \u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8\u00c7\u00a8\u00e0\u00cb\u00b8 \u00c0\u00be\u00ba \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00be\u00c4\u00ea\u00f3 -(\u00a1) \u00a6\u00e0 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba \u00a8\u00ee\u00cb\u00e8\u00a8\u00da\u00c4 \u00c7\u00a8\u00e0\u00cb\u00b8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00a6\u00ce\u0096,\u00a6\u00ef\u00cc\u00e0\u00c4 \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00c2\u00c8 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00c9\u00ec \u00cc\u00e8\u00c6\u00f5\u00aa\u00fa\u0097\u00cc\u00ea\u008a, \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00cc\u00c4\u00aa \u00a6\u00ce\u0096 \u00aa\u00e8\u0097\u00cc\u00ea\u008a \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00a1\u00be\u00ea\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ef\u008c \u00ef\u00c6\u00e5\u00bc\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c6.\n\n(\u00a1\u00e6) \u00a6\u00e0 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba \u00a8\u00ee\u00cb\u00e8\u00a8\u00da\u00c4 \u00c7\u00a8\u00e0\u00cb\u00b8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4\u00c9\u00e5\u00cc\u00e8\u00bc\u00e5\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00ef\u00bc\u00be \u00c8\u00f3\u00c9 \u00be\u00f8\u00c6\u0095\u00ba\u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00bc\u00fa\u00be\u00b4 \u00a2\u00b4\u00ea \u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00e8\u00c6\u00f5 \u00ba\u00f9\u00be\u00e0\u00f3,\u00c0\u00f2\u00a8\u00e5\u00ca \u00cc\u00cd \u00a1\u00e5\u00b3\u00e5, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa, \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4\u00c9\u00e5\u00cc\u00e8\u00bc\u00e5\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00ef\u00bc\u00be \u00c8\u00bc \u00ba\u00f9\u00be\u00e0\u00f3\u00c0\u00f2\u00a8\u00e5\u00ca \u00cc\u00cd \u00a1\u00e5\u00b3\u00e5 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 \u00a6\u00e0 \u00a1\u00be\u00ea\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ef\u00c9\u00cd\u00fa \u00ef\u00c6\u00e5\u00bc\u00c9\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n\u00c0\u00d6\u0083\u00d2\u00be\u00e0\u00be \u00a8\u00f8\u00d7\u00c4\u00cc\u00cd \u00a1\u00be\u00e0\u00ba\u00da\u00a8\u00e5\u00c8\u00e9\u00be\u0097\u0093\u0097\u00bd\u00e5\u00be.\n\n151999 \u00a1\u00e2\u00a8 20 \u00bc\u00c7\u00be \u00a8\u00ee\u00cb\u00e8\u00a8\u00e5\u00da\u0095\u00a8 \u00cc\u00cd \u00ef\u00aa\u00e5\u0097\u00b0\u00be\u00c7\u00a8\u00e0\u00cb\u00b8 \u00c0\u00be\u00ba\n\n(\u00a1\u00e7) \u00a6\u00e0 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00bc, 1987 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00aa\u00e5\u0097 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0\u00cc\u00cd \u00cc\u00c4\u00e5\u00b0 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00b8 \u00c0\u00f2\u00ba\u00e8\u00c8\u00e5\u00c3 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00bc,1990 \u00a1\u00e2\u00a8 23 \u00bc\u00c7\u00be \u009e\u00c9\u00c7 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00cc\u00cd \u00cc\u00c4\u00e5\u00b0\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00b8 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00bc \u00a8\u00ee\u00cb\u00e8\u00a8\u00da\u00c4 \u00c7\u00a8\u00e0\u00cb\u00b8\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00e8\u00c6\u00f5\u00c2\u00c8\u00ba\u00c8 \u00cd\u00e5 \u00a8\u00e5\u00da\u00c6, \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be\u00c0\u00d6\u00bc\u00fa \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00ef\u00c9\u00ba \u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00a1\u00e6\u00ba\u00f8 \u00c2\u00c8\u00ba\u00c8 \u00cd\u00e5 \u00a8\u00e5\u00da\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00c7 , \u00a6\u00e0 \u00a1\u00be\u00ea\u00c9 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00e8\u00be\u00e0, 1987 \u00a1\u00e2\u00a8 12 \u00bc\u00c7\u00be \u00ef\u00aa\u00e5\u0097\u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00cc\u00cd \u00cc\u00c4\u00e5\u00b0 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00b8 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5\u00a8\u00f2\u00c4 \u00c0\u00be\u00ef\u00ba\u00e0 \u00bc 1990 \u00a1\u00e2\u00a8 23 \u00bc\u00c7\u00be \u009e\u00c9\u00c7 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0\u00cc\u00cd \u00cc\u00c4\u00e5\u00b0 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00b8 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4 \u00c0\u00be\u00ef\u00ba\u00e0 \u00bc\u00a8\u00ee\u00cb\u00e8\u00a8\u00da\u00c4 \u00c7\u00a8\u00e0\u00cb\u00b8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00a8\u00e0,\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u00bf\u00cd\u00be\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6.\n\n(\u00a2) \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7\u00ba\u00eb\u00c9 \u00c4 \u00c9\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0\u00bc\u00fb \u00a6\u00c4 \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00a8\u00ee\u00cb\u00e8\u00a8\u00da\u00c4 \u00c7\u00a8\u00e0\u00cb\u00b8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u00a1\u00c6\u00ba\u00e0\u00c9\u00ba\u00f8\u00c2\u00ea\u00b8\u00e5 \u00c9\u00ec \u00cc\u00cd \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00b4\u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00cc\u00e8\u00c6\u00f5 \u00ae\u00e2\u00ae\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce \u00be\u00f8\u00c6\u0095\u00ba\u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be \u00c0\u00d6\u00bc\u00fa, \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00cc\u00ba\u00eb \u00c9\u00be\u00e0\u00ef\u00be\u00e0\u00c6.\n\n(\u00a3) \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c4 \u00c9\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00c0\u00e6\u00c9\u00ba\u00f8 \u00a6\u00e0 \u00c0\u00be\u00ba\u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00a8\u00ee\u00cb\u00e8\u00a8\u00da\u00c4 \u00c7\u00a8\u00e0\u00cb\u00b8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e8\u00c6\u00f5\u00b8\u00c6 \u00cd\u00e5 \u00c2\u00e6\u00c7\u00a8\u008a, \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be\u00c0\u00d6\u00bc\u00fa \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00b8\u00c6 \u00cd\u00e5 \u00c2\u00e6\u00c7\u00a8\u008a \u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
