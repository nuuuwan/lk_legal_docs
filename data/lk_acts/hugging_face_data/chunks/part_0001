    "chunk_text": "\u00a1\u00c4\u00ea\u00b8\u00e5 \u00a1\u00e6\u00ba.).......................................................\n\n....................................................... \u00ef\u00c9\u00ba (\u00be\u00c4\u00cc\u00cd \u00c8\u00e8\u00c0\u00e8\u00be\u00c6 \u00bc\u00a8\u00e0\u00c9\u00be\u00e0\u00be) \u00c3\u00e5\u00c7 \u00bc\u00fb \u00a1\u00e6\u00ba/* \u00a6\u00a8\u00f9\u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8 \u00ba\u00eb\u00ce \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00f9 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8 \u00c4\u00ba ;\u00c0\u00f2\u00bc\u00da\u00ca\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba ;\n\n...........................................\u00a6\u00a8\u00f9 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00ef\u00c8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00a1\u00be\u00c9\u00cc\u00c7\u00ef\u00c6\u00be\u00e0 \u00cc\u00be\u00e0\u00ba\u00a8\u00c6/*\u00c0\u00bc\u00fa\u00e2\u008e\u00c6 \u00c8\u00c2\u00e5\u00ef\u00aa\u00be \u00a1\u00e6\u00ba\u00f8 \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 69\u00a1\u00e6\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00c7 \u00a1\u00e6\u00ba ;\n\n121999 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00be\u00f8\u00c9\u00e5\u00cc \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(\u00a1\u00e5)\u00a6\u00a8\u00f9 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00ef\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00cc\u00be\u00e0\u00ba\u00a8\u00c6\u00a1\u00e5\u00c0\u00cc\u00ea \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd \u00a6\u00a8\u00f9 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00ef\u00c8\u00be\u00e0\n\n\u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8/ \u00a6\u00a8\u00f9 ........................................................\n\n.................................................................................... (\u00be\u00c4\u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00e0\u00be) \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00c6\u00e6\u00ef\u00c0\u00be\u00e0\u00be\u00be\u00e0 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00ef\u00c9\u00ef\u00ba\u00e5\u00ba\u00e0, \u00a7\u00c9\u00ea\u00be\u00e0 \u00bc \u00ef\u00be\u00c7\u00c0\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00e5\u00c6\u00e5\u00ae\u00be\u00c6\u00a8\u00c7\u0095.\n\n\u00a1\u00ba\u00e0\u00cc\u00be,\u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u00e5\u0093\u00a8\u00e5\u00d6.\n\n\u00a2\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6(\u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00c6 \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00c0\u00e8\u00cd\u00fa\u009b\u00c4 \u00c0\u00f2\u00a8\u00e5\u00ca \u00ef\u00a8\u00ef\u00c7\u0095\u00be\u00e0 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u0097\u00cc\u00e0\u00ba\u00c7\u00c6\u00a8\u00e0 \u00ef\u00c4\u00cd\u00fa \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00e0\u00be)\n\n\u00a1\u00ba\u00e0\u00cc\u00be,\u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u00e5\u0093\u00a8\u00e5\u00d7\n\n\u00bc\u00fa\u00be\u00c6* \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u00ef\u008c \u00be\u008a \u00a8\u00c0\u00e5 \u00cd\u00d6\u00be\u00e0\u00be\n\n\u201c\u00a1\u00e6\u201d \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8\u00c6(69\u00a1\u00e7 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6) \u00bc\u00fa\u00c9\u00ea\u00c7\u00e6\u008a \u00c0\u00ba\u00f2\u00c6\n\n\u00b0\u00e5\u00ba\u00f8\u00a8 \u00be\u00f8\u00c9\u00e5\u00cc \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u00e5\u0093\u00a8\u00e5\u00d7 (\u00be\u00c4 \u00cc\u00bf\u00cd\u00be\u00e0\u00a8\u00c7\u00be\u00e0\u00be).......................................................................................\u00c9\u00be\u00c4\u00c4, \u00b0\u00e5\u00ba\u00f8\u00a8 \u00be\u00f8\u00c9\u00e5\u00cc \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ef\u00ba\u00e0 69\u00a1\u00e7 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0\u00be\u00f8\u00c6\u0095\u00ba \u00c0\u00d6\u00bc\u00fa, \u00aa\u00e5\u008a\u00c3\u00fb\u00c7\u00ba\u00e5 \u00c0\u00ec\u00da\u00c9\u00a8\u00c9, \u00a1\u00c9\u00e2\u00a8\u00c9 \u00cc\u00cd \u00cc\u00ba\u00f1\u00c9\u00e5\u00bc\u00fb\u00c9 \u00bc \u00bc\u00fa\u00c9\u00ea\u00c7\u00e5\u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00c7\u0095/ \u00c0\u00f2\u00ba\u00e8\u00b3\u00e5 \u00bc\u00fb \u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00c7\u0095 :-\n\n(i) \u00b0\u00e5\u00ba\u00f8\u00a8 \u00be\u00f8\u00c9\u00e5\u00cc \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u00e5\u0093\u00a8\u00e5\u00d6\u00c4\u00c4 \u00ef\u00c9\u0095;\n\n(ii) \u00ef\u00be\u00c7\u00c0\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00a2\u00c8\u00e0\u00c8\u00e9\u00ef\u008a \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00cd\u00fa \u0097\u00cc\u00e0\u00ba\u00c7\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc \u00b0\u00e5\u00ba\u00f8\u00a8\u00be\u00f8\u00c9\u00e5\u00cc \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8\u00a8\u00f8,\u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0, \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8\u00a8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 ;\n\n131999 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00be\u00f8\u00c9\u00e5\u00cc \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(iii) \u00a1\u00cc\u00e0\u00a8\u00f8\u00d7\u00ef\u008a \u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6\u00a8\u00e0 (\u00ef\u00be\u00c7\u00c0\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00a2\u00c8\u00e0\u00c8\u00e9\u00ef\u00c4\u00cd\u00e8\n\n\u00c0\u00e8\u00b4\u00c0\u00ba\u00a8\u00e0 \u00a1\u00c4\u00ea\u00b8\u00e5 \u00a1\u00e6\u00ba.) .....................................(\u00be\u00c4\u00cc\u00cd \u00c8\u00e8\u00c0\u00e8\u00be\u00c6 \u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00e0\u00be) \u00ef\u00c9\u00ba \u00c3\u00e5\u00c7 \u00bc\u00e9 \u00a1\u00e6\u00ba/ *\u00a6\u00a8\u00f9\u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8 \u00ba\u00eb\u00ce \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ba \u00c0\u00f2\u00bc\u00da\u00ca\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00a1\u00e6\u00ba ;\n\n(iv) \u00a6\u00a8\u00f9 ......................................( \u00be\u00c4 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00e0\u00be)\u00a6\u00a8\u00f9 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00ef\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00a1\u00be\u00c9\u00cc\u00c7\u00ef\u00c6\u00be\u00e0\u00cc\u00be\u00e0\u00ba\u00a8\u00c6/* \u00c0\u00bc\u00fa\u00e2\u008e\u00c6 \u00c8\u00c2\u00e5 \u00ef\u00aa\u00be \u00a1\u00e6\u00ba\u00f8 \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00c0\u00be\u00ef\u00ba\u00e069\u00a1\u00e6 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00a8\u00f8\u00d7\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00c7 \u00a1\u00e6\u00ba."
