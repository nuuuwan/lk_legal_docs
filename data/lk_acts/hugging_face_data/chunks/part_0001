c6\u0b95\u0bbe\u0bb3\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u201d.\n\n75450(3)(\u0b88)\u201c\u0b95\u0b9f\u0baa\u0bcd\u0baa\u0bbe\u1f8c\u0b95\u0bc8\u0bb3 \u0ba8\u0bbf\u0bc8\u0bb1\u0bc7\u0bb5\u0bb1\u0bcd\u1fa0\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0bc7\u0b95\u0bbe\u0bb0\u0baa\u0bcd\u0baa\u1f8c\u0bb5\u0ba4\u0ba9\u0bcd\u0bc7\u0bae\u0bb2\u0bcd;\u201d\n\n\u201c\u0b95\u0b9f\u0baa\u0bcd\u0baa\u0bbe\u1f8c\u0b95\u0bc8\u0bb3 \u0ba8\u0bbf\u0bc8\u0bb1\u0bc7\u0bb5\u0bb1\u0bcd\u1fa0 \u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0bc7\u0b95\u0bbe\u0bb0\u0baa\u0bcd\u0baa\u1f8c \u0bb5\u0ba4\u0ba9\u0bcd\u0bc7\u0bae\u0bb2\u0bcd\u201d; \u0b85\u0ba4\u0bcd\u1f90\u0b9f\u0ba9\u0bcd\n\n2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 12 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95, 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 12 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95,\n\n\u0b95\u0bae\u0bcd\u0bc6\u0baa\u0ba9\u0bbf\u0b95\u0bb3\u0bcd (\u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0b9a\u0bcd) \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\u0b95\u0bae\u0bcd\u0bc6\u0baa\u0ba9\u0bbf\u0b95\u0bb3\u0bcd (\u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0b9a\u0bcd) \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd31\n\n76450(4)\u201c\u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb1\u0bcd\u1fa0\u0bb5\u0ba4\u0bbf\u1fa2\u1f9e\u0ba8\u0bcd\u1f90 \u0ba4\u0bb5\u0bbf\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\u201d\u201c\u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb1\u0bcd\u1fa0 \u0bb5\u0ba4\u0bbf\u1fa2\u1f9e\u0ba8\u0bcd\u1f90 \u0ba4\u0bb5\u0bbf\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\u201d\n\n77470(1) \u201c\u0bc7\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0b95\u201d,\u201c\u0bc7\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0b95\u201d.\n\n78472(2)\u201c\u0ba8\u0bc0\u0ba4\u0bbf\u0bae\u0ba9\u0bcd\u0bb1\u0bae\u0bcd\u201d (\u0b85\u1f90 \u0b85\u0bb5\u0bcd\u1fab\u0b9f\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0bc7\u0ba4\u0bbe\u0ba9\u0bcd\u1fa0\u0bae\u0bbf\u0b9f\u0ba4\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0bb2\u0bbe\u0bae\u0bcd)\n\n\u201c\u0ba8\u0bc0\u0ba4\u0bbf\u0bae\u0ba9\u0bcd\u0bb1\u0bae\u0bcd\u201d.\n\n79481(3)\u201c\u0b87\u0baa\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fa4\u0bb3\u0bcd \u0bb3\u0bc6\u0ba4\u1f90\u1fab\u0bae\u0bcd \u0ba8\u0bc8\u0b9f\u1f99\u0bc8\u0bb1\u0bc8\u0baf\u0baa\u0bcd \u0baa\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u1f90 \u0ba4\u0bb2\u0bbe\u0b95\u0bbe\u1f90\u201d,\n\n\u201c\u0b87\u0baa\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fa4\u0bb3\u0bcd\u0bb3 \u0bc6\u0ba4\u1f90\u1fab\u0bae\u0bcd \u0ba8\u0bc8\u0b9f\u1f99\u0bc8\u0bb1\u0bc8\u0baf\u0baa\u0bcd \u0baa\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u1f90 \u0ba4\u0bb2\u0bbe\u0b95\u0bbe\u1f90\u201d.\n\n80482\u201c\u0baa\u0ba4\u0bbf\u0bb5\u0bbe\u0bb3\u0bb0\u0bcd \u0ba4\u0bc8\u0bb2\u0bc8\u0bae\u0baf\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0ba4\u0bbf\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd (\u0b85\u1f90 \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0b87\u0b9f\u0bc6\u0bae\u0bb2\u0bcd\u0bb2\u0bbe\u0bae\u0bcd)\u201d\n\n\u201c\u0b95\u0bae\u0bcd\u0bc6\u0baa\u0ba9\u0bbf\u0b95\u0bb3\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bbe\u0bb3\u0bb0\u0bcd \u0ba4\u0bc8\u0bb2\u0bc8\u0bae\u0baf\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0ba4\u0bbf\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd\u201d\n\n81514(1)\u201c\u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0ba4\u0bbe\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bbf\u0ba4\u0bbf\u0baf\u0ba4\u0bcd\u1f90\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bb0\u1fab\u0bc8\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bb2\u0bcd\u201d,\n\n\u201c\u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0ba4\u0bbe\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bbf\u0ba4\u0bbf\u0baf\u0ba4\u0bcd\u1f90\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bb0\u1fab\u0bc8\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bb2\u0bcd\u201d."
