    "chunk_text": "\u201c\u00ef\u00c0\u00e5\u00c8\u00e9 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1\u00a1\u00e5)\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a\u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4 \u00cc\u00ea\u00db\u00a8\u00eb\u008a \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0\u00a8\u00c8\u00e0\u00c0\u00e8\u00d7\u00ef\u008a \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00b4 \u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba\u00c9 \u00a6\u00c6 \u00bc\u00c7\u00be\u00e0\u00be\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00bc\u00c7\u00e5 \u00cc\u00e8\u009b\u00ef\u008a \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00b4 \u00a1\u00be\u00ea\u00c0\u00e5\u00ba\u00e8\u00a8\u00c9 \u00a6\u00c4\u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00c2\u00e5 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c0\u00e5\u00c8\u00e9 \u00ef\u00cd\u00e5\u00e0 \u00c9 \u00b4\u008a \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00cc\u00c4\u00e5\u00be\u00ea\u00c0\u00e5\u00ba\u00f8\u00a8 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n162005 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n\u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd\u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00a6\u00c4\u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00c3\u00e5\u00be\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00df\u008a\u00a8\u00c7\u00c4\u00ea\u00c8\u00e8\u00be\u00e0 \u00c4 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00bc\u00fb \u00c6\u008a\u00c9 \u00b4\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e9 \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u00aa\u00d1\u00c4\u00b4\u00c6\u00b4\u00ba\u00e0\u00c9 \u00c6\u008a \u00c0\u00f2\u00e5\u00bb\u0095\u00a8 \u00ef\u00c9\u00ef\u00ce\u00be\u00e0\u00bc\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u0095\u00c8\u00bc\u00fb\u00aa\u00e6\u00be\u00f9\u00c4 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00bc\u00e0\u0097\u00ba\u00f9\u00c6 \u00ef\u00c9\u00ef\u00ce\u00bf\u00c0\u00c8 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(1\u00a1\u00e5) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a\u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00ef\u00aa\u00be \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a\u00c0\u00f2\u00e5\u00bb\u0095\u00a8 \u00ef\u00c9\u00ef\u00ce\u00be\u00e0\u00bc\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0\u00c9\u00e5 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4\u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00c4\u00ea\u00c8\u00e8\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00c9\u00e5 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00e6\u00be\u00e9\u00ef\u008a \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00a6\u00a8\u00e0 \u00bc\u00fa\u00be\u00a8\u00b4 \u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00a6\u00c4 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2 \u00bc\u00e6\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea \u00be\u00e6\u00c9\u00ba\u0095\u00c8\u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00c0\u00cc\u00ea \u00be\u00e6\u00c9\u00ba \u0095\u00c8\u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00c4\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\u201d;\n\n(3)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 _\n\n(\u00a1)(\u00a1\u00a1\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (iv) \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00e6\u00ba\u00f8 \u201c\u00ef\u00c0\u00e5\u00c8\u00e8\u00c6\u201d \u00c6\u00be\u00c9\u00ae\u00be\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00ef\u00c6\u00cd\u00fa (i) \u00ef\u00d8\u00bc\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(i)2004 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00c0\u00cc\u00ea\u00c9\u00c6\u008a \u00be\u00f8\u00c9\u00cc\u00a8\u00e0 \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u0095\u00c8\u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00c4\u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00c6\u008a \u00be\u00f8\u00c9\u00cc\u00a8\u00e0 \u00a2\u00bc\u00fa \u00a8\u00f8\u00d7\u00c4\u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00a2\u00b6\u008a \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u0095\u00c8\u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00c4\u00cc\u00bf\u00cd\u00e5;\u201d;\n\n(\u00a1\u00e5)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a3) \u00ef\u00d8\u00bc\u00ef\u00c6\u00cd\u00fa_\n\n(i)\u201c\u00a6\u00c4 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba\u00a1\u00e5\u00bc\u00e5\u00c6\u0095\u00be\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 \u00ba\u00f8\u00cc\u00e0\u00c0\u00cd\u00a8 \u00a4\u00c0\u00d6\u00c4 \u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0\u00bc\u00a8\u00e0\u00c9\u00e5 \u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7 \u00a6\u00ef\u00cc\u00e0\u00a1\u00b6\u00ea\u00a8\u00c7\u00aa\u00ba \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00c0\u00e5\u00b6\u00ea\u00c9\u00a8\u00e0 \u00a3\u00ce\u00ad\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd \u00a2\u00be\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c6\u00b4 \u00ef\u00aa\u00be\u00c6\u00e5 \u00cd\u00e6\u00a8\u00f8\u00c6:\u201d; \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a6\u00c4 \u00c9\u00da\u00cb\u00c6\u00cc\u00bf\u00cd\u00e5 -\n\n(\u00a1) (1\u00a1) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e8\u00ef\u00c6\u00be\u00e0\u00cc\u00cd \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c9\u00c8\u00e8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 ;\n\n172005 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n(\u00a1\u00e5) (1\u00a1\u00e5) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00ef\u00c0\u00e5\u00c8\u00e9\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00a8\u00e0 ; \u00cc\u00cd\n\n(\u00a1\u00e6) (1\u00a1\u00e6) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00ba\u00e7\u00aa\u00fa\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0, \u00bc\u00b6\u00c6\u00a8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0, \u00c6\u008a\u00ef\u00c8\u00e5\u00ba\u00db\u00c6\u00fa \u00bc\u00fa\u00be\u00ea\u00c4\u00a8 \u00cc\u00cd \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c9\u00be\u00e0\u00bc\u00fa \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00c4\u00ba \u00c9\u00ec \u00ef\u00c0\u00e5\u00c8\u00e8\u00c6\u00a8\u00e0,"
