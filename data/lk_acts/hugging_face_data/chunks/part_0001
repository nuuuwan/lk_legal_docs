    "chunk_text": "1971 \u00a4\u00ba\u00c6\u00a4\u00ae\u0088\u0081 30 \u00a4\u00ba\u00c6\u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 3 \u00a4\u00ba\u00c6\u0089\u00c7\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\nH - 22545\n\n21999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 22 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00cd\u00b6\u00b1\u00c8\u00bb \u00cd\u00b1\u00ba\u00c8\u00b9\u00c6\u00da\u00c1+\u00c6\u00af\u00c8 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n3 .\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 4 \u00a4\u00ba\u00c6 \u0089\u00c7\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n\u201c(1) \u00c1+\u00c6\u00af\u00c8 \u00a3\u00b6\u0081 \u0089\u00bc\u00b6\u00c7\u00b8 \u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00b4\u00b6\u00c6\u00ce\u00b6\u00af\u00c6\u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u0089\u00be\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081,\u00c1+\u00c6\u00af\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00ce\u00be\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5 \u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00af\u00af\u00c6 \u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00db\u00af\u00c1\u00bc\u00c7\u00ae\u00ce\u00ba\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 , \u00db\u00af\u00c1\u00c7\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6, \u00a3\u00b6\u00c6 \u00d7\u00b4\u0081\u00ce\u00c1\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00ce\u00bf\u00b6\u00c6 \u00b6\u00c8\u00bc\u00b4\u00d5\u00ba\u00c6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af, \u00a5\u00be\u00c6+\u00c6\u00ce\u00af\u00af\u00c6\u00d0\u00cc\u00c1\u00bf\u00c8\u00cd\u00bb \u00db\u00af\u00c1\u00c7\u00c6\u00af\u00ce\u00bf \u00b7\u00c8\u00bb\u00ba\u00c8\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8\u00b6\u00c6\u00d7\u00c1\u00a3\u00df\u00c1\u00be\u00af+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6,\u201d \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(2) \u00a3\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081 (2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00c8\u00c7\u00c8\u008c\u00be\u00c6, \u201c\u00db\u00af\u00c1\u00c7\u00c6 \u00b7\u00c8\u00ce\u00be\u00bb\u00ba\u00c7\u00af\u00a3\u00be\u00c6\u00be\u00d7 \u00db\u00af\u00c1\u00bc\u00c7\u00af \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6 \u201c \u00a9\u0081\u00bd \u00cc\u00b1\u00c7\u00bd\u00c6\u00e0\u00af\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af, \u201c\u00db\u00af\u00c1\u00bc\u00c7\u00af \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u201d\u00c6 \u00a9\u0081\u00bd \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6\u00b0\n\n4.\u00a4\u008a\u00bc\u00b6\u00c6\u00d7\u00b6\u00c6 \u00cc\u00b6\u00c7\u00bf\u00c7\u008a\u00bc\u00b6\u00c6\u00d7\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ae\u00d6\u00c7\u00bd\u00c6\u00ce\u00bd\u00b7\u00c6\u00b6\u00c7\u00ba\u00c6\u00a4\u00ae\u0088\u0081 28 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 6 \u00a4\u00ba\u00c6 \u0089\u00c7\u00c8\u00e2, \u00a3\u00b9\u00c6\u0089\u00c7\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u00be\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00cd\u00ba\u00df\u00ba\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n(1)\u201c\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c8\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00ce\u00ba\u00c1\u00c7\u00af\u201d \u00a9\u0081\u00bd\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af, \u201c\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00af\u00c6 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6, \u00a3\u00b6\u0081\u00af\u00c9\u00c0\u00c6 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ac\u00c0+\u00c6\u00d0\u008c\u00b6\u00c8\u00af\u00e0\u00ba\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00b5\u00c8\u00b9\u00c6\u00da\u00af\u00e0\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b4 \u00cd\u00c1\u00de\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00ba\u00c6 \u00a3\u00ce\u00ba\u00c1\u00c7\u00af\u201d, \u00a9\u0081\u00bd \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00a5\u00d5\u00c1\u00b6\u0081 \u00db\u00be\u00db\u00ba\u00c6;\n\n(2)\u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00c7\u00c8\u00c1\u00c8\u0081 (\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6, \u201c\u00ce\u00c1\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00b5\u00af\u00c6\u00d0\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cd\u00b1\u00ba\u00c8\u00b9\u00c6\u00da\u00af\u00c6 \u00af\u00b5\u00af\u00c6\u00d0\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00b6\u00c8\u00bd\u00b6\u00c6\u00b6\u00be\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cd\u00b1\u00ba\u00c8\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00c7\u0081\u00bd\u00c8\u00b6\u00c0\u00c6\u00af\u00bf\u00c6 \u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6\u201d \u00a9\u0081\u00bd\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af, \u201c\u00cd\u00b1\u00ba\u00c8\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00c7\u0081\u00bd\u00c8\u00b6\u00c0\u00c6\u00af\u00bf\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00b1\u00ba\u00c8\u00b9\u00c6\u00da\u00af\u00ce\u00bf\u00b6\u00c6 \u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0 \u00c1+\u00c6\u00af\u00c8\u00ce\u00bb\u00a5\u00bb\u00be\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd \u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b1\u00c7\u00b6\u00b8\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u00a9\u0081\u00bd \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6;\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c8\u00814 \u00a4\u00ba\u00c6 \u00b9\u00c8\u00c7\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c8\u00816 \u00a4\u00ba\u00c6 \u00b9\u00c8\u00c7\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n31999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 22 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00cd\u00b6\u00b1\u00c8\u00bb \u00cd\u00b1\u00ba\u00c8\u00b9\u00c6\u00da\u00c1+\u00c6\u00af\u00c8 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(3)\u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u0081 (\u00a7) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6, \u201c\u00a3\u00c1\u00c7\u00c6\u00af\u00bf\u00d7\u00b9\u00b5\u00ce\u00c1\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c8\u0081 \u0089\u00ce\u00b5\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00c6 \u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u201d\u00c6 \u00a9\u0081\u00bd\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af, \u201c\u00a3\u00c1\u00c7\u00c6\u00af\u00bf\u00d7 \u00b9\u00b5\u00ce\u00c1\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00bf\u00c8\u0081 \u0089\u00ce\u00b5\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u00a3\u00be\u00c6\u00be\u00d7 \u00b1\u00ce\u00b9\u008a\u00b8\u00c7\u00be\u00c6 \u00b6\u00c9\u00c7\u00c6\u00ba\u00c7\u00b8\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00c1\u00c7\u00bd\u00c7\u00b8\u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6 \u0089\u00ce\u00b5\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7\u00a7\u00b6\u00c6\u00b6\u00bc\u00c1\u00c7\u00b6\u00c6\u00d7\u00af\u00c6 \u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u201d \u00a9\u00b8\u00c6\u00bd \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6;\n\n(4)\u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00c7\u00c8\u008c\u0081 (\u00a8) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\u201c\u0089\u00ce\u00b5\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u0081 \u00ba\u00c9\u00d7 \u0096\u00b4\u00ce\u00ba\u00b9\u00c6\u00da\u00af\u00c6 \u00af\u00b4\u0081\u00af\u00ce\u00bf\u201d\u00a9\u0081\u00bd \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af, \u201c\u00b9\u00c8\u00ce\u00b5\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u0081\u00ba\u00c9\u00d7 \u0096\u00b4\u00ce\u00ba\u00b9\u00c6\u00da\u00af\u00c6 \u00af\u00b4\u0081\u00af\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c7\u00c6\u00b6\u00c6\u00b6\u00af\u00ba\u00c6\u00b1\u00c7\u00bc\u00c7 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8 \u00cd\u00c1\u00de \u00af\u00b4\u0081\u00af\u00ce\u00bf\u201d \u00a9\u0081\u00bd\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00ba\u00c6;"
  },
