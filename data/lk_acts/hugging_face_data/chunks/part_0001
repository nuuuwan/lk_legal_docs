    "chunk_text": "10\u00b0 \u00a4\u008a\u00bc\u00b6\u00c6\u00d7\u00b6\u00c6 \u00cc\u00b6\u00c7\u00bf\u00c7\u008a\u00bc\u00b6\u00c6\u00d7 \u00a9\u00e1\u00b9\u00b6\u00c6\u00d7 \u00a9\u00c0\u00c7\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6\u00a5\u00be\u00af\u00c6\u00af \u00b7\u00c7\u00d5 \u00af\u00b4\u00b6\u00c6\u00b6\u00be\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a9\u00d7 \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c8\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6,\u00a3\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 \u00b9\u00c7\u00af\u00ba\u00c6 \u00a4 \u00a9\u0081\u00b9\u00b6\u00c8\u00df\u00ba\u00c6\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00df\u00ba\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00de, \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b6\u00c1\u00de\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c6\u00bd\u00b3\u00c6\u00b1\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00bd\u00c6\u00bd\u00b6\u00c6 \u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00ce\u00bf \u00b7\u00c7\u00d5\u00af\u00b4\u00b6\u00c6\u00d7\u00ba\u00c6\u00a3\u00be\u00c6\u00be\u00d7 11 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 \u00af\u00c9\u00c0\u00c6 \u00b1\u00ba\u00c1\u00c7\u00bb \u00a3\u00bc\u00cc\u00b1\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00a7\u00b6\u008c\u00bb\u00bf\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00ba\u00c7\u00b6\u00c6\u00b6\u00c8\u00bc\u00ba\u00c6, \u00a3\u00bc\u00b1\u00c8\u00bb\u00be\u00c6 \u00a5\u00bb\u00be\u00c6\u00da\u00ce\u00b4\u00bb\u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00bd\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bc\u00b1\u00c8\u00bb\u00be\u00c6 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00de\u00b4\u0081 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00ce\u00b4\u00bb\u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00bd\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bc\u00b1\u00c8\u00bb\u00be\u00c6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00d7{\u00ae\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00bd\u00c7\u00af \u00a5\u00be\u00c6\u00be\u00c7\u00b6\u00c8\u00dd\u00b9\u00c6\u00b9\u00b6\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n12\u00b0 \u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00ba\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00c9\u00c0\u00c7\u00b8 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00ce\u00bd\u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00ce\u00bd \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c7\u008a\u00d9\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0\u00cc\u00c1\u00bf\u00c8\u00cd\u00bb\u00bb\u00c7\u008a\u00d9\u00b3\u00c6 \u00b1\u00bc\u00c8 \u00da\u00bc\u00c8\u00c1\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00ce\u00b8\u00b9\u00c6 \u00da\u00bc\u00c8\u00c1\u00b6\u00bd\u00c6\u00d0\u00a8\u00af\u00c6\u00af\u00ba\u00bf\u00c8\u00b9\u00c6\u00b9\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7, \u00d7{\u00ae\u00d5\u00c1\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00e1+\u00c6\u00d0\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bd\u00c8\u00b7\u00c6\u00d7 \u00b7\u00c8\u00b6\u00c8\u00dc\u00b6\u008c\u00bb\u00bf\u00c8\u00b9\u00c6\u00b9\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00a4\u00cc\u00bf\u00c1\u00ce\u00bc\u00dc\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00d0\u00e1\u00af\u00c6\u00af\u00ce\u00bf\u00b6\u00c6 \u00b6\u00d5\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00b6\u00c6\u00cd\u00b6\u00c7\u00b6\u00c7\u00b8 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00ce\u00bf \u00cd\u00ba\u00bd\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00e0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n13\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00af\u00c6\u00d0\u00ba\u00c6, \u00b6\u00ba\u00c8\u00c0\u00c6 \u00a7\u00ce\u00bc\u00af\u00c6\u00d0\u00ba\u00c8\u00ce\u00b4\u00cd\u00bb\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00bb \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c7\u00b8 \u00b6\u00c1\u00de\u00af\u00bf\u00c6,\u00b7\u00c7\u00d5\u00af\u00b4\u00b6\u00c6\u00d7\u00ba\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\u00a3\u00bc\u00b1\u00c8\u00bb\u00bd\u00c6\u00b6\u00c1\u00de\u00af\u00bf\u00c6\u00db \u00b6 \u008b \u00bb \u00b8 \u00c1 \u00be \u00c6 \u00be\u00a9\u00b8\u00af\u00c6\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00b0\n\n\u00b1\u00ba\u00c1\u00c7\u00bb \u00a3\u00bc\u00d2\u00af\u00e0\u00af\u00c6\u00d0 \u00a7\u00b6\u008c\u00b0\n\n\u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00ba\u00c6\u00b6\u00c1\u00de\u00af\u00ce\u00bf\u00b6\u00c6\u00b6\u00d5\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00b8\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00ce\u00bf \u00cd\u00ba\u00bd\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00e0\u00b6\u00be\u00c6\u00b0\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8 \u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n71999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 11 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af, \u00b9\u00bb+\u00c6\u00af\u00bc\u00c1\u00c7\u00b6\u00c8\u00af\u00bf\u00c8\u0081\u00d0\u00ae\u00d5\u00b6\u00c6\u00b6\u00c7\u00af\u00c6\u00d0\u00b6\u00be\u00c6\u00af\u00ce\u00bf \u00ac\u00d5\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n14\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00b7\u00c6\u00b6\u00bc\u00c6\u00b9\u00c6\u00b9\u00ba\u00c6 \u00cd\u00c1\u00de \u00c1\u00ce\u00af\u00bb\u00c7\u00af\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u0081\u00bd\u00c8 -\n\n\u201c\u00cc\u00c1\u0088 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u008a\u00bc\u00c8\u00b1\u00c6 \u00cd\u00b1\u00b6\u00ba\u00c6 \u00aa\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd \u00cd\u00c1\u00de\u00af\u00dd\u008c\u201d \u00a9\u0081\u00b9\u00d7 -\n\n(\u00a3) \u00ba\u00bc\u00b5\u00b6\u00c6\u00ce\u00b6, \u00b9\u00c7\u00bc\u00d7{\u00bc\u00ba\u00c7\u00b8 \u00a7\u00b4\u00be\u00c6 \u00a8\u00ce\u00bd \u00a3\u00be\u00c6\u00be\u00d7\u00af\u00b5\u00c8\u00b1\u00ba\u00c7\u00b8 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00cd\u00b1\u00b6\u00b6\u00c6\u00ce\u00b6 \u008c\u00ce\u00bf\u008c\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00c1\u0088\u00c1\u00ce\u00ba\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00a4\u00bd\u00c6\u00bd\u00df\u00ce\u00b4\u00bb \u00cc\u00c1\u0088\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00a9\u00bc\u00c8 \u00a4\u00dc\u00b6\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00dd\u008c ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4) \u00b7\u00b1\u00c6\u00d2 \u00a5\u00bc\u00b1\u00c7\u00bb\u00b8+\u00c6\u00af\u00bf\u00c6, \u00a7\u008a\u00bc\u00c8\u00bb\u00bd\u00c6\u00af\u00c7\u008c\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u008c\u00b4+\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00ce\u00b8\u00cc\u00bb\u00c7\u00b6\u00c6\u00b6 \u00b9\u00b6\u00c7\u00bc\u00c6\u00b6\u00c6\u00b6+\u00c6\u00af\u00bf\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00b6\u00c8\u00bc\u00c8\u00bb\u00af\u00c6\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00c8\u00bf\u00bc\u00c6\u00ba\u00c8\u0081\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00ce\u00bf \u00cc\u00c1\u00bf\u00c8\u008c\u00d5\u00b6\u00be\u00c6, \u00b9\u00bc\u00b9\u00c6\u00da\u00c1\u00b6\u0081\u00a8\u00b4\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u0081 \u00b6\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00a8\u00b4\u00c7\u00af\u00a5\u00bd\u00b9\u00c6\u00ce\u00b9, \u00b9\u00c7\u00bc\u00c7\u00d7{\u00bc\u00ba\u00c7\u00b8 \u00a7\u00b4\u00be\u00c6 \u00a8\u00ce\u00bd \u00a3\u00be\u00c6\u00be\u00d7\u00af\u00b5\u00c8\u00b1\u00ba\u00c7\u00b8 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6 \u00cd\u00b1\u00b6\u00b6\u00c6\u00ce\u00b6 \u00aa\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00c1\u0088\u00c1\u00ce\u00ba\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00be\u00c6\u00be\u00d7\u00aa\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6 \u00a4\u00bd\u00c6\u00bd\u00df\u00ce\u00b4\u00bb \u00ad\u00bc\u00c6 \u00a4\u00dc\u00b6\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00af\u00dd\u008c,\n\n\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;"
