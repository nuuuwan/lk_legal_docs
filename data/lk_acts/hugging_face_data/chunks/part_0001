    "chunk_text": "\u00aa\u00ba\u00e0 \u00a8\u00ce, 10 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00bc\u00b8\u00e0\u00b6\u00be \u00c4\u00ea\u00bc\u00c8 \u00a1\u00ba\u00e0\u00cd\u00e6\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00c4 \u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00cc\u00cd \u00c6\u00ea\u00a8\u00e0\u00ba\u00f8 \u00cc\u00cd\u00aa\u00ba \u00c2\u00c9\u00b4 \u00bc\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5 \u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a,\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4 \u00bc\u00b8\u00e0\u00b6\u00be \u00c4\u00ea\u00bc\u00c8\u00a1\u00ba\u00e0\u00cd\u00e6\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00c4 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(\u00a1) \u00a6\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u0097\u00e8\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00bc\u00b8\u00e0\u00b6\u00be\u00c4\u00ea\u00bc\u00c8, \u00a1\u00be\u00ba\u00eb\u00c7\u00e6\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be \u00c6\u008a \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a7\u00cd\u00ea\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00bc\u00e0\u00bc \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00fa\u00c8\u008c \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8 \u00c6 ;\n\n(\u00a1\u00e5) \u00a6\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00bc\u00b8\u00e0\u00b6\u00be\u00c4\u00ea\u00bc\u00c8 \u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\u201d\n\n12.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00e5\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 11 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00a1\u00ba\u00c7 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00ef\u0089 :-\n\n1 1. 10 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u00c9\u00be \u00c8\u00bc\u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00bc\u00fa\u00be\u00c6 \u00a2\u00a8\u00eb\u00ba\u00e0\u00d1\u00c4\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9\u00c2\u00f3 \u00c4\u00ea\u00bc\u00c8 \u00cc\u00cd \u00a3\u00b4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00bc\u00b8\u00e0\u00b6\u00be\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u00aa\u00c9\u00e5 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4 \u00c2\u00f3 \u00c4\u00ea\u00bc\u00c8\u00cc\u00cd \u00a3\u00b4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00bc\u00b8\u00e0\u00b6\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d6 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00be\u00c4 \u00cc\u00cd \u00a1\u00be\u00e0\u00ba\u00f8\u00c4\u00b4\u00bc\u00e6\u00be \u00cc\u00e8\u0090 \u00c0\u00bc\u00fa\u00e2\u008e \u00cc\u00e0\u00bb\u00e5\u00be\u00c6 \u00bc \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00a8\u00e0,\u00a6\u00e0 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6 \u00c0\u00e8\u00cd\u00fa\u0090 \u00ef\u00a8\u00e5 \u00b5\u00e5\u00ca\u00c6 \u0097\u00cb\u00c6\u00ef\u00c6\u00cd\u00fa \u00a1\u0093\u00a8\u00c7\u00b8\n\n\u00ef\u00aa\u00c9\u00ec \u00bc\u00b8\u00e0\u00b6\u00be\u00c4\u00ea\u00bc\u00c8 \u00cd\u00fa\u00c8\u008c\u00a8\u00f8\u00d7\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u00d1\u00c4\u00b4\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5\u00cc\u00ba\u00eb \u00c2\u00c8\u00c6.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e011 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00a8\u00e8\u00d7\u00c4.\n\n\u201c\u00c2\u00bc\u00e0\u00bc \u00a1\u00c6\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00c4.\n\n61999 \u00a1\u00e2\u00a8 24 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba\n\n\u00c2\u00c8\u00c6 \u00a1\u00e6\u00ba\u00f8 \u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6. \u00a6\u0097\u00b4\u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c2\u00bc\u00e0\u00bc \u00cc\u00cd \u00a3\u00b4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be\u00c8\u00bc \u00c6\u008a \u00bc\u00b8\u00e0\u00b6\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00a1\u00c6 \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0\u00ef\u00aa\u00d1\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00e6\u00d6\u00c6 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00c9\u00e6\u0091\u00f3\u00c7\u00be\u00b6\u00ea \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00ef\u00be\u00e5\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c4\u00be\u00e0\u00bc \u00c6\u00be\u00e0\u00be\u00b4\u00a8\u00c7\u00e6\u00b8\u00ea \u00bc\u00e6\u00a8\u00e0\u00d1\u00c4\u00b4 \u00a7\u00cd\u00ea \u00ba\u00c4\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c6\u00b4 \u00a8\u00e6\u00bf\u00d1\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6.\u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00ba\u00e0 \u00ef\u00cd\u00e0\u00ba\u00eb \u00ef\u00be\u00e5\u00ef\u00c0\u00be\u00e0\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u00ef\u00be\u00e5\u00ef\u00aa\u00c9\u00e5\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d6\u00c6 \u00c2\u00bc\u00e0\u00bc \u00cc\u00cd \u00a3\u00b4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a\u00bc\u00b8\u00e0\u00b6\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00bc\u00b6\u00c6\u00a8\u00f8\u00be\u00e0 \u00c0\u00c4\u00b8\u00a8\u00e0 \u00bc\u00b9\u00ea\u00c9\u008a \u00a8\u00ce\u00c6\u00ea\u00ba\u00eb \u00ef\u00cd\u00e5\u00e0 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00bc\u00b9\u00ea\u00c9\u008a\u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00c0\u00e6\u00cd\u00e6\u00d6\u00cd\u00e6\u00d6\u00c6\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00aa\u00e0 \u00bc\u00b8\u00e0\u00b6\u00be\u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00f8\u00be\u00e0 \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00b6\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7,\u00a6\u0097\u00b4 \u00a6\u00c9\u00e6\u00be\u00f8 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00b6\u00c6\u00a8\u00e0\u00ef\u00aa\u00d1\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 1979 \u00a1\u00e2\u00a8 15\u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 \u00c0\u00be\u00ef\u00ba\u00e0 291 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be(\u00a6\u00cd\u00fa (\u00a1), (\u00a1\u00e7) \u00cc\u00cd (\u00a6) \u00ef\u00d8\u00bc\u00c9\u00c8 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cd\u00e6\u00c7)\u00a1\u00bc\u00e5\u00ce \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6. \u00a6\u00e0 \u00bc\u00b8\u00e0\u00b6\u00be \u00be\u00f8\u00c6\u00c4\u00c6 \u00a8\u00c7\u00be \u00ef\u008c\u00c8\u00e5\u00ef\u00c9\u00cd\u00fa\u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c0\u00f2\u00a8\u00e5\u00c7 \u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00ce\u00cd\u00e6\u00a8\u00f8\u00c6.\u201d\n\n13.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00e5\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 12 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00ef\u0089."
