u00ce\u00ba \u00a3\u00bd\u0096\u00d5 \u00a9\u00b8 \u00a3\u00ce\u00c0\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb \u00a3\u00bd\u0096\u00cc\u00b4\u00c7\u0081\u00de \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00ce\u00ba\u00bb2005 \u00b1\u00b8\u00c1\u00bc\u00c8 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6 \u00a4\u00ae\u0088\u008b\u00dd\u00b7\u00c6\u00d7\u00ba\u00c6\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u0081 \u0089\u0081\u00b8\u00bc\u00c6 \u00ac\u00c1\u00c6\u00cd\u00c1\u00c7\u00bc\u00c7\u00ae\u00d5\u00ba\u00c6 0\u00b025 \u00b1\u00b6\u0096\u00b6\u00b9\u00c6\u00b9\u0088\u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00b1\u00f2\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00ce\u00b4\u00ce\u00ba\u00a3\u00bd\u0096\u00d5 \u00a9\u0081\u00bd\u00c1\u00ce\u00af\u008a\u00be\u00c6 \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00b6\u00c8\u00bc\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8\u00af\u00bf\u00c6\u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00c8\u00de\u00c1\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8 \u00cd\u00b6\u00b1\u00c8\u00bb\u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00c7\u00b4\u00c6\u00d5\u00b6\u00c6 \u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00d7\u00b4\u0081 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00ce\u00b4\u00bb \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00ce\u00bf\u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\