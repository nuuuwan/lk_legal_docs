    "chunk_text": "(\u00a7\u00a7) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be \u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081\u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be\u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c6 \u00ac\u0081\u00de \u00af\u00b5\u00c8\u00b1\u00ba\u00c7\u00b8 \u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00ce\u00bb\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b9\u00c6\u00b9\u00b6\u00c7\u00b8 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de\u00af\u00c6\u00d0,\n\n\u00a3\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb \u00af\u00b4\u00d9\u00b6\u008c\u008a\u0081 \u00a7\u00b1\u00c6\u00b1\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af ;\n\n(i) \u00ac\u00dd \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ac\u00dd \u00d0\u00e1\u008c\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00b8\u00c8\u00bb\u00c7\u00bf\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 2 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c642\n\n(ii) \u00e7\u00b4\u00c6\u00d5\u00cc\u00ba\u00c7\u00b6\u00c6\u00b6\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u2013\n\n(\u00a3) \u00ac\u00dd \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00b8\u00c7\u00df\u00ba\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b8\u00c1\u00bd\u00c6\u00de\u00bf\u00c6 \u00ac\u0081\u00bd\u00c8\u00b8\u00c7\u00df\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u0081\u00de\u00af\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bd\u00c6\u00bd\u00c8\u00b8\u00c7\u00df\u00ba\u00c6 :\u2013\n\n(\u00a3\u00a3) \u00a3\u00b6\u0081 \u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be \u00b7\u00c8\u00de\u00c1\u00b8+\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 ;\n\n(\u00a4\u00a4) \u00a3\u00b6\u0081 \u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00b8\u00c7\u00be\u00c6 ;\n\n(\u00a5\u00a5) \u00a3\u00b6\u0081 \u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be\u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a6\u00a6) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be \u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u0081 \u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be \u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c6 \u00ac\u0081\u00de\u00af\u00b5\u00c8\u00b1\u00ba\u00c7\u00b8 \u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00ce\u00bb\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b9\u00c6\u00b9\u00b6\u00c7\u00b8\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00ac\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 ;\u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4)\u00b6\u00b8\u00c8\u00bb\u00c7\u00bf\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c8\u00b8\u00c7\u00df\u00ba\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b8\u00c1\u00bd\u00c6\u00de\u00bf\u00c6 \u00ac\u0081\u00bd\u00c8\u00b8\u00c7\u00df\u00ba\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u0081\u00de\u00af\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bd\u00c6\u00bd\u00c8\u00b8\u00c7\u00df\u00ba\u00c6 :-\n\n(\u00a3\u00a3) \u00a3\u00c1\u00bc\u00d7 \u00cc\u00b7\u00dd+\u00c6\u00af\u00c8\u00bb \u00a7\u00bd\u008c\u00b8\u00bc\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 ;\n\n(\u00a4\u00a4) \u00a3\u00c1\u00bc\u00c6 \u00af\u00b5\u00c8\u00b1\u00ba\u00c7\u00b8 \u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00ce\u00bb\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00bf\u00c6\u00bf\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00d7 \u00cc\u00b7\u00dd+\u00c6\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 2 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c643\n\n\u00af\u00c8\u00bb \u00a7\u00bd\u008c\u00b8\u00bc\u00c6 \u00af\u00b5\u00c8\u00b1\u00ba\u00c7\u00b8\u00bf\u00e2 \u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00ce\u00bb\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u00d5\u00bf\u00c6\u00bf \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00ac\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 ;\n\n(\u00a5\u00a5) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081\u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be \u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 ;\n\n(\u00a6\u00a6) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081\u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00b8\u00c7\u00be\u00c6;\n\n(\u00a7\u00a7) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081\u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081\u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be \u00b7\u00c8\u00de\u00c1\u00b8\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 ;\n\n(\u00a8\u00a8) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be \u00b7\u00c8\u00de\u00c1\u00b8\u00cc\u00ba\u00c7\u0081\u00de\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081\u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081\u00d7\u00ce\u00b5 \u00b7\u00c8\u00ce\u00be \u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c6\u00af\u00b5\u00c8\u00b1\u00ba\u00c7\u00b8 \u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00ce\u00bb\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b9\u00c6\u00b9\u00b6\u00c7\u00b8\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00ac\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 ;\u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a9\u00a9) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b6\u00b8\u00c8\u00bb\u00c7\u00bf\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00d7 \u00ba\u00c8\u00af\u00cc\u00b7\u00dd+\u00c6\u00af\u00c8\u00bb \u00a7\u00bd\u008c\u00b8\u00bc\u00c6\u00af\u00b5\u00c8\u00b1\u00ba\u00c7\u00b8 \u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00ce\u00bb\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u00d5\u00bf\u00c6\u00bf \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de \u00b6\u008c\u00bc\u00c6\u00b7\u00c6\u00b6\" \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00d0\u00e1\u00cc\u00c1\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a5)\u008c\u00b4\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00cd\u00af\u00bd\u00c6\u00bd\u00c7\u00bd\u00c6\u00cd\u00b9\u00c7\u00be\"\u00b6\u00b8\u00c8\u00bb\u00c7\u00bf\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00ac\u0081\u00de \u00cd\u00b7\u00bc\u0088\u00bb\u00c7\u00af\u00cd\u00c1\u00c7\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 2 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c644\n\n\u00ba\u00ce\u00bd\u00db\u00af\u00ba\u00c7\u00af\u00cd\u00c1\u00c7 \u00a3\u00be\u00c6\u00be\u00d7\u00b7\u0081\u00ce\u00ba \u00cc\u00b9\u00de\u00b9\u00c1\u00bc\u00c7\u00af\u00cd\u00c1\u00c7 \u00a9\u00b7\u00c6\u00b6\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u0081\u00bd\u00c8\u00df\u00ba\u00c6 \u00af\u00b5\u00c8\u00b1\u00ba\u00c7\u00b8 \u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7\u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00b4\u00b6\u00c6\u00b6\u00af\u00c6\u00af \u00db\u00af\u00c7\u00ce\u00ba\u00b1\u00c6 \u00cc\u00b1\u00be\u00c6\u00c1\u00c7\u00af\u00c6\u00ce\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00bf\u00c6\u00bf\u00c7\u00cd\u00bc\u00c7\u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00af\u00c7\u00ae\u00d5\u00bf\u00c6\u00bf\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6\u00af\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00df\u00ba\u00c6\" \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\"\n\n\u00b9+\u00c6\u00d0\u00f2\u00be\u00b6\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00a4\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00d8{\u00bd\u00c6\u00de\u0096\u00b6\u00ba\u00c6\u00b0"
  },
