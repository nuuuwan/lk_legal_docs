    "chunk_text": "\u201c\u00a8\u00b8\u00db\u00bd\u00c6\u00bd \u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u00be\u00c6\u201d \u00a9\u0081\u00b9\u00d7 \u00b6\u00b8\u00d7 \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u0089\u00ce\u00c0\u00b9\u00c6\u00ce\u00b9\u00b6\u00c6 \u00cd\u00b6\u0088\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00b9\u00c7\u00d7\u00ba\u00c7\u00b8 \u00a3\u00bf\u00e2\u00af\u00c6\u00d0\u00b6\u00c6 \u00b6\u00b8\u00af\u00c6\u00d0 \u00a4\u00b6\u00c7\u00bc\u00b6\u00c6\u00ce\u00b6 \u00cd\u00b6\u0088\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\n\n\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00cd\u00af\u00c7\u00b4\u00be\u00c6\u00b0\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8 \u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 37 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c618\n\n\u201c\u00ba\u00b5\u00b3\u00c6\u00b1\u00c7\u00c7\u00c6\u201d \u00a9\u0081\u00b9\u00d7, \u0089\u00bf\u00c6\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7\u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u00cc\u00be\u00c7\u0081\u00de \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u0089\u00be\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7 \u00b6\u00c8\u00dd\u00ba\u00b5\u00b3\u00c6 \u00cc\u00b1\u00bb\u00c6\u00b6 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00c7\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6\u0089\u00bd\u00b7\u00c6\u00b6 \u0089\u00bf\u00c6\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u00be\u00c6 \u00a9\u00b8\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6;\n\n\u201c\u00ba\u00b5\u00b3\u00c6\u00b1\u00c7\u00bc\u00c7\u201d \u00a9\u0081\u00b9\u00d7, \u0089\u00bf\u00c6\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7\u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u00cc\u00be\u00c7\u0081\u00de \u00cc\u00b6\u00c7\u00b4\u00c7\u00c6\u0089\u00be\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7 \u00b6\u00c8\u00dd\u00ba\u00b5\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00c7\u00b6 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00c7\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6\u0089\u00bd\u00b7\u00c6\u00b6 \u0089\u00bf\u00c6\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u00be\u00c6 \u00a9\u00b8\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n\u201c\u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00c7\u00c6\u201d \u00a9\u00b8\u00c6\u00b9\u00d7 \u00ba\u00af\u00cd\u00c1\u00bd\u00c6\u00da \u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00ce\u00bc\u00dc\u00ba\u00c6\u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6 ;\n\n\u201c\u00b1\u00ba\u00c6\u00b9\u00bf\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00d7, \u00a9\u00be\u00c6\u00be\u00c7\u00b9\u00c6 \u00b9\u0088\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cd\u00c1\u00b6\u00b8+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6\u00b0\n\n\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\n\n\u00b9\u0088\u00c1 \u00a5\u00be\u00b01\n\n1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 37 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u0089\u00bc\u00b6\u00c8\u00c1\u00c7\u00b6\u00c8\u00cc\u00bb\u00c7\u00dd\u00c1\u00dd\u00af\u00c6\u00af\u00c7\u00b8 \u00a3\u00ce\u00c0\u00b9\u00c6\u00da\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b0\n\n\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 \u00ab\u00b1\u00c6 \u00cd\u00b1\u00c7\u00c6\u00b7\u00c6\u00b6 \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 \u00a9\u0081\u00b9\u00c1\u00dd\u00af\u00c6\u00d0\u00b0\u00a7\u00ba\u00d7 \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6 \u00d7\u00ce\u00b5\u00ce\u00bb \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0(\u00cc\u00b9\u00bb\u00c7\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00b4\u00e2\u00ba\u00c6)(\u00a3\u00be\u00c6\u00be\u00d7 \u0089\u00bf\u00c6\u00ce\u00bf\u00ce\u00bb / \u00c1\u00bb\u00d7 \u00c1\u00b7\u00c6\u00b6 \u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u00ce\u00be / \u00a5\u00bb\u00be\u00c7\u00ce\u00ba \u00a7\u00bf\u00c6\u00bf\u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u00ce\u00be) \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 (\u00cc\u00b9\u00bb\u00c7\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00d5\u00af) \u00a3\u00be\u00c6\u00be\u00d7\u00b6\u00c7\u008a\u0081 \u00cc\u00b9\u00bb\u00ce\u00bc\u00af\u00c6 \u00e7\u00bd\u00c8\u00b9\u00c6 \u0089\u00bf\u00c6\u00ce\u00bf\u00ce\u00bb\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00d5\u00af) \u00b7\u00c9\u00c7\u00c6 \u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00af\u00c6\u00af\u008c\u00be\u00c6\u00ce\u00be\u00a9\u0081\u00bd \u00d0\u00bd\u00c6\u00bd\u00b1\u00c6\u00b1\u00c7\u00b4\u00c6\u00d5\u00af\u00c6\u00d0 \u00ba\u00de\u00cc\u00ba\u00c7\u00c0\u00c8 \u00e7\u00de\u00c1\u00b6\u00bd\u00c6\u00d0 \u00b7\u00c9\u00c7\u00c6 \u00b1\u00db\u00af\u00ba\u00bf\u00c8\u00b9\u00c6\u00b9\u00d7\u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00b8\u00b6\u00c7\u00b6\u00be\u00c7\u00df\u00ba\u00c6 :\n\n\u00a3\u00be\u00c6\u00be\u00d7\u00a7\u00ba\u00d7 \u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00c6\u00d0 / \u00c1\u00bb\u00d7 \u00c1\u00b7\u00c6\u00b6 \u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u00df\u00af\u00c6\u00d0 / \u00a5\u00bb\u00be\u00c7\u00ce\u00ba \u00a7\u00bf\u00c6\u00bf\n\n\u00c1\u00c0\u00c8\u00b6\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u00df\u00af\u00c6\u00d0 / \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6 \u00d7\u00ce\u00b5\u00af\u00c6\u00d0 \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0....\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 (\u00cc\u00b9\u00bb\u00c7\n\n(\u0089\u00c7\u00c8\u00e2 15)\n\n1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 37 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c619\n\n\u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00d5\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00ba\u00cd\u00be \u00a7\u00bf\u00c6\u00bf\u00c1\u00c7\u00de \u008c\u00b9\u00c7\u00c8\u00af\u00c6\u00af\u00e2\u00ba\u00c6) \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00af\u00c7\u00be\u00ba\u00c7\u00af (\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00ce\u00bb\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00b4\u00e2\u00ba\u00c6) \u00cd\u00b9\u00c7\u00ba\u00b6\u00c8\u00bb\u00c7\u00b8 \u00b9\u0088\u00ce\u00bb\u00af\u00c6\u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00c7\u00b6\u00b6\u0081 \u00f2\u00be\u00ba\u00c6 1999 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 37 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af,\u00b9\u00bc\u00c7\u00ba\u00c7\u00c8\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00c9\u00c0\u00c6 \u00a7\u00ba\u00af\u00c6\u00d0 \u00a9\u00b6\u00c8\u00bc\u00c7\u00af \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00c7\u00b9\u00c7\u00c8\u00b9\u00c6\u00da\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00ac\u0081\u00ce\u00bd \u00ba\u00c9\u00bd\u00c8\u008a\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00d0\u00bd\u00c6\u00bd\u00b1\u00c6\u00b1\u00c7\u00b4\u00c6\u00d5\u00af\u00c6\u00d0 \u00ba\u00de\u00cc\u00ba\u00c7\u00c0\u00c8 \u00e7\u00de\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a7\u00ba\u00d7 \u00b1\u00f2\u00af\u00ba\u00c6\u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00b8\u00b6\u00c7\u00af \u00a7\u00bf\u00c6\u00bf\u00b6\u00c7\u00b6\u00be\u00c7\u00df\u00ba\u00c6 :"
