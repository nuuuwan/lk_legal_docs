    "chunk_text": "(v) \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8\u00c6\u00a8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00be\u00e6\u00c9\u00ba\u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00ef\u008a \u00c9\u00da\u00bd\u00be\u00c6\u00a1\u00b6\u00c0\u00b8 \u00a8\u00c7\u00be \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00cc\u00e9\u00c4\u00e5\u00c9\u00be\u00e0\u00b4\u0097\u00cc\u00df\u008a \u00c8\u00c2\u00e5 \u00bc\u00fb\u00ef\u008a \u00c4\u00e5\u00da\u00aa \u00ef\u00cc\u00e5\u00c6\u00e5 \u00c2\u00e6\u00c8\u00e9\u00c4 \u00cc\u00cd \u00c9\u00e6\u00b6 \u00cc\u00b4\u00cd\u00be\u00e0\u00cc\u00bf\u00cd\u00e5 \u00cc\u00ea\u00c3\u00cc\u00e5\u00bd\u00be\u00c6 ,\n\n\u00a1\u00e6\u00ba\u00eb\u00dd\u00c9, \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00be\u00e0 \u00bc\u00fa\u00d6\u00c4\u00ba\u00e0 \u00a8\u00c7\u00be \u00cc\u00cd \u00a6\u00e0\u00c9\u00e5 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4\u00cc\u00e5\u00bd\u00be\u00f9\u00c6 \u00c0\u00d6\u00cc\u00c7\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00f8\u00d7\u00c4 ;\n\n(ii) \u00ba\u00c7\u00aa\u00a8\u00e5\u00d7\u00ba\u00e0\u00c9\u00ef\u00c6\u00e0 \u00c4\u00ec\u00c8\u00bd\u00da\u00c4 \u00c4\u00ba \u00c0\u00bc\u00be\u008a \u00a8\u00c7\u00aa\u00ba\u00e0\u00c6\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00bc\u00fa\u00d6\u00aa\u00e6\u00be\u00e0\u00d1\u00ef\u008a \u00a4\u00c0\u00a8\u00f2\u00c4 \u00cc\u00cd \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00c9\u00ec \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00c0\u00bc\u00be\u008a \u00a8\u00c7 \u00aa\u00ba\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba\u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00c6\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00bc\u00fa\u00d6\u00c4\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00e8\u00c6\u00c9\u00c7 \u00ef\u00cc\u00e5\u00c6\u00e5\u00aa\u00e6\u00be\u00f9\u00c4,\n\n\u00a1\u00e6\u00ba\u00eb\u00dd\u00c9, \u00be\u00e6\u00c9\u00ba \u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00cc\u008a\u00c0\u00ba\u00e0 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6\u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00a1\u00c7\u00c4\u00ea\u00b8\u00ea \u00a8\u00c7\u00aa\u00ba\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8\u0097\u00ca\u00e0\u00ef\u00c8\u00e0\u00cb\u00b8\u00c6 \u00ef\u00a8\u00e5\u00b4 \u00be\u00f8\u00da\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a6\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e6\u00c8\u00cc\u00ea\u008a\u00cc\u00a8\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a2)\u00c7\u00b4 \u00ba\u00eb\u00c8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00a1\u00e2\u00ca\u00ef\u00c6\u00e0 \u00cc\u00ea\u00be\u00f8\u00ba\u00f1\u00c3\u00e5\u00c9\u00c6 \u00cc\u00cd \u00c6\u00cd\u00c0\u00ba\u00e0 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00c4\u00cc\u00be\u00e5\u00bb \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u2014\n\n(i) \u00b8\u00c6 \u00c9\u00e6\u0091\u00f3\u00c7\u00b4\u00ba\u00e0 \u00c8\u00c2\u00e5 \u00bc\u00e9\u00c4 \u00a2\u00cd\u00c8 \u00be\u00e6\u00e2\u00d1\u00c4 \u00cd\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0\u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00c4\u00e5\u00da\u00aa\u00ef\u00c6\u00be\u00e0 \u00be\u00e6\u00c9\u00ba \u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6, \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00a8\u00e5\u00da\u00c6\u00a8\u00e0\u00cb\u00c4\u00ba\u00e5\u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00cc\u00cd \u00aa\u00f2\u00e5\u00e4\u00c6 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4\u00cc\u00cd \u00cc\u00e2\u00c7\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00db\u00cc\u00e0\u00a8\u00f8\u00d7\u00c4\u00b4 \u00c9\u00e6\u00b6\u00cc\u00b4\u00cd\u00be\u00e0 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ; \u00cc\u00cd\n\n2007 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00be\u00f8\u00ba\u00f1 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba7\n\n(ii) \u00a1\u00e5\u00be\u00c6\u00be\u00f8\u00a8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00c4\u00ba \u00c6\u00e6\u00c0\u00e9\u00c4 \u00a1\u00b6\u00ea \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be,\u00be\u00e6\u00c9\u00ba \u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6,\u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00a8\u00e5\u00da\u00c6\u00a8\u00e0\u00cb\u00c4\u00ba\u00e5 \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4, \u00cc\u00e2\u00c7\u00a8\u00e0\u00cb\u00b8\u00c6\u00cc\u00cd \u00aa\u00f2\u00e5\u00e4\u00c6 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00c6\u00be \u00a1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00be\u00f8\u00c6\u00c4\u00ea\u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8 \u00cc\u00bf\u00cd\u00e5, \u00a1\u00e5\u00bd\u00e5\u00c7 \u00cc\u00cd \u00a1\u00e5\u00c7\u008a\u00c3\u00a8 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00c6 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4,\n\n\u00a1\u00e6\u00ba\u00eb\u00dd\u00c9, \u00be\u00e6\u00c9\u00ba \u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6,\u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00a8\u00e5\u00da\u00c6\u00a8\u00e0\u00cb\u00c4\u00ba\u00e5 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a \u00cc\u00cd \u00cc\u00e2\u00c7\u00a8\u00e0\u00cb\u00b8\u00c6,\u00aa\u00f2\u00e5\u00e4\u00c6 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00be\u00e0 \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4\u00cc\u00cd \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e0\u00ba\u00eb \u00c9\u00be \u00cc\u00e5\u00bd\u00be\u00f9\u00c6 \u00c0\u00d6\u00cc\u00c7\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a3)\u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00a1\u00e2\u00ca\u00ef\u00c6\u00e0 \u00c0\u00c7\u00f3 \u00bc\u00c7\u00be\u00e0\u00be\u00be\u00e0\u00ef\u00aa\u00e0 \u00cd\u00e6\u00a8\u00f8\u00c6\u00e5 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6\u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c6\u008a \u00c0\u00c7\u00f3\u00bc\u00c7\u00be\u00e0\u00ef\u00be\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00c0\u00da\u00ef\u00c6\u00e0\u00cb\u00b8 \u00cc\u00cd\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00c7\u00a8\u008a \u00cc\u00bf\u00cd\u00e5 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00e8\u00a8 \u00cc\u00cd \u00c4\u00ea\u00c8\u00f1 \u00cc\u00cd\u00e5\u00c6\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 ;\n\n(\u00a4) (i) \u00c2\u00e5\u00bd\u00a8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7 \u00c9\u00e5\u00b8\u00e8\u00b0\u00c4\u00c6 \u00c4\u00ea\u00c8\u00f1 \u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00ef\u008c\u00ca\u00d1\u00c4\u00b4 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00b4 \u00cc\u00cd\u00e5\u00c6 \u00c9\u00be \u00be\u00c9\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4 \u00be\u00f8\u00da\u00c4\u00e5\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 ; \u00cc\u00cd\n\n(ii) \u00c6\u008a \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00c0\u00d6\u00cc\u00c7\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00b8\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00cd\u00e6\u00a8\u00f8 \u00cc\u00cd\u00be\u00bc\u00e5\u00c6\u00fb \u00c4\u00ea\u00c8\u00f1\u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00ef\u008c\u00ca \u00d1\u00c4\u00b4 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00b4\u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00cc\u00e6\u00c8\u00cc\u00e9\u00c4 \u00cc\u00cd \u00cc\u00cd\u00e5\u00c6 \u00d1\u00c4,"
