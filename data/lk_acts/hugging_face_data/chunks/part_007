    "chunk_text": "\u00a6\u00a8\u00f9 \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00ca\u00e8\u00a8\u00e0\u00cb\u00b8 \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8 \u00c0\u00c9\u00c7\u00e5\u00ef\u00aa\u00be \u00a6\u00c6 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6\u00a8\u00c7\u00be \u00ef\u00c8\u00cc \u00a6\u00a8\u00f9 \u00a8\u00e6\u00ce\u00b8\u00e8\u00c6 \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c7\u00b0\u00ef\u00c6\u00be\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e5\u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00c6\u00e8\u00be\u00e0 \u00cc\u00cd \u00a6\u00ef\u00cc\u00e0 \u00c0\u00e6\u00c9\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00e6\u00c8\u00e6\u00cc\u00e0\u00d1\u00c4 \u00c4\u00cd\u00b0\u00be\u00c6\u00cd\u00c0\u00ba \u00cc\u00bf\u00cd\u00e5 \u00c9\u00be \u00ef\u00cd\u00c6\u00e8\u00be\u00e0 \u00bc:\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c4\u00ef\u00cc\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089:\u2014\n\n2007 \u00a1\u00e2\u00a8 51 \u00bc\u00c7\u00be \u00aa\u008a\u00c0\u00cd \u0097\u00a8\u00f2\u00c4\u00e5\u00c7\u0083\u008e \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u00ca\u00fa\u00a8\u00e0\u00cb\u00b8 \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8 (\u00c0\u00e6\u00c9\u00d7\u00ef\u008a) \u00c0\u00be\u00ba2\n\n2.(1) 1978 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8 \u00c0\u00be\u00ef\u00ba\u00e0 24\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 1995 \u00ef\u00c0\u00c2\u00c7\u00c9\u00e5\u00d6 \u00c4\u00cc 23 \u00c9\u00be \u00bc\u00fa\u00be \u00a1\u00e2\u00a8 859/12\u00bc\u00c7\u00be \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce \u00a8\u00c7\u00be \u00c8\u00bc \u00be\u00f8\u00c6\u00c4\u00c6 \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00a8\u00e6\u00ce\u00b8\u00e8\u00c6\u0097\u00ca\u00e0\u00c9 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u00b4 \u00a1\u00be\u00ea\u00c2\u00bc\u00e0\u00bd \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00bc\u00e5 \u00c9\u00ec \u00bc \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0\u00c9\u00b6\u00e5\u00ba\u00e0 \u00cc\u0097\u00cc\u00e0\u00ba\u00c7\u00c9 \u0097\u00cc\u00e0\u00ba\u00c7 \u00ef\u00a8\u00e5\u00b4 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc \u00aa\u008a\u00c0\u00cd \u0097\u00a8\u00f2\u00c4\u00e5\u00c7\u0083\u008e\u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u00b4 \u00a1\u00e7\u00bf\u00e5 \u00a1\u00e6\u00ba\u00e8 (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00ef\u00c7\u00e5\u00e0\u00cd\u00c8\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be ) \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8 (\u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00b4 \u00a2\u00cd\u00ba\u00f8\u00be\u00e0 \u00c9\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0\u00ef\u00c7\u00e5\u00e0\u00cd\u00ef\u00c8\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c3\u00e5\u0097\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e8\u00c6\u00f5 \u00cc\u0097\u00a8\u00f8\u00d7\u008a \u00c0\u00e8\u00d6\u00c6\u00ba\u00a4\u00c0\u00a8\u00c7\u00b8 \u00cd\u00e5 \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u0097\u00cc\u00e0\u00ba\u00c7\u00c6\u00a8\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 ) \u00a6\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a8\u00c9\u00c7 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c9\u00be\u00e0\u00bc\u00fa \u00ef\u00aa\u00d1\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c9\u00be\u00c6\u008a \u00ef\u00aa\u00d1\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00ef\u00c9\u00be\u00c0\u00c7\u00e8\u00bc\u00fa \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9 \u00ef\u00c9\u00ba \u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2)\u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00c6\u00b4 \u00a2\u00cd\u00ba\u00f8\u00be\u00e0\u00c4 \u00c9\u00ec \u00bc\u00e8\u00be\u00ef\u00c6\u00e0 \u00ef\u00c7\u00e5\u00e0\u00cd\u00ef\u00c8\u00e0 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00e0\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c9 \u00cc\u00e8\u0090\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec \u00cc\u00e8\u00c6\u00f5\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00cd\u00b4 \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u00c9\u00cd\u00e8 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00e8\u00c6 \u00c0\u00e8\u00d6\u00be\u00c4\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 ,\u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00c6\u00b4 \u00a2\u00cd\u00ba\u00e8\u00be\u00e0 \u00c9\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00a7\u00c9\u00ea\u00be\u00e0 \u00c3\u00eb\u00a8\u00e0\u00ba\u00f8 \u0097\u00bf\u00fa \u00be\u00f8\u00c6\u00c4 \u00cd\u00e5\u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8\u00c9\u00c8\u00b4 \u00c9\u00b6\u00e5 \u00a1\u00b6\u00ea \u00c9\u00e5\u00cc\u00e8 \u00cc\u00cd\u00aa\u00ba \u00ef\u00be\u00e5\u00c9\u00be \u00be\u00f8\u00c6\u00c4 \u00cd\u00e5\u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8 \u00c4\u00ba \u00a7\u00c9\u00ea\u00be\u00e0 \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00cd\u00fa\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00ba\u00c9 \u00bc \u00a7\u00c9\u00ea\u00be\u00e0 \u00ef\u00c7\u00e5\u00e0\u00cd\u00ef\u00c8\u00e0 \u00a8\u00e5\u00da\u00c6 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4\u00c0\u00ba\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3\u00c9 \u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0\u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00be \u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00a8\u00e5\u00c8\u00c6 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u0097\u00ca\u00f2\u00e5\u00c4\u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00cc\u00cd\u00fa\u00ba \u00ef\u00cc\u00e0\u00c9\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00aa\u00b8\u00be\u00e0 \u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6 :\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc , \u00a6\u00c9\u00e6\u00be\u00f8 \u00c0\u00e8\u00d6\u00be\u00e6\u00e4\u00c4\u00a8\u00e0 \u00c3\u00e5\u00c7 \u00ef\u00be\u00e5\u00aa\u00be\u00ea \u00c8\u00c2\u00be\u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6\u00be\u00e0 \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00e8\u00cc\u00e0\u00ef\u008c\u0083\u00af\u00e5\u00ef\u00c9\u00be\u00e0 \u00ba\u00c4 \u00ef\u00cc\u00e0\u00c9\u00c6 \u00cd\u00e6\u00c7\u00aa\u00fa\u00c6\u00e5\u00ef\u00cc\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a7\u00c9\u00ea\u00be\u00e0\u0097\u00ca\u00f2\u00e5\u00c4 \u00c6\u00e5\u00ef\u008a \u00bc\u00e9 \u00a7\u00c9\u00ea\u00be\u00e0\u00b4 \u00cd\u00fa\u0095\u00a8\u008a \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00a1\u00da\u00bb\u00c8\u00e5\u00c3 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c0\u00d6\u00bc\u00e8 \u00c9\u00ec \u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00ba\u00e0 \u00c9\u00be\u00e0\u00bc\u00fa \u00ef\u00cd\u00e5\u00e0\u00c0\u00e5\u00d6\u00ef\u00ba\u00e5\u00e0\u00cb\u00e8\u00a8 \u00c7\u00b0\u00ef\u00c6\u00be\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a7\u00c9\u00ea\u00be\u00e0\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6.\n\n(3) \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00cc\u00cd \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9_"
