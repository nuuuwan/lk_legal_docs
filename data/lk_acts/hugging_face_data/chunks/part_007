    "chunk_size_bytes": 3327,
    "chunk_text": "\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0\u00ba\u00eb\u00ce \u00c0\u00e8\u00cd\u00fa\u0090 \u00be\u00e6\u00c9\u00ba\u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00cc\u008a\u00c0\u00ba\u00e0\u00cc\u00e2\u00c7\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00cc\u00bf\u00cd\u00e5 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00c9\u00aa\u00a8\u00f8\u00c9 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6\u00b4 \u00ef\u00cd\u00e5\u00e0\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6\u00b4 \u00a1\u00e6\u00ba\u00e6\u008a\u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00be\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00ba\u00cd\u00be\u008a \u00c2\u00c9.\n\n\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0\u00ba\u00eb\u00ce \u00a1\u00e6\u00ba\u00f8 \u00be\u00e6\u00c9\u00ba\u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00cc\u008a\u00c0\u00ba\u00e0\u00c9\u00c8\u00a1\u00c6\u00fa\u00ba\u00f8\u00c6 \u00b0\u00be\u00c7\u00b0\u00c6\u00b4\u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9.\n\n2007 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00be\u00f8\u00ba\u00f1 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba16\n\n16.(1) \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00be\u00f9\u00ba\u00f8\u00c6\u00a8 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8 \u00c0\u00b4\u00cd\u00e6\u00be\u00f8\u00c9 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00c9\u00ea\u00c9 \u00bc, 71 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9, \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0\u00ba\u00eb\u00ce \u00cc\u00cd \u00ba\u00ba\u00e0\u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00f8\u00be\u00e0 \u00c9\u00ec \u00a1\u0093\u00a8\u00e5\u00d6 \u00c2\u00c8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cd\u00e6\u00c7, \u00a8\u00f8\u00cc\u00e8\u00f3 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00c2\u00c8\u00c6 \u00b0\u00be\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be \u00c4\u00bd\u00f1\u00c4 \u00b0\u00e5\u00c8\u00c6\u00ba\u00eb\u00ce \u00c9\u00ec \u00be\u00e6\u00c9\u00ba \u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8 \u00be\u00f8\u00c7\u00ba\u00ef\u00c9\u0095\u00be\u00e0\u00a6\u00c9\u00e6\u00be\u00e0\u00be\u00a8\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00e5\u00c4 \u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00ba\u00eb\u00ce \u00c4\u00bd\u00f1\u00c4 \u00b0\u00e5\u00c8\u00c6 \u00ba\u00eb\u00ce \u00c9\u00ec \u00be\u00e6\u00c9\u00ba \u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8 \u00be\u00f8\u00c7\u00ba\u00ef\u00c9\u0095\u00be\u00e0 \u00a6\u00c9\u00e6\u00be\u00e0\u00be\u00a8\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00e5\u00c4\u00a1\u00ef\u00c0\u00e0\u00a8\u00e0\u00cb\u00e5 \u00a8\u00c7\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0, \u00be\u00f8\u00c6\u0095\u00ba \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 \u00cc\u00cd \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00c8\u00e0\u00a9\u00be \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00a6\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00be\u00f8\u00c6\u0095\u00ba \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8 \u00c0\u00ba\u00f2\u00c6\u00a8\u00f8\u00be\u00e0,\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb-\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\u2014\n\n(\u00a1)\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c3\u00ed\u00ef\u00aa\u00e5\u00e0\u00c8\u00e9\u00c6 \u00c0\u00e8\u00cd\u00fa\u009b\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c9\u00ec \u00cc\u00e8\u00ba\u00f8\u00c6\u00ef\u008a\u00c0\u00e8\u00b4\u00c0\u00ba\u00a8\u00e0 ;\n\n(\u00a1\u00e5)\u00b0\u00be\u00be\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8 \u00ca\u00a8\u00e0\u00ba\u00f8 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00ef\u00a8\u0090 \u0097\u00cc\u00e0\u00ba\u00c7\u00c6\u00a8\u00e0 ;\n\n(\u00a1\u00e6)\u00ef\u00c6\u00e5\u00bc\u00e5\u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00c0\u00f2\u00ca\u00cc\u00e0\u00ba\u00a8\u00c7\u00b8 \u00a4\u00c0\u00c4\u00e5\u00be\u00c6 \u00a1\u00e6\u00ba\u00eb\u00dd \u00c4\u00ea\u00c8\u00f1\u00cc\u00e6\u00c8\u00cc\u00ea\u00c4 \u00cc\u00cd \u00a1\u00e6\u00cc\u00e0\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00aa\u00ba \u00c4\u00ea\u00dd \u00c0\u00e8\u00d6\u00c9\u00e6\u00c6 ;\n\n(\u00a1\u00e7)\u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00ba\u00e0 \u00c4\u00ea\u00c8\u00f1 \u00c0\u00f2\u00ba\u00f8\u00c0\u00e5\u00bc\u00be \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4 \u00cc\u00e5\u00bd\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00cc\u00bf\u00cd\u00e5 \u00a1\u00c9\u00ca\u00f1 \u00a8\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c8\u00c2\u00e5\u00aa\u00be\u00e0\u00be\u00e5 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6 ;\n\n\u00c4\u00bd\u00f1\u00c4 \u00b0\u00e5\u00c8\u00c6 \u00ba\u00eb\u00ce \u00c9\u00ec\u00be\u00e6\u00c9\u00ba \u00c2\u00c8\u00aa\u00e6\u00be\u00e0\u0097\u00c6\u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8.\n\n2007 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00be\u00f8\u00ba\u00f1 \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8\u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba17\n\n(\u00a2)\u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00e8\u00cd\u00fa\u009b\u00c4 (\u00a6\u00c6 \u00b0\u00c8\u0097\u00f3\u00c8\u00e8 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u008c \u00be\u008a,\u00aa\u00e2\u00aa\u00e5\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00fa\u00c6 \u00c0\u00cd\u00c7\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00b0\u00e5\u00ef\u00a8\u00e5\u00b4\u00ea\u00c9 \u00cc\u00cd \u00c2\u00c8\u00e5\u00aa\u00e5\u00c7\u00c6,\u00a6\u00c6 \u00cc\u00ea\u00ce\u00e2 \u00c2\u00c8 \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u008c \u00be\u008a, \u00cc\u00ea\u00ce\u00e2 \u00ba\u00c8\u00c2\u00c4\u00be \u00cc\u00cd\u00c9\u00f1\u00ea\u00cd\u00c6\u00be\u00e0, \u00a6\u00c6 \u00ef\u00ef\u00b0\u00c9 \u00cc\u00e0\u00a8\u00be\u00e0\u00bd \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u008a \u00be\u008a \u00a2\u00be\u00e0\u00bd\u00be\u00c9\u00aa\u00e5\u00c9, \u00c2\u00c8\u00e5\u00aa\u00e5\u00c7\u00c6 \u00cc\u00cd \u00b0\u00c8 \u00c4\u00ec\u00c8\u00e5\u00ca\u00f2\u00c6 \u00cc\u00cd \u00a6\u00c6 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u008c \u00be\u008a, \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00c4\u00ec\u00c8\u00e5\u00ca\u00f2\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9\u00c0\u00d6\u00c9\u00da\u00ba\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00be\u00e8\u00c4\u00e5\u00c9\u00be\u00e0) ; \u00cc\u00cd\n\n(\u00a3)\u00b0\u00be\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u0097\u00f3\u00c8\u00e8\u00c2\u00c8\u00c6 \u00c4\u00ea\u00bc\u00e5\u00cd\u00e6\u00d7\u00c4\u00b4 \u00a2\u00c8\u00e0\u00f5\u008a\u00a8\u00c7\u00e6\u00a1\u00ef\u00c0\u00e0\u00a8\u00e0\u00cb\u00e5 \u00a8\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00ef\u00a8\u00ef\u00cc\u00e0\u00bc \u00c6\u00be\u00e0\u00be\u00ba\u00e0, \u00b0\u00e5\u00ba\u00f8\u00a8 \u0097\u00f3\u00c8\u00e8\u00c2\u00c8\u00b0\u00e5\u00c8\u00c6\u00b4 \u00b0\u00be\u00a8 \u00c6\u00be\u00e0\u00ba\u00f2\u00c6 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00cc\u00cd \u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00bc\u00fa\u00be \u0097\u00f3\u00c8\u00e8 \u00db\u00cd\u00e6\u00be\u00e0 \u00c4\u00e5\u00da\u00aa\u00c6\u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00c3\u00ed\u00ef\u00aa\u00e5\u00e0\u00c8\u00e9\u00c6 \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00bc \u00c0\u00e6\u00cd\u00e6\u00bc\u00fa\u00c8\u00e8 \u00a8\u00c7\u0095\u00be\u00e0\u00c9\u00ec \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0."
