    "chunk_text": "(v)\u00ba\u00b6+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00ce\u00b4\u008a\u00be\u00c6 \u00ac\u00b6\u00c6\u00b6\u00c8\u00ce\u00b1\u00ce\u00c1 \u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 ;\n\n\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00cc\u00b9\u00c7\u00d7\u00af\u00c6\u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00bf\u00c6\u00b0\n\n32007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 38 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af \u00b9\u00af\u00c1\u00c7\u0081\u00fe \u00b1\u00b6\u00c6\u00bb \u00b1\u00c7\u008a \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u0081 \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b1\u00ce\u00b9 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(vii)\u00aa\u00b6\u00c7\u00c1\u00d7 \u00b9\u00c7\u00b4\u00b1\u00c7\u00ce\u00be\u008a\u00be\u00c6\" \u00af\u00be\u00c6\u00df{\u00bc\u00c8\u008a\u00be\u00c6\" \u00b9\u00be\u00c6\u00af\u00ce\u00be\u00af\u00c6\u00af\u00c0\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u00b8\u00c7\u00be\u00c6 \u00a3+\u00c6\u00af\u00c9\u00af\u00c7\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00c1\u00de \u00b7\u00c8\u00de\u00c1\u00b8\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b6\u00ce\u00af\u00ce\u00ba\u00dc\u00ce\u00b4\u00bb\u00ba\u00c7\u00b5\u00c1\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00da\u00be\u00ce\u00ba\u00b9\u00c6 \u00b9\u00bc\u00c8\u00b1\u00c8\u00be\u00c6\u00af\u00ce\u00bf \u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6 ;\n\n(viii)\u00a7\u00b6\u008c \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd \u00ba\u00c7\u00b5\u00c1\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00da\u00b6\u00c6\u00b6\u00af+\u00c6\u00af\u00bf\u00c6\"\u00a7\u00b9\u00af\u00bc\u00b5+\u00c6\u00af\u00bf\u00c6\" \u00a4\u00ce\u00b4 \u00a3\u00b5\u00c8\u00af\u00be\u0081\u00af\u00bf\u00c6 \u00a9\u00b8\u00c6\u00b9\u00c1\u00bd\u00c6\u00ce\u00bd\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6\" \u00af\u00b4\u0081 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8\u00b1\u00c7\u00bc\u00c6\u00b7\u0081\u00cc\u00af\u00c7\u00ce\u00b4\u00af\u00ce\u00bf \u00c1\u00c0+\u00c6\u00d0\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 \u00a7\u00b6\u008c\u00da\u00bc\u00c8\u00b6\u00be\u00c6;\n\n(ix)\u00af\u00be\u00c6\u008c \u00db\u0081\u00cd\u00b8\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00aa\u00d7\u00c1\u00c7\u00af \u00a3\u00ce\u00ba\u00bb\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00d0\u00b9\u00c6\u00da\u00af\u00bf\u00c6\" \u008c\u00bc\u00c8\u00e2\u00ce\u00bc\u00af\u00bf\u00c6\" \u00af\u00dd\u00b6\u00c6\u00b6\u00bc+\u00c6\u00d0\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00af\u00be\u00c6\u008c\u00b1\u00c6 \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00af\u00c6\u00af\u00ce\u00bf \u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00c1\u00d7\u00b4\u0081\" \u00a3\u00b6\u00cd\u00b8\u00c7\u00d5\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00ce\u00b4\u00bb \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00c1\u00de \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c8\u00be\u00c6 \u00a6\u00d5\u00b9\u00d5\u00b6\u00df\u00ba\u00c6;\n\n(x)\u00c1\u00bd\u00c8\u00bb\u00c1\u00bc\u00c6\u00af\u00bf\u00c6\" \u00db\u00b6\u00c8\u00bb\u00c1\u00bc\u00c6\u00af\u00bf\u00c6\" \u00a8\u00b8\u00db\u00bd\u00c6\u00bd\u00c1\u00bc\u00c6\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00a3\u00b7\u00c7\u00ce\u00b6\u00b9\u00c6 \u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00e0\u00af\u00c6\u00d0 \u00a5\u00be\u00c6\u00be+\u00c6\u00af\u00ce\u00bf \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6 ;\n\n(xi)\u00a5\u00b4\u00dd\u00bd\u00c6\u00bd \u00a4\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00b9+\u00c6\u00af\u00c9\u00b4\u00c6\u00d5 \u00a7\u00b5\u00e2\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\" \u00a7\u00b5\u00e2\u00af\u00bf\u00c6\" \u00a7\u00ce\u00b4\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u0089\u00bd \u00a7\u00b6\u008c\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6 ;\n\n(xii)\u00cd\u00b7\u00c7\u00dc\u00bd\u00c6\u00bd \u00a4\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b1\u00c6 \u00b1\u00c8\u00af\u00c8\u00b1\u00c6\u00ce\u00b1 \u00a3\u00bf\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00ba\u00dd\u00b6\u00c6\u00d7\u00c1\u00ba\u00ce\u00b8\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u0089\u00b5\u00c8\u00bb\u00c7\u00bb\u00c6\u00e2 \u00b7\u00c8\u00ce\u00be\u00bb+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00b7\u00c8\u00dd\u00ba\u00c7\u00b5\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\" \u00b6\u00c7\u0089\u00b6\u00c6\u00b6\u00be\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6;\n\n(xiii)\u00cd\u00b7\u00c7\u00dc\u00bd\u00c6\u00bd \u00a4\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00ba\u00dd\u00b7\u00c6\u00d7\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00ba\u00dd\u00b6\u00c6\u00d7\u00c1\u00b1\u00c8\u00af\u00c8\u00b1\u00c6\u00ce\u00b1\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6 ;\n\n(xiv)\u00d2\u00af\u00c7\u00b6\u00c7\u00bc\u00ba\u00c6\" \u00b1\u00f2\u00af \u00b7\u00be\u00cd\u00b8\u00c7\u00ba\u00c6\u00b9\u00be\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b1\u00f2\u00af\u00b9\u00c6 \u00da\u00b8\u00bc\u00c6\u00c1\u00c7\u00c0\u00c6\u00e2 \u00a4\u00af\u00c8\u00bb\u00c1\u00bd\u00c6\u00ce\u00bd \u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00e2\u00ba\u00c6\" \u00cd\u00b7\u00c7\u00bb\u00c6 \u00b9\u00bc\u00e2\u00b6\u00ce\u00be\u00b6\u00c6 \u00b6\u00d5\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6 \u00af\u00ae\u00af\u00c7\u00b4\u00c6\u00b1\u00c8\u00af\u00ce\u00bf \u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00b6\u00df\u00ba\u00c6 \u00a3\u00b6\u00cd\u00b8\u00c7\u00d5 \u00b1\u00ba\u00c6\u00b9\u00b7\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c8\u00be\u00c6 \u00a6\u00d5\u00b9\u00d5\u00b6\u00df\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 38 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af \u00b9\u00af\u00c1\u00c7\u0081\u00fe \u00b1\u00b6\u00c6\u00bb \u00b1\u00c7\u008a \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u0081 \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b1\u00ce\u00b9 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n4\n\n(xv)\u00aa\u00bd\u00c6\u00af\u00b8\u00cd\u00c1 \u00b7\u00b4\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5 \u00c1\u00dd\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00dd+\u00c6\u00af\u00c7\u00be\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a7\u00dd\u00c1\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6 \u00e7\u0088\u00bb \u00a5\u00be+\u00c6\u00ce\u00af \u00b9\u00af\u00c1\u00c7\u0081\u00fe \u00b1\u00b6\u00c6\u00bb \u00b1\u00c7\u008a \u00a3\u00ce\u00ba\u00b9\u00c6\u0089\u0081 \u00cd\u00c1\u00de \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00e0\u00b4\u0081 \u00e7\u00b4\u00c6\u00b4\u00c7\u00af \u00a5\u00ce\u00b5\u00b7\u00c6\u00d7 \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00b0\n\n4\u00b0 (1) \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u0081 \u00b7\u00c8\u00dd\u00c1\u00c7\u00af\u00ba\u00c6\" \u00db\u00af\u00c7\u00ce\u00ba \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00af\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00c7\u00d5 \u00a9\u0081\u00b9\u00b8 \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u008c\u00b6\u00c8\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00b5+\u00c6\u00af\u00b6\u00c6\u00cc\u00b6\u00bc\u00c8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u0089\u0081\u00c1\u00dd\u00cd\u00c1\u00c7\u00bc\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b4\u00b9\u00b6\u00c8\u00cc\u00b8\u00c7\u00dd \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd \u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b1\u00ce\u00b9\u00cc\u00bb\u00c7\u0081\u00de\u00af\u00c6\u00d0 (\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u201c\u00b1\u00ce\u00b9\u201d\u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00a7\u00bc\u00c8\u00b6\u00c6\u00b6\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\u2013\n\n(\u00a3)\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u008c\u00b1\u00c7\u00bf\u00bc\u00c6 ;\n\n(\u00a4)\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00cc\u00b9\u00c7\u00d7\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c7\u00bf\u00bc\u00c6; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a5)\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00bf\u00bc\u00c6\u00b0"
