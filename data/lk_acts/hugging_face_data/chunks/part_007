    "chunk_text": "\u00c2\u00cc\u00e0\u00be\u00e5\u00cd\u00fa\u00c7 \u00c0\u00ce\u00e5\u00ef\u00ba\u00e0 \u00aa\u008a\u00c0\u00cd \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00aa\u008a\u00c0\u00cd \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a \u00ef\u00a8\u00e5 \u00b5\u00e5\u00ca\u00ef\u00c6\u00e0 \u00c4\u00e6\u00bc\u00c0\u00ba\u00e0\u00ba\u00eb\u00ef\u008c \u00c6\u00a8\u00e0\u00a8\u00c8 \u00be\u008a \u00aa\u00f2\u00e5\u00c4\u00ef\u00c6\u00e0 \u00c0\u00e8\u00cd\u00fa\u0090 \u00ef\u00a8\u00e5\u00e0\u00be\u00e0\u00aa\u00cd\u00c9\u00ba\u00e0\u00ba \u00be\u008a \u00a2\u00b6\u00ef\u00c4\u00be\u00e0 \u00c4\u00e6\u00be \u00cc\u00e5\u00bc\u00be \u00c8\u00bc \u00a1\u00c6\u00fa.\u00a6\u00e0. \u0097\u00ef\u00d9\u00ba\u00f8\u00c8\u00a8 \u0095\u00be\u00ea\u008a\u00ef\u00bc\u00e5\u00e0\u00c7\u00e6 \u00a1\u0093\u00a8\u00e5\u00d6 \u00ba\u00eb\u00c4\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 2003 .11 .12 \u00bc\u00e5\u00ba\u0095\u00be\u00e0 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00c7\u00be \u00c8\u00bc\u00a1\u00e2\u00a8 \u00aa\u008a/\u00aa\u008a/ 03/275-B \u00cc\u00cd 2004 \u00cc\u00e6\u00c0\u00e0\u00ba\u00e6\u008a\u00c2\u00da \u00cd\u00e5 \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u00c2\u00da \u00bc\u00c7\u00be \u00a1\u00be\u00ea\u00ef\u00da\u00a9\u00be\u00ef\u00c6\u00e0\u00ef\u00c8\u00e5 \u00a1\u00e2\u00a8 1 \u00ef\u00c8\u00cc \u00c8\u00a8\u00eb\u00b8\u00ea \u00ef\u00a8\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00aa\u008a\u00c0\u00cd \u0097\u00a8\u00f2\u00c4\u00e5\u00c7\u0083\u008e \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8\u00e0 \u00cc\u00e2\u00a8\u00f9\u00da\u00b8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00dd\u00cc\u00e8\u00c6\u00f5 \u00aa\u00cd\u00ef\u00a8\u00e5\u00ce \u00c0\u00ce\u00ba\u00eb\u00c7\u00e6 \u00cc\u00cd \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8 \u00cc\u00cd\u00fa\u00ba \u00a1\u00a8\u00e0\u00a8\u00c7 \u00a6\u00a8\u00c6\u00fa \u00c0\u00da\u00ae\u00cc\u00e0 \u00ba\u00f8\u00cc\u00e0 \u00c0\u00cd\u00c6\u00e8 \u00bc\u00ca\u00c4\u00a6\u00a8\u00c6\u00fa \u00ef\u00bc\u00a8\u00a8 (\u00a1. 1 \u00c7\u00e7. 0 \u00c0\u00da. 35.12 ) \u0097\u00ca\u00e5\u00c8\u00ba\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u00c6\u00ea\u00ba\u00e0 \u00a6\u00a8\u00f9 \u00a2\u00b6\u00c4 \u00ef\u008c.\n\n\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n2007 \u00a1\u00e2\u00a8 51 \u00bc\u00c7\u00be \u00aa\u008a\u00c0\u00cd \u0097\u00a8\u00f2\u00c4\u00e5\u00c7\u0083\u008e \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc\u00ca\u00fa\u00a8\u00e0\u00cb\u00b8 \u00ef\u00c7\u00e5\u00e0\u00cd\u00c8 (\u00c0\u00e6\u00c9\u00d7\u00ef\u008a) \u00c0\u00be\u00ba4"
  },
