    "chunk_text": "(3) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00c8\u008a\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a3\u00b6\u0081 \u00a3+\u00c6\u00af\u00c9\u00af\u00c7\u00bc\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cc\u00af\u00b8\u00db\u0081\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(4) \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00cd\u00b6\u00b6\u00c8\u00ce\u00bb\u00af\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00d0\u00ba\u00c6 \u00a3\u00bd\u00c8\u008c\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00de \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00c8\u008a\u00be\u00c6\u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n9\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8+\u00c6\u00af\u00bf\" \u00b6\u00ba\u00c8\u00c0\u00c6 \u00a7\u00ce\u00bc\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00ce\u00b4\u00cd\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\" \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00bb \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba\u008a\u0081\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\"\u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00ba\u00cd\u00be+\u00c6\u00af\u00c8 \u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n1\u00b0 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00be\u00c6 \u00b6\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00de\u00af\u00c6\u00d0 \u00a7\u00b4\u00b7\u00c6\u00ce\u00b6\u00bb\u00c7\u008a\u00dd\u00b6\u00c6\u00b6\u00be\u00c6\" \u00a7\u00b4\u00b7\u00c6\u00ce\u00b6\u00bb\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6 \u00cc\u00b1\u00bb\u00be\u00c6 \u00da\u00bc\u00c8\u00bb\u00b9\u00c6\u00b9\u0088\u0081\u00b0\n\n2\u00b0 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00be\u00c6 \u00b6\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00b6\u00c1\u00de\u00af\u00c6\u00d0 \u00a7\u00b4\u00b7\u00c6\u00ce\u00b6\u00bb\u00bf\u00c8\u00af\u00c6\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00c1\u00ce\u00bd\u00b9\u00c6\u00da\u00bc\u00c8\u00bb \u00e9\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0\n\n3\u00b0 \u00cc\u00af\u00c7\u00ce\u00be\u00b0\n\n4\u00b0 \u00cc\u00af\u00c7\u00ce\u00be\u00bb\u00c7\u00af\u00c7\u00b6 \u00d0\u00bd\u00c6\u00bd\u00db\u00ce\u00b4\u00bb \u00ba\u00bc\u00b5\u00ba\u00c6\u00b0\n\n5\u00b0 \u00cc\u00af\u00c7\u00ce\u00be \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00b0\n\n\u0089\u00bc\u00c8\u00e2 102 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0\n\n\u0089\u00bc\u00c8\u00e2 113\u00a4 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0\n\n\u0089\u00bc\u00c8\u00e2 296 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0\n\n\u0089\u00bc\u00c8\u00e2 297 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0\n\n\u0089\u00bc\u00c8\u00e2 300 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0\n\n\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5(\u0089\u00bc\u00c8\u00e2 2)\u00b7\u00c8\u00ce\u00bc I\u00b7\u00c8\u00ce\u00bc II\n\n\u00cc\u00b1\u00be\u00c6\u00df\u00b9\u0088\u00bb\u00c7\u00af\u00c6\u00d0\u00b6\u00be\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 42 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00d0\u00bd\u00c6\u00bd\u008c\u00bb\u00be\u00c6\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00db\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1(\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n11\n\n6\u00b0 \u00cc\u00af\u00c7\u00ce\u00be \u00da\u00bc\u00c8\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af \u00a4\u00b4\u00c6\u00af\u00c1\u00bc\u00c6\u00b6\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00b4\u00c6\u00af\u00b4\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n7\u00b0 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00ce\u00bc \u00b6\u00c1\u00bd\u00c7\u00af \u00a3\u00ce\u00b4\u00b6\u00c6\u00d7\u00ce\u00c1\u00af\u00c6\u00d0\u00ba\u00c6 \u00a7\u00bf\u00af\u00c6 \u00af\u00dd\u00b6\u00c6\u00d7\u00b4\u0081 \u00a4\u00b4\u00c6\u00af\u00c1\u00bc\u00c6\u00b6\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00b4\u00c6\u00af\u00b4\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n8\u00b0 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00ce\u00bc \u00db\u00ce\u00bd\u00cd\u00af\u00b4\u00c7\u00af \u00af\u00d5+\u00c6\u00af\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a7\u00b4\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6 \u00a7\u00bf\u00af\u00c6\u00af\u00dd\u00b6\u00c6\u00d7\u00b4\u0081 \u00a4\u00b4\u00c6\u00af\u00c1\u00bc\u00c6\u00b6\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00b4\u00c6\u00af\u00b4\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n9\u00b0 \u00af\u00c1\u00bc\u00c6\u00b7\u00c6\u00d7 \u00cc\u00b1\u00be\u00c6\u00be\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00ce\u00bf \u00ba\u00ce\u00bd\u00b6\u00c6\u00d7\u00ce\u00c1\u00b6\u00c6\u00b6\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00ce\u00b4\u00b6\u00c6\u00d7\u00ce\u00c1\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n10\u00b0 \u00af\u00bd\u00c6\u00b9\u00c0\u00c8\u00b9\u00c6\u00da\u00b0\n\n11\u00b0 \u00ba\u00bc\u00b5\u00b6\u00c6\u00ce\u00b6 \u00aa\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00db\u00b6\u008b\u00bb\u00b8 \u00cc\u00b1\u00bb\u00c6\u00d7\u008c\u00b4\u00c6\u00d5 \u00da\u00bc\u00c8\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00b6\u00c8\u00dd\u00b4\u00c6\u00d5\u00b0\n\n12\u00b0 \u00ba\u00bc\u00b5\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00d5+\u00c6\u00af\u00c7\u00bb\u00ba\u00c6 \u008c\u00ce\u00bf\u008c\u00af\u00c6\u00d0\u00ba\u00c6 \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u00be\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00ce\u00bf\u00b0\n\n13\u00b0 \u00ba\u00bc\u00b5\u00ba\u00c6 \u008c\u00ce\u00bf\u008c\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00a4\u00dc\u00b6\u00b7\u00c6\u00b6\u00c7+\u00c6\u00af\u00c8\u00bb \u00b9\u0088 \u00cc\u00af\u00c7\u00ce\u00be \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00b0\n\n14\u00b0 \u00cd\u00ba\u00bd\u00c6\u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00b6\u00c1\u00de\u00af\u00ce\u00bf\u00b9\u00c6 \u00da\u00bc\u00c8\u00dc\u00ba\u00c6 \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00b0\n\n15\u00b0 \u00cc\u00c1\u0088\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00ce\u00bf\" \u00b6\u00c9+\u00c6\u00d0\u008c\u00ce\u00bf\u008c\u00af\u00c6\u00d0\u00ba\u00c6 \u00a4\u00dc\u00b6\u00ba\u00c6 \u00ac\u0081\u00ce\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00d7\u00c1\u00af\u00c6\u00cc\u00af\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6 \u00da\u00bc\u00c8\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00b6\u00c1\u00de\u00b0\n\n\u0089\u00bc\u00c8\u00e2 355 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0\n\n\u0089\u00bc\u00c8\u00e2 356 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0\n\n\u0089\u00bc\u00c8\u00e2 358 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0\n\n\u0089\u00bc\u00c8\u00e2 359 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0\n\n\u0089\u00bc\u00c8\u00e2 364 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0\n\n\u0089\u00bc\u00c8\u00e2 371 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0\n\n\u0089\u00bc\u00c8\u00e2 383 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0\n\n\u0089\u00bc\u00c8\u00e2 384 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0\n\n\u0089\u00bc\u00c8\u00e2 490 \u2013 \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u00b0"
