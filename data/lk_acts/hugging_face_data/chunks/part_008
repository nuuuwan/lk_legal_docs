    "chunk_text": "333.\u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00cc\u00e0\u00ef\u008c\u0083\u00af\u00e5\u00ef\u00c9\u00be\u00e0 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u0097\u0093\u0097\u00bd\u00e5\u00be.266334.\u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4.267335.\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4.268336.\u00c0\u00d7\u00a8\u00e0\u00cb\u00b8 \u00a8\u0095\u00b4\u00ea\u00c9 \u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4.268337.\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00c0\u00e5\u00d6\u00ca\u00f2\u0095\u00a8 \u00be\u00f8\u00c6\u00c4\u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c2\u00c8\u00ba\u00c8\u00a1\u00c9\u00cc\u00be\u00e0\u00d1\u00c4.269338.\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00bd\u00ea\u00c7\u00ef\u00c6\u00cd\u00fa \u00c0\u00ea\u00c7\u00c0\u00e0\u00c0\u00e5\u00b6\u00ea\u00c9 \u00c0\u00e8\u00c7\u00d1\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c8\u00c6.270339.\u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00e0\u00ef\u008c\u0083\u00af\u00e5\u00ef\u00c9\u00be\u00e0 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 328 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00bc\u00e5\u00ce \u00a8\u00f8\u00d7\u00c4.270340.\u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc \u00a1\u00c9\u00cc\u00e5\u00be\u00ef\u00c6\u00e0 \u00cc\u00c4\u00e5\u00aa\u008a \u00cc\u00cd \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00db\u00cc\u00e0\u00d1\u008a\u00a8\u00e6\u00bf\u00d1\u00c4 \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00c2\u00c9.270341.\u00a1\u00c9\u00cc\u00e5\u00be \u00db\u00cc\u00e0\u00d1\u00c4 \u00cc\u00cd \u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00e6\u00d7\u00c4.270\n\n\u00cc\u00e0\u00ef\u008c\u0083\u00af\u00e5\u00ef\u00c9\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e7\u00c4 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4\u00a8\u00b4 \u00c4\u00a1\u00bc\u00e5\u00ce \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u0097\u0093\u0097\u00bd\u00e5\u00be\n\n342.\u00cc\u00e0\u00ef\u008c\u0083\u00af\u00e5\u00ef\u00c9\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e7\u00c4 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4\u00a8\u00b4 \u00c4 \u00a1\u00bc\u00e5\u00ce\u0097\u0093\u0097\u00bd\u00e5\u00be.272343.\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00bc\u00e0\u00c0\u00ce \u00ef\u00c2\u00bc\u00e5 \u00cd\u00e6\u00d7\u00c4.272\n\nxviii\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\n(IV) \u00a1\u0093\u00a8\u00c7\u00b8\u00ef\u00c6\u00e0 \u00a1\u009e\u00a8\u00e0\u00cb\u00b8\u00c6\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4\n\n351.\u00a1\u009e\u00a8\u00e0\u00cb\u00b8\u00c6\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00c4\u00be \u00ef\u00c8\u00cc \u00a1\u00e5\u00b3\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00c8\u00c6.275352.\u00a1\u009e\u00a8\u00e0\u00cb\u00b8\u00c6\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00c9\u00ec \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00ef\u00c0\u00ba\u00e0\u00cc\u00ef\u008a\u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c6.275353.\u00a1\u009e\u00a8\u00e0\u00cb\u00b8\u00c6\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4\u00a8\u00b4275 \u00c9\u00be \u00cc\u00cd 276 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a1\u00bc\u00e5\u00ce \u00a8\u00f8\u00d7\u00c4.275354.\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00cc\u00e0\u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00cc\u00ba\u00eb \u00c2\u00c8\u00c6.275355. \u00a1\u009e\u00a8\u00e0\u00cb\u00b8 \u00a1\u00e5\u00b3\u00e5\u00ef\u008c \u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c6.276\n\n\u00cd\u00e8\u0095\u00a8\u008a \u00c0\u00e7\u00c4 \u00a7\u00c0\u00e0\u00c0\u00ea \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00c9\u00da\u00aa \u00a8\u00f8\u00d7\u00c4\n\n356.\u00c0\u00e8\u00ce\u00e8\u00aa\u00ba\u00c6\u00ea\u00ba\u00eb \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u008a.277357.\u00cc\u00ea\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba \u00ef\u00be\u00e5\u00c9\u00ec \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u008a.277358.\u00cc\u00ea\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00cd\u00e5 \u00a8\u00e5\u00da\u00c6\u00c6.278359.\u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00ef\u008a \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00ef\u00a8\u00e5\u00b4 \u00bc\u00e6\u00be\u00aa\u00e6\u00be\u00f9\u00c4.282360.\u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00ef\u00a8\u00e5\u00b4 \u00bc\u00e6\u00be\u00aa\u00ba\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4.282361.\u00bc\u00b6, \u00bc\u00b8\u00e0\u00b6\u00be \u00cc\u00cd \u00a1\u00c6\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c4\u00ea\u00bc\u00c8\u00e0282362.\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00b8\u00c6 \u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u008a.283363.\u00a1\u00ef\u00be\u00f1\u00e5\u00be\u00f1 \u00c2\u00e6\u00c7\u00a8\u008a \u00cc\u00cd \u00cd\u00fa\u00c8\u008c \u00a8\u00f8\u00d7\u008a.283364.\u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u008a\u00c9\u00c8\u00b4 \u00ef\u00c0\u00e5\u00ce\u00e8\u00c6.284365.\u00c9\u00c7\u00b8\u00e8\u00a8 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u008a.284366.\u00ef\u00c9\u00be\u00ba\u00e0 \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u008a \u00cc\u00cd \u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba \u00c9\u00ba\u00e0\u00a8\u008a \u00ef\u00c2\u00bc\u00e5 \u00cd\u00e6\u00d7\u00c4. 285\n\n\u00c2\u00c8 \u00c7\u00cd\u00fa\u00ba \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\n\n367.\u00c9\u00c7\u00b8\u00e9\u00c6 \u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c6 \u00a1\u00e6\u00ba\u00f8 \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea.286\n\nxix\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\n368.\u00c2\u00c8 \u00c7\u00cd\u00fa\u00ba \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7.286369.\u00c9\u00e5\u00b8\u00e8\u00b0\u00c4\u00c6 \u00ef\u00be\u00e5\u00c9\u00be \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea.288370.\u00c2\u00c8 \u00c7\u00cd\u00fa\u00ba \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea \u00cd\u00e5 \u00c2\u00e6\u00bf\u00fb\u008a \u00a2\u00c9\u00ba\u00c8\u00e9\u00ef\u008a \u00a8\u00e5\u00da\u00c6 \u00c0\u0090\u00c