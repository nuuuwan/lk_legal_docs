    "chunk_text": "63.\u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0, \u00a6\u00c6 \u00cc\u00ba\u00eb \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c45664.\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c4 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u0095\u00c8 \u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00c45765.\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u0095\u00c8\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00ef\u00a8\u00e5\u00be\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c458\n\n\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\n\n66.\u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00c6\u00be\u00e0\u00ef\u00be\u00cd\u00fa \u00a1\u00da\u00bb\u00c65967.\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c4\u00be\u00e5\u00c0\u00c6 \u00c0\u00d6\u00bc\u00fa \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c45968.\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c4\u00be\u00e5\u00c0\u00c6 \u00c0\u00d6\u00bc\u00fa \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c45969.\u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c460\n\n70.\u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00bc\u00e9\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c0\u00d6\u00cc\u00e9\u00c4\u00e56071.70 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ba\u00cd\u00be\u008a \u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ec \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea62\n\n\u00c0\u00f2\u00ba\u00f8\u00ef\u00c8\u00e5\u00e0\u00c4 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00bc\u00e6\u00d7\u00c4\n\n72.\u00c0\u00e5\u00c8\u00e8\u00ba \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00c0\u00e5\u00c8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00bc\u00e6\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00cc\u00e9\u00c4\u00e563\n\n\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cc\u00cd \u00cc\u00ee\u00b8 \u00c0\u00ba\u00f2 \u00c0\u00e6\u00c9\u00d7\u00c4\n\n\u00cd\u00fa\u0095\u00a8\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00a1\u00e5\u00bc\u00fa\u00c6\n\n73.\u00c0\u00e6\u00c9\u00c7\u00e6\u008a \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u0097\u00b4 \u00cd\u00e6\u00c7 \u00c0\u00e6\u00c9\u00d7\u00c4 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c96474.\u00be\u00f9\u00ba\u00f1\u00be\u00ea\u00a8\u00ed\u00c8 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e6\u00c9\u00d7\u00c46475.\u00c0\u00e6\u00c9\u00c7\u00e6\u008a\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4 \u00c0\u00e8\u00b4 \u00c0\u00e6\u00c9\u00c7\u00e6\u00c4\u00a8\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c46476.\u00c0\u00e6\u00c9\u00c7\u00e6\u00c4\u00a8\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4 \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00e6\u00be\u00e0\u00d1\u00c46577.\u00c0\u00e6\u00c9\u00c7\u00e6\u008a \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00f8\u00d7\u00c46578.\u00cc\u00cd\u00ba\u00f8\u00a8 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u00cc\u00ba\u00eb \u00c6\u00ea\u00ba\u00eb\u00a8\u008a6679.\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cd\u00fa\u0095\u00a8\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8\u00c6\u00a8\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c96780.\u00ef\u00c0\u00f2\u00e5\u00ef\u0089 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6 \u00a1\u00e5\u00bc\u00fa\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00ce \u00c2\u00c9\u00b4 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e867\n\nv\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\n\u00cc\u00ee\u00b8 \u00c0\u00ba\u00f2 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be\n\n81.\u00cc\u00ee\u00b8 \u00c0\u00ba\u00f2 \u00bc\u00c7\u00be\u00e0\u00be\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cd\u00e5 \u00c3\u00e5\u00c7 \u00a7\u00c0\u00e0\u00c0\u00ea\u00ef\u008c\u00c0\u00e8\u00b4\u00c0\u00ba\u00e0 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00cc\u00ee\u00b8 \u00c0\u00ba\u00f2 \u00bc\u00c7\u00be\u00e0\u00be\u00be\u00e0 \u00cd\u00e5 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u00cc\u00ba\u00eb \u00a1\u00c6\u00fa\u00ba\u00f8\u00c66882.\u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00b4 \u00ba\u00cd\u00be\u008a \u00c2\u00c96983.\u00be\u00f8\u00ba\u00f1 \u00cc\u00ee\u00b8 \u00c0\u00ba\u00f26984.\u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00cc\u00ee\u00b8 \u00c0\u00ba\u00f2 \u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8 \u00be\u00e6\u00c9\u00ba \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a\u00c2\u00c8\u00c67085.\u00cc\u00ee\u00b8 \u00c0\u00ba\u00f2\u00c9\u00c8\u00b4 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00aa\u00fa\u0097\u00cc\u00ea\u008a \u00a6\u00ef\u00cc\u00e0\u00c4 \u00a2\u00b4\u00ea\u00a8\u00f8\u00d7\u00c471\n\nV \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc- \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u00cc\u00cd \u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00cd\u00e5 \u00c2\u00e6\u00bf\u00fb\u008a\n\n86.\u201c\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00e5\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00cd\u00fa \u00a1\u00da\u00bb\u00c671\n\n\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u00cc\u00ba\u00eb \u00c9\u00aa\u00a8\u00f9\u00c4\n\n87.\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u00cc\u00ba\u00eb \u00c9\u00aa\u00a8\u00f9\u00c47288.\u00a1\u00e6\u00c7\u00c6\u00ea\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00aa\u00a8\u00f9\u00c47389.\u00c9\u00aa\u00a8\u00f9\u00c4 \u00c9\u00e6\u0091 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u00a6\u00a8\u00ad \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c973\n\n\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c2\u00c8\u00ba\u00c8\n\n90.\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00b4 \u0097\u00ef\u00ca\u00e0\u00cb \u00c9\u00ec \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c47491.\u00cc\u00e5\u00c4\u00e5\u00be\u00f1 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c47492.\u0097\u00ef\u00ca\u00e0\u00cb \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc