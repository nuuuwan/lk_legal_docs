    "chunk_text": "(4)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (6) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u2014\n\n(\u00a1)(ii) \u00c9\u00be \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c\u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00c7\u00a8\u00c4\u00a8\u00b4\u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00be\u00e6\u00ba\u00f8\u00be\u008a\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4, \u201c\u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00c7\u00a8\u00c4\u00a8\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00be\u00e6\u00ba\u00f8\u00be\u008a \u00ef\u00cd\u00e5\u00e0 \u00c2\u00bc\u00e0\u00bc\u00b4\u00c6\u00b4\u00ba\u00e0 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a \u00a1\u00aa\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00ef\u00c8\u00cc \u00aa\u00e6\u00ef\u00be\u00be\u00cc\u00e6\u00c0\u00c6\u00ea\u00c4\u00a8\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00ef\u008c \u00be\u008a\u201d ;\n\n2007 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb\u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba3\n\n(5)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (9) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0:\u2014\n\n\u201c(10) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a2\u00cd\u00ba\u00f8\u00be\u00e0 \u00c9\u00ec \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a2\u00b6\u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00ef\u00c6\u00bc\u00c9\u00ea\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00e0\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6, \u00a6\u00e0 \u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00cc\u00bf\u00cd\u00e5 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a2\u00b6\u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00ef\u00c6\u00bc\u00c9\u00ea\u008a \u00c2\u00bc\u00e0\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00b4\u00c0\u00ba\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00be\u00f8\u00c4\u00e6\u00c9\u00ea\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0, \u00cc\u00e8\u00c6\u00c6\u00b4 \u00a1\u00cc\u00ec\u00c0\u00cd \u00c6\u00be\u00c0\u00f2\u00c4\u00e5\u00b8\u00c9\u00c8\u00e8\u00be\u00e0 \u00a1\u00b6\u00ea \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00b4 \u00ba\u00c9\u00f3\u00c7\u00b4\u00ba\u00e0 \u00cc\u00e9\u00c4\u00e5 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\u00ef\u00a8\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc \u00cc\u00e8\u00c6\u00c6\u00b4 \u00a1\u00cc\u00ec\u00c0\u00cd\u00a8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4 \u00cc\u00e9\u00c4\u00e5 \u00a8\u00c7\u00be\u00c8\u00bc 22 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (5) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ba\u00eb\u00be\u00e0\u00c9\u00be \u00a1\u00ba\u00eb\u00c7\u00e6\u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c0\u00e8\u00d6\u00cc\u00e6\u00a8\u00cc\u00ea\u008a \u00ef\u00be\u00e5\u00a8\u00c7 \u00be\u00e6\u00c9\u00ba\u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c3\u00e5\u00b8\u00e0\u00b6 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 2006 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 31 \u00c9\u00be \u00bc\u00fa\u00be\u00b4\u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba \u00ef\u00c6\u00bc\u00c9\u00ea\u008a \u00c2\u00bc\u00e0\u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00a2\u00b6 \u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00ef\u00c6\u00bc\u00c9\u00ea\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0\u00c6\u008a \u00ef\u00ca\u00e0\u00cb\u00c6\u00a8\u00e0 \u00a2\u00ba\u00f8\u00d6 \u00d1 \u00a1\u00e6\u00ba\u00e0\u00be\u008a, \u00a6\u00c6 \u00a6\u00c4 \u00cc\u00e9\u00c4\u00e5\u00a8\u00f8\u00d7\u00c4\u00b4 \u00c4 \u00c6\u00b4\u00ba\u00e0\u00c9\u00c0\u00cc\u00ea\u00c9 \u00a6\u00ce\u00ef\u00c5\u00be \u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00ba\u00eb\u00ce \u00a2\u00b6\u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00ef\u00c6\u00bc\u00c9\u00ea\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00a2\u00cd\u00ba \u00cc\u00e9\u00c4\u00e5 \u00a8\u00e8\u00d7\u008a\u2014\n\n(i)\u00ca\u00eb\u00be\u00f1 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00aa\u00ba \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00c9\u00c8\u00b4;\n\n(ii)1996 \u00a1\u00e2\u00a8 33 \u00bc\u00c7\u00be \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ba\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00e5 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00ce \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 1979 \u00a1\u00e2\u00a8 40 \u00bc\u00c7\u00be \u00a1\u00c0\u00be\u00c6\u00be\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc\u00a1\u00c0\u00be\u00c6\u00be \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00a1\u00c0\u00be\u00c6\u00be\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00ef\u00c9\u00ba 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc,\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa, \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0\u00a1\u00c0\u00be\u00c6\u00be \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c2\u00f3\u0097\u00c8\u008a\u00c3\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00f8\u00be\u00e0 \u00c9\u00ec \u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00c9\u00c8\u00b4 ; \u00cc\u00cd\n\n(iii) \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00e5\u00c8\u00c6 \u00ba\u00eb\u00ce \u00bc\u00fb 22 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (7) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00d1 \u00a1\u00e6\u00ba\u00f8 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u0097\u00c6\u00bc\u008a \u00a8\u00c7\u00be\u00c8\u00bc \u00c3\u00e5\u00b8\u00e0\u00b6 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c9\u00f1\u00e5\u00c0\u00ee\u00ba\u00f8\u00c9\u00c8 \u00bc\u00fb,\n\n2007 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb\u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba4\n\n\u00a1\u00e5\u00ef\u00c7\u00e5\u00e0\u00c0\u00e8\u00ba \u00ef\u00c6\u00bc\u00c9\u00ea\u008a \u00c2\u00bc\u00e0\u00bc \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d.\n\n5.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 25 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u201c\u00a7\u00cd\u00ea\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4 \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4, \u201c\u00a7\u00cd\u00ea\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6:"
