    "chunk_text": "(\u00a6)(i)\u00ac\u00dd \u00b7\u00c8\u00da\u00b5\u00bc\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00df\u00c1\u00be\u00af \u00db\u00ce\u00bd\u00bb\u00c7\u00b8\u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00a4\u00c1\u00b5\u00b6\u00c6\u00b6\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00e7\u00bd\u00c6\u00bd\u00c8\u0081 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b6\u00c6\u00b6\u00c8\u0081\u00ba\u00c9\u00d7 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb\u00d7 \u00a9\u00b8\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6\u00b6\u00c7\u00b8\" \u00ac\u00c1\u00c6\u00cd\u00c1\u00c7\u00bc\u00c6 \u00a7\u00ae\u00ce\u00ba\u00bb\u00bd\u00c6\u00bd\u00e7\u00bd\u00c6\u00de\u00b6\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\u00e2\u00ba\u00c6\" \u00a3\u00c1\u00bc\u00c6\" \u00e7\u00bd\u00c6\u00bd\u00c7\u00b8\u00d7\u00a7\u00ae\u00ce\u00ba\u00bb\u00c7\u00b8\u00cc\u00b6\u00b8 \u00b7\u00ba\u00c6\u00da\u00c1\u00b6\u00bd\u00c6\u00d0 \u00b7\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8\u00aa\u00d7\u00ce\u00c1 \u00a7\u00ce\u00b4\u00bb\u00c1\u00bc\u00c7\u00af\u008c\u00dd\u00b7\u00c6\u00b6\u00c7\u00cc\u00bc\u0081\u00de\u00ba\u00c6\" \u008c\u00b4\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00cd\u00af\u00bd\u00c6\u00b9 \u00b9+\u00c6\u00d0\u00af\u00bf\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00b4\u0081\u00af\u00bf\u00c8\u0081 \u0089\u00bc\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00d7\u00af\u00c6\u00d0\u00ce\u00af\u00af\u00c6 \u00af\u00c7\u00be\u00ba\u00c6\u00c1\u00ce\u00bc \u00a3\u00af\u00c6\u00e7\u00bd\u00c6\u00bd\u00c7\u00b8\u00d7 \u00a7\u00ae\u00ce\u00ba\u00bb\u00c7\u00b8\u00cc\u00b6\u00b8 \u00b7\u00ba\u00c6\u0089\u00b8\u00c7\u00cc\u00bc\u0081\u00de\u00ba\u00c6;\n\n(ii)\u00b7\u00c8\u00da\u00b5\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00e7\u00bd\u00c6\u00cc\u00bd\u00c7\u0081\u00cc\u00bd\u00b8\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00a9\u00d7 \u00b7\u00c8\u00da\u00b5\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c8\u0081 \u00a3\u00bd\u00c8\u00af\u00c6\u00ce\u00af\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b9\u00de\u00ba\u00c7\u00b8\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c644\n\n(iii)\u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00c1\u00bc\u00d7 \u00a3\u00df\u00c1\u00be\u00af\u00db\u00ce\u00bd\u00bb\u00c7\u00b8 \u00b6\u0081\u00ce\u00ba\u008a\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ac\u00dd \u00e7\u00bd\u00c6\u00cc\u00bd\u00b8\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00a9\u00d7 \u00a3\u00df\u00c1\u00be\u00af\u00db\u00ce\u00bd\u00bb\u00c7\u00af \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00a4\u00c1\u00b5\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00b6\u00c7\u00b8 \u00ac\u00dd \u0089\u00bc\u00b6\u00c8\u00bb\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u0089\u00bc\u00c8\u00b6\u00c6\u00cc\u00b6\u00d5\u00b6\u00c6\u00b6\u00b9\u00d0\u00b6\u00c8\u00bb\u00c7\u00af \u00a7\u00bf\u00c6\u00bf\u00cc\u00b6\u00b8\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7\u00a3\u00b6\u00c8\u00be\u00c6 \u00a3\u00b4+\u00c6\u00af\u00c8\u00dc\u00bf\u00c6\u00bf \u00a7\u00ae\u00ce\u00ba\u00bb\u00bd\u00c6\u00bd \u00e7\u00bd\u00c6\u00de\u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u0081\u00de\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\u00e2\u00ba\u00c6 \u00a3\u00d7 \u00e7\u00bd\u00c6\u00bd\u00c8\u0081\u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00c1\u00b5\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00b6\u00c7\u00b8 \u0089\u00bc\u00b6\u00c8\u008a\u0081\u00a3\u00be\u00c6\u00be\u00d7 \u0089\u00bc\u00c8\u00b6\u00c6\u00cc\u00b6\u00d5\u00b6\u00c6\u00b6 \u00b9\u00d0\u00b6\u00c8\u008a\u0081 \u00b1\u00bc\u00c8\u00bb\u00c7\u00b8\u00d7\u00ba\u00c6\u00cd\u00b7\u00bc\u00c8\u00bb\u00d7\u00ba\u00c7\u00b8 \u0089\u00bc\u00b6\u00c8\u00b9\u008b\u00b9\u00c6\u00b9\u00c7\u00af \u00a5\u00dd\u00b7\u00c6\u00b6\u00cc\u00b6\u0081\u00de\u00ba\u00c6\"\n\n\u00a9\u00ae\u0089\u00b9\u00c6\u00b9\u00c7\u00bc\u00c7\u008a\u0081\" \u00a3\u00c1\u00bc\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00c6\u00d0 \u00a4\u00bf\u00c7\u00b6\u00be\u00c7\u00af\u00c7\u00d7 :\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c645\n\n\u00a4\u008a\u0081\" \u00b7\u00c8\u00da\u00b5\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00bd \u00db\u00ce\u00bd\u008a\u00be\u00c6 \u00b6\u00ba\u00c6\u00ba\u00c7\u00be\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cc\u00b6\u00b8\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd \u00a7\u00ae\u00ce\u00ba\u00bb\u00bd\u00c6\u00bd \u00e7\u00bd\u00c6\u00de\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00db\u00bd\u00c6\u00b9\u00af\u00bc\u00c6\u008c\u0081 \u00c1\u00c0+\u00c6\u00d0\u00ce\u00af\u00af\u00c6\u00d0 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf\u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00bd \u00c1\u00ce\u00af\u008a\u00be\u00c6 38 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00ba\u00c6\u00ba\u00b6\u00b6\u00c6\u00ce\u0