    "chunk_text": "90.\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00b4 \u0097\u00ef\u00ca\u00e0\u00cb \u00c9\u00ec \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c47491.\u00cc\u00e5\u00c4\u00e5\u00be\u00f1 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c47492.\u0097\u00ef\u00ca\u00e0\u00cb \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c2\u00c8\u00ba\u00c874\n\n\u00cc\u00ea\u00dd \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u0095\u00c8 \u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a\n\nvi\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\nVI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc-\u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4\n\n\u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4\n\n102.\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00c9\u00ec \u00cc\u00c4\u00e5\u00aa\u008a \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c483103.\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00ef\u00be\u00e5\u00a8\u00ce \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8 \u00c2\u00c8\u00c7\u00cd\u00fa\u00ba \u00c2\u00c987104.\u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00ef\u00bc\u00e0\u00c0\u00ce \u0097\u00cb\u00ef\u00c6\u00cd\u00fa \u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4, \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6\u00a8\u00e0 \u00c2\u00c988105.\u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00c2\u00e5 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c2\u00c989106.\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cc\u00ee\u00b8 \u00c0\u00ba\u00f2\u00c9\u00c8 \u00c0\u00e8\u00b4\u00cc\u00be\u00e0 \u00a8\u00f8\u00d7\u00c490107.\u00ba\u00ee\u00c0\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00e5 \u00cd\u00e6\u00d7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u00b4\u00cd\u00be\u00e090108.\u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00be\u00f8\u00c9\u00e6\u00c7\u00bc\u00fa \u00a8\u00f8\u00d7\u00c491\n\n\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00ef\u00c8\u00e0\u00a9\u00be \u00cd\u00e5 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00a8\u00ef\u00c7\u00be\u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2 \u00c0\u00e8\u00b4\u00c0\u00ba\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u0097\u0093\u0097\u00bd\u00e5\u00be\n\n109.\u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00a8\u00ef\u00c7\u00be \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2 \u00c0\u00e8\u00b4\u00c0\u00ba\u00e0, \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00c2\u00e5 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c2\u00c991110.\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00ef\u00c8\u00e0\u00a9\u00be\u00c691\n\n\u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00be\u00e6\u00c9\u00ba \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4\n\n111.\u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00be\u00e6\u00c9\u00ba \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c492\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00cc\u00c4\u00e5\u00aa\u008a\u00c9\u00c8\u00b4 \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00bc\u00e5\u00ce \u00a8\u00f8\u00d7\u00c4\n\n112.\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0, \u00a1\u00e6\u00ba\u00f8 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c9\u00c8\u00b4\u00cd\u00e5 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce\u00c9\u00c8\u00b4 \u00ef\u008a\u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00bc\u00e5\u00ce \u00a8\u00f8\u00d7\u00c493\n\nVII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc-\u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00c6 \u00cd\u00e5 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6\n\n\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00e5\u00da\u00c6\u00e5\u00c8\u00c6\n\n113.\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00e5\u00da\u00c6\u00e5\u00c8\u00c694114.\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00e5\u00da\u00c6\u00e5\u00c8\u00c6 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c494115.\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00e5\u00da\u00c6\u00e5\u00c8\u00c6 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00be\u00f8\u00c6\u00c4 \u00a8\u00f8\u00d7\u00c494\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\nvii\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\n\u00cc\u00c4\u00e5\u00aa\u008a \u00c9\u00e5\u00da\u00ba\u00e5\n\n116.\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c9\u00e5\u00da\u00ba\u00e5 \u00ba\u00c2\u00e5 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00cc\u00e0\u00bb\u00e5\u00be\u00c696117.\u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00c8 \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8\u00c698\n\n\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c9\u00e5\u00da\u00ba\u00e5 \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4\n\n118.\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5 \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c498119.\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00c8\u00e0\u00a9\u00be \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c499120.\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c9\u00e5\u00da\u00ba\u00e5 \u00c4\u00cd\u00b0\u00be\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00c499121.\u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6100122.\u00ef\u00c8\u00e0\u00a9\u00be\u00c9\u00c8 \u00c0\u00e8\u00b4\u00c0\u00ba\u00e0101\n\n\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\n123.\u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5 \u00ef\u00aa\u00be \u00c6\u00e5 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9101124.\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6102125.\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c4\u00ea\u00bc\u00e0\u00bc\u00c7 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb103126.\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00ea\u008e\u00c6104127.\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00c9\u00cc\u00e5 \u00ba\u00e6\u009f\u00ef\u008a \u00c2\u00c8\u00c6104128.\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00be\u00f8\u00c9\u00e6\u00c7\u00bc\u00fa \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00cc\u00ba\u00eb \u00c2\u00c8\u00c6104129.\u00c3\u00e5\u00c7 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9106130.\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8\u00c6\u00a8\u00e0 \u00c9\u00be \u00c2\u00c9106\n\n\u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9"
