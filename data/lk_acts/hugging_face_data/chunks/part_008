    "chunk_text": "40.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 200 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089:\u2014\n\n(1)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (7) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c8 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(\u00a1) \u00c9\u00be \u00ef\u00d8\u00bc\u00c6\u201d, \u201c\u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c7\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00c6\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(\u00a1) \u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c134 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u201d,\u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u00c4 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c133 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 134 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd\u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(\u00a1\u00e5) \u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c133 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u00c4 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c133\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 134 \u00c6\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n41.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 207 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c9\u00ba\u201d, \u00c6\u00be \u00c9\u00ae\u00be\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0 \u00ef\u00b0\u00f1\u00cb\u00e0\u00b5 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0 \u00ef\u00b0\u00f1\u00cb\u00e0\u00b5 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0\u00ef\u00b0\u00f1\u00cb\u00e0\u00b5 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c9\u00ba\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0207 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0200 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba48\n\n42.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 208 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u00a6\u00c4 \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201c\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0\u201d, \u00c6\u00be\u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(2)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (5) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00f3 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n43.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 217 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u201c\u00c9\u00e5\u00b8\u00e8\u00b0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u201d \u00c6\u00be \u00ef\u00c6\u00f3\u00ef\u008a \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6\u00b4\u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5 \u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00ef\u00a8\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c;\u201d ;"
