    "chunk_text": "\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6 \u0089\u00b5\u00af\u00c6\u00d0\u00af\u00bf\u00c6 \u00b1\u00ce\u00b9\n\n507\u00b0 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6 \u0089\u00b5\u00af\u00c6\u00d0\u00af\u00bf\u00c6 \u00b1\u00ce\u00b9\n\n508\u00b0 \u00b1\u00ce\u00b9 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00bf\u00c6 \u0089\u00b5\u00af\u00c6\u00d0\u00af\u00ce\u00bf \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb\u0083\u00b6\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00be\u00c7\u00ba\u00c6\n\n509\u00b0 \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb\u0083\u00b6 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00b1\u00c8\u00bd\u00b9\u00c6\u00da\u00bc\u00c8\u00ce\u00ba\n\n510\u00b0 \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb\u0083\u00b6\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00af\u00b4\u00c6\u00b4\u00b5+\u00c6\u00af\u00bf\u00c6\n\n\u00b9\u00c7\u00af\u00ba\u00c6 XXI\n\n\u00b6\u00c1\u00de\u00af\u00bf\u00c6\n\n511\u00b0 \u0089\u00ce\u00c0\u00bb\u00c7\u00b8 \u00e7\u00bd\u00c6\u00bd\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00b6\u00ae\u00b4\u00ce\u00b8\n\n512\u00b0 \u00b9\u00b6\u00c8\u00cd\u00c1\u00d5\u00af\u00ce\u00bf\u00b9\u00c6 \u00cc\u00b9\u00c7\u00bb\u00c6\u00bb\u00c7\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00b6\u00ae\u00b4\u00ba\u00c6\n\n513\u00b0 \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u201d \u00a9\u0081\u00bd \u00cc\u00b1\u00c7\u00be\u00c6\u00ce\u00be \u00db\u00ce\u00bd\u00cd\u00af\u00b4\u00c7\u00af\u00b9\u00c6\u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00bf\u00c6\u00bf \u00b6\u00ae\u00b4\u00ba\u00c6\n\n\u00b6\u00c1\u00de\u00af\u00bf\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00cc\u00b9\u00c7\u00d7 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00b