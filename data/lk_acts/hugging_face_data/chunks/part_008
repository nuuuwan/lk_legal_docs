    "chunk_text": "(\u00a3) \u00a5\u00b7\u00c6\u00b6 \u00a3\u00ce\u00ba\u00b9\u00c6\u00b9\u00af\u008c\u00b6\u00c8\u00af\u00bf\u00c8\u00be\u00c6 \u00a7\u00bf\u00c6\u00bf\u00d7 \u00a9\u00d7 \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c8\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6\" \u00a3\u00b7\u00c6\u00b6 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00ce\u00bb \u00a9\u00d5\u00b6\u00c6\u00b6\u00be\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00be\u00c6\u00c1\u008b\u00b6\u00c7\u00b8\u00b6\u00c7\u00af \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b9\u00c6\u00b9\u00b6\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a4) \u00a5\u00b7\u00c6\u00b6\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u008131 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b9\u00c6 \u0089\u0081\u00b9\u00bd\u00c6\u00bd\u00c8 \u00a3\u00b7\u00c6\u00b6 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6\u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n\u00a5\u00b7\u00c6\u00b6 \u00a3\u00ce\u00ba\u00b9\u00c6\u00b9\u00af\u008c\u00b6\u00c8\u008a\u00be\u00c6 -\n\n(\u00a3) \u201c\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00d7 2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a9\u00b8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n(\u00a4) \u00a5\u00b7\u00c6\u00b6\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00c1\u00ce\u00bc\u008c\u00be\u00af\u00c6\u00af\u00b5+\u00c6 \u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00b6+\u00c6\u00af\u00bf\u00c6\u00a5\u00b7\u00c6\u00b6 \u00a3\u00ce\u00ba\u00b9\u00c6\u00b9\u00af \u008c\u00b6\u00c8\u008a\u00be\u00c6 \u00a7\u00bf\u00c6\u00bf \u00a3\u00cd\u00b6 \u00af\u00dd\u00b6\u00c6\u00ce\u00b6\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00a5\u00bc\u00ae\u00b4\u00c7\u00c1\u00d7 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5(\u0089\u00bc\u00c8\u00e2 31 (1))\n\n\u00b9+\u00c6\u00d0\u00b6\u00c7\u00bc\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00aa\u00af\u00ba\u00b8\u00b6\u00c7\u00b8 \u00a3+\u00c6\u00af\u00c9\u00af\u00c7\u00bc\u00b6\u00c6\u00d7\u00b4\u0081 \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6\u00b6\u00b8\u00c8\u00bb\u00c7\u00bc\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00e0\u00af\u00c6\u00d0 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00b6\u00c6\u00b6\u00c7\u00af\u00c7\u00b6 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00b0\n\n\u0089\u00bc\u00c8\u00e2 52(\u00b9+\u00c6\u00d0\u00af\u00bf\u00c6 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u0089\u00bc\u00b6\u00c8\u00b9\u00bb\u0081)\n\n\u0089\u00bc\u00c8\u00e2 53(\u00da\u00b6\u00c8\u00bb \u00c1\u00c0+\u00c6\u00af\u00be\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8 \u00db\u00bd\u00c6\u00cc\u00af\u00c7\u00bf\u00c6 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00bf\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 56(\u00b9\u00af\u00c8\u00bc\u00c6\u00b7\u00c6\u00b6\u00bf\u00c8\u00b9\u00c6\u00da\u00af\u00bf\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 60(\u00b9+\u00c6\u00af\u00c8\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 61(\u00b9\u00af\u00c8\u00bc\u00c6\u00b7\u00c6\u00b6\u00bf\u00c8\u00b9\u00c6\u00da\u00af\u00ce\u00bf \u00ba\u00c9\u00bf\u00b9\u00c6\u00cc\u00b9\u00bd\u00be\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 64(\u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00b9\u00c6 \u00b9+\u00c6\u00d0\u00af\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b8\u00e2\u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 70(\u00b7\u00c8\u00b6\u00c8 \u00a7\u00b6\u008c\u00af\u00bf\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b6\u0081 \u00ba\u00c9\u00b6\u00c7\u00b8 \u00ba\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 90(\u00b9+\u00c6\u00d0\u00b6\u00c7\u00bc\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00cc\u00af\u00b8 \u00ac\u00d7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00b6\u00c6\u00d7\u00c1+\u00c6\u00af\u00ce\u00bf\u00b9\u00c6\u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00c8\u00b6\u00c6\u00b6\u00be\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 92(1) (\u00a4) (\u008c\u00cd\u00b1\u00b4 \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00f2\u00be\u00ba\u00c6 \u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00b6\u00b6\u00c6\u00d7\u00c1+\u00c6\u00af\u00bf\u00c6)\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6580\n\n\u0089\u00bc\u00c8\u00e2 99(\u00b9+\u00c6\u00d0\u00b6\u00c7\u00bc\u00bc\u00c8\u0081 \u00a7\u00bc\u00c8\u00ce\u00ba \u00ba\u00c7\u00bd\u00c6\u00bd\u00ba\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 185(\u00b9\u00c7\u00bc\u00c8\u00bb \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00be\u00c6 \u00c1\u00c7+\u00c6\u00af\u00be\u00c6\u00af\u00bf\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 192(\u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00ce\u00bb \u00cc\u00c1\u00bf\u00c8\u008c\u00d5\u00b6\u00be\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 193(\u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00be\u00c6 \u00c1\u00c7+\u00c6\u00af\u00ce\u00be\u00b6\u00c6 \u00b6\u008c\u00bc\u00c6\u00b6\u00c6\u00b6\u00be\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 216(\u00a8\u00b6\u00c8\u00bb\u00db\u00ba\u00c6 \u00cd\u00c1\u00de \u00b7\u00be\u0081\u00af\u00e0\u00ba\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 217(\u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8 \u00af\u00b4\u0081\u00af\u00bf\u00c8\u0081 \u00ba\u00c9\u00b6\u00c7\u00b8\u00ba\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 218(\u00b7\u00b4\u00c6\u00cd\u00b4\u00c7\u00b6\u00c6\u00b6\u00bc\u00c1\u00c7\u00b6\u00db\u00ba\u00c6 \u00af\u00c7\u00b9\u00c6\u00da\u00de\u00b6\u00c8\u00dc\u00ba\u00c6)\n\n\u00f2\u0081\u00bd\u00c7\u00c1\u00d7 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5(\u0089\u00bc\u00c8\u00e2 35 (1))\n\n\u00a7\u00b6\u00c6\u00b6\u00bc\u00c1\u00c7\u00b6\u00f2\u00be\u00ba\u00c6 \u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00e0\u00af\u00c6\u00d0 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00b6\u00c6\u00b6\u00c7\u00af\u00c7\u00b6 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00b0\n\n\u00b9\u00d0\u00b6\u00c8 IV (\u00b9+\u00c6\u00d0\u00af\u00e0\u00ba\u00c6 \u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00b4\u0081\u00af\u00e0\u00ba\u00c6)\n\n\u0089\u00bc\u00c8\u00e2\u00af\u00bf\u00c6 93 \u00a5\u008b\u00dd\u00b7\u00c6\u00d7 98 \u00c1\u00ce\u00bc (\u00b1\u00c8\u00de\u00b9\u00c7\u0081\u00ce\u00ba \u00a7\u00ce\u00b4\u00ce\u00ba \u00b7\u00c9\u00af\u00c6\u00d0 \u00a7\u00bc\u00c8\u00ce\u00ba)\n\n\u0089\u00bc\u00c8\u00e2 99 \u00a5\u008b\u00dd\u00b7\u00c6\u00d7 101 \u00c1\u00ce\u00bc (\u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00b6\u00c6 \u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u00af\u00bf\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 123 (1) (\u00a4) \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 (\u00a5) (\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00b9+\u00c6\u00d0 \u00a5\u00b4\u00c7\u00b9\u00c6\u00ce\u00b9\u00b9\u00c6 \u00cd\u00b9\u00b5\u00c8\u00c1\u00dd\u00b6\u00be\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 124 (1) \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 (3) (\u00b9+\u00c6\u00d0 \u00a5\u00b4\u00c7\u00b9\u00c6\u00da \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00a5\u00b4\u00c7\u00b9\u00c6\u00da)\n\n\u0089\u00bc\u00c8\u00e2\u00af\u00bf\u00c6 198 \u00a5\u008b\u00dd\u00b7\u00c6\u00d7 200 \u00c1\u00ce\u00bc (\u00b9+\u00c6\u00d0\u00af\u00bf\u00c8\u00be\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00bf\u00c6\u00bf \u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00ce\u00bb \u00cc\u00c1\u00bf\u00c8\u008a\u00d5\u00b6\u00be\u00c6)\n\n\u0089\u00bc\u00c8\u00e2 220 (\u00af\u00d5\u00ba\u00c6 \u00f2\u00be\u00b6\u00b8 \u00a5\u00c0\u00b9\u00c6\u0089\u0081 \u00ba\u00c9\u00b6\u00c7\u00b8 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00af\u00b4\u00ce\u00ba)\n\n\u00b9\u00c7\u00af\u00ba\u00c6 VIII (\u00ac\u0081\u00bd\u00c8\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6\u00af\u00bf\u00c6)\n\n\u00ab\u00b7\u00c6\u00b6\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 \u00a7\u00b9-\u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00bf\u00c6 (\u00a4) \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 (\u00a7) \u00cc\u00b6\u00c7\u00b4\u00af\u00c6\u00af\u00ba\u00c6 (\u00ad) \u00c1\u00ce\u00bc (\u00a4\u00ae\u00d5 \u008c\u00b9\u00bc\u00b6\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u0088\u00be\u00c6 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4 \u00cd\u00c1\u00ae\u0088\u00bb\u008c\u00b4\u00bb+\u00c6\u00af\u00bf\u00c6)"
  },
