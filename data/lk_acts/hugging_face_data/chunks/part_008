    "chunk_text": "(9) \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6 \u0089\u00b5\u00af\u00c6\u00d0\u00af\u00bf\u00c6 \u00b1\u00ce\u00b9\u00bb\u00c7\u00b8\u00d7\" \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c8\u0081\u00a3+\u00c6\u00af\u00c9\u00af\u00c7\u00bc\u00b6\u00c6\u00d7\u00b4\u0081\" \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00a5\u00b9\u00c6\u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00c9\u00c0\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u0089\u00b5\u00af\u00c6\u00d0\u00af\u00bf\u00c6 \u00b1\u00ce\u00b9\u008a\u0081 \u00af\u00b4\u00ce\u00ba\u00af\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5 \u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00c1\u00b6\u00c8\u00be\u00c6\u00a7\u00b6\u00e2\u00c1\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00c1\u00bc\u00c6\u00af\u00cc\u00bf\u00b8 \u00a3\u00d7 \u00af\u00dd\u00d7\u00af\u00c8\u0081\u00bd \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a3\u00df\u00c1\u00be\u00bc\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cd\u00b1\u00ce\u00c1\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n508\u00b0 (1) (\u00a3) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00d0 \u00b9\u00bb\u0081 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c6 \u00a9\u00e1\u00af\u00c8\u0081\u00bd ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4) \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00a9\u00b6\u00b8\u00d7\u00ba\u00c6 \u00a3\u00df\u00c1\u00be\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00db\u00af\u00c7\u00ce\u00ba \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c7\u00b8\"\n\n\u0089\u00b5\u00af\u00c6\u00cc\u00af\u00c7\u0081\u00bd\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00b6\u00c8\u00bd\u00b6\u00c6\u00b6\u00c1\u00bc