    "chunk_text": "(\u00a4) 1861 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 \u00e7\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9+\u00c6\u00d0\u00b6\u00c6 \u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u00af\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 \u008a\u0081 \u2018\u00a5\u2019\u00a9\u00d9\u00ba\u00c6 \u00b9\u00c7\u00af\u00b6\u00c6\u00ce\u00b6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00c7\u00af\u00b6\u00c6\u00ce\u00b6\u00b7\u00c8\u00bb\u00ba\u00c8\u00b6\u00c6\u00b6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a7\u00bf\u00b6\u00c7\u008a\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00c6\u00d0 \u00a3\u00d7 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b6\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00a3\u00bf\u00e2\u00af\u00c6\u00d0\u00ba\u00c6 ;\n\n\u00ac\u00d5\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af \u00db\u0088\u00e2\u00bd\u00c7\u00b6\u00c8\u00dd\u00af\u00c6\u00d0\u00ba\u00c6\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8\u00cd\u00b9\u00b5\u00be\u00c6\u00af\u00bf\u00c6\u00b0\n\n(\u00a5) 1897 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 \u00e7\u00b4\u00c6\u00d5\u00b9\u00c6 \u00b9+\u00c6\u00d0\u00b6\u00c6\u00cc\u00b6\u00c7\u00d0\u00b6\u00c8 \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081\u2018\u00a4\u2019 \u00a9\u00d9\u00ba\u00c6 \u00b9\u00b4\u00c6\u0088\u00bb\u00ce\u00be \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00b9\u00c7\u00af\u00b6\u00c6\u00ce\u00b6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00b6\u00c6\u00b6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a7\u00bf\u00b6\u00c7\u008a\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00c6\u00d0 \u00a3\u00d7 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b6\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00d0\u00ba\u00c6\u00a3\u00bf\u00e2\u00af\u00c6\u00d0\u00ba\u00c6 ;\n\n(\u00a6) (145 \u00a4\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8) \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b8 \u00db\u00b6\u00be\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00be\u00c6 \u00a7\u00bf\u00c6\u00bf \u2018\u00a3\u2019\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u2018\u00a5\u2019 \u00a9\u00d9\u00ba\u00c6 \u00b9\u00b4\u00c6\u0088\u00bb\u00be\u00c6\u00af\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u00c7\u00af\u00b6\u00c6\u00ce\u00b6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00b6\u00c6\u00b6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a7\u00bf\u00b6\u00c7\u008a\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00c6\u00d0 \u00a3\u00d7 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b6\u00c7\u00af\u00a5\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00a3\u00bf\u00e2\u00af\u00c6\u00d0\u00ba\u00c6 ;\n\n(\u00a7) 1982 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 17 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00db\u00b6\u00be\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00be\u00c6 \u00a7\u00bf\u00c6\u00bf \u2018\u00a3\u2019\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u2018\u00a5\u2019 \u00b9\u00b4\u00c6\u0088\u00bb\u00be\u00c6\u00af\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00b9\u00c7\u00af\u00b6\u00c6\u00ce\u00b6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00b6\u00c6\u00b6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a7\u00bf\u00b6\u00c7\u008a\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00c6\u00d0 \u00a3\u00d7 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b6\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00d0\u00ba\u00c6\u00a3\u00bf\u00e2\u00af\u00c6\u00d0\u00ba\u00c6\"\n\n\u00b9\u00c7\u00b6\u00c8\u00b6\u00c6\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n532\u00b0 (1) \u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00ce\u00ba\u00bb\"\u00ac\u00d5\u00af\u00c6\u00d0\u00b6\u00be\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\" \u00b7\u00c8\u00bb\u00ba\u00c8\u00b6\u00c6\u00b6\u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u0081\u00b8\u00bc\u00c6 \u00a3\u00b6\u0081 \u00ac\u00d5\u00af\u00c6\u00af\u00be\u00c6 \u00a4\u00bc\u00ba\u00c6\u00b9\u00ba\u00c7\u00af\u00c8\u00dc\u00bf\u00c6\u00bf \u00a9\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c7\u00af\u00c7\u00d7\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00dc\u00ba\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u008c\u00be\u00c6\u00ce\u00be\u00cc\u00bb\u0081\u00bd\u00c7\u00bd\u00c6\u00cd\u00b9\u00c7\u0081\u00de \u00a3\u00cd\u00b6\u00db\u00ce\u00bd\u008a\u00df\u00ba\u00c6 \u00a3\u00cd\u00b6 \u00b7\u00c8\u00af\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00af\u00e0\u00b4\u00d9\u00ba\u00c6 \u00ac\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00ac\u00d5\u00af\u00c6\u00d0\u00ba\u00c6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\"\u00a9\u00c1\u00c6\u00cc\u00c1\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u00b8 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00ac\u00d5\u00af\u00c6\u00af\u00be\u00c6 \u00a4\u00bc\u00ba\u00c6\u00b9\u00ba\u00c7\u00af\u00c8\u00bb\u00cd\u00b6\u00c7\u00a3\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00db\u00e1\u00c1\u00df\u00e2\u00b4\u0081 \u00a5\u00dd\u00b9\u00c6\u00b9\u00b6\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00e2\u00af\u00c6\u00af\u00c8\u00b5+\u00c6\u00af \u00ac\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c7\u00b8\u00d7\" \u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00af\u00b4\u0081\u00b6\u00dd\u00b7\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6551\n\n\u00b7\u00c9\u00af\u00c6\u00af+\u00c6\u00af\u00bf\u00c6\u00b0\n\n1996 \u00a4\u00ba\u00c6\u00a4\u00ae\u0088\u008110 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00db\u00b6\u00be\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00af\u00c6\u00af\u00c7\u00b8\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00ba\u00c6\u00b0"
  },
