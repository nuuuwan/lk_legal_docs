    "chunk_text": "2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6540\n\n\u201c\u00cc\u00b9\u00de\u00b7\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" XV \u00a9\u00d9\u00ba\u00c6 \u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00ac\u0081\u00bd\u00c8\u0081 \u00a4\u00b6\u00b8\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00db\u00e1\u00c1\u00ce\u00b6\u00dc\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u0081 \u00ac\u00dd \u00b9\u00c7\u00af\u00b6\u00c6\u00ce\u00b6\u00b9\u00c6\u00cc\u00b9\u00de\u00b9\u00c1\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00a5\u00b4\u00c7\u00b9\u00c6\u00da\u201d \u00a9\u0081\u00b9\u00d7\" 473 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 \u00af\u00c9\u00c0\u00c6 \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u00b8\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00b4\u00c7\u00b9\u00c6\u00da \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6 \u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00ce\u00bf\u00b9\u00c6\u00b9\u00b6\u00c8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6\u00af\u00b4\u00ce\u00ba\u00ce\u00bb \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00da\u00bc\u00c8\u00af\u00c8\u0081\u00bd \u00cd\u00c1\u00de \u00a3\u00df\u00c1\u00be\u00bc\u00c6\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00a3\u00ce\u00ba\u00b9\u00c6\u00da \u00a3\u00af\u008c\u00b6\u00c8\u00af\u00bf\u00c6 \u00ba\u00c7\u00bd\u00c6\u00de\u00ba\u00c6 \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" 15 \u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00b6\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00cd\u00b6 \u00af\u00dd\u00b6\u00c6\u00ce\u00b6\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\n\n\u201c\u00b9+\u00c6\u00d0\u201d \u00a9\u0081\u00b9\u00d7\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00ac\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ac\u00dd\u00b9+\u00c6\u00d0 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00b9+\u00c6\u00d0 \u00a5\u00b4\u00c7\u00b9\u00c6\u00da\u201d \u00a9\u0081\u00b9\u00d7\" 123 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u00b8\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a5\u00b4\u00c7\u00b9\u00c6\u00da \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00b9+\u00c6\u00d0\u00b6\u00c7\u00bc\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" 86 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00b6\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00c1\u00c7\u00bd\u00c7\u00b8\u00a3\u00cd\u00b6 \u00af\u00dd\u00b6\u00c6\u00b6\u00ce\u00b6\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\n\n\u201c\u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00f2\u00be\u00b6\u00b8\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" 58 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00b6\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00cd\u00b6 \u00af\u00dd\u00b6\u00c6\u00ce\u00b6\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6541\n\n\u201c\u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be\u201d \u00a9\u0081\u00b9\u00d7\"\n\n(1) \u00ac\u00dd \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00b8\u00d7 \u2013\n\n(\u00a3) \u00a5\u0081\u00cc\u00b8\u00c7\u00dd \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u2013\n\n(i)\u00a3\u00b6\u0081 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c6 \u00b1\u00ce\u00b9\u008a\u0081 \u00a3\u00ce\u00ba\u00b9\u00c6\u00ce\u00b9\u00af\u00c6\u00af\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00c7\u00af \u00a5\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u00c6 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(ii)\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00e7\u00b4\u00c6\u00b4\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u00be\u00c6 \u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00db\u0088\u00dc\u00ba\u00c7\u00b8 \u00c1\u00c7\u00af\u00c6\u00d0\u00af\u00bf\u00c8\u0081 \u00a3\u00b6\u00c8\u00e7\u0088\u00bb\u00a9\u00ae\u00b5\u00c8\u00af\u00c6\u00ce\u00af\u008a\u0081 \u00a3\u00ce\u00bc\u00c1\u00c7\u00b1\u00c8\u00af\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c6\u00b4\u00ce\u00b6\u00b9\u00c6\u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00c8\u00b6\u00c6\u00b6\u00ce\u00be\u00af\u00c6\u00af\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6 \u00ac\u00dd \u00b7\u00c8\u00ce\u00be\u008a\u00be\u00c6 \u00a5\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u00c6 ;\n\n(iii)\u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00f2\u00be\u00b6\u00b8\u00b9\u00c6 \u00b9\u00af\u00c8\u00bc\u00c6\u00cc\u00c1\u00c7\u0081\u00bd\u00c8\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b6\u00c7\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00a3\u00b9\u00c6\u00b9\u00c7\u00be\u00c6 \u00b9+\u00c6\u00d0 \u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a9\u00b7\u00c6\u00b6 \u00a7\u00bc\u00c8\u00ce\u00ba\u00ce\u00bb\u00dc\u00ba\u00c6\u00cc\u00af\u00c7\u00ae\u0088\u00bc\u00c7\u00b6 \u00b9+\u00c6\u00d0\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00c7\u00b6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081\u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9+\u00c6\u00d0\u00af\u00bf\u00c8\u0081 \u00a3\u00ce\u00bc\u00c1\u00c7\u00b1\u00c8\u00af\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9+\u00c6\u00d0\u00af\u00ce\u00bf \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u00c6 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(iv)\u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00f2\u00be\u00b6\u00b8\u00b9\u00c6 \u00b9\u00af\u00c8\u00bc\u00c6\u00cc\u00c1\u00c7\u0081\u00bd\u00c8\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b6\u00c7\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00a3\u00b9\u00c6\u00b9\u00c7\u00be\u00c6 \u00b9+\u00c6\u00d0 \u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a9\u00c1\u00c6\u00e2\u00bc\u00c8\u00ce\u00ba\u00ce\u00bb\u00dc\u00ba\u00c6\u00cc\u00af\u00c7\u00ae\u0088\u00bc\u00c7\u00b6 \u00b9+\u00c6\u00d0\u00af\u00bf\u00be\u00c6\u00be\u00c7\u00b6\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00be\u00c6\u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9+\u00c6\u00d0\u00af\u00bf\u00c6 \u00ba\u00c9\u00d7 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00b9+\u00c6\u00af\u00c8\u00be\u00c7\u00b9\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7 \u00a3\u00ce\u00bc\u00c1\u00c7\u00b1\u00c8\u00af\u00c6\u00d0\u00ba\u00c6\u00cd\u00ba\u00be\u00c7\u00b8\u00ce\u00b6\u00b9\u00c6 \u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a7\u00bc\u00c8\u00b6\u00c6\u00d7\u00ce\u00b4\u00bb\u00c1\u00bc\u00c7\u00bb\u00c6\u00a5\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u00c6 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4) \u00db\u00b6\u00be\u00c7\u00c1\u00d7 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00b8\u00d7\" \u00a3\u00b7\u00c6\u00b6\u00cd\u00c1\u00de \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be\u00af\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00bb\u00c6\u00a7\u00bf\u00c6\u00bf \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00af \u00a5\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u00c6\" \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00a5\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u00c6\u00ba\u00c7\u00b6\u00c6\u00b6\u00c8\u00bc\u00cd\u00ba\" \u00a3\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00a3\u00b7\u00c6\u00b6 \u00a5\u0081\u00cc\u00b8\u00c7\u00dd \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be\u00af\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6542"
