    "chunk_text": "25\u00b0\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00e2\u00bf\u00c6\u00bf \u00a4\u00b6\u00b8\u00ba\u00c6 \u00a9\u00d7\u00e2\u00ba\u00c6 \u00d0\u00b6\u00c6\u00b6\u00ce\u00af\u00af\u00c6\u00d0\u00a9\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u008c\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7 \u201c\u008c\u00bd\u00c6\u00cd\u00b9\u00c7\u0081\u201d \u00a9\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00be\u00c6\u00be\u00ce\u00ba\u00b9\u00c6\u00da\u00d0\u00b6\u00c6\u00b6\u00ce\u00af \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00c1\u00ce\u00bc \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00af\u00c8\u008a\u00dd\u00b7\u00c6\u00b6\u00c7\u00bd\u00c6\u00cd\u00b9\u00c7\u0081\u00de\u00ba\u00c6 \u201c\u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b8\u00e2\u00b9\u00c6 \u00b9\u00b5\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00be\u00c6\u00be\u00ce\u00ba\u00b9\u00c6\u00da \u00d0\u00b6\u00c6\u00b6\u00ce\u00af\u00af\u00c6\u00af\u00c7\u00b8 \u0089\u00bc\u00b6\u00c8\u00b9\u00be\u00ce\u00b8 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00af\u00c8\u008a\u00dd\u00b7\u00c6\u00b6\u00c7\u00bd\u00c6\u00cd\u00b9\u00c7\u0081\u00de\u00ba\u00c6 \u201c\u00a7\u00b9 \u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b8\u00e2\u00af\u00c6\u00af\u00c7\u00bc\u00bc\u00c6\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00be\u00c6\u00be\u00ce\u00ba\u00b9\u00c6\u00da \u00a7\u00b9 \u00d0\u00b6\u00c6\u00b6\u00ce\u00af\u00af\u00c6\u00af\u00c7\u00bc\u00bc\u00c6 \u00ac\u00dd\u00c1\u00ce\u00bc \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00af\u00c8\u008a\u00dd\u00b7\u00c6\u00b6\u00c7\u00bd\u00c6\u00cd\u00b9\u00c7\u0081\u00de\u00ba\u00c6 \u00a5\u00c1\u00c6\u00c1\u00b4\u00c6\u00b4\u00ce\u00b5 \u00b9\u00bb\u00d9\u00de\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n27\u00b0\u00b9\u00b6\u00c6\u00b6\u00c7\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\" \u008c\u00bd\u00c6\u00cd\u00b9\u00c7\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00c6\u00af\u00e0\u00bf\u00c6 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00d0\u00e1\u00ba\u00ba\u00c6 \u00ac\u0081\u00bd\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u00d0\u00e1\u00ba\u00b6\u00c6\u00b6\u00c8\u0081\u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00bf\u00c6 \u00cd\u00c1\u00de\u00cd\u00c1\u00bd\u00c7\u00b8 \u008c\u00bd\u00c6\u00cd\u00b9\u00c7\u00bc\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n28\u00b0\u00ab\u00b7\u00c6\u00b6\u00c7\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00c1\u00c7\u00b8 \u00af\u00c7\u00be\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00ce\u00be\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u00d5 \u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u0081 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00ab\u00b7\u00c6\u00d7\u00c1\u00dd\u00b4+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00c1\u00c7\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00b7\u00b4\u00c7\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b6\u00c7\u00c0\u00c8\u00cc\u00be\u00c7\u0081\u00bd\u00c8\u0081 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\" \u00a3\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00b8\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00b8\u00d7\u00af\u00b5\u00af\u00c6\u00d0\u00af\u00bf\u00c6 \u00b7\u00c7\u0081\u00d0 \u00a4\u00ae\u00d5\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\" \u00f2\u00b8\u00c6\u00de \u00a4\u00ae\u00d5\u00af\u00bf\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\" \u00a5\u00bc\u00ae\u00d5 \u00a4\u00ae\u00d5\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00ad\u00bc\u00c7\u00ae\u00d5\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af \u00ba\u00b4\u00c6\u00d5\u00cd\u00ba \u00b6\u00bb\u00c7\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u008c\u00b4\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00cd\u00af\u00bd\u00c6\u00bd\u00c7\u00bd\u00c6\u00cd\u00b9\u00c7\u0081\u00de\" \u00b7\u00c7\u0081\u00d0 \u00a4\u00ae\u00d5\u00af\u00bf\u00c6\" \u00f2\u0081\u00de \u00a4\u00ae\u00d5\u00af\u00bf\u00c6\" \u00a5\u00bc\u00ae\u00d5\u00a4\u00ae\u00d5\u00af\u00bf\u00c6\" \u00ad\u00bc\u00c7\u00ae\u00d5 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00af\u00bf\u00c6 \u00ab\u00b7\u00c6\u00b6\u00c7\u00ae\u00d5\u00af\u00bf\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb\u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u00a5\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c7\u00bd\u00c6 \u00cd\u00b9\u00c7\u0081\u00de 20 \u00a4\u00ba\u00c6\" 21 \u00a4\u00ba\u00c6\"\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 22 \u00a4\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00bf\u00c8\u00b8\u00d7 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00b9\u00bb\u00d9\u00de\u00c1\u00b8\u00c1\u00c7\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6591\n\n29\u00b0\u00a5\u00dd\u00b9\u00b6\u00c7\u00ba\u00c6\" 21 \u00a4\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 22 \u00a4\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00bf\u00c8\u00be\u00c6 \u201c\u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d5\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00be\u00c6\u00be\u00ce\u00ba\u00b9\u00c6\u00da\" \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cd\u00af\u00bd\u00c6\u00bd\u00c7\u00bd\u00c6\u00cd\u00b9\u00c7\u00b8\u00c6\u00de \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00b8\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00b8\u00d7 \u00af\u00b5\u00af\u00c6\u00d0\u00af\u00bf\u00c6 \u00a9\u00b7\u00c6\u00b6 \u00a4\u00ae\u00d5 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\u00b6\u00c6 \u00b6\u00bb\u00c7\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00b8\u00cd\u00c1\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00a4\u00ae\u00d5 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u0081 \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d5\u00db\u0088\u00c1\u00ce\u00b4\u00dc\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u008a\u00be\u00c6 \u00a7\u00bf\u00c6\u00bf \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ba\u00c7\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00c7\u00bc\u00b5\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u0081 \u00af\u00b5\u00af\u00c6\u00d0\u00af\u00bf\u00c6 \u00ad\u00bc\u00c7\u00ae\u0088\u00bd\u00c6\u00d0\u00af\u00c6 \u00e7\u00d5\u00b6\u00be\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00ce\u00bd\u00c1\u00c7\u00b8 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00cc\u00af\u00b8\u00b6\u00c6\u00b6\u00bb\u00c7\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u00e7\u00d5\u00b6\u00be\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00ce\u00bd\u00c1\u00c7\u00b8\u00a3\u00b7