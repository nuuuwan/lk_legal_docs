    "chunk_text": "(\u00a1\u00e5) \u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 (ii)\u00c9\u00be \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u201c \u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba\u00c6\u00b4 \u00cc\u00c4\u00e5\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6:\u201d, \u00c6\u00be \u00c9\u00ae\u00be\u00c9\u00c8 \u00cc\u00e8\u00b4 \u00a6\u00c4 \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u00a1\u00c9\u00cc\u00e5\u00be\u00c6 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00a8\u00e5\u00b4\u00cc \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201d \u201c\u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba\u00c6\u00b4\u00cc\u00c4\u00e5\u00be \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0;\n\n(\u00a1\u00e6) \u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e7) \u00ef\u00d8\u00bc\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\u00cc\u00cd\n\n(2)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00e8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n19.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 63 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c\u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8; \u00ef\u00cd\u00e5\u00e0\u201d,\u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8;\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00e8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(2)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u201c\u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00f8\u00be\u00e0 \u00cc\u00c4\u00be\u00e0\u0097\u00ba\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec;\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00f8\u00be\u00e0\u00cc\u00c4\u00be\u00e0\u0097\u00ba \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec; \u00ef\u00cd\u00e5\u00e0 \u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00e8\u00d7\u00ef\u00c4\u00be\u00e0;\n\n(3)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0\u00ef\u00d8\u00bc\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(\u00a1\u00e7) \u00a6\u00e0 \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c6 \u00be\u00f8\u00c8 \u00c8\u00e6\u00c6\u00fa\u00cc\u00e0\u00ba\u00eb\u00aa\u00ba \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0\u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00b4 \u00c0\u00ba\u00e0\u00a8\u00c7\u00be \u00c8\u00bc \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c6\u00a8\u00e0 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec,\u201d;\n\n(4)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00e6\u00ba\u00f8 \u00cc\u00b4\u00cd\u00ef\u00be\u00e0 \u201c\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c4\u00ea\u00dd \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba \u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u008a\u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 63\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba29\n\n20.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 65 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1) \u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 :\u2014\n\n(\u00a1)\u201c\u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00a1\u00e5\u00aa\u00be\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c0\u00bc\u00be\u008a \u00a8\u00c7\u00aa\u00be\u00e0\u00be\u00e5\u00c8\u00e5\u00c3\u00c9\u00c8\u00e8\u00be\u00e0, \u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00aa\u00d1\u00c4\u00b4 \u00ef\u00a8\u00ef\u00c7\u00be\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0\u00ef\u00aa\u00d1\u00c4\u00b4 \u00ef\u00a8\u00ef\u00c7\u00be \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0;\n\n(\u00a1\u00e5)\u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6\u0097\u00bd\u00e5\u00be\u00c6 \u00cc\u00cd \u201c\u00bc\u00ce \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u201d \u00c6\u00be \u00ef\u00c6\u00f3\u00ef\u008a \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00be\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4, \u00a6\u00e0\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00ef\u008a \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00c6\u008a\u00c9\u00e5\u00cc\u00e8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00bc\u00ce \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6\u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb, \u00ab\u00ee\u00b0\u00ea\u00c9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00ba\u00c7\u00c4\u00e6\u00bc\u00fa \u00cc\u00c4\u00e5\u00aa\u008a \u00a6\u00a8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c9\u00e6\u0091 \u00aa\u00b8\u00be\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c9\u00e5\u00cc\u00e8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00cc\u00cd \u00c0\u00ce\u00c4\u00ea\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c8 \u00c9\u00e5\u00cc\u00e8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00ef\u00c9\u00ba \u00c8\u00e6\u00c2\u00ea\u00b8\u00ea \u00c6\u008a \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca \u00a1\u00e6\u00ba\u00e0\u00be\u008a, \u00a6\u00a8\u00f9 \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca \u00ef\u00a8\u00e5\u00b4\u00cc\u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00ef\u00be\u00e5\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d; \u00cc\u00cd\n\n(2)\u00a6\u00c4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00ef\u00c6\u00e0 (\u00a1\u00e7) \u00ef\u00d8\u00bc\u00ef\u00c6\u00cd\u00fa :\u2014\n\n(\u00a1) (i) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(i) \u00c8\u00e6\u00c2\u00ea\u00b8\u00ea \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c9\u00c8\u00e8\u00be\u00e0 ; \u201d; \u00cc\u00cd"
