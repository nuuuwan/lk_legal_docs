    "chunk_text": "(\u00a5) \u00ac\u00d5\u00af\u00c6\u00d0\u00b6\u008b\u00be\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cd\u00af\u00bd\u00c6\u00b9 \u00af\u00b5\u00af\u00c6\u00af\u00c8\u0081 \u00ba\u00c8\u00d0\u00b6\u00c8\u00ba\u00c7\u00b6\u00c6\u00b6\u00c8\u00bc\u00ba\u00c6 \u00a7\u00bc\u00c8\u00ce\u00ba\u00cd\u00af\u00c7\u00bc\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u00e2\" \u00b9+\u00c6\u00d0\u00b6\u00c7\u00bc\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c7\u00be\u00c6 -\n\n(\u00a3) \u00b9+\u00c6\u00cc\u00af\u00c7\u0081\u00bd\u00c8\u0081 \u00c1\u00c0+\u00c6\u00af\u00c9\u00b4\u00c6\u0088\u00bd\u00c6\u00af\u00c7\u00b8 \u0089\u00bc\u00b6\u00c8\u00b9\u00be\u00b8\u00c7\u00af\u00a3\u00be\u00c6\u00be\u00d7 \u0089\u00bc\u00b6\u00c8\u00b9\u00be\u00b8\u00c8\u0081 \u00b9\u00c7\u00af\u00ba\u00c7\u00af ; \u00a3\u00be\u00c6\u00be\u00d7\n\n\u00b9\u00bc\u0083\u00b9\u00bc \u00c1\u00bc\u00e2\u00ba\u00c6\u00a9\u00b6\u00c8\u00bc\u00c9\u00d5\u00ba\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6352\n\n\u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c6\u00ba\u00c9\u00b6\u00c7\u00b8 \u00c1\u00b4\u00c6\u0088\u00b0\n\n364\u00b0 (1) \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u0081 \u00cc\u00b6\u00c7\u00ce\u00af\u008a\u00be\u00c6 \u00ac\u00d5\u00af\u00c6\u00d0\u00b6\u008b\u0081 \u00a4\u00bc\u00ba\u00c6\u00b9\u00ba\u00c6 \u00c1\u00ce\u00bc -\n\n(\u00a3) \u00a3\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u008a\u0081\u00ba\u00c9\u00d7 \u00c1\u00b4\u00c6\u0088\u008a\u0081 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00c6\u00d0\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ac\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b4+\u00c6\u00af\u00c8\u008a\u00dd\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u0096\u00b6\u00b9\u00c6\u00b9\u0088 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4) \u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00b4\u0081 \u00ac\u0081\u00bd\u00c8\u0081 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00b4\u0081\u00ba\u00c9\u00d7\u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u0096\u00b6\u00b9\u00c6\u00b9\u0088\"\n\n\u00c1\u00b4\u00c6\u0088\u00dc\u00ba\u00c6 \u00a3\u00b4+\u00c6\u00af\u00c8\u008a\u00dd\u00af\u00c6\u00d0\u00ba\u00c6\u00b0\n\n(2) \u00aa\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00be\u00c6\u00be\u00c7 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u008c\u0081 \u0089\u0081\u00b8\u00bc\u00c6 \u00ba\u00c8\u00b6\u00ba\u00c8\u00b3\u00c6\u00b1\u00c8\u00bb \u00cc\u00b1\u00c7\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00bf\u00c6\u00a9\u00ce\u00c1\u00dc\u00ba\u00c6 \u00a9\u00b3\u00c6\u00b1\u00c8\u008a\u00dd\u00b9\u00c6\u0089\u0081\" \u00a3\u00b7\u00c6\u00b6 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c6\u00ba\u00c9\u00d7\"\u00ac\u00d5\u00af\u00c6\u00d0\u00b6\u00be\u00c6 \u00a4\u00bc\u00ba\u00c6\u00b9\u00ba\u00c7\u00b8 \u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00dc\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u00c1\u00ce\u00bc \u008c\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u0096\u00b6\u00b9\u00c6\u00b9\u0088 \u00c1\u00b4\u00c6\u0088 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a5\u00dd\u00b9\u00c6\u00da\u00b1\u00c6\u00cc\u00b1\u00c7\u00b6\u00c6\u00d7\u00ba\u00c8\u00d0\u00cc\u00b6\u00c7\u00ce\u00af\u008a\u0081 \u00cc\u00b6\u00c7\u00ce\u00af \u00a9\u00be\u00c6\u00be\u00c7 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c6 \u00ba\u00c9\u00b6\u00c7\u00b8\u00db\u00e1\u00ce\u00ba\u00bb\u00c7\u00b8 \u00c1\u00b4\u00c6\u0088\u00ce\u00bb \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00cd\u00b9\u00c7\u00b6\u00c7\u00b6\u00c7\u008a\u0081\" \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00ce\u00af\u00bb\u00c7\u00b8\u00d7 \u00a9\u00be\u00c6\u00be\u00c7 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c8\u00ce\u00b4\u00cd\u00bb\u00dc\u00ba\u00c6 \u008c\u00af\u00c8\u00b6\u00c7\u00b1\u00c7\u00bc\u00bc\u00c9\u00b6\u00c8\u008a\u00be\u00c6 \u00d0\u00ce\u00bd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(3) \u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00bd\u00c6\u00af\u00c8\u00b5+\u00c6\u00af \u00c1\u00b4\u00c6\u0088\u008a\u0081 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u008c\u0081 \u0089\u0081\u00b8\u00bc\u00c6 \u00ba\u00c8\u00b6\u00ba\u00c8\u00b3\u00c6\u00b1\u00c8\u00bb \u00a5\u00dd\u00b9\u00c6\u00da\u00b1\u00c6 \u00cc\u00b1\u00c7\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00bf\u00c6 \u00a9\u00ce\u00c1\u00dc\u00ba\u00c6\u00a9\u00b3\u00c6\u00b1\u00c8\u008a\u00dd\u00b9\u00c6\u0089\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00be\u00c6\u00be\u00c7 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c6\u00ba\u00c9\u00d7\u00ba\u00c6 \u00ac\u00d5\u00af\u00c6\u00d0\u00b6\u008b\u0081 \u00a4\u00bc\u00ba\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00cd\u00b6\u00b6\u00c8\u00c1\u00ce\u00bc \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cd\u00af\u00bd\u00c6\u00b9 (\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 (\u00a4)\u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u0096\u00b6\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6 \u008c\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u0096\u00b6\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a5\u00ce\u00b4\u008a\u00be\u00c7\u00b8 \u008c\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00b1\u00b9\u00c6\u00b9\u0088 \u00c1\u00b4\u00c6\u0088\u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00ba\u00c8\u00b6\u00ba\u00c8\u00b3\u00c6\u00b1\u00c8\u00bb \u00cc\u00b1\u00c7\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00bf\u00c8\u0081 \u00cc\u00b6\u00c7\u00ce\u00af\u00a9\u00be\u00c6\u00be\u00c7 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c6\u00ba\u00c9\u00d7\u00ba\u00c6 \u00c1\u00b4\u00c6\u0088\u00ce\u00bb \u00db\u00e1\u00ce\u00ba\u00bb\u00c7\u00af\u00b1\u00c6\u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00cd\u00b9\u00c7\u00b6\u00c7\u00b6\u00c8\u00dd\u00b9\u00c6\u0089\u0081 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00ce\u00af\u00bb\u00c7\u00b8\u00d7 \u00a9\u00be\u00c6\u00be\u00c7\u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c8\u00ce\u00b4\u00cd\u00bb\u00dc\u00ba\u00c6 \u008c\u00af\u00c8\u00b6\u00c7\u00b1\u00c7\u00bc\u00bc\u00c9\u00b6\u00c8\u008a\u00be\u00c6 \u00d0\u00ce\u00bd\u00b7\u00c6\u00d7\u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6353\n\n\u00db\u0081\u00d9\u00bc\u00c8\u00ce\u00ba\u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c6\u00b0"
