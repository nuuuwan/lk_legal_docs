    "chunk_text": "(iii) \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u201d ;\n\n(iv) \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u201d;\n\n(v) \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u201d ;\n\n(vi) \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6\u201d ;\n\n(vii) \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 (\u00b6\u00b8\u00c8\u00bb\u00c7\u00bc\u00c6) \u201d ;\n\n(viii) \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af\u00af\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u201d\u00b0\n\n(\u00a6)\u00a9\u00e1\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00bf\u00c8\u0081 \u00c1\u0088\u00c1\u00ba\u00c6\" \u00b9\u00dd\u00ba\u0081\" \u00a7\u00b1\u00c6\u00b1\u00bc\u00c8\u00b9\u00c6\u00da\u00af\u00bf\u00c6\" \u00a9\u00e1\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00ce\u00b4\u008a\u00be\u00c7\u00b8 \u00a5\u00ce\u00b4\u00cc\u00c1\u00bf\u00c8\u00af\u00bf\u00c6\" \u00b7\u00c8\u00de\u00b6\u00c6\u00b6\u00af\u00c6 \u00d0\u00bd\u00c8\u00af\u00bf\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a7)\u201c\u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u201d \u00a3\u00be\u00c6\u00be\u00d7 \u201c&\u201d\n\n8\u00b0 (1) \u00ac\u00dd \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00b8\u00d7 \u008c\u00cd\u00b1\u00b4 \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00f2\u00be\u00db\u00ba\u00c6\u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00bc\u00c8\u0081 \u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u00b8 \u00db\u0081\u00b8+\u00c6\u00af\u00c9\u00af\u00c7\u00bc\u00b6\u00c6\u00d7\u00b4\u00d9\u00ba\u00c6 \u00a3\u00b6\u0081\u00cc\u00b9\u00bb\u00ce\u00bc \u00ba\u00c7\u00bd\u00c6\u00bd\u00b3\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00be\u00c7\u00ba\u00c6\u00b0\n\n(2) \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00b6\u0081 \u00cc\u00b9\u00bb\u00ce\u00bc\u00ba\u00c7\u00bd\u00c6\u00bd\u00b6\u00c6 \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00c8\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf\u008c\u00b4\u00b6\u00c6\u00d7\" \u00ba\u00c7\u00bd\u00c6\u00bd\u00b3\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00b6\u00c6\u00d7\u00cd\u00c1\u00ce\u00be\u00b7\u00c7\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00bf\u00c6 \u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00dd\u00af\u00c6\u00d0 \u00ba\u00c7\u00bd\u00c6\u00bd\u00ba\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00ce\u00be \u008c\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u0088\u00c1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(3) \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de \u00a3\u00b6\u0081 \u00cc\u00b9\u00bb\u00ce\u00bc \u00ba\u00c7\u00bd\u00c6\u00bd\u00c8\u00dc\u00bf\u00c6\u00bf\u00cc\u00b6\u0081\u00bd\u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6 \u00af\u00c8\u00ce\u00b4\u00af\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00bd\u00c6\u00bd\u00b6\u0081\u00ba\u00c9\u00d7\" \u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00bc\u00c6 \u2013\n\n(\u00a3)\u00a5\u00b4\u00c7\u00b9\u00c6\u0089\u00be\u00c6 \u00db\u00b7\u00c6\u00b6\u00c8\u00bb \u00cc\u00b9\u00bb\u00bc\u00c8\u00b8\u00c8\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00da\u00b6\u00c8\u00bb \u00cc\u00b9\u00bb\u00ce\u00bc\u00b9\u00c6\u00b9\u00b6\u00c8\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n\u00cc\u00b9\u00bb\u00bc\u00c6 \u00ba\u00c7\u00bd\u00c6\u00bd\u00ba\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c68\n\n(\u00a4) (i)\u00cc\u00b9\u00bb\u00bc\u00c6 \u00ba\u00c7\u00bd\u00c6\u00bd\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(ii)\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00ac\u00dd \u00b6\u00b8\u00c8\u00bb\u00c7\u00bc\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00af\u00c8\u00dc\u00bf\u00c6\u00bf\u008c\u00b4\u00b6\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00dd \u00b6\u00b8\u00c8\u00bb\u00c7\u00bc\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00af\u00a5\u00be\u00c6\u00be\u00c7\u00cc\u00b6\u00c7\u00c0\u00c8\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf\u008c\u00b4\u00b6\u00c6\u00d7\" \u00a3\u00ba\u00c6\u00ba\u00c7\u00bd\u00c6\u00bd\u00ba\u00c6\u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00b7\u00c8\u00af\u00c0\u00c6\u00ce\u00c1\u00dc\u00ba\u00c6\n\n\u00d2\u00b4\u00c6\u0088\u00af\u00c6\u00af\u00c7\u00b4\u00c6\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0 \u008c\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u0088\u00c1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00da\u00b6\u00c8\u00bb \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00c7\u0081\u00bd\u00c8\u00b6\u00cc\u00c0\u00c7\u0081\u00ce\u00bd \u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(4) \u00cc\u00b9\u00bb\u00bc\u00c6 \u00ba\u00c7\u00bd\u00c6\u00bd\u00ba\u00c7\u00b8\u00d7\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf \u00b9\u00c7\u00b6\u00c8\u00b6\u00c6\u00b6\u00be\u00c7\u00af\u00c7\u00d7\" \u00a3\u00be\u00c6\u00be\u00d7\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af \u00a9\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00b1\u00b4\u00c6\u00b4 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00ce\u00bf\u00b9\u00c6 \u00b9\u00bb\u00b8\u00bd\u00c6\u00bd\u00b6\u00c7\u00af\u00c6\u00d0\u00c1\u00b6\u00c7\u00af\u00c7\u00d7\u00b0 \u00a3\u00b6\u0081\u00db\u00b7\u00c6\u00b6\u00c8\u00bb \u00cc\u00b9\u00bb\u00bc\u00c8\u00be\u00c6 \u00a3\u00b6\u00bd\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u00b6\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b7\u00c6\u00d7 \u00b7\u00b4\u00c7\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00b1\u00b4\u00c6\u00b4 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c6 \u00a9\u00ce\u00c1\u00dc\u00ba\u00c6 \u00a3\u00b6\u0081 \u00da\u00b6\u00c8\u00bb \u00cc\u00b9\u00bb\u00bc\u00c6\u00cc\u00af\u00c7\u00ae\u00d5 \u00a3\u00b6\u00bd\u00c6\u00d0 \u00a9\u00b6\u00c8\u00bc\u00c7\u00af\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u00d5\u00b7\u00b4\u00c7\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n(5) \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de (2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00e2\u00af\u00c6\u00d0 \u00a5\u00b5+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u00e1\u00af\u00b6\u00c6\u00b6\u00c1\u00de\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7 \u2013\n\n(\u00a3)\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\" \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c6\u00bd\u00c1\u00c7\u00bf\u00c8\u00bb\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00d0\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u0081\u00cd\u00ba\u00be\u00c6\"\u00ab\u00ba\u00c6\u00b9\u00b6\u00c8\u00b8\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a4\u00bf\u00c7\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a4)\u00b6\u00c1\u00de\u00ce\u00af\u008a\u00df\u00bf\u00c6\u00bf\u00c1\u00bc\u00c7\u00b8 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a3\u00df\u00c1\u00be\u00bc\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00c1\u00dd\u00ba\u00c6 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c6\u00bd\u00c1\u00c7\u00bf\u00c8\u00bb\u00c7\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00d0\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u0081\u00cd\u00ba\u00be\u00c6 \u00ab\u00ba\u00c6\u00b9\u00b6\u00c8\u00b8\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a4\u00bf\u00c7\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n9\u00b0 (1) \u00ac\u00dd \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00b8\u00d7 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00d7 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00db\u00b9\u00c6\u00b9\u00d7 \u00cd\u00c1\u00ce\u00be\u00b7\u00c7\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00bf\u00c6\u00bf\u00c7\u00af \u2013"
