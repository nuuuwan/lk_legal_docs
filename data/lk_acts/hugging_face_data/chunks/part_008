    "chunk_text": "(ii)\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00b9[\u00bc\u00c6\u00c1\u00c7+\u00c6\u00af\u00b1\u00c6 \u00cc\u00b1\u00be\u008c\u00b8+\u00c6\u00af\u00bf\u00c6\" \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00df\u00bf\u00c6\u00bf \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00b9+\u00c6\u00d0\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6\u00a4\u00bf\u00c6 \u00ac\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a7\u00b4\u0081\u00b9\u00b4\u00c6\u00b4\u00b6\u00bd\u00c6\u00d0\u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00b6\u00b6\u00bd\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af \u00a7\u00b4\u0081\u00b9\u00b4\u00c6\u00b4\u00b6\u00bd\u00c6\u00d0\u0089\u00bc\u00b6\u00c8\u00b9\u00bb\u00b8\u00c7\u00af \u00a3\u00c1\u00dd\u00af\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b6\u00bc\u00d0 ;\n\n(iii)\u00cd\u00ba\u00bd\u00c6\u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u008c\u00b4\u00bb+\u00c6\u00af\u00e0\u00bf\u00c6 \u00a9\u00d7 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\u00e2\u00ba\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00af\u00b4\u00b8\u00c7\u00af\u00b9\u00c6 \u00cc\u00b9\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6\u00b9\u00b5+\u00c6\u00af\u00bf\u00c8\u0081 \u00ba\u00c9\u00bf\u00c6\u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00ce\u00af\u00b0\n\n(\u00a4) \u00cd\u00ba\u00bd\u00c6\u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u008c\u00b4\u00bb+\u00c6\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00c1\u00c0+\u00c6\u00af\u008b\u008b\u00dd\u00b7\u00c6\u00d7\u00cc\u00b9\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00b6\u00be\u00c6\u00be\u00c7\u00ba\u00be\u00c6 \u00cd\u00c1\u00de\u00c1\u00ce\u00af\u00bb\u00c7\u00af\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb \u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00bf\u00c6\" \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00bf\u00c6 \u00a9\u00ba\u00c6\u00f2\u00be+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00b8\u00cd\u00c1\u00c7 \u00a3\u00ba\u00c6\u00f2\u00be+\u00c6\u00af\u00bf\u00c8\u0081 \u008c\u00b9\u00bc+\u00c6\u00af\u00bf\u00c6\u00b0\n\n6\u00b0\u00ac\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00b5 \u00b7\u00c8\u00bc\u00be\u00c6\u00af\u00bf\u00c6 \u00b6\u00c8\u00bd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00cd\u00b7\u00bc\u00db\u00ba\u00c6 \u00f2\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00cd\u00b7\u00bc\u00db\u00ba\u00c6\u00b0\n\n7\u00b0\u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00b9+\u00c6\u00af\u00c8\u0081 \u00ba\u00c9\u00b6\u00c7\u00b8 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u0081 \u00ba\u00c9\u00d7\u00ba\u00c6 \u0089\u00bc\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00d7\u00af\u00c6\u00af\u008b\u0081\u00ba\u00c9\u00d7\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00cc\u00b6\u00c7\u00ce\u00af \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u00a5\u00bc\u00ae\u00b4\u00c7\u00c1\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u0089\u0081\u00b8\u00bc\u00c7\u00b8 \u00b9+\u00c6\u00d0\u00af\u00bf\u00c8\u0081 \u00cc\u00af\u00c7\u00ce\u00b4\u00db\u00ce\u00b8\u008c\u0081\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\" \u00db\u00bd\u00c6\u00cd\u00b9\u00c7\u00b7\u00c6\u00b6 \u00a5\u00bc\u00ae\u00d5 \u00a4\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00bf\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00db\u00b7\u00c6\u00b6\u00c8\u00bb \u0089\u00bc\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00d7\u00af\u00c6\u00af\u00be\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u0081\u00bd\u00c8\u0081 \u00ba\u00c9\u00d7\u00ba\u00c7\u00b8 \u00ac\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af \u00cc\u00af\u00c7\u00ce\u00b4 \u00db\u00ce\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b6\u00c7\u00ce\u00af \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u00a7\u00bf\u00c6\u00bf\u00b9\u0088 \u0089\u00bc\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00d0\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b6\u00c7\u00ce\u00af \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u0089\u00bc\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00d7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9+\u00c6\u00d0\u00af\u00bf\u00c6 \u00ba\u00c9\u00d7 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b6\u00c7\u00ce\u00af\" \u00aa\u00cd\u00b6\u00d9\u00ba\u00c8\u00dd\u00b9\u00c6\u0089\u0081\u00a3\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00b0\n\n8\u00b0\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00df\u00bf\u00c6\u00bf \u00a9\u00b7\u00c6\u00b6 \u00b9+\u00c6\u00d0\u00af\u00e0\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a9\u00b7\u00c6\u00b6\u00b6\u00c6\u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00b4\u0081\u00af\u00e0\u00af\u00c6\u00d0 \u00a4\u00cc\u00bf\u00c1\u00dd\u00ba\u00c6 \u00ac\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u008c\u00dd\u00b9\u00c6\u00da\u00bc\u00c8\u00ce\u00ba\u00dc\u00ce\u00b4\u00bb\u00c1\u00bc\u00c7\u00af \u00a7\u00bf\u00c6\u00bf\u00c7\u00cd\u00bc\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u008c\u00dd\u00b9\u00c6\u00da\u00bc\u00c8\u00ce\u00ba\u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a7\u00bc\u00c8\u00b6\u00c6\u00d7\u00ce\u00b4\u00bb\u00c1\u00bc\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\u00c7\u00cd\u00bc\u00c7\" \u00a3\u00b7\u00c6\u00b6\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9+\u00c6\u00d0\u00af\u00bf\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00b4\u0081\u00af\u00bf\u00c8\u0081 \u00a9\u00ae\u00b5\u00c8\u00af\u00c6\u00ce\u00af\u00dc\u00ba\u00c6 \u008c\u00c1\u00bc\u00b5\u00db\u00ba\u00c6 \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00dc\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u008c\u00dd\u00b9\u00c6\u00da\u00bc\u00c8\u00ce\u00ba \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb\u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u008c\u00c1\u00bc+\u00c6\u00af\u00e0\u00ba\u00c6\" \u00a3\u00ce\u00c1\u00bb\u00c7\u00c1\u00b8 :\u2013\n\n(\u00a3) \u00a9\u00af\u00c6\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081\u00cd\u00b9\u00c7\u00d7 \u00a3\u00d7 \u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00cd\u00b6\u00c7\u00a3\u00af\u00c6\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8 ;\n\n(\u00a4) \u00a3\u00b6\u0081\u00af\u00c9\u00c0\u00c6 \u00ac\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9+\u00c6\u00d0\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00b4\u0081\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb\u008c\u00ce\u00be ;\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6583\n\n(\u00a5) \u00a3\u00b6\u00bd\u00c6\u00af\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00af\u00c7\u00af \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb \u0089\u00bc\u00b6\u00c8\u00b9\u00bb\u0081 (\u00aa\u00cd\u00b6\u00d9\u00ba\u00c8\u00dd\u00b9\u00c6\u0089\u0081)\n\n(\u00a6) \u00a3\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00a7\u00bc\u00c8\u00ce\u00ba \u00a9\u00c1\u00c6\u00c1\u00c7\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00c7 \u00a3\u00c1\u00c6\u00c1\u00c7\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00cc\u00b9\u00bb\u00bc\u00c6\u00af\u00e0\u00ba\u00c6 \u00db\u00af\u00c1\u00bc\u00c8\u00af\u00e0\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00bf\u00b6\u00c7\u008a\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00b9+\u00c6\u00d0\u00b6\u00c7\u00bc\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00b4\u0081 \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b9\u00c6\u00b9\u00c1\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b9\u00c6\u0089\u0081\" \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00b9+\u00c6\u00d0\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u00af\u00c6 \u00af\u00b4\u0081\u00af\u00bf\u00c6\u00b0"
  },
