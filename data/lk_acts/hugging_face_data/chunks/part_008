    "chunk_text": "11.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 3 \u00c9\u00be, 4 \u00c9\u00be, 5 \u00c9\u00be, 6 \u00c9\u00be, 7 \u00c9\u00be, 8 \u00c9\u00be, 9 \u00c9\u00be,10 \u00c9\u00be, 11 \u00c9\u00be, 12 \u00c9\u00be, 13 \u00c9\u00be \u00cc\u00cd 14 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00e6\u00c7\u00bc\u00fa\u00c9\u00c8\u00e8\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ba\u00e6\u00ba\u00e0 \u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e8\u00f3\u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u009f\u00c4\u00b4 \u00cc\u00c8\u00cc\u00e0\u00c9\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4\u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00c7\u00bc \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be \u00c8\u00bc \u00a4\u00c0\u00d6\u00c4 \u00bc\u00b6\u00ef\u00c6\u00be\u00e0 \u00cd\u00d6 \u00a1\u00b6\u00a8\u00b4\u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00c7\u00bc \u00cc\u00bf\u00cd\u00e5, \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be \u00c8\u00bc \u00a4\u00c0\u00d6\u00c4\u00a8\u00e5\u00c8\u00ef\u00c6\u00be\u00e0 \u00cd\u00d6 \u00a1\u00b6\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00bc\u00b6\u00c6 \u00cc\u00cd\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c6\u00be \u00bc\u00b9\u00ea\u00c9\u008a \u00ef\u00bc\u00a8\u00b4\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00a8\u00b4 \u00c0\u00f2\u00ef\u008c\u00ca\u00d1\u00c4\u00b4 \u00be\u00f9\u00ba\u00f1\u00be\u00ea\u00a8\u00ed\u00c8\u00c2\u00c8\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9\u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00a1\u00be\u00e5\u00c9\u00c7\u00b8\u00c6\u00a8\u00f8\u00d7\u00c4 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00c2\u00c9.\n\n\u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4\u00a1\u00be\u00ea\u00c2\u00c8 \u00bc\u00fb\u00c4.\n\n\u00c9\u00e6\u00c7\u00bc\u00fa \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ba\u00e6\u00ba\u00e0\u00a8\u00e8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 24 \u00bc\u00c7\u00be \u00c0\u00d6\u00aa\u00b8\u00a8 \u00a1\u00c0\u00c7\u00e5\u00bd \u00c0\u00be\u00ba7\n\n(\u00a1) \u00a1\u00be\u00ea\u00c2\u00c8 \u00bc\u00fb\u00ef\u008a \u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00a1\u00be\u00ea\u00c2\u00c8 \u00f3\u00be\u00e0 \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e0\u00be\u008a, \u00a6\u00e0 \u00c9\u00c7\u00bc \u00cc\u00bf\u00cd\u00e5 \u00c0\u00be\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00bc\u00b9\u00ea\u00c9\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00ba\u00c9 \u00bc\n\n(\u00a1\u00e5) \u00a1\u00be\u00ea\u00c2\u00c8 \u00bc\u00fb\u00ef\u008a \u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3\u00a8\u00c7 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u2014\n\n(i) \u00c9\u00c7\u00bc \u00cc\u00bf\u00cd\u00e5 \u00a4\u00c0\u00d6\u00c4 \u00bc\u00b6\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00c0\u00be\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00c9\u00c7\u00bc \u00cc\u00bf\u00cd\u00e5 \u00c0\u00be\u00c9\u00be\u00c8\u00bc \u00a4\u00c0\u00d6\u00c4 \u00bc\u00b6\u00ef\u00c6\u00be\u00e0 \u00cd\u00ba\u00ef\u00c7\u00be\u00e0 \u00a6\u00a8\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091\u00bc\u00b6\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00c7\u00bc \u00cc\u00bf\u00cd\u00e5 \u00c0\u00be\u00c9\u00be \u00c8\u00bc \u00a4\u00c0\u00d6\u00c4\u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00ef\u00c9\u00be\u00e0 \u00cd\u00ba\u00ef\u00c7\u00be\u00e0 \u00a6\u00a8\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00bc\u00b6\u00c6 \u00cc\u00cd\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c6\u00be \u00bc\u00b9\u00ea\u00c9\u008a \u00ef\u00bc\u00a8\u00b4\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00cc\u00cd\n\n(ii) \u00c9\u00c7\u00bc \u00cc\u00bf\u00cd\u00e5 \u00a4\u00c0\u00d6\u00c4 \u00bc\u00b6\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00c0\u00be\u00c9\u00e5 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a \u00a4\u00c0\u00d6\u00c4 \u00a8\u00e5\u00c8 \u00cc\u00e9\u00c4\u00e5\u00c9\u00d5\u0097\u00ba\u00e5\u00be\u00e0\u00ba\u00c6 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00c9\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb, \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00c8\u00a8\u00e0\u00cb \u00c0\u00be\u00cc\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4\u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00c0\u00cd\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00e0 \u00bc\u00b6\u00c6 \u00cc\u00cd\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c6\u00be \u00bc\u00b9\u00ea\u00c9\u008a \u00ef\u00bc\u00a8\u00b4\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u201c\u00a1\u00be\u00ea\u00c2\u00c8 \u00bc\u00fb\u00c4\u201d \u00c6\u00be \u00ef\u00c6\u00f3\u00c4\u00b4 \u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00ef\u00c6\u00e0 (19 \u00c9\u00be\u00a1\u0093\u00a8\u00e5\u00c7\u00c6) 100 \u00c9\u00be \u00cc\u00cd 101 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8\u00e8\u00be\u00e0 \u00bc\u00e9 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00c6\u00a1\u00bc\u00e5\u00ce \u00c9\u00be \u00a1\u00ba\u00c7, \u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00ef\u00c6\u00e0 (19 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6) 101\u00a1, 103\u00c9\u00be, 104 \u00c9\u00be, 105 \u00c9\u00be, 106 \u00c9\u00be \u00cc\u00cd 107 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00c9\u00c7\u00bc\u00a8\u00b4 \u00a1\u00be\u00ea\u00c2\u00c8\u00bc\u00fb\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc \u00a1\u00bc\u00e5\u00ce\u00a8\u00c7\u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n13.(1) \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a8\u00eb\u00c4\u00be\u00e0\u00ba\u00f2\u00b8\u00c6 \u00a8\u00c7\u00be\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u0097\u00b4 \u00a6\u00e0 \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u00be\u00ea\u00c2\u00c8 \u00bc\u00fb\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00b9\u00ea\u00c9\u0095\u00be\u00e0 \u00bc\u00b9\u00ea\u00c9\u008a\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4\u00a8\u00eb\u00c4\u00be\u00e0\u00ba\u00f2\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 24 \u00bc\u00c7\u00be \u00c0\u00d6\u00aa\u00b8\u00a8 \u00a1\u00c0\u00c7\u00e5\u00bd \u00c0\u00be\u00ba8"
