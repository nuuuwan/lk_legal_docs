    "chunk_text": "368.\u00c2\u00c8 \u00c7\u00cd\u00fa\u00ba \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7.286369.\u00c9\u00e5\u00b8\u00e8\u00b0\u00c4\u00c6 \u00ef\u00be\u00e5\u00c9\u00be \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea.288370.\u00c2\u00c8 \u00c7\u00cd\u00fa\u00ba \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea \u00cd\u00e5 \u00c2\u00e6\u00bf\u00fb\u008a \u00a2\u00c9\u00ba\u00c8\u00e9\u00ef\u008a \u00a8\u00e5\u00da\u00c6 \u00c0\u0090\u00c0\u00e5\u0090\u00c6.290371.\u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e5\u00b3\u00e5.291372.\u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea \u00cd\u00e5 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00a2\u00c9\u00ba\u00c8\u00e9\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00a1\u00ba\u00f8\u00ef\u00da\u00a8 \u0097\u0093\u0097\u00bd\u00e5\u00be.292373.\u00c9\u00c7\u00b8 \u00c6\u00be\u00e5\u00bc\u00fa\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.293\n\n\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4\u00b4 \u00c0\u00f2\u00bb\u00c4 \u00a1\u00c6\u00bb\u00e5 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00cc\u00cd \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c9\u00aa\u00a8\u00f9\u008a\n\n\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4\u00b4 \u00c0\u00ec\u00da\u00c9\u00a8\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5\u00bc\u00e6\u00e4\u00c4 \u00a8\u00c7\u00be \u00a1\u00ba\u00c7\u00ba\u00eb\u00c7 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c9\u00e6\u00c7\u00bc\u00fa\n\n380.\u00a1\u00e7\u00c9\u00c7 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00c4\u00e5\u00aa\u008a\u00c9\u00c8 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00c9\u00e6\u00c7\u00bc\u00fa.304381.\u00be\u00f8\u00cc\u00e8 \u00aa\u00fa\u00b8\u00ea\u008a \u00ba\u00c2\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00c9\u00aa\u00a8\u00e9\u00c4.306382.\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c9\u00c7\u00bc\u00a8\u00e5\u00c7 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00b4 \u00cc\u00cd \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00b4 \u00be\u00b6\u00ea \u00c0\u00e6\u00c9\u00d7\u00c4.307\n\n\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00d6\u00c0\u00ec\u00c7\u00a8 \u0097\u0093\u0097\u00bd\u00e5\u00be\n\n383.\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a309384.\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00e8\u00d7\u00c4 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00c2\u00c8\u00c0\u00e5\u00be \u00f4\u00cb\u00e8\u00ba \u00ef\u00c0\u00ce\u00c5\u00d1\u00c4.310385.\u00c9\u00e5\u00da\u00ba\u00e5 \u00a1\u00e5\u00bc\u00fa\u00c6 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u00cc\u00ba\u00eb \u00a8\u00e5\u00da\u00c6\u00c6 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00a8\u00f8\u00d7\u00c4.310386.\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00a1\u00e7\u00c9\u00c7 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c2\u00c9 \u00bc\u00e6\u00be\u00ea\u008a\u00bc\u00fb\u00c4.311387.\u00cc\u00c4\u00e5\u00aa\u00c4 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00ef\u008a \u00bc\u00fb \u00a1\u00e6\u00ba\u00e6\u008a \u00ef\u00c8\u00e0\u00a9\u00be \u00c4\u00ea\u00bc\u00e0\u00bc\u00c7\u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00c8\u00e8\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4.311388.\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00c0\u00e5\u00ba\u00e0 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.311389.\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00c0\u00e5\u00ba\u00e0 \u00cd\u00e5 \u00c0\u00ba\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4.312390.\u00ef\u00be\u00e5\u00be\u00f8\u0095 \u00a1\u00e7\u00c9\u00c7 \u00a8\u00f8\u00d7\u008a \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6.313391.\u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cd\u00e5 \u00cc\u00cd\u00bc\u00e5\u00c6\u00a8\u00c6\u00fa\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00b6\u00e5\u00c8\u00c9 \u00a8\u00c8\u00e0 \u00ba\u00e6\u00c2\u00ec \u00cc\u00c3\u00e5\u00db\u00cc\u00e0\u00d1\u008a\u00c9\u00c8 \u00bc\u00fb \u00cc\u008a\u00c4\u00ba \u00c9\u00ec \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba\u00c6\u00be\u00e0.313\n\nxx\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\n\u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00cc\u00ba\u00eb \u00a1\u00ba\u00f8\u00ef\u00da\u00a8 \u00c2\u00c8\u00ba\u00c8\n\n392.\u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00cd\u00bc\u00e5\u00c6\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c3\u00fa\u00c0\u00f2\u00e5\u00c6 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00ef\u00a8\u00e5\u00b4\u00bc\u00e6\u00be\u00aa\u00e6\u00be\u00f9\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00c9\u00ec \u00cc\u00c3\u00e5 \u00db\u00cc\u00e0\u00d1\u008a.313\n\n\u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00e6\u00d7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u0097\u0093\u0097\u00bd\u00e5\u00be\n\n393.\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00e6\u00d7\u00c4 \u00c2\u00c8\u00c7\u00cd\u00fa\u00ba \u00c6\u00c6\u00fa \u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00cc\u00ba\u00eb \u00c2\u00c8\u00c6.314394.\u00a8\u00f2\u00e8\u00c6\u00e5 \u0097\u00c7\u00cd\u00fa\u00ba \u00c2\u00c9\u00b4 \u00c0\u00ba\u00e0\u00c9 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00be\u00e0 \u00a8\u00c0\u00e5 \u00cd\u00e6\u00d6\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c9.314395.\u0097\u00cc\u00ea\u00c7\u00e6\u00c9\u00e5 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00ef\u00bc\u00e0\u00c0\u00ce \u00c7\u00b0\u00c6 \u00cc\u00ba\u00eb \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.316\n\n\u00cc\u00c4\u00e5\u00aa\u008a \u00a1\u00e7\u00c9\u00c7\u00a8\u00f8\u00d7\u00ef\u008a \u00aa\u00fa\u00b8\u00ea\u00c4\n\n396.\u00cc\u00c4\u00e5\u00aa\u008a \u00a1\u00e7\u00c9\u00c7\u00a8\u00f8\u00d7\u00ef\u008a \u00aa\u00fa\u00b8\u00ea\u00c4 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4.316397.\u00cc\u00c4\u00e5\u00aa\u008a \u00a1\u00e7\u00c9\u00c7 \u00a8\u00f8\u00d7\u00ef\u008a \u00aa\u00fa\u00b8\u00ea\u00c4\u00b4 \u00cc\u00cd \u00a6\u00c4 \u00aa\u00fa\u00b8\u00ea\u00ef\u00c4\u00be\u00e0 \u00ef\u00aa\u00d1\u008a.317398.\u00a1\u00ba\u00f1\u00e5\u00c9\u00ca\u00f1 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00f8\u00d7\u00c4 \u00ba\u00cd\u00be\u008a \u00c2\u00c9.318\n\n\u00d7\u00ba\u00f8 \u00cc\u00cd \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\n\n399.\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5\u00bc\u00e6\u00e4\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb.318\n\nXIII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc - \u00a1\u00bc\u00e0\u0095\u00be\u00f8\u00cc\u00e0\u00ba\u00f2\u00e5\u00cc\u00e8\u00a8\u00c7\u00e6\u00ef\u00c9\u00e5\u00e0\n\n\u00a1\u00bc\u00e0\u0095\u00be\u00f8\u00cc\u00e0\u00ba\u00f2\u00e5\u00cc\u00e8\u00a8\u00c7\u00e6 \u00c0\u00ba\u00e0\u00a8\u00f9\u00d7\u00c4\n\n400.\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.319401.\u00a1\u00bc\u00e0\u0095\u00be\u00f8\u00cc\u00e0\u00ba\u00f2\u00e5\u00cc\u00e8\u00a8\u00c7\u00e6 \u00c0\u00ba\u00e0\u00a8\u00e8\u00d7\u00c4\u00b4 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c8\u00c6.319402.\u00a1\u00bc\u00e0\u0095\u00be\u00f8\u00cc\u00e0\u00ba\u00f2\u00e5\u00cc\u00e8\u00a8\u00c7\u00e6 \u00c0\u00ba\u00e0\u00a8\u00e8\u00d7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00bc\u00e6\u00be\u00e0\u00d1\u00c4 \u00cc\u00ee\u00b8\u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u00b4 \u00bc\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.321403.\u00a1\u00bc\u00e0\u0095\u00be\u00f8\u00cc\u00e0\u00ba\u00f2\u00e5\u00cc\u00e8\u00a8\u00c7\u00e6 \u00c0\u00ba\u00e0\u00a8\u00e8\u00d7\u00ef\u008a \u00c2\u00c8\u00c0\u00e7\u00c4.321\n\n\u00c4\u00ea\u00c8\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4 \u00cc\u00cd \u00c0\u00ba\u00e0\u00d1\u00c4 \u00cc\u00e0\u00bb\u00e8\u00c7 \u00a8\u00f8\u00d7\u00c4"
