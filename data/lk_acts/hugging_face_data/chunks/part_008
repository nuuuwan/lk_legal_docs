    "chunk_text": "(3)\u00a3\u00b6\u0081 (\u00a5) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\" \u008c\u00b4\u00bb\u00ba\u00c6 (xv)\u00ab \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :-\n\n\u201c(xiii) \u00ba\u00c8\u0081\u00b1\u00c7\u00bc\u00b6\u00c6\u00ce\u00b6 \u00c1\u00c0+\u00c6\u00d0\u00ba\u00c6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af\u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00be+\u00c6\u00ce\u00af \u00ba\u00c8\u0081\u00b1\u00c7\u00bc\u00b1\u00c6 \u00b1\u00ce\u00b9\u008a\u00b8\u00c7\u00be\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a9\u00b7\u00c6\u00b6\u00c8\u00bc\u00b6\u00c6\u00cc\u00b6\u00c7\u00d0\u00b6\u00c8 \u00a3\u00be\u00c6\u00be\u00d7\u00b1\u00c7\u00b6\u00b8\u00ba\u00c6 ;\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 14 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c617\n\n(xv)\u00b9\u00bb\u00b5\u00c8\u00af\u00bf\u00c8\u0081 \u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af\u00b9\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00c1\u00d7\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8\u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6 \u00cd\u00b7\u00bc\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00ab\u00b7\u00c6\u00b6\u00c7\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6\u00d0\u00ce\u00bd\u00bb\u00c7\u00b6 \u00af\u00c7\u00be\u00b6\u00c6\u00d7\u00af\u00c6\u00d0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00bb\u0081\u00b9\u00c7\u00b4\u00c6\u0088\u00be\u00c6 \u00a5\u00dd\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf\u00d7\u00ba\u00c7\u00b8 \u00b9\u0083\u00c1\u00ae\u0088\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00ba\u00c7\u00bd\u00c6\u00bd\u00c9\u00d5\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af\" \u00cd\u00b6\u00b1\u00c8\u00bb\u00b9\u00c6\u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00d7 \u00a4\u00ce\u00b5\u00af\u00c6\u00d0\u00e1\u008c\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ba\u00c7\u00af\u00c7\u00b5 \u0096\u00b6\u00c8\u00b9\u00c6 \u00b9\u00bb\u00b5\u00c8\u00af\u00bf\u00c6\u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00d7 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u008a\u00b8\u00c7\u00be\u00c6 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b1\u00be\u00c6\u00df\u00b9\u0088\u00bb\u00c7\u00b8 \u00ba\u00c7\u00bc\u00c6\u00af\u00c6\u00af\u00a3\u00d9\u00ba\u00b6\u00c8\u00b9\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00bc\u00b6\u00c6\u00ce\u00b6 \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b9\u00c6\u00b9\u00c1\u00bc\u00c8\u00b8\u00c7\u00be\u00c6\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9\u0083\u00c1\u00ae\u0088 ;\n\n(xvi)\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u008a\u0081 \u00a3+\u00c6\u00af\u00c9\u00af\u00c7\u00bc\u00b6\u00c6\u00d7\u00b4\u0081\" \u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b1\u00c7\u00ce\u00be\u00b1\u00c6 \u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00af\u00c6\u00af\u00c7\u00bc\u00bc\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b1\u00c7\u00ce\u00be\u00af\u00ce\u00bf \u00b7\u0096\u00b8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af\" \u00d2+\u00c6\u00af\u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\u00af\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a5\u00ce\u00b1\u00c1\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a7\u00b5\u00e2\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u008c\u00c1\u00bc\u00b5\u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00bf\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00ce\u00b4\u00bb\u00c7\u00bf+\u00c6\u00af\u00c7\u00b5\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a9\u00b7\u00c6\u00b6\u00c8\u00bc\u00b6\u00c6\u00cc\u00b6\u00c7\u00d0\u00b6\u00c8 ;\n\n(xvii)\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u008a\u0081 \u00a3+\u00c6\u00af\u00c9\u00af\u00c7\u00bc\u00b6\u00c6\u00d7\u00b4\u0081\" \u00d2+\u00c6\u00af \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\u00af\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00ce\u00b1\u00c1\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a7\u00b5\u00e2\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u008c\u00c1\u00bc\u00b5 \u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00bf\u00c8\u0081\u00af\u00c9\u00c0\u00c6\" \u00b9\u00bd\u00ce\u00c1\u00af\u00ce\u00bf \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00b8\u00a9\u00b7\u00c6\u00b6\u00c8\u00bc\u00b6\u00c6\u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\" \u00b9\u00bd\u00ce\u00c1 \u00a3\u00ce\u00b4\u00af\u00c7\u00b9\u00c6\u00da\u00b9\u00c6\u00cc\u00b9\u00c7\u00bd\u00c8\u00af\u00e0\u00ba\u00c6 \u00a3\u00ce\u00b4\u00af\u00c7\u00af\u00c6\u00d0\u00ba\u00c6 \u00af\u00dd\u008c\u00af\u00e0\u00ba\u00c6\"\u00a5\u00b8\u00b9\u00c6\u00cc\u00b9\u00dd\u00af\u00c6\u00af \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u008c\u00be+\u00c6\u00d0\u00af\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00c7\u00be\u00c6\u00b7\u00ce\u00b4\u00af\u00ce\u00bf\" \u00a9\u00dd\u00ce\u00ba\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 14 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c618\n\n\u00ba\u00c7\u00d5\u00af\u00ce\u00bf\" \u00b9\u00bd\u00ce\u00c1\u00af\u00ce\u00bf\" \u00b9\u0081\u00bd\u00c8\u00af\u00ce\u00bf\"\u00a4\u00d5\u00af\u00ce\u00bf\" \u00cc\u00b1\u00ba\u00c6\u00ba\u00bd\u00c8\u00bb\u00c7\u00d5\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8\u00cc\u00b1\u00bb\u00c6\u00b6\u00df\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u0081 \u008c\u00b7\u00c6\u00d7\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00af\u00dd\u00af\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00c1\u00bf\u00bc\u00c6\u00b6\u00c6\u00b6\u00be\u00c6 ;\n\n(xviii) \u00b7\u00c8\u00b6\u00c8 \u00a9\u0081\u00d9\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00af\u00e2\u00bf\u00c6\u00bf \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c8\u0081 \u00a3+\u00c6\u00af\u00c9\u00af\u00c7\u00bc\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00ce\u00ba\u00bb\"\u00ce\u00af\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00a3\u00ce\u00ba\u00b1\u00c6\u00d2\u00b1\u00c6\u00cc\u00b1\u00bb\u00be\u00c7\u00bf\u00bc\u00c8\u0081 \u008c\u00b6\u00b9\u00c6\u00da\u00ce\u00bc\u008a\u0081\u00ba\u00c9\u00d7 \u00b9\u00c7\u00b6\u00a3\u00b5\u00c8 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00df\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb \u00cc\u00b1\u00b9\u00c6\u00b9\u00ba\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00c7\u00be\u00c6\u00b0\u201d\u00b0\n\n10\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00a5\u00b6\u00c6\u00b6\u00c7\u00bd\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n(1)\u201c\u0089\u0081\u00c1\u00dd\u00c1\u00b8\u00c1\u00bd\u00c6\u00bd\u00c8\u00b8\u00c6 \u00c1\u00c0+\u00c6\u00af\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u0089\u0081\u00c1\u00dd\u00c1\u00b8\u00c1\u00bd\u00c6\u00bd\u00c8\u00be\u00c6\u00c1\u00c0+\u00c6\u00af\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n(2)\u008c\u00b4\u00bb\u00ba\u00c6 (vi) \u00ab \u00b7\u00c9\u00af\u00c6\u00af\u00c8\u008c\u00b4\u00c6\u00d5 \u008c\u00b4\u00bb\u00ba\u00c6 (vii)\u00ab \u008c\u00b4\u00bb\u00ba\u00c6 (vi)\u00a9\u00b8 \u00ba\u00c9\u00bf \u00a5\u00be\u00af\u00c6\u00af\u00ba\u00c8\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 ;\n\n(3)\u008c\u00b4\u00bb\u00ba\u00c6 (vi)\u00ab \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u008c\u00b4\u00bb+\u00c6\u00af\u00ce\u00bf\u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :-"
