ce\u00ba\u00cd\u00af\u00c7\u00bc\u00c7\u00d7 \u008c\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00a4\u00b6\u00b8\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00d7 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\" \u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00ce\u00bb\u00dc\u00ba\u00c6\" \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081\u00a4\u00b6\u00b8\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6 \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0 \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\"\u00a4\u00b8\u00c7\u00be\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00ce\u00bb\u00dc\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a4\u00b6\u00b8\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u008b\u00dd\u00b7\u00c6\u00d7 \u008c\u00d5\u008c\u00af\u00c6\u00d0\u00ba\u00c6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00af\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00bf\u00e2\u00af\u00c6\u00d0\u00b6\u00c6 \u00b6\u008c\u00bc\" \u00cd\u00c1\u00de \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u0081 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00ce\u00bf\u00cd\u00bb\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00ce\u00bf\u00cd\u00bb\u00c7 \u00b9\u00c7\u00b6\u00c8\u00b6\u00c6\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n(3) \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c7\u00b8\u00d7\" \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00ce\u00bb \u00ce\u00af\u008c\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0\u00a3\u00d9\u00ba\u00b6\u00c8 \u00a3\u00bf\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0 \u00db\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bf\u00c8\u00b9\u00c6\u00b9\u00b6\u0081\u00ba\u00c9\u00d7 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6\u00b7\u00c9\u00b6\u00c8\u00bb\u00c7\u00b8\u00cc\u00b6\u00b8\u00af\u00c6 \u00af\u00dd\u00d7\u00af\u00c8\u0081\u00bd\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6\u00af\u00bf\u00c6\u00a3\u00af\u00c6\u00af\u00ce\u00bd\u00dc\u00ce\u00b4\u00bb \u00a4\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u00b8\u00b6\u00c6\u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c7\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a3\u00d9\u00ba\u00b6\u00c8 \u00a3\u00bf\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00b7\u00c8\u00b9\u00b7\u00c6\u00b6\u00ce\u00b8\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00af \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b7\u00c8\u00bb\u00b6\u00c8\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u008c\u00b6\u00c8\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a5\u00b7\u00c6\u00b6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00c1\u00de \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00ce\u00bb\u00dc\u00ba\u00c6 \u00a4\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0"
