    "chunk_text": "\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00cd\u00e5 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9 \u00cc\u00cd \u00a6\u00cd\u00fa \u00c0\u00e8\u00b4\u00c0\u00ba\u00e0 \u00a2\u00c8\u00e0\u00f5\u008a \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00a8\u00ef\u00c7\u00be \u00c6\u008a \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8, \u00ae\u00a8\u00f2\u00ef\u00c8\u00e0\u00a9\u00c6\u00a8\u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ae\u00e5\u00c7\u00a8 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8, \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ee\u00b8 \u00c0\u00ba\u00f2\u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00d1\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00c9\u00e5 \u0095\u00c8 \u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00c4\u00cd\u00b0\u00be\u00c6\u00e5\u00b4 \u00c6\u008a\u00a1\u00e5\u00c7\u00e5\u00bd\u00be\u00c6\u00a8\u00e0 \u00a1\u00b6\u00e2\u00aa\u00eb\u00c9 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00be\u008a, \u00a6\u00e0 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4, \u00ae\u00a8\u00f2\u00ef\u00c8\u00e0\u00a9\u00c6 \u00ef\u00cd\u00e5\u00e0\u00c0\u00f2\u00ae\u00e5\u00c7\u00a8 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ce \u00a8\u00f8\u00d7\u00c4 \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a2\u00cd\u00ba\u00f8\u00be\u00e0\u00c9\u00ec \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00f8\u00be\u00e0 \u00c9\u00ce\u00a8\u00e0\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u00c6\u00fa \u00cc\u00c8\u00a8\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6; \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00ef\u00c8\u00cc \u00ef\u00ba\u00e0\u00c7\u00e6\u008a \u00aa\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n38.(1) \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ee\u00b8 \u00c0\u00ba\u00f2 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00d1\u00c4\u00b4\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00a1\u00e5\u00c7\u00e5\u00bd\u00be\u00e5 \u00ef\u00a8\u00ef\u00c7\u00be \u00cc\u00cd \u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c\u00c6\u00c6\u00fa \u00a4\u00bc\u00e0\u00ef\u00bc\u00e0\u00ca\u00fa\u00ba \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 :\u2014\n\n(\u00a1\u00e5)(\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00cd\u00fa \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00d6\u00bc\u00fa \u00a6\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00bc\u00fb\u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9 \u00cc\u00cd \u00a6\u00c6 \u00a2\u00c8\u00e0\u00c8\u00e5 \u00a1\u00cc\u00e0\u00a8\u00c7 \u00ef\u00aa\u00be \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00c2\u00c9 \u00cc\u00bf\u00ca\u00be\u00e0\u00c9\u00be \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00ef\u00c6\u00cd\u00fa \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a\u0095\u00cc,\n\n\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a8\u00b6 \u00a8\u00c7\u0095\u00be\u00e0 \u00c6\u008a \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00cc\u00c4\u00e5\u00aa\u00c4 \u00cc\u00cd \u00a6\u00c6 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00cd\u00fa \u00c8\u00e5\u00bc\u00e6\u00be \u00bc\u00e6\u00be\u00c4 \u00c0\u00e5\u00da\u00ca\u00e0\u00c9\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00be \u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c4 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00a8\u00c7\u00be\u00a1\u00ba\u00c7, \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4, \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c8\u00a8\u00e0\u00cb \u00ef\u00bc\u00a8\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00bc\u00b6\u00c6\u00a8\u00b4 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u201c\u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00e5\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00c6\u00b4\u00a2\u00e2\u00d4\u00ef\u00be\u00e0\u00c7\u00e6\u00c9\u00c7\u00c6\u00a8\u00eb, \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb, \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00a8\u00eb,\u00aa\u00b8\u00a8\u00e5\u0093\u00a8\u00e5\u00d7\u00c9\u00c7\u00c6\u00a8\u00eb \u00cc\u00cd \u00cc\u00c4\u00e5\u00be \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c9\u00be\u00ba\u00e0\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00bc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c.\n\n\u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0\u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4\u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba\u00a1\u00c9\u00ca\u00f1 \u00c2\u00c9.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba32\n\n39.(1) \u00c6\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0, \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c2\u00e6\u00e2\u00a8\u00eb\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00ef\u00c8\u00cc, \u00a6\u00e0\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ee\u00b8 \u00c0\u00ba\u00f2 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa \u00d1\u00c4\u00b4\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00a1\u00e5\u00c7\u00e5\u00bd\u00be\u00c6 \u00ef\u00a8\u00ef\u00c7\u00be \u00c6\u008a \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8 \u00a6\u00cd\u00fa \u00be\u00c4\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00e8\u008d\u00ba \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00bc\u00fb \u00ba\u00f8\u00ef\u0089 \u00be\u008a \u0095\u00cc\u00cc\u00cd \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00ef\u00c6\u00cd\u00fa \u00c0\u00e8\u00b4\u00c0\u00ba\u00a8\u00e0 \u00c3\u00e5\u00c7 \u00bc\u00fb\u00c4\u00b4\u00ef\u00c0\u00c7 \u00a6\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00a1\u00cc\u00e0\u00a8\u00c7 \u00ef\u00aa\u00be \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00be\u008a \u0095\u00cc, \u00a6\u00e0\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a6\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00ef\u00c6\u00cd\u00fa \u00be\u008a\u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a6\u00cd\u00fa\u00be\u00c4 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00bc\u00fb \u00ba\u00f8\u009f\u00ef\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00c9\u00be\u00f8\u00cc\u00e5\u00c4 \u00c0\u00c4\u00b8\u00a8\u00e0, \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4\u00b4 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00c2\u00c8\u00c6 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
