    "chunk_text": "\u00c6\u008a \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00e8\u00a8 \u0097\u0093 \u00a8\u00f2\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 \u00bc\u00e6\u00be\u00ea\u00c9\u00ba\u00e0\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00be\u00e9\u00ba\u00f1\u00be\u00ea\u00a8\u00ed\u00c8 \u00a1\u00c9\u00cc\u00c7\u00c6\u00a8\u00e0\u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00c7, \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c8\u00a8\u00e0\u00cb\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00c8\u00a8\u00e0\u00cb \u00ba\u00eb\u00be\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00e5\u00cc \u00cd\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3\u00ba\u00eb\u00be\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00e0 \u00bc\u00b6\u00c6 \u00cc\u00cd \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4 \u00c6\u00be \u00bc\u00b9\u00ea\u00c9\u008a \u00ef\u00bc\u00a8\u00b4\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00be\u00f9\u00ba\u00f8 \u0097\u00ef\u00c7\u00e5\u00e0\u009e \u00ef\u00c8\u00cc\u00bc\u00ba\u00e0\u00ba \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00c9\u00c7\u00bc\u00a8\u00e0 \u00c2\u00c9.\n\n\u00c9\u00c7\u00bc\u00a8\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u00be\u00f9\u00ba\u00f8\u0097\u00ef\u00c7\u00e5\u00e0\u009e \u00a4\u00c0\u00a8\u00f2\u00c4\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00c2\u00c9.\n\n2007 \u00a1\u00e2\u00a8 24 \u00bc\u00c7\u00be \u00c0\u00d6\u00aa\u00b8\u00a8 \u00a1\u00c0\u00c7\u00e5\u00bd \u00c0\u00be\u00ba6\n\n(\u00a1) \u00c0\u00d6\u00aa\u00b8\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c9\u00e6\u00b6\u00cc\u00b4\u00cd\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00c6\u008a \u00c0\u00d6\u00aa\u00b8\u00a8\u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 ;\n\n(\u00a1\u00e5) \u00c0\u00d6\u00aa\u00b8\u00a8\u00c6\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00b4 \u00c0\u00f2\u00ef\u008c\u00ca\u00d1\u00ef\u008a \u00cd\u00e6\u00a8\u00f8\u00c6\u00e5\u00c9\u00c0\u00c9\u00ba\u00f8\u00be \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c4\u00ea\u00c7\u00c0\u00bc\u00c6\u00a8\u00e0, \u00c0\u00f2\u00ef\u008c\u00ca \u00ef\u00a8\u00e0\u00ba\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cd\u00e5\u00cc\u00c4\u00e5\u00be \u00bc\u00ba\u00e0\u00ba,\n\n\u00be\u00e9\u00ba\u00f1\u00be\u00ea\u00a8\u00ed\u00c8 \u00a1\u00c9\u00cc\u00c7\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00c3\u00e5\u0097\u00ba\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be,\u0097\u00a8\u00eb\u00b8\u00be, \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00c7\u00be, \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be, \u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00a8\u00c7\u00be,\u00ef\u00c2\u00bc\u00e5\u00cd\u00d6\u00be \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00cc\u00c0\u00c6\u00e5 \u00ef\u00bc\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c9\u00c7\u00bc\u00a8\u00b4\u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c8\u00a8\u00e0\u00cb\u00c6\u00a8\u00b4\u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c8\u00a8\u00e0\u00cb \u00ba\u00eb\u00be\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00e5\u00cc \u00cd\u00c6\u00a8\u00b4\u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ba\u00eb\u00be\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00e0 \u00bc\u00b6\u00c6 \u00cc\u00cd\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c6\u00be \u00bc\u00b9\u00ea\u00c9\u008a \u00ef\u00bc\u00a8\u00b4\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n10.\u00c0\u00d6\u00aa\u00b8\u00a8\u00c6\u00a8\u00e0 \u00c4\u00e5\u00da\u00aa\u00ef\u00c6\u00be\u00e0 \u00cc\u00c0\u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00a8\u00b4\u00c0\u00f2\u00ef\u008c\u00ca\u00d1\u00c4\u00b4 \u00cd\u00e6\u00a8\u00f8\u00a8\u00c7\u00c9\u0095\u00be\u00e0 \u00ba\u00c4\u00e5\u00b4 \u00c0\u00c9\u00c7\u00e5 \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6, \u00c6\u008a\u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00a1\u0093\u00a8\u00e5\u00d6 \u00c2\u00c8\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e2\u00d4\u00ba\u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00a8\u00b6\u00a8\u00c7\u0095\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00e5\u00c9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00c8\u00a8\u00e0\u00cb\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c8\u00a8\u00e0\u00cb \u00ba\u00eb\u00be\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0\u00c4\u00e5\u00cc \u00cd\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ba\u00eb\u00be\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\u00a6\u00e0 \u00bc\u00b6\u00c6 \u00cc\u00cd \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c6\u00be \u00bc\u00b9\u00ea\u00c9\u008a \u00ef\u00bc\u00a8\u00b4\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n11.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 3 \u00c9\u00be, 4 \u00c9\u00be, 5 \u00c9\u00be, 6 \u00c9\u00be, 7 \u00c9\u00be, 8 \u00c9\u00be, 9 \u00c9\u00be,10 \u00c9\u00be, 11 \u00c9\u00be, 12 \u00c9\u00be, 13 \u00c9\u00be \u00cc\u00cd 14 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00e6\u00c7\u00bc\u00fa\u00c9\u00c8\u00e8\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ba\u00e6\u00ba\u00e0 \u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e8\u00f3\u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u009f\u00c4\u00b4 \u00cc\u00c8\u00cc\u00e0\u00c9\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4\u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00c7\u00bc \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be \u00c8\u00bc \u00a4\u00c0\u00d6\u00c4 \u00bc\u00b6\u00ef\u00c6\u00be\u00e0 \u00cd\u00d6 \u00a1\u00b6\u00a8\u00b4\u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00c7\u00bc \u00cc\u00bf\u00cd\u00e5, \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be \u00c8\u00bc \u00a4\u00c0\u00d6\u00c4\u00a8\u00e5\u00c8\u00ef\u00c6\u00be\u00e0 \u00cd\u00d6 \u00a1\u00b6\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00bc\u00b6\u00c6 \u00cc\u00cd\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c6\u00be \u00bc\u00b9\u00ea\u00c9\u008a \u00ef\u00bc\u00a8\u00b4\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
