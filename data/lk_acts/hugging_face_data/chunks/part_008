    "chunk_text": "(i)\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0 \u00ef\u00bc\u00ef\u00bc\u00be\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 ;\n\n\u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00ef\u00c6\u00e0\u00c0\u00e8\u00b4\u00c0\u00ba\u00a8\u00e0 \u00c8\u00c2\u00e5\u00aa\u00e6\u00be\u00f9\u00c4\u00b4\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00b4\u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c2\u00c9.\n\n\u00aa\u00fa\u0097\u00cc\u00ea\u008a\u00c9\u00c8\u00b4\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba16\n\n(ii)\u00a6\u00a8\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00c0\u00c4\u00b8\u00a8\u00e0 \u00cc\u00e8\u0090\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a, \u00a6\u00e0\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 ;\n\n(iv)\u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00a6\u00a8\u00e0 \u00a1\u00e6\u00ef\u00b4\u00e5\u00e0\u00da\u00be\u00f8\u00c2\u00c8\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00c9\u00e6\u0091 \u00a1\u00e6\u00ef\u00b4\u00e5\u00e0\u00da\u00be\u00f8 \u00c2\u00c8\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00aa\u00b8\u00be\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0,\n\n\u00a1\u00ba\u00e0\u00cc\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00ef\u00be\u00e5\u00ba\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00bc\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(\u00a1\u00e5)\u00c6\u008a \u00c2\u00e6\u00bf\u00fb\u00c4\u00a8\u00b4 \u00cc\u00e0\u00c9\u00e5\u00c3\u00e5\u0097\u00a8 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00be\u00ea\u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a, \u00a6\u00e0 \u00c2\u00e6\u00bf\u00fb\u00c4 \u00c8\u00e8\u00c6\u0097\u00c8\u00e0\u00c8\u00a8\u00f8\u00be\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9\u00b4 \u00cd\u00e5 \u00a6\u00e0\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00ba\u00e0\u00cc\u00be\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9\u00b4 \u00be\u00f9\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00a1\u00e6\u00ba\u00e0\u00be\u008a \u00a6\u00e0 \u00c2\u00e6\u00bf\u00fb\u00c4\u00b4, \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e2\u00d4\u00ba \u00a1\u0093\u00a8\u00e5\u00c7\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00c7\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00ba\u00e0\u00cc\u00be\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u00cc\u00c4\u00e5\u00aa\u00c4 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c8\u00e8\u00c6\u0097\u00c8\u00e0\u00c8\u00a8\u00f8\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6 ;\n\n(\u00a1\u00e6)\u00c6\u008a \u00c2\u00e6\u00bf\u00fb\u00c4\u00a8\u00b4 \u00cc\u00e0\u00c9\u00e5\u00c3\u00e5\u0097\u00a8 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00be\u00ea\u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a, \u00c8\u00e8\u00c6\u0097\u00c8\u00e0\u00c8\u00a8\u00f8\u00be\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00ef\u00be\u00e5\u00c9\u00be \u00c2\u00c9\u00b4 \u00be\u00f9\u00ba\u00f8\u00ef\u00c6\u00be\u00e0\u00be\u00f8\u00c6\u00c4 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00be\u008a, \u00a6\u00e0 \u00c2\u00e6\u00bf\u00fb\u00c4\u00b4 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e2\u00d4\u00ba\u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00c7\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c8\u00e8\u00c6\u0097\u00c8\u00e0\u00c8\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u008e\u00a8\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be, \u00c6\u008a \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c9\u00be\u00ba\u00e0 \u00c2\u00e6\u00bf\u00fb\u00c4\u00a8\u00b4\u2014\n\n(\u00a1)\u00a6\u00e0 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00bf\u00fb\u00c4\u00b4 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00bc\u00fb \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00ec\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0\u00ef\u00be\u00e5\u00c9\u00ec\u00ef\u00c6\u00e0 \u00c9\u00ea\u00c9 \u00bc ; \u00a6\u00ef\u00cc\u00e0\u00c4\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00bf\u00fb\u00c4 \u00c0\u00e5\u00c8\u00be\u00c6 \u00ef\u00a8\u00ef\u00c7\u00be \u00be\u00f9\u00ba\u00f8\u00c6 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c\u00be\u00f9\u00ba\u00f8\u00c6 \u00c9\u00ea\u00c9 \u00bc \u00ef\u00be\u00e5\u00c9\u00ec\u00c9 \u00bc,\n\n\u00a1\u00bc\u00e5\u00ce \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba17\n\n(3) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a\u00be\u00ef\u00c4\u00cd\u00fa \u00c6\u008a \u00c9\u00ae\u00be\u00c6\u00a8 \u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u00ef\u00c6\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba\u00e0 \u00ef\u00a8\u0090 \u00ef\u00c6\u00f3\u00c4\u00a8\u00e0 \u00c3\u00e5\u0097\u00ba\u00a8\u00f8\u00d7\u00c4 \u00ef\u00be\u00e5\u00c4\u00aa \u00c6\u00c9\u00be \u00cc\u00ea\u00dd \u00be\u008a \u0095\u00cc, \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00ef\u00a8\u0090\u00ef\u00c6\u00f3\u00c4 \u00c3\u00e5\u0097\u00ba \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n20.(1) \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0, \u00a6\u00cd\u00fa \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00c6\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9, 19 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c8\u00e8\u00c6\u00e5 \u00a1\u00ba\u00e0\u00cc\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00c8\u00e8\u00c6\u0097\u00c8\u00e0\u00c8\u00a8\u00f8\u00be\u00e0 \u00c9\u00ec \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0, \u00ef\u00c0\u00e5\u00f3\u00ef\u008c \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00a8\u00e5\u00c7\u00b8\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00a1\u00e6\u00ef\u00b4\u00e5\u00e0\u00da\u00be\u00f8 \u00c2\u00c8\u00a8\u00c7\u00e6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u00cc\u00bf\u00cd\u00be\u00e0 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00a8\u00c7\u00be\u00c8\u00bc \u00a1\u00e6\u00ef\u00b4\u00e5\u00e0\u00da\u00be\u00f8 \u00c2\u00c8\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0, \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cb\u00c6\u00ef\u00c6\u00cd\u00fa \u00a1\u00be\u00ea\u00aa\u00c4\u00f1\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
