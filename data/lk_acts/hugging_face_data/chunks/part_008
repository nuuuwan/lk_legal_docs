    "chunk_text": "(ii) 1971 \u00a1\u00e2\u00a8 47 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8\u008e\u00ba\u00f2\u00c0\u00b4 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8\u008e\u00ba\u00f2\u00c0\u00b4 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0, \u0091\u00d4\u00b4\u00c8\u00e0\u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00c6, \u0091\u00d4\u00b4\u00c8\u00e0 \u00c0\u00f2\u00bc\u00da\u00ca\u00be \u00a8\u00f2\u00c4\u00cc\u00cd \u00ef\u00b6\u00e5\u00c8\u00e0\u0094 \u00ca\u0089\u00bc \u00c0\u00bc\u00e0\u00bd\u00ba\u00e8\u00c9\u00c8\u00e8\u00be\u00e0\u00cc\u00c4\u00be\u00e0\u0097\u00ba \u00cc\u00e8\u00be\u00c4\u00e5\u00ca\u00e5\u00c8\u00e5\u00c9\u00a8\u00e0 \u00c2\u00c9\u00b4\u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec \u00bc,\u00cc\u00e8\u00be\u00c4\u00e5\u00ca\u00e5\u00c8\u00e5\u00c9\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n(\u00a1\u00e5) \u201c\u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00ce \u00cc\u00e8\u00be\u00c4\u00e5\u00ca\u00e5\u00c8\u00e5\u00c9\u201d\u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 :\u2014\n\n(i) 2007 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be\u00b4\u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00cc\u00e8\u00be\u00c4\u00e5\u00c7\u00e7\u00c0\u00e9 \u008e\u00ba\u00f2\u00c0\u00b4\u00c0\u00f2\u00bc\u00da\u00ca\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00c7\u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc ;\n\n2007 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba8\n\n(iii) 1971 \u00a1\u00e2\u00a8 47 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00b0\u00e5\u00ba\u00f8\u00a8 \u008e\u00ba\u00f2\u00c0\u00b4 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u00c0\u00be\u00ba\u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00b0\u00e5\u00ba\u00f8\u00a8 \u008e\u00ba\u00f2\u00c0\u00b4 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0,2007 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0\u00a2\u00be\u00e0\u00c0\u00cc\u00ea\u00c9 \u0091\u00d4\u00b4\u00c8\u00e0 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00c6,\u0091\u00d4\u00b4\u00c8\u00e0 \u00c0\u00f2\u00bc\u00da\u00ca\u00be \u00a8\u00f2\u00c4 \u00cc\u00cd \u00ef\u00b6\u00e5\u00c8\u00e0\u0094\u00ca\u0089\u00bc \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c9\u00c8\u00e8\u00be\u00e0 \u00cc\u00c4\u00be\u00e0\u0097\u00ba\u00cc\u00e8\u00be\u00c4\u00e5\u00ca\u00e5\u00c8\u00e5\u00c9\u00a8\u00e0 \u00c2\u00c9\u00b4 \u00cc\u00cd\u00ba\u00f8\u00a8\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec \u00bc,.\n\n\u00cc\u00e8\u00be\u00c4\u00e5\u00ca\u00e5\u00c8\u00e5\u00c9\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n24\u00a1\u00e5. (1) (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00ba\u00cd\u00e6\u00c7 \u00bc\u00c4\u00e5 \u00ba\u00f8\u009f \u00be\u00e6\u00c9\u00ba \u0097\u00c9\u00ee\u00ba \u00a8\u00c7\u00be \u00c8\u00bc\u00c6\u008a \u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00ca\u00e5\u00c8\u00e5\u00c9\u00a8\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 3\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 (\u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00c9\u00ba\u00e0\u00a8\u008a \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c8\u00c2\u00be \u00c8\u00e5\u00c3 \u00ef\u00be\u00e5\u00c9\u00be)\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00c2\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u008a, 2011\u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 31 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00be \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5\u201c\u00a1\u00ba\u00cd\u00e6\u00c7 \u00bc\u00c4\u00e5 \u00ba\u00f8\u009f \u00be\u00e6\u00c9\u00ba \u0097\u00c9\u00ee\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a\u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00ca\u00e5\u00c8\u00e5\u00c9\u00a8\u00e0\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 :\u2014\n\n(\u00a1) \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00c3\u00e5\u00b8\u00e0\u00b6 \u00ef\u00cd\u00e5\u00e0 \u00f7\u00c9\u00f1 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00f8\u00d7\u00ef\u00c4\u00cd\u00fa \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e7\u00bc\u00fb\u00ef\u00c4\u00cd\u00fa \u00be\u00f8\u00c7\u00ba\u00c9 \u00c9\u00ec\u00a6\u00ef\u00cd\u00ba\u00e0 2006 \u00ef\u00be\u00e5\u00c9\u00e6\u008a\u00c2\u00da \u00c4\u00cc 16 \u00c9\u00be\u00bc\u00fa\u00be\u00b4 \u00c0\u00ec\u00da\u00c9\u00ef\u00c6\u00be\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ba\u00eb\u00be\u00a8\u00b4\u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00a1\u00a9\u00b8\u00e0\u00b6 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00a6\u00c4\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00ef\u00c6\u00e0 \u00be\u00f8\u00c7\u00ba\u00c9 \u00ef\u00be\u00e5\u00cc\u00e8\u0090; \u00cc\u00cd\n\n(\u00a1\u00e5) 2008 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be\u00b4\u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00a6\u00c4 \u00c3\u00e5\u00b8\u00e0\u00b6\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00f7\u00c9\u00f1\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c3\u00e5\u00b8\u00e0\u00b6\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00f7\u00c9\u00f1\u00c6\u00a8\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e7\u00bc\u00fb\u00c4\u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00c7\u00be,\n\n\u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba \u00ca\u00e5\u00c8\u00e5\u00c9\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\u201d.\n\n\u00a1\u00ba\u00cd\u00e6\u00c7 \u00bc\u00c4\u00e5 \u00ba\u00f8\u00c2\u00ec\u00a8\u00da\u00c4\u00e5\u00be\u00e0\u00ba\u00ca\u00e5\u00c8\u00e5\u00c9\u00a8\u00e0\u00be\u00e6\u00c9\u00ba \u00a1\u00e5\u00c7\u008a\u00c3\u00ef\u00a8\u00e5\u00b4\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a1\u00e5\u00c7\u008a\u00c3\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a4\u00c0\u00c6\u00be\u00c8\u00e5\u00c3 \u00cc\u00cd\u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0\u00a8\u00f8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba9\n\n10.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 25 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1) \u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6\u00ef\u00c9\u00be\u00ea\u00c9\u00b4, \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014"
