    "chunk_text": "(2) \u00a2\u00cd\u00ba \u00a8\u00f9 \u00c0\u00be\u00ef\u00ba\u00e0 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00c0\u00e5\u00f3 \u00c7\u00e5\u00b0\u00f1 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c7\u00b4\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a2\u00cd\u00ba \u00a8\u00f9 \u00c0\u00be\u00ba \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00ec\u00ef\u00c0\u00e5\u00f3 \u00c7\u00e5\u00b0\u00f1 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c7\u00b4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00c7\u00b4\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4,\u00cc\u008a\u00c4\u00ea\u00ba\u00f8 \u00c7\u00b4\u00a8\u00b4 \u00c6\u008a\u00ba\u00e5\u00a8\u00e0 \u00c9\u00ec \u00cc\u00e8\u00c6\u00f5 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00bc\u00fb\u00c4 (\u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00cd\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca \u00c8\u00c2\u00e5\u00aa\u00e6\u00be\u00f9\u00c4, \u00cc\u00e8\u00ba\u00e5\u00cc\u00e8 \u00c3\u00e5\u00c7\u00bc\u00fb\u00c4 \u00cd\u00e5 \u00ef\u00cc\u00e5\u00e0\u00bc\u00fa\u00cc\u00e8 \u00a8\u00f8\u00d7\u00c4 \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9) \u00a2\u00b4\u00ea\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u00a1\u00c9\u00ca\u00f1 \u00c9\u00be \u00ba\u00e5\u00a8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u00e8\u00c6\u00f5 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00a2\u00c8\u00e0\u00c8\u00e5\u00cc\u00e8\u009b\u00c4 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a8\u00e5\u00da\u00c6\u00c6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00cc\u008a\u00c4\u00ea\u00ba\u00f8 \u00c7\u00b4\u00a8\u00b4 \u00a1\u00e5\u00bd\u00e5\u00c7\u00bc\u00fb\u00c4, \u00cc\u00ea\u00f3\u00cc\u00ea \u00c6\u00c6\u00fa \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u00cc\u00e8\u00ba\u00be \u00c6\u008a\u00be\u00f8\u00c6\u00c4 \u00cd\u00e5 \u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n37.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n38.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00c0\u00bc \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00be\u00f1\u00e5\u00da\u00bb\u00c6\u00a8\u00e0 \u00a1\u00c9\u00ca\u00f1 \u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0\u0095\u00cc \u2014\n\n\u201c\u00c0\u00d6\u00aa\u00b8\u00a8\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00cc\u00e6\u00a8\u00cc\u00e9\u00ef\u008a \u00cd\u00e6\u00a8\u00f8\u00c6\u00e5\u00c9 \u00bc\u00c7\u00be\u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c4\u00e5\u00be \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00c0\u00d6\u00aa\u00b8\u00a8 \u00bc\u00ba\u00e0\u00ba \u00a1\u00e5\u00ae\u00c6\u00be \u00c4\u00e5\u00bd\u00f1\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8 \u00a4\u00c0\u00a8\u00e5\u00c7\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00be\u00e6\u00ba\u00f8\u00c9\u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00be\u00e6\u00c9\u00ba \u00bc\u00e6\u00a8\u00e0\u00d1\u00ef\u008a \u00cc\u00e5\u00c4\u00e5\u00da\u00bb\u00c6\u00a8\u00e0 \u00bc\u00a8\u00e0\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00a8\u00f8\u00cc\u00e8\u00c6\u008a\u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00c0\u00d6\u00aa\u00b8\u00a8 \u00c9\u00e6\u00b6 \u00cc\u00b4\u00cd\u00be\u00e0\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c0\u00d6\u00aa\u00b8\u00a8\u00c6\u00a8\u00b4 \u00a8\u00f8\u00c6\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c4\u00e5\u00bd\u00f1\u00c6\u00a8\u00f8\u00be\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cd\u00e6\u00a8\u00f8 \u00a8\u00c7\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec,\u00c0\u00d6\u00aa\u00b8\u00a8\u00c6\u00b4 \u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba \u00a8\u00e5\u00da\u00c6\u00c6\u00a8\u00e0 \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c6\u00b4\u00ce\u00ad\u00e5\u00d1\u00c4\u00b4 \u00cc\u00c8\u00cc\u00e0\u00c9\u00be \u00c9\u00ae\u00be\u00c9\u00c8\u00e8\u00be\u00e0, \u00ef\u00a8\u00e0\u00ba\u00c9\u00c8\u00e8\u00be\u00e0, \u00ef\u00c6\u00f3\u008a\u00c9\u00c8\u00e8\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00a4\u00c0\u00ef\u00bc\u00e0\u00ca\u00be \u00c4\u00e5\u00c8\u00e5\u00c9\u00a8\u00e0\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5\u00c0\u00e5\u00b5\u00c6 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00a1\u00da\u00bb\u00be\u00f8\u00c7\u00e7\u00c0\u00be\u00c6.\n\n\u00a4\u00bc\u00da\u00c0\u00be \u00be\u00f9\u00ba\u00f8\u00ef\u00c6\u00e0\u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00ef\u008a\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00c9\u00e6\u00c7\u00bc\u00fa\u00ef\u00bc\u00e0\u00ca\u00c0\u00e5\u00c8\u00be \u00c9\u00e6\u00c7\u00bc\u00fa\u00a1\u00e5\u00bc\u00fa\u00c6 \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n2007 \u00a1\u00e2\u00a8 24 \u00bc\u00c7\u00be \u00c0\u00d6\u00aa\u00b8\u00a8 \u00a1\u00c0\u00c7\u00e5\u00bd \u00c0\u00be\u00ba20\n\n\u201c\u00c0\u00d6\u00aa\u00b8\u00a8 \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c0\u00d6\u00aa\u00b8\u00a8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00e0\u00ba\u00da\u00b0\u00e5\u00c8\u00c6\u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00a1\u00be\u00e0\u00ba\u00da \u00cc\u008a\u00c2\u00be\u00e0\u0093\u00ba \u00c0\u00d6\u00aa\u00b8\u00a8 \u00cc\u00c4\u00ec\u00cd\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0\u201d \u00c6\u00be\u00e0\u00be\u00b4, \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ;\n\n\u201c\u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00ef\u00c8\u00e0\u00a9\u00be\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00a8\u00f2\u00c4\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00a8\u00e0\u00cb\u00ea\u00f7\u00c0\u00b4\u00c8 (\u00c4\u00c6\u00fa\u00ef\u00a8\u00f2\u00e5\u00e0\u00cf\u00e8\u00c8\u00e0\u008a) \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00a1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00e0\u00a8\u00f2\u00c4\u00c6\u00a8\u00f8\u00be\u00e0 \u00a4\u00ba\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc, \u00a1\u00e5\u00ae\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc, \u00c8\u00c2\u00e5\u00aa\u00ba\u00e0\u00ef\u00cd\u00e5\u00e0 \u00c6\u00c9\u00be \u00c8\u00bc \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6, \u00c9\u00e5\u00da\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00ba\u00e0\u00ba \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00a8\u00da\u00ba\u00c9\u00f1\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c0\u00d6\u00aa\u00b8\u00a8\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9, \u00c0\u00d6\u00aa\u00b8\u00a8\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00a6\u00e0 \u00ba\u00eb\u00ce\u00e8\u00be\u00e0 \u00ba\u00da\u00a8\u00be\u00c6, \u00a1\u00e2\u00a8 \u00aa\u00b8\u00e8\u00ba\u00c4\u00c6 \u00c9\u00e6\u00b6 \u00cc\u00b4\u00cd\u00be\u00a8\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6\u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c4, \u00c4\u00a8\u00e5 \u00bc\u00e6\u00e4\u00c4, \u00aa\u00c2\u00b6\u00e5 \u00a8\u00f8\u00d7\u00c4,\u00a1\u00e5\u00ae\u00be\u00c6 \u00be\u00e6\u00c9\u00ba \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00cd \u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c;"
