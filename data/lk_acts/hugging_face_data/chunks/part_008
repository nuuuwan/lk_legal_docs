    "chunk_text": "349\u00b0 \u00ac\u00c0\u00c8\u00b9\u00c6\u00cd\u00b9\u00c7\u00b8\u00c8\u0081 \u00a8\u00b6\u00c8\u00bb\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b4 \u00ac\u00d5\u00af\u00c6\u00d0\u00b6\u008b\u00be\u00c6 \u00db\u00ce\u00bd\u00bb\u00c7\u00af\u00a7\u00b6\u00c1\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00be\u00c6\u00be\u00c7\u00b1\u00c6 \u00cc\u00b1\u00be\u00e2\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00e0\u00ba\u00c6\" \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00e0\u00ba\u00c6\u00cc\u00b1\u00be\u00e2\u00af\u00e0\u00ba\u00c6 \u00cd\u00c1\u00de \u00a9\u00be\u00c6\u00be\u00c7 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00cd\u00ba\u00be\u00c7\u00b8\u00db\u00b7\u00c6\u00d7\u00bc\u00c8\u00ce\u00ba\u00bb\u00c7\u00af \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a5\u00dd\u00b9\u00c6\u00da\u00b1\u00c6 \u00cc\u00b1\u00c7\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b8\u00c1\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(IV) \u00ac\u00d5\u00af\u00c6\u00d0\u00b6\u00be\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00ba\u00bd\u00c6\u00b9\u00c7\u00bc\u00c6\u00ce\u00c1\u00af\u00c6\u00d0 \u00a3\u00ce\u00ba\u00b7\u00c6\u00b6\u00d7\n\n351\u00b0 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de \u00b6\u0081\u00b8\u00c8\u00b1\u00c6\u00ce\u00b1\u00bb\u00c7\u00b8 \u00ac\u00d5\u00af\u00c6\u00af\u00df\u00af\u00c6\u00af\u00c7\u00b8\u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00cc\u00ba\u00c7\u0081\u00ce\u00bd \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00bd\u00c8\u008a\u00dd\u00af\u00c6\u00d0\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7 \u00b6\u0081\u00b8\u00c8\u00b1\u00c6\u00ce\u00b1\u00bb\u00c7\u00b8\u00ac\u00d5\u00af\u00c6\u00d0\u00b6\u00