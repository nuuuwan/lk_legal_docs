    "chunk_text": "\u00aa\u00c0\u00c7\u00c1\u00d7 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5(\u0089\u00bc\u00c8\u00e2 249(2)\n\n\u00a9\u00b4\u00c6\u00b4\u00c7\u00c1\u00d7 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5(\u0089\u00bc\u00c8\u00e2 355(2)\n\n\u00ac\u0081\u00b9\u00b6\u00c7\u00c1\u00d7 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\n\n\u00b9\u00b6\u00c6\u00b6\u00c7\u00c1\u00d7 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\n\n\u00b9\u00b6\u00c8\u00cc\u00b8\u00c7\u00bc\u00c7\u00c1\u00d7 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\n\n\u00b9\u0081\u00b8\u00c8\u00bc\u00ae\u00b4\u00c7\u00c1\u00d7 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\n\n\u00b9\u00b6\u00c8\u0081\u00f2\u0081\u00bd\u00c7\u00c1\u00d7 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\n\n547\n\n549\n\n550\n\n551\n\n551\n\n552\n\n579\n\n580\n\n581\n\n591\n\n593\n\n594\n\n601\n\n602\n\n606\n\n609\n\n613\n\n616\n\n\u00d2\u00dd\u00af\u00c6\u00af\u00b9\u00c6 \u00cc\u00b9\u00bb\u00dd\u00ba\u00c6\u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00af\u00c6\u00d0\u00c1\u00dd\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00dc\u00ba\u00c6\u00b0\n\n\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u0081 \u00b1\u00b4\u00c6\u00b4\u00a3\u00b7\u00c6\u00b6\u0083\u00d7\u00ba\u00c6\u00b6\u00ce\u00af\u00ce\u00ba\u00dc\u00ba\u00c6\u00b0\n\n[2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00ba\u00c7\u00b1\u00c6\u00d2 \u00ba\u00c7\u00b6\u00ba\u00c6 20 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00b0]\n\n\u00b1\u00b0 \u00c1\u00b0 \u00ad 44/2005\n\n\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c7\u00b8 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00ce\u00b6\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c7\u00b8\u00cc\u00b6\u00c7\u00dd \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081 \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b1\u00b4\u00c6\u00b4\u00ba\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00c7\u00d0\u00af :-\n\n1\u00b0 (1) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a9\u00b8 \u00a9\u00d5\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n(2) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00c8\u008a\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00f2\u00be\u00ba\u00c6 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00af\u00c6\u00d0 \u00c1\u00dd\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 (\u00a5\u00d7 \u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u201c\u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6)\u00b0\n\n\u00b9\u00c7\u00af\u00ba\u00c6 I\n\n\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00ce\u00bf\u00af\u00c6 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b9\u00b4\u00c6\u00b4\u00af\u00dd\u00ba+\u00c6\u00af\u00e0\u00ba\u00c6\n\n\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c8\u0081 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00c1\u00b1\u00c8\u00bb\u00b6\u00c6 \u00b6\u00b8\u00c8\u00b9\u00c6\u00b9\u00ae\u00da\u00af\u00bf\u00c6\n\n2\u00c6\u00b0 (1) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de\u00af\u00c7\u00be\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00af\u00c6\u00af\u00c7\u00be\u00ba\u00c6 \u00a3\u00d7 \u00a9\u00b9\u00c6\u00cc\u00b9\u00bb\u00bc\u00c7\u00be\u00c6 \u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7 \u00a3\u00b9\u00c6\u00cc\u00b9\u00bb\u00bc\u00c6\u00cc\u00af\u00c7\u00ae\u00b4 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00d0\u00e1\u00cc\u00c1\u00c7\u0081\u00bd\u00c7\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0 \u00a7\u00bf\u00c6\u00cd\u00bf\u00dc\u00ba\u00c6 \u00cc\u00c1\u00bf\u00c8\u00cd\u00bb\u00dc\u00ba\u00c6 \u2013\n\n(\u00a3)\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 13 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00ce\u00ba\u00c1\u00c7\u00af\" \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00ce\u00be \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00c7\u00b4\u00c6\u00ce\u00b4\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u00d5\u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00cd\u00b9\u00bd\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\" \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b1\u00bb\u00ce\u00be\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00be\u00c6 \u00c1\u00c7+\u00c6\u00af\u008b\u00be\u00c6 \u00a6\u00d5\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0\u00b6\u00c6\u00b6\u00ce\u00af\u00ce\u00ba\u00ce\u00bb\u00dc\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c62\n\n(\u00a4)\u00a5\u00be+\u00c6\u00ce\u00af\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c7\u00b4\u00c6\u0088\u0081\u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00ce\u00ba\u00bb\" (\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00b8 \u00a9\u00be\u00c6\u00be\u00c7 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00b6\u00b6\u00c6\u00d7\u00c1+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00b1\u00c8\u00bd\u00b9\u00c6\u00da\u00bc\u00c8\u00ce\u00ba\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\"\n\n\u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n3\u00b0 (1) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de\"\u00ac\u0081\u00bd\u00c8\u00be\u00c6 \u2013\n\n(\u00a3)\u00a9\u00b7\u00c6\u00b6\u00b9\u00c6 \u00b9+\u00c6\u00d0\u00af\u00ce\u00bf \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b9\u00c6\u00b9\u00c1\u00bc\u00c6\u00af\u00bf\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081\u00cc\u00b1\u00c7\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00bf\u00c6 \u00a9\u00ce\u00c1\u00dc\u00ba\u00c8\u00dd\u00b9\u00c6\u0089\u0081 \u00a3\u00c1\u00bd\u00c6\u00de\u00af\u00c6\u00d0 \u00a7\u00b6\u00e2\u00cc\u00b6\u00c7\u00ce\u00af \u00cc\u00b1\u00df\u00b6\u00c6\u00d7\u00ba\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00ce\u00b4\u00bb\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\u00c7\u00bc\u00c6\u00af\u00cd\u00bf\u00c7 \u00a3\u00b7\u00c6\u00b6\u00b9\u00c6 \u00b9+\u00c6\u00d0\u00af\u00ce\u00bf\u00b1\u00c6 \u00b1\u00c7\u00bc\u00c6\u00b7\u00c6\u00b6\u00c8\u00dd\u00b9\u00c6\u00b9\u00b8\u00c1\u00c7\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a3\u00ce\u00ba\u00b9\u00c6\u00b9\u00af \u008c\u00b6\u00c8\u00af\u00bf\u00c8\u00be\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00b9\u00c6\u00b9+\u00c6\u00d0\u00af\u00ce\u00bf \u00c1\u00c0+\u00c6\u00d0\u00ba\u00c6 \u00ac\u00dd\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00af (\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u201d \u00ac\u0081\u00cc\u00bd\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) ;\u00a3\u00be\u00c6\u00be\u00d7"
