    "chunk_text": "\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00be\u00f8\u00c6\u00c4\u00c6 \u00c0\u00d6\u00bc\u00fa \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00fb\n\n[\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00ef\u00ce\u00e0 2007 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 20 \u00c9\u00be \u00bc\u00fa\u00be]\n\n2007 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 23 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 II \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00a1\u00ba\u00f8\u00ef\u00da\u00a8\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00c8 \u00a8\u00c7\u00be \u00c8\u00bc\u00fb.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00c4\u00ea\u00f7\u00b8 \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00fb.\u00ef\u00a8\u00e5\u00ce\u00c5 1, \u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00be \u00a8\u00e5\u00da\u00c6\u00e5\u00e2\u00ca\u00ef\u00c6\u00be\u00e0 \u0095\u00ce\u00bc\u00fb \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u00c6.\u0095\u00ce : \u00c7\u00e6. \u00c6\u00fa.\u00ba\u00e6\u00c0\u00e6\u00c8\u00e0 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 : \u00c7\u00e6. \u00c6\u00fa\n\ni\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\n2-PL 001387- 425 (2006/08)\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00be\u00e5\u00c4\u00e5\u00c9\u00c8\u00e8\u00c6\n\n1.\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6 \u00cc\u00cd \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00d1\u00ef\u008a \u00bc\u00fa\u00be\u00c61\n\nI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc-\u00cc\u00c4\u00e5\u00aa\u008a \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a1\u00bc\u00e5\u00ce \u00a8\u00e5\u00c7\u00b8\u00e5\n\n\u00cc\u00c4\u00e5\u00aa\u008a\u00c9\u00c8 \u00c0\u00e6\u00c9\u00ba\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00e5\u00c9\u00ca\u00f1\u00a8 \u00c8\u00a8\u00e0\u00cb\u00b8\n\n2.\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00ef\u00ef\u00be\u00ba\u00f8\u00a8 \u00ba\u00ba\u00e0\u00c9\u00c6 \u00cc\u00cd \u00ca\u00a8\u00e0\u00be\u00ea\u00ba\u00e5\u00c913.\u0097\u0097\u00bd \u00c9\u00da\u00aa\u00ef\u00c6\u00e0 \u00cc\u00c4\u00e5\u00aa\u008a2\n\n\u00cc\u00c4\u00e5\u00aa\u008a \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\n\n4.\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00f2\u00c4\u00c625.\u00cc\u00c4\u00e5\u00aa\u00c4 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00c43\n\n\u00cc\u00c4\u00e5\u00aa\u008a \u00be\u008a\n\n6.\u00be\u00e5\u00c4\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00be\u00f8\u00c6\u00c447.\u00be\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00cc\u00e9\u00c4\u00e5 \u00a8\u00f8\u00d7\u00c458.\u00be\u00c4 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c469.\u00be\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00f2\u00cc\u00e8\u00bc\u00e0\u00bd \u00bc\u00e6\u00be\u00e0\u00d1\u00c4810.\u00be\u00c4 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u0097\u00bd\u00e5\u00be \u00a8\u00f8\u00d7\u00c4911.\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6 \u00ef\u00c9\u00be\u00cc\u00e0\u00d1\u00c4 \u00c4\u00ba \u00be\u00c4 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c41012.\u00cc\u00c4\u00aa\u00ef\u008a \u00be\u00c4 \u00cd\u00e5 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00a1\u00e2\u00a8\u00c6 \u00c3\u00e5\u0097\u00ba \u00a8\u00f8\u00d7\u00c411\n\n\u00cc\u00e5\u00e2\u00aa\u0095\u00a8 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00c6\n\n13.\u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00ef\u00c6\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00e5\u00c7\u00b8\u00e51214.\u00a1\u00e5\u00bc\u00da\u00ca \u00c9\u00f1\u00c9\u00cc\u00e0\u00ba\u00e5\u00c9\u00c8\u00e8\u00c6\u00a8\u00e0 \u00a1\u00bc\u00e5\u00ce\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c41315. \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00c6\u00a8\u00e0 \u00a1\u00bc\u00e5\u00ce \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c41316.\u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00ef\u00c6\u00e0 \u00c2\u00c8\u00c0\u00e7\u00c41417.\u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00ef\u00c6\u00e0 \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00f2\u00a8\u00e5\u00ca\u00ef\u00c6\u00e0 \u00c2\u00c8\u00c0\u00e7\u00c41418.\u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00ef\u00c6\u00e0 \u00c0\u00e8\u00b4\u00c0\u00ba\u00a8\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00b4\u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c915\n\nii\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\n\u00cc\u00c4\u00e5\u00aa\u008a \u00aa\u00fa\u0097\u00cc\u00ea\u008a \u00a1\u00e5\u00bc\u00fa\u00c6\n\n19.\u00aa\u00fa\u0097\u00cc\u00ea\u008a\u00c9\u00c8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c61520.\u00a1\u00e6\u00ef\u00b4\u00e5\u00e0\u00da\u00be\u00f8 \u00c2\u00c8\u00a8\u00c7\u00e6\u00ef\u00c9\u00e5\u00e01721.\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0, \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cd\u00e5 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u0093\u00a8\u00e5\u00c7\u00c61722.\u00cc\u008a\u00c0\u00f2\u00c6\u00ea\u00a8\u00e0\u00ba \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00c2\u00c918\n\n\u00c0\u00ec\u00da\u00c9-\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a \u00aa\u00fa\u0097\u00cc\u00ea\u008a\n\n23.\u00c0\u00ec\u00da\u00c9-\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a \u00aa\u00fa\u0097\u00cc\u00ea\u008a \u00cc\u00e0\u00bb\u00fc\u00c7 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c91924.\u00c0\u00ec\u00da\u00c9 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a \u00aa\u00fa\u0097\u00cc\u00ea\u008a\u00c9\u00c8 \u00c9\u00f1\u00e2\u00d4\u00ba \u00a1\u00e6\u00c0\u00d1\u008a1925.\u00cc\u00e0\u00bb\u00fc\u00c7 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d7\u00c420\n\n\u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be \u00cc\u00e6\u00c2\u00e7 \u00c2\u00c9\u00b4 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00f8\u00d7\u00c4\n\n26.\u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be \u00cc\u00e6\u00c2\u00e7 \u00c2\u00c9\u00b4 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00f8\u00d7\u00c421\n\nII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc-\u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00cc\u00c4\u00e5\u00aa\u008a\n\n27.\u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00c62128.\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00d1\u00c4 \u00a1\u00c9\u00cc\u00be\u00e0 \u00d1\u00c42129.\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00c2\u00c9\u00b4 \u00c0\u00ba\u00e0 \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c92230.\u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00cc\u00c4\u00e5\u00aa\u008a \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00c7\u00c6 \u00ba\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00a1\u00c9\u00ca\u00f1 \u00ef\u00be\u00e5\u00c9\u00be \u00c2\u00c9 2231.\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00a8\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00a6\u00e0\u00a8\u00c4\u00ba\u00f8\u00a8 \u00a6\u00a8\u00ad\u00ba\u00e0\u00c9\u00c623\n\nIII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc-\u00a1\u00e6\u00c0\u00ef\u00c6\u00be\u00e0 \u00cc\u00e9\u0095\u00ba \u00cc\u00c4\u00e5\u00aa\u008a"
