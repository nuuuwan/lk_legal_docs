    "chunk_text": "\u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 5,000,000\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00cc\u00cd (\u00a1) \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00cd\u00fa \u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00be\u00e5\u00c9\u00be\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00c9\u00be \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00cc\u00e8\u00c6\u00c6\u00b4 15\n\n(\u00a1\u00e5) 2007 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00e5\u00c7\u008a\u00c3\u00c9\u00be \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5_\n\n(\u00a1) (i) \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 5,000,000-\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n(ii) \u201c\u00a1\u201d \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0\u00ef\u00be\u00e5\u00c9\u00be; \u00cc\u00cd\n\n(\u00a1\u00e5) \u00c0\u00e5\u00c8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0, \u00c0\u00e5\u00c8\u00e8\u00ba \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c4\u00e5\u00aa\u008a\u00cc\u00c4\u00ec\u00cd\u00c6\u00a8 \u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be\n\n\u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c4\u00ba \u00cc\u00e8\u00c6\u00c6\u00b4 15\n\n\u00ef\u008a \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u201c\u00c0\u00e5\u00c8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u201d, \u201c\u00c0\u00e5\u00c8\u00e8\u00ba\u00cc\u00c4\u00e5\u00aa\u008a\u201d \u00cc\u00cd \u201c\u00cc\u00c4\u00ec\u00cd \u00cc\u00c4\u00e5\u00aa\u008a\u201d \u00c6\u00be \u00ef\u00c6\u00f3\u008a\u00c9\u00c8\u00b4 2007\u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a6\u00e0\u00c9\u00e5\u00b4 \u00bc\u00e9 \u00a1\u00e6\u00ba\u00f8 \u00a6\u00c4 \u00a1\u00bc\u00e5\u00ce\u00a1\u00da\u00bb\u00c6\u00be\u00e0\u00c4 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n2. \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00db\u00a8\u00eb\u008a \u00c0\u00ba\u00e0 \u00cd\u00e5 \u0097\u00be\u00f8\u00c4\u00c6 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0\u00cc\u00c3\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00c9\u00cc\u00e0\u00ba\u00eb\u0097\u00be\u00f8\u00c4\u00c6 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00f2\u00cc\u00e8\u00bc\u00e0\u00bd \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00be\u00f8\u00c8 \u00c8\u00e6\u00c6\u00fa\u00cc\u00e0\u00ba\u00eb\u00c9\u00a8\u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00c0\u00ce\u00c4\u00ea\u00c9 \u00c8\u00e6\u00c6\u00fa\u00cc\u00e0\u00ba\u00eb\u00aa\u00ba \u00a8\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 (\u00ef\u00c4\u00cd\u00fa\u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be) \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 5,000,000\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00cc\u00cd \u00a6\u00c4 \u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4\u00a6\u00ce\u00ef\u00c5\u00be \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00cd\u00ba\u00c7 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00cc\u00bf\u00cd\u00e5:_\n\n\u00a6\u00c4 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c4\u00ba \u00cc\u00e8\u00c6\u00c6\u00b4 33 1/3\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9\u00bc, \u00a6\u00c4 \u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 2006 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc01 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00c9\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00cc\u00e8\u00c6\u00c6\u00b4 33 1/3\u00a8 \u00a1\u00be\u00ea\u00c0\u00e5\u00ba\u00c6 \u00a1\u00bc\u00e5\u00ce \u00c9\u00be\u00ea\u00ef\u00c6\u00e0 \u00a6\u00c4\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00cd\u00ba\u00c7\u00a8 \u00a8\u00e5\u00c8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, 2006 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc01 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00c0\u00cc\u00ea\u00c9 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00c6\u008a\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00f8.\n\n3. \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ef\u008a \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u0095\u00be\u00e0 \u00ef\u00c0\u00c7\u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00cd\u00e6\u00c7 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 :\u2014\n\n\u00a6\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c4\u00ba \u00cc\u00e8\u00c6\u00c6\u00b4 35\n\n2007 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba56\n\n4. \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c2\u00f3 \u00a1\u00c6 \u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0095\u00c8\u00e8\u00c6\u00be \u00c0\u00cd\u00a8\u00b4 \u00c9\u00e6\u0091 \u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb,\u00a6\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u008a \u00c0\u00be\u00ba\u00b4\u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00a1\u00e5\u00aa\u00be\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00a6\u00ef\u00cc\u00e0 \u00c9\u00e6\u0091 \u00c9\u00ec \u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba\u00c6\u00b4\u00a1\u00ef\u00c7\u00e5\u00e0\u00c0\u00be\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a6\u00e0 \u00c2\u00bc\u00e0\u00ef\u00bc\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc, \u00a6\u00c4 \u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba\u00c6\u00b4 \u00c9\u00b6\u00e5\u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d."
