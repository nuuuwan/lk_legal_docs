    "chunk_text": "\u201c\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa \u00ef\u00cd\u00e5\u00e0 \u00d7\u00ba\u00f8 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u2014\n\n(\u00a1)2006 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00b8\u00c6 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a4\u00c0\u00c6\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00c9\u00be \u00a6\u00e0\u00a8\u00a8\u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00ef\u00be\u00f1\u00e5\u00be\u00f1 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00f8\u00be\u00e0 ; \u00cc\u00cd\n\n\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0\u201d.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 70\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 73\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 75\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 66\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba31\n\n25.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00e8\u00ef\u00c6\u00e0 78 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u201c\u00cc\u00e7\u00c4 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0\u00c4 76 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00c2\u00bc\u00fa\u00c6\u00cd\u00e6\u00a8\u00f8 \u00c8\u00e5\u00c3\u00c9\u00c8 \u00c4\u00ea\u00dd \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00c4\u00ba \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c4\u00ba,\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00c0\u00cc\u00e0\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0\u201d , \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c\u00cc\u00e7\u00c4 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e8\u00be\u00e0\u00c4:\u2014\n\n(\u00a1) 2006 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5, 76 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00ef\u00c2\u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c8\u00e5\u00c3\u00c9\u00c8 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00c4\u00ea\u00bc\u00c8 \u00cc\u00cd \u00a1\u00ef\u00be\u00a8\u00eb\u00ba\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u008a ; \u00cc\u00cd\n\n(\u00a1\u00e5) 2007 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 01 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00c0\u00cc\u00ea\u00bc\u00fa\u00be\u00c6\u00a8 \u00cc\u00e8\u00b4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5,76 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00c2\u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c8\u00e5\u00c3\u00ef\u00c6\u00e0\u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c8\u00a8\u00e0\u00cb \u00cd\u00c6\u00a8\u00b4 \u00c9\u00e6\u0091\u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba\u00c6\u00a8\u00e0 \u00ef\u008c \u00be\u008a, \u00a6\u00c4 \u00a1\u00ba\u00f8\u00d6\u00a8\u00e0\u00ba\u00c6 \u00cc\u00cd \u00a1\u00ef\u00be\u00a8\u00eb\u00ba\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u008a,\n\n\u00c4\u00ba, \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00c0\u00cc\u00e0\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd\u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(2)\u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00ce\u00c4\u00ea \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 \u201c2004 \u00a1\u00e2\u00a8 11\u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201c2006 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0,\u00a6\u00c4 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(3)\u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00bc\u00c9\u00be \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 \u201c2004 \u00a1\u00e2\u00a8 11\u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd\u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c2006 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc\u201d, \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 78\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba32\n\n26.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 102 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00a1\u00ba\u00c7 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00ef\u0089 :\u2014"
