    "chunk_text": "(2) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00a9\u00d7\u00e2\u00ba\u00c6\"\u00a3\u00b7\u00c6\u00b6 \u00cc\u00b1\u00be\u00e2\u00af\u00bf\u00c6 \u00bb\u00c7\u00e2\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u0081 \u00a5\u00ce\u00b4\u00cd\u00b7\u00bc\u00c6\u008c\u00ce\u00bf\u00c1\u00c7\u00b8\u00cc\u00b1\u00be\u00e2\u00af\u00bf\u00c6 \u00bb\u00c7\u00e2\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c1\u00de\u00ce\u00af\u00af\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00b8 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a3\u00df\u00c1\u00be\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00c7+\u00c6\u00af\u00c8\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u00b8 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00be\u00c7\u00ba\u00c6\u00b0\n\n\u00a5\u00b9\u00c6\u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00b4\u0081\u00a5\u00b5+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u00e1\u00d0\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8\u00af\u00b4\u00ce\u00ba\u00ce\u00bb\u00c1\u00df\u00e2\u00af\u00c6\u00d0\u00cc\u00af\u00c7\u00ae\u00d5\u00c1\u00dd\u00b6\u00be\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6505\n\n\u00b9+\u00c6\u00d0\u00af\u00bf\u00c8\u0081 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8\u00ba\u00c9\u00d7\u00ba\u00c6\" \u00b9+\u00c6\u00d0\u00af\u00bf\u00c8\u0081 \u008c\u00bd\u00c6\u00b9\u00ce\u00b8\u00af\u00c6\u00af\u00c7\u00b8\u00cc\u00af\u00c7\u00ce\u00b4 \u00db\u00ce\u00b8\u00e2\u00ba\u00c9\u00d7\u00ba\u00c6 \u00a7\u00bf\u00c6\u00bf \u00ba\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\n\n500\u00b0 (1) \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0 \u00cc\u00c1\u00bf\u00c8\u00cd\u00bb \u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00be\u00c6\u00be\u00d7\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00e2\u00bf\u00c6\u00bf \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00df\u00bf\u00c6\u00bf \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b9+\u00c6\u00d0\u00af\u00e0\u00af\u00c6\u00d0\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081 \u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00b4\u0081\u00af\u00e0\u00af\u00c6\u00d0 \u00ac\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00af\u00cc\u00af\u00c7\u00ce\u00b4\u00db\u00ce\u00b8\u00e2 \u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd\u00b6\u00c7\u00b8 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00db\u00bd\u00c6\u00b9\u00af\u00bc\u00c6\u008c\u00ce\u00b8\" \u00a3\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00b4\u00ba\u00c6 \u00ac\u0081\u00ce\u00bd\u00b6\u00c6 \u00b6\u00c7\u0089\u00b6\u00c6\u00b6\u00c8\u00dd\u00b7\u00c6\u00b6\u00c7\u00df\u00b3\u00c6\u00b1\u00bc\u00c8 \u00a5\u00be\u00c6\u00be\u00c7\u008c\u0088\u00d9\u00ba\u00c6\u00b1\u00bc\u00c8\" \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00dd\u00c1\u00c7\u00d0\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7 \u00b6\u00c7\u0089\u00b6\u00c6\u00b6\u00c7\u00df\u00ba\u00c6\u00b1\u00bc\u00c8\" \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00c7\u008c\u0088\u00d9\u00b3\u00c6\u00b1\u00bc\u00c8 \u00db\u00bd\u00c6\u00b9\u00af\u00bc\u00c6\u00c1\u00c7\u00b8\u00d7 \u00cd\u00b6\u00b6\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c7\u00be\u0081\u00bd\u00c8\u00dc\u00ba