    "chunk_text": "(\u00a1\u00e5) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 38 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00a1\u00c9\u00ca\u00f1 \u00d1 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00cd \u00a6\u00e0 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba\u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00bc\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4\u00b4 \u00ef\u00c0\u00c7 \u00a6\u00c6 \u00a2\u00c8\u00e0\u00c8\u00e5 \u00a1\u00cc\u00e0\u00a8\u00c7 \u00ef\u00aa\u00be \u00a1\u00e6\u00ba\u00f8,\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00ef\u008c \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c6\u008a\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00bc\u00e6\u00be\u00ea\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00bc, \u00a6\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u00cd\u00e6\u00c7, \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00cc\u00cc\u00ea \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00e6\u00be\u00e0 \u00cc\u00cd \u00a6\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4\u00b4 \u00c2\u00c8\u00c6 \u00ef\u00bc\u00be \u00c8\u00bc \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba\u00c0\u00d6\u00bc\u00fa, (\u00a1) \u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00ef\u00c6\u00e0 \u00ba\u00c4 \u00be\u00c4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00c8\u00bc \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00a1\u00c9\u00ca\u00f1 \u00d1 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00bc \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa, \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00be\u00c4 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00ef\u00c6\u00cd\u00fa \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00a8\u00eb \u00ef\u00c8\u00cc \u00ba\u00c4\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00e6\u00c6\u00fa \u00a4\u00bc\u00e0\u00ef\u00bc\u00e0\u00ca\u00fa\u00ba \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00a6\u00cd\u00fa \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00a8\u00e5\u00b4 \u00ef\u00aa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ba\u00c4\u00e5\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00c8\u00bc \u00c6\u008a \u00be\u00b6\u00ea\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00be\u00b6\u00ea \u00a8\u00b4\u00c6\u00ea\u00ba\u00e0\u00ba\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ba\u00c4\u00e5 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u0097\u00ba\u00e0\u00ba\u00f8\u00c9\u00e5\u00ae\u00a8 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a \u00c8\u00e5, \u00bc\u00e6\u00d7\u00c4\u00b4 \u00cc\u00e8\u00f3\u00c9\u00be \u00cc\u00e8\u00c6\u00f5 \u00a1\u00c8\u00e5\u00c3, \u00be\u00b6\u00ea\u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00cc\u00cd \u0097\u00c6\u00bc\u008a \u00cc\u00bf\u00cd\u00e5 \u00c9\u00be\u00e0\u00bc\u00fa \u00ef\u00aa\u00d1\u00c4\u00b4 \u00c2\u00e6\u00bf\u00fb \u00cc\u00e8\u0090\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba39\n\n(5) \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00d1\u00c4 \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00a8\u00e5\u00b4 \u00ef\u00aa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb\u00ef\u00c8\u00cc \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bd\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00d1\u00c4\u00b4 \u00a6\u00a8\u00ad\u00c9 \u00cc\u00e8\u0090\u00be\u00e0\u00be\u00a8\u00eb \u00ef\u00c8\u00cc \u00be\u008a \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u009f\u00c4 \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00a8\u00e5\u00b4 \u00ef\u00aa\u00be \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c2\u00c8\u00c6\u00bc\u00fb\u00c4 \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00a8\u00e5\u00b4 \u00ef\u00aa\u00be \u00ef\u00cd\u00e5\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00a8\u00eb \u00ef\u00c8\u00cc \u00ba\u00c4\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00c6\u00c6\u00fa \u00a4\u00bc\u00e0\u00ef\u00bc\u00e0\u00ca\u00fa\u00ba \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00a6\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00ef\u00c6\u00cd\u00fa \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00a8\u00e5\u00b4 \u00ef\u00aa\u00be \u00ef\u00cd\u00e5\u00e0 \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00ef\u00aa\u00d1\u00c4\u00a8\u00e0\u00a8\u00f8\u00d7\u00c4\u00b4 \u00c2\u00e6\u00bf\u00fb \u00cc\u00e8\u0090\u00be \u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c4 \u0097\u00cc\u00e8\u00be\u00e0, \u00ef\u00c9\u00be \u00ef\u00c9\u00be\u00c4 \u00be\u00b6\u00ea\u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00c4 \u00ef\u00aa\u00d1\u00c4 \u00c4 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c2\u00e6\u00bf\u00fb\u00c4\u00a8\u00b4 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8\u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00be\u00e0, \u00a6\u00ef\u00cc\u00e0 \u00c2\u00e6\u00bf\u00fb \u00cc\u00e8\u0090\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00e2\u00ae\u00be\u00f8\u00a8\u00ef\u00c8\u00cc \u00f3\u00c7\u00da\u00c0\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00d1, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a3\u00b4\u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00ef\u00be\u00e5\u00d1 \u00cc\u00e8\u0090\u00c6\u00ef\u00cd\u00e5\u00ba\u00e0 \u0095\u00cc, \u00aa\u00fa\u0097\u00cc\u00ea\u008a\u00c9\u00c8 \u00bc\u00fb \u00ef\u00c4\u00be\u00e0\u00c4 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00be\u00e0 \u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00c6 \u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(6) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5,\u2014\n\n(\u00a1)\u201c\u00c0\u00f2\u00c9\u00da\u00bd\u00a8\u00c6\u00e5\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00cc\u00ba\u00f1\u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00f8\u00d7\u00ef\u00c4\u00cd\u00fa \u00c8\u00e5\u00c0\u00e5\u00da\u00ca\u00e0\u00c9\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00ec \u00c0\u00f2\u00c9\u00da\u00bd\u00a8\u00c6\u00a8\u00eb \u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be \u00be\u00c4\u00ea\u00ba\u00e0, \u00cc\u00c4\u00e5\u00aa\u00c4\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00ef\u00c4\u00cd\u00fa \u00c8\u00e5 \u00be\u00f8\u00c7\u00ba \u00c9\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0, \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6 \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00a8\u00f8\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00a8\u00e5\u00b4\u00ef\u00aa\u00be \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a3\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00be\u00e5\u00ef\u008c ; \u00ba\u00c9 \u00bc,\n\n(\u00a1\u00e5)\u201c\u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00e5\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00cd\u00fa 38, \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00a3\u00b4 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8\u00a1\u00da\u00bb\u00c6 \u00c4 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6."
