    "chunk_text": "2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6371\n\n\u00af\u00b4\u00b8\u00c8\u00de\u00af\u00c6\u00af \u00c1\u00ce\u00af\u008a\u0081\u00ce\u00ba\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\"\u00a3\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 12 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00b8\u00c8\u00d2 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00b5\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u0081 \u00a3\u00bd\u0096\u00b4\u00c6\u0088\u00bd\u00c6\u00af\u00c7\u00b8\u00b7\u00c9\u00b6\u00c8\u00b6\u00c6 \u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00bd\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00a4\u008a\u00d9\u00ba\u00c6\" \u00ac\u00d5\u00af\u00c6\u00d0\u00b6\u00be\u00c6 \u00a4\u00bc\u00ba\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00ac\u00dd\u00ba\u00c7\u00b6\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00bf\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00b6\u00b8\u00ba\u00c6 \u00a9\u00d7\u00e2\u00ba\u00c6 \u00ac\u00c0\u00c8\u00b9\u00c6\u00cd\u00b9\u00c7\u00b8\u00c8\u0081\u00a3\u00bd\u00c8\u00e2\u00af\u00c6\u00d0 \u00a9\u00b4\u00c6\u00b4\u00c7\u00b6\u008c\u00b4\u00b6\u00c6\u00d7\" \u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c8\u0081\u00af\u00c9\u00c0\