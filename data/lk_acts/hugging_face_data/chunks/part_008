    "chunk_text": "(i) \u00a3\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 (i) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\" \u201c97 \u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a5) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00a3\u00d9\u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00af\u00b4\u00b8\u00c8\u0081 \u00a4\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00ce\u00bb\u008c\u00b4\u00af\u00c6 \u00e7\u00d5\u00b6\u00be\u00c7\u00af\u00e2\u00bf\u00c6\u00bf\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c97 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081(1)\u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a5) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00a3\u00d9\u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00af\u00b4\u00b8\u00c8\u0081 \u00a4\u00af\u00af\u00c6\u00e7\u0088\u00bb\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6;\n\n(iii) \u00a3\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 (iv) \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\" \u201c\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc \u00cd\u00b1\u00ce\u00c1\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00b5\u00ba\u00c6 ;\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc\u00cd\u00b1\u00ce\u00c1\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00b5\u00ba\u00c6 ; \u00a3\u00be\u00c6\u00be\u00d7\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 ;\n\n(iv) \u00a3\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 (v) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\"\u201c\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00c1\u00bc\u00c8 ;\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8 \u00c1\u00bc\u00c8 ; \u00a3\u00be\u00c6\u00be\u00d7\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 ;\n\n(v) \u00a3\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 (vi) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\"\u201civ \u00a4\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u201c4 \u00a4\u00ba\u00c6\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00a5\u00be\u00af\u00c6\u00af\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6 \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6;\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c617\n\n(\u00a4)\u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00aa) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u00a3\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 (iv) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 (\u00a4) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\u201c\u00cc\u00b9\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c\u00cc\u00b9\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(v)\u201c\u00af\u00b4\u0081\u201d \u00a9\u0081\u00b9\u00d7 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b6\u00b8\u00c8\u00d2\u00b1\u00c6 \u00b1\u00c7\u00b6\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00c1\u00c0+\u00c6\u00af\u00c9\u00b4\u00c6\u0088\u008b\u00dd\u00b7\u00c6\u00b6\u00c7\u00b8 \u00b7\u00c8\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00cd\u00b1\u00af\u00bc\u00c8\u00b9\u00c6\u00ce\u00b9 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6 ;\u201d;\n\n(\u00a5)\u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00aa) \u00a9\u0081\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ce\u00bb \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb \u00b9\u00b7\u00c6\u00b6\u00c8\u00ce\u00bb\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :-\n\n\u201c(\u00be) \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00c6\u00d0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00d7\u00ce\u00b5\u00b7\u00c8\u00ce\u00be\u00af\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00be\u00c6 \u00cc\u00b9\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00b4\u0081 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00ad\u00bc\u00c6 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bf\u00bc\u00c7\u00af\u00a5\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u00a3\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u0081\u00a5\u00de\u00b6\u00c8\u008a\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9+\u00c6\u00d0\u00f2\u00be\u00b6\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7\u00ba\u00c6 \u00ac\u00d7\u00af\u00c6\u00af\u00c9\u00d5\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00e7\u00b4\u00c6\u00d5\u00cc\u00ba\u00c7\u00b6\u00c6\u00b6\u00b6\u00c6\u00b6\u00c8\u0081 \u00db\u00ba\u00c6\u00ba\u00b4+\u00c6\u00af\u00c8\u00bd\u00c6\u00d0\u00b1\u00c6\u00b1\u00ba\u00ba\u00c7\u00b8\u00c1\u00c7\u00de \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00b4\u00b8\u00c8\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00aa\u00bd\u00c6\u00bd\u00c8\u00af\u00c6 \u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b8\u00c1\u00c7\u00de \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00b4\u00c6\u0088\u008a\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00cd\u00ba\u00be\u00c7\u00af \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00b4\u00c6\u0088\u008a\u0081 \u00e7\u00b4\u00c6\u00d5\u00cc\u00ba\u00c7\u00b6\u00c6\u00b6\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u008a\u0081 \u00ba\u00c8\u00ce\u00af\" \u00aa\u00d7\u00ba\u00c8\u00dd\u00b9\u00c6\u0089\u0081 :\n\n\u00a4\u008a\u0081\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cc\u00af\u00c7\u00bf\u00c8\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00ad\u00bc\u00c6\u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bf\u00bc\u00c7\u00af \u00a5\u00be\u00c6\u00be\u00c7\u00b6\u008c\u00b4\u00b6\u00c6\u00d7\" \u00db\u00bd\u00c6\u00cd\u00b9\u00c7\u00b7\u00c6\u00b6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u201c\u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9+\u00c6\u00d0\u00f2\u00be\u00b6\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7\u00ba\u00c6 \u00ac\u00d7\u00af\u00c6\u00af\u00c9\u00d5\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00e7\u00b4\u00c6\u00d5\u00cc\u00ba\u00c7\u00b6\u00c6\u00b6\u00b6\u00c6\u00b6\u00c8\u0081 \u00db\u00ba\u00c6\u00ba\u00b4+\u00c6\u00af\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9+\u00c6\u00d0\u00f2\u00be\u00b6\u00b8\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7\u00ba\u00c6"
