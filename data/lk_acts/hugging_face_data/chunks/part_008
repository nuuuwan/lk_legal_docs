    "chunk_text": "191.\u201c\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u201d \u00c6\u00be\u00e0\u00ef\u00be\u00cd\u00fa \u00a1\u00da\u00bb\u00c6162192.\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00a1\u00be\u00e5\u00c9\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4163193.\u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea \u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00c4164194.\u00c0\u00e5\u00da\u00ca\u00e0\u00c9\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00c2\u00c8\u00c0\u00e7\u00c4165195.\u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8 \u00bc\u00fb 192 \u00cc\u00cd 193 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u00c9\u00be \u00c2\u00c9165196.\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00af\u00be\u00e0\u00bc\u00c6 \u00c0\u00e5\u0097\u0083\u008e \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c9165197.\u00cc\u00c4\u00e5\u00aa\u00c4 \u00cc\u00ba\u00eb \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4166\n\n198.\u201c\u00a1\u00bc\u00e5\u00ce \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00cd\u00fa \u00a1\u00da\u00bb\u00c6167199.\u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8 \u00bc\u00fb \u00a1\u00bc\u00e5\u00ce \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00ef\u00be\u00e5\u00cc\u00c8\u00a8\u00e5 \u00cd\u00e6\u00d6\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9170200.\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea \u00a1\u00be\u00e5\u00c9\u00c7\u00b8\u00c6 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9171\n\n\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\n\n201.\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0 \u00cc\u00e2\u00a9\u00f1\u00e5\u00c9172202.\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a172203.\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00a1\u00c9\u00ca\u00f1 \u00c2\u00c9173204.\u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u00cc\u00cd \u00ba\u00bc\u00be\u00be\u00e0\u00ba\u00c7 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4173205.\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00c9\u00be \u00ef\u00c9\u00be\u00c4 \u00af\u00be\u00e0\u00bc\u00c6 \u00bc\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9174206.\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4174207.\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u00bd\u00ea\u00c7\u00c6 \u00bc\u00e6\u00d7\u00c4 \u00be\u00ba\u00c7 \u00d1\u00c4175208.\u00a1\u00be\u00e0\u00ba\u00f8\u00c4\u00b4 \u00a2\u00ba\u00f8\u00d6\u00c9 \u00cc\u00e8\u0090\u00be \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u00a2\u00c8\u00e0\u00c8\u00e5 \u00a1\u00cc\u00e0\u00d1\u00c4176209\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00c8 \u00c9\u00c8\u00e2\u00aa\u00eb\u00c3\u00e5\u00c9\u00c6176\n\nxi\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\n\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u0097\u00ca\u00f2\u00e5\u00c4 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c9\u00c6\u00cc\n\n210.\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00c6\u00cc\u00e0 \u00cc\u00e9\u00c4\u00e5\u00c9176211.\u00c9\u00c6\u00cc\u00e0 \u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00ef\u00c8\u00cc \u00cc\u00c4\u00e5\u00aa\u00c4 \u00cc\u008a\u00c4\u00ba \u00a8\u00c7 \u00aa\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\u00c9\u00c6\u00cc\u00e0 \u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9177212.\u00c9\u00c6\u00cc \u00ef\u00cd\u00ce\u00e8\u00bc\u00c7\u008c \u00a8\u00f8\u00d7\u00c4 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00e6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c6\u00ea\u00ba\u00eb\u00a8\u00c4 \u00c2\u00c9177\n\n\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00be\u00ea\u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a\n\n213.\u00cc\u00c4\u00e5\u00aa\u008a \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ba\u00cd\u00be\u008a \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0178214.\u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0 \u00be\u00ea\u00cc\u00ea\u00f3\u00cc\u00e0\u00cc\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c9179\n\n\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00b4 \u00a1\u00bc\u00e5\u00ce \u0097\u0097\u00bd \u0097\u0093\u0097\u00bd\u00e5\u00be\n\n215.\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00c0\u0090\u00c0\u00e5\u0090\u00c6181216.\u00c0\u00e5\u00d6\u00ca\u00f2\u0095\u00a8 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3181217.\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00b4 \u00ef\u00bc\u00be\u00ea \u00c8\u00c2\u00be \u00b8\u00c6 \u00cc\u00e9\u00c4\u00e5 \u00a8\u00f8\u00d7\u00c4183218.\u00cd\u00e5\u00be\u00e8\u00c0\u00ec\u00c7\u00b8\u00c6 \u00cd\u00e5 \u00c7\u00a8\u00e0\u00cb\u00b8\u00c6185219.\u00c9\u00cc\u00e0\u00ba\u00eb \u00c3\u00e2\u00aa\u00ba\u00e0\u00c9\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0 \u00cc\u00ba\u00eb \u00c6\u00ea\u00ba\u00eb\u00a8\u00c4187220.\u00ba\u00bc\u00c2\u00c8 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00c0\u00e5\u00b6\u00ea\u00c9\u00a8 \u00bc\u00fb \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c6\u00ea\u00ba\u00eb\u00a8\u008a188\n\n\u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00be\u00e0\n\n221.\u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5189222.\u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a \u00be\u00f8\u00c6\u00c4 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9190\n\n\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0 \u00cc\u00cd \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\n223.\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0 \u00cc\u00cd \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00ef\u00c8\u00e0\u00a9\u00be\u00c6.190\n\n\u00c0\u00e9\u00b6\u00e5\u00a8\u00e5\u00d7\u00ba\u00e0\u00c9\u00c6 \u00cc\u00cd \u00a1\u00c6\u00bb\u00e5 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00c4\n\n224.\u00c0\u00e9\u00b6\u00e5\u00a8\u00e5\u00d7\u00ba\u00e0\u00c9\u00c6.192225.\u00a1\u00c6\u00bb\u00e5 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6.192226.\u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00ef\u00c9\u00ba \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00a8\u00ce \u00cd\u00e6\u00a8\u00e0\u00ef\u00a8\u00e0 \u00a8\u00c9\u00c7\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00bc \u00c6\u00be \u00c9\u00aa.193227.\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00ef\u008a \u00be\u00b6\u00ea \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00c0\u00c9\u00ba\u00f8\u00be \u0097\u00b4 224 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00ef\u00cd\u00e5\u00e0 225 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00b4 \u00a1\u00e6\u00ba\u00f8\u00c2\u00c8\u00c6.194228.224 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 225 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8 \u00bc\u00fb\u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c8\u00c6.195\n\nxii\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9"
