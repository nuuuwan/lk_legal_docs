    "chunk_text": "(\u00a1)\u00af\u00be\u00e0\u00bc\u00c6 \u00bc\u00fb\u00ef\u008a \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00cd\u00e5 \u00ef\u00c2\u00bc\u00e5 \u00cd\u00e6\u00d7\u00ef\u008a \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00bc\u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00ef\u008a \u00c0\u00be\u00ba \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e5\u00e2\u00aa\u0095\u00a8 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec\u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a, \u00c9\u00c7\u00c0\u00f2\u00cc\u00e5\u00bc, \u00cc\u00e9\u00c4\u00e5 \u00a8\u00f8\u00d7\u008a\u00cd\u00e5 \u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8 ;\n\n(\u00a1\u00e5)53 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00c0\u00ec\u00da\u00c9\u00a8\u00f2\u00c6 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a ;\n\n\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a\u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba82\n\n(\u00a1\u00e7)\u00cc\u00e5\u00e2\u00aa\u0095\u00a8 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00c6 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00cc\u00e5\u00e2\u00aa\u0095\u00a8 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8\u00a8\u00e5\u00da\u00c6 \u00c0\u0090\u00c0\u00e5\u0090\u00c6\u00a8\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00ef\u00be\u00e5\u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00cc\u00e0\u00ef\u00be\u00e5\u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u00c4,\n\n\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n100.\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00c2\u00c8\u00c0\u00e5\u00be \u00a8\u00f2\u00e8\u00c6\u00e5\u00c4\u00e5\u00da\u00aa\u00c6\u00a8\u00e0 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00bc\u00a8\u00e0\u00c9\u00be \u00a8\u00b8\u00e0\u00b6\u00e5\u00c6\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00cd\u00e5 \u00a6\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00c4\u00e5\u00da\u00aa\u00c6 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00cc\u00c4\u00e5\u00aa\u00c4 \u00cd\u00fa\u0095\u00a8\u008a \u00c8\u00c2\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8,\u2014\n\n(\u00a1)\u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00be\u0095\u00be\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00cd\u00e5\u00a8\u00f2\u00e8\u00c6\u00e5 \u00c4\u00e5\u00da\u00aa \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00a6\u00a8\u00c4 \u00a1\u00da\u00bb\u00c8\u00e5\u00c3\u00fb\u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00a1\u00e6\u00ba\u00f8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00cc\u00e8\u00c6\u00f5 \u00c4 \u00af\u00be\u00e0\u00bc\u00bc\u00e6\u00c4\u00ec, \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00bc\u00a8\u00e0\u00c9\u00be \u00a8\u00b8\u00e0\u00b6\u00e5\u00c6\u00ef\u008a \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb\u00c9\u00ec \u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00e5 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00a8\u00f2\u00e8\u00c6\u00e5 \u00c4\u00e5\u00da\u00aa\u00c6 \u00aa\u00e6\u00be\u00f9\u00c4 \u00a1\u00be\u00ea\u00c4\u00ba \u00ef\u00a8\u00ef\u00c7\u00be \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba\u00c6\u00a8\u00e0144 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u008a\u00c4\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00be\u0095\u00be\u00e0 \u00c8\u00e8\u00c6\u00e5 \u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00cd\u00e5 \u00a6\u00a8\u00c4\u00a1\u00da\u00bb\u00c8\u00e5\u00c3\u00fb \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u00c4 \u00a1\u00e6\u00ba\u00f8, \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba\u00c6 \u00a1\u00ba\u00e0\u00cc\u00be\u00e0 \u00ef\u00be\u00e5\u00a8\u00ce \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00bc\u00a8\u00e0\u00c9\u00be\u00a8\u00b8\u00e0\u00b6\u00e5\u00c6\u00ef\u008a \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00c9\u00ec \u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00e5,\n\n94 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9, \u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0, \u0095\u00c8 \u00bc\u00fb \u00aa\u00be\u00e0\u00be\u00e5 \u00ef\u00c8\u00cc\u00cc\u00c4\u00e5\u00aa\u00ef\u00c4\u00be\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u009b\u00c4\u00b4 \u00cd\u00fa\u0095\u00a8\u008a \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n101.\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa\u00c2\u00c8\u00c0\u00e5\u00be \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5 \u00c4\u00e5\u00da\u00aa\u00c6\u00a8\u00e0 \u00aa\u00e6\u00be\u00f9\u00c4, \u00a6\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00c4\u00e5\u00da\u00aa\u00c6 99 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u009f\u00ef\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00c9 \u00be\u00f8\u00cc\u00e5 \u00c4 \u00c0\u00c4\u00b8\u00a8\u00e0, \u00be\u00f8\u00da\u00c2\u00c8\u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u0095\u00c8 \u00bc\u00fb\u00aa\u00be\u00e0\u00be\u00e5 \u00ef\u00c8\u00cc,\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u00c4\u00be\u00e0\u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u0090\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c2\u00c9.\n\n\u00be\u00f8\u00da\u00c2\u00c8 \u00ef\u00be\u00e5\u00c9\u00be\u00a8\u00f2\u00e8\u00c6\u00e5 \u00c4\u00e5\u00da\u00aa.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba83\n\nVI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4\n\n\u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4"
