    "chunk_text": "\u00ac\u0081\u00b9\u00b6\u00c7\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00cd\u00c1\u00cc\u00bd\u00c7\u00dd \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00b4\u00be\u00c6\u00af\u00b4\u00b7\u00c6\u00b6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00be\u00c6\u00a4\u00b4\u00c6\u00cd\u00b1\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b9\u00bb\u00ce\u00bc\u00b9\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00be\u00c6 \u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00f2\u0081\u00de \u00ba\u00c7\u00b6+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00bf\u00c6\u00bf\u00c7\u00af \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c7\u00de \u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00dd\u00af\u00c6\u00d0 \u00cd\u00c1\u00ae\u00d5\u00cd\u00af\u00c7\u00cc\u00bf\u00c7\u0081\u00de \u008c\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(2) \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00bc\u00c7\u00be\u00c6\u00b9\u00b5\u00c8\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00de \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00a4\u00de \u00c1\u00c7\u00bc+\u00c6\u00af\u00ce\u00bf\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u00b4\u00cc\u00c1\u00c7\u00dd \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00bf\u00c6\u00bf\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00b6\u00c8\u00c1\u00c7\u00bf\u00bc\u00c6\u00a3\u00c1\u00bc\u00d7 \u00b6\u00bd\u00c6\u00de\u00b5\u00c8\u0089\u0081\u00cd\u00b9\u00bc\u00c8\u00be\u00c6 \u00a3\u00d9\u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b7\u00c9\u00ae\u00b4\u00af\u00c7\u00be\u00b9\u00c6 \u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00bf\u00c6\u00bf\u00c7\u00af\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00b5\u00c8\u00b9\u00c6\u00da\u00af\u00c6\u00d0\u00a5\u00b5+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u00e1\u00d0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(3) \u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00b5\u00c8\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00de\u00af\u00c6\u00d0 \u00a5\u00b5+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u00e1\u00af\u00b6\u00c6 \u00b6\u00c1\u00de\u00af\u00c8\u0081\u00bd \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c6\u00bd\u00c1\u00c7\u00bf\u00c8\u00bb\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00d0\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u0081\u00ba\u00c9\u00d7 \u00a5\u00bc\u00ae\u00d5 \u00a5\u00be\u00b4\u00c6\u00b1\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a4\u00bf\u00c7\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 07 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c611\n\n11\u00b0 (1) \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de \u00b6\u00b8\u00c8\u00bb\u00c7\u00bc\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00af\u00a5\u00be\u00c6\u00be\u00c7\u00cc\u00b6\u00c7\u00c0\u00c8\u00dc\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u00a3\u00d7\" \u201c(\u00b6\u00b8\u00c8\u00bb\u00c7\u00bc\u00c6)\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00be\u00c6\u00ce\u00be\u008c\u00b4\u00c6\u00d5\u008c\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 8 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00b5+\u00c6\u00af \u00a3\u00b6\u0081 \u00cc\u00b9\u00bb\u00ce\u00bc \u00ba\u00c7\u00bd\u00c6\u00bd\u00b6\u00c6 \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00c8\u00b6\u00c6\u00b6\u00c8\u00dd\u00b9\u00c6\u00b9\u00b6\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00b6\u00b8\u00c8\u00bb\u00c7\u00bc\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00be\u00c6\u00be\u00c7\u00b6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de 29\u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b6\u00b8\u00c8\u00bb\u00c7\u00bc\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00af \u00c1\u00dd\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u00a3\u00d7\u00a3\u00b6\u0081 \u00cc\u00b9\u00bb\u00bc\u00c8\u00be\u00c6 \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00be\u00c6\u00df\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0 (\u00b6\u00b8\u00c8\u00bb\u00c7\u00bc\u00c6)\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 8 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00b5+\u00c6\u00af \u00a3\u00b6\u0081 \u00cc\u00b9\u00bb\u00ce\u00bc \u00ba\u00c7\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00c8\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf\u00b6\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(3) \u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de \u00b7\u00c8\u00bc\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00af \u00c1\u00dd\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u00a3\u00d7\" \u00a3\u00b6\u0081 \u00cc\u00b9\u00bb\u00bc\u00c8\u00be\u00c6 \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00be\u00c6\u00df\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af\u00af\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c68 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00b5+\u00c6\u00af \u00a3\u00b6\u0081\u00cc\u00b9\u00bb\u00ce\u00bc \u00ba\u00c7\u00bd\u00c6\u00bd\u00b6\u00c6 \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00c8\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf\u00b6\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(4) \u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00de \u00b7\u00c8\u00bc\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00af \u00a5\u00be\u00c6\u00be\u00c7\u00cc\u00b6\u00c7\u00c0\u00c8\u00dc\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u00a3\u00d7\" \u00a3\u00b6\u0081\u00cc\u00b9\u00bb\u00bc\u00c8\u00be\u00c6 \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af\u00af\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00c1\u00ce\u00bc\u00bb\u00de\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00be\u00c6\u00ce\u00be\u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 8 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00b5+\u00c6\u00af \u00a3\u00b6\u0081 \u00cc\u00b9\u00bb\u00ce\u00bc \u00ba\u00c7\u00bd\u00c6\u00bd\u00b6\u00c6 \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00c8\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf\u00b6\u00c7\u00af\u00af\u00c6\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0"
