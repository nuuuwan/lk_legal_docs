    "chunk_text": "(\u00a7\u00a7\u00a7\u00a7) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c6 \u00ac\u00dd \u00c1+\u00c6\u00af\u00c8\u00bb\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00dd\u00b7\u00c8\u00b6\u00c8 \u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c7\u00af \u00a5\u00be\u00c6\u00be\u00c7\u00b6\u008c\u00b4\u00b6\u00c6\u00d7\" 2007\"\u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081\u0089\u0081\u00b8\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00ba\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6 \u00a9\u00b7\u00c6\u00b6\u00af\u00c6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00cc\u00af\u00b8 \u00a4\u00bb\u00c6\u00b7\u00c6\u00b6\u00bd\u00c8\u00bb\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00b8\u00cd\u00c1\u00c7\u00a3\u00b7\u00c6\u00b6\u00af\u00c6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081\u00cd\u00b9\u00c7\u00d7 \u00a3\u00bd\u008c\u00b4\u00db\u0088\u00bb\u00c7\u00b6\u00b8\u00c1\u00c7\u00af \u00c1\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf\u00b6\u00c7\u00af \u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00a3\u00bf\u00e2\u00af\u00c6\u00d0 \u00ab\u00bb\u00af\u00c6\u00af\u00b4\u0081\u00af\u00e0\u00af\u00c6\u00d0 \u00b7\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8\u00b6\u00c7\u00af \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 \u00af\u00dd\u00d7\u00af\u00c8\u0081\u00bd\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af :\n\n\u00a5\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u201c\u00b7\u00c8\u00b6\u00c8\u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00d7 147 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00a3\u00b1\u00c6\u00cc\u00b1\u00c7\u00be\u00c6\u00be\u00ce\u00ba\u00b9\u00c6\u0089\u00bd\u00c6\u00d0\u00b6\u00c6 \u00b6\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00c1\u00c7\u00bd\u00c7\u00b8\u00a3\u00cd\u00b6 \u00cc\u00b9\u00c7\u00dd\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c615\n\n(5)\u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00aa) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\" \u00a3\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00c6\u00af\u00c7\u00b8\u00af\u00c7\u00b9\u00c6\u00da\u00c1\u00c7\u00b1\u00af+\u00c6\u00af\u00ce\u00bf \u008c\u00b4\u00c6\u00d5 \u008c\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\u201d\u00b0\n\n(6)\u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 (\u00ad) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00c6\u00af\u00c7\u00b8 \u00af\u00c7\u00b9\u00c6\u00da\u00c1\u00c7\u00b1\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 :-\n\n(\u00a3) \u00a3\u00af\u00c6\u00af\u00c7\u00b9\u00c6\u00da \u00c1\u00c7\u00b1\u00af\u00b6\u00c6\u00b6\u00c8\u0081 (iv) \u00a4\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\u201c\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b1\u00be\u00e2\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\"\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u201c\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6\u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b1\u00be\u00e2\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 ;\n\n(\u00a4) \u00a3\u00af\u00c6\u00af\u00c7\u00b9\u00c6\u00da \u00c1\u00c7\u00b1\u00af\u00b6\u00c6\u00b6\u00c8\u0081 (v) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\u201c\u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a3\u00d9\u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c\u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a3\u00d9\u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c7\u00af\u00c7\u00d7 :\n\n\u00a5\u00af\u00c6\u00af\u00c7\u00b9\u00c6\u00da \u00c1\u00c7\u00b1\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201c\u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b1\u00be\u00e2\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00c7\u00af\u00b8\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00d0\u00b6\u00c6\u00b6\u00ce\u00af \u00c1\u00c7\u00b4\u00ce\u00af\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de\u00c1\u00c7\u00b4\u00ce\u00af\u008a\u0081 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u008c\u00b8\u00d7 \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00c7\u00af\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u008b\u0081\u00cc\u00b1\u00be\u00ce\u00c1 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\u201d; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(7)\u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00b4) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00ce\u00bb \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u00ce\u00bb\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :\n\n(\u00b5) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00bf\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a7\u00bb\u00bc\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00ce\u00be\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u00d5\u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00ba\u00c6 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u00ac\u00b6\u00c6\u00b6\u00c8\u00ce\u00b1\u00e2\u00b1\u00c6 \u00cc\u00b1\u00be\u00e2\u00af\u00bf\u00c6\u00b0\u201d\u00b0\n\n11\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 26 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008126 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c616\n\n(1)\u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u2013\n\n(\u00a3) \u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00ac\u00bf) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u2013\n\n(i) \u00a3\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 (i) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\" \u201c97 \u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a5) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00a3\u00d9\u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00af\u00b4\u00b8\u00c8\u0081 \u00a4\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00ce\u00bb\u008c\u00b4\u00af\u00c6 \u00e7\u00d5\u00b6\u00be\u00c7\u00af\u00e2\u00bf\u00c6\u00bf\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c97 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081(1)\u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a5) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00a3\u00d9\u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00af\u00b4\u00b8\u00c8\u0081 \u00a4\u00af\u00af\u00c6\u00e7\u0088\u00bb\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6;"
