    "chunk_text": "(7) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0\u00cc\u00e8\u00f3 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00c6\u008a\u00ef\u00c0\u00f2\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00c2\u00f3\u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00bc\u00e5\u00ce \u00cc\u00e8\u00c6\u00f5\n\n\u201c\n\n2007 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb\u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba10\n\n8.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 76 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e03 \u00c9\u00be \u00a1\u00ba\u00eb\u00c7\u00e6 \u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 \u201c\u00ba\u00f2\u00e8\u00ef\u00c7\u00e5\u00e0\u00bc \u00c7\u00bb \u00cc\u00bf\u00cd\u00e5 \u00a8\u00c8\u00e0\u00c2\u00f3 \u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4\u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5 \u00cd\u00e6\u00c7,\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00ba\u00e0\u00cd\u00e6\u00d7\u00ef\u00c4\u00be\u00e0 \u00cc\u00cd \u201c\u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00ce\u00cd\u00e6\u00a8\u00f8 \u00cc\u00e6\u00c0\u00c6\u00ea\u00c4\u00a8\u00e0 \u00c2\u00c9\u00b4 \u00c0\u00ba\u00e0\u00c9\u00be\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8\u00cc\u00e6\u00c0\u00c6\u00ea\u00c4\u00a8\u00e0 \u00c2\u00c9\u00b4, 2006 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 31 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00ef\u00c0\u00c7 \u00c0\u00ba\u00e0\u00c9\u00be\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00cd\u00e5 \u00a2\u00c8\u00a8\u00e0\u00a8\u008a \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n9.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 II \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u2014\n\n(\u00a1) (vi) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00e0 \u201c\u00aa\u00eb\u00c9\u00be\u00e0 \u00c6\u00e5\u00be\u00e5 \u00a2\u00be\u00e0\u00bd\u00be \u00cc\u00cd \u00be\u00e6\u008c\u00cc\u00bf\u00cd\u00e5 \u00ef\u00ba\u00c8\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4, \u201c\u00aa\u00eb\u00c9\u00be\u00e0 \u00c6\u00e5\u00be\u00e5 \u00a2\u00be\u00e0\u00bd\u00be,\u00be\u00e6\u008c \u00cc\u00bf\u00cd\u00e5 \u00ef\u00ba\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00cc\u00e2\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba \u00c9\u00da\u00aa\u00fb\u00a8\u00c7\u00b8 \u00ca\u00fb\u00da\u00cb \u00a1\u00e2\u00a8 2710. 19. 60 \u00c6\u00b4\u00ef\u00ba\u00e0\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a2\u00be\u00e0\u00bd\u00be \u00ef\u00ba\u00c8\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00cc\u00cd \u00a2\u00c8\u00a8\u00e0\u00a8\u008a\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n(\u00a1\u00e5) (vii) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00e0 \u201c\u00ef\u0089\u00f2\u00c8\u00e0 \u00c8\u00e8\u00c6\u00be \u00c0\u00ea\u00c9\u00c7\u00e6\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00ef\u00c9\u00be\u00ea\u00c9\u00b4, \u201c\u00ef\u0089\u00f2\u00c8\u00e0 \u00c8\u00e8\u00c6\u00be \u00c0\u00ea\u00c9\u00c7\u00e6 \u00cc\u00cd \u00a6\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00e5\u00c2\u00e5\u0093\u00ba\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00c4\u00ba \u00a6\u00c4\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00cd\u00be\u00c9\u00c8 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00ef\u00aa\u00be \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec, \u00a1\u00e5\u00c2\u00e5\u0093\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c3\u00e5\u0097\u00ba \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c3\u00e5\u00b8\u00e0\u00b6\u00c6\u00a8\u00e0\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n(\u00a1\u00e6) (xiv) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00a1\u00c6\u00fa\u00ba\u00c4\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(xv) \u00a2\u00cc\u00e0\u00cc\u00be\u00e0\u201d.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00c0\u00ce\u00c4\u00ea\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e076 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb\u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba11\n\n(2) \u00a6\u00cd\u00fa (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u2014\n\n(\u00a1) (xvi) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00a1\u00c6\u00fa\u00ba\u00c4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(xvii) \u00c6\u008a \u008e\u00ba\u00f2\u00c0\u00b4\u00c6\u00a8\u00e0 \u00ef\u00c2\u00bc\u00e5 \u00cd\u00e6\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00bc\u00da\u00ca\u00be\u00c6\u00a8\u00e8\u00d7\u00c4 ;\n\n(xviii) \u00c6\u008a \u008e\u00ba\u00f2\u00c0\u00b4\u00c6\u00a8\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00e8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec\u0097\u00bc\u00f1\u00e5\u00aa\u00e5\u00c7 \u00c0\u00cd\u00cc\u00ea\u00a8\u008a;\n\n(xix) \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00fa\u00ba \u00a1\u00ba\u00e0\u00a8\u008a \u00ef\u00c7\u00bc\u00fa;\n\n(xx) \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00fa\u00ba \u00ef\u00c0\u00e5\u00c8\u00e0\u00ef\u00ba\u00c8\u00e0;\n\n(xxi) \u00c6\u008a \u00c6\u00e5\u00ba\u00f2\u00e5\u00c9\u00a8\u00e0 \u00a8\u00eb\u00c8\u00e8\u00c6\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4\u00a8\u00e0 \u00c9\u00be\u00ef\u00cc\u00e0\u00c9\u00e5,\u201d;\n\n(\u00a1\u00e5) \u00a6\u00cd\u00fa (i) (\u00a1) \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00e0 \u201c\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u0097\u00cb\u00c6\u00c6 \u00c4\u00e5\u00c8\u00e5\u00c9\u00a1\u00be\u00ea\u00aa\u00c4\u00be\u00c6 \u00a8\u00c7\u00be\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c\u0097\u00cb\u00c6\u00c4\u00e5\u00c8\u00e5\u00c9\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00a1\u00bd\u00f1\u00c0\u00be \u00ef\u00cc\u00e0\u00c9\u00e5 \u00ef\u00cd\u00e5\u00e0\u00a6\u00c9\u00e6\u00be\u00f8 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00c8 \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00ef\u00be\u00e5\u00c9\u00be \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00c6\u00a8\u00e0 \u00cd\u00e6\u00c7, \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u0097\u00cb\u00c6\u00c6\u00c4\u00e5\u00c8\u00e5\u00c9 \u00a1\u00be\u00ea\u00aa\u00c4\u00be\u00c6 \u00a8\u00c7\u00be\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd"
