    "chunk_text": "255.\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.222256.\u00c9\u00e6\u00b6\u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00c9\u00c8\u00e0, \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00a8\u00f8\u00d7\u008a \u00cc\u00cd \u00cc\u00c4\u00bb\u00c6\u00b4 \u00a6\u00ce\u00d0\u008a \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00f8\u00d7\u00c4.222257.\u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00ba\u00f8\u00ef\u00da\u00a8 \u00a1\u00e5\u00b3\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c9.224258.VIII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00bc\u00e5\u00ce \u00a8\u00f8\u00d7\u00c4.226259.\u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00c4\u00bb\u00c6\u00b4 \u00a6\u00ce\u00d0\u00c4\u00b4 256 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00bc\u00e5\u00ce \u00a8\u00f8\u00d7\u00c4.226\n\nXI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc - \u00a1\u00a8\u00e0 \u00ef\u00c9\u00c7\u00ce \u00cc\u00c4\u00e5\u00aa\u008a\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u0097\u0093\u0097\u00bd\u00e5\u00be\n\nXII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc - \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4\n\n(I) \u00c4\u00ec\u00c8\u00e8\u00a8\n\n\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00ef\u008a \u00a8\u00f2\u00c4\n\n266.\u201c\u00cc\u00cd\u00bc\u00e5\u00c6\u00a8\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00cd\u00fa \u00a1\u00da\u00bb \u00a8\u00bb\u00be\u00c6.230267.\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00ef\u008a \u00a8\u00f2\u00c4.230\n\nxiv\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\n\u00cc\u00cd\u00bc\u00e5\u00c6\u00a8\u00ef\u00c6\u00e5\u00e0\n\n268.\u00c9\u00da\u00ba\u00c4\u00e5\u00be \u00cc\u00cd \u00a1\u00e5\u00bc\u00e8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c9\u00aa\u00a8\u00f9\u00c4 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4\u00b4\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u00cc\u00ba\u00eb \u00c2\u00c8\u00c6.230269.\u00ef\u00aa\u00c9\u00e5 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00a1\u00e6\u00db\u00c6\u00ea\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00bc\u00e8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00c9\u00aa\u00a8\u00f9\u00c4.231\n\n(II) \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4\n\n270.\u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u0095\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5.231271.\u00b8\u00c6 \u00ef\u00aa\u00d1\u00c4\u00b4 \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8 \u00d1\u00c4 \u00c6\u00be\u00e0\u00ef\u00be\u00cd\u00fa \u00a1\u00da\u00bb \u00a8\u00bb\u00be\u00c6.232\n\n\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5\u00bc\u00e6\u00e4\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00ef\u00c0\u00ba\u00e0\u00cc\u00c4 \u00cc\u00cd \u00a6\u00cd\u00fa \u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\n\n272.\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5\u00bc\u00e6\u00e4\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4.233273.\u00ef\u00c0\u00ba\u00e0\u00cc\u008a \u0097\u00c3\u00e5\u00aa \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00e9 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00cc\u00ba\u00eb \u00c2\u00c8\u00ba\u00c8.234274.\u00cc\u00c4\u00e5\u00aa\u00c4\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00be\u00b6\u00ea \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00be\u00ba\u00c7 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00ba\u00cd\u00be\u008a\u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00c8\u00c6.235275.\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea \u00ef\u00bc\u00e0\u00c0\u00ce \u00a1\u00e5\u00bc\u00fa\u00c6 \u00be\u00e9\u00c6\u00e5\u00bc\u00be\u00c6\u00a8\u00f8\u00d7\u00c4 \u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00c4.236276.\u00ba\u00cd\u00be\u008a \u00a8\u00f8\u00d7\u00c4 \u00a1\u00e5\u00bc\u00fa\u00c6 \u00ca\u00eb\u00be\u00f1 \u00a8\u00f8\u00d7\u00c4.236\n\n\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5\u00bc\u00e6\u00e4\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00f8\u00d7\u00c4\n\n277.\u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00e8\u00d7\u00c4.236\n\n\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5\u00bc\u00e6\u00e4\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8 \u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\n\n278.\u00a1\u00e5\u00b3\u00e5\u00ef\u008c \u00c0\u00e8\u00b4\u00c0\u00ba\u00a8\u00e0 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00c6\u00e6\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.237279.\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00ef\u008a \u00bc\u00fb \u00be\u00b6\u00ea \u00be\u00ba\u00c7 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.237280.\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8 \u00c2\u00c8\u00c0\u00e7\u00c4.237\n\n\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5\u00bc\u00e6\u00e4\u00ef\u008a \u00bc\u00fb \u00be\u00f8\u00c8 \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\n\n281.\u00be\u00f8\u00c8 \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6.237282.\u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8 \u00bc\u00fb \u00be\u00f8\u00c8 \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00ba\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00c4.237283.\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00be\u00f8\u00c8 \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u00ef\u00c9\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.238284.\u00be\u00f8\u00c8 \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9.240\n\nxv\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\n\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00ef\u00c9\u00e5\u00e0"
