    "chunk_text": "\u00ef\u00c9\u00be\u00ba\u00e0 \u00c7\u00e5\u00b0\u00f1\u00c9\u00c8\u00b4\u00cc\u00cd\u00e5\u00c6 \u00bc\u00fb\u00c4\u00b4\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9\u00b4 \u00a1\u00e6\u00ba\u00f8\u00a8\u00e5\u00da\u00c6 \u00c3\u00e5\u00c7\u00c6.\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8\u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa.\n\n182006 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4 \u00c9\u00e2\u00ae\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00be\u00ba\n\n32.\u00c0\u00bc \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00be\u00f1\u00e5\u00da\u00bb\u00c6\u00a8\u00e0 \u00a1\u00c9\u00ca\u00f1 \u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u0095\u00cc, \u00ef\u008a\u00c0\u00be\u00ef\u00ba\u00cd\u00fa :\u2014\n\n\u201c\u00c2\u00c8\u00c6 \u00c0\u00e6\u00c9\u00d7\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4 \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00be\u00e0\u00be\u00e5 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0\u00a1\u00be\u00ea\u00c4\u00e6\u00ba\u00f8\u00c6 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00c8\u00e8\u00c6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c. \u00c2\u00c8\u00c6 \u00c0\u00e6\u00c9\u00d7\u00ef\u008a\u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00c8\u00e8\u00c6 \u00cd\u00b9 \u00cd\u00df\u00be\u00e5\u00aa\u00e6\u00be\u00f9\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u0097\u00bc\u00f1\u00ea\u00ba\u00e0 \u00c4\u00e5\u00da\u00aa\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u00f3\u0097\u00c6 \u00cd\u00e6\u00a8 ;\n\n\u201c\u00a8\u00e5\u0086\u00c0\u00ba\u00e0 \u00bc\u00c7\u00be\u00e0\u00be\u00e5\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00d1\u008a\u00a4\u00c0\u00a8\u00f2\u00c4 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0\u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00ef\u00c9\u00ba \u00bc \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0\u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8 \u00c0\u00f2\u00ba\u00e8\u00c8\u00e5\u00c3 \u00a4\u00ef\u00bc\u00cc\u00e5 \u00bc \u00a6\u00c4 \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u00ef\u00c6\u00e0 \u00be\u00c4\u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00be \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00c9\u00f1\u00e5\u00b0 \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c9\u00f1\u00e5\u00b0, \u00cc\u00e5\u00c9\u00bc\u00f1, \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00c7\u00be\u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e5\u00b0 \u00ef\u00c8\u00cc \u00cc\u00a8\u00cc\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8 \u00cd\u00df\u00be\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u00c9\u00f1\u00e5\u00b0\u00c9\u00be \u00cc\u00e2\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c; \u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00a8\u00e5\u0086 \u00cc\u00e7\u00bc\u00fb\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a \u00a4\u00c0\u00a8\u00c7\u00b8\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c6\u008a\u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00c4\u00ba \u00bc\u00ba\u00e0\u00ba \u00a6\u008a\u00ef\u00c2\u00e5\u00e0\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4, \u00bc\u00ba\u00e0\u00ba \u00cc\u00b4\u00cd\u00be\u00e0\u00a8\u00f8\u00d7\u00c4, \u00bc\u00ba\u00e0\u00ba \u00c9\u00e5\u00da\u00ba\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00c2\u00b6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c3\u00e5\u0097\u00ba\u00e5\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00f8\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00c7\u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u0097\u00bc\u00f1\u00ea\u00ba\u00e0 \u00ae\u00ea\u008a\u00c2\u00a8 \u00cc\u00cd\u00fa\u00ba\u00ef\u00cd\u00e5\u00e0 \u0097\u00bc\u00f1\u00ea\u00ba\u00e0 \u00a8\u00f2\u00c4\u00c6\u00b4 \u00a1\u00be\u00ea\u00c9 \u00c9\u00ec \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00a4\u00c0\u00a8\u00c7\u00b8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c6\u00be\u00e0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c. \u00ba\u00c9 \u00bc, \u00a6\u00c4\u00a4\u00c0\u00a8\u00c7\u00b8\u00c6 \u00c9\u00f1\u00e5\u00b0 \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00c7\u00b8 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u00bc \u00c3\u00e5\u0097\u00ba\u00e5 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6 ;\n\n\u201c\u00c0\u00d6\u00aa\u00b8\u00a8\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00c0\u00e8\u00d6\u00cc\u00e6\u00a8\u00cc\u00ea\u008a \u00a8\u00f8\u00d7\u00ef\u008a \u00cd\u00e6\u00a8\u00f8\u00c6\u00e5\u00c9\u00a1\u00e6\u00ba\u00f8 \u0097\u00bc\u00f1\u00ea\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c4\u00e5\u00be \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n192006 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4 \u00c9\u00e2\u00ae\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00be\u00ba\n\n\u201c\u00bc\u00ba\u00e0\u00ba\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00c0\u00d6\u00aa\u00b8\u00a8\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8 \u00c3\u00e5\u0097\u00ba\u00c6\u00cc\u00bf\u00cd\u00e5 \u00cc\u00ea\u00f3\u00cc\u00ea \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00b4 \u00cc\u00a8\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00cd\u00e5\u00e0 \u00cc\u00a8\u00cc\u00e0 \u00a8\u00c7\u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00d6\u00aa\u00b8\u00a8\u00c6\u00a8 \u00aa\u00c2\u00b6\u00e5 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00a4\u00ba\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u00a8\u00c8\u00e0\u00c0\u00c9\u00c8 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00a8\u00e0\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00c9\u00e2\u00ae\u00be\u00f8\u00a8 \u00a2\u00c8\u00e0\u00f5\u008a \u00c0\u00ba\u00f2\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00a1\u00cc\u00ba\u00f1 \u00ef\u00c8\u00e0\u00a9\u00be, \u00a1\u00cc\u00ba\u00f1\u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6, \u00c9\u00f1\u00e5\u00b0 \u00cd\u00e6\u00df\u00be\u00ea\u008a\u00c0\u00ba\u00e0 \u00cc\u00cd \u00c8\u00e8\u00c0\u00e8\u00be\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00a1\u00cc\u00ba\u00f1 \u00a8\u00c7\u00e6\u00b8\u00ea \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u00c7\u00bc\u00fa \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00a1\u00e6\u00ba\u00eb\u00c8\u00ba\u00e0 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc\u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00ef\u00c0\u00e5\u00ce\u00c5 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5\u00a2\u00c8\u00e0\u00f5\u008a \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;"
