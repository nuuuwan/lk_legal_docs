    "chunk_text": "4.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 4\u00a1 \u00cc\u00cd 4\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 , \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00e8\u00be\u00e0 \u00a6\u00e0\u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 4\u00a1\u00e5 \u00cc\u00cd 4\u00a1\u00e6 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00be\u00e6\u00c9\u00ba \u00a1\u00e2\u00a8 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n5.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 1 \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 4 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00a1\u00ba\u00c7, \u00a6\u00c6, \u00a6\u00e0 \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 4\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6 :\u2014\n\n(2) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00c0\u00f2\u00bd\u00e5\u00be \u0097\u00bd\u00e5\u00c6\u00a8 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0\u00c8\u00e8\u008d\u00ba \u00a1\u00be\u00ea\u00c4\u00ba\u00c6 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9, (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e6\u00c8 \u00c7\u00a8\u00e0\u00cb\u00e8\u00ba \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba\u00c6\u008a \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8 \u00ba\u00e5\u00c9\u00a8\u00e5\u00c8\u00e8\u00a8 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\n\n4\u00a1 \u00cc\u00cd 4\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f84\u00a1\u00e5 \u00cc\u00cd 4\u00a1\u00e6\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00be\u00e6\u00c9\u00ba \u00a1\u00e2\u00a8\u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e04\u00a1 \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n\u201c\u00a1\u00e6\u00c8 \u00c7\u00a8\u00e0\u00cb\u00e8\u00ba\u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00b4 \u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a2\u00b6\u008a \u00ef\u00aa\u00e5\u00b6\u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00cd\u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba7\n\n\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00ea\u00cd \u00a2\u00bc\u00fa \u00a8\u00c7\u00be\u00ea\u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00ef\u008a \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00bc\u00be\u00ea\u00c8\u00c2\u00be \u00a1\u00be\u00ea\u00c4\u00ba\u00c6\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00e8\u00be\u00e0 \u00a2\u00b6\u00c4 \u00c0\u00e8\u00cd\u00fa\u0090\u00ef\u00a8\u00e5 \u00b5\u00e5\u00cc\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ce\u00e5\u00ef\u00ba\u00e0 \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0\u00ef\u00cd\u00e5\u00e0 \u00c0\u00ce\u00e5\u00ba\u00e0 \u00a2\u00b6\u008a \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00be\u00f8\u00da\u00ef\u00bc\u00e0\u00ca\u00c4\u00ba \u00c0\u00f2\u00bd\u00e5\u00be \u0097\u00bd\u00e5\u00c6\u00a8 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00be\u00f8\u00c6\u00c4 \u00cd\u00e5 \u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8\u00c9\u00c8\u00b4\u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00e8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00a8\u00b6\u00a8\u00c7\u0095\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba\u00c6\u00a8\u00e0 \u00ef\u00bc\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 \u00c6\u008a \u00be\u00f8\u00c6\u00c4 \u00cc\u00cd\u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00bc \u00a6\u00e0 \u00be\u00f8\u00c6\u00c4 \u00cc\u00cd\u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00d6\u00be \u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c4 \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00c7\u00bc\u00a8\u00b4\u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00a8\u00b6\u00a8\u00c7\u0095\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00c7\u00be \u00c2\u00c9 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00c0\u00f2\u00bd\u00e5\u00be\u0097\u00bd\u00e5\u00c6\u00a8 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00bc\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8,(2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a8\u00b6 \u00a8\u00c7\u0095\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0, \u00a7\u00cd\u00ea \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00be\u00e0 \u00c9\u00ce\u00a8\u00e0\u00c9\u00be \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0 \u00cc\u00cd \u00a1\u00e6\u00c8 \u00c7\u00a8\u00e0\u00cb\u00e8\u00ba\u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00a6\u00c9\u00e6\u00be\u00f8 \u00c6\u008a \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00a2\u00bc\u00e8 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00ea\u00cd\u00c6\u00a8\u00e0\u0094\u00bf \u00ef\u00cd\u00ce\u00e9\u00c4\u00b4 \u00c2\u00c8\u00c6 \u00ef\u00bc\u00be \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00e8\u00d7\u00c4\u00cc\u00bf\u00cd\u00e5, \u00a1\u00e6\u00c8 \u00c7\u00a8\u00e0\u00cb\u00e8\u00ba \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba\u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6 \u00c0\u00e8\u00cd\u00fa\u0090\u00ef\u00c6\u00e0 \u00c6\u008a \u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00a8\u00a1\u0093\u00a8\u00c7\u00b8 \u00c2\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00bc, \u00a6\u00e0 \u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00ef\u00c9\u00ba \u00c0\u00f2\u00bd\u00e5\u00be \u0097\u00bd\u00e5\u00c6\u00a8 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6."
