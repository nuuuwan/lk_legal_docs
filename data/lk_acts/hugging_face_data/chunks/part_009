    "chunk_text": "\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00a6\u00e0 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c8 \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u00ef\u00c8\u00cc \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00c6\u00e5\u00e0\u00aa\u00f1 \u00c6\u00c6\u00fa \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00b4 \u00ef\u00c0\u00be\u00f9 \u00aa\u00fa\u00c6\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0, \u00a6\u00e0 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00ef\u008a \u00bc\u00fb \u00be\u00f8\u00c8 \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u00ef\u00c8\u00cc \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00a6\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7, \u00a6\u00ef\u00cc\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a6\u00e0 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5\u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00ef\u008a \u00bc\u00fb \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c8 \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6, \u00a1\u00bc\u00e5\u00ce \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00cc\u00c4\u00e5\u00aa\u00ef\u008a\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00c9 \u00cc\u00e8\u0090 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u0091 \u00ef\u00bc\u00be\u00a8\u00eb\u00ef\u00cd\u00e5\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc, \u00a6\u00bc\u00fa\u00be\u00b4 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5\u00c9 \u00cc\u00e8\u0090 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00c8\u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c0\u00cd\u00ba\u00cc\u00bf\u00cd\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00a1\u00ba\u00eb\u00ef\u00c7\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00bc, \u00a1\u0093\u00a8\u00c7\u00b8\u00ef\u00c6\u00e0 \u0097\u00bd\u00e5\u00be\u00c6\u00b4\u00c6\u00b4\u00ba\u00e0\u00c9, \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00cc\u00ba\u00f1\u00e5\u00c6\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\u2014\n\n(\u00a1)\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0 \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0 \u00d1 \u00cc\u00e8\u0090\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 ;\n\n(\u00a1\u00e5)\u00cc\u00c4\u00e5\u00aa\u00c4 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00ef\u00c4\u00cd\u00fa \u00c8\u00e5, \u00a1\u00bc\u00e5\u00ce \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7 \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc\u00a8\u00e0\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u0097\u00b4\u00a8, \u00cd\u00c9\u00ea\u00c8\u00e0\u00c9\u00ec\u00c9\u00be\u00e0 ;\n\n(\u00a1\u00e6)\u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00cd\u00fa \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c9 \u00cc\u00e8\u0090\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00f9 \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00cd\u00fa \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c9 \u00cc\u00e8\u0090\u00c6\u00e5 \u00c9\u00ec \u00bc, \u00be\u00f8\u00c8 \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00c4\u00ba\u00c6 \u00a1\u00be\u00ea\u00c9, \u00a1\u00c9\u00ca\u00f1 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00c8\u00c2\u00e5\u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 ;\n\n(\u00a1\u00e7)\u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00a1\u00bc\u00e5\u00ce \u00c9\u00be \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00f9\u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00c9 \u00cc\u00e8\u0090 \u00cc\u00cd \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00f9 \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00c9\u00cc\u00e8\u0090 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00cd\u00fa \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00cd\u00fa \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c9 \u00cc\u00e8\u0090 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0.\n\n\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00be\u00f8\u00c8\u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00ef\u00c9\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba239\n\n(3) \u00a1\u00bc\u00e5\u00ce \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00bc\u00fa\u00be \u00bc\u00cd\u00cd\u00ba\u00c7\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00c8 \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u00ef\u00cd\u00e5\u00e0 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u0097\u00cc\u00e8\u00be\u00e0, \u0097\u00ef\u00ca\u00e0\u00cb \u00ef\u00cd\u00e0\u00ba\u00eb \u00c4\u00ba \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00bc\u00fb\u00da\u00ab \u00a8\u00ce \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00e8\u00be\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00cc\u00cd\u00bc\u00fa\u00c9\u00ea\u00c7\u00e6\u008a \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00f8\u00d7\u00ef\u00c4\u00cd\u00fa \u00c8\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00c9\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00cd\u00e5 \u00bc\u00fa\u00c9\u00ea\u00c7\u00e6\u008a \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00f8\u00d7\u00c4\u00cc\u00cd \u00cc\u00a8\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd \u00a6\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00bc, \u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00cc\u00cd\u00aa\u00ba \u00c6\u00c6\u00fa \u00be\u00f8\u00c8 \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00cd\u00e5 \u0097\u00c6\u00bc\u008a, \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00ef\u00c9\u00ba \u00a1\u00c3\u00e8\u00c6\u00e5\u00ae\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9,\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa, \u00be\u00f8\u00c8 \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e5\u00c9\u00a8\u00e5\u00c8\u00e8\u00a8\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c9\u00ba\u00e0\u00a8\u008a\u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
