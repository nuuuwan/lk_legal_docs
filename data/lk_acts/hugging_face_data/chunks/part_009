00ce\u00ba\u00b0\n\n14 2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 30 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00a7\u00b9\u00c7\u00bb+\u00c6\u00af\u00bf\u00c8\u0081 \u00cd\u00ba\u00c7\u00b1\u0088\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(3) \u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6\" \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c7\u00b8 \u00da\u00be\u00b8\u00c7\u00bb\u00c6\u00cc\u00c1\u00c7\u0081\u00bd\u00c8\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00b6\u00bc\u00ce\u00c1 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00b6\u00af\u00c1\u00ce\u00be \u00cc\u00c1\u00bf\u00c8\u008c\u00d5\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af\u00af\u00c6 \u00d0\u0088\u008a\u00bb\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00bd\u00c6\u00bd\u008c\u00bb\u00bd\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a4\u00bf\u00c7\u00af\u00c8\u0081\u00bd\u00c1\u00bc\u00c7\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n(4) \u00ad\u00bc\u00c7\u00ba\u00c6\" (2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00e2\u00af\u00bf\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf \u00ba\u00c9\u00de\u00af\u00c8\u0081\u00bd\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c7\u00bf\u00c6\" \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c6\u00bd\u00c1\u00c7\u00bf\u00c8\u00bb\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081\" \u00d0\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u