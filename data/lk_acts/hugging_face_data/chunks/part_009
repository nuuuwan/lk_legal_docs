    "chunk_text": "\u00b6\u00ce\u00be\u00b9\u00c6\u00da153\u00af\u00ba\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00cd\u00b1\u00ce\u00c1\u00af\u00bf\u00c6\" \u008c\u00c1\u00b1\u00c7\u008a\u00af\u00bf\u00c6 \u00b1\u00f2\u00af \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c6\u00b7\u00c8\u00af\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00ba\u00c6 1 \u2013 \u00cc\u00b1\u00bb\u00be\u00c6\u00db\u00ce\u00bd\u00b1\u00c6 \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00b7\u00c8\u00af\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00ba\u00c6 2 \u2013 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\n\n\u00b6\u00ce\u00be\u00b9\u00c6\u00da281\u00af\u00ba\u00b7\u00be \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00b6\u00c6 \u00b6\u00c8\u00ce\u00b5\u00af\u00c6\u00af\u00bf\u00ba\u00c6\u00b7\u00c8\u00af\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00ba\u00c6 1 \u2013 \u00cc\u00b1\u00bb\u00be\u00c6\u00db\u00ce\u00bd\u00b1\u00c6 \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00b7\u00c8\u00af\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00ba\u00c6 2 \u2013 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\n\n\u00a3\u00ce\u00ba\u00e2 \u00c1\u00dd\u00ba\u00c7\u00de :\n\n\u00b6\u00ce\u00be\u00b9\u00c6\u00da154\u00b6\u00c7\u00c1\u00bc\u008c\u00bb\u00be\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u008c\u00be+\u00c6\u00af\u00c8\u00bb\u00be\u00c6 \u00b9[+\u00c6\u00af\u00c7\u00af\u00c6\u00af\u00bf\u00c6 \u00cd\u00ba\u00ba\u00c6\u00b9\u00c7\u00b4\u00c6\u00d5 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c6\u00b7\u00c8\u00af\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00ba\u00c6 1 \u2013 \u