5\u00be\u00b1\u00c6\u00b1\u00c8\u00ce\u00b8\u00bb\u00c7\u00b8\u00d7 \u00db\u00af\u00c7\u00ce\u00ba\u00b1\u00c6 \u00b1\u00ce\u00b9\u00bb\u00c7\u00be\u00c6 \u00db\u00ce\u00bd\u00bb\u00c7\u00af \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00db\u0081\u00b8\u00c8\u00ce\u00be\u008a\u00be\u0081\u00bd\u00c8 \u00a9\u00b6\u00c6\u00b6\u0081\u00ce\u00ba\u00b6\u00c6\u00b6\u00c7\u00b8\u00d7\u00ba\u00c7\u00b8 \u00a9\u00b1\u00c6\u00b1\u00c7\u00b6\u00b8\u00b6\u00c6\u00b6\u00c8\u00df\u00ba\u00c6 \u00cc\u00b9\u00c7\u00bd\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c6 \u00b6\u00c7\u00ba\u00c6 \u00b1\u00f2\u00af\u00ba\u00c7\u008a\u00dd\u00b7\u00c6\u00b6\u00ce\u00ba\u00af\u00c6\u00d0\u00a3\u00ce\u00b4\u00bb\u00c7\u00bf\u00ba\u00c7\u00af \u00a3\u00b1\u00c6\u00b1\u00c7\u00b6\u00b8\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b6\u00ba\u00d7 \u00cc\u00b9\u00bb\u00bc\u00c6\u00af\u00ce\u00bf \u00a9\u00e1\u00b6\u00c8\u00af\u00c6\u00ce\u00af\u00cc\u00bb\u00c7\u00b9\u00c6\u00b9\u00ba\u00c8\u00d5\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00ce\u00af\u00cc\u00bb\u00c7\u00b9\u00c6\u00b9\u00ba\u00c8\u00d5\u00b6\u00be\u00c7\u00b8\u00d7 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c7\u00bf\u00c6 \u00b1\u00c7\u00b4\u00c6\u00b1\u00c8\u00bb\u00c7\u00af\u00af\u00c6 \u00ce\u00af\u00cc\u00bb\u00c7\u00b9\u00c6\u00b9\u00ba\u00c8\u00d5\u00c1\u00b6\u00c8\u00b8\u00c8\u0081\u00de\u00ba\u00c6 \u00b6\u00b8\u00c8\u00cd\u00c1\u00bd\u00c7\u00b8\u00b6\u00c7\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n10\u00b0(1) \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d5 \u00b9\u00b3\u00c6\u00b1\u00