    "chunk_text": "(\u00a1\u00e5) \u00a1\u00bc\u00e5\u00ce \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c9\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00e6\u00d6 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00b4\u00a1\u00c6\u00ba\u00e0\u00c9 \u00ba\u00f8\u00c2\u00ec \u00c6\u008a \u00ae\u00e2\u00ae\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00f8\u00be\u00e0\u00c0\u00e6\u00be\u00be\u00aa\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00ef\u00bc\u00e0\u00c0\u00ce \u00be\u00f8\u00cc\u00e5 \u00a1\u00e6\u00ba\u00f8\u00c9\u00be \u00cc\u00e8\u00c6\u00f5\u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a, \u00c2\u00c8\u00ba\u00c8, \u00c9\u00c7\u00c0\u00f2\u00cc\u00e5\u00bc, \u00a1\u0093\u00a8\u00e5\u00d6 \u00c2\u00c8\u00ba\u00c8 \u00cc\u00cd\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 ;\n\n(\u00a1\u00e6) \u00a1\u00bc\u00e5\u00ce \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c9\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8\u00c9\u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00e6\u00d6 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00cc\u00e8\u00c6\u00f5 \u00c2\u00e6\u00c7\u00a8\u008a ; \u00cc\u00cd\n\n(3\u00a1\u00e5) 76\u00a8 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (3) \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0(i) \u00a4\u00c0\u00ef\u00d8\u00bc\u00c6 \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9 \u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00e6\u00d6 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00ef\u00c9\u00ba \u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4\u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa\u2014\n\n(\u00a1)\u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00e6\u00d6 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c0\u00c9\u00c7\u00be \u00c8\u00bc \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00c9\u00ec \u00bc \u00a6\u00c4\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec\u00bc \u00a1\u00bc\u00e5\u00ce \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c9\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00c9\u00ec\u00ef\u00cd\u00e5\u00e0 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8\u00c9 \u00c0\u00c9\u00ba\u00f8\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d6\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00c0\u00e5\u00da\u00ca\u00c9\u00c6\u00a8\u00e0 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00e6\u00d6\u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c9\u00e5\u00cc\u00e8\u00c6\u00b4 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00cc\u00e8\u00c6\u00f5 \u00aa\u00fa\u0097\u00cc\u00ea\u008a, \u00a7\u00c0\u00e0\u00c0\u00ea,\u00c2\u00e6\u00df\u008a\u00a8\u00c7, \u00a6\u00a8\u00ad\u00ba\u00e5, \u00a1\u00e6\u00ef\u00b4\u00e5\u00e0\u00da\u00be\u00f8 \u00c2\u00c8, \u00ef\u00ef\u00be\u00ba\u00f8\u00a8\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba \u00c2\u00c8\u00ba\u00c8 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00be\u00e0 \u00cc\u00cd \u00a8\u00c9\u00c7 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2 \u00a1\u00bc\u00e5\u00ce \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4\u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00d1 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00aa\u00fa\u0097\u00cc\u00ea\u008a, \u00a7\u00c0\u00e0\u00c0\u00ea, \u00c2\u00e6\u00df\u008a\u00a8\u00c7, \u00a6\u00a8\u00ad\u00ba\u00e5,\u00a1\u00e6\u00ef\u00b4\u00e5\u00e0\u00da\u00be\u00f8 \u00c2\u00c8, \u00ef\u00ef\u00be\u00ba\u00f8\u00a8 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba \u00c2\u00c8\u00ba\u00c8\u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(\u00a1\u00e5)\u00c0\u00e6\u00cd\u00e6\u00c7\u00cd\u00e6\u00d6 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c0\u00c9\u00c7\u00be \u00c8\u00bc \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00c9 \u00a6\u00c4\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec\n\n2006 \u00a1\u00e2\u00a8 46 \u00bc\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba4\n\n\u00bc, \u00a1\u00bc\u00e5\u00ce \u00bc\u00fa\u00be\u00c6\u00a8\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c9\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00ef\u00be\u00e5\u00a1\u00c9\u00cc\u00be\u00e0\u00c9 \u00c0\u00c9\u00ba\u00f8\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00a8\u00c9\u00c7 \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0\u00c9\u00ec \u00cc\u00e8\u00c6\u00f5 \u00be\u00b6\u00ea \u00cc\u00cd \u00be\u00b6\u00ea \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a1\u00bc\u00e5\u00ce \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4\u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00c0\u00c9\u00c7\u00be \u00c8\u00bc \u00be\u00b6\u00ea \u00cc\u00cd \u00be\u00b6\u00ea \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00a1\u00be\u00ea\u00c9 \u00a6\u00e0 \u00be\u00b6\u00ea \u00cc\u00cd\u00be\u00b6\u00ea \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00bc\u00fa\u00aa\u00b4\u00c4 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5 \u00ef\u00aa\u00be \u00c6\u00e5\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00be\u00b6\u00ea\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7 \u00ef\u00aa\u00be \u00c6\u00e5\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6."
