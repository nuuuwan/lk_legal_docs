    "chunk_text": "(\u00a1\u00e6)\u00a6\u00e0 \u00cc\u00e8\u00c6\u00f5 \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u00a1\u0097\u0093\u00c4\u00ba\u00e0\u00a8\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8\u00d1\u00c4 \u00a1\u00ba\u00e0\u00cd\u00e6\u00c7 \u00bc\u00e6\u00e4\u00c4\u00b4 \u00a6\u00a8\u00ad\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a,\n\n\u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00a1\u00c9\u00c8\u00e2\u00aa\u00eb \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n(4) \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4 \u00a6\u00a8\u00ad\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a, \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00c8 \u00a1\u00b6\u00e5\u00c8\u00c9 \u00a8\u00c8\u00e0\u00ba\u00e6\u009f\u00c4 \u00cc\u00cd \u00ba\u00e6\u00be\u00e8\u00be\u00e0 \u00ba\u00e6\u00be\u00b4 \u00ef\u00aa\u00be\u00c6\u00e5\u00c4 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(6) \u00ef\u008a \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 1 (\u00a1) \u00ef\u00cd\u00e5\u00e0 1 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8\u00e0\u00bc\u00fa\u00be \u00ba\u00f8\u00cd\u00a8\u00b4 \u00a1\u00b6\u00ea \u00a8\u00e5\u00c8\u00c6\u00a8\u00b4 \u00a1\u00b6\u00e5\u00c8\u00c9 \u00a8\u00c8\u00e0\u00ba\u00c2\u00be \u00c8\u00bc \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a1\u00b6\u00e5\u00c8\u00c9 \u00a8\u00c8\u00e0 \u00ba\u00c2\u00be\u00c8\u00bc \u00db\u00cc\u00e0\u00d1\u00ef\u008a \u00bc\u00fb \u00a6\u00e0 \u00c2\u00c9 \u00bc\u00e6\u00be\u00ea\u008a\u00bc\u00fb\u00c4\u00a8\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e6\u00c7, \u00a1\u00b6\u00e5\u00c8\u00c9 \u00a8\u00c8\u00e0 \u00ba\u00e6\u00c2\u00ec \u00db\u00cc\u00e0\u00d1\u00ef\u008a \u00bc\u00fa\u00be\u00c6 \u00cd\u00e5\u00cc\u00e0\u00bb\u00e5\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00a1\u00c9\u00ca\u00f1 \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n3.\u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5\u2014\n\n(1) \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00cd \u00a7\u00cd\u00ea \u00c0\u00e6\u0095\u00b8 \u00cc\u00e8\u0090\u00be \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00e5\u0095\u00a8\u00c6\u00a8\u00eb \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00cd \u00a6\u00e0 \u00be\u00e5\u0095\u00a8\u00c6\u00e5 \u00c0\u00e6\u0095\u00b8 \u00cc\u00e8\u0090\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a7\u00cd\u00ea \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00c6 \u00ef\u008a \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 1(\u00a1), \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c8\u00cc \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00c6\u008a \u00be\u00e5\u0095\u00a8\u00c6\u00a8\u00eb\u00c6\u00be \u00ef\u00bc\u00ef\u00bc\u00be\u00e5\u00ef\u00aa\u00be\u00e0 \u00a8\u00c9\u00c7\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e6\u0095\u00b8 \u00ef\u00be\u00e5\u00cc\u00e8\u0090\u00be \u00c6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00db\u00cc\u00e0\u00d1\u00c4\u00b4 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00c9\u00be \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00c6\u00a8\u00eb \u00a6\u00e0 \u00db\u00cc\u00e0\u00d1\u00ef\u008a \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c8\u00cc \u00ef\u00ba\u00e5\u00e0\u00c7\u00e5\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00be\u008a \u00db\u00cc\u00e0\u00d1\u00ef\u008a \u00c4\u00ea\u00c8\u00cc\u00ea\u00be \u00aa\u00be\u00e0\u00be\u00e5 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00c9\u00ca\u00f1 \u00cc\u00e8\u00c6\u00f5 \u00ef\u00bc\u00e0, \u00ef\u008a \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 1 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00db\u00cc\u00e0\u00d1\u00c4\u00a8\u00e0 \u00a8\u00e6\u00bf\u00c9\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n4.\u00aa\u00b8\u00c0\u00ec\u00c7\u00b8\u00c6\u2014\n\n(1) \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u2013\n\n(\u00a1)\u00af\u00be\u00e0\u00bc\u00c6 \u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u00ba\u00eb\u00be\u00e0\u00ef\u00bc\u00be\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00e0\u00c0\u00f2\u00ba\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00be\u00e0 \u00c0\u00e6\u0095\u00b8 \u00cc\u00e8\u009b \u00be\u008a \u00ef\u00cd\u00e5\u00e0 \u00a7\u00c9\u00ea\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00e6\u00c0\u00e6\u00c8\u00e0 \u00af\u00be\u00e0\u00bc\u00c6 \u00c0\u00f2\u00a8\u00e5\u00ca\u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00be\u008a; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00af\u00be\u00e0\u00bc\u00c6 \u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cd\u00fa\u0095\u00a8\u008a \u00a1\u00e6\u00ba\u00f8 \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00e2\u00a9\u00f1\u00e5\u00c9 \u00ba\u00eb\u00be\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a, \u00af\u00be\u00e0\u00bc\u00c6 \u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cd\u00fa\u0095\u00a8\u008a \u00a1\u00e6\u00ba\u00f8 \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00be\u00e0 \u00c0\u00e6\u0095\u00b8 \u00cc\u00e8\u009b \u00be\u008a \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00c0\u00e6\u00c8\u00e0 \u00af\u00be\u00e0\u00bc\u00c6 \u00c0\u00f2\u00a8\u00e5\u00ca\u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00be\u008a,\n\n\u00aa\u00b8\u00c0\u00ec\u00c7\u00b8\u00c6\u00a8\u00e0 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n4712007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba"
