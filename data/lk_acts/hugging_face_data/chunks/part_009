    "chunk_text": "3\u00b0 (1) \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00df\u00ba\u00c6 \u00cd\u00c1\u00de \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u00b8 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00df\u00ba\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c6\u00d8\u00d6\u00af\u00c6\u00af\u00af\u00c6 \u00af\u00be\u00c6\u008c \u00b7\u00c8\u00de\u00c1\u00af\u00ba\u00c6\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00bf\u00c6 \u00a5\u00b4\u00ba\u00c6\u00cc\u00b9\u00de\u00ba\u00c6 \u00a5\u00b4+\u00c6\u00af\u00bf\u00c8\u00cc\u00be\u00be\u00c6\u00be\u00c7\u00ba\u00c6 \u00a3\u00c1\u00bd\u00c6\u00bd\u00c8\u00bd\u00c6\u00af\u00c7\u00af \u201c\u00be\u00af\u00c6\u0082\u00ba\u0081 \u00af\u00b6\u00c8\u00bc\u00c6\u00af\u00c7\u00ba\u00bc\u00c6 \u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1 \u00a7\u00bd\u00e2\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cc\u00b1\u00bb\u00be\u00c6\u00d8\u00d6\u00af\u00c6\u00af\u00af\u00c6 \u00af\u00be\u00c6\u008c \u00b7\u00c8\u00de\u00c1\u00af\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00bf\u00c6 \u00a5\u00b4\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n22006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 32 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6\u00cc\u00b1\u00bb\u00be\u00c6\u00d8\u00d6\u00af\u00c6\u00af\u00af\u00c6 \u00af\u00be\u00c6\u008c \u00b7\u00c8\u00de\u00c1\u00af (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u201c\u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00db\u00af\u00c7\u00ce\u00ba\u00b1\u00c6\u00b1\u00ce\u00b9\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00813 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00ba\u00c7\u00bd\u00c6\u00bd\u00c9\u00d5 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0\n\n4\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 3 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b7\u00c9\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5 \u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a5\u00b4\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n3\u00b0 (1) \u00b7\u00c8\u00de\u00c1\u00af\u00ba\u00c7\u00b8\u00d7 (\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6\u201c\u00b1\u00ce\u00b9\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00db\u00af\u00c7\u00ce\u00ba\u00b1\u00c6\u00b1\u00ce\u00b9\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081\" \u00a3\u00b6\u00bd\u00c6\u00d0 \u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00a3\u00df\u00c1\u00be\u00c6\u00af\u00bf\u00c8\u0081\u00b7\u00c8\u00bc\u00c6\u00c1\u00c7\u00af\u00db\u00ba\u00c6 \u00db\u00af\u00c7\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1\u00db\u00ba\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00b1\u00ce\u00b9\u00bb\u00c7\u00b8\u00d7 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00de \u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00b6\u00c6\u00d7\u00c1+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\" \u00b9\u00b5\u00c8\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00c8\u00b6\u00c6\u00b6\u00df\u00ba\u00c6\" \u00da\u00bc\u00c8\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00b1\u00ce\u00b9 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00a4\u00b4\u00c6\u00af\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :-\n\n(\u00a3)\u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u00b4\u00df\u00c1\u00be\u00c6\u00af\u00bf\u00c6 \u00a9\u0081\u00d9\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00b8 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c6 ; \u00a5\u00c1\u00bc\u00c6\u00b6\u008c\u00b1\u00c7\u00bf\u00bc\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\n\n(\u00a4)\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\" \u00bc\u00c7\u00b2\u00b6\u00b7\u00c6\u00b6\u00c8\u00bc\u00ba\u00c6\" \u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1 \u00a7\u00bd\u00e2\u00af\u00bf\u00c6\" \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\" \u00cd\u00b6\u00b1\u00c8\u00bb \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\"\u00cc\u00b9\u00c7\u00dd\u00bf\u00c8\u00bb\u00be\u00c6\" \u00e9\u00c0\u00be\u00c6\" \u008c\u00c1\u00b1\u00c7\u00bb\u00ba\u00c6 \u00a4\u00af\u00c8\u00bb\u00d7\u00ce\u00bd\u00af\u00bf\u00c8\u00be\u00c6 \u00da\u00af\u00c0\u00c6 \u00a9\u00bb\u00c6\u00b6\u00c8\u00dc\u00bf\u00c6\u00bf \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u00ce\u00b4\u00cd\u00bb\u008a\u00dd\u00b7\u00c6\u00d7 \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u00b4\u00df\u00c1\u00be\u00c6\u00af\u00bf\u00c6\u00a9\u0081\u00d9\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00b8\u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c7\u00be\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00e1 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6\u00b0\n\n(3) \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c6\" \u00db\u00b6\u00be\u00c6 \u00db\u00af\u00c7\u00ce\u00ba\u00b1\u00c6\u00b1\u00ce\u00b9 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00af\u00c7\u00be\u00b3\u00c6 \u00cc\u00b1\u0081\u00bd \u00be\u00af\u00c6\u0082\u00ba\u0081 \u00af\u00b6\u00c8\u00bc\u00c6\u00af\u00c7\u00ba\u00bc\u00c8\u0081\u00d0\u00d5\u00ba\u00c6\u00b9 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6 \u00ac\u00dd\u00c1\u00ce\u00bc \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0 \u00d0\u00d5\u00ba\u00c6\u00b9\u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c7\u00af \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00bf\u00c6\" \u00b1\u00ce\u00b9\u008a\u0081 \u00a4\u00dc\u00b4\u00c6\u00af\u00c7\u00be \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c7\u00af \u00cd\u00b1\u00ce\u00c1\u00bb\u00c7\u00bd\u00c6\u00de\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(4) \u00b1\u00ce\u00b9\u00af\u00c6\u00d0 \u00b7\u00c8\u00bb\u00ba\u00b8+\u00c6\u00af\u00ce\u00bf\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00ce\u00af\u008a\u00be\u00c6\"\u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c6\" \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00cc\u00b1\u00bb\u00c6\u00c1\u00d7 \u00a7\u00b1\u00c8\u00b6\u00ba\u00c7\u00b8\u00cc\u00b6\u00b8\u00af\u00c6\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 32 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6\u00cc\u00b1\u00bb\u00be\u00c6\u00d8\u00d6\u00af\u00c6\u00af\u00af\u00c6 \u00af\u00be\u00c6\u008c \u00b7\u00c8\u00de\u00c1\u00af (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c63\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00814 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00ba\u00c7\u00bd\u00c6\u00bd\u00c9\u00d5 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0\n\n\u00af\u00dd\u00d7\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" (3) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00b7\u00c8\u00bb\u00b6\u00c8\u00af\u00bf\u00c8\u0081\u00b9\u0088\u00b1\u00ce\u00b9\u00af\u00c6\u00d0 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00c7\u00be\u00b3\u00c6\u00cc\u00b1\u0081\u00bd \u00be\u00af\u00c6\u0082\u00ba\u0081\u00af\u00b6\u00c8\u00bc\u00c6\u00af\u00c7\u00ba\u00bc\u00c8\u0081 \u00d0\u00d5\u00ba\u00c6\u00b9 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00ce\u00bc\u00af\u00c6 \u00af\u00be\u00b7\u00c6\u00b6\u00c7\u00cd\u00be\u00c7\u00b1\u00c8\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n(5) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00b1\u00ce\u00b9 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00b7\u00c8\u00bb\u00ba\u00b8\u00ba\u00c6\"\u00b9\u00b6\u008c\u00af\u00c6\u00af\u00c7\u00be\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00cd\u00c1\u00b6\u00b8\u00ba\u00c6\" \u00b1\u00ce\u00b9\u008a\u0081\u00e7\u00b4\u00c6\u00b4+\u00c6\u00af\u00bf\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00a5\u00be\u00b1\u00c6\u00b1\u00c8\u00ce\u00b8\u00a9\u0081\u00b9\u00b8 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d\u00b0\n\n5\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 4 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b7\u00c9\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5 \u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a5\u00b4\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n4\u00b0 \u00b7\u00c8\u00de\u00c1\u00af\u00ba\u00c7\u00b8\u00d7 -"
