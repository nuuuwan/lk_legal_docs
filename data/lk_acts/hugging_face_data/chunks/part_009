    "chunk_text": "15\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8+\u00c6\u00af\u00bf\" \u00b6\u00ba\u00c8\u00c0\u00c6 \u00a7\u00ce\u00bc\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00ce\u00b4\u00cd\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00bb \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00af\u00ce\u00be\u00b9\u00c6\u0089\u0081 \u00ba\u00c9\u00d7\u00a9\u00b3\u00c6\u00b1\u00c8\u008a\u00dd\u00af\u00c6\u00d0\u00ba\u00c6\u00a4\u00b6\u00b8\u00ba\u00c6\u00b0\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba\u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6\u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf\u00a7\u00ce\u00bc \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n2007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 3 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00c8\u00de\u00c1\u00bc\u00c6\"\u00a5\u00ce\u00bf\u00b3\u00bc\u00c6 \u00a3\u00bc+\u00c6\u00cd\u00af\u00bd\u00c6\u00de \u00ba\u0081\u00bd\u00ba\u00c6 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6)\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n9"
