    "chunk_text": "\u00be\u00f8\u00c8 \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00a8\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00c9\u00e5\u00da\u00ba\u00e5\u00c9(\u00c9\u00aa. 284)\n\n\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00b4 \u00a1\u00e6\u00ba\u00f8\u00c2\u00c8\u00c6(\u00c9\u00aa, 285)\n\n\u00ba\u00e5\u00c9\u00a8\u00e5\u00c8\u00e8\u00a8 \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd\u00c2\u00c8\u00ba\u00c8(\u00c9\u00aa. 286)\n\n\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00ef\u008a \u00bc\u00fb \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4, \u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00c3\u00fa\u00bd\u00e5\u00be \u00a1\u00e5\u00bc\u00fa\u00c6(\u00c9\u00aa. 287)\n\n\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00b4 \u00a1\u00bc\u00e5\u00ce \u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u0097\u0093\u0097\u00bd\u00e5\u00be(\u00c9\u00aa. 289)\n\n\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4\u00cc\u00cd \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4(\u00c9\u00aa. 293)\n\n\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00ef\u00c0\u00e5\u00ba\u00e0(\u00c9\u00aa. 294)\n\n\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00b4 \u00a8\u00c7\u00be \u00ef\u00aa\u00d1\u008a(\u00c9\u00aa. 295)\n\n\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00aa\u00fa\u00b8\u00ea\u008a \u0097\u00aa\u00b8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 (\u00c9\u00aa. 296)\n\n\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4(\u00c9\u00aa. 297)\n\n\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00c4\u00ea\u00bc\u00e5\u00cd\u00e6\u00d7\u00c4(\u00c9\u00aa. 298)\n\n\u00c0\u00d7\u00e8\u00a8\u00e0\u00cb\u00b8 \u00a8\u0095\u00b4\u00ea\u00c9\u00a8\u00e0 \u00c0\u00ba\u00e0\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00bc \u00be\u00e6\u00bc\u00e0\u00bc\u00c6\u00be\u00e0\u00be \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00cd \u00a1\u00e5\u00bd\u00e5\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4(\u00c9\u00aa. 299)\n\n\u00c0\u00d7\u00a8\u00e0\u00cb\u00b8 \u00a8\u0095\u00b4\u00ea\u00ef\u008c \u00cc\u00e2\u00c6\u00ea\u00ba\u00f8\u00c6 \u00cc\u00cd \u00a8\u00e5\u00da\u00c6\u00c6 \u00c0\u00d6\u00c0\u00e5\u0090\u00c6(\u00c9\u00aa. 300)\n\n\u00c0\u00d7\u00a8\u00e0\u00cb\u00b8 \u00a8\u0095\u00b4\u00ea\u00c9\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00cc\u00ba\u00eb \u00c2\u00c8\u00ba\u00c8(\u00c9\u00aa, 301)\n\n4752007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n\u0097\u00ef\u00ca\u00e0\u00cb \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00e6 \u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4(\u00c9\u00aa. 307)\n\n\u00c0\u00f2\u00c9\u00da\u00bd\u00a8\u00c6\u00be\u00e0, \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00e6\u00be\u00e0 \u00a1\u00e5\u00bc\u00fb\u00be\u00e0 \u00c4\u00cd\u00b0\u00be\u00c0\u00d7\u00a8\u00e0\u00cb\u00e5\u00c9\u00b4 \u00c3\u00e5\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u00e5\u00b3\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a\u00c2\u00c8\u00c6(\u00c9\u00aa. 311)\n\n\u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ba\u00cd\u00be\u008a \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0(\u00c9\u00aa. 213)\n\n\u00a1\u0093\u00a8\u00c7\u00b8\u00ef\u00c6\u00e0 \u00a1\u00e6\u00ba\u00e6\u008a \u00c2\u00c8\u00ba\u00c8 \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00ef\u00c9\u00ba \u00c0\u00e6\u00c9\u00d7\u00c4(\u00c9\u00aa. 315)\n\n\u00be\u00c4\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6[365 (2) \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6]\n\n\u00c9\u00c7\u00b8\u00e9\u00c6 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u008a\n\n1. \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0, \u00a6\u00e0\u00c9\u00e5 \u00c8\u00e6\u00c6\u00fa\u00cc\u00e0\u00ba\u00eb\u00aa\u00ba \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c0\u00f2\u00c4\u00ea\u00a9\u00ba\u00e0\u00c9\u00ef\u00c6\u00e0 \u00a1\u00be\u00ea\u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8 \u00a1\u00be\u00ea\u00c9\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00aa\u00d1\u008a \u00c0\u00ce\u00c4\u00ea\u00c9 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6 :\u2013\n\n(\u00a1)\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00cc\u00cd \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb,\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00cc\u00e8 \u00c0\u00d6\u00e8\u00bc\u00fa \u00bc\u00c7\u00be \u00c8\u00bc \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00cc\u00cd \u0097\u00c6\u00bc\u008a \u00cc\u00cd, \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0\u00c0\u00e5\u00d6\u00ca\u00f2\u0095\u00a8;\n\n(\u00a1\u00e5)\u00a2\u00c8\u00e0\u00c8\u00e9\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ef\u00c0\u00be\u00f9 \u00cc\u00e8\u0090\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a2\u00b6 \u00ef\u00bc\u00be \u00c8\u00bc\u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00be\u00b6\u00ea \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u0095\u00be\u00e0, \u00cc\u00c4\u00e5\u00aa\u00c4 \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9\u00b4 \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0 \u00c8\u00c2\u00e5\u00aa\u00e6\u00be\u00f8\u00c4 \u00cc\u00bf\u00cd\u00e5, \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00b4 \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00a8\u00ce\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00be\u00b6\u00ea \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb;\n\n(\u00a1\u00e6)\u00a1\u00e7\u00c9\u00c7\u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u0095\u00b4\u00ea\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00c9\u00ca\u00f1\u00ef\u00c6\u00be\u00e0\u00c4 \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00bc\u00c7\u00be\u00c8\u00bc \u00cc\u00e7\u00c2\u00e7 \u0097\u00c6\u00bc\u008a.\n\n2. 1 \u00c9\u00be \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u008a \u00cc\u00bf\u00cd\u00e5 \u00ef\u00aa\u00d1\u008a \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9, \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00aa\u00d1\u008a \u00a2\u00be\u00e0 \u00a1\u00be\u00ba\u00eb\u00c7\u00e6\u00c9 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6 :\u2013\n\n(\u00a1)\u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4 \u00a1\u00c6\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00cc\u00e8\u00c6\u00dd \u00a1\u00da\u00bb \u00cc\u00e5\u00bd\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00cc\u00e0\u00c9\u00a8\u00c3\u00e5\u00c7\u00a8\u00e5\u00c7 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00cc\u00cd \u00c0\u00e5\u00da\u00ef\u00ba\u00e5\u00e0\u00cb\u00e8\u00a8 \u00ef\u00aa\u00d1\u00c4 ;\n\n(\u00a1\u00e5)\u00a1\u00e7\u00c9\u00c7\u00a8\u00f8\u00d7\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c9\u00ec \u00c0\u00ec\u00da\u00b8 \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc, \u00a6\u00c4 \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00be\u00ea\u00c9 \u00ef\u00ba\u00e5\u00e0\u00c7\u00e5 \u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6;"
