\u00a3\u00b4+\u00c6\u00d0\u00ba\u00c6\u00b0\n\n(\u00a3)\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00ce\u00bf \u00a3\u00d9\u00ba\u00b6\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\"\u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00b9\u00b6\u008c\u008c\u00be\u00af\u00be\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00c1\u00bc\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00b9\u00b6\u008c\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00b7\u00c9\u00af\u00c6\u00d0\u00b6\u00be\u00c6 ;\n\n(\u00a4)\u00b9\u00b6\u008c\u00b6\u00c7+\u00c6\u00d0\u00b7\u00bc\u00c6\u00af\u00ce\u00bf\u00b6\u00c6 \u00cd\u00b6\u00bc\u00c6\u00b7\u00c6\u00cc\u00b6\u00d5\u00b6\u00c6\u00b6\u00be\u00c6 ;\n\n(\u00a5)\u00db\u00af\u00c7\u00ce\u00ba\u00b1\u00c6 \u00b1\u00ce\u00b9\u008a\u00b8\u00d7\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u00b9\u00b6\u008c \u00b6\u00c7+\u00c6\u00d0\u00b7\u00bc\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00b6\u00b6\u00c6\u00d7\u00c1+\u00c6\u00af\u00bf\u00c6\" \u00af\u00b4\u00ce\u00ba\u00af\u00bf\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b9\u00b5\u00c8\u00af\u00bf\u00c6 ;\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 33 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00b7\u00c7\u00c1\u00be\u00b9\u00c6\u0089\u00b4\u00c6\u0088\u00b6\u00c7\u00dd\u00be\u00c6 \u00a7\u00df{\u00ba\u00c6 \u00a3\u00be\u00c6 \u00c4\u00c7\u008d\u00ba\u00c8\u00bb\u00c7 \u00a3\u00bc\u00da\u00af\u00c6 \u00af\u00be\u00c6\u00df{\u00bc\u00c8(\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n5\n\n(\u00a6)\u00db\u00af\u00c7\u00ce\u00ba\u00b1\u00c6\u00b1\u00ce\u00b9\u008a\u0081 \u00e7\u00b4\u00c6\u00b4+\u00c6\u00af\u00bf\u00c6 \u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00b6\u00be\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00e7\u00b4\u00c6\u00b4+\u00c6\u00af\u00bf\u00c8\u00be\u00c6 \u0089\u0081\u00b9\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b4 \u00cd\u00c1\u00ae\u0088\u00bb\u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af \u00db\u00ce\u00bd\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00e7\u00b4\u00c6\u00b4+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00b8 \u00e7\u00b4\u00c6\u00b4 \u00b7\u00b4\u00b9\u00c6\u00cc\u00b9\u00ae ;\n\n(\u00a7)\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00c1\u00ce\u00be\u00bb\u00c7\u00b4\u00c6\u00af\u00ce\u00bf \u00b7\u00c8\u00bb\u00ba\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00af\u00b4\u00ce\u00ba\u00af\u00bf\u00c6\" \u00b9\u00b5\u00c8\u00af\u00bf\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00c1\u00ce\u00be\u00bb\u00c7\u00b4\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00af\u00ce\u00b4\u00b9\u00c6\u0089\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb \u00ac\u00e1\u00af\u00c6\u00af \u00cc\u00b7\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1 ;\n\n(\u00a8)\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u008c\u00b6\u00c8\u00af\u00bf\u00c6 \u00cd\u00b6\u00b1\u00c8\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00ba\u00c7\u00af\u00c7\u00b5\u00af\u00c6 \u00af\u00be\u00c6\u008c\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00ce\u00af\u00dc\u00b4\u0081 \u00db\u00bc\u00b5\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00af\u00c7\u00b6 \u00a3\u00bf\u00e2\u00af\u00c6\u00d0\"\u00b7\u00b4\u00c7\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00cd\u00c1\u00ae\u0088\u00bb \u00af\u00bd\u00c6\u00ce\u00af\u00cc\u00b7\u00bd\u00c8\u00af\u00bf\u00c6\" \u00af\u00be\u00c6\u008c\u00b9\u00c6 \u00b9\u00c7\u00b4\u008c\u00b6\u00c7\u00b8+\u00c6\u00af\u00bf\u00c6\" \u00b9\u00bc\u00c9\u00b4\u00c6\u00ce\u00b1\u00af\u00bf\u00c6 \u00b