    "chunk_text": "(\u00a1\u00e5)\u00a6\u00ef\u00cc\u00e0 \u00ba\u00c4 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4 \u00a1\u00c9\u00cc\u00e5\u00be \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00c8\u00e2\u00aa\u00eb \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00e5\u00c7 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00e5\u00c7\u00c9\u00c7\u00c6\u00e5 \u00cc\u00cd \u00aa\u00fa\u0097\u00cc\u00ea\u00c4 \u00a1\u00c9\u00cc\u00e5\u00be \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00c8\u00e2\u00aa\u00eb\u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00b3\u00e5\u00c9 \u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00a6\u00e0 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00e5\u00ef\u00aa\u00e0\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00ca\u00f2\u00fa\u00ba\u00c6\u00a8\u00eb\u00c9 \u00cc\u00e8\u0090\u00c6\u00e5 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00ba\u00eb\u00c7\u00e6\u00c9\n\n224 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00ef\u00cd\u00e5\u00e0 225 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00b4\u00c9\u00aa\u00a4\u00ba\u00e0\u00ba\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4.\n\n\u00a1\u00e6\u00ba\u00e6\u008a \u00aa\u00fa\u0097\u00cc\u00ea\u008a\u00a1\u00c9\u00cc\u00be\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0\u00cc\u00ea\u00dd \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00c9\u00be\u00cc\u00e0\u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00f2\u00ba\u00f8\u00c1\u00c8.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba198\n\n(2)(\u00a1)(1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00a4\u00c8\u00e0\u00c8\u00e2\u00ab\u00be\u00c6 \u00a8\u00c7\u0095\u00be\u00e0 \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00e5\u00c7\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0\u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00e5\u00c7\u00c9\u00c7\u00c6\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c8\u00cc \u00bc\u00e6\u00be \u00bc\u00e6\u00be\u00c4 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00c7\u00be\u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00c9\u00be \u00a1\u00ba\u00c7,\u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u0095\u00c8\u00e8\u00c6\u00be\u00c6\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(\u00a1\u00e5)\u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00c9\u00c7\u00bc\u00a8\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u2014\n\n(i)\u00a6\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00e0 \u00be\u008a, \u00a6\u00e0\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00cc\u00e7\u00c4 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00c4 \u00cc\u00cd\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00c4 ;\n\n(ii)\u00a6\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00be\u008a,\u00a6\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00cc\u00e7\u00c4 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00c4,\n\n\u00a6\u00e0 \u00c9\u00c7\u00bc \u00cc\u00bf\u00cd\u00e5 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9\u00bc \u00a6\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 \u00ba\u00c4\u00bc\u00e6\u00be\u00ea\u00c4 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00c2\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4 \u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ba\u00c4\u00e5 \u00be\u00f8\u00cc\u00e8\u00cc\u00e8\u00c6\u00f5 \u00a4\u00bc\u00e0\u00ef\u00c6\u00e5\u00e0\u00aa\u00ef\u00c6\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00ce \u00c2\u00c9, \u00a7\u00c0\u00e0\u00c0\u00ea \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a6\u00e0 \u00c9\u00c7\u00bc \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00c6\u00c6\u00fa \u00cc\u00c8\u00a8\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n232. 224 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 228 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00ba\u00a8\u00e0 \u00c9\u00ec \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8\u201c\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb\u201d \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4\u2014\n\n(\u00a1)\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb \u0095\u00c6 \u00c6\u00e5\u00ef\u00c4\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00c9\u00c8 \u00a1\u00c6\u00e8\u00ba\u00f8\u00c6 \u00c0\u00e6\u00c9\u00c7\u00e6\u00b8\u00ea\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 ;\n\n\u201c\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00e5\u201d\u00c6\u00be\u00e0\u00ef\u00be\u00cd\u00fa \u00c9\u00f1\u00e5\u00c0\u00e0\u00ba\u00a1\u00da\u00bb\u00c6.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba199\n\n(\u00a1\u00e5)\u0095\u00c6\u00aa\u00fa\u00c6 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e0\u00c4\u00e3\u00a8\u00c7\u00e6 \u00ef\u00cd\u00e5\u00e0\u00a1\u00bc\u00e0\u0095\u00be\u00f8\u00cc\u00e0\u00ba\u00f2\u00e5\u00cc\u00e8\u00a8\u00c7\u00e6; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e6)224 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 225 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0\u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c9\u00ec \u00c4\u00e5\u00cc \u00cd\u00c6\u00a8 \u00a8\u00e5\u00c8\u00c6 \u00ba\u00eb\u00ce\u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb\u00c9 \u00cc\u00e8\u0090\u00c6\u00e5 \u00c9\u00ec\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0,\n\n\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00bc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00ef\u008a \u00a1\u00e5\u00b3\u00e5"
