    "chunk_text": "2.\u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00cc\u00cd \u00a2\u00be\u00e0\u00c0\u00cc\u00ea\u00c9(\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u00a1\u00be\u00ea\u00c7\u00e5\u00bd\u00c0\u00ea\u00c7\u00b0\u00c6 \u00ca\u00f2\u00e9 \u00c4\u00cd \u00ef\u00c2\u00e5\u00e0\u0093 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00cd\u00fa \u00bc\u00e6\u00be\u00b4 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00c9 \u00cc\u00e8\u0090\u00be\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00cc\u00cd \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 (\u00ef\u00c4\u00cd\u00fa\u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u201c\u00b0\u00c6 \u00ca\u00f2\u00e9 \u00c4\u00cd \u00ef\u00c2\u00e5\u00e0\u0093\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u201d \u00c6\u00be \u00be\u00e5\u00c4\u00c6 \u00cc\u00cd \u00a1\u00c3\u00fa\u00bd\u00e5\u00be\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u0097\u0083\u00d2\u00be\u00e0\u00be\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00a8\u00f9 \u00be\u00e5\u00c4\u00ef\u00c6\u00be\u00e0 \u00a6\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u0097\u00cc\u00e8\u00be\u00e0 \u00bc, \u00a6\u00c6\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00bc, \u00cc\u00e8\u00c6\u00f5 \u00a1\u0093\u00a8\u00c7\u00b8\u00c9\u00c8 \u00bc\u00fb \u00be\u00b6\u00ea \u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8 \u00c6. \u00ba\u00c9 \u00bc, \u00ef\u00c0\u00e5\u00f3 \u00c4\u00ea\u00f7\u00e5\u00c9\u00a8\u00e0 \u00ba\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00bc, \u00a6\u00c6 \u00c0\u00e5\u0097\u0083\u008e \u00a8\u00f8\u00d7\u00ef\u008a \u00bc,\u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00a1\u00c3\u00fa\u00c4\u00ba\u00c6 \u00c0\u00d6\u00bc\u00fa \u00a6\u00c6 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc, \u00c0\u00ec\u00da\u00b8 \u00c2\u00c8\u00c6 \u00cc\u00cd \u00a1\u0093\u00a8\u00e5\u00c7\u00c6\u00a3\u00b4 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6.\n\n(\u00a1) \u00c0\u00ec\u00b0\u00be\u00f9\u00c6 \u00b0\u00c6 \u00ca\u00f2\u00e9 \u00c4\u00cd \u00ef\u00c2\u00e5\u00e0\u0093\u00c6 \u00c9\u00b4\u00e5 \u00c7\u00be\u00e0\u00c9\u00e6\u00b4\u00a8\u00e0 \u00ba\u00e6\u00be\u00d1\u00c4 \u00cc\u00cd\u00a1\u00c9\u00ca\u00f1 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8 \u00bc\u00fb \u00a6\u00a8\u00f9 \u00c7\u00be\u00e0\u00c9\u00e6\u00ef \u00be\u00b6\u00ba\u00e0\u00ba\u00eb \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u00cd\u00c0\u00f2\u00ba\u00f8\u00cc\u00e2\u00cc\u00e0\u00a8\u00c7\u00b8 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00c7\u00d1\u00c4 ;\n\n\u00a1\u00be\u00ea\u00c7\u00e5\u00bd\u00c0\u00ea\u00c7 \u00b0\u00c6\u00ca\u00f2\u00e9 \u00c4\u00cd\u00e5 \u00ef\u00c2\u00e5\u00e0\u0093\u00c7\u00be\u00e0\u00c9\u00e6\u00b4 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4.\n\n\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00ef\u00c0\u00e5\u00f3\u00c0\u00c7\u00c4\u00e5\u00da\u00bb.\n\n2006 \u00a1\u00e2\u00a8 41 \u00bc\u00c7\u00be \u00a1\u00be\u00ea\u00c7\u00e5\u00bd\u00c0\u00ea\u00c7 \u00b0\u00c6 \u00ca\u00f2\u00e9 \u00c4\u00cd\u00e5 \u00ef\u00c2\u00e5\u00e0\u0093\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a) \u00c0\u00be\u00ba2\n\n(\u00a1\u00e5) \u00b0\u00c6 \u00ca\u00f2\u00e9 \u00c4\u00cd \u00ef\u00c2\u00e5\u00e0\u0093\u00c4\u00dd\u00c9 \u00a1\u00e6\u00ba\u00eb\u00c8\u00ba \u00cc\u008a\u00c0\u00f2\u00bc\u00e5\u00c6\u00fa\u00a8, \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd\u00e5\u00aa\u0095\u00a8\u00cd\u00e5 \u00cc\u00e2\u00cc\u00e0\u00a8\u00ee\u00ba\u00f8\u00a8 \u00c9\u00ba\u00e5\u00c9\u00ba\u00e0 \u00a2\u00b4\u00ea \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a1\u00be\u00e0\u00bc\u0095\u00be\u00e0 \u00a6\u00cd\u00fa\u00c0\u00d6\u00cc\u00c7\u00c6 \u00cc\u00a8\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c9\u00aa \u00c2\u00c8\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00cd \u00a3\u00b4 \u00c0\u00cd\u00cc\u00ea\u00a8\u008a\u00cc\u00e6\u00ce\u00cc\u00e9\u00c4 ;\n\n(\u00a1\u00e6) \u00c0\u00ec\u00b0\u00be\u00f9\u00c6 \u00b0\u00c6 \u00ca\u00f2\u00e9 \u00c4\u00cd \u00ef\u00c2\u00e5\u00e0\u0093\u00c4\u00dd\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00c3\u00ed\u0095\u00c3\u00e5\u00aa\u00ef\u00c6\u00e0\u00ef\u00c2\u00f0\u00bc\u00e0\u00bd\u00e5\u00aa\u0095\u00a8, \u00c0\u00ea\u00c7\u00e5\u0097\u00bc\u00f1\u00e5\u00ba\u00e0\u00c4\u00a8 \u00cd\u00e5 \u00ef\u00a6\u00ba\u00f8\u00cd\u00e5\u00cc\u00e8\u00a8 \u00c9\u00cc\u00e0\u00ba\u00ed\u00be\u00e0\u00db\u00ef\u00a8\u00be \u00a1\u00be\u00e0\u00bc\u0095\u00be\u00e0 \u00c0\u00d6\u00cc\u00c7\u00c6 \u00cc\u00e2\u00c7\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00c3\u00ed\u0095 \u00be\u00f8\u00da\u00c4\u00e5\u00b8\u00c6\u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00c0\u00ea\u00c7\u00e5\u0097\u00bc\u00f1\u00e5 \u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00a1\u00be\u00ea\u00c4\u00ba\u00c6 \u00cd\u00e5\u00a1\u009e\u00a8\u00e0\u00cb\u00b8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00ef\u00be\u00a8\u00eb\u00ba\u00e0 \u00cc\u00e2\u00c7\u00a8\u00e0\u00cb\u00b8 \u00cc\u00cd \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a1\u00e7) \u00c0\u00ec\u00b0\u00be\u00f9\u00c6 \u00b0\u00c6 \u00ca\u00f2\u00e9 \u00c4\u00cd \u00ef\u00c2\u00e5\u00e0\u0093\u00c4\u00dd\u00c9\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8,\u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00cc\u00a8\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a1\u00bc\u00e5\u00ce\u00c2\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a4\u00c0\u00ef\u00bc\u00cc\u00e0 \u00c0\u00d6\u00bc\u00fa \u00be\u00c9 \u00c0\u00d6\u00cc\u00c7\u00c6\u00a8\u00e0 \u00cc\u00e6\u00ce\u00cc\u00ea\u008a \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a2) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00c0\u00c7\u00c4\u00e5\u00da\u00bb \u00a1\u00c9\u00ef\u00c2\u00e5\u00e0\u00bd \u00a8\u00c7\u00d1\u00ef\u00c4\u00cd\u00fa \u00c8\u00e5 \u00c0\u00f2\u00bc\u00da\u00ca\u00b8,\u00ef\u00bc\u00e0\u00ca\u00b8, \u00cc\u008a\u00c4\u00be\u00e0\u00ba\u00f2\u00b8 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4, \u00c0\u00f2\u00a8\u00e5\u00ca\u00be \u00c0\u00ce \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5\u00ef\u00c9\u00be\u00ba\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a3) \u00b0\u00c6 \u00ca\u00f2\u00e9 \u00c4\u00cd \u00ef\u00c2\u00e5\u00e0\u0093\u00c6 \u00c0\u00f2\u00c4\u00ea\u00a9 \u00a1\u00be\u00ea\u00c7\u00e5\u00bd\u00c0\u00ea\u00c7 \u00a1\u00b4\u00c4\u00cc\u00e0\u00bb\u00e5\u00be\u00ef\u00c6\u00e0\u00ba\u00e0,\u00a1\u00be\u00ea\u00c7\u00e5\u00bd\u00c0\u00ea\u00c7 \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00a1\u00b4\u00c4\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00b4 \u00a1\u00be\u00ea\u00c2\u00bc\u00e0\u00bd \u00ef\u00c9\u00be\u00ba\u00e0\u00cc\u00e8\u00bc\u00e0\u00bd\u00cc\u00e0\u00bb\u00e5\u00be\u00c9\u00c8\u00ba\u00e0 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00c2\u00ea\u00bc\u00e0\u00bd\u00ca\u00e5\u00cc\u00be\u00ef\u00c6\u00e0 \u008e\u00c7\u00cc\u00e0\u00ba\u00f8\u00bb\u00fc\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00cc\u00e7\u00c4 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00c4\u00e5\u00da\u00aa\u00c6\u00a8\u00e0\u00c4\u00a1\u00be\u00ea\u00aa\u00c4\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a4) \u00c0\u00ec\u00b0\u00be\u00f9\u00c6 \u00b0\u00c6 \u00ca\u00f2\u00e9 \u00c4\u00cd \u00ef\u00c2\u00e5\u00e0\u0093\u00c6 \u00c9\u00b4\u00e5 \u00a2\u00bc\u00fa \u00ef\u00a8\u00ef\u00c7\u00be \u00c7\u00be\u00e0\u00c9\u00e6\u00b4 \u00a2\u00bc\u00fa\u00a8\u00f8\u00d7\u00c4\u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u0081\u00be\u00e7\u00c4 \u00a8\u00b4\u00c6\u00ea\u00ba\u00e0\u00ba\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00ea\u00c7\u00e5\u0097\u00bc\u00f1\u00e5\u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00ef\u008c \u00a1\u00be\u00ea\u00c4\u00ba\u00c6 \u00cd\u00e5 \u00a1\u009e\u00a8\u00e0\u00cb\u00b8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00cd\u00e5\u00c6\u00d1\u00c4 ;\n\n(\u00a4\u00f0) \u00c2\u00ea\u00bc\u00e0\u00bd \u00bd\u00da\u00c4\u00c6 \u00cc\u00cd \u00a6\u00cd\u00fa \u00ef\u00bc\u00e0\u00ca\u00be\u00e5 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00bc\u00e6\u00cd\u00e6\u0095 \u00bc\u00fa\u0097 \u00ef\u00c0\u00ef\u00c9\u00ba\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00c0\u00f2\u00ae\u00e5\u00c7\u00c6 \u00a8\u00f8\u00d7\u00c4 ;"
