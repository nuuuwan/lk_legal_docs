    "chunk_text": "(\u00a1)\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00c7\u00be \u00a8\u00c8\u00e0\u00cd\u00fa\u00a1\u00c9\u00ca\u00f1 \u00aa\u00b8\u00c0\u00ec\u00c7\u00b8\u00c6\u00b4 \u00c9\u00b6\u00e5 \u00a1\u00b6\u00ea \u00ef\u00be\u00e5\u00c9\u00be \u00cc\u00e2\u00a9\u00f1\u00e5\u00c9\u00a8\u00f8\u00be\u00e0\u00cc\u00e2\u00c6\u00ea\u00a8\u00e0\u00ba \u00c9\u00be \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00e6\u00be\u00e0 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00cc\u00c4\u00e5\u00aa\u00c4\u00b4 \u00cc\u00e8\u0090\u00be\u00e0\u00ef\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00ef\u00c6\u00a8\u00e0 \u00c0\u00c4\u00b8\u00a8\u00e0\u00be\u008a, \u00a6\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5, \u00ef\u00cd\u00e5\u00e0\n\n\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00ef\u00c0\u00e5\u00ba\u00a8\u00e0 \u00cd\u00e5 \u00c0\u00ba\u00a8\u00e0\u201d \u00cc\u00cd \u201c\u00ef\u00c0\u00e5\u00ba\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ba\u00a8\u00e0\u201d \u00c6\u00be\u00e0\u00be\u00b4 \u00aa\u00fa\u00b8\u00ea\u008a,\u00a7\u00c0\u00e0\u00c0\u00ea, \u00c8\u00e8\u00c6\u0097\u00c8\u00e8 \u00cd\u00e5 \u00ef\u00c8\u00e0\u00a9\u00be \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ;\n\n\u201c\u00c0\u00be\u00e0\u00ba\u00f8\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00cc\u00c4\u00e5\u00be \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a, \u00c9\u00c7\u00c0\u00f2\u00cc\u00e5\u00bc, \u00cc\u00e9\u00c4\u00e5\u00a8\u00e8\u00d7\u008a \u00cd\u00e5\u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8 \u00a1\u00be\u00ea\u00aa\u00ba \u00d1 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00c0\u00be\u00e0\u00ba\u00f8\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00cc\u00c4\u00e5\u00aa\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00a1\u00b8\u00e0\u00b6\u00ea\u00a8\u00f2\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c 154\u00aa \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ce\u00e5\u00ba\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00e8\u00cd\u00e8\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00c9\u00e5\u00c9\u00ec\u00bc 1996 \u00a1\u00e2\u00a8 10\u00bc\u00c7\u00be \u00c0\u00ce\u00e5\u00ba\u00e0\u00c2\u00bc \u00c4\u00cd\u00e5\u0093\u00a8\u00c7\u00b8 (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ef\u00ba\u00e0 2\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a6\u00c6 \u00c0\u00e8\u00cd\u00e8\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c0\u00ce\u00e5\u00ba \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00cc\u00e8\u0097\u00c8\u00e0\u00a1\u0093\u00a8\u00c7\u00b8 \u00c2\u00c8\u00c6 \u00c0\u00e6\u00c9\u00c7\u00e6\u00be\u00e5\u00c9\u00ec\u00bc \u00c4\u00cd\u00e5\u0093\u00a8\u00c7\u00b8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a\u00c0\u00ce\u00e5\u00ba\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c9\u00e6\u00be\u00f8 \u00cc\u00e8\u0097\u00c8\u00e0 \u00a1\u0093\u00a8\u00c7\u00b8 \u00c2\u00c8\u00c6\u00a8\u00e0 \u00c0\u00e6\u00c9\u00c7\u00e6\u00b8\u00ea\u00c4\u00cd\u00e5\u0093\u00a8\u00c7\u00b8\u00c6\u00a8\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u0097\u00b4\u00a8 \u00c2\u00cc\u00e0\u00be\u00e5\u00cd\u00fa\u00c7\u00c0\u00ce\u00e5\u00ba \u00cc\u00bf\u00cd\u00e5 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c4\u00cd\u00e5\u0093\u00a8\u00c7\u00b8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n4252007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n\u201c\u00cc\u00ee\u00b8 \u00c0\u00ba\u00f2\u00c6\u201d \u00c6\u00be\u00e0\u00be\u00b4 \u00cc\u00ee\u00b8 \u00c0\u00ba\u00f2, \u00cc\u00e0\u00a8\u00be\u00e0\u00bd, \u00c2\u00e6\u00df\u008a\u00a8\u00c7 \u00cd\u00e5 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a\u00c9\u00ba\u00e0\u00a8\u008a\u00c9\u00c8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00c9\u00ea\u00c9\u00ba\u00e0 \u00be\u00e6\u00ba\u00ba\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00ef\u00c9\u00be\u00ba\u00e0\u00cc\u00ea\u00db\u00a8\u00eb\u008a \u00c0\u00ba\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ;\n\n\u201c\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u201d \u00c6\u00be\u00e0\u00be\u00b4 \u2014\n\n(\u00a1)\u00a8\u00c9\u00c7 \u00be\u00c4\u00a8\u00f8\u00be\u00e0 \u00cd\u00e6\u00bf\u00fa\u00be\u00e0\u00c9\u00ea\u00c9 \u00bc \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6 \u00a4\u00cc\u00ea\u00c8\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00bc ;\n\n(\u00a1\u00e5)187, 188, 189, 190, 197, 374, \u00cc\u00cd 377 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8\u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u2014\n\n(i)(\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00ce\u00c6\u00ea\u00ba\u00eb\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c0\u00ea\u00c7\u00e6\u00f3 \u00d1 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u0097\u00bd\u00e5\u00be \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u00ef\u00bc\u00cc\u00e0\u00c9\u00c8\u00b4\u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00bc \u00a6\u00e0 \u00ef\u00bc\u00c9\u00be\u00ea \u00a8\u00f9 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 ;\n\n(ii)\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c0\u00ea\u00c7\u00e6\u00f3 \u00d1 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u0097\u00bd\u00e5\u00be \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u00ef\u00bc\u00cc\u00e0\u00c9\u00c8\u00b4\u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00bc \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 ;\n\n(iii)\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00ef\u00c6\u00be\u00e0 \u00c2\u00e5\u00cd\u00fa\u00c7\u00c9, \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ef\u008c \u00ef\u00c6\u00bc\u00e9\u00c4\u00b4 \u00be\u00f8\u00c6\u0095\u00ba\u00c9\u00ba\u00f8\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ef\u008c \u00ef\u00c6\u00e5\u00bc\u00be \u00ef\u00cd\u00e5\u00e0\u00a8\u00f2\u00e8\u00c6\u00e5\u00ef\u008c \u00ef\u00c6\u00bc\u00fb\u00c4\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4 \u00ba\u00f8\u00ef\u00c2\u00be \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\u00a6\u00e0 \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ef\u008c \u00ef\u00c6\u00bc\u00fb\u00c4 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0\u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4 \u00a1\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 ;\u00cc\u00cd"
