    "chunk_text": "\u201c\u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00e5\u201d \u00c6\u00be\u00e0\u00be\u00b4, \u00c6\u008a \u00c9\u00da\u00ba\u00c4\u00e5\u00be \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00e5\u00aa\u00ba, \u00be\u00f8\u00c6\u00ba \u00ef\u00cd\u00e5\u00e0\u00cc\u008a\u00c3\u00e5\u00c9\u00f1 \u00b8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00aa\u00a8\u00f9\u00c4\u00a8\u00e0 \u00cc\u00cd \u00cc\u00e0\u00bb\u00fc\u00c7 \u00ef\u00c8\u00cc \u00bc\u00e6\u00be\u00aa\u00ba\u00e0\u00b8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00aa\u00a8\u00f9\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c8\u00e5\u00c3 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c9\u00aa\u00a8\u00f9\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c0\u00f2\u00bc\u00e5\u00be\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00b8\u00c6\u00c9 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00aa\u00a8\u00f9\u00c4\u00a8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9\u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00bc \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ;\n\n\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n3502007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n\u201c\u00c0\u00f2\u00bc\u00e5\u00be\u00a8\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00e0\u00ef\u00a8\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0\u00ef\u00bc\u00e0\u00c0\u00ce \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201d\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, XII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00a4\u00a8\u00cc\u201d \u00c6\u00be\u00e0\u00be\u00b4, \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00c8\u00a8 \u0097\u0090\u00be\u00e5\u00a8\u00c4 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00a1\u00e6\u00c0\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00c9\u00ec \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00ef\u008c ;\n\n\u201c\u00a4\u00a8\u00cc\u00e0 \u00c8\u00e5\u00c3\u00fa\u00c6\u00e5\u201d \u00c6\u00be\u00e0\u00be\u00b4, \u00c4\u00ea\u00c8\u00e0 \u00a4\u00a8\u00cc\u00e0\u00c8\u00e5\u00c3\u00fa\u00c6\u00e5 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00c8\u00cd\u00fa\u0095\u00a8\u00c4 \u00c8\u00c2\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00be \u00be\u00c4\u00ea\u00ba\u00e0, \u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00a3\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00be\u00e5\u00ef\u008c ;\n\n\u201c\u00c9\u00c7\u00b8\u00e9\u00c6 \u00cd\u00fa\u0095\u00a8\u008a\u00c0\u00e7\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00be\u00c9\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 (\u00a6\u00e0\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 1 \u00c9\u00be \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cd\u00e6\u00c7) \u00cc\u00bf\u00cd\u00be\u00e0 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4 \u00a1\u00bc\u00cd\u00cc\u00e0\u00ef\u008c ;\n\n\u201c\u00ef\u00bc\u00e0\u00c0\u00ce\u201d \u00c6\u00be\u00e0\u00be\u00b4,\n\n(\u00a1)\u00ae\u00e2\u00ae\u00c8 \u00cc\u00cd \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce ;\n\n(\u00a1\u00e5)\u00ae\u00e2\u00ae\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 ;\n\n(\u00a1\u00e6)\u00b8\u00c6\u00a8\u00e0 ;\n\n(\u00a1\u00e7)\u00be\u00b6\u00ea\u00c9\u00a8\u00b4 \u0097\u00cb\u00c6 \u00d1 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 ;\n\n(\u00a2)\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0,\n\n\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c.\n\n\u201c\u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00e5\u00c7\u00ba\u00e0\u00c9\u00c6\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ef\u00bc\u00e0\u00c0\u00ce\u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00bc \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n3512007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n\u201c\u00ef\u00bc\u00e0\u00c0\u00ce \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0\u2014\n\n(\u00a1)\u00c6\u008a \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00ef\u008a \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00a8\u00e0 \u00ef\u00c9\u00ba \u00c0\u00e6\u00c9\u00d7 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c8\u00c6\u00a8\u00e0\u00a8\u00f2\u00e8\u00c6\u00e5\u00ef\u008c \u00ef\u00c6\u00bc\u00d1\u00ef\u00c4\u00cd\u00fa \u00c8\u00e5 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0,\n\n\u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u00ef\u00cd\u00e5\u00e0\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u00cd\u00e5\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb,\u00a6\u00ef\u00cc\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00e5\u00c7\u00ba\u00e0\u00c9\u00c6\u00b4\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c2\u00c8\u00c6 \u00ba\u00f8\u00c2\u00ea\u00b8\u00bc \u00ef\u00be\u00e5\u00ba\u00f8\u00c2\u00ea\u00b8\u00bc\u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be \u00be\u00c4\u00ea\u00ba\u00e0, \u00a3\u00b4\u2014\n\n(\u00a1\u00e6)\u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8\u00c9 \u00ba\u00c4\u00e5\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00a8\u00eb \u00c4\u00aa\u00e8\u00be\u00e0\u00ef\u00cd\u00e5\u00e0\u2014\n\n(i)\u00a4\u00a8\u00cc\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ef\u00ce\u00cd\u00fa \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c8\u00e6\u009f\u00ef\u008a ;\n\n(ii)\u00a4\u00a8\u00cc\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8 \u00cc\u00be\u00e0\u00ba\u00a8\u00c6\u00b4 \u00a1\u00e6\u00ba\u00eb\u00dd\u00d1\u00ef\u008a \u00ef\u00cd\u00e5\u00e0\u00c0\u00e5\u00c8\u00be\u00c6 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a ; \u00ef\u00cd\u00e5\u00e0\n\n(iii)\u00a4\u00a8\u00cc\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0\u00a1\u00be\u00e0\u00cc\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u008a\n\n\u00c2\u00c8\u00c6\u00a8\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ef\u008c \u00ef\u00c6\u00e5\u00bc\u00c9\u00be \u00a4\u00a8\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e7)\u00a6\u00c9\u00e6\u00be\u00f8 \u00c6\u008a \u00a4\u00a8\u00cc\u00e0 \u00c8\u00e5\u00c3\u00fa\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0\n\n\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00be\u00e5\u00ef\u008c.\n\n\u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00c8\u00c6"
  },
