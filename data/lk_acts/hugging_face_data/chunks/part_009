    "chunk_text": "(vi)\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba \u00cc\u00c4\u00bb\u00c6\u00b4 \u00a6\u00ce\u00d0\u00c4 \u00cc\u00cd \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u00c6\u008a \u00c0\u00be\u00e0\u00ba\u00f8\u00c6\u00a8 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb\u00a6\u00e0 \u00cc\u00c4\u00bb\u00c6\u00b4 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 250 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00e0 \u00cc\u00c4\u00bb\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be \u00ef\u00cd\u00e5\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u00e8\u00c6\u00f5 \u00c4 \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00a6\u00a8\u00f9 \u00c0\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00e8\u00c6\u00f5 \u00c4 \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u0097\u00cb\u00c6\u00ef\u00c6\u00cd\u00fa\u00c2\u00e6\u00bf\u00fb\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00c7\u00be \u00c2\u00c9 \u00c0\u00e6\u00cd\u00e6\u00bc\u00fa\u00c8\u00e8 \u00a8\u00c7\u0095\u00be\u00e0; \u00cc\u00cd\n\n(vii)\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba \u00cc\u00c4\u00bb\u00c6\u00b4 \u00a6\u00ce\u00d0\u00c4 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u00c4\u00be\u00e0\u00c0\u00cc\u00ea \u00a6\u00e0 \u00cc\u00c4\u00bb\u00c6\u00b4 \u00a6\u00ce\u00d0\u00c4 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00cc\u00c4\u00bb\u00c6\u00b4\u00a6\u00ce\u00d0\u00ef\u008a \u00c4 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00c8\u00cc \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00a8\u00e5\u00da\u00c6 \u00c0\u0090\u00c0\u00e5\u0090\u00c6\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u0097\u00cc\u00e0\u00ba\u00c7 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u0095\u00be\u00e0,\n\n\u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 ; \u00cc\u00cd\n\n\u00bc\u00e6\u00be\u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00c8\u00e6\u009f \u00a1\u00e6\u00ba\u00f8 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00ce\u00e8\u00be\u00e0, \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00e5 \u00ef\u00c9\u00ba, \u00cc\u00c4\u00e5\u00aa\u00c4\u00ef\u00c9\u00ba, \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7 \u00aa\u00be\u00e0\u00be\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bc\u00e0\u0095\u00be\u00f8\u00cc\u00e0\u00ba\u00f2\u00e5\u00cc\u00e8\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c9\u00ba \u00bc, \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00bc, \u00c3\u00e5\u00c7 \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n250. (1) \u00ef\u00c4\u00cd\u00fa \u00c9\u00ec \u00cd\u00ba\u00e0\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00be\u00f8\u00c6\u00c4\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c0\u00be\u00e0\u00ba\u00f8\u00c6\u00a8\u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c0\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4 \u00a8\u00f9 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 5 \u00c9\u00be \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9,\u00c6\u008a \u00cc\u00c4\u00bb\u00c6\u00b4 \u00a6\u00ce\u00d0\u00c4\u00a8\u00e0, \u00a3\u00b4 \u00a6\u00c4 \u00db\u00cc\u00e0\u00d1\u00ef\u008a \u00bc\u00fb \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\u00a8\u00e0 \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9, \u00c0\u00e8\u00ce\u00e8\u00aa\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e0\u00be\u008a, \u00a6\u00e0 \u00cc\u00c4\u00bb\u00c6\u00b4 \u00a6\u00ce\u00d0\u00c4\u00a6\u00a8\u00f9 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9, \u00a6\u00e0 \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c0\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c0\u00be\u00e0\u00ba\u00f8\u00c6\u00a8 \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba\u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00cc\u00c4\u00bb\u00c6\u00b4 \u00a6\u00ce\u00d0\u00c4\u00a8\u00b4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\u00a8\u00e0 \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00a6\u00e0 \u00cc\u00c4\u00bb\u00c6\u00b4 \u00a6\u00ce\u00d0\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u00cc\u00cd\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5\u00c9 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 249 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8\u2014\n\n(\u00a1)\u00cc\u00e8\u00c6\u00f5 \u00c4 \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 ; \u00ef\u00cd\u00e5\u00e0\n\n\u00cc\u00c4\u00bb\u00c6\u00a8\u00b4 \u00a6\u00ce\u00d0\u00ef\u008a\u00c2\u00c8\u00c0\u00e7\u00c4.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba218\n\n(\u00a1\u00e5)\u00a6\u00a8\u00e0 \u00c0\u00be\u00e0\u00ba\u00f8\u00c6\u00a8\u00b4 \u00c9\u00e6\u0091 \u00c0\u00be\u00e0\u00ba\u00f8 \u00cc\u00e2\u00a9\u00f1\u00e5\u00c9\u00a8\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00a1\u00e6\u00ba\u00e0\u00be\u008a, \u00a6\u00e0 \u00c0\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u00cc\u00e8\u00c6\u00f5 \u00c4 \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0,\n\n\u00c2\u00e6\u00bf\u00fb \u00cc\u00e8\u0090\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
