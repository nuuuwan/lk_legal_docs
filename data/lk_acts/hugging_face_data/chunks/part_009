    "chunk_text": "\u201c\u00ef\u00c9\u00ef\u00ce\u00be\u00e0\u00bc\u00e5\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00aa\u00e6\u00be\u00f9\u00c4 \u00c4\u00ba \u00c3\u00e5\u00b8\u00e0\u00b6\u00cd\u00e5 \u00ef\u00cc\u00e0\u00c9\u00e5 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4\u00b4 \u00bc \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c8\u00c2\u00e5\u00bc\u00fb\u00c4\u00b4 \u00bc \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0\u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00c7\u00b8\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0\u2014\n\n(\u00a1)\u00b8\u00c6\u00c9\u00c7 \u00a8\u00e5\u0086 \u00c0\u00ba\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be \u00a1\u00ba\u00c7 \u00a3\u00b4 \u00ae\u00ea\u008a\u00c3\u00a8\u00bc\u00ba\u00e0\u00ba \u00ef\u00c6\u00e5\u00bc\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00a8\u00e5\u0086\u00c0\u00ba\u00a8\u00e0, \u00ba\u00cd\u00b6\u00ea\u00c9\u00a8\u00e0,\u00cc\u00e2\u00ef\u00a8\u00e0\u00ba\u00c6\u00a8\u00e0, \u00aa\u00fa\u00b8\u00ea\u008a \u00a1\u00e2\u00a8\u00c6\u00a8\u00e0, \u00c4\u00c6\u00fa\u00ef\u00a8\u00f2\u00e5\u008e\u00c0\u00e0\u00cc\u00e0, \u00bc\u00ee\u00ca\u00f1\u00a4\u00c0\u00a8\u00c7\u00b8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0 \u00bc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ; \u00ef\u00cd\u00e5\u00e0\n\n(i)\u00c3\u00e5\u00b8\u00e0\u00b6 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00b8\u00c6\u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00cc\u00c8\u00cc\u00e5 \u00ef\u00bc\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc; \u00ef\u00cd\u00e5\u00e0\n\n(ii)\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00cc\u00cd\u00c2\u00e6\u00e2\u00a8\u00eb \u00aa\u00fa\u00b8\u00ea\u00c4\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00ef\u00c9\u00be\u00ba\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u00e8\u00f3\u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc,\n\n\u00a8\u00e5\u0086\u00c0\u00ba\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4 \u00bc\u00c7\u00be\u00e0\u00be\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00be\u00b4 \u00ef\u00aa\u00d1\u008a\u00a4\u00c0\u00a8\u00f2\u00c4\u00c6 \u00bc\u00c7\u00be\u00e0\u00be\u00e5\u00ef\u00aa\u00e0 \u00aa\u00fa\u00b8\u00ea\u008a \u00a1\u00e2\u00a8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00be\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e8\u00c0\u00e8\u00be\u00c6\u00c9\u00e6\u00be\u00f8 \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6 \u00c4\u00ba \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8, \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00c7\u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00a6\u008a\u00ef\u00c2\u00e5\u00e0\u00cc\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ;\n\n212006 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4 \u00c9\u00e2\u00ae\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00be\u00ba\n\n\u201c\u00a1\u00ef\u00ce\u0097 \u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be \u00aa\u00ba \u00c6\u00be\u00e0\u00ba\u00f2 \u00b0\u00e5\u00c8\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00be\u00e0\u00be\u00e5\u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00ef\u00c6\u00e0 \u00ef\u00c6\u00e5\u00bc\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00ef\u00ce\u0097 \u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00aa\u00ba \u00c6\u00be\u00e0\u00ba\u00f2 \u00b0\u00e5\u00c8\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00be\u00f8\u00da\u00c4\u00e5\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4,\u00cc\u00ba\u00f1\u00e5\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00c0\u00e8\u00b4\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00c8\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00cc\u00e0\u00a8\u00f8\u0095\u00e2\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00a6\u00a8\u00e0 \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8 \u00ae\u00ea\u008a\u00c2\u00a8 \u00ba\u00f9\u00c7\u00e6\u00c9 \u00c4\u00ba\u00a1\u00e6\u00ba\u00f8 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00ba\u00e0\u00ba\u00c6\u00be\u00e0, \u00cc\u00ea\u00f3 \u00c0\u00e0\u00c8\u00e5\u00cc\u00e0\u0090\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd\u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00c9\u00f1\u00e5\u00b0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e5\u00b0 \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8\u00b4 \u00c0\u00e8\u00b4\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00a1\u00bc\u00cd\u00cc\u00e0\u00ef\u008c ;\n\n\u201c\u00b0\u00e5\u00c9\u00e5\u00c7\u008a \u00a8\u00f8\u00d7\u00c4\u201d \u00c6\u00be\u00e0\u00be\u00b4 \u00c9\u00f1\u00e5\u00b0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00c9\u00cc\u00c7 \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4 \u00a6\u00a8\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00c9\u00e6\u0091 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00be\u00f9\u00ba\u00f1\u00be\u00ea\u00a8\u00ed\u00c8 \u00c2\u00c8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e5\u00bd\u00e5\u00c7\u00b8\u00be\u00f8\u00bc\u00cd\u00cc\u00b4 \u00a8\u00c7\u00e6\u00b8\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00a1\u00e5\u00be\u00c6\u00be\u00c6\u00a8\u00f8\u00d7\u00c4, \u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00c4\u00e5\u00c7\u00e6 \u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00bc\u00cd\u00cc \u00a1\u00e6\u00ba\u00f8\u00c9 \u00c8\u00ad \u00ba\u00c2\u00e5\u00ef\u00aa\u00be \u00cc\u00e8\u009b\u00c4, \u00cc\u00ad\u00c9\u00e5 \u00ba\u00e6\u009f\u00c4, \u0095\u00c8 \u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00c4, \u0097\u00a8\u00f8\u00b8\u00e9\u00c4, \u00c8\u00c2\u00e5 \u00bc\u00fb\u00c4,\u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4, \u00aa\u00c2\u00b6\u00e5 \u00a8\u00f8\u00d7\u00c4, \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4,\u00db\u00ef\u00aa\u00be\u00c6\u00e5\u00c4, \u00c6\u00e6\u00d1\u00c4, \u00c3\u00e5\u00c7\u00bc\u00fb\u00c4, \u00c0\u00f2\u00cc\u008a\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c2\u00bc\u00e5\u00cd\u00e6\u00d7\u00c4 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00cd\u00ea\u00c9\u00c4\u00e5\u00c7\u00e6\u00c9\u00be \u00bc\u00ba\u00e0\u00ba\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0\u2014\n\n(\u00a1)\u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0\u00cc\u00e2\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6\u00a8 \u00aa\u00eb\u00b8\u00e5\u00e2\u00aa\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00bc\u00ba\u00e0\u00ba \u00a1\u00bc\u00cd\u00cc\u00e0\u00ef\u008c ;\n\n(\u00a1\u00e5)\u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00c0\u00c6\u00be\u00e0\u00be\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00c9\u00be \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6\u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0\u00a4\u00ba\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00c9\u00be \u00bc\u00ba\u00e0\u00ba \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n(\u00a1\u00e6)\u00cc\u00e2\u00be\u00f8\u00ef\u008c\u00bc\u00be \u00a1\u00e5\u00c7\u008a\u00c3\u00c6, \u00cc\u00e2\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00ef\u00c6\u00e0 \u00a1\u00c9\u00cc\u00e5\u00be \u00cc\u00e0\u00bb\u00e5\u00be\u00c6,\u00aa\u00c4\u00be\u00e0\u00c4\u00aa, \u00ef\u008c\u00c8\u00e5\u00c9, \u00bc\u00ba\u00e0\u00ba, \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6, \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00ef\u00cd\u00e5\u00e0\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u0097\u00cc\u00e0\u00ba\u00c7 \u00ef\u00c0\u00be\u00e0\u00c9\u00be\u00bc\u00ba\u00e0\u00ba\u00c6\u00be\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n(\u00a1\u00e7)\u00cc\u00e2\u00be\u00f8\u00ef\u008c\u00bc\u00be \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c6\u00a8\u00e0 \u00cd\u00c7\u00cd\u00e5 \u00aa\u00c8\u00e5\u00c6\u00be \u00c6\u008a \u00bc\u00ba\u00e0\u00ba\u00c6\u00be\u00e0\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c;\n\n222006 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4 \u00c9\u00e2\u00ae\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00be\u00ba"
  },
