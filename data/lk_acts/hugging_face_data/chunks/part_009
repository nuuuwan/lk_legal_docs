    "chunk_text": "(\u00a1)\u00a7\u00cd\u00ea \u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c8\u00cc \u00c0\u00ba\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u00c4\u00be\u00e0\u00c0\u00cc\u00ea \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00cd\u00c6 \u00c4\u00e5\u00cc\u00c6\u00a8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00c9\u00cc\u00be\u00e0 \u00d1\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00c4\u00e5\u00cc \u00ef\u00bc\u00a8\u00a8\u00b4 \u00c9\u00b6\u00e5 \u00c0\u00cc\u00ea \u00ef\u00be\u00e5\u00d1 ; \u00cc\u00cd\n\n\u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e6\u00c0\u00c6\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c9\u00e6\u0091\u00f3\u00c7 \u00c9\u00e5\u00da\u00ba\u00e5.\n\n3662007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n(\u00a1\u00e5)\u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00e5\u00c7\u00ba\u00e0\u00c9\u00c6 \u00a1\u00c9\u00cc\u00e5\u00be \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00c4\u00e5\u00cc\u00ef\u00bc\u00a8\u00a8\u00b4 \u00c9\u00b6\u00e5 \u00c0\u00cc\u00ea\u00ef\u00be\u00e5\u00d1,\n\n(2) 1 \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00ef\u00c9\u00cd\u00fa\u2014\n\n(\u00a1)\u00a3\u00b4 \u00c0\u00ec\u00da\u00c9 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8 \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00bc\u00e0\u00c0\u00ce\u0097\u00cc\u00e0\u00ba\u00c7 \u00cc\u00cd \u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00e5\u00c7\u00ba\u00e0\u00c9\u00c6\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce\u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c6\u008a \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5\u00c9\u00c8 \u0097\u00cc\u00e0\u00ba\u00c7 ;\n\n(\u00a1\u00e5)\u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00bc \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4, \u00c9\u00e5\u00da\u00ba\u00e5\u00ef\u008c \u00bc\u00fa\u00be\u00b4\u00a1\u00c6\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u0097\u00cc\u00e0\u00ba\u00c7 ;\n\n(\u00a1\u00e6)\u00c9\u00c7\u00b8\u00e9\u00c6 \u00cd\u00fa\u0095\u00a8\u008a\u00c0\u00e7\u008a \u00ba\u00f8\u00ef\u00c2\u00be, \u00c0\u00f2\u00bc\u00e5\u00be\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00b4,\u00c9\u00e5\u00da\u00ba\u00e5\u00ef\u008c \u00bc\u00fa\u00be\u00b4 \u00a1\u00c6\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u0097\u00cc\u00e0\u00ba\u00c7 ;\n\n(\u00a1\u00e7)(\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a1\u00c6 \u00cd\u00e6\u00c7, \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00b4\u00ef\u00aa\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00e5\u00da\u00ba\u00e5\u00ef\u008c \u00bc\u00fa\u00be\u00b4, \u00ba\u00f8\u009f\u00c4\u00b4 \u00a2\u00b6 \u00a1\u00e6\u00ba\u00f8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u0097\u00cc\u00e0\u00ba\u00c7,\n\n\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00e5\u00c7\u00ba\u00e0\u00c9\u00c6\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c6\u008a \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5\u00c9\u00c8 \u0097\u00cc\u00e0\u00ba\u00c7 \u00c9\u00e5\u00da\u00ba\u00e5\u00ef\u00c9\u00cd\u00fa \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4, \u00ef\u00bc\u00e0\u00c0\u00ce\u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00a8\u00da\u00ba\u00c9\u00f1 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ef\u008c \u00ef\u00c6\u00bc\u00d1\u00c4 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00ef\u00c2\u00e5\u00ef\u00cd\u00e5\u00e0 \u00ef\u00cc\u00c6\u00fa\u00be\u00e0\u00cd\u00e5\u00be\u00f8\u00a8\u00c7 \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c9 \u00a7\u00cd\u00ea \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00c6 \u00cc\u00c8\u00a8\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u00a6\u00c4 \u0097\u00cc\u00e0\u00ba\u00c7 \u00a7\u00cd\u00ea\u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00c6 \u0097\u00cc\u00e8\u00be\u00e0, (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c9\u00e5\u00da\u00ba\u00e5\u00ef\u00c9\u00be\u00e0 \u00a1\u00ba\u00e0\u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(4) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a1\u00be\u00ea\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be \u00cc\u00e7\u00c4\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00c4 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00a8\u00c7\u00be \u00a1\u00ba\u00c7 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4, \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00c0\u00b8\u00cc\u00e0\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4 \u00a7\u00cd\u00ea \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n3672007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n457\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 455 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 456\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00be\u00f8\u00c6\u0095\u00ba \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u2014\n\n(\u00a1)\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c8\u00cc \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00bc\u00e0\u00c0\u00ce \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c8\u00cc \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0\u00c4\u00aa\u00fa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0,\n\n\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4 \u00c4\u00ba \u00bc\u00fb\u00da\u00ab \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n458.(1) 455 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 456 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e6\u00c4 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00c4 \u00c0\u00e8\u00b4\u00c0\u00ba\u00a8\u00e0, \u00a6\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00be\u00f8\u00c6\u0095\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u2014\n\n(\u00a1)\u00c0\u00f2\u00bc\u00e5\u00be\u00a8\u00c7\u00e6 \u00ef\u00c9\u00ba ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00ef\u00bc\u00e0\u00c0\u00c8 \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6 \u00c0\u00ba\u00e0\u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00bc \u00a6\u00e0 \u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00c9\u00ba,\n\n\u00c6\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
