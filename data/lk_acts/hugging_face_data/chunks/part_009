    "chunk_text": "(2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00b7\u00cc\u00c1\u00ba\u00c6\u00b9\u00bc\u00c6 \u00ba\u00c7\u00b6\u00ba\u00c6 30 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7)\n\n\u00a3\u00bc\u00b1\u00c8\u00b8\u00bc\u00c6 \u00a4\u00ce\u00b5\u00b9\u00c6\u00b9\u0088 \u00a3\u00b1\u00c6\u00b1\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\n\n\u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00a3\u00b1\u00c6\u00d2\u00b6\u00c6 \u00b6\u00c8\u00ce\u00b5\u00af\u00c6\u00af\u00bf\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00b9\u00b6\u00c8\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00bd\u00c6\u00bd\u00d7\u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da 1\" \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00cc\u00c1\u00bf\u00c8\u0094\u00b4\u00c6\u00b4\u00df\u00c1\u00be\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00be\u00c7\u00ba\u00c6\n\n\u008c\u00ce\u00be : \u00f4\u00b9\u00c7 25'75\u00b6\u00b9\u00c7\u00bd\u00c6 \u00cc\u00b1\u00be\u00e2 : \u00f4\u00b9\u00c7 10\u00b000\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081\u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00ba\u00c6\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u00b8\u00c6 46 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n2006\" \u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00bc\u00c6 \u00ba\u00c7\u00b6\u00ba\u00c6 01 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb \u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6\u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00b9\u00c6 \u00b9\u00b6\u00c6\u00b6\u00c8\u00bc\u00c8\u00ce\u00af\u008a\u0081 II \u00a4\u00ba\u00c6 \u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00b7\u00c8\u00bc\u00b9\u00c6\u0089\u00bb\u00c7\u00af\u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 46 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c61\n\n2 \u2013PL 001322 \u2013 225 (2006/06)\n\n\u00d2\u00dd\u00af\u00c6\u00af\u00b9\u00c6 \u00cc\u00b9\u00bb\u00bc\u00c6\u00b0\n\n[2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00b7\u00cc\u00c1\u00ba\u00c6\u00b9\u00bc\u00c6 \u00ba\u00c7\u00b6\u00ba\u00c6 30 \u00a4\u00ba\u00c6 \u00b6\u00c8\u00af\u00b6\u00c8 \u00a3\u00b6\u00c6\u00b6\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00b0]\n\n\u00b1\u00b0\u00c1\u2013\u00ad\u00b0 47/2006\n\n\u00c1+\u00c6\u00af\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00ce\u00b6\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8\u00cc\u00b6\u00c7\u00dd \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081 \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b1\u00b4\u00c6\u00b4\u00ba\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00c7\u00d0\u00af :\u2013\n\n1\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 46 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00c1+\u00c6\u00af\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a9\u00b8 \u00a9\u00d5\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n2\u00b0 \u00a4\u008a\u00bc\u00b6\u00c6\u00d7\u00b6\u00c6 \u00cc\u00b6\u00c7\u00bf\u00c7\u008a\u00bc\u00b6\u00c6\u00d7 \u00a9\u00ae\u00b9\u00b6\u00c6\u00cc\u00b6\u00b4\u00c6\u00b4\u00c7\u00ba\u00c6 \u00a4\u00ae\u0088\u008130\u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 76\u00af \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2\u00a5\u00b6\u00c6\u00b6\u00c7\u00bd\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n(1) \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (3) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6\" \u00a3\u00b6\u0081 (\u00a4) \u00a9\u0081\u00d9\u00ba\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 (i) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8 \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c(i) \u00c1+\u00c6\u00af\u00c8\u00bb\u00c7\u00b8\u00d7\" \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u00b8 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00d9\u00bf\u00c6\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u2013\n\n(\u00a3)\u00c1+\u00c6\u00af\u00c8\u008a\u0081 \u00af\u00b4\u00c6\u00b4\u00c7\u00bb \u00ac\u00d5\u00af\u00c6\u00d0\u00ce\u00af\u00af\u00c6\u00af\u00c7\u00b8\u00c1\u00c0\u00af\u00c6\u00d0 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c6 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081\" VIII \u00a4\u00ba\u00c6\u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\" \u00aa\u00bd\u00c6\u00bd\u00ba\u00c7\u00bd\u00c6\u00bd+\u00c6\u00af\u00e0\u00b4\u0081\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00ac\u00d5\u00af\u00c6\u00d0\u00ce\u00af\u00af\u00c6\u00d0\u00ba\u00c6\u00a3\u00d7 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\u00e2\u00ba\u00c6 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4)\u00b9\u00b5\u00b1\u00c6\u00b1\u00ce\u00b9\u00bb\u00c7\u00b8\u00d7\" \u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6\u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u00b8 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00db\u00bc\u00b5\u00c7\u00af\u00e2\u00bf\u00c6\u00bf\u00ce\u00ba \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c8\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6\"\u00ce\u00c1\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00b7\u00be\u0081\u00af\u00dd\u00b6\u00c8\u00dc\u00ba\u00c6\u00b7\u00c8\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bd\u008a\u0081 \u00b7\u00c8\u00ce\u00be\u00dc\u00de\u00b6\u00c8\u00ce\u00bb \u00a7\u00de\u00b6\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00a3\u00c1\u00b1\u00c8\u00bb\u00b6\u00c6\u00ce\u00b6\u00af\u00c6 \u00af\u00dd\u00b6\u00c6\n\n1988 \u00a4\u00ba\u00c6\u00a4\u00ae\u0088\u008130 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00c1+\u00c6\u00af\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 76\u00af\u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 46 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c62"
