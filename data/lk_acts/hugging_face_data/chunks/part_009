    "chunk_text": "\u201c\u00b6\u00bc\u00e2\u201d \u00a9\u0081\u00b9\u00d7\" \u00ac\u00dd \u00af\u00b5\u00b8\u00c8\u008a\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00dd \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00a7\u00b9\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00c1\u0088\u00c1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b6\u00bb\u00c7\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00bb\u00c7\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00dd \u00af\u00b5\u00b8\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00af\u00bf\u00b3\u00c6\u00b1\u00c8\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00b6\u00c7\u00bd\u00c6\u00de\u008c\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd \u00b6\u00af\u00c1\u00be\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00dd\u00b6\u00c6\u00d7\u00dd\u00af\u00c6\u00af\u00bf\u00c6\u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00ac\u00dd \u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8\u00b6\u00c6\u00d7\u00c1\u00ba\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 30 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00a7\u00b9\u00c7\u00bb+\u00c6\u00af\u00bf\u00c8\u0081 \u00cd\u00ba\u00c7\u00b1\u0088\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c625\n\n\u201c\u00cd\u00ba\u00c7\u00b1\u0088\u00bb\u00c7\u00b8 \u00c1\u00b5\u00c8\u00af \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00a7\u00b9\u00c7\u00bb\u00b6\u00c6\u00ce\u00b6 \u00c1\u00b5\u00c8\u00af\u00bc\u00c6 \u00aa\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00c7\u00cc\u00bc\u00b8\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00e0\u00b7\u00ce\u00bc \u00b7\u00ba\u00c6\u00b9\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6 \u00c1\u00ce\u00af\u008a\u00be\u00c6 \u00a3\u00c1\u00ce\u00bc\u00b9\u00c6 \u0089\u00ce\u00c0\u00c1\u00c0\u00c8\u00dc\u00bb\u00c6\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00cc\u00af\u00b8\" \u00cc\u00b9\u00c7\u00bb\u00c6\u00bb\u00c7\u00b8\" \u0089\u00ce\u00c0\u00bb\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7\u0089\u00ce\u00c0\u00c1\u00c0\u00c8\u00dc\u00bb\u00c6\u00af\u00c6\u00af\u00c8\u0081\u00bd \u00b6\u00af\u00c1\u00ce\u00be\u00b9\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8\"\u00c1\u00b5\u00c8\u00af\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c7\u00af\u00b9\u00c6 \u00b9\u00c7\u00b1\u00c7+\u00c6\u00d0\u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd \u00ad\u00bc\u00c6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6\" \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00d0\u00e1\u008c\u00b8\u00c7\u00be\u00c6\" \u00a7\u00dd\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00ac\u00e1+\u00c6\u00af\u00ce\u00ba\u00b9\u00c6\u0089\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cc\u00c1\u00c7\u00dd \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00ba\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00db\u00e1\u00ba\u00c7\u00bc\u00c6\u00af\u00c6\u00af\u00b6\u00c6 \u00b6\u00bc\u00e2\u201d \u00a9\u0081\u00b9\u00d7\" \u00ac\u00dd \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2 \u00a7\u00b9\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c7\u00b7\u00c6\u00b6 \u00cd\u00af\u00c7\u00b4\u00c6\u0088\u0081\u00ba\u00c9\u00d7 \u00ba\u00c7\u00bc\u00c6\u00af\u00c6\u00af\u00ba\u00c6 \u00ac\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7\u00a5\u00bc\u00ae\u0088\u00be\u00c6 \u00ba\u00ce\u00bd\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00be\u00af\u00c6\u00af\u00ba\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00bd\u00c6\u00de\u00b5\u00c8\u00da \u00b1\u00c7\u00bc\u00c6 \u00b6\u00bc\u00e2\u00b4\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00bc\u00e2 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b9\u00c6\u00b9\u00c1\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00c1\u00c0+\u00c6\u00d0\u00b7\u00cc\u00bc\u00c7\u00dd\u00c1\u00dd\u00af\u00c6\u00d0 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u0081\u00cd\u00ba\u00be\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00a7\u00b9\u00c7\u00bb\u00cc\u00ba\u00c7\u0081\u00de \u00a9\u00c1\u00c6\u00c1\u00c7\u00e0\u00af\u00c6\u00d0 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7\u00a3\u00c1\u00c6\u00c1\u00c7\u00bf\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00b6\u00af\u00c1\u00be\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00b6\u00bc\u00e2\" \u00a7\u00ce\u00bc\" \u0089\u00ba\u00c6\u00b9+\u00c6\u00af\u00bf\u00c6\" \u00ac\u008b\" \u00d0\u00bd\u00c8\u0094\u00d5\u00af\u00bf\u00c6\"\u00af\u00b5\u00b8\u00c8 \u00b7\u00c8\u00af\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00af\u00bf\u00c6\" \u00b6\u00bc\u00e2\u00b6\u00c6\u00b6\u00bf+\u00c6\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00d8\u00ae\u00b9\u00b4\u00b6\u00c6\u00b6\u00af\u00d5 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00ce\u00bd \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6 ;\n\n\u201c\u00b6\u00af\u00c1\u00be\u00c6 \u00db\u00ce\u00bd\u00ce\u00ba\u201d \u00a9\u0081\u00b9\u00d7\" \u00d0\u00bc\u00ce\u00be \u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00bc\u00ce\u00c1\"\u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bc\u00ae\u00ce\u00b4\u00dc\u00ba\u00c6 \u00cd\u00b1\u00af\u00bc\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\" \u00cc\u00b1\u00bb\u00c6\u00db\u00ce\u00bd\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\" \u00af\u00bf\u00b3\u00c6\u00b1\u00c8\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\" \u00b6\u00c8\u00bd\u00ce\u00ba\u00bb\u00c7\u00af\u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\" \u00db\u00af\u00c7\u00ce\u00ba\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\" \u00af\u00b4\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\"\n\n26 2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 30 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00a7\u00b9\u00c7\u00bb+\u00c6\u00af\u00bf\u00c8\u0081 \u00cd\u00ba\u00c7\u00b1\u0088\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00cc\u00c1\u00bf\u00c8\u00af\u00c6\u00af\u00c7\u00b4\u00c6\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0\" \u00b9\u00bc\u00b9\u00c6\u00da\u00c1\u00b6\u00bd\u00c6\u00d0\" \u00ba\u00c7\u00bd\u00c6\u00de\u00c1\u00b6\u00bd\u00c6\u00d0\"\u00c8\u00a5\u00ce\u00b4\u00ba\u00c7\u00bd\u00c6\u00de\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd \u00a4\u00b4\u00c6\u00af\u00ce\u00bf \u00a9\u00b7\u00c6\u00b6\u00c8\u00bc+\u00c6\u00af\u00ce\u00bf \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00db\u00ce\u00bd\u00af\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00bf\u00c6\u00bf (\u00cc\u00b6\u00c7\u00ce\u00be\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00af\u00bf\u00c6\"\u00af\u00b5\u00b8\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00af\u00b5\u00b8\u00c8 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7\u00a5\u00ce\u00b4\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b1\u00c6 \u00b1\u00c7\u00b6\u00b8 \u00db\u00ce\u00bd\u00ce\u00ba \u00a3\u00be\u00c6\u00be\u00d7\u00a7\u00b9\u00db\u00ce\u00bd\u00af\u00bf\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a5\u00dd \u00db\u00ce\u00bd\u00ce\u00ba\u00af\u00bf\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00db\u00ce\u00bd\u00ce\u00ba\u00af\u00bf\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b4\u00c6\u00b4)\" \u00a9\u00b7\u00c6\u00b6\u00c8\u00bc\u00f2\u00be\u00ba\u00c6 \u00cc\u00b1\u00bb\u00be\u00c6\u00a5\u00bb\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u008a\u00d9\u00b3\u00c6\u00b1\u00bc\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00ce\u00af\u008a\u00b8\u00c7\u00be\u00c6 \u00a5\u00bb\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u008a\u00d9\u00b3\u00c6\u00b1\u00bc\u00c8\" \u00db\u00ce\u00bd\u00ce\u00ba\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081\" \u00cc\u00ba\u0081\u00af\u00be\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6\" \u00b7\u00c8\u00ce\u00be\u00cc\u00b9\u00c7\u00dd\u00ce\u00bf\u00dc\u00ba\u00c6\"\u00c1\u0081\u00af\u00be\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6 \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6 ;\n\n\u201c\u00c1\u00c0+\u00c6\u00d0\u00b7\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2 \u00a7\u00b9\u00c7\u00bb\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00c1\u00c0+\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00d0\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u0088 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00ba\u00c6\u00a3\u00b6\u0081\u00f2\u00be\u00ba\u00c6 \u00ac\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00bc\u00c9\u00b6\u00c8\u008a\u00be\u00c7\u00b8 \u00a7\u00bd\u00e2\u00db\u00ce\u00bd\u00ce\u00bb\u00a3\u00b6\u00ce\u00b8 \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b9\u00c6\u00b9\u00c1\u00dd\u00b4\u0081 \u00cc\u00b1\u00bb\u00c6\u00d7\u00cc\u00af\u00c7\u00bf\u00c6\u00af\u00c8\u0081\u00bd\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00c1+\u00c6\u00af\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00cd\u00c1\u00de \u00d0\u00e1\" \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9 \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00c8\u00de\u00c1\u00b8\u00ba\u00c6 \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;"
