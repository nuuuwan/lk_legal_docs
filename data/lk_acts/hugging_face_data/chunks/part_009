    "chunk_text": "\u201c\u00a5\u00b8\u00ba\u00c6\u00af\u00c7\u00b5\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00c8\u00af\u00c8\u00b1\u00c6\u00ce\u00b1 \u00a3\u00ce\u00bd\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7\"\u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00b7\u00be\u0081\u00af\u00ce\u00bf\u00b9\u00c6 \u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a7\u00bc\u00c8\u00b6\u00c6\u00d7\u00ce\u00b4\u00bb \u00a4\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0 \u00d2\u00af\u00c7\u00b6\u00c7\u00bc\u00af\u00c6 \u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00da\u00ba\u00c6 \u00b9\u00bc\u00c7\u00ba\u00bc\u00c8\u00b9\u00c6\u00da\u00ba\u00c6\u00a3\u00bf\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00af \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ba\u00dd\u00b6\u00c6\u00d7\u00c1\u00ba\u00ce\u00b8\u00af\u00bf\u00c8\u00be\u00c6 \u00a5\u00b8+\u00c6\u00af\u00c7\u00b5\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00c8\u00af\u00c8\u00b1\u00c6\u00ce\u00b1 \u00a3\u00ce\u00bd\u00af\u00bf\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6;\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 28 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b6\u00b1\u00c8\u00bb \u00af\u00c7\u00b9\u00c6\u00da\u00de\u00b6\u00c8\u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00b7\u00c8\u00b6\u00c8\u00bb\u00ba\u00c625\n\n\u201c\u00ba\u00c9\u00b8\u00c1\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00b1\u00c9\u00c1\u00cd\u00b8\u00c7\u00b9\u00c7\u00bb\u00cc\u00ba\u00c7\u0081\u00bd\u00c7\u00af \u00ba\u00c9\u0081\u0089\u0088\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u008b\u00be\u00c6 \u00a6\u00d5\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n\u201c\u00a7\u00bf\u00c6\u00f7\u00bc\u00c7\u00b4\u00c6\u00b1\u00c8\u00b1\u00c6 \u00cd\u00b1\u00ce\u00c1 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" 1974 \u00a4\u00ba\u00c6\u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a7\u00bf\u00c6\u00f7\u00bc\u00c7\u00b4\u00c6\u00b1\u00c8\u00b1\u00c6 \u00cd\u00b1\u00ce\u00c1\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00ce\u00ba\u00b6\u00c6\u00d7\u00dd\u00c1\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6;\n\n\u201c\u00a7\u00bf\u00c6\u00f7\u00bc\u00c7\u00b4\u00c6\u00b1\u00c8\u00b1\u00c6 \u00cd\u00b1\u00ce\u00c1 \u00ad\u00bb\u00c6\u00c1[\u00b6\u00c8\u00bb\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00a7\u00bf\u00c6\u00f7\u00bc\u00c7\u00b4\u00c6\u00b1\u00c8\u00b1\u00c6\u00cd\u00b1\u00ce\u00c1\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00ad\u00bb\u00c6\u00e2 \u00cc\u00b9\u00bd\u00c6\u00bd\u00c1\u00dd\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00b1\u00ce\u00c1\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00ad\u00bb\u00c6\u00c1[\u00b6\u00c8\u00bb\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00cc\u00b9\u00de\u00af\u00c8\u0081\u00bd\u00c1\u00dd\u00ba\u00c7\u00b8\u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n\u201c\u00ba\u00c7\u00af\u00c7\u00b5 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00cd\u00b1\u00ce\u00c1 \u00a3\u00df\u00c1\u00be\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" 1987 \u00a4\u00ba\u00c6\u00a4\u00ae\u0088\u0081 42 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00ba\u00c7\u00af\u00c7\u00b5 \u00b1\u00ce\u00b9\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b7\u00c8\u00bb\u00b6\u00c8\u00af\u00bf\u00c8\u0081\u00b9\u0088 \u00ba\u00c7\u00af\u00c7\u00b5\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u0081 \u00ba\u00c7\u00af\u00c7\u00b5\u00b9\u00c6\u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00cd\u00b1\u00ce\u00c1\u008a\u00be\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00df\u00af\u00c6\u00af\u00ba\u00bc\u00c6\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n\u201c\u00ba\u00c7\u00af\u00c7\u00b5 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00cd\u00b1\u00ce\u00c1 \u00ad\u00bb\u00c6\u00c1[\u00b6\u00c8\u00bb\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00ba\u00c7\u00af\u00c7\u00b5\u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00cd\u00b1\u00ce\u00c1\u008a\u0081 \u00cd\u00b1\u00ce\u00c1\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00ad\u00bb\u00c6\u00e2\u00cc\u00b9\u00bd\u00c6\u00bd\u00ba\u00c7\u00af\u00c7\u00b5\u00b1\u00ce\u00b9\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00ad\u00bb\u00c6\u00c1[\u00b6\u00c8\u00bb\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00b9\u00c6\u00cc\u00b9\u00de\u00af\u00c8\u0081\u00bd\u00c1\u00dd\u00ba\u00c7\u00b8 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6;\n\n\u201c\u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00a3\u00df\u00c1\u00be\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00cd\u00b1\u00ce\u00c1\u008a\u00be\u00c6 \u00a7\u00bf\u00c6\u00bf\u00c1\u00dd\u00ba\u00c6\u00a3\u00de\u00b9\u00d7 \u00c1\u00bb\u00d7\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00b7\u00c6\u00b6\u00c1\u00dd\u00ba\u00c7\u00b8 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00a3\u00df\u00c1\u00be\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n26 2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 28 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b6\u00b1\u00c8\u00bb \u00af\u00c7\u00b9\u00c6\u00da\u00de\u00b6\u00c8\u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00b7\u00c8\u00b6\u00c8\u00bb\u00ba\u00c6\n\n\u201c\u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00cd\u00b1\u00ce\u00c1 \u00ad\u00bb\u00c6\u00c1[\u00b6\u00c8\u00bb\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00cd\u00b1\u00ce\u00c1\u008a\u008b\u00dd\u00b7\u00c6\u00d7\u00ad\u00bb\u00c6\u00e2\u00cc\u00b9\u00bd\u00c6\u00de \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7 \u00ad\u00bb\u00c6\u00c1[\u00b6\u00c8\u00bb\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00cc\u00b9\u00de\u00af\u00c8\u0081\u00bd \u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00a3\u00df\u00c1\u00be\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n\u201c\u00b1\u00db\u00bc\u00c6\u00b6\u00c6\u00b6\u00c8 \u00b9\u00bb\u00d9\u00af\u00bc\u00c8\u201d \u00a9\u0081\u00b9\u00d7\" 1995 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 30 \u00a4\u00ba\u00c6\u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af \u00b1\u00db\u00bc\u00c6\u00b6\u00c6\u00b6\u00c8 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00b7\u00c8\u00bb\u00b6\u00c8\u00af\u00bf\u00c8\u0081\u00b9\u0088 \u00b7\u00be\u0081\u00af\u00ce\u00bf\u00b9\u00c6 \u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a7\u00bc\u00c8\u00b6\u00c6\u00d7\u00ce\u00b4\u00bb\u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n\u201c\u00d2\u00bb\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6 \u00da\u00bc\u00c8\u00dc\u00ba\u00c6 \u00a4\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00b6\u00c7\u00ba\u00c7\u00af\u00cd\u00c1 \u00b1\u00c9\u00c1\u00cd\u00b8\u00c7\u00b9\u00c7\u00bb\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00c1\u00b6\u00c8\u00be\u00c6 \u00a6\u00d5\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 28 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b6\u00b1\u00c8\u00bb \u00af\u00c7\u00b9\u00c6\u00da\u00de\u00b6\u00c8\u00b7\u00ba\u00c6\u0089\u00af\u00c6\u00ce\u00af\u00b9\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da \u00b7\u00c8\u00b6\u00c8\u00bb\u00ba\u00c627"
