    "chunk_text": "\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 4 \u00c9\u00be\u00c0\u00e8\u00b4\u00ea\u00c9, 1 \u00cc\u00e8\u00b4 8 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00e6\u00ba\u00eb\u00c8\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be :\u2014\n\n4.(1) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb, \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00cc\u00cd \u00a6\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0\u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00d7\u00ba\u00f8\u00c6\u00a8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00cd\u00ba\u00c7\u00ef\u00bc\u00be\u00a8\u00eb\u00ef\u00aa\u00be\u00e0\u00cc\u00c4\u00be\u00e0\u0097\u00ba \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6\u00a8\u00f8\u00d7\u00c4.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c9\u00a8\u00eb\u00aa\u00b6\u00ea \u00c0\u00bc\u00be\u00c4 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a)15\n\n(3) \u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00d1\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3\u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00e0\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00c9\u00ec \u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0\u00c4 \u00cc\u00cd \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c6\u00bb\u00e5\u00c0\u00d6\u00bc\u00fa \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00aa\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e7\u00c4\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0\u00c4 \u00be\u00c4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8 \u00be\u00e5\u00c4\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c4\u00b4 \u00cc\u00e6\u00c8\u00e6\u00cc\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6, \u00c6\u00be \u00c0\u00f2\u00ca\u00e0\u00be\u00c6 \u0097\u00c4\u00cc\u00be \u00c8\u00bc\u00fa\u00be\u00e0, \u00cc\u00c3\u00e5 \u00cc\u008a\u00c4\u00ba\u0097\u00c6.\n\n\u201c\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00c0\u00be\u00ba\u00e0 \u00ef\u00a8\u00b4\u00ea\u008a\u00c0\u00ef\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0\u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d \u00c6\u00be \u00c0\u00f2\u00ca\u00e0\u00be\u00c6 \u0097\u00c4\u00cc\u00be \u00c8\u00bc\u00fa\u00be\u00e0 \u00cc\u00c3\u00e5 \u00cc\u008a\u00c4\u00ba \u0097\u00c6.\n\n05 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\n\n\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6.\n\n4 \u00c9\u00be \u00c0\u00e8\u00b4\u00ea\u00c9 22 \u00cc\u00e8\u00b4 33 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00cc\u00cd 5 \u00c9\u00be \u00c0\u00e8\u00b4\u00ea\u00c9, 1 \u00cc\u00e8\u00b4 4\u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\n\n\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6, \u00c6\u00be \u00c0\u00f2\u00ca\u00e0\u00be\u00c6 \u0097\u00c4\u00cc\u00be \u00c8\u00bc\u00fa\u00be\u00e0, \u00cc\u00c3\u00e5 \u00cc\u008a\u00c4\u00ba\u0097\u00c6.\n\n06 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\n\n\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\n\n5 \u00c9\u00be \u00c0\u00e8\u00b4\u00ea\u00c9 5 \u00cc\u00e8\u00b4 14 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\n\n\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6, \u00c6\u00be \u00c0\u00f2\u00ca\u00e0\u00be\u00c6 \u0097\u00c4\u00cc\u00be \u00c8\u00bc\u00fa\u00be\u00e0, \u00cc\u00c3\u00e5 \u00cc\u008a\u00c4\u00ba\u0097\u00c6.\n\n07 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\n\n\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 5 \u00c9\u00be\u00c0\u00e8\u00b4\u00ea\u00c9, 15 \u00cc\u00e8\u00b4 33 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\n\n\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6, \u00c6\u00be \u00c0\u00f2\u00ca\u00e0\u00be\u00c6 \u0097\u00c4\u00cc\u00be \u00c8\u00bc\u00fa\u00be\u00e0, \u00cc\u00c3\u00e5 \u00cc\u008a\u00c4\u00ba\u0097\u00c6.\n\n08 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\n\n\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c9\u00a8\u00eb\u00aa\u00b6\u00ea \u00c0\u00bc\u00be\u00c4 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a)16\n\n6 \u00c9\u00be \u00c0\u00e8\u00b4\u00ea\u00c9, 1 \u00cc\u00e8\u00b4 32 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\n\n\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6, \u00c6\u00be \u00c0\u00f2\u00ca\u00e0\u00be\u00c6 \u0097\u00c4\u00cc\u00be \u00c8\u00bc\u00fa\u00be\u00e0, \u00cc\u00c3\u00e5 \u00cc\u008a\u00c4\u00ba\u0097\u00c6.\n\n09 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\n\n\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 6 \u00c9\u00be\u00c0\u00e8\u00b4\u00ea\u00c9, 33 \u00cc\u00e8\u00b4 36 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00cc\u00cd 7 \u00c9\u00be \u00c0\u00e8\u00b4\u00ea\u00c9, 1 \u00cc\u00e8\u00b4 10 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec\u00ef\u00c0\u00e0\u00c8\u00e8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\n\n\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6, \u00c6\u00be \u00c0\u00f2\u00ca\u00e0\u00be\u00c6 \u0097\u00c4\u00cc\u00be \u00c8\u00bc\u00fa\u00be\u00e0, \u00cc\u00c3\u00e5 \u00cc\u008a\u00c4\u00ba\u0097\u00c6.\n\n10 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\n\n\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 07 \u00c9\u00be\u00c0\u00e8\u00b4\u00ea\u00c9 11 \u00cc\u00e8\u00b4 17 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\n\n\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6, \u00c6\u00be \u00c0\u00f2\u00ca\u00e0\u00be\u00c6 \u0097\u00c4\u00cc\u00be \u00c8\u00bc\u00fa\u00be\u00e0, \u00cc\u00c3\u00e5 \u00cc\u008a\u00c4\u00ba\u0097\u00c6.\n\n11 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\n\n\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\n\n7 \u00c9\u00be \u00c0\u00e8\u00b4\u00ea\u00c9, 18 \u00cc\u00e8\u00b4 29 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be"
  },
