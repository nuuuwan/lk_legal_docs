    "chunk_text": "\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00cc\u00b1\u00c7\u00be\u00c6\u00be\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1+\u00c6\u00af\u00ba\u00c6 \u00a9\u00b9\u00c6\u00b9\u00be\u00c6\u00cd\u00c1\u00de \u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6 \u00af\u00dd\u00ba+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6 \u00a7\u00dd\u00c1\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00c7\u00a3\u00b9\u00c6\u00b9\u00be\u00c6\u00cd\u00c1\u00de \u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00af\u00dd\u00ba+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a5\u00d7\u00c1\u00ce\u00bc\u00cc\u00c1\u00bd\u00c6\u00bd\u00c8\u00af\u00bc\u00ba\u00c7\u00af \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00bd\u00c8\u00dc\u00ba\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00b7\u00b4\u00c7\u00b6\u00c6\u00b6\u00c8\u00dc\u00ba\u00c6 \u00c1\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf\u00b6\u00c7\u00b6\u00be\u00c7\u00df\u00ba\u00c6\" \u00a3\u00c1\u00c6 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00b6\u00c6\u00ce\u00b6 \u00a3\u00d9\u00ba\u00b6\u00c8\u00b6\u00c6\u00b6\u00be\u00c6 \u00cc\u00b9\u00c7\u00d7\u00ba\u00af\u00c6\u00af\u00bf\u00c6\u00b7\u0081\u00ce\u00ba\u00af\u00c6\u00af\u00c7\u00af\u008c\u00dd\u00af\u00c6\u00d0\u00ba\u00c7\u00b6\u00be\u00c7\u00df\u00ba\u00c6 :\n\n\u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00c6 \u00b1\u00b8\u00b7\u00c7\u00bb\u00af \u00cd\u00b1\u00c7\u00b1\u008b\u00b1\u00af\u00c6 \u00d0\u0088\u00bb\u00bc\u00b1\u00c8\u0081 \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b1\u00b4\u00c6\u00b4\u00ba\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00c7\u00d0\u00af :-\n\n1\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\" 2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 53 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00b6\u00bc\u00c6\u00ba\u00c7\u00bb\u00b6\u00b8\u00c7 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1+\u00c6\u00af\u00ba\u00c6 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a9\u00b8\u00a9\u00d5\u00b6\u00c6\u00d7\u00af\u00c6 \u00af\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n22006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 53 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b6\u00bc\u00c6\u00ba\u00c7\u00bb\u00b6\u00b8\u00c7\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1+\u00c6\u00af\u00ba\u00c6 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00cc\u00b9\u00c7\u00d7\u00af\u00c6\u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00bf\u00c6\u00b0\n\n3\u00b0 \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00ba\u00c6 \u00a3\u00ce\u00ba\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00cc\u00b9\u00c7\u00d7\u00af\u00c6 \u00d0\u00bd\u00c8\u00af\u00c6\u00cd\u00af\u00c7\u00bf\u00c6\u00af\u00bf\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b8\u00c1\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u00b8 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u00cc\u00c1\u00bf\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u00bd\u00d7 :-\n\n(\u00a3)\u00cd\u00b6\u00b1\u00c8\u00bb\" \u00ba\u00b6 \u00af\u00be\u00c7\u00b1\u00c6\u00b1\u00c7\u00bc \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00bf\u00c8\u0081 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00a8\u00af\u00c6\u00d0\u008c\u00b9\u00c6\u00da\u00af\u00c6\u00d0\u00ba\u00c7\u00b8 \u00cc\u00b1\u00bb\u00bd\u00c6\u00bd\u00c8\u00b4\u00c6\u00b4+\u00c6\u00af\u00ce\u00bf\u00b6\u00c6\u00b6\u00bb\u00c7\u00bc\u00c8\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 ;\n\n(\u00a4)\u00b6\u00bc\u00c6\u00ba\u00c7\u00bb\u00b6\u00b8\u00ce\u00c1\u00b9\u00c6 \u00cd\u00b9\u00d6\u00b6\u00be\u00c6\" \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\"\u00b9\u00bc\u00c7\u00ba\u00bc\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\" \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da \u00cc\u00b9\u00bf\u00b6\u00c6\u00b6\u00c7\u00cd\u00be\u00c7\u00af\u00ba\u00c7\u00c1\u00b6\u00c6\u00ce\u00b6\u008a\u00df\u00bf\u00c6\u00bf \u00a3\u00e2\u00af\u00c6\u00af\u00b5 \u00da\u00b6\u00c6\u00b6\u00cc\u00b9\u00dd\u00ba\u00c7\u00b8\u00c8\u0081\u00b1\u00c8\u00ce\u00be\u00ce\u00bb\u00b9\u00c6 \u00b9\u00c7\u00d7\u00af\u00c7\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00cd\u00b9\u00d6\u00b6\u00df\u00ba\u00c6 ;\n\n(\u00a5)\u00cc\u00b9\u00bf\u00b6\u00c6\u00b6 \u00b6\u00b6\u00c6\u00d7\u00c1\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6 \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00db\u00ce\u00bd\u00ce\u00bb\u00dc\u00ba\u00c6\u00b9\u00c7\u00d7\u00af\u00c7\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00a3\u00c1\u00bd\u00c6\u00ce\u00bd\u00b9\u00c6 \u00cd\u00b9\u00b5\u00c8 \u00c1\u00bf\u00bc\u00c6\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 ;\n\n(\u00a6)\u00cc\u00c1\u00bf\u00c6\u00bf\u00c1\u00b6\u00c6\u00ce\u00b6\" \u00cd\u00b9\u00c7\u00b6\u00c8\u00de\u00af\u00c6\u00af\u00c7\u00bc\u00c7\u00ba \u0096\u00b6\u00c8 48 \u00a4\u00ba\u00c6\u00a5\u00be\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00ce\u00ba\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf \u201c\u00be\u00af\u00c6\u008c\u00dd \u00cc\u00b1\u00c1\u00b8\u201d\u00a5\u00be\u00c6\u00be\u00b6\u00c6\u00ce\u00b6\u00b9\u00c6 \u00cd\u00b9\u00d6\u00b6\u00be\u00c6 ;\n\n(\u00a7)\u00c1\u00bd\u00c8\u00bb\u00c1\u00bc\u00c6\u00af\u00bf\u00c6\" \u00a4\u00b6\u00bc\u00c1\u00bd\u00c6\u00bd\u00c1\u00bc\u00c6\u00af\u00bf\u00c6\" \u00a3+\u00c6\u00af\u0096\u00b8\u00bc\u00c6 \u00ba\u00b7\u00c6\u00b6\u00cd\u00b9\u00c7\u00b1\u00ce\u00b8\u00bb\u00c7\u00b8 \u00cc\u00b9\u00bf\u00b6\u00c6\u00b6 \u00b1\u00c8\u00de\u00c1\u00bc\u00c6\u00af\u00bf\u00c6 \u00a4\u00af\u00c8\u00cd\u00bb\u00c7\u00dd\u00af\u00c6\u00d0\u00a7\u00b6\u008c\u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6 ;\n\n(\u00a8)\u00b6\u00ce\u00be\u00b7\u00af\u00bc\u00c8\u00df\u00bf\u00c6\u00bf \u00cc\u00b9\u00bf\u00b6\u00c6\u00b6 \u00ba\u00b6\u00d0\u00dd\u00ba\u00c7\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00cc\u00b9\u00c7\u00d7\u00b7\u00c8\u00ce\u00be\u008a\u00b8\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00ad\u00bb\u00c6\u008c\u00b4\u00ba\u00c6 \u00a3\u00bf\u00c8\u00b6\u00c6\u00b6\u00be\u00c6 ;\n\n(\u00a9)\u00da\u00b6\u00c6\u00b6\u00af \u00b1\u00c7\u00ce\u00be\u00ce\u00bb\u00dc\u00ba\u00c6 \u00d8{\u00be\u00af \u00cd\u00b1\u00ce\u00c1\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00b6\u00c7\u0089\u00b6\u00c6\u00b6\u00df\u00ba\u00c6\" \u00cd\u00b9\u00d6\u00b6\u00df\u00ba\u00c6 ;\n\n(\u00aa)\u00b1\u00c8+\u00c6\u00af\u00bf\" \u00b6\u00ba\u00c8\u00c0\u00c6\" \u00a4+\u00c6\u00af\u00c8\u00be \u00cc\u00ba\u00c7\u00c0\u00c8\u00af\u00bf\u00c8\u00be\u00c6 \u00cc\u00b9\u00bf\u00b6\u00c6\u00b6\u00a3\u00bd\u00cc\u00b7\u00bd\u00c8 \u0089\u00bc\u00b1+\u00c6\u00af+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00af\u00be\u00b7\u00c6\u00d7\u00ce\u00bc\u00bb\u00c7\u00b4\u00be\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00c1\u00d7\u00b4\u0081\" \u00a3\u00c1\u00bd\u00c6\u00ce\u00bd \u00a5\u00be\u00b6\u00c6\u00b6\u00c8\u00bc\u00b8\u00c8\u00bb\u00be\u00c6\u00a8\u00b4\u00af+\u00c6\u00af\u00bf\u00c6 \u00a8\u00b4\u00c7\u00af \u00ac\u008b\" \u00ac\u00bf\u00c8\u00b9\u00bc\u00b9\u00c6\u00da\u00b6\u00df\u00ba\u00c6 ;\n\n(\u00ab)\u00cd\u00b6\u00b1\u00c8\u00bb \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00ba\u00b6 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8\u00af\u00c6\u00d0 \u008c\u00dd\u00ba\u00c6\u00b9\u00b6\u00c6\u00b6\u00af\u00c6\u00af\u00b1\u00c8+\u00c6\u00af\u00bf\u00ba\u00c6\" \u00b6\u00ba\u00c8\u00c0\u00c6\" \u00a4+\u00c6\u00af\u00c8\u00be\u00ba\u00c6\" \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cd\u00c1\u00de\u00cc\u00ba\u00c7\u00c0\u00c8\u00af\u00bf\u00c8\u00df\u00ba\u00c6 \u00d8{\u00be\u00c6\u00af\u00bf\u00c6\" \u00b1\u00b3\u00c6\u00b1\u00c8\u00ce\u00af\u00af\u00bf\u00c6\" \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00d7\u00ae\u00d5\u00b9\u00c6\u0089\u00bc\u00d2\u00bc+\u00c6\u00af\u00ce\u00bf \u00cc\u00c1\u00bf\u00c8\u008a\u00d5\u00b6\u00be\u00c6 ;\n\n(\u00ac)\u00da\u00bc\u00c7\u00b6\u00b8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u0096\u00bc\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00b7\u00c8\u00ce\u00b8\u00e2\u00b1\u00c6\u00b1\u00c8\u0081\u00b8+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00cd\u00b9\u00d6\u00b6\u00be\u00c6 ;\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 53 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b6\u00bc\u00c6\u00ba\u00c7\u00bb\u00b6\u00b8\u00c7\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1+\u00c6\u00af\u00ba\u00c6 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c63\n\n(\u00ad)\u00cc\u00b9\u00bf\u00b6\u00c6\u00b6\u00bc\u00c6\u00af\u00bf\u00c7\u00b8 \u00a3\u00b8\u00c7\u00b6\u00bc\u00c1\u00c7\u00b8\" \u00db\u00d7\u00ce\u00ba\u00bb\u00ce\u00b4\u00b7\u00c6\u00b6\u00cd\u00b7\u00c7\u00bb\u00c7\u00bf\u00c8\u00af\u00e0\u00af\u00c6\u00d0 \u00b1\u00f2\u00af \u00b7\u00be\u0081\u00da\u00bc\u00c8 \u00b7\u00c8\u00ce\u00be\u00bb+\u00c6\u00af\u00ce\u00bf\u00b6\u00c6\u00b6\u00c7\u0089\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u00cd\u00b9\u00d6\u00b6\u00df\u00ba\u00c6 ;\n\n(\u00ac\u00bf)\u00cc\u00b9\u00bf\u00b6\u00c6\u00b6 \u00d0\u00dd\u00ba\u00c7\u00dd\u00af\u00c6\u00d0\u00ba\u00c6\" \u00a3\u00bd\u00cc\u00b7\u00bd\u00c8 \u00b9\u00c7\u00b4\u00b1\u00c7\u00ce\u00be\u00a4\u00b1\u00c8\u00bc\u00c8\u00bb\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00ba\u00c7\u00b5\u00c1\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6\" \u00af\u00b5\u00b8\u00c8 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00a8\u00b4\u00af\u00b9\u00c6 \u00b9\u008a\u00bd\u00c6\u00b1\u00c8\" \u00b7\u00c8\u00ce\u00be\u00bb+\u00c6\u00af\u00ce\u00bf\u00b6\u00c6 \u00b6\u00c7\u0089\u00b6\u00c6\u00b6\u00be\u00c6 ;"
