    "chunk_text": "(2) \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00c6\u008a \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00a8\u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00cc\u00e8\u0097\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea\u00c9\u00a8 \u00bc\u00fb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00c7\u00be\u00c8\u00bc \u00c6\u008a \u0097\u00c6\u00bc\u00c4\u00a8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00c9\u00e6\u00be\u00f8\u00c6\u008a \u00cc\u00e8\u0097\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea\u00c9\u00a8 \u00bc\u00fb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00c6\u008a \u00be\u00b6\u00ea \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00b4 \u00c2\u00e6\u00c7 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0\u00ef\u00cd\u00e5\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0\u0097\u00bd\u00e5\u00be\u00c6 \u00c4\u00ba \u00a8\u00c7\u00be\u00c8\u00bc \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9.\n\n2006 \u00a1\u00e2\u00a8 29 \u00bc\u00c7\u00be \u00c4\u00e5\u00bd\u00f1\u00ef\u008c\u00bc\u00fb\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00be \u00cc\u00c4\u00e5\u00b0\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00b8 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4\u00c6 \u00c0\u00be\u00ba11\n\n21.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n22.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00c0\u00bc \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00be\u00f1\u00e5\u00da\u00bb\u00c6\u00a8\u00e0\u00a1\u00c9\u00ca\u00f1 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u0095\u00cc\u2014\n\n\u201c\u00c4\u00e5\u00bd\u00f1\u00ef\u008c\u00bc\u00fa\u00c6\u00e5\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c4\u00ea\u00f7\u00e8\u00ba \u00cc\u00cd \u0097\u00bc\u00f1\u00ea\u00ba\u00e0 \u00c4\u00e5\u00bd\u00f1 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00c6\u008a\u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be \u00c4\u00e5\u00bd\u00f1\u00c6\u00a8\u00e0 \u00cd\u00c7\u00cd\u00e5 \u00c0\u00f2\u00c9\u00ee\u00ba\u00e0\u00ba\u00f8 \u00cc\u00cd \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00bc, \u00a6\u00c4\u00c0\u00f2\u00c9\u00ee\u00ba\u00e0\u00ba\u00f8 \u00cc\u00cd \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u0097\u00cc\u00e0\u00ba\u00c7 \u00bc, \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u008a, \u00cc\u00a8\u00cc\u00e0\u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00cd \u00c0\u00f2\u00ae\u00e5\u00c7\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00be\u00f8\u00c6\u00e6\u00c8\u00e9 \u00cc\u00e8\u0090\u00be \u00b0\u00be\u00c4\u00e5\u00bd\u00f1\u00ef\u008c\u00bc\u00fa\u00c6\u00a8\u00eb\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\nI \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\n[6 (5) \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6]\n\n\u00d5\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00a8\u00c8\u00ba\u00f2\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u0097\u00cc\u00e8 \u00a6\u00a8\u00b4 \u00a1\u00b6\u00ea \u00cc\u00ea\u00b0\u00e5\u00ba \u00bc\u00c7\u00e6\u00c9\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00ef\u00c8\u00e0 \u00ef\u00be\u00e5\u00ef\u00aa\u00c9\u00e5 \u00a2\u00ba\u00e8\u00d6\u00c9 \u00a1\u00e6\u00ba\u00f8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c9\u00be\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00a1\u00be\u00ea\u00c0\u00e5\u00ba\u00c6 \u00c9\u00be\u00ea\u00ef\u00c6\u00e0\u2014\n\n(\u00a1)\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u0097\u00cc\u00e8 \u00a6\u00a8\u00b4 \u00c9\u00e6\u0091 \u00d5\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00cc\u00ea\u00b0\u00e5\u00ba \u00bc\u00c7\u00e6\u00c9\u00be\u00e0 \u00a1\u00ba\u00c7 \u00cc\u00c4\u00e5\u00be\u00ea\u00c0\u00e5\u00ba\u00f8\u00a8\u00c9\u00ef\u00c2\u00bc\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(\u00a1\u00e5)\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u0097\u00cc\u00e8 \u00a6\u00a8\u00b4 \u00c9\u00e6\u0091 \u00d5\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00cc\u00ea\u00b0\u00e5\u00ba \u00bc\u00c7\u00e6\u00c9\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00eb \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u0097\u00b4 \u2013\n\n(i) \u00d5\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00ef\u00bc\u00c4\u008c\u00c0\u00e8\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00c6\u00a8\u00eb\u00b4 \u00c9\u00e6\u0091\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u009b \u00be\u008a, \u00a6\u00e0\u00ef\u00bc\u00c4\u008c\u00c0\u00e8\u00c6\u00be\u00e0 \u00a1\u00ba\u00c7, \u00cc\u00c4\u00e5\u00be\u00ea\u00c0\u00e5\u00ba\u00f8\u00a8\u00c9 \u00ef\u00c2\u00bc\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(ii) \u00ef\u00bc\u00c4\u008c\u00c0\u00e8\u00c6\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00c6\u00a8\u00eb \u00c0\u00c4\u00b8\u00a8\u00e0 \u00d5\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u009b\u00be\u008a, \u00c4\u00ea\u00f5 \u00c4\u00ea\u00bc\u00c8 \u00c4\u00a6\u00c4 \u00c4\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00c6\u00e5\u00b4 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(iii) \u00ef\u00bc\u00c4\u008c\u00c0\u00e8\u00c6\u00be\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb, \u00d5\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00c7\u00c6\u00be\u00e0\u00cc\u00cd \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00d6\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00c6\u00a8\u00eb\u00b4 \u00c9\u00e6\u0091\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u009b \u00be\u008a, \u00a6\u00e0 \u00d5\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be\u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00c7\u00c6\u00be\u00e0 \u00cc\u00cd \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00d6\u00c6\u00be\u00e0 \u00a1\u00ba\u00c7, \u00cc\u00c4\u00e5\u00be\u00ea\u00c0\u00e5\u00ba\u00f8\u00a8\u00c9 \u00ef\u00c2\u00bc\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(iv) \u00d5\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00a6\u00a8 \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00c7\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8 \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00d6\u00c6\u00a8 \u00c0\u00c4\u00b8\u00a8\u00e0 \u00cc\u00e8\u009b\u00be\u008a, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa, \u00a6\u00e0 \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00c7\u00c6\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00d6\u00c6\u00b4 \u00c4\u00ea\u00dd\u00c4\u00ea\u00bc\u00c8 \u00c4 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n2006 \u00a1\u00e2\u00a8 29 \u00bc\u00c7\u00be \u00c4\u00e5\u00bd\u00f1\u00ef\u008c\u00bc\u00fb\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00be \u00cc\u00c4\u00e5\u00b0\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00b8 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4\u00c6 \u00c0\u00be\u00ba12\n\nII \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\n[6 (6) \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6]\n\n\u00bc\u00e5\u00c6\u00a8\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 6 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (6)\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00a1\u00be\u00ea\u00c0\u00e5\u00ba\u00c6 \u00cc\u00cd \u00ef\u00aa\u00d1\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c0\u00f2\u00c4\u00ea\u00a9\u00ba\u00e5\u00c9\u00ef\u00c6\u00e0 \u00a1\u00be\u00ea\u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8 \u00c9\u00be\u00ea\u00ef\u00c6\u00e0 \u2013"
