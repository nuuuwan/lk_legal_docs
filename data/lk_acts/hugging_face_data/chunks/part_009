    "chunk_text": "(\u00a1\u00e6)\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00a8\u00c7\u00be \u00ef\u008c\u00c8\u00e5\u00ef\u008c\u00bc\u00fb \u00cc\u00c4\u00e5\u00aa\u00c4\u00b4 \u00ef\u00bc\u00e0\u00c0\u00ce \u0097\u00a8\u00eb\u00b8\u00be \u00c8\u00bc\u0097\u00a8\u00eb\u00b8\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00a8\u00c7\u00be \u00ef\u008c\u00c8\u00e5\u00ef\u008c \u00bc\u00fb \u00cc\u00c4\u00e5\u00aa\u00ef\u008a\u00c0\u00f2\u00c9\u00da\u00bd\u00a8\u00c6\u00a8\u00eb, \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c6\u00e5\u00e0\u00d4\u00ba \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00c9\u00be\u00ef\u00cd\u00e5\u00e0 \u00c9\u00ec \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a5\u00b0\u00ea\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00a8\u00f2\u00e5\u00a8\u00e5\u00c7\u00c9 \u00c6\u008a\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00ba\u00f8\u00c2\u00ec \u00a8\u00c8\u00e8\u00be\u00e0 \u00c9\u00ec \u00c9\u00da\u00cb \u00ef\u00bc\u00a8 \u00ba\u00eb\u00ce \u00bc\u00fb \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00a8\u00ce\u00ef\u00bc\u00e0\u00c0\u00ce \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00c6\u008a \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00ef\u00a8\u0090 \u0097\u00cc\u00e0\u00ba\u00c7.\n\n(\u00a1)\u00aa\u00fa\u0097\u00cc\u00ea\u00c4 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00c2\u00c8\u00e5\u00ef\u00c0\u00e5\u00ef\u00c7\u00e5\u00ba\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00bc\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00aa\u00fa\u0097\u00cc\u00ea\u00ef\u008a \u00c0\u00f2\u00bb\u00fc\u00c1\u00c8\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e5\u00d1,\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00be\u00f1 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00c8\u00e8\u00ef\u00c6\u00e0 \u00bc\u00fb \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00ec\u00ef\u00c6\u00e0 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u0095\u00c8\u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00cc\u00bf\u00cd\u00e5 \u00bc \u00a6\u00c4 \u00ef\u00bc\u00e0\u00c0\u00ce ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00aa\u00e6\u00be\u00ea\u008a \u0095\u00ef\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00c9\u00e6\u00bc\u00aa\u00ba\u00e0 \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce.\n\n11.\u00a8\u00f9\u00da\u00ba\u00f8\u00be\u00e5\u00c4\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u008c \u00be\u008a \u00a6\u00c6 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0\u00a8\u00c7\u0095\u00be\u00e0, \u00a2\u00cd\u00ba \u00a1\u00be\u00e0\u00ba\u00f8\u00c4\u00b4 \u00c9\u00ec \u00ef\u00d8\u00bc\u00c6 \u00a1\u00bc\u00e5\u00ce\u00c9\u00be \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0,\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ee\u00b8\u00c0\u00ba\u00f2\u00c9\u00c8\u00e8\u00be\u00e0 \u00aa\u00e6\u00be\u00ea\u008a \u0095\u00c8 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00aa\u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u008c \u00be\u008a, \u00a6\u00a8\u00f9 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6.\n\n4622007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n12.\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ee\u00b8\u00c0\u00ba\u00f2\u00c9\u00c8 \u00cc\u00cd\u00c3\u00e5\u00aa\u00d1\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00cd\u00c3\u00e5\u00aa\u00d1\u00c4\u00b4\u00a6\u00a8\u00ad\u00d1\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00cd\u00c3\u00e5\u00aa \u00a8\u00eb \u00b4\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00cd\u00c3\u00e5\u00aa \u00a8\u00eb \u00b4\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4\u00a6\u00a8\u00ad\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00a8\u00e5\u0095\u00cc\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00c9\u00ec \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ef\u00bc\u00a8 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00ef\u00aa\u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb (\u00a4\u00c0 \u00c0\u00f2\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00a8\u00e5\u0095\u00cc\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00ef\u00be\u00e5\u00c9\u00be) \u00ef\u00a8\u00e5\u0095\u00cc\u00e0 \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u008c \u00be\u008a \u00a6\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00c6\u008a \u00ef\u00a8\u00e5\u0095\u00cc\u00e0 \u00c4\u00ea\u00bc\u00c8\u00a8\u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8.\n\n13.\u00c4\u00ec\u00c8\u00e8\u00a8 \u0097\u00c6\u00bc\u008a\u00c9\u00c8 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00b8\u00be\u00e0 \u00c2\u00c8\u00be \u00c8\u00bc \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00cc\u00cd \u00a6\u00a8\u00f9\u0097\u00c6\u00bc\u008a\u00c9\u00c8\u00e8\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00ef\u00aa\u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00cc\u00cd \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a\u0097\u00c6\u00bc\u008a\u00c9\u00c8 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00b8\u00be\u00e0 \u00c2\u00c8\u00be \u00c8\u00bc \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00cc\u00cd \u00a6\u00e0 \u0097\u00c6\u00bc\u008a\u00c9\u00c8\u00e8\u00be\u00e0\u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00ef\u00aa\u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c9\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0.\n\n14.\u00a8\u00c8\u00e8\u00be\u00e0 \u00c9\u00ec \u00c9\u00da\u00cb \u00ef\u00bc\u00a8 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c6\u008a \u00c0\u00f2\u00c9\u00da\u00bd\u00a8\u00c6\u00a8\u00eb\u00b4 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00ef\u00bc\u00be \u00c8\u00bc\u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00ef\u00aa\u00d1\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00fb\u00c4\u00b4 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3\u00c6\u00a8\u00e0\u00cc\u00cd \u00ef\u00aa\u00d1\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3\u00c6 \u00bc\u00fb\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00ba\u00f8\u00cb\u00e0\u00b5\u00e5\u00c9.\n\n15.\u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be \u00ef\u00cd\u00e5\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00e5\u00c4\u00b4 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8 \u00cc\u00e5\u00c4\u00e5\u00be\u00f1 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00c8\u00e8\u00ef\u00c6\u00e0 \u00bc\u00fb \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00ec \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fa\u00be\u00c6\u00b4 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ef\u00bc\u00a8\u00a8\u00b4 \u00c9\u00b6\u00e5 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00ec \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00ef\u00be\u00e5\u00c9\u00be \u00cc\u00e7\u00c4 \u00c9\u00e6\u00bc\u00aa\u00ba\u00e0 \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8 \u00c4 \u00bc\u00fa\u00be\u00c6, \u00c0\u00e5\u00da\u00ca\u00e0\u00c9\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00cc\u00cd \u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00c6.\n\n16.\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00eb \u00ef\u008c \u00be\u008a \u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00e0 \u00be\u008a \u00cc\u00cd \u00c8\u00e8\u00c0\u00e8\u00be\u00c6\u00be\u00e0."
