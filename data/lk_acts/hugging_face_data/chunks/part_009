    "chunk_text": "(\u00a1)\u00cc\u00c4\u00e5\u00aa\u00c4 \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00c9\u00be \u00a1\u00ba\u00c7, \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u0097\u00b4, \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c8\u00a8\u00e0\u00cb \u00ef\u00bc\u00a8\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4 \u00c6\u00b4\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00ba\u00c9 \u00bc\n\n(\u00a1\u00e5)\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d7\u00c4 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00cc\u00e7\u00c4 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00c4 \u00c9\u00c7\u00bc\u00a8\u00b4\u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a1\u00ba\u00c7, \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u0097\u00b4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0\u00c8\u00a8\u00e0\u00cb\u00c6\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n163.(1) \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00c4\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u0097\u00aa\u00b8\u00be\u00c6\u00a8\u00c7\u00be \u00c8\u00bc \u00c4\u00ea\u00c8\u00f1 \u00c0\u00f2\u00a8\u00e5\u00ca \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00b4 \u00bc\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00ef\u008c\u2014\n\n(\u00a1)\u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c4\u00ba\u00c6\u00b4 \u00c9\u00ec \u00ef\u00cd\u00e0\u00ba\u00ed\u00be\u00e0 ;\n\n(\u00a1\u00e5) \u0097\u00aa\u00b8\u00be\u00ef\u00c6\u00e0 \u0097\u00cb\u00c6 \u00c0\u00bb\u00c6 \u00cd\u00e5 \u00c0\u00d6\u00cc\u00e9\u00c4\u00e5 ;\n\n(\u00a1\u00e6)\u00a1\u00c9\u00ca\u00f1 \u00cc\u00e8\u00c6\u00f5 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00cd\u00e5 \u00c0\u00e6\u00cd\u00e6\u00bc\u00fa\u00c8\u00e8 \u00a8\u00f8\u00d7\u008a \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00c2\u00e5\u00ef\u00aa\u00be \u00a1\u00e6\u00bc\u00e0\u00bc \u00c6\u00be \u00c9\u00aa ;\n\n(\u00a1\u00e7)\u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c4\u00ba\u00c6 \u00a1\u00be\u00ea\u00c9, \u00a6\u00e0\u00c9\u00e5 \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb\u00ef\u00c0\u00be\u00f9\u00c6\u00be \u00ba\u00e5\u00a8\u00e0 \u00f3\u00c7\u00b4 \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00cc\u00e8 \u00aa\u00fa\u00b8\u00ea\u008a \u00c9\u00e5\u00da\u00ba\u00e5 \u00ba\u00c2\u00e5\u00ef\u00aa\u00be \u00a1\u00e6\u00bc\u00e0\u00bc \u00c6\u00be \u00c9\u00aa ;\n\n(\u00a2)\u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c4\u00ba\u00c6 \u00a1\u00be\u00ea\u00c9, \u00c4\u00ea\u00c8\u00f1 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c9\u00c8\u00e8\u00be\u00e0 \u00cc\u00cd \u00c6\u008a\u00cc\u00c4\u00ec\u00cd \u00c4\u00ea\u00c8\u00f1 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c9\u00c8\u00e8\u00be\u00e0, \u00a6\u00e0\u00c9\u00e5 \u00a1\u00bc\u00e5\u00ce \u00a8\u00e5\u00c7\u00b8\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00cc\u00ba\u00f1\u00cc\u00cd \u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00a1\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00c0\u00be\u00e0\u00be\u00ea\u008a \u00a8\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00bc \u00c6\u00be \u00c9\u00aa \u00cc\u00cd\u00a6\u00e0\u00c9\u00e5\u00c6\u00fa\u00be\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00a1\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00c0\u00be\u00e0\u00be\u00ea\u008a \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u00a1\u00b6\u00ea\u00c0\u00e5\u00b6\u00ea\u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00a8\u00c9\u00c7 \u00a8\u00e5\u00c7\u00b8\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc \u00c6\u00be \u00c9\u00aa ;\n\n\u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5 \u00c2\u00e6\u00bf\u00fb\u008a\u00aa\u00e6\u00b4\u00f5\u00c9\u00c8\u00e8\u00be\u00e0 \u00c9\u00e6\u00ce\u00a8\u00f9\u00cc\u00e8\u0090\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0\u00c9\u00e5\u00da\u00ba\u00e5\u00c9.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba137\n\n(\u00a3)\u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c4\u00ba\u00c6 \u00a1\u00be\u00ea\u00c9, \u00c4\u00ea\u00c8\u00f1 \u00c0\u00f2\u00a8\u00e5\u00ca \u00cc\u00cd \u00c6\u008a \u00cc\u00c4\u00ec\u00cd\u00c4\u00ea\u00c8\u00f1 \u00c0\u00f2\u00a8\u00e5\u00ca, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa, 151 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00cd\u00e5\u00e0153 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a1\u00be\u00ea\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00c7 \u00ba\u00f8\u00ef\u0089 \u00bc \u00c6\u00be \u00c9\u00aa\u00cc\u00cd \u00a6\u00ef\u00cc\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00c7 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00be\u008a, \u00a1\u00b6\u00ea\u00c0\u00e5\u00b6\u00ea \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00a8\u00c9\u00c7\u00a8\u00e5\u00c7\u00b8\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc \u00c6\u00be \u00c9\u00aa,\n\n\u00c0\u00f2\u00a8\u00e5\u00ca \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0, \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9 \u00cc\u00c4\u00e5\u00aa\u00c4\u00b4\u00c3\u00e5\u00c7 \u00ef\u00bc\u00be \u00ef\u008c\u00c8\u00e5\u00ef\u008c \u00bc\u00fb \u00c4\u2014\n\n(\u00a1)(\u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cd\u00e6\u00c7) \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5\u00b4 \u00cc\u00c4\u00e5\u00aa\u00c4\u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00c6\u008a \u00c0\u00e5\u00c8\u00e8\u00ba \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00cc\u00c4\u00aa \u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00c6\u008a \u00c2\u00e6\u00bf\u00fb\u00c4\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u00c4\u00cd\u00fa \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00c6\u008a \u00c0\u00e5\u00c8\u00e8\u00ba \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c0\u00c9\u00ba\u00e0\u00be\u00e5\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00bd\u00ea\u00c7\u00c6 \u00bc\u00c7\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4\u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4 \u0097\u00aa\u00b8\u00a8 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00cd\u00e5 \u0097\u00c6\u00bc\u008a \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c4\u00ea\u00bc\u00c8\u00e0 \u00cc\u00cd \u00ef\u00c9\u00be\u00c4 \u0097\u00cb\u00c6\u00e5\u00e2\u00a8\u00c6\u00a8\u00e0\u00c9\u00ca\u00ef\u00c6\u00be\u00e0, \u00cc\u00cd \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0\u00cc\u00c8\u00cc\u00be \u00c8\u00bc \u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00cd\u00e5 \u0097\u00c6\u00bc\u008a \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0,\n\n\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00bc \u00cc\u00c4\u00e5\u00aa\u00c4\u00b4 \u00c3\u00e5\u00c7 \u00bc\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n164.(1) \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00a8\u00eb\u00b4 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00aa\u00fa\u00b8\u00ea\u008a\u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00c8\u00b4 \u00cd\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be\u00c9\u00c8\u00b4 \u00cc\u00e8\u00c6\u00f5 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8 \u00bc\u00fb \u00c0\u00f2\u00ef\u008c\u00ca\u00c6\u00a8\u00e0\u00cc\u00e6\u00c8\u00ef\u00cc\u00be \u00c2\u00c9\u00b4 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c9\u00aa\u00c2\u00c8\u00e5 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6."
