    "chunk_text": "(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a4\u00c8\u00e0\u00c8\u00e2\u00ab\u00be\u00c6 \u00a8\u00c7\u00be \u00a8\u00f8\u00cc\u00e8\u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7,\u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u00a2\u00bc\u00fa\u00d6\u00c0\u00e8\u00b4 \u00bc\u00fb \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00c8\u00ab\u00ea \u00be\u00b6\u00ea \u0097\u00c3\u00e5\u00aa\u00c6\u00a8\u00f8\u00be\u00e0\u00c0\u00cc\u00ea \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u008a \u00bc\u00fb \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00cd\u00e5\u00c7\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00b4\u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00a6\u00a8\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4\u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00bc\u00b6\u00c6 \u00cc\u00cd \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c6\u00be \u00bc\u00b9\u00ea\u00c9\u008a \u00ef\u00bc\u00a8\u00b4\u00c4 \u00ef\u00cd\u00e5\u00e0\u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n32.(1) \u00c4\u00cd\u00b0\u00be\u00c6\u00e5\u00b4 \u00c0\u00f2\u00ef\u008c\u00ca \u00d1\u00c4\u00b4 \u00cd\u00e6\u00a8\u00f8\u00c6\u00e5\u00c9 \u00ba\u00f8\u00ef\u00c2\u00be \u00a8\u00f8\u00cc\u00e8\u00f3\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8 \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00ef\u00cd\u00e5\u00e0 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00ef\u00c2\u00bc\u00e5\u00cd\u00d6\u00be \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c2\u00bc\u00e5\u00cd\u00e6\u00d7\u00c4\u00b4 \u00cd\u00e6\u00a8\u00f8\u00a8\u00c7\u00c9\u00be \u00c6\u008a \u00cc\u00e0\u00c9\u00c6\u00e2\u00a8\u00f2\u00e9\u00c6 \u0097\u00a8\u00eb\u00b8\u00ea\u008a \u00c6\u00be\u00e0\u00ba\u00f2\u00c6\u00a8\u00e0\u00cc\u0097 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u0097\u00a8\u00c7 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a8\u00f8\u00cc\u00e8\u00f3 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a1\u00c9\u00cc\u00c7\u00ef\u00be\u00e5\u00bc\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u201c\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00ef\u00cd\u00e5\u00e0 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00ef\u00c2\u00bc\u00e5\u00cd\u00d6\u00be \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c2\u00bc\u00e5\u00cd\u00e6\u00d7\u00c4\u00b4 \u00cd\u00e6\u00a8\u00f8\u00a8\u00c7\u00c9\u00be \u00cc\u00e0\u00c9\u00c6\u00e2\u00a8\u00f2\u00e9\u00c6 \u0097\u00a8\u00eb\u00b8\u00ea\u008a\u00c6\u00be\u00e0\u00ba\u00f2\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u2014\n\n(\u00a1) \u00cc\u00e0\u00c9\u00c6\u00e2\u00a8\u00f2\u00e9\u00c6\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00cc\u00cd\u00e5\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9 \u00a8\u00e5\u00cc\u00e8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00cc\u00e2\u00b3\u00e5\u00c0\u00ba\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00c8\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00a4\u00c0\u00a8\u00f2\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0\u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u008a \u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00ef\u00cd\u00e5\u00e0 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00ef\u00c2\u00bc\u00e5\u00cd\u00d6\u00be ; \u00cc\u00cd\n\n\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00ef\u00cd\u00e5\u00e0 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u0097\u00cc\u00e8 \u00a6\u00a8\u00b4\u00a1\u00b6\u00ea \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4\u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00ba\u00cd\u00be\u008a\u00a8\u00f8\u00d7\u00c4.\n\n\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00ef\u00cd\u00e5\u00e0 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00ef\u00c2\u00bc\u00e5\u00cd\u00e6\u00d7\u00ef\u008a\u0097\u00a8\u00eb\u00b8\u00ea\u008a \u00c6\u00be\u00e0\u00ba\u00f2 \u00cc\u00cd\u00cc\u00e0\u00c9\u00c6\u00e2\u00ef\u00cc\u00e0\u00c9\u00e5 \u00a8\u00f2\u00c4\u00ba\u00cd\u00be\u008a \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 27 \u00bc\u00c7\u00be \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00cd\u00e5 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba16\n\n(\u00a1\u00e5) \u00a6\u00c9\u00e6\u00be\u00f8 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u008a \u00a1\u00ba\u00c7\u00ba\u00eb\u00c7 \u00bc\u00fb \u00a1\u00b6\u00ea\u00c0\u00e5\u00b6\u00ea \u00c0\u00e8\u00c7\u00d1\u00c4\u00b4 \u00a1\u00c9\u00ca\u00f1\u00ef\u00be\u00e5\u00c9\u00be,\n\n\u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00cc\u00e0\u00c9\u00c6\u00e2\u00ef\u00cc\u00e0\u00c9\u00e5 \u00c6\u00be\u00e0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n(3) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a4\u00c8\u00e0\u00c8\u00e2\u00ab\u00be\u00c6 \u00a8\u00c7\u00be \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00a8\u00c7\u00be \u00a1\u00ba\u00c7, \u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb\u00a2\u00bc\u00fa\u00d6\u00ef\u00c6\u00e0 \u00c0\u00e6\u00c9\u00ba\u00e0\u00ef\u00c9\u00be \u00c8\u00ab\u00ea \u00be\u00b6\u00ea \u0097\u00c3\u00e5\u00aa\u00c6\u00a8\u00f8\u00be\u00e0 \u00c0\u00cc\u00ea \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u0097\u00b4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00bc\u00cd\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00bc\u00b6\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc\u00a8\u00b4\u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00bc\u00b6\u00c6 \u00cc\u00cd\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c6\u00be \u00bc\u00b9\u00ea\u00c9\u008a \u00ef\u00bc\u00a8\u00b4\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4\u00ba\u00e0 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n33. (1) \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa \u00c9\u00c8\u00e8\u00be\u00e0 \u00be\u00f8\u00c6\u0095\u00ba \u00f3\u008a\u00ef\u00a8\u00e5\u00ce\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00cc\u00e7\u00bc\u00fb\u00c4, \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4, \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4\u00b4\u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a4\u00c8\u00e0\u00c8\u00e2\u00ab\u00be\u00c6 \u00a8\u00c7\u00be \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7,\u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u00a2\u00bc\u00fa\u00d6\u00ef\u00c6\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00c8\u00ab\u00ea \u00be\u00b6\u00ea \u0097\u00c3\u00e5\u00aa\u00c6\u00a8\u00f8\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u008a \u00bc\u00fb \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00ef\u00bc\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00a6\u00a8\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4\u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00bc\u00b6\u00c6 \u00cc\u00cd \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c6\u00be \u00bc\u00b9\u00ea\u00c9\u008a \u00ef\u00bc\u00a8\u00b4\u00c4 \u00ef\u00cd\u00e5\u00e0\u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
