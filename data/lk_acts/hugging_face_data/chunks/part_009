    "chunk_text": "(4) \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0\u00a8\u00c4\u00ba\u00f8\u00a8 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0\u00ba\u00c2\u00e5\u00aa\u00e6\u00be\u00f9\u00c4 \u00a1\u00ba\u00e0\u00cd\u00e6\u00d6\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6. \u00a6\u00c9\u00e6\u00be\u00f8 \u00c6\u008a \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba\u00c6\u00a8\u00e0, \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0\u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00c2\u00e5\u00aa\u00e6\u00be\u00f9\u00c4 \u00ba\u00c4\u00e5\u00b4 \u00a1\u00c9\u00ca\u00f1 \u00a8\u00c7\u00be \u00c2\u00c9\u00b4 \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00c8\u00e8\u00c6\u0097\u00c8\u00e0\u00c8\u00a8\u00f8\u00be\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00b4 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00be\u008a, \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8\u00d1\u00c4 \u00a1\u00c9\u00cc\u00be\u00e0 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n4582007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n(5) \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00db\u00ef\u00aa\u00be \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00b4 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u00cc\u00e8\u00c6\u00c8\u00e0\u00c8 \u00c4 \u00a6\u00a8\u00ad\u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00c0\u00ce\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8,\u2014\n\n(\u00a1\u00e5)\u00c0\u00be\u00ef\u00ba\u00cd\u00fa \u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00cd\u00fa \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00be \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c0\u00be\u00ef\u00ba\u00e031 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00f2\u00a8\u00e5\u00c7\u00c9, \u00a6\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n42.\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6\n\n\u00ef\u00c4\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00ef\u00c6\u00cd\u00fa \u00c0\u00be\u00ba \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba \u00a1\u00bc\u00cd\u00cc\u00e0\u00c9\u00be \u00a1\u00ba\u00c7, \u00c0\u00be\u00ef\u00ba\u00e0 \u00a1\u00da\u00bb \u00be\u00e8\u00c7\u00e7\u00c0\u00be\u00c6 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c0\u00bc\u00c9\u00c8 \u00a1\u00da\u00bb\u00c6 \u00ef\u008a \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8\u00a1\u00da\u00bb\u00c6\u00c4 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6[31 (1) \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6]\n\n\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a6\u00e0\u00a8\u00c4\u00ba\u00e8\u00a8 \u00a1\u00be\u00ea\u00c4\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00c7\u00be \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8\u00cc\u00c4\u00e5\u00aa\u008a\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u00c9\u00be \u0097\u0093\u0097\u00bd\u00e5\u00be\n\n52 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00ba\u00f8\u00cb\u00e0\u00b5\u00e5\u00c9)\n\n53 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00a1\u00dd\u00ba\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u008a\u00c9\u00c8\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c0\u00ec\u00da\u00c9 \u00ae\u00a8\u00f2 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6)\n\n56 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00ef\u00c2\u00bc\u00e5 \u00cd\u00e6\u00d7\u00c4)\n\n60 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00c8\u00e5\u00c3\u00e5\u00e2\u00ca)\n\n61 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00ef\u00c2\u00bc\u00e5 \u00cd\u00e6\u00d7\u008a \u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4)\n\n64 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00ba\u00c4\u00e5\u00ef\u00aa\u00e0 \u00c4 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u0095\u00c8\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4)\n\n70 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00c4\u00ea\u00c8\u00f1\u00c4\u00c6 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00bc\u00fb\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u00e9\u00c4\u00e5 \u00a8\u00f8\u00d7\u008a)\n\n90 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00b4 \u00ef\u00c9\u00be\u00e0 \u00a8\u00ce \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4)\n\n92 (1) (\u00a1\u00e5) \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u0097\u00ef\u00ca\u00e0\u00cb \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00c7\u00be\u00c2\u00c8\u00ba\u00c8)\n\n99 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4)\n\n185 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00c0\u00f2\u00bd\u00e5\u00be \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00a8\u00f8\u00d7\u008a)\n\n192 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00ef\u00cd\u00ce\u00e8\u00bc\u00c7\u008c \u00a8\u00f8\u00d7\u00c4)\n\n193 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00a8\u00f8\u00d7\u008a \u00c4\u00aa\u00cd\u00e6\u00d7\u00c4)\n\n216 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00c0\u00e5\u00d6\u00ca\u00f2\u0095\u00a8 \u00cd\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3)\n\n217 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00b4 \u00b8\u00c6 \u00bc\u00fb\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u00e9\u00c4\u00e5\u00a8\u00f8\u00d7\u008a)\n\n218 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6(\u00cd\u00e5\u00be\u00f8\u00c0\u00ec\u00c7\u00b8\u00c6 \u00cd\u00e5 \u00c7\u00a8\u00e0\u00cb\u00b8\u00c6)\n\n4592007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n3 \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6[35(1) \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6]\n\n\u00a1\u00e6\u00c0\u00ef\u00c6\u00be\u00e0 \u00cc\u00e9\u0095\u00ba \u00cc\u00c4\u00e5\u00aa\u008a\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u00c9\u00be \u0097\u0093\u0097\u00bd\u00e5\u00be\n\niv \u00ef\u00a8\u00e5\u00b4\u00cc(\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cc\u00cd \u00cc\u00ee\u00b8\u00c0\u00ba\u00f2)\n\n93 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 98 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00bc\u00a8\u00e0\u00c9\u00e5(\u00cc\u00ea\u00dd \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00be\u00e0 \u00c0\u00c9\u00ba\u00f8\u00be \u0095\u00c8\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4)\n\n99 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 101 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00bc\u00a8\u00e0\u00c9\u00e5(\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00a8\u00b8\u00e0\u00b6\u00e5\u00c6\u008a)\n\n123 (1) (\u00a1\u00e5) \u00cc\u00cd (\u00a1\u00e6) \u00c9\u00aa\u00be\u00e0\u00ba\u00f8(\u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be\u00c6\u00e5 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9)\n\n124 (1) \u00cd\u00e5 (3) \u00c9\u00aa\u00be\u00e0\u00ba\u00f8(\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00ba\u00c2\u00be \u00cc\u00e0\u00bb\u00e5\u00be\u00c6)\n\n198 \u00cc\u00e8\u00b4 200 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8(\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00ef\u00cd\u00c8\u00e8\u00bc\u00c7\u008c \u00a8\u00f8\u00d7\u00c4)"
