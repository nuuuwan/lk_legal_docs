    "chunk_text": "(3) \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00a8\u00c7\u00aa\u00be\u00e0\u00be\u00e5 \u00a1\u00e6\u00c0 \u00c8\u00ba\u00e0 \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u2014\n\n(\u00a1)\u00c4\u00ea\u00bc\u00c8\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ca\u00eb\u00bc\u00e0\u00bd \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9\u00a1\u00c6\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6\u008a \u00ef\u00ca\u00e0\u00cb\u00c6\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00ea\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba \u00ef\u00be\u00e5\u00c9\u00ec \u00b8\u00c6\u00cd\u00fa\u0095\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cd\u00fa\u00c4\u00a8\u008a \u00c0\u00e7\u00c4\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6 ;\n\n(4) \u00cc\u00ea\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e6\u00c0\u00c6 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 ,\u00cc\u00ea\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4\u00a8\u00e0 \u00a8\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a,\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9 \u00cd\u00e5 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4 \u00be\u00f8\u00c6\u0095\u00ba \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00c7, \u00a6\u00cd\u00fa\u2014\n\n(\u00a1)\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9 \u00cd\u00e5 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u0097\u00cc\u00e0\u00ba\u00c7 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(\u00a1\u00e5)\u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6 \u00ef\u00bc\u00be \u00c8\u00bc \u00bc\u00fa\u00be\u00c6 \u00bc \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00a6\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u008a\u00c0\u00ec\u00da\u00b8\u0097\u00cc\u00e0\u00ba\u00c7 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00ba\u00c9 \u00bc,\n\n(\u00a1\u00e6)\u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4 \u00cd\u00e5 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6 \u00ba\u00cd\u00c9\u00ea\u00c7\u00e6 \u00ef\u00a8\u00ef\u00c7\u00be \u00ef\u00c8\u00e0\u00a9\u00be \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6,\n\n\u00ba\u00c9\u00bc, \u00cc\u00ea\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4\u00a8\u00b4359 \u00c9\u00be, 360 \u00c9\u00be \u00cc\u00cd 362 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00bc\u00e5\u00ce \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(5) \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u2014\n\n(\u00a1) (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00ba\u00e8\u00ef\u00c6\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00cd\u00fa \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0\u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00ef\u00c8\u00cc \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6 ; \u00ba\u00c9 \u00bc\n\n2802007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n(\u00a1\u00e5)(4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4\u00a8\u00e0 \u00bc\u00fa\u00c9\u00ea\u00c7\u00e6\u008a\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u00ba\u00f1\u00e5\u00c6\u00be\u00c6 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6\u00c6\u00fa \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(6) (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4\u00a8\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0\u2014\n\n(\u00a1)\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9 \u00cd\u00e5 \u00cd\u00fa\u0095\u00a8\u008a\u00c0\u00e7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\n\n(\u00a1\u00e5)\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9 \u00cd\u00e5 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4 \u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00b6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00a6\u00ef\u00cd\u00ba\u00e0\u2014\n\n(i)\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00a8\u00e0 \u00cc\u00cd \u00b8\u00c6 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4\u00a8\u00e0 \u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00ef\u00c6\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a1\u00b6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8,\u00b8\u00c6 \u00cd\u00fa\u0095\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0, \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00c8\u00e6\u009f\u00ef\u00c4\u00be\u00e0 \u00c9\u00e6\u00b6 \u00a8\u00c7\u00be \u00bc\u00fa\u00be \u00bc\u00cd\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c0\u00f2\u00ba\u00f8\u00ef\u00ca\u00e5\u00e0\u0093\u00ba\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00a8\u00e0 \u00cd\u00e5 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4\u00a8\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6 ; \u00ba\u00c9 \u00bc\n\n(ii)\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00a8\u00e0 \u00cd\u00e5 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4\u00a8\u00e0 \u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00a1\u00b6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c9\u00e6\u00c7\u00bc\u00fa \u00ef\u00c8\u00cc \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e6\u00c6\u00fa\u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u00ba\u00bc\u00be\u00be\u00e0\u00ba\u00c7\u00c9 \u00cc\u00c8\u00a8\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0\u00a6\u00c4 \u00ba\u00f9\u00c7\u00b8\u00c6 \u00c0\u00f2\u00ba\u00f1\u00e5\u00bc\u00fa\u00cb\u00e0\u00b4 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4,\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(7) \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0\u2014\n\n(\u00a1)(6) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00a8\u00e0 \u00cd\u00e5\u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec ;\n\n(\u00a1\u00e5)(6) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c0\u00f2\u00ba\u00f8\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00a8\u00e0 \u00cd\u00e5 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec ;\u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e6)(6) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (II) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0, \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4\u00a8\u00e0 \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00f8\u00d7\u00ef\u008a \u00ba\u00f9\u00c7\u00b8\u00c6\u00a8\u00e0\u00c0\u00f2\u00ba\u00f1\u00e5\u00bc\u00fa\u00cb\u00e0\u00b4 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00a8\u00e0\u00cd\u00e5 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec,"
