    "chunk_text": "\u00c6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u0095\u00c8\u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u0095\u00c8 \u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c4\u00be\u00e5\u00c0\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c6\u00ba \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00be\u00e0\u00ef\u00bc\u00e0\u00cc\u00e8 \u00cc\u00cd\u00e8\u00ba \u00c6\u008a\u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00d1 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c4 \u00ef\u008a \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00b8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5\u0097\u00a8\u00eb\u00b8\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n25.\u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u00c2\u00bc\u00e0\u00bc\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u2018\u0097\u00a8\u00eb\u00b8\u00ea\u008a\u00a8\u00c7\u00e6\u2019 \u00c6\u00be \u00ef\u00c6\u00f3\u00c4\u00b4 \u00c2\u00f3\u00bc\u00fb\u00c4\u00be\u00e5\u00a8\u00c7\u00e6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00ec \u00ef\u00c8\u00cc \u00bc\u2018\u00aa\u00e6\u00be\u00ea\u008a \u0095\u00c8\u2019 \u00c6\u00be \u00ef\u00c6\u00f3\u00c4\u00b4 \u00c2\u00bc\u00e0\u00bc \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c0\u00f2\u00ba\u00f8\u00cb\u00e0\u00b5\u00e5\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00ec \u00ef\u00c8\u00cc\u00bc\u2018\u00a4\u00c0\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u2019 \u00c6\u00be \u00ef\u00c6\u00f3\u00c4\u00b4 \u2018\u00a4\u00c0 - \u00c2\u00f3\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u2019 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00ec \u00ef\u00c8\u00cc\u00bc\u00ef\u008a \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n26.\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ee\u00b8 \u00c0\u00ba\u00f2\u00c9\u00c8\u00b4 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00d1\u00c4 \u00aa\u00e6\u00be 8 \u00c9\u00be \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a\u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00a6\u00e0\u00c9\u00e5 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4\u00b4 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00bc\u00cd\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0\u00c9\u00e5 \u00ef\u00c9\u00be\u00e0 \u00a8\u00c7\u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00e0 \u00a8\u00c7 \u00bc\u00e9\u00c4\u00b4 \u00a6\u00a8\u00ad\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00be\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00c4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n27.\u0097\u00a8\u00eb\u00b8\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00c9\u00ec\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, 10 \u00c9\u00be \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00ef\u00c9\u00be\u00e0 \u00ef\u00c9\u00be\u00e0 \u0097\u00a8\u00eb\u00b8\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n28.\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00c0\u00cd\u00a8\u00b4 \u00a1\u00b6\u00ea \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00a8\u00c7\u00ef\u00aa\u00be \u00aa\u00fa\u00c6 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3\u00c0\u00cd\u00a8\u00b4 \u00a1\u00b6\u00ea \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00aa\u00fa\u00c6 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u0097\u00b4\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00aa\u00fa\u00b8\u00ea\u008a \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00cd\u00ba\u00c7\u00a8\u00e0, \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ba\u00eb\u00be\u00a8\u00e0, \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3\u00ef\u00bc\u00a8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c0\u00c4\u00b8\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00ef\u00a8\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb 20 \u00c9\u00be, 21 \u00c9\u00be \u00cd\u00e5 22 \u00c9\u00be \u00ef\u00d8\u00bc\u00c9\u00c8 \u0097\u0093\u0097\u00bd\u00e5\u00be, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba\u00c0\u00d6\u00bc\u00fa \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00cd\u00ba\u00c7\u00a8\u00e0, \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ba\u00eb\u00be\u00a8\u00e0, \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ef\u00bc\u00a8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00f8\u00d7\u00e8\u008a \u00c0\u00cc\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00f8\u00d7\u008a\u00c9\u00c8\u00b4\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00cc\u00e0 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n29.20 \u00c9\u00be, 21 \u00c9\u00be \u00cd\u00e5 22 \u00c9\u00be \u00ef\u00d8\u00bc\u00c9\u00c8 \u2018\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00da\u00cb\u00c6\u2019 \u00c6\u00be \u00ef\u00c6\u00f3\u00ef\u00c4\u00be\u00e0\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00aa\u00fa\u00b8\u00ea\u008a \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c\u00c6\u008a \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc \u00a6\u00e0 \u00c9\u00da\u00cb\u00c6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be \u00a1\u00ba\u00c7 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00cd\u00e5\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00da\u00cb\u00c6 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00be \u00bc\u00fa\u00be\u00c6 \u00ef\u00c9\u00be\u00cc\u00e0 \u00d1\u00e8\u00ef\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a\u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00aa\u00fa\u00b8\u00ea\u008a \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc\u00a8\u00b4 \u00c9\u00e6\u0091 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00b6\u00ea \u00a8\u00e5\u00c8 \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00e0 \u00c9\u00e6\u0091 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00b6\u00ea \u00a8\u00e5\u00c8 \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6 \u00a6\u00c4\u00ef\u00d8\u00bc\u00c9\u00c8 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
