    "chunk_text": "\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00818 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c620\u00a3\" 20\u00a4\u00a9\u0081\u00d9\u00ba\u00c6 \u00da\u00b6\u00c8\u00bb\u0089\u00bc\u00c8\u00e2\u00af\u00ce\u00bf\u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u201c\u00b6\u00ce\u00b4 \u00cc\u00b1\u00bb\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00af\u00c6\u00af\u00c7\u00b8\u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8\u00b7\u00ce\u00b4\u00db\u00ce\u00bd\u00b0\n\n12 2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 35 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af \u00af\u00c7\u00b5\u00c8\u00ba\u00c9\u00b4\u00c6\u00da \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00ba\u00c6 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(3) \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a3\u00ce\u00c0\u00b9\u00c6\u00b9\u00c7\u00ce\u00b5 \u00a9\u00b7\u00c6\u00b6 \u00a4\u00e0\u00af\u00c6\u00d0\u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00a4\u00bf\u00c6 \u00a3\u00ce\u00c0\u00b9\u00c6\u00b9\u00c7\u00ce\u00b5\u008a\u00be\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de\" \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u00cd\u00b6\u00c7\u0081\u00bd\u00b6\u00c6 \u00b6\u00c1\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00bd\u00c6\u00d0 \u00a9\u00b6\u00c8\u00bc\u00c7\u00af\u00af\u00c6 \u00af\u00c7\u00bc\u00b5\u00ba\u00c6\u00a9\u00d7\u00e2\u00ba\u00c6 \u00af\u00c7\u00b4\u00c6\u00d5\u00c1\u00b6\u00bd\u00c6\u00af\u00c8\u00be\u00c6\u00ce\u00be \u00a9\u00b8 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c7\u00b8\u00d7 \u00a7\u00b4\u00b8\u0088\u00bb\u00c7\u00af \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00cd\u00af\u00c7\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00de \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(4) \u00a9\u00b7\u00c6\u00b6 \u00a4\u00e0\u00af\u00c6\u00d0 \u00a3\u00ce\u00c0\u00b9\u00c6\u00b9\u00c7\u00ce\u00b5 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00a4\u00bf\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00cd\u00b6\u00c7\u0081\u00bd\u00c8\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00c1\u00c0+\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u00af\u00c6 \u00af\u00c7\u00b4\u00c6\u00d5\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00af\u00c7\u00bc\u00b5\u00ba\u00c6 \u00b6\u00ba\u00af\u00c6\u00d0\u00ae\u00d5 \u00a9\u00b8\u00af\u00c6 \u00e7\u00bd\u00c8\u00b8\u00c7\u00be\u00c6\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6 \u00a7\u00b4\u00b8\u0088\u00bb\u00c7\u00af \u00c1\u00c0\u00af\u00c6\u00ce\u00af\u00b6\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b7\u00c6\u00d7\u00b7\u00b4\u00b6\u00c6\u00b6\u00be\u00c7\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u0089\u00b7\u00c6\u00b6\u00c8\u00bb \u00cd\u00b6\u00b6\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00be\u00c6\u008c\u00b1\u00c7\u00bc\u00ce\u00b5\u00af\u00c6\u00af\u00c7\u00af \u00c1\u00c0\u00af\u00c6\u00ce\u00af \u00ac\u00b6\u00c6\u00b6\u00c8\u00ce\u00c1\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n(5) \u00b7\u00c9\u00b6\u00c8\u00c1\u00c7\u0081 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00a4\u00b6\u00c7\u00bc\u00ba\u00c7\u00af \u00b1\u00c7\u00b4\u00c6\u00b1\u00c8\u00bb\u00ba\u00c6 \u00a9\u00b6\u00ce\u00b8\u00dc\u00ba\u00c6 \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u0089\u00bc\u00b6\u00c7\u00b8 \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00de \u00a3\u00df\u00c1\u00be\u00bc\u00c8\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7\u00cd\u00af\u00c7\u00dd\u00c1\u00b6\u00bd\u00c6\u00d0\u00b6\u00c6 \u00b6\u00d0\u00b6\u00c8\u00dc\u00ce\u00b4\u00bb\u00b6\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(6) \u008c\u00b1\u00c7\u00bc\u00ce\u00b5\u008a\u0081 \u00db\u0088\u008c\u00be\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cd\u00af\u00bd\u00c6\u00b9 2\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d72\u00a4 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 4\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 20\u00a5 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00de \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00ce\u00bd \u00c1\u00c0+\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00b6\u00c6\u00ce\u00b6\u00b6\u00c6 \u00b6\u00bf\u00c6\u00e0\u00b9\u0088 \u00cc\u00b1\u00bb\u00c6\u00bb\u00be\u00c7\u00ba\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 35 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af \u00af\u00c7\u00b5\u00c8\u00ba\u00c9\u00b4\u00c6\u00da \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00ba\u00c6 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c613\n\n20\u00a4\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6\u00b6\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00c0\u00af\u00c6\u00d0 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00c7\u00b5\u00c8 \u2013\n\n(\u00a3)\u00af\u00c7\u00b5\u00c8\u00ba\u00c9\u00b4\u00c6\u00da \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00b9\u00c7\u00af2 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c7\u00b8 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00bd\u00c8\u00be\u00c6 \u00a3\u00ce\u00ba\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf\u00b6\u00c7 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4)2\u00a4 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 \u00af\u00c9\u00c0\u00c7\u00b8 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00c7\u00c0\u00c6\u00b7\u00c8\u00be\" \u00b1\u00d7\u00b9\u00c6\u00da\u00b7\u00c8\u00be\"\u00b6\u00bc\u00c8\u00d2\u00b7\u00c8\u00be \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00b1\u00bd\u00c6\u00de \u00b7\u00c8\u00be \u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00b9\u00c7\u00af\u00b6\u00c6 \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00bd\u00c8\u00be\u00c6 \u00a3\u00ce\u00ba\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf\u00b6\u00c7 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a5)4\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 \u00af\u00c9\u00c0\u00c7\u00b8 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00af\u00c7\u00be\u00c6\u00c1\u00c7\u00bb\u00c6 \u00ac\u00d7\u00af\u00c6\u00af\u00c8\u00b4\u00cc\u00ba\u00c7\u0081\u00bd\u00c7\u00af \u00cc\u00c1\u00bf\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00bd\u00c8\u00be\u00c6 \u00a3\u00ce\u00ba\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf\u00b6\u00c7\""
