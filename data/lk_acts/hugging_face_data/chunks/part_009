    "chunk_text": "2.\u00ef\u008a \u00c0\u00be\u00ba \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00cc\u00cd \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0\u00c4\u00ba\u00eb\u201c\u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u00be\u00e5\u00c9\u00c8\u00c0\u00e8\u0090\u00c6 \u00bc\u00e5\u00c7\u00e6\u00c8\u00e0 \u00a4\u00f5\u008a\u00a1\u00c8\u00e0\u00cd\u00e5\u00cb\u00e8\u0095\u00c6\u00e5 \u00a1\u00c7\u00e5\u0094 \u0097\u00bc\u00f1\u00e5\u00c8\u00ef\u00c6\u00e0 \u00bc\u00e6\u00be\u00b4 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00c9 \u00cc\u00e8\u0090\u00be \u00ba\u00e5\u00a8\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00cd\u00e5 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00b4\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c2\u00bf\u00c9\u00e5 \u00aa\u00be\u00ea \u00c8\u00c2\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb\u201c\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u201c\u00be\u00e5\u00c9\u00c8\u00c0\u00e8\u0090\u00c6 \u00bc\u00e5\u00c7\u00e6\u00c8\u00e0 \u00a4\u00f5\u008a\u00a1\u00c8\u00e0\u00cd\u00e5\u00cb\u00e8\u0095\u00c6\u00e5 \u00a1\u00c7\u00e5\u0094 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u201d \u00c6\u00be \u00be\u00e5\u00c4\u00c6 \u00cc\u00cd \u00a1\u00c3\u00fa\u00bd\u00e5\u00be\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00a1\u0097\u0083\u00d2\u00be\u00e0\u00be \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00e0 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6. \u00ba\u00c9 \u00bc \u00a6\u00a8\u00f9 \u00be\u00e5\u00c4\u00ef\u00c6\u00be\u00e0\u00a6\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc \u00a3\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00bc \u00cc\u00e8\u00c6\u00f5 \u00a1\u0093\u00a8\u00c7\u00b8\u00c9\u00c8 \u00be\u00b6\u00ea \u00c0\u00c9\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7, \u00ef\u00c0\u00e5\u00f3 \u00c4\u00ea\u00f7\u00e5\u00c9\u00a8\u00e0 \u00ba\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00bc \u00a6\u00c6 \u00c0\u00e5\u0097\u0083\u008e \u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00a1\u00c3\u00e8\u00c4\u00ba\u00c6 \u00c0\u00d6\u00bc\u00fa \u00a6\u00c6 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a \u00bc \u00c0\u00ec\u00da\u00b8 \u00c2\u00c8\u00c6 \u00cd\u00e5 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00b4 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6.\n\n(\u00a1) \u00a2\u00cc\u00e0\u00c8\u00e5\u0095\u00c6 \u201c\u00c0\u00e5\u00d6\u00c6\u00e5\u201d \u00be\u00f9\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00d5\u0097\u00ba\u00ef\u00c6\u00e0 \u00cc\u00e8\u00c6\u00f5 \u00a1\u00e2\u00ca\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00cc\u00c4\u00e5\u00b0\u00c6\u00b4 \u00c4\u00ad\u00ef\u00c0\u00be\u00e0\u00d1\u00c4\u00b4 \u00cc\u00c4\u00ba\u00e0 \u00a2\u00cc\u00e0\u00c8\u00e5\u00e4\u00c6\u00ef\u00bc\u00e0\u00c9\u00bd\u00da\u00c4\u00c9\u00e5\u00bc\u00fb\u00be\u00e0 \u0094\u00cd\u00fa \u00a8\u00f8\u00d7\u00c4 ;\n\n\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c\u00ef\u00c0\u00e5\u00f3\u00c0\u00c7\u00c4\u00e5\u00da\u00bb.\n\n2006 \u00a1\u00e2\u00a8 33 \u00bc\u00c7\u00be \u00be\u00e5\u00c9\u00c8\u00c0\u00e8\u0090\u00c6 \u00bc\u00e5\u00c7\u00e6\u00c8\u00e0 \u00a4\u00f5\u008a\u00a1\u00c8\u00e0\u00cd\u00e5\u00cb\u00e8\u0095\u00c6\u00e5 \u00a1\u00c7\u00e5\u0094 \u0097\u00bc\u00f1\u00e5\u00c8\u00c6 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a) \u00c0\u00be\u00ba2\n\n(\u00a1\u00e5) \u00ca\u00eb\u00bc\u00e0\u00bd \u00c9\u00ec \u00a8\u00eb\u00c7\u00e5\u00be\u00c6 \u00a8\u00b4\u00c0\u00e5\u00b6\u0095\u00be\u00e0 \u00bc\u00be\u00e0\u00be\u00e5 \u00cd\u00cb\u00e9\u0086\u00c9\u00c7\u00e6\u00be\u00e0 \u0094\u00cd\u00fa\u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a1\u00e6) \u00a2\u00cc\u00e0\u00c8\u00e5\u00e4\u00c6 \u00bd\u00da\u00c4\u00c6 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a1\u00e7) \u00a2\u00cc\u00e0\u00c8\u00e5\u00e4\u00c6 \u00cc\u00c4\u00e5\u00b0\u00c6 \u00ba\u00eb\u00ce \u00cc\u00c4\u00aa\u00fa\u00c6 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd\u00ef\u00c0\u00e5\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a2\u00cc\u00e0\u00c8\u00e5\u00e4\u00c6 \u00cc\u00c4\u00e5\u00b0\u00ef\u00c6\u00e0 \u00c0\u00f2\u00ca\u00e0\u00be\u00c9\u00c8\u00b4 \u00c0\u00e8\u00ce\u00e8\u00ba\u00eb\u00c7\u00e6\u00ef\u00cc\u00d1\u00c4 ;\n\n(\u00a2) \u00a2\u00cc\u00e0\u00c8\u00e5\u00e4\u00c6 \u00cc\u00c4\u00e5\u00b0\u00ef\u00c6\u00cd\u00fa \u201c\u00cc\u00ea\u00be\u00e0\u00be\u00ba\u00e0 \u00c9\u00c8\u00e0 \u00b0\u00c4\u00e5\u00ba\u00e0\u201d \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8\u00c6\u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a3) \u00cb\u00e5f\u00c0\u00e8 \u00be\u00f8\u00a8\u00e5\u00ef\u00c6\u00e0 \u201c\u00cb\u00e8\u00a8\u00e0 \u201d\u00be\u00f9\u00ba\u00f8 (\u00cc\u00e2\u00a8\u00c8\u00e0\u00c0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00aa\u00eb\u00c7\u00e6\u00a8\u00eb\u00c8\u00c6) \u00cc\u00cd\u201c\u00a1\u00c8\u00e0 \u00a1\u00cb\u00e0\u00a1\u00d6\u00c6\u00e5\u201d \u0097\u00ca\u00e0\u00c9\u00e5\u00cc\u00c6 \u00cc\u00cd \u00ca\u00eb\u00bc\u00e0\u00bd \u00c9\u00ec \u201c\u00ba\u0089\u00c8\u00e8\u00ba\u00e0\u201d \u00c4\u00ba \u00c0\u00bc\u00be\u008a\u00c9\u00ec \u00cc\u00ea\u00be\u00e0\u00be\u00ba\u00e0 \u00c9\u00c8\u00e0 \u00b0\u00c4\u00e5\u00ba\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd\u00ef\u00c0\u00e5\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 ;\n\n(\u00a4) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00c4\u00ba\u00c6 \u00a1\u00be\u00ea\u00c9 \u00a2\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u00c4\u00a8\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00cc\u00cd\u0097\u00bc\u00f1\u00e5\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6\u00b4 \u00a4\u00c0\u00a8\u00e5\u00d7 \u00c9\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00e8\u00c6\u00f5 \u00ef\u00bc\u00e0 \u00a2\u00b4\u00ea\u00a8\u00f8\u00d7\u00c4 ;\n\n4.(1) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6, \u00c0\u00e5\u00c8\u00be\u00c6 \u00cc\u00cd \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00c6 \u00ef\u008a\u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8, \u00a4\u00c0 \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8, \u00cc\u00c4\u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00e6 \u00ef\u00bc\u00ef\u00bc\u00be\u00a8\u00eb, \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00d6\u00a8, \u00cc\u00cd\u00a8\u00e5\u00c7 \u00ef\u00c8\u00e0\u00a8\u008a, \u00cc\u00cd\u00a8\u00e5\u00c7\u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00d6\u00a8 \u00cc\u00cd \u00a8\u00e5\u00c7\u00a8 \u00cc\u00c3\u00fa\u00a8\u00c6\u00be\u00e0 \u00cd\u00ba\u00c7 \u00ef\u00bc\u00be\u00a8\u00eb \u00a1\u00e6\u00ba\u00eb\u00f5\u00c9 \u00cc\u00c4\u00e5\u00b0\u00ef\u00c6\u00e0\u00be\u00e5\u00c6\u00a8\u00c6\u00be\u00e0 \u00cc\u00cd \u00ef\u00bc\u00e0\u00c9 \u00bd\u00da\u00c4 \u00ca\u00e5\u00cc\u00e0\u00ba\u00f2\u00b3\u00c6\u00be\u00e0 \u00c9\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00a1\u00ba\u00eb\u00d6\u00be\u00e0\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00d7\u00ba\u00f8\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00ef\u00ba\u00e5\u00e0\u00c7\u00e5 \u00c0\u00ba\u00e0\u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00a6\u00ef\u00a8\u00e5\u00ef\u00ce\u00e5\u00cc\u00e0 \u00ef\u00bc\u00be\u00a8\u00eb\u00ef\u00aa\u00be\u00e0 \u00cc\u00c4\u00be\u00e0\u0097\u00ba \u00c9\u00be \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0\u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00cc\u00c4 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00e6\u00be\u00e0 \u00ef\u00bc\u00ef\u00bc\u00be\u00e5\u00ef\u00aa\u00be\u00e0\u00a6\u00a8\u00e0 \u00a1\u00c6\u00a8\u00eb \u0097\u00bc\u00f1\u00e5\u00c8\u00ef\u00c6\u00e0 \u00aa\u00eb\u00c7\u00e6\u00c9\u00c7\u00c6\u00a8\u00eb \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00ef\u008a \u00c0\u00be\u00ba\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00d1\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3\u00c9\u00be \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9\u00c4 \u00c9\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00bd\u00ea\u00c7 \u00bc\u00c7\u00be\u0097\u00bc\u00f1\u00e5\u00c8\u00ef\u00c6\u00e0 \u00c0\u00e5\u00c8\u00a8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00c4 \u00c0\u00e5\u00c8\u00a8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6,\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00d7\u00ba\u00f8\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00c9 \u00be\u00c9 \u00c0\u00e5\u00c8\u00a8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0 \u00c0\u00ba\u00e0\u00a8\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00ba\u00eb\u00c7\u00e6\u00bd\u00ea\u00c7 \u00bc\u00e6\u00d6\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
