    "chunk_text": "(3) \u00a1\u00bc\u00e5\u00ce \u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u008a\u00c9\u00c8 \u00bc\u00fb \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba\u00e0 \u00a1\u00be\u00ea\u00c0\u00e5\u00ba\u00c6\u00be\u00e0\u00b4 \u00a1\u00be\u00ea\u00c9 \u00c9\u00ec \u00ef\u00c9\u00ef\u00ce\u00bf\u00c9 \u00b4\u00c4\u00a8\u00e0 \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00ef\u00cd\u00e5\u00e0 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00a8\u00eb\u00b4, \u00a1\u00e5\u00be\u00c6\u00be\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c2\u00bc\u00e5\u00cd\u00d6\u00be\u00e0\u00be\u00a8\u00eb\u00b4 \u00c8\u00c2\u00e5\u00bc\u00fb\u00c4 (2)\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a4\u00c8\u00e0\u00c8\u00e2\u00ab\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n38.(1) \u00ef\u00c9\u00ef\u00ce\u00bf \u00cc\u00c8\u00a8\u00eb\u00b8\u00ea, \u00a1\u00e5\u00ef\u008c\u00be\u00f8\u00a8 \u00c8\u00a8\u00eb\u00b8\u00ea, \u0097\u00ef\u00ca\u00e0\u00cb \u00c8\u00e5\u00e2\u00af\u00be\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00ef\u00c6\u00e0 \u00c9\u00da\u00aa\u00fb \u00be\u00e5\u00c4\u00c6\u00a8\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00e0\u00ef\u00be\u00e5\u00c9\u00be \u00c6\u008a \u00f7\u00c9\u00f1\u00c6\u00a8\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c2\u00bc\u00e5\u00cd\u00e6\u00d7\u00c4, \u0097\u00a8\u00f8\u00b8\u00e9\u00c4\u00ef\u00cd\u00e5\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00e0 \u00ef\u00cc\u00e0 \u00bc\u00da\u00ca\u00be\u00c6 \u00c9\u00be \u00f3\u008a\u00ef\u00a8\u00e5\u00ce\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00c6\u008a \u00f7\u00c9\u00f1\u00c6\u00a8\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00e5\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e5\u0095\u00ef\u00c8\u00e0 \u00ef\u00c2\u00bc\u00e5 \u00cd\u00e6\u00d7\u00c4\u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a4\u00c8\u00e0\u00c8\u00e2\u00ab\u00be\u00c6 \u00a8\u00c7\u00be \u00c6\u008a\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00be\u00c6\u00be\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0(2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a4\u00c8\u00e0\u00c8\u00e2\u00ab\u00be\u00c6 \u00a8\u00c7\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb\u00a2\u00bc\u00fa\u00d6\u00ef\u00c6\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00c8\u00ab\u00ea \u00be\u00b6\u00ea \u0097\u00c3\u00e5\u00aa\u00c6\u00a8\u00f8\u00be\u00e0 \u00c0\u00cc\u00ea \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u009f\u00ef\u008a \u00bc\u00fb \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00cc\u00e0 \u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3\u00ef\u00bc\u00a8\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0\u00a6\u00e0 \u00bc\u00b6\u00c6 \u00cc\u00cd \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7 \u00aa\u00ba\u00a8\u00f8\u00d7\u00c4 \u00c6\u00be \u00bc\u00b9\u00ea\u00c9\u008a \u00ef\u00bc\u00a8\u00b4\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u00b4\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00ef\u00cd\u00e5\u00e0 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c9\u00c8\u00ef\u00c9\u00ef\u00ce\u00bf \u00c8\u00a8\u00eb\u00b8\u00ea\u00c9\u00c8\u00b4\u00a1\u00bc\u00e5\u00ce \u00c9\u00e6\u00c7\u00bc\u00fa.\n\n2006 \u00a1\u00e2\u00a8 27 \u00bc\u00c7\u00be \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00cd\u00e5 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba22\n\n39.\u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00ea \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00c0\u00e5\u00f3 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a8\u00f8\u00cc\u00e8\u00c4\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c6\u008a \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00c0\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a6\u00ef\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a2\u00b6\u00bc\u00fb\u00c4 \u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00ea \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00c0\u00e5\u00f3 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8, \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb,\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb, \u00cd\u00fa\u0095\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb, \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb, \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4\u00cc\u00e0\u00bb\u00e5\u00be\u00c6 \u00c3\u00e5\u00c7\u00c9 \u00cc\u00e8\u0090\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00ea \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00c3\u00e5\u0097\u00ba\u00e5 \u00a8\u00c7\u0095\u00be\u00e0 \u00f3\u008a \u00c0\u00e5\u00be\u00c6\u00ef\u00be\u00e5\u00a8\u00c7\u00be \u00c2\u00c9\u00b4 \u00cc\u00cd\u00ba\u00f8\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6:\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00c9\u00ea\u00c9 \u00bc-\n\n(\u00a1)\u00a8\u00e5\u00c4\u00c7 \u00ba\u00f8\u00cd\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00c9\u00e6\u0091 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0\u00b4\u00c8\u00c6\u00a8,\u00a1\u00e5\u00aa\u00be\u00e0\u00ba\u00eb\u00a8 \u00be\u00f8\u00c9\u00e5\u00cc\u00c6\u00a8, \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e5\u00c9\u00a8\u00e5\u00c8\u00e8\u00a8 \u00be\u00c9\u00e5\u00ba\u00e6\u00be\u00e0 \u00ef\u00c0\u00e5\u00ce\u00a8(\u00ef\u00c8\u00e5\u00d9);\n\n(\u00a1\u00e5)\u00a1\u00c9\u00c4 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00be\u00e0 \u00ba\u00f8\u00cd\u00a8\u00b4 \u00c9\u00e5\u0091\u00d1 \u00cc\u00e8\u009b\u00c4\u00b4 \u00a2\u00b6\u00a8\u00b6\u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00a1\u00e5\u00c0\u00be\u00ca\u00e5\u00c8\u00e5\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c4\u00e5\u00b0\u00ca\u00e5\u00c8\u00e5\u00c9\u00a8; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e6)\u00c6\u008a \u00aa\u00eb\u00c9\u00be\u00e0 \u00ef\u00ba\u00e5\u00b4\u00ea\u00c0\u00ce\u00a8,"
