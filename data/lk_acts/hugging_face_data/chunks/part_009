    "chunk_text": "(4) (117 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00be) \u00ef\u00c8\u00e0\u00a9\u00be \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e017 \u00c9\u00be \u00cd\u00e5 20 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u0097\u0093\u0097\u00bd\u00e5\u00be_\n\n(\u00a1)\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00ce \u00a8\u00e5\u00da\u00c6\u00e5\u00c8\u00c6 \u00c0\u00e8\u00cd\u00fa\u0090\u00ef\u00c6\u00e0 \u00a8\u00c9\u00c7\u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00c6\u00a8\u00e0 \u00ba\u00eb\u00ce \u00bc \u00a6\u00e0 \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00c6 \u00ba\u00eb\u00ce \u00a6\u00e0 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 IV\u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 VI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc \u00c6\u00b4\u00ef\u00ba\u00e0 ,\n\n(5) \u00cc\u00e6\u00a8 \u00f3\u00c7\u00e6\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 (89 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00a4\u00a8\u00cc\u00e0 \u00c0\u00be\u00ef\u00ba\u00e0 63\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00ae\u00c8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00a8\u00c7\u00be \u00c6\u008a\u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n429.(1) \u00ef\u00c4\u00cd\u00fa \u00a6\u00ef\u00a8\u00e5\u00ef\u00ce\u00e5\u00cc\u00e0\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0\u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0, \u00ae\u00c8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00c7\u00be \u00cc\u00e7\u00c4 \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8\u00c4, \u00a6\u00c9\u00e6\u00be\u00f8\u00c6\u008a \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8 \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c9\u00f1\u00e2\u00aa\u00fa\u00a8 \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba\u00c9\u00c4\u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00c7\u00be \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00c9\u00e5\u00b4 \u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8 \u00c9\u00be \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00b4 \u00cd\u00e6\u00c7,\u00c9\u00f1\u00e2\u00aa\u00fa\u00a8 \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00ae\u00c8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00a1\u00e6\u00ba\u00f8 \u00a8\u00c7\u00be \u00cc\u00e5\u00bd\u00be\u00c0\u00ba\u00f2\u00c6.\n\n\u00ae\u00c8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00a1\u00e6\u00ba\u00f8 \u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00e5\u00bd\u00be\u00c0\u00ba\u00f2\u00ef\u00c6\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be.\n\n3422007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n(2) \u00ae\u00c8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00c7\u00be \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8_\n\n(\u00a1)\u00ae\u00c8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00b4 \u00c9\u00b6\u00e5 \u00c9\u00e6\u0091 \u00c0\u00f2\u00c4\u00ea\u00a9\u00ba\u00e0\u00c9\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0\u00cc\u00c4\u00e5\u00be \u00ef\u00ca\u00f2\u00e0\u00b8\u00e8\u00ef\u00c6\u00e0 \u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ae\u00c8 \u00cc\u00ee\u00b8\u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00cc\u00e0\u00bb\u00e5\u00c9\u00c7 \u00a1\u00e6\u00c0\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00e8\u00d7\u00c4 \u00ba\u00cd\u00be\u008a\u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e9\u00c4\u00e5 \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00c4\u00ba \u00c9\u00ec \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c0\u00c9\u00ba\u00e0\u00be\u00e5\u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a1\u00be\u00e5\u00aa\u00ba \u00ae\u00c8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e0\u00bb\u00e5\u00c9\u00c7 \u00a1\u00e6\u00c0\u00cc\u00c4\u00aa \u00ae\u00c8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7 \u00c9\u00da\u00aa \u00ef\u00a8\u00ef\u00c7\u00be\u00ea\u00ef\u00c6\u00e0 \u00a8\u00c9\u00c7 \u00a1\u00be\u00ea\u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00a8\u00b4\u00bc \u00a6\u00e0 \u00a1\u00be\u00ea\u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8 \u0097\u0093\u00c4\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u0097\u0093\u0097\u00bd\u00e5\u00be,\n\n\u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n430.(1) \u00ae\u00c8 \u00a5\u00b8 \u00c3\u00e5\u00c7\u00c6 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00be\u00f8\u00c6\u00c4\u00c9\u00c8\u00b4\u00c6\u00b4\u00ba\u00e0\u00c9, \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ae\u00c8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00f8\u00d7\u00c4\u00c4\u00aa\u00fa\u00be\u00e0 \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00cc\u00e5\u00c4\u00e5\u00be\u00f1 \u00c9\u00f1\u00e5\u00c0\u00e5\u00d6\u00a8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00c8\u00e8\u00c6 \u00ba\u00eb\u00ce \u00bc\u00fb \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00a8\u00f8\u00d7\u00c4\u00b4 \u00cc\u00c4\u00e5\u00aa\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00cd\u00e6\u00a8\u00f8\u00c6\u00e5\u00c9\u00b4 \u00c2\u00c8\u00c0\u00e7\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) (\u00a1)\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00b4 \u00a1\u00be\u00ea\u00c6\u00e5\u00ba \u00ef\u00a8\u00e5\u00b4 \u00ef\u00be\u00e5\u00ba\u00f8\u00c2\u00ea\u00b8\u00ea\u00ae\u00c8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00b4 \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00c6\u00b4\u00ba\u00e0\u00c9 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 ;\u00cc\u00cd\n\n(\u00a1\u00e5)\u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u0097\u00a8\u00eb\u00b8\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8,\n\n\u00cc\u00c4\u00e5\u00aa\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00c8\u00c2\u00e5\u00aa\u00be\u00e0\u00be\u00e5 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ae\u00c8 \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00ef\u00c6\u00e0\u00c8\u00e5\u00c3 \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00b4 \u00cd\u00fa\u0095\u00a8\u008a \u00a1\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00c9\u00ba, (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00ef\u00cd\u00e5\u00e0 (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00c7\u00e6\u00b8\u00ea\u00c9\u00c8 \u00bc\u00fb \u00ef\u00bc\u00e0\u00c0\u00ef\u00ce\u00e0\u00a1\u00aa\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00aa\u00fa\u00b8\u00ea\u008a \u00bc\u00fb\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00c2\u00e5\u00aa\u00be\u00e0\u00be\u00e5\u00c8\u00bc \u00ef\u00bc\u00e0\u00c0\u00ef\u00ce\u00e0 \u00a1\u00aa\u00c6 \u00cc\u00bf\u00cd\u00e5_\n\n(\u00a1)\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00cc\u00e5\u00c4\u00e5\u00be\u00f1 \u00c9\u00f1\u00e5\u00c0\u00e5\u00d6\u00a8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00c8\u00e8\u00c6 \u00ba\u00eb\u00ce \u00bc\u00fb \u00ef\u00bc\u00e0\u00c0\u00ce\u0097\u00a8\u00f8\u00b8\u00e9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00e8\u00f3 \u00ef\u00be\u00e5\u00c9\u00ea\u00ef\u00c6\u00e0 \u00be\u008a ; \u00cc\u00cd"
