    "chunk_text": "(\u00a8)\u00da\u00b8\u00c8\u00b6 \u00b2\u00bb \u00b1\u00c8\u00bd\u00c9 \u00ba\u00af\u00c7\u00cd\u00b9\u00c7\u00b6\u00c8 \u00a7\u00b4\u00c6\u00b9\u00b4 \u00a3\u00b4\u00c6\u00b4\u00ba\u00b6\u00c6\u00b6\u00c7\u00b8\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00d9\u00bc\u00c7\u00b6\u00da\u00bc \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00ce\u00ba\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf \u00a3\u00b4\u00c6\u00b4\u00ba\u00b6\u00c6\u00b6\u00c7\u00b8+\u00c6\u00af\u00cd\u00bf\u00c7\u00d5 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b9\u00b4\u00c6\u00b4 \u00aa\u00ce\u00b8\u00bb \u00c1\u00c0\u00c8\u00b9\u00c7\u00b4\u00c6\u00d5\u00a5\u00b4+\u00c6\u00af\u00bf\u00c8\u0081 \u00b7\u00be\u00d9\u00af\u00c6\u00af\u00c7\u00af \u00a7\u00b6\u00e2\u00b6\u00df\u00ba\u00c6 \u00da\u00b6\u00c6\u00b6\u00b1\u00c7\u00b1\u00b8\u00b7\u00c8\u00ce\u00be\u00cd\u00b9\u00bd\u00c6\u00bd\u00c8\u00ce\u00b8\u00b9\u00c6 \u00b9\u00bc\u00b9\u00c6\u00b9 \u00b1\u00af\u00be \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00a9\u00d5\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 ;\n\n(\u00aa)\u00cc\u00b9\u00bf\u00b6\u00c6\u00b6 \u00ba\u00b6\u00b6\u00c6 \u00b6\u00b6\u00c6\u00d7\u00c1+\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a3\u00b6\u00b8\u00c7\u00be\u00c6 \u0089\u00bc\u00b1\u00c7\u00bc\u00ba\u00c6\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b7\u00be\u00c6\u00cc\u00be\u00c7\u00e1\u00af\u00c6\u00af \u00c1\u00c7\u00c0\u00c6\u00e2\u00db\u00ce\u00bd\u00ce\u00bb\u00dc\u00ba\u00c6\u00b9\u00c7\u00d7\u00af\u00c7\u00b6\u00c6\u00b6\u00df\u00ba\u00c6 \u0089\u00bc\u00b1\u00c7\u00bc\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00b6\u00df\u00ba\u00c6 ;\n\n(\u00ab)\u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00df\u00ba\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0 \u00cc\u00c1\u00bf\u00c8\u008a\u00df\u00ba\u00c6 \u00a7\u00bf\u00c6\u00bf\u00aa\u00ce\u00b8\u00bb \u00cc\u00b9\u00bf\u00b6\u00c6\u00b6 \u00ac\u00e1+\u00c6\u00af\u00ce\u00ba\u00b9\u00c6\u00da\u00af\u00e0\u00b4\u0081 \u00b1\u00c8\u00cd\u00b7\u00af\u00b9[\u00bc\u00c6\u00c1\u00a7\u00bd\u00e2\u00af\u00ce\u00bf\u00b9\u00c6 \u00cd\u00b9\u00d6\u00b6\u00df\u00ba\u00c6 \u00a8\u00af\u00c6\u00d0\u008c\u00b6\u00c6\u00b6\u00df\u00ba\u00c6\u00b0\n\n4\u00b0 (1) \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00bf\u00c6 \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081\u0089\u00bc\u00b6\u00ba \u00cd\u00b9\u00c7\u00c2\u00af\u00bc\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00af\u00cd\u00c1\u00ae\u0088\u00bb\u00c1\u00bc\u00c7\u00b8 \u00c1\u00b5\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00bc\u00c8\u00bb\u00a3\u00b4\u00c6\u00b4\u00ba\u0083\u00b6\u00c7\u00b8\u00c7\u00b6\u00c8\u00b9\u00b6\u00c8 \u00cd\u00b6\u00bc\u00bc\u00c8\u0081 \u00ba\u00b6\u00c8\u00dc\u00ce\u00bc\u008a\u0081\u00ba\u00c9\u00d7\u00ba\u00c6 \u008c\u00b6\u00b9\u00c6\u00da\u00ce\u00bc\u008a\u0081\u00ba\u00c9\u00d7\u00ba\u00c6 \u00ba\u00c7\u00ae\u00da\u00ba\u00c8\u00af\u00c6\u00af \u0089\u00bc\u00b6\u00ba\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(2) \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00a9\u00ae\u00b5\u00c8\u00af\u00c6\u00ce\u00af\u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00b9\u00b6\u008c \u00c1\u00c0\u00c8 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00bf\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b4 \u00b9\u00b6\u00c6\u00d7 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00ba\u00df\u00ba\u00c6 \u00a5\u00dd\u00b9\u00d7 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\u00af\u00ce\u00bf \u008c\u00b3\u00c6\u00b1\u00c7\u00ba\u00df\u00ba\u00c8\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\n\n(i) \u00cc\u00b6\u00c7\u00be\u00c6\u00cc\u00b9\u00c7\u00dd\u00bf\u00c8\u00bb\u00be\u00c6 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 ;\n\n(ii) \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb \u00af\u00be\u00c7\u00b1\u00c7\u00bc \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u0081 \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6\u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 ;\n\n(iii) \u00cc\u00b9\u00bf\u00b6\u00c6\u00b6 \u00ba\u00b6 \u00a3\u00df\u00c1\u00be\u00c6\u00af\u00bf\u00c6 \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6\u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8 ;\n\n(iv) \u00a3\u00d9\u00bc\u00c7\u00b6\u00da\u00bc \u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c7\u00bf\u00bc\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(v) \u00cd\u00b6\u00b1\u00c8\u00bb \u00cc\u00b9\u00bf\u00b6\u00c9\u00af\u00b6\u00c6 \u00b6\u00c8\u00b4\u00c6\u00b4\u00ba\u00c8\u00b4\u00be\u00c6 \u00b6\u00c8\u00ce\u00b5\u00af\u00c6\u00af\u00bf\u00b6\u00c6\u00b6\u00c8\u0081\u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u00b0\n\n\u00a7\u00de\u00b9\u00c6\u00b9\u00c7\u00ae\u00ce\u00ba\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 41 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00a3\u00d9\u00bc\u00c7\u00b6\u00da\u00bc \u00b2\u00bb \u00b1\u00c8\u00bd\u00c9\u00ba\u00af\u00c7\u00cd\u00b9\u00c7\u00b6\u00c8 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00b7\u00c8\u00b6\u00c8\u00bb\u00ba\u00c6 (\u00e7\u00b4\u00c6\u0088\u00ce\u00b5\u00b6\u00c6\u00b6\u00be\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c64\n\n(3) \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00dd\u00ba\u00c6\u00a5\u00bd\u00b9\u00c6\u0089\u00b8\u00c7\u00be\u00c6\" \u00b9\u00b6\u008c\u00d7\u00bd\u00b6\u00c6\u00b6\u008b\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00b6\u008c\u008a\u008b\u00dd\u00b7\u00c6\u00d7\u00a3\u00af\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00c1\u00bc\u00c6 \u00b9\u00b6\u008c\u00ce\u00bb \u00db\u0081\u00b8\u00cd\u00bc \u00c1\u00bd\u00c8\u00b6\u00c7\u00af\u00c6\u00af\u00c8\u00b8\u00c7\u00cc\u00be\u00c7\u00c0\u00c8\u00bb \u00a3\u00c1\u00bc\u00d7 \u00b7\u00c8\u00bb\u00ba\u00b8\u00b6\u00c6 \u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00ab\u00b7\u00c6\u00b6\u00c7\u00ae\u00d5\u00af\u00ce\u00bf\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u00b4\u00cc\u00c1\u00c7\u00dd \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u008c\u00b6\u00c7+\u00c6\u00d0\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\n\n(4) \u00e7\u00b4\u00c6\u00d5\u00b6\u00c6\u00b6\u00c7\u00b9\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00dd\u00ba\u00c6 \u00a3\u00b6\u0081\u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6 \u0089\u00bc\u00b6\u00ba \u00ba\u00b7\u00c6\u00b6\u00c8\u00bc\u00c8\u00af\u00c6\u00d0 \u00db\u00af\u00c1\u00bc\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5 \u00a3\u00d9\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00af\u0088\u00b6\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u0081\u00f2\u00be\u00ba\u00c6 \u00a3\u00c1\u00bc\u00d7 \u00b9\u00b6\u008c\u00ce\u00bb\u00b6\u00c6 \u00d7\u00bd\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00b6\u008c\u00d7\u00bd\u00b6\u00c6\u00b6\u00be\u00c7\u00b8\u00d7 \u00a3\u00d7 \u0089\u00bc\u00b6\u00ba \u00ba\u00b7\u00c6\u00b6\u00c8\u00bc\u00c8\u00bb\u00c7\u00be\u00c6 \u00aa\u00bd\u00c6\u00