    "chunk_text": "\u00a1\u00ba\u00e0\u00a8\u00c7\u00ef\u00aa\u00be \u00ba\u00f8\u00ef\u00c2\u00be \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00cd\u00fa\u0095\u00a8\u00c4 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa\u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00b4 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00c6 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00ef\u00cd\u00e5\u00e0\u00c2\u00c8\u00c0\u00e7\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00c6\u008a \u00cc\u00ee\u00b8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 371 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0 \u00a2\u00c9\u00ba\u00c8\u00e9\u00ef\u00c4\u00be\u00e0, \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u2014\n\n(\u00a1\u00e5)\u00a1\u00aa\u00be\u00e5 \u00c0\u00f2\u00ba\u00f8\u00cb\u00e0\u00b5\u00e5\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 ; \u00cc\u00cd\n\n(\u00a1\u00e6)\u00cc\u00bc\u00e0\u00c3\u00e5\u00c9\u00ef\u00c6\u00be\u00e0,\n\n\u00a1\u00ba\u00e0\u00a8\u00c7\u00ef\u00aa\u00be \u00ba\u00f8\u00ef\u00c2\u00be \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00cd\u00fa\u0095\u00a8\u00c4 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa\u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00b4 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00c6 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00ef\u00cd\u00e5\u00e0\u00c2\u00c8\u00c0\u00e7\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea \u00cd\u00e5 \u00cc\u00ee\u00b8\u00c3\u00e5\u00c7 \u00a2\u00c9\u00ba\u00c8\u00e9\u00c4\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00a1\u00ba\u00f8\u00ef\u00da\u00a8\u0097\u0093\u0097\u00bd\u00e5\u00be.\n\n2932007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n(3) 371 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00be\u00f9\u00ba\u00f8 \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0\u00cc\u00e5\u00bd\u00e5\u00c7\u00b8\u00ba\u00e0\u00c9\u00c6 \u00a1\u00be\u00ea\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c9, \u00a1\u00e7\u00c9\u00c7\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00ef\u00cd\u00e5\u00e0\u00ef\u00bc\u00e0\u00c0\u00ce\u00b4 \u00cc\u00c4\u00e5\u00be \u00c9\u0090\u00be\u00e5\u00a8\u00c4 \u00a1\u00e5\u00c0\u00cc\u00ea \u00aa\u00e6\u00be\u00f9\u00c4\u2014\n\n(\u00a1)\u00a6\u00ef\u00cc\u00e0 \u00a1\u00e5\u00c0\u00cc\u00ea \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00be\u00e0\u00bc \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00cc\u00bc\u00e0\u00c3\u00e5\u00c9\u00ef\u00c6\u00be\u00e0 \u00c8\u00c2\u00e5\u00ef\u00aa\u00be\u00a1\u00e6\u00ba\u00e0\u00be\u008a \u00cc\u00cd \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00c9\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00c0\u00e6\u00c9\u00d7\u00c4\u00c2\u00c8\u00cc\u00cd\u00fa\u00ba\u00c9 \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00bc\u00a8\u00e0 \u00c6 \u00c6\u00be \u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u0097\u00ca\u00e0\u00c9\u00e5\u00cc\u00c6 \u00c4\u00ba \u00a6\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00ba\u00ba\u00e0\u00c9\u00c6 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00a1\u00e6\u00ba\u00e0\u00be\u008a ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00a1\u00e5\u00c0\u00cc\u00ea \u00c8\u00c2\u00e5\u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00c0\u00cc\u00ea \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4,\u00a1\u0093\u00a8\u00c7\u00b8\u00ef\u00c6\u00e0 \u00c4\u00ba\u00c6 \u00a1\u00be\u00ea\u00c9 \u00cc\u00e5\u00bd\u00e5\u00c7\u00b8\u00e9\u00c6 \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a,\n\n\u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00ef\u00c6\u00be\u00e0 \u00c4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n373.(1) 367 \u00c9\u00be \u00cc\u00cd 369 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9\u201c\u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u201d \u00c6\u00be\u00e0\u00be\u00b4\u2014\n\n(\u00a1) \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce \u00cc\u00c4\u00da\u00c0\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e6\u00c9\u00d7\u00c4\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 ;\n\n(\u00a1\u00e5)\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00bc\u00e0\u00c0\u00ce \u00c4\u00ba \u00a1\u00e6\u00c0\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00bf\u00fb\u00c4\u00a8\u00e0 \u00bc\u00fb\u00c4 ;\n\n(\u00a1\u00e6)\u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00c2\u00e6\u00bf\u00e9\u00c4\u00a8\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00d1\u00c4 ;\n\n(\u00a1\u00e7)\u00a1\u0093\u00a8\u00c7\u00b8\u00c4\u00c6 \u00be\u00b6\u00ea \u00a8\u00b4\u00c6\u00ea\u00ba\u00e0\u00ba\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ef\u008c \u00ef\u00c6\u00bc\u00d1\u00ef\u008a\u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 ;\n\n(\u00a2)\u00a1\u0093\u00a8\u00c7\u00b8 \u00ba\u00f9\u00be\u00e0\u00f3\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00aa\u00d1\u00c4\u00a1\u00e6\u00ba\u00eb\u00dd\u00c9, \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00aa\u00d1\u00c4,\n\n\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c.\n\n(2) 367, 368 \u00cd\u00e5 369 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u201c\u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0\u2014\n\n(\u00a1)\u00cc\u008a\u00c2\u00be\u00e0\u0093\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00cc\u00c4\u00aa \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00be \u00c8\u00bc \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u0093\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00c2\u00e6\u00bf\u00fb\u00c4\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4\u2014\n\n\u00c9\u00c7\u00b8 \u00c6\u00be\u00e5\u00bc\u00fa\u00c6\u00b4\u00a1\u00bc\u00e5\u00ce \u00a1\u00da\u00bb\u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n2942007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba\n\n(i)\u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00e6\u00e4\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3\u00d1\u00c4\u00b4 \u00c0\u00ec\u00da\u00c9 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3\u00ef\u00bc\u00a8\u00a8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 ; \u00cc\u00cd\n\n(ii)\u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00aa\u00b8\u00be\u00e0 \u00ef\u0089\u00c7\u00e5 \u00c9\u00cc\u00e5 \u00bc\u00c4\u00be\u00ea \u00c8\u00c2\u00be\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4, \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00ef\u00c9\u00ba\u00ef\u00c0\u00ba\u00e0\u00cc\u00c4 \u00ef\u00aa\u00e5\u00be\u00ea \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c0\u00ec\u00da\u00c9 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ef\u00bc\u00a8\u00a8\u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00cc\u00cd \u00a3\u00b4 \u00a6\u00a8\u00ba\u00eb\u00c9, \u00a6\u00c4 \u00ef\u00c0\u00ba\u00e0\u00cc\u00c4 \u00ef\u00aa\u00e5\u00be\u00ea \u00a8\u00ce\u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3\u00c9,\n\n\u00a1\u0093\u00a8\u00c7\u00b8 \u00a1\u00e5\u00b3\u00e5\u00c9 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00be \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00bc\u00cd\u00cc\u00e0\u00ef\u008c."
