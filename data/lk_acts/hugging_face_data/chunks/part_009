    "chunk_text": "\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6\n\n187. (1) \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00a8\u00e5\u00da\u00c6 \u00a2\u00b4\u00ea \u00a8\u00c7\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00cc\u00bc\u00e0\u00c3\u00e5\u00c9\u00ef\u00c6\u00be\u00e0 \u00bc, \u00cc\u00cd (2) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9, \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00a4\u00ef\u00bc\u00cc\u00e5 \u00c6\u00c6\u00fa \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u0097\u00ca\u00e0\u00c9\u00e5\u00cc \u00a8\u00c7\u00be \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00b4 \u00bc, \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c2\u00c8\u00ba\u00c8 \u00c0\u00c9\u00c7\u00e5 \u00bc\u00fb\u00c4.\n\n\u00cc\u00bc\u00e0\u00c3\u00e5\u00c9\u00ef\u00c6\u00be\u00e0 \u00cc\u00cd\u00cc\u00c4\u00e5\u00aa\u00ef\u008a\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00a4\u00ef\u00bc\u00cc\u00e5\u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00c6\u00ea\u00ba\u00eb\u00a8\u008a \u00c2\u00c9.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba161\n\n188.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00c6\u008a \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a\u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00ef\u00c6\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c6\u008a \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00a4\u00c8\u00e0\u00c8\u00e2\u00ab\u00be\u00c6 \u00c9\u00be\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00a8\u00f2\u00e8\u00c6\u00e5 \u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6 ;\u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00ef\u00cc\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00ef\u00c4\u00cd\u00fa \u00c8\u00e5 \u00a6\u00a8\u00ad \u00ef\u00be\u00e5\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n189.\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00a2\u00b4\u00ea \u00a8\u00c7\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u2014\n\n(\u00a1)\u00a1\u00be\u00c9\u00bd\u00e5\u00be\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00c7\u00c0\u00ba\u00c8 \u00ef\u00c8\u00cc \u00ef\u00be\u00e5\u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e8\u00c4\u00ba\u00e0 \u00a1\u00be\u00e0\u00bc\u0095\u00be\u00e0\u00a8\u00f2\u00e8\u00c6\u00e5 \u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6 ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00bc\u00e6\u00be\u00ea\u00c4 \u00cd\u00e5 \u00c0\u00ce\u00c0\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc \u00a1\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00be\u00e0\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00cc\u00cd\u00aa\u00ba \u00ef\u00c8\u00cc \u00c2\u00c8\u00e5\u00ef\u00c0\u00e5\u00ef\u00c7\u00e5\u00ba\u00e0\u00ba\u00eb \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00be\u00f8\u00c0\u00ea\u00be\u00ba\u00e5\u00ef\u008c\u00cd\u00e5 \u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e8\u00c4\u00ba\u00e0 \u00c3\u00e5\u00c9\u00ef\u00c6\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u0097\u00bc\u00cd\u00e5 \u00bc\u00e6\u00a8\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n190.(1) (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00a1\u00ba\u00eb\u00ef\u00c7\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb, \u00a6\u00be\u008a :\u2014\n\n(\u00a1)\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb ;\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6\u00c4\u00c6 \u00ef\u00cd\u00e5\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb\u00b3 \u00be\u00f8\u00c0\u00ea\u00be\u00ba\u00e0\u00c9\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00a8\u00e0\u00ef\u00cb\u00e0\u00ba\u00f2\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c0\u00c9\u00ba\u00e0\u00be\u00e5 \u00c2\u00c9\u00b4 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u0097\u00ca\u00e0\u00c9\u00e5\u00cc\u00a8\u00c7\u00be \u00a8\u00e5\u00c7\u00b8\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9, \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6\u00c4\u00c6 \u00a4\u00c0\u00ef\u00bc\u00e0\u00ca\u00a8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0\u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00a8\u00eb ;\n\n(\u00a1\u00e6)\u00c6\u008a \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00a8\u0095\u00b4\u00ea\u00c9\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00a8\u0095\u00b4\u00ea\u00ef\u008c \u00be\u00f8\u00da\u00bc\u00fa\u00cb\u00e0\u00b4 \u00c2\u00c8\u00c6\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c9\u00ec \u00a8\u00e5\u00c7\u00b8\u00e5\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00ef\u00cc\u00e0\u00c9\u00c6 \u00ef\u00be\u00e5\u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 \u00bc,\u00a6\u00c9\u00e6\u00be\u00f8 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00a8\u0095\u00b4\u00ea\u00c9\u00a8\u00e0,\n\n\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00a8\u00cc\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c0\u00c6\u00be \u00c8\u00bc \u00c9\u00e5\u00da\u00ba\u00e5, \u00c0\u00f2\u00a8\u00e5\u00ca \u00cc\u00cd \u00c4\u00ea\u00c8\u00f1\u00c4\u00c6\u00bc\u00ba\u00e0\u00ba \u00cd\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00c4\u00ba \u00cc\u00cd \u00ef\u00bc\u00be \u00c8\u00bc \u00c9\u00ee\u00ba\u00e0\u00ba\u00f9\u00c6\u00c4\u00c6 \u00ef\u00cd\u00e5\u00e0\u0097\u00ef\u00ca\u00e0\u00cb\u00b3 \u00a4\u00c0\u00ef\u00bc\u00cc\u00e0 \u00c4\u00ba \u0097\u00ca\u00e0\u00c9\u00e5\u00cc\u00c6 \u00ba\u00c2\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(2) \u00c6\u008a \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00ef\u00c6\u00a8\u00e0\u2014\n\n(\u00a1)\u00cc\u00bc\u00e0\u00c3\u00e5\u00c9\u00ef\u00c6\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a ;\n\n(\u00a1\u00e5)\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00c7\u00e6\u00b8\u00ea \u00a1\u00be\u00ea\u00c9, \u00c0\u00d6\u00a8\u00e0\u00cb\u00b8\u00c6\u00a8 \u00a1\u00c9\u00ca\u00f1\u00ba\u00e5\u00c9\u00ef\u00c0\u00be\u00e0\u00be\u00ea\u008a \u00a8\u00c7\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00be\u00f8\u00cc\u00e8 \u00c0\u00d6\u00bc\u00fa \u00c9\u00ec \u00c0\u00d6\u00a8\u00e0\u00cb\u00b8\u00c6\u00a8\u00e0\u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a ; \u00cc\u00cd\n\n\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00be\u00ba \u00cc\u00cd\u00cc\u00c4\u00e5\u00aa\u00ef\u008a\u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00c6 \u00a1\u00be\u00ea\u00c9\u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0\u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e8\u00c4\u00ba\u00e0 \u00d1\u00ef\u008a\u00c0\u00f2\u0095\u00ba\u00f8\u00c6.\n\n\u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00cd\u00e5\u00a4\u00c0\u00ef\u00bc\u00cc\u00e0\u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00b4\u00aa\u00e6\u00be\u00f9\u00c4.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba162\n\n(\u00a1\u00e6)\u00a6\u00c9\u00e6\u00be\u00f8 \u0097\u00ca\u00e0\u00c9\u00e5\u00cc\u00c6\u00a8\u00e0 \u00ba\u00e6\u009f\u00c4 \u00a1\u00c9\u00ca\u00f1 \u00ef\u00be\u00e5\u00c9\u00be \u00c2\u00c9 \u00bc\u00e6\u00be\u00ef\u00be\u00e5\u00cc\u00e8\u0090\u00ef\u00c6\u00e0 \u00be\u008a,\n\n\u00cd\u00e5 \u00a6\u00ef\u00cc\u00e0 \u00be\u008a \u00c0\u00c4\u00b8\u00a8\u00e0, (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a6\u00e0\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u00b4 \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
