    "chunk_text": "(7) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e6\u00c2\u00ea\u00b8\u00ea \u00c0\u00f2\u00ba\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba \u00c0\u00ba\u00f2\u00c0\u00e5\u0097\u0083\u008e \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb \u00bc \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a1\u00b6\u00e5\u00ce\u00c9 \u00a8\u00c8\u00e0\u00ba\u00c2\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb \u00bc, \u00a6\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4 \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00c0\u00e8\u00d6\u00ef\u00cc\u00c6\u00fa\u00be\u00e0\u00c0\u00e6\u00c6 \u00ba\u00eb\u00be\u00a8\u00b4 \u00a8\u00c8\u00e8\u00be\u00e0, \u00a6\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba \u00c0\u00ba\u00f2 \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00e8\u00d7\u00c4\u00b4, \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00cc\u00e7\u00c4\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb\u00b4 \u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4 \u00c4 \u00cd\u00fa\u0095\u00a8\u00c4 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n140. (1) (\u00a1) \u00c4\u00cd\u00e5 \u00cc\u00c3\u00e5 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb \u00db\u00cc\u00e0\u00d1\u00ef\u00c4\u00cd\u00fa \u00cc\u00c3\u00e5\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5\u00ef\u00ba\u00e5\u00e0\u00c7\u00e5 \u00c0\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4 \u00a1\u00b6\u00e5\u00ce\u00c9\u00a8\u00c8\u00e0\u00ba\u00e6\u009f\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00cd\u00e6\u00c7, \u00c6\u008a \u00c0\u00f2\u00ca\u00e0\u00be\u00c6\u00a8\u00e0\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00af\u00be\u00e0\u00bc \u0097\u00c4\u00cc\u00e9\u00c4\u00a8\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u009b\u00c4\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6\u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00ef\u008a ; \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\n\n(ii) \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb \u00af\u00be\u00e0\u00bc\u00c6 \u00bc\u00fb\u00c4\u00b4 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u00cc\u00e8\u00c6\u00f5\u00ef\u00bc\u00be\u00e5\u00ef\u00aa\u00e0 \u00c4 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00af\u00be\u00e0\u00bc\n\n\u00af\u00be\u00e0\u00bc \u0097\u00c4\u00cc\u00e9\u00c4\u00a8\u00e0\u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u009b\u00c4\u00b4\u00a1\u00c6\u00fa\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba117\n\n\u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a\u00c9\u00c8\u00e8\u00be\u00e0 \u00bc\u00cd\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea\u00cc\u00e2\u00a9\u00f1\u00e5\u00c9\u00a8\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00cd\u00fa\u0095\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0 \u00cc\u00e2\u00a9\u00f1\u00e5\u00c9\u00a8\u00e0\u0097\u00cc\u00e8\u00be\u00e0 ; \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00c6\u008a \u00c0\u00f2\u00ca\u00e0\u00be\u00c6\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9\u00af\u00be\u00e0\u00bc \u0097\u00c4\u00cc\u00e9\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00c7\u00be \u00c8\u00bc \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0\u00c2\u00c8\u00c7\u00cd\u00fa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a,\n\n\u00c0\u00f2\u00ba\u00f8\u00c1\u00c8\u00c6 \u00ef\u00aa\u00be \u00ef\u00bc\u00be \u00ba\u00e5\u00a8\u00e0 \u00f3\u00c7\u00b4, \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00e8\u00ef\u00c6\u00cd\u00fa \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00c6\u008a \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00c2\u00c8\u00c7\u00cd\u00fa\u00ba \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb \u00af\u00be\u00e0\u00bc\u00c6 \u00bc\u00fb\u00c4\u00b4 \u00c0\u00f2\u00ba\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6, \u00af\u00be\u00e0\u00bc\u00c6\u00a8\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u009b\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00af\u00be\u00e0\u00bc\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00b4 \u00a6\u00a8\u00e0\u00d1\u00c4\u00b4 \u00c2\u00c8\u00c6 \u00c0\u00c9\u00c7\u00be\u00e0\u00be\u00a8\u00e0 \u00ef\u00c8\u00cc \u00bc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00c7, (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00cd\u00fa\u0095\u00c6\u00a8\u00eb \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0, \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00cd\u00e5 \u00cc\u00c4\u00e5\u00be\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n141. \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c6\u008a \u00c0\u00be\u00e0\u00ba\u00f8\u00c6\u00a8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00cd\u00e8\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00af\u00be\u00e0\u00bc \u0097\u00c4\u00cc\u00e9\u00c4\u00a8 \u00bc\u00fb, \u00a6\u00a8\u00e0\u00af\u00be\u00e0\u00bc\u00c6\u00a8\u00b4 \u00c9\u00b6\u00e5 \u00c9\u00e6\u0091 \u00af\u00be\u00e0\u00bc \u00cc\u00e2\u00a9\u00f1\u00e5\u00c9\u00a8\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4 \u00ba\u00f8\u00ef\u00c2\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb\u00af\u00be\u00e0\u00bc\u00c6 \u00ef\u00bc\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a, \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00cc\u00e8\u00c6\u00f5 \u00af\u00be\u00e0\u00bc \u00a6\u00a8\u00c4 \u00a1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00c0\u00e5\u0097\u0083\u008e\u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00fb\u00c4 \u00a1\u00c9\u00ca\u00f1 \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n142. (1) \u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c0\u00d6\u00bc\u00fa, \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00c6\u008a \u00cc\u00e2\u00a9\u00f1\u00e5\u00c9\u00a8\u00ef\u00aa\u00e0 \u00c8\u00e8\u008d\u00ba \u00a1\u0093\u00c6\u00e5\u00ae\u00be\u00c6 \u00c4\u00ba \u00cc\u00cd ( \u00cc\u00c4\u00e5\u00aa\u00c4\u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba \u00a8\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u0095\u00cc)\u00a1\u0093\u00c6\u00e5\u00ae\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u0097\u00c6\u00bc\u0095\u00be\u00e0\u2014\n\n(\u00a1)\u00a3\u00ce\u00ad \u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00c4\u00cd\u00e5 \u00cc\u00c3\u00e5\u00ef\u008c \u00bc\u00e6\u00be\u00e0\u00d1\u00c4 \u00c8\u00e6\u009f\u00c4\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5\u00c9\u00ec \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00b4 \u00a6\u00e0 \u00db\u00cc\u00e0\u00d1\u00ef\u008a \u00bc\u00fb \u00be\u00f8\u00c6\u00c4\u00a1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00cc\u00cd \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u00bc\u00cd\u00cc\u00e0\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00cc\u008a\u00c4\u00ba\u00c6\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00bc\u00e6\u00be\u00ea\u008a \u00bc\u00fb\u00c4 ;"
