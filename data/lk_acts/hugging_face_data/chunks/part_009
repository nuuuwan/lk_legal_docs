    "chunk_text": "\u201c(\u00a1\u00e6) \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5\u00c9 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5 \u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4, \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be\u00c6\u00e5\u00c4 \u00cc\u00cd\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4. \u201d .\n\n7.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 13 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00a1\u00ba\u00c7, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2013\n\n(2) \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00ef\u00c0\u00e5\u00f3 \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0\u00b4 \u00cc\u00cd \u00c0\u00e5\u00c8\u00be\u00c6\u00b4\u00c6\u00b4\u00ba\u00e0\u00c9, \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00be\u00f8\u00c6\u0095\u00ba \u00c0\u00d6\u00bc\u00fa\u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00cd \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0\u00c2\u00c8\u00ba\u00c8 \u00cc\u00cd \u00a8\u00da\u00ba\u00c9\u00f1\u00c6\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd\u00a2\u00b4\u00ea\u00a8\u00f8\u00d7\u00c4 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0, \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00c9\u00aa\u00a8\u00e8\u00c9\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u201c\u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e012 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e013 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 23 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba5\n\n(3) \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00a1\u00be\u00ea\u00c4\u00e6\u00ba\u00f8\u00c6\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9, \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00b0\u00be\u00c7\u00e5\u00c8\u00e0 \u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00c2\u00c8\u00ba\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00da\u00ba\u00c9\u00f1\u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0, \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00c9\u00ca\u00f1 \u00c6\u00c6\u00fa \u00cc\u00c8\u00a8\u00be \u00c0\u00d6\u00bc\u00fa \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4 \u00c8\u00e8\u008d\u00ba\u00c9 \u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8 \u00c6. \u00c2\u00c8\u00ba\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00da\u00ba\u00c9\u00f1\u00c6\u00be\u00e0 \u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00c6\u008a\u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb \u00ef\u00c9\u00ba \u00bc, \u00a6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00a6\u00e0\u00c2\u00c8\u00ba\u00c8 \u00cc\u00cd \u00a8\u00da\u00ba\u00c9\u00f1 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00c4\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6. \u201d.\n\n8.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 14 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00e8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00a6\u00c4 \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 14\u00a1 \u00cc\u00cd 14\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00ef\u00c8\u00cc \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6:\u2013\n\n14\u00a1. (1) \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0\u00a1\u00be\u00ea\u00c4\u00e6\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9, \u009e\u00c9\u00c7 \u00cc\u00cd \u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2 \u00bc\u00fb\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0 \u00ef\u00c8\u00cc\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc, \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5 \u00c9\u00f1\u00e5\u00c0\u00e0\u00ba\u00f8 \u00be\u00f8\u00c8\u00bd\u00e5\u00d6\u00bd\u00ea\u00c7\u00c6\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00bd\u00ea\u00c7\u00c6\u00a8\u00e0 \u00bc\u00c7\u00be \u00a1\u0093\u00a8\u00e5\u00d6\u00ef\u00c6\u00e0 \u00c6\u008a\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0, \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(2) \u00c2\u00c8\u00c0\u00ba\u00f2\u00bc\u00fb\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00ef\u00c8\u00cc \u00c0\u00ba\u00e0 \u00a8\u00ce \u00a8\u00f8\u00cc\u00e8\u00c6\u008a\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0, 14\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c2\u00c8\u00ba\u00c8\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u00c4\u00ba\u00c7\u00c9, \u009e\u00c9\u00c7 \u00cc\u00cd \u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a\u00a8\u00e5\u00da\u00c6\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00da\u00ba\u00c9\u00f1 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00bc, \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4\u00cc\u00cd \u00a2\u00b4\u00ea \u00a8\u00f8\u00d7\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n14\u00a1\u00e5. (1) \u00c2\u00c8\u00c0\u00ba\u00f2 \u00bc\u00fb\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00b4 \u2013\n\n(\u00a1)\u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5 \u00ef\u00c4\u00ef\u00cd\u00c6\u00ea\u00c4\u00a8\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba \u00d1\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6\u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0\u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00ef\u008c\u00c8\u00e5\u00c9\u00a8 \u00ef\u00aa\u00be\u00e0\u00c9\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4\u00cc\u00cd \u0097\u00c4\u00cc\u00e5 \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4;\n\n(\u00a1\u00e5)\u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5\u00c9\u00ec \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00d6\u00ca\u00f2\u00c6\u00a8\u00e0\u00ef\u00cc\u00e5\u00e0\u00bc\u00fa\u00cc\u00e8 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cc\u00cd \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00b414\u00a1 \u00cc\u00cd 14\u00a1\u00e5 \u00c6\u00be\u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n\u201c\u00c2\u00c8\u00c0\u00ba\u00f2 \u00bc\u00fb\u00ef\u008a\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0 \u00be\u008a\u00a8\u00f8\u00d7\u00c4.\n\n\u00c2\u00c8\u00c0\u00ba\u00f2\u00bc\u00fb\u00ef\u008a\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00c2\u00c8\u00ba\u00c8 \u00cc\u00cd\u00a8\u00da\u00ba\u00c9\u00f1\u00c6\u00be\u00e0."
