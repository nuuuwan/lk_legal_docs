    "chunk_text": "(4) \u00cc\u00e8\u00ba\u00e5\u00cc\u00e8 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00ef\u00bc\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00c9\u00ba\u00bc, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c6\u00bb\u00e5 \u00c0\u00d6\u00bc\u00fa \u00a1\u0093\u00a8\u00c7\u00b8\u00ef\u00c6\u00e0 \u00ef\u00c0\u00be\u00f9 \u00cc\u00e8\u00b4 \u00a6\u00e0\u00a1\u00e5\u00b3\u00e5\u00c9 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00ba\u00c4\u00e5\u00b4 \u00ef\u00cd\u00e0\u00ba\u00eb \u00bc\u00e6\u00a8\u00e0\u00d1\u00c4\u00b4\u00a1\u00e6\u00ba\u00e6\u00c6\u00fa \u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c9\u00cd\u00e5\u00c4\u00be\u00b6\u00ea\u00c9 \u0097\u00c3\u00e5\u00aa \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c0\u00cc\u00ea \u00bc\u00fa\u00be\u00c6\u00a8 \u0097\u00c3\u00e5\u00aa\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00be\u00f8\u00c6\u00c4 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(6) \u00c0\u00d7\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a1\u00c9\u00cc\u00e5\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb, \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0,\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa, 2\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 2\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00ef\u00cd\u00e5\u00e0 4\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 20\u00a1\u00e6 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00d6\u00bc\u00fa\u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6; \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0,\u00a2\u00c8\u00e0\u00c8\u00e9\u00c4 \u00be\u00f8\u00cb\u00e0\u00c0\u00f2\u00c3 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n20\u00a1\u00e5. \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00c9\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00be\u00b6\u00ea\u00a8\u00b4\u00c6\u00ea\u00ba\u00e0\u00ba\u00a8 \u00bc\u00fb \u00c6\u008a \u00a2\u00b6\u00c4\u00a8\u00e0 \u2014\n\n(\u00a1) 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00be\u00f8\u00c6\u00c4\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0\u00ef\u00aa\u00e5\u00b6\u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00cd \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0\u00ef\u00c8\u00cc \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00ba\u00eb\u00ce ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5) 2\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00cd\u00ba\u00e0,\u00c9\u00aa\u00eb\u00c7\u00e6, \u00c4\u00ea\u00b6\u00ea \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00e5\u00ef\u00cd\u00e5\u00c7\u00e6 \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc\u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00ba\u00eb\u00ce; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e6) 4\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00be\u00f8\u00c6\u00c4\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00e6\u00c8\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0\u00ba\u00eb\u00ce ; \u00ef\u00cd\u00e5\u00e0\n\n\u00c0\u00e8\u00cd\u00fa\u00b4\u00e5 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00bc \u00c6\u00be \u00c2\u00c9\u00b4 \u00c0\u00f2\u00ca\u00e0\u00be\u00c6\u00a8\u00e0 \u00c0\u00e6\u00be \u00be\u00e6\u00ef\u00aa\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00c0\u00f2\u00bd\u00e5\u00be \u0097\u00bd\u00e5\u00c6\u00a8 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0\u00a1\u00ba\u00e0\u00cc\u00be \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00a8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a2\u00b6\u00c4,\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa \u00ef\u00aa\u00e5\u00b6\u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00ba\u00eb\u00ce \u00ef\u00cd\u00e5\u00e0\u00c0\u00cd\u00ba\u00e0, \u00c9\u00aa\u00eb\u00c7\u00e6, \u00c4\u00ea\u00b6\u00ea \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00e5\u00ef\u00cd\u00e5\u00c7\u00e6 \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00ba\u00eb\u00ce \u00ef\u00cd\u00e5\u00e0\u00a1\u00e6\u00c8 \u00c7\u00a8\u00e0\u00cb\u00e8\u00ba \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8\u00e0 \u00ba\u00eb\u00ce \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4 \u00c9\u00ec \u00a6\u00e0\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00cc\u00e5\u00a8\u00e0\u00cb\u00f1\u00ef\u00c6\u00e0 \u00bc\u00fb \u00a1\u00e5\u00ef\u008c\u00ca\u00f1 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7,\u00a6\u00c6 \u00a6\u00cd\u00fa \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00a8\u00c7\u00e6\u00b8\u00ea \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c4\u00ea\u00c8\u00e0 \u00c2\u00e6\u00c8\u00e0\u00c4\u00b4 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba\u00cd\u00e6\u00a8\u00f8 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c\u00c0\u00f2\u00bd\u00e5\u00be \u0097\u00bd\u00e5\u00c6\u00a8\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00a6\u00cd\u00fa\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00e6\u00b8\u00ea\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c4\u00ea\u00c8\u00e0\u00c2\u00e6\u00c8\u00e0\u00c4\u00b4 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba\u00cd\u00e6\u00a8\u00f8 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n2006 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a2\u00b6\u008a \u00ef\u00aa\u00e5\u00b6\u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00cd\u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba11\n\n20\u00a1\u00e6. (1) 4\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00be\u00f8\u00c6\u00c4\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0\u00a1\u00e6\u00c8 \u00c7\u00a8\u00e0\u00cb\u00e8\u00ba\u00c6\u00a8\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00b4 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a\u00a1\u00e6\u00c8\u00a8\u00b4 \u00c6\u008a \u00f4\u00cb\u00b8\u00a8\u00e5\u00c7\u00a8\u00c6\u00a8\u00e0 \u00bc\u00e6\u00e4\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c2\u00e6\u00cd\u00e6\u00c7\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00c4 \u00a1\u00e6\u00c8 \u00f4\u00cb\u00b8\u00c6 \u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00f4\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4\u00cc\u00c8\u00cc\u00e0\u00c9\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00c9\u00be \u00a1\u00ba\u00c7\u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u00a2\u00bc\u00fa\u00d6\u00c0\u00e8\u00b4 \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00c8\u00ab\u00ea \u00be\u00b6\u00ea\u0097\u00c3\u00e5\u00aa\u00c6\u00a8\u00f8\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u008a \u00bc\u00fb \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0\u00a6\u00a8\u00e0\u00c8\u00a8\u00e0\u00cb\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c0\u00be\u00e0\u00c8\u00a8\u00e0\u00cb\u00c6\u00a8\u00b4\u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00b4 \u00cc\u00cd \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00a6\u00c4 \u00c9\u00c7\u00bc \u00bc\u00fa\u00aa\u00b4\u00c4 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u008a \u00bc\u00fb \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3\u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00bc\u00fa\u00be\u00a8\u00b4 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc \u00c2\u00e6\u00aa\u00fa\u00be\u00e0 \u00c9\u00ec\u00bc\u00b6\u00c6\u00a8\u00b4 \u00bc \u00a7\u00cd\u00ea \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00a6\u00c4 \u00f4\u00cb\u00b8\u00c6 \u2014\n\n(\u00a1) \u00a6\u00ef\u00cc\u00e0 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00b4 \u00c0\u00cc\u00ea\u00c9, \u00c2\u00e5\u00bd\u00e5\u00c9\u00a8\u00e8\u00be\u00e0\u00ef\u00ba\u00e5\u00c7\u00c9 \u00bc\u00fa\u00be \u00bc\u00e5\u00cd\u00ba\u00c7\u00a8\u00b4 \u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00bc\u00fa\u00aa\u00b4\u00c4\u00cc\u00e8\u00f3\u00c9\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 ; \u00ef\u00cd\u00e5\u00e0"
