    "chunk_text": "\u00b8\u00c6\u00c9\u00c7 \u00a8\u00e5\u0086 \u00c0\u00ba\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8\u00e0 \u00bc\u00c7\u00be\u00e0\u00be\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0, \u00a6\u00c4\u00a8\u00e5\u0086\u00c0\u00ba \u00ef\u00cd\u00e5\u00e0 \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00ce \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4 \u00cc\u00e8\u00ba\u00e5\u00c4\u00ba\u00e5 \u00c9\u00e2\u00ae\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a\u00a1\u00bc\u00cd\u00cc\u00e8\u00be\u00e0 \u00a6\u00ef\u00cc\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4 \u00c0\u00ec\u00da\u00c9 \u00be\u00f8\u00aa\u00c4\u00be\u00c6 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00ec\u00da\u00c9 \u00be\u00f8\u00aa\u00c4\u00be.\n\n\u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4\u00c6\u00a8\u00be\u00f9\u00ba\u00f1\u00be\u00ea\u00a8\u00ed\u00c8\u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0\u00c9\u00e2\u00ae\u00e5\u00c9\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00c2\u00c9\u00b4 \u00c0\u00ec\u00da\u00c9\u00be\u00f8\u00aa\u00c4\u00be\u00c6.\n\n19.1978 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be \u00a1\u0093\u00a8\u00c7\u00b8 \u00cc\u00e2\u0097\u00bd\u00e5\u00be \u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00c9\u00ea\u00c9 \u00bc, \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00cc\u00e7\u00c4 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c4 \u00be\u00b6\u00ea \u0097\u00c3\u00e5\u00aa\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00a8\u00f2\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c 154 \u00aa \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ef\u00a8\u00e5\u00ce\u00c5\u00bc\u00fb \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00c2\u00cc\u00e0\u00be\u00e5\u00cd\u00fa\u00c7 \u00c0\u00ce\u00e5\u00ef\u00ba\u00e0 \u00c4\u00cd\u00e5\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u0097\u00c3\u00e5\u00aa \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n20.1979 \u00a1\u00e2\u00a8 15 \u00bc\u00c7\u00be \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 \u00c0\u00be\u00ef\u00ba\u00e0\u00c0\u00b4\u00cd\u00e6\u00be\u00f8\u00c9 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00cc\u00e7\u00c4 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00c4, \u00a6\u00c4\u00c0\u00be\u00ef\u00ba\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00cc\u00cd \u00a6\u00cd\u00fa \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e2\u00ef\u00b3\u00c6 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n21.\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c8\u00bc\u00e6\u00c6\u00fa \u00a8\u00f8\u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c6\u008a \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00a8 \u00bc\u00fb \u00a6\u00c4 \u0097\u00ef\u00ca\u00e0\u00b3\u00c6\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00c0\u00c9\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00cc\u00e8\u0097\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea\u00c9\u00a8 \u00bc\u00e9 \u00a6\u00c4\u0097\u00ef\u00ca\u00e0\u00cb\u00b3\u00c6\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e8\u00cc\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5\u00b4 \u00bc\u00e6\u00d7\u00c4\u00b4 \u00cc\u00e8\u00f3 \u00c9\u00ec \u00c6\u008a \u0097\u00c6\u00bc\u00c4\u00a8\u00e0, \u00a6\u00c4\u00a8\u00f2\u00e8\u00c6\u00e5\u00c9 \u00cc\u00bc\u00e0\u00c3\u00e5\u00c9\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c2\u00c9\u00b4 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u00ba\u00e9\u00c7\u00b8\u00c6\u00a8\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a, \u00a6\u00c4 \u00cc\u00e8\u0097\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c0\u00c7\u00e5\u00bd \u00be\u00b6\u00ea\u00ef\u008c \u00bc\u00fb \u00a6\u00c4 \u00c4\u00ea\u00bc\u00c8 \u00a7\u00cd\u00ea \u0097\u00cc\u00e8\u00be\u00e0\u00a1\u00c6\u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00be\u008a \u0095\u00cc, \u00a6\u00c4 \u00c4\u00ea\u00bc\u00c8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa \u00be\u00f8\u00a8\u00eb\u00ba\u00e0\u00a8\u00c7\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n22.\u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1977 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00a4\u00bc\u00da\u00c0\u00be \u00c0\u00be\u00ef\u00ba\u00e0\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u201c\u00a1\u00e5\u201d \u00ef\u00a8\u00e5\u00b4\u00cc\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00c4 \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00ef\u0089 :\u2014\n\n\u201c(48)2006 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4 \u00c9\u00e2\u00ae\u00e5 \u00c0\u00be\u00ef\u00ba\u00e0\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c9\u00ec \u00c9\u00c7\u00bc\u00a8\u00e0 ;\u201d\n\n23.\u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1977 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00a4\u00bc\u00da\u00c0\u00be \u00c0\u00be\u00ef\u00ba\u00e0\u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00a6\u00c4 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a4\u00bc\u00da\u00c0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00c4\u00b8\u00a8\u00e0\u00ef\u008a \u00c0\u00be\u00ba \u00c0\u00f2\u00a8\u00e5\u00c7 \u00c9\u00ec \u00c9\u00c7\u00bc\u00a8\u00e0 \u00c4\u00ea\u00c8\u00f1 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00ef\u00c8\u00cc \u00ef\u00cd\u00e5\u00e0 \u00ef\u00bc\u00e0\u00ca\u00c0\u00e5\u00c8\u00be \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00ef\u00c6\u00e0\u00c9\u00c7\u00bc\u00a8\u00e0 \u00ef\u00c8\u00cc \u00ef\u00cd\u00e5\u00e0 \u00ef\u00bc\u00e0\u00ca\u00c0\u00e5\u00c8\u00be \u00c9\u00c7\u00bc\u00a8\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00c9\u00c7\u00bc\u00a8\u00e0 \u00ef\u00c8\u00cc \u00ef\u00cd\u00e5\u00e0\u00ef\u00bc\u00e0\u00ca\u00c0\u00e5\u00c8\u00be \u00a1\u00c7\u00c4\u00ea\u00b8\u00ea \u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00c0\u00e5\u00ce\u00c5\u00c9\u00be \u00c8\u00bc \u00c9\u00c7\u00bc\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea\u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c4\u00cd\u00e5\u0093\u00a8\u00c7\u00b8\u00c6\u00b4\u00a1\u0093\u00a8\u00c7\u00b8 \u00c2\u00c8\u00c6\u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec\u00c9\u00e6\u00c7\u00bc\u00fa \u00cc\u00e2\u00ef\u00b3\u00c6 \u00c9\u00e6\u00c7\u00bc\u00fa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00be\u00b6\u00ea\u00c9\u00a8\u00bc\u00fb \u00bc\u00e6\u00d7\u00c4\u00b4\u00cc\u00e8\u00f3 \u00c9\u00ec \u0097\u00c6\u00bc\u008a\u00ef\u00aa\u00d1\u00c4.\n\n\u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1\u00cc\u00c3\u00e5\u00ef\u008c 1977 \u00a1\u00e2\u00a88 \u00bc\u00c7\u00be \u00a4\u00bc\u00da\u00c0\u00be\u00c0\u00be\u00ba \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\u00a8\u00f8\u00d7\u00c4.\n\n\u00a4\u00bc\u00da\u00c0\u00be \u00c0\u00be\u00ba\u00b4\u00a1\u00bc\u00e5\u00ce\u00c9 \u00a1\u00da\u00bb\u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n152006 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00ef\u00aa\u00d1\u008a \u00a4\u00c0\u00a8\u00f2\u00c4 \u00c9\u00e2\u00ae\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c0\u00be\u00ba"
