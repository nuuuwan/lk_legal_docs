    "chunk_text": "2\u00b0 (1) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u201c\u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d5 2007\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00c1\u00d7\u00ba\u00c6\" 2007\" \u00b1\u00b8\u00c1\u00bc\u00c8 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8 \u00cc\u00b6\u00c7\u00b4+\u00c6\u00af\u00c8 2007\" \u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00bc\u00c631 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00db\u0088\u00c1\u00ce\u00b4\u00c1\u00d7\u00ba\u00c7\u00b8 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00af\u00c7\u00b8\u00cd\u00b1\u00ce\u00c1\u00af\u00c6\u00af\u00c7\u00af \u00ba\u00b6\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00b8 \u00a9\u00ae\u00d6{\u00bd\u00c6\u00bd\u00c8 \u00ac\u0081\u00b9\u00b6\u00c7\u008a\u00bc\u00b6\u00c6\u00d7\u00b7\u00c7\u00d9{\u00bd\u00c6\u00de \u00b7\u00c7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8 \u00f2\u0081\u00de \u00ba\u00c8\u00be\u00c6\u008b\u00bb\u0081 \u00ab\u00b7\u00c6\u00d8{\u00bd\u00c6\u00bd\u00c8 \u00ab\u00ba\u00c6\u00b9\u00d7 \u00a4\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00cc\u00b1\u00be\u008c\u00b8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u00bb\u00c7\u00b8\u00d7\" \u00cc\u00b1\u00be\u008c\u00b8\u00ba\u00c6\u00a9\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00cd\u00c1\u00de \u00b1\u00b4\u00c6\u00b4\u00cc\u00ba\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00b9+\u00c6\u00af\u00ba\u00c8\u0081\u00bd\u00c8 \u2013\n\n(\u00a3)\u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00b8\u00c8\u00b4\u00db\u00bf\u00c6\u00bf \u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00b5+\u00c6\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\n\n\u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d52007 \u00a5\u00bd\u00c6\u00af\u00c7\u00b8 \u00b7\u00c8\u00b6\u00c8\u00ac\u00d7\u00af\u00c6\u00af\u00c9\u00d5\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 47 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00ac\u00d7\u00af\u00c6\u00af\u00c9\u00b4\u00c6\u00d5\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c62\n\n\u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a4)\u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6 \u00a3\u00b6\u0081 \u00b1\u00c7\u00bc\u00c6\u0089\u00df\u00ba\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\n\n\u008a\u00cd\u00be\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0 \u00cc\u00c1\u00bf\u00c8\u008a\u00cd\u00be\u00c7 \u00b6\u00c8\u00bc\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\n\n\u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u00b8 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\n\n\u00af\u00b4\u0081\u00af\u00bf\u00c8\u0081 \u00c1\u00dd\u00ba\u00c6\u00b9\u0088\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00ba\u00c6\" \u00cc\u00b9\u00bd\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\n\n\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c7\u008a\u00d9\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00dd\u00ba\u00c6\u00b9\u0088\u008a\u0081\n\n\u00e7\u00b4\u00c6\u00d5 \u00cc\u00ba\u00c7\u00b6\u00c6\u00b6\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u00bb\u00c7\u00b8\u00d7 \u00a3\u00de\u00d8{\u00bd\u00c6\u00bd\u00c8 \u00ab\u00ba\u00c6\u00b9\u00b6\u00c6\u00d7\n\n\u00ab\u00b7\u00c6\u00d7 \u00a4\u008a\u00bc\u00ba\u00c6 \u00ba\u00c8\u00be\u00c6\u008b\u00bb\u0081 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00d2\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n(2) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00ae\u00d6{\u00bd\u00c6\u00de\n\n\u00ac\u0081\u00b9\u00b6\u00c7\u008a\u00bc\u00b6\u00c6\u00d7 \u00b7\u00c7\u00d9{\u00bd\u00c6\u00de \u00b7\u00c7\u00bd\u00c6\u00b9\u00b6\u00c6\u00d7 \u00f2\u0081\u00de \u00ba\u00c8\u00be\u00c6\u008b\u00bb\u0081 \u00ab\u00b7\u00c6\u00d8{\u00bd\u00c6\u00bd\u00c8\n\n\u00ab\u00ba\u00c6\u00b9\u00d7 \u00a4\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7 \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00db\u00b6\u00be\u00c7\u00ba\u00c6\n\n\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00c1\u00c7\u00de \u00cc\u00b1\u00be\u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n(3) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6\"\n\n\u00a3\u00b6\u0081 \u00b1\u00c7\u00bc\u00c6\u0089\u00df\u00ba\u00c6 \u00af\u00b4\u0081 \u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\n\n\u00be\u00c7\u00b8 \u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9+\u00c6\u00af\u00ba\u0081\u00bd\u00c8\n\n\u00b9\u00bb\u00d9\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n3\u00b0 (1) \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d5 2007 \u00a5\u0081 \u00cd\u00b9\u00c7\u00d7 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8\n\n\u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 I \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\n\n\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7\u00ba\u00c6 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00ba\u00c6 \u00cc\u00b9\u00de\u00ba\u00c6\n\n\u00cc\u00b9\u00de\u00ce\u00af\u00af\u00bf\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00bf\u00c8\u0081 \u00af\u00b5\u00af\u00c6\u00af\u00c8\u00bd\u00c6\u00d0 \u00c1\u00bc\u00e2\n\n\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a4\u00b8\u00c7\u00be\u00c6 \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00c1\u00bc\u00e2\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\n\n\u00b9\u00d5\u00ba\u00c6 \u00cc\u00b9\u00de\u00ce\u00af\u00af\u00bf\u00c8\u0081 \u00e7\u00b4\u00c6\u00d5\u00cc\u00ba\u00c7\u00b6\u00c6\u00b6\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u00bb\u00c7\u00b8\u00d7\"\n\n\u00a3\u00c1\u00c6\u00c1\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 III \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00be\u00c6 \u00a7\u00bf\u00c6\u00bf \u00cd\u00b7\u00cc\u00bc\u00c7\u00b6\u00c6\u00b6 \u00b9\u00b6\u00c8\u008c\u00be\u00c6\n\n\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00a4\u00af\u00af\u00c6 \u00d0\u00ce\u00bd\u00b7\u00c6\u00b6 \u00a9\u00be\u00c6\u00ce\u00be\u00af\u00c6\u00d0 \u00d0\u00ce\u00bd\u00c1\u00c7\u00af\n\n\u008c\u00dd\u00b6\u00c6\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00bf\u00c8\u0081 \u00cd\u00b6\u00bd\u00c8\u00bb \u00ba\u00c8\u00ce\u00af\u00bb\u00c7\u00b8\u00d7\n\n\u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d52007 \u00a5\u00bd\u00c6\u00af\u00c7\u00b8\u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00d0\u00bd\u00c8\u00b6\u00c6\u00b6 \u00b1\u00c8\u00be\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00af\u00bf\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c7\u00b8\u00b7\u00c8\u00b6\u00c8 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 47 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00ac\u00d7\u00af\u00c6\u00af\u00c9\u00b4\u00c6\u00d5\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 3\n\n\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a5\u00dd\u00b9\u00c6\u0089\u0081\" \u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00ae\u00d5 2007 \u00db\u0088\u00e2\u00bd\u00c6\u00bd \u0089\u0081\u00b8\u00bc\u00c6 \u00a4\u00de\u00ba\u00c7\u00b6+\u00c6\u00af\u00bf\u00c6 \u00db\u0088\u00c1\u00ce\u00b4\u00c1\u00b6\u00bd\u00c6\u00d0 \u00db\u0081\u00b8\u00b6\u00c7\u00af\u00b6\u00c6 \u00b6\u00c8\u00bc\u00b4\u00c6\u00d5 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b1\u00c6\u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0"
