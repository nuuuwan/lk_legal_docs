    "chunk_text": "\u201c(\u00a1\u00e7)\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c9\u00c8\u00e8\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00c8\u00e6\u00ef\u00c2\u00be \u00cc\u00e8\u00c6\u00f5 \u00c4\u00ea\u00bc\u00c8\u00e0 ;\n\n(\u00a2)\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00cc\u00e8\u00c6\u00f5\u00c4\u00ea\u00bc\u00c8\u00e0 ; \u00cc\u00cd\n\n(\u00a3)\u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00a1\u00bd\u00f1\u00c6\u00be \u00c0\u00e5\u00b5\u00c4\u00e5\u00c8\u00e5\u00cc\u00bf\u00cd\u00e5 \u00ef\u00aa\u00d1\u008a \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00cc\u00e8\u00c6\u00f5 \u00c4\u00ea\u00bc\u00c8\u00e0.\u201d.\n\n10\u00a1. \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 (\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00cc\u00c3\u00e5\u00c9\u201d\u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u201c\u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00a4\u00c0\u00ef\u00bc\u00e0\u00ca\u00a8 \u00cc\u00c3\u00e5\u00c9\u201d \u00be\u008a \u00c9\u00ec \u00cc\u00c3\u00e5\u00c9\u00a8\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00c4 \u00cc\u00c3\u00e5\u00c9 \u00c7\u00e5\u00b0\u00f1 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9, \u00c7\u00e5\u00b0\u00f1 \u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb, \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5, \u00be\u00f9\u00ba\u00f8\u00c6, \u00b0\u00e5\u00ba\u00f8\u00a8\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9, \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u0097\u00bc\u00f1\u00e5\u00c9, \u00a8\u00ee\u00cb\u00e8\u00a8\u00da\u00c4\u00c6 \u00cc\u00cd \u00c0\u00d6\u00cc\u00c7\u00c6\u00b4\u00a1\u00bc\u00e5\u00ce \u00a8\u00e0\u00ef\u00cb\u00e0\u00ba\u00f2\u00c9\u00c8 \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00c0\u00f2\u00cc\u00e8\u00bc\u00e0\u0093\u00c6\u00a8\u00e0 \u00c8\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00c0\u00cc\u00e0\u00ef\u00bc\u00be\u00a8\u00eb\u00ef\u00aa\u00be\u00e0 \u00cc\u00c4\u00be\u00e0\u0097\u00ba \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00cc\u00c3\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00cc\u00e8\u00c6 \u00a4\u00ba\u00e0\u00cc\u00e5\u00cd\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u0090\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u0097\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce \u00a8\u00c7\u00e6\u00b8\u00ea \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u00a4\u00c0\u00ef\u00bc\u00cc\u00e0 \u00bc\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u201c\u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7\u00a4\u00c0\u00ef\u00bc\u00e0\u00ca\u00a8\u00cc\u00c3\u00e5\u00c9.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00b410\u00a1, 10\u00a1\u00e5, 10\u00a1\u00e6,10\u00a1\u00e7 \u00cc\u00cd 10\u00a2 \u00c6\u00be\u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 9\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 32 \u00bc\u00c7\u00be \u00a4\u00c0\u00e5\u00c6 \u00c4\u00e5\u00da\u00aa \u00a1\u00bd\u00f1\u00c6\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba7\n\n10\u00a1\u00e5. \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00bc\u00a8\u00e5\u00da\u00c6 \u00cc\u00cd \u00a8\u00da\u00ba\u00c9\u00f1 \u00a2\u00b4\u00ea\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00bc \u00a1\u00c9\u00ca\u00f1 \u00c6\u00c6\u00fa\u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e0\u00bb\u00e5\u00c9\u00c7 \u00a8\u0095\u00b4\u00ea \u00ef\u00cd\u00e5\u00e0 \u00cd\u00bc\u00fa\u00cc\u00e8 \u00a8\u0095\u00b4\u00ea, \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6. \u00a6\u00c4 \u00a8\u0095\u00b4\u00ea\u00c9\u00c8\u00b4\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00bc \u00a1\u00e6\u00ba\u00eb\u00c8\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n10\u00a1\u00e6. (1) \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u00cc\u00ea\u00f3\u00cc\u00ea \u00c2\u00c9\u00b4 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00c2\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00c8 \u00c2\u00bf\u00c9\u00e5 \u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(2) \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ba\u00e0\u00c9\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00a4\u00c0\u00c4\u00e5\u00be (\u00aa\u00c7\u00e6\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00cc\u00cd \u00c2\u00bf\u00c9\u00e5\u00aa\u00ba\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd)\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u0097\u0097\u00bd \u00c0\u00be\u00e0\u00ba\u00f8 \u00cc\u00cd \u00c9\u00da\u00aa, \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00c2\u00bf\u00c9\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00a8\u00f2\u00c4\u00c6 \u00cc\u00cd \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6, \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00c9\u00f1\u00ea\u00cd\u00c6, \u00af\u00be\u00e0\u00bc\u00c6 \u00bc\u00fb\u00ef\u008a \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6\u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a, \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0\u00c0\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00da\u00aa\u00ef\u00c6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c2\u00e6\u00bf\u00fb\u008a \u00cc\u00cd\u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00d1\u00c4 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00be \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u0095\u00be\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00d7\u00ba\u00f8 \u00cc\u00e5\u00bc\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(3) \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a\u00c9\u00c8\u00b4 \u00cd\u00e5\u00be\u00f8\u00bc\u00e5\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0\u00c0\u00b4\u00cd\u00e6\u00be\u00f8 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00b4 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb\u00b4\u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a4\u008e\u00ba \u00c6\u00c6\u00fa \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5 \u00c4\u00e5\u00da\u00aa\u00c6\u00a8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6."
