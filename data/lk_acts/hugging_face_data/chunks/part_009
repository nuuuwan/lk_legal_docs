    "chunk_text": "(\u00a1\u00e6)\u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c3\u00e5\u00b8\u00e0\u00b6\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00ce \u00ef\u00c9\u00ef\u00ce\u00bf \u00c8\u00a8\u00eb\u00b8\u00a8\u00e0;\n\n(\u00a1\u00e7)\u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00e0 \u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00c9\u00da\u00aa\u00e9 \u00be\u00e5\u00c4\u00c6\u00a8\u00e0;\n\n(\u00a2)\u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00be\u00c4,\n\n2006 \u00a1\u00e2\u00a8 27 \u00bc\u00c7\u00be \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00cd\u00e5 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba19\n\n\u201c\u00c0\u00ce\u00a8\u00f8\u00d7\u00c4\u201d \u00c6\u00be\u00e0\u00be \u201c\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00c0\u00f2\u00ae\u00e5\u00c7\u00a8 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7\u00c0\u00f2\u00ae\u00e5\u00c7\u00a8 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00b4\u201d \u00a1\u00bc\u00e5\u00ce\u00c9, \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00bc\u00e7 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c :\u2014\n\n(\u00a1)\u00c0\u00f2\u00ae\u00e5\u00c7\u00a8 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ae\u00e5\u00c7\u00a8 \u00bc\u00e6\u00be\u00e0\u00d1\u00ef\u008a \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0,\u00c4\u00cd\u00b0\u00be\u00c6\u00e5\u00b4 \u00c0\u00f2\u00ef\u008c\u00ca \u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c9\u00e5\u00cd\u00be\u00c6\u00a8\u00f8\u00be\u00e0 \u00bc\u00da\u00ca\u00be\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00c9\u00b8\u00c6 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8\u00c0\u00d6\u00bc\u00fa \u00c0\u00f2\u00bc\u00da\u00ca\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00ba\u00f8\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e5\u00bc\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4;\n\n(\u00a1\u00e5)\u00c4\u00cd\u00b0\u00be\u00ba\u00e5\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00cd\u00b0\u00be\u00ba\u00e5\u00c9\u00ef\u00aa\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00c9\u00ba \u00c8\u00c2\u00e5\u00aa\u00ba\u00cd\u00e6\u00a8\u00f8 \u00c0\u00d6\u00bc\u00fa \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c2\u00bc\u00e5\u00cd\u00d6\u00be\u00ea \u00c8\u00c2\u00be \u00c0\u00f2\u00c9\u00ee\u00ba\u00e0\u00ba\u00f8 \u00c0\u00ba\u00f2\u00c6\u00a8,\u00cc\u00ad\u00c7\u00e5\u00c9\u00a8, \u00c9\u00e6\u00b6\u00cc\u00b4\u00cd\u00be\u00a8, \u00c0\u00ba\u00f2\u00e8\u00a8\u00e5\u00c9\u00a8, \u00a1\u00ba\u00e0 \u00c0\u00ba\u00f2\u00e8\u00a8\u00e5\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8 \u00c0\u00f2\u00ae\u00e5\u00c7\u00a8 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4;\n\n(\u00a1\u00e6)\u00c4\u00cd\u00b0\u00be\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00cd\u00b0\u00be\u00ba\u00e5\u00c9\u00ef\u00aa\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0\u00be\u00c7\u00c5\u00be \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00c9\u00b8\u00c6 \u00a8\u00c7\u00be \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00be\u00c7\u00c5\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0\u00ca\u00f2\u00c9\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00b4 \u00a1\u00c7\u00c4\u00ea\u00b8\u00ea \u00a8\u00c7\u00be \u008e\u00ba\u00f2\u00c0\u00b4\u00c6\u00a8, \u00d1\u0091\u00ef\u00c6\u00e5\u00e0\u00c0\u00b4\u00c6\u00a8, \u00aa\u00eb\u00c9\u00be\u00e0\u0097\u00f3\u00c8\u00e8 \u00c9\u00e6\u00b6\u00cc\u00b4\u00cd\u00be\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00e7\u00c0\u00c9\u00e5\u00cd\u00fa\u00be\u00f9\u00c9\u00e6\u00b6\u00cc\u00b4\u00cd\u00be\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00e0\u00ba\u00da\u00b0\u00e5\u00c8\u00c6 \u00ba\u00eb\u00ce \u00c0\u00f2\u00ae\u00e5\u00c7\u00a8 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4;\n\n(\u00a1\u00e7)\u00c0\u00f2\u00ae\u00e5\u00c7\u00a8 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ae\u00e5\u00c7\u00a8 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0\u00c4\u00cd\u00b0\u00be\u00ba\u00e5\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00cd\u00b0\u00be\u00ba\u00e5\u00c9\u00ef\u00aa\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00b4 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4,\u00a8\u00eb\u00c8\u00e8\u00c6\u00b4 \u00bc\u00fb\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00ef\u00cd\u00e5\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u00c4, \u00a8\u00eb\u00c8\u00e8\u00c6\u00b4 \u00bc\u00fb\u00c4, \u00ef\u00cd\u00e5\u00e0\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4,\n\n\u201c\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00c0\u00f2\u00ae\u00e5\u00c7\u00a8 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0\u2014\n\n(\u00a1)\u00f3\u008a\u00c0\u00e5\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4;\n\n(\u00a1\u00e5)\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u0095\u00c8 \u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e5\u0097\u0083\u008e \u00a8\u00e8\u00d7\u00c4;\n\n(\u00a1\u00e6)\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c6\u008a \u00c3\u00e5\u00b8\u00e0\u00b6 \u00cc\u00bf\u00cd\u00e5 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00ce \u00ef\u00c9\u00ef\u00ce\u00bf\u00c8\u00a8\u00eb\u00b8\u00a8\u00e0;\n\n2006 \u00a1\u00e2\u00a8 27 \u00bc\u00c7\u00be \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00cd\u00e5 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u0093\u00a8\u00e5\u00d6\u00c6 \u00c0\u00be\u00ba20\n\n(\u00a1\u00e7)\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00a1\u00e5\u00ca\u00f2\u00e8\u00ba \u00c9\u00da\u00aa \u00be\u00e5\u00c4\u00c6\u00a8\u00e0;\n\n(\u00a2)\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00be\u00c4,\n\n\u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u00c7\u00c4\u00ea\u00b8\u00ea \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a\u00c8\u00e8\u00c6\u0097\u00c8\u00e0\u00c8\u00a8\u00e0, \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00ae\u00c8 \u00c0\u00e8\u00be\u00e0\u00ba\u00ed\u00c7, \u00cc\u00e2\u00b3\u00e5, \u00cc\u00e2\u00ef\u00a8\u00e0\u00ba \u00ef\u00cd\u00e5\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba\u00c9\u00da\u00b8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00bc\u00ee\u00cb\u00f1 \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00ca\u00f2\u00c9\u00f1 \u00c0\u00b8\u00e8\u0097\u00b6\u00c6\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8 \u00cc\u00e2\u00a8\u00c8\u00be\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n36.(1) \u00a8\u00f8\u00cc\u00e8\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0, \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c9\u00c8\u00b4 \u00ef\u00cd\u00e5\u00e0\u00c4\u00bd\u00f1\u00cc\u00e5\u00c7 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c9\u00c8\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00ef\u00c9\u00ef\u00ce\u00bf \u00be\u00e5\u00c4\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00ce\u00bf \u00c8\u00a8\u00eb\u00b8\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c6\u008a \u00cc\u00e2\u00ef\u00a8\u00e0\u00ba\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c9\u00c8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7\u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c9\u00c8\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00c9\u00be \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00a8\u00c6\u00e5\u00ef\u00aa\u00e0 \u00be\u00c4, \u00cc\u00ee\u00b0\u00ea\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00a8\u00f2\u00c9 \u00a6\u00e0\u00f3\u008a\u00ef\u00a8\u00e5\u00ce \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00bc\u00f1\u00cc\u00e5\u00c7 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00cc\u00c4\u00aa\u2014\n\n(\u00a1)\u00c6\u008a \u00a1\u00bd\u00f1\u00e5\u00c0\u00be\u00f8\u00a8, \u00cc\u00e2\u00cc\u00e0\u00a8\u00ee\u00ba\u00f8\u00a8, \u00cc\u00c4\u00e5\u00b0 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00f2\u00e9\u00b6\u00e5 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c0\u00f2\u00c9\u00da\u00bd\u00be \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00c7\u00a8\u008a \u00ef\u00cd\u00e5\u00e0 \u00a4\u00ba\u00e0\u00cc\u00c9 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00be\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0;"
