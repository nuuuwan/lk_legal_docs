    "chunk_text": "(3) \u00c6\u008a \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00a8\u00e0 \u00a1\u00be\u00e5\u00c9\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00b4 \u00aa\u00e6\u00be\u00f9\u00c4\u00ef\u00cd\u00e5\u00e0 \u00a6\u00c6 \u00a4\u00c0\u00ef\u00c6\u00e5\u00e0\u00aa\u00fb \u00a8\u00c7\u00ef\u00aa\u00be \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00b4\u00a1\u00aa\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c9\u00b4 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00cc\u00e7\u00cd\u00fb\u00c4\u00b4 \u00c0\u00ba\u00e0 \u00c9\u00be\u00e0\u00ef\u00be\u00e0\u00be\u008a, \u00a6\u00ef\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb\u00b4 \u00c2\u00c8\u00c6\u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u0097\u00cb\u00c6\u00ef\u00c6\u00cd\u00fa \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00a1\u00be\u00e5\u00c9\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\n\n(\u00a1)\u00a6\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5 \u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3\u00fb \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6 \u00ef\u008c \u00be\u008a ;\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00af\u00be\u00e0\u00bc\u00c6 \u00bc\u00fb\u00ef\u008a \u00c6\u008a \u00a1\u00c6\u00fa\u00ba\u00f8\u00c6\u00a8\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00c8\u00c6 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u00b4 \u00ba\u00f8\u00ef\u0089 \u00be\u008a ;\n\n(\u00a1\u00e6) \u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00b4 \u00a1\u00c6\u00ba\u00e0 \u00af\u00be\u00e0\u00bc\u00c6 \u00c0\u00e5\u0097\u0083\u008e \u00a8\u00f8\u00d7\u00c4 \u00c6\u008a \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u00c4\u00a8\u00e0\u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00c8\u00c6 \u00a6\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u00b4 \u00ba\u00f8\u00ef\u0089 \u00be\u008a ;\n\n(\u00a1\u00e7)\u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c2\u00c8\u00c6 \u00a6\u00e0\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u00b4 \u00ba\u00f8\u00ef\u0089 \u00be\u008a ;\n\n(\u00a2)\u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00ef\u00cd\u00e5\u00e0\u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00c8\u00c6 \u00a6\u00e0 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u00b4\u00ba\u00f8\u00ef\u0089 \u00be\u008a ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a3) \u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00c6\u008a \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0, \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00e0, \u00cc\u00e6\u00c8\u00cc\u00ea\u00c4\u00a8\u00e0,\u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00ce\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00e0\u00be\u00a8\u00e0 \u00c0\u00f2\u00a8\u00e5\u00c7(\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a3\u00b4 \u00c0\u00e5\u00da\u00ca\u00e0\u00c9\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00ea \u00c9 \u00bc, \u00ef\u00be\u00e5\u00c9\u00ec\u00c9 \u00bc)\u2014\n\n(i)\u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00af\u00be\u00e0\u00bc\u00c6 \u00bc\u00fb\u00ef\u008a \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u00c4\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00c8\u00c6 \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00ef\u008c\u00c8\u00e5\u00c9\u00a8 \u00bc\u00fb \u00ba\u00f8\u00ef\u0089\u00be\u008a;\n\n(ii)\u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00af\u00be\u00e0\u00bc\u00c6 \u00bc\u00fb\u00ef\u008a \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u00c4\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00ef\u008c\u00c8\u00e5\u00c9\u00a8 \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0\u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00c8\u00c6 \u00ba\u00f8\u00ef\u0089 \u00be\u008a;\n\n\u201c\u00a1\u00bc\u00e5\u00ce\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u201d\u00c6\u00be\u00e0\u00ef\u00be\u00cd\u00fa \u00a1\u00da\u00bb\u00c6.\n\n2007 \u00a1\u00e2\u00a8 07 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba168\n\n(iii)\u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00e9\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0\u00c2\u00c8\u00c6 \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00ef\u008c\u00c8\u00e5\u00c9\u00a8 \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00ba\u00f8\u00ef\u0089 \u00be\u008a; \u00ef\u00cd\u00e5\u00e0\n\n(iv)\u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00ef\u00cd\u00e5\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00c8\u00c6 \u00a8\u00c9\u00c7\u00ef\u00cd\u00e5\u00e0 \u00ef\u008c\u00c8\u00e5\u00c9\u00a8 \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00ba\u00f8\u00ef\u0089 \u00be\u008a,\n\n200 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a6\u00e0\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00e5\u00b4 \u00a1\u00bc\u00e5\u00ce \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6.\n\n(2) \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 (\u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00c9\u00ea\u00c9 \u00bc,\u00ef\u00be\u00e5\u00c9\u00ec\u00c9 \u00bc) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00f2\u00a8\u00e5\u00c7 \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00cc\u00cd\u2014\n\n(\u00a1)(i)\u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00af\u00be\u00e0\u00bc\u00c6 \u00c0\u00e5\u0097\u0083\u008e \u00a8\u00f8\u00d7\u00ef\u008a\u00a1\u00c6\u00e8\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u00c4 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0;\n\n(ii)\u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00af\u00be\u00e0\u00bc\u00c6 \u00c0\u00e5\u0097\u0083\u008e \u00a8\u00f8\u00d7\u00ef\u008a\u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u00c4\u00a8\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0;\n\n(iii)\u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0; \u00ef\u00cd\u00e5\u00e0\n\n(iv)\u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00ef\u00cd\u00e5\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00c8\u00c6 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00a8\u00f8\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0,"
