    "chunk_text": "\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 07 \u00c9\u00be\u00c0\u00e8\u00b4\u00ea\u00c9 11 \u00cc\u00e8\u00b4 17 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\n\n\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6, \u00c6\u00be \u00c0\u00f2\u00ca\u00e0\u00be\u00c6 \u0097\u00c4\u00cc\u00be \u00c8\u00bc\u00fa\u00be\u00e0, \u00cc\u00c3\u00e5 \u00cc\u008a\u00c4\u00ba\u0097\u00c6.\n\n11 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\n\n\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\n\n7 \u00c9\u00be \u00c0\u00e8\u00b4\u00ea\u00c9, 18 \u00cc\u00e8\u00b4 29 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\n\n12 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\n\n\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 7 \u00c9\u00be\u00c0\u00e8\u00b4\u00ea\u00c9, 30 \u00cc\u00e8\u00b4 37 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\n\n\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6, \u00c6\u00be \u00c0\u00f2\u00ca\u00e0\u00be\u00c6 \u0097\u00c4\u00cc\u00be \u00c8\u00bc\u00fa\u00be\u00e0, \u00cc\u00c3\u00e5 \u00cc\u008a\u00c4\u00ba\u0097\u00c6.\n\n13 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\n\n\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 8 \u00c9\u00be\u00c0\u00e8\u00b4\u00ea\u00c9 1 \u00cc\u00e8\u00b4 6 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\n\n\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6, \u00c6\u00be \u00c0\u00f2\u00ca\u00e0\u00be\u00c6 \u0097\u00c4\u00cc\u00be \u00c8\u00bc\u00fa\u00be\u00e0, \u00cc\u00c3\u00e5 \u00cc\u008a\u00c4\u00ba\u0097\u00c6.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c9\u00a8\u00eb\u00aa\u00b6\u00ea \u00c0\u00bc\u00be\u00c4 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a)17\n\n14 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\n\n\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 8 \u00c9\u00be\u00c0\u00e8\u00b4\u00ea\u00c9 7 \u00cc\u00e8\u00b4 32 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8 \u00cc\u00cd 9 \u00c9\u00be \u00c0\u00e8\u00b4\u00ea\u00c9, 1 \u00cc\u00e8\u00b4 15 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00ef\u00c0\u00e0\u00c8\u00e8\u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be\n\n\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00c0\u00e8\u00ce\u00e8\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6, \u00c6\u00be \u00c0\u00f2\u00ca\u00e0\u00be\u00c6 \u0097\u00c4\u00cc\u00be \u00c8\u00bc\u00fa\u00be\u00e0, \u00cc\u00c3\u00e5 \u00cc\u008a\u00c4\u00ba\u0097\u00c6.\n\n15 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00cc\u00c3\u00e5 \u00cc\u008a\u00c4\u00ba \u0097\u00c6.\n\n\u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\n\n5. \u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\n\n\u00aa\u00c7\u00e6 \u0097\u00b0\u00c6\u00bc\u00e5\u00cc \u00c7\u00e5\u00b0\u00c0\u00a8\u00e0\u00cb \u00c4\u00cd\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\n\n9 \u00c9\u00be \u00c0\u00e8\u00b4\u00ea\u00ef\u008c 15 \u00c9\u00be \u00ef\u00c0\u00e0\u00c8\u00e8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00e0\u00be :\u2014\n\n5.(1) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c6\u008a \u00c4\u00cd\u00e5 \u00cc\u00c3\u00e5 \u00db\u00cc\u00e0\u00d1\u00c4\u00a8 \u00bc\u00fb\u00a3\u00b4 \u00c0\u00e6\u0095\u00b8 \u00af\u00be\u00e0\u00bc\u00c6 \u00ef\u00bc\u00be \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00ba\u00eb\u00ef\u00be\u00be\u00e0 \u00ef\u00bc\u00a8\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea\u00c2\u00cd\u00ea\u00ba\u00c7 \u00af\u00be\u00e0\u00bc\u00ef\u00c6\u00be\u00e0 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c8\u00e8\u008d\u00ba \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8 \u00ef\u00be\u00e5\u00c9\u00be \u00d7\u00ba\u00e8 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00cc\u00e8\u00c6\u00f5 \u00a8\u00e5\u00c7\u00b8\u00e5\u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00c8 \u00cc\u00e7\u00bc\u00fb\u00c4 \u00be\u00f9\u00ba\u00f1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6 :\u2014\n\n(\u00a1) \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00c9\u00da\u00aa\u00fb\u00a8\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb, \u00a7\u00c9\u00ea\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4, \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4,\u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ba\u00e0\u00c9\u00ef\u00c6\u00be\u00e0 \u00ef\u00be\u00c7\u00c0\u00e9\u00c4 ;\n\n(\u00a1\u00e5) \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00b4 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0 \u00ef\u00ba\u00e5\u00e0\u00c7\u00e5 \u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4,\u00a6\u00cd\u00fa \u00c2\u00c8\u00ba\u00c8 \u00cc\u00cd \u00a8\u00e5\u00da\u00c6 ;\n\n(\u00a1\u00e6) \u00bd\u00ea\u00c7 \u00bc\u00c7\u00be\u00e0\u00be\u00be\u00e0 \u00ef\u00ba\u00e5\u00e0\u00c7\u00e5 \u00c0\u00ba\u00e0 \u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4, \u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00e0 \u00bd\u00ea\u00c7\u00a8\u00e5\u00c8\u00c6,\u00a2\u00c8\u00e0\u00c8\u00e5 \u00a1\u00cc\u00e0\u00d1\u00c4, \u00bd\u00ea\u00c7\u00c6 \u00cd\u00fa\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00bd\u00ea\u00c7\u00ef\u00c6\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00e0 \u00c2\u00c8\u00ba\u00c8 ;\n\n(\u00a1\u00e7) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0, \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00cd \u00ef\u00cc\u00e0\u00c9\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00a8\u00e5\u00da\u00c6 \u00cc\u00cd \u00a8\u00da\u00ba\u00c9\u00f1 ;\n\n\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00d7\u00ba\u00f8.\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c9\u00a8\u00eb\u00aa\u00b6\u00ea \u00c0\u00bc\u00be\u00c4 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a)18\n\n(\u00a2) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00db\u00cc\u00e0\u00d1\u008a \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00ef\u008a \u00bc\u00fb \u00cc\u00cd \u00db\u00cc\u00e0\u00d1\u008a \u00a8\u00e6\u00bf\u00d1\u00ef\u008a\u00bc\u00fb\u00a1\u00be\u00ea\u00aa\u00c4\u00be\u00c6 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00a8\u00e5\u00da\u00c6 \u00c0\u00e5\u0090\u00c0\u00e5\u0090\u00c6, \u00a6\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00aa\u00b8\u00c0\u00ec\u00da\u00b8\u00c6\u00cc\u00cd \u00a6\u00c9\u00e6\u00be\u00f8 \u00db\u00cc\u00e0\u00d1\u008a\u00c9\u00c8 \u00bc\u00fb \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00e5\u00c4 ;\n\n(\u00a3) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00a6\u00cd\u00fa \u00ef\u00bc\u00e0\u00c0\u00ce \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00c6 \u00cc\u00cd\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 ; \u00cc\u00cd\n\n(\u00a4) \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u008c \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00cc\u00cd \u00a6\u00cd\u00fa \u00a1\u00c7\u00c4\u00ea\u00b8\u00ea \u00a2\u00b4\u00ea\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00c4."
