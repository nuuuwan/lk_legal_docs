    "chunk_text": "\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00c4\u00ef\u00cc\u00e0 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n1.\u00ef\u008a \u00c0\u00be\u00ba 2005 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00cc\u00ea\u00be\u00e5\u0095 (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be)\u00c0\u00be\u00ba \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cd\u00df\u00be\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n\u00c0\u00ec\u00da\u0097\u00a8\u00e5\u00c9.\n\n2005 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00cc\u00ea\u00be\u00e5\u0095 (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba2\n\nI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n2.\u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 108 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8 \u00a8\u00eb\u00c4\u00a8\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9 \u00bc, 2004 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 26 \u00c9\u00be \u00bc\u00fa\u00be \u00c9\u00be \u0097\u00b4 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0\u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8 \u00c0\u00bc\u00fa\u00e2\u008e\u00c9 \u00cc\u00e8\u0090 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00a6\u00c4 \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00ef\u00c6\u00e0 \u00cc\u00e8\u0090 \u00c2\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00cd\u00c7\u00cd\u00e5 \u00aa\u00c4\u00be\u00e0 \u00a8\u00c7\u0095\u00be\u00e0 \u00cc\u00e8\u0090 \u00c2\u00c9\u00b4 \u00bc\u00e6\u00be\u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00c8\u00e6\u009f \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb,\u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00d5\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00ef\u00c6\u00e0 \u00be\u008a, \u00a7\u00cd\u00ea \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00cc\u00e5\u00c4\u00e5\u00be\u00f1\u00ef\u00c6\u00be\u00e0\u00bc\u00e6\u00be\u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00c8\u00e6\u00ef\u00c2\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00a6\u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c4\u00e5\u00cc \u00cd\u00c6\u00a8\u00e0 \u00ba\u00eb\u00ce \u00a7\u00cd\u00ea\u00ef\u00cc\u00e5\u00c6\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8\u00c9 \u00cc\u00e8\u0090\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00cc\u00cd \u00a7\u00cd\u00ea \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00bc\u00e6\u00be\u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8\u00c9 \u00cc\u00e8\u0090\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00cc\u00cd \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6\u00bc\u00cd\u00be\u00e0\u00d1\u00c4, \u00cc\u00ea\u00be\u00e5\u0095\u0097\u00c0\u00ba \u00be\u00f8\u00cc\u00e5 \u00cc\u00e8\u00f3 \u00c9\u00ec \u00c2\u00c9\u00b4 \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a7\u00cd\u00ea \u00d5\u00c9\u00ba\u00e0\u00c9 \u00cc\u00e8\u0090\u00be\u00c2\u00c9\u00b4 \u00a7\u00c0\u00e0\u00c0\u00ea \u00a8\u00f8\u00d7\u00ef\u008a \u00c3\u00e5\u00c7\u00c6 \u00a6\u00c6 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00c7\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c4\u00ba \u00c0\u00e6\u00c9\u00ef\u00da.\n\n3. (1) 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00c4\u00c7\u00b8 \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00c9\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00c8\u00ad\u00c4\u00b3\u00e5\u00ba\u00f8\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00c8\u00ad\u00c4 \u00b3\u00e5\u00ba\u00f8\u00c6\u00a8\u00eb \u00d5\u00c9\u00ba\u00e0\u00c9 \u00ef\u00be\u00e5\u00cc\u00e8\u0090\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8,\u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00bc\u00be\u00e0\u00be\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0, \u00ef\u00c4\u00cd\u00fa\u0095\u00be\u00e0\u00c4\u00ba\u00eb \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00c8\u00cc\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00b4 \u00a2\u00c8\u00e0\u00f5\u008a \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6."
