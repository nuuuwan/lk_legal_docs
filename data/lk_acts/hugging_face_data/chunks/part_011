    "chunk_text": "\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5\u00c0\u00e5\u00b5\u00c6 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00be\u00c9 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6\u00a8\u00c7\u00be\u00ba\u00eb\u00c7\u00e6 \u00bc\u00e6\u00be\u00b4\u00c0\u00c9\u00ba\u00f8\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00bc\u00fa\u00aa\u00b4\u00c4 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 25\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2005 \u00a1\u00e2\u00a8 20 \u00bc\u00c7\u00be \u00ef\u00ba\u00e0 \u00cc\u00cd \u00c7\u00c2\u00da \u00c9\u00ba\u00eb(\u00a8\u00e6\u00c2\u00c8\u00e8 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e5\u00c8\u00be) (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba8"
