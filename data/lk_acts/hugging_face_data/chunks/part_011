    "chunk_text": "\u201c\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0\u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00a8\u00e0\u00c8\u00c2\u00e5 \u00ef\u00be\u00e5\u00ef\u00aa\u00be\u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be\u00a1\u00e5\u00c6\u00ba\u00be\u00c9\u00c8\u00a1\u00e6\u00ba\u00e6\u008a\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00e6\u00c2\u00c8\u00e8\u00a8\u00f8\u00d7\u008a \u00cc\u00e6\u00ce\u00cc\u00ea\u008a\u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00f8\u00d7\u00c4\u00ba\u00cd\u00be\u008a \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00b423\u00a1 \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n2005 \u00a1\u00e2\u00a8 20 \u00bc\u00c7\u00be \u00ef\u00ba\u00e0 \u00cc\u00cd \u00c7\u00c2\u00da \u00c9\u00ba\u00eb(\u00a8\u00e6\u00c2\u00c8\u00e8 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e5\u00c8\u00be) (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba7\n\n(\u00a1)\u201c\u00ef\u00c2\u00f3\u008a \u00be\u00b6\u00ea\u00c9\u201d \u00c6\u00be \u00ef\u00c6\u00f3\u00ef\u00c4\u00cd\u00fa \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9\u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c \u201c\u00ef\u00c0\u00e5\u00c8\u00e0 \u00c9\u00ba\u00e0\u00ba\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c0\u00f2\u00c4\u00e5\u00b8\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00a8\u00e0\u00b4\u00c6\u00e5\u00da\u00cd\u00ba\u00c7\u00a8\u00b4 \u00a1\u00b6\u00ea \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, 1971 \u00a1\u00e2\u00a8 46 \u00bc\u00c7\u00be\u00ef\u00c0\u00e5\u00c8\u00e0 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00c9\u00ec\u00c9\u00ba\u00e0\u00ba\u00a8\u00e0 \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00c9\u00ba\u00e0\u00ba\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00c2\u00be \u00a2\u00b6\u008a \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00f8\u00be\u00e0 \u00c6\u00ea\u00ba\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00c9\u00ba\u00e0\u00ba\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0\u00ef\u008c ;\n\n\u201c\u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c6\u008a \u00c4\u00cd\u00be\u00aa\u00c7\u00cc\u00c3\u00e5\u00c9\u00a8\u00e0, \u00be\u00aa\u00c7 \u00cc\u00c3\u00e5\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00cc\u00c3\u00e5\u00c9\u00a8\u00e0\u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be \u00a1\u00ba\u00c7, \u00a6\u00c9\u00e6\u00be\u00f8 \u00c6\u008a \u00cc\u00c3\u00e5\u00c9\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cd\u00e5 \u00a2\u00b4\u00ea \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00c2\u00c8\u00ba\u00c8\u00c9\u00c8\u00b4, \u00a8\u00e5\u00da\u00c6\u00c6\u00be\u00e0\u00b4 \u00cd\u00e5 \u00a8\u00da\u00ba\u00c9\u00f1\u00c6\u00be\u00e0\u00b4\u00a1\u00be\u00ea\u00c7\u00e7\u00c0\u00e9 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cd\u00e5 \u00cc\u00c4\u00e5\u00be \u00c2\u00c8\u00ba\u00c8, \u00a8\u00e5\u00da\u00c6 \u00cd\u00e5\u00a8\u00da\u00ba\u00c9\u00f1 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00a2\u00b4\u00ea\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a\u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00a8\u00e5\u00b4 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00a8\u00e0 \u00bc \u00a3\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c.\u201d;\n\n(\u00a1\u00e5)\u201c\u00c7\u00c2\u00da \u00c9\u00ba\u00e0\u00ba\u201d \u00c6\u00be \u00ef\u00c6\u00f3\u00ef\u008a \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00ef\u00c6\u00cd\u00fa \u201c\u00ef\u00cd\u00a8\u00e0\u00b4\u00c6\u00e5\u00da\u00cd\u00ba\u00c8\u00e8\u00cd\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00ef\u00cd\u00a8\u00e0\u00b4\u00c6\u00e5\u00da \u0097\u00cc\u00e0\u00cc\u00a8\u00b4\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00cc\u00cd\n\n(\u00a1\u00e6)\u201c\u00ef\u00ba\u00e0 \u00c9\u00ba\u00e0\u00ba\u201d \u00c6\u00be \u00ef\u00c6\u00f3\u00ef\u008a \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00ef\u00c6\u00e0 \u201c\u00ef\u00cd\u00a8\u00e0\u00b4\u00c6\u00e5\u00da\u00cd\u00ba\u00c8\u00e8\u00cd\u00a8\u00b4\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00ef\u00cd\u00a8\u00e0\u00b4\u00c6\u00e5\u00da \u0097\u00cc\u00e0\u00cc\u00a8\u00b4\u201d\u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0.\n\n11.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7 \u00c6\u008a\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n12.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00b4\u00cd\u00e6\u00be\u00f8\u00c9 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00ef\u008a \u00c0\u00be\u00ba\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00d1\u00ef\u008a \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c4 \u00bd\u00ea\u00c7 \u00bc\u00c7\u00be \u00ef\u00ba\u00e0 \u00cc\u00cd \u00c7\u00c2\u00da \u00c9\u00ba\u00eb (\u00a8\u00e6\u00c2\u00c8\u00e8\u00a8\u00f8\u00d7\u00c4 \u00c0\u00e5\u00c8\u00be) \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0, \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 5 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u0093\u00ba \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 10 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00c7\u00be \u00ba\u00eb\u00c7\u00e6 \u00cc\u00cd \u00a6\u00ef\u00cc\u00e0\u00a8\u00c7\u00be\u00ba\u00eb\u00c7\u00e6 \u00c0\u00c4\u00b8\u00a8\u00e0, \u00a6\u00c4 \u00bd\u00ea\u00c7 \u00bc\u00e6\u00d7\u00c4 \u00bc\u00fa\u00aa\u00b4\u00c4 \u00cc\u00e8\u00f3 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5\u00c0\u00e5\u00b5\u00c6 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00be\u00c9 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00e0\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6\u00a8\u00c7\u00be\u00ba\u00eb\u00c7\u00e6 \u00bc\u00e6\u00be\u00b4\u00c0\u00c9\u00ba\u00f8\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00bc\u00fa\u00aa\u00b4\u00c4 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 25\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2005 \u00a1\u00e2\u00a8 20 \u00bc\u00c7\u00be \u00ef\u00ba\u00e0 \u00cc\u00cd \u00c7\u00c2\u00da \u00c9\u00ba\u00eb(\u00a8\u00e6\u00c2\u00c8\u00e8 \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e5\u00c8\u00be) (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba8"
  },
