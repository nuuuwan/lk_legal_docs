cd\u00c1\u00ce\u00be\u00bb\u00c7\u00e0\u00af\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00b9\u0088\u00bb\u00c7\u00b8\u00d7 \u00a3\u00ba\u00c6\u00ba\u00c7\u00b6\u00b6\u00c6\u00b6\u00c8\u0081\u00cd\u00b9\u00c7\u00d7 \u00a3\u00c1\u00bc\u00c6 \u00cd\u00c1\u00ce\u00be\u00cc\u00b1\u00bb\u00c6\u00d7\u00bf\u00c6\u00bf \u00b7\u00c7\u00b4\u00c6\u00af\u00bf\u00c8\u0081 \u00a9\u00ae\u00b5\u00c8\u00af\u00c6\u00ce\u00af\u008a\u0081 \u008c\u00af\u00c8\u00b6\u00c7\u00b1\u00c7\u00bc\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a4\u00b8\u00c7\u00be\u00c6 \u00a4\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1\u008c\u00b3\u00c6\u00d2\u00b6\u00df\u00ba\u00c6 \u00a4\u00af\u00c7\u00d7 ;\n\n(\u00a4)\u00b7\u00c7\u00bf\u00c7\u00b7\u00c6\u00b6 \u0096\u00b6\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00c1\u00c7\u00af\u00b9\u00c6 \u00cc\u00b9\u00de\u00ba\u00c6\u00cd\u00c1\u00ce\u00be\u00bb\u00c7\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c8\u0081 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\" \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00b9\u0088\u00bb\u00c7\u00b8\u00d7\" \u00a3\u00ba\u00c6\u00ba\u00c7\u00b6\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00c1\u00bc\u00c6 \u00cd\u00c1\u00ce\u00be\u00cc\u00b1\u00bb\u00c6\u00d7\u00bf\u00c6\u00bf \u00b7\u00c7\u00bf\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u0081\u00bd\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6 \u00b7\u00c7\u00bd\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\n\n\u00a4\u008a\u0081\" \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c7\u008a\u00d9\u00ba\u00c6 \u00ba\u00c7\u00b6\u00cc\u00ba\u00c7\u0081\u00de\u00af\u00c6\u00d0 \u00cc\u00b1\u00df\u00