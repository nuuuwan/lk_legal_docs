    "chunk_text": "(i)\u00b6\u00b7\u00c6\u00ce\u00b6\" \u00b6\u00c7\u00bb\u00c6\" \u00b9\u00c7\u00b4\u00c6\u00b4\u00b8\u00c7\u00bc\u00c6\" \u00b9\u00c7\u00b4\u00c6\u0088\"\u00ba\u00c7\u00bd\u00c6\u00bd\u00c7\u00b7\u00c6 \u00b6\u00b7\u00c6\u00ce\u00b6\" \u00ba\u00c7\u00bd\u00c6\u00bd\u00c7\u00b7\u00c6 \u00b6\u00c7\u00bb\u00c6 ;\n\n(ii) \u00ba\u00af\u0081\" \u00ba\u00af\u00bf\u00c6\" \u00cd\u00b9\u00bc\u0081\" \u00cd\u00b9\u00b6\u00c6\u00b6\u00c8\" \u00ba\u00c7\u00bd\u00c6\u00bd\u00c7\u00b7\u00c6\u00b6\u00c7\u008a\u0081 \u00ba\u00af\u0081\" \u00ba\u00c7\u00bd\u00c6\u00bd\u00c7\u00b7\u00c6 \u00b6\u00c7\u008a\u0081 \u00ba\u00af\u00bf\u00c6;\n\n(iii) \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u0081\" \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u00c8\" \u00ac\u0081\u00de\u008c\u00b4\u00c6\u00b4\u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u0081\" \u00ac\u0081\u00de\u008c\u00b4\u00c6\u00b4 \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u00c8\"\u00ba\u00c7\u00bd\u00c6\u00bd\u00c7\u00bf\u00c6 \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u0081\" \u00ba\u00c7\u00bd\u00c6\u00bd\u00c7\u00bf\u00c6 \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u00c8 ;\n\n(iv) \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c8\u0081 \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\" \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u00c8\u00af\u00bf\u00c6 ;\n\n(vi) \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c8\u0081 \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\" \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u00c8\u00af\u00bf\u00c8\u0081\u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00bf\u00c6 ;\n\n\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u0089\u00bc\u00b6\u00c8\u00c1\u00c7\u00b6\u00c8\u201d \u00a9\u0081\u00b9\u00d7\" \u00ac\u00dd \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00a3\u00be\u00c6\u00be\u00d7\u00ad\u00bc\u00c6 \u00a5\u00ce\u00b4\u00af\u00c6\u00af\u00c7\u00be\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\" \u00a9\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00a9\u00c1\u00c6\u008c\u00ce\u00bb\u00b9\u00c7\u00b8 \u00a4\u00e0\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af \u00b7\u00c7\u00b4\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7 \u00a3\u00c1\u00c6\u008c\u00ce\u00bb\u00b9\u00c7\u00b8 \u00a4\u00bf\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 - I(\u0089\u00bc\u00c8\u00e2 22)\n\n1\u00b0\u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u008a\u0081 XVI \u00a4\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\u00a3\u00b4+\u00c6\u00af\u00c8\u00dc\u00bf\u00c6\u00bf \u00a9\u00be\u00c6\u00be\u00c7\u00b6\u00c6 \u00b6\u00c1\u00de\u00af\u00e0\u00ba\u00c6\n\n2\u00b0\u00c1\u0081 \u00b9\u00bd\u00c8 - \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u008a\u0081 \u0089\u00bc\u00c8\u00e2 372\n\n3\u00b0\u00d0\u00bd\u00c6\u00bd \u00a3\u00b1\u00c6\u00d2\u00de\u00b6\u00c6\u00b6\u00be\u00c6 - \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1\u008a\u0081\u0089\u00bc\u00c8\u00e2 483\n\n4\u00b0\u00cd\u00ba\u00bd\u00c6\u00b9\u0088 \u00b6\u00c1\u00de\u00af\u00e0\u00bf\u00c6 \u00a9\u00b6\u00ce\u00b8\u00dc\u00ba\u00c6 \u00da\u00bc\u00c8\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 34 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00d0\u00d5\u00ba\u00c6\u00b9\u00c1\u0081\u00db\u00ce\u00bd\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c6 \u00b6\u00d5\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c617\n\n\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 - II(\u0089\u00bc\u00c8\u00e2 2(3) )\n\n\u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00ba\u00c6\n\n'''''''''''''''''''''''''''''''''''''\u00b7\u00c9\u00b6\u00c8\u00c1\u00c7\u0081 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\"\n\n'''''''''''''''''''\u00a9\u0081\u00d9\u00ba\u00c6 \u00db\u00af\u00c1\u00bc\u00c8\u00ce\u00bb\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b7\u00c6\u00b6 \u00a3\" \u00a4 \u00a9\u0081\u00b9\u00c1\u00bc\u00c6 \u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00bf\u00c8\u0081\u00cc\u00b9\u00bb\u00bc\u00c6\" \u008c\u00c1\u00bc\u00b5\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00db\u00af\u00c1\u00bc\u00c8 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00c1\u00bc\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8\u00b6\u00c6\u00d7\u00c1\u00b6\u00c6\u00b6\u0081\u00ce\u00ba\u008a\u00be\u00c6 \u00c1\u00c0\u00af\u00c6\u00d0\u00b6\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b7\u00c6\u00b6\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u0081\u00ce\u00ba\u00ce\u00bb\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00d5\u00af - \u00a7\u00b0\u00ba\u00c6\u00b0\u00b6\u00ba\u00d7 \u00b9\u00c7\u00d7\u00af\u00c7\u00c1\u00be\u00bc\u00c6 \u00f2\u00be\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c0\u00af\u00c6\u00d0 \u00b7\u00ae\u00b9\u00bc\u00c6 \u00f2\u00be\u00ba\u00c6 \u00b9\u00bc\u00c7\u00bb\u00ba\u00ce\u00b4\u00bb\u00c7\u00b6\u00a3\u00be\u00c6\u00be\u00d7 \u00b1\u00c8\u00b6\u00c6\u00b6\u00d2\u00c1\u00c7\u00b6\u00c9\u00b8\u00ba\u00c6 \u00a3\u00bd\u00c6\u00bd \u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00bf\u00c6 \u00cd\u00b6\u00c7\u00bd\u00c6\u00bd\u00c8\u00b8\u00c7\u00be\u00c6\" \u00a3\u00b6\u00c7\u00c1\u00d7'''''''''''''''''''''''''''''''''''''\u00a9\u0081\u00d9\u00ba\u00c6 \u00db\u00af\u00c1\u00bc\u00c8\u00ce\u00bb\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b7\u00c6\u00b6 \u00a3\u00c1\u00bc\u00d7 \u00c1\u00c0\u00af\u00c6\u00d0\u00b7\u00ae\u00b9\u00bc\u00c6 \u00a5\" \u00a6 \u00a9\u0081\u00b9\u00c1\u00bc\u00c6 \u00f2\u00be\u00ba\u00c6 \u00b9\u00bc\u00c7\u00bb\u00ba\u00ce\u00b4\u00bb\u00c7\u00b6\u00c1\u00bc\u00c6) '''''''''''''''''''''''''''''''''''''(\u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00bf\u00c6)\n\n\u00a9\u00b6\u00c8\u00bc\u00c7\u00af''''''''''''''''''''''''''''''''''''' \u00a9\u0081\u00d9\u00ba\u00c6 \u00db\u00af\u00c1\u00bc\u00c8\u00ce\u00bb\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b7\u00c6\u00b6 \u00af\" + \u00a9\u0081\u00b9\u00c1\u00bc\u00c6(\u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00a4\u00bf\u00c8\u0081 \u00cc\u00b9\u00bb\u00bc\u00c6\" \u008c\u00c1\u00bc\u00b5\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00db\u00af\u00c1\u00bc\u00c8) '''''''''''''''''\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0'''''''''''''''''''' (\u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00a4\u00bf\u00c6)\n\n20'''''''' \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 '''''''''''''''''''''\u00ba\u00c7\u00b6\u00ba\u00c6 ''''''''''''' \u00a4\u00b7\u00c6 \u00b7\u00c7\u00bf\u00c6\u00b0\n\n\u00cd\u00ba\u00cd\u00be \u00cc\u00b9\u00bb\u00bc\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00b4\u00c6\u00b4 \u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00bf\u00c8\u0081 (\u00a3\u00be\u00c6\u00be\u00d7 \u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u0081)(\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u008c\u00b4\u00bb\u00ba\u00c6 \u00a3\u00c1\u00c6\u00c1\u00c7\u00bd\u00c7\u008a\u0081 \u00cd\u00b1\u00bc\u00c6\u00af\u00c6\u00af\u00b0 \u00a3\u00c1\u00bc\u00d7 \u00b9\u00b6\u00c8\u00e2\u00cc\u00b9\u00bd\u00c6\u00bd \u00a3\u00bd\u00c6\u00cd\u00bd\u00c7\u00b5\u00c8\u00a5\" \u00a9\" \u00a9\u0081\u00b9\u00c1\u00bc\u00c6 \u00f2\u00be\u00ba\u00c6 \u00cd\u00b6\u00c7\u00bd\u00c6\u00de\u00ba\u00c6)\n\n\u0089\u00bc\u00c7\u00b6\u00c7\u00b8\u00d7 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00e7\u00de\u00af\u00c8\u00bd\u00d7 :-\n\n(\u00a5+\u00c6\u00d0 \u00c1\u00c0\u00af\u00c6\u00af\u00c8\u0081 \u00e9\u00c0\u00c6\u00b7\u00c8\u00ce\u00be\u00af\u00ce\u00bf\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00d5\u00af\u00b0)\u00a9\u0081\u00bd\u00c8\u00c1\u00c6\u00c1\u00c7\u00de \u00e7\u00bd\u00e2\u00ba\u00c6\u00a4\u00af\u00cd\u00c1\" \u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00bf\u00c6 (\u00a3\u00be\u00c6\u00be\u00d7 \u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00b4\u00c6\u00af\u00bf\u00c6) 20''''''' \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5''''''''''''''' \u00ba\u00c7\u00b6\u00ba\u00c6 '''''''''''''''' \u00a4\u00ba\u00c6 \u00b7\u00c7\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u0089\u00bc\u00b6\u00c8\u00c1\u00c7\u00b6\u00c8\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00af\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00de\u00af\u00c6\u00af\u00c7\u00af\u00cd\u00c1\u00ae\u0088 \u00b7\u00c8\u00bd\u00c6\u00af\u00c8\u0081\u00bd\u00c7\u00bc\u00c6\u00b0"
