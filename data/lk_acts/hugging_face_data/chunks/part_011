aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c6 \u00a4\u00af\u00c7\u00d7 \u00a9\u0081\u00b9\u00d7\u00b4\u0081\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00dd\u00ba\u00ba\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00c0\u00af\u00c6\u00af\u00c7\u00b8\u00d7\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a5\u00ce\u00b4\u00cd\u00bb\u00bd\u00c6\u00b9\u00c7\u00b4\u00c7\u00b8 \u00b9\u00bc\u00c8\u00af\u00c7\u00bc\u00ba\u00c6\u00c1\u00c0+\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00d7 \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00de\u00ba\u00c6 \u00a3\u00bf\u008c\u00be\u00c6 \u00ba\u00b4\u00c6\u00d5\u00ba\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6 \u00ac\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00aa\u00bd\u00c6\u00de\u00af\u00c6\u00af\u00c1\u00b8\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081 \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00c8\u00af\u00c6\u00af\u00e2\u00ba\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n(3) \u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb\u0083\u00b6\u00a7\u00b4\u0081\u00b9\u0088\u00af\u00c6\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00de\" \u00ba\u00b6\u00c6\u00b6\u00c8\u00bb\u0083\u00b6\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6\u00b6\u00c9\u00bc\u00c6\u00e2\u00af\u00c7\u00ae\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00af \u00ac\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00db\u00ce\u00bd\u008a\u00cd\u00be\u00c7 \u00a3\u00be\u00c6\u00be\u00d7\u00cd\u00c1\u00de\u00c1\u00c0\u00c8\u008a\u00cd\u00be\u00c7 \u00c1\u00ce\u00bc\u008c\u00be\u00af\u00c6\u00af\u00b5\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00