\u00bd\u00c8\u00bb\u008b\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b1\u00c8\u008c\u00be\u00c6 \u008c\u00ba\u00c7\u00b8\u00b9\u00c6 \u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u0081 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u0089\u00bd\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00b8\u00b1\u00b4\u00c6\u00b4\u008c\u00cd\u00bc\u00c7\u00b6\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c6\u00af\u00ce\u00bf \u00ac\u00d5\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 \u00b1\u00ba\u00c1\u00c7\u00bb\u00ba\u00c6\u00b0\n\n3\u00b01973 \u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00bc\u00c6 14 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00ab\u00af\u00c6\u00af\u00c8\u00bb \u00b7\u00c7\u00d5\u00af\u00bf\u00c8\u0081 \u00cc\u00b9\u00c7\u00d7\u00b1\u00c6\u00b1\u00ce\u00b9\u00bb\u00c7\u00be\u00c6 \u00aa\u00bd\u00c6\u00de \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\" \u00a5\u00bc\u00c7\u00b1\u00b6\u00b7\u00c6\u00b6\u00c8\u00bc \u00db\u00af\u00c1\u00bc\u00c6\u00af\u00bf\u00c6\u00a7\u00b4\u00c6\u00b9\u00b4 \u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1 \u00bc\u00c9\u00b6\u00c8\u008a\u00be\u00c6 \u00b9\u00c7\u00d7\u00af\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00b8\u00d0\u00bd\u00c6\u00bd+\u00c6\u00af\u00ce\u00bf\u00b6\u00c6 \u00b6\u00d5\u00b6\u00c6\u00b6\u00be\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b6\u00ae\u0088\u00b6\u00c6\u00b6\u00be\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00b1\u00ba\u00c1\u00c7\u00bb\u00ba\u00c6\u00b0\n\n4\u00b01979 \u00b6\u00c8\u00cc\u00b1\u00ba\u00c6\u00b9\u00bc\u00c6 17 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00ab\u00af\u00c6\u00af\u00c8\u00bb \u00b7\u00c7\u00d5\u00af\u00bf\u00c8\u0081 \u00cc\u00b9\u00c7\u00d7\u00b1\u00c6\u00b1\u00ce\u00b9\u00bb\u00c7\u00be\u00c6 \u00aa\u00bd\u00c6\u00de \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00b5\u00bb\u00af\u00c6 \u00ce\u00af\u00b6\u00c8\u00af\u00ce\u00bf\u00a9\u00d5\u00b6\u00c6\u00b6\u00df\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00b8 \u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1\u00b1\u00c6 \u00b1\u00ba\u00c1\u00c7\u00bb\u00ba\u00c6\u00b0\n\n5\u00b01980 \u00ba\u00c7\u00b1\u00c6\u00d2 3 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u008c\u00bb\u0081\u00b8\u00c7\u008c\u00be\u00c6 \u00aa\u00bd\u00c6\u00de \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a3\u00d6\u00b1\u00c6 \u00b1\u00af\u00c6\u00b6\u00c8\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c8\u0081 \u00a7\u00dd\u00b9\u00c6\u00b9\u0088 \u00bc\u00c9\u00b6\u00c8\u008a\u00be\u00c7\u00b8 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da\u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \u00b1\u00ba\u00c1\u00c7\u00bb\u00ba\u00c6\u00b0\n\n6\u00b01988 \u00cc\u00b9\u00b9\u00c6\u00da\u00dd\u00c1\u00bc\u00c8 24 \u00a4\u00b7\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u00bb\u008b\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b1\u00c8\u008c\u00be\u00c6 \u008c\u00ba\u00c7\u00b8\u00b9\u00c6 \u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u0081 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u0089\u00bd\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00b8 \u00b1\u00b4\u00c6\u00b4\u008c\u00cd\u00bc\u00c7\u00b6\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c6\u00af\u00ce\u00bf \u00ac\u00d5\u00af\u00c6\u00d0\u00b6\u00df\u00af\u00c6\u00af\u00c7\u00b8 \u00b1\u00ba\u00c1\u00c7\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00b7\u00c8\u00bc\u00b9\u00c6\u0089\u00bb\u00c7\u00af\u00c8\u00bb \u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1 \u00b1\u00c8\u008c\u00be\u00c6 \u008c\u00ba\u00c7\u00b8\u00b9\u00c6 \u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u0