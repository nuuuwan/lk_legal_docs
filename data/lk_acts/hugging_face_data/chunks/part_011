    "chunk_text": "\u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00aa\u00ba \u00ef\u00a8\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2,\u00be\u00f8\u00c6\u0095\u00ba \u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c4 \u00c9\u00ec \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb \u00a6\u00c6 \u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00ef\u00c6\u00be\u00e0\u00c4 \u00ef\u00cd\u00e5\u00e0\u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00a2\u00b4\u00ea\u00a8\u00c7 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00a2\u00ba\u00f8\u00d6\u00c9 \u00c0\u00c9\u00ba\u00f8\u00be \u00c6\u008a \u00ba\u00f9\u00be\u00e0\u00f3 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00e0 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa, \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c9\u00e5\u00cc\u00e8\u00c6\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c6\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9\u00c9\u00e5\u00da\u00ba\u00e5\u00aa\u00ba \u00ef\u00a8\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00ba\u00f9\u00be\u00e0\u00f3 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00cc\u00e8\u0097\u00c8\u00e0 \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00cc\u00e2\u00aa\u00f2\u00cd\u00ef\u00c6\u00e0\u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00f9\u00be\u00e0\u00f3 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ef\u008c \u00ef\u00c6\u00bc\u00d1\u00c4\u00b4\u00a1\u00bc\u00e5\u00ce \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00a8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c6\u00b4\u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ef\u008c \u00ef\u00c6\u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n35.\u00c0\u00bc \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a1\u00be\u00f1\u00e5\u00da\u00bb\u00c6\u00a8\u00e0 \u00a1\u00c9\u00ca\u00f1\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u0095\u00cc \u00ef\u008a\u00c0\u00be\u00ef\u00ba\u00e0\u2014\n\n\u201c \u00ef\u00c0\u00e5\u00f3 \u00a8\u00e5\u00c8 \u00cc\u00b4\u00cd\u00be\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c6\u008a \u00ef\u00ba\u00e5\u00e0\u00c7\u00e5\u00aa\u00ba\u00e0 \u00c4\u00e5\u00da\u00aa\u00c6\u00a8 \u00cc\u00e8\u00c6\u00f5\u00c4\u00c2\u00cc\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be \u00a8\u00e5\u00c8 \u00cc\u00b4\u00cd\u00be \u00a6\u00a8\u00e0 \u00cc\u00b4\u00cd\u00be\u00a8\u00f8\u00be\u00e0 \u00ef\u00c0\u00be\u00e0\u00be\u00ea\u008a\u00a8\u00c7\u00be \u00a8\u00e5\u00c8\u00cc\u00b4\u00cd\u00be\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00c8\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00a2\u00b6\u008a \u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be \u00a1\u00ba\u00c7, \u00a3\u00b4 \u00b0\u00c8\u00ef\u00c6\u00be\u00e0\u00c6\u00b4\u00c9\u00ec \u00a2\u00b6\u008a \u00bc, \u00be\u00f8\u00c9\u00e5\u00cc, \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8 \u00cc\u00cd \u00be\u00f8\u00c9\u00e5\u00cc\u00c9\u00c8 \u00cc\u00cd\u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e8\u00c9\u00c8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00bc \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c ; \u00cc\u00cd\n\n\u201c\u00c2\u00cc\u00e0\u00c7\u00bb\u00c6\u201d \u00c6\u00be\u00e0\u00be\u00b4 \u00ef\u00c4\u00e5\u00e0\u00b4\u00da \u00c0\u00f2\u00c9\u00e5\u00cd\u00be \u00c0\u00be\u00ef\u00ba\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00da\u00bb\u00c6\u00c4 \u00ba\u00e8\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\nVII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n1991 \u00a1\u00e2\u00a8 37 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00aa\u00c4\u00be\u00e5\u00aa\u00c4\u00be \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5 \u00c0\u00be\u00ba\u00b4\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\n\n36.(\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00cd\u00fa \u201c\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) 1991 \u00a1\u00e2\u00a8 37 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f8\u00a8 \u00aa\u00c4\u00be\u00e5\u00aa\u00c4\u00be \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0\u00cc\u00c3\u00e5 \u00c0\u00be\u00ef\u00ba\u00e0 \u00c0\u00ec\u00da\u0097\u00a8\u00e5\u00c9 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1) (\u00a1) \u00ef\u00d8\u00bc\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00e8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8\u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00be\u00c6.\n\n1991 \u00a1\u00e2\u00a8 37 \u00bc\u00c7\u00be\u00c0\u00be\u00ef\u00ba\u00e0 \u00c0\u00ec\u00da\u0097\u00a8\u00e5\u00c9\u00b4\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be.\n\n2005 \u00a1\u00e2\u00a8 27 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00aa\u00c4\u00be\u00e5\u00aa\u00c4\u00be \u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ba22\n\n\u201c(\u00a1) \u0097\u00bc\u00f1\u00e5\u00ba\u00e0\u00c4\u00a8\u00c9 \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00c0\u00e5\u00f3 \u00a8\u00e5\u00c8\u00cc\u00b4\u00cd\u00be\u00a8\u00e0 \u00c4\u00ba\u00a1\u00e6\u00ba\u00e0\u00ba \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00c4\u00aa\u00fb \u00a2\u00c8\u00e0\u00c8\u00e9\u008a \u00cc\u00c0\u00ea\u00c7\u00e5\u00c8\u00e9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00d1\u00be \u00c7\u00e5\u00b0\u00f1\u00c2\u00cc\u00e0 \u00ef\u00cc\u00e0\u00c9\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00c2\u00cc\u00e0 \u00ef\u00cc\u00e0\u00c9\u00c6\u00a8\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u201d;\n\n(2) \u00a6\u00cd\u00e8 (\u00a1\u00e6) \u00ef\u00af\u00e0\u00bc\u00ef\u00c6\u00e0 \u201c\u00c8\u00e5\u00c3 \u00ef\u00be\u00e5\u00c8\u00c2\u00be \u00aa\u00c4\u00be\u00e0 \u00c4\u00e5\u00da\u00aa\u201d \u00c6\u00be \u00c9\u00ae\u00be\u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c8\u00e5\u00c3 \u00ef\u00be\u00e5\u00c8\u00c2\u00be \u00aa\u00c4\u00be\u00e0 \u00c4\u00e5\u00da\u00aa \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00cd \u00aa\u00c4\u00be\u00e0 \u00c9\u00e5\u00c7\u201d \u00c6\u00be\u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(3) (\u00a1\u00e7) \u00ef\u00d8\u00bc\u00c6 \u00a2\u00c9\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00d8\u00bc\u00c6\u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(\u00a1\u00e7) \u00a6\u00c4 \u00ef\u00cc\u00c9\u00e5 \u00cc\u00c0\u00c6\u00be\u00e0\u00be\u00be\u00e0 \u00a1\u00ba\u00c7 \u00c6\u00cd\u00c0\u00ba\u00e0 \u00ba\u00c7\u00aa\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00a8\u00c7\u00a1\u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00cc\u00cd \u00c8\u00e5\u00c3 \u00ef\u00be\u00e5\u00c8\u00c2\u00be \u00ba\u00c7\u00ad\u00a8\u00e5\u00d7\u00ba\u00e0\u00c9\u00c6 \u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00c4\u201d;\n\n(4) (\u00a1\u00e7) \u00ef\u00d8\u00bc\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00ef\u00d8\u00bc\u00c6 \u00a6\u00a8\u00ba\u00eb\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(\u00a2) \u00c4\u00cd\u00b0\u00be\u00ba\u00e5\u00c9\u00b4 \u00c2\u00cc\u00e0\u00c9\u00c8\u00e8\u00be\u00e0 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5 \u00cc\u00cd\u00fa\u00ba \u00cc\u00cd \u00cc\u00e6\u00c0\u00c0\u00cd\u00cc\u00ea \u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00ef\u00cc\u00e0\u00c9\u00c6\u00a8\u00e0 \u00cc\u00c0\u00c6\u00be \u00c2\u00c9\u00b4 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5\u201d.\n\n37.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 18 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00a1\u00ba\u00c7 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00ef\u0089 :\u2014"
