    "chunk_text": "(\u00a4)\u00a3\u00b6\u00bd\u00c6\u00cc\u00af\u00b8 \u00a3\u00d9\u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u00d9\u00bf\u00c6\u00a5\u00c0\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00bd\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00af\u00c6\u00d0 \u00a9\u00b6\u00c8\u00bc\u00c7\u00af \u00cd\u00ba\u0081\u00db\u00ce\u00bd\u0094\u00b4\u00c6\u00d5\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00cd\u00ba\u0081\u00db\u00ce\u00bd\u0094\u00d5 \u00a9\u00d7\u00e2\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00af\u00c7\u00b6\u008c\u00b4\u00b6\u00c6\u00d7\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a5\u00c0\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00bd\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00af\u00c6\u00d0 \u00a9\u00b6\u00c8\u00bc\u00c7\u00af \u00a9\u00af\u00c6\u00af\u00c7\u00be\u00b9\u00c6 \u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0\u00bf\u00c6 \u00cd\u00ba\u0081\u00db\u00ce\u00bd\u0094\u00b4\u00c6\u00d5 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00cd\u00ba\u0081\u00db\u00ce\u00bd\u0094\u00cc\u00b4\u00c7\u0081\u00de\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00cd\u00ba\u00c7\" \u00a3\u00af\u00c6\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8 \u00db\u0088\u00e2\u00bd\u00c6\u00bd \u0089\u0081\u00b8\u00bc\u00c6\"\n\n\u00b9\u00bb\u00d9\u00af\u00c6\u00d0 \u00c1\u00dd\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 5 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00b9\u00b5\u00ba\u00c6\u00d7{\u00bb\u00c6\u00b6\u00c7\u00af\u00c6\u00af\u00be\u00c6 \u00b6\u00ce\u00b4\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c613\n\n14\u00b0 (1) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 13 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a5\u00c0\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00bd\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00b9\u00c7\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00cc\u00bf\u00c1\u00dd\u00ba\u00c6\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u0081 \u008c\u00ce\u00bf\u00c1\u00c7\u00af\u00b6\u00c6 \u00b6\u00ba\u00af\u00c6\u00d0 \u00a5\u00c0\u00b9\u00c6\u00da\u00aa\u00bd\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\u00cc\u00b6\u00b8\u00af\u00c6 \u00e7\u00de\u00af\u00c8\u0081\u00bd \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00a3\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00db\u00b9\u00c6\u00b9\u00d7 \u00b7\u00c7\u00b4\u00c6\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00cc\u00bb\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00bf\u00c6 \u00a5\u00c0\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00be\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00ce\u00bb \u00a4\u00af\u00c6\u00af\u00c8\u00bb\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00be\u00c7\u00ba\u00c6\u00b0\n\n(2) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a5\u00c0\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00bd\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00ce\u00bb \u00a4\u00af\u00c6\u00af\u00c8\u00bb\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00cc\u00ba\u00c7\u0081\u00de \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u008c\u00b4\u00b6\u00c6\u00d7\"\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c7\u00b8\u00d7 \u00a3\u00b6\u0081 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u008a\u0081 \u008c\u00ce\u00bf\u00c1\u00c7\u00af \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00af\u00c7\u00bc\u00dd\u00af\u00c6\u00d0 \u00a5\u00c0\u00b9\u00c6\u00da \u00aa\u00bd\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00af\u00c8\u00bd\u00cc\u00b6\u00b8\u00b6\u00c6 \u00b6\u00c8\u00dd\u00b9\u00c6\u00b6\u00c8\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u0081\u00cd\u00ba\u00be\u00c6\"\u00a5\u00c0\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b1\u00c7\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00e0\u00af\u00c6\u00d0\u00b7\u0082\u00b4\u00a6\u00d5 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u00b8\u00af\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00a4\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n15\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 13 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a4\u00b6\u00b8\u00ba\u00c6\u00a3\u00bc\u00d2\u00af\u00c6\u00d0 \u00a5\u00c0\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\u008c\u00b4\u00b6\u00c6\u00d7\" \u00a5\u00c0\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00be\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00ce\u00bb \u00a4\u00af\u00c6\u00d0\u00af\u00c8\u0081\u00bd \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c7\u00b8\u00d7\" \u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00a5\u00c0\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00b6\u00b8\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00af\u008c\u00dd\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00cc\u00af\u00b8\u00b9\u00c6 \u00cc\u00b9\u00de\u00b7\u00bc\u00c6 \u00ac\u00dd\u00c1\u00ce\u00bc \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n16\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00a5\u00b9\u00c6\u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00a9\u00e1\u00b6\u00c6\u00b6\u00c8\u00be\u00c7\u00b8\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de\u00c1\u00ce\u00af\u008a\u00be\u00c6 \u00b6\u00af\u00c1\u00be\u00c6\u00cc\u00c1\u00bf\u00c8\u008a\u00d5\u00b6\u00be\u00c6\u00ba\u00c9\u00d7 \u00d2\u00ba\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00bc\u00af\u00b1\u00c8\u00bb\u00ba\u00c6 \u00cd\u00b9\u00b5\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de\u00ba\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00c7\u00d5 \u00cd\u00b9\u00c7\u0081\u00bd \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00d5 \u00a9\u00d7 \u00a9\u00b9\u00c6\u00b9\u0088\u008a\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6\u00b9\u00bb\u00d9\u00bf\u00c6\u00bf\u00b8\u00c1\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00b6\u00bd\u00c6\u00af\u00c8\u00b5+\u00c6\u00af \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00a5\u00b9\u00c6\u00b9\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00b4\u0081 \u00a5\u00b5+\u00c6\u00af\u00c8 \u00ac\u00e1\u00d0\u00ba\u00c6\u00cd\u00b9\u00c7\u00d7\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00b6\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00af\u00c1\u008b\u0081 \u00cc\u00c1\u00bf\u00c8\u008c\u00d5\u00ce\u00af \u00a9\u00d7\u00e2\u00ba\u00c6\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00b4\u00c6\u0088\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00ba\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00c7\u00b4\u00c6\u0088\u0081 \u00ba\u00c9\u00de\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00bd\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00df\u00ba\u00c7\u00af\u00c7\u00d7\u00b0\n\n\u00b7\u0081\u00cd\u00b8\u00c7\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00af\u00c7\u00ae\u00b4 \u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00c6\u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c8\u0081\u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00bf\u00c6\u00b0\n\n\u00a5\u00c0\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00be\u00c6\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u0081\u00ba\u00c9\u00d7\u00cc\u00b9\u00de\u00b7\u00bc\u00c6 \u00ac\u00dd\u00c1\u00ce\u00bc\u00b7\u00c8\u00bb\u00ba\u00c8\u00b6\u00c6\u00b6\u00be\u00c6\u00b0\n\n\u00a5\u00bc\u00af\u00b1\u00c8\u00bb\u00ba\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00bb\u00af\u00b4\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00af\u00c1\u00b8\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00a9\u00d5\u00b6\u00c6\u00d7\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c7\u00ce\u00ba\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 5 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00b9\u00b5\u00ba\u00c6\u00d7{\u00bb\u00c6\u00b6\u00c7\u00af\u00c6\u00af\u00be\u00c6 \u00b6\u00ce\u00b4\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c614\n\n\u00b9\u00c7\u00af\u00ba\u00c6 III\n\n\u00cc\u00b9\u00c7\u00d7\n\n17\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00c9\u00c0\u00c7\u00b8 \u00b6\u00c1\u00de \u00ac\u0081\u00de\" 1979 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u008115 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d0\u00bd\u00c6\u00bd\u008c\u00bb\u00be\u00c6 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af \u00db\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4