    "chunk_text": "12\u00b0\u00e7\u00b4\u00c6\u00d5\u00af\u00c6\u00d0\u00d5\u00ba\u00c6\u00b9\u00b6\u00c6\u00d7\u00b4\u00d9\u00ba\u00c6 \u00b7\u00ae\u00b9\u00bc\u00c6\u00af\u00e0\u00b4\u00d9\u00ba\u00c7\u00b8 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00b7\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8\u00bf\u00e2 \u00b1\u00c7\u00b6\u00c6\u00b6\u00c8\u00bb\u00ba\u00bd\u00c6\u00bd\u00b6\u00c7\u00af\u00e2\u00ba\u00c6 \u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081 \u00b7\u00be\u00d9\u00af\u00c6\u00d0\u00ac\u00c1\u00c6\u00c1\u00c7\u00b6\u00b6\u00c7\u00af\u00e2\u00ba\u00c6 \u00a5\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u0081\u00bd\u00c8 \u00d2\u0096\u00af\u00c7\u00bc\u00b9\u00c6 \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00af\u00ce\u00bf\u00b9\u00c6 \u00cd\u00b9\u00d6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c7\u00b8\u00c1\u00c7\u00bb\u00c6\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00ce\u00bf \u0089\u00bf\u00c6\u00ce\u00bf\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00bf\u00ba\u00c6 \u00a4\u00e0\u00af\u00c6\u00d0 \u00c1\u00c0+\u00c6\u00af\u008c\u00dd\u00b9\u00c6\u00b9\u00db\u00bf\u00c6\u00bf\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u00af \u00a5\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n13\u00b0\u0089\u00bf\u00c6\u00ce\u00bf\u008a\u0081 \u008c\u00dd\u00b9\u00c6\u00b9+\u00c6\u00af\u00e0\u00bf\u00c6 \u00cd\u00b9\u00c7\u00b6\u00c8\u00bb\u00bf\u00e2 \u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n14\u00b0\u00d2\u0096\u00af\u00c7\u00bc \u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00da\u00af\u00c6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u0081 \u0089\u0081\u00b8\u00bc\u00c6 \u0089\u00bf\u00c6\u00ce\u00b