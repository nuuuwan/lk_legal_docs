    "chunk_text": "(5) \u00a3\u00bd\u0096\u00b4\u00c7\u00af\u00b1\u00c6 \u00cd\u00b1\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00bf\u00c8\u0081 \u008c\u00b9\u00bc+\u00c6\u00af\u00bf\u00c6\u00a9\u00be\u00c6\u00be\u00c7\u00c1\u00bd\u00c6\u00ce\u00bd\u00dc\u00ba\u00c6 \u008c\u00b6\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00db\u00ce\u00bd\u008a\u00be\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00bf\u00c6\u00bf\u00ba\u00c7\u00b6\u00c7\u00b7\u00c6\u00b6\u00af\u00c6 \u00e7\u00bd\u00c6\u00de \u00ac\u0081\u00de\" \u00a3\u00d5\u00b6\u00c6\u00d7\u00de\u00ba\u00c6 \u00ba\u00c7\u00b6\u00b6\u00c6\u00b6\u00c8\u0081 \u00b9\u00b6\u00c8\u00ce\u00b8\u00b7\u00c6\u00b6\u00c7\u00ba\u00c6\u00b7\u00c7\u00bf\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0 \u00db\u0081\u00b8\u00bc\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00cd\u00b1\u00ce\u00c1\u00c1\u00c0+\u00c6\u00d0\u00b7\u00bc\u00c8\u00b8\u00c7\u00df\u00ba\u00c6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00af\u00c6\u00d0 \u00a3\u00d9\u00b9\u00c6\u0089\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(7) \u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (5) \u00a4\u00ba\u00c6\" (6) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00e2\u00af\u00bf\u00c8\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf\u00ba\u00c9\u00de\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bd\u00c6\u00de\u00af\u00c6\u00d0 \u00a5\u00b5+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u00e1\u00af\u00b6\u00c6 \u00b6\u00c1\u00de\u00af\u00c8\u0081\u00bd\u00a4\u00bf\u00c6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd\u00c1\u00dd\u00ba\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00af\u00c6\u00d0\u00bd\u00c6\u00bd\u00c1\u00c7\u00bf\u00c8\u00bb\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(8) \u00b9\u00b5\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00a3\u00bd\u0096\u00d5 \u00a9\u0081\u00bd\u00c1\u00ce\u00af\u00bb\u00c7\u00af\u00b1\u00c6 \u00cd\u00b1\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00b5+\u00c6\u00af\u00bf\u00c6\" 23 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (1) \u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6 \u00b9\u00bb\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081\"\u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u0081 \u00c1\u00bc\u00e2\u00af\u00c6\u00af\u00c8\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00b9\u00b5+\u00c6\u00af\u00bf\u00c6 \u00a9\u00be\u00c6\u00be\u00c7\u00ba\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6\u00db\u00ce\u00bd\u008a\u00be\u00c6 \u00cc\u00b1\u00be\u00c1\u00c0\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\u2013\n\n(\u00a3)\u00a9\u00e1\u00b9\u00d7 \u0096\u00b6\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u008a\u00b8\u00b6\u00c7\u00b8 (70%) \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00de\" \u0089\u00bc\u00c8\u00e2 40 \u00a5\u0081 \u00af\u00c9\u00c0\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00be+\u00c6\u00ce\u00af\u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6 \u00b9\u00bb\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd \u00cd\u00ba\u00ba\u00c6\u00b9\u00c7\u00d5 \u00b9\u00b5\u00c8\u00bb\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b1\u00c6\u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 38 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6\u00b9\u00bb\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c622\n\n(\u00a4)\u00b9\u0081\u00b8\u00c8\u00bc\u00ae\u00d5 \u0096\u00b6\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u008a\u00b8\u00b6\u00c7\u00b8 (12%) \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00cc \u00bb\u00c7\u0081\u00de\" \u0089\u00bc\u00c8\u00e2 33 \u00a5\u0081 \u00af\u00c9\u00c0\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a5\u00be+\u00c6\u00ce\u00af \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6 \u00b9\u00bb\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cd\u00c4\u00c7\u00b4\u00c6\u00b4\u00be\u00c6\u00db\u00af\u00c7\u00ce\u00ba\u00b6\u00c6\u00d7\u00c1 \u00b7\u00c8\u00de\u00c1\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\n\n(\u00a5)\u00b9\u00b6\u00c8\u00b8\u00c7\u0081\u00d0 \u0096\u00b6\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u008a\u00b8\u00b6\u00c7\u00b8 (14%) \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00de \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00af\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a6)\u00b7\u00c7\u0081\u00d0 \u0096\u00b6\u00b6\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u008a\u00b8\u00b6\u00c7\u00b8 (4%) \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00de 42\u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a5\u00be+\u00c6\u00ce\u00af\u00b1\u00ba\u00c1\u00c7\u00bb\u00b9\u00c6 \u00b9\u00b5\u00c8\u00bb\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(9) \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00e2 (8) \u00a5\u00be\u00c6 \u00b6\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00db\u00ce\u00bd\u008a\u00be\u00c6 \u00a3\u00bd\u0096\u00d5 \u00a9\u0081\u00bd\u00c1\u00ce\u00af\u00bb\u00c7\u00af\u00b1\u00c6 \u00cd\u00b1\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00cc\u00b1\u00be\u00c1\u00c0\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00b5+\u00c6\u00af\u00bf\u00c6\"\u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6 \u00b9\u00bb\u00b5\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b9\u00bb\u00b5\u00ba\u00c6 \u00cd\u00ba\u00bd\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00cd\u00c1\u00c7\u00bc\u00c6\u008c\u00dd\u00ba\u00c6\u0089\u00c1\u00dd\u00ba\u00c6 \u00a5\u00b4\u00cc\u00ba\u00c7\u0081\u00bd\u00c7\u00af \u00a5\u00be+\u00c6\u00ce\u00af\u00ce\u00bb \u00cd\u00ba\u00ba\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6\u00b1\u00b7\u00c6\u00ce\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c6 \u00b1\u00ba\u00c6\u00b9\u00b7\u00c6\u00b6\u00ba\u00c7\u00b8 \u00cc\u00af\u00c7\u00d5\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00ce\u00bf\u00b1\u00c6 \u00cc\u00b1\u00bb\u00c6\u00dc\u00ba\u00c6\u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af \u00ba\u00b4\u00c6\u00d5\u00ba\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00b9\u00c7\u00af\u00ba\u00c6 II\n\n\u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c6 IV\n\n\u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6 \u00b9\u00bb\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00da\u00af\u00bf\u00c6\n\n25\u00b0 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc \u00b1\u00ce\u00b9\u00bb\u00c7\u00b8\u00d7\" 26 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 \u00b7\u00c8\u00bb\u00b6\u00c8\u00af\u00bf\u00c8\u00b8\u00c6\u00b9\u0088\"\u00cc\u00c1\u00bf\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00d2\u00bd\u00c6\u00de\u00be\u00c7\u00b9\u00c6 \u00b9\u00bb\u00b5\u00b6\u00c6\u00d7\u00ce\u00bd\u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u0089\u00df\u00ba\u00c6 \u00a3\u00b6\u0081\u00ba\u00c9\u00d7\u00ba\u00c6 \u00b7\u00c8\u00bb\u00c7\u00bb\u00c7\u00b6\u00c8\u00af\u00c6\u00af\u00b6\u00c6\u00ce\u00b6\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n26\u00b0 (1) \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c7\u00b8\u00c1\u00bc\u00c6\" \u00af\u00c7\u00be\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00af\u00c6 \u00af\u00c7\u00be\u00ba\u00c6\" \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u008a\u0081 \u008c\u00b6\u00b9\u00c6\u00da\u00ce\u00bc\u008a\u0081\u00ba\u00c9\u00d7\" \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00c8\u008a\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00f2\u00be\u00ba\u00c6 (\u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u00b8\u00c6\u00b8\u00bc\u00c6 \u201c\u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00da\u201d \u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\