    "chunk_text": "(ii)\u00a6\u00c4 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba \u00a1\u00b8\u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00b4 \u00bc \u00a6\u00c4\u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00cd\u00df\u00be\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00cc\u00e2\u00ef\u00a8\u00e0\u00ba\u00c6 ;\n\n(iii)\u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00cd\u00fa \u00a1\u00b8\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00aa\u00fa\u00b8\u00ea\u008a \u00a1\u00e2\u00a8\u00c6 ;\n\n(iv)\u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00cd\u00fa \u00a1\u00b8\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00c0\u00d6\u00bc\u00fa\u00a6\u00c6 \u00a8\u00c9\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00bc \u00c6\u00be \u00c9\u00aa ; \u00cc\u00cd\n\n(v)\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa \u00c4\u00aa\u00fa\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00c8 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8\u00ef\u00c9\u00be\u00ba\u00e0 \u00a8\u00c7\u00e6\u00b8\u00ea,\n\n\u00a1\u00b6\u00e2\u00aa\u00eb \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00c0\u00f2\u00ba\u00f8\u0094\u008a\u00c2\u00c6 \u00a1\u00e5\u00c0\u00cc\u00ea \u00a6\u00d1\u00ef\u008a \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0, \u00a6\u00c6 \u00a1\u00bc\u00e5\u00ce \u00c9\u00be \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u0097\u00bc\u00e0\u00c6\u00ea\u00ba\u00e0 \u00c4\u00e5\u00da\u00aa\u00ef\u00c6\u00be\u00e0\u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00a8\u00b4 \u00ef\u00aa\u00d1\u008a\u00ef\u00be\u00e5\u00a8\u00ce \u0097\u00b4\u00a8\u00f2\u00e8\u00c6\u00e5\u00c4\u00e5\u00da\u00aa\u00c6.\n\n2005 \u00a1\u00e2\u00a8 28 \u00bc\u00c7\u00be \u00ef\u00aa\u00d1\u00ef\u008a \u00cd\u00e5 \u00ef\u0089\u00c7\u00e6\u008a \u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00bc\u00e0\u00bd\u00ba\u00f8 \u00c0\u00be\u00ba40\n\n35.(1) 33 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00c9 \u0097\u00bc\u00e0\u00f1\u00ea\u00ba\u00e0\u00c4\u00e5\u00da\u00aa\u00ef\u00c6\u00be\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb, \u00a6\u00c4 \u00c0\u00f2\u00ba\u00f8\u0094\u008a\u00c2\u00c6\u00c4\u00ea\u00c8\u00e0 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00cd\u00fa \u00cc\u00ba\u00f1, \u00c0\u00ec\u00da\u00b8 \u00cd\u00e5 \u00be\u00f8\u00c9\u00e6\u00c7\u00bc\u00fa \u00c0\u00f2\u00ba\u00f8\u0094\u008a\u00c2\u00c6\u00a8\u00e0 \u00c2\u00c9\u00b4 \u00cc\u00cd \u00be\u00f8\u00c6\u0095\u00ba\u0097\u00bc\u00e0\u00f1\u00ea\u00ba\u00e0 \u00ef\u00aa\u00d1\u008a \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00cd\u00fa \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6\u00c4 \u00c2\u00c9\u00b4 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00c9\u00be\u00e0\u00ef\u00be\u00e0\u00c6. \u00a6\u00c6 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4, \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00c4 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u0097\u00bc\u00e0\u00f1\u00ea\u00ba\u00e0 \u00a8\u00f2\u00c4\u00c4\u00aa\u00fa\u00be\u00e0 \u00cc\u00e8\u00f3\u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0 \u00bc\u00c7\u00be\u00e0\u00be\u00b4 \u00cc\u00e8\u00f3\u00c9\u00be \u00c6\u008a \u00a1\u00c8\u00e5\u00c3\u00c6\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u00c2\u00e6\u00e2\u00a8\u00eb\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00b8\u00a8\u00c7\u00e6\u00c9 \u00cd\u00e5\u00be\u00f8\u00c0\u00ec\u00c7\u00b8\u00c6 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) 34 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00c9 \u00c0\u00f2\u00ba\u00f8\u0094\u008a\u00c2\u00c6\u00a1\u00e5\u00c0\u00cc\u00ea \u00a6\u00d1\u00ef\u008a \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb, \u00a6\u00c4 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6,\u00a6\u00c6 \u00a1\u00bc\u00e5\u00ce \u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00cd\u00fa \u00cc\u00ba\u00f1 \u00c0\u00e8\u00b4\u00c0\u00ba\u00a8\u00e0 \u00c2\u00c9\u00b4 \u00cc\u00cd\u00ba\u00f8\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00cc\u00cd \u00a6\u00c4\u00ef\u00ae\u00a8\u00e0\u00c0\u00ba \u00c4\u00ba\u00c4 \u00ef\u00aa\u00d1\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c4\u00ba \u00be\u00b6\u00ea \u00c0\u00c9\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0 \u00cc\u00e8\u00f3\u00c9\u00be \u00c6\u008a \u00a1\u00c8\u00e5\u00c3\u00c6\u00a8\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00a1\u00b8\u00a8\u00c7\u00e6\u00b4 \u00cd\u00e5\u00be\u00f8\u00c0\u00ec\u00c7\u00b8\u00c6\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00aa\u00a8\u00f9\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00d1\u008a \u00cc\u00cd\u00cd\u00e5\u00be\u00f8\u00c0\u00ec\u00c7\u00b8, \u00a1\u00bc\u00e5\u00ce \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba \u00a1\u00b8\u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00b4 \u00bc \u00a6\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c\u00c9\u00e5\u00cc\u00e8\u00c6\u00b4, \u00a6\u00c4 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00e0 \u00a1\u00b8\u00a8\u00c7\u00e6 \u00ef\u00c8\u00cc \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00a6\u00c4 \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00c9\u00e5\u00cc\u00e8\u00c6\u00b4, \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00b4 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c8\u00c2\u00e5\u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c6 \u00c3\u00e5\u00c7\u00f3\u00be\u00e0 \u00bd\u00e5\u00c7\u00a8\u00ef\u00aa\u00e0 \u00c9\u00e5\u00cc\u00e8\u00c6\u00b4 \u00cc\u00cd \u00a6\u00c4 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00cd\u00fa \u00c6\u008a\u00c0\u00ec\u00da\u00c9 \u00c0\u00e8\u00b4\u00cc\u00be\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00ef\u00aa\u00e0 \u00c9\u00e5\u00cc\u00e8\u00c6\u00b4 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00c9\u00c7 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00ba\u00f8\u00c2\u00ea\u00b8 \u00bc, \u00ef\u008a\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00e5\u00be\u00f8\u00c0\u00ec\u00da\u00b8 \u00c2\u00e6\u00bf\u00fb\u00c4\u00a8\u00e0 \u00a8\u00b6 \u00c9\u00ec\u0097\u00b4\u00a8, \u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00e0 \u00a1\u00b8 \u00c8\u00ba\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00a8\u00c7\u00e6\u00ef\u00aa\u00be\u00e0 \u00a6\u00c4 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ef\u00ba\u00e0 \u00a1\u00b8\u00a8\u00c7\u00e6\u00c2\u00c9\u00b4 \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e8\u00c6 \u00cd\u00fa\u0095\u00a8\u008a\u00c0\u00e7\u00c4 \u00a5\u00b0\u00ea\u00c9\u00c4 \u00a1\u00c6\u00a8\u00c7\u00aa\u00ba\u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7 \u00a6\u00e0 \u00c2\u00e6\u00e2\u00a8\u00eb\u00a8\u00c7\u00e6, \u00cc\u00cd\u00ba\u00f8\u00a8 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00cd\u00e5\u00be\u00f8\u00c0\u00ec\u00c7\u00b8 \u00c2\u00e6\u00bf\u00fb\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00c9\u00ec\u00c2\u00e6\u00e2\u00a8\u00eb\u00a8\u00c7\u00e6\u00b4 \u0097\u00c7\u00e6\u00bc\u00e0\u00bd\u00c9 \u00a2\u00cd\u00ba \u00a8\u00f9 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00cd\u00fa\u0095\u00a8\u008a \u00c0\u00e7\u00c4\u00b4 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n36.(1) (82 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u0097\u00be\u00f8\u00c4\u00c6 \u0094\u00c8\u00e0\u00c0\u00ba\u00e0 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 52\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (4) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u2014\n\n(\u00a1)33 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5\u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00a8\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 ;\n\n(\u00a1\u00e5)33 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u00c4\u00be\u00e0 \u00a1\u00be\u00ba\u00eb\u00c7\u00e6\u00c9 \u00ef\u00aa\u00d1\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00a8\u00b4,"
