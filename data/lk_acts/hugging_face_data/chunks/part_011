    "chunk_text": "2\u00b0\u0089\u00bc\u00c8\u00e2 26 \u00a5\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 (\u00a4) (i)\u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u201c\u00a4\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1\u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00ab\u00bb\u00c7\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00ab\u00ba\u00c6\u00b9\u00b6\u00c8\u00b8\u00c7\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n1\u00b0\u0089\u00bc\u00c8\u00e2 35 \u00a5\u0081 (2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u201c\u00ab\u00bb\u00c7\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\"\u201c\u00ab\u00bb\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6\u00a5\u00dd\u00b9\u00b6\u00c6\u00ce\u00b6\u00bb\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n1993 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u008112 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00af\u00ce\u00b4\u00b1\u00c8\u00bb\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 1980 \u00a4\u00ba\u00c6\u00a4\u00ae\u0088\u0081 27 \u00a4\u00ba\u00c6\u00a5\u00be\u00af\u00c6\u00af \u00ac\u00b9\u00c6\u00b9\u00ce\u00b8\u00b1\u00c6\u00b1\u00c7\u00b6\u00b8+\u00c6\u00af\u00bf\u00c6\" \u00a7\u00b9\u00c7\u00bb+\u00c6\u00af\u00bf\u00c6\" \u00ac\u00bf\u00b4\u00b6+\u00c6\u00af\u00bf\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n1996 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u00817 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00af\u00ce\u00b4\u00b1\u00c8\u00bb\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ba\u00d7\u00c1\u00bc\u00c8\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\u00b0(\u00a3\u00b6\u00c6\u00b0 52)\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 12 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5+\u00c6\u00af\u00bf\u00c8\u0081\u00a3\u00b6\u00c8\u00af\u00bc\u00c8\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c611\n\n\u00b7\u00c8\u00ce\u00bc I\n\n\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00b9\u00c6\u00da\n\n\u00b7\u00c8\u00ce\u00bc II\n\n\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6+\u00c6\u00af\u00bf\u00c6\n\n2\u00b0\u0089\u00bc\u00c8\u00e2 47 \u00a5\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u201c\u00ac\u00dd\u00a5\u00be\u00b4\u00c6\u00b1\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u00c1\u00ce\u00bc \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00ab\u00bb\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00ac\u00dd \u00a5\u00be\u00b4\u00c6\u00b1\u00b6\u00c6\u00d7 \u00a5\u00dd\u00b9\u00b6\u00c6\u00ce\u00b6\u00bb\u00c7\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n3\u00b0\u0089\u00bc\u00c8\u00e2 48 \u00a5\u00be\u00c6 \u201c\u00ab\u00b7\u00c6\u00d7 \u00a5\u00be\u00b4\u00c6\u00b1\u00ba\u00c6 \u00f4\u00b9\u00c7 \u00c1\u00ce\u00bc\u00b7\u00c9\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u00af\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\"\u201c\u00ab\u00bb\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00a4\u00de\u00a5\u00be\u00b4\u00c6\u00b1\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n4\u00b0\u0089\u00bc\u00c8\u00e2 50 \u00a5\u00be\u00c6 \u201c\u00b9\u00b6\u00c6\u00b6\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7 \u00c1\u00ce\u00bc \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb\u00b6\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a4\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00b9\u00b6\u00c8\u00ce\u00b8\u00bb\u00c7\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n1\u00b0\u0089\u00bc\u00c8\u00e2 10 \u00a5\u00be\u00c6 \u201c\u00b9\u00b6\u00c6\u00b6\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6\u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00a5\u00dd\u00b9\u00b6\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1\u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d\u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00b9\u00b6\u00c8\u00ce\u00b8\u00bb\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00ab\u00ba\u00c6\u00b9\u00b6\u00c8\u00b8\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n2\u00b0\u0089\u00bc\u00c8\u00e2 19\u00a3 \u00a9\u0081\u00b9\u00b6\u0081 (2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6\u201c\u00db\u00b9\u00c6\u00b9\u00b6\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6\u00ab\u00ba\u00c6\u00b9\u00b6\u00c8\u00b8\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00ab\u00ba\u00c6\u00b9\u00b6\u00c8\u00b8\u00c7\u008a\u00bc\u00ba\u00c6\u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00a5\u00bc\u00ae\u00d5 \u00a5\u00be\u00b4\u00c6\u00b1\u00b6\u00c6\u00d7 \u00ab\u00ba\u00c6\u00b9\u00b6\u00c8\u00b8\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00d7\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 