    "chunk_text": "(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce\u00c9\u00c8\u00cc\u00be\u00e0\u00ba\u00a8\u00c6, 2004 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 26 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 2005 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc26 \u00c9\u00be \u00bc\u00fa\u00be \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00a8\u00e5\u00c8\u00c6 \u00ba\u00eb\u00ce \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u008a \u00ef\u00cd\u00e0\u00ba\u00eb\u00c9 \u00be\u00f8\u00cc\u00e5\u00c4 \u00c0\u00c4\u00b8\u00a8\u00e0, (1) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ef\u00ce\u00cd\u00fa \u00cc\u00be\u00e0\u00ba\u00a8\u00c6\u00b4\u00c2\u00e5\u00bd\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec\u00c9\u00e5 \u00ef\u00cc\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nIV \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00c0\u00f2\u00e5\u00bb\u0095\u00a8 \u00a1\u0093\u00a8\u00c7\u00b8 \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00c0\u00be\u00ef\u00ba\u00e0 66 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00a1\u00e6\u00ba\u00f8 \u00be\u00b6\u00ea\n\n30.(1) 2004 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 26 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 2005 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da\u00c4\u00cc 26 \u00c9\u00be \u00bc\u00fa\u00be \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00ba\u00eb\u00ce \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 1979\u00a1\u00e2\u00a8 44 \u00bc\u00c7\u00be \u00c0\u00f2\u00e5\u00bb\u0095\u00a8 \u00a1\u0093\u00a8\u00c7\u00b8 \u00be\u00b6\u00ea \u0097\u00bd\u00e5\u00be \u00c0\u00be\u00ef\u00ba\u00e0 66 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00ea\u00be\u00e5\u0095 \u0097\u00c0\u00ba\u00f8\u00be\u00e0 \u00cd\u00e5\u00be\u00f8\u00c6\u00b4 \u00c0\u00ba\u00e0 \u00c0\u00f2\u00ef\u00bc\u00e0\u00ca\u00c6\u00a8 \u00c0\u00e8\u00cd\u00fa\u0090 \u00a2\u00b6\u00c4\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00ef\u00aa\u00e5\u00be\u00ea \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2, \u00a2\u00b6\u00ef\u008a \u00cc\u00be\u00e0\u00ba\u00a8\u00c6 \u00cd\u00fa\u0095\u0097\u00c6 \u00c6\u00ea\u00ba\u00e0\u00ef\u00ba\u00e0 \u00a8\u00c9\u00c7\n\n\u00cc\u00ea\u00be\u00e5\u0095 \u0097\u00c0\u00ba\u00f8\u00be\u00e0\u00cd\u00e5\u00be\u00f8\u00c6\u00b4 \u00c0\u00ba\u00e0 \u00a2\u00b6\u008a\u00c9\u00c8\u00cc\u00be\u00e0\u00ba\u00a8\u00c6.\n\n2005 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00cc\u00ea\u00be\u00e5\u0095 (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba16\n\n\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00bc \u00c6\u00be\u00e0\u00be \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u0097\u00c3\u00e5\u00aa\u00c6\u00a8\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4 \u00c0\u00be\u00ef\u00ba\u00e0 68 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00b4\u00cd\u00e6\u00be\u00f8\u00c9 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9 \u00bc, 2004 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 26\u00c9\u00be \u00bc\u00fa\u00be \u00a2\u00b6\u00ef\u008a \u00cc\u00be\u00e0\u00ba\u00a8\u00c6 \u00bc\u00c7\u0095\u00be\u00e0 \u00cc\u00e8\u0090 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u0095\u00c6\u00ef\u00aa\u00e5\u00cc\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6\u00bc\u00cd\u00be\u00e0 \u00d1 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00cc\u00c4\u00aa\u00a6\u00c4 \u00a2\u00b6\u00ef\u008a \u00cc\u00be\u00e0\u00ba\u00a8\u00c6 \u00bc\u00c7\u0095\u00be\u00e0 \u00cc\u00e8\u0090 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00a6\u00c4\u00a2\u00b6\u00ef\u008a \u00cc\u00be\u00e0\u00ba\u00a8\u00c6 \u00bc\u00c7\u0095\u00be\u00e0 \u00cc\u00e8\u0090 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 \u00a6\u00c4 \u00a2\u00b6\u00ef\u008a \u00cc\u00be\u00e0\u00ba\u00a8\u00c6 \u00bc\u00e6\u00d7\u00c4\u00b4 \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00cd\u00fa\u0095\u00a8\u008a \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00b3\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00a2\u00b6\u00c4\u00a8 \u00cc\u00be\u00e0\u00ba\u00a8\u00c6 \u00bc\u00c7\u0095\u00be\u00e0\u00cc\u00e8\u0090 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0, \u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a6\u00c4\u00a2\u00b6\u00ef\u008a \u00cc\u00be\u00e0\u00ba\u00a8\u00c6 \u00bc\u00c7\u0095\u00be\u00e0 \u00cc\u00e8\u0090 \u00c2\u00c9\u00b4 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00c2\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 2004 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 26 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00c4\u00e5\u00cc\u00ef\u00bc\u00a8\u00a8 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00c2\u00c8\u00cd\u00ba\u00e0\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00cc\u00be\u00e0\u00ba\u00a8\u00ef\u00c6\u00be\u00e0 \u00ef\u00be\u00c7\u00c0\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00ef\u00cc\u00e0 \u00cc\u00be\u00e0\u00ba\u00a8\u00ef\u00c6\u00be\u00e0\u00ef\u00be\u00c7\u00c0\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00a6\u00c4 \u00a2\u00b6\u00ef\u008a \u00cc\u00be\u00e0\u00ba\u00a8\u00c6\u00be\u00e6\u00c9\u00ba \u00c8\u00c2\u00e5\u00ef\u00bc\u00be \u00ef\u00c8\u00cc \u0097\u00be\u00f8\u00ca\u00e0\u00ae\u00c6\u00a8\u00e5\u00c7\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u0097\u00bd\u00e5\u00be \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00c7 \u00be\u00f8\u00cc\u00e8 \u00a1\u0093\u00a8\u00c7\u00b8 \u00c2\u00c8\u00c6 \u00a1\u00e6\u00ba\u00f8 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00a8 \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00f9\u00be\u00e0\u00f3\u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8 \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u0095\u00cc, \u00a6\u00c4 \u00cc\u00be\u00e0\u00ba\u00a8\u00c6\u00b4 \u00c2\u00e5\u00bd\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00ba\u00cd\u00be\u008a\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nV \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00c0\u00d6\u00ca\u00f2\u00c9\u00c8 \u00a8\u00ed\u00c8\u00e9 \u00be\u00f8\u00c9\u00e6\u00cc\u00e8\u00c6\u00be\u00e0"
