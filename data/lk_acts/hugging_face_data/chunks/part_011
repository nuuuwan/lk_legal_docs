    "chunk_text": "(ii) \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00a8\u00eb \u00ef\u00c8\u00cc\u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8 \u00cd\u00c9\u00ea\u00c8\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c8\u00cc \u00ef\u00c9\u00be\u00ba\u00e0\u00ef\u00ef\u00be\u00ba\u00e8\u00a8 \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00be\u00e0 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00c9 \u00a6\u00e0 \u00cd\u00e5 \u00cc\u00c4\u00e5\u00be\u00ba\u00c7\u00e5\u00ba\u00f8\u00c7\u00c4\u00a8\u00f8\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a6\u00ef\u00cc\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00c7\u00bc\u00fb\u00c4;\n\n2006 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00ca\u00eb\u00bc\u00e0\u009e\u00a8\u00c7\u00b8\u00c6\u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00ef\u008a \u00c0\u00be\u00ba21\n\n(iv) \u00c6\u008a \u00c0\u00f2\u00a8\u00e5\u00ca\u00fa\u00ba \u00c3\u00e5\u00c7\u00c6\u00a8 \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6 \u00ef\u00c8\u00cc \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a6\u00ef\u00cc\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8\u00a8\u00c7 \u00bc\u00fb\u00c4;\n\n(v) \u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00be\u00e5\u0095\u00a8\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c8\u00cc \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00a6\u00ef\u00cc\u00e0\u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c6\u00c8 \u00a8\u00c7 \u00bc\u00fb\u00c4;\n\n(\u0081) \u201c\u00a1\u00a8\u00e0\u00ef\u00c9\u00c7\u00ce\u201d \u00c6\u00be\u00e0\u00be\u00b4 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c8\u00e8\u008d\u00ba \u00be\u00e9\u00ba\u00f8\u00c9\u00c8 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00a1\u00a8\u00e0\u00ef\u00c9\u00c7\u00ce \u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00c6\u00a8\u00f8\u00d7\u00c4;\n\n(\u00a8) \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u00e5\u00da\u00bb\u00fc\u00a8\u00ef\u00c6\u00e0 \u00c6\u00cd\u00c0\u00ba \u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00ef\u00aa\u00be \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00c8 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7;\n\n\u201c\u00c4\u00ea\u00c8\u00f1 \u00c2\u00ea\u00bc\u00e0\u0093 \u00a6\u00e0\u00a8\u00a8\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 2006 \u00a1\u00e2\u00a8 6 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c9\u00e5\u00da\u00ba\u00e5 \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00be\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba\u00c4\u00ea\u00c8\u00f1 \u00c2\u00ea\u00bc\u00e0\u0093 \u00a6\u00e0\u00a8\u00a8\u00c6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00c4\u00ea\u00c8\u00f1 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u201d \u00c6\u00be\u00e0\u00be\u00b4 \u00ef\u00c4\u00cd\u00fa \u00c0\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00cd\u00e5\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00e5\u00c7\u00a8\u008a \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c:\u2014\n\n(\u00a1) \u00c4\u00cd\u00b0\u00be\u00c6\u00e5\u00ef\u00aa\u00e0 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0\u00c3\u00e5\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9, 1988 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb \u00c0\u00be\u00ef\u00ba\u00e0\u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00c6 \u00a8\u00c7 \u00ba\u00f8\u00ef\u00c2\u00be \u00c2\u00e6\u00e2\u00a8\u00eb \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb;\n\n(\u00a1\u00e5) (\u00a1\u00bc\u00e5\u00ce \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00e5 1988 \u00a1\u00e2\u00a8 78 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u00cc\u00c4\u00e5\u00aa\u008a\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2 \u00c8\u00e6\u00c2 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00d1 \u00ba\u00f8\u00ef\u0089\u00bc\u00c6\u00be\u00e0\u00be \u00ef\u00be\u00e5\u00ba\u00a8\u00e5) \u00a6\u00c4 \u00c0\u00be\u00ef\u00ba\u00e0 \u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00c6 \u00a8\u00c7\u00ba\u00f8\u00ef\u00c2\u00be \u00c0\u00d6\u00bc\u00fa \u00c9\u00ec \u00c4\u00ea\u00c8\u00f1 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7;\n\n(\u00a1\u00e6) \u00c0\u00e5\u00d6\u00ef\u00c3\u00e5\u00e0\u00aa\u00fa\u00a8 \u00b8\u00c6, \u00a4\u00a8\u00cc\u00e0 \u00b8\u00c6, ( \u00c9\u00aa\u00a8\u00f9\u008a \u00cc\u00cd\u00fa\u00ba\u00c9 \u00ef\u00cd\u00e5\u00e0\u00c7\u00cd\u00fa\u00ba) \u00ef\u00c9\u00ce\u00bf \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00ba\u00e0\u00c9\u00c6 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00b8\u00c6\u00bc\u00fb\u00c4 \u00cc\u00cd\u00c9\u00e5\u00b8\u00e8\u00b0 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c4\u00ea\u00c8\u00f1\u00a8\u00c7\u00b8\u00c6;\n\n(\u00a1\u00e7) \u00c0\u00e5\u00d6\u00ef\u00c3\u00e5\u00e0\u00aa\u00fa\u00a8 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00cd\u00e6\u00c7 \u00c4\u00ea\u00c8\u00f1\u00a8\u00c8\u00e0\u00c2\u00f3\u00a8\u00c7\u00b8\u00c6;\n\n(\u00a2) \u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00aa\u00c6 \u00c0\u00e6\u00c9\u00d7\u00c4;\n\n2006 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u00ca\u00eb\u00bc\u00e0\u009e\u00a8\u00c7\u00b8\u00c6\u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00ef\u008a \u00c0\u00be\u00ba22\n\n(\u00a3) \u00c4\u00ea\u00bc\u00c8\u00e0 \u00cd\u00e5 \u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00e5\u00c7\u00e6\u00a8\u00f8\u00d7\u008a \u00ef\u00cc\u00e0\u00c9\u00e5;\n\n(\u00a4) \u00ef\u00aa\u00d1\u008a \u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00f2\u00ef\u00c4\u00e5\u00e0\u00c0\u00e5\u00c6 \u00a6\u00be\u008a \u00ef\u00a8\u00f2\u0091 \u00a8\u00e5\u0086 (\u00b8\u00c6\u00c0\u00ba\u00e0), \u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00e0 (\u00b4\u00f2\u00e6\u00c9\u00c8\u00da\u00cc\u00e0 \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00e0), \u00c4\u00ea\u00bc\u00c8\u00e0\u00a1\u00e6\u00b8\u00c9\u00ea\u008a \u00cd\u00e5 \u00c2\u00e6\u00e2\u00a8\u00eb \u00a1\u00b8\u00a8\u00c7 \u00cd\u00e5 \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0\u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6;\n\n(\u00a4\u00f0) \u00c0\u00e5\u00d6\u00ef\u00c3\u00e5\u00e0\u00aa\u00fa\u00a8 \u00b8\u00c6, \u00c9\u00aa\u00a8\u00f9\u00c4 \u00cc\u00cd\u00fa\u00ba\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00cd\u00fa\u00ba\u00c9 \u00ef\u00c9\u00ef\u00ce\u00bf\u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00ba\u00e0\u00c9\u00c6 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00a6\u00ef\u00cd\u00ba\u00e0 \u00a6\u00c6\u00b4 \u00cc\u00e9\u00c4\u00e5 \u00ef\u00be\u00e5\u00d1 \u00c4\u00ea\u00c8\u00f1\u00a1\u00e6\u00c0\u00a8\u00c7 \u00cc\u00cd \u00ef\u00c0\u00e5\u00ef\u00c7\u00e5\u00be\u00e0\u00f3 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00bd\u00be\u00bc\u00b8\u00e0\u00b6\u00be\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00c9 \u00c4\u00ea\u00c8\u00f1 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c4\u00ea\u00c8\u00f1\u00a8\u00c7\u00b8\u00c6;"
