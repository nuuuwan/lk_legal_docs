    "chunk_text": "(2) \u00b1\u00ce\u00b9\u008a\u0081 \u00cd\u00c1\u00ae\u00d5\u00cd\u00af\u00c7\u00bf\u00c8\u0081\u00cd\u00b9\u00bc\u00c8\u00be\u00c6 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af\u00a3\u00df\u00c1\u00be\u00bc\u00c6\" \u00a3\u00c1\u00c6\u00c1\u00df\u00c1\u00be\u00bc\u00c8\u0081 \u00b1\u00ba\u00c6\u00ba\u00b6\u00b6\u00c6\u00d7\u00b4\u00d9\u00ba\u00c6 \u00cc\u00b9\u00c7\u00d7 \u00b7\u00c8\u00dd\u00c1\u00c7\u00af\u00ba\u00c6\u00a9\u0081\u00d9\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b9\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00b9\u00c7\u00b8 \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c8\u0081 \u00a3\u00ce\u00ba\u00b1\u00c6\u00d2\u00af\u00c6\u00af\u00c7\u00b8 \u00cc\u00b1\u00bb\u00be\u00c7\u00bf\u00bc\u00c8\u0081 \u00b1\u00ba\u00c6\u00ba\u00b6\u00b6\u00c6\u00d7\u00b4\u00d9\u00ba\u00c6 \u00b1\u00ce\u00b9\u008a\u00b8\u00c7\u00be\u00c6 \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u0088\u00bb\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0 \u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081\u00b9\u00b5\u00c8\u00bb\u00c7\u00b4\u00c6\u00cc\u00b4\u00c7\u00d0\u00b6\u00c8\u00af\u00c6\u00d0 \u00a3\u00cd\u00b6\u00cd\u00b9\u00c7\u0081\u00bd \u00b1\u00ba\u00c6\u00ba\u00b6\u00b6\u00c6\u00d7\u00b4\u0081 \u00b6\u00bd\u00c6\u00af\u00c7\u008b\u00af\u00ba\u00c7\u00af \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00cd\u00b6 \u00cd\u00b9\u00c7\u0081\u00bd \u00b1\u00ba\u00c6\u00ba\u00b6\u00b6\u00c6\u00d7\u00b4\u0081\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00b5\u00c8\u00bb\u00c7\u00b4\u00c6\u00cc\u00b4\u00c7\u00d0\u00b6\u00c8\u00af\u00c6\u00d0 \u00b7\u00c8\u00bc\u00b7\u00c6\u00b6\u00bc\u00ba\u00c7\u00af \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n(4) \u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00b9\u00b5\u00c8\u00bb\u00c7\u00b4\u00c6\u00cc\u00b4\u00c7\u00d0\u00b6\u00c8\u00af\u00c6\u00d0 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00a3\u00df\u00c1\u00be\u00cc\u00bc\u00c1\u00dd\u00ba\u00c6 \u00b7\u00c8\u00bc\u00b7\u00c6\u00b6\u00bc\u00ba\u00c7\u00af \u00b7\u00c8\u00bb\u00ba\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" 1991 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u008137 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b6\u00b1\u00c8\u00bb \u00cd\u00b9\u00c7\u00af\u00c6\u00d0\u00c1\u00bc\u00b6\u00c6\u00d7 \u00a4\u00ce\u00b5\u00af\u00c6\u00d0\u00e1\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u008114 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081 (3) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\" \u00aa\u00bd\u00c6\u00bd\u00ba\u00c7\u00bd\u00c6\u00bd+\u00c6\u00af\u00e0\u00b4\u0081 \u00a3\u00c1\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00a3\u00c1\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00df\u00ba\u00c6 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00d0\u00bd\u00c8\u00b6\u00c6\u00b6 \u00b1\u00c8\u00be\u00ac\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6+\u00c6\u00af\u00bf\u00c8\u0081\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00af\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8\u00cd\u00b1\u00ce\u00c1\u00bb\u00c7\u00b8\u00d7\u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8\u00cd\u00b1\u00ce\u00c1\u00bb\u00c7\u00af\u00af\u00c6\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 19 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00cc\u00b1\u00bf\u00ba\u00c8\u00bb\u00f2\u00bc\u00c6\u00b6\u00c6\u00b6\u00c8\u00cc\u00b6\u00c7\u00ae\u00b4\u00ba\u00c7\u0081 \u00b3\u00c7\u00b9\u00af\u00c7\u00bc\u00c6\u00b6\u00c6\u00b6 \u00ba\u0081\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c69\n\n\u00a3\u00ce\u00b1\u00c1\u00bd\u00c6\u00bd \u00a3\u00bc\u00b1\u00af\u00c7\u00b5\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00af\u00c6\u00af\u00c8\u00ce\u00b4\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb\u00b6\u00c7\u00af\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0\n\n9\u00b0 \u00a3\u00bc\u00b1\u00c8\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a3\u00ce\u00b1\u00c1\u00bd\u00c6\u00bd \u00a4\u00b6\u00b8\u00ba\u00c6 \u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00b6\u00b8\u00ba\u00c6 (454 \u00a4\u00ba\u00c6\u00a3\u00b6\u00c6\u00b6\u00c8\u00bb\u00c7\u00bb\u00ba\u00c7\u00b8) \u00db\u0088\u00af\u00c6\u00d0\u00bc\u00c8\u00bb \u00af\u00c7\u00b5\u00c8\u00af\u00bf\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00816 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a9\u00b7\u00c6\u00b6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af \u008c\u00cd\u00b1\u00b4 \u00ba\u00c7\u00b8\u00c8\u00bb\u00af\u00c6\u00cc\u00af\u00c7\u00ce\u00b4\u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00b6\u00c6\u00b6\u00ce\u00af \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00af\u00c6\u00e7\u00d5\u00cd\u00ba\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00ba\u00c6 \u00ac\u0081\u00bd\u00c7\u00af\u00af\u00c6\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a3\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00b6\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u008c\u00cd\u00b1\u00b4\u00ba\u00c7\u00b8\u00c8\u00bb\u00af\u00c6\u00cc\u00af\u00c7\u00ce\u00b4 \u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00b6\u00c6\u00b6\u00ce\u00af \u00ac\u0081\u00bd\u00c8\u00bd\u00c6\u00d0 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00b9\u00c7\u00af\u00ba\u00c6 II\n\n\u00b7\u00c8\u00b6\u00c8\n\n10\u00b0 (1) \u201c\u00cc\u00b1\u00bf\u00ba\u00c8\u00bb\u00f2\u00bc\u00c6\u00b6\u00c6\u00b6\u00c8 \u00cc\u00b6\u00c7\u00ae\u00b4\u00ba\u00c7\u0081 \u00b3\u00c7\u00b9\u00af\u00c7\u00bc\u00c6\u00b6\u00c6\u00b6 \u00ba\u0081\u00bd\u00b7\u00c8\u00b6\u00c8\u00bb\u00ba\u00c6 \u201d \u00a9\u00b8 \u00a3\u00ce\u00c0\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b7\u00c8\u00b6\u00c8\u00bb\u00ba\u00c6 \u00ac\u0081\u00de \u00b6\u00c7\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 (\u00a5\u00d7 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a5\u00b6\u00b8\u00af\u00b6\u00c6\u00d7\u00b9\u00c6\u0089\u0081\u00b8\u00bc\u00c6 \u201c\u00b7\u00c8\u00b6\u00c8\u00bb\u00ba\u00c6\u201d\u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6)\u00b0\n\n(2) \u00aa\u00bd\u00c6\u00af\u00b8\u00cd\u00c1 \u00cc\u00b1\u00be\u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00e1\u00b9\u00b6\u00c6\u00b6\u00c8\u00cc\u00bc\u00ae\u00d5 \u00ba\u00c8\u00be\u00c6\u008b\u00bb\u0081\u00f4\u00b9\u00c7 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u0081 \u00cc\u00b6\u00c7\u00b4\u00af\u00c6\u00af \u00f2\u00be\u00b6\u00b8\u00ba\u00c7\u00af \u00a5\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a5\u00d7\u00bd\u00ba\u00c6\u00cc\u00b9\u00c7\u00b4\u008c\u00be\u00c6 \u00a3\u00ce\u00ba\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf \u00cc\u00b6\u00c7\u00ae\u00b4\u00ba\u00c7\u0081 \u00af\u00be\u00c7\u00b1\u00c7\u00bc \u00b7\u00c8\u00ce\u00be\u00bb\u00ba\u00c6\"\u00cd\u00b7\u00c7\u00bc\u00c6\u00c1[\u00b4\u00c6\u0088\u00be\u00c6 \u00a3\u00ce\u00ba\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf \u00cc\u00b6\u00c7\u00ae\u00b4\u00ba\u00c7\u0081 \u008c\u00ce\u00bf\u00bb\u00c7\u00b4\u00c6\u00d5\u00af\u00c6\u00af\u00b4\u00c6\u0088\u00b4\u00b6\u00c6\u00cc\u00b6\u00c7\u00d0\u00b6\u00c8 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00c4\u00b4\u00c6\u00b4\u00b8\u00c8\u00be\u00c6 \u00a3\u00ce\u00ba\u00b7\u00c6\u00d7\u00bf\u00c6\u00bf\u00cc\u00b6\u00c7\u00ae\u00b4\u00ba\u00c7\u0081 \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af \u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b9\u008a\u00bd\u00c6\u00b1\u00c8 \u00b7\u00c8\u00ce\u00be\u00bb\u00ba\u00c6 \u00a9\u0081\u00b9\u00c1\u00bd\u00c6\u00ce\u00bd\u00b7\u00c8\u00de\u00e2\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u0081 \u00b6\u00c8\u00bc\u00ae\u00b4 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cc\u00b6\u00c7\u00ce\u00af\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(3) \u0089\u0081\u00c1\u00dd\u00c1\u00b8 \u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :\u2013"
