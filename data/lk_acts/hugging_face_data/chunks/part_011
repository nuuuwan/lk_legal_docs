    "chunk_text": "(\u00a4)\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\" \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00af\u00c9\u00c0\u00c7\u00b8\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00c0\u00af\u00c6\u00d0 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00af\"\u00a7\u00bb\u00bc\u00c6\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00bd\u00be\u00c6\u00be\u00c7\u00b6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00af\u00dd\u00ba\u00b6\u00c6\u00ce\u00b6\"\n\n\u00a3\u00b1\u00c6\u00b1\u00c8\u00d5\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00c1\u00bf\u00c8\u008a\u00d5\u00af\u00c8\u0081\u00bd \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c7\u00bf\u00c6\" \u00a5\u00bc\u00ae\u00b4\u00c7\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00d0 \u00b7\u00c9\u0088\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00a5\u00dd\u00c1\u00ce\u00af\u008a\u00cc\u00be\u00c7\u00dd\u00c1\u00ce\u00af \u00ba\u00bd\u00c8\u00bb\u00bd\u00c6\u00bd\u00ae\u00b4\u00ce\u00b8\u008a\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00ba\u00bd\u00c8\u00bb\u00bd\u00c6\u00bd\u00ae\u00b4\u00ce\u00b8\u008a\u00b8\u00c7\u00df\u00ba\u00c6 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00df\u00ba\u00c6 \u00b6\u00ae\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n22\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8+\u00c6\u00af\u00bf\" \u00b6\u00ba\u00c8\u00c0\u00c6 \u00a7\u00ce\u00bc\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00ce\u00b4\u00cd\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00af\u00c7\u00b5\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00bb \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n23\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081\" \u00b1\u00b7\u00c6\u00b6\u00bc\u00c6\u00b9\u00c6\u00b9\u00ba\u00c6 \u00cd\u00c1\u00de\u00c1\u00ce\u00af\u00bb\u00c7\u00af\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00cc\u00be\u00c7\u00c0\u00c8\u00bb -\n\n\u201c\u00b1\u00c8\u00de\u00c1\u00bc\u00c6\u201d \u00a9\u0081\u00b9\u00d7 18 \u00c1\u00bb\u00d7\u00af\u00c6\u00d0\u00af\u00c6 \u00af\u00c9\u00c0\u00c6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00bf\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u00aa\u00ce\u00b8\u00bb\u00c1\u00c0\u00af\u00c6\u00d0\u00af\u00bf\u00c6 \u00b6\u00ce\u00b4\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u008c\u00be\u00c6\u00ce\u00be\u00b0\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba\u008a\u0081\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf\u00a7\u00ce\u00bc \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u00cd\u00af\u00c7\u00b4\u00be\u00c6\u00b0\n\n\u00d0\u00bd\u00c6\u00bd\u00c1\u00ce\u00bc\u00b6\u008b\u00be\u00c6\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6\u0089\u0081\u00b9\u00bd\u00c6\u00bd\u00cd\u00c1\u00ae\u0088\u00bb\u00b7\u00b4\u00b9\u0088\u00db\u00ce\u00bd\u00b0\n\n\u00d0\u00bd\u00c8\u00b6\u00c6\u00b6 \u00b1\u00c8\u00be\u008c\u00b4\u00bb+\u00c6\u00af\u00bf\u00c8\u00be\u00c6\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00dd\u00b6\u00c6\u00ce\u00b6\u00a3\u00b1\u00c6\u00b1\u00c8\u00d5\u00af\u00c8\u0081\u00bd\u00a3\u00be\u00c6\u00be\u00d7\u00cc\u00c1\u00bf\u00c8\u008a\u00d5\u00af\u00c8\u0081\u00bd\u00a4\u00b4\u00c6\u00af\u00bf\u00c6\u00b6\u00ae\u0088\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 34 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00d0\u00d5\u00ba\u00c6\u00b9\u00c1\u0081\u00db\u00ce\u00bd\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c6 \u00b6\u00d5\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c615\n\n\u201c\u00d0\u00d5\u00ba\u00c6\u00b9 \u00c1\u0081\u00db\u00ce\u00bd\u201d \u00a9\u0081\u00b9\u00d7 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00a4\u00bf\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c7\u00be\u00c6\u0096\u00b4\u00c6\u00d5\u00b1\u00c6 \u00e9\u00c0\u00df\u00af\u00c6\u00d0\u00bf\u00c6\u00bf\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00c1\u00bf\u00c8\u00cd\u00bb \u00da\u00bc\u00c8\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u008c\u00ce\u00bf\u008c\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\u00ba\u00c6 \u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00a4\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a5\u00ce\u00b4\u00cd\u00bb\u00dc\u00bf\u00c6\u00bf \u00a7\u00bd\u00e2\u00db\u00ce\u00bd\u008a\u0081 \u00b6\u00b8\u00c8\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u0081\u00ce\u00ba\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00a9\u00e1\u00c1\u00d7\u00ba\u00c7\u00b8 \u2013\n\n(\u00a3) I \u00a4\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00bd\u00c7\u00af \u00a3\u00ce\u00ba\u00dc\u00ba\u00c6 \u00ac\u00dd \u00cc\u00b1\u00bb\u00be\u00c6 ;\n\n(\u00a4) \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a7\u00b5\u00bc\u00c6\u00b1\u00c6\u00b1\u00c8\u00bc\u00c9\u00b6\u00c8\u00bb\u00c7\u00b8 \u00d7\u0082\u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00ba\u00c6\n\n\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00a7\u00b5\u00bc\u00c6\u00b1\u00c6\u00b1\u00c8\u00bc\u00c9\u00b6\u00c8\u00bb\u00c7\u00b8 \u00d7\u0082\u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00ba\u00c6\u201d \u00a9\u0081\u00b9\u00d7 \u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00ce\u00bf\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00c8\u00b9\u00c6 \u00da\u00bc\u00c8\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00d5\u00ce\u00ba\u00bb\u00c7\u00b8 \u00cc\u00af\u00c7\u00ec\u00bc\u00ba\u00c7\u00b8\"\u00ba\u00b8\u00c8\u00b6\u00b6\u00c6\u00b6\u0081\u00ce\u00ba\u00bb\u00bd\u00c6\u00bd\" \u00a5\u00c0\u00c8\u00e2\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00a5\u00ba\u00c6\u00ce\u00b1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6 \u00ac\u00dd\u00c1\u00ce\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b7\u00b4\u00b6\u00c6\u00ce\u00b6 \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6;\n\n\u201c\u00cd\u00b1\u00bc\u00c6\u00b6\u00c6\u00b6\u00d9\u00b9\u008c\u00af\u00c6\u00d0\u00ba\u00c6 \u00f2\u00be\u00c1\u00bf+\u00c6\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7 \u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00e0\u00ba\u00c6\u0089\u00bc\u00b6\u00c8\u00c1\u00c7\u00b6\u00c8\u00dc\u00ba\u00c6 \u00c1\u00c0\u00ce\u00ba\u00bb\u00c7\u00af\u00b9\u00c6 \u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00d6\u00d0\u00ba\u00c6 \u00a3\u00ce\u00b1\u00e2\u00bf\u00c6\u00bf \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00ce\u00b1\u00c1\u00bd\u00c6\u00bd \u00a4\u00b6\u00b8\u00ba\u00c6\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00a4\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7 \u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00bf\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6\" \u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00bf\u00c8\u0081 -\n\n(\u00a3) (i)\u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6\u00d7\u00ce\u00b5 ;\n\n(ii) \u00db\u0081\u00ce\u00b8\u00bb \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6\u00d7\u00ce\u00b5 ;\n\n(iii) \u00e7\u0088\u00c1\u00c7\u00e1\u00ba\u00c6 \u00d7\u00ce\u00b5\u00c1\u00bc\u00c6 \u00a9\u0081\u00de ;\n\n(\u00a4)\u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00bf\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6\u00d7\u00ce\u00b5\u008a\u0081\" \u00db\u0081\u00ce\u00b8\u00bb \u00c1\u00c7\u00c0\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c6\u00d7\u00ce\u00b5\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00d7\u0081\u00da\u00bd\u00c6\u00bd \u00a4\u00bf\u00c8\u0081\u00e7\u0088\u00c1\u00c7\u00e1\u00ba\u00c6 \u00d7\u00ce\u00b5\u00c1\u00bc\u00c8\u0081 -\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 34 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00d0\u00d5\u00ba\u00c6\u00b9\u00c1\u0081\u00db\u00ce\u00bd\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c6 \u00b6\u00d5\u00b9\u00c6\u00da\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c616\n\n(i)\u00b6\u00b7\u00c6\u00ce\u00b6\" \u00b6\u00c7\u00bb\u00c6\" \u00b9\u00c7\u00b4\u00c6\u00b4\u00b8\u00c7\u00bc\u00c6\" \u00b9\u00c7\u00b4\u00c6\u0088\"\u00ba\u00c7\u00bd\u00c6\u00bd\u00c7\u00b7\u00c6 \u00b6\u00b7\u00c6\u00ce\u00b6\" \u00ba\u00c7\u00bd\u00c6\u00bd\u00c7\u00b7\u00c6 \u00b6\u00c7\u00bb\u00c6 ;\n\n(ii) \u00ba\u00af\u0081\" \u00ba\u00af\u00bf\u00c6\" \u00cd\u00b9\u00bc\u0081\" \u00cd\u00b9\u00b6\u00c6\u00b6\u00c8\" \u00ba\u00c7\u00bd\u00c6\u00bd\u00c7\u00b7\u00c6\u00b6\u00c7\u008a\u0081 \u00ba\u00af\u0081\" \u00ba\u00c7\u00bd\u00c6\u00bd\u00c7\u00b7\u00c6 \u00b6\u00c7\u008a\u0081 \u00ba\u00af\u00bf\u00c6;\n\n(iii) \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u0081\" \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u00c8\" \u00ac\u0081\u00de\u008c\u00b4\u00c6\u00b4\u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u0081\" \u00ac\u0081\u00de\u008c\u00b4\u00c6\u00b4 \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u00c8\"\u00ba\u00c7\u00bd\u00c6\u00bd\u00c7\u00bf\u00c6 \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u0081\" \u00ba\u00c7\u00bd\u00c6\u00bd\u00c7\u00bf\u00c6 \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u00c8 ;\n\n(iv) \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c8\u0081 \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\" \u00b1\u00cd\u00af\u00c7\u00b6\u00bc\u00c8\u00af\u00bf\u00c6 ;"
