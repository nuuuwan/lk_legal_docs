    "chunk_text": "\u201c\u00b1\u00c8\u00de\u00b9\u00bd\u00c6\u00de \u00b7\u00c8\u00be+\u00c6\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7 \u00ab\u00ba\u00c6\u00b9\u00d7 \u00aa\u00af\u00c6\u00af\u00bc\u00c6 \u00b7\u00c8\u00be\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00ce\u00b9\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u00b4 \u00a3\u00be\u00c6\u00be\u00d7 \u00ab\u00ba\u00c6\u00b9\u00d7 \u00aa\u00af\u00c6\u00af\u00bc\u00c6 \u00b7\u00c8\u00be\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00ce\u00b9\u008c\u00b4\u00d0\u00ce\u00bd\u00c1\u00c7\u00af\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00bf\u00c6\u00bf\u00d7\u00ba\u00c7\u00b8 \u00a5\u00b4\u00b9\u00c6\u00b9\u00bc\u00b9\u00c6\u00da \u00a9\u00b8\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00c1\u00d7\u00b4\u0081 \u201c\u00b1\u00c8\u00de\u00b9\u00bd\u00c6\u00de \u00b7\u00c8\u00be\u00b1\u00c6 \u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00af\u00c6\u00af\u00c7\u00bc\u00bc\u00c6\u00af\u00bf\u00c6\u201d \u00a9\u00b8 \u00cc\u00c1\u00bf\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00ba\u00c6 \u00cc\u00b1\u00c7\u00be\u00c6\u00be\u00ce\u00ba\u00b9\u00c6\u00da \u00a3\u00b6\u00bd\u00c6\u00af\u00c8\u00b5+\u00c6\u00af\u00b9\u00c6 \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;\n\n\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6 \u00cd\u00af\u00c7\u00b4\u00be\u00c6\u00b0\n\n\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba\u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6\u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00b1\u00c8+\u00c6\u00af\u00bf\u00a7\u00ce\u00bc \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6\u00b0\n\n20 2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 31 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00b9\u00c6\u00de\u00af\u00c6\u00af \u00b7\u00c8\u00b6\u00c8\u00bb\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00ba\u00c6"
