    "chunk_text": "\u00c0\u00e9\u00b6\u00e5\u00c9\u00b4 \u00c0\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00cc\u00cd \u00a1\u00bc\u00e5\u00ce \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a1\u00ba\u00c7 \u00a1\u00e6\u00ba\u00f8\u00ef\u00c0\u00f0\u00bc\u00e0\u00aa\u00c8\u00e8\u00a8 \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00ef\u00c6\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00ef\u00c6\u00be\u00e0 \u00c0\u00e6\u00be \u00be\u00aa\u00fa\u00be\u00e0\u00be\u00e5\u00c9\u00ec \u00bc \u00be\u00f8\u00c9\u00ef\u00cc\u00e0 \u00c0\u00d6\u00cc\u00c7\u00c6 \u00ba\u00eb\u00ce \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00b4\u00ba \u00bc\u00fb \u00a1\u00bc\u00e5\u00ce \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00cd,\n\n\u00ef\u00c9\u00be\u00ba\u00e0 \u00be\u00b6\u00ea \u00c0\u00e6\u00c9\u00d7\u00c4\u00c9\u00ce\u00a8\u00e0\u00c9\u00e5 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c2\u00c9.\n\n\u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0\u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u0097\u00b4 \u00cc\u00e8\u00e2\u00cd\u00c8\u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00a1\u00da\u00bb \u00be\u00e8\u00c7\u00e7\u00c0\u00b8\u00c6.\n\n\u00ef\u00ae\u00e5\u00e0\u00bc\u00be\u00e5 \u00ef\u00a8\u00b4\u00ea\u008a\u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00e5\u00da\u00c6\u00c0\u0090\u00c0\u00e5\u0090\u00c6\u00a1\u00be\u00ea\u00aa\u00c4\u00be\u00c6 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb\u00c2\u00c9.\n\n2005 \u00a1\u00e2\u00a8 34 \u00bc\u00c7\u00be \u00aa\u00ee\u00cd\u00cc\u00e0\u00bb \u00c0\u00f2\u00ae\u00b8\u00e0\u00b6 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00ef\u008a \u00c0\u00be\u00ba12\n\n(\u00a1) I \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00cd\u00fa \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00c9\u00c7\u00bc\u00a8\u00e0\u00cc\u00e2\u00c6\u00ea\u00a8\u00e0\u00ba \u00c9\u00be \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0 ;\n\n(\u00a1\u00e5) \u00c6\u008a \u00a4\u00bc\u00e0\u00ef\u008c\u00aa\u00ca\u00fb\u00c8\u00e9 \u00c2\u00e6\u00be \u00c9\u00e6\u00bc\u00fb\u00c4\u00a8\u00e0,\n\n\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00a4\u00bc\u00e0\u00ef\u008c\u00aa\u00ca\u00fb\u00c8\u00e9 \u00c2\u00e6\u00be \u00c9\u00e6\u00bc\u00fb\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c0\u00e9\u00b6\u00e5\u00c9\u00b4 \u00c0\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00ef\u00c6\u00e5\u00c4\u00ea \u00a8\u00c7\u00be \u00c8\u00bc \u00c2\u00c7\u00c0\u00ba\u00c8 \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00ef\u00c6\u00e0 \u00a1\u00c9\u00c4\u00be\u00e0 \u00a8\u00f8\u00d7\u00ef\u008a\u00ef\u00cd\u00e5\u00e0 \u00a1\u00c0\u00cd\u00e5\u00cc \u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00c8\u00e5\u00c0\u00c6\u00a8 \u00cc\u00e0\u00c9\u00c7\u00e7\u00c0\u00c6\u00a8\u00f8\u00be\u00e0 \u00c6\u00ea\u00a8\u00e0\u00ba\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00a6\u00e0 \u00c0\u00e9\u00b6\u00e5\u00c9\u00b4 \u00c0\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00c2\u00c7\u00c0\u00ba\u00c8 \u00a8\u00e0\u00cb\u00b8\u00e8\u00a8\u00c0\u00e9\u00b6\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00f8\u00d7\u00ef\u008a \u00c2\u00c8\u00c0\u00e7\u00c4 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00cd\u00c9\u00ea\u00ef\u00c8\u00e0 \u00c2\u00ea\u00a8\u00e0\u00ba\u00f8 \u0097\u00bf\u00fa\u00be \u00cc\u008a\u00c0\u00ba\u00e0\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c0\u00e9\u00b6\u00e5\u00c9\u00b4 \u00c0\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00cc\u00cd \u00c9\u00aa\u00a4\u00ba\u00e0\u00ba\u00c7\u00a8\u00c7\u00e6 \u00cc\u00e8\u00d6\u00ba\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c3\u00e5\u0097\u00ba \u00a8\u00ce \u00ef\u00cd\u00e5\u00e0\u00a7\u00c9\u00ea\u00be\u00e0\u00b4 \u00c0\u00f2\u00ef\u008c\u00ca\u00c6 \u00ba\u00f8\u00c2\u00ea\u00be \u00be\u00f8\u00ca\u00e0\u00ae\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00ae\u00e2\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce \u00a1\u00bc\u00cd\u00cc\u00e0\u00ef\u008c ;\n\n\u00c0\u00e9\u00b6\u00e5\u00c9\u00b4 \u00c0\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u201c\u00a1\u00bc\u00e5\u00ce \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u2013\n\n\u00c0\u00e8\u00b6\u00e5\u00c9\u00b4 \u00c0\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u2013\n\n(\u00a1) (i)\u00a8\u00c8\u00ba\u00f2\u00c6\u00e5 ;\n\n(ii) \u00ef\u00c9\u00be\u00e0\u00d1\u00c4\u00a8\u00b4 \u00ef\u00c0\u00c7 \u00cc\u00e8\u0090 \u00a8\u00c8\u00ba\u00f2\u00c6\u00e5 ;\n\n(iii)\u00cc\u00cd\u00c9\u00e5\u00cc\u00ef\u00c6\u00e0 \u00ef\u00c6\u00ef\u00bc\u00be \u00cc\u00cd\u00a8\u00c7\u00e6 ;\n\n(\u00a1\u00e5) \u00c0\u00e9\u00b6\u00e5\u00c9\u00b4 \u00c0\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a8\u00c8\u00ba\u00f2\u00c6\u00e5\u00ef\u00aa\u00e0, \u00a8\u00c8\u00e8\u00be\u00e0 \u00cc\u00e8\u0090\u00be\u00a8\u00c8\u00ba\u00f2\u00c6\u00e5\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00cd\u00c9\u00e5\u00cc\u00ef\u00c6\u00e0 \u00ef\u00c6\u00ef\u00bc\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0-\n\n(i)\u00c0\u00e8\u00c6\u00e5, \u00c4\u00c9, \u00cc\u00e9\u00c6\u00e5, \u00a1\u00e5\u0083\u008e, \u00c2\u00e5\u00c0\u00e0\u00c0\u00e5, \u00cc\u00ea\u00dd\u00c4\u00c9 ;\n\n(ii) \u00c0\u00ea\u00ba\u00e5, \u00f3\u00c9, \u00c4\u00ea\u00be\u00ea\u00c2\u00ea\u00c7\u00e5, \u0095\u00be\u00f8\u0094\u00d6\u00c6, \u00cc\u00ea\u00dd\u00c0\u00ea\u00ba\u00e5, \u00cc\u00ea\u00dd\u00bc\u00fa\u00c6\u00b8\u00e8\u00c6 ;\n\n(iii) \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00c7\u00c6\u00e5, \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00d6\u00c6, \u00a1\u00da\u00bd \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00c7\u00c6\u00e5, \u00a1\u00da\u00bd\u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00d6\u00c6, \u00cc\u00ea\u00dd \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00c7\u00c6\u00e5, \u00cc\u00ea\u00dd \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00d6\u00c6 ;\n\n(iv) \u00ef\u00bc\u00c4\u00e5\u00c0\u00e8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00c7 \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00d6\u00c6\u00be\u00e0 ;\n\n(v)\u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00d6\u00c6\u00a8\u00ef\u00aa\u00e0 \u00ce\u00c4\u00c6\u00e5 ;\n\n(vi) \u00ef\u00bc\u00c4\u00e5\u00c0\u00e8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ef\u00cd\u00e5\u00e0\u00bc\u00d6\u00c6\u00a8\u00ef\u00aa\u00e0\u00ce\u00c4\u00c6\u00e5,\u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c;\n\n2005 \u00a1\u00e2\u00a8 34 \u00bc\u00c7\u00be \u00aa\u00ee\u00cd\u00cc\u00e0\u00bb \u00c0\u00f2\u00ae\u00b8\u00e0\u00b6 \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00e6\u00ce\u00e6\u00a8\u00e0\u00d1\u00ef\u008a \u00c0\u00be\u00ba13\n\n\u201c \u00c9\u00aa\u00a4\u00ba\u00e0\u00ba\u00c7\u00a8\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8 \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6\u00a1\u00e5\u00b3\u00e5\u00c9\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00be \u0097\u00b4, \u00a6\u00c4 \u00a1\u00e5\u00b3\u00e5\u00c9 \u00a1\u00ef\u00c0\u00e0\u00a8\u00e0\u00cb\u00e5 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00a1\u00bc\u00e5\u00ce \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4\u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00bc \u00a6\u00c4 \u00a1\u00bc\u00e5\u00ce \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n1.\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00ef\u00c6\u00e0 XVI \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba \u00cc\u00e8\u00c6\u00f5 \u00c9\u00e6\u00c7\u00bc\u00fa.2.\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00ef\u00c6\u00e0 \u00c2\u00ef\u00c8\u00be\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4. 372 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6.3.\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c0\u00c7\u00e5\u009e \u0094\u00c6 \u00aa\u00e6\u00be\u00e0\u00d1\u00c4. 483 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6.4.\u00a2\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00e6\u00c7\u00bc\u00fa\u00c9\u00c8\u00e8\u00be\u00e0 \u00c6\u008a \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ba\u00e6\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\nII \u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c62 (3) \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6.\u00a2\u00c8\u00e0\u00c8\u00e9\u00c4"
  },
