    "chunk_text": "\u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00a8\u00f9 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a1\u00be\u00e0\u00ba\u00f8\u00c4\u00b4\u00c0\u00bc\u00fa\u00e2\u008e\u00c9 \u00cc\u00e8\u0090 \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00a4\u00c0\u00e0\u00c0\u00e6\u00be\u00e0\u00be \u00cc\u00cd \u00c4\u00c7\u00b8 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6. \u00a6\u00c9\u00e6\u00be\u00f8 \u00cc\u00e7\u00c4 \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00cc\u00c4\u00ad\u00c4,\u00a6\u00a8\u00f9 \u00a2\u00c8\u00e0\u00f5\u008a\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c0\u00f2\u00a8\u00e5\u00c7 \u00ef\u00bc\u00be\u00ea \u00c8\u00c2\u00be \u00bc\u00fa\u00c9\u00ea\u00c7\u00e6\u008a\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00cc\u00cd, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00e8, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9, \u00c0\u00d7\u00a8\u00e0\u00cb\u00b8\u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00ef\u008c \u00ef\u00cd\u00e5\u00e0 \u0097\u00ef\u00ca\u00e0\u00cb \u00b0\u00be\u00e5\u0093\u00c0\u00ba\u00e8 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00ef\u008c \u00ba\u00f9\u00c7\u00b8\u00ef\u00c6\u00e0\u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00ce \u00c0\u00e8\u00b4\u00c0\u00ba\u00a8\u00e0 \u00bc \u00a1\u00c4\u00ea\u00b8\u00e5 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec\u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00c8\u00e6\u00c2\u00ea\u00b8\u00ea \u0097\u00b4, \u00a6\u00a8\u00f9 \u00cc\u00cd\u00ba\u00f8\u00a8\u00ef\u00c6\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u0097\u00cc\u00e0\u00ba\u00c7, \u00be\u00f8\u00cc\u00e8\u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 (110 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00a4\u00c0\u00e0\u00c0\u00e6\u00be\u00e0\u00be \u00cc\u00cd \u00c4\u00c7\u00b8\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00c4\u00c7\u00b8\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7\u00be \u00ef\u00c8\u00cc \u00a6\u00e0 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5\u00b4\u0097\u00bd\u00e5\u00be \u00ef\u00a8\u00ef\u00c7\u00be \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8\u00e0 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00c6\u00e6\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) (110 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00a4\u00c0\u00e0\u00c0\u00e6\u00be\u00e0\u00be \u00cc\u00cd \u00c4\u00c7\u00b8 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00a6\u00a8\u00f9 \u00c4\u00c7\u00b8\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce\u0097\u00cc\u00e0\u00ba\u00c7 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be \u00ef\u00c8\u00cc \u0097\u00bd\u00e5\u00be \u00a8\u00c7\u0095\u00be\u00e0 (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00aa\u00c6\u00a8\u00e0 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5\u00b4 \u00c8\u00e6\u00c2\u00ea\u00b8 \u0097\u00b4, \u00a6\u00e0 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00be\u00e5\u00c0\u00c4\u00e5\u00c9 \u00a6\u00c4 \u0097\u00cc\u00e0\u00ba\u00c7 \u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4 \u00be\u00f8\u00cc\u00e8 \u00cc\u00e0\u00bb\u00e5\u00be\u00ef\u00c6\u00e0\u00a1\u00ba\u00e0\u00cc\u00be\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(5) \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c8\u00e8\u008d\u00ba \u00be\u00f8\u00c6\u00c4\u00c6 \u00a1\u00bc\u00e5\u00ce \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00ef\u008a \u00cc\u00b4\u00cd\u00ef\u00be\u00e0 \u00a1\u00be\u00ea \u00c0\u00e8\u00b4\u00c0\u00ba\u00b4\u00a1\u00e6\u0095\u00b8\u00e8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00c6 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c3\u00e5\u00c7\u00ef\u00c6\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00a8\u00e5\u00da\u00c6\u00e5\u00c8\u00ef\u00c6\u00e0 \u00ba\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a7\u00cd\u00ea \u00ef\u00c9\u00ba \u00c6\u00e6\u00d1\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc, \u00a6\u00a8\u00f9 \u00be\u00f8\u00c6\u00c4\u00c6\u00a1\u00c4\u00ea\u00b8\u00be \u00c8\u00bc \u00a1\u00be\u00ea\u00c0\u00e8\u00b4\u00c0\u00ba \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00cc\u00e8 \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00c6\u00e6\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n2005 \u00a1\u00e2\u00a8 17 \u00bc\u00c7\u00be \u00c4\u00c7\u00b8 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00ef\u008a(\u00ba\u00e5\u00c9\u00a8\u00e5\u00c8\u00e8\u00a8 \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba6\n\n(6) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00a2\u00c8\u00e0\u00c8\u00e9\u00c4\u00a8\u00e0 \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00ef\u00c9\u00ba \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, (2) \u00c9\u00be \u00cd\u00e5 (5) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c9\u00c8 \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u0097\u0093\u0097\u00bd\u00e5\u00be, \u00a1\u00c9\u00ca\u00f1 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u008a \u00cc\u00cd\u00fa\u00ba\u00c9, \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00bf\u00cd\u00be\u00a8\u00e0 \u00ef\u00c8\u00cc \u00a1\u00bc\u00e5\u00ce \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00cc\u00e0\u00c9\u00e5\u00c3\u00e5\u0097\u00a8 \u00c9\u00f1\u00cc\u00be \u00ef\u00cd\u00e5\u00e0 \u0097\u00c0\u00ba\u00e0\u00ba\u00f8 \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0 \u00a1\u00ba\u00eb\u00c7\u00e6\u00bc\u00cd\u00be\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00e0 \u00c4\u00c7\u00b8 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4"
