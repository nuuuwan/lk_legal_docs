c6 \u00cc\u00b9\u00bb\u00bc\u00c6) \u00a9\u0081\u00b9\u00c1\u00bc\u00c8\u00b4\u00ba\u00c6 \u00a7\u00b4\u00b8\u0088\u00bb\u00c7\u00af\u00af\u00c6 \u00ce\u00af\u00bb\u00bf\u00c8\u00af\u00c6\u00d0\u00ba\u00c7\u00de\u00b6\u00c7+\u00c6\u00af\u00bf\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00c9\u00bc\u00c6\u00af\u00bf\u00c6\u00b0\n\n\u00cd\u00b6\u00b6\u00c8 : \u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b0\u00b7\u00c9\u00b6\u00c8\u00c1\u00c7\u00b8\u00c8\u0081 \u00ce\u00af\u00cc\u00bb\u00c7\u00b9\u00c6\u00b9\u00db\u00ba\u00c6\u00a5\u00be\u00b1\u00c6\u00b1\u00c8\u00ce\u00b8\u00dc\u00ba\u00c6\u00b0\n\n2005 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00d2\u00b8\u00c7\u00ba\u00c8(\u008c\u00cd\u00b1\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c635"
