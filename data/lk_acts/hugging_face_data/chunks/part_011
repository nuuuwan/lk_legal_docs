    "chunk_text": "\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 IV(\u0089\u00bc\u00c8\u00e2 2\" 11 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 13)\n\n1949 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00ad\u00af\u00b6\u00c6\u00d7 12 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\" \u00cd\u00b9\u00c7\u00bc\u00c6\u00af\u00c6\u00af\u00c7\u00be\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00d0\u0088\u00ba\u00af\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00b9\u00bf\u00c8\u00b6\u00c6\u00b6\u00be\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00b8 \u00cc\u00b2\u00b8\u00c9\u00c1\u00c7 \u00b1\u00ba\u00c1\u00c7\u00bb\u00ba\u00c6\n\n\u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\n\n\u00b9\u00c7\u00af\u00ba\u00c6 IV\n\n\u00b1\u00ba\u00c1\u00c7\u00bb\u00b6\u00c6\u00ce\u00b6 \u00b7\u00c8\u00ce\u00bd\u00cd\u00c1\u00bd\u00c6\u00de\u00b6\u00be\u00c6\n\n\u0089\u00bc\u00c8\u00e2 1\n\n\u00cc\u00b9\u00c7\u00d7 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\n\n\u00a7\u00de\u00b9\u00c6\u00da\u00ce\u00bc 142\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 4 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cc\u00b2\u00b8\u00c9\u00c1\u00c7\u00b1\u00ba\u00c1\u00c7\u00bb+\u00c6\u00af\u00bf\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c625\n\n\u00a5\u00b6\u00c6\u00d7\u00ce\u00bd\u008a\u00be\u00c6 \u00cc\u00b1\u00b3\u00c6\u00b1\u00c8\u00df\u00ce\u00c1\u00b1\u00c6 \u00b1+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00bc\u00c6\u00c1\u00cd\u00b6\u00b1\u00af\u00c6 \u00d0\u00e1\u008c\u00b8\u00d7 \u008c\u00cd\u00b1\u00b4\u00b7\u00c8\u00ce\u00be\u00ce\u00ba\" \u00a9\u00be\u00c6\u00be\u00c7 \u00cd\u00b7\u00bc+\u00c6\u00af\u00bf\u00c8\u00df\u00ba\u00c6 \u00aa\u00bd\u00c6\u00bd+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5 \u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00a7\u00de\u0