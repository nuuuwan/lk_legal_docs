\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b8\u00db\u00b6\u00be\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5 \u00a5\u00b6\u00c6\u00b6\u00c7\u00bd\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n(1) 286\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00b8 \u00b9\u00b6\u00c8\u00e2\u00af\u00ce\u00bf \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u00b9\u00b6\u00c8\u00e2\u00af\u00ce\u00bf \u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u00cd\u00ba\u00bd\u00c6\u00b9\u0088 \u00cd\u00ba\u00bd\u00c6\u00b9\u0088 \u00cd\u00ba\u00bd\u00c6\u00b9\u0088 \u00cd\u00ba\u00bd\u00c6\u00b9\u0088 \u00a5\u00bc\u00ae\u00b4\u00c7\u00ae\u00d5\u00af\u00ce\u00bf\u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd\u00af\u00c7\u00be\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00a5\u00dd\u00c1\u00ce\u00af\u008a\u00cc\u00be\u00c7\u00dd\u00c1\u00ce\u00af\u00ba\u00bd\u00c8\u00bb\u00bd\u00c6\u00bd\u00ae\u00b4\u00ce\u00b8\u00af\u00c6\u00d0\n\n\u201c286\u00a4 \u00af\u00b5\u00b8\u00c8\u00f2\u00be\u00ba\u00c6\u00cd\u00b1\u00ce\u00c1\u00c1\u00c0+\u00c6\u00d0\u00ba\u00c6 \u00a4\u00bf\u00c6\"\u00b1\u00c8\u00de\u00c1\u00bc\u00c8\u0081\u00b9\u00c7\u008b\u00bb\u00be\u00c6\u00d7\u00bc\u00c6\u00b9\u00c6\u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00b6\u00c6\u00ce\u00b6\u00b6\u00c6 \u00b6\u00d5\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\u00b6\u00c6\u00b6\u00c1\u00de\u00b6\u00be\u00c6\u00b0\n\n\u00b7\u00c9\u00b6\u00c8\u00c1\u00c7\u0081\u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00ba\u00c6\u00b0\n\n1979 \u00a4\u00ba\u00c6\u00a4\u00ae\u0088\u008115 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b8\u00db\u00b6\u00be\u00c7\u00ba\