    "chunk_text": "7.\u00c6\u00e5\u00c0\u00be\u00c6 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00a4\u00ba\u00eb\u00c7\u00e6 \u00f4\u00c0\u00ba (\u00a8\u00c6\u00fa \u00cc\u00e0), \u00a8\u00c7\u00ef\u00c9\u0086\u0091, \u00ef\u00c0\u00e0\u00f3\u00c7\u00e6\u00ba\u00eb\u00b6\u00ea\u00c9, \u00ae\u00e5\u00c9\u00a8\u0083\u00ef\u0083\u00d6\u00c6, \u00a8\u00ef\u00c7\u00c6\u00fa\u00be\u00aa\u00da, \u00c4\u00c7\u00e6\u00ba\u00be\u00e0\u00a8\u00be\u00f8, \u00ef\u00ba\u00c8\u00e8\u00c0\u00e0\u00c0\u00ef\u00c8\u00c6\u00fa, \u00cc\u00cd\u00ef\u00b6\u00c8\u00e0\u00c0\u00e0\n\n8.\u00c4\u00ea\u00c8\u00ba\u00f8\u008c \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00c0\u00ea\u00ba\u00eb\u00a8\u00eb\u0091\u00c6\u00ea\u00c7\u00e6\u00c0\u00e0\u00c0\u00ea, \u00cc\u00cd \u00c4\u00d6\u00ef\u00ba\u008a\u00c0\u00ba\u00e0\u00ba\u00eb.\n\n\u00cc\u00ea\u00be\u00e5\u0095 \u00cc\u00cd\u00be\u00e5\u00bd\u00e5\u00c7\u00ef\u00bc\u00e0\u00c0\u00ce\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9\u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00bc\u00b8\u00e0\u00b6\u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec\u00a1\u00e6\u00ba\u00e6\u008a \u00c9\u00e6\u00c7\u00bc\u00fa \u00cc\u00bf\u00cd\u00e5\u00bc\u00b8\u00e0\u00b6\u00be.\n\n2005 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00cc\u00ea\u00be\u00e5\u0095 (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba18\n\n9.\u00a8\u00f8\u00c8\u00e8\u00ef\u00be\u00e5\u0083\u008e \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00a8\u00be\u00e0\u00b6\u00c9\u00ef\u00c8\u00c6\u00fa \u00cc\u00cd \u00c0\u00ea\u00be\u00a8\u00e0\u00a8\u00e5\u00d6.\n\n10.\u00c4\u00b6\u00a8\u00c8\u00c0\u00ea\u00c9 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00c4\u00e6\u00bc \u00ef\u00a8\u00e5\u00e0\u00c7\u00ef\u00c8\u00e0 \u00c0\u00ba\u00e0\u00ba\u00eb\u00c9, \u00ef\u00ae\u00be\u00e0\u00a8\u00c8\u00e5\u0091,\u00c9\u00e5\u00c8\u0083\u008e\u00ef\u00be\u00c6\u00fa, \u00a8\u00c8\u00c9\u00be\u00e0\u008e\u00a8\u00eb\u0091, \u00a6\u00c7\u00c9\u00ea\u00da \u00be\u00aa\u00c7\u00c6, \u00a4\u00ba\u00eb\u00c7\u00e6 \u00c4\u00be\u00e0\u00c4\u00ea\u00ef\u00be\u00c6\u00fa, \u00c9\u00cd\u00e5\u00c7\u00be\u00e0,\u00a8\u00e5\u00ba\u00e0\u00ba\u00be\u00e0\u00a8\u00eb\u0091, \u00a1\u00d6\u00c6\u008a\u00c0\u00ba\u00f8, \u00a8\u00f8\u00c7\u00e5\u00be\u00e0, \u00ef\u00c9\u00c8\u00e0\u00c8\u00ef\u008c\u00c8\u00e8, \u00c0\u00bc\u00fa\u00c0\u00ef\u00c8\u00c6\u00fa, \u00c9\u008c\u00be\u00e5\u00ba\u00f8\u008c \u00cc\u00cd\u00a7 \u00b4\u00c4\u00e5\u00c9\u0091.\n\n11.\u00a1\u008a\u00c0\u00e5\u00c7 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00a8\u00c8\u00e0\u00c4\u00ea\u00ef\u00be\u00e0, \u00cc\u00c6\u00fa\u00be\u00e0\u00ba\u00c4\u00c7\u00e5\u00ba\u00eb, \u00a8\u00e5\u00c7\u00ba\u00f8\u008c,\u00be\u00f8\u00be\u00e0\u00ba\u00c9\u00ea\u00da, \u00a1\u00b6\u00c8\u00e5\u0083\u00ae\u00ef\u00be\u00c6\u00fa, \u00a1\u00a8\u00e0\u00a8\u00c7\u00c6\u00fa \u00c0\u00ba\u00e0\u00ba\u00eb, \u00a1\u00c8\u00c6\u00e5\u0091\u00ef\u00c9\u008a\u00c2\u00ea, \u00ba\u00f8\u00c7\u00e6\u00a8\u00e0\u00ef\u00a8\u00e5\u0097\u00c8\u00e0,\u00ef\u00c0\u00e5\u00ba\u00eb\u0097\u00c8\u00e0 \u00cc\u00cd \u00c8\u00e5\u00cd\u00ea\u00aa\u00c8.\n\n12.\u00ba\u00f2\u00e8\u00a8\u00eb\u00b8\u00e5\u00c4\u00c8 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00a8\u00eb\u0083\u00ae\u00ef\u008c\u00c8\u00e8, \u00ba\u00f2\u00e8\u00a8\u00eb\u00b8\u00e5\u00c4\u00c8 \u00be\u00aa\u00c7\u00c6 \u00cc\u00cd\u00a8\u00b6\u00c9\u00ba\u00e0, \u00ba\u008a\u00c0\u00c8\u00e5\u00aa\u00c4\u00ea\u00c9, \u00a8\u00e8\u00be\u00e0\u00c6\u00e5, \u00c4\u00ea\u00ba\u00e0\u00ba\u00ed\u00da, \u00ef\u00cc\u00e0\u00c7\u00e6\u0097\u00c8, \u00ef\u00c9\u00c7\u00e6\u00aa\u00c8\u00e0/\u00a6\u0083\u008e\u00c8\u008a\u00c0\u00ba\u00e0\u00ba\u00f8.\n\n13.\u00c0\u00ea\u00ba\u00e0\u00ba\u00c8\u00c4 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00ef\u00c9\u00be\u00e0\u00be\u00c0\u00e0\u00c0\u00ea\u00c9.\n\n\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6[3 (2) \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6]\n\n\u00aa\u00f2\u00e5\u00c4 \u00be\u00f8\u00c8\u00bd\u00e5\u00d6 \u00ef\u00c9\u00ba,\n\n\u00a1\u00ba\u00eb\u00c7\u00e6\u00bc\u00cd\u00be\u00e0 \u00c9\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00a8\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00c9\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00cc\u00bf\u00cd\u00e5 \u00a2\u00c8\u00e0\u00f5\u008a \u00c0\u00ba\u00f2\u00c6\n\n1.\u00a1\u00ba\u00eb\u00c7\u00e6\u00bc\u00cd\u00be\u00e0 \u00c9\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00be\u00c4 :\u20142.\u00cc\u00e0\u00ba\u00f2\u00e9\u00c0\u00ea\u00c7\u00e6\u00cb \u00c3\u00e5\u00c9\u00c6 :\u20143.\u00b0\u00e5\u00ba\u00f8\u00c6 :\u20144.\u00c9\u00c6\u00cc :\u20145.\u0095\u00c6\u00aa\u00fa\u00c6 \u00bc\u00fa\u00be\u00c6 :\u20146.\u00a1\u00c9\u00cc\u00be\u00e0\u00c9\u00c7\u00b4 \u00c0\u00bc\u00fa\u00e2\u008e \u00cc\u00e0\u00bb\u00e5\u00be\u00ef\u00c6\u00e0 \u00c8\u00e8\u00c0\u00e8\u00be\u00c6 :\u20147.\u00cc\u00e0\u00bb\u00fc\u00c7 \u00c9\u00e5\u00cc\u00cc\u00e0\u00bb\u00e5\u00be\u00ef\u00c6\u00e0 \u00c8\u00e8\u00c0\u00e8\u00be\u00c6 :\u20148.\u00be\u00f8\u00c8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00db\u00a8\u00f8\u00c6\u00e5\u00c9 :\u20149.\u00a2\u00c8\u00e0\u00f5\u008a\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00be\u00c4 :\u201410.\u00a2\u00c8\u00e0\u00f5\u008a\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00c0\u00bc\u00fa\u00e2\u008e \u00cc\u00e0\u00bb\u00e5\u00be\u00c6 \u00cc\u00cd \u00f3\u00c7\u00a8\u00bb\u00be \u00a1\u00e2\u00a8\u00c6 :\u201411.\u00a2\u00c8\u00e0\u00f5\u008a\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00c6/\u00db\u00a8\u00f8\u00c6\u00e5\u00c9 :\u201412.\u00a2\u00c8\u00e0\u00f5\u008a\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5\u00cc\u00e0\u00bb\u00e5\u00be\u00c6 \u00cc\u00cd \u00f3\u00c7\u00a8\u00bb\u00be \u00a1\u00e2\u00a8\u00c6 :\u201413.\u00a2\u00c8\u00e0\u00f5\u008a\u00a8\u00c7\u00e6, \u00a1\u00ba\u00eb\u00c7\u00e6\u00bc\u00cd\u00be\u00e0 \u00c9\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00c6 :\u2014\n\n.......................\u00c0\u00bc\u00fa\u00e2\u008e.......................\u00c9\u00be \u00c4\u00e5 \u0097\u00cc\u00e8\u00be\u00e0....................(\u00a1\u00ba\u00eb\u00c7\u00e6\u00bc\u00cd\u00be\u00e0 \u00c9\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0\u00be\u00c4) \u00c6\u00be \u00a1\u00c6 \u00c4\u00e5\u00cc\u00cd\u00c6\u00a8\u00b4 \u00c9\u00b6\u00e5 \u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8 \u00cc\u00e8\u00b4 \u00a1\u00ba\u00eb\u00c7\u00e6\u00bc\u00cd\u00be\u00e0\u00c9 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9 \u00cc\u00cd\u00a6\u00a8\u00f9................\u00c6\u00be \u00a1\u00c6 \u00cc\u00ea\u00be\u00e5\u0095 \u0097\u00c0\u00ba \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0 \u0095\u00c6\u00ef\u00aa\u00e5\u00cc\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4 \u00cc\u00e6\u00c2\u00e6\u0097\u00be\u00e0\u00c4\u0097\u00ca\u00e0\u00c9\u00e5\u00cc \u00a8\u00c7\u00be \u00c2\u00c9\u00b4 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089.\n\n\u00a6\u00c4 \u00be\u00f8\u00cc\u00e5 \u00c4\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00a8\u00f9 \u00c4\u00c7\u00b8\u00c6, (110 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00a4\u00c0\u00e0\u00c0\u00e6\u00be\u00e0\u00be \u00cc\u00cd \u00c4\u00c7\u00b8\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00e5\u00b3\u00e5 \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7\u00be \u00ef\u00c8\u00cc \u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u0090\u00be\u00ea \u00c8\u00c2\u00be\u00a1\u00ba\u00c7 \u00a6\u00a8\u00f9 \u00c4\u00c7\u00b8\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00c4\u00c7\u00b8 \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6 \u00c4\u00e5 \u00ef\u00c9\u00ba \u00c8\u00c2\u00e5 \u00ef\u00bc\u00be \u00ef\u00c8\u00cc \u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u0090\u0095.\n\n\u00bc\u00fa\u00be\u00c6 :\u00a2\u00c8\u00e0\u00f5\u008a\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00a1\u00ba\u00e0\u00cc\u00be\n\n2005 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00cc\u00ea\u00be\u00e5\u0095 (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba19\n\n\u00ba\u00eb\u00be\u00e0\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6[9 (1) \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6]\n\n\u00c0\u00d6\u00c9\u00e5\u00cc \u00cd\u00e5 \u00ce\u00c4\u00e5 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00ef\u00c9\u00ba."
