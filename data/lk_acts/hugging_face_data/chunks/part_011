    "chunk_text": "(\u00a1) \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00ef\u00cd\u00e5\u00e0 \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00ea\u008a \u00a1\u00b8\u00a8\u00c7 \u00cc\u00cd \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00c0\u00e6\u00c9\u00d7\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00a4\u00c0\u00ef\u00bc\u00cc\u00e0\u00c6\u00e6\u00d1\u00c4, \u00c0\u00e8\u00d6\u00cc\u00e6\u00a8\u00cc\u00ea\u008a \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00c8\u00c2\u00e5\u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c6\u008a\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0, \u00ef\u00c9\u00be\u00ba\u00e0 \u00c4\u00ea\u00c8\u00f1 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00cc\u00c0\u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00cd \u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u0097\u0093\u00c4\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd\u00a1\u009e\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00a6\u00c9\u00e6\u00be\u00f8 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00cc\u00cd \u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4,\u00ef\u00c4\u00ef\u00cd\u00c6\u00d1\u00c4 \u00cc\u00cd \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00c4\u00ea\u00c8\u00f1 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00b4 \u00cc\u00cd\u00e5\u00c6 \u00d1\u00c4 ;\n\n(\u00a1\u00e5) (i)\u00ef\u00aa\u00d1\u008a, \u00be\u00f8\u00cb\u00e0\u00a8\u00e5\u00ca\u00be\u00c6 \u00cc\u00cd \u00ef\u0089\u00c7\u00e6\u008a \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c6\u008a\u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c6\u00a8\u00e0 \u00cc\u00cd \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00ef\u00cd\u00e5\u00e0 \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0\u00ef\u00aa\u00d1\u008a \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00ea\u00c9\u00c4\u00e5\u00c7\u00e6\u00c9 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00ef\u00c9\u00be\u00ba\u00e0\u00c9\u00e6\u00b6\u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00a8\u00e0 ;\n\n(iii) \u0081\u00be\u00e7\u00c4 \u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00a8 \u00ef\u00aa\u00d1\u008a \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0\u00c9\u00c8\u00b4\u0081\u00be\u00e7\u00c4 \u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00a8\u00f8\u00be\u00e0 \u00ef\u00aa\u00d1\u008a \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00d1\u008a\u00cd\u00ea\u00c9\u00c4\u00e5\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00cd\u00ea\u00c9\u00c4\u00e5\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec\u00ef\u00c9\u00be\u00ba\u00e0 \u00c9\u00e6\u00b6\u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00c9\u00c8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9, \u00be\u00f8\u00cb\u00e0\u00a8\u00e5\u00ca\u00be\u00c6 \u00cc\u00cd\u00ef\u0089\u00c7\u00e6\u008a \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00cc\u00e6\u00c8\u00cc\u00e9\u00c4 \u00c0\u00e8\u00b8\u00e8\u00cc \u00c9\u00ec \u00c6\u008a\u00c0\u00bc\u00e0\u00bd\u00ba\u00f8,\n\n\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4, \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4, \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6, \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6, \u00a3\u00b4 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00d1\u00c4\u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00c9\u00e5 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4\u00b4, \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4\u00b4, \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6\u00b4 \u00cc\u00cd \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6\u00b4\u00cc\u00cd\u00e5\u00c6\u00d1\u00c4 \u00cc\u00cd \u00a6\u00e0\u00c9\u00e5 \u0097\u0093\u00c4\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a1\u009e\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n2005 \u00a1\u00e2\u00a8 28 \u00bc\u00c7\u00be \u00ef\u00aa\u00d1\u00ef\u008a \u00cd\u00e5 \u00ef\u0089\u00c7\u00e6\u008a \u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00bc\u00e0\u00bd\u00ba\u00f8 \u00c0\u00be\u00ba5\n\n5.(1) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00aa\u00d1\u008a \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8\u00c6\u00a8\u00e0 \u00cc\u00a8\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4,\u00c0\u00e8\u00ce\u00e8\u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00cc\u00cd \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4, \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8 \u00cc\u00e4\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ca\u00f2\u00e9\u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00b4 \u00c2\u00c8\u00c6 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6. \u00a6\u00c4 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8\u00c6 \u00c0\u00f2\u00cc\u00e8\u00bc\u00e0\u00bd \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00be\u00f8\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8\u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00a4\u00cc\u00cc\u00e0\u00c4 \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00c0\u00f2\u0095\u00ba\u00f8\u00c9\u00c8\u00c4\u00e5\u00da\u00ef\u00aa\u00e5\u00e0\u00c0\u00ef\u00bc\u00e0\u00ca\u00a8\u00ba\u00e0\u00c9\u00c6 \u00c8\u00c2\u00e5\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6. \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00ef\u00aa\u00d1\u008a \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8\u00c6 \u00c4\u00ec\u00c8\u00e8\u00a8 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c4\u00ea\u00c8\u00f1 \u00a8\u00f2\u00c4\u00ef\u00c6\u00e0 \u00cc\u00c4\u00cc\u00e0\u00bb \u00cc\u00e0\u00bb\u00e5\u00c9\u00c7\u00ba\u00e0\u00c9\u00c6, \u00ef\u00aa\u00d1\u008a\u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00ea\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba\u00c3\u00e5\u00c9\u00c6 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4, \u00a8\u00e5\u00da\u00c6\u00a8\u00e0\u00cb\u00c4\u00ba\u00e5\u00c9 \u00cc\u00cd\u00a1\u00c9\u00bc\u00e5\u00be\u00c4 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00cd\u00cc\u00ea\u00a8\u008a \u00cc\u00e6\u00c8\u00ef\u00cc\u00be \u00c0\u00d6\u00bc\u00fa \u00cc\u00e6\u00c8\u00cc\u00ea\u008a \u00a8\u00ce\u00c6\u00ea\u00ba\u00eb \u00c6. \u00ef\u00c4\u00c4 \u00c4\u00ec\u00c8\u00e8\u00a8 \u00a1\u00c7\u00c4\u00ea\u00b8\u00b4 \u00c6\u00b4\u00ba\u00e0\u00c9 \u00ef\u00c4\u00c4 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8\u00c6 \u00c4\u00cd\u00b0\u00be \u00c6\u00cd\u00c0\u00ba\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00ef\u00cc\u00cc\u00ea \u00a1\u00e2\u00ca \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00c4\u00b4, \u0097\u00ef\u00ca\u00e0\u00cb\u00ef\u00c6\u00be\u00e0 \u00ef\u00aa\u00d1\u008a \u00ef\u00c9\u00ef\u00ce\u00bf\u00c0\u00ef\u00c8\u00cd\u00fa\u00ba\u00c7\u00aa\u00a8\u00e5\u00d7\u00ba\u00e0\u00c9\u00c6 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cc\u00cd \u00ef\u00aa\u00d1\u008a \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c6 \u00c0\u00e5\u0097\u0083\u008e\u00a8\u00c7\u00be\u00e0\u00be\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00bc\u00e5\u00c6\u00a8 \u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00cc\u00e6\u00c8\u00cc\u00ea\u008a\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00ef\u00aa\u00d1\u008a \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00ea\u00c7\u00a8\u00e0\u00cb\u00e8\u00ba\u00c3\u00e5\u00c9\u00c6 \u00cd\u00e5 \u00a8\u00e5\u00da\u00c6\u00a8\u00e0\u00cb\u00c4\u00ba\u00e5\u00c9 \u00c0\u00f2\u00c9\u00da\u00bd\u00be\u00c6\u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c7\u00b4\u00c9\u00c8 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb \u00cc\u00cd \u00ef\u00c9\u00be\u00ba\u00e0\u00a1\u00bc\u00e5\u00ce \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00ef\u00cd\u00e5\u00e0 \u0097\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00c2\u00c8\u00bd\u00c7\u00c6\u00be\u00e0 \u00cc\u00c4\u00aa \u00cc\u00cd\u00ef\u00c6\u00e5\u00e0\u00aa\u00ef\u00c6\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00ce\u00c6\u00ea\u00ba\u00eb \u00c6.\n\nII \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00aa\u00fa\u00b8\u00ea\u008a"
