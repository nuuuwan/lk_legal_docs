    "chunk_text": "(2) \u00be\u00e5\u00ef\u00c4\u00e5\u00e0\u00bc\u00e0\u00bc\u00fa\u00cb\u00e0\u00b4 \u00be\u00f8\u00cb\u00e0\u00a8\u00e5\u00ca\u00be \u00cc\u00cd \u00ef\u0089\u00c7\u00e6\u008a \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c6\u00b4\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00c9 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00cc\u00e7\u00c4\u00be\u00f8\u00cb\u00e0\u00a8\u00e5\u00ca\u00be\u00e5\u00aa\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0\u00c4, \u00a6\u00c4 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u008a \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00a1\u00c0\u00f2\u00c4\u00e5\u00bc\u00c9 \u00ca\u00f2\u00e9\u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00ef\u00c9\u00ba \u00c8\u00e8\u008d\u00ba \u00bc\u00e6\u00be\u00ea\u008a \u00bc\u00fb\u00c4\u00a8\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a2\u00cd\u00ba\u00f8\u00be\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00e6\u00b8\u00ea\u00c9\u00c8 \u00c9\u00f1\u00e5\u00c0\u00e0\u00ba\u00f8\u00c6 \u00cc\u00e9\u00c4\u00e5 \u00a8\u00f8\u00d7\u00c4\u00a8\u00f8\u00be\u00e0 \u00ef\u00ba\u00e5\u00c7\u00c9, \u00a6\u00c4 \u00bc\u00e6\u00be\u00ea\u008a\u00bc\u00fb\u00c4\u00c4\u00aa\u00fa\u00be\u00e0,\n\n(ii)\u00be\u00f8\u00cb\u00e0\u00a8\u00e5\u00ca\u00be\u00e5\u00aa\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c0\u00ba\u00e0\u00a8\u00ce \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa\u00c2\u00c8\u00c0\u00e7\u00c4\u00a8\u00e0 \u00cc\u00cd\u00fa\u00ba \u00c6\u008a \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4\u00a8\u00e0,\n\n\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00cc\u00e6\u00c0\u00c6\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00cc\u00e7\u00c4 \u00be\u00f8\u00cb\u00e0\u00a8\u00e5\u00ca\u00be\u00e5\u00aa\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0\u00c4, \u00a6\u00cd\u00fa \u00be\u00e5\u00ef\u00c4\u00e5\u00e0\u00bc\u00e0\u00bc\u00fa\u00cb\u00e0\u00b4 \u00be\u00f8\u00cb\u00e0\u00a8\u00e5\u00ca\u00be\u00cd\u00e5 \u00ef\u0089\u00c7\u00e6\u008a \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0\u00c8\u00e8\u00c6\u0097\u00c8\u00e0\u00c8\u00a8\u00e0 \u00c4\u00ad\u00e8\u00be\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c0\u00d6\u00bc\u00fa, \u00a6\u00ef\u00cc\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be \u00ef\u008c\u00c8\u00e5\u00c9\u00be\u00e0\u00cd\u00fa\u00bc\u00fb \u00cc\u00cd \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00c9, \u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u0090 \u00c6\u008a \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00cc\u00e6\u00c0\u00c6\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n26.(1) \u00ef\u008a \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00a8\u00da\u00ba\u00c9\u00f1 \u00a2\u00b4\u00ea\u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6\u00cc\u00bf\u00cd\u00e5 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00cb\u00e0\u00a8\u00e5\u00ca\u00be\u00e5\u00aa\u00e5\u00c7\u00c6\u00a8 \u0097\u00aa\u00b8\u00be \u00cc\u00cd\u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u008a \u00cc\u00e8\u00f3 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(2) \u00a1\u00c9\u00ca\u00f1 \u00c6\u00c6\u00fa \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00cc\u00c8\u00a8\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb (1) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u0097\u00aa\u00b8\u00be \u00cc\u00cd \u00c0\u00d7\u00a8\u00e0\u00cb\u00b8, \u00ba\u00c4\u00be\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a\u00c8\u00ba\u00e0 \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00e6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6\u00c6\u00fa \u00cc\u00cd \u00a7\u00c9\u00ea\u00be\u00e0\u00ef\u00aa\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u00ef\u00c9\u00ba\u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6\u00c6\u00fa \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n\u0097\u00aa\u00b8\u00be\u00c6 \u00cc\u00cd \u00ca\u00f2\u00e9\u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4.\n\n2005 \u00a1\u00e2\u00a8 28 \u00bc\u00c7\u00be \u00ef\u00aa\u00d1\u00ef\u008a \u00cd\u00e5 \u00ef\u0089\u00c7\u00e6\u008a \u00a8\u00f8\u00d7\u00ef\u008a\u00c0\u00bc\u00e0\u00bd\u00ba\u00f8 \u00c0\u00be\u00ba32\n\n(3) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00b4 \u00cc\u00cd \u0097\u00aa\u00b8\u00be \u00cd\u00e5 \u00c0\u00d7\u00a8\u00e0\u00cb\u00b8 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4\u00cc\u00bf\u00cd\u00e5 \u00c0\u00ba\u00e0\u00a8\u00ce \u00cc\u00e7\u00c4 \u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a\u00c8\u00ba\u00e0 \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00a8\u00eb\u00b4\u00c4, \u00be\u00f8\u00cb\u00e0\u00a8\u00e5\u00ca\u00be\u00e5\u00aa\u00e5\u00c7\u00ef\u00c6\u00e0\u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6, \u00ef\u00c0\u00e5\u00ba\u00e0\u00c0\u00ba\u00e0 \u00cc\u00cd \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00c8\u00b4 \u00c0\u00f2\u00ef\u008c\u00ca\u00c6 \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6. \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00a8\u00e5\u00da\u00c6 \u00a2\u00b4\u00ea\u00a8\u00f8\u00d7\u00ef\u008a \u00bc\u00fb \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a\u00c8\u00ba\u00e0 \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5\u00b4 \u00be\u00f8\u00cb\u00e0\u00a8\u00e5\u00ca\u00be\u00e5\u00aa\u00e5\u00c7\u00c6 \u0097\u00cc\u00e8\u00be\u00e0\u00cc\u00cd\u00e5\u00c6 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(4) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u201c\u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a\u00c8\u00ba\u00e0 \u0097\u00aa\u00b8\u00a8\u00c9\u00c7\u00c6\u00e5\u201d\u00c6\u00be \u00ef\u00c6\u00f3\u00c4\u00b4, \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00a8\u00f2\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c 154 \u00c9\u00be \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00be\u00e0 \u00a3\u00b4 \u00bc\u00fb\u00a1\u00e6\u00ba\u00f8 \u00a1\u00da\u00bb\u00c6\u00c4 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6.\n\n(5) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u0097\u00aa\u00b8\u00be\u00c6\u00a8\u00e0 \u00cc\u00cd \u00c0\u00d7\u00a8\u00e0\u00cb\u00b8\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00c9\u00bc\u00fa\u00c9\u00ea\u00c7\u00e6\u00c4 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 (17 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6\u00c9\u00ec) \u00bc\u00fa\u00c9\u00ea\u00c7\u00e6\u008a \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ba\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00bc\u00fa\u00c9\u00ea\u00c7\u00e6\u008a \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ba\u00f8\u00b3\u00e5 \u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00ca\u00f2\u00e9\u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00b4 \u00c2\u00c8\u00c6 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6.\n\n27.\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00b4, \u00be\u00f8\u00cb\u00e0\u00a8\u00e5\u00ca\u00be \u00cd\u00e5 \u00ef\u0089\u00c7\u00e6\u008a \u00a8\u00e8\u00d7\u00ef\u008a\u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c6\u00a8\u00b4 \u00cc\u00cd \u00be\u00f8\u00cb\u00e0\u00a8\u00e5\u00ca\u00be\u00e5\u00aa\u00e5\u00c7\u00c6\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a8\u00f2\u00e8\u00c6\u00e5\u00cc\u00e8\u00c6\u00c8\u00e0\u00c8 \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c2\u00c8\u00c6 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\u2014\n\n(i)\u00c0\u00e5\u00b6\u00ea\u00c9\u00a8\u00e0 \u00cd\u00c9\u00ea\u00ef\u00c8\u00e0 \u00bc\u00e6\u00d7\u00ef\u008a \u00c6\u00e5\u00be\u00e0\u00ba\u00f2\u00b8\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9 \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00d1\u00c4, \u00cc\u00cd\u00c3\u00e5\u00aa\u00fa \u00d1\u00c4 \u00cc\u00cd \u00c4\u00bd\u00f1\u00c4 \u00c0\u00f2\u00ba\u00f8\u00c0\u00e5\u00da\u00ca\u00e0\u00c9\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c8\u00cc \u00a8\u00f2\u00e8\u00c6\u00e5\u00a8\u00f8\u00d7\u00c4 ;"
