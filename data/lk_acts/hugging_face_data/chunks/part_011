u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00c8\u00af\u00c6\u00af\u00e2\u00ba\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00b6\u00b1\u00c8\u00be \u00b7\u00be\u0081\u00af\u00ce\u00bf \u00a3\u00d9\u00b9\u008c\u00af\u00c6\u00af\u00e2\u00ba\u00c6 \u00a5\u00bb\u00be\u00c7\u00b6\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u008a\u00dd\u00b9\u00c6\u00b9\u00b6\u00b8\u00c7\u00df\u00ba\u00c6 \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c7\u00be\u00c6 \u00a7\u00bf\u00b6\u00c7\u00b8 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00b4\u0081 \u00a5\u00b5+\u00c6\u00af\u00c8\u00cc\u00bb\u00c7\u00e1\u00af \u00a5\u00bb\u00be\u00c7\u00ce\u00ba\u008a\u0081 \u008c\u00ce\u00bf\u00c1\u00c7\u00af \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00b6\u00b1\u00c8\u00be \u00b6\u00b4+\u00c6\u00af\u00be\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u0089\u00bc\u00b6\u00c8\u00e7\u00be+\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00c7\u00bc\u00c6\u00af\u00bf\u00c6 \u00a4\u00b6\u00be\u00c7\u00df\u00ba\u00c6 :\n\n\u00d2\u00b8\u00c7\u00ba\u00c8\u008a\u0081 \u00af\u00c7\u00bc\u00b5\u00ba\u00c7\u00af \u00cc\u00b9\u00bd\u00c6\u00cd\u00bd\u00c7\u00bc\u00c8\u0081 \u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00da\u00b9\u00c6\u00cd\u00b9\u00c7\u00b6\u00c8\u00bb\u00bf\u008c\u00be\u00c6 \u00af\u00c8\u00ce\u00b4\u00af\u00c6\u00af\u00b9\u00c6\u00cc\u00b9\u00bd\u00c7\u00d7 \u00b1\u00c8\u00de\u00c1\u00bc\u00c6\u00af\u00e0\u00ba\u00c6 \u00a5\u00bf\u00ba\u00c6 \u00a4\u00b4\u00c6\u00af\u00e0\u00ba\u00c6\u008c\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\u00c7\u00bc\u00c6\u00af\u00bf\u00c6 \u00a9\u0081\u00b9\u00b6\u00c7\u00df\u00ba\u00c6 \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c6 \u00ba\u00c7\u00bd\u00c6\u00bd\u00c9\u00b4\u00c7\u00b8\u00af\u00c1\u00b8\u00c8\u00b9\u00c6\u00ce\u00b9\u00dc\u00ba\u00c6 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00ce\u00b9\u00dc\u00ba\u00c6 \u00cc\u00b9\u00de\u00af\u00c8\u0081\u00bd\u00c7\u00bc\u00c6\u00af\u00bf\u00c6 \u00a9\u0081\u00b9\u00ce\u00b6\u00a7\u00de\u00b6\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00d7 \u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\u00d7 \u00a4\u00b6\u00be\u00c7\u00df\u00ba\u00c6 :\n\n\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00d2\u00b8\u00c7\u00ba\u00c8\u00bb\u00c7\u00be\u00c6 \u00b9\u00c7\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00b6\u00bd\u00c6\u00cd\u00b9\u00c7\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd \u00b1\u00b4\u00c6\u00b4\u00db\u00ce\u00bd \u00a5\u00ce\u00b4\u00bb[\u00de\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a7\u00bf\u00b6\u00c7\u00b8 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6 \u00b6\u00ce\u00b4\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00b6\u00c7\u00ae\u0088 \u00c1\u00dd\u00c1\u00b6\u00ce\u00b8 \u00a5\u00bb\u00be\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00d7\u00a7\u00bc\u00c8\u00ce\u00ba\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00b1\u00c8\u00bd\u00b9\u00c6\u00da\u00bc\u00c8\u00ce\u00ba\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00ce\u00b9\u00dc\u00ba\u00c6\u00b6\u00bd\u00c6\u00af\u00c7\u00b6\u00c6\u00b6\u00ce\u00be\u00dc\u00ba\u00c6 \u00a7\u00de\u00b6\u00c8\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6 \u008c\u00cd\u00b1\u00b4 \u00b1\u00b4\u00c6\u00b4 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf\u00a4\u00af\u00c6\u00af\u00cd\u00c1\u00ae\u0088\u00bb \u00a7\u00b4\u00b8\u0088\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00c7\u00cc\u00b4\u00c7\u0081\u00de \u00a5\u00b9\u00c6\u00cc\u00b9\u00c7\u00e1\u00d7\u00a7\u00bf\u00b6\u00c7\u00af\u008c\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\u00b6\u00c7\u00b6\u00be\