    "chunk_text": "(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00a2\u00b6\u00c4\u00a8 \u00cc\u00be\u00e0\u00ba\u00a8\u00c6 \u00bc\u00c7\u0095\u00be\u00e0\u00cc\u00e8\u0090 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0, \u00a6\u00c4 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a6\u00c4\u00a2\u00b6\u00ef\u008a \u00cc\u00be\u00e0\u00ba\u00a8\u00c6 \u00bc\u00c7\u0095\u00be\u00e0 \u00cc\u00e8\u0090 \u00c2\u00c9\u00b4 \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00c2\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 2004 \u00ef\u00bc\u00cc\u00e6\u008a\u00c2\u00da \u00c4\u00cc 26 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00c4\u00e5\u00cc\u00ef\u00bc\u00a8\u00a8 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00c2\u00c8\u00cd\u00ba\u00e0\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00cc\u00be\u00e0\u00ba\u00a8\u00ef\u00c6\u00be\u00e0 \u00ef\u00be\u00c7\u00c0\u00be\u00ea \u00c8\u00e6\u00c2 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00ef\u00cc\u00e0 \u00cc\u00be\u00e0\u00ba\u00a8\u00ef\u00c6\u00be\u00e0\u00ef\u00be\u00c7\u00c0\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00a6\u00c4 \u00a2\u00b6\u00ef\u008a \u00cc\u00be\u00e0\u00ba\u00a8\u00c6\u00be\u00e6\u00c9\u00ba \u00c8\u00c2\u00e5\u00ef\u00bc\u00be \u00ef\u00c8\u00cc \u0097\u00be\u00f8\u00ca\u00e0\u00ae\u00c6\u00a8\u00e5\u00c7\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u0097\u00bd\u00e5\u00be \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00c7 \u00be\u00f8\u00cc\u00e8 \u00a1\u0093\u00a8\u00c7\u00b8 \u00c2\u00c8\u00c6 \u00a1\u00e6\u00ba\u00f8 \u00a1\u0093\u00a8\u00c7\u00b8\u00c6\u00a8 \u00a1\u00e5\u00b3\u00e5\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00f9\u00be\u00e0\u00f3\u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8 \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u0095\u00cc, \u00a6\u00c4 \u00cc\u00be\u00e0\u00ba\u00a8\u00c6\u00b4 \u00c2\u00e5\u00bd\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00ba\u00cd\u00be\u008a\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nV \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00c0\u00d6\u00ca\u00f2\u00c9\u00c8 \u00a8\u00ed\u00c8\u00e9 \u00be\u00f8\u00c9\u00e6\u00cc\u00e8\u00c6\u00be\u00e0\n\n\u00a8\u00eb\u00c8\u00e9 \u00be\u00f8\u00c9\u00e6\u00cc\u00e8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c2\u00f3 \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00c6\u00fa\u00ba\u00e9\u00be\u00e0\u00ba\u00cd\u00be\u008a \u00ef\u00be\u00e5\u00a8\u00f8\u00d7\u00c4.\n\n2005 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00cc\u00ea\u00be\u00e5\u0095 (\u0097\u00ef\u00ca\u00e0\u00cb \u0097\u0093\u0097\u00bd\u00e5\u00be) \u00c0\u00be\u00ba17\n\nVI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00cc\u00ea\u00be\u00e5\u0095 \u00cc\u00cd\u00be\u00e5\u00bd\u00e5\u00c7 \u00ef\u00bc\u00e0\u00c0\u00ce \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00c9\u00e6\u00c7\u00bc\u00fa\n\n32.\u00cc\u00ea\u00be\u00e5\u0095 \u00cc\u00cd\u00be\u00e5\u00bd\u00e5\u00c7 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c4\u00ea\u00bc\u00c8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c6\u008a \u00ae\u00e2\u00ae\u00c8 \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9,\u00cc\u00e5\u00c0\u00c7\u00e5\u009e \u00c9\u00f1\u00c0\u00cd\u00c7\u00b8\u00c6, \u00cc\u00e5\u00c0\u00c7\u00e5\u009e \u0097\u00ca\u00e0\u00c9\u00e5\u00cc \u00c3\u00e5\u00c7\u00c6 \u00a8\u00b6\u00a8\u00f8\u00d7\u00c4, \u00ef\u00cc\u00e5\u00c7\u00a8\u00c4,\u00ba\u00f2\u00e5\u00cc\u00bc\u00e0\u00aa\u00f2\u00cd\u00b8\u00c6, \u00ef\u00a8\u00e5\u00c8\u00e0\u00c8\u00a8\u00e7\u00c4, \u00c9\u00e2\u00ae\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00ef\u00cc\u00e5\u00c7\u00a8\u008a \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00bc\u00e0\u00c0\u00ce\u00ba\u00c2\u00e5\u00aa\u00e6\u00be\u00f9\u00c4 \u00c6\u00be \u00c9\u00e6\u00c7\u00bc\u00fa \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a6\u00ef\u00cc\u00e0 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u008a \u00bc\u00fb\u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a6\u00c4 \u00c9\u00c7\u00bc \u00cc\u00bf\u00cd\u00e5 \u00c0\u00be\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00bc\u00b9\u00ea\u00c9\u00c4\u00ef\u00c4\u00be\u00e0 \u00ef\u00bc\u00aa\u00eb\u00b8\u00c6\u00a8\u00b4 \u00cc\u00c4\u00e5\u00be \u00bc\u00b9\u00ea\u00c9\u00c4\u00a8\u00b4 \u00a7\u00cd\u00ea \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n33.\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00cc\u00e8\u00e2\u00cd\u00c8 \u00cc\u00cd \u00ef\u00bc\u00c4\u00ce \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5 \u00a1\u00ba\u00c7\u00c6\u008a \u00a1\u00be\u00be\u00ea\u00a8\u00ed\u00c8\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00c9\u00ea\u00c9\u00ef\u00cd\u00e5\u00ba\u00e0, \u00a6\u0097\u00b4, \u00cc\u00e8\u00e2\u00cd\u00c8 \u00c3\u00e5\u00cb\u00e5 \u00c0\u00e5\u00b5\u00c6\u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6[2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6]\n\n\u00c0\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00c0\u00f2\u00e5\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00ef\u00c8\u00e0\u00a8\u008a \u00ef\u00a8\u00e5 \u00b5\u00e5\u00cc, \u00a6\u00be\u008a :\u2014\n\n1.\u00ef\u00a8\u00e5\u00ce\u00c5 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00ef\u00a8\u00e5\u00ce\u00c5, \u00ba\u00f8\u0096\u00d6\u00aa\u00cc\u00e0\u00c6\u00e5\u00c6, \u00ef\u00bc\u00cd\u00fa\u00c9\u00c8, \u00ef\u00c4\u00e5\u00c7\u00b4\u00ea\u00c9\u00cc\u00cd \u00c7\u00ba\u00e0\u00c4\u00c8\u00e5\u00be.\n\n2.\u00aa\u008a\u00c0\u00cd \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00e4\u00aa\u00c4\u00ea\u00c9 \u00cc\u00cd \u00c9\u00ba\u00e0\u00ba\u00c8.\n\n3.\u00a8\u00dd\u00ba\u00c7 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00c0\u00e5\u00be\u00f3\u00c7, \u00a8\u00dd\u00ba\u00c7 \u00cc\u00cd \u00ef\u0089\u00c7\u00e6\u00c9\u00c8.\n\n4.\u00aa\u00e5\u00c8\u00e0\u00c8 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00ef\u00c2\u00be\u00e0\u00ef\u00ba\u00e5\u00b4, \u00c2\u00c8\u00c0\u00e8\u0090\u00c6, \u00a1\u008a\u00c2\u00c8\u00be\u00e0\u00ef\u00aa\u00e5\u00b6,\u00cd\u00fa\u00a8\u00e0\u00a8\u00b6\u00ea\u00c9, \u00aa\u00e5\u00f5 \u00a8\u00b6\u00c9\u00ba\u00e0 \u00cc\u00ba\u00c7 \u00cc\u00cd \u00cd\u00c2\u00c7\u00e5\u00f4\u00c9.\n\n5.\u00c4\u00e5\u00ba\u00c7 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00c9\u00e6\u00c8\u00e8\u00aa\u00c4, \u00c4\u00e5\u00ba\u00c7 \u00a8\u00b6\u00c9\u00ba\u00e0 \u00cc\u00ba\u00c7, \u00ef\u00bc\u0097\u00be\u00ea\u00c9\u00c7\u00cc\u00cd \u00bc\u00fa\u00a8\u00e0\u00c9\u00e6\u00c8\u00e0\u00c8.\n\n6.\u00cd\u008a\u00c2\u00be\u00e0\u00ef\u00ba\u00e5\u00b4 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00ba\u00f8\u00cc\u00e0\u00cc\u00c4\u00cd\u00e5\u00c7\u00e5\u00c4\u00c6, \u00cd\u008a\u00c2\u00be\u00e0\u00ef\u00ba\u00e5\u00b4,\u00a1\u008a\u00c2\u00c8\u00be\u00e0\u00ef\u00ba\u00e5\u00b4 \u00cc\u00cd \u00ba\u00e2\u00aa\u00c8\u00e0\u00c8.\n\n7.\u00c6\u00e5\u00c0\u00be\u00c6 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00a4\u00ba\u00eb\u00c7\u00e6 \u00f4\u00c0\u00ba (\u00a8\u00c6\u00fa \u00cc\u00e0), \u00a8\u00c7\u00ef\u00c9\u0086\u0091, \u00ef\u00c0\u00e0\u00f3\u00c7\u00e6\u00ba\u00eb\u00b6\u00ea\u00c9, \u00ae\u00e5\u00c9\u00a8\u0083\u00ef\u0083\u00d6\u00c6, \u00a8\u00ef\u00c7\u00c6\u00fa\u00be\u00aa\u00da, \u00c4\u00c7\u00e6\u00ba\u00be\u00e0\u00a8\u00be\u00f8, \u00ef\u00ba\u00c8\u00e8\u00c0\u00e0\u00c0\u00ef\u00c8\u00c6\u00fa, \u00cc\u00cd\u00ef\u00b6\u00c8\u00e0\u00c0\u00e0\n\n8.\u00c4\u00ea\u00c8\u00ba\u00f8\u008c \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00ef\u00c6\u00e0 \u00c0\u00ea\u00ba\u00eb\u00a8\u00eb\u0091\u00c6\u00ea\u00c7\u00e6\u00c0\u00e0\u00c0\u00ea, \u00cc\u00cd \u00c4\u00d6\u00ef\u00ba\u008a\u00c0\u00ba\u00e0\u00ba\u00eb.\n\n\u00cc\u00ea\u00be\u00e5\u0095 \u00cc\u00cd\u00be\u00e5\u00bd\u00e5\u00c7\u00ef\u00bc\u00e0\u00c0\u00ce\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9\u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00bc\u00b8\u00e0\u00b6\u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec\u00a1\u00e6\u00ba\u00e6\u008a \u00c9\u00e6\u00c7\u00bc\u00fa \u00cc\u00bf\u00cd\u00e5\u00bc\u00b8\u00e0\u00b6\u00be."
