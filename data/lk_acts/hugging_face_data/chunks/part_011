00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00ac\u00d7\u00af\u00c6\u00af\u00c9\u00b4\u00c6\u00d5\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6 5\n\n\u00db\u0081\u00b8\u00bc\u00c6 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00ce\u00bf \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cc\u00b1\u00be\u008c\u00b8\u00b6\u00c6\u00ce\u00b6 \u00a9\u00b6\u00c8\u00bc\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af\u00db\u00e1\u00ce\u00ba\u00bb\u00c7\u00af\u00cd\u00c1\u00c7 \u00a3\u00be\u00c6\u00be\u00d7 \u00b9\u00d0\u00b6\u00c8\u00bb\u00bf\u008c\u00cd\u00be\u00c7 \u00a3\u00c1\u00bc\u00c6 \u00ba\u00c9\u00b4\u00c6\u00d5\u00b9\u00c6 \u00cc\u00b9\u00bd\u00be\u00c7\u00ba\u00c6\u00b0\n\n8\u00b0 (1) \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c7\u00b8\u00c1\u00bc\u00c6\" \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00a3+\u00c6\u00af\u00c9\u00af\u00c7\u00bc\u00b6\u00c6\u00cd\u00b6\u00c7\u00d52007 \u00a4\u00ba\u00c6 \u00a4\u00ae\u00d5 \u00cd\u00ba \u00ba\u00c7\u00b6\u00ba\u00c6 31 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u00bb\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00bd\u00c6\u00d0\u00db\u0081\u00b8\u00bc\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00f2\u00be\u00ba\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6\u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081 -\n\n(\u00a3)II \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00df\u00ba\u00c6 IV \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00df\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00d7\u00b4\u0081V \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00df\u00ba\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00a4\u00af\u00af\u00c6\u00e7\u0088\u00bb \u00a9\u00be\u00c6\u00ce\u00be\u00af\u00e0\u00bf\u00c6 \u00a9\u00b6\u00ce\u00b8\u00dc\u00ba\u00c6\"\n\n(\u00a4)III \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00a4\u00af\u00af\u00c6\u00d0\u00ce\u00bd\u00b7\u00c6\u00b6 \u00a9\u00be\u00c6\u00ce\u00be\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\"\u00cd\u00c1\u00de\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c7\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00ba\u00c7\u00bd\u00c6\u00bd\u00be\u00c7\u00ba\u00c6\u00b0\n\n(2) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00af\u00c9\u00c0\u00c6 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00a9\u00d7\u00e2\u00ba\u00c6\"\u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6\" \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00f2\u00be\u00ba\u00c6 \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u0081\u00bd\u00c8 \u00b9\u00bb\u00d9\u00ce\u00b4\u00bb\u00b6\u00c7\u00b6\u00be\u00c6 \u00a4\u00af\u00c7\u00d7\u00b0\n\n(3) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00af\u00c9\u00c0\u00c6 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00a9\u00d7\u00e2\u00ba\u00c6\u00a3\u00b6\u0081\u00af\u00ae\" \u00a3\u00c1\u00c6\u008c\u00b6\u00ba\u00c6 \u00e7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00b7\u00c6\u00b6\u00c7\u00be\u00c6\" \u00a3\u00b6\u0081\u00af\u00ae \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u0088\u00dd\u00af\u00c6\u00af\u00af\u00c6\u00e7\u0088\u00bb\u00d7\u00ba\u00c6\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0\u00db\u00b7\u00c6\u00b6\u00c8\u00bb\u00d7\u00ba\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00b9\u00bb\u00d9\u00ce\u00b4\u00bb\u00b6\u00c7\u008a\u00dd\u00b7\u00c6\u00b6\u00b6\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n9\u00b0 \u00b9\u00c7\u00bc\u00c7\u00e0\u00ba\u0081\u00bd\u00ba\u00c7\u00b8\u00d7\" \u00b6\u00c9\u00bc\u00c6\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00f2\u00be\u00ba\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00b8 \u00a5\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u00ce\u00bb\" \u00a3\u00b7\u00c6\u00b6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u0081\u00cd\u00b6\u00c7\u00b6\u00c7\u00b8 \u00b7\u00c8\u00ce\u00bc\u00af\u00e0\u00af\u00c6\u00d0\" \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u00ce\u00bb\u00dc\u00ba\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081 -\n\n(\u00a3)\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00db\u00bb\u00bd\u00c6\u00b1\u00c8 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00b8 \u00a9\u00be\u00c6\u00be\u00c7 \u00a4\u00af\u00af\u00c6\u00e7\u0088\u00bb\u00a9\u00be\u00c6\u00ce\u00be\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bd\u00c6\u00de\u00bf\u00c6 \u00a9\u00c1\u00bd\u00c6\u00ce\u00bd\u00dc\u00ba\u00c6 ;\n\n(\u00a4)\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00db\u00bb\u00bd\u00c6\u00b1\u00c8 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c7\u00b8 \u00a4\u00af\u00af\u00c6\u00d0\u00ce\u00bd\u00b7\u00c6\u00b6\u00a9\u00be\u00c6\u00ce\u00be\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\"\u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081 \u00f2\u00be\u00ba\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00be\u00c7\u00ba\u00c6\u00b0\n\n10\u00b0 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00b1\u00c8+\u00c6\u00af\u00bf\" \u00b6\u00ba\u00c8\u00c0\u00c6 \u00a7\u00ce\u00bc\u00af\u00e0\u00af\u00c6\u00af\u00c8\u00ce\u00b4\u00cd\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00ac\u00c1\u00c6\u00c1\u00c7\u00ce\u00ba \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\" \u00b1\u00c8+\u00c6\u00af\u00bf \u00a7\u00ce\u00bc\u00cd\u00bb \u00cd\u00ba\u00cd\u00be\u00c7+\u00c6\u00af\u00c8\u00b7\u00c8\u00bd\u00c6\u00bd\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0"
