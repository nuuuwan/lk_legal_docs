f2\u00be\u00db\u00ba\u00c6 ;\n\n\u0089\u00bc\u00c8\u00e2 8\u00a5\u0081 (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u201c\u00ab\u00ba\u00c6\u00b9\u00d7 \u00f4\u00b9\u00c7\u00ce\u00c1\u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00a5\u00dd\u00b9\u00d7 \u00f4\u00b9\u00c7\u00ce\u00c1\u008c\u00b3\u00c6\u00b1\u00c7\u00b6 \u00cd\u00ba\u00df\u00ba\u00c6 \u00ac\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00b9\u00b6\u00c6\u00b6\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6\u00d0\u00ce\u00bd\u00bb\u00c7\u00b6\u00d7\u00ba\u00c6 \u00ab\u00ba\u00c6\u00b9\u00b6\u00c7\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6 \u201c\u00a4\u008a\u00bc\u00ba\u00c6 \u00f4\u00b9\u00c7\u00ce\u00c1\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00b4 \u00cd\u00ba\u00df\u00ba\u00c6 \u00ac\u00dd\n\n1988 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u008163 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u