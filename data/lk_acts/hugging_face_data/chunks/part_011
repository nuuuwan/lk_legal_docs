    "chunk_text": "(2) \u00d0\u00bd\u00c6\u00bd\u00b3\u00c6\u00b1\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bc\u00c6 \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00b9\u00c7\u00bc\u00c6\u00af\u00c6\u00ce\u00af\u00b6\u00c8\u00cc\u00bb\u00c7\u00dd\u00c1\u00bc\u00c7\u00af\u008c\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\" \u00b6\u00ba\u00c6\u00ce\u00ba\u00b9\u00c6 \u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8\u00b6\u00c6\u00d7\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b9\u00c1\u00bc\u00c7\u00af\u00af\u00c6 \u00d0\u00bd\u00c6\u00bd\u00b3\u00c6\u00b1\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00aa\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c0\u00af\u00c6\u00d0\u00ce\u00bc\u00b3\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c6 \u00a5\u00be\u00c6\u00be\u00c7\u00b6\u00c8\u00dd\u00b9\u00c6\u0089\u0081\" \u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00b9\u00bf\u00c8\u00a3\u00bc\u00b1\u00c8\u0081 \u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6 \u00a3\u00b7\u00c6\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af \u00a3\u00bd\u00c8\u00e2\u00de\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00c0\u00af\u00c6\u00d0\u00ce\u00bc\u00b3\u00bc\u00c6\" (1) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (ii) \u00a4\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00c7\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9+\u00c6\u00af\u00ba\u00c8\u0081\u00bd\u00c8\" \u00d0\u00bd\u00c6\u00bd\u00b3\u00c6\u00b1\u00c7\u00b4\u00c6\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00ce\u00bc\u00b9\u00c6 \u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8\u00b6\u00c6\u00d7\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00b9\u00c1\u00bc\