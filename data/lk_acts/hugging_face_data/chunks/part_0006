d\u0dbd : \u025e. 36.00 \u0dad\u0dd0\u0db4\u0dd0\u0262 \u0d9c\u0dcf\u0dc3\u0dca\u01b1\u0dc0 : \u025e. 150.00\u023d\u0dbd : \u025e. 36.00 \u0dad\u0dd0\u0db4\u0dd0\u0262 \u0d9c\u0dcf\u0dc3\u0dca\u01b1\u0dc0 : \u025e. 150.00\n\n\u027c \u0dbd\u0d82\u0d9a\u0dcf\u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f\n\n\u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1\u0dc0\u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1\u0dc0\n\n2025 \u0d85\u0d82\u0d9a 4 \u0daf\u0dbb\u0db1 \u0d91\u0d9a\u01b1 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u01d0 2025 \u0d85\u0d82\u0d9a 4 \u0daf\u0dbb\u0db1 \u0d91\u0d9a\u01b1 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u01d0\n\n(\u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1) \u0db4\u0db1\u0dad(\u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1) \u0db4\u0db1\u0dad\n\n2025 \u0d85\u0d82\u0d9a 4 \u0daf\u0dbb\u0db1 \u0d91\u0d9a\u01b1 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u01d0 2025 \u0d85\u0d82\u0d9a 4 \u0daf\u0dbb\u0db1 \u0d91\u0d9a\u01b1 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u01d0\n\n(\u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1) \u0db4\u0db1\u0dad(\u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1) \u0db4\u0db1\u0dad 1\n\n[\u0dc3\u0dc4\u01af\u0d9a\u0dba \u0dc3\u0da7\u0dc4\u01e6 \u0d9a\u0dd9\u0dc5\u0dca 2025 \u0d85\u0dd9\u021e\u0262 \u0db8\u0dc3 11 \u0dc0\u0db1 \u01ce\u0db1][\u0dc3\u0dc4\u01af\u0d9a\u0dba \u0dc3\u0da7\u0dc4\u01e6 \u0d9a\u0dd9\u0dc5\u0dca 2025 \u0d85\u0dd9\u021e\u0262 \u0db8\u0dc3 11 \u0dc0\u0db1 \u01ce\u0db1]\n\n\u0d91\u0262.\u018c. -\u0d95 81/2024\n\n2002 \u0d85\u0d82\u0d9a 14 \u0daf\u0dbb\u0db1 \u0d91\u0d9a\u01b1 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u01d0 \u0db4\u0db1\u0dad 2002 \u0d85\u0d82\u0d9a 14 \u0daf\u0dbb\u0db1 \u0d91\u0d9a\u01b1 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u01d0 \u0db4\u0db1\u0dad\n\n\u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u026d \u0db4\u0db1\u0dad\u00fb\u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u026d \u0db4\u0db1\u0dad\u00fb\n\n\u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1\u0dc0 \u026a\u0286\u01e6 \u0dd9\u0db8\u0dd9\u0dc3\u0dca \u0db4\u0db1\u0dc0\u01e9 \u0dbd\u0dd0\u0dd9\u0229:-\n\n1. (1) \u0dd9\u023c \u0db4\u0db1\u0dad 2025 \u0d85\u0d82\u0d9a 4 \u0daf\u0dbb\u0db1 \u0d91\u0d9a\u01b1 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u01d0 (\u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1) \u0db4\u0db1\u0dad \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc4\u01ff\u01e6\u0dc0\u01e9 \u0dbd\u0dd0\u0dd9\u0229.\n\n(2) 3 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (1) \u0dc0\u0db1 \u0dd9\u0146\u0daf\u0dba \u0db8\u0119\u01e6 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u0dc4\u0dd0\u0dbb \u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae \u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u0dd9\u023c \u0db4\u0db1\u01ae \u0dd9\u0d9a\u017b\u023c\u0db4\u0dad \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1\u0dd9\u0269 \u0db4\u0db1\u0dad\u00fa \u0db6\u0dc0\u0da7 \u0db4\u01ae\u0dc0\u0db1 \u01ce\u0db1 \u0286\u0da7 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u026a\u0dba \u0252\u01b1 \u0dba.\n\n(3) 3 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (1) \u0dc0\u0db1 \u0dd9\u0146\u0daf\u0dba \u0db8\u0119\u01e6 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba 2024 \u0da2\u0db1\u0dc0\u0dcf\u025c \u0db8\u0dc3 1 \u0dc0\u0db1 \u01ce\u0db1\u0dd9\u024f \u01cf \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0db6 \u0d87\u01af \u0dd9\u0dbd\u0dc3\u0da7 \u0dc3\u0dbd\u0d9a\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0dba.\n\n2. (\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae \u023d\u01e6\u0db8\u01b1 \u201c\u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dba\u201d \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1) 2002 \u0d85\u0d82\u0d9a 14 \u0daf\u0dbb\u0db1 \u0d91\u0d9a\u01b1 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u01d0 \u0db4\u0db1\u0dd9\u01ae 2 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0db4\u025c\u01ce \u0dd9\u0db8\u0250\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229:-\n\n(1) \u0d92 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (1) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (\u0d86) \u0dd9\u0146\u0daf\u0dd9\u024f \u201c\u0d86\u0db1\u0dba\u0db1\u0dba \u00fb\u025d\u0db8 \u0db8\u0dad,\u201d \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0dd9\u0dc0\u01e9\u0dc0\u0da7,\u201c\u0d86\u0db1\u0dba\u0db1\u0dba \u00fb\u025d\u0db8 \u0db8\u0dad; \u0dd9\u0dc4\u0dcf\u0dca\u201d \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0d86\u0dd9\u01ca\u0dc1 \u00fb\u025d\u0dd9\u0db8\u01e6;\n\n(2) (1) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (\u0d86) \u0dd9\u0146\u0daf\u0dba\u0da7 \u0d89\u00fa\u022a\u01af\u0dc0 \u0db8 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0dd9\u0d9a\u0dcf\u0da7\u0dc3 \u0d86\u0dd9\u01ca\u0dc1 \u00fb\u025d\u0dd9\u0db8\u01e6:-\n\n\u201c(\u0d87) 2025 \u0d94\u00fa\u0dd9\u0dad\u0dcf\u0dca\u0db6\u0259 \u0db8\u0dc3 1 \u0dc0\u0db1 \u01ce\u0db1 \u0286\u0da7 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0dc0\u0db1 \u0db4\u025c\u01ce, \u01e7\u0259\u0dc0\u0dcf\u0286\u0d9a \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u026a\u0286\u01e6 \u027c \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u0286\u0179\u0db1 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u0dd9\u0dc0\u0dad \u0d89\u0dd9\u0dbd\u00fa\u0dd9\u017e\u0dcf\u01e7\u0d9a \u0dd9\u0269\u01ce\u0d9a\u0dcf\u0dc0\u00fa \u0dc4\u0dbb\u0dc4\u0dcf \u0dd9\u0dc3\u0dca\u0dc0\u0dcf \u0dc3\u0dd0\u0db4\u0251\u0db8 \u0db8\u0dad,\u201d;\n\n\u0265\u0291\u01a8 \u0db1\u0dcf\u0db8\u0dba \u0dc4\u0dcf \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u026b\u0dd9\u023c \u01ce\u0db1\u0dba\n\n2002 \u0d85\u0d82\u0d9a 14 \u0daf\u0dbb\u0db1 \u0db4\u0db1\u0dd9\u01ae 2 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u00fb\u025d\u0db8\n\n2025 \u0d85\u0d82\u0d9a 4 \u0daf\u0dbb\u0db1 \u0d91\u0d9a\u01b1 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u01d0 2025 \u0d85\u0d82\u0d9a 4 \u0daf\u0dbb\u0db1 \u0d91\u0d9a\u01b1 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u01d0"
