    "chunk_text": "\u0daf\u0dd2\u0dc3\u0dca\u0dad \u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dba \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\n\n8 2025 \u0d85\u0d82\u0d9a 1 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\n\n\u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca (\u0dc0\u0dd2\u0dc1 \u0dda\u0dc2 \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1) \u0db4\u0db1\u0dad\n\n\u0daf\u0dd2\u0dc3\u0dca\u0dad \u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dba \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\n\n9\n\n2025 \u0d85\u0d82\u0d9a 1 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\n\n\u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca (\u0dc0\u0dd2\u0dc1 \u0dda\u0dc2 \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1) \u0db4\u0db1\u0dad\n\n\u0daf\u0dd2\u0dc3\u0dca\u0dad \u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dba \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\n\n10 2025 \u0d85\u0d82\u0d9a 1 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\n\n\u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca (\u0dc0\u0dd2\u0dc1 \u0dda\u0dc2 \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1) \u0db4\u0db1\u0dad\n\n17 \u0dc4\u0dbb \u0dad\u0db8\u0dbd\u0dca \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 18 \u0dc4\u0dbd\u0dca\u0dd4 \u0db8\u0dca\u0db8\u0dd4\u0dbd\u0dca\u0dbd \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 (23) \u0dc1\u0db8\u0ddc\u0dab\u0dbb\u0dcf\u0d9c\u0dbd 1 \u0db6\u0dd2\u0db6\u0dd2\u0dbd \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 2 \u0dd9\u0dd0\u0daf\u0db1\u0dd9 \u0db4 \u0dbb\u0dcf\u0db8\u0dda\u0dba \u0dba \u0dc3\u0dcf\u0dcf\u0dc0 3 \u0dd9\u0da9\u0dd4\u0db