    "chunk_text": "10. \u00c6\u008a \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00c9\u00e5\u00da\u00ba\u00e5 \u00a1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00c3\u00e5\u00c7\u00aa\u00ba\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea\u00c9\u00a8\u00e0\u00a2\u00ef\u00c8\u00a8\u00e0\u00b4\u00f2\u00e5\u00be\u00f8\u00a8\u00c9 \u00cc\u00e8\u00f3 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9\u00b4 \u00c6\u008a \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00c6\u00a8\u00b4, \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c\u00ef\u00bc\u00c0\u00e5\u00da\u00ba\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9\u00a8\u00b4, \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00b4, \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00b4\u00ef\u00cd\u00e5\u00e0 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00be \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u00a8\u00b4\u00c2\u00c8\u00a8\u00c7 \u00a2\u00c8\u00e0\u00c8\u00e5 \u00cc\u00e8\u009b\u00c4, \u00ef\u00c4\u00cd\u00fa \u00e4\u00b4 \u00a2\u00cd\u00ba\u00f8\u00be\u00e0 \u00c9\u00ec \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8 \u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba\u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00f8\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u00c4\u00a8\u00e0 \u00ef\u00be\u00e5\u00c0\u00e6\u00c9\u00ef\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\nIII \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00aa\u00fa\u0097\u00cc\u00ea\u008a\n\n\u00a2 \u00ef \u00c8 \u00a8 \u00e0 \u00ef \u00b4 \u00f2 \u00e5 \u00be \u00f8 \u00a8\u00cc\u00e0\u00c9\u00c7\u00e7\u00c0\u00ef\u00c6\u00e0\u00c9\u00be \u00aa\u00e6\u00cc \u00c6\u00be\u00e5\u00bc\u00fa\u00ef\u00c6\u00cd\u00e8\u00c0\u00ce\u00a8\u00e8\u00d7\u00c4\u00be\u00f8\u00cc\u00e8 \u00c0\u00ce\u00a8\u00f8\u00d7\u00c4\u00a8\u00e0 \u00ef\u00c8\u00cc\u00cc\u00e6\u00c8\u00ef\u00a8\u00be \u00c2\u00c9.\n\n\u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8\u00aa\u00fa\u0097\u00cc\u00ea\u008a.\n\n\u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0,\u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8\u00cc\u00e0\u00c9\u00c7\u00e7\u00c0\u00ef\u00c6\u00be\u00e0\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c6\u00c6\u00fa \u00c2\u00c8 \u00a8\u00f8\u00d7\u00c4\u00b4\u00a1\u00c6\u00fa\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c2\u00c9.\n\n2006 \u00a1\u00e2\u00a8 19 \u00bc\u00c7\u00be \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c0\u00be\u00ba7\n\n12. (1) \u00c4\u00ec\u00c8\u00e5\u00c7\u008a\u00c3\u00a8 \u00cc\u00cd \u00c8\u00e8\u00c0\u00e8\u00be\u00c6 \u00cd\u00fa\u0095\u00a8\u00c7\u00e6 \u00a1\u00ba\u00c7 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c9\u00a6\u00a8\u00ad\u00d1\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00e0\u00be\u008a \u0095\u00cc, \u00c6\u008a \u00bc\u00ba\u00e0\u00ba \u00c0\u00b8\u00e8\u00c9\u00ea\u00b6\u00c6\u00a8\u00e0, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6\u00a8\u00e0_\n\n(\u00a1)\u00a6\u00cd\u00fa \u00c4\u00ec\u00c8\u00e5\u00c7\u008a\u00c3\u00a8 \u0097\u00cc\u00e8\u00be\u00e0 \u00c4 \u00c6\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00be\u008a ;\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00bc\u00ba\u00e0\u00ba \u00c0\u00b8\u00e8\u00c9\u00ea\u00b6\u00c6, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8\u00c9\u00e5\u00da\u00ba\u00e5\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0\u00c4\u00ec\u00c8\u00e5\u00c7\u008a\u00c3\u00a8 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00cd \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c2\u00c8\u00c6\u00c8\u00ba\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c6\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00be\u008a ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e6)\u00c4\u00ec\u00c8\u00e5\u00c7\u008a\u00c3\u00a8 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00e0\u00c9\u00c6\u00e2\u00a8\u00f2\u00e9\u00c6\u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c6\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00be\u008a,\n\n\u00a6\u00c6 \u00c4\u00ec\u00c8\u00e5\u00c7\u008a\u00c3\u00a8 \u0097\u00cc\u00e8\u00be\u00e0 \u00c4 \u00c6\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00bc\u00ba\u00e0\u00ba \u00c0\u00b8\u00e8\u00c9\u00ea\u00b6\u00c6\u00a8\u00e0,\u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00c4\u00ec\u00c8\u00e5\u00c7\u008a\u00c3\u00a8 \u00cc\u00cd \u00c8\u00e8\u00c0\u00e8\u00be\u00c6 \u00cd\u00fa\u0095\u00a8\u00c7\u00e6 \u00a1\u00ba\u00c7 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00c9 \u00a6\u00a8\u00ad\u00d1\u00c4\u00a8\u00e0\u00a1\u00e6\u00ba\u00e0\u00be\u008a \u0095\u00cc, \u00bc\u00ba\u00e0\u00ba \u00c0\u00b8\u00e8\u00c9\u00ea\u00b6\u00c6\u00a8, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8,\u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6\u00a8 \u00c4\u00ec\u00c8\u00e5\u00c7\u008a\u00c3\u00a8\u00ef\u00aa\u00e0\u00bc\u00ba\u00e0\u00ba \u00c0\u00b8\u00e8\u00c9\u00ea\u00b6\u00c6\u00a8\u00e0, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc \u00a6\u00cd\u00fa \u00c8\u00e8\u00c0\u00e8\u00be\u00c6 \u00cd\u00fa\u0095\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c8\u00a8\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7 _\n\n(\u00a1) \u00a6\u00c4 \u00bc\u00ba\u00e0\u00ba \u00c0\u00b8\u00e8\u00c9\u00ea\u00b6\u00ef\u00c6\u00e0, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0,\u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00c9\u00e5\u00da\u00ba\u00e5\u00ef\u008c \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00ef\u00c6\u00e0\u00cc\u00ba\u00f1\u00c9\u00ba\u00e0 \u00c3\u00e5\u00c9\u00c6 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00cc\u00e6\u00a8 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00c8\u00e8\u00c0\u00e8\u00be\u00c6 \u00cd\u00fa\u0095\u00a8\u00c7\u00e6\u00b4\u00ef\u00cd\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00be\u008a ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5) \u00a6\u00c4 \u00bc\u00ba\u00e0\u00ba \u00c0\u00b8\u00e8\u00c9\u00ea\u00b6\u00c6, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6,\u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6 \u00cc\u00ba\u00f1\u00c9\u00ba\u00e0\u00ef\u00be\u00e5\u00c9\u00be \u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00a8\u00f9\u00c4\u00b4, \u00c8\u00e8\u00c0\u00e8\u00be\u00c6 \u00cd\u00fa\u0095\u00a8\u00c7\u00e6 \u00bc\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00cc\u00cd\u00aa\u00ba \u00c0\u00f2\u00ef\u008c\u00cc\u00c4\u00a8\u00f8\u00be\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00a8\u00c7\u00be \u00c8\u00bc \u00be\u008a \u00c8\u00e8\u00c0\u00e8\u00be\u00c6\u00cd\u00fa\u0095\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00e6\u00be\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb\u00c9 \u00ba\u00f8\u00c2\u00ea\u00b8\u00ea \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00c7\u00e6\u00b8\u00ea\u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00ef\u00be\u00e5\u00c0\u00c9\u00ba\u00f8\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a,"
