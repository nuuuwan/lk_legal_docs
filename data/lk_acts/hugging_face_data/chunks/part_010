    "chunk_text": "\u201c\u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u201d \u00c6\u00be\u00e0\u00be\u00b4, \u00c6\u008a \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u00ef\u00c9\u00a8\u00e0, \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8\u00ef\u00c6\u00a8\u00e0, \u00ef\u00bc\u00e0\u00c0\u00ce\u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00a8\u00ef\u00c6\u00a8\u00e0, \u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00e6\u00ef\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00c8\u00a8 \u00cc\u00e2\u0097\u00bd\u00e5\u00be\u00c6, \u00c0\u00e5\u00c8\u00be\u00c6 \u00ef\u00cd\u00e5\u00e0\u00a8\u00ce\u00c4\u00be\u00e5\u00a8\u00c7\u00b8\u00c6 \u00cc\u00ba\u00eb\u00c9 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00bc ; \u00c6\u008a\u00a6\u00e0\u00a8\u00a8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00a8\u00c7\u00be \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a6\u00e0 \u00a6\u00e0\u00a8\u00a8\u00c3\u00e5\u00c7\u00ef\u00c6\u00e0 \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c0\u00ba\u00e0\u00a8\u00c7\u00be \u00c8\u00bc \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00bc,\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00be \u00be\u00c4\u00ea\u00ba\u00e0, \u00ef\u00c0\u00e5\u00c8\u00e0\u00c4\u00e3\u00a8\u00c7\u00e6\u00ef\u00c9\u00a8\u00e0 \u00a3\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00be\u00e5\u00ef\u008c ;\n\n3042006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba\n\n\u201c\u00a6\u00e0\u00a8\u00a8 \u00c3\u00e5\u00c7\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00cc\u00cd \u0097\u00be\u00f8\u00c4\u00c6 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0\u00cc\u00c3\u00e5\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00e0\u00a8\u00a8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00ef\u00bc\u00be \u00c8\u00bc\u00c6\u008a \u00a6\u00e0\u00a8\u00a8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c;\n\n\u201c\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c6\u008a \u00c9\u00da\u00cb\u00c6\u00a8 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc \u00c0\u00ce\u00c4\u00ea\u00c9\u00be\u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00d1 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00a6\u00ce\u00ef\u00c5\u00be \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00c4\u00e5\u00da\u00ba\u00eb\u00c4\u00cc \u00ba\u00f8\u00cc\u00e0\u00a6\u00a8\u00e0\u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00be \u00c4\u00e5\u00cc \u00ef\u00bc\u00e5\u00ce\u00cd\u00a8\u00a8\u00e5\u00c8\u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00b4 \u00a2\u00cd\u00ba\u00f8\u00be\u00e0 \u00c9\u00ec \u00c9\u00da\u00cb\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00c6\u00a8\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9\u00c4 \u00c9\u00ec \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc \u00ba\u00f8\u00cc\u00e0\u00a6\u00a8\u00e0\u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0\u00a1\u00c9\u00cc\u00be\u00e0 \u00c9\u00be \u00c4\u00e5\u00cc \u00ef\u00bc\u00e5\u00ce\u00cd\u00a8 \u00a8\u00e5\u00c8\u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\nXXXIII \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n2000 \u00a1\u00e2\u00a8 38 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba \u00a1\u00bc\u00e5\u00ce \u00a8\u00f8\u00d7\u00c4\n\n218.(1) 2006 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 01 \u00c9\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9\u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3 \u00c9\u00be \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c6\u008a \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c2\u00bc\u00e0\u00bc\u00a8\u00b4,2000 \u00a1\u00e2\u00a8 38 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba \u00a1\u00bc\u00e5\u00ce \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n(2) 2000 \u00a1\u00e2\u00a8 38 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00c6\u008a \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0\u00c6\u00b4\u00ef\u00ba\u00e0, \u00a6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00ef\u00c6\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00c8\u00e5\u00c3 \u00cc\u00cd, \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00cc\u00cd 2000 \u00c4\u00e5\u00da\u00ba\u00eb 31 \u00c9\u00be \u00bc\u00fa\u00be\u00bc\u00fb \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00a6\u00e0 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00ef\u00c9\u00be\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00ef\u00aa\u00d1 \u00a2\u00ba\u00f8\u00d6\u00c9\u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa \u00a6\u00e0 \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00c6\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c (1)\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00be\u00f8\u00cc\u00e5 \u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00be\u00b4, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa,\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00a6\u00e0 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00cc\u008a\u00c0\u00ec\u00da\u00b8 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00a6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00a9\u00b8\u00e0\u00b6\u00c9 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00c0\u00c9\u00ba\u00f8\u00be\u00e0\u00be\u00a8\u00e0 \u00ef\u00c4\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00ef\u00cc\u00e0 \u00a1\u00a9\u00b8\u00e0\u00b6\u00c9 \u00c0\u00e6\u00c9\u00ba\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n2000 \u00a1\u00e2\u00a8 38 \u00bc\u00c7\u00be\u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c0\u00be\u00ba \u00a1\u00bc\u00e5\u00ce \u00a8\u00f8\u00d7\u00c4.\n\n3052006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba"
