    "chunk_text": "(i)\u00a6\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6, \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00c6 \u00c8\u00c2\u00e5 \u00ef\u00bc\u00be\u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00be\u00e0 \u00cc\u00c0\u00c6\u00be \u00a8\u00b6\u00bc\u00e5\u00cc\u00e8 \u00c4\u00ba \u00c4\u00ea\u00f7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0\u00c6\u008a \u00a1\u00e6\u00cc\u00ea\u00c7\u00e6\u008a \u00f7\u00c9\u00f1\u00c6\u00be\u00e0 \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cd\u00e5\u00e0\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00c9\u00be \u0097\u00b4, \u00c0\u00be\u00cd\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00c9\u00be\u00e0\u00be\u00e5\u00c9\u00ec \u00bc;\n\n\u00c6\u008a \u00be\u00c9 \u00a8\u00e5\u00da\u0095\u00a8\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8 \u00c8\u00e5\u00c3\u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u008a\u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba45\n\n(ii)\u00a6\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6 \u00a2\u00cd\u00ba (i) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0\u00ef\u00be\u00e5\u00c9\u00be \u00ef\u00c9\u00be\u00ba\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00c9\u00be \u0097\u00b4, \u00ef\u00bc\u00cc\u00e9\u00c6\u00a8\u00b4\u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc,\n\n\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n(\u00a1)\u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00ef\u00c4\u00cd\u00fa \u00ef\u00bc\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u2018\u00a1\u2019 \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00c6\u00a8\u00e0 \u00ba\u00eb\u00ce \u00c0\u00e8\u00cd\u00fa\u00b4\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb II \u00c9\u00be \u00ba\u00f9\u00c7\u00ef\u00c6\u00e0(\u00a1) \u00a1\u00be\u00ea\u00ba\u00f9\u00c7\u00c6 \u00ba\u00eb\u00c8 ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00ef\u00c4\u00cd\u00fa \u00ef\u00bc\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u2018\u00a1\u00e5\u2019 \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00c6\u00a8\u00e0 \u00ba\u00eb\u00c8 \u00c0\u00e8\u00cd\u00fa\u00b4\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb II \u00c9\u00be \u00ba\u00f9\u00c7\u00ef\u00c6\u00e0(\u00a1\u00e5) \u00a1\u00be\u00ea\u00ba\u00f9\u00c7\u00c6 \u00ba\u00eb\u00c8,\n\n\u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n\u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\nI \u00c9\u00be \u00ba\u00f9\u00c7\u00c6 II \u00c9\u00be \u00ba\u00f9\u00c7\u00c6\n\n\u00a1\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00c4\u00ea\u00bc\u00c8\u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00c9\u00c8\u00e8\u00be\u00e0\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0095\u00c8\u00e8\u00c6\u00be \u00c9\u00c8\u00e8\u00be\u00e0\n\n\u201c\u00a1\u00eb\u201d \u00a4\u00c0\u00ba\u00f9\u00c7\u00c6\u201c\u00a1\u00e5\u201d \u00a4\u00c0\u00ba\u00f9\u00c7\u00c6\n\n30 \u00b4 \u00c9\u00e6\u0091 \u00a6\u00ef\u00cd\u00ba\u00e0 50 \u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u009157\n\n50 \u00b4 \u00c9\u00e6\u0091 \u00a6\u00ef\u00cd\u00ba\u00e0 100 \u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u009168\n\n100 \u00b4 \u00c9\u00e6\u0091810\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba46\n\n\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\n\n\u201c\u00a1\u201d \u00ef\u00a8\u00e5\u00b4\u00cc\u201c\u00a1\u00e5\u201d \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00aa\u008a\u00c0\u00cd \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00ce\u00c5 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u2013\u201c\u00a1\u201d \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00c9\u00c8 \u00c4\u00e5\u00c6\u00fa\u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0\u00c6\u008a \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00c6\u00a8\u00e0; \u00cc\u00cd\u00cc\u00c4\u00aa \u0095\u00ca\u00f2 \u00c9\u00be\u00ea\u00ef\u00c6\u00e0 \u00c6\u008a \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u2013\u00aa\u008a\u00c0\u00cd \u00cc\u00cd \u00ef\u00a8\u00e5\u00ce\u00c5 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be\u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00c6\u00a8 \u00c4\u00e5\u00c6\u00fa\u00c4\u00a8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8, \u00cd\u00e6\u00c7 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a\u00bc, \u00a6\u00c4 \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00c6. \u00c0\u00d6\u00c0\u00e5\u00c8\u00be \u00bc\u00fa\u00cc\u00e0\u00ba\u00f2\u00e8\u00a8\u00e0\u00a8\u00c6\u00a8\u00e0.\n\n(4) (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 II \u00c9\u00be \u00ba\u00f9\u00c7\u00ef\u00c6\u00e0(\u00a1) \u00a1\u00be\u00ea\u00ba\u00f9\u00c7\u00ef\u00c6\u00cd\u00fa \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e5) \u00a1\u00be\u00ea\u00ba\u00f9\u00c7\u00ef\u00c6\u00cd\u00fa \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9-\n\n(\u00a1)(1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00be\u00c9 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6, \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00ec\u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c9\u00c8\u00e8\u00be\u00e0 \u00c8\u00e5\u00c3 \u00c8\u00e6\u009f\u00c4 \u00a1\u00e5\u00da\u008a\u00c3 \u00a8\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0\u00a1\u00e5\u00c7\u008a\u00c3\u00c6; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00c6\u008a \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u00c9\u00e5\u00be\u00f8\u00b0 \u00ef\u00c4\u00ef\u00cd\u00c6\u00ea\u008a \u00a1\u00e5\u00c7\u008a\u00c3 \u00a8\u00ce \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00c6 \u00a1\u00e5\u00c7\u008a\u00c3\u00d1\u00ef\u008a \u00cc\u00e8\u00b4 \u00aa\u00b8\u00be\u00e0 \u00c2\u00c8\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ba\u00eb\u00be\u00a8\u00b4\u00c9\u00b6\u00e5 \u00c9\u00e6\u0091 \u00ef\u00be\u00e5\u00c9\u00be \u00a8\u00e5\u00c8\u00c6\u00a8 \u00bc\u00fb \u00ef\u00c6\u00ef\u00bc\u00be \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0\u00a1\u00e5\u00c7\u008a\u00c3\u00c6,\n\n\u00c6\u00be \u00ef\u00bc\u00ef\u00a8\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a6\u00ce\u00ef\u00c5\u00be \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00a1\u00e5\u00c7\u008a\u00c3\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4\u00a1\u00e5\u00c7\u008a\u00c3 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n21. (1) (2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00be\u00e6\u00c9\u00ba \u00cc\u00e0\u00bb\u00e5\u00be\u00aa\u00ba \u00a8\u00c7\u00be \u00c8\u00bc\u00c6\u008a \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00f8\u00be\u00e0, \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00b4 \u00c8\u00e6\u00ef\u00c2\u00be, 3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5)\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9, \u00a6\u00ef\u00cd\u00ba\u00e0 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00c9\u00ba\u00e0\u00a8\u00c4\u00a8\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0\u00ef\u00be\u00e5\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec, \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4, (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00c0\u00cd\u00a8 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00cc\u00e7\u00c4 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00c4 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
