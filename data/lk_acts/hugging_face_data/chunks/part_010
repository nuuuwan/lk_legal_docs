    "chunk_text": "(iii) \u00af\u00c7\u00d2 \u00b6\u008c\u00bc\u00c6\u00b7\u00c6\u00b6 \u00cd\u00c1\u00de \u00a4\u00b6\u00b8\u00ba\u00c7\u00af \u00a5\u00dd\u00af\u00c6\u00d0\u00ba\u00c8\u00b4\u00b6\u00c6\u00d7\"\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a4\u00b6\u00b8\u00ba\u00c6 \u00b6\u00c1\u00ce\u00b5 \u00b6\u00c1\u00bd\u00c8\u00bb\u00c1\u00bc\u00d7\"\u00cc\u00b1\u00be\u008c\u00df\u00ba\u00c6 \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u0089\u00df\u00ba\u00c6 \u00ab\u00b7\u00c6\u00d7 \u00b7\u00c7\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00b6\u00c1\u00ce\u00b5\u00b6\u00c1\u00bd\u00c8\u00bb\u00c1\u00bc\u00c6 \u00a5\u00b7\u00c6\u00b6 \u00ab\u00b7\u00c6\u00d7 \u00b7\u00c7\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00bf\u00c6\u00bf\u00c7\u00af \u00b6\u00c1\u00ce\u00b5\u00b6\u00c1\u00bd\u00c8\u00bb \u00c1\u00bc\u00c8\u00ce\u00bb\u00b1\u00c6 \u00cc\u00b1\u00be\u00e2\u00af\u00e0\u00b4\u00d9\u00ba\u00c6 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00e0\u00b4\u00d9\u00ba\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00c7\u008c\u0088\u0081\" \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00a3\u00b6\u00c8\u00b9\u00bc\u00c6\"\u00a7\u00b6\u008c \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af \u00a3\u00b6\u00c8\u00b9\u00bc\u00c6\" \u0089\u00d2\u00af\u00c6\u00af\u00c7\u00be\u00c6\" \u0089\u00bc\u00b6\u00c8\u00b9\u00c6\u0089\u00d2\u00af\u00c6\u00af\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00bc\u00c8 \u00cd\u00b1\u00af\u00bc\u00c8\u00b9\u00c6\u00b9\u00c7\u00bf\u00bc\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00a4\u00b6\u00b8\u00b6\u00c6\u00ce\u00b6\u00b9\u00c6 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af \u00aa\u00be\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u008c\u00bd\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00b1\u00c6\u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00a3\u00be\u00c6\u00be\u00d7 \u00