    "chunk_text": "\u00a6\u00ef\u00cc\u00e0 \u00bc\u00c7\u00be \u00c8\u00bc \u0097\u00c6\u00bc\u008a ;\n\n(\u00a1\u00e7)\u00cc\u00e0\u00c9\u00c6\u00e2 \u00db\u00a8\u00f8\u00c6\u00e5\u00c9\u00c8 \u00be\u00f8\u00c6\u00ea\u00ba\u00eb \u00c9\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00bc \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00e8\u00cc\u00e8\u00be\u00e0 \u00ba\u00ba\u00e0\u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7\u00be \u00c8\u00bc\u00e0\u00bc\u00e5\u00c9\u00ec \u00bc \u00a1\u00da\u00bb\u00cc\u00e5\u00bd\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8\u00b4 \u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c6\u008a\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 ;\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9\u00bc \u00a8\u00c7\u00be \u00c8\u00bc \u00a6\u00c4 \u00bc\u00e5\u00c6\u00a8 \u00c4\u00ea\u00bc\u00c8 \u00a6\u00c4 \u00c0\u0091\u00be\u0091\u00c9\u00c8\u00e8\u00be\u00e0\u00cc\u00e8\u00c6\u00c6\u00b4 \u00ef\u00bc\u00e5\u00ce\u00cd\u00a8\u00e0 \u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00ef\u00cc\u00e0 \u00a2\u00a8\u00e0\u00c4\u00c9\u00e5\u00c6\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\u00e8\u00be\u00e0 \u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a \u00c8\u00c2\u00be \u00ef\u00aa\u00d1\u00c4\u00a8\u00e0 \u00cc\u00e2\u00c6\u00ea\u00a8\u00e0\u00ba \u00ef\u00be\u00e5\u00c9\u00be\u00c2\u00c9 \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(\u00a3)\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0-\n\n(i)1994 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be \u0097\u00bc\u00f1\u00e5\u00c9 \u00cd\u00e5 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00c6 \u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea\u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00a8\u00e5\u00da\u0095\u00a8 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4 ;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba92\n\n(ii)\u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1973 \u00a1\u00e2\u00a8 31 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00bc\u00be\u00c4\u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00bc\u00be\u008a \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4 ;\n\n(iii)1978 \u00a1\u00e2\u00a8 1 \u00b4\u00c9\u00da \u00ef\u00cd\u00e5\u00e0\u00c8\u00e0 \u00c7\u00ad\u00cd\u00c8 \u00c0\u00bc\u00be\u00c4 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00c8\u00bc \u00b4\u00c9\u00da \u00ef\u00cd\u00e5\u00e0\u00c8\u00e0 \u00c7\u00ad\u00aa\u00c8 \u00c0\u00bc\u00be\u00c4\u00b4 ;\n\n(iv)1979 \u00a1\u00e2\u00a8 53 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00be\u00c9 \u00be\u00f8\u00c0\u00e6\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00bc\u00fa\u00d6\u00aa\u00e6\u00be\u00e0\u00d1\u00ef\u008a \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00be\u00c9\u00be\u00f8\u00c0\u00e6\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00a8\u00e5\u0095\u00cc\u00c4\u00b4 ;\n\n(v)\u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1975 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be \u00a6\u00cc\u00e0. \u00b6\u0089\u00c8\u00e8\u008c.\u00a1\u00e5\u00da. \u009c. \u00c2\u00b8\u00e0\u00b6\u00e5\u00c7\u00be\u00e5\u00c6\u00a8 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u00be\u00ea\u00cc\u00e0\u00c4\u00c7\u00b8 \u00c0\u00bc\u00be\u00c4\u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00a6\u00cc\u00e0. \u00b6\u0089\u00c8\u00e8\u008c. \u00a1\u00e5\u00da. \u009c.\u00c2\u00b8\u00e0\u00b6\u00e5\u00c7\u00be\u00e5\u00c6\u00a8 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u00be\u00ea\u00cc\u00e0\u00c4\u00c7\u00b8 \u00c0\u00bc\u00be\u00c4\u00b4 ;\n\n(vi)1981 \u00a1\u00e2\u00a8 55 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00ec\u00c8\u00e8\u00a8 \u00a1\u00bd\u00f1\u00c6\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00ec\u00c8\u00e8\u00a8 \u00a1\u00bd\u00f1\u00c6\u00be\u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4 ;\n\n(vii)1982 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00bc\u00c5\u00c8 \u00a1\u00e5\u00c6\u00ba\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00bc\u00c5\u00c8 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4 ;\n\n(viii)1984 \u00a1\u00e2\u00a8 18 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00ea\u00f7\u00b8 \u00a1\u00e5\u00c6\u00ba\u00be \u00c0\u00be\u00ba\u00f8\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00ea\u00f7\u00b8 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4 ;\n\n(ix)1994 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be \u0097\u00bc\u00f1\u00e5\u00c9 \u00cd\u00e5 \u0097\u00bc\u00f1\u00e5 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00c6 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00be\u00d1\u00be \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00e8\u00a8\u0097\u00bc\u00f1\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00a1\u00e5\u00ba\u00da \u00cc\u00e9. \u00a8\u00e0\u00c8\u00e5\u00a8\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4 ;\n\n(x)1988 \u00a1\u00e2\u00a8 53 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8 \u00a1\u00bd\u00f1\u00c6\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8 \u00a1\u00bd\u00f1\u00c6\u00be\u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00b4 ;\n\n(xi)1988 \u00a1\u00e2\u00a8 77 \u00bc\u00c7\u00be \u00ef\u00d9. \u00a1\u00e5\u00da. \u00b0\u00c6\u00c9\u00da\u00bd\u00be \u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ef\u00d9. \u00a1\u00e5\u00da. \u00b0\u00c6\u00c9\u00da\u00bd\u00be\u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00b4,\n\n\u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00ba\u00f1\u00e5\u00aa\u00c6\u00a8\u00e0 ;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba93\n\n(\u00a4)\u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00bc\u00fb \u00ef\u00aa\u00c9\u00be \u00c8\u00bc\u2014\n\n(i)\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00ba\u00eb\u00be\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0 \u00ba\u00eb\u00ce \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c9\u00c9\u00e5\u00d6\u00a8\u00c6 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb (\u00cd\u00ea\u00f3 \u00c0\u00d6\u00ba\u00f1\u00e5\u00aa \u00c7\u00a8\u00e0\u00cb\u00b8 \u00a7\u00c0\u00e0\u00c0\u00ea\u00c9\u00a8\u00e0\u00ef\u00be\u00e5\u00c9\u00be) \u00d5\u0097\u00ba \u00c7\u00a8\u00e0\u00cb\u00b8 \u00a7\u00c0\u00e0\u00c0\u00ea\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 ;\n\n(ii)\u00ef\u00ef\u00c9\u00bc\u00f1 \u00c7\u00a8\u00e0\u00cb\u00b8 \u00a7\u00c0\u00e0\u00c0\u00ea\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5,\n\n\u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a4\u00c0\u008e\u00ba \u00d1 \u00ba\u00f8\u00ef\u00c2\u00be, \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00bc\u00fb \u00be\u00f8\u00a8\u00eb\u00ba\u00e0\u00a8\u00c7\u00be \u00c8\u00bc \u00a6\u00c9\u00e6\u00be\u00f8 \u00c6\u008a \u00a7\u00c0\u00e0\u00c0\u00ea\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00bc\u00fb\u00ef\u00aa\u00c9\u00be \u00c9\u00e5\u00d6\u00a8 \u00ef\u00be\u00e5\u00c9\u00be \u00c6\u008a \u00c9\u00e5\u00d6\u00a8 ;"
