    "chunk_text": "\u201c\u00c0\u00e6\u00cd\u00e6\u00bc\u00fa\u00ce\u00e8 \u00a8\u00f8\u00d7\u00c4 2 :\u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5,\u00a1\u00b6\u008a\u00ef\u00ba\u00e0 \u00b4\u008a \u00a8\u00f8\u00d7\u00c4\u00b4 363 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e0\u00ba\u00f2\u00e9 \u00f4\u00cb\u00b8\u00c6\u00c2\u00c9\u00b4 \u00c0\u00ba\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 365\u00a1\u00e5 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec\u00c2\u00c7\u00c0\u00ba\u00c8 \u00c8\u00e8\u00e2\u00aa\u00fa\u00a8 \u00a1\u00c0\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00a8\u00e0\u00ef\u00be\u00e5\u00c9\u00be \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u0097\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\u201d.\n\n(2)\u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00e6\u00cd\u00e6\u00bc\u00fa\u00ce\u00e8 \u00a8\u00f8\u00d7\u00c4 2 \u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00c0\u00e6\u00cd\u00e6\u00bc\u00fa\u00ce\u00e8 \u00a8\u00f8\u00d7\u00c4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n6.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 350 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c4 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00ca\u00fb\u00da\u00cb\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00a1\u00f5\u00ba\u00e0 \u00ca\u00fb\u00da\u00cb\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n\u201c\u00a1\u00c0\u00cd\u00c7\u00b8\u00c6, \u00c0\u00e6\u00cd\u00e6\u00c7\u00ef\u00aa\u00be \u00c6\u00e5\u00c4 \u00cc\u00cd \u00c9\u00cd\u00c8\u00e0\u00a8\u00c4 \u00a1\u00e5\u00bc\u00fa\u00c6\u201d\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0308\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u201c\u00a1\u00c0\u00cd\u00c7\u00b8\u00c6\u00cc\u00cd \u00c0\u00e6\u00cd\u00e6\u00c7\u00ef\u00aa\u00be\u00c6\u00e5\u00c4\u201d \u00c6\u00be\u00ca\u00fb\u00da\u00cb\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0345 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba5\n\n7.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 358 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00c6 \u00a6\u00c4\u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 358\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c8\u00cc \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\u2014\n\n358\u00a1. (1) (\u00a1)\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb, \u00b8\u00c6\u00c2\u00e6\u00df\u008a\u00a8\u00c7\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00e5\u00cc\u00c3\u00e5\u00c9\u00c6\u00b4\u00c0\u00ba\u00e0 \u00a8\u00c7\u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00ef\u00cc\u00e0 \u00c0\u00ba\u00e0\u00a8\u00c7\u00d1\u00c4\u00b4 \u00cc\u00c8\u00cc\u00e0\u00c9\u00be ;\n\n(\u00a1\u00e5)\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c2\u00c8\u00cd\u00ba\u00e0\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00f8\u00c9\u00e5\u00da\u00c6\u00ef\u00c6\u00be\u00e0 \u00c9\u00e6\u00b6 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4\u00c6\u00b4\u00ba\u00e0 \u00a8\u00c7\u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00ef\u00cc\u00e0 \u00c6\u00b4\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4\u00b4 \u00cc\u00c8\u00cc\u00e0\u00c9\u00be ;\n\n(\u00a1\u00e6)\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c9\u00cd\u00c8\u00e0\u00a8\u00c4\u00b4\u00c3\u00e5\u00b0\u00be\u00c6 \u00a8\u00c7\u00c9\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00ef\u00cc\u00e0\u00c3\u00e5\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00cc\u00ce\u00cc\u00e0\u00c9\u00be ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e7)\u00cc\u00be\u00e0\u00be\u00bc\u00e0\u00bd \u00a1\u00c7\u00aa\u00c8\u00c6\u00a8 \u00bc\u00fb \u00ef\u00c6\u00bc\u00d1\u00c4\u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00ce\u00c4\u00c6\u00a8\u00eb \u00ef\u00c6\u00e5\u00bc\u00e5 \u00aa\u00be\u00e0\u00be\u00e5\u00ef\u00cd\u00e5\u00e0 \u00c2\u00bf\u00c9\u00e5 \u00aa\u00be\u00e0\u00be\u00e5,\n\n\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1), (\u00a1\u00e5) \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e6)\u00ef\u00d8\u00bc \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00ec \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00c9\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u008a \u00bc\u00fb \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u0097\u00cc\u00e0\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00cc\u00cd \u00bc\u00b6\u00c6\u00a8\u00b4 \u00bc (1) \u00c9\u00be\u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1), (\u00a1\u00e5), \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00c6\u00be\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0\u00ce\u00c4\u00c6\u00a8\u00eb\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00ef\u00cd\u00e5\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e7)\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3\u00ba\u00f8\u00cd\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00cc\u00cd \u00bc\u00b6\u00c6\u00a8\u00b4\u00bc \u00a7\u00cd\u00ea \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa\u2014\n\n\u201c\u00b8\u00c6 \u00c2\u00e6\u00df\u008a\u00a8\u00c7\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00b8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00a1\u00e6\u00c0\u00c6\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00b8\u00c6\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00b4\u00a1\u00f5\u00ba\u00f8\u00be\u00e0 358\u00a1\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4.\n\n\u201c\u00b8\u00c6\u00c2\u00e6\u00df\u008a\u00a8\u00c7\u00c6\u00b4\u00ef\u00cd\u00e5\u00e0\u00bc\u00e5\u00cc\u00c3\u00e5\u00c9\u00c6\u00b4 \u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4,\u00c2\u00c8\u00cd\u00ba\u00e0\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0\u00ef\u00cd\u00e5\u00e0\u00a1\u00be\u00f8\u00c9\u00e5\u00da\u00c6\u00ef\u00c6\u00be\u00e0\u00c9\u00e6\u00b6 \u00aa\u00e6\u00be\u00f9\u00c4,\u00c9\u00cd\u00c8\u00e0\u00a8\u00c4\u00b4\u00c3\u00e5\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4\u00cc\u00cd \u00c6\u00ea\u00bc\u00e0\u00bd\u00ef\u00c6\u00e0\u00ef\u00c6\u00bc\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5\u00ce\u00c4\u00c6\u00fa\u00be\u00e0 \u00c2\u00bf\u00c9\u00e5\u00aa\u00e6\u00be\u00f9\u00c4.\n\n2006 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba6"
  },
