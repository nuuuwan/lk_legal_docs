    "chunk_text": "(\u00a1)\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00a4\u00c0\u0097\u00ba \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00a4\u00bc\u00e0\u00aa\u00ba \u00c9\u00ec\u00bc \u00ef\u008a\u00c0\u00be\u00ef\u00ba\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c2\u00bc\u00e0\u00bc\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00c9\u00ec \u00bc \u00c6\u008a \u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00a8\u00e0 \u00c8\u00e6\u00c2\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 ;\u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00a6\u00c2\u00df \u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a1\u00b8\u00b4 \u00ef\u00aa\u00c9\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 ,\n\n\u00bc\u00e6\u00be\u00e0\u00d1\u00ef\u00c4\u00cd\u00fa \u00be\u00f8\u00c6\u0095\u00ba \u00a8\u00e5\u00c8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a8\u00c7\u00e6\u00b8\u00ea\u00a6\u00be\u008a :\u2014\n\n(ii)\u00a6\u00e0 \u00c8\u00e5\u00c3 \u00cd\u00e5 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00a4\u00c0\u0097\u00ba \u00c9\u00ec\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a4\u00bc\u00e0\u00aa\u00ba \u00c9\u00ec\u00ef\u00c6\u00e0\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00bc \u00a6\u00e0 \u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0\u00c4 \u00be\u00c4\u00cc\u00cd \u00c8\u00e8\u00c0\u00e8\u00be\u00c6,\n\n\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00cc\u00c0\u00c6\u00be \u00ef\u00c8\u00cc \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00ce\u00c4\u00ea \u00a8\u00f9 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c6.\n\n\u00ef\u00c9\u00be\u00ba\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00e0\u00aa\u00b8\u00be\u00b4 \u00c8\u00c2\u00e5\u00aa\u00ba\u00e0\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00b4 \u00ef\u00aa\u00c9\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00c9\u00e5\u00da\u00ba\u00e5\u00cc\u00e6\u00c0\u00c6\u00e8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba181\n\n110.\u00bc\u00e6\u00be\u00e0\u00d1\u00ef\u00c4\u00cd\u00fa \u00be\u00f8\u00c6\u0095\u00ba \u00a8\u00e5\u00c8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c0\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00e6\u00b8\u00ea\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00cc\u00c0\u00c6\u00be \u00ef\u00c8\u00cc \u00be\u00f8\u00c6\u00c4 \u00ef\u00a8\u00ef\u00c7\u00be \u00c8\u00e8\u008d\u00ba \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0, \u00c6\u008a\u00a2\u00b6\u00c4\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8\u00a8 \u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c9\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c6 :\u2014\n\n(\u00a1)\u00a6\u00e0 \u00a2\u00b6\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00ef\u00c8\u00e0 \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00be\u00c4 \u00cd\u00e5 \u00c8\u00e8\u00c0\u00e8\u00be\u00c6;\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00a2\u00b6\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00e5\u00b6\u00be\u00e6\u00aa\u00fa\u00c8\u00e0\u00c8 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a\u00c9\u00e6\u0091 \u00bc\u00fa\u00c6\u00ea\u00b8\u00ea \u00a8\u00f8\u00d7\u008a ; \u00cd\u00e5\n\n(\u00a1\u00e6)\u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a8\u00eb\u00c8\u00e8\u00c6 \u00cd\u00e5 \u00a6\u00e0 \u00a8\u00eb\u00c8\u00e8\u00c6\u00b4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00a1\u00ba\u00c4\u00e5\u00c7\u00e6 \u00c9\u00ec \u00ef\u00c9\u00be\u00ba\u00e0\u00c6\u008a \u00c0\u00f2\u00ba\u00f8\u00cb\u00e0\u00b5\u00e5\u00c9\u00a8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u00ba\u00f1 \u00c9\u00ec\u00ba\u00e0, \u00be\u00f8\u00c9\u00e6\u00c7\u00bc\u00fa \u00c9\u00ec\u00ba\u00e0 \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0.\n\n111.\u00bc\u00e6\u00be\u00e0\u00d1\u00ef\u008a \u00bc\u00fa\u00be\u00ef\u00c6\u00e0\u00bc\u00fb \u00ba\u00c4 \u00be\u00f8\u00c9\u00e5\u00cc\u00ef\u00c6\u00cd\u00fa, \u00ef\u00cd\u00e5\u00e0\u00b4\u00c8\u00ef\u00c6\u00cd\u00fa \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00cd\u00fa \u00c0\u00bc\u00fa\u00e2\u008e\u00c9 \u00cc\u00e8\u0090\u00be\u00e0\u00be\u00e5 \u00c9\u00ec\u00bc, \u00ba\u00e5\u00c9\u00a8\u00e5\u00c8\u00e8\u00a8 \u00c2\u00e6\u00cd\u00e6\u00c7 \u00c6\u00e7\u008a \u00a1\u00ba\u00e0\u00cd\u00e6\u00c7 \u00a6\u00e0\u00bc\u00fa\u00be\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00ba\u00eb\u00be\u00e0 \u00c4\u00e5\u00cc\u00c6 \u00c4\u00ea\u00dd\u00c8\u00e0\u00ef\u00c8\u00e0\u00c4 \u00a6\u00ef\u00cc\u00e0 \u00c0\u00bc\u00fa\u00e2\u008e\u00c9 \u00cc\u00e8\u0090\u00c6\u00e5 \u00c9\u00ec\u00bc \u00cc\u00e6\u00c4\u00be\u00c9\u00e5\u00ba\u00e6\u00be\u00e0\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e0\u00c9\u00e5\u00cc\u00e8\u00a8\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00be\u00c4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0,\u00bc\u00e6\u00be\u00e0\u00d1\u00ef\u00c4\u00cd\u00fa \u00be\u00f8\u00c6\u00c4 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00cc\u00e6\u00c0\u00c6\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6\u00e6\u00c6\u00fa \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00c8\u00e8\u008d\u00ba \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00f8\u00c6.\n\n112. (1) (\u00a1)\u00ba\u00c4\u00e5\u00ef\u00aa\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00bc, \u00ba\u00c4\u00e5\u00b4 \u00bc\u00c7\u00e6\u00c9\u00a8\u00eb \u00cc\u00e8\u009b\u00be\u008a \u00a6\u00e0 \u00bc\u00c7\u00e6\u00c9\u00e5\u00ef\u00aa\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00bc, \u00bc\u00e6\u00be\u00e0\u00d1\u00ef\u00c4\u00cd\u00fa\u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00e5\u00c8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00cc\u00c0\u00c6\u00be\u00ef\u00c8\u00cc \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u0095\u00be\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 106 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (7) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c8\u00e8\u008d\u00ba \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00a1\u00be\u00ea\u00c9 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00a8\u00f8\u00d7\u00c4\u00b4 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 ;\n\n(\u00a1\u00e5)106 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0\u00cc\u00e6\u00c0\u00c6\u00fb\u00c4\u00b4 \u00be\u00f8\u00c6\u0095\u00ba \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a6\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00e5\u00c8\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4\u00b4 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e6)120 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c6\u008a \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u00a1\u00be\u00ea\u00c9 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00a8\u00f8\u00d7\u00c4\u00b4 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00a8\u00eb \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 ;"
