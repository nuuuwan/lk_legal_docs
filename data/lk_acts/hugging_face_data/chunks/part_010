    "chunk_text": "(\u00a1)\u201c\u00a1\u00c0\u00be\u00c6\u00be \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00c4\u201d \u00c6\u00be\u00e0\u00be \u00c6\u008a \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u00c6\u00ef\u00bc\u00be \u0097\u00b4, \u00c3\u00e5\u00b8\u00e0\u00b6 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00ef\u00ce\u00bf \u00f7\u00c9\u00f1\u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (ii) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00a8\u00e0 \u00cc\u00e6\u00c0\u00c6\u00fb\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6 \u0097\u00cc\u00e8\u00be\u00e0\u00c8\u00c2\u00e5\u00aa\u00ba\u00e0\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e5\u00aa\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c9\u00ea\u00c9 \u00bc \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u00c4\u00ea\u00dd \u00c4\u00ea\u00bc\u00c8\u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be \u00be\u00c4\u00ea\u00ba\u00e0 \u00a6\u00c6\u00b4-\n\n(ii)\u00ef\u00ba\u00e5\u00aa \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c9\u00ec \u00a8\u00dd \u00ef\u00ba\u00e0, \u00ef\u00a8\u00f2\u00e0\u00c0\u00e0 \u00c7\u00c2\u00da, \u00cb\u00e9 \u00c7\u00c2\u00da,\u00cc\u00e0\u00a8\u00f2\u00e6\u00c0\u00e0 \u00c7\u00c2\u00da, \u00c7\u00c2\u00da \u00a8\u00f8\u00d6 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00f5\u00ba\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e0 \u00a1\u00c0\u00be\u00c6\u00be\u00c6\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c8\u00c2\u00e5\u00aa\u00ba\u00e0\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e5\u00aa\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c9\u00ea\u00c9 \u00bc \u00c8\u00c2\u00e5\u00aa\u00ba\u00cd\u00e6\u00a8\u00f8 \u00c9\u00ec \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 ; \u00ef\u00cd\u00e5\u00e0\n\n(iii)3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c8\u00e5\u00c3 \u00cc\u00cd\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00ef\u00be\u00e5\u00c9\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0,\n\n\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00be\u00e5\u00ef\u008c ;\n\n(\u00a1\u00e5)\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u00c6\u00ef\u00bc\u00be \u0097\u00b4, \u201c\u00cc\u00ea\u00f3\u00cc\u00ea\u00a8\u008a \u00c8\u00e6\u00c2\u00ec\u00a1\u00c0\u00be\u00c6\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0 \u00a2\u00be\u00e0 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00aa\u00fa\u00c6 \u00c6\u008a \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00f8\u00be\u00e0 \u00a6\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6\u00a8\u00c7\u00be \u00c8\u00bc (\u00c4\u00e6\u00b8\u00e8\u00a8\u00e0 \u00cc\u00cd \u00cc\u00e0\u00c9\u00da\u00b8\u00e5\u00c3\u00c7\u00b8 \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0 \u00c8\u00ba\u00e0 \u00c8\u00e5\u00c3\u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00cc\u00cd \u00c6\u008a \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be \u00c9\u00ba\u00e0\u00a8\u00c4\u00a8\u00e0 \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0 \u00c8\u00ba\u00e0\u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8) \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00b4 \u00c0\u00cd\u00ba \u00cc\u00bf\u00cd\u00be\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9, \u00a6\u00be\u008a, \u00a6\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00a6\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0\u00a1\u00c0\u00be\u00c6\u00be \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u008a \u00c6\u008a \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00bc\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00bc \u00a6\u00a8\u00f9 \u00c8\u00e5\u00c3\u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00b4 \u00a6\u00e0 \u00a1\u00be\u00ea\u00c0\u00e5\u00ba\u00c6\u00c4 \u00bc\u00c7\u00be \u00c4\u00ea\u00bc\u00c8 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00be\u00c6.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba121\n\n(\u00a1\u00e6)\u201c\u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0-\n\n(i)\u00a6\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e5\u00bc\u00be \u00c8\u00bc, \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be\u00c6 \u00a8\u00c7\u00be\u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u0095\u00c8\u00b4 \u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00cc\u008a\u00c0\u00f2\u00bc\u00e5\u00c6\u00fa\u00a8 \u00ef\u00be\u00e5\u00c9\u00be\u00c3\u00e5\u00b8\u00e0\u00b6 \u00a1\u00c0\u00be\u00c6\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ; \u00ef\u00cd\u00e5\u00e0\n\n(ii)\u0097\u00ef\u00bc\u00e0\u00ca \u00c9\u00f1\u00c9\u00cd\u00e5\u00c7 \u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00c9\u00ec \u00ef\u00aa\u00d1\u008a \u00cc\u00bf\u00cd\u00e5 \u00be\u00e6\u008c\u00a1\u00f5\u00ba\u00e0\u00c9\u00e6\u0091\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4, \u00be\u00e6\u008c \u0094\u00bf \u00ef\u00cd\u00ce\u00e9\u00c4, \u00c4\u00ec\u00f3 \u00be\u00e6\u008c \u00c2\u00b6\u00ea\u00a8\u00be\u00e0\u00ef \u00be\u00da \u00a1\u00f5\u00ba\u00e0\u00c9\u00e6\u0091\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00c6\u00bb\u00e5 \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00b4\u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4, \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c4\u00ee\u00f3\u00a8\u00e5\u00e2\u00aa, \u00c0\u00d6\u00aa\u00b8\u00a8\u00c9\u00e6\u00b6\u00cc\u00b4\u00cd\u00be\u00e0, \u00c0\u00d6\u00aa\u00b8\u00a8 \u00c0\u00bc\u00e0\u00bd\u00ba\u00f8 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00ef\u00cd\u00e5\u00e0\u00c0\u00d6\u00aa\u00b8\u00a8 \u00bc\u00ba\u00e0\u00ba \u00c0\u0090\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00e0 \u00c0\u00ce\u00a8\u00c7\u00be\u00c8\u00bc \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00c9\u00a8\u00e0 \u00a2\u00b4\u00ea\u00a8\u00e8\u00d7\u00ef\u00c4\u00cd\u00fa,\n\n\u00be\u00f8\u00c7\u00ba \u00c9\u00be \u00c6\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ; \u00cc\u00cd\n\n(\u00a1\u00e7)\u201c\u00c4\u00ea\u00dd \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00c4\u201d \u00c6\u00be\u00e0\u00be, \u00c6\u008a \u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u00c6\u00ef\u00bc\u00be \u0097\u00b4, \u00a2\u00be\u00e0 \u00c6\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0\u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u00c4\u00a8\u00f8\u00be\u00e0,\u00c8\u00c2\u00e5\u00aa\u00ba\u00e0\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e5\u00aa\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c9\u00ec \u00c4\u00ea\u00dd \u00c4\u00ea\u00bc\u00c8\u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be \u00be\u00c4\u00ea\u00ba\u00e0 3 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9\u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00ef\u00be\u00e5\u00c9\u00be \u00c6\u008a \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0, \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00c9\u00ba\u00e0\u00a8\u008a, \u00c4\u00e6\u00b8\u00e8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00e0\u00c9\u00da\u00b8\u00e5\u00c3\u00c7\u00b8 \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0, \u00c8\u00c2\u00e5 \u00aa\u00ba\u00e0\u00ef\u00ba\u00e0\u00ef\u00cd\u00e5\u00e0 \u00ef\u00be\u00e5\u00aa\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c9\u00ea\u00c9 \u00bc \u00c8\u00c2\u00e5\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0\u00a3\u00b4 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u00be\u00e5\u00ef\u008c."
  },
