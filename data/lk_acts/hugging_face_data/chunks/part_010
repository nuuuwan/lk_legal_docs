    "chunk_text": "(12) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00e4\u00b4 \u00a2\u00cd\u00ba\u00f8\u00be\u00e0 \u00a1\u00e6\u00ba\u00f8 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba\u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00f8\u00be\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00cc\u00be\u00e0\u00ba\u00a8\u00ef\u00c6\u00e0, \u00c3\u00e5\u00c7\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0\u00c0\u00e5\u00c8\u00be\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00be\u00f8\u00cc\u00e8\u00c9\u00e5\u00da\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be\u00c9\u00c8\u00b4 \u00c0\u00f2\u00ef\u008c\u00ca\u00c6 \u00c8\u00e6\u009f\u00c4\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00c9\u00e5 \u00c0\u00d7\u00a8\u00e0\u00cb\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00e5\u00e2\u00ca\u00ef\u00c6\u00e0 \u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5\u00b4 \u00c2\u00c8\u00c6\u00c8\u00e6\u00ef\u00c2\u00be \u00c2\u00c9\u00b4 \u00a6\u00c4 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a8\u00f8\u00c6\u00d1\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00da\u00bb\u00a8\u00bb\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0\u00ef\u00be\u00e5\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n17.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 83 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00cd\u00e8 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089:\u2013\n\n(1) \u201c\u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u201d \u00c6\u00be \u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00be\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9\u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00e0\u00be:\u2013\n\n(2)\u201c\u00cc\u008a\u00c4\u00ba \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u201d \u00c6\u00be \u00a1\u00da\u00bb \u00a8\u00bb\u00be\u00ef\u00c6\u00e0 \u201c\u00ef\u00bc\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00ef\u00a8\u00e5\u00b4 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u201c\u00ef\u00bc\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0, \u00ba\u00eb\u00be\u00e0\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00cc\u00cd \u00cd\u00ba\u00c7\u00c9\u00be\u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00ef\u00a8\u00e5\u00b4 \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(3)\u201c\u00c2\u00f3 \u00a1\u00c6\u00a8\u00ce \u00cd\u00e6\u00a8\u00f8 \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9\u201d \u00c6\u00be \u00a1\u00da\u00bb \u00a8\u00bb\u00be\u00ef\u00c6\u00e0 (\u00a1)\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (v) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00ef\u00a8\u00e5\u00b4\u00cc \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 :\u2014\n\n\u201c(vi) \u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c0\u00be\u00c6\u00be \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0(2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 (\u00a1\u00e7) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00ef\u00c7\u00bc\u00fa\u00c0\u00e8\u00ce\u00e8 \u00c0\u00e2\u00aa\u00eb \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c0\u00be\u00c6\u00be \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a1\u00c0\u00be\u00c6\u00be\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00b4 \u00cc\u00e6\u00c0\u00c6\u00ea\u008a \u00a8\u00c7\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8;\u201d.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e083 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00a6\u00a8\u00ba\u00eb \u00a8\u00ce \u00a1\u00aa\u00c6 \u00c4\u00ba \u00c2\u00f3(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba21\n\n18.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00ce\u00c4\u00ea\u00c9\u00be \u00a4\u00c0\u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 II \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc,\u00ef\u00c4\u00cd\u00fa \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00fa \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n(1)\u00a6\u00cd\u00fa (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u2013\n\n(\u00a1)(1) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00cd\u00fa \u201c\u0094\u00ba\u00e0\u00ba\u00c7, \u00a8\u00f8\u00d6 (\u00a8\u00f8\u00d6\u00c0\u00e8\u0090 \u00c9\u00c8\u00e8\u00be\u00e0\u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00bd\u00e5\u00be\u00f1 \u00c9\u00da\u00aa\u00c6\u00a8\u00f8\u00be\u00e0 \u00cc\u00a8\u00cc\u00e0 \u00ef\u00be\u00e5\u00a8\u00ce) \u201d \u00c6\u00be\u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u0094\u00ba\u00e0\u00ba\u00c7, (\u00a8\u00f8\u00d6\u00c0\u00e8\u0090 \u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a\u00bd\u00e5\u00be\u00f1 \u00c9\u00da\u00aa\u00c6\u00a8\u00f8\u00be\u00e0 \u00cc\u00a8\u00cc\u00e0 \u00ef\u00be\u00e5\u00a8\u00ce) \u00f7\u00c9 \u00a8\u00f8\u00d6 \u00cc\u00cd\u00c0\u00e8\u0090\u00a8\u00ce \u00a8\u00f8\u00d6\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(\u00a1\u00e5)(iv) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00cd\u00fa \u201c\u00aa\u00eb\u00c9\u00be\u00e0 \u00c6\u00e5\u00be\u00e5, \u00ef\u00cd\u00c8\u00e8\u00ef\u00a8\u00e5\u00c0\u00e0\u00b4\u00da\u00cc\u00cd\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00aa\u00eb\u00c9\u00be\u00e0 \u00c6\u00e5\u00be\u00e5\u00ef\u00cd\u00c8\u00e8\u00ef\u00a8\u00e5\u00c0\u00e0\u00b4\u00da, \u00c4\u00ea\u00ba\u00eb, \u00bc\u00fa\u00c6\u00c4\u00be\u00e0\u00ba\u00f8, \u00cc\u00e0\u00c9\u00e5\u00c3\u00e5\u0097\u00a8 \u00ef\u00cd\u00e5\u00e0\u00a8\u00ee\u00ba\u00f8\u00c4 \u00c4\u00e6\u00b8\u00e8\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00da\u00bd \u00c9\u0090\u00be\u00e5\u00a8\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c4\u00e6\u00b8\u00e8\u00a8\u00e0\u00aa\u00c8\u00e0, \u00bc\u00fa\u00c6\u00c4\u00be\u00e0\u00ba\u00f8 \u00a8\u00eb\u00b6\u00ea, \u00a1\u00aa\u00be\u00e5 \u00ef\u00c8\u00e5\u00e0\u00cd, \u00a1\u00aa\u00be\u00e5 \u00ef\u00c8\u00e5\u00e0\u00cd\u00a1\u00e5\u00ef\u00c8\u00e0\u00c0\u00e8\u00ba \u00ef\u00c8\u00e5\u00e0\u00cd, \u00c7\u00be\u00e0\u00a8\u00e5\u00cc\u00e8\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 ;\n\n(\u00a1\u00e6)(vi) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00ef\u00c6\u00e0 \u201c\u00c3\u00ed\u0095\u00ef\u00ba\u00c8\u00e0, \u00aa\u00eb\u00c9\u00be\u00e0 \u00c6\u00e5\u00be\u00e5\u00a2\u00be\u00e0\u00bd\u00be\u201d \u00c6\u00be \u00c9\u00ae\u00be \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u201c\u00c3\u00ed\u0095\u00ef\u00ba\u00c8\u00e0, \u00f7\u00d1\u00a8\u00ee\u00ba\u00ef\u00c0 \u00ef\u00c7\u00e5\u00e0\u00c8\u00e8\u00c6\u008a \u00aa\u00e7\u00cc\u00e0 \u00cc\u00cd \u00aa\u00eb\u00c9\u00be\u00e0 \u00c6\u00e5\u00be\u00e5 \u00a2\u00be\u00e0\u00bd\u00be (2005\u00a1\u00ef\u00aa\u00e5\u00e0\u00cc\u00e0\u00ba\u00eb \u00c4\u00cc 5 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be \u00c0\u00d6\u00bc\u00fa)\u00cc\u00cd \u009c\u00cc\u00c8\u00e0 2005 \u00a1\u00ef\u00aa\u00e5\u00e0\u00cc\u00e0\u00ba\u00eb \u00c4\u00cc 1 \u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4\u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00be \u00c0\u00d6\u00bc\u00fa)\n\n(\u00a1\u00e7)(xi) \u00c9\u00be \u00a1\u00c6\u00fa\u00ba\u00c4\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be\u00a1\u00c6\u00e8\u00ba\u00c4\u00c6 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0\u2013"
