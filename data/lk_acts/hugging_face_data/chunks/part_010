    "chunk_text": "(16) (14) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ba\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb\u00ef\u00c9\u00ba \u00ef\u00cd\u00e5\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c9\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00e5\u00e0 \u00a7\u00cd\u00ea \u00ef\u00c9\u00ba \u00ef\u00c0\u00f2\u00e0\u00cb\u00b8\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00e5\u00e0 (13) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c9\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00ef\u00c0\u00f2\u00e0\u00cb\u00b8\u00c6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a6\u00ef\u00cc\u00e0 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c4\u00e5\u00da\u00aa\u00c6\u00a8\u00f8\u00be\u00e0 \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00cc\u00be\u00e0\u00ba\u00a8\u00c6\u00b4\u00c0\u00ba\u00e0\u00c9\u00be \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00c0\u00ba\u00e0\u00d1 \u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u00a7\u00c0\u00e0\u00c0\u00ea, \u00c0\u00e8\u00c5\u00ea\u00c7\u00e6, \u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2, \u00ef\u00c0\u00e5\u00ba\u00e0,\u00ef\u00c8\u00e0\u00a9\u00be, \u00aa\u00fa\u00b8\u00ea\u008a, \u00ef\u00c9\u00ce\u00bf \u00c8\u00e6\u00c6\u00fa\u00cc\u00e0\u00ba\u00eb, \u00ef\u00ae\u00a8\u00e0\u00c0\u00ba\u00e0, \u00c2\u00e6\u00c7\u00c0\u00ba\u00e0, \u0097\u00aa\u00b8\u00be \u00c9\u00e5\u00da\u00ba\u00e5\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ef\u00c8\u00e0\u00a9\u00be, \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c7\u00bf\u00c9\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a1\u00c9\u00ca\u00f1\u00ba\u00e5\u00a8\u00e0\u00a8\u00c8\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba\u00f8\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00ba\u00c4\u00e5\u00ef\u00aa\u00e0 \u00c3\u00e5\u00c7\u00ef\u00c6\u00cd\u00fa \u00c7\u00bf\u00c9\u00e5 \u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u00c6 :\n\n\u00a6\u00e0\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00ef\u00cc\u00e0 \u00c7\u00bf\u00c9\u00e5 \u00ba\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4, \u00a1\u00bc\u00e5\u00ce\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00a1\u00c9\u00cc\u00e5\u00be\u00ef\u00c6\u00e0 \u00cc\u00e8\u00b4 \u00c9\u00da\u00cb \u00c0\u00cd\u00a8\u00e0 \u00a2\u00a8\u00eb\u00ba\u00e0 \u00c9\u00ec \u00c0\u00cc\u00ea\u00c9 \u00c9\u00c8\u00e2\u00aa\u00eb\u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(18) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u201c\u00ef\u00c8\u00e0\u00a9\u00be\u201d \u00c6\u00be \u00ef\u00c6\u00f3\u00c4\u00b4 \u00c6\u008a\u00c0\u00d6\u00aa\u00b8\u00a8 \u00c9\u00e6\u00b6 \u00cc\u00b4\u00cd\u00be\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00ba\u00e0\u00ba, \u00cc\u00e2\u00ef\u00a8\u00e0\u00ba\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u0097\u00bc\u00e0\u00c6\u00ea\u00ba\u00e0,\u00a8\u00e5\u00be\u00e0\u00bc\u008a \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c4\u00e5\u00bd\u00f1\u00c6\u00a8\u00f8\u00be\u00e0 \u00aa\u00c2\u00b6\u00e5 \u00a8\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00b4\u00cd\u00be\u00e0 \u00a8\u00c7\u00a1\u00e6\u00ba\u00f8 \u00c6\u008a \u0091\u00cc\u00e0\u00a8\u00b4\u00c6\u00a8\u00e0, \u00c0\u0090\u00c6\u00a8\u00e0, \u00cc\u00ea\u00cc\u00e2\u00cd\u00fa\u00ba \u0091\u00cc\u00e0\u00a8\u00b4\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00ef\u00c9\u00be\u00ba\u00e0\u00c6\u008a \u00ef\u00bc\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00ef\u008c.\n\n107.(1) \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00aa\u00fa\u00b8\u00ea\u008a \u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00cc\u00cd \u00a6\u00e0\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00a1\u00e5\u00aa\u00b8\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc \u00a6\u00e0 \u00a8\u00e5\u00c8\u00c6\u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00ef\u00c9\u00ef\u00ce\u00bf\u00c4\u00a8\u00e0, \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0, \u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00a8\u00e0 \u00c0\u00e8