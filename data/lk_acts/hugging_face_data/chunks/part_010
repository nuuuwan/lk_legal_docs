    "chunk_text": "111.\u00be\u00c9\u00e5\u00ba\u00e6\u00be\u00e0\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00cd\u00e5 \u00ef\u00be\u00e0\u00c9\u00e5\u00cc\u00e8\u00a8\u00c6\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c9\u00e5\u00da\u00ba\u00e5.181\n\n112.\u00c9\u00e5\u00da\u00ba\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00bc\u00b8\u00e0\u00b6\u00be\u00c6\u00a8\u00e0 \u00be\u00f8\u00c6\u00c4\u00a8\u00f8\u00d7\u00c4\u00b4 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00b4 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c8\u00c6.181\n\nXIII \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00cc\u00e0\u00c9\u00c6\u00e2 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c2\u00bc\u00e0\u00bc \u00ef\u00aa\u00d1\u00c4\n\n113.\u00cc\u00e0\u00c9\u00c6\u00e2 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c2\u00bc\u00e0\u00bc \u00ef\u00aa\u00d1\u00c4.183\n\n\u00ef\u00cc\u00e0\u00c9\u00e5 \u00ef\u00c6\u00e5\u00b0\u00a8\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c0\u00e5\u00d6\u00ca\u00f2\u0095\u00a8\u00c6\u00be\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00c4\n\n114.\u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc \u00a1\u00b6\u00ea \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.184\n\n115.\u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0\u00a8\u00ce\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9184\n\n116.\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00ae\u00a8\u00f2 \u00a1\u00bc\u00e5\u00ce \u00a8\u00f8\u00d7\u00c4.185\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\nxi\n\n117.\u0097\u00ef\u00ca\u00e0\u00cb \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8 \u00a1\u00be\u00ea\u00c9 \u00c2\u00f3 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00c4.187\n\n118.\u00ef\u00cc\u00e0\u00c9\u00e5 \u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00be\u00e0\u00b4 \u0097\u00bd\u00e5\u00be.189\n\n119.\u00ef\u00cc\u00e0\u00c9\u00e5 \u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00cc\u00e8 \u00c9\u00e5\u00da\u00ba\u00e5 \u00ba\u00c2\u00e5 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.190\n\n120.\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea \u00ef\u00cc\u00e0\u00c9\u00e5 \u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00be\u00e0 \u00cc\u00ba\u00eb \u00a8\u00e5\u00da\u00c6191\n\n121.\u00ef\u00be\u00e5\u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u0091\u00ef\u00c6\u00be\u00e0 \u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00f3 \u00c4\u00ea\u00bc\u00c8\u00e0 \u0097\u0093\u00c4\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.192\n\n122.\u00a1\u00c9\u00ca\u00f1 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u00c4 \u00ef\u00be\u00e5\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u0097\u00b4 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00e5\u0097\u00cc\u00e8\u00be\u00e0 \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00a8\u00c8 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.192\n\n123.\u00a1\u00b6\u00ea \u00a8\u00c7\u00be \u00c8\u00bc \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc \u00ef\u00cc\u00e0\u00c9\u00e5 \u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00c9\u00ba\u00e0\u00a8\u008a \u00c9\u00c8\u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.193\n\n124.\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00aa\u00d1\u008a \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d7\u00c4.193\n\n125.\u00ef\u00cc\u00e0\u00c9\u00e5\u00ef\u00c6\u00e5\u00e0\u00b0\u00a8\u00c6\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.194\n\n126.\u00a1\u00c3\u00fa\u00c6\u00e5\u00ae\u00be\u00e5.195\n\n127.\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00bc\u00b8\u00e0\u00b6\u00be\u00c6.196\n\n128.\u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00e6\u00d7\u00c4 \u00c4\u00ba \u00bc\u00b8\u00e0\u00b6\u00be\u00c6.197\n\n129.\u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00c2\u00bc\u00e0\u00bc \u00cc\u00bf\u00cd\u00e5 \u00c2\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4.198\n\n130.\u00a1\u00e5\u00a8\u00ee\u00ba\u00f8 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00ef\u008a \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4\u00a1\u00be\u00ea\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4.198\n\n131.\u00a1\u00da\u00bb \u00be\u00f8\u00c7\u00e7\u00c0\u00b8\u00c6.198\n\nXV \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00ef\u00aa\u00d1\u00c4\u00b4 \u00a1\u00bc\u00e5\u00c8 \u0097\u0093\u0097\u00bd\u00e5\u00be\n\n132.\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00cd\u00fa \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00f3 \u00ef\u00aa\u00d1\u00c4.201\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\nxii\n\nXVI \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00c2\u00e6\u00e2\u00a8\u00eb \u00cc\u00cd \u00c4\u00ea\u00c8\u00f1 \u00a1\u00e5\u00c6\u00ba\u00be \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00c0\u00e5\u00c8\u00e8\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00f3 \u00a1\u00b6\u00ea\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\n\n133.\u00c2\u00e6\u00e2\u00a8\u00eb \u00cc\u00cd \u00c4\u00ea\u00c8\u00f1 \u00a1\u00e5\u00c6\u00ba\u00be \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea\u00a8\u00c8 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.202\n\n134.\u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0, \u00c3\u00e5\u00b8\u00e0\u00b6\u00e5\u00aa\u00e5\u00c7 \u00c2\u00e6\u00df\u008a\u00a8\u00c7 \u00a1\u00e5\u00bc\u00fa\u00c6 \u00c4\u00ba \u00c8\u00e6\u00ef\u00c2\u00be\u00ef\u00c0\u00e5\u00c8\u00e8\u00c6 \u00c4\u00ba \u00c2\u00f3 \u00a1\u00b6\u00ea\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4.205\n\n135.\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e5\u00e2\u00aa\u0095\u00a8 \u00b8\u00c6 \u00cc\u00ea\u00db\u00a8\u00eb\u008a\u00c0\u00ba\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0\u00a8\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a205\n\n136.\u00a1\u00b6\u00ea\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c2\u00f3 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00c2\u00e6\u00c7.206\n\n137.\u00bc\u00e0\u0097\u00ba\u00f8\u00c6\u00fa\u00a8 \u00ef\u00c9\u00ef\u00ce\u00bf\u00c0\u00c8 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c4\u00ba \u00c4\u00ba\u00f8\u00c4\u00e5\u00ba\u00f2 \u00c2\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4.207\n\n138.\u00c7\u00bf\u00c9\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00c2\u00bc\u00e0\u00bc\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e9 \u00c4\u00ba \u00ef\u00aa\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00a1\u00e5\u00c0\u00cc\u00ea \u00ef\u00aa\u00d1\u00c4207\n\n139.133 \u00c9\u00be \u00ef\u00cd\u00e5\u00e0 136 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00c0\u00e5\u00c8\u00e9 \u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u00c4\u00be\u00e0 \u00a1\u00b6\u00ea\u00a8\u00f8\u00d7\u008a\u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u0097\u00bd\u00e5\u00be \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.208\n\n140.\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00a1\u00b6\u00ea \u00a8\u00f8\u00d7\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c0\u00bc\u00fa\u00be \u00c2\u00e6\u00e2\u00a8\u00eb \u00cc\u00cd \u00c4\u00ea\u00c8\u00f1 \u00a1\u00e5\u00c6\u00ba\u00be \u00cc\u00ba\u00eb \u00a8\u00e5\u00da\u00c6. 210\n\n141.\u00c2\u00f3 \u00ef\u00aa\u00d1\u00c4 \u00c4\u00aa\u00cd\u00e6\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00bc\u00b8\u00e0\u00b6\u00be.210"
