u00be\u00ef\u00ba\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00c8\u00cc\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec\u00a1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00c8\u00c2\u00e5 \u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6. \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00ef\u00a8\u00be\u00a8\u00eb\u00b4 \u00c9\u00e6\u0091\u00aa\u00b8\u00be\u00a8\u00e0 \u00cc\u00e8\u0090\u00ba\u00e0 \u00be\u008a, \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00ef\u00aa\u00e0 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a7\u00c9\u00ea\u00be\u00e0 \u00a6\u00a8\u00e0\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00e0 \u00ef\u00c9\u00be\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9 \u00a1\u00be\u00ea\u00c9, \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc\u00b4 \u00a7\u00c9\u00ea\u00be\u00e0 \u00a6\u00a8\u00e0\u00c9 \u00cd\u00e5\u00ef\u00c9\u00be\u00e0 \u00ef\u00c9\u00be\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n82.(1) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u2014\n\n\u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00e5\u00e0.\n\n\u00a1\u00e6\u00ba\u00e6\u008a \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8\u00ba\u00e6\u00be\u00e6\u00ba