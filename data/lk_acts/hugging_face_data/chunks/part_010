    "chunk_text": "2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c613\n\n(2) \u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u201c\u0089\u00bf\u00c6\u00ce\u00bf\u201d \u00a9\u0081\u00b9\u00d7\" \u00b9\u00b6\u00c8\u00cc\u00b8\u00b4\u00c6\u00d5\u00c1\u00bb\u00d7\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00c1\u00c7\u00b8 \u00ad\u00bc\u00c6 \u00a4\u00bf\u00c6 \u00a9\u0081\u00de\u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6\u00b0\n\n360\u00a7\u00b0 (1) \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0\u00bf\u00c6 \u00a4\u008a\u00d9\u00b3\u00c6\u00b1\u00bc\u00c8\" \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0 \u00cc\u00c1\u00bf\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00b6\u00c7\u008a\u00d9\u00b3\u00c6\u00b1\u00bc\u00c8 \u00a9\u00b6\u00c6\u00b6\u0081\u00ce\u00ba\u00bb\u00d7\u00ba\u00c7\u00b8 \u00c1\u00c0\u00c8\u00db\u00ce\u00bd\u008a\u00b8\u00c7\u00be\u00c6 \u2013\n\n(\u00a4)\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c6 \u00b9\u00b6\u00c8\u00cc\u00b8\u00b4\u00c6\u00d5 \u00c1\u00bb\u00d7\u00af\u00c6\u00d0\u00af\u00c6\u00d0\u00ce\u00bd\u00c1\u00c7\u00b8\u00c1\u00bc\u00c6 \u00a9\u00b8 \u00b7\u00ba\u00c6\u0089 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00a4\u00ce\u00bf\"\n\n\u0089\u00bf\u00c6\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u0081 \u00b9\u00c7\u008b\u00bb\u00be\u00c6 \u00d7\u0082\u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u0081\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af \u00b9\u00bc\u00c8\u00b7\u00c6\u00d7\u00cd\u00af\u00b4\u00c6\u00af\u00c8\u0081\u00bd \u00a9\u00c1\u00dd\u00ba\u00c6\"\u0089\u00bf\u00c6\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00b9\u00bc\u00c8\u00b7\u00c6\u00d7 \u00cd\u00af\u00b4\u00c6\u00d0\u00ba\u00c6 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00da\u00bc\u00c8\u00af\u00c8\u0081\u00bd\u00c7\u00bc\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081\" \u00d0\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u0081\u00cd\u00ba\u00be\u00c6 \u00b9\u00b6\u00c6\u00d7 \u00a4\u00ae\u00d5\u00af\u00ce\u00bf \u008c\u00b3\u00c6\u00b1\u00c7\u00b6\u00cc\u00c1\u00c7\u00dd \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0 \u00a5\u00dd\u00c1\u00ce\u00af\u008a\u00cc\u00be\u00c7\u00dd\u00c1\u00ce\u00af\u00ba\u00bd\u00c8\u00bb\u00bd\u00c6\u00bd\u00ae\u00b4\u00ce\u00b8\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00dd \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00ba\u00bd\u00c8\u00bb\u00bd\u00c6\u00bd\u00ae\u00b4\u00ce\u00b8\"\u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00ba\u00c6 \u00a4\u00af\u00c8\u00bb \u00a5\u00bc\u00ae\u0088\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a4\u00bf\u00c7\u00b6\u00df\u00ba\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d.\n\n10\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 364 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2\" \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081\u008c\u00bf\u00af\u00c6\u00af\u00ba\u00c6 3\u00ab \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u008c\u00bf\u00af\u00c6\u00af\u00b6\u00c6\u00ce\u00b6 \u00a7\u00b4\u00c6\u00da\u00d0\u00b6\u00c6\u00d7\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n\u201c\u008c\u00bf\u00af\u00c6\u00af\u00ba\u00c6 4 : \u201c\u00a8\u00de\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00a7\u00bf\u008c\u00bb\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00ba\u00b8\u00af\u00c6\u00af\u00c8\u00cd\u00be\u00b1\u00b6\u00c6\u00ce\u00b6\u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6\u00b0\u201d\u00b0\n\n11\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 365 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 \u2013\n\n(1) \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u201c\u008c\u00bf\u00af\u00c6\u00af\u00ba\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00be\u00c6\u00df\u00af\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8 \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 \u2013\n\n\u201c\u008c\u00bf\u00af\u00c6\u00af\u00ba\u00c6 1 \u2013\u201d ;\n\n\u0089\u00bf\u00c6\u00ce\u00bf\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00b9\u00c6\u00b9\u00bc\u00c8\u00b7\u00c6\u00d7\u00cd\u00af\u00b4\u00c6\u00b4\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081364 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081365 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 16 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00b6\u00ae\u00b4\u00ce\u00b8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00af\u00c6\u00cd\u00af\u00c7\u00ce\u00c1 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c614\n\n(2) \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u008c\u00bf\u00af\u00c6\u00af\u00ba\u00c6 (1) \u00ab \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6\u00da\u00b6\u00c8\u00bb \u008c\u00bf\u00af\u00c6\u00af\u00b6\u00c6\u00ce\u00b6\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c\u008c\u00bf\u00af\u00c6\u00af\u00ba\u00c6 2 : \u201c\u00a8\u00de\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00a7\u00bf\u008c\u00bb\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00ba\u00b8\u00af\u00c6 \u00af\u00c8\u00cd\u00be\u00b1\u00b6\u00c6\u00ce\u00b6\u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6 \u00b0\u201d\u00b0\n\n12\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 365\u00a3 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2 \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00db\u0088\u00ce\u00c1 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u008c\u00bf\u00af\u00c6\u00af\u00b6\u00c6\u00ce\u00b6\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081 \u00f2\u00be\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n\u201c\u008c\u00bf\u00af\u00c6\u00af\u00ba\u00c6 : \u201c\u00a8\u00de\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00a7\u00bf\u008c\u00bb\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00ba\u00b8\u00af\u00c6\u00af\u00c8\u00cd\u00be\u00b1\u00b6\u00c6\u00ce\u00b6\u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6 \u00b0\u201d\u00b0\n\n13\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 365\u00a4 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2\u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c7\u00de \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n(1) \u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00be\u00c6 \u2013\n\n(\u00a3) \u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a3) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u201c\u00aa\u00e1\u00a4\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6\u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00ab\u00b7\u00c6\u00d7 \u00a4\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n(\u00a4) \u00a3\u00c1\u00c6\u00e2\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 (\u00a4) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\" \u201c\u00b9\u00b6\u00c6\u00d7\u00a4\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00e0\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\" \u201c\u00aa\u00e1 \u00a4\u00ae\u00d5\u00af\u00e0\u00af\u00c6\u00d0\u00af\u00c6\u201d \u00a9\u0081\u00d9\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00ce\u00bf \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 ;\n\n(2)\u00a3\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 (2) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00db\u0088\u00ce\u00c1 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00ba\u00c6 \u008c\u00bf\u00af\u00c6\u00af\u00b6\u00c6\u00ce\u00b6\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n\u201c\u008c\u00bf\u00af\u00c6\u00af\u00ba\u00c6 : \u201c\u00a8\u00de\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00a7\u00bf\u008c\u00bb\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00ba\u00b8\u00af\u00c6\u00af\u00c8\u00cd\u00be\u00b1\u00b6\u00c6\u00ce\u00b6\u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6 \u00b0\u201d\u00b0"
  },
