b9\u00b6\u00c8\u00be\u00c7\u00af \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8 \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00ba\u00c6 \u00a5\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u00cd\u00ba\u00df\u00ba\u00c6 \u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :\u2013\n\n\u201c\u00b9\u00c7\u00af\u00ba\u00c6 1\n\n\u00a5\u00b6\u00bd\u00c6\u00af\u00c7\u00b8\" I \u00a4\u00ba\u00c6 \u00b7\u00c8\u00ce\u00bc\u008a\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00ac\u00c1\u00c6\u00cd\u00c1\u00c7\u00bc\u00c7\u00ae\u00d5\u00af\u00c6\u00d0\u00ba\u00c6 \u00d0\u00b6\u00c8\u00ce\u00bc\u00b9\u00c6 \u00b9\u00b7\u00c6\u00b6\u00bb\u00b9\u00c6 \u00b9\u00b5\u00bb\u00b6\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00bc\u00c6 \u00a9\u0081\u00d9\u00ba\u00c6\u00cc\u00b6\u00c7\u00c0\u00c8\u00ce\u00be\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5 \u00b7\u00b4\u00c7\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c8\u00b8\u00c7\u00bd\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u008c\u0081 \u00cc\u00b6\u00c7\u00ce\u00af\" \u00a5\u00b6\u00bd\u00c6\u00af\u00c7\u00b8 II \u00a4\u00ba\u00c6\u00b7\u00c8\u00ce\u00bc\u008a\u00df\u00bf\u00c6\u00bf \u00cd\u00b7\u00cc\u00bc\u00c7\u00b6\u00c6\u00b6 \u00b9\u00b6\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00cc\u00b6\u00c7\u00ce\u00af\u00af\u00c6\u00d0\u00b1\u00c6 \u00b1\u00ba\u00ba\u00c7\u00b8\u00b6\u00c7\u00af \u00a5\u00dd\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u2013\n\n\u00b7\u00c8\u00ce\u00bc I\u00b7\u00c8\u00ce\u00bc II\n\n\u00a4\u00ae\u00d5\u008c\u00b6\u00c8\u00b9\u00c6\u00b9\u00b8\u008c\u0081 \u00cc\u00b6\u00c7\u00ce\u00af\n\n1\u00b0 1988\" \u00aa\u00b9\u00c6\u0089\u00bd\u00be\u00c6 