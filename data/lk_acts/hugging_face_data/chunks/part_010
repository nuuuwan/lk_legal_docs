    "chunk_size_bytes": 3621,
    "chunk_text": "\u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00aa\u00e5\u00be\u00ea \u00a8\u00c7\u00be \u00c8\u00bc\u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00c9\u00e5\u00da\u00ba\u00e5\u00ef\u008c \u00c9\u00e6\u00bc\u00aa\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0,(2) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00e5\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00a8\u00eb\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00cc\u00cd\u00ba\u00f8\u00a8\u00c6\u00a8\u00e0\u00c8\u00c2\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4, \u00cc\u00c4\u00e5\u00aa\u008a \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6\u00a8\u00e0\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n(\u00a1\u00e6)(\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 (i) \u00c9\u00be \u00a1\u00be\u00ea\u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00bc\u00fa\u00be\u00c6, \u00a6\u00ef\u00cc\u00e0\u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea, \u00c9\u00cd\u00e5\u00c4 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00c4\u00e5\u00aa\u008a \u00ef\u00c7\u00d4\u00cc\u00e0\u00b4\u00f2\u00e5\u00da\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba\u00bc\u00e6\u00be\u00ea\u008a \u00ef\u00bc\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(\u00a1\u00e5) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00ba\u00eb\u00ce \u00c9\u00e5\u00cc\u00e8\u00a8 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00ef\u00be\u00e5\u00c8\u00c2\u00be \u00cc\u00e7\u00c4 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u0097\u00cc\u00e8\u00be\u00e0\u00c4 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00c9\u00da\u00cb\u00ef\u00c6\u00e0 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00e8\u00be\u00e0 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00cc\u00e8\u00b4 \u00cc\u00e6\u00c0\u00e0\u00ba\u00e6\u008a\u00c2\u00da \u00bc\u00a8\u00e0\u00c9\u00e5\u00cc\u00cd \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u00c2\u00da \u00cc\u00e8\u00b4 \u00c4\u00e5\u00da\u00ba\u00eb \u00bc\u00a8\u00e0\u00c9\u00e5 \u00c9\u00ec \u00a8\u00e5\u00c8\u00c6 \u00ba\u00eb\u00ce \u00bc\u00fb \u00ef\u00c0\u00f2\u00e0\u00cb\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc\u00c4\u00ea\u00bc\u00c8 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u0097\u00cc\u00e0\u00ba\u00c7 \u00a1\u00e6\u00ba\u00eb\u00dd\u00c9, \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0\u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00a8\u00e0\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u0097\u00cc\u00e0\u00ba\u00c7 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u0095\u00be\u00e0 62 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0\u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c0\u00f2\u00e0\u00cb\u00b8\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a7\u00a8\u00e0\u00ef\u00ba\u00e5\u00e0\u00c2\u00da \u00c4\u00cc 31\u00c9\u00be \u00bc\u00fa\u00be \u00cc\u00e8\u00b4 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc 30 \u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7 \u00a1\u00da\u00bd \u00c9\u00e5\u00da\u00cb\u00e8\u00a8\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba171\n\n\u00c0\u00bc\u00be\u00c4\u00a8\u00e0 \u00c4\u00ba, \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6. \u00a8\u00f8\u00cc\u00e8\u00f3 \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00a6\u00a8\u00f9 \u00a8\u00e5\u00c8 \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6 \u00ba\u00eb\u00c8 \u00ef\u00c0\u00f2\u00e0\u00cb\u00b8\u00c6 \u00ef\u00be\u00e5\u00a8\u00c7\u00be\u00c8\u00bc \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u201c\u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00e0 \u00be\u00e6\u00ba\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0\u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(5) (\u00a1) \u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00ef\u008a \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e5)\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u00c0\u00ef\u00cd\u00be\u00e0 \u00c6\u008a \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u00cd\u00ba\u00c7\u00a8\u00e0\u00cc\u00c0\u00ea\u00c7\u00e5\u00c8\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00a8\u00f9 \u00be\u00f8\u00c6\u00c4\u00c6\u00be\u00e0 \u00cc\u00c0\u00ea\u00c7\u00e5\u00c8\u00e9\u00ef\u008a \u00bc\u00e8\u00be \u00cc\u00e8\u00b4\u00a6\u00a8\u00e0 \u00c4\u00e5\u00cc\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(\u00a1\u00e5) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1) \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00be\u00e8\u00c6\u00c4\u00c6\u00be\u00e0\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00d6\u00bc\u00e8 \u00ef\u008c :\u2014\n\n(i)\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00bc\u00cc \u00bc\u00cd\u00cc\u00a8\u00b4 \u00c9\u00e6\u0091 \u00ca\u00eb\u00bc\u00e0\u00bd \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00c4\u00e5\u00cc\u00e8\u00a8\u00ef\u00be\u00e0\u00c9\u00e5\u00cc\u00e8\u00a8 \u0097\u00f3\u00c8\u00e8 \u0094\u00c8\u00e0\u00c0\u00ba\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00aa\u00d1\u00c4 ;\n\n(ii)\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0097\u00cc\u00e8\u00c0\u00be\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4 \u00c9\u00e6\u0091 \u00c4\u00e5\u00cc\u00e8\u00a8 \u00ef\u00a8\u00f2\u0091 \u00a8\u00e5\u0086 \u0094\u00c8\u00e0\u00c0\u00ba\u00a8\u00e0\u00a4\u00c0\u008e\u00ba \u00a8\u00c7\u00aa\u00be\u00ea \u00c8\u00e6\u009f\u00c4 ;\n\n(iii)\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00bc\u00cc \u00bc\u00cd\u00cc\u00a8\u00b4 \u00c9\u00e6\u0091 \u00ca\u00eb\u00bc\u00e0\u00bd \u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00c4\u00e5\u00cc\u00e8\u00a8\u00c9 \u00be\u00f8\u00c9\u00e5\u00cc\u00f3\u00c7\u00a8\u00bb\u00be \u0094\u00c8\u00e0\u00c0\u00ba\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00aa\u00d1\u00c4 ;\n\n(iv)\u00c0\u00e8\u00b4\u00c7\u00b4 \u00c6\u00e5\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00aa\u00eb\u00c9\u00be\u00e0 \u0090\u00a8 \u00c0\u00ba\u00a8\u00e0 \u0095\u00c8 \u00bc\u00fb \u00aa\u00e6\u00be\u00f9\u00c4 ; \u00cc\u00cd\n\n(v)\u00aa\u00c4\u00be\u00e5\u00aa\u00c4\u00be\u00c6 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u00bf\u00cd\u00e5 \u00c3\u00e5\u0097\u00ba\u00e5 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00c4\u00e5\u00e0\u00b4\u00da\u00c9\u00e5\u00cd\u00be\u00c6\u00a8 \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6\u00c9 \u00cc\u00e8\u009b\u00c4.\n\n(6) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00c6\u008a \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00ef\u00aa\u00d1\u00c4\u00b4\u00c6\u00b4\u00ba\u00e0 \u00c9\u00be \u00cc\u00e6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c4\u2014\n\n(\u00a1)\u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8 \u00a1\u00c9\u00cc\u00e5\u00be \u00bc\u00fa\u00be\u00ef\u00c6\u00e0 \u00bc\u00fb, \u00cc\u00e7\u00c4 \u00c9\u00ba\u00e0\u00a8\u008a \u00cd\u00e5\u00c2\u00e6\u00c7\u00a8\u008a\u00c9\u00c8\u00c4 \u00c9\u0090\u00be\u00e5\u00a8\u00c4 ; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3\u00ef\u00aa\u00d1\u00ef\u00c4\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00c8\u00e5\u00c3 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9,\n\n\u00c0\u00f2\u00a8\u00e5\u00ca\u00c6\u00a8\u00e0 \u00a8\u00c8 \u00c6\u00ea\u00ba\u00eb \u00c6."
