    "chunk_text": "(ii)1971 \u00a1\u00e2\u00a8 35 \u00bc\u00c7\u00be \u00ef\u00c9\u00ef\u00ce\u00bf \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 (\u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a)\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00e5\u00e0\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u00ef\u00c9\u00ba \u00cc\u00ba\u00eb \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00ef\u00c9\u00ef\u00ce\u00bf \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8,\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc, \u00a6\u00e0 \u00a1\u00ba\u00e0\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ba\u00eb\u00a8\u00c7\u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00bc\u00fa\u00be\u00ef\u00c6\u00be\u00e0 \u00a1\u00e5\u00da\u008a\u00c3 \u00c9\u00be \u00c6\u008a \u00a8\u00e5\u00c8\u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\u00a8\u00e0\u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00cd\u00e6\u00c7,\n\n\u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 ;\n\n(ii)\u0099\u00be \u00c4\u00cd\u00b0\u00be \u00cc\u00c4\u00ec\u00cd\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00c6\u008a\u00a8\u00f8\u00cc\u00e8 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00be\u00e6\u008c\u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00be\u00e6\u008c \u00a8\u00eb\u00c8\u00e8\u00c6\u00b4 \u00aa\u00be\u00e0\u00be\u00e5 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00c8\u00e6\u00c2\u00ea\u00c9\u00e5 \u00c9\u00ec \u00bc, \u00a6\u00e0 \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u00cd\u00e5 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea \u00a1\u00ba\u00c7 \u00a1\u00e6\u00ba\u00f8\u00a8\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00c8\u00bc \u00c6\u008a \u00aa\u00fa\u0097\u00cc\u00ea\u00c4\u00a8\u00cc\u00bf\u00cd\u00be\u00e0\u00c9 \u00a1\u00e6\u00ba\u00e0\u00ba\u00e5 \u00c9\u00ec \u00bc \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00a6\u00e0\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00ef\u00cd\u00e5\u00e0 \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00f1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 ;\n\n(\u00a2) (i)\u00c0\u00ea\u00b8\u00f1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8 \u00c8\u00e5\u00c3, \u00cd\u00ea\u00ef\u00bc\u00a8\u00e0 \u00a6\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00c0\u00ea\u00b8\u00f1 \u00a8\u00e5\u00da\u00c6\u00c6\u00a8\u00e0\u00cc\u00bf\u00cd\u00e5 \u00ef\u00c6\u00e5\u00bc\u00c9\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u00cd\u00e5,\n\n(\u00a1)\u00a6\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00c4\u00ec\u00c8\u00e8\u00a8 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00e6\u00c2\u00e6\u0097\u00be\u00e0\u00c4\u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00c7\u00be \u00a1\u00ba\u00c7\u00ba\u00eb\u00c7 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00c0\u00f2\u00bd\u00e5\u00be \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00a6\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0\u00a1\u00da\u00bb\u00c8\u00e5\u00c3\u00fb\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00a2\u00b4\u00ea \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a;\u00ef\u00cd\u00e5\u00e0\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba17\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u00c9\u00be\u00e0 \u00a1\u00e5\u00bd\u00e5\u00c7\u00c8\u00c2\u00be\u00e0\u00ef\u00be\u00e0 \u00be\u008a \u00cc\u00cd \u00ef\u008a \u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6\u00cc\u00bf\u00cd\u00e5 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00be\u008a\u00cc\u00cd \u00a6\u00cd\u00fa \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u00a1\u00be\u00e8\u00c6\u008a \u00cc\u00e0\u00c9\u00c3\u00e5\u00c9\u00c6\u00a8\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u00be\u008a,\n\n\u00a6\u00e0 \u00c0\u00ea\u00b8\u00f1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c7\u00ef\u00aa\u00be \u00c6\u00be\u00ea \u00c8\u00c2\u00be\u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8 \u00c8\u00e5\u00c3 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4;\n\n(ii)(\u00a1) \u00a6\u00c9\u00e6\u00be\u00f8 \u00c0\u00ea\u00b8\u00f1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00c6\u008a \u00ef\u00c0\u00e5\u00f3 \u00c0\u00ec\u00b0\u00be\u00f9\u00c6 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8\u00e0 \u00cc\u00cd \u00a6\u00cd\u00fa\u00c3\u00ed\u0095\u00ef\u00c6\u00cd\u00fa \u00bc;\n\n(\u00a1\u00e5) \u00cd\u00ea\u00ef\u00bc\u00a8\u00e0 \u00a6\u00e0 \u00c0\u00ea\u00b8\u00f1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00c6\u008a \u00a8\u00e5\u00da\u00c6\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0\u00c0\u00ea\u00b8\u00f1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00cd\u00fa\u0095\u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2, \u00c9\u00e5\u00cc\u00c6\u00b4\u00ef\u00aa\u00be \u00a1\u00e6\u00ba\u00f8 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c3\u00ed\u0095\u00c6\u00a8 \u00bc ;\n\n\u00ca\u00eb\u00bc\u00e0\u00bd \u00c9\u00e5\u00da\u00cb\u00e8\u00a8 \u00c9\u0090\u00be\u00e5\u00a8\u00c4 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00a6\u00e0 \u00c0\u00ea\u00b8\u00f1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0\u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4;\n\n(iii)\u00a6\u00e0 \u00c0\u00ea\u00b8\u00f1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00c0\u00e5\u00f3\u00c0\u00ec\u00b0\u00be\u00f9\u00c6 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00b4, 1815 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 2 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7\u00c7\u00e5\u00b0\u00a8\u00f9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ba\u00e7\u00aa\u00fa\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00f8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4,\u00a6\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00c6\u008a \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00bc \u00a6\u00e0\u00a8\u00e5\u00da\u00c6\u00ef\u00c6\u00cd\u00fa\u00c8\u00e5 \u00a6\u00e0 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c0\u00e5\u0097\u0083\u008e \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00ba\u00e5\u00a8\u00e0\u00f3\u00c7\u00b4, \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce\u00e8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c9\u00be\u00e0\u00be\u00e5\u00c9\u00ec \u00a6\u00e0 \u00c0\u00ea\u00b8\u00f1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4;\n\n(\u00a3)\u00ef\u00c9\u00ef\u00ce\u00bf \u00be\u00e6\u008c \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00ef\u00c9\u00ba \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00c6\u00e5 \u00c6\u00e5\u00ba\u00f2\u00e5\u00cc\u00cd \u0097\u00ef\u00be\u00e5\u00e0\u00bc \u00c6\u00e5\u00ba\u00f2\u00e5 \u00ef\u00cc\u00e0\u00c9\u00c6\u00a8\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c6\u008a\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u2013"
