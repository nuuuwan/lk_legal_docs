    "chunk_text": "\u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00ef\u00c6\u00bc\u00d1\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00a1\u00c6\u00ea\u00ba\u00eb \u00c8\u00e8\u00e2\u00aa\u00e8\u00a8 \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00be\u00f9\u00ba\u00f8\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0\u00c9\u00c7\u00bc\u00a8\u00e0 \u00cc\u00e2\u00c6\u00ea\u00a8\u00e0\u00ba \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00ef\u00c9\u00be\u00ba\u00e0\u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00c6\u00e5\u00bc\u00e5\u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00ba\u00da\u00b0\u00be\u00c6\u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0, \u00c2\u00c8\u00cd\u00ba\u00e0\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0,\u00c9\u00e2\u00ae\u00e5\u00ef\u00c9\u00be\u00e0, \u00db\u00c9\u009b\u00ef\u00c4\u00be\u00e0,\u00ef\u00c0\u00ce\u00c5\u00d1\u00ef\u00c4\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00c0\u00e9\u00b6\u00e5\u00a8\u00e5\u00d7\u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00a8\u00f8\u00be\u00e0 \u00a1\u00c6\u00ea\u00ba\u00eb \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00aa\u00e6\u00be\u00f9\u00ef\u00c4\u00be\u00e0 \u00c6\u008a, \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c2\u00bf\u00c9\u00e5\u00aa\u00be\u00e0\u00be\u00e5, \u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00c6 \u00a8\u00c7\u00be,\u00cc\u00e0\u00bb\u00e5\u00be\u00c4\u00e5\u00c7\u00e6 \u00a8\u00c7\u00be, \u00a1\u00e5\u00c7\u00a8\u00e0\u00cb\u00e5\u00c9\u00cc\u00c8\u00cc\u00e5 \u00ef\u00bc\u00be, \u00c3\u00e5\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00cc\u00e8\u00f3\u00a8\u00c7\u00be ;\u00ef\u00cd\u00e5\u00e0\n\n\u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb, \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u008a \u00a8\u00f8\u00d7\u00ef\u008a \u00c9\u00c7\u00bc\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\n\n2006 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba10\n\n(2) \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u008a \u00a8\u00f8\u00d7\u00ef\u008a \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u008a \u00bc\u00fb \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3\u00ef\u00bc\u00a8\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u0097\u00cc\u00e0\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00f8\u00be\u00e0 \u00a7\u00cd\u00ea\u00b4 \u00bc\u00b9\u00ea\u00c9\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00bc\u00b6\u00c6\u00a8\u00f8\u00be\u00e0 \u00bc \u00a7\u00cd\u00ea\u00b4 \u00bc\u00b9\u00ea\u00c9\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8 \u00c6 ; \u00ba\u00c9\u00bc \u00ce\u00c4\u00c6\u00a8\u00eb \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00a6\u00c4 \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3\u00ba\u00eb\u00be\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u0097\u00cc\u00e0\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be\u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00f8\u00be\u00e0 \u00bc\u00b9\u00ea\u00c9\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb\u00a1\u00ba\u00c7, \u00bc\u00b6\u00c6\u00a8\u00f8\u00be\u00e0 \u00bc \u00a7\u00cd\u00ea\u00b4 \u00bc\u00b9\u00ea\u00c9\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6.\n\n(3) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa-\n\n\u201c\u00ce\u00c4\u00c6\u00e5 \u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c9\u00c6\u00cc \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00bc\u00cd \u00a1\u00b4\u00b4\u00a1\u00b6\u00ea \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c ;\n\n\u201c\u00c2\u00c8\u00cd\u00ba\u00e0\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00e8\u00c9\u00e5\u00da\u00c6\u00ef\u00c6\u00be\u00e0 \u00c9\u00e6\u00b6\u00aa\u00e6\u00be\u00f9\u00c4 \u201d \u00c6\u00be\u00e0\u00be\u00b4 358\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a1\u00e6\u00ba\u00f8\u00a1\u00da\u00bb\u00c6\u00c4 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n\u201c\u00c9\u00cd\u00c8\u00e0 \u00c3\u00e5\u00c9\u00c6 \u201d \u00c6\u00be\u00e0\u00be\u00b4 358\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a1\u00e6\u00ba\u00f8\u00a1\u00da\u00bb\u00c6\u00c4 \u00ba\u00f8\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n\u201c\u00ef\u00c9\u00be\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00c0\u00e9\u00b6\u00e5\u00a8\u00e5\u00d7 \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00a8\u00f8\u00be\u00e0\u00a1\u00c6\u00ea\u00ba\u00eb \u00c0\u00f2\u00ef\u00c6\u00e5\u00e0\u00b0\u00be \u00aa\u00e6\u00be\u00f9\u00c4\u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a1\u00e5\u00da\u00bb\u00fc\u00a8, \u00cc\u00e2\u00cc\u00e0\u00a8\u00ee\u00ba\u00f8\u00a8\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00be\u00ea\u00aa\u00ba \u00a8\u00c7\u00e6\u00b8\u00ea\u00c9\u00e5\u00cc\u00e8\u00c6\u00b4 \u00ef\u00c6\u00e5\u00bc\u00e5 \u00aa\u00be\u00f8\u0095\u00be\u00e0 \u00a8\u00f8\u00cc\u00e8\u00c6\u008a\u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00b4 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00a1\u00c9\u00be\u00ba\u00d1\u00c4\u00b4\u00ef\u00c0\u00ce\u00c5\u00d1\u00c4 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\u201d.\n\n9.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 360\u00a1\u00e6 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00e0\u00c9\u00e5 \u00c0\u00f2\u00bd\u00e5\u00be\u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 360\u00a1\u00e7 \u00cc\u00cd 360\u00a2 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8 \u00ef\u00c8\u00cc \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\u2014\n\n360\u00a1\u00e7. \u00ce\u00c4\u00c6\u00a8\u00eb \u00bc\u00c7\u00e6\u00a8\u00c4\u00b4 \u00cd\u00bc\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00cc\u00bf\u00cd\u00e5\u2014\n\n(i)\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00bc\u00c4\u00e5\u00c0\u00e8\u00c6\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00ef\u00a8\u00be\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0\u00ef\u00ef\u00be\u00ba\u00f8\u00a8 \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00c6\u008a\u0097\u00ef\u00bc\u00e0\u00ca \u00c7\u00b4\u00a8\u00b4 \u00aa\u00c4\u00be\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00ce\u00c4\u00c6\u00e5\u00b4\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u00c8\u00cc\u00e0\u00c9\u00e5 \u00ef\u00bc\u00be \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00a8\u00c7\u00be ;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00b4\u00a1\u00f5\u00ba\u00f8\u00be\u00e0 360\u00a1\u00e7 \u00cc\u00cd360\u00a2 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n\u201c\u00bc\u00c7\u00e6\u00a8\u00c4\u00b4 \u00cd\u00bc\u00e5\u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9\u00e6\u00c7\u00bc\u00fa.\n\n2006 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba 11"
