    "chunk_text": "(ii)\u00a3\u00c1\u00c6\u00c1\u00c7\u00de \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00c1\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u008c\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00af\u00bf\u00c8\u00be\u00c6 \u00db\u00b6\u008b\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0089\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00ba\u00c7\u00af\u00db\u00b6\u008b\u00be\u00c6 \u00d0\u00bd\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00bd\u00c6\u00d0\u00cd\u00b7\u00bc\u00c6\u00db\u00b7\u00c6\u00b6\u00c8\u00bb \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00d5\u00af\u00c6\u00af\u00c7\u00b8 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0089\u00b4\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00b8 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00d8{\u00bd\u00c6\u00bd\u00c8\u00a5\u00dd\u00b9\u00b6\u00c6\u00ce\u00b6\u00b7\u00c6\u00d7 \u00b1\u00b6\u0096\u00b6\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00af\u00c6 \u00d0\u00ce\u00bd\u00bb\u00c7\u00af \u00b9\u00b5\u00b6\u00c6\u00cc\u00b6\u00c7\u00ce\u00af\u00cc\u00bb\u00c7\u0081\u00ce\u00bd\u00af\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00b6\u00c6\u00d7\u00bf\u00c6\u00bf\u008c\u00b4\u00b6\u00c6\u00d7\u00ba\u00c6 ;\u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n\u00a3\u00b9\u00c6\u00cd\u00b9\u00c7\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u008c\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u00d5 \u00aa\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a