    "chunk_size_bytes": 3475,
    "chunk_text": "\u201c(\u00a1\u00e6)\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba \u00c0\u00d6\u00bc\u00fa \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0, \u00ef\u00a8\u00c8\u00e8\u00be\u00e0\u00c4\u00ef\u00cd\u00e5\u00e0 \u00a1\u00be\u00f1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c6\u008a \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0\u00cc\u00c4\u00e5\u00aa\u008a\u00c9\u00c8 \u00cc\u00e7\u00ef\u00cd\u00be \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00e6\u00bc\u00aa\u00ba\u00e0\u00a8\u00ce\u00c4\u00b8\u00e5\u00a8\u00c7\u00be \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c9\u00c6\u00a8\u00e0 \u00bc\u00c7\u00be\u00e0\u00ef\u00be\u00e0 \u00bc, \u00a6\u00c9\u00e6\u00be\u00f8 \u00cc\u00c4\u00e5\u00aa\u008a\u0097\u00cc\u00e8\u00be\u00e0, \u201d;\n\n\u00f5\u00cd\u00ea\u00b9\u00ea \u00be\u00e5\u00c4\u00c6.\n\n1988 \u00a1\u00e2\u00a8 30 \u00bc\u00c7\u00be\u00c0\u00be\u00ef\u00ba\u00e0 19 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e046 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 15 \u00bc\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba2\n\n76 \u00a4. (1) (3) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00be\u00e0\u00b4\u00c6\u00b4\u00ba\u00e0\u00c9, \u00cc\u00e7\u00c4 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fb \u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c4,\u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0095\u00c8\u00e8\u00c6\u00be \u00c0\u00be\u00cd\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a6\u00a8\u00ad\u00ba\u00e0\u00c9\u00c6 \u00a1\u00e6\u00ba\u00f8\u00c9, \u00c2\u00e6\u00e2\u00a8\u00eb \u00a8\u00f2\u00c4\u00ef\u00c6\u00e0\u00ca\u00a8\u00e0\u00ba\u00f8\u00c4\u00ba\u00e0 \u00c3\u00e5\u00c9\u00c6 \u00cc\u00cd \u00cc\u00e0\u00bb\u00e5\u00c9\u00c7 \u00c3\u00e5\u00c9\u00c6\u00ba\u00e0; \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u00e5\u00da\u00bb\u00fc\u00a8\u00ef\u00c6\u00e0\u00c6\u00cd\u00c0\u00ba\u00ba\u00e0 \u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00ef\u00aa\u00be \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00ce \u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00ef\u00c9\u00be\u00ba\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00e5\u00cc\u00e0\u00a8\u00be\u00e0\u00bd \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00c6\u00a8\u00e0 \u00cc\u00e7\u00c4 \u00a8\u00c8\u00e0\u00cd\u00fa \u00c4 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u201c\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00e5\u00cc\u00e0\u00a8\u00be\u00e0\u00bd \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00c6\u201d \u00c6\u00be\u00e0\u00be\u00b4 19 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (2)\u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a3\u00b4 \u00c8\u00c2\u00e5 \u00bc\u00fb \u00a1\u00e6\u00ba\u00f8 \u00a1\u00da\u00bb\u00c6 \u00c4 \u00ba\u00f8\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(3) (\u00a1)(i) \u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fb \u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8 \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00eb\u00c9\u00aa\u00a8\u00e9\u008a \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00c0\u00be\u00f8\u00a8 \u00c9\u00aa\u00a8\u00f9\u008a \u00a1\u00e6\u00ba\u00eb\u00dd\u00c4\u00ea\u00dd \u00c9\u00aa\u00a8\u00f9\u008a \u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00dd\u00c9\u00ba\u00e0\u00a8\u008a \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a\u00be\u00f8\u00cb\u00e0\u008e\u00ba \u00c9\u00ba\u00e0\u00a8\u008a \u00c9\u00da\u00aa\u00c6\u00a8\u00e0; \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\n\n(ii) \u00c2\u00e6\u00e2\u00a8\u00eb \u00a8\u00f2\u00c4\u00ef\u00c6\u00e0 \u00ca\u00a8\u00e0\u00ba\u00f8\u00c4\u00ba\u00e0\u00c3\u00e5\u00c9\u00c6 \u00cc\u00cd\u00cc\u00e0\u00bb\u00e5\u00c9\u00c7\u00c3\u00e5\u00c9\u00c6 \u00cc\u00cd \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u00e5\u00da\u00bb\u00fc\u00a8\u00ef\u00c6\u00e0\u00c6\u00cd\u00c0\u00ba,\n\n\u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00ef\u00aa\u00be \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00e5 \u00cc\u00e0\u00a8\u00be\u00e0\u00bd \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0\u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fb \u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be\u00c6\u00e5\u00c4\u00b4 \u00be\u00f8\u00c6\u0095\u00ba \u00a1\u00c9\u00c4 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00bc\u00a8\u00e0\u00c9\u00e5\u00a1\u00e6\u00ba\u00f8 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00be\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00ce\u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6 ;\n\n(\u00a1\u00e5)\u00a1\u00c9\u00c4 \u00be\u00f8\u00c6\u0095\u00ba \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00e5 \u00cc\u00e0\u00a8\u00be\u00e0\u00bd \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00c6\u00c9\u00aa\u00a8\u00f9\u008a\u00c9\u00c8\u00b4 \u00cd\u00e5 \u00c9\u00ba\u00e0\u00a8\u008a\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00c9\u00be \u00ef\u00cc\u00e0\u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a8\u00c8\u00e0\u00cd\u00fa, \u00a6\u00c6 \u00aa\u00b8\u00be\u00e0 \u00c2\u00e6\u00c8\u00e9\u00ef\u008a\u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00c6 \u00cc\u00cd \u00c9\u00aa\u00a8\u00f9\u008a \u00c6\u00be\u00ef\u00bc\u00a8\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00ba\u00e0\u00a8\u008a, \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u00e5\u00da\u00bb\u00fc\u00a8\u00ef\u00c6\u00e0\u00c6\u00cd\u00c0\u00ba \u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e0\u00c8\u00b4 \u00ef\u00aa\u00be, \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00c8\u00e8\u00be\u00e0 \u00a8\u00ce \u00ba\u00f9\u00c7\u00b8\u00c6 \u00a8\u00c7\u00be \u00c0\u00d6\u00bc\u00fa \u00c9\u00ec\u00c9\u00da\u00aa\u00c6\u00a8 \u00cc\u00cd \u00aa\u00b8\u00be\u00e0 \u00c2\u00e6\u00c8\u00e9\u00ef\u008a \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e076\u00a4 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00e8\u00d7\u00c4.\n\n\u201c\u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00e9\u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba\u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00e5\u00cc\u00e0\u00a8\u00be\u00e0\u00bd\u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00c6\u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be\u00c6\u00e5 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n2006 \u00a1\u00e2\u00a8 15 \u00bc\u00c7\u00be \u00c2\u00e6\u00e2\u00a8\u00eb (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba3\n\n(\u00a1\u00e6)\u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fb \u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0\u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c4\u00b4 \u00be\u00f8\u00c6\u0095\u00ba \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00e5\u00cc\u00e0\u00a8\u00be\u00e0\u00bd \u00c0\u00f2\u00e5\u00aa\u00e0\u00bd\u00be\u00c6 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c4\u00ea\u00bc\u00c8\u00e0\u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00ef\u00c9\u00be\u00cc\u00a8\u00e0\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c8\u00e8\u008d\u00ba\u00c9\u00cc\u00e8\u00c6\u00f5\u00c4 \u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00e9 \u0097\u00ef\u00ca\u00e0\u00cb\u00e8\u00ba \u00c2\u00e6\u00e2\u00a8\u00eb\u00c9\u00c8\u00b4\u00bc\u00e6\u00be\u00ea\u008a \u00bc\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 ;"
