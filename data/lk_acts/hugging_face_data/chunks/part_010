    "chunk_text": "(xix) 1979 \u00a1\u00e2\u00a8 53 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00be\u00c9 \u00be\u00f8\u00c0\u00e6\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00bc\u00fa\u00d6\u00aa\u00e6\u00be\u00e0\u00d1\u00ef\u008a \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00be\u00c9\u00be\u00f8\u00c0\u00e6\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00ef\u00c9\u00cd\u00fa ;\n\n(xx) (105 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ef\u00ef\u00c9\u00bc\u00f1 \u00a1\u00e5\u00b3\u00e5 \u00c0\u00be\u00ba\u00f8\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00ef\u00ef\u00c9\u00bc\u00f1 \u00cc\u00c3\u00e5\u00ef\u00c9\u00cd\u00fa ;\n\n(xxi) 1961 \u00a1\u00e2\u00a8 31 \u00bc\u00c7\u00be \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc\u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00ef\u00ef\u00c9\u00bc\u00f1 \u00cc\u00c3\u00e5\u00ef\u00c9\u00cd\u00fa ;\n\n(xxiii) 1971 \u00a1\u00e2\u00a8 9 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a8\u00e5\u00c6\u00e8\u00a8 \u00ef\u00ef\u00c9\u00bc\u00f1\u00c9\u00c7\u00e6\u00be\u00e0\u00ef\u00aa\u00e0\u00cc\u00e2\u00aa\u00c4\u00c6 (\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00f8\u00d7\u00ef\u008a) \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a8\u00e5\u00c6\u00e8\u00a8 \u00ef\u00ef\u00c9\u00bc\u00f1\u00c9\u00c7\u00e6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00cd\u00fa ;\n\n(xxiv) 1968 \u00a1\u00e2\u00a8 17 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a2\u00e2\u00d4\u00ef\u00be\u00e0\u00c7\u00e6\u00c9\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00aa\u00ba \u00a8\u00c7\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00a2\u00e2\u00d4\u00ef\u00be\u00e0\u00c7\u00e6\u00c9\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00cd\u00fa ;\n\n(xxv) 1978 \u00a1\u00e2\u00a8 15 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00c0\u00be\u00c6\u00be \u00b8\u00c6 \u00c7\u00a8\u00e0\u00cb\u00b8\u00cc\u00e2\u00cc\u00e0\u00bb\u00e5 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00c0\u00be\u00c6\u00be \u00b8\u00c6\u00c7\u00a8\u00e0\u00cb\u00b8 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00cd\u00fa ;\n\n(xxvi) 1979 \u00a1\u00e2\u00a8 40 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00c0\u00be\u00c6\u00be \u00cc\u00e2\u00c9\u00da\u00bd\u00be\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00a1\u00c0\u00be\u00c6\u00be\u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00cd\u00fa ;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba12\n\n(xxvii) \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1976 \u00a1\u00e2\u00a8 8 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00cc\u00e0\u00c9\u00e5 \u00c4\u00ea\u00a8\u00e0\u00ba \u00c3\u00b4\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00e2\u00aa\u00c4\u00c6 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00c4\u00ea\u00a8\u00e0\u00ba \u00c3\u00b4\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00e2\u00aa\u00c4\u00ef\u00c6\u00cd\u00fa ;\n\n(xxviii)(i) \u00a1\u00be\u00e0\u00ba\u00da \u00b0\u00e5\u00ba\u00f8\u00a8 \u00ef\u00c4\u00ef\u00cd\u00c6\u00ea\u008a \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\u00c9\u00c8 \u00be\u00f8\u00c7\u00ba\u00c9\u00ec ;\n\n(ii) \u00c6\u008a \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00b4 \u00a1\u00c6\u00fa\u00ba\u00f8 \u00c9\u00ec \u00ef\u00cd\u00e5\u00e0 \u00cc\u00c4\u00e5\u00aa\u008a \u0097\u00cc\u00e8\u00be\u00e0\u00a8\u00eb\u00c8\u00e8\u00c6\u00b4 \u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec ; \u00cc\u00cd\n\n(iii) 1971 \u00a1\u00e2\u00a8 52 \u00bc\u00c7\u00be \u00ef\u00c9\u00ef\u00ce\u00bf \u00be\u00e6\u008c \u00c0\u00be\u00ef\u00ba\u00e0 30\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 (\u00a1\u00e6) \u00ef\u00d8\u00bc\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc\u00ba\u00f9\u00c7\u00b8\u00c6\u00a8 \u00ef\u00cd\u00e0\u00ba\u00eb\u00ef\u00c9\u00be\u00e0 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00be\u00e6\u00c9\u00a8\u00e0 \u00ef\u00c8\u00cc\u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00c2\u00be\u00e0\u00be\u00e5 \u00c9\u00ec,\n\n\u00be\u00e6\u00c9\u00a8\u00f8\u00be\u00e0, 1982 \u00a1\u00e2\u00a8 17 \u00bc\u00c7\u00be \u00cc\u00c4\u00e5\u00aa\u008a \u00c0\u00be\u00ef\u00ba\u00e0 VIII\u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00b4 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c9\u00c7\u00e5\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00c7\u00e5\u00c6\u00a8\u00f8\u00be\u00e0 \u00a6\u00e0\u00be\u00e6\u00ef\u008c \u00c4\u00aa\u00e9\u00be\u00e0, \u00ba\u00e6\u00c0\u00e6\u00c8\u00e0, \u00a1\u00e6\u00ba\u00f8 \u00a8\u00c7\u00be \u00cc\u00ba\u00eb\u00be\u00e0 \u00cc\u00cd \u00c2\u00b6\u00ea\u00c0\u00f2\u00c9\u00e5\u00cd\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00b4 \u00a4\u00bc\u00e0\u00aa\u00ba \u00c9\u00be \u00c8\u00e5\u00c3\u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00ef\u00be\u00e5\u00c9\u00be \u00a4\u00bc\u00e0\u00aa\u00ba \u00c9\u00be;\n\n(xxix) 1981 \u00a1\u00e2\u00a8 55 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00ec\u00c8\u00e8\u00a8 \u00a1\u00bd\u00f1\u00c6\u00be\u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00ec\u00c8\u00e8\u00a8\u00a1\u00bd\u00f1\u00c6\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00cd\u00fa;\n\n(xxx) 1982 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00bc\u00c5\u00c8 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00bc\u00c5\u00c8 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00cd\u00fa;\n\n(xxxi) 1981 \u00a1\u00e2\u00a8 74 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd \u00cd\u00e5 \u00c0\u00e5\u00c8\u00e8 \u0097\u00ca\u00e0\u00c9\u0097\u00bc\u00f1\u00e5\u00c8\u00c6 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00ef\u00c2\u00f0\u00bc\u00e0\u00bd \u00cd\u00e5\u00c0\u00e5\u00c8\u00e8 \u0097\u00ca\u00e0\u00c9\u0097\u00bc\u00f1\u00e5\u00c8\u00c6 \u00cc\u00cd \u00a6\u00e0 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00c0\u00be\u00ba\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00c6\u008a \u00a4\u00cc\u00cc\u00e0 \u00a1\u00bd\u00f1\u00e5\u00c0\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8;\n\n(xxxii) 1984 \u00a1\u00e2\u00a8 18 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00ea\u00f7\u00b8 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6 \u00c0\u00be\u00ba\u00f8\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00ea\u00f7\u00b8 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0;\n\n(xxxiii) 1985 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00cc\u00e2\u00c7\u00a8\u00e0\u00cb\u00b8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00c2\u00c8\u00ca\u00a8\u00e0\u00ba\u00f8 \u00cc\u00e2\u00c7\u00a8\u00e0\u00cb\u00b8\u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00cd\u00fa;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba13"
