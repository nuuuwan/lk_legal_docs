    "chunk_text": "(6) \u00a3\u00de\u00b9\u00b6\u00c6\u00d7 \u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00df\u00ba\u00c6\" 61 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00df\u00ba\u00c6\u00db\u00bc\u009a\u00af \u00a9\u00d7 \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c8\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6\" 97 (1) \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00b8 \u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c6\" \u00a9\u00b7\u00c6\u00b6 \u00b7\u00c7\u00b4\u00c6\u0088\u00be\u00c6\u00c1\u00b6\u00c8\u00c1\u00bd\u00c6\u00bd \u00b9+\u00c6\u00d0\u00b6\u00c7\u00bc\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 \u00c1\u00b6\u00c8\u00dc\u00bf\u00c6\u00bf\u00c1\u00bc\u00c7\u00af\u00e2\u00bf\u00c6\u00bf\u00c7\u00cd\u00bc\u00c7\" \u00a3\u00b7\u00c6\u00b7\u00c7\u00b4\u00c6\u0088\u0081 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0\u00ba\u00c8\u00ce\u00b4\u00cd\u00bb\u00c7\u00b8 \u00ad\u00bc\u00c6 \u00a7\u00b4\u0081\u00b9\u0088\u00af\u00c6\u00ce\u00af\u008a\u00be\u00c6\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9+\u00c6\u00af\u00c8\u00be\u00c7\u00b9+\u00c6\u00af\u00bf\u00c6 \u00ba\u00c9\u00b6\u00c7\u00b8 \u00c1\u00bc\u00c8\u0096\u00b6\u00b6\u00c6\u00b6\u00c8\u0081\u00ba\u00c8\u00ce\u00af\u00bb\u00c7\u00af \u008c\u00b3\u00c6\u00b1\u00c8\u00bb\u00b6\u00c7\u00af\" \u00c1\u00b6\u00c8\u00dc\u00bf\u00c6\u00bf \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9+\u00c6\u00d0\u00b6\u00c7\u00bc\u00dd\u00af\u00c6\u00d0\u00b1\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cc\u00b6\u00c7\u00dd \u00b9+\u00c6\u00af\u00c8\u00be\u00c7\u00b9\u00b