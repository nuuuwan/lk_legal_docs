    "chunk_text": "\u00a6\u00a8\u00e0\u00bc\u00cd\u00cc\u00e0 \u00be\u00c9\u00cc\u00e8\u00c6 \u00cd\u00e6\u00b4 \u00ba\u00eb\u00ef\u00be\u00e0 \u00a1\u00ef\u00c0\u00f2\u00e0\u00c8\u00e0 \u00c4\u00cc\u0097\u00cc\u00e8\u00cd\u00ba\u00c7 \u00c9\u00e6\u00be\u00f8 \u00bc\u00fa\u00be \u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00a6\u00a8\u00e0\u00cc\u00ba\u00e0 \u00b0\u00e5\u00ba\u00f9\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u008a\u00ef\u008a\u00c8\u00be\u00c6 \u00c4\u00aa\u00fa\u00be\u00e0(\u00ef\u00c4\u00cd\u00fa \u0095\u00be\u00e0 \u00c4\u00ba\u00eb \u201c\u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00c6\u201d \u00c6\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be) \u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00b0\u00e5\u00ba\u00f1\u00be\u00e0\u00ba\u00c7 \u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00c6\u00a8\u00e0 \u0097\u00c6\u00be\u00e5 \u00cd\u00fa \u00bc\u00fb \u00cc\u008a\u00c4\u00ba\u00a8\u00c7\u00aa\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00cd\u00c6\u00fa\u00be\u00e0 \u00bc ;\n\n1981 \u00a1\u00e2\u00a8 4 \u00bc\u00c7\u00be\u00c0\u00be\u00ef\u00ba\u00e0 \u00bc\u00fb\u00da\u00ab \u00be\u00e5\u00c4\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00c0\u00e6\u00be\u00d1\u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n\u201c\u00c0\u00ec\u00da\u0097\u00a8\u00e5\u00c9\n\n\u00a2\u00cd\u00ba \u00a8\u00f9 \u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00c6 \u00a6\u00a8\u00e0 \u00bc\u00cd\u00cc\u00e0 \u00be\u00c9\u00cc\u00e8\u00c6 \u00cd\u00e6\u00b4\u00cd\u00ef\u00ba\u00e0 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc \u00bc\u00cd\u00be\u00c9 \u00ef\u00c9\u00be\u00f8 \u00bc\u00fa\u00be \u00cc\u00e8\u00b4\u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00c9\u00ec \u00ef\u00cd\u00c6\u00fa\u00be\u00e0 \u00bc :\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00a6\u00a8\u00e0\u00cc\u00ba\u00e0\u00b0\u00e5\u00ba\u00f9\u00be\u00e0\u00ef\u00aa\u00e0 \u00c4\u00cd\u00ef\u00c8\u00e0\u00a8\u008a\u00c9\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u201c\u00c0\u00f2\u00ef\u008c\u00ca \u00d1\u00ef\u008a\u00cc\u00e5\u00bd\u00be \u00c0\u00ba\u00f2\u00c6\u00a8\u00e0\u201d \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a2\u00cd\u00ba\u00a8\u00f9 \u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00c6\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9\u00a1\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7 \u00cc\u00e8\u0090\u00be \u00c2\u00e6\u0097\u00be\u00e0 \u00bc :\n\n\u00a2\u00cd\u00ba \u00a8\u00f9 \u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c\u00c9\u00aa\u00a8\u00f9\u008a \u00c2\u00c8\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u008c\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00ef\u00be\u00ba\u00f8\u00a8 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00cc\u00e6\u00c8\u00e6\u00cc\u00e0\u00d1\u00c4\u00a1\u00c9\u00ca\u00f1 \u00c9\u00be \u00ef\u00cd\u00c6\u00fa\u00be\u00e0 \u00bc :\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00b0\u00e5\u00ba\u00e5\u00be\u00e0\u00ba\u00f2\u00e8\u00a8 \u00cc\u00c4\u00e5\u00b0\u00c9\u00e5\u00bc\u00fb \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0\u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00c4\u00ef\u00cc\u00e0 \u00c0\u00be\u00c9\u00be\u00ea\u00c8\u00e6\u00ef\u0089:\u2014\u201d.\n\n4.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00ef\u00c0\u00c7\u00e5\u00ba\u00eb\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ca\u00fb\u00da\u00cb\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n\u201cI \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00cc\n\n\u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0 \u00cc\u00c2\u00bf\u00ba\u00e5 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4 \u00cd\u00e5 \u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0 \u00a8\u00da\u00ba\u00c9\u00f1 \u00cd\u00df\u00be\u00e5\u00aa\u00e6\u00be\u00f9\u00c4\u201d.\n\n5.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 2 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00a1\u00ba\u00c7 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n2. (1) \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00c7\u00e5\u00b0\u00f1 \u00ef\u00bc\u00a8\u00a8\u00e0 \u00a1\u00ba\u00c7\u00ba\u00e5\u00be\u00e5\u00c0\u00ba\u00f8 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea \u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00e5\u00ef\u00aa\u00be \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6. \u00c2\u00e5\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00c7\u00e5\u00b0\u00f1\u00ef\u00c6\u00e0 \u00ef\u00bc\u00e0\u00ca\u00cc\u00e9\u00c4\u00e5\u00c9 \u00ba\u00eb\u00ce \u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0\u00bd\u00ea\u00c7\u00c6\u00a8\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00e5 \u00aa\u00e6\u00be\u00f9\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea,\u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0 \u00a8\u00da\u00ba\u00c9\u00f1 \u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0 \u00bd\u00ea\u00c7\u00c6 \u00bc\u00c7\u00be\u00e0\u00be\u00e5 \u00cd\u00c7\u00cd\u00e5\u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 2\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00ef\u00c0\u00c7\u00ca\u00fb\u00da\u00cb\u00c6 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4.\n\n\u201c\u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0\u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ba\u00e5\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00d1\u00c4 \u00cc\u00cd\u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0\u00a8\u00da\u00ba\u00c9\u00f1\u00a2\u00b4\u00ea\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5\u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00b4\u00c2\u00c8\u00c6 \u00c0\u00e6\u00c9\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 2\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 18 \u00bc\u00c7\u00be \u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0 \u00a8\u00da\u00ba\u00c9\u00f1(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba3\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00cc\u008a\u00c4\u00ea\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8\u00b4 \u00a1\u00be\u00ea\u00a8\u00ed\u00c8\u00c9,\u00ef\u00a8\u00e5\u00be\u00e0\u00cc\u00c8\u00e0 \u00a8\u00da\u00ba\u00c9\u00f1 \u00ba\u00e5\u00be\u00e5\u00c0\u00ba\u00f8 \u00f4\u00ba \u00c4\u00b8\u00e0\u00b6\u00c8 \u0097\u00cc\u00e8\u00be\u00e0 \u00bc \u00a2\u00b4\u00ea\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6."
