    "chunk_text": "7.\u00c6\u008a \u00a1\u00bc\u00e5\u00ce \u00a8\u00e5\u00da\u00ba\u00eb\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00cc\u00e7\u00c4\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00cd\u00e5 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c4, \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0\u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00c9 \u00bc \u00ef\u00be\u00e5\u00c8\u00e6\u00c2\u00ea\u00c9 \u00bc, \u00a6\u00e0 \u00a1\u00bc\u00e5\u00ce \u00a8\u00e5\u00da\u00ba\u00eb\u00ef\u008c \u00a1\u00c9\u00cc\u00e5\u00be\u00c6\u00b4\u00c0\u00cc\u00ea\u00c9 \u00c4 \u00a6\u00ce\u00ef\u00c5\u00be \u00c4\u00e5\u00cc\u00ef\u00c6\u00e0 \u0097\u00cc\u00e8\u00c9\u00be \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00ef\u00c0\u00c7, \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u00c9\u00e5\u00e0\u008e\u00ba\u00c0\u00d6\u00bc\u00fa, \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00a1\u00bc\u00e5\u00ce \u00c0\u00e8\u00d6\u00c9\u00e6\u00b4\u00ea\u00c4 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9, \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a \u00a1\u00e5\u00a8\u00ee\u00ba\u00f8\u00c6\u00a8\u00cc\u00cd \u00c6\u008a \u0097\u00cc\u00e0\u00ba\u00c7 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00ef\u00c9\u00ba \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00c9\u00e5\u00da\u00ba\u00e5\u00ef\u008c, \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 \u00aa\u00b8\u00be\u00e0 \u00c2\u00e6\u00c8\u00e9\u00ef\u008a \u00c0\u00bc\u00be\u00c4\u00cd\u00e5 \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00ef\u00a8\u00e5\u00c4\u00cc\u00e5\u00d6\u00cc\u00e0 \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00f8\u00ca\u00e0\u008e\u00ba\u00c9\u00cc\u00bf\u00cd\u00be\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u0097\u00cc\u00e0\u00ba\u00c7 \u00bc \u00ef\u00c0\u00be\u00e0\u00be\u00ea\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n9.\u00c6\u008a \u00a1\u00bc\u00e5\u00ce \u00a8\u00e5\u00da\u00ba\u00eb\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5, \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00a1\u00c6\u00a8\u00c8 \u00cd\u00e6\u00a8\u00f8 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0\u2014\n\n(\u00a1)\u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 \u00ef\u00aa\u00c9\u00e5 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u0097\u00cc\u00e8\u00be\u00e0, \u00a1\u00bc\u00e5\u00ce \u00a8\u00e5\u00da\u00ba\u00eb\u00c9 \u00cc\u00bf\u00cd\u00e5\u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb\u00c9 \u00ba\u00f8\u00c2\u00ec \u00c4\u00ea\u00bc\u00c8\u00b4 \u00c9\u00b6\u00e5 \u00a1\u00b6\u00ea\u00c4\u00ea\u00bc\u00c8\u00a8\u00e0 \u00ef\u00aa\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9\u00b4,\n\n\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00ef\u00aa\u00e0 \u00c4\u00ba\u00c6 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00e0 \u00a1\u00bc\u00e5\u00ce \u00a8\u00e5\u00da\u00ba\u00eb\u00c9\u00cc\u00bf\u00cd\u00e5, \u00a7\u00cd\u00ea\u00ef\u00aa\u00e0 \u00c4\u00ba\u00c6 \u00a1\u00be\u00ea\u00c9, \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00c7\u00c6 \u00ef\u00cc\u00e0\u00c9\u00e5\u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c9 \u00ba\u00f8\u00c2\u00ec \u00c4\u00ea\u00bc\u00c8, \u00a6\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6 \u0097\u00cc\u00e8\u00be\u00e0\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00a1\u00ba\u00c7 \u00c8\u00e8\u00c6\u0097\u00c8\u00e0\u00c8\u00a8\u00f8\u00be\u00e0 \u00c9\u00ec \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0\u2014\n\n(i)\u00a6\u00e0 \u00a1\u00bc\u00e5\u00ce \u00a8\u00e5\u00da\u00ba\u00eb\u00c9 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u0097\u00cc\u00e8\u00be\u00e0 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00ef\u00aa\u00c9\u00e5 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8 \u00be\u008a, \u00a6\u00e0 \u00a1\u00bc\u00e5\u00ce\u00a8\u00e5\u00da\u00ba\u00eb\u00c9 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00ef\u00cc\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00ef\u008c\u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 ; \u00ef\u00cd\u00e5\u00e0\n\n\u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00bc\u00fb\u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00c7\u00e6\u0097\u00cc\u00e8\u00be\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00a8\u00f8\u00d7\u00c4 \u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9.\n\n\u00c9\u00e5\u00da\u00ba\u00e5 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be\u00c6\u00e5\u00c4.\n\n\u00c9\u00e5\u00da\u00ba\u00e5 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 13 \u00bc\u00c7\u00be \u00a1\u00e5\u00da\u00bb\u00fc\u00a8 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00c0\u00be\u00ba7\n\n(ii)\u00a6\u00e0 \u00a1\u00bc\u00e5\u00ce \u00a8\u00e5\u00da\u00ba\u00eb\u00c9 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c6\u008a\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6\u00a8\u00e0 \u00ef\u00aa\u00c9\u00e5 \u00a1\u00e6\u00ba\u00e0\u00be\u008a, \u00a6\u00ef\u00cc\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00c7\u00be\u00c8\u00bc \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00cd\u00e5 \u00a6\u00e0 \u00a1\u00bc\u00e5\u00ce \u00a8\u00e5\u00da\u00ba\u00eb\u00c9 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00e6\u00ba\u00e0\u00ba \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c4\u00ef\u00aa\u00c9\u00be \u00c8\u00bc \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb \u00c0\u00f2\u00c4\u00e5\u00b8\u00c6 \u00a1\u00ba\u00c7 \u00a1\u00e6\u00ba\u00f8 \u00ef\u00c9\u00be\u00cc,\n\n\u00c9\u00cd\u00e5\u00c4 \u00ef\u00aa\u00c9\u00be \u00ef\u00c8\u00cc \u00a6\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00b4 \u00be\u00f8\u00c6\u00c4 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n10.(1) \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00ef\u00aa\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 6 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0\u00be\u00f8\u00ca\u00e0\u008e\u00ba \u00bc\u00a8\u00e0\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8 \u00bc\u00fa\u00be \u00ef\u00cd\u00e5\u00e0 \u00a3\u00b4 \u00ef\u00c0\u00c7, \u00c6\u008a \u00a1\u00bc\u00e5\u00ce \u00a8\u00e5\u00da\u00ba\u00eb\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a\u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00ef\u008c \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00ef\u00aa\u00c9\u00e5 \u00a1\u00e6\u00ba\u00f8\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00e0 \u00c9\u00e5\u00d6\u00a8\u00c6 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00c8\u00cc \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00c0\u00e6\u00cd\u00e6\u00c7 \u00cd\u00d6\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ef\u00cc\u00e0\u00c9\u00e5 \u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00c9 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00cd\u00fa \u00ef\u00a8\u00e5\u00b4\u00cc\u2014\n\n(\u00a1)\u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 ;\n\n(\u00a1\u00e5)\u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 ;"
