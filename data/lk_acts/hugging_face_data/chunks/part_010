    "chunk_text": "7\u00aa\u00b0 \u00a3\u00d9\u00b9\u00c6\u00da\u00ba\u00c6 \u00a3\u00bc\u00b1\u00c8\u0081 \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7 \u00a3\u00df\u00c1\u00be\u00bc\u00c6\u00af\u00bf\u00c6\" \u00aa\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u00bc\u00b1\u00c8\u0081 \u00b1\u00b4\u00c6\u00b4+\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00df\u00ba\u00c6 \u00ac\u00e1+\u00c6\u00d0\u008c\u00b6\u00c8\u00af\u00bf\u00c8\u00b8\u00c7\u00df\u00ba\u00c6 \u00a3\u00d9\u00ba\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00a3\u00bf\u00e2\u00c1\u00ce\u00bc\"\u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00b9\u00c6 \u00b9\u00b5\u00c8\u00af\u00bf\u00c8\u0081 \u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00ba\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00b8 \u00a9\u00be\u00c6\u00be\u00c7\u00af\u00c6 \u00af\u00dd\u00ba+\u00c6\u00af\u00bf\u00c6 \u00b9\u00bd\u00c6\u00bd\u00c8\u00dc\u00ba\u00c6 \u00aa\u00bd\u00c6\u00d0\u00ba\u00c6\u00a3\u00bc\u00b1\u00c8\u0081 \u00a5\u00ce\u00bb\u00b9\u00c7\u00b8 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00c8\u00af\u00e0\u00b4\u0081 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00cc\u00af\u00c7\u00bf\u00c6\u00e0\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a7\u00bc\u00c8\u00ce\u00ba\u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00b6\u00c6\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n7\u00ad\u00b0 (1) \u00a9\u00be\u00c6\u00be\u00c7\u00af\u00c6 \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7 \u00a3\u00df\u00c1\u00be\u00bc\u00c6\u00af\u00e0\u00ba\u00c6\u00a9\u00be\u00c6\u00be\u00c7 \u00cd\u00b7\u00bc+\u00c6\u00af\u00bf\u00c8\u00df\u00ba\u00c6 \u00a7\u00bc\u00c8\u00bb \u00ba\u00bc\u00c8\u00bb\u00c7\u00ce\u00b6\u00dc\u00b4\u0081 \u00b7\u00b4\u00c7\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081\" \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00a3\u00df\u00c1\u00be\u00bc\u00c6\u00af\u00bf\u00c6\" (\u00b9\u00c7\u00bc\u00d7{\u00bc\u00ba\u00c7\u00b8 \u00d0\u00bd\u00c6\u00bd\u00b1\u00c6\u00cc\u00b1\u00bb\u00cc\u00be\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00da\u00bc\u00c8\u00b7\u00c6\u00b6\u00ce\u00ba\u00af\u00c6\u00af\u00c7\u00af\u00e2\u00ba\u00c6 \u00b6\u00d0\u00b6\u00c8\u00c1\u00c7\u00bb\u00c6\u00b7\u00c6\u00b6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u0081 \u00db\u0088\u00cc\u00c1\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u0089\u0081\u00b9\u00bd\u00c6\u00bd\u00c8\u00dc\u00ba\u00c6\u00a3\u00be\u00c6\u00be\u00c7\u00ba\u00be\u00c6) \u00ce\u00af\u00d7\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00df\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7\u00b6\u00d5\u00b9\u00c6\u00da\u00af\u00c6 \u00af\u00c7\u00c1\u00df\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00b1\u00c6\u00d2\u00b6\u00b7\u00c6\u00b6\u00c8\u00bc\u00b6\u00c6\u00b6\u00c8\u0081 \u00ba\u00c9\u00b6\u00c7\u00b8 \u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6 \u00c1\u00ce\u00af\u008a\u00b8\u00b6\u00c7\u00b8 \u00ba\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00c7\u00b4\u00c6\u00d5\u00af\u00c6\u00d0 \u00a4\u00bf\u00c7\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n(2) \u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00bd\u00c7\u00b8 \u00b9\u00c7\u00bc\u00d7{\u00bc\u00ba\u00c7\u00b8\u00cc\u00c1\u00c7\u00dd \u00d0\u00bd\u00c6\u00bd\u00b1\u00c6\u00cc\u00b1\u00bb\u00df\u00af\u00c6\u00af\u00c7\u00af\u00af\u00c6 \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7 \u00a3\u00df\u00c1\u00be\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c6 \u00ce\u00af\u00d7\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00d5\u00b9\u00c6\u00da\u00af\u00c6\u00af\u00c7\u00c1\u008b\u00be\u00c6 \u00a5\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00b9\u00b4\u00c6\u00b1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6\" \u00aa\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u00bc\u00b1\u00c7\u00b8\u00d7 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b7\u00c8\u00af\u00c0\u00c6\u00e2 \u00b9\u00bd\u00c6\u00bd\u00c8\u00af\u00c6\u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00b9\u00c6 \u00b9\u00b5\u00c8\u00bb\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00c1\u00dd\u00af\u00c6\u00d0 \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0 \u00ce\u00af\u00d7\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a4\u00bf\u00c6 \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00b9\u00c6 \u00b9\u00b5\u00c8\u00bb\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b6\u00ce\u00be\u00c1\u00bc\u00c7\u00af\u00cd\u00c1 \u00a5\u00dd\u00b9\u00c6\u0089\u0081\"\u00d7{\u00b6\u00c7\u00ae\u00ce\u00ba \u00c1\u00c0\u00c8\u00c1\u00ce\u00af\u00af\u00bf\u00c6\u00f2\u00be\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00b7\u00c8\u00af\u00c0\u00c6\u00ce\u00c1 \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c6\" \u00aa\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u00bc\u00d2\u00af\u00c6\u00d0 \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n\u00a5\u00ce\u00bb\u00b9\u00c7\u00b8\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00c8\u00af\u00e0\u00b4\u0081\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00cc\u00af\u00c7\u00bf\u00c6\u00e0\u00b6\u00be\u00c6\u00b0\n\n\u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00af\u00c6\u00af\u00b4\u00c6\u00b4\u00b5+\u00c6\u00af\u00e0\u00ba\u00c6\u00a5\u00de\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00e0\u00ba\u00c6\u00b0\n\n\u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00a3\u00df\u00c1\u00be\u00bc\u00c6\u00af\u00bf\u00c6\u00db\u00e1\u00b7\u00c8\u00ce\u00bd\u00af\u00c6\u00af\u00c7\u00b9\u00c6\u00da\u00ce\u00b4\u00cd\u00bb\u00c7\u00bc\u00c7\u00af\u008c\u00dd\u00b6\u00c6\u00b6\u00df\u00ba\u00c6\u00ce\u00af\u00d7\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6\u00db\u00b6\u008b\u00bb\u00c1\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00b8\u00d2\u00b6\u00b7\u00c6\u00b6\u00c8\u00bc\u00db\u00ba\u00c6\u00b0\n\n102006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 18 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00b9\u00c6\u00b9\u00b5\u00c8\u00af\u00bf\u00c6 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n(3) \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7 \u00a3\u00df\u00c1\u00be\u00bc\u00c6\u00af\u00e0\u00ba\u00c6 \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00a8\u00c0\u00c8\u00bb\u00bc\u00c6\u00af\u00e0\u00ba\u00c6\" \u00a3\u00c1\u00bc\u00c6\u00af\u00bf\u00c8\u0081 \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00b9\u00c6 \u00b9\u00b5\u00c8\u00af\u00bf\u00c8\u0081 \u0089\u00bc\u00cd\u00bb\u00c7\u00af\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00da\u00bc\u00c8\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00cc\u00b1\u00bb\u00be\u00c6\u00af\u00bf\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00aa\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u00bc\u00b1\u00c8\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00b7\u00c9\u00b6\u00c8\u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00b7\u00c8\u00bb\u00c7\u00bb\u00c7\u00b6\u00c8\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00c8\u00dd\u00c1\u00c7\u00af\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b6\u00c6\u00d7\u00af\u00c6\u00d0 \u00a3\u00ce\u00ba\u00b7\u00c6\u00cd\u00b6\u00c7\u00bc\u00c7\u00b6\u00be\u00c7\u00af\u00c7\u00d7 :\n\n\u00a4\u008a\u0081\" \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c7\u008a\u00d9\u00ba\u00c6\" (3) \u00a4\u00ba\u00c6 \u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u2013\n\n(\u00a3) \u00a3\u00d9\u00b9\u00c6\u00da\u00ba\u00c6 \u00a3\u00bc\u00b1\u00c8\u0081 \u00db\u00af\u00c1\u00cc\u00bc\u00c7\u00dd\u00c1\u00bc\u00c7\u00af\u00c1\u0081\u00bd\u00c8 \u00cd\u00c1\u00de\u00c1\u00ce\u00af\u00bb\u00c7\u00af \u00ac\u00dd \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7\u00a3\u00df\u00c1\u00be\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00bb\u00c6\u00d7\u00cc\u00af\u00c7\u00bf\u00c6\u00bf\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ac\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b8 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a4) \u00aa\u00bd\u00c6\u00d0\u00ba\u00c6 \u00a3\u00bc\u00b1\u00c8\u00be\u00c6 \u00aa\u00bd\u00c6\u00b9\u00d5\u00ba\u00c6 \u008c\u00b9\u00b6\u00c6\u00cc\u00b6\u00c7\u0081\u00bd\u00c8\u008b\u00dd\u00b7\u00c6\u00d7 \u00a9\u00e1\u00af\u00c8\u0081\u00bd \u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u00b6\u00c8\u00bd\u00b6\u00c6\u00b6\u00c1\u00bc\u00c6\u00cd\u00b1\u00b6\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00b8\"\n\n\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a3\u00df\u00c1\u00cc\u00bc\u00c7\u00dd\u00c1\u00dd\u00af\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7\u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00d7 \u00a8\u00c0\u00c8\u00bb\u00cc\u00bc\u00c7\u00dd\u00c1\u00dd\u00af\u00c6\u00d0 \u00a9\u00b6\u00c8\u00bc\u00c7\u00af\u00b6\u00c6 \u00cc\u00b6\u00c7\u00d5\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00d0\u0088\u008a\u00bb\u00be\u00c6 \u00c1\u00c0\u00af\u00c6\u00d0 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00af\u00e0\u00af\u00c6\u00d0\u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0"
