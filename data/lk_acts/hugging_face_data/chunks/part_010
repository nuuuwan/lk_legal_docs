4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00b4\u00bd\u00c6\u00cc\u00bd\u00c7\u00c0\u00c8\u00be\u00c6\"\u00b7\u00c9\u00bc\u00c6\u00c1\u00c7\u00c0\u00c6 \u00a7\u008a\u00bc\u00c8\u00b8 \u00c1\u00bf+\u00c6\u00af\u00bf\u00c6 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c64\n\n\u00ba\u00bf\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00a3\u00df\u00c1\u00be\u00dd\u00af\u00c6\u00d0\u00b1\u00c6 \u00b1\u00ba\u00bc\u00c6\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6\u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u0081\u00ba\u00c9\u00d7\" \u00da\u00d7\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00be\u00c7\u00ba\u00c6\u00b0\n\n(2) \u00a7\u00bc\u00c8\u00ba\u00ba\u00bf\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00a3\u00df\u00c1\u00be\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 (1) \u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u008c\u00ae\u00b5\u00b9\u00c6\u00b9\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u00b4\u00b6\u0081\u00cd\u00ba\u00be\u00c6 \u2013\n\n(\u00a3)\u00a7\u00bc\u00c8\u00ba\u00ba\u00c6 \u00cc\u00b9\u00bd\u00c6\u00bd\u00c1\u00bc\u00c6\" \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a7\u00bc\u00c8\u00ba\u00b6\u00c6\u00b6\u00c8\u0081 \u00b7\u00c8\u00bb\u00b6\u00c8\u00af\u00bf\u00c6 \u00b7\u00c8\u00b9\u00b7\u00c6\u00b6\u00ce\u00b8\u00af\u00ce\u00bf \u00ba\u00c9\u00bd\u00c8 \u00a3\u00be\u00c6\u00be\u00d7 \u00db\u00bc\u00b5\u00c7\u00af \u00a9\u00b6\u00ce\u00b8\u00dc\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00c7\u00b6\u008c\u00b4\u00b6\u00c6\u00d7 ;\n\n(\u00a4)\u00a7\u00bc\u00c8\u00ba\u00ba\u00c6 \u00cc\u00b9\u00bd\u00c6\u00bd\u00c1\u00bc\u00c6\" \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081\u00af\u00c9\u00c0\u00c6 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6\u00ac\u00e1+\u00c6\u00d0\u008c\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf \u00ba\u00c9\u00bd\u00c8\u008a\u00dd\u00af\u00c6\u00af\u00c7\u00b6\u008c\u00b4\u00b6\u00c6\u00d7 ;\n\n(\u00a5)\u00a7\u00bc\u00c8\u00ba\u00ba\u00c6 \u00cc\u00b9\u00bd\u00c6\u00bd\u00c1\u00bc\u00c6 1998 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u008153 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b6\u00c6 \u00cd\u00b6\u00b1\u00c8\u00bb\u00b7\u00c9\u00bc\u00c8\u00bb\u00be\u00c6 \u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00ce\u00bf \u00b9\u00ae\u00b9\u00d5\u00b6\u00c6\u00b6\u00be\u00c6 \u00a3\u0089\u008c\u00dd\u00b6\u00c6\u00b6\u00c8 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00b1\u00ce\u00b9\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081\u00af\u00c9\u00c0\u00c6 \u00a4\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00ac\u00e1+\u00c6\u00d0 \u008c\u00b6\u00c8\u00af\u00bf\u00c8\u0081 \u00a9\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00ce\u00bf \u00ba\u00c9\u00bd\u00c8\u008a\u00dd\u00af\u00c6\u00af\u00c7\u00b6\u008c\u00b4\u00b6\u00c6\u00d7 ; \u00a3\u00be\u00c6\u00be\u00d7\n\n(\u00a6)\u00b1\u00ba\u00c6\u00b9\u00b7\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b7\u00c9\u00bc\u00c6\u00c1\u00c7\u00c0\u00c6 \u00a7\u008a\u00bc\u00c8\u00b8\u00c1\u00bf\u00bc\u00c6\u00b9\u00c6\u00da\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b9\u00c7\u00b4\u00c6\u00ce\u00b4\u00b6\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00c1\u00b6\u00c7\u00b8\u00d7 \u00e9\u00c0\u00be\u00c6\u00ba\u00c9\u00d7 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ba\u00c7\u00bd\u00c7\u00b8\u00b6\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00ce\u00b6\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00af\u00c6\u00af\u00c7\u00b6\u008c\u00b4\u00b6\u00c6\u00d7\"\n\n\u00a7\u00bc\u00c8\u00ba\u00cc\u00ba\u00c7\u0081\u00ce\u00bd\u00b9\u00c6 \u00da\u00d7\u00b9\u00c6\u0089\u00af\u00c6\u00af\u00be\u00c7\u00ba\u00c6\u00b0\n\n(3) \u00b7\u00c7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00cc\u00bc\u00ae\u00b4\u00c7\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00be\u00c6 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6\u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00da\u00d7\u00b9\u00c6\u0089\u00b6\u00c6\u00b6\u00be\u00c6\u00ba\u00c9\u00d7 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a7\u00bc\u00c8\u00ba\u00cc\u00ba\u00c7\u0081\u00de \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00bb\u00b8\u00c1\u00c7\u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 22 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00af\u00b4\u00bd\u00c6\u00cc\u00bd\u00c7\u00c0\u00c8\u00be\u00c6\"\u00b7\u00c9\u00bc\u00c6\u00c1\u00c7\u00c0\u00c6 \u00a7\u008a\u00bc\u00c8\u00b8 \u00c1\u00bf+\u00c6\u00af\u00bf\u00c6 (\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c65"
