    "chunk_text": "(ii)\u00ad\u00bc\u00c7\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00d7{\u00b6\u00bc\u00c7\u00ae\u00ce\u00ba\u00b9\u00c6 \u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8\u008a\u0081\u00b9\u00b5\u00c8\u00bb\u00c7\u00b4\u00c6\u00cc\u00b4\u00c7\u00d0\u00b6\u00c8\u008a\u0081 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c6\" \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00b6\u00bc\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00af \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6\" \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u00a3\u00b7\u00c6\u00b6\u00b6\u00c6 \u00d7{\u00b6\u00bc\u00c7\u00ae\u00ce\u00ba\u00b9\u00c6 \u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8\" \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00b6\u00bc\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00af \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6 \u00a9\u00b7\u00c6\u00b6 \u00b7\u00c7\u00b4\u00c6\u0088\u0081\u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00af\u00e2\u00bf\u00c6\u00bf\u00c7\u00cd\u00bc\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00b7\u00c7\u00b4\u00c6\u0088\u00be\u00c6 \u00c1\u00b6\u00c8\u00b9\u00c1\u00bc\u00c7\u00b8 \u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00cd\u00b7\u00cc\u00bc\u00c7\u00b6\u00c6\u00b6\u00a7\u00b6\u00c6\u00b6\u00c8\u00cd\u00bb\u00c7\u00af\u00b6\u00c6\u00b6\u00bc\u00c6 \u00a3\u00b7\u00c6\u00b7\u00c7\u00b4\u00c6\u0088\u00b8\u00c7\u00be\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00c1\u00bc\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7 \u00ac\u00b6\u00c6\u00b6 \u008c\u00be\u00af\u00c6\u00d0 \u00a3\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00c7\u00cc\u00bc\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00c7\u00cc\u00bc\u00b8\u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c6 \u00b6\u00c8\u00dd\u00b9\u00c6\u00b9\u00b6\u00c8\u00bb\u00ce\u00b4\u00c1\u00b6\u0081 \u00cd\u00ba\u00be\u00c6\" \u00a3\u00c1\u00c6\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u008c\u00be\u00af\u00c6\u00d0 \u00aa\u00bd\u00c6\u00da\u00ce\u00b4\u00b6\u00c6\u00b6\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 \u00a9\u00b8\u00cc\u00c1\u00bf\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6\" \u00a3\u00c1\u00c6\u00c1\u00c7\u00bf\u00c6 \u00a9\u00b7\u00c6\u00b6 \u00b7\u00c7\u00b4\u00c6\u0088\u0081\u0089\u00bc\u00b6\u00c8\u00b7\u00c8\u00b6\u00c8\u00bb\u00c7\u00af\u00e2\u00bf\u00c6\u00bf\u00c7\u00cd\u00bc\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00b7\u00c7\u00b4\u00c6\u0088\u0081\u0089\u00bc\u00ce\u00b1\u00bb\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u0088\u00c1\u00b6\u00c8\u00e2\u00bf\u00c6\u00bf\u00c1\u00dd\u00ba\u00c6\"\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c625\n\n\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00c7\u00c1\u00bd\u00c6\u00de{\u00b6\u00bc\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00af\u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c8\u0081 \u00b9\u00b5\u00c8\u00bb\u00c7\u00b4\u00c6\u00cc\u00b4\u00c7\u00d0\u00b6\u00c8\u008a\u00df\u00bf\u00c6\u00bf\u00c1\u00dd\u00ba\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a7\u00de\u00b9\u00c6\u0089\u00b8\u00bc\u00c8\u0081:\n\n(iii)\u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00ab\u00af\u00c6\u00af\u00c8\u00bb \u00b7\u00c7\u00d5\u00af\u00bf\u00c6\u00a3\u00ce\u00ba\u00b9\u00c6\u0089\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00ab\u00af\u00c6\u00af\u00c8\u00bb \u00a3\u00cc\u00ba\u00bc\u00c8\u00af\u00c6\u00af\u00a3\u00bc\u00d2\u00af\u00bf\u00c6 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u00b7\u00c7\u0081\u00d0 \u00a3\u00ba\u00c6\u00b1 \u00a7\u00b6\u008c\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u008c\u00cd\u00b1\u00b4\u00b6\u00c6\u00d7\u00c1 \u00db\u00af\u00c1\u00bc\u00c6\u00b7\u00c8\u00ce\u00be\u00bb\u00b6\u00c6\u00b6\u00c8\u0081 \u00a8\u00b4\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4 \u00ac\u00e1+\u00c6\u00af\u00ce\u00ba\u00b9\u00c6\u0089\u0081 \u00a8\u00b4\u00c7\u00af (\u00a3\u00b6\u0081\u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00d8\u00b4\u00c6\u00b9 \u00a7\u00b6\u008c\u00b9\u00c6 \u00b9\u00b5\u00c8\u00bb\u00af\u00ba\u00c6 \u00a7\u00b4\u00c6\u00b9\u00b4) \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00b1\u00c8\u00bb \u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c8\u0081 \u00a8\u00b4\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00b6\u00c6\u00b6\u00b6\u0081\u00ce\u00ba\u008a\u00b8\u00b6\u00c7\u00af \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c7\u00be\u00c6 \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00c1\u00de \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00ac\u00e1+\u00c6\u00af\u00ce\u00ba\u00b9\u00c6\u0089\u0081\u00a8\u00b4\u00c7\u00af \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0\u00af\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5\u00c1\u00bc\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00b7\u00c6\u00b6\u00b7\u00c8\u00da\u00b5\u00bc\u00c8\u0081\" \u00a4\u00cd\u00be\u00c7\u00b1\u00af\u00bc\u00c8\u0081\" \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\" \u00d8\u00b4\u00c6\u00b9\u008c\u00bb\u00be\u00c7\u00bf\u00bc\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00df\u00c1\u00be\u00af\u00bc\u00c8\u0081 \u00b1\u00ba\u00c6\u00b9\u00bf\u00ba\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u0089\u00bc\u00b6\u00c7\u00b8 \u00cd\u00c1\u00b6\u00b8\u00c7\u00b6\u00c8\u00b0\n\n(\u00a3)\u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00cd\u00af\u00bd\u00c6\u00b9\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00ac\u00e1+\u00c6\u00af\u00ce\u00ba\u00b9\u00c6\u0089\u00b8\u00c7\u00be\u00c6\" \u00b7\u00c8\u00af\u00c0\u00c6\u00b1\u00c6\u00b1\u00c8\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00ba\u0081\u00bd\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00d0 \u00ba\u00c7\u00b8\u00c8\u00bb\u00ba\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00a7\u00b6\u008c \u00a9\u0081\u00bd \u00c1\u00ce\u00af\u008a\u00be\u00c6\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b7\u00c8\u00b6\u00c8\u00af\u00bf\u00c8\u008b\u00dd\u00b7\u00c6\u00d7\u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00c7\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7 ;\u00a3\u00be\u00c6\u00be\u00d7\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c626\n\n(\u00a4)\u00a5\u00be+\u00c6\u00ce\u00af \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c6 \u00cc\u00b1\u00df\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b6\u00be\u00c6\u00be\u00cd\u00c1\u00c7\"\n\n\u00a3\u00c1\u00c6\u00c1\u00df\u00c1\u00bc\u00c8\u0081 ;\n\n(iv)\u00ab\u00af\u00c6\u00af\u00c8\u00bb\u00b7\u00c7\u00d5\u00af\u00bf\u00c6 \u00a3\u00ce\u00ba\u00b9\u00c6\u0089\u00b8\u00d7\u00ba\u00c6 \u00a3\u00b6\u0081 \u00b1\u00c8\u00bd\u00b9\u00c6\u00da\u00db\u00af\u00c1\u00bc\u00c6 \u00b7\u00c8\u00ce\u00be\u00bb+\u00c6\u00af\u00bf\u00c8\u00b8\u00d7\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4 \u00a3\u00ce\u00ba\u00b9\u00c6\u0089\u00b8\u00d7\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00a3\u00ce\u00b6\u00cc\u00bb\u00c7\u00b6\u00c6\u00b6 \u00b6\u0081\u00ce\u00ba\u00bb\u00c7\u00b8\u00b6\u00c7\u00af \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a3\u00ce\u00ba\u00b9\u00c6\u0089\u00b8\u00d7\u00ba\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00d8\u00b4\u00c6\u00b9 \u00ac\u00b6\u00c6\u00d7\u00ce\u00c0\u00b9\u00c6\u00da\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00ba\u00c6\u00a9\u00b6\u00b8\u00d7\u00ba\u00c6\u00af\u00c9\u00c0\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0 \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u0088\u008b\u00dd\u00b7\u00c6\u00d7\u00a3\u00d9\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00b9\u008a\u00bd\u00c6\u00b1\u00c8 \u00cc\u00b9\u00de\u00b7\u00bc\u00c8\u0081 ;\n\n(v)\u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00c1\u00b6\u00c8\u00b9\u00c1\u00dd\u00ba\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u00b9\u00c6 \u0089\u00bc\u00ce\u00b1\u00bb\u00be\u00c6\u00be\u00c7\u00b6\u00c1\u00dd\u00ba\u00c7\u00b8 \u00ab\u00af\u00c6\u00af\u00c8\u00bb\u00b7\u00c7\u00d5\u00af\u00bf\u00c6 \u00a3\u00ce\u00ba\u00b9\u00c6\u0089\u0081\u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a7\u00b6\u00c6\u00b6\u00c8\u00cd\u00bb\u00c7\u00af\u00b6\u00c6\u00b6\u00bc\u00c8\u0081 ;"
