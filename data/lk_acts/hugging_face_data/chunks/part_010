    "chunk_text": "\u00a4\u008a\u0081\" \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8 \u00ac\u0081\u00bd\u00c8\u0081 \u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6\u00d0\u00e1\u00cc\u00c1\u00c7\u0081\u00bd\u00c8\u0081 \u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c8\u0081\u00af\u00c9\u00c0\u00c6\u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00cc\u00be\u00c7\u0081\u00bd\u00c8\u0081 \u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6 \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00b8\u00d7 \u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c8\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00bd\u00c8\u008c\u00b6\u00c6\u00b6\u00cc\u00be\u00c7\u0081\u00de \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a4\u00bf\u00c6\u00a3\u00af\u00c6\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00dc\u00b4\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00d0\u00e1\u00e2\u00b4\u0081 \u00b6\u00ba\u00af\u00c6\u00d0 \u00a9\u00b7\u00c6\u00b6\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00ba\u00c6 \u00a5\u00be\u00c6\u00ce\u00be\u00cc\u00bb\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a4\u00b4\u00c6\u00af\u00bf\u00c6 \u00d0\u00e1\u00e2\u00b4\u0081 \u00b6\u00ba\u00af\u00c6\u00d0\u00a9\u00b7\u00c6\u00b6\u00b6\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da\u00ba\u00c6 \u00a5\u00be\u00c6\u00ce\u00be\u00cc\u00bb\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00c1\u00b6\u00c8\u00dc\u00ba\u00c6\u00cd\u00c1\u00cd\u00bd\u00c7\u00bc\u00c6 \u00a4\u00cd\u00bf \u00a3\u00b6\u0081 \u0089\u00bc\u00b6\u00c7\u00b8 \u00a3\u00df\u00c1\u00be\u00bc\u00c6 \u00a9\u00b8 \u00a9\u00ae\u0089\u00b6\u00c6\u00b6\u00c7\u00cc\u00be\u00c7\u00c0\u00c8\u00bb \u00a3\u00b7\u00c6\u00b6 \u00a4\