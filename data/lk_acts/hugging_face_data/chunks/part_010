    "chunk_text": "(\u00a4) \u00ac\u00dd \u00b6\u00b8\u00c8\u00bb\u00c7\u00bf\u00c8\u0081 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00b6\u00b8\u00c8\u00bb\u00c7\u00bf\u00c8\u0081 \u00a5\u00bd\u00b9\u00c6\u00da \u00b1\u00ba\u00c6\u00b9\u008c\u00b6\u00c6\u00b6 \u00a3\u00be\u00c6\u00be\u00d7\u00ac\u00dd \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00c1\u00de \u00a4\u00b4\u00c6\u00af\u00bf\u00c6\u00d0\u00e1\u008c\u0081 \u008c\u00b4\u00bb\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00ac\u00d5\u00b9\u00c6\u00da \u00aa\u00bd\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u00d5\u00af\u00c6\u00d0 \u00a3\u00b9\u00c6\u00b9\u00c7\u00be\u00c6 \u00a9\u00b7\u00c6\u00b6\u00b7\u00b4\u00c6\u00b4\u00db\u00ba\u00c6 \u00db\u0081\u00cc\u00af\u00c7\u00b5\u00bc\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c7\u00af\u00c7\u00d7 ;\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6113\n\n(\u00a6) \u00cc\u00b1\u00c7\u00b6\u00c6\u00d7\u00de\u00b6\u00c8\u00bb\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b1\u00c7\u00b6\u00c6\u00d7\u00de\u00b6\u00c8\u00bb\u00bd\u00c6\u00bd \u00c1\u00ce\u00af\u00bb\u00c7\u00af \u00b6\u008c\u00bc\" \u00cc\u00b1\u00c7\u00b6\u00c6\u00b6\u00c7\u00ae\u00ce\u00ba\u00ba\u00c7\u00bd\u00c6\u00bd\u00ba\u00c6 \u00aa\u00bd\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf \u00ac\u00dd \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081\u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b7\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a9\u00d7\u00e2\u00ba\u00c6\" \u00b7\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00b8 \u00b7\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b6\u00c7\u00b8 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00af\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u008c\u00bb\u00c7\u00b9\u00c7\u00bc\u00b6\u00c6\u00b6\u00c8\u0081 \u00b7\u00c8\u00bb\u00b6\u00c8\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4 \u00c1\u00dd\u00ba\u00c7\u00b8\u00b6\u00c6\u00d7\u00af\u00c6\u00cc\u00af\u00b6\u00c8\u00bc\u00c7\u00b6\u00be\u0081\u00bd\u00c8 \u00af\u00c0\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c7\u00af\u00c7\u00d7\u00b0\n\n\u00a5\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00d7\u00af\u00c6\u00af\u00c7\u00af \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u0081 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b9+\u00c6\u00d0\u00f2\u00be\u00b6\u00b8\u00b6\u00c6\u00b6\u00c8\u0081 \u00f2\u0081\u00bd\u00c8\u00cc\u00be\u00c7\u0081\u00de\u00af\u00c6\u00d0 \u00cd\u00ba\u00bd\u00c6\u00b9\u00b4\u00c6\u00b4\u00d7\" \u00b7\u00b4\u00c6\u00b4\u00ba\u00c6 \u00a9\u00b7\u00c6\u00b6\u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00be\u00c6 \u00a7\u00bd\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00be\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00cd\u00b7\u00bc\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9+\u00c6\u00d0\u00f2\u00be\u00b6\u00b8\u00b6\u00c6\u00ce\u00b6 \u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00af\u00c6\u00af\u00c7\u00b6 \u00a4\u00b4\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00cd\u00b7\u00bc\u0088\u00bb\u00c7\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00b7\u00c8\u00bb\u00ba\u00b6\u00c6\u00b6\u00bc\u00c6\u00af\u00bf\u00c6 \u00f2\u00be\u00ba\u00c6 \u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u00be\u00c6 \u00af\u00c0\u00c8\u00b9\u00c6\u00b9\u00b8\u00e2\u00af\u00c6\u00af\u00c7\u00b8 \u00cd\u00af\u00c7\u00bc\u00c8\u00af\u00c6\u00ce\u00af\u00ac\u0081\u00de \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00cd\u00b6\u00c7 \u00a3\u00c1\u00c6\u00c1\u00bc\u00c8\u00ba\u00b6\u00c8\u00b9\u00c6\u0093\u00b4\u00c6\u00b4\u00c7\u00ae\u0088\u0081 \u00a9\u00b7\u00c6\u00b6\u00cd\u00b7\u00bc\u00b6\u00c6\u00b6\u00c8\u00df\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u0081 \u00cc\u00b1\u00c7\u00b6\u00c6\u00d7\u00c1\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00ba\u00c7\u00bd\u00c6\u00bd\u00cc\u00ba\u00c7\u0081\u00de\u00b7\u00c8\u00af\u00c0\u00c6\u00b7\u00c6\u00b6\u00b6\u00c7\u00af\u00af\u00c6 \u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7\u00b0\n\n(6) (\u00a3) \u00ac\u00dd \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u0081 \u00a5\u00be\u00c7\u00b9+\u00c6\u00af\u00e0\u00ba\u00c6 \u00c1\u00dd\u00ba\u00c7\u00b8\u00db\u00ba\u00c6\" \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00c6\u00d0 (\u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8 \u00a5\u00b9\u00c6\u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6 \u2018\u008c\u00be\u00af\u00c6\u00af\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u2019\u00a9\u00b8\u00af\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 16 \u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\" 17 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\" 18 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\"19 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\" 20 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\" 21 \u00a9\u0081\u00d9\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\" \u00a3\u00be\u00c6\u00be\u00d7 22 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\"\u00a3\u00be\u00c6\u00be\u00d7 23 \u00a9\u0081\u00d9\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\" 24 \u00a9\u0081\u00d9\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 2000 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 38 \u00a4\u00ba\u00c6\u00a5\u00be\u00af\u00c6\u00af\" \u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u0081 17 \u00a4\u00ba\u00c6\u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\" 18 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\" 19 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u0081\u00af\u00c9\u00c0\u00c6\"\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 10 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\"\u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6114"
