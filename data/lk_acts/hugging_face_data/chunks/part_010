    "chunk_text": "(2) (1) \u00c9\u00be \u00a4\u00c0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c9\u00c8 \u00a8\u00eb\u00c4\u00a8\u00e0\u00cc\u00bf\u00cd\u00be\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00c2\u00c8\u00c0\u00ba\u00f2 \u00bc\u00fb\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00b4 \u00a6\u00ef\u00c7\u00cd\u00fa\u00c9 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0\u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a \u00c0\u00e6\u0095\u00b8\u00e8\u00c8\u00e0\u00c8\u00a8\u00e0 \u0097\u00c3\u00e5\u00aa \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00c0\u00cc\u00ea\u00c9 \u00cc\u00cd\u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00be\u00ea\u00aa\u00ba \u00a8\u00c7\u00e6\u00b8\u00ea \u00a1\u00be\u00ea\u00c9 \u00a4\u008e\u00ba \u00c6\u00c6\u00fa \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u00cc\u00ce\u00a8\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00bc\u00fb, \u00a6\u00c4 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5\u00c2\u00c8\u00c0\u00ba\u00f2 \u00bc\u00fb\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00bd\u00ea\u00c7\u00ef\u00c6\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4\u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5\u00b4 \u00c2\u00c8\u00c6 \u00a1\u00e6\u00ba\u00e0\u00ef\u00ba\u00e0 \u00c6.\n\n4.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 44 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00cd\u00ba\u00f8\u00be\u00e0 \u00c4 \u00c9\u00ec VII \u00c9\u00be\u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00cd\u00fa \u00a1\u00e6\u00ba\u00f8 \u00ca\u00fb\u00da\u00cb\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a2\u00c9\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00c9\u00b4\u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00ca\u00fb\u00da\u00cb\u00c6 \u00a1\u00e5\u00ef\u00bc\u00e0\u00ca \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014\n\n\u201c\u00a1\u00e5\u00c7\u00e5\u00c9\u00ea\u00c8\u00e0 \u00cc\u00c4\u00bb\u00c6\u00b4 \u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u201d\n\n5.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 45 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00dd\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00e0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a6\u00c4 \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 45\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6:\u2014\n\n45\u00a1. (1) \u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5 \u00ef\u00c4\u00ef\u00cd\u00c6\u00ea\u00c4\u00a8\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9 \u00c6\u008a\u00a1\u00e5\u00c7\u00e5\u00c9\u00ea\u00c8\u00a8\u00e0 \u00c0\u00e6\u00be \u00be\u00e6\u00aa\u00eb\u00b8 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e6\u00ba\u00f8 \u00c9\u00ec \u00c2\u00c9 \u00ef\u00cc\u00e5\u00c6\u00e5 \u00aa\u00be\u00ea\n\n\u00c2\u00c8\u00c0\u00ba\u00f2 \u00bc\u00fb\u00ef\u008a\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00b4\u00a6\u00ef\u00c7\u00cd\u00fa\u00c9\u00c0\u00e6\u0095\u00b8\u00e8\u00c8\u00e8.\n\n\u00a6\u00a8\u00ba\u00eb \u00a8\u00c7\u00be \u00c8\u00bc\u00aa\u00e5\u00cc\u00e0\u00ba\u00eb\u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00b4 \u00c2\u00e6\u00c7\u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0VII \u00c9\u00be \u00ef\u00a8\u00e5\u00b4\u00ef\u00cc\u00e0\u00ca\u00fb\u00da\u00cb\u00c6 \u00c0\u00f2\u00ba\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6\u00a8\u00f8\u00d7\u00c4.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00b445\u00a1 \u00a1\u00dd\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n\u201c\u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5\u00a1\u00e5\u00c7\u00e5\u00c9\u00ea\u00c8\u00e0.\n\n2006 \u00a1\u00e2\u00a8 22 \u00bc\u00c7\u00be \u009e\u00c9\u00c7 \u00cc\u00cd \u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba8\n\n\u00c8\u00c2\u00be \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8, \u00a6\u00c6 \u00c0\u00d7\u00a8\u00e0\u00cb\u00b8\u00c6 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00cc\u00c4\u00bb\u00c6\u00a8\u00b4\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00e0 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00be\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c2\u00c8\u00c6\u00c8\u00ba\u00e0\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00ef\u00c9\u00ba \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00b0\u00be\u00c7\u00e5\u00c8\u00e0\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a6\u00c4\u00a1\u00e5\u00c7\u00e5\u00c9\u00ea\u00c8 \u00ef\u00c6\u00e5\u00c4\u00ea \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6. \u00a6\u00c9\u00e6\u00be\u00f8 \u00c0\u00d7\u00a8\u00e0\u00cb\u00b8\u00c6\u00a8\u00e0\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00ef\u008a \u00bc\u00fb \u00c6\u008a \u00c2\u00c8\u00c0\u00ba\u00f2 \u00bc\u00fb\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00cc\u00cd\u00c6\u00c2\u00c8\u00c6\u00c8\u00ba\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5 \u00ef\u00c9\u00ba \u00c8\u00c2\u00e5 \u00bc\u00fa\u00c6 \u00cd\u00e6\u00a8\u00e8 \u00c6.\n\n(2) (1) \u00c9\u00be \u00a4\u00c0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0 \u00a1\u00e5\u00c7\u00e5\u00c9\u00ea\u00c8\u00a8\u00e0\u00c0\u00e8\u00ce\u00e8\u00c2\u00bf\u00c9 \u00c0\u00d7\u00a8\u00e0\u00cb\u00b8\u00c6\u00a8\u00e0 \u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00d1\u00c4 \u00cc\u00cd \u00a6\u00c6 \u00cc\u00c4\u00bb\u00c6\u00b4 \u00c0\u00ba\u00e0\u00a8\u00f8\u00d7\u00c4 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 44 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00cd 45 \u00c9\u00be\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00c9\u00ca\u00f1 \u00ef\u00c9\u00be\u00cc\u00e0 \u00a8\u00f8\u00d7\u008a \u00cc\u00cd\u00fa\u00ba\u00c9 \u00a1\u00bc\u00e5\u00ce\u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\u201d.\n\n6.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 49 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00e0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a6\u00c4 \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 49\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6 :\u2014\n\n49\u00a1. (\u00a1)\u00c9\u00c8\u00e2\u00aa\u00eb \u00c2\u00c8\u00c0\u00ba\u00f2\u00c6\u00a8\u00e0 \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00c6\u008a \u00b0\u00c8\u00d5\u00d1\u00c9\u00aa\u00e5 \u00ef\u00c4\u00ef\u00cd\u00c6\u00ea\u00c4\u00a8\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00be ;\n\n(\u00a1\u00e5)\u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fa\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u0090\u0095\u00be\u00e0 \u00c6\u008a\u0097\u00cb \u00cc\u00cd\u00fa\u00ba, \u00c0\u00e9\u00b6\u00e5\u00a8\u00e5\u00d7 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00e5\u00be\u00f8\u00bc\u00e5\u00c6\u00a8\u00f7\u00c9\u00f1\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00bc\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c0\u0097\u00ba\u00f2 \u00b0\u00c8\u00c6\u00c6\u008a \u00a1\u00c3\u00f1\u00be\u00e0\u00ba\u00c7 \u00b0\u00c8\u00e5\u00ca\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a\u00a2\u00b6\u00c4\u00a8 \u00c0\u00e5\u00d6\u00cc\u00d6\u00a8 \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00b4 \u00a1\u00cd\u00fa\u00ba\u00a8\u00c7\u00ef\u00c8\u00cc \u00c2\u00c8\u00c0\u00e5\u00be \u00a1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00c6\u008a \u00a2\u00b6\u00c4\u00a8\u00b4\u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00c7\u00be, \u00bc\u00c4\u00be, \u00ef\u00cd\u00e5\u00e0 \u00a2\u00b6\u00c4\u00a8\u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be, \u00c4\u00ea\u00bc\u00e5 \u00cd\u00d6\u00be \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4\u00b4, \u00bc\u00e6\u00e4\u00c4\u00b4, \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4\u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00e5 \u00cd\u00e6\u00d7\u00c4\u00b4 \u00a1\u00c9\u00cc\u00c7 \u00ef\u00bc\u00be ;\n\n(\u00a1\u00e6) \u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fa\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u0090\u0095\u00be\u00e0\u00c0\u00d6\u00cc\u00c7\u00c6\u00b4 \u00cd\u00e5\u00be\u00f8\u00bc\u00e5\u00c6\u00a8 \u00c2\u00c8\u00c0\u00e7\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00a8\u00c7\u00c9\u00be \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be ;"
