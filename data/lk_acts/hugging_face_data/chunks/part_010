    "chunk_text": "(XIII)\u008c\u00be\u00af\u00c6\u00af\u00bf\u00c8\u00b9\u00c6\u00da \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af\u00db\u00b9\u00c6\u00b9\u00d7 \u00ba\u00c8\u00be\u00c6\u008b\u00bb\u0081 \u00f4\u00b9\u00c7\u00e2\u00af\u00c6\u00d0\u00af\u00c6\u00d0\u00ce\u00bd\u00bb\u00c7\u00b6 \u00f2\u00be\u00b6\u00b8 \u00db\u00b6\u0095\u00cc\u00b4\u00c7\u0081\u00ce\u00bd\u00dc\u00ba\u00c6 \u00a7\u00ae\u00b5\u00c7\u00b4\u00c6\u00b4\u00bc\u00b1\u00c8\u00ce\u00bd\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u008120\u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u008c\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00aa\u00ce\u00b8\u00bb \u00af\u00b4\u00c6\u00b4\u00ce\u00bf\u00af\u00c6 \u00af\u00bd\u00c6\u00af\u00ce\u00bf\u00dc\u00ba\u00c6\u00cc\u00af\u00c7\u00ae\u00d5\u00bf\u00c6\u00bf\u00c1\u00c7\u00de\" \u00cc\u00af\u00c7\u00e1\u00ba\u00c6\u00da\"\u00af\u00ba\u00c6\u00b9\u00c4\u00c7 \u00a3\u00be\u00c6\u00be\u00c7\u00b6 \u00cd\u00c1\u00cd\u00bd\u00cd\u00b6\u00d9\u00ba\u00c6\u00ba\u00c7\u00c1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u00bb\u00c7\u00be\u00c6\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c630\n\n\u00da\u00b6\u00c8\u00bb\u00cc\u00b6\u00c7\u00dd \u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00da\u00db\u00bb\u00bd\u00c6\u00b1\u00c8\u008a\u00bd\u00c6\u00b9\u00bb\u0081\u00b9\u00d5\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00af\u00c7\u00af \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00af\u00ba\u00c6\u00cc\u00b9\u00b8\u00c8\u008a\u00b8\u00c7\u00be\u00c7\u00b8 \u00cc\u00b9\u00c7\u00bd\u00c8\u00b6\u00c6 \u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u00dc\u00ba\u00c6 \u00a9\u00b7\u00c6\u00b6\u00c8\u00bc\u00b6\u00c6\u00cc\u00b6\u00c7\u00d0\u00b6\u00c8\u00dc\u00ba\u00c6 ;\n\n(2) (\u00a4) \u00a9\u0081\u00d9\u00ba\u00c6 \u00b9\u00b7\u00c6\u00b6\u00c8\u008a\u00be\u00c6\"\n\n(\u00a3)(1) \u00a4\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00ce\u00b6 \u00b7\u00c9\u00af\u00c6\u00af\u00c8\u008c\u00b4\u00c6\u00d5 \u00a3\u00b6\u00bd\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8 \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :-\n\n\u201c(1) (\u00a3)\u00af\u00be\u00c6\u008c\u00b6\u00c6 \u00b6\u00c7\u00b9\u00b8\u00cc\u00ba\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b9\u00c6 \u00b9\u00c7\u00b4\u00b1\u00c7\u00ce\u00be\u00bb\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c7\u00be\u00c6\u00b7\u00c8\u00b6\u00c8\u00bb\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00c7\u00b4\u00b1\u00c7\u00ce\u00be\u00cc\u00bb\u00c7\u0081\u00bd\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 (2004\"\u00bb[\u00ce\u00be 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7\u00b9\u00bb\u00d9\u00bf\u00c6\u00bf) \u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b9\u00c6 \u00b9\u00c7\u00b4\u00b6\u00c6\u00b6\u00c8\u00b4\u00c6\u00b4\u00b6\u00c6\u00ce\u00b6\u00b9\u00c6 \u0089\u0081\u00b9\u00bd\u00c6\u00bd\u00c8\u00bb \" \u00af\u00be\u00c6\u008c\u00a3\u00ce\u00ba\u00b1\u00c6\u00d2\u00b4\u0081 \u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b9\u00c7\u00b4\u00b1\u00c7\u00ce\u00be\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c7\u00b8 \u00af\u00be\u00c6\u008c\u00b1\u00c6\u00cd\u00b1\u00ce\u00c1\u00af\u00bf\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\n\n(\u00a4)\u00a3\u00bc\u00b1\u00c7+\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00b8\u00c7\u00be\u00c7\u00b8\" \u00ba\u00c7\u00af\u00c7\u00b5\u00b1\u00ce\u00b9\u008a\u00b8\u00c7\u00be\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7\u00a7\u00bf\u00c6\u00f7\u00bc\u00b6\u00c8\u00af\u00c7\u00bc \u00b1\u00ce\u00b9\u008a\u00b8\u00c7\u00be\u00c7\u00b8\u00cc\u00b9\u00c7\u00d7 \u00d8{\u00be\u00af\u00b1\u00c6 \u00cd\u00b1\u00ce\u00c1 ;\u201d\u00b0\n\n(\u00a4)(IX) \u00a4\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8 \u00a5\u00d5\u00c1\u00b6\u0081 \u00f2\u00be\u00db\u00ba\u00c6 :\u2013\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c631\n\n\u201c(IX) \u00a3\u00ce\u00ba\u00b1\u00c6\u00b1\u00bc\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3+\u00c6\u00af\u00c9\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00de \u00a5\u00bb\u00bd\u00c6\u00ce\u00af\u00bb\u00c7\u00b8 \u00a3\u00be\u00c6\u00be\u00d7 \u00ba\u00b8\u00c8\u00b6\u00a3\u00c0\u00c8\u00e2\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u008c\u00ce\u00bf\u008c\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00c8\u0092\u00bc\u00c6 \u00a5\u00b4\u00dd\u00af\u00c6\u00d0 \u00b7\u00c8\u00c1\u00c7\u00bc\u00b5\u00ba\u00bf\u00c8\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00af\u00c7\u00af\" \u00cd\u00b6\u00b1\u00c8\u00bb \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00b6\u00c7\u00bc\u00b6\u00c6\u00b6\u00c8\u0081 \u00b7\u00be\u00ce\u00b8\u00af\u00c6 \u00af\u00dd\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6 \u00cc\u00af\u00c7\u00ae\u00d5 \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6\u00cc\u00b1\u00bb\u00bd\u00c6\u00b9\u00c7\u00b4\u00c6\u00d5\u00af\u00c6\u00d0 \u00cc\u00c1\u00bf\u00c8\u00b7\u00c7\u00b4\u00c6\u00d5 \u00ac\u00e1+\u00c6 \u00af\u00ce\u00ba\u00b9\u00c6\u00da\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00cd\u00b7\u00bc\u0088\u00bb\u00c7\u00af \u00b7\u00c8\u00b6\u00c8\u00bb\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c6\u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00b1\u00ce\u00c1\u00af\u00bf\u00c6 ;\u201d;\n\n(\u00a5)(xii) \u00a4\u00ba\u00c6 \u008c\u00b4\u00bb\u00b6\u00c6\u00ce\u00b6 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8\u00b1\u00c6 \u00cd\u00b1\u00bc\u00c6\u00b9\u00c6\u00b9\u00b6\u0081\u00f2\u00be\u00db\u00ba\u00c6 :-\n\n\u201c(xiii) \u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u00a3\u00b4\u00c6\u00b4\u00c1\u00ce\u00b5\u008a\u00bd\u00c6 \u00d0\u00bd\u00c8\u00b9\u00c6\u0093\u00d5 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00b6\u00b8\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6\u00cc\u00c1\u00b4\u00c6\u00d5 \u00ba\u00bc\u00af\u00c6\u00d0\u00bd\u00c6\u00bd\u00c8\u00af\u00e0\u00ba\u00c6\"\u00af\u00b9\u00c6\u00b9\u00be\u00c6\u00af\u00e0\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00b9\u00ae\u00b4+\u00c6\u00af\u00e0\u00ba\u00c6 \u00a5\u00be+\u00c6\u00ce\u00af\u00af\u00c6\u00d0\u00bf\u00c6 \u00a5\u00bd\u00af\u00c6\u00d0\u00ba\u00b6\u00c8 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00d5\u00ba\u00bf\u00e2\u00af\u00c6\u00d0 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb\u00cc\u00c1\u00b4\u00c6\u00d5\u00ba\u00bc\u00af\u00c6\u00d0\u00bd\u00c6\u00bd\u00c8\u00af\u00e0\u00ba\u00c6\"\u00af\u00b9\u00c6\u00b9\u00be\u00c6\u00af\u00e0\u00ba\u00c6 \u00a3\u00be\u00c6\u00be\u00d7\u00b9\u00ae\u00b4+\u00c6\u00af\u00e0\u00ba\u00c6 ;\n\n(xiv) \u00a7\u00bb\u00bc\u00c6 \u00da\u00bc\u00b6\u00b1\u00c6\u00b1\u00b6\u00c6\u00d7\u00ce\u00b4\u00bb\u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00a7\u00bb\u00bc\u00c6 \u00a8\u00af\u00c6\u00af\u00f2\u00b4\u00c6\u00d5\u00ba\u00c6 \u00af\u00ba\u00b3\u00c6\u00b1\u00c7\u00bc\u00c6 \u00a7\u00b5\u00e2\u00af\u00bf\u00c7\u00af \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6\u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u008a \u00b8\u00c7\u00be\u00c6\u00a3\u00ce\u00b4\u00bb\u00c7\u00bf+\u00c6\u00af\u00c7\u00b5\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00c1\u00c7\u00de\" \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6\u00b9\u008a\u00bc\u00c8\u00b4\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b6\u00bb\u00c7\u00bc\u00c8\u00b9\u00c6\u0089\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c632\n\n\u008b\u00dd\u00b7\u00c6\u00d7 \u00b6\u00bb\u00c7\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00a7\u00b5\u00e2 \u00a7\u00bd\u00c6\u00b9\u00b6\u00c6\u00b6\u00c8\u00b9\u00c6\u00cc\u00b9\u00c7\u00dd\u00b4\u00c6\u00af\u00bf\u00c6 \u00a3\u00b6\u00c6\u00d7\u00b4\u0081\u00da\u00bd \u00c1\u00bf\u00bc\u00c6\u00b1\u00c6\u00b1\u00c8\u00bb\u00c7\u00bf\u00bc\u00c6\u00af\u00bf\u00c8\u00b4\u00ba\u00c8\u00dd\u00b7\u00c6\u00d7 \u0089\u0081\u00cd\u00b8\u00c7\u00af\u00c6\u00af\u00c8\u00ac\u0081\u00bd\u00c8\u00ce\u00b5\u00e2\u00b4\u0081 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b6\u00c7\u00b8\u00c8\u00bb+\u00c6\u00af\u00bf\u00c8\u00b8\u00c7\u00be\u00c6\u00cc\u00b9\u00bd\u00c6\u00de\u00af\u00c6 \u00cc\u00af\u00c7\u00bf\u00c6\u00e0\u00b6\u00be\u00c6\u00af\u00bf\u00c6\u00cc\u00b9\u00c7\u00de\u00b9\u00c6\u00cd\u00b9\u00bd\u00c6\u00af\u00b9\u00c6\u00b9\u00d5 \u00b6\u00be\u00c6\u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 ;"
