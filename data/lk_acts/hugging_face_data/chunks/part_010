0\u00c0\u00cc\u00ea\u00c9 \u00a4\u00bc\u00e0\u00aa\u00ba \u00c9\u00be \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c8\u00e5\u00c3 \u00cd\u00e5 \u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u00c4\u00be\u00e0\u00a6\u00c4 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00a1\u00ba\u00eb\u00ef\u00c7\u00be\u00e0 \u00c6\u008a \u0097\u0093\u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00e0 \u00c6\u00b4\u00ef\u00ba\u00e0\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be \u00c8\u00bc \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0\u00c0\u00cc\u00ea\u00c9 \u00a6\u00a8\u00e0 \u00a1\u00c9\u00ea\u00c7\u00e6\u00bc\u00e0\u00bc\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00ef\u00cd\u00e5\u00e0 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a\u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00fa\u0095\u00c6\u00a8\u00eb\u00b4 \u00ef\u00aa\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c6\u00a8\u00e0 ;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba30\n\n(\u00a4\u00f0)\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e8\u00ce\u00e8\u00ef\u00c9\u00c8\u00e8\u00be\u00e0 (\u00a1), (\u00a1\u00e6), (\u00a1\u00e7), (\u00a2), (\u00a3)\u00ef\u00cd\u00e5\u00e0 (\u00a4) \u00ef\u00d8\u00bc\u00c9\u00c8 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0\u00a8\u00c7 \u00ba\u00f8\u00ef\u00c2\u00be \u00a8\u00e5\u00c8\u00cc\u00e9\u00c4\u00e5\u00c9 \u00ba\u00eb\u00ce \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u00c8\u00e6\u00c2\u00ec \u00a6\u00c9\u00e6\u00be\u00f8 \u00cc\u00e7\u00c4\u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c6\u00a8\u00f8\u00be\u00e0 \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0 \u00cd\u00e8\u0095\u00c6\u00a8\u00eb\u00b4 \u00ef\u00aa\u00c9\u00be\u00c8\u00bc \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c6\u00a8\u00e0, \u00a6\u00e0 \u00ef\u00bc\u00c9\u00be\u00ea\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c6 \u00ef\u00aa\u00c9\u00be\u00ea\u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00a6\u00e0 \u00cc\u00c4\u00e5\u00aa\u00c4 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00ce\u00c4\u00ea\u00c9 \u00cc\u00bf\u00cd\u00be\u00e0 \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c6 \u00c8\u00e6\u00c2\u00ec\u00c6\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00ba\u00eb\u00c8 \u00be\u008a \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0\u00c0\u00cc\u00ea \u00a6\u00a8\u00e0\u00c9\u00da\u00cb\u00c6\u00a8\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba \u00be\u008a ;"
