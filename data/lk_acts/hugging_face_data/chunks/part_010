    "chunk_text": "(i)\u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00bc\u00c4\u00e5\u00c0\u00e8\u00c6\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00ef\u00a8\u00be\u00a8\u00eb\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0\u00ef\u00ef\u00be\u00ba\u00f8\u00a8 \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u00ef\u00aa\u00e0 \u00a8\u00e6\u00c4\u00e6\u00ba\u00e0\u00ba \u00ef\u00be\u00e5\u00c4\u00e6\u00ba\u00f8\u00c9 \u00c6\u008a\u0097\u00ef\u00bc\u00e0\u00ca \u00c7\u00b4\u00a8\u00b4 \u00aa\u00c4\u00be\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00ce\u00c4\u00c6\u00e5\u00b4\u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u00c8\u00cc\u00e0\u00c9\u00e5 \u00ef\u00bc\u00be \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00bd\u00e5\u00c7 \u00a8\u00c7\u00be ;\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00b4\u00a1\u00f5\u00ba\u00f8\u00be\u00e0 360\u00a1\u00e7 \u00cc\u00cd360\u00a2 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n\u201c\u00bc\u00c7\u00e6\u00a8\u00c4\u00b4 \u00cd\u00bc\u00e5\u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a1\u00bc\u00e5\u00ce\u00c9\u00e6\u00c7\u00bc\u00fa.\n\n2006 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba 11\n\n(iii)\u00ce\u00c4\u00c6\u00e8\u00be\u00e0 \u00bc\u00e6\u00d7\u00ef\u008a \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a8\u00e5\u00be\u00e0\u00ba\u00e5\u00c9\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0\u00a1\u00c5\u00ea-\u00cc\u00e6\u0095 \u00c6\u00ea\u00c9\u00c8\u00a8\u00e0 \u00c2\u00bf\u00c9\u00e5 \u00aa\u00be\u00e0\u00be\u00e5 ;\n\n(iv)\u00a4\u00c0\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00f8\u00d7\u00c4 \u00cd\u00e5 \u00cc\u008a\u00c2\u00be\u00e0\u00bd \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00c9\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0, \u00a4\u00c0\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00f8\u00d7\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c3\u00e5\u0097\u00ba \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a\u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0 \u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba \u00c6\u008a\u00a4\u00c0\u00e0\u00c0\u00e6\u00be\u00e0\u00be \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0 \u00c9\u00f1\u00e5\u00b0 \u00ef\u00c8\u00cc \u00ef\u00c9\u00be\u00cc\u00e0\u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u00c9\u00cc\u00c7 \u00ef\u00bc\u00be ;\n\n(v)\u00c4\u00ea\u00bc\u00c8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c0\u00f2\u00ba\u00f8\u00ca\u00e0\u00b5\u00e5\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00a1\u00e5\u00ef\u00c7\u00e5\u00e0\u00aa\u00f1\u00ca\u00e5\u00c8\u00e5\u00c9\u00c8\u00e8\u00be\u00e0, \u00a8\u00e5\u00be\u00e0\u00ba\u00e5 \u00db\u00a8\u00c9\u00c7\u00b8\u00e5\u00c3\u00e5\u00c7\u00be\u00f8\u00c9\u00e5\u00cc\u00c9\u00c8\u00e8\u00be\u00e0, \u00cc\u00e5\u00c6\u00be\u00c9\u00c8\u00e8\u00be\u00e0, \u00c8\u00bc\u00c7\u00e6 \u00c0\u00e5\u00cc\u00c8\u00e0\u00c9\u00c8\u00e8\u00be\u00e0,\u00bc\u00fa\u00c9\u00e5 \u00cc\u00ea\u00db\u00a8\u00eb\u008a \u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00c9\u00c8\u00e8\u00be\u00e0, \u00ce\u00c4\u00c6\u00fa\u00be\u00e0\u00db\u00a8 \u00c2\u00c8\u00e5 \u00aa\u00be\u00e0\u00be\u00e5 \u00ef\u00c9\u00be\u00ba\u00e0 \u00ce\u00c4\u00e5\u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00c9\u00c8\u00e8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00ea\u00c3 \u00cc\u00e5\u00bd\u00a8\u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00c9\u00c8\u00e8\u00be\u00e0 \u00ce\u00c4\u00c6\u00fa\u00be\u00e0 \u00a8\u00eb \u00b4\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a\u00be\u00f8\u00c6\u00e6\u00c8\u00e9 \u00cc\u00e8\u0090\u00be \u00ef\u00cd\u00e5\u00e0 \u00ce\u00c4\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c4\u00c9\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00ba\u00da\u00b0\u00be\u00c6 \u00a8\u00e8\u00d7\u00ef\u00c4\u00be\u00e0 \u00bc\u00c7\u00e6\u00a8\u00c4\u00b4 \u00cd\u00bc\u00e5\u00aa\u00e6\u00be\u00f9\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00a6\u00c4 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0\u00c4\u00bd\u00f1\u00cc\u00e0\u00bb\u00e5\u00be\u00ef\u00c6\u00be\u00e0 \u00ce\u00c4\u00c6\u00e5 \u00a8\u00eb \u00b4\u00be\u00c6 \u00a8\u00c7\u00be ; \u00ef\u00cd\u00e5\u00e0\n\n(vi)\u00ce\u00c4\u00c6\u00e5\u00ef\u00aa\u00e0 \u00c4\u00c9 \u00ef\u00cc\u00e0 \u00c9\u00f1\u00e5\u00b0 \u00ef\u00c8\u00cc \u00ef\u00c0\u00be\u00f9 \u00cc\u00e8\u0090\u00be \u00ef\u00cd\u00e5\u00e0\u00a6\u00ef\u00cc\u00e0 \u00c9\u00f1\u00e5\u00b0 \u00ef\u00c8\u00cc \u00ef\u00c0\u00be\u00f9 \u00cc\u00e8\u009b\u00c4\u00b4 \u00a4\u00c0\u00a8\u00e5\u00d7 \u00c9\u00be,\n\n\u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c9\u00c7\u00bc\u00a8\u00b4 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00c9\u00be \u00a1\u00ba\u00c7,\u00a6\u00ef\u00cc\u00e0 \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u008a \u00bc\u00fb \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u0097\u00cc\u00e0\u00cc\u00a8\u00e0\u00ef\u00be\u00e5\u00a2\u00a8\u00e0\u00c4\u00c9\u00be \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00a8\u00f8\u00be\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00b6\u00c6\u00a8\u00f8\u00be\u00e0\u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00e0 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00bc\u00b6\u00c6 \u00c6\u00be\u00ef\u00bc\u00a8\u00f8\u00be\u00e0\u00c4 \u00a7\u00cd\u00ea\u00b4 \u00bc\u00b9\u00ea\u00c9\u008a \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00cd\u00fa \u201c \u00ce\u00c4\u00c6\u00e5 \u201d \u00c6\u00be\u00e0\u00ef\u00be\u00be\u00e0, \u00c9\u00c6\u00cc\u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00bc\u00cd\u00a1\u00b4\u00b4 \u00a1\u00b6\u00ea \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00ef\u008c.\n\n2006 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u00bc\u00b8\u00e0\u00b6 \u00be\u00f9\u00ba\u00f8 \u00cc\u00e2\u00aa\u00f2\u00cd\u00c6 (\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba12\n\n360\u00a2. (1) \u00ce\u00c4\u00c6\u00a8\u00eb \u00c8\u00e8\u00e2\u00aa\u00e8\u00a8 \u00a1\u00c0\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a\u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5\u2014\n\n(\u00a1)\u00c9\u00c6\u00cc \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00bc\u00cd \u00a1\u00b4\u00b4 \u00a1\u00b6\u00ea \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0 ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a1\u00e5)\u00c9\u00c6\u00cc \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00bc\u00cd \u00a1\u00b4\u00b4 \u00a1\u00b6\u00ea \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00c2\u00c9\u00b4\u0097\u00ca\u00e0\u00c9\u00e5\u00cc \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0,\n\n\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c9 \u00ba\u00eb\u00ce \u00bc\u00fb \u00ef\u00cd\u00e5\u00e0 \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00cc\u00e8\u00b4 \u00a8\u00c9\u00c7\u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00ef\u00c0\u00ce\u00c5\u00c9\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00a1\u00e6\u0097\u0090\u00c8\u00e8 \u00a8\u00c7\u00be\u00a8\u00c9\u00c7 \u00ef\u00cd\u00e5\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ce\u00c4\u00c6\u00a8\u00eb \u00ef\u00c0\u00ce\u00c5\u00c9\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4\u00a1\u00e6\u0097\u0090\u00c8\u00e8 \u00a8\u00f8\u00d7\u00ef\u008a \u00c9\u00c7\u00bc \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be \u00a1\u00ba\u00c7, \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u009f\u00ef\u008a \u00bc\u00fb \u00a1\u00c9\u00ea\u00c7\u00e6\u00f3 \u00bc\u00cd\u00c6\u00a8\u00b4 \u00c9\u00e6\u0091 \u00ef\u00be\u00e5\u00c9\u00be \u00a8\u00e5\u00c8\u00c6\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00bc\u00b6\u00c6\u00a8\u00b4 \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00c4\u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00bc\u00b6\u00c6 \u00c6\u00be \u00ef\u00bc\u00a8\u00b4\u00c4 \u00ef\u00cd\u00e5\u00e0\u00a7\u00cd\u00ea \u00c6\u00b4\u00ba\u00e0 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\u201d .\n\n10.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 364 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a1\u00e6\u00ba\u00f8 3 \u00c9\u00be \u00c0\u00e6\u00cd\u00e6\u00bc\u00fa\u00c8\u00e8\u00a8\u00f8\u00d7\u00c4\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00c0\u00e6\u00cd\u00e6\u00bc\u00fa\u00c8\u00e8 \u00a8\u00f8\u00d7\u00c4 \u00a6\u00a8\u00ba\u00eb \u00a8\u00f8\u00d7\u00ef\u00c4\u00be\u00e0 \u00a6\u00c4\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00e8\u00be\u00e0 \u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00ef\u0089 :\u2014"
