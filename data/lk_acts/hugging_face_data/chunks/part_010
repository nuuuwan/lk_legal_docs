    "chunk_text": "(3) \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00c8\u00be\u00c6\u00be\u00ce\u00bd\u008c\u00bd\u00c6\u00b9\u00ce\u00b8\u00bb\u00c7\u00bf\u00bc\u00c8\u0081 \u00b9\u00b6\u00c8\u00e2 \u00a9\u00b7\u00c6\u00b7\u00c8\u00b9\u00b7\u00c6\u00b6\u00ce\u00b8\u00af\u00c6\u00af\u00ce\u00ba\u00bb\u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b7\u00c8\u00b9\u00b7\u00c6\u00b6\u00ce\u00b8 \u00a9\u00b6\u00ce\u00b8\u00dc\u00ba\u00c6\u00ba\u00c9\u00de\u00af\u00c8\u0081\u00bd \u00a3\u00b7\u00c6\u00b6 \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00c8\u00be\u00c6\u00be\u00ce\u00bd\u008c\u00bd\u00c6\u00b9\u00ce\u00b8\u00bb\u00c7\u00bf\u00bc\u00c6 \u00b6\u00c1\u00cc\u00bd\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00af\u00c6 \u00d0\u00bd\u00c6\u00bd\u00c1\u00c7\u00bf\u00c8\u00bb\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081\" \u00b7\u00c9\u00b6\u00c8\u00c1\u00c7\u00cc\u00b8\u00c7\u00dd\u00c1\u00bc\u00c8\u0081\u00db\u0081\u00b8\u00bc\u00c6 \u00d2\u00dd\u00af\u00c6\u00af\u00db\u00ce\u00bd \u008c\u00bf\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 \u0089\u0081\u00b8\u00bc\u00c6\u00d0\u00bd\u00c6\u00bd\u00b6\u00c6\u00b6\u00c9\u00bc\u00c6\u00b9\u00c6\u00b9\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u0081\u00cd\u00ba\u00be\u00c6\" \u00ad\u00bc\u00c6 \u00a5\u00be\u00b4\u00c6\u00b1\u00ba\u00c6\u00f4\u00b9\u00c7\u00ce\u00c1 \u008c\u00b3\u00c6\u00b1\u00c7\u00b6 \u00d0\u00bd\u00c6\u00bd\u00b9\u00c6\u00b9\u00b5\u00cc\u00ba\u00c7\u0081\u00de\u00af\u00c6\u00d0\u00ba\u00c6\u00a3\u00c1\u00bc\u00d7 \u00b9\u00b6\u00c8\u00e2 \u00a5\u00be\u00c6\u00be\u00c7\u00b6\u00c7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0\u00ba\u00c6\u00a4\u00bf\u00c7\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(5) \u00a5\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00b6\u00c6\u00b6\u00c8\u00be\u00c6 \u00db\u00bc\u00b5\u00c7\u00b8 \u00cd\u00c1\u00cc\u00bd\u00ce\u00c1\u00cd\u00bb\u00d9\u00ba\u00c6\u00aa\u00bd\u00c6\u00b9\u00c7\u00d5\u00af\u00bf\u00c6 \u00a9\u00c1\u00c6\u00c1\u00c7\u00bd\u00c8\u00dd\u00b9\u00c6\u0089\u00d9\u00ba\u00c6\" \u00ac\u00c1\u00c6\u00cd\u00c1\u00c7\u00bc\u00c6\u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00c8\u00be\u00c6\u00be\u00ce\u00bd \u008c\u00bd\u00c6\u00b9\u00ce\u00b8\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c617\n\n\u00bb\u00c7\u00bf\u00dd\u00af\u00c6\u00d0\u00ba\u00c6 \u00a4\u00ce\u00b5\u00bb\u00c7\u00bf\u00bc\u00c6 \u00b6\u00ce\u00be\u00ce\u00ba\u00bb\u00b6\u00c8\u00b9\u00b6\u00c8\u008a\u00b8\u00c7\u00be\u00c6 \u00ba\u00c7\u00b6\u00c7\u00b7\u00c6\u00b6 \u00c1\u00bc\u00c8\u008c\u00b6\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00bd\u00c6\u00b9\u00c7\u00be\u00b8\u00c1\u00c7\u00b8\u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u00af\u00bf\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00cc\u00b6\u00c7\u00d7\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00cc\u00ba\u0081\u00b9\u00d7\u00b4\u0081\" \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00a3\u00b6\u00c8\u00af\u00c7\u00bc\u00ba\u00bf\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4\u00b1\u00c8\u00be\u00c6\u00be\u00ce\u00bd \u008c\u00bd\u00c6\u00b9\u00ce\u00b8\u00bb\u00c7\u00bf\u00bc\u00c6 \u00a3\u00b6\u00bd\u00c6\u00af\u00c8\u00b5+\u00c6\u00af \u00ba\u00c7\u00b6\u00c7\u00b7\u00c6\u00b6\u008c\u00c1\u00bc\u00b6\u00c6\u00b6\u00c8\u00bc\u00b4\u00c6\u00d5\u00af\u00c6\u00af\u00ce\u00bf\u00af\u00c6 \u00cc\u00af\u00c7\u00d5\u00b6\u00c6\u00d7\u00b6\u00e2\u00b6\u00df\u00ba\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\n\n(6) \u00a5\u00b9\u00c6\u0089\u00bc\u00c8\u008c\u0081 \u00cd\u00b7\u00c7\u00af\u00c6\u00af+\u00c6\u00af\u00e0\u00af\u00c6\u00af\u00c7\u00af -\n\n\u201c\u00a7\u00be\u00c6\u00be\u00c7\u00b1\u00b9\u00c6 \u00b9\u00bb\u00b5\u00c8\u201d \u00a9\u0081\u00b9\u00d7\" \u00a5\u00be+\u00c6\u00ce\u00af\u00b9\u00c6\u0089\u00bc\u00ce\u00b1\u00cc\u00bb\u00c7\u00dd\u00c1\u00bc\u00be\u00c6\u00be\u00c7\u00b6\u00c1\u00dd\u00ba\u00c6\u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00df\u00af\u00c6\u00af\u00ba\u00bc\u00c6\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00b4\u00c7\u00b6\u00c1\u00dd\u00ba\u00c6\" \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00c1\u00bc\u00c6\u00a5\u00be+\u00c6\u00ce\u00af\u00ce\u00bb \u00cd\u00b6\u00b6\u00c8\u00af\u00c6\u00d0 \u00db\u0081\u00b8\u00bc\u00c7\u00b8\u00a5\u00bc\u00ae\u00b4\u00c7\u00ae\u00d5\u00af\u00bf\u00c8\u00be\u00c6 \u00db\u00b7\u00c6\u00d8{\u00bd\u00c6\u00de\u00a3\u00de\u00b9\u00b6\u00c6\u00ce\u00b6\u00b7\u00c6\u00d7 \u00b7\u00c7\u00b4\u00c6\u00af\u00e0\u00af\u00c6\u00cd\u00af\u00c7 \u00a3\u00b6\u00bd\u00c6\u00af\u00b6\u00c8\u00af\u00ba\u00c7\u00af\u00cd\u00c1\u00c7 \u00a5\u00be+\u00c6\u00ce\u00af\u008a\u00be\u00c6 \u00c1\u00b6\u00c8\u00bb\u00c7\u00b6\u00c1\u00dd\u00ba\u00c7\u00b8 \u00a9\u00c1\u00cd\u00bc\u00d9\u00ba\u00c6 \u00b6\u00b8\u00c8\u00bb\u00c7\u00bf\u00c6\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c7\u00d0\u00ba\u00c6 ;\n\n\u201c\u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c6\u201d \u00a9\u0081\u00b9\u00d7\" \u00c1\u00bc\u00c6\u00b6\u00c6\u00b6\u00ba\u00c7\u00b8\u00c8\u008a\u00be\u00c6 \u00cc\u00c1\u00bf\u00c8\u008a\u00b4\u00b9\u00c6\u00b9\u00d5\u00ba\u00c6 \u00af\u00b4\u00c6\u00b4\u00ce\u00bf \u00f2\u00be\u00ba\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00c1\u00c7\u00bd\u00c7\u00b8 \u00a3\u00b6\u00c6\u00b6\u00ce\u00af\u00bb \u00b9\u00ae\u00b4+\u00c6\u00af\u00bf\u00c7\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6\u00b0\u201d\u00b0\n\n15\u00b0 \u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6 \u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081 71 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00e2\" \u00a3\u00b6\u0081 (2)\u00a4\u00ba\u00c6\u00a7\u00b4\u00c6\u0089\u00bc\u00c8\u00e2\u00af\u00c6\u00d0\u00b9\u00c6 \u00b9\u00b6\u00c8\u00be\u00c7\u00af\u00b9\u00c6 \u0089\u0081\u00c1\u00dd\u00c1\u00b6\u00ce\u00b8 \u00a5\u00d5\u00c1\u00b6\u0081\u00f2\u00be\u00ba\u00c6\u00a5\u00b6\u00c6\u00b6\u00c7\u00bd\u00c6\u00bd\u00c8\u00dd\u00b6\u00c6\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00d7 :-\n\n\u201c(2) \u0089\u0081\u00c1\u00dd\u00c1\u00b8 \u00b7\u00c8\u00b6\u00c8\u00bb\u00b6\u00c6\u00d7\u00af\u00c6\u00d0 \u00c1\u00bc\u00e2\u00ce\u00c1\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00d5\u00b6\u00be\u00c6 \u00cd\u00c1\u00ae\u00d5\u00ba\u00c6 :-\n\n(i) 2002\" \u00ad\u00af\u00b6\u00c6\u00d7 1 \u00a4\u00ba\u00c6 \u00cd\u00b6\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7\u00cc\u00b6\u00c7\u00b4+\u00c6\u00d0\u00af\u00c8\u0081\u00bd \u00af\u00c7\u00be\u00b9\u00c6\u00b9\u00d0\u00b6\u00c8\u008a\u008b\u00dd\u00b7\u00c6\u00d7\u00a4\u00bc\u00ba\u00c6\u0089\u00b9\u00c6\u00b9\u00b6\u00c7\u00b8 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00ba\u00c7\u00b6\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6\u00a3\u00b6\u0081\u0089\u0081\u00b8\u00bc\u00c7\u00b8 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00ba\u00c7\u00b6\u00b6\u00c6\u00ce\u00b6\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008171 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00b6\u00c6\u00b6\u00c8\u00dd\u00b6\u00c6\u00d7\u00b6\u00be\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 8 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00cd\u00b1\u00bc\u00c6\u00cc\u00b9\u00de\u00ba\u00b6\u00c8\u00c1\u00bc\u00c8(\u00b6\u00c8\u00dd\u00b6\u00c6\u00b6\u00b1\u00c6) \u00b1\u00b4\u00c6\u00b4\u00ba\u00c618\n\n\u00db\u00b6\u0081\u00ce\u00ba\u00b1\u00c6\u00b1\u00b4\u00c6\u00b4\u00c1\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u008173 \u00a4\u00ba\u00c6 \u0089\u00bc\u00c8\u00ce\u00c1\u00ba\u00c7\u00bd\u00c6\u00bd\u00c9\u00d5 \u00cc\u00b1\u00bb\u00c6\u00b6\u00be\u00c6\u00b0\n\n\u00dc\u00ba\u00c6 \u00a7\u00b4\u00b8\u00d5\u00b6\u00c6\u00d7\u00c1\u00dd\u00ba\u00c6 \u00ba\u00c7\u00b6\u00b6\u00c6\u00b6\u00c8\u0081\u00b9\u00b6\u00c8\u00ce\u00b8\u00b7\u00c6\u00b6\u00c7\u00ba\u00c6 \u00b7\u00c7\u00bf\u0081\u00de \u00a3\u00be\u00c6\u00be\u00d7 \u00a3\u00b6\u0081\u00db\u0081\u00b8\u00bc\u00c6\" \u00a3\u00b7\u00c6\u00b6 \u00ac\u00c1\u00c6\u00cc\u00c1\u00c7\u00dd \u00ba\u00c7\u00b6\u00b6\u00c6\u00b6\u00c8\u00df\u00ba\u00c6\u00cd\u00b1\u00af\u00bc\u00c8\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00c1\u00bc\u00c8\u008a\u0081 \u00a5\u00dd\u00b9\u00b6\u00c6\u00ce\u00b6\u00b7\u00c6\u00d7\u00b1\u00b6\u0096\u00b6\u00ba\u00c6 ; \u00a3\u00b6\u00c6\u00d7\u00b4\u0081"
