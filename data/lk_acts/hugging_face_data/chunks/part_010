    "chunk_text": "(iii)\u00a6\u00e0 \u00c0\u00ea\u00b8\u00f1\u00e5\u00c6\u00ba\u00be\u00c6 \u0097\u00cc\u00e8\u00be\u00e0 \u00c0\u00e5\u00c8\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00ef\u00c0\u00e5\u00f3\u00c0\u00ec\u00b0\u00be\u00f9\u00c6 \u00cc\u00e0\u00bb\u00e5\u00be\u00c6\u00b4, 1815 \u00c4\u00e5\u00da\u00ba\u00eb \u00c4\u00cc 2 \u00c9\u00be \u00bc\u00fa\u00be\u00b4 \u00ef\u00c0\u00c7\u00c7\u00e5\u00b0\u00a8\u00f9\u00c6 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00ba\u00e7\u00aa\u00fa\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00ef\u00bc\u00e0\u00c0\u00ce\u00a8\u00f8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4,\u00a6\u00e0 \u00c0\u00f2\u00bc\u00e5\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ea\u00ef\u008c \u00c6\u008a \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00bc \u00a6\u00e0\u00a8\u00e5\u00da\u00c6\u00ef\u00c6\u00cd\u00fa\u00c8\u00e5 \u00a6\u00e0 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c0\u00e5\u0097\u0083\u008e \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be\u00ba\u00e5\u00a8\u00e0\u00f3\u00c7\u00b4, \u00a6\u00e0 \u00ef\u00bc\u00e0\u00c0\u00ce\u00e8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c9\u00be\u00e0\u00be\u00e5\u00c9\u00ec \u00a6\u00e0 \u00c0\u00ea\u00b8\u00f1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4;\n\n(\u00a3)\u00ef\u00c9\u00ef\u00ce\u00bf \u00be\u00e6\u008c \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb \u00ef\u00c9\u00ba \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7\u00be \u00c8\u00bc \u00ef\u00c6\u00e5 \u00c6\u00e5\u00ba\u00f2\u00e5\u00cc\u00cd \u0097\u00ef\u00be\u00e5\u00e0\u00bc \u00c6\u00e5\u00ba\u00f2\u00e5 \u00ef\u00cc\u00e0\u00c9\u00c6\u00a8\u00e0 \u00c0\u00c9\u00ba\u00e0\u00c9\u00e5\u00ef\u00aa\u00be \u00c6\u00e5\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00c9\u00ec \u00c6\u008a\u00c9\u00f1\u00c9\u00cc\u00e5\u00c6\u00a8\u00e0 \u2013\n\n(ii)\u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00a1\u00be\u00ea\u00c4\u00ba \u00a8\u00c7 \u00a1\u00e6\u00ba\u00e0\u00be\u008a,\n\n\u00a6\u00e0 \u00c9\u00f1\u00c9\u00cc\u00e5\u00ef\u00c6\u00e0 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba18\n\n(\u00a4) (i) 1978 \u00a1\u00e2\u00a8 1 \u00bc\u00c7\u00be \u00b4\u00c9\u00da\u00ef\u00cd\u00e5\u00e0\u00c8\u00e0 \u00c7\u00ad\u00cd\u00c8 \u00c0\u00bc\u00be\u00c4 \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00b4\u00c9\u00da\u00ef\u00cd\u00e5\u00e0\u00c8\u00e0 \u00c7\u00ad\u00cd\u00c8 \u00c0\u00bc\u00be\u00ef\u008a;\n\n(ii)1960 \u00a1\u00e2\u00a8 57 \u00bc\u00c7\u00be \u00c4\u00bd\u00f1\u00c4 \u00cc\u00e2\u00cc\u00e0\u00a8\u00ee\u00ba\u00f8\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8 \u00c0\u00be\u00ba\u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00c4\u00bd\u00f1\u00c4 \u00cc\u00e2\u00cc\u00e0\u00a8\u00ee\u00ba\u00f8\u00a8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0; \u00cc\u00cd\n\n(iii)1978 \u00a1\u00e2\u00a8 7 \u00bc\u00c7\u00be \u00b0\u00be\u00e5\u0093\u00c0\u00ba\u00f8\u00c9\u00c7\u00c6\u00e5\u00ef\u00aa\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e0 \u00c0\u00be\u00ba\u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00b0\u00be\u00e5\u0093\u00c0\u00ba\u00f8 \u00a1\u00c7\u00c4\u00ea\u00bc\u00ef\u00c8\u00e0,\n\n\u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4,\n\n\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n8. (1) (\u00a1) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00be\u00c7\u00b0\u00ef\u00c6\u00e0 \u00b0\u00be\u00e5\u0093\u00c0\u00ba\u00f8 \u00bd\u00ea\u00c7\u00ef\u00c6\u00be\u00e0 \u00c6\u008a\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4 \u00c8\u00e6\u00ef\u00c2\u00be \u00c0\u0091\u00be\u0091, \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00cc\u00cd\u00ef\u00c9\u00be\u00ba\u00e0 \u00c0\u00f2\u00ba\u00f8\u00c8\u00e5\u00c3 ;\n\n(\u00a1\u00e5) (i) \u00b0\u00be\u00c7\u00b0\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00c6\u008a \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0\u00c8\u00c2\u00be \u00bd\u00ea\u00c7\u00c6\u00a8\u00e0 \u00bc\u00c7\u00be \u00c6\u008a \u00c0\u00ea\u00bc\u00e0\u00aa\u00c8\u00c6\u00a8\u00eb\u00b4;\n\n(ii) \u00c0\u00e5\u00da\u00c8\u00e8\u00ef\u008a\u00be\u00e0\u00ba\u00eb\u00c9 \u0097\u00cc\u00e8\u00be\u00e0 \u00c6\u008a \u00c7\u00e5\u00b0\u00f1 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00b4\u00c9\u00e5\u00da\u00cb\u00e8\u00a8\u00c9 \u00a6\u00e0\u00a8\u00e5\u00c2\u00bc\u00e0\u00bd \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00e8\u00be\u00e0 \u00cc\u008a\u00c4\u00ba \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00c4\u00ea\u00bc\u00c8\u00e0\u00c9\u00c8\u00e8\u00be\u00e0 \u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00ef\u00c6\u00be\u00e0\u00c4 \u00ef\u00cd\u00e5\u00e0 \u00a2\u00be\u00e0\u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00f8\u00be\u00e0, \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0\u00c0\u0091\u00be\u0091 \u00ef\u00cd\u00e5\u00e0 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0 \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c4 \u00c8\u00e5\u00c3 \u00ef\u00aa\u00c9\u00be\u00c7\u00e5\u00b0\u00f1 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8\u00e0 \u00c9\u00be \u00c6\u008a \u00c7\u00e5\u00b0\u00f1 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00c6\u008a\u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4 ;\n\n(iii) \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00a8\u00f2\u00c4 \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00ef\u008c 154 (\u00a1\u00e5) \u00c9\u00f1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5 \u00c0\u00ba\u00e0\u00a8\u00c7\u00be \u00c8\u00bc\u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00a8\u00e5\u00c7\u00c9\u00c7\u00c6\u00e5\u00b4 ;\n\n(iv) \u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00e0 \u00cc\u00c3\u00e5\u00c9\u00a8 \u00c6\u008a \u00c4\u00be\u00e0\u00ba\u00f2\u00e9\u00c9\u00c7\u00c6\u00a8\u00eb\u00b4 ;\n\n(v) \u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00e0 \u00cc\u00c3\u00e5\u00c9\u00a8 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4\u00ef\u00cd\u00e5\u00e0 \u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c7\u00e5\u00b0\u00f1 \u00ef\u00cc\u00e0\u00c9\u00c6\u00a8 \u00c6\u008a\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00b4 ;\n\n(vi)\u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00c6\u008a\u00cc\u00c3\u00fa\u00a8\u00c6\u00a8\u00eb\u00b4 ;\n\n(vii)\u00c6\u008a \u00c0\u00ce\u00e5\u00ba\u00e0 \u00a1\u00e5\u00c6\u00ba\u00be\u00c6\u00a8 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00f8\u00a8\u00c6\u00a8\u00eb\u00b4 ;\n\n\u00a1\u00e6\u00ba\u00e6\u008a\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00cc\u00cd\u00ef\u00cc\u00e0\u00c9\u00e5\u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00a1\u00e6\u00ba\u00e6\u008a \u00c8\u00e5\u00c3 \u00cc\u00cd\u00a1\u00e5\u00bc\u00e5\u00c6\u008a, \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0\u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba19\n\n(viii)1978 \u00a1\u00e2\u00a8 16 \u00bc\u00c7\u00be \u0097\u00ca\u00e0\u00c9\u0097\u00bc\u00f1\u00e5\u00c8 \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00c8\u00bc \u00ef\u00cd\u00e5\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00bc\u00e6\u00c6\u00fa \u00cc\u00ce\u00a8\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u0097\u00ca\u00e0\u00c9\u0097\u00bc\u00f1\u00e5\u00c8\u00c6\u00a8 \u00c6\u008a \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4 ;\n\n(ix)1988 \u00a1\u00e2\u00a8 53 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8 \u00a1\u00bd\u00f1\u00c6\u00be \u00a1\u00e5\u00c6\u00ba\u00be\u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8 \u00a1\u00bd\u00f1\u00c6\u00be\u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 \u00ef\u00cc\u00e0\u00c9\u00e5 \u00be\u00f8\u00c6\u00ea\u00a8\u00e0\u00ba\u00c6\u00a8\u00eb\u00b4 ;"
