    "chunk_text": "(vii) (431 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c7\u00b0\u00ef\u00c6\u00e0 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00be\u00e0\u00ef\u00aa\u00e0\u00c9\u00e6\u00be\u00e0\u00bc\u00c5\u00ea \u00cc\u00cd \u00a1\u00be\u00ba\u00e0\u00bc\u00c7\u00e6 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4\u00c6\u00a8;\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba10\n\n(viii) \u00c0\u00c8\u00e5\u00ba\u00e0 \u00c0\u00e5\u00c8\u00be \u00ef\u00cc\u00e0\u00c9\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e0\u00bb\u00e5\u00c0\u00be\u00c6 \u00a8\u00c7\u00be \u00c8\u00bc \u00c6\u008a\u00c9\u00e6\u00be\u00e0\u00bc\u00c5\u00ea \u00cc\u00cd \u00a1\u00be\u00ba\u00e0\u00bc\u00c7\u00e6 \u0097\u00ca\u00f2\u00e5\u00c4 \u00c9\u00e6\u00b4\u00ea\u00c0\u00e0 \u00a1\u00c7\u00c4\u00ea\u00bc\u00c8\u00a8 \u00ef\u00cd\u00e5\u00e0\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00e5 \u00a8\u00f2\u00c4\u00c6\u00a8 ;\n\n(x) \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1975 \u00a1\u00e2\u00a8 2 \u00bc\u00c7\u00be \u00a6\u00cc\u00e0. \u00b6\u0089\u00c8\u00e8\u008c.\u00a1\u00e5\u00da. \u009c. \u00c2\u00b8\u00e0\u00b6\u00e5\u00c7\u00be\u00e5\u00c6\u00a8 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u00be\u00ea\u00cc\u00e0\u00c4\u00c7\u00b8 \u00c0\u00bc\u00be\u00c4\u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a6\u00cc\u00e0. \u00b6\u0089\u00c8\u00e8\u008c. \u00a1\u00e5\u00da. \u009c.\u00c2\u00b8\u00e0\u00b6\u00e5\u00c7\u00be\u00e5\u00c6\u00a8 \u00b0\u00e5\u00ba\u00f8\u00a8 \u00a1\u00be\u00ea\u00cc\u00e0\u00c4\u00c7\u00b8 \u00c0\u00bc\u00be\u00ef\u008a;\n\n(xi) 1994 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be \u0097\u00bc\u00f1\u00e5\u00c9 \u00cd\u00e5 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00c6 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea\u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00b0\u00e5\u00ba\u00f8\u00a8\u0097\u00bc\u00f1\u00e5 \u00c0\u00bc\u00be\u00ef\u008a;\n\n(xii) 1994 \u00a1\u00e2\u00a8 11 \u00bc\u00c7\u00be \u0097\u00bc\u00f1\u00e5\u00c9 \u00cd\u00e5 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00c6 \u00c9\u00e6\u0091\u00bc\u00fa\u00c6\u00ea\u00b8\u00ea\u00a8\u00f8\u00d7\u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00a8\u00e5\u00da\u0095\u00a8 \u00ba\u00e5\u00a8\u00e0\u00cb\u00b8\u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0;\n\n(xiii) 1984 \u00a1\u00e2\u00a8 6 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u0095\u00ba\u00f8 \u00a1\u00e5\u00c6\u00ba\u00be \u00c0\u00be\u00ba\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00f2\u0095\u00ba\u00f8 \u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0;\n\n(xiv) 1968 \u00a1\u00e2\u00a8 14 \u00bc\u00c7\u00be \u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00cc\u00e2\u00c9\u00da\u00bd\u00be \u00c0\u00be\u00ef\u00ba\u00e0 57(1)\u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e2\u00cc\u00e0\u00bb\u00e5\u00c0\u00e8\u00ba \u00c6\u008a \u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00cc\u00e0\u00bb\u00e5\u00be\u00a1\u0093\u00a8\u00e5\u00d6\u00c6\u00a8;\n\n(xv) 1966 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00c8\u00e2\u00a8\u00e5 \u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00c4\u00b8\u00e0\u00b6\u00c8 \u00c0\u00be\u00ba\u00c6\u00b4\u00ef\u00ba\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c8\u00e2\u00a8\u00e5 \u00cc\u00e2\u00ae\u00e5\u00c7\u00a8 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0;\n\n(xvi) \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c4\u00cd \u00c2\u00e6\u00e2\u00a8\u00eb\u00ef\u008c \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc,(422 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00c4\u00ea\u00bc\u00c8\u00e0 \u00be\u00f9\u00ba\u00f8 \u00c0\u00be\u00ba \u00c4\u00aa\u00fa\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00c4\u00ea\u00bc\u00c8\u00e0 \u00c4\u00b8\u00e0\u00b6\u00c8\u00ef\u00c6\u00e0;\n\n(xvii) \u00cc\u00c4\u00ec\u00c0\u00a8\u00e5\u00c7 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00b4 \u00a1\u00bc\u00e5\u00ce \u00a1\u00e5\u00b8\u00e0\u00b6\u00ea\u00ef\u008c \u00c0\u00f2\u00ba\u00f8\u00c0\u00ba\u00e0\u00ba\u00f8\u00c6\u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00cc\u00e6\u00c8\u00a8\u00f8\u00c8\u00e8\u00c4\u00ba\u00e0\u00c9 \u00aa\u00e6\u00cc \u00c0\u00ba\u00f2\u00ef\u00c6\u00cd\u00fa \u00c0\u00ce \u00a8\u00c7\u00be\u00ea\u00c8\u00c2\u00be \u00bc\u00e6\u00be\u00e0\u00d1\u00c4\u00a8\u00e0 \u00c4\u00aa\u00fa\u00be\u00e0 \u00a1\u00c4\u00e5\u00ba\u00f1\u00c9\u00c7\u00c6\u00e5 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00c6\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00cc\u00c4\u00ec\u00c0\u00a8\u00e5\u00c7 \u00cc\u0095\u00ba\u00f8\u00c6\u00a8\u00e0\u00c8\u00c2\u00be \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00b0\u00e5\u00ba\u00f8\u00a8 \u00c7\u00e5\u00b0\u00f1\u00cc\u00c3\u00e5\u00ef\u008c 1972 \u00a1\u00e2\u00a8 5 \u00bc\u00c7\u00be \u00cc\u00c4\u00ec\u00c0\u00a8\u00e5\u00c7 \u00cc\u0095\u00ba\u00f8 \u00c0\u00be\u00ef\u00ba\u00e0\u00a1\u00da\u00bb\u00e5\u00be\u00ea\u00a8\u00ed\u00c8\u00c9 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u00c2\u00ec \u00c6\u008a \u00cc\u0095\u00ba\u00f8\u00c6\u00a8\u00e0\u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc, \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00be\u00e0\u00ef\u00aa\u00be\u00e0 \u00c2\u00cd\u00ea\u00ba\u00c7 \u00cc\u00e2\u00a9\u00f1\u00e5\u00c9 \u00ca\u00f2\u00e9\u00c8\u00e2\u00a8\u00e5\u00ef\u008c \u00c9\u00e5\u00cc\u00e8\u00a8\u00c6\u00be\u00e0 \u00c9\u00be\u00e0\u00be\u00e5 \u00c9\u00ec \u00bc \u00c6\u008a \u00cc\u0095\u00ba\u00f8\u00c6\u00a8, \u00ef\u00c9\u00be\u00ba\u00e0\n\n2006 \u00a1\u00e2\u00a8 10 \u00bc\u00c7\u00be \u00ef\u00bc\u00e0\u00ca\u00fb\u00c6 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c0\u00be\u00ba11\n\n\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00ce \u00cc\u0095\u00ba\u00f8\u00c6\u00a8\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6\u008a\u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e \u00a8\u00ce \u00cc\u0095\u00ba\u00f8\u00c6\u00a8 \u00bc, \u00a6\u00e0 \u00cc\u0095\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00ba\u00e0\u00c9\u00c6\u00be\u00f8\u00ca\u00e0\u00ae\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5, \u00a6\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00ce \u00cc\u0095\u00ba\u00f8\u00ef\u00c6\u00e0 \u00a6\u00a8\u00e0 \u00a6\u00a8\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00e5 \u00a6\u00a8\u00f9 \u00c8\u00e8\u00c6\u00e5\u00c0\u00bc\u00fa\u00e2\u008e\u00a8\u00ce \u00cc\u0095\u00ba\u00f8\u00ef\u00c6\u00e0 \u00cc\u00e5\u00c4\u00e5\u00d4\u00a8\u00c6\u00a8\u00eb \u00ef\u00c8\u00cc \u00cc\u00c8\u00a8\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6 ;\n\n(xviii) \u00b0\u00e5\u00ba\u00e8\u00a8 \u00c7\u00e5\u00b0\u00f1 \u00cc\u00c3\u00e5\u00ef\u008c 1973 \u00a1\u00e2\u00a8 31 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00c0\u00bc\u00be\u00c4 \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00c0\u00bc\u00be\u00c4\u00a1\u00e5\u00c6\u00ba\u00be\u00ef\u00c6\u00e0 ;\n\n(xix) 1979 \u00a1\u00e2\u00a8 53 \u00bc\u00c7\u00be \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00be\u00c9 \u00be\u00f8\u00c0\u00e6\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00bc\u00fa\u00d6\u00aa\u00e6\u00be\u00e0\u00d1\u00ef\u008a \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00be\u00c9\u00be\u00f8\u00c0\u00e6\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00a8\u00e5\u0095\u00cb\u00be\u00e0 \u00cc\u00c3\u00e5\u00ef\u00c9\u00cd\u00fa ;\n\n(xx) (105 \u00c9\u00be \u00a1\u0093\u00a8\u00e5\u00c7\u00c6 \u00c9\u00ec) \u00ef\u00ef\u00c9\u00bc\u00f1 \u00a1\u00e5\u00b3\u00e5 \u00c0\u00be\u00ba\u00f8\u00be\u00e0\u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc \u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5 \u00ef\u00ef\u00c9\u00bc\u00f1 \u00cc\u00c3\u00e5\u00ef\u00c9\u00cd\u00fa ;\n\n(xxi) 1961 \u00a1\u00e2\u00a8 31 \u00bc\u00c7\u00be \u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00c0\u00be\u00ba\u00f8\u00be\u00e0 \u00c0\u00e8\u00cd\u00fa\u00b4\u00ea\u00c9\u00be \u00c8\u00bc\u00a1\u00e5\u00c6\u00ea\u00da\u00ef\u008c\u00bc \u00ef\u00ef\u00c9\u00bc\u00f1 \u00cc\u00c3\u00e5\u00ef\u00c9\u00cd\u00fa ;"
