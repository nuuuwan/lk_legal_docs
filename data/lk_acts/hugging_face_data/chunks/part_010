    "chunk_text": "(\u00a1\u00e5)\u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fa\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u0090\u0095\u00be\u00e0 \u00c6\u008a\u0097\u00cb \u00cc\u00cd\u00fa\u00ba, \u00c0\u00e9\u00b6\u00e5\u00a8\u00e5\u00d7 \u00ef\u00cd\u00e5\u00e0 \u00cd\u00e5\u00be\u00f8\u00bc\u00e5\u00c6\u00a8\u00f7\u00c9\u00f1\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00bc\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c0\u0097\u00ba\u00f2 \u00b0\u00c8\u00c6\u00c6\u008a \u00a1\u00c3\u00f1\u00be\u00e0\u00ba\u00c7 \u00b0\u00c8\u00e5\u00ca\u00c6\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c6\u008a\u00a2\u00b6\u00c4\u00a8 \u00c0\u00e5\u00d6\u00cc\u00d6\u00a8 \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00b4 \u00a1\u00cd\u00fa\u00ba\u00a8\u00c7\u00ef\u00c8\u00cc \u00c2\u00c8\u00c0\u00e5\u00be \u00a1\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00c6\u008a \u00a2\u00b6\u00c4\u00a8\u00b4\u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00c7\u00be, \u00bc\u00c4\u00be, \u00ef\u00cd\u00e5\u00e0 \u00a2\u00b6\u00c4\u00a8\u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00c7\u00be, \u00c4\u00ea\u00bc\u00e5 \u00cd\u00d6\u00be \u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0\u00c2\u00e6\u00cd\u00e6\u00c7 \u00a8\u00f8\u00d7\u00c4\u00b4, \u00bc\u00e6\u00e4\u00c4\u00b4, \u00ba\u00e6\u00be\u00e0\u00c0\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4\u00b4\u00ef\u00cd\u00e5\u00e0 \u00c4\u00ea\u00bc\u00e5 \u00cd\u00e6\u00d7\u00c4\u00b4 \u00a1\u00c9\u00cc\u00c7 \u00ef\u00bc\u00be ;\n\n(\u00a1\u00e6) \u00c2\u00c8\u00c0\u00ba\u00f2\u00c8\u00e5\u00c3\u00fa\u00c6\u00a8\u00eb \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00e8\u0090\u0095\u00be\u00e0\u00c0\u00d6\u00cc\u00c7\u00c6\u00b4 \u00cd\u00e5\u00be\u00f8\u00bc\u00e5\u00c6\u00a8 \u00c2\u00c8\u00c0\u00e7\u00c4\u00a8\u00e0 \u00a1\u00e6\u00ba\u00f8\u00a8\u00c7\u00c9\u00be \u00c6\u008a \u00a8\u00f2\u00e8\u00c6\u00e5\u00c9\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be ;\n\n\u201c\u00b0\u00c8\u00d5\u00d1 \u00c9\u00aa\u00e5\u00ef\u00c4\u00ef\u00cd\u00c6\u00ea\u008a\u00c9\u00c8\u00b4\u00a1\u00bc\u00e5\u00ce \u00c9\u00e6\u00c7\u00bc\u00fa.\n\n\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00c6\u00b449\u00a1 \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00f8\u00d7\u00c4.\n\n2006 \u00a1\u00e2\u00a8 22 \u00bc\u00c7\u00be \u009e\u00c9\u00c7 \u00cc\u00cd \u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba9\n\n\u00a8\u00ce \u0097\u00b4 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u00cc\u00e6\u00c0\u00c6\u00fb\u00c4 \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0\u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00ef\u00cc\u00e0 \u00be\u00f8\u00c6\u00c4 \u00a8\u00ce \u0097\u00b4 \u00c6\u008a\u00c9\u00e6\u00bc\u00aa\u00ba\u00e0 \u00a8\u00c7\u00e6\u00b8\u00a8\u00e0 \u00cc\u008a\u00c2\u00be\u00e0\u00bd\u00ef\u00c6\u00be\u00e0 \u00c9\u00f1\u00e5\u00b0,\u00ef\u00be\u00e5\u00c4\u00ad \u00c6\u00c9\u00be \u00cc\u00ea\u00dd \u00ef\u00cd\u00e5\u00e0 \u00a1\u00cc\u00ba\u00f1 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6\u00c8\u00c2\u00e5 \u00ef\u00bc\u00be ;\n\n(\u00a2) \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00a8\u00e5\u00da\u00c6\u00c6 \u00a2\u00b4\u00ea\u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00c2\u00c8\u00ba\u00c8 \u00a8\u00f2\u00e8\u00c6\u00e5\u00ba\u00e0\u00c4\u00a8 \u00a8\u00c7\u00be\u00c2\u00c8\u00c0\u00ba\u00f2 \u00bc\u00fb\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00b4 \u00c2\u00e6\u00be\u00c9\u00e6\u00bc\u00fb\u00ef\u008a\u00ef\u00cd\u00e5\u00e0 \u00ba\u00da\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00c9\u00ae\u00be \u00c0\u00e5\u0097\u0083\u008e\u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00a1\u00c9\u00c4\u00be\u00e0 \u00cc\u00cd\u00aa\u00ba \u00a1\u00c3\u00fa\u00be\u00c6\u00a8\u00e0 \u00cc\u00e8\u00f3\u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa\u00ba\u00da\u00b0\u00be\u00c6 \u00a8\u00f8\u00d7\u00ef\u008a \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00b4 \u00cd\u00e6\u00cc\u00e8\u00ef\u00c7\u00be ;\n\n(\u00a3) \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c2\u00c8\u00c0\u00ba\u00f2 \u00bc\u00fb\u00ef\u008a\u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00a8\u00e5\u00da\u00c6\u00c6 \u00a2\u00b4\u00ea \u00a8\u00c7\u00be\u0097\u00b4 \u00a6\u00c4 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00e5\u00b4 \u00c0\u00cd\u00c7 \u00ef\u00bc\u00be \u00ef\u00cd\u00e5\u00e0\u00c2\u00e5\u00bd\u00e5 \u00a8\u00c7\u00be ;\n\n(\u00a4) \u00c2\u00c8\u00c0\u00ba\u00f2 \u00bc\u00fb\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00bc\u00be\u00ea\u00c8\u00c2\u00be \u00cc\u00e7\u00c4 \u00be\u00f9\u00ba\u00f1\u00be\u00ea\u00a8\u00ed\u00c8 \u00a4\u00c0\u00ef\u00bc\u00cc\u00a8\u00b4\u00ef\u00cd\u00e5\u00e0 \u0097\u00bd\u00e5\u00be\u00c6\u00a8\u00b4 \u00c9\u00cd\u00e5\u00c4 \u00cc\u00cd\u00cc\u008a\u00c0\u00ec\u00da\u00b8\u00ef\u00c6\u00be\u00e0 \u00c4 \u00a6\u00a8\u00ad\u00c9 \u00a8\u00f2\u00e8\u00c6\u00e5 \u00a8\u00f8\u00d7\u00c4\u00b4\u00a1\u00ef\u00c0\u00e5\u00ef\u00cd\u00e5\u00cc\u00ba\u00e0 \u00c9\u00be, \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00c7\u00be \u00ef\u00cd\u00e5\u00e0\u00a1\u00ba\u00c0\u00cc\u00ea \u00a8\u00c7\u00be ;\n\n(\u00a4\u00f0) \u00c2\u00c8\u00c0\u00ba\u00f2 \u00bc\u00fb\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb \u00ef\u00c8\u00cc \u00c9\u00f1\u00e5\u00b0 \u00ef\u00c8\u00cc\u00ef\u00c0\u00be\u00f9 \u00cc\u00e8\u0090\u00be \u00ef\u00cd\u00e5\u00e0 \u00a6\u00c9\u00e6\u00be\u00f8 \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00cc\u00e5\u00c9\u00bc\u00f1 \u00ef\u00c8\u00cc \u00be\u00f8\u00ef\u00c6\u00e5\u00e0\u00b0\u00be\u00c6 \u00a8\u00c7\u00be ; \u00ef\u00cd\u00e5\u00e0\n\n(\u00a6) \u00cc\u00e0\u00c9\u00a8\u00f9\u00c6 \u00a8\u00e5\u00da\u00c6\u00c6 \u00a2\u00b4\u00ea \u00a8\u00f8\u00d6\u00ef\u008a \u00bc\u00fb \u00c2\u00c8\u00c0\u00ba\u00f2\u00bc\u00fb\u00ef\u008a \u00be\u00f8\u00c8\u00bd\u00c7\u00c6\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6\u00c9\u00c8\u00b4 \u00c6\u008a\u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8\u00f8\u00be\u00e0 \u00a1\u00c6\u00ea\u00ba\u00eb \u00ef\u00c8\u00cc \u00c4\u00e6\u00bc\u00fa\u00cd\u00ba\u00e0 \u00c9\u00be,\n\n\u00cc\u00e7\u00c4 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00a8\u00e0\u00c4, \u00ef\u008a \u00c0\u00be\u00ba \u00c6\u00b4\u00ef\u00ba\u00e0 \u00c9\u00c7\u00bc\u00a8\u00b4\u00c9\u00c7\u00bc\u00a8\u00c7\u00e6 \u00c9\u00be \u00a1\u00ba\u00c7, \u00c4\u00ef\u00cd\u00cc\u00e0\u00ba\u00f2\u00e5\u00ba\u00e0\u00c9\u00c7\u00c6\u00a8\u00eb \u00a2\u00bc\u00fa\u00d6\u00c0\u00e8\u00b4\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u00ef\u00c9\u00be \u00c8\u00ab\u00ea \u00be\u00b6\u00ea \u0097\u00c3\u00e5\u00aa\u00c6\u00a8\u00f8\u00be\u00e0 \u00c0\u00cc\u00ea \u00c9\u00c7\u00bc\u00a8\u00c7\u00e6\u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00ef\u008a \u00bc\u00fb, \u00c4\u00e5\u00cc \u00bc\u00cd\u00a1\u00b4\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea \u00cc\u00cd\u00c4\u00e5\u00cc \u00ba\u00f8\u00cc\u00e0\u00cd\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00a8\u00e5\u00c8 \u00cc\u00e9\u00c4\u00e5\u00c9\u00a8\u00e0 \u00cc\u00bf\u00cd\u00e5\u00ef\u00bc\u00c6\u00e5\u00a8\u00e5\u00c7\u00ef\u00c6\u00be\u00e0 \u00a6\u00a8\u00e0 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba\n\n2006 \u00a1\u00e2\u00a8 22 \u00bc\u00c7\u00be \u009e\u00c9\u00c7 \u00cc\u00cd \u00b0\u00c8\u00b0 \u00cc\u008a\u00c0\u00ba\u00e0(\u00cc\u00e2\u00ef\u00ca\u00e5\u00e0\u00bd\u00be) \u00c0\u00be\u00ba10\n\n\u00a8\u00f8\u00d7\u00c4\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u0097\u00cc\u00e8\u00c0\u00be\u00e0\u00bc\u00cd\u00cc\u00a8\u00b4 \u00ef\u00be\u00e5\u00a1\u00b6\u00ea\u00cc\u00cd \u00c7\u00e6\u00c0\u00e8\u00c6\u00c8\u00e0 \u00c8\u00a8\u00e0\u00cb\u00c6\u00a8\u00b4 \u00ef\u00be\u00e5\u00c9\u00e6\u0091 \u00bc\u00b6\u00c6\u00a8\u00b4,\u00be\u00e6\u00ba\u00ef\u00cd\u00e5\u00ba\u00e0 \u00a6\u00c4 \u00bc\u00b6\u00c6 \u00cc\u00cd \u00c2\u00be\u00e0\u00bd\u00be\u00e5\u00aa\u00e5\u00c7\u00aa\u00ba \u00a8\u00f8\u00d7\u00c4\u00c6\u00be \u00ef\u00bc\u00a8\u00b4\u00c4 \u00c6\u00b4\u00ba\u00e0 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00c6.\u201d.\n\n7.\u00c0\u00f2\u00bd\u00e5\u00be \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 57 \u00c9\u00be \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00b4 \u00a2\u00a8\u00e0\u0094\u00ba\u00f8\u00c9 \u00c4 \u00c0\u00cd\u00ba\u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u00a1\u00f5\u00ba\u00e0 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00ef\u00c4\u00c6\u00fa\u00be\u00e0 \u00a1\u00e6\u00ba\u00eb\u00ce\u00ba\u00e0 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a1\u00ba\u00c7, \u00a6\u00e0\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00a6\u00c4 \u00c0\u00f2\u00b3\u00c0\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 57\u00a1 \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00c2\u00c8\u00c0\u00e6\u00c9\u00e6\u00ba\u00e0\u0097\u00c6\u00c6\u00ea\u00ba\u00eb \u00c6 :\u2014"
