    "chunk_text": "(2) \u00c0\u00f2\u00ba\u00f9\u00ba\u00be\u00c6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00a8\u00f8\u00be\u00e0 \u00ef\u00ba\u00e5\u00c7\u00c9, \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00cc\u00e6\u00c0\u00c6\u00fb\u00ef\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00cd\u00fa \u00ef\u00c6\u00bc\u00fb \u00cc\u00e8\u0090\u00be \u00c6\u008a \u00cc\u00cd\u00ba\u00f8\u00a8 \u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a1\u00c6\u00fa\u00ba\u00f8\u00c9\u00e5\u00cc\u00e8\u00a8\u008a\u00c9\u00c8\u00b4, \u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba \u00a8\u00f8\u00cc\u00e8\u00c9\u00a8\u00f8\u00be\u00e0\u00c2\u00e5\u00bd\u00e5\u00c9\u00be \u00ef\u00c8\u00cc \u00ef\u00cd\u00e5\u00e0 \u00a8\u00e8\u00cc\u00e8\u00f3 \u00a1\u00e5\u00a8\u00e5\u00c7\u00c6\u00a8 \u00cc\u00e9\u00c4\u00e5 \u00a8\u00e8\u00d7\u00c4\u00a8\u00e0 \u00cc\u00e8\u00f3 \u00c9\u00be \u00ef\u00c8\u00cc \u00ef\u00ba\u00e0\u00c7\u00e6\u008a\u00ef\u00be\u00e5\u00aa\u00ba \u00c6\u00ea\u00ba\u00eb \u00c6.\n\nV \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00ef\u00a8\u00ef\u00c7\u00cd\u00fa \u00c2\u00c8\u00c0\u00c9\u00ba\u00e0\u00c9\u00be \u00d7\u00ba\u00f8\n\n21. (1) \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00a1\u00e5\u00b3\u00e5\u00c0\u00be\u00ef\u00ba\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0 \u00c6\u008a \u00be\u00f9\u00ba\u00f8\u00c6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c0\u00b4\u00cd\u00e6\u00be\u00f8\u00c9\u00a8\u00eb\u00c4\u00a8\u00e0 \u00cc\u00bf\u00cd\u00be\u00e0\u00c9 \u00ba\u00f8\u00c2\u00ea\u00b8 \u00bc, \u00ef\u008a \u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00ef\u00c6\u00e0 \u00c0\u00cd\u00ba \u00bc\u00e6\u00a8\u00e0\u00ef\u00c9\u00be \u0097\u0093\u0097\u00bd\u00e5\u00be,\u00ef\u008a \u00c0\u00be\u00ef\u00ba\u00e0 \u00a8\u00e5\u00da\u00c6\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00a1\u00bc\u00e5\u00ce \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6.\n\n(2) (\u00a1) \u00c0\u00f2\u00ca\u00e0\u00be \u00aa\u00ba \u00c6\u008a \u00a8\u00c7\u00e6\u00b8\u00a8\u00b4 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00bc\u00e5\u00ce \u00a8\u00c7\u00e6\u00b8\u00b4; \u00cc\u00cd\n\n(\u00a1\u00e5)\u00c6\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8\u00e0, \u00ef\u00c9\u00ef\u00ce\u00bf\u00e5\u00c4\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00c9\u00ee\u00ba\u00e0\u00ba\u00f8\u00c6\u00a8\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00ba\u00e0\u00be\u00f8\u00ba\u00f8\u00c0\u00ba\u00e5 \u00cc\u00e8\u00f3 \u00a8\u00c7\u00be\u00ea \u00c8\u00c2\u00be \u00a8\u00b4\u00c6\u00ea\u00ba\u00e0\u00ba\u00a8\u00e0 \u00a1\u00ba\u00c7\u00ba\u00eb\u00c7 \u00bc\u00fb \u00cc\u00e5\u00bc\u00be\u00c8\u00bc, \u00c8\u00e6\u00c2\u00ea\u00b8 \u00ef\u00cd\u00e5\u00e0 \u00c8\u00c2\u00e5\u00aa\u00ba\u00e0,\n\n\u00bc\u00ba\u00e0\u00ba \u00c0\u00b8\u00e8\u00c9\u00ea\u00b6\u00c6\u00a8, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8\u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6\u00a8 \u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba \u00c6\u008a \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00a8\u00e0 \u00be\u00f9\u00ba\u00f8\u00a8\u00ee\u00ba\u00f1\u00c6\u00a8 \u00bc\u00fb \u00a1\u00e5\u00ef\u008c\u00ca\u00f1 \u00a8\u00c7\u00aa\u00ba \u00cd\u00e6\u00a8\u00f8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n\u00c0\u00f2\u00ba\u00f9\u00ba\u00be \u00cc\u00cd\u00ba\u00f8\u00a8\u00a8\u00f8\u00d7\u00ef\u008a \u00ef\u00cc\u00e0\u00c9\u00e5\u00cc\u00e6\u00c0\u00c6\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00be\u00e0.\n\n\u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00d7\u00ba\u00f8 \u00a1\u00bc\u00e5\u00ce\u0097\u00c4.\n\n2006 \u00a1\u00e2\u00a8 19 \u00bc\u00c7\u00be \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00aa\u00be\u00ea\u00ef\u00bc\u00be\u00ea \u00c0\u00be\u00ba15\n\n\u00a6\u00ef\u00cc\u00e0 \u00c9\u00ea\u00c9 \u00bc, \u00a6\u00e0 \u00c0\u00f2\u00ca\u00e0\u00be\u00aa\u00ba \u00a8\u00c7\u00e6\u00b8 \u00ef\u00cd\u00e5\u00e0 \u00a1\u00e5\u00bc\u00e5\u00ce \u00a8\u00c7\u00e6\u00b8 \u00c0\u00e8\u00ce\u00e8\u00c2\u00bf \u00cc\u00ee\u00b0\u00ea\u00c9\u00e5\u008e\u00a8 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00ba\u00f8\u00ef\u0089 \u00be\u008a \u00a6\u00c4 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00a1\u00e5\u00ef\u008c\u00ca\u00f1 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00a1\u00ba\u00c7, \u00a6\u00c4 \u00bc\u00ba\u00e0\u00ba\u00c0\u00b8\u00e8\u00c9\u00ea\u00b6\u00ef\u00c6\u00e0, \u00a2\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00ef\u00c8\u00e0\u00a9\u00be\u00ef\u00c6\u00e0, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00c9\u00e5\u00da\u00ba\u00e5\u00ef\u008c \u00ef\u00cd\u00e5\u00e0\u00ef\u00c9\u00be\u00ba\u00e0 \u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00ef\u00c6\u00e0 \u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6 \u0097\u00ca\u00e0\u00c9\u00e5\u00cc\u00c6 \u00ba\u00e6\u0094\u00c6 \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8\u00ef\u00cd\u00e5\u00e0 \u00cc\u00e5\u00c9\u00bc\u00f1 \u00c2\u00c9\u00b4, \u0097\u00ca\u00e0\u00c9\u00e5\u00cc \u00a8\u00f8\u00d7\u00c4\u00b4 \u00ef\u00cd\u00e0\u00ba\u00eb\u00c9\u00a8\u00e0 \u00be\u00e6\u00ba\u00f8 \u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6 :\n\n\u00a6\u00ef\u00cc\u00e0\u00c4 \u00ba\u00c9\u00f3\u00c7\u00b4\u00ba\u00e0 (\u00a1) \u00cc\u00cd (\u00a1\u00e5) \u00ef\u00d8\u00bc\u00c9\u00c8 \u00a8\u00e5\u00da\u00c6 \u00cc\u00bf\u00cd\u00e5 \u00c6\u008a \u00bc\u00ba\u00e0\u00ba\u00c0\u00b8\u00e8\u00c9\u00ea\u00b6\u00c6\u00a8\u00e0, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00ef\u00c8\u00e0\u00a9\u00be\u00c6\u00a8\u00e0, \u00a2\u00ef\u00c8\u00a8\u00e0\u00ef\u00b4\u00f2\u00e5\u00be\u00f8\u00a8 \u00c9\u00e5\u00da\u00ba\u00e5\u00c9\u00a8\u00e0\u00ef\u00cd\u00e5\u00e0 \u00ef\u00c9\u00be\u00e0\u00ba \u00cc\u00be\u00e0\u00be\u00f8\u00ef\u008c\u00bc\u00be\u00c6\u00a8\u00e0 \u00a1\u00be\u00e0\u00ba\u00da\u00aa\u00ba \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00a8\u00e0 \u00a2\u00bc\u00fa\u00d6\u00c0\u00ba\u00e0 \u00a8\u00ce\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb-\n\n(i)\u0095\u00c6\u00aa\u00fa\u00c6 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00be\u008a \u00ef\u00cd\u00e5\u00e0 \u00ca\u00e5\u00d7\u00d6\u00a8 \u00ef\u00cd\u00e5\u00e0 \u00c4\u00e5\u00be\u00cc\u00e8\u00a8 \u00ba\u00ba\u00e0\u00ba\u00e0\u00c9\u00c6\u00a1\u00be\u00ea\u00c9 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8\u00a8\u00c7\u00e6 \u00ef\u00c8\u00cc \u00ef\u00c0\u00be\u00f9 \u00cc\u00e8\u009b\u00c4\u00b4 \u00a1\u00ef\u00c6\u00e5\u00e0\u00aa\u00f1 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00be\u008a ; \u00ef\u00cd\u00e5\u00e0\n\n(ii)\u00ca\u00f2\u00e9 \u00c8\u00e2\u00a8\u00e5\u00ef\u00c9\u00be\u00e0 \u00c0\u00e8\u00b4\u00ba \u00cc\u00e8\u0090\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00be\u008a \u00cc\u00cd \u00a6\u00c4\u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00e5 \u00ef\u00cc\u00d1\u00c4 \u00cc\u00bf\u00cd\u00e5 \u00cc\u00e5\u00bd\u00e5\u00c7\u00b8 \u00ef\u00c8\u00cc \u00c0\u00e8\u00c6\u00c9\u00c7 \u00ef\u00aa\u00be \u00a7\u00cd\u00ea\u00ef\u00cc\u00e5\u00c6\u00e5 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00ef\u00be\u00e5\u00cd\u00e6\u00a8\u00f8 \u00c9\u00ec \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00be\u008a ; \u00ef\u00cd\u00e5\u00e0\n\n(iii) \u0094\u00c6 \u00be\u00f8\u00cc\u00e5 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00bc\u00fb\u00c4\u00b4 \u00a1\u00a8\u00c4\u00e6\u00ba\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00be\u00c4 ; \u00ef\u00cd\u00e5\u00e0\n\n(iv)\u00a6\u00ef\u00cc\u00e0 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00bc\u00fb\u00ef\u00c4\u00be\u00e0 \u00c9\u00ce\u00a8\u00e0\u00c9\u00be\u00ea \u00c8\u00c2\u00be \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00be\u008a,\n\n\u00a6\u00c4 \u00ef\u00ba\u00e5\u00c7\u00ba\u00eb\u00c7\u00e6\u00c9\u00c8\u00b4 \u00a1\u00bc\u00e5\u00ce \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00a1\u00e6\u00ba\u00e0\u00be\u008a \u00a6\u00c4 \u00cc\u00e5\u00a8\u00e0\u00cb\u00e8 \u00a1\u00e5\u00ef\u008c\u00ca\u00f1 \u00a8\u00c7\u00be\u00ea\u00c8\u00e6\u0094\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c6."
