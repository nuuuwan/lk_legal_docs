    "chunk_text": "\"\u00b6\u00af\u00c1\u00be\u00c6 \u00db\u00ce\u00bd\u00ce\u00ba\" \u00a9\u0081\u00b9\u00d7 \u00b6\u00af\u00c1\u00ce\u00be \u00a7\u00dd\u00c1\u00c7\u00af\u00c6\u00d0\u00c1\u00b6\u00bd\u00c6\u00d0\"\u0089\u00bd\u00b9\u00c6\u00b9\u00c7\u00af\u00c6\u00d0\u00b6\u00bd\u00c6\u00d0\" \u00a3\u00d9\u00b9\u00c6\u00da\u00b6\u00bd\u00c6\u00d0\" \u00cc\u00b9\u00de\u00c1\u00b6\u00bd\u00c6\u00d0\" \u00cd\u00b6\u00af\u00c6\u00af\u00c8\u00ce\u00c1\u00b9\u00c6\u00b9\u00b6\u00bd\u00c6\u00d0\" \u00ba\u00c9\u00bf\u00c6 \u00a7\u00dd\u00c1\u00c7\u00af\u00c6\u00af\u00ba\u00c6 \u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0\" \u00af\u00c7\u00b4\u00c6\u00b1\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0\" \u00b9\u00b6\u00c8\u00e2\u00cc\u00b1\u00bb\u00c6\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a3\u00be\u00c6\u00be\u00d7 \u00db\u00ce\u00bd\u00c1\u00c0\u00c8\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00c1\u00b6\u00bd\u00c6\u00d0 \u00a4\u00b8 \u00a5\u00be\u00b6\u00c6\u00b6\u00c8\u00bc\u00b8\u00c8\u00bb\u00be\u00c6 \u00db\u00ce\u00bd\u00ce\u00ba\u00cc\u00bb\u00c7\u0081\u00de \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n\"\u00c1\u00ce\u00be\u00bb\u00ce\u00ba\u00b9\u00c6\u00da \u00cd\u00b1\u00ce\u00c1 \u00c1\u00c0+\u00c6\u00d0\u00b7\u00bc\u00c6\" \u00a9\u0081\u00b9\u00d7 \u00b9\u00af\u00c8\u00bc+\u00c6\u00af\u00b7\u00c8\u00ce\u00be\u00ba\u00c7\u00bd\u00c6\u00de \u00c1\u00ce\u00be\u00bb\u00ce\u00ba\u00b9\u00c6\u00cc\u00b9\u00c7\u0081\u00ce\u00bd\u00b1\u00c6 \u00cc\u00b1\u00c7\u00b7\u00c6\u00b6\u00ba\u00c7\u00af\u00af\u00c6\u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\" \u00a7\u00ce\u00b4\u00ce\u00ba\u00cc\u00af\u00c7\u00ae\u0088\u00dd\u00af\u00c6\u00af\u00c8\u0081\u00bd\"\u00cc\u00b6\u00c7\u00c0\u00c8\u00bd\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd\" \u00db\u00af\u00c7\u00ce\u00ba\u00cc\u00b1\u00bb\u00c6\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7\u00af\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00d7\u00af\u00c8\u0081\u00bd \u00a3\u00be\u00c6\u00be\u00d7 \u00cc\u00b6\u00c7\u00ce\u00be\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00da \u00cd\u00b1\u00ce\u00c1\u00af\u00ce\u00bf \u00c1\u00c0+\u00c6\u00d0\u00af\u00c8\u0081\u00bd \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00bc\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n24 2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 19 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be\u00b6\u00c6\u00b6\u00c8\u00bc\u00b8\u00c8\u00bb\u00be\u00c6\u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00be\u00c6 \u00c1\u00c7+\u00c6\u00af\u00be\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c6\n\n\"\u00f2\u00be\u00af\u00c7\u00bc\u0081\" \u00a9\u0081\u00b9\u00d7 \u00a9\u00b7\u00c6\u00b6 \u00a4\u00bf\u00c8\u00b8\u00c7\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00a9\u00b7\u00c6\u00b6 \u00a4\u00bf\u00c8\u0081\u00b1\u00c7\u00bc\u00c6\u0089\u00be\u00c6\" \u00cc\u00b9\u00de\u00ce\u00af \u00a3\u00be\u00c6\u00be\u00d7 \u00cd\u00b6\u00af\u00c6\u00af\u00ba\u00c6\" \u00a9\u00d7\u00e2\u00ba\u00c8\u00dd\u00b9\u00c6\u0089\u0081\"\u00a3\u00b6\u00bd\u00c6\u00d0 \u00db\u0081\u00b8\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00b4\u00be\u00c6 \u00a3\u00d9\u00b9\u00c6\u00b9\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00b6\u00c7\u00af\u00a3\u00be\u00c6\u00be\u00d7 \u0089\u00bd\u00b9\u00c6\u00b9\u00c7\u00af\u00c6\u00af\u00b3\u00c6 \u00cc\u00b1\u00bb\u00c6\u00bb\u00b9\u00c6\u00b9\u00b4\u00c6\u00d5\u00bf\u00c6\u00bf\u00b6\u00c7\u00af\u00af\u00c6\u00af\u00dd\u00b6\u00b9\u00c6\u00b9\u00d5\u00af\u00c8\u0081\u00bd\u00cd\u00b6\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00a4\u00bf\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6;\u00a4\u00b8\u00c7\u00be\u00c6 \u00a3\u00b6\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u00b9\u00c7\u00b4\u00be\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a5\u00ce\u00b4\u00c1\u00dd\u00b7\u00bc\u00c6\u00ac\u00dd\u00c1\u00bc\u00c7\u00af\u00b1\u00c6 \u00cc\u00b1\u00bb\u00be\u00c7\u00bd\u00c6\u00de\u00ba\u00c6 \u00a4\u00cc\u00bf\u00c7\u00dd\u00c1\u00ce\u00bc \u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00af\u00ba\u00c7\u00b4\u00c6\u00b4\u00c7\u00d7 ;\n\n\"\u00a3\u00d6\u00af\u00c6\u00af\u00ba\u00c6 \u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6\" \u00a9\u0081\u00b9\u00d7 \u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u00b6\u00c8\u00bd\u00b6\u00c6\u00b6\u00c1\u00bc\u00c6 \u00b6\u00af\u00c1\u00be\u00c6\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00a9\u00b7\u00c6\u00b6\u00b6\u00c6 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00d8\u00b4\u00c6\u00b9 \u00c1\u00c0\u00c8\u00db\u00ce\u00bd\u00af\u00bf\u00c6\u00f2\u00be\u00ba\u00c6\u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u00b6\u00c8\u00bd\u00b6\u00c6\u00b6\u00c1\u00bc\u00c6 \u00b6\u00af\u00c1\u00df\u00af\u00c6\u00d0 \u00a3\u00d6\u00af\u00c6\u00af\u00ba\u00c6 \u00cc\u00b9\u00bd\u00be\u00c7\u00cd\u00ba\u00c7\u00a3\u00b7\u00c6\u00b6 \u00a3\u00c1\u00b1\u00c8\u00bb\u00ba\u00c7\u00b8 \u00cc\u00b6\u00c7\u00c0\u00c8\u00be\u00c6\u00d8\u00b4\u00c6\u00b9 \u00db\u00ce\u00bd\u00af\u00ce\u00bf \u00c1\u00c0+\u00c6\u00d0\u00b6\u00be\u00c6\u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 \u00a9\u0081\u00b9\u00d7\u00b4\u0081\" \u00a3\u00d6\u00af\u00c6\u00af\u00ba\u00c6 \u00c1\u00c0+\u00c6\u00d0\u00ba\u00c6\u00cd\u00b7\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u00bd\u00c6\u00af\u00c7\u00af \u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u00b6\u00c8\u00bd\u00b6\u00c6\u00b6\u00c1\u00bc\u00c6 \u00b6\u00af\u00c1\u008b\u0081\u00b6\u0081\u00b8\u00c8\u00bb\u00af\u00c6\u00af \u00ba\u00bd\u00c6\u00de\u00ba\u00c6 \u00b6\u00bd\u00c6\u00af\u00c7\u008b\u00af\u00b6\u00c6 \u00cd\u00b6\u00af\u00c6\u00af\u00b6\u00c6\u00ce\u00b6\u00dc\u00ba\u00c6\u00a7\u00bf\u00c6\u00bf\u00b4\u00af\u00c6\u00d0\u00ba\u00c6 ;\n\n\"\u00b9\u00c7\u00d7\u00af\u00c7\u00b9\u00c6\u00da \u00b7\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00db\u00ce\u00bd\" \u00a9\u0081\u00b9\u00d7 \u00b9\u0088\u00c1\u00db\u00ce\u00bd\u00af\u00bf\u00c8\u0081\u00a3\u00be\u00c6\u00be\u00d7 \u00d0\u00bd\u00c8\u00af\u00bf\u00c8\u0081\" \u00a5\u00b8\u00ba\u00c6 \u00af\u00c7\u00d6\u00ba\u00c6 \u00cc\u00b1\u00c7\u00bd\u00c6\u00af\u00bf\u00c8\u0081\u00a3\u00b6\u00c6\u00d7\u00b4\u0081 \u00a9\u00ae\u00af\u00bf\u00c8\u0081 \u00d0\u00bd\u00c8\u00db\u00ce\u00bd\u00bb\u00c7\u00af\u00c6\u00af\u00b6\u00c6\u00b6\u00c8\u0081\" \u00b6\u00c8\u00dd\u00b9\u00c6\u0089\u008c\u00ce\u00b4\u00bb\u00bf\u00c8\u00b6\u00c6\u00b6\u00be\u00c6 \u00a3\u00be\u00c6\u00be\u00d7 \u00ac\u00b9\u00c6\u00da\u00af\u00c6\u00cd\u00af\u00c7\u00b4\u00be\u00c6 \u00b7\u0088\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00db\u00ce\u00bd\u00af\u00bf\u00c8\u0081\" \u00cc\u00ba\u0081\u00cc\u00b9\u00c7\u00dd\u00bf\u00c8\u0081\" \u00c1\u0081\u00cc\u00b9\u00c7\u00dd\u00bf\u00c8\u0081 \u00a3\u00be\u00c6\u00be\u00d7\u00a5\u00b6\u00ce\u00b8\u00cc\u00bb\u00c7\u00b6\u00c6\u00b6 \u00a7\u00b9\u00c7\u00bb+\u00c6\u00af\u00bf\u00c8\u0081 \u00b9\u00c7\u00c1\u00ce\u00b8\u00ce\u00bb\u00b6\u00c6 \u00cd\u00b6\u00ce\u00c1\u00b9\u00c6\u00b9\u00d5\u00b6\u00c6\u00b6\u00af\u00c6\u00e7\u0088\u00bb \u00aa\u00cd\u00b6\u00d9\u00ba\u00c6 \u00a5\u00be\u00b6\u00c6\u00b6\u00c8\u00bc\u00b8\u00c8\u00bb\u00be\u00c6 \u00a4\u00c1\u00b5\u00b6\u00c6\u00b6\u00c8\u0081\u00a7\u00ae\u00ce\u00ba\u00b6\u00c6\u00b6\u0081\u00ce\u00ba\u00ce\u00bb \u00a3\u00be\u00c6\u00be\u00d7 \u00b6\u00c8\u00b4\u00c6\u00b9\u00b6\u00c6\u00ce\u00b6 \u00a3\u00be\u00c6\u00be\u00d7\u00a5\u00bc\u00ae\u00ce\u00b4\u00dc\u00ba\u00c6 \u00b7\u00c8\u00ce\u00be\u00b7\u00c7\u00b4\u00c6\u00d5\u00c1\u00b6\u00bd\u00c6\u00d0\" \u00b1\u00c7\u0081\u00bd\u00bf\u00c8\u00af\u00c6\u00d0\u00ba\u00c6 \u00cd\u00b1\u00ce\u00c1\u00c1\u00c0+\u00c6\u00d0\u00b7\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c7\u00be\u00c6 \u00c1\u00c0+\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b1\u00c7\u0081\u00bd\u00c8\u00b6\u00cc\u00c0\u00c7\u0081\u00de\u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00d0\u00bd\u00c8\u00b6\u00c6\u00d7\u00ce\u00bc\u00af\u00c6\u00af\u00b9\u00c6\u00b9\u00b4\u00c6\u00b4 \u00b7\u00b4\u00c1\u0088\u00af\u00c6\u00ce\u00af\u00db\u00ce\u00bd\u00cc\u00bb\u00c7\u0081\u00de \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6 ;\n\n\"\u00f2\u0081\u00bd\u00c7\u00ba\u00c6 \u00b6\u00c8\u00bd\u00b6\u00c6\u00b6\u00c1\u00bc\u00c6\" \u00a9\u0081\u00b9\u00d7 \u00c1\u00ce\u00be\u00bb\u00ce\u00ba\u00b9\u00c6\u00da \u00cd\u00b1\u00ce\u00c1\u00c1\u00c0+\u00c6\u00d0\u00b7\u00bc\u00c6 \u00ac\u00dd\u00c1\u00bc\u00c6 \u00cc\u00b6\u00c7\u00b4\u00bc\u00c6\u0089\u00be\u00c6 \u00cd\u00b1\u00ce\u00c1 \u00c1\u00c0+\u00c6\u00d0\u00b9\u00c1\u00dd\u00af\u00c6\u00d0\u00a9\u00b7\u00c6\u00b6 \u00a4\u00bf\u00c8\u0081\u00cd\u00ba\u00be\u00c6 \u00b9\u00bb\u00d9\u00de\u00b6\u00c8\u00dc\u00bf\u00c6\u00bf \u00af\u00b4\u00c6\u00d5\u00b9\u00c6\u00b9\u00c7\u00cc\u00b4\u00d7\u00e2\u00ba\u00c6\u00a5\u00be\u00c6\u00ce\u00be\u00cd\u00bb\u00c7 \u00a3\u00b7\u00c6\u00b6 \u00a4\u00bf\u00c6 \u00a9\u0081\u00de \u00cc\u00b9\u00c7\u00dd\u00bf\u00c6\u00b9\u00d5\u00ba\u00c6\u00b0\n\n2006 \u00a4\u00ba\u00c6 \u00a4\u00ae\u0088\u0081 19 \u00a4\u00ba\u00c6 \u00a5\u00be\u00af\u00c6\u00af\" \u00a5\u00be\u00b6\u00c6\u00b6\u00c8\u00bc\u00b8\u00c8\u00bb\u00be\u00c6\u00cc\u00af\u00c7\u00d5\u00af\u00c6\u00af\u00be\u00c6 \u00c1\u00c7+\u00c6\u00af\u00be\u00c6 \u00b1\u00b4\u00c6\u00b4\u00ba\u00c625"
  },
