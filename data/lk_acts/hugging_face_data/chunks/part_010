    "chunk_text": "63.\u00a1\u00e6\u00ba\u00e6\u008a \u00c8\u00e5\u00c2\u00e5\u00e2\u00ca \u00c8\u00c2\u00e5\u00aa\u00be\u00e0\u00be\u00e5 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00c8 \u00cd\u00e6\u00a8\u00f8\u00a1\u00e5\u00bc\u00e5\u00c6\u00ef\u008a \u00ef\u00a8\u00e5\u00b4\u00cc\u00a8\u00e0 \u00ef\u00be\u00e5\u00c9\u00be \u00c2\u00c9124\n\n64.\u00ba\u00c4 \u00ef\u00a8\u00e5\u00b4\u00cc\u00e0\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00cc\u00c4\u00aa \u00a8\u00c7\u00be \u00aa\u00b8\u00ea\u00ef\u00bc\u00be\u00ea \u00c9\u00c8\u00e8\u00be\u00e0 \u00c8\u00e6\u00ef\u00c2\u00be\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c8\u00e5\u00c3125\n\n65.\u00c6\u008a \u00c8\u00e5\u00c3\u00e5\u00e2\u00ca\u00c6\u00a8\u00f8\u00be\u00e0 \u00c2\u00bc\u00e0\u00bc\u00a8\u00e0 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00e6\u00be\u00f9\u00c4\u00b4 \u00c9\u00e5\u00cc\u00e8\u00a8 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00b4 \u00cd\u00fa\u0095\u00a8\u00c4 \u00a1\u00e6\u00ba\u00f8 \u00c2\u00c9125\n\n67.\u00cc\u00c4\u00e5\u00aa\u00c4\u00a8 \u00c8\u00e5\u00c3 \u00cc\u00cd \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00cc\u00c4\u00e5\u00aa\u00ef\u008a \u00a1\u00bd\u00f1\u00a8\u00e0\u00cb\u00c9\u00c7\u00c6\u00a8\u00eb\u0097\u00cc\u00e8\u00be\u00e0 \u00be\u00ba\u00eb\u00a8\u00c7 \u00aa\u00be\u00e0\u00be\u00e5 \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00a8 \u00a1\u00bc\u00e5\u00c8 \u00c9\u00be\u0097\u0093\u0097\u00bd\u00e5\u00be130\n\n68.\u00ef\u008a \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00ef\u00c6\u00e0 \u0097\u0093\u0097\u00bd\u00e5\u00be \u00c0\u00ea\u00b8\u00f1\u00e5\u00c6\u00ba\u00be \u00a1\u00e5\u00bc\u00fa\u00c6\u00b4 \u00a1\u00bc\u00e5\u00c8\u00ef\u00be\u00e5\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9130\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\nvii\n\nXI \u00c9\u00be \u00c0\u00d6\u0083\u00ef\u00d8\u00bc\u00c6\n\n\u0097\u00ef\u00ca\u00e0\u00cb \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\n\n\u00a1-\u00bc\u00c7\u00e6\u00ef\u00c9\u00e5\u00e0\n\n69.\u00bc\u00c7\u00e6\u00c9\u00a8\u00eb\u00ef\u00aa\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4130\n\n\u00a1\u00e5 - \u00c3\u00e5\u00c7\u00aa\u00e6\u00be\u00ea\u008a\u00a8\u00c7\u00e6\u00ef\u00c9\u00e5\u00e0, \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u00ef\u00c9\u00e5\u00e0 \u00cd\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0\u00c4\u00e3\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c6\u00be\u00e5\u00bc\u00e9\u00cd\u00ea\n\n70.\u00c3\u00e5\u00c7\u00aa\u00e6\u00b8\u00ea\u008a\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u00cc\u00cd \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00c9\u00e5\u00da\u00bb\u00e5 \u00cc\u00e6\u00c0\u00c6\u00fa\u00c6\u00c6\u00ea\u00ba\u00eb \u00c2\u00c9 \u00cc\u00cd \u00c2\u00f3 \u00ef\u00aa\u00d1\u00c4\u00b4 \u00a7\u00c9\u00ea\u00be\u00e0 \u00c6\u00b4\u00ba\u00e0 \u00c9\u00be \u00c2\u00c9131\n\n71.\u00a1\u00c2\u00c8\u00ba\u00e5\u00c9\u00c6\u00a8\u00b4 \u00c0\u00ba\u00e0 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00ef\u00aa\u00e0 \u00c3\u00e5\u00c7\u00a8\u00e5\u00c7\u00c6\u00a8\u00eb \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00bc\u00e0\u00bc \u00ef\u00aa\u00d1\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00c2\u00c9132\n\n72.\u0095\u00c6\u00aa\u00fa\u00c6 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u0097\u00cc\u00e8\u00be\u00e0 \u00ef\u00aa\u0097\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00f3 \u00ef\u00aa\u00d1\u00c4\u00b4\u00ef\u00c0\u00e5\u00c8\u00e0\u00c4\u00e3\u00a8\u00c7\u00e6\u00c9\u00a8\u00eb \u00c6\u00b4\u00ba\u00e0\u00c9\u00be \u00c2\u00c9133\n\n73.\u00ef\u00c0\u00e5\u00c8\u00e0\u00c4\u00e3\u00a8\u00c7\u00e6\u00c9\u00be\u00e0 \u0097\u00cc\u00e8\u00be\u00e0 \u00cc\u00e6\u00c0\u00c6\u00fa\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c9\u00e5\u00da\u00ba\u00e5 \u00cd\u00e5 \u00ef\u00c0\u00e5\u00c8\u00e0\u00c4\u00e3\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00cd\u00e5 \u00a1\u00da\u00bb\u00c8\u00e5\u00c3\u00fb\u00be\u00e0 \u00c2\u00f3 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u009f\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00c2\u00c9134\n\n74.\u00cd\u00c9\u00ea\u00c8\u00e0 \u00c3\u00e5\u00c7\u00a8\u00c7\u00e6 \u00cc\u00cd \u00ef\u00c0\u00e5\u00c8\u00e0\u00c4\u00e3\u00a8\u00c7\u00e6\u00ef\u00c9\u00e5\u00e0135\n\n\u00a1\u00e6-\u00a6\u00e0\u00a8\u00a8 \u00c3\u00e5\u00c7\n\n75.\u00cc\u00e7\u00c4 \u00a6\u00e0\u00a8\u00a8 \u00c3\u00e5\u00c7\u00c6\u00a8\u00e0\u00c4 \u00cc\u00c4\u00e5\u00aa\u00c4\u00a8\u00e0 \u00c9\u00ca\u00ef\u00c6\u00be\u00e0 \u00cc\u00e6\u00c8\u00a8\u00f8\u00c6 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9135\n\n\u00a1\u00e7-\u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\n\n76.\u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c6\u00a8 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00f8\u00d7\u00c4136\n\n77.\u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8 \u00bc\u00fb \u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00ef\u00c6\u00e0 \u00be\u00e5\u00c4\u00ef\u00c6\u00be\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6\u00c9\u00a8\u00e0\u00a8\u00ce \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9139\n\n78.\u00cd\u00c9\u00ea\u00c8\u00e0 \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7 \u00c4\u00ba \u00a1\u00c6\u00a8\u00c8 \u00c6\u00ea\u00ba\u00eb \u00c2\u00f3140\n\n\u00a2-\u00c9\u00e5\u00cc\u00e8\u00a8 \u00c3\u00e5\u00c9\u00c6\n\n79.\u00c9\u00e5\u00cc\u00e8\u00a8\u00c3\u00e5\u00c9\u00c6 \u00c6\u00be\u00e0\u00ef\u00be\u00e0 \u00a1\u00bc\u00cd\u00cc\u00e0 \u00c9\u00be\u00e0\u00ef\u00be\u00e0 \u00a8\u00eb\u00c4\u00a8\u00e0\u00bc \u00c6\u00be \u00c9\u00aa141\n\n\u00c9\u00aa\u00be\u00e0\u00ba\u00f8\u00c6\u00c0\u00e8\u00b4\u00ea\u00c9\n\nviii\n\n\u00a3-\u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00e0 \u00c2\u00e6\u00bf\u00fb\u008a\n\n80.\u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00e6\u00ba\u00e6\u008a \u00c8\u00e5\u00c3 \u00a1\u00c6\u00a8\u00c7 \u00aa\u00be\u00ea \u00c8\u00e6\u0094\u00c6 \u00cd\u00e6\u00a8\u00f8 \u00c2\u00c9143\n\n81.\u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb \u00ef\u00c9\u00be\u00ea\u00ef\u00c9\u00be\u00e0 \u00ba\u00a8\u00e0\u00ef\u00cc\u00e0\u00c7\u00e6 \u00a8\u00c7\u00be\u00ea \u00c8\u00e6\u0094\u00c6\u00cd\u00e6\u00a8\u00f8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ef\u00ba\u00e5\u00e0144\n\n82.\u00a1\u00e6\u00ba\u00e6\u008a \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00e0 \u00c2\u00e6\u00bf\u00fb\u008a144\n\n83.\u00a1\u00e6\u00ba\u00e6\u008a \u00c9\u00f1\u00e5\u00c0\u00e5\u00c7\u00c9\u00c8 \u00c8\u00e5\u00c3 \u00c8\u00e6\u009f\u008a \u00c9\u00c8 \u00c0\u00f2\u00ba\u00f8\u00ca\u00ba\u00c6\u00a8\u00e0 \u00ef\u00c8\u00cc\u00aa\u00b8\u00be\u00c6 \u00a8\u00c8 \u00c6\u00ea\u00ba\u00eb \u00c2\u00c9146\n\n84.\u00a1\u00c0\u00be\u00c6\u00be \u00be\u00f8\u00cb\u00e0\u00c0\u00e5\u00bc\u00be \u0097\u00a8\u00f8\u00b8\u00e9\u00ef\u00c4\u00be\u00e0 \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00a8\u00eb\u00b4\u00c8\u00e6\u00ef\u00c2\u00be \u00c8\u00e5\u00c3146\n\n85.\u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00ef\u00aa\u00e0 \u00a1\u00e6\u00ba\u00e6\u008a \u00c8\u00e5\u00c2 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a\u00c2\u00bc\u00e0\u00bc\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00d1\u00c4147\n\n86.\u00a1\u00e6\u00ba\u00e6\u008a \u00a1\u00c9\u00cc\u00e0\u00bb\u00e5\u00c9\u00c8\u00bc\u00fb \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0 \u00a1\u00e5\u00bc\u00e5\u00c6\u00c4\u00c2\u00bc\u00e0\u00ef\u00bc\u00be\u00e0 \u00be\u00f8\u00bc\u00cd\u00cc\u00e0 \u00a8\u00f8\u00d7\u00c4 \u00cc\u00cd \u00a1\u00e6\u00ba\u00e6\u008a \u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00ba\u00e6\u00be\u00e6\u00ba\u00e0\u00ba\u00be\u00e0\u00a1\u00b6\u00ea\u00a8\u00c8 \u00a1\u00be\u00ea\u00c0\u00f2\u00c4\u00e5\u00b8 \u00a1\u00be\u00ea\u00c9 \u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00f3 \u00ef\u00aa\u00d1\u00c4\u00b4 \u00c6\u00b4\u00ba\u00e0 \u00d1\u00c4147\n\n\u00a4-\u00be\u00e6\u008c \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb \u00cc\u00cd \u00aa\u00eb\u00c9\u00be\u00e0 \u00a8\u00b4\u00c6\u00ea\u00ba\u00eb\n\n87.\u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00be\u00e6\u008c \u00cd\u00fa\u0095\u00c6\u00be\u00e0\u00ef\u00aa\u00e0 \u00ef\u00cd\u00e5\u00e0 \u00be\u00e6\u008c \u00a8\u00eb\u00c8\u00e8\u00c6\u00b4 \u00aa\u00be\u00e0\u00be\u00be\u00e0\u00ef\u00aa\u00e0 \u00c8\u00e5\u00c3148\n\n88.\u00be\u00e6\u00c9\u00a8 \u00c0\u00f2\u00bd\u00e5\u00be\u00c6\u00e5 \u00a1\u00be\u00ea\u00ef\u00c6\u00e5\u00e0\u00d4\u00ba\u00c6\u00a8\u00eb \u00c2\u00c9148\n\n89.\u00a1\u00e5\u00bc\u00e5\u00c6\u008a \u00c2\u00bc\u00e0\u00bc \u00ef\u00aa\u00d1\u00c4 \u00cd\u00fa\u00ad\u00c9 \u00a1\u00e6\u00ba\u00f8 \u0097\u00b4 \u00a1\u00e5\u00c0\u00cc\u00ea \u00c6\u00e5\u00ba\u00f2\u00e5\u00a8\u00f8\u00d7\u00c4\u00b4 \u00a1\u00c9\u00cc\u00c7 \u00bc\u00fb\u00c4 \u00c0\u00f2\u00ba\u00f8\u00a8\u00e0\u00ef\u00cb\u00e0\u00c0 \u00a8\u00f8\u00d7\u00c4.148\n\n90.\u00be\u00f8\u00da\u00c9\u00e5\u00cc\u00e8\u00a8 \u00aa\u00eb\u00c9\u00be\u00e0\u00c6\u00e5\u00be\u00e5 \u00a1\u00c6\u00fa\u00ba\u00f8\u00a8\u00c7\u00e6\u00c9\u00be\u00e0\u00ef\u00aa\u00e0 \u00cd\u00e5 \u00aa\u00eb\u00c9\u00be\u00e0\u00c6\u00e5\u00be\u00e5\u00a8\u00eb\u00c8\u00e8\u00c6\u00b4 \u00aa\u00be\u00e0\u00be\u00be\u00e0\u00ef\u00aa\u00e0 \u00c8\u00e5\u00c3149"
