dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u0daf\u0dd4 (\u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0db1) \u0db4\u0db1\u0dad \u0dba\u0db1\u0dd4\u0dd9\u0dc0\u0db1\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dc0\u0dbd \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd3\u0dd9\u0db8\u0dca \u0daf\u0dd2\u0db1 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d87\u0dad\u0dca\u0db1\u0db8\u0dca \u0db8\u0dd2\u0dc3, 2012 \u0da2\u0db1\u0dc0\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 1 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd6 \u0dd9\u0dbd\u0dc3 \u0dc3\u0dbd\u0d9a\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba. 2. (\u0dd9\u0db8\u0dc4\u0dd2 \u0db8\u0dd2\u0db1\u0dca\u0db8\u0dad\u0dd4 \u201c\u0db4\u0db0\u0dcf\u0db1 \u0db4\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u201d \u0dba\u0db1\u0dd4\u0dd9\u0dc0\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1) 2002 \u0d85\u0d82\u0d9a 14 \u0daf\u0dbb\u0db1 \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u0daf\u0dd4 \u0db4\u0db1\u0dd9\u0dad\u0dca 2 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0d9a\u0dca\u0dd9\u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd9\u0db6\u0dca :- (1) \u0d92 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dd9\u0dba\u0dca (2) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dd9\u0dba\u0dca :- (\u0d85) (\u0d89) \u0d85\u0db1\u0dd4\u0dd9\u0da2\u0dca\u0daf\u0dd9\u0dba\u0dca (i) \u0dc0\u0db1 \u0d85\u0dba\u0dd2\u0dad\u0db8\u0dba \u0d89\u0dc0\u0dad\u0dca\u0dd9\u0d9a\u0ddc\u0da7 \u0d92 \u0dd9\u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0d9a\u0dca\u0dd9\u0dc0\u0db1 \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 \u0d86\u0dd9\u0daf\u0dca\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0db1\u0dca :- \u201c(i) \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0db1 \u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dd9\u0dba\u0dca II \u0dc0\u0db1 \u0dd9\u0d9a\u0ddc\u0da7\u0dd9\u0dc3\u0dda (\u0d8a) \u0dd9\u0da1\u0dca\u0daf\u0dd9\u0dba\u0dca (i) \u0dc0\u0db1 \u0d85\u0db1\u0dd4\u0dd9\u0da1\u0dca\u0daf\u0dd9\u0dba\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d87\u0dad\u0dd2, 2008 \u0d85\u0d82\u0d9a 14 \u0daf\u0dbb\u0db1 \u0d9a\u0dd9\u0db8\u0ddd\u0db4\u0dcf\u0dba \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc0\u0255\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0db4\u0db1\u0dd9\u0dad\u0dca 3 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dd9\u0dba\u0dca (4) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db4\u0d9a\u0dcf\u0dbb\u0dc0 \u0dba\u0db8\u0dca \u0d9a\u0dd9\u0db8\u0ddd\u0db4\u0dcf\u0dba \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc0\u0255\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba\u0d9a \u0db1\u0dd2\u0dba\u0dd0\u0dbd\u0dd2 \u0dad\u0dd0\u0db1\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0dd9\u0dc4\u0ddd (2011 \u0d85\u0dd9\u0db4\u0dda\u0dbd\u0dca \u0db8\u0dc3 1 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0db6\u0dbd\u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dd9\u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2) \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0db1 \u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dd9\u0dba\u0dca II \u0dc0\u0db1 \u0dd9\u0d9a\u0ddc\u0da7\u0dd9\u0dc3\u0dda (\u0d8a) \u0dd9\u0da1\u0dca\u0daf\u0dd9\u0dba\u0dca (ii) \u0dc0\u0db1 \u0d85\u0db1\u0dd4\u0dd9\u0da1\u0dca\u0daf\u0dd9\u0dba\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0db1 \u0dbd\u0daf \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2\u0dd2\u0dad \u0dc0\u0255\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba\u0d9a \u0db1\u0dd2\u0dba\u0dd0\u0dbd\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dad\u0dd0\u0db1\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0dd9\u0dc0\u0dad \u0d9a\u0dbb\u0db1 \u0d