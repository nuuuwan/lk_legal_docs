a\u0db1\u0dcf \u0dc0\u0dd6 \u0d87\u0dad\u0dd0\u0db8\u0dca \u0dc0\u0255\u0dc0\u0dc3\u0dcf\u0dba\u0db1\u0dca (235 \u0dc0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dba \u0dc0\u0dd6) \u0dd9\u0dbb\u0dca\u0d9c\u0dd4 \u0d86\u0da5\u0dcf\u0db4\u0db1\u0dad, (423 \u0dc0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dba \u0dc0\u0dd6) \u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba \u0db4\u0dcf\u0dbd\u0db1 \u0db4\u0db1\u0dad \u0dc3\u0dc4 1969 \u0d85\u0d82\u0d9a 1 \u0daf\u0dbb\u0db1 \u0d86\u0db1\u0dba\u0db1 \u0dc3\u0dc4 \u0d85\u0db4\u0db1\u0dba\u0db1 (\u0db4\u0dcf\u0dbd\u0db1) \u0db4\u0db1\u0dad \u0dba\u0db1 \u0db4\u0db1\u0dad\u0dca\u0dc0\u0dbd \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1 \u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u0dd3\u0dd9\u0db8\u0db1\u0dca \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0daf; \u0d92 \u0dc4\u0dcf \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0dd9\u0dc4\u0ddd \u0d8a\u0da7 \u0d86\u0db1\u0dd4\u0dc2\u0dcf\u0d82\u0d9c\u0dd2\u0d9a \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0daf \u0dc0\u0dd6 \u0db4\u0db1\u0dad\u0d9a\u0dd2. \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dd9\u0db8\u0dd9\u0dc3\u0dda \u0db4\u0db1\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd9\u0db6\u0dca:- 1. \u0dd9\u0db8\u0dca \u0db4\u0db1\u0dad 2012 \u0d85\u0d82\u0d9a 12 \u0daf\u0dbb\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0db1\u0dad \u0dba\u0db1\u0dd4\u0dd9\u0dc0\u0db1\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd9\u0db6\u0dca. I \u0dc0\u0db1 \u0dd9\u0d9a\u0ddc\u0da7\u0dc3"
