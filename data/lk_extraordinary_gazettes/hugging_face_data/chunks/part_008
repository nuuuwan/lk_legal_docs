\n\u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0baa\u0bbf\u1fb9 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0 \u0b95\u1fc0\n\n1:7 0.3011 \u0b85\u0bb0\u1f86 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 _ _\n\n1:9 0.1951 \u0b85\u0bb0\u1f86 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 _ \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a.\u0ba4\u0bbf\u1fb9 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9 \u0b95\u1fa6\u1fb0\u1f81\u1fbb,\n\n\u0baa\u1fb7\u0ba4\u0bbf\u0bb0 \u0b87\u0bb2. 1071/661 \u0b95\u0bc0\u1fc1 \u0bb0\u0bb9\u0b9a\u0bbf\u1fb9\n\n\u0bae\u0bb9\u0bc6\u0b95\u0ba4\u0bb0 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\n\n\u0bb2\u0bbe\u0bc7\u0b95 \u1f86\u0b9a\u1fb8\u0ba4 \u1f81\u0bae\u0bbe\u0bb0 \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9\n\n\u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 1:10 0.2568 \u0b85\u0bb0\u1f86 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 _ \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a.\u0ba4\u0bbf\u1fb9\n\n\u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9 \u0b95\u1fa6\u1fb0\u1f81\u1fbb, \u0baa\u1fb7\u0ba4\u0bbf\u0bb0 \u0b87\u0bb2.\n\n1072/661 \u0b95\u0bc0\u1fc1 \u1f97\u1fb4\u0b9a\u0bbf \u0baa\u1fb6\u0b9f\u0bbe\u0bc7\u0b95\n\n\u0b85\u0b9c\u0bbf\u1fb7 \u1f81\u0bae\u0bbe\u0bb0 \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 1:16 0.1680 \u0b85\u0bb0\u1f86 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 _ _\n\n1:23 0.2078 \u0b85\u0bb0\u1f86 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 _ _ 1:26 0.2058 \u0b85\u0bb0\u1f86 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 _ _ 1:28 0.2056 \u0b85\u0bb0\u1f86 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 _ _\n\n1:29 0.1268 \u0b85\u0bb0\u1f86 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81