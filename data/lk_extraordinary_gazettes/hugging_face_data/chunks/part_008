9a 5985; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5881.\n\n45. \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5881 \u2013 \u0daf\u0dd4\u0d82\u0d82\u0d9a\u0dbd\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba \u2013 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba: 45. \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5881 \u2013 \u0daf\u0dd4\u0d82\u0d82\u0d9a\u0dbd\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba \u2013 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba: \u0dc4\u0dd9\ufffd\u0d9a\u0dca. 0.0369\u0dc4\u0dd9\ufffd\u0d9a\u0dca. 0.0369 \u0d8b\u0dad\u0dd4\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5883 \u0dc3\u0dc4 5876; \u0db1\u0dd0\u200d\u200d\ufffd\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5876 \u0dc3\u0dc4 5880; \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5985 \u0dc3\u0dc4 5882; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5882."
