\u1f90\u0ba3\u0bcd\u1f8c M; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c M\n\n\u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bb8\u0bcd\u0bb0\u0bc0\u0bae\u0bbe\u0bc7\u0bb5\u0bbe \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0bae\u0bbe\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4.\n\n11. \u1f90\u0ba3\u0bcd\u1f8c \u1f90\u0ba3\u0bcd\u1f8c \u2018M\u2019 \u2013 \u0bb5\u0bbe\u0bbf\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. 223, \u0bb8\u0bcd\u0bb0\u0bc0\u0bae\u0bbe\u0bc7\u0bb5\u0bbe \u2013 \u0bb5\u0bbe\u0bbf\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. 223, \u0bb8\u0bcd\u0bb0\u0bc0\u0bae\u0bbe\u0bc7\u0bb5\u0bbe\n\n\u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0bae\u0bbe\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0009 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0bae\u0bbe\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0009 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u0bb8\u0bcd\u0bb0\u0bc0\u0bae\u0bbe\u0bc7\u0bb5\u0bbe \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0bae\u0bbe\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd\n\n\u1f90\u0ba3\u0bcd\u1f8c K; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c K, \u0baa\u0bc0. \u0b95\u0bc1\u0bae\u0bb0\u0ba9\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd\n\n\u0bb5\u0bbe\u0bbf\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. 221 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa \u0ba8\u0bb1\u0bcd\u0b95\u0bc1\u0ba9\u0ba8\u0bbe\u0ba4\u0ba9\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae\n\n\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bb5\u0bbe\u0bbf\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9