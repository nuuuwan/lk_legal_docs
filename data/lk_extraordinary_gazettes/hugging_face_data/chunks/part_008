    "chunk_text": "\u0d9a\u0dd1\u0dd1\u0d9c\u0dbd\u0dca\u0dbd\u0daf\u0dd9\u0dd9\u0dc4\u0dd2\u0d95\u0dc0\u0dd2\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0dbd\u0dd2\u0dba\u0db1 \u0dbd\u0dda\u0262\u0d9a\u0db8\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dc3\u0db8\u0db1\u0dca\u0dc3\u0dd2\u0dbb\u0dd2 \u0dc0\u0dd3\u0dbb\u0dc3\u0dd2\u0d82\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dcf\u0dcf2025.06.17\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dd2\u0db8\u0dcf\u0dcf\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0dad\u0dcf\u0dcf\u0db1\u0d9c\u0dda\u0118 \u0db1\u0db1\u0dca\u0daf\u0db1 \u0dc3\u0db8\u0dbb\u0dc0\u0dd3\u0dbb \u0db8\u0dc4\u0dad\u0dcf\u0dcf2025.06.17\n\n\u0d9a\u0dd1\u0dd1\u0d9c\u0dbd\u0dca\u0dbd\u0db8\u0dcf\u0dcf\u0dc0\u0db1\u0dd0\u0dd0\u0dbd\u0dca\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dc0\u0dad\u0dca\u0dad\u0dda\ufffd \u0d9c\u0dd9\ufffd\u0daf\u0dbb \u0dc3\u0db8\u0db1\u0dca \u0db0\u0db8\u0dca\u0db8\u0dd2\u0d9a \u0dc0\u0dda\u0dda\u0dbb\u0d9c\u0ddc\ufffd\u0ddc\u0da9 \u0db8\u0dc4\u0dad\u0dcf\u0dcf2025.06.17\n\n\u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb\u0d9a\u0dc4\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0d9c\u0db1\u0dda\ufffd\u0d9c\u0db8 \u0d9c\u0dd4\u0dbb\u0dd4\u0d9c\u0dda\u0118 \u0dc1\u0dcf\u0dcf\u0db1\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0d82\u0d82\u0d9a\u0dbb \u0db8\u0dc4\u0dad\u0dcf\u0dcf2025.06.18\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0db4\u0dbd\u0dca\u0dbd\u0dda\u0