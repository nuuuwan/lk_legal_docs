u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bcd\u0bb3\u0bb5\u0bbe\u0bb1\u0bc1 \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0bcd\u0ba4\u0bae\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0bcd\u0baf\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bb2\u0bcd \u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bc6\u0ba9 \u0b87\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbe\u0bb2\u0bcd \u0b85\u0bb1\u0bbf\u0baf\u0ba4\u0bcd\u0bcd\u0ba4\u0bb0\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bcd\u0bb1\u0bb1\u0bc7\u0ba9\u0bcd.\n\n\u0b86\u0bb0\u0bcd. \u0b8e\u0bae\u0bcd. \u0b8f. \u0b8e\u0bb2\u0bcd. \u0bb0\u0ba4\u0bcd\u0bcd\u0ba8\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0bcd\u0b95, \u0b8e\u0bae\u0bcd. \u0b8f. \u0baa\u0bc0. \u0b9a\u0bbf. \u0baa\u0bc6\u0bb0\u0bc7\u0bb0\u0bbe, \u0b85\u0bae\u0bc0\u0bb0\u0bcd \u0baa\u0bbe\u0baf\u0bbf\u0bb8\u0bcd, \u0b86\u0bb0\u0bcd. \u0b8e\u0bae\u0bcd. \u0b8f. \u0b8e\u0bb2\u0bcd. \u0bb0\u0ba4\u0bcd\u0bcd\u0ba8\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0bcd\u0b95, \u0b8e\u0bae\u0bcd. \u0b8f. \u0baa\u0bc0. \u0b9a\u0bbf. \u0baa\u0bc6\u0bb0\u0bc7\u0bb0\u0bbe, \u0b85\u0bae\u0bc0\u0bb0\u0bcd \u0baa\u0bbe\u0baf\u0bbf\u0bb8\u0bcd,\n\n\u0ba4\u0bb5\u0bbf\u0b9a\u0bbe\u0bb3\u0bb0\u0bcd, \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bbf\u0ba9\u0bb0\u0bcd, \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bbf\u0ba9\u0bb0\u0bcd,\n\n\u0ba4\u0bc7\u0bb0\u0bcd\u0bcd\u0ba4\u0bb2\u0bcd \u0b86\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1. \u0ba4\u0bc7\u0bb0\u0bcd\u0bcd\u0ba4\u0bb2\u0bcd \u0b86\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1. \u0ba4\u0bc7\u0bb0\u0bcd\u0bcd\u0ba4\u0bb2\u0bcd \u0b86\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1.\n\n\u0b8f. \u0b9a\u0ba3\u0bcd\u0bae\u0bc1\u0b95\u0ba8\u0bbe\u0ba4\u0ba9\u0bcd, \u0b8f. \u0b9a\u0ba3\u0bcd\u0bae\u0bc1\u0b95\u0ba8\u0bbe\u0ba4\u0ba9\u0bcd, \u0baa\u0bc7\u0bb0\u0bbe\u0b9a\u0bbf\u0bb0\u0bbf\u0baf\u0bb0\u0bcd\u0baa\u0bc7\u0bb0\u0bbe\u0b9a\u0bbf\u0bb0\u0bbf\u0baf\u0bb0\u0bcd \u0bb2\u0b95\u0bcd\u200c\u0bb7\u0bcd\u0bcd\u0bae\u0ba9\u0bcd \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0bcd\u0b95, \u0bb2\u0b95\u0bcd\u200c\u0bb7\u0bcd\u0bcd\u0bae\u0ba9\u0bcd \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0bcd\u0b95,\n\n\u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bbf\u0ba9\u0bb0\u0bcd, \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bbf\u0ba9\u0bb0\u0bcd,\n\n\u0ba4\u0bc7\u0bb0\u0bcd\u0bcd\u0ba4\u0bb2\u0bcd \u0b86\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1. \u0ba4\u0bc7\u0bb0\u0bcd\u0bcd\u0ba4\u0bb2\u0bcd \u0b86\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1.\n\n\u0ba4\u0bc7\u0bb0\u0bcd\u0bcd\u0ba4\u0bb2\u0bcd \u0b86\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1 \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0b95\u0bae\u0bcd,\n\n\u0b9a\u0bb0\u0ba3 \u0bae\u0bbe\u0bb5\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bc8,\n\n\u0b87\u0bb0\u0bbe\u0b9c\u0b95\u0bbf\u0bb0\u0bbf\u0baf,\n\n2025, \u0baf\u0bc2\u0ba9\u0bcd 12."
