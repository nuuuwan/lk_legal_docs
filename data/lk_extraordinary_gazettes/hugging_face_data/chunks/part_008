    "chunk_text": "\u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dc3\u0dc4 \u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd22025.06.18\u0db4\u0dd9\u0dd9. \u0dc0. 09.00\n\n\u0dc0\u0dd0\u0dd0\u0dbd\u0dd2\u0dc0\u0dd2\u0da7\u0dd2\u0dba \u0daf\u0dd2\u0dc0\u0dd2\u0dad\u0dd4\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda, \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n02\u0db1\u0dd9\ufffd\u0dc5\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dc3\u0dc4\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd22025.06.17\u0db4\u0dd9\u0dd9. \u0dc0. 10.00\n\n\u0db1\u0dd9\ufffd\u0dc5\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda, \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n\u0db1\u0dcf\u0dcf\u0d9c\u0ddc\ufffd\u0ddc\u0da9 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda, \u0d8b\u0da9\u0dd4\u0d9c\u0db8 \u0dc1\u0dca\u200d\u0dbb\u0dc0\u0dab\u0dcf\u0dcf\u0d9c\u0dcf\u0dcf\u0dbb\u0dba\n\n04\u0dbb\u0da2\u0dca\u0d9c\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dc3\u0dc4\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd22025.06.20\u0db4. \u0dc0. 02.30\u0dbb\u0da2\u0dca\u0d9c\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda, \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n05\u0d9c\u0dcf\u0dcf\u0dbd\u0dca\u0dbd \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9c\u0dbb\u0dd4 \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc3\u0dc4 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0dca\u200d\u0dba\u0dba \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd22025.06.20\u0db4\u0dd9\u0dd9. \u0dc0. 09.00\n\n\u0d9c\u0dcf\u0dcf\u0dbd\u0dca\u0dbd \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda, \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n06\u0dc4\u0dd2\u0d9a\u0dca\u0d9a\u0da9\u0dd4\u0dc0 \u0db1\u0d9c\u0dbb\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dc3\u0dc4\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd22025.06.18\u0db4. \u0dc0. 02.30\u0dc4\u0dd2\u0d9a\u0dca\u0d9a\u0da9\u0dd4\u0dc0 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda, \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n07\u0db6\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dc3\u0dc4\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd22025.06.24\u0db4. \u0dc0. 02.30\n\n\u0db6\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda, \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n08\u0db6\u0dd9\ufffd\u0db1\u0dca\u0dad\u0ddc\ufffd\u0ddc\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dc3\u0dc4\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd22025.06.24\u0db4\u0dd9\u0dd9. \u0dc0. 09.30\n\n\u0dc4\u0db6\u0dd4\u0dbb\u0dd4\u0d9c\u0dbd \u0db4\u0dc4\u0dc5 \u0d9c\u0db8\u0dca\u0dc4\u0dba \u0d8b\u0db4 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba\u0dda\u024f \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n09\u0db6\u0daf\u0dca\u0daf\u0dda\u0dda\u0d9c\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dc3\u0dc4\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd22025.06.30\u0db4. \u0dc0. 02.30\u0db6\u0daf\u0dca\u0daf\u0dda\u0dda\u0d9c\u0db8 \u0db1\u0d9c\u0dbb \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n\u0db8\u0dcf\u0dcf\u0dad\u0dbb\n\n01\u0db8\u0dd4\u0dbd\u0da7\u0dd2\u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dc3\u0dc4\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd22025.06.25\u0db4\u0dd9\u0dd9. \u0dc0. 10.00\n\n\u0db8\u0dd4\u0dbd\u0da7\u0dd2\u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda, \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n02\u0dc0\u0dd0\u0dd0\u0dbd\u0dd2\u0d9c\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dc3\u0dc4\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd22025.06.27\u0db4\u0dd9\u0dd9. \u0dc0. 10.00\n\n\u0dc0\u0dd0\u0dd0\u0dbd\u0dd2\u0d9c\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda, \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n03\u0dc0\u0dd0\u0dd0\u0dbd\u0dd2\u0d9c\u0db8 \u0db1\u0d9c\u0dbb\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dc3\u0dc4\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd22025.06.27\u0db4. \u0dc0. 02.30\n\n\u0dc0\u0dd0\u0dd0\u0dbd\u0dd2\u0d9c\u0db8 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda, \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n\u0dc4\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0ddc\ufffd\u0ddc\u0da7\n\n01\u0d9a\u0da7\u0dd4\u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9c\u0dbb\u0dd4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dc3\u0dc4\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd22025.06.19\u0db4\u0dd9\u0dd9. \u0dc0. 10.00\n\n\u0d9a\u0da7\u0dd4\u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda, \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n02\u0dc4\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0ddc\ufffd\u0ddc\u0da7 \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9c\u0dbb\u0dd4 \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc3\u0dc4 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0dca\u200d\u0dba\u0dba \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd22025.06.23\u0db4\u0dd9\u0dd9. \u0dc0. 10.00\n\n\u0dc4\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0ddc\ufffd\u0ddc\u0da7 \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda, \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n03\u0dad\u0d82\u0d82\u0d9c\u0dbd\u0dca\u0dbd \u0db1\u0d9c\u0dbb\n\n\u