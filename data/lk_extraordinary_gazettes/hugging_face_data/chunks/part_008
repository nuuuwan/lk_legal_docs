0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0bb0\u0ba9\u0bcd\u0bcd\u0baa\u0ba9\u0bcd\u0bcd\u0b9f\u0b9f\u0bbe \u0bb5\u0ba9\u0bcd\u0bcd\u0ba9\u0ba9\u0bbf\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0bcd\u0b95\n\n\u0bb5\u0ba9\u0bcd\u0bcd\u0ba9\u0ba9\u0bbf\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0bcd\u0b95 \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bcd\u0b9a\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0b85\u0ba9\u0bc1\u0bb0 \u0baa\u0ba3\u0bcd\u0bcd\u0b9f\u0b9f\u0bbe\u0bb0 \u0ba8\u0bb5\u0bb0\u0ba4\u0bcd\u0bcd\u0ba9\n\n\u0bb8\u0bcd\u0bb0\u0bc0\u0bb0\u0b99\u0bcd\u0bcd\u0b95 \u0bb8\u0bcd\u0bb0\u0bc0\u0ba8\u0bbe\u0bb0\u0bbe\u0baf\u0ba9 \u0b85\u0ba4\u0bcd\u0bcd\u0ba4\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0bcd\u0b95 \u0baa\u0bae\u0bc1\u0ba3\u0bc1 \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bcd\u0b9a\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0b85\u0ba9\u0bc1\u0bb0 \u0b85\u0ba4\u0bcd\u0bcd\u0ba4\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0bcd\u0b95\n\n\u0baa\ufffd\u0bca\u0bb2\u0b95\u0bb9\u0bb5\u0bc6\u0bb2 \u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0b95\ufffd\u0bca\u0bb8\u0bcd\u0bcd\u0bb5\u0ba4\u0bcd\u0bcd\u0ba4 \u0b95\u0bae\u0bcd\u0bcd\u0bb2\u0ba4\u0bcd\u0bcd\u0ba4\u0bb2\u0bbe\u0b95\u0bc7 \u0b95\u0bc1\u0b9a\u0bc1\u0bae\u0bbe \u0b95\u0bc1\u0ba3\u0bb5\u0bb0\u0bcd\u0bcd\u0ba4\u0ba9\n\n\u0bae\u0bc6\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bc7 \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bcd\u0b9a\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0ba4\u0bb0\u0bcd\u0bcd\u0bae\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bbf\u0bb0\u0bbf\u0baf \u0baa\u0bbf\u0bb0\u0bc7\u0bae\u0b95\u0bc1\u0bae\u0bbe\u0bb0\n\n\u0b9a\u0bae\u0bb0\u0b9a\u0bbf\u0b99\u0bcd\u0bcd\u0bb9 \u0b85\u0b9a\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf\u0bb2\u0bcd\u0bcd\u0bb2\u0bb2\u0bbe\u0b95\u0bc7 \u0bb0\u0bc1\u0bb5\u0ba9\u0bcd \u0baa\u0bc1\u0bb7\u0bcd\u0bcd\u0baa \u0b95\u0bc1\u0bae\u0bbe\u0bb0\n\n\u0bb0\u0bbe\u0b9c\u0baa\u0b95\u0bcd\u0bb7\u0b95\u0bc7 \u0ba4\u0bc1\u0b9a\u0bbe\u0ba8\u0bcd\u0bcd\u0ba4\u0b9a\u0bbf\u0bb0\u0bbf \u0bb5\u0bbf\u200b\u0bc7\u0b9c\u0bb0\u0ba4\u0bcd\u0bcd\u0ba9\n\n\u0bb9\u0bbe\u0b9c\u0bbe \u0b85\u0bae\u0bbe\u0bb2\u0bcd\u0bcd\u0ba4\u0bc0\u0ba9\u0bcd \u0bae\ufffd\u0bca\u0bb9\u0bae\u0b9f\u0bcd \u0b85\u0ba9\u0bcd\u0bcd\u0baa\u0baa\u0bbe\u0bb8\u0bcd\n\n\u0b9c\u0bbe\u0b9a\u0bbf\u0b99\u0bcd \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bcd\u0b9a\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0b9a\u0bae\u0ba9\u0bcd\u0bcd\u0bb2\u0ba4\u0bbe \u0b9c\u0baf\u0b9a\u0bbf\u0b99\u0bcd\u0bcd\u0bb9\n\n\u0bae\ufffd\u0bca\u200b\u0bc6\u0bb9\u0bbe\u0bae\u0b9f\u0bcd \u0b9a\u0bc1\u0bb2\u0bcd\u0bcd\u0ba4\u0ba4\u0bbe\u0ba9\u0bcd \u0bb7\u0ba4\u0bc0\u0bb7\u0bcd \u0bae\ufffd\u0bca\u200b\u0bc6\u0bb9\u0bbe\u0bae\u0b9f\u0bcd"
