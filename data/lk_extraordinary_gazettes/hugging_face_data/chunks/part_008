u0b8e\u0ba9\u0bcd. \u0b9f\u0baa\u0bcd\u0bb3\u0bbf\u0bb5\u0bcd. \u0b8e\u0ba9\u0bcd. \u0b9f\u0bc0. \u0b9f\u0bc0. \u0b9c\u0bc0. \u0b9c\u0baf\u0bc7\u0b9a\u0b95\u0bcd\u0b95\u0bb0 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0bbe\u0ba9\u0bcd\u0ba9\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \u0b8f29 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa).\n\n32. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \"\u0b8f32\" - \u0bc6\u0b95\u0bbe\u0ba9\u0bcd\u0ba9\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd 32. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \"\u0b8f32\" - \u0bc6\u0b95\u0bbe\u0ba9\u0bcd\u0ba9\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : 0.0029 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bbe\u0bcd0.0029 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bbe\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa); \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \u0b8f33, \u1faa\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0baa\u0bc0. \u0b8e\u0ba9\u0bcd. \u0b8e\u0baa\u0bcd. \u1f97\u1fa4\u0b95\u0bb9\u0baa\u0bbf\u0b9f\u0bcd\u1f8a\u0baf \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0bbe\u0ba9\u0bcd\u0ba9\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \u0b8f33, \u1faa\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b8e\u0ba9\u0bcd. \u0b9f\u0baa\u0bcd\u0bb3\u0bbf\u0bb5\u0bcd. \u0b8e\u0ba3\u0bcd. \u0b9f\u0bc0. \u0b9f\u0bc0. \u0b9c\u0bc0. \u0b9c\u0baf\u0bc7\u0b9a\u0b95\u0bcd\u0b95\u0bb0 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0bbe\u0ba9\u0bcd\u0ba9\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u0b8e\u0ba9\u0bcd. \u0b9f\u0baa\u0bcd\u0bb3\u0bbf\u0bb5\u0bcd. \u0b8e\u0ba9\u0bcd. \u0b9f\u0bc0. \u0b9f\u0bc0. \u0b9c\u0bc0. \u0b9c\u0baf\u0bc7\u0b9a\u0b95\u0bcd\u0b95\u0bb0 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0bbe\u0ba9\u0bcd\u0ba9\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \u0b8f31 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa).\n\n33. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \"\u0b8f33\" - \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bb5\u0bbf\u0bb2\u0bcd\u0bc8\u0bb2 - 33. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \"\u0b8f33\" - \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bb5\u0bbf\u0bb2\u0bcd\u0bc8\u0bb2 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : 0.0005 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bbe\u0bcd 0.0005 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bbe\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \u0b8f32 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa); \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1faa\u0ba4\u0bbf; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb2\u0baf\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd \u0b95\u0ba3\u0bcd\u1f8c\u0baa\u0bcd\u0baa\u0bbf\u1f8a\u0b95\u0bcd\u0b95 \u1f99\u1f8a\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u0baa\u0bc0. \u0b8e\u0ba9\u0bcd. \u0b8e\u0baa\u0bcd. \u1f97\u1fa4\u0b95\u0bb9 \u0baa\u0bbf\u0b9f\u0bcd\u1f8a\u0baf \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0bbe\u0ba9\u0bcd\u0ba9\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \u0b8f32.\n\n34. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \"\u0b8f34\" - \u0bc7\u0bb9\u0bbe\u0bae\u0bcd \u0b8e\u0bb8\u0bcd\u0bc7\u0b9f\u0b9f\u0bcd - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd 34. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \"\u0b8f34\" - \u0bc7\u0bb9\u0bbe\u0bae\u0bcd \u0b8e\u0bb8\u0bcd\u0bc7\u0b9f\u0b9f\u0bcd - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : 0.0004 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bbe\u0bcd0.0004 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bbe\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa); \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa) \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \u0b8f35; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \u0b8f35, \u0b9a\u0bc0\u0bc6\u0bae\u0ba8\u0bcd\u1f90 \u0bb5\u0bbe\u0baf\u0bcd\u0b95\u0bcd\u0b95\u0bbe\u0bb2\u0bcd; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u0b8e\u0bae\u0bcd. \u0b8f. \u0b8f. \u0b8e\u0bae\u0bcd. \u1f99\u0ba3\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc7\u0bb9\u0bbe\u0bae\u0bcd \u0b8e\u0bb8\u0bcd\u0bc7\u0b9f\u0b9f\u0bcd."
