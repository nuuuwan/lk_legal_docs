u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0dbb\u0da2\u0db8\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dcf\u0dbb, \"\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dad \u0db8\u0dd0\u0daf\u0dd4\u0dbb\", \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dd9\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca \u0daf\u0dd3 \u0dba.\n\n\u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba\n\n(\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca)\n\n1:22 0.0281 \u0db1\u0dd2\u0dc4\u0dcf\u0dbd\u0dca \u0dc3\u0dd3\u0dc0\u0dbd\u0dd3 \u0db4\u0db1\u0dcf\u0db1\u0dca\u0daf\u0dd4 603620062V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0.\u0d85.30 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c _ \u0d85\u0d82\u0d9a 410/ 7, \u0dc4\u0d82\u0dc3 \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dd9\u0dc3\u0dc0\u0db1,\u0dc3\u0dd6\u0dbb\u0dd2\u0dba\u0dd9\u0d9c\u0ddc\u0da9,\u0db8\u0dd4\u0dbb\u0dd4\u0dad\u0dbd\u0dcf\u0dc0 \u0dc3\u0db8\u0d9f 1:26 0.0294 \u0db4\u0da7\u0db6\u0dd0\u0db3\u0dd2 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc0\u0dd2\u0dd9\u0da2\u0dca\u0dbb\u0dad\u0dca\u0db1 511221935V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0.\u0d85. 30 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c _ \u0db6\u0dab\u0dca\u0da9\u0dcf \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0d85\u0d82\u0d9a 410/32, \u0dc4\u0d82\u0dc3 \u0dd9\u0dc3\u0dc0\u0db1, \u0dc3\u0dd6\u0dbb\u0dd2\u0dba\u0dd9\u0d9c\u0ddc\u0da9, \u0dc3\u0db8\u0d9f. \u0db8\u0dd4\u0dbb\u0dd4\u0dad\u0dbd\u0dcf\u0dc0. 1:30 0.0533 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u