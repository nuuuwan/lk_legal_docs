u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0bae\u0bb2\u0bcd\u0b95\u0bbe\u0ba8\u0bcd\u0ba4\u0bbf \u0bb0\u0ba4\u0bcd\u0ba9\u0bae\u0bc6\u0ba3\u0bbf\u0b95\u0bc7\u0b9a\u0bae\u0bb0\u0b95\ufffd\u0bcb\u0ba9\u0bcd \u0bb5\u0bbf\u0b9c\u0bc7\u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bae \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9 \u0bae\u0bc1\u0bb9\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd\u0bb2\u0bbe\u0b95\u0bc7 \u0ba4\u0bc1\u0bb2\u0bbe\u0b9e\u0bcd\u0b9a\u0bb2\u0bbf \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba4\u0bb0\u0bcd\u0bb7\u0ba9\u0bbf\n\n\u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2 \u0baa\u0bbf\u0bb0\u200d\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bae\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bbe \u0ba4\u0bc1\u0bb0\u0baf\u0bb2\u0bbe\u0b95\u0bc7 \u0bb5\u0bbe\u0b9a\u0ba9\u0bbe \u0b8e\u0b9f\u0bcd\u0bb5\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba4\u0bb0\u0bcd\u0bb7\u0ba9\u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bae \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bc7 \u0bb0\u0b9e\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\n\n\u0ba4\u0ba3\u0bae\u0bb2\u0bcd\u0bb5\u0bbf\u0bb2 \u0baa\u0bbf\u0bb0\u200d\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bb2\u0bb2\u0bbf\u0ba4\u0bcd \u0bb0\u0bbe\u0b9c\u0baa\u0b95\u0bcd\u0bb7\u0bb9\u0bc6\u0b9f\u0bcd\u0b9f\u0bbf \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf \u0b95\u0bae\u0b95\u0bc7 \u0bb0\ufffd\u0bca\u0bb8\u0bbe\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba4\u0bb0\u0bcd\u0bb7\u0ba9\u0bb9\u0bc6\u0ba9\u0bbf\u0b95\u0bcd \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0b9a\u0bbe\u0ba8\u0bcd\u0ba4\u0ba9\u0bbf \u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bbf\u0b95\u0b99\u0bcd\u0b95\u0bbe\u0ba9\u0bae\u0bcd \u0b95\u0bae\u0b95\u0bc7 \u0b85\u0ba9\ufffd\u0bcb\u0bae\u0bbe \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba8\u0bcd\u0ba4\u0bbf\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0bc8 (\u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf)\n\n6 IV ^wd& \u0d9a\u02c1\u0ddc\u0da7\u0dc3 - \u200d\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dad\