db8\u0dca \u0dbd\u0dd2\u0dba \u0dad\u0daf\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0dad\u0db1\u0dad\n\n10 A III \u0dc1\u0d9a\u0ddc\u0da7\u0dc0 - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbc\u0d82\u0d9a \u200d\u0dbb\u0da2\u0dcf \u0dad \u0dca\u0daf\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc0\u0db8 \u0da2\u0dcf\u0dbd \u0da2 \u0da2\u0dcf\u0db1\u0dbb\u0da2\u0dcf\u0dc1\u0d85 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dbe\u0dbf \u0d9c\u0dd0\u0dc0 \u0db4 \u0dad\u200d\u0dbb\u0dba - 2025.06.12\n\n\u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dc5\u0dbb 2013005017 \u0dbd\u0dc6\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d9a\u0d82\u0d9a 1810351 \u0daf\u0dbb\u0db1 \u0d9c\u0dc6\u0dc0\u0da7\u0dca \u0db3\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda \u0dba\u0dae\u0dc5 \u0db3\u0dbb\u0dd2\u0daf\u0dd2 \u0db3\u0dc2\u0d9a\u0dbb\u0db1 \u0dbc\u0daf \u0d9a\u0d82\u0d9a 4230308 \u0daf\u0dbb\u0db1 \u0daf\u0dc6\u0dca\u0dad\u0dc0\u0dd3\u0dba\u0db8\u0dca \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0dba\u0d9a\u0ddc\u0da7 \u0d87\u0dda\u0dcf\u0dc5 \u0dc0\u0dd5 \u0daf, \u0d89\u0da9\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dc0\u0dc4\u0dbd\u0dbc \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc0\u0db8\u0dca\u0db6\u0dca\u0dad\u0db0\u0dba\u0dba\u0dca\u0dad \u0dba\u0db8\u0dc4\u0dd2 \u0d8b\u0db3\u0dba\u0dbd\u0dca\u0d9b\u0db1\u0dba\u0dda \u0daf\u0dc6\u0d9a\u0dca\u0d9a\u0dba\u0dba\u0dbd\u0db1 \u0db8\u0dc5\u0dba\u0dda \u0dad\u0dd3\u0dbb\u0dab 1998 \u0d9a\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dc5\u0db3\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0db3\u0db1\u0dba\u0dda 14 \u0dbd\u0dc6\u0db1\u0dd2 \u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba\u0dba\u0dca\u0dad \u0db3\u0dc1\u0dcf \u0d9a\u0dda\u0dc0\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0db8\u0dc5 \u0dba\u0dbd\u0dcf \u0db3\u0dbd\u0dbb\u0dc5 \u0d87\u0dad\u0dd2 \u0db6\u0dbc\u0dcf\u0dbc \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dc5\u0dbb, \u0db8\u0db8 \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dc5\u0dbe \u0d9a\u0dbb\u0db8\u0dd20 \u0db4\u0dd3. \u0dc3\u0dd3. \u0da9\u0dd3. \u0dc3\u0dd2\u0dc1\u0dda\u0dbb , \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0db8\u0dc0\u0dc5\u0dbb\u0dd2\u0dc0\u0dc4 \u0da2\u0dcf\u0db1\u0dbb\u0dc5\u0dbd\u0dca0 2025 \u0db8\u0dc5\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dc0 11 \u0dbd\u0dc6\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbc, \u0dbb\u0da2\u0dcf\u0db8\u0dbd\u0dca\u0dbd\u0dda\u0dcf \u0db3\u0dc5\u0dbb, \"\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dcf \u0db8\u0dc6\u0daf\u0dd4\u0dbb\", \u0d9a\u0d82\u0d9a 120036, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dba\u0daf\u0db3\u0dc5\u0dbb\u0dca\u0dcf\u0dba\u0db8\u0dca\u0dca\u0dad\u0dad\u0dd4\u0dba\u0dda \u0daf\u0dd3 \u0dba0"
