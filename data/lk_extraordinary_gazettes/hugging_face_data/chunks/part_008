bf\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd\u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b89\u0bb3\u0bcd\u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0731\u0b9f\u0bcd\u0bb3\u0bc2\u0bb0\u0731\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf\u0b9a\u0bbf\u0bbf \u0ba4\u0bc7\u0bc7\u0bb0\u0bcd\u0ba4\u0bc7\u0bc7\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bb3\u0bcd \u0b95\u0b9f\u0bcd\u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8\u0bc8\u0b9a\u0bcd\u0b9f\u0bb3\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd 66\u0b8766\u0b87.(.(1) \u0b86\u0bae\u0bcd \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd\u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0b95\u0bc0\u0bb4\u0bbe\u0bbe\u0ba9\u0bb4\u0bbe\u0bbe\u0ba9 \u0ba8\u0bbf\u0bbf\u0baf\u0bae\u0ba9\u0b99\u0bcd\u0ba8\u0bbf\u0bbf\u0baf\u0bae\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0bbe\u0ba9\u0baa\u0bbe\u0bbe\u0ba9 \u0b85\u0bb1\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba4\u0bcd\u0b85\u0bb1\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\u0ba4\u0bb2\u0bcd\n\n\u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0721\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd I \u0b87\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba8\u0bbf\u0bbf\u0bb0\u0bcd\u0bb5\u0bbe\u0bbe\u0b95 \u0bae\u0bbe\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0721\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd II \u0b87\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0731\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf \u0b9a\u0baa\u0bc8\u0bc8, \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0731\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf \u0ba4\u0bc7\u0bc7\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd 66\u0b87.(1) \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0ba4\u0bb2\u0bcd\u0bb5\u0bb0\u0bcd, \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bbf\u0bbf \u0bae\u0bc1\u0ba4\u0bb2\u0bcd\u0bb5\u0bb0\u0bcd \u0b86\u0b95\u0bbf\u0bbf\u0baf\ufffd\u0bcb\u0bb0\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0bc6\u0bc6\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0721\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd III \u0b87\u0bb2\u0bc1\u0bae\u0bcd, \u0ba4\u0bc6\u0bc6\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1 \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0bbf\u0bbf\u0ba9\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0721\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd IV \u0b87\u0bb2\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bb5\u0bbe\u0bbe\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0baf\u0bc1\u0bae\u0bcd.\n\n\u0b9a\u0bbe\u0bbe\u0bb0\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0b95\u0bbe\u0bbe \u0b95\u0bb2\u0bcd\u0b95\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf \u0b9c\u071e\u0baf\u0b9a\u0bc1\u0ba8\u0bcd\u0ba4\u0bb0, \u0b9a\u0bbe\u0bbe\u0bb0\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0b95\u0bbe\u0bbe \u0b95\u0bb2\u0bcd\u0b95\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf \u0b9c\u071e\u0baf\u0b9a\u0bc1\u0ba8\u0bcd\u0ba4\u0bb0, \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3 \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0731\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf \u0b86\u0ba3\u0721\u0baf\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd, \u0bae\ufffd\u0bb2\u0bcd \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3\u0bae\u0bcd.\n\n\u0baa\u0ba4\u0bcd\u0ba4\u0bb0\u0bae\u0bc1\u0bb2\u0bcd\u0bb2, \u0b9f\ufffd\u0ba9\u0bcd\u0b9a\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\ufffd\u0bca\u0baa\u0bcd\u0baa\ufffd\u0b95\u0b9f\u0bc1\u0bb5 \u0bae\u0bbe\u0bbe\u0bb5\u0ba4\u0bcd\u0ba4,\u0b87\u0bb2. 204, \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3 \u0b9a\u0baa\u0bc8\u0bc8 \u0b95\u0b9f\u0bcd\u0b9f\u0b9f\u0ba4\u0bcd \u0ba4\ufffd\u0bca\u0b95\u0bc1\u0ba4\u0bbf\u0bbf,\u0bae\ufffd\u0bb2\u0bcd \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3 \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3 \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0731\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0ba3\u0721\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd,2025, \u0baf\u0bc2\u0ba9\u0bcd 16.\n\n1A - 44569 \u2014 09 (2025/06)\n\nIV ^wd& fldgi - Y%S ,xld m%cd;dka;%sl iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'06'17gFjp IV (M) - ,yq;ifr; rdehaf Nrhryprf; FbauR tu;j;jkhdg; gj;jpupif - mjp tpNr\\khdJ - 2025.06.172A\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0721 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0721"
