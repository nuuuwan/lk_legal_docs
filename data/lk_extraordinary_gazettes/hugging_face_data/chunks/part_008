b6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\n1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dad 14 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca\u0dd9\u0d9c\u0dca \u0dad\u0dd3\u0dbb\u0dab \u0db4\u0d9a\u0dcf\u0dc1\u0dba \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0db4\u0dc5\u0dcf\u0dd9\u0dad\u0dca \u0dc4\u0db8\u0dca\u0db6\u0db1\u0dca\u0dd9\u0dad\u0ddc\u0da7 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca \u0dbd\u0dd4\u0db1\u0dd4\u0d9c\u0db8\u0dca\u0dd9\u0dc0\u0dd9\u0dc4\u0dbb \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca \u0d85\u0d82\u0d9a 77 - \u0dc3\u0dcf\u0dbd\u0dd2\u0dba\u0db4\u0dd4\u0dbb \u0d9c\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba \u0dad\u0dd4\u0dc5 \u0d9a\u0dd4\u0da9\u0dcf \u0d9c\u0db8\u0dca\u0db8\u0dcf\u0db1 06 \u0db1\u0db8\u0dd0\u0dad\u0dd2 \u0d9c\u0dd9\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf \u0dc0\u0dd6 \u0daf, \u0d85\u0d82\u0d9a 830062 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0dd9\u0db8\u0dca \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 1 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 6 : 1 \u0dc3\u0dc4 7 : 2 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u0db8\u0dca\n\n6 A III \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 - \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba - 2025.06.11\n\n\u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0dd9\u0dbd\u0dc3 \u0dd9\u0db4\u0db1\u0dca\u0db1\u0dd4\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7 \u0d87\u0dad\u0dca\u0dad\u0dcf \u0dc0\u0dd6 \u0daf, \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dd1\u0db8\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dd9\u0dbd\u0dc3 \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0dd9\u0daf\u0db8\u0dd2\u0db1\u0dca 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dd9\u0dad\u0dca 12 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db4\u0d9a\u0dcf\u0dbb 2009.04.27 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d9a 1599/09 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dd9\u0dba\u0dca \u0dba\u0dae\u0dcf \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db4\u0dc5\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a 83/0009 \u0daf\u0dbb\u0db1 \u0daf\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0dd9\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dd9\u0d9a\u0ddc\u0da7 \u0d87\u0dad\u0dca\u0dad\u0dcf \u0dc0\u0dd6 \u0daf, \u0d89\u0da9\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0dca\u0dc0\u0dbd \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd9\u0dba\u0db1\u0dca \u0dd9\u0db8\u0dc4\u0dd2 \u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dd9\u0dba\u0dca \u0daf\u0dd0\u0d9a\u0dca\u0dd9\u0dc0\u0db1 \u0db8\u0dcf\u0dd9\u0d9c\u0dca \u0dad\u0dd3\u0dbb\u0dab 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dd9\u0dad\u0dca 14 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dd9\u0dba\u0db1\u0dca \u0db4\u0dc4\u0dad \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dc0\u0dbb\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0d9a\u0dcf\u0dbb, \u0db8\u0db8 \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dca \u0db4\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u0db8\u0dd2. \u0db4\u0dd3. \u0dc3\u0dd3. \u0da9\u0dd3. \u0dc3\u0dd2\u0dd9\u0d9c\u0dca\u0dbb\u0dcf, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca. 2025 \u0d85\u0dd9\u0db4\u0dda\u0dbd\u0dca \u0db8\u0dc3 21 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0dbb\u0da2\u0db8\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dcf\u0dbb, \"\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dad \u0db8\u0dd0\u0daf\u0dd4\u0dbb\", \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dd9\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca \u0daf\u0dd3 \u0dba."
