a7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5902 \u0dc3\u0dc4 5900.\n\n61. \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5902 \u2013 \u0daf\u0dd4\u0d82\u0d82\u0d9a\u0dbd\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba \u2013 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba:\u0dc4\u0dd9\ufffd\u0d9a\u0dca. 61. \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5902 \u2013 \u0daf\u0dd4\u0d82\u0d82\u0d9a\u0dbd\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba \u2013 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba:\u0dc4\u0dd9\ufffd\u0d9a\u0dca. 0.30700.3070 \u0d8b\u0dad\u0dd4\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5905, 5899, 5900 \u0dc3\u0dc4 5901;\n\n\u0db1\u0dd0\u200d\u200d\ufffd\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5901, 5893, 5892, 5891 \u0dc3\u0dc4 3161; \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 3161 \u0dc3\u0dc4 3157; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 3157, 5906 \u0dc3\u0dc4 5905.\n\n62. \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5903 \u2013 \u0daf\u0dd4\u0d82\u0d82\u0d9a\u0dbd\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba \u2013 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba: 62. \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5903 \u2013 \u0daf\u0dd4\u0d82\u0d82\u0d9a\u0dbd\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba \u2013 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba: \u0dc4\u0dd9\ufffd\u0d9a\u0dca. 0.0072\u0dc4\u0dd9\ufffd\u0d9a\u0dca. 0.0072 \u0d8b\u0dad\u0dd4\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5904; \u0db1\u0dd0\u200d\u200d\ufffd\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5897; \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5897 \u0dc3\u0dc4 1827; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5904.\n\n63. \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5905 \u2013 \u0daf\u0dd4\u0d82\u0d82\u0d9a\u0dbd\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba \u2013 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba: 63. \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5905 \u2013 \u0daf\u0dd4\u0d82\u0d82\u0d9a\u0dbd\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba \u2013 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba: \u0dc4\u0dd9\ufffd\u0d9a\u0dca. 0.0233\u0dc4\u0dd9\ufffd\u0d9a\u0dca. 0.0233 \u0d8b\u0dad\u0dd4\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 1827, 5897 \u0dc3\u0dc4 5899; \u0db1\u0dd0\u200d\u200d\ufffd\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5899 \u0dc3\u0dc4 5902; \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5902; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5906 \u0dc3\u0dc4 5907.\n\n64. \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5906 \u2013 \u0daf\u0db9\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba \u2013 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba:\u0dc4\u0dd9\ufffd\u0d9a\u0dca. 0.034364. \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5906 \u2013 \u0daf\u0db9\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba \u2013 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba:\u0dc4\u0dd9\ufffd\u0d9a\u0dca. 0.0343 \u0d8b\u0dad\u0dd4\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5905 \u0dc3\u0dc4 5899; \u0db1\u0dd0\u200d\u200d\ufffd\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5902; \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5902, 3157 \u0dc3\u0dc4 5907; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5907.\n\n65. \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5908 \u2013 \u0daf\u0dd4\u0d82\u0d82\u0d9a\u0dbd\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba \u2013 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba: 65. \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5908 \u2013 \u0daf\u0dd4\u0d82\u0d82\u0d9a\u0dbd\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba \u2013 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba: \u0dc4\u0dd9\ufffd\u0d9a\u0dca. 0.5287\u0dc4\u0dd9\ufffd\u0d9a\u0dca. 0.5287 \u0d8b\u0dad\u0dd4\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5910, 3161 \u0dc3\u0dc4 5906; \u0db1\u0dd0\u200d\u200d\ufffd\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 3161; \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5913 \u0dc3\u0dc4 5911; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 5911 \u0dc3\u0dc4 5910."
