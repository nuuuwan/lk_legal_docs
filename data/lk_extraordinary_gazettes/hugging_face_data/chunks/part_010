a9\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\n\n\u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0b9a\u0baa\u0bc8 \u0baa\u0bc6\u0baf\u0bb0\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0b9a\u0baa\u0bc8 \u0baa\u0bc6\u0baf\u0bb0\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n\u0ba8\u0bc1\u0bb5\u0bb0\u0bc6\u0bb2\u0bbf\u0baf\u0bbe\u0ba8\u0bc1\u0bb5\u0bb0\u0bc6\u0bb2\u0bbf\u0baf\u0bbe \u0ba4\u0bb2\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bb2\u0bc8 1 \u0bb9\ufffd\u0bca\u0bb2\u0bbf\u0bb1\u0bc2\u0b9f\u0bcd \u0b9a\u0bbf\u0bb5\u0ba9\u0bc8\u0baf\u0bbe \u0b9a\u0bbf\u0bb5\u0bb0\u0bbe\u0b9c\u0bcd (\u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf) \u0bb2\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1\u0bb2 \u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8 2 \u0ba4\u0bb2\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bb2\u0bc8 \u0ba4\u0bbe\u0bb2\u0bae\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b9a\u0bc1\u0ba4\u0bbe\u0b95\u0bb0\u0bcd 3 \u0ba4\u0bb2\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bb2\u0bc8 \u0ba4\u0bc6\u0bb1\u0bcd\u0b95\u0bc1 * \u0ba8\u0bc6\u0bb2\u0bc6\u0ba9\u0bcd\u0ba4\u0bbf\u0b95\u0bc7 \u0bb0\u0b99\u0bcd\u0b95\u0bb7\u0bbe\u0ba9\u0bcd \u0bae\u0ba4\u0bc1\u0b9a\u0b99\u0bcd\u0b95 \u0baa\u0bbf\u0bb9\u0bb5\u0bb2 \u0b95\u0bbe\u0bb0\u0bbf\u0baf\u0bb5\u0b9a\u0bae\u0bcd \u0bae\u0bbe\u0ba9\u0b95\u0bc7 \u0ba4\u0bb0\u0bbf\u0ba9\u0bbf \u0ba8\u0bb5\ufffd\u0bcb\u0ba4\u0bbe 4 \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0baa\u0bb9\u0bb2 \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9\u0b95\u0bc7 \u0b87\u0bb7\u0bbe\u0bb0 \u0b85\u0ba9\u0bc1\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4 \u0bae\u0b9e\u0bcd\u0b9a\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 5 \u0bb2\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1\u0bb2\u0bc8 * \u0bae\u0bb2\u0bbf\u0ba4\u0bc1\u0bb5 \u0bb2\u0bbf\u0baf\u0ba9\u0b95\u0bc7 \u0b89\u