dbb\u0dad\u0dca\u0db102 \u0d9a\u0dd2\u0dbb\u0dd2\u0dc0\u0dd0\u0dd0\u0dbd\u0dca\u0daf\u0ddc\ufffd\u0ddc\u0dbd\u0d9c\u0da2\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dbd\u0dd2\u0d9c\u0dda\u0118 \u0db8\u0dbd\u0dd2\u0db1\u0dca\u0daf \u0da0\u0dcf\u0dcf\u0db1\u0d9a03 \u0d9a\u0db1\u0dca\u0daf\u0dd2\u0dbd\u0dca\u0db4\u0dcf\u0dcf\u0db1\u0dbb\u0dad\u0dca\u0db1\u0db8\u0dca \u0db4\u0dd4\u0db1\u0dca\u0db1\u0dd2\u0dba\u0db8\u0dd6\u0dbb\u0dca\u0dad\u0dd204 \u0dad\u0dd0\u0dd0\u0db1\u0dd2\u0db4\u0dd2\u0da7*\u0dbb\u0db1\u0dca\u0d9a\u0da9\u0dd4 \u0db4\u0da7\u0dca\u0da7\u0dbd\u0d9c\u0dda\u0118 \u0db4\u0dda\u0dda\u0db8\u0dbb\u0dad\u0dca\u0db1 \u0d9a\u0daf\u0dd2\u0dbb\u0dda\u0dda\u0dc2\u0db1\u0dca \u0d9a\u0db1\u0dca\u0db1\u0db1\u0dca05 \u0daf\u0dd9\u0dd9\u0db1\u0dd2\u0dba\u0dcf\u0dcf\u0dba\u0db8\u0dc4 \u0d9a\u0dd4\u0db9\u0dd4\u0dbb\u0d9c\u0dda\u0118 \u0dc3\u0db8\u0dd3\u0dbb \u0dc4\u0dbb\u0dca\u0dc2\u0db1\u0dcf\u0dcf\u0dad\u0dca06 \u0db4\u0dbd\u0dca\u0dbd\u0dd9\ufffd\u0d9c\u0db8\u0dc4\u0dda\ufffd\u0dda\u0db1\u0dd9\ufffd\u0d9c\u0db8 \u0dbd\u0dd2\u0dba\u0db1\u0d9c\u0dda\u0118 \u0daf\u0dd4\u0db8\u0dd2\u0db1\u0dca\u0daf \u0dc3\u0d82\u0d82\u0da2\u0dd3\u0dc0 \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb07 \u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0dc0\u0dd9\u0dd9\u0dab\u0dd2\u0d9c\u0db8\u0dc0\u0dad\u0dd4\u0dbb\u0dcf\u0dcf\u0dc0 \u0db8\u0dcf\u0dcf\u0db1\u0d9c\u0dda\u0118 \u0d85\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0d9a \u0d85\u0db8\u0dbb\u0dc3\u0dd2\u0dbb\u0dd208 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0db4\u0ddc\ufffd\u0ddc\u0dbd \u0d8b\u0dad\u0dd4\u0dbb\u0da0\u0db8\u0dd2\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0d82\u0d82\u0dc4 \u0d9c\u0dd4\u0dab\u0dc3\u0dda\ufffd\u0dda\u0d9a\u0dbb09 \u0d89\u0dbd\u0dd4\u0d9a\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba\u0db8\u0ddc\ufffd\u0ddc\u0dbd\u0ddc\ufffd\u0ddc\u0d9c\u0dca\u0d9c\u0db8\u0dd4\u0dc0 \u0dc4\u0dd9\ufffd\u0da7\u0dca\u0da7\u0dd2\u0d9c\u0dda\u0118 \u0d85\u0dba\u0dda\u024f\u0dc2\u0dcf\u0dcf \u0daf\u0dd2\u0dbd\u0dca\u0dc4\u0dcf\u0dcf\u0db1\u0dd210 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0db4\u0ddc\ufffd\u0ddc\u0dbd \u0daf\u0d9a\u0dd4\u0dab\u0d9c\u0dcf\u0dcf\u0db8\u0dd2\u0dab\u0dd2 \u0dc0\u0dd3\u0dbb\u0dc3\u0dda\ufffd\u0dda\u0d9a\u0dbb11 \u0dc0\u0dbb\u0dbd\u0dca\u0dbd\u0dc0\u0dda\u0dda\u0dbb\u0d9c\u0ddc\ufffd\u0ddc\u0da9 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda\u0118 \u0db1\u0dd2\u0dc4\u0dcf\u0dcf\u0dbd\u0dca \u0d85\u0da2\u0dd2\u0dad\u0dca12 \u0db8\u0ddc\ufffd\u0ddc\u0dbb\u0dc0\u0d9a\u0dc4\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0daf\u0dd4 \u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0dd0\u0dd0\u0dbd\u0dca\u0dbd\u0d9c\u0dda\u0118 \u0d86\u0dbb\u0dd2\u0dba\u0daf\u0dcf\u0dcf\u0dc313 \u0dc4\u0ddc\ufffd\u0ddc\u0dbb\u0d9c\u0dbd\u0da2\u0dcf\u0dcf\u0dad\u0dd4\u0d82\u0d82\u0d9c\u0dda\u0118 \u0db1\u0dd2\u0db8\u0dbd \u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0d91\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0d9a\u0ddd\ufffd\u0ddd\ufffd\u0da7\u0dca\u0da7\u0dda\ufffd \u0d9a\u0db1\u0dca\u0d9a\u0dcf\u0dcf\u0db1\u0db1\u0dca\u0d9c\u0dda\u0118 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0dcf\u0daf\u0dca\u0db8\u0dcf\u0dcf\u0dba\u0dcf\u0dcf\u0db1\u0dca\u0da9\u0dd2 \u0dbb\u0dc0\u0dd3\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0db1\u0dba\u0db1\u0dcf\u0dcf \u0daf\u0dc5\u0dd4\u0dc0\u0dad\u0dca\u0dad\u0dc3\u0dd4\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf \u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a\u0d9a\u0dbd\u0dd4\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9c\u0dda\u0118 \u0db8\u0dc4\u0dd2\u0db1\u0dca\u0daf\u0dbb\u0dad\u0dca\u0db1\u0d9c\u0dd2\u0d82\u0d82\u0dad\u0ddc\ufffd\u0ddc\u0da7 \u0dc0\u0dd2\u0dad\u0dcf\u0dcf\u0dbb\u0dab\u0d9c\u0dda\u0118 \u0da0\u0db8\u0dca\u0dbd\u0dd2 \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf\u0dcf\u0dc0\u0dbd\u0dca\u0db4\u0dd2\u0da7 \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0d9c\u0dda\u0118 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0dad\u0db4\u0dca\u200d\u0dbb\u0dd0\u0dd0\u0db1\u0dca\u0dc3\u0dd2\u0dc3\u0dca\u0d9a\u0dd4 \u0db6\u0daf\u0dd4\u0d9c\u0dda\u0118 \u0db1\u0dd2\u0dc4\u0dcf\u0dcf\u0dbd\u0dca \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf\u0dcf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0da2\u0dba\u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbb\u0dd4\u0db6\u0dc3\u0dd2\u0d82\u0d82 \u0d9c\u0db8\u0d9c\u0dda\u0118 \u0db8\u0dc4\u0dda\ufffd\u0dda\u0dc2\u0dd2\u0d9a\u0dcf\u0dcf \u0d8b\u0daf\u0dba\u0d82\u0d82\u0d9c\u0db1\u0dd3\u0dbb\u0dcf\u0dcf\u0da2\u0dda\u0dda\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0db1\u0dca \u0dc2\u0dc1\u0dd2\n\n\u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0db4\u0ddc\ufffd\u0ddc\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0"
