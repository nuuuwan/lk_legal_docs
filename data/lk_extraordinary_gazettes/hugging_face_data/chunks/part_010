\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb \u0da90\u0da9400\u0da90\u0da96 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d9a\u0d82\u0d9a \u0da937300\u0dd3 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda \u0dba\u0dae\u0dcf \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db4\u0dc5\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u0d82\u0d9a 810034\u0da9 \u0daf\u0dbb\u0db1 \u0daf\u0dd0\u0dca\u0dad\u0dc0\u0dd3\u0dba\u0db8\u0dca \u0dc3\u0db3 \u0dca\u0dad \u0dba\u0d9a\u0ddc\u0da7 \u0dca\u0dda\u0dcf\u0dcf \u0dc0\u0dd6 \u0daf, \u0d89\u0da9\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dc3\u0dca\u0dc0\u0dbd \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0db6\u0dca\u0dad \u0dba\u0dba\u0dca\u0dad \u0dba\u0db8\u0dc4\u0dd2 \u0d8b\u0db4\u0dba\u0dbd\u0dca\u0d9b\u0db1\u0dba\u0dda \u0daf\u0dd0\u0d9a\u0dca\u0d9a\u0dba\u0dba\u0dc0\u0db1 \u0db8\u0dcf\u0dba\u0dda \u0dad\u0dd3\u0dbb\u0dab 1998 \u0d9a\u0d82\u0d9a \u0da91 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0db4\u0db1\u0dba\u0dda 14 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba\u0dba\u0dca\u0dad \u0db4 \u0dcf \u0d9a\u0dda\u0dc3\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0db8\u0dcf \u0dba\u0dc0\u0dcf \u0db4\u0dc0\u0dbb\u0dcf \u0dca\u0dad\u0dd2 \u0db6\u0dbd\u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb, \u0db8\u0db8 \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dba \u0d9a\u0dbb\u0db8\u0dd20 \u0db4\u0dd3. \u0dc3\u0dd3. \u0da9\u0dd3. \u0dc3\u0dd2\u0dc1\u0dda\u0dbb\u0dcf, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dbd\u0dca0\n\n\u0da90\u0da9\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0dc5 \u0db8\u0dc3 19 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0dbb\u0da2\u0dcf\u0db8\u0dbd\u0dca\u0dc0\u0dda\u0dcf \u0db4\u0dcf\u0dbb, \"\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dcf \u0db8\u0dd0\u0daf\u0dd4\u0dbb\", \u0d9a\u0d82\u0d9a 1\u0da90006, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dba\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dcf\u0dba\u0db8\u0dca\u0dca\u0dad\u0dc5 \u0dba\u0dda \u0daf\u0dd3 \u0dba0\n\n\u0d8b\u0db4\u0dc1\u0dda\u0d9b\u0db1\u0dba\n\n\u0dc0\u0dd2\u0db1\u0dd2\u0dba\u0dca\u0da0\u0dba\u0dca\u0dad \u0dc3 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dba\u0dba\u0dda\u0dc2 \u0dba \u0ddd \u0db4\u0dad\u0dca\u200d\u0dbb \u0d9a\u0d82\u0d9a\u0dba \u0d89\u0dca\u0dad\u0dba\u0da2\u0dcf\u0dca\u0dad\u0dc2\u0dca\u0dad \u0dcf \u0db1\u0db8\u0dca \u0dba\u0db4\u0dde\u0dca\u0db0\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3 \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dba\u0dcf\u0dbd\u0dda\u0dc0\u0dba \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dba\u0dda0\u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0dca\u0dad\u0dba\u0dda \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d9a\u0dba\u0dd2\u0dad\u0dd2 \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0dda \u0d9a\u0dba\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dcf\u0dba\u0dc0\u0dca\u0dad \u0dca\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dda \u0dba\u0d9a\u0ddc\u0da7\u0dba\u0dc3\u0dda \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db1\u0db80\u0db1\u0db8\u0dca \u0dc3 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db4\u0dda \u0d89\u0da9\u0dba\u0db8\u0dca \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dc3 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dca \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0d82\u0d9a\u0dba \u0d9a\u0d82\u0d9a\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u