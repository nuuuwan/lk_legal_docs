    "chunk_text": "\u0dad\ufffd\u0ddd\ufffd\u0dbb\u0dcf \u0d91\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0db8\u0dd2\u0daf\u0dd2\u0d9c\u0dc3\u0dca\u0db4\u0d9c\u0dd9 \u0daf\u0dba\u0dcf\u0dbb\u0dad\u0dca\u0db1 \u0d85\u0dc1\ufffd\u0ddd\ufffd\u0d9a \u0d91\u0daf\u0dd2\u0dbb\u0dd2\u0dc3\u0dd2\u0d82\u0dc4 \u0d85\u0db3\u0dd4\u0dbb\u0dad\u0dca\u0dc0\u0dd2\u0dbd \u0da0\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0da2\ufffd\u0ddc\u0dca\u0dad\u0dd2 \u0dc4\u0dd2\u0db8\u0dd2 \u0d9a\u0d82\u0d9a\u0dcf\u0db1\u0dd2 \u0d9c\u0db8\u0d9c\u0dda \u0daf\u0dd4\u0db8\u0dd2\u0db1\u0dca\u0daf \u0dbd\u0dbd\u0dd2\u0dad\u0dca \u0daf\u0dba\u0dcf\u0d9a\u0dcf\u0db1\u0dca\u0dad \u0dc3\u0dd9\u0db1\u0dd9\u0dc0\u0dd2\u0dbb\u0dad\u0dca\u0db1 \u0dc3\u0dd9\u0dad\u0dd2\u0db1\u0dd2 \u0daf\u0dc4\u0db8\u0dca\u0dc3\u0dcf \u0da2\u0dba\u0dc3\ufffd\u0dda\u0d9a\u0dbb \u0d86\u0db1\u0db1\u0dca\u0daf\u0d9c\u02c3\u0ddc\u0da9\u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dbb\u0dca\u0dc1\u0dd2 \u0dbb\u0db1\u0dca\u0db8\u0dbd\u0dd3 \u0dad\u0dbd\u0dca\u0db4\u0dd9 \u0dbd\u0dd2\u0dba\u0db1\u0d9c\u0dda \u0dc3\u0db8\u0db1\u0dca \u0da0\u0dd2\u0db1\u0dca\u0dad\u0d9a \u0d85\u0db8\u0dbd\u0dca \u0d89\u0db1\u0dca\u0daf\u0dd2\u0d9a \u0d8b\u0da9\u0dc0\u0dad\u0dca\u0dad \u0dc3\u0dd2\u0dba\u0dad\u0dca \u0dc3\u0dd2\u0d82\u0da4\u02cb\u0ddd\ufffd \u0db4\ufffd\u0ddc\u0dbd\u0dca\u0d9c\u0dc4\u0db8\u0dd4\u0dbd\u0dca\u0dbd\u0dd9 \u0d9c\u0db8\u0d9c\u0dda \u0d8b\u0daf\u0dcf\u0dbb \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0db8\u0dca \u0db6\u0da7\u0dd4\u0dc0\u0dad\u0dca\u0dad \u0d9c\u0db8\u0d9c\u0dda \u0d85\u0db1\u0dd4\u0dbb \u0dad\ufffd\u0ddd\ufffd\u0dbb\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0dad\ufffd\u0ddd\ufffd\u0dbb\u0dcf \u0d91\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0d9c\u0dcf\u0dbd\u0dca\u0dbd (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0db