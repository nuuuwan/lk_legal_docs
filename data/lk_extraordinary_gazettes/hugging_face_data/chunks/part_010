0b95\u0bc1 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0ba4\u0731\u0bb3\u0bcd \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd \u0736\u0b9a\u0731\u0ba8\u0bcd\u0ba4\u0b95\u0bcd\u0b95\u0731\u0bb0\u0bb0\u0bcd/ \u0736\u0b9a\u0731\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0737\u0ba4\u0b9a\u0732\u0baf \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0731\u0732\u0baf \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0ba4\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba9\u0732\u0baf\u0731\u0bb0\u0bc1\u0b95\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0731\u0bb0\u0bb0\u0bcd\u0b95\u0bb3\u0732\u0ba9\u0bcd \u0bae\u0bc1\u0bb4\u0bc1\u0baa\u0bcd \u0736\u0baa\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b85\u0738\u0b9f\u0baf\u0731\u0bb3 \u0b87\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bae\u0bcd \u0b88\u0b9f\u0bc1, \u0b95\u0bc1\u0ba4\u0bcd \u0b95\u0bc1\u0731\u0732\u0baf \u0b9a\u0b9f\u0bcd\u0b9f\u0b99\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd (\u0736\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0731\u0bb0\u0bcd) \u0bae\u0bc1\u0b95\u0bb5\u0731\u0732\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0738\u0b9f \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd \u0b87\u0baf\u0bb2\u0bcd\u0baa\u0bc1\u0bae\u0bcd \u0ba4\u0738\u0b95 \u0b95\u0bb3\u0bc1\u0bb3\u0bcd \u0b8e\u0bb5\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0b87\u0bb2. \u0ba4\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd \u0bb5\u0738\u0b95\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b87\u0bb2. \u0b95\u0b9f\u0bcd\u0b9f\u0738\u0bb3 \u0b85\u0738\u0bae\u0ba8\u0bcd\u0ba4\u0732\u0bb0\u0bc1\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0732\u0baf \u0baa\u0732\u0ba9\u0bcd \u0bb5\u0732\u0baa\u0bb0\u0b99\u0bcd \u0bb5\u0732\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bb3\u0bcd\n\n1:325 0.7024 \u0ba8\u0731\u0b95\u0bb2\u0bbf\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0737\u0b9c\u0731\u0b9a\u0baa\u0bcd \u0bb5\u0731\u0bb8\u0bcd \u0bb0\u0b9c\u0732\u0ba8\u0bcd\u0ba4\u