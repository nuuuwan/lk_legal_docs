    "chunk_text": "\u0dc4\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0db6\u0db9\u0dbb\u0dd0\u0db1\u0dca\u0daf\u0d9c\u0dda\u0118 \u0dbd\u0dc3\u0db1\u0dca\u0dad \u0dc3\u0d82\u0d82\u0da2\u0dd3\u0dc0\u0d9c\u0dbd\u0db8\u0dd4\u0dbd \u0dc4\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dc3\u0dd4\u0da2\u0dd2\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0dad\u0d9a\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0db1\u0db8\u0dca \u0d9c\u0db8\u0d9c\u0dda\u0118 \u0d85\u0dbb\u0ddd\ufffd\u0ddd\ufffd\u0dc2\u0dcf\u0dcf \u0daf\u0dd2\u0dbd\u0dca\u0db8\u0dd2\u0db1\u0dd2\u0dbd\u0dc4\u0db3\u0db4\u0dd4\u0dbb\u0d9c\u0dda\u0118 \u0d9a\u0ddd\ufffd\u0ddd\ufffd\u0dc3\u0dbd\u0dcf\u0dcf \u0db1\u0dd2\u0dbb\u0ddd\ufffd\u0ddd\ufffd\u0dc2\u0db1\u0dd3\u0dc4\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0db4\u0dad\u0dca\u0dad\u0dd2\u0db1\u0dd2\u0d9c\u0dda\u0118 \u0dc3\u0dd4\u0dc3\u0dd2\u0dbd\u0dca \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0dad\u0dd2\u0dbd\u0d9a\u0dc4\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0dbd\u0dd4\u0dab\u0dd4\u0dc0\u0dd2\u0dbd\u0d9c\u0dda\u0118 \u0d85\u0db8\u0dd2\u0dbd \u0d85\u0dc3\u0d82\u0d82\u0d9a\u0dbb\u0dcf\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda\u0118 \u0dc3\u0dbb\u0dad\u0dca\n\n\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0db4\u0dbd\u0dcf\u0dcf\u0dc4\u0dd0\u0dd0\u0db1\u0dca\u0db1\u0daf\u0dd2 \u0dc4\u0dda\ufffd\u0dda\u0dc0\u0d9c\u0dda\u0118 \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dbb\u0dad\u0dca\u0db1 \u0d86\u0dc1\u0dcf\u0dcf \u0daf\u0dd3\u0db4\u0dca\u0dad\u0dd2\u0d85\u0d9c\u0db8\u0dca\u0db4\u0ddc\ufffd\u0ddc\u0da9\u0dd2 \u0da2\u0d9c\u0dad\u0dca \u0d86\u0dbb\u0dd2\u0dba\u0dad\u0dd2\u0dbd\u0d9a\n\n\u0daf\u0dd9\u0dd9\u0dc0\u0dd2\u0db1\u0dd4\u0dc0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\n\n\u0dad\u0dd2\u0dc4\u0d9c\u0ddc\ufffd\u0ddc\u0da9 \u0db4\u0dca\u200d\u0dbb\u