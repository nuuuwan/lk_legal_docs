    "chunk_text": "\u0ba4\u0bb5\u0bb2\u0bae 01 \u0b8e\u0bb2 \u0b87\u0bb9\u0bb2 \u0ba8\u0bbe\u0ba9\u0bbe\u0baf\u0b95\u0bcd\u0b95\u0bbe\u0bb0 \u0b9c\u0bbe\u0b95\ufffd\u0bca\u0b9f\u0b95\u0bc7 \u0ba8\u0bbf\u0bb7\u0bbe\u0ba8\u0bcd\u0ba4 \u0baa\u0bbf\u200e\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8 02 \u0bb9\u0baa\u0bb0\u0b95\u0b9f \u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bc1 \u0b9a\u0bbe\u0b9e\u0bcd\u0b9a\u0bbf\u0bb9\u0bbe\u0bae\u0bbf\u0bb2\u0bbe\u0b95\u0bc7 \u0ba4\u0bc7\u0bb7\u0bbe\u0ba9\u0bcd \u0bae\u0ba4\u0bc1\u0b9a\u0b99\u0bcd\u0b95 03 \u0ba4\u0bb5\u0bb2\u0bae \u0ba4\u0bbe\u0bae\u0bcd\u0bae\u0bb2 \u0bb2\u0bbf\u0baf\u0ba9\u0b95\u0bc7 \u0b9a\ufffd\u0bcb\u0bae\u0bbe \u0bb2\u0bbf\u0baf\u0ba9\u0b95\u0bc7 04 \u0bb9\u0bbf\u0ba9\u0bbf\u0ba4\u0bc1\u0bae \u0baa\ufffd\u0bcb\u0b99\u0bcd\u0b95\u0bbf\u0bb2\u0bbf\u0baf \u0b95\u0bae\u0b95\u0bc7 \u0ba4\u0bb0\u0bcd\u0bb7\u0ba9\u0bc0 \u0b9a\u0bbe\u0bb5\u0bbf\u0ba4\u0bcd\u0bb0\u0bbf 05 \u0baa\u0ba9\u0b99\u0bcd\u0b95\u0bb2 \u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bc1 \u0baa\u0bb9\u0bb2 \u0b95\u0bae\u0b95\u0bc7 \u0bb0\u0b9e\u0bcd\u0b9c\u0bbf\u0ba4\u0bcd 06 \u0ba4\u0bb2\u0b99\u0bcd\u0b95\u0bb2\u0bcd\u0bb2 \u0ba4\u0bbe\u0bae\u0bcd\u0bae\u0bb2 \u0bb2\u0bbf\u0baf\u0ba9\u0b95\u0bc7 \u0b85\u0b9c\u0bbf\u0ba4\u0bcd \u0b95\u0bc1\u0bae\u0bbe\u0bb0 07 \u0bb9\u0bb2\u0bcd\u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0b95\u0bb2 \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bc7\u0bb1\u0bcd\u0bb1\u0bae\u0bcd \u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bae\u0ba8\u0bbe\u0baf\u0b95 \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9 \u0b95\u0bbe\u0bae\u0bbf\u0ba3\u0bc0 \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9 08 \u0b93\u0baa\u0bbe\u0ba4 \u0baf\u0b9a\u0ba8\u0bcd\u0ba4 \u0b9a\u0bae\u0bc0\u0bb0 \u0b9a\u0bc7\u0ba9\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 09 \u0bb5\u0bc0\u0bb0\u0baa\u0bbe\u0ba9 \u0b85\u0baa\u0bc7\u0b95\u0bc1\u0ba9\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 \u0b95\ufffd\u0bcb\u0bb0\u0bb2\u0bc7 \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bc7 \u0b85\u0bae\u0bbf\u0bb2 10 \u0baa\u0ba9\u0b99\u0bcd\u0b95\u0bb2 \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0b95\u0bbe\u0bb0\u0bbf\u0baf\u0bb5\u0b9a\u0bae\u0bcd \u0baa\u0ba4\u0bbf\u0bb0\u0b95\u0bc7 \u0bb0\u0ba4\u0bcd\u0ba9\u0b9a\u0bbf\u0bb1\u0bbf \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba8\u0bcd\u0ba4\n\n\u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n\u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bbe\u0b95\ufffd\u0bca\u0b9f 01 \u0bae\u0bb2\u0bbe\u0bae\u0bc1\u0bb0 \u0bb5\u0bb0\u0bbe\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0b95\u0bc7 \u0b85\u0b9c\u0bbf\u0ba4\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba8\u0bcd\u0ba4 \u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8 02 \u0bae\u0bbe\u0baa\u0bb2\u0b95\u0bae \u0b95\ufffd\u0bca\u0b9f\u0b95\u0ba8\u0bcd\u0ba4 \u0b95\u0b99\u0bcd\u0b95\u0bbe\u0ba9\u0bae\u0b95\u0bc7 \u0b85\u0b9c\u0bbf\u0ba4\u0bcd \u0b95\ufffd\u0bca\u0b9f\u0b95\u0ba8\u0bcd\u0ba4 03 \u0baa\u0bb0\u0ba3\u0ba4\u0bbe\u0ba9\u0bbe\u0baf\u0bae\u0bcd\u0b95\u0bca\u0b9f \u0ba4\u0bb0\u0bcd\u0bae\u0b9a\u0bbf\u0bb1\u0bbf \u0b95\u0ba9\u0bc7\u0bb5\u0ba4\u0bcd\u0ba4 04 \u0b95\u0bae\u0bcd\u0bae\u0bc6\u0ba4\u0bcd\u0ba4\u0bc7\u0b95\ufffd\u0bca\u0b9f \u0bb0\u0bc1\u0bb5\u0ba9\u0bcd \u0bb5\u0bbf\u0b9c\u0bc7\u0b9a\u0bc7\u0b95\u0bb0 05 \u0ba8\u0bbe\u0b95\ufffd\u0bca\u0b9f \u0ba8\u0bbe\u0b95\ufffd\u0bca\u0b9f \u0b95\u0bae\u0b95\u0bc7 \u0ba4\u0bc0\u0baa\u0bcd\u0ba4\u0bbf \u0b95\u0bbe\u0b9e\u0bcd\u0b9a\u0ba9 \u0b9a\u0ba4\u0bc1\u0bb0\u0b99\u0bcd\u0b95 06 \u0b89\u0b9f\u0bc1\u0b95\u0bae \u0ba4\u0bc6\u0bb2\u0bcd\u0bb2\u0bae\u0bcd\u0baa\u0bc1\u0bb0 \u0b95\u0bae\u0b95\u0bc7 \u0b9a\u0ba9\ufffd\u0bcb\u0b9c\u0bbe \u0b9f\u0bbf\u0bb2\u0bbe\u0ba9\u0bbf 07 \u0bb9\ufffd\u0bcb\u0bae\u0ba4\ufffd\u0bca\u0bb2 \u0b93\u0baa\u0bbe\u0ba4 \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9 \u0baa\u0ba4\u0bbf\u0bb0\u0ba3\u0b95\u0bc7 \u0ba8\u0bbf\u0bb8\u0b99\u0bcd\u0b95 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0baa\u0ba4\u0bbf\u0bb0\u0ba3 08 \u0b85\u0bb2\u0bc1\u0ba4\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4 \u0ba4\u0bc0\u0baa\u0b95\ufffd\u0bca\u0b9f \u0b95\u0b99\u0bcd\u0b95\u0bbe\u0ba9\u0bae\u0bcd\u0b95\u0bc7 \u0b9a\u0bc1\u0b9a\u0ba8\u0bcd\u0ba4 \u0b9c\u0baf\u0bb2\u0ba4\u0bcd 09 \u0b95\ufffd\u0bcb\u0ba9\u0ba4\u0bc6\u0ba9\u0bbf\u0baf \u0bae\u0b99\u0bcd\u0b95\u0bb2 \u0baa\u0bbf\u0bb0\u0baa\u0bbe\u0ba4\u0bcd \u0bb9\u0bc7\u0bb5\u0bbe\u0bb5\u0bbf\u0ba4\u0bbe\u0ba9 10 \u0b89\u0b9f\u0bb2\u0bae\u0ba4\u0bcd\u0ba4 \u0b95\u0bbf\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0b9f\u0bc1\u0bb5 \u0b95\u0bae\u0b95\u0bc7 \u0b9c\u0baf\u0ba9\u0bbe\u0bae 11 \u0b95\u0bc6\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bbe\u0b95\ufffd\u0bca\u0b9f \u0bb0\u0ba3\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bc7 \u0bb0\u0b9e\u0bcd\u0b9c\u0bbf\u0ba4\u0bcd \u0bae\u0bbe\u0ba9\u0bc6\u0bb2\u0bcd 12 \u0b89\u0b9f\u0bb5\u0bc6\u0bb2\u0bbf\u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0baa\u0bb9\u0bb2 \u0b95\u0bae\u0b95\u0bc7 \u0b9a\u0bae\u0bcd\u0baa\u0ba4\u0bcd \u0b95\u0baa\u0bbf\u0bb2 13 \u0b89\u0ba9\u0ba9\u0bcd\u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0b95\ufffd\u0bca\u0b9f\u0bcd\u0b9f\u0bb2\u0bcd \u0ba4\u0bc6\u0ba3\u0bbf\u0baf\u0bc7 \u0b9f\u0bb5\u0bc1\u0ba8\u0bcd\u0ba4 \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0bbe\u0ba9\u0bcd\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0b85\u0bb0\u0bc1\u0ba9 \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0b95 \u0bb5\u0bbf\u0b9c\u0bc7\u0bb0\u0ba4\u0bcd\u0ba9 \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0 14 \u0b8a\u0bb0\u0bb2 \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9 \u0b95\u0bae\u0b95\u0bc7 \u0b9c\u0ba9\u0b95 \u0b9c\u0baf\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 15 \u0baf\u0b9f\u0bcd\u0b9f\u0bb2\u0bae\u0ba4\u0bcd\u0ba4 \u0b9c\u0bbe\u0b95\ufffd\u0bca\u0b9f \u0bb0\u0bc1\u0b9a\u0bbf\u0bb0 \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0b99\u0bcd\u0b95\u0bb0 \u0b9c\u0ba9\u0b95 \u0b95\u0bc1\u0bae\u0bbe\u0bb0\n\n\u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n\u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0b95\u0bc7 \u0bb5\u0b9a\u0ba8\u0bcd\u0ba4 \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0bb5\u0bc0\u0bb0\u0b95\u0bc1\u0ba3\u0bb0\u0ba4\u0bcd\u0ba9 \u0b9a\u0bb9\u0baa\u0ba8\u0bcd\u0ba4\u0bc1 \u0b8e\u0ba3\u0bcd\u0b9f\u0bc7\u0bb0 \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bc7 \u0bb5\u0bc6\u0bb0\u0b99\u0bcd\u0b95 \u0bb2\u0b95\u0bcd\u0bae\u0bbe\u0bb2\u0bcd \u0b9a\u0bc1\u0baa\u0bbe\u0bb7\u0bbf \u0bae\u0ba4\u0bc1\u0bae\u0bbe\u0bb2\u0bbf \u0b8f\u0b95\u0ba8\u0bbe\u0baf\u0b95 \u0ba4\u0bc6\u0bb2\u0bbf\u0b95\u0b9f \u0baa\u0bb2\u0bcd\u0bb2\u0bbf\u0baf \u0b95\u0bc1\u0bb0\u0bc1\u0b95\u0bc7 \u0b9c\u0baf \u0bb5\u0bbf\u0bb0\u0bbe\u0b9c\u0bcd \u0b95\u0bc1\u0bb0\u0bc1\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0b89\u0b9f\u0bc1\u0b95\u0bae \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9\u0b95\u0bc7 \u0ba4\u0bae\u0baf\u0ba8\u0bcd\u0ba4\u0bbf \u0bae\u0bc6\u0bb2\u0bc7\u0b95\ufffd\u0bca\u0b9f \u0b95\u0bae\u0b95\u0