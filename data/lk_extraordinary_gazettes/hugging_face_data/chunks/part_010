5\u0bcd\u0bb0\u0bae \u0ba8\u0baa\u0ba4\u0bb5 \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9\u0b95\u0bc7 \u0bb7\u0bc6\u0bb2\u0bcd\u0b9f\u0ba9\u0bcd \u0ba4\u0bb0\u0bcd\u0bae\u0b95\u0bc0\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf \u0bb9\u0bc7\u0bb5\u0bbe \u0ba4\u0bc7\u0bb5\u0b95\u0bc7 \u0ba8\u0bbf\u0bb2\u0ba8\u0bcd\u0ba4 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0bb5\u0bb2\u0bb5\u0bc6 \u0baa\u0bb2\u0bcd\u0bb2\u0bbf\u0baf\u0bc6 \u0b95\u0bc1\u0bb0\u0bc1\u0b95\u0bc7 \u0b9a\u0ba8\u0bcd\u0ba4\u0ba9 \u0b89\u0ba4\u0baf \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0b95\u0bae\u0bcd\u0bae\u0bc6\u0ba4\u0bcd\u0ba4 \u0ba4\u0ba9\u0bcd\u0b9f\u0b95\u0bcd\u0b95\u0bbe\u0bb0\u0b95\u0bc7 \u0b95\u0b9a\u0bc1\u0ba9\u0bcd \u0ba4\u0bb0\u0b99\u0bcd\u0b95 \u0b95\u0baa\u0bcd\u0baa\u0bb0\u0b95\u0bc7 \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe \u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bbf \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba4\u0bb0\u0bcd\u0bb7\u0ba9\u0bc0 \u0ba8\u0bbf\u0bb7\u0bbe\u0ba8\u0bcd\u0ba4 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0b9a\u0ba8\u0bcd\u0ba4\u0bc1\u0ba9\u0bbf \u0ba8\u0bbf\u0b9a\u0b99\u0bcd\u0b9a\u0bb2\u0bbe \u0ba8\u0bbf\u0bae\u0bbe\u0bb2\u0bcd \u0b9a\u0bc7\u0baa\u0bbe\u0bb2 \u0b85\u0bae\u0bb0\u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bae\n\n\u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bb0\u0b9c\u0bcd\u0b95\u0bae 01 \u0b8a\u0bb0\u0bb5\u0ba4\u0bcd\u0ba4 \u0ba4\u0bbf\u0bb0\u0bbf\u0bae\u0bbe\u0ba4\u0bc1\u0bb0 \u0ba8\u0bbf\u0bb9\u0bbe\u0bb2\u0bcd \u0bae\u0bc6\u0ba9\u0bcd\u0b9f\u0bbf\u0bb8\u0bcd \u0baa\u0bbf\u200e\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8 02 \u0b95\u0bc1\u0bb2\u0bc0\u0b95\ufffd\u0bca\u0b9f \u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0b95\u0bae\u0bb2\u0bcd \u0baa\u0bc6\u0bb0\u0bc7\u0bb0\u0bbe \u0bb0\u0bbe\u0b9c\u0b95\u0bb0\u0bc1\u0ba3\u0bbe 03 \u0bae\u0bbe\u0ba4\u0bae\u0bcd\u0baa\u0bbe\u0b95\u0bae \u0b95\u0bb2\u0bc1\u0b95\u0bb2 \u0ba4\u0bae\u0bbf\u0ba4\u0bcd \u0ba8\u0bbf\u0b9a\u0b99\u0bcd\u0b95 \u0ba4 \u0b9a\u0bbf\u0bb2\u0bcd\u0bb5\u0bbe 04 \u0b85\u0b95\u0bc1\u0bb0\u0bb2 \u0bb5\u0bbf\u0b9c\u0bc7\u0bae\u0bc1\u0ba9\u0bbf \u0b9c\u0ba9\u0ba9\u0bbf \u0b9a\u0bae\u0bbf\u0bb2\u0bcd\u0b95\u0bbe \u0ba4 \u0b9a\u0bbf\u0bb2\u0bcd\u0bb5\u0bbe 05 \u0b95\u0bb9\u0bb5 \u0bb5\u0bc7\u0bb0\u0b95\ufffd\u0bca\u0b9f \u0b9a\u0bc7\u0ba9\u0bbe\u0ba8\u0bbe\u0baf\u0b95 \u0baa\u0bbf\u0bb0\u0ba4\u0bc0\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba9\u0bcd \u0b95\u0bc1\u0bae\u0bbe\u0bb0 06 \u0ba4\u0bc6\u0bb2\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4 \u0ba4\u0bc1\u0baf\u0bcd\u0baf\u0bbe\u0bb9\u0ba8\u0bcd\u0ba4\u0bbf \u0baa\u0bbf\u0bb0\u0baf\u0b99\u0bcd\u0b95\u0bb0 07 \u0b95\u0bb2\u0bc1\u0baa\u0bc6 \u0ba4\u0bc7\u0bae\u0bc1\u0ba9\u0bbf \u0baa\u0bb0\u0bbe\u0b95\u0bcd\u0bb0\u0bae 08 \u0ba4\ufffd\u0bca\u0b9f\u0bcd\u0b9f\u0b95\u0bae\u0bc1\u0bb5 \u0b95\u0b99\u0bcd\u0b95\u0bbe\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bbf \u0ba4\u0bbf\u0bb8\u0bcd\u0ba9\u0bbe \u0ba4\u0bc1\u0bb7\u0bbe\u0bb0\u0bbf \u0b95\u0bc1\u0ba3\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 09 \u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0ba4\u0bae\u0bcd\u0baa\u0bc7 \u0b95\u0bbf\u0bb0\u0bbf\u0bb8\u0bcd\u0ba4\u0bcb\u0bae\u0bcd\u0baa\u0bc1 \u0bb0\u0b9c\u0bbf\u0ba4\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba8\u0bcd\u0ba4 10 \u0bae\u0bbe\u0bb5\u0b9f\u0bb5\u0bbf\u0bb2 \u0ba4\u0b9f\u0bb2\u0bcd\u0bb2\u0b95\u0bc6\u0baf\u0bbf \u0bb2\u0baf\u0ba9\u0bb2\u0bcd \u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0b9a\u0bbf\u0bb1\u0bbf 11 \u0bb9\u0bc7\u0b95\ufffd\u0bca\u0b9f \u0bae\u0bc1\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0bc1\u0bb5\u0bbe\u0ba4\u0bc1\u0bb0 \u0b9a\u0bc1\u0bae\u0ba4\u0bbf\u0baa\u0bbe\u0bb2 12 \u0bae\u0bb2\u0bbf\u0ba4\u0bc1\u0bb5 \u0bae\u0bb9 \u0b95\u0bae\u0b95\u0bc7 \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0bb5\u0ba4\u0bbf 13 \u0b95\u0ba9\u0b