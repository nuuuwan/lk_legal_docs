    "chunk_text": "(1) \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0b89\u0bc8\u0b9f, \u1f99\u1fa8 \u0b90\u0bc7\u0bb0\u0bbe\u0baa\u0bcd\u0baa\u0bbf\u0baf \u0b89\u0bc8\u0b9f, \u0b95\u0bbe\u0bb1\u0bcd\u0b9a\u0b9f\u0bcd\u0bc8\u0b9f \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b95\u1fa8\u0ba4\u0bcd\u1f90 \u0bb5\u0bc8\u0bb0 \u1f9a\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u1f90\u0ba3\u0bbf\u1f9c\u0b9f\u0ba9\u0bcd \u0b95\u0bc2\u1f8a\u0baf \u0ba8\u0bc0\u0ba3\u0bcd\u0b9f\u0bc8\u0b95 \u0b89\u0bc8\u0b9f\u0baf\u0ba3\u0bbf.(2) \u0bc6\u0baa\u0ba3\u0bcd \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0bc7\u0b9a\u0bc8\u0bb2 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc7\u0bae\u0bb2\u0bbe\u0bc8\u0b9f(3) \u0bae\u0ba4 \u0baa\u0bb4\u0b95\u0bcd\u0b95\u0bb5\u0bb4\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bae\u0bb0\u1f97\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u1f8a \u0b8f\u0bb1\u0bcd\u1fa0\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b89\u0bc8\u0b9f(4) \u0bae\u0ba4 \u0baa\u0bb4\u0b95\u0bcd\u0b95\u0bb5\u0bb4\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bae\u0bb0\u1f97\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u1f8a \u0b8f\u0bb1\u0bcd\u1fa0\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0bc8\u0bb2\u0baf\u0bbe\u0bc8\u0b9f(5) \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0baf\u0ba9\u0bcd\u0bb1 \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe \u0bc7\u0ba8\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u1fa4\u0bae\u0bcd \u0bc6\u0bb5\u0bd7\u0bbf\u0bb0\u0bcd \u0ba8\u0bbf\u0bb1 \u0b86\u0bc8\u0b9f \u0b85\u0ba3\u0bbf\u0baf \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd, \u0bc7\u0bae\u1fa4\u0bae\u0bcd \u0b87\u1f9e\u0ba3\u0bcd\u0b9f \u0ba8\u0bbf\u0bb1 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0bc7\u0b95\u0bbe\u1f8a\u0b9f\u0bcd\u0b9f \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0bc6\u0b9a\u0b95\u0bcd \u0b86\u0bc8\u0b9f\u0b95\u0bc8\u0bb3 \u0b85\u0ba3\u0bbf\u0bb5\u0bc8\u0ba4\u0ba4\u0bcd \u0ba4\u0bb5\u0bbf\u0bb0\u0bcd\u0b95\u0bcd\u0b95 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd.\n\n\u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\n\n\u1f99\u0ba9\u0bcd\u1f94\u0bbe\u0bbf\u0bc8\u0bae \u0bb5\u0bbe\u0bbf\u0bc8\u0b9a\n\n\u0b9a\u0bc8\u0baa \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b89\u0bc8\u0b9f\n\n\u0b87\u1f9e\u0b95\u0bcd\u0b95 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8a\u0baf \u0b95\u0bc1\u0bc8\u0bb1\u0ba8\u0bcd\u0ba4 \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0bc8\u0b95\n\nIV (\u0d85) \u0dd9\u0d9a\u02a3\u0da7\u0dc3 - \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba - 2025.05.30\u0baa\u0b95\u0bc1\u0ba4\u0bbf IV (\u0b85) - \u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u1f8a\u0baf\u0bb0\u0b9a\u0bc1 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 - 2025.05.306A\n\n9. (1) \u0b92\u1f9e \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b95\u0bc2\u1f8c\u0bae\u0bcd \u0bc7\u0ba8\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd 30 \u0ba8\u0bbf\u0bae\u0bbf\u0b9f\u0b99\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0bc2\u1f8a\u0baf \u0b95\u0bbe\u0bb2\u0bae\u0bcd \u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0ba9\u0bcd \u0b87\u1f9e\u0b95\u0bcd\u0b95 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8a\u0baf \u0b95\u0bc1\u0bc8\u0bb1\u0ba8\u0bcd\u0ba4 \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0bc8\u0b95 \u0b87\u0bb2\u0bcd\u0bc8\u0bb2 \u0b8e\u0ba9\u0bc7\u0bb5\u0bbe \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc7\u0bae\u0bb2\u0bcd 8 \u0bb5\u1f90 \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0bc7\u0baa\u0bbe\u0ba9\u0bcd\u1fa0 \u0b87\u1f9e\u0b95\u0bcd\u0b95 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8a\u0baf \u0b95\u0bc1\u0bc8\u0bb1\u0ba8\u0bcd\u0ba4 \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0bc8\u0b95 \u0b87\u0bb2\u0bcd\u0bc8\u0bb2 \u0b8e\u0ba9 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f \u1f99\u0ba4\u0bb2\u0bbe\u0b9a\u0ba9\u0bae\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0bb0\u0bcd \u0b8e\u0ba9\u0bbf\u0ba9\u0bcd \u0b85\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba8\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b9a\u0bc8\u0baa \u0b92\u0ba4\u0bcd\u0ba4\u0bbf \u0bc8\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd.\n\n(2) \u0ba4\u0bb5\u0bbf\u0b9a\u0bbe\u0bb3\u0bb0\u0bcd \u1f9a\u0bb2\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u1f99\u0ba4\u0bb2\u0bbe\u0bb5\u1f90 \u1f90\u0bc8\u0ba3\u0baa\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b92\u0ba4\u0bcd\u0ba4\u0bbf \u0bc8\u0bb5\u0ba4\u0bcd\u0ba4 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b92\u0ba9\u0bcd\u1fa0 \u0b85\u0baa\u0bcd\u0baa\u1f8a \u0b92\u0ba4\u0bcd\u0ba4\u0bbf \u0bc8\u0bb5\u0ba4\u0bcd\u1f90 24 \u0bae\u0ba3\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0bb3\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0b87\u1f9e\u0b95\u0bcd\u0b95 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8a\u0baf \u0b95\u0bc1\u0bc8\u0bb1\u0ba8\u0bcd\u0ba4 \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0bc8\u0b95 \u0b87\u0bb2\u0bcd\u0bc8\u0bb2 \u0b8e\u0ba9\u0bcd\u0bb1\u0bbe\u0bb2\u0bcd \u0b85\u0ba8\u0bcd\u0ba4 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0bc7\u0bb5\u1fa0 \u0b92\u1f9e \u0ba4\u0bbf\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b92\u0ba4\u0bcd\u0ba4\u0bbf \u0bc8\u0bb5\u0b95\u0bcd\u0b95 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd. \u0b85\u0baa\u0bcd\u0baa\u1f8a \u0b92\u0ba4\u0bcd\u0ba4\u0bbf \u0bc8\u0bb5\u0ba4\u0bcd\u0ba4 \u0b9a\u0bc8\u0baa \u0b92\u0ba4\u0bcd\u0ba4\u0bbf \u0bc8\u0bb5\u0ba4\u0bcd\u0ba4 \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf \u0ba8\u0bbf\u0bb0\u0bc7\u0bb2\u0bbe \u0b85\u0ba4\u0ba9\u0bcd \u0bae\u0bbf\u0b95\u0bc1\u0ba4\u0bbf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0b92\u0ba4\u0bcd\u0ba4\u0bbf \u0bc8\u0bb5\u0ba4\u0bcd\u0ba4 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b87\u1f9e\u0ba8\u0bcd\u1f90 15 \u0ba4\u0bbf\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0bae\u0bc0\u0ba3\u0bcd\u1f8c\u0bae\u0bcd \u0b85\u0bc8\u0bb4\u0b95\u0bcd\u0b95 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd.\n\n(3) \u0b87\u0ba8\u0bcd\u0ba4 \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b92\u0ba4\u0bcd\u0ba4\u0bbf \u0bc8\u0bb5\u0ba4\u0bcd\u0ba4 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b92\u0ba9\u0bcd\u1fa0 \u0bae\u0bc0\u0ba3\u0bcd\u1f8c\u0bae\u0bcd \u0b85\u0bc8\u0bb4\u0b95\u0bcd\u0b95 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u1f97 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0ba8\u0b9f\u0bbe\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0ba4\u0bbf\u0ba9\u0ba4\u0bcd\u0bc8\u0ba4\u0baf\u0ba9\u0bcd\u0bb1\u0bbf \u1f9a\u0ba9\u0bcd\u1fa0 \u0ba8\u0bbe\u0b9f\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u1f99\u0ba9\u0bcd\u0b95\u0bc2\u0b9f\u0bcd\u1f8a\u0bc7\u0baf \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd.\n\n(4) \u0b87\u0ba8\u0bcd\u0ba4 \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b92\u0ba4\u0bcd\u0ba4\u0bbf \u0bc8\u0bb5\u0ba4\u0bcd\u0ba4 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b92\u0ba9\u0bcd\u1fa0 \u0bae\u0bc0\u0ba3\u0bcd\u1f8c\u0bae\u0bcd \u0b85\u0bc8\u0bb4\u0baa\u0bcd\u0baa\u1f90 \u0bc6\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0ba9 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0ba4\u0bbf\u0bb2\u0bcd 4 \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u1f9a\u0bb2\u0bae\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0bae\u0bcd \u0b8e\u1f8c\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b9a\u0ba8\u0bcd\u0ba4\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbf\u0ba9\u0bcd\u0b85\u0b9e\u0bcd\u0b9a\u0bb2\u0bcd \u1f9a\u0bb2\u0bae\u0bcd \u0b85\u1f94\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b85\u0ba8\u0bcd\u0ba4 \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u1f9e\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b9a\u0b9f\u0bcd\u0b9f\u1f98\u0bb0\u0bcd\u0bb5\u0bae\u0bbe\u0ba9 \u0b92\u0baa\u0bcd\u0baa\u0bc8\u0b9f\u0baa\u0bcd\u1f97 \u0b8e\u0ba9 \u0b95\u1f9e\u0ba4\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd."
