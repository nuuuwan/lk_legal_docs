    "chunk_text": "\u0dc4\u0dd9\ufffd\u0db1\u0dbb\u0dad\u0dca \u0db4\u0dad\u0dd2\u0dbb\u0db1\u0dca\u0db1\u0dd0\u0dd0\u0dc4\u0dd0\u0dd0\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dc3\u0dbb\u0dad\u0dca \u0db4\u0dd4\u0dc2\u0dca\u0db4 \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb\u0db8\u0dd2\u0dbb\u0dd2\u0dc4\u0dcf\u0dcf\u0db1 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dad\u0dd2\u0dc3\u0dca\u0dc3 \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dcf\u0dba\u0d9a\u0d9a\u0dc5\u0dd4\u0dc0\u0d9c\u0dca\u0d9c\u0dbd\u0d9c\u0dda\u0118 \u0dbb\u0ddc\ufffd\u0ddc\u0dc2\u0dcf\u0dcf\u0db1\u0dd2 \u0da0\u0db1\u0dca\u0daf\u0dd2\u0db8\u0dcf\u0dcf \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0dbb\u0dad\u0dca\u0db1\u0db0\u0db1\u0dd9\ufffd\u0dc2 \u0d85\u0dbb\u0dd4\u0dab\u0da2\u0dd2\u0dad\u0dca \u0dbb\u0dcf\u0dcf\u0da2\u0db4\u0d9a\u0dca\u200d\u0dc2\u0da2\u0dba\u0db1\u0dd9\ufffd\u0dad\u0dca\u0dad\u0dd2 \u0db4\u0dad\u0dd2\u0dbb\u0db1\u0d9c\u0dda\u0118 \u0dbd\u0d9a\u0dd3 \u0dc3\u0dca\u0dc0\u0dbb\u0dca\u0dab\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0dbb\u0dad\u0dca\u0db1 \u0db4\u0dad\u0dd2\u0dbb\u0dab\u0d9c\u0dda\u0118 \u0dc3\u0db8\u0db1\u0dca\u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb\u0dd2 \u0da2\u0dba\u0dad\u0dd2\u0dbd\u0d9a\u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0db4\u0dca\u200d\u0dbb\u0dad\u0dcf\u0dcf\u0db4 \u0dbb\u0d82\u0d82\u0d9c\u0dda\u0118 \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb \u0dc0\u0db1\u0dca\u0db1\u0dd2\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0da2\u0dba\u0db8\u0dd2\u0dab\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc2\u0dcf\u0dcf\u0db1\u0dca\u0dad \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb\u0db8\u0ddc\ufffd\u0ddc\u0dc4\u0db8\u0da9\u0dca \u0d85\u0dbd\u0dd2 \u0db8\u0ddc\ufffd\u0ddc\u0dc4\u0db8\u0da9\u0dca \u0db1\u0dd2\u0dc3\u0dcf\u0dcf\u0db8\u0dca\u0db8\u0ddc\ufffd\u0ddc\u0dc4\u0ddc\ufffd\u0ddc\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0dbb\u0dc4\u0dd4\u0db8\u0dad\u0dd4\u0dbd\u0dca\u