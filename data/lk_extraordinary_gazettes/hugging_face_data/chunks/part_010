d\n\n\u0baa\u0bb9\u0bb2 \u0b95\u0bbe\u0bb2\u0bcd\u0bb2\u0b95\u0bc7 \u0ba4\u0bbf\u0bb2\u0bcd\u0bb7\u0bbe\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0baa\u0bbe\u0bb7\u0bcd\u0bb5\u0bb0\n\n13 \u0bae\u0bbe\u0bb3\u0bbf\u0b95\u0bbe\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bca\u0bb9\u0bae\u0b9f\u0bcd \u0b9a\u0bb0\u0bc2\u0b95\u0bcd \u0bae\ufffd\u0bca\u0bb9\u0bae\u0b9f\u0bcd \u0bb0\u0bbf\u0b9a\u0bbe\n\n14 \u0b95\u0bbf\u0bb0\u0bbe\u0ba9\u0bcd\u0b9f\u0bcd\u0baa\u0bbe\u0bb8\u0bcd \u0ba4\u0bc6\u0bb1\u0bcd\u0b95\u0bc1 * \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b95 \u0b85\u0b9a\u0b99\u0bcd\u0b95 \u0bae\ufffd\u0bca\u0bb0\u0bc7\u0bb0\u0bbe\n\n\u0baa\u0bbf\u0bb0\u0b9a\u0ba9\u0bcd\u0ba9 \u0bb2\u0bbf\u0baf\u0ba9 \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bc7\n\n15 \u0b95\u0bc6\u0ba4\u0bcd\u0ba4\u0bbe\u0bb0\u0bbe\u0bae\u0bc8 \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0ba4\u0bc1 \u0baf\u0bbe\u0b9a\u0bc0\u0ba9\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0ba4\u0bc1 \u0bb7\u0bbe\u0ba9\u0bbf\u0baa\u0bcd \u0bae\ufffd\u0bcc\u0bb2\u0bbe\u0ba9\u0bbe\n\n16 \u0ba8\u0bbf\u0baf\u0bc2\u0baa\u0b9a\u0bbe\u0bb0\u0bcd \u0bae\ufffd\u0bca\u0bb9\u0bae\u0b9f\u0bcd \u0b85\u0bb8\u0bcd\u0bb2\u0bbe\u0bae\u0bcd \u0bae\ufffd\u0bca\u0bb9\u0bae\u0b9f\u0bcd \u0bb7\u0bbe\u0b95\u0bc0\u0bb0\u0bcd\n\n17 \u0bae\u0b9a\u0b99\u0bcd\u0b95\u0bb8\u0bcd \u0bb5\u0bc0\u0ba4\u0bbf \u0bae\ufffd\u0bca\u0bb9\u0bae\u0b9f\u0bcd \u0ba8\u0bbe\u0b9c\u0bc0\u0bae\u0bcd \u0bae\ufffd\u0bca\u0bb9\u0bae\u0b9f\u0bcd \u0baa\u0bbe\u0baa\u0bbf\u0b95\u0bcd\n\n18 \u0b9c\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf \u0bb0\u0ba4\u0bcd\u0ba8\u0bbe\u0baf\u0b95 \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0ba4\u0bc1\u0bb7\u0bbe\u0bb0 \u0bb9\u0bc7\u0bae\u0ba8\u0bcd\u0ba4\n\n19 \u0b95\ufffd\u0bca\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0b9f\u0bc8 \u0bb5\u0bc0\u0bb0\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 \u0baa\u0ba4\u0bbf\u0bb0\u0bc6\u0ba9\u0bcd\u0ba9\u0bc6\u0bb9\u0bc6\u0bb2\u0b