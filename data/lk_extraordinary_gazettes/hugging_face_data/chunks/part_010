\u0dbd\u0db0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0db1 \u0dc4\u0dd0\u0dd0\u0da9\u0dd2\u0d9c\u0dbd\u0d9c\u0dda\u0118 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0dc3\u0da2\u0dd3\u0dc0 \u0dad\u0dd4\u0dba\u0dd2\u0dba\u0d9a\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0dad\u0dcf\u0dcf \u0dc0\u0db1 \u0db8\u0db8, \u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dc0\u0dbd 5 \u0dc0\u0db1 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca, \u0db8\u0dda\u023c \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca, \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0d9a\u0dbd\u0da7 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0dd2\u0dad \u0dc3\u0dc4 2025 \u0db8\u0dd0\u0dd0\u0dba\u0dd2 \u0db8\u0dc3 30 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 2438/47 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dbd\u0dd0\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0dbb\u0da7 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0dd2\u0dad, \u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dc0\u0dbd 4 \u0dc0\u0db1 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0db1\u0db8\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dc3\u0dc4 \u0dbd\u0dd0\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0d9c\u0dad \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dc3\u0dc4 2014 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dc3 21 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 1854/41 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dba\u0db8\u0dca \u0dc3\u0dca\u0dca\u0dc0\u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0d9a \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0db1\u0ddb\u0ddb\u0dad\u0dd2\u0d9a \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4\u0da7, \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dba\u0db8\u0d9a\u0da7 \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0d85\u0dc3\u0dca\u0dae\u0dd2\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0da7 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0 \u0dad\u0dd2\u0db6\u0dd9\ufffd\u0db1 \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dc3\u0dad\u0dd4 \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0daf\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0dc0\u0dad\u0dca\u0d9a\u0db8\u0dca \u0dc3\u0dc4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0db8\u0dda\u023c \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf \u0dc0\u0dd2\u0dbb\u0dc4\u0dd2\u0dad \u0d9a\u0dbb\u0db8\u0dd2.\n\n2012 \u0d85\u0d82\u0d82\u0d9a 1 \u0daf\u0dbb\u0db1 \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dcf\u0dad\u0dd3\u0db1\u0dca\u0d9c\u0dda\u0118 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dc0\u0dbd 5 \u0dc0\u0db1 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0dc3\u0dcf\u0dcf\u0daf\u0db1 \u0dbd\u0daf 2023 \u0da2\u0dd4\u0db1\u0dd2 \u0db8\u0dc3 10 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 2335/31 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f, 2024 \u0da2\u0dd4\u0db1\u0dd2 \u0db8\u0dc3 3 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 2387/03 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0dc3\u0dc4 2025 \u0db4\u0dd9\u0dd9\u0db6\u0dbb\u0dc0\u0dcf\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 20 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 2424/52 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd2\u0dba\u0db8, \u0d92 \u0dba\u0da7\u0dad\u0dda\ufffd \u0dc3\u0dd2\u0daf\u0dd4\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u0dd2\u0dc3\u0dd2\u0dc0\u0d9a\u0da7 \u0d85\u0d9c\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0db1\u0ddc\ufffd\u0ddc\u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0d85\u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229."
