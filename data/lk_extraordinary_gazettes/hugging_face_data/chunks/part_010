0ddc\u0dc4\u0db8\u0da9\u0dca \u0db1\u0dd2\u0dbd\u0dcf\u0db8\u0dca \u0d9a\ufffd\u0ddc\u0da7\u0dca\u0da7\u0dbd\u0dca \u0db6\u0daf\u0dca\u0daf \u0db8\u0dc4 \u0dc0\u0dd2\u0daf\u0dcf\u0db1\u0d9c\u0dda \u0da0\u0db1\u0dca\u0daf\u0db1\u0dbd\u0dcf\u0dbd\u0dca \u0dc1\u0dcf\u0dc4\u0dd4\u0dbd\u0dca \u0dc4\u0db8\u0dd3\u0da9\u0dca \u0d85\u0dc4\u0db8\u0da9\u0dca \u0d89\u0db8\u0dca\u0dbb\u0dcf\u0db1\u0dca \u0dc3\u0dd2\u0dad\u0dd4\u0db8\u0dd2\u0dab\u0dd2 \u0daf\u0d9a\u0dca\u0dc2\u0dd2\u0db1\u0dcf \u0db4\u0dad\u0dd2\u0dbb\u0db1 \u0db4\u0dd4\u0dc3\u02ea\u0dca\u0dc3\u0dda\u0dc0\u0dbd \u0dc4\ufffd\u0dda\u0dc0\u0d9c\u0dda \u0dbd\u0dc3\u0db1\u0dca\u0dad\u0dd2 \u0d9c\u0dd3\u0dad\u0dd2\u0d9a\u0dcf \u0d9a\u0dd3\u0dbb\u0dca\u0dad\u0dd2\u0dbb\u0dad\u0dca\u0db1 \u0dc4\u0dbb\u0dca\u0dc2\u0db1\u0dd3 \u0dc3\u0dd2\u0dbb\u0dd2\u0db8\u0dcf\u0db1\u0dca\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db7\u0dcf\u0dad\u0dca \u0db4\u0dd2\u0dba\u0dd4\u0dc2\u0dcf\u0db1\u0dca \u0dc3\u0dd9\u0db1\u0dd9\u0dc0\u0dd2\u0dbb\u0dad\u0dca\u0db1 \u0dad\u02d4\u0ddd\u02ea\u0dbb\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0d85\u0db8\u0dca\u0db6\u0dbd\u0db1\u0dca\u0d9c\u0ddc\u0da9 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 01 \u0d9a\u0dd9\u0dbb\u0db8\u0dd2\u0db1\u0dd2\u0dba \u0db8\u0d9c\u0d9c\u0dda \u0da0\u0db8\u0dca\u0db4\u0dcf \u0dc3\u0dd4\u0db8\u0dd4\u0daf\u0dd4 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2 02 \u0dad\u0dbd\u0dca\u0d9c\u0dc3\u02ea\u0dca\u0d9c\u0ddc\u0da9 \u0d9a\u0dc5\u0dd4\u0dc0\u0dcf \u0daf\u0dda\u0dc0 \u0dbb\u0db8\u0dda\u0dc2\u0dca \u0db0\u0db1\u0d82\u0da2\u0dba \u0da2\u0dba\u0dc3\u0dd2\u0d82\u0dc4\n\n\u0d8b\u0db4\u0dbd\u0dda\u0d9b\u0db1\u0dba\n\n\u0d9c\u0dcf\u0dbd\u0dca\u0dbd(\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\nI \u0dad\u0dd3\u0dbb\u0dd4\u0dc0 II \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\n\n\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d9a\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3 \u0d85\u0d82\u0d9a\u0dba \u0db1\u0db8 \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda \u0db1\u0db8 \u0dc3\u0dc4 \u0db1\u0db8 \u0dad\u02d4\u0ddd\u02ea\u0dbb\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\nIV^wd& jeks fldgi \u2013 YS% ,xld m%cd;dka;s%l iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025.05.313 A\n\n\u0d8b\u0db4\u0dbd\u0dda\u0d9b\u0db1\u0dba (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\n\u0d85\u0db8\u0dca\u0db6\u0dbd\u0db1\u0dca\u0d9c\u0ddc\u0da9 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 03 \u0db4\ufffd\u0ddc\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad \u0dc3\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dcf \u0db8\u0dbb\u0d9a\u0dca\u0d9a\u0dbd \u0dc3\u0dbb\u0dad\u0dca\u0da0\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2) 04 \u0d9a\u0dc5\u0dd4\u0dc0\u0da9\u0dd4\u0db8\u0dd4\u0dbd\u0dca\u0dbd \u0dc0\u0dbb\u0dca\u0dab\u0d9a\u0dd4\u0dbd\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0db1\u0dd2\u0dc1\u0dcf\u0db1\u0dca\u0dad 05 \u0db4\ufffd\u0ddd\ufffd\u0dbb\u0db9 \u0d9a\u0d82\u0d9a\u0dcf\u0dab\u0dd2\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2 \u0da9\u0dd2\u0d9a\u0dca\u0dc3\u0db1\u0dca \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf 06 \u0d9a\u0dbb\u0dd2\u0dad\u0dca\u0dad\u0d9a\u0db1\u0dca\u0daf \u0d9a\u0dd4\u0da9\u0dcf \u0dc0\u0dd2\u0daf\u0dcf\u0db1 \u0dc3\u0d82\u0d9b \u0db0\u0db1\u0d82\u0da2\u0dba 07 \u0dc4\u0dd9\u0db4\u0dca\u0db4\u0dd4\u0db8\u0dd4\u0dbd\u0dca\u0dbd \u0dc3\u0dd2\u0dc3\u0dd2\u0dbb \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbb\u0dab\u0dc3\u0dd2\u0d82\u0dc4 08 \u0db4\u0da7\u0db6\u0dd0\u0db3\u0dd2\u0db8\u0dd4\u0dbd\u0dca\u0dbd \u0dc0\u0dad\u0dd4\u0daf\u0dd4\u0dbb\u0dc4\ufffd\u0dda\u0dc0\u0dcf \u0d9c\u0dba\u0db1\u0dd2 \u0daf\u0dda\u0dc0\u0dd2\u0d9a\u0dcf 09 \u0dc0\u0dd2\u0dbd\u0dda\u0d9c\u02c3\u0ddc\u0da9 \u0dc3\u0dd9\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dbd\u0dd2\u0dba\u0db1 \u0dbb\u0dc3\u0dd3\u0db1\u0dca \u0db8\u0db1\ufffd\u0ddd\ufffd\u0da2\u0dca \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf 10 \u0dc4\u0dd2\u0dbb\u0dda\u0dc0\u0dad\u0dca\u0dad \u0db6\u0dda\u0dbb\u0dd4\u0dc0\u0dbd \u0d9a\u0db4\u0dd4\u0d9c\u0dda \u0da2\u0d9c\u0dad\u0dca \u0db1\u0dd2\u0dc1\u0dcf\u0db1\u0dca\u0dad 11 \u0db4\u0db1\u0dd2\u0dba\u0db1\u0dca\u0daf\u0dd4\u0dc0 \u0dbd\u0dd4\u0dc0\u0dd2\u0dc3\u0dca \u0dc4\u0db1\u0dca\u0db1\u0dd0\u0daf\u0dd2\u0d9c\u0dd9\u0dba\u0dd2 \u0db1\u0dd2\u0dbb\u0d82\u0da2\u0db1\u0dca \u0db4\u0dd9\u0dbb\u0dda\u0dbb\u0dcf 12 \u0db8\u0dc4 \u0d85\u0db8\u0dca\u0db6\u0dbd\u0db1\u0dca\u0d9c\u0ddc\u0da9 \u0d9c\u02c3\u0ddc\u0da9\u0dc4\ufffd\u0dda\u0dc0\u0dcf \u0d85\u0dc3\ufffd\u0dda\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db1\u0dca\u0db1\n\n\u0dad\ufffd\u0ddd\ufffd\u0dbb\u0dcf \u0d91\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0db6\u0dd9\u0db1\u0dca\u0dad\u0ddc\u0da7\u0d9c\u0dda \u0da2\u0db1\u0dd2\u0dad\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dad\u0dd2\u0dbd\u0d9a \u0db8\u0d9c\u0d9c\u0dda \u0d85\u0dad\u0dd4\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dcf\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0d9c\u0dda \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0dd2\u0d9a \u0d89\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0da2\u0dd2\u0dad\u0dca \u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0db1\u0dd2\u0db8\u0dd9\u0dbd\u0dca \u0db1\u0db8\u0dca\u0db6\u0dd2 \u0db1\u0dd2\u0db8\u0dbd\u0dca\u0d9a\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db6\ufffd\u0ddd\ufffd\u0daf\u0db1\u0dd2 \u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0db1\u0dd2\u0d9a\u0dca\u0d9a\u0dd4\u0db1\u0db8\u0dca\u0db6\u0dd2 \u0db8\u0dcf\u0dba\u0dcf \u0dc1\u0dca\u200d\u0dba\u0dcf\u0db8\u0dbd\u0dd3 \u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2\u0d9c\u0dda \u0da0\u0db8\u0dad\u0dca \u0db8\u0db0\u0dd4\u0dc1\u0d82\u0d9b \u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db4\u0dd9\u0dad\u0dca\u0dad\u0dcf \u0dba\u0daf\u0dca\u0daf\u0dd9\u0dc4\u0dd2 \u0dc4\u0dd2