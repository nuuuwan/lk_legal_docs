    "chunk_text": "(2) \u0bc7\u0bae\u1fa4\u0bb3\u0bcd\u0bb3 \u1f90\u0bc8\u0ba3\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0baa\u0bbe\u0bbf\u0ba8\u0bcd\u1f90\u0bc8\u0bb0\u0bc6\u0baf\u0bbe\u0ba9\u0bcd\u1fa0 \u0b8f\u0bb1\u0bcd\u1fa0\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c \u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b92\u1f9e \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bbe\u0bbf\u0ba9\u0bcd \u0b9a\u0bc8\u0baa \u0bc7\u0b9a\u0bc8\u0bb5\u0bc8\u0baf \u0ba8\u0bbf\u1fa0\u0ba4\u0bcd\u1f90\u0bb5\u0ba4\u0bbe\u0baf\u0bbf\u0ba9\u0bcd \u1f99\u0ba4\u0bb2\u0bcd \u0b85\u0bae\u0bb0\u0bcd\u0bb5\u0bbf\u0bc7\u0bb2 \u0b85\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbf\u1fa0\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0b92\u1f9e \u0bae\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0b95, \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bbe\u0bb5\u0ba4\u0bbe\u0b95 \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u1f8c\u0bae\u0bcd \u0ba8\u0bbf\u1fa0\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0b87\u0bb0\u0ba3\u0bcd\u1f8c \u0bae\u0bbe\u0ba4\u0b99\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0b95, \u1f9a\u0ba9\u0bcd\u0bb1\u0bbe\u0bb5\u1f90 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bc7\u0bae\u0bb2\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0ba8\u0bbf\u1fa0\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u1f9a\u0ba9\u0bcd\u1fa0 \u0bae\u0bbe\u0ba4\u0b99\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0b95 \u0b87\u1f9e\u0b95\u0bcd\u0b95 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd.\n\n(4) \u0b87\u0ba8\u0bcd\u0ba4 \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0ba9\u0bcd \u0bc7\u0b9a\u0bc8\u0bb5\u0bc8\u0baf \u0ba8\u0bbf\u1fa0\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b92\u1f9e \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b92\u0ba9\u0bcd\u1fa0 \u0bc7\u0b9a\u0bb0\u0bcd\u0ba8\u0bcd\u1f90 \u0bc6\u0b9a\u0baf\u0bb1\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bbf\u0bb2\u0bb0\u0bcd \u0b9a\u0bc8\u0baa \u0b85\u1fa4\u0bb5\u0bb2\u0b95 \u0bb5\u0bb3\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u1fa2\u1f9e\u0ba8\u0bcd\u1f90 \u0bb5\u0bbf\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f \u0ba4\u0bb5\u0bbf\u0b9a\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b9a\u0ba8\u0bcd\u0ba4\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0baa\u0bbe\u0bbf\u0ba4\u0bbf \u1f99\u0ba4\u0bb2\u0bbe\u0b9a\u0ba9\u0bae\u0bcd \u1f9a\u0bb2\u0bae\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u1f8c\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bae\u0bb5\u0bbe\u0b95 \u0ba8\u0bbf\u1fa0\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b95\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b8f\u0bc7\u0ba4\u1f94\u0bae\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b85\u1f8a\u0baa\u0bcd\u0baa\u0bc8\u0b9f\u0baf\u0bbf\u0bb2\u0bcd \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u1fa0\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd, \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u1f99\u1f8a\u1fab\u0b95\u0bb3\u0bcd \u0b85\u0baa\u0bcd\u0baa\u1f8a\u0bc7\u0baf \u0ba8\u0bc8\u0b9f\u1f99\u0bc8\u0bb1\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4 \u0bc7\u0ba4\u0bc8\u0bb5\u0baf\u0bbe\u0ba9 \u0ba8\u0b9f\u0bb5\u1f8a\u0b95\u0bcd\u0bc8\u0b95 \u0b8e\u1f8c\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bbe\u1fa0 \u0b85\u0ba8\u0bcd\u0ba4 \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u1f9e\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0bb5\u0bbf\u0b9a\u0bbe\u0bb3\u0bb0\u0bcd \u1f9a\u0bb2\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0baf\u0bbf\u0b9f \u1f99\u1f8a\u1f9c\u0bae\u0bcd.\n\n40. \u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bb3\u0bcd 38 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 39 \u0b8e\u0ba9\u0bcd\u0bb1 \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0bb5\u0bbe\u0bbf\u0bc8\u0b9a\u0baf\u0bbe\u0b95 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0ba9\u0bcd \u0b9a\u0bc8\u0baa \u0b95\u0bb0\u0bcd\u0bae\u0baa\u0bc0\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u1fa2\u1f9e\u0ba8\u0bcd\u1f90 \u0bc6\u0bb5\u0bb3\u0bbf\u0bc7\u0baf\u0bb1 \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bbf\u0b9f\u0bcd\u0b9f \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0bb2\u0bcd \u0bc7\u0b9a\u0bc8\u0bb5 \u0ba8\u0bbf\u1fa0\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0bb2\u0bcd, \u0b9a\u0bc8\u0baa \u0b95\u1f9e\u0bae \u0baa\u0bc0\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u1fa2\u1f9e\u0ba8\u0bcd\u1f90 \u0b89\u0b9f\u0bc7\u0ba9 \u0bb5\u0bbf\u0bb2\u0b95 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b85\u0baa\u0bcd\u0baa\u1f8a \u0bb5\u0bbf\u0bb2\u0b95 \u0bb5\u0bbf\u0bb2\u0bcd\u0bc8\u0bb2 \u0b8e\u0ba9\u0bcd\u0bb1\u0bbe\u0bb2\u0bcd \u0b85\u0baa\u0bcd\u0baa\u1f8a \u0bb5\u0bbf\u0bb2\u0b95 \u0bc7\u0ba4\u0bc8\u0bb5\u0baf\u0bbe\u0ba9 \u0ba8\u0bbf\u0baf\u0bbe\u0baf\u0bae\u0bbe\u0ba9 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba8\u0bc0\u0ba4\u0bbf\u0baf\u0bbe\u0ba9 \u0ba8\u0b9f\u0bb5\u1f8a\u0b95\u0bcd\u0bc8\u0b95\u0b95\u0bc8\u0bb3 \u0ba4\u0bb5\u0bbf\u0b9a\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b9a\u0ba8\u0bcd\u0ba4\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u0baa \u1f99\u0ba4\u0bb2\u0bbe\u0b9a\u0ba9\u0bae\u0bcd \u1f9a\u0bb2\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0baf\u0bbf\u0b9f \u1f99\u1f8a\u1f9c\u0bae\u0bcd.\n\n41. \u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0ba9\u0bcd \u0ba4\u0bb5\u0bbf\u0b9a\u0bbe\u0bb3\u0bb0\u0bcd, \u0baa\u0bbf\u0bb0\u0ba4\u0bbf \u0ba4\u0bb5\u0bbf\u0b9a\u0bbe\u0bb3\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0bc6\u0b9a\u1fa4\u0ba4\u0bcd\u0ba4 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8a\u0baf \u0bae\u0bbe\u0ba4\u0bbe\u0ba8\u0bcd\u0ba4 \u0bc6\u0b95\u0bbe\u1f8c\u0baa\u0bcd\u0baa\u0ba9\u1fab\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b85\u0bb3\u1fab\u0b95\u0bb3\u0bcd \u0b95\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b95\u0bbe\u0bb2\u0bae\u0bcd \u0b85\u1f90 \u0b9a\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bae\u0bbe\u0b95 \u0b85\u0bb0\u0b9a\u0bc1 \u1f9a\u0bb2\u0bae\u0bcd \u0b8e\u1f8c\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bc8\u0b95\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u1f99\u1f8a\u1fab\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bae\u0bb5\u0bbe\u0b95 \u0b87\u1f9e\u0b95\u0bcd\u0b95 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b85\u0baa\u0bcd\u0baa\u1f8a \u0bb5\u0bbf\u1f8c\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b85\u0ba4\u0bbf\u0b95\u0baa\u0b9f\u0bcd\u0b9a\u0b99\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u1f8c \u0b95\u0b9f\u0ba8\u0bcd\u0ba4 \u0bae\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0b85\u1f8c\u0ba4\u0bcd\u0ba4 \u0bae\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bc6\u0b9a\u1fa4\u0ba4\u0bcd\u0ba4 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd.\n\n42. \u0b95\u0bc0\u0bb4\u0bcd\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bb0\u0bcd\u0baa\u0bcd\u0baa \u0b95\u0bbe\u0bb0\u0ba3\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b85\u1f8a\u0baa\u0bcd\u0baa\u0bc8\u0b9f\u0baf\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b92\u1f9e \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u1f9e\u0b95\u0bcd\u0b95\u0bc1 \u0bc6\u0b95\u0bbe\u1f8c\u0baa\u0bcd\u0baa\u0ba9\u1fab \u0b9a\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bae\u0bbe\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0b95\u0bb3\u0bcd \u0b87\u0bb2\u0bcd\u0bb2\u0bbe\u0bae\u0bb2\u0bcd \u0b87\u1f9e\u0b95\u0bcd\u0b95 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd.\n\n(1) \u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bb3\u0bcd 39 \u0b95\u0bc0\u0bb4\u0bcd \u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0ba9\u0bcd \u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0ba9\u0bcd \u0ba8\u0b9f\u0bb5\u1f8a\u0b95\u0bcd\u0bc8\u0b95\u0b95\u0bb3\u0bcd \u0b87\u0bc8\u0b9f\u0ba8\u0bbf\u1fa0\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bae\u0bbe\u0b95 \u0b85\u0baa\u0bcd\u0baa\u1f8a \u0b87\u0bc8\u0b9f\u0ba8\u0bbf\u1fa0\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0b95\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0b95.\n\n(2) \u0b8f\u0bc7\u0ba4\u1f94\u0bae\u0bcd \u0b95\u0bc1\u0bb1\u0bcd\u0bb1\u0b9a\u0bcd\u0b9a\u0bbe\u0b9f\u0bcd\u1f8c\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0bc8\u0b95\u1f90 \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c \u0b95\u0bbe\u0bb5\u1fa2\u0bb2\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b9a\u0bbf\u0bc8\u0bb1\u0baf\u0bbf\u0bb2\u0bcd \u0b87\u1f9e\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0b95."
