2\u0d9a 355 \u0dc4\u0dd2 - \u0d9a\u0d82\u0d9a 75/5, \u0dba\u0dda \u0dba\u0d9a\u0ddc\u0da7\u0dd4\u0dbd \u0dc1\u0d82\u0daf\u0dd2\u0dba, \u0db8\u0dc5\u0dbb\u0dca\u0d9c \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc1\u0dc5 \u0daf\u0dd2\u0dba\u0d9c\u0db8, \u0d9a\u0dd2\u0dbb\u0dd2\u0dbd\u0dda\u0dad\u0dd4\u0da9\u0dd4\u0dbd \u0d9a\u0dd4\u0dbb\u0dd4\u0dda\u0db4\u0dd4 \u0d9a\u0da0\u0dca\u0da0\u0dd2\u0dba\u0dda \u0dba\u0daf\u0ddc\u0dca\u0dad \u0d9a\u0dd4\u0db8\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db7\u0dc5\u0dda \u0dba\u0db1 \u0d9a\u0dba 2024012001 \u0dc3\u0dd2\u0daf\u0da7 2026011031 \u0daf\u0d9a\u0dca\u0d9a\u0dba\u0dbd\u0dc5 \u0d87\u0dad\u0dd2 \u0db6\u0dca\u0db0\u0daf\u0da7 \u0dba\u0da7\u0dda\u0dbd EOG 05-0217/28\n\n1998 \u0d85\u0dd2\u0d82 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2 \u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad"
