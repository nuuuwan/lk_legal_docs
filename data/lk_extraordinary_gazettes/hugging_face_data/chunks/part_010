    "chunk_text": "01 \u0d89\u0dad\u0dca\u0dad\u0db4\u0dcf\u0dcf\u0db1\u0d9a\u0dda\ufffd.\u0d9a\u0dda\ufffd.\u0da9\u0dd3. \u0db8\u0d82\u0d82\u0d9c\u0dbd \u200d\u200d\u0da2\u0dba\u0dad\u0dd2\u0dbd\u0d9a02 \u0dbd\u0dd6\u0dbd\u0dca\u0db6\u0daf\u0dca\u0daf\u0dd6\u0dc0\u0d85\u0dc3\u0d82\u0d82\u0d9c \u0dbd\u0d9a\u0dca\u0db8\u0dbd\u0dca \u0dc3\u0db8\u0dbb\u0dc0\u0dd3\u0dbb03 \u0db4\u0db1\u0dca\u0db1\u0dd2\u0dbd\u0db1\u0dcf\u0dcf \u0d9a\u0db1\u0dca\u0daf\u0dbd\u0d9c\u0dda\u0118 \u0dbd\u0dbd\u0dd2\u0dad04 \u0db8\u0ddc\ufffd\u0ddc\u0dbb\u0d9c\u0dbd\u0d9a\u0dda\ufffd.\u0da2\u0dd2.\u0da9\u0dd3.\u0dc3\u0ddd\ufffd\u0ddd\ufffd\u0db8\u0dc3\u0dd2\u0dbb\u0dd205 \u0db8\u0daf\u0dca\u0daf\u0dd9\u0dd9\u0d9c\u0db8\u0d89\u0db1\u0dca\u0daf\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0dad \u0db8\u0dbd\u0dca\u0dbd\u0dc0\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd206 \u0db8\u0dd2\u0d9c\u0dc4\u0dad\u0dd0\u0dd0\u0db1\u0dca\u0db1\u0d9a\u0dda\ufffd.\u0db6\u0dd3. \u0dc3\u0db8\u0db1\u0dca \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0dc0\u0d82\u0d82\u0dc107 \u0db6\u0ddd\ufffd\u0ddd\ufffd\u0dad\u0dbd\u0dcf\u0dcf\u0dc0\u0db4\u0dca\u200d\u0dbb\u0daf\u0dd2\u0db4\u0dca \u0db1\u0dd2\u0dc1\u0dcf\u0dcf\u0db1\u0dca\u0dad \u0d85\u0dbd\u0dc0\u0dbd08 \u0d89\u0dc4\u0dc5 \u0dc4\u0dd9\ufffd\u0dc0\u0dd9\u0dd9\u0dc3\u0dca\u0dc3\u0dba\u0dd6.\u0d91\u0dbd\u0dca.\u0d91\u0db8\u0dca.\u0d9c\u0dd4\u0db1\u0dc0\u0dbb\u0dca\u0db0\u0db109 \u0db4\u0dd0\u0dd0\u0dbd\u0dc0\u0dad\u0dca\u0dad\u0d9a\u0dda\ufffd.\u0da7\u0dd3.\u0dc3\u0db6\u0dd3\u0dad\u0dcf\u0dcf \u0dc3\u0db8\u0db1\u0dca\u0db8\u0dbd\u0dd310 \u0d9c\u0ddc\ufffd\u0ddc\u0dbb\u0d9a\u0daf\u0dd6\u0dc0 \u0da2\u0db1\u0dd2\u0dad\u0dcf\u0dcf \u0daf\u0ddc\ufffd\u0ddc\u0da9\u0db8\u0dca\u0d9c\u0ddc\ufffd\u0ddc\u0da911 \u0db8\u0dcf\u0dcf\u0d9a\u0dbd\u0db1\u0dca\u0daf\u0dcf\u0dcf\u0dc0\u0d91\u0da0\u0dca.\u0d92.\u0da0\u0db8\u0dd2\u0db1\u0dca\u0daf \u200d\u200d\u0da2\u0dcf\u0dcf\u0db1\u0d9a12 \u0dc0\u0dbd\u0dbd\u0dca\u0dbd\u0dcf\u0dcf\u0dc0\u0dd2\u0da7\u0db4\u0dd3.\u0d9a\u0dda\ufffd. \u0dc3\u0dd4\u0db1\u0dd2\u0dbd\u0dca \u0d85\u0db6\u0dba\u0dc3\u0dd2\u0dbb\u0dd213 \u0db4\u0dbb\u0dd9\u0dd9\u0dba\u0dd2\u0d9c\u0db8\u0d9a\u0dda\ufffd.\u0d9a\u0dda\ufffd. \u0d8b\u0daf\u0dba \u0db4\u0dd4\u0dc2\u0dca\u0db4 \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb14 \u0d9a\u0dbb\u0db4\u0dcf\u0dcf\u0d9c\u0dbd\u0dc0\u0da2\u0dd2\u0dbb \u0db4\u0dd4\u0dbd\u0dc3\u0dca\u0dad\u0dd2 \u0d91\u0daf\u0dd2\u0dbb\u0dd2\u0dc3\u0dd2\u0d82\u0d82\u0dc4 \u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0d91\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0d85\u0d9c\u0dbd\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0(\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\n\u0dc0\u0dbd\u0dbd\u0dca\u0dbd\u0dcf\u0dcf\u0dc0\u0dd2\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\n\n(\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\nIV (\u0d86) \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3 - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\ufffd\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.05.3115A\n\nI \u0dad\u0dd3\u0dbb\u0dd4\u0dc0 II \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\n\n\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda\u024f \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3 \u0d85\u0d82\u0d82\u0d9a\u0dba \u0db1\u0db8 \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda\u024f \u0db1\u0db8 \u0dc3\u0dc4 \u0db1\u0db8 \u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0d91\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0d9a\u0dc5\u0dd4\u0dad\u0dbb(\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\n\u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\n\u0db8\u0dbd\u0dca\u0dbd\u0dc0 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda\u0118 \u0da2\u0dba\u0dc3\u0dda\ufffd\u0dda\u0db1\u0d9a\u0d9a\u0dd4\u0dbd\u0dd9\ufffd \u0dc0\u0dd2\u0daf\u0dcf\u0dcf\u0db1\u0dd9\ufffd\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0daf\u0ddc\ufffd\u0ddc\u0db1\u0dca \u0da0\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dcf\u0dc3\u0d9a\u0db1\u0dad\u0dca\u0dad \u0d9c\u0db8\u0d9c\u0dda\u0118 \u0daf\u0ddc\ufffd\u0ddc\u0db1\u0dca \u0dbb\u0dd4\u0d9a\u0dca\u0dc2\u0db1 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dd3\u0db4\u0dca \u0d9c\u0db8\u0d9c\u0dda\u0118\u0d9a\u0dcf\u0dcf\u0dbd\u0dc0\u0dd2\u0dbd \u0dc0\u0dd2\u0dad\u0dcf\u0dcf\u0db1\u0d9c\u0dda\u0118 \u0db1\u0dcf\u0dcf\u0dbd\u0d9a \u0dad\u0dbb\u0d82\u0d82\u0d9c \u0dc3\u0db8\u0dbb\u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0d9a\u0dd4\u0d9a\u0dd4\u0dbd\u0dda\u0262 \u0d9a\u0db1\u0dca\u0d9a\u0dcf\u0dcf\u0db1\u0db8\u0dca\u0d9c\u0dda\u0118 \u0daf\u0dd3\u0db4\u0dcf\u0dcf\u0dbd\u0dca \u0d9a\u0dd2\u0dad\u0dca\u0dc3\u0dd2\u0dbb\u0dd2\u0db8\u0dd2\u0dba\u0db1\u0d9a\u0ddc\ufffd\u0ddc\u0dbd\u0dad\u0dd0\u0dd0\u0db1\u0dca\u0db1 \u0dc4\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0dd2\u0db8\u0dcf\u0dcf\u0dbd\u0dd2 \u0d85\u0dba\u0dda\u024f\u0dc2\u0dcf\u0dcf \u0dbd\u0d9a\u0dca\u0db8\u0dd2\u0dab\u0dd2\u0d85\u0dad\u0dd4\u0d9a\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dbd \u0daf\u0ddc\ufffd\u0ddc\u0db1\u0dca \u0d8b\u0daf\u0dda\u0dda\u0db1\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0d82\u0d82\u0d9c\u0db8\u0da9\u0dc0\u0dd2\u0da7 \u0dc0\u0dd2\u0dad\u0dcf\u0dcf\u0db1\u0d9c\u0dda\u0118 \u0da0\u0dad\u0dd4\u0dbb \u0d9c\u0dba\u0dcf\u0dcf\u0db1\u0dca\n\n\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n01 \u0d9c\u0dd4\u0d82\u0d82\u0d9c\u0db8\u0dd4\u0dc0\u0da2\u0dd2.\u0d9a\u0dda\ufffd \u0d85\u0db1\u0ddd\u200d\ufffd\u200d\ufffd\ufffd\u0da2\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0d9c\u0dd4\u0dab\u0dc0\u0dbb\u0dca\u0db0\u0db102 \u0dc0\u0dd0\u0dd0\u0dbd\u0dd2\u0d9a\u0dbd\u0da2\u0dda\u0dda.\u0da2\u0dd2 \u0dc3\u0db8\u0db1\u0dca \u0dc3\u0dd4\u0da2\u0dd3\u0dc003 \u0dba\u0dcf\u0dcf\u0dbd\u0d9c\u0dbd\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0d9a\u0dbb\u0db1\u0d9c\u0dda\u0118 \u200d\u200d\u0da2\u0dba\u0dc3\u0dd2\u0dbb\u0dd204 \u0dc4\u0dbd\u0dca\u0dad\u0ddc\ufffd\u0ddc\u0da7\u0db4\u0dd3.\u0d92 \u0da2\u0db1\u0d9a \u0db8\u0ddd\ufffd\u0ddd\ufffd\u0dc4\u0dcf\u0dcf\u0db1\u0dca \u0da2\u0dd3\u0dc0\u0dcf\u0dcf\u0db1\u0db1\u0dca\u0daf05 \u0db8\u0dd2\u0dbd\u0dca\u0dbd\u0db1\u0dd2\u0dba\u0d91\u0dc3\u0dca.\u0d92.\u0d91\u0da0\u0dca \u0db0\u0db8\u0dca\u0db8\u0dd2\u0dad\u0dca \u0db4\u0dd9\u0dd9\u0dbb\u0dda\u0dda\u0dbb\u0dcf\u0dcf06 \u0db4\u0dbb\u0d9c\u0dc3\u0dca\u0dad\u0ddc\ufffd\u0ddc\u0da7\u0d91\u0dc3\u0dca. \u0daf\u0dba\u0dcf\u0dcf\u0dbd\u0dca \u0dc3\u0dd9\ufffd\u0db1\u0dbb\u0dad\u0dca \u0db8\u0db1\u0ddd\ufffd\u0ddd\ufffd\u0dc4\u0dbb07 \u0db4\u0dd0\u0dd0\u0dbd\u0dca\u0db4\u0ddc\ufffd\u0ddc\u0dbd\u0dbd\u0dd2\u0dba\u0db1\u0d9c\u0dda\u0118 \u0d85\u0dc3\u0db1\u0dca\u0dad \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb08 \u0db6\u0da7\u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0d9a\u0dda\ufffd.\u0d92 \u0daf\u0dbb\u0dca\u0dc1\u0db1 \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb09 \u0dc0\u0dd9\u0dd9\u0db1\u0dd2\u0dc0\u0dd0\u0dd0\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba\u0daf\u0dda\u0dda\u0dc0\u0d9c\u0dda\u0118 \u0da0\u0db8\u0dd2\u0dbd\u0dcf\u0dcf \u0dc3\u0dd4\u0db6\u0dcf\u0dcf\u0db1\u0dd210 \u0d8b\u0da9\u0dd4\u0dc0\u0dbb\u0da2\u0dcf\u0dcf\u0db8\u0dd4\u0db1\u0dd2 \u0dc3\u0dd4\u0dbb\u0d82\u0d82\u0d9c \u0db8\u0d82\u0d82\u0d9c\u0dbd\u0db1\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dd9\u0dd9\u0dbb\u0dda\u0dda\u0dbb\u0dcf\u0dcf11 \u0d9c\u0dbd\u0dca\u0db4\u0dcf\u0dcf\u0dad\u0d9c\u0dd4\u0db1\u0dd9\ufffd\u0dad\u0dca\u0dad\u0dd2 \u0dbb\u0dd2\u0dc2\u0dcf\u0dcf\u0db1\u0dca \u0daf\u0dd2\u0dbd\u0dca\u0db4\u0dc4\u0db1\u0dca12 \u0dba\u0da7\u0dc0\u0dbb\u0da2\u0dba\u0dc3\u0dd2\u0dbb\u0dd2\u0d9c\u0dda\u0118 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db1\u0dca\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dbb\u0dca\u0dc3\u0db1\n\n\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0d91\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0dad\u0ddc\ufffd\u0ddc\u0da7\u0dd4\u0db4\u0dd2\u0da7\u0dd2\u0dba\u0d9c\u0dda\u0118 \u0da2\u0dd3\u0dc0\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dd2\u0db1\u0dba\u0dd2\u0dad\u0db1\u0dca\u0d9c\u0dda\u0118 \u0da2\u0db1\u0db1\u0dd3 \u0d9a\u0dde\ufffd\u0dde\u0dc2\u0dbd\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dcf\u0db1\u0dca\u0daf\u0dd4\u0d8b\u0db3\u0dd4\u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0d9c\u0dda\u0118 \u0da2\u0dba\u0dc3\u0dda\ufffd\u0dda\u0db1 \u0dbb\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dd2\u0d9c\u0ddd\ufffd\u0ddd\ufffd\u0dc4\u0dd9\ufffd\u0da7\u0dca\u0da7\u0dd2\u0d9c\u0dda\u0118 \u0d9c\u0dd2\u0dc4\u0dcf\u0dcf\u0db1\u0dca \u0db4\u0dd9\u0dd9\u0dbb\u0dda\u0dda\u0dbb\u0dcf\u0dcf\u0db8\u0dbd\u0dc0\u0dd2\u0d9c\u0dda\u0118 \u0da2\u0d9c\u0dad\u0dca \u0dad\u0dd4\u0dc2\u0dcf\u0dcf\u0dbb \u0dc4\u0dda\ufffd\u0dda\u0db8\u0db1\u0dca\u0dad\u0dc0\u0dd9\u0dd9\u0da9\u0dd2\u0d9a\u0dca\u0d9a\u0dcf\u0dcf\u0dbb \u0dc3\u0dd4\u0dbb\u0dda\u0dda\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dbb\u0dca\u0dc1\u0db1\u0dd3 \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf\u0dcf\u0db1\u0db8\u0dca\u0db8\u0dd4\u0db1\u0dd2 \u0d9c\u0dba\u0dcf\u0dcf\u0db1\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0dbb\u0dad\u0dca\u0db1\u0dc3\u0dd2\u0dbb\u0dd2\u0d85\u0db9\u0dc0\u0dbd\u0d9c\u0dda\u0118 \u0daf\u0dbb\u0dca\u0dc1\u0db1 \u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dbb\u0dca\u0dab\u0db4\u0dd4\u0dbb\u0d9a\u0dd4\u0dc3\u0dd4\u0db8\u