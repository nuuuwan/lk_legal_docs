    "chunk_text": "\u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0bb5\u0b9f\u0bcd\u0b9f\u0bbe\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0bb5\u0b9f\u0bcd\u0b9f\u0bbe\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\n\n\u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0b9a\u0baa\u0bc8 \u0baa\u0bc6\u0baf\u0bb0\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0b9a\u0baa\u0bc8 \u0baa\u0bc6\u0baf\u0bb0\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n\u0b95\u0bbe\u0bb2\u0bbf \u0b95\u0bbe\u0bb2\u0bbf\n\n(\u0ba4\u0722\u0bca\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf)(\u0ba4\u0722\u0bca\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf)\n\n\u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n\u0bb2\ufffd\u0bca\u0b95\u0bc1\u0b95\u0bc7 \u0ba4\ufffd\u0bca\u0ba9\u0bcd \u0b9a\u0bc1\u0ba4\u0ba4\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0ba9\u0bcd\u0ba9 \u0b85\u0b9c\u0bbf\u0ba4\u0bcd \u0baa\u0ba3\u0bcd\u0b9f\u0bbf\u0ba4 \u0bb5\u0b9f\u0bc1\u0b95\u0bc7 \u0baf\ufffd\u0bca\u0bb9\u0bbe\u0ba9\u0bcd \u0bb0\ufffd\u0bca\u0ba9\u0bbf\u0bb2\u0bcd \u0b9a\u0bbe\u0bae\u0bb0 \u0b9a\u0bc7\u0ba4\u0bbf\u0b95\u0bb2\u0bcd\u0bb2\u0b95\u0bc7 \u0b9a\u0bc7\u0ba9\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0b9a\u0bc6\u0bae\u0bcd\u0baa\u0b95\u0bc1\u0b9f\u0bcd\u0b9f\u0bbf\u0b95\u0bc7 \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bae\u0bbe \u0ba4\u0bbf\u0bb2\u0bbe\u0ba9\u0bbf \u0bb0\u0bbe\u0bb9\u0bc1\u0baa\u0ba4\u0bcd\u0ba4 \u0b95\u0b99\u0bcd\u0b95\u0bbe\u0ba9\u0bae\u0bcd\u0b95\u0bc7 \u0b9a\u0ba8\u0bcd\u0ba4\u0bc1\u0ba9\u0bbf \u0ba4\u0bbf\u0bb2\u0bcd\u0bb9\u0bbe\u0ba9\u0bbf \u0b85\u0bb0\u0bc1\u0bae\u0bbe\u0ba4\u0bc1\u0bb0 \u0ba4\u0bc1\u0b9a\u0bbf\u0ba4 \u0ba4\u0bbf\u0bb2\u0b99\u0bcd\u0b95 \u0b9c\u0baf\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0b9a\u0b9e\u0bcd\u0b9c\u0baf \u0baa\u0bbf\u0bb0\u0ba4\u0bc0\u0baa\u0bcd\u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0b85\u0bb3\u0bc1\u0ba4\u0bcd\u0b95\u0bae \u0b95\u0bc1\u0bb0\u0bc1\u0b95\u0bc7\n\n\u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bb2\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf 01 \u0baa\ufffd\u0bca\u0bb0\u0bb2\u0bc1\u0b95\u0bc6\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0b87\u0bb2\u0ba8\u0bcd\u0ba4\u0bbe\u0bb0\u0bbf\u0ba4\u0bc7\u0bb5 \u0b9a\u0bc1\u0ba9\u0bbf\u0bb2\u0bcd \u0bb5\u0bc0\u0bb0\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0baa\u0bbf\u200e\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8 02 \u0ba8\u0bbe\u0ba9\u0ba4\ufffd\u0bca\u0b9f\u0bcd\u0b9f\u0baa\u0bb2\u0bbe\u0ba4\u0bcd\u0ba4 \u0ba4\u0bb0\u0bcd\u0b9a\u0ba3 \u0b9a\u0baa