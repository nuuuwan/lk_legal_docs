dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0d9c\u0db8 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0d89\u0da9\u0db8\u0dca \u0d89\u0da9\u0dd9\u0db8\u0dca \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0dd9\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dd9\u0dc3\u0dda \u0db4\u0db8\u0dcf\u0dab\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dc5 \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4\u0dad\u0dd2\u0d9a\u0dd9\u0dba\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba \u0d85\u0d82\u0d9a\u0dba\n\n(\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0db6\u0db8\u0dd4\u0dab\u0dd9\u0db4\u0ddc\u0dad 420357 \u0d9a\u0dbd\u0dcf\u0db4 01 0.1638 00190022392 \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 63 \u0dc3\u0dd0\u0dc5\u0d9a\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. - \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0db1\u0dca\u0dad\u0dd2\u0db8 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0db4\u0dad\u0dba\u0d9a\u0dca \u0dd9\u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2 \u0dd9\u0daf\u0dca\u0db4\u0dc5\u0d9a\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dbd\u0dd2\u0dba\u0dd4\u0db8\u0dca\u0dc0\u0dbd, \u0d92 \u0dd9\u0daf\u0dca\u0db4\u0dc5\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0dd9\u0db8\u0dca \u0d85\u0d82\u0d9a\u0dba, \u0d89\u0da9\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dd9\u0dc3\u0dda \u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4 \u0d92 \u0d89\u0da9\u0db8\u0dca\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dd1\u0db8\u0da7 \u0dad\u0db8\u0dcf\u0da7 \u0d87\u0dad\u0dd2 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba. \u0dbd\u0dd2\u0dba\u0dd4\u0db8\u0dca \u0d9a\u0dc0\u0dd9\u0dbb\u0dd9\u0dba\u0dca \u0dc0\u0db8\u0dca\u0db4\u0dc3 \u0d8b\u0da9 \u0dd9\u0d9a\u0dc5\u0dc0\u0dd9\u0dbb\u0dca \u201c\u0d85\u0db1\u0dca\u0dad\u0dd2\u0db8 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0db4\u0dad\u0dba\u0d9a\u0dca \u0dd9\u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2 \u0dd9\u0daf\u0dca\u0db4\u0dc5 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0db8\u0dca \u0db4\u0dad\u0dba\u201d \u0dba\u0db1\u0dd4\u0dd9\u0dc0\u0db1\u0dca \u0dbd\u0dd2\u0dba\u0dcf \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba. EOG 05 - 0195/5\n\n5 A III \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 - \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba - 2025.05.28\n\n\u0d85\u0db1\u0dca\u0dad\u0dd2\u0db8 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0db4\u0dad\u0dba\u0d9a\u0dca \u0dd9\u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2 \u0dd9\u0daf\u0dca\u0db4\u0dbd \u0dc3\u0db3\u0dc4\u0dcf \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca\u0db4\u0dd1\u0db8\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dd9\u0dbd\u0dc3 \u0daf\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dad (55 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba) \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca \u0dd9\u0dc4\u0ddd\u0db8\u0dcf\u0d9c\u0db8 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0