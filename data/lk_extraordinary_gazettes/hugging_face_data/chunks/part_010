    "chunk_text": "\u0da2\u0dda\u0db8\u0dd2\u0dc3\u0dca \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dca \u0daf\u0dd4\u0dbd\u0dd2\u0db4\u0dca \u0dc3\u0dbb\u0dca\u0db1\u0dd2 \u0da0\u0dad\u0dd4\u0dbb\u0d82\u0d9c \u0db1\u0db8\u0dc3\u0dd2\u0dc0\u0dcf\u0dba\u0db8\u0dca \u0dbb\u0dd9\u0dc3\u0dca\u0db8\u0dd2\u0d9a\u0dcf\u0db1\u0dca\u0dad\u0db1\u0dca \u0dc0\u0dd9\u0dc5\u0db8\u0dd0\u0daf\u0d9c\u0dd9\u0daf\u0dbb \u0db4\ufffd\u0ddc\u0da9\u0dd2 \u0db8\u0dd0\u0dab\u0dd2\u0d9a\u0dda \u0d9c\u0db8\u0dca\u0db8\u0dd4\u0daf\u0dd4\u0dc0\u0dad\u0dca\u0dad\u0dda \u0d9c\u0dd9\u0daf\u0dbb \u0d9c\u0dd4\u0dab\u0dc0\u0dad\u0dd3 \u0d8b\u0da9\u0dad\u0dd0\u0db1\u0dca\u0db1\u0dda \u0d9c\u0dd9\u0daf\u0dbb \u0dc3\ufffd\u0ddd\ufffd\u0db8\u0dbd\u0dad\u0dcf \u0dbd\ufffd\u0ddd\ufffd\u0d9c\u0db1\u0dcf\u0daf\u0db1\u0dca \u0da2\u0dd4\u0dbd\u0dd2\u0db1\u0dca \u0dbb\u0dcf\u0dc3\u0dba\u0dd2\u0dba\u0dcf \u0dc0\u0dd2\u0da2\u0dba\u0daf\u0dbb\u0dca\u0dc1\u0db1\u0dd3 \u0db8\u0dba\u0dd2\u0dbd\u0dca\u0dc0\u0dcf\u0d9c\u0db1\u0db8\u0dca \u0d85\u0db1\ufffd\u0ddd\ufffd\u0da2\u0dcf \u0d89\u0dbd\u0d82\u0d9c\u0d9a\ufffd\u0ddd\ufffd\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0db1\u0dd2\u0dbd\u0d82\u0d9c\u0db1\u0dd3 \u0db8\u0dd0\u0dab\u0dd2\u0d9a\u0dda \u0dc3\u0dd4\u0db6\u0dca\u200d\u0dbb\u0db8\u0db1\u0dd2\u0dba\u0db8\u0dca \u0dc3\u0db1\u0dca\u0db8\u0dd4\u0d9c\u0daf\u0dcf\u0dc3 \u0dad\u0d82\u0d9c\u0dbb\u0dcf\u0da2\u0dca \u0db4\u0dd4\u0dab\u0dca\u200d\u0dba\u0db8\u0dd6\u0dbb\u0dca\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc2\u0dca\u0dab\u0dc3\u0dcf\u0db8\u0dd2 \u0d9a\u0db8\u0dbd\u0daf\u0dcf\u0dc3\u0db1\u0dca \u0d9c\u0dbd\u0dca\u0dbd\u0daf\u0dab\u0dca\u0da9\u0d9c\u0dda \u0db8\u0dc4\ufffd\u0dda\u0dc2\u0dca \u0da0\u0db8\u0dd2\u0db1\u0dca\u0daf \u0d9c\u0dbd\u0dca\u0dbd\u0dd9\u0daf\u0dab\u0dca\u0da9 \u0dc3\u0dd9\u0dbd\u0dca\u0dc0\u0db8\u0dd4\u0dad\u0dca\u0dad\u0dd4 \u0dc3\u0dd9\u0dbd\u0dca\u0dc0\u0db8\u0daf\u0db1\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dc0\u0dda\u0dbd\u0dca \u0dc2\u0dd9\u0d