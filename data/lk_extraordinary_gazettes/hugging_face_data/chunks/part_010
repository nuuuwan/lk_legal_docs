dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1 \u0dbd\u0dda\u0262\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc0\u0dc1\u0dba\u0dd9\u02e0\u0db1\u0dca \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n\u0db1\u0db8\u0dad\u0db1\u0dad\u0dd4\u0dbb\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0dba\n\n1.\u0d91\u0db8\u0dca.\u0d92.\u0d91\u0dbd\u0dca.\u0d91\u0dc3\u0dca.\u0d91\u0db1\u0dca.\u0d9a\u0dda\ufffd. \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dad\u0dcf\u0dcf-\u0dbd\u0dda\u0262\u0d9a\u0db8\u0dca\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8\u0dd3\u0dba \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1, \u0dc3\u0db8\u0dcf\u0dcf\u0da2 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf \u0dc3\u0dc0\u0dd2\u0db6\u0dbd\u0d9c\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\n\n2025.05.21\n\n2.\u0d86\u0da0\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0db6\u0dd3.\u0d9a\u0dda\ufffd. \u0d9a\u0ddd\ufffd\u0ddd\ufffd\u0dbd\u0dd2\u0dad \u0d9a\u0db8\u0dbd\u0dca \u0da2\u0dd2\u0db1\u0daf\u0dcf\u0dcf\u0dc3 \u0db8\u0dc4\u0dad\u0dcf\u0dcf-\u0dbd\u0dda\u0262\u0d9a\u0db8\u0dca\u0db0\u0dd3\u0dc0\u0dbb, \u0da2\u0dbd\u0da2 \u0dc3\u0dc4 \u0dc3\u0dcf\u0dcf\u0d9c\u0dbb \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\n\n2025.05.21\n\n\u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db4\u0dbb\u0dd2\u0daf\u0dd2, \u0d86\u0da0\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0d91\u0db1\u0dca.\u0d91\u0dc3\u0dca. \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a, \u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dbd\u0dda\u0262\u0d9a\u0db8\u0dca.\n\n2025 \u0db8\u0dd0\u0dd0\u0dba\u0dd2 \u0db8\u0dc3 28 \u0dc0\u0db1 \u0daf\u0dd2\u0db1,\u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba,\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 01.\n\nEOG 05 - 0208\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dbb\u0da2\u0dba\u0dda\u024f \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.1A - G 44455 \u2014 05 (2025/05)"
