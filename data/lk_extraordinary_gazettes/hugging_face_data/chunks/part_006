bf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90\u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90\n\n\u0d85\u0d82\u0d9a 2442/58 - 2025 \u0da2\u0dd4\u0db1\u0dd2 \u0db8\u0dc3 27 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc3\u0dd2\u0d9a\u0dd4\u0dbb\u0dcf\u0daf\u0dcf - 2025.06.27\u0d85\u0d82\u0d9a 2442/58 - 2025 \u0da2\u0dd4\u0db1\u0dd2 \u0db8\u0dc3 27 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc3\u0dd2\u0d9a\u0dd4\u0dbb\u0dcf\u0daf\u0dcf - 2025.06.27\n\n2442/58 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd - 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8c \u1f9d\u0ba9\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd 27 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4 \u0bc6\u0bb5\u0bd7\u0bcd\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb4\u0bc8\u0bae2442/58 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd - 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8c \u1f9d\u0ba9\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd 27 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4 \u0bc6\u0bb5\u0bd7\u0bcd\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb4\u0bc8\u0bae\n\n(\u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0ba4\u0bcd\u1f90\u0b9f\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0bc1\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90)\u0baa\u0b95\u0bc1\u0ba4\u0bbf III - \u0b95\u0bbe\u0ba3\u0bbf\u0b95\u0bb3\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf III - \u0b95\u0bbe\u0ba3\u0bbf\u0b95\u0bb3\u0bcd\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb5\u0ba9\u1fab \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bcd\u0b95\u0bbe\u0ba3\u0bbf \u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb5\u0ba9\u1fab \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bcd\n\n1A - G44676 - 19 (2025/06)\u0b87\u0bb5\u0bcd \u0b85\u0ba4\u0bbf\u0bb5\u0bbf \u0bc7\u0bb7\u0b9f \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0bc8\u0baf www.documents.gov.lk \u0b8e\u1f94\u0bae\u0bcd \u0b87\u0bc8\u0ba3\u0baf\u0ba4\u0bcd\u0ba4\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u1fa2\u1f9e\u0ba8\u0bcd\u1f90 \u0baa\u0ba4\u0bbf\u0bb5\u0bbf\u0bb1\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0baf \u1f99\u1f8a\u1f9c\u0bae\u0bcd.\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u0bb1\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd (\u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0baf\u0bae\u0bcd 460)\u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u0bb1\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd (\u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0baf\u0bae\u0bcd 460)\n\n5 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0baa\u1f8a\u0baf\u0bbe\u0ba9 \u0baa\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0bae\u0bcd\n\n\u0b95\u0bc0\u0bb4\u0bcd\u0b95\u0bcd\u0b95\u0bbe\u1f8e\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf \u0b92\u1f9e \u0baa\u0b95\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0ba4\u0bcd \u0bc7\u0ba4\u0bc8\u0bb5\u0b95\u0bcd\u0b95\u0bc1 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8a\u0baf\u0ba4\u0bbe\u0baf\u0bcd \u0b87\u1f9e\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bc6\u0ba4\u0ba9\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u0bb1\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u1f8c\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0bbe\u0bb0\u0bae\u0bcd \u0b85\u1f90 \u0b8e\u1f8c\u0ba4\u0bcd\u1f90\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u1f8c\u0bc6\u0bae\u0ba9\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u0bb1\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 5 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd (1) \u0b86\u0bae\u0bcd \u0b89\u0baa\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0bbe\u0bb0\u0bae\u0bcd \u0b95\u0bae\u0ba4\u0bcd\u0bc6\u0ba4\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd, \u0b95\u0bbe\u0bb2\u0bcd\u0ba8\u0bc8\u0b9f \u0bb5\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0b9a\u0ba9 \u0b85\u0bc8\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b95\u0bc1\u0bb0\u0b95\u0bae\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u0ba9\u0bcd \u0bb2\u0bbe\u0bb2\u0bcd \u0b95\u0bbe\u0ba8\u0bcd\u0ba4 \u0b86\u0b95\u0bbf\u0baf \u0ba8\u0bbe\u0ba9\u0bcd, \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0bae\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd.\n\n\u0bc7\u0bae\u0bb2\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bc6\u0b95\u0bbe\u1fa8\u0bae\u0bcd\u1f97 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bc7\u0bb9\u0bbe\u0bae\u0bbe\u0b95\u0bc8\u0bae \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0b87\u0bb2. 486\u0baa\u0bc0, \u0bc7\u0bb9\u0bbe\u0bae\u0bbe\u0b95\u0bc8\u0bae \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0bc7\u0bb9\u0bbe\u0bae\u0bbe\u0b95\u0bc8\u0bae \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0ba8\u0bbe\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd 2023.12.16 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0ba4\u0baf\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u1f99\u0ba4\u0bb1\u0bcd \u0b9a\u0bc1\u0bb5\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. CO/HMG/2023/420 \u0b87\u0bb2\u0bcd \u0bb5\u0bbf\u0baa\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 0.0055 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u1f99\u0bc8\u0b9f\u0baf \u201c\u0b8f\u201d \u0bc6\u0ba4\u0bbe\u0b9f\u0b95\u0bcd\u0b95\u0bae\u0bcd \u201c\u0b8e\u0baa\u0bcd\u201d \u0bb5\u0bc8\u0bb0\u0baf\u0bbe\u0ba9 \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd \u1f90\u0ba3\u0bcd\u1f8c\u0b95\u0bb3\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bbe\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0b8e\u1f8c\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u1f90. \u0b87\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u1f90\u0ba3\u0bcd\u1f8c\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0b95\u0bb3\u0bcd :"
