\u01e6\u0dd9\u01ca\u0286\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae\u0dc0 \u0db6\u0dbd\u0db4\u01b4 \u0d85\u0d82\u0d9a 52/332 \u0dba\u0da7\u0dd9\u01ae \u0d8b\u00fa\u0d9a\u0dd4\u0dc0\u0dcf\u0dd9\u0118 \u0218\u0dba\u0dbb\u01ae\u0db1 \u0dba\u0db1 \u0d85\u0dba \u0236\u00fa\u01af \u026a\u01cf. 1:25 0.3035 \u0dbb\u0da2\u0dba \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u01ae \u0dd9\u0d9a\u02a3\u01e6\u0dd9\u01ca\u0286\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae\u0dc0 \u0db6\u0dbd\u0db4\u01b4 \u0d85\u0d82\u0d9a 43/332 \u0dba\u0da7\u0dd9\u01ae \u0d9c\u0262\u0dd9\u0d9a\u02a3\u017b\u0dd9\u0269 \u0dd9\u0d9c\u0daf\u0dbb \u0dc4\u0259\u0dc2 \u0da0\u01b1\u0dbb\u0d82\u0d9c \u0d9a\u025e\u0dab\u0dcf\u0dbb\u01ae\u0db1 \u0dba\u0db1 \u0d85\u0dba \u0236\u00fa\u01af \u026a\u01cf. 1:26 0.3035 \u0dbb\u0da2\u0dba \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u01ae \u0dd9\u0d9a\u02a3\u01e6\u0dd9\u01ca\u0286\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae\u0dc0 \u0db6\u0dbd\u0db4\u01b4 \u0d85\u0d82\u0d9a 43B/332 \u0dba\u0da7\u0dd9\u01ae \u0d9c\u0262\u0dd9\u0d9a\u02a3\u017b\u0dd9\u0269 \u0dd9\u0d9c\u0daf\u0dbb \u0da0\u01e6\u01d6\u0dbd\u0dad\u0dcf \u0dba\u0db1 \u0d85\u0dba \u0236\u00fa\u01af \u026a\u01cf.\n\n\u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba \u2013 (\u0dc3\u023c\u0db6\u01e6\u01dd\u0dad\u0250)\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013--\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 \u026a\u01e7\u0dc1\u0dca\u0da0\u0dba\u01e6 \u0dc3\u0dc4 \u0dba\u023c \u0