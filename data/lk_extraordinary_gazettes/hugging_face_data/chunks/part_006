\u0bc7\u0baa\u0bbe\u0baa\u0bcd\u0bc7\u0baa \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbe\u0bbf\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. 1002 \u0b87\u0ba9\u0bcd \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b85\u0bc7\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bae\u0bbf\u0b95\u0bc1\u0ba4\u0bbf\u0baa\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u0b85\u0bc7\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bae\u0bbf\u0b95\u0bc1\u0ba4\u0bbf\u0baa\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf, \u0bc7\u0b95\u0bbe\u0b9f\u0bcd\u0bc8\u0b9f - \u0bc7\u0baa\u0bbe\u0baa\u0bcd\u0bc7\u0baa \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbe\u0bbf \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. 1000/A \u0b87\u0ba9\u0bcd \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 48. 48. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 48 - \u0bb5\u0bbe\u0bbf\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. 1000/A, \u0bc7\u0b95\u0bbe\u0b9f\u0bcd\u0bc8\u0b9f - \u0bc7\u0baa\u0bbe\u0baa\u0bcd\u0bc7\u0baa \u1faa\u0ba4\u0bbf - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0061 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u0baf\u0b9a\u0baa\u0bbe\u0bb2 \u0b95\u1fa6\u0b86\u0bb0\u0bbe\u0b9a\u0bcd\u0b9a\u0bbf \u0b85\u0bc6\u0bb5\u0ba9\u0bbf\u1f9d \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc7\u0b95\u0bbe\u0b9f\u0bcd\u0bc8\u0b9f \u0bc7\u0baa\u0bbe\u0baa\u0bcd\u0bc7\u0baa \u1faa\u0ba4\u0bbf ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u0bc7\u0b95\u0bbe\u0b9f\u0bcd\u0bc8\u0b9f - \u0bc7\u0baa\u0bbe\u0baa\u0bcd\u0bc7\u0baa \u1faa\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 47 ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 47, \u0bc7\u0b95\u0bbe\u0b9f\u0bcd\u0bc8\u0b