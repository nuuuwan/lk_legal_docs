\u0dcf\u0dad\u0dd2\u0d9a \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0d85\u0d82\u0d9a 1826, 5 \u0dc0\u0dd0\u0db1\u0dd2 \u0db8\u0dc4\u0dbd, \u0dc3\u0dbb\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0da0\u0dd2\u0dad\u0dca\u0dad\u0db8\u0dca\u0db4\u0dbd\u0db8\u0dca \u0d92 \u0d9c\u0dcf\u0da9\u0dca\u0db1\u0dbb\u0dca \u0db8\u0dcf\u0dc0\u0dad, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dd9\u0dba\u0dca \u0d9a\u0da7\u0dca\u0da7\u0dd2 \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 02 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0dd9\u0db8\u0dca \u0d85\u0d82\u0d9a124/2011.12.13 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db8\u0dcf\u0d9a\u0dc0\u0dd2\u0da7\u0dd9\u0d9c\u0dca \u0d91\u0dc5\u0dd2\u0dc3\u0dd9\u0db6\u0dad\u0dca \u0dd9\u0db4\u0dd9\u0dbb\u0dca\u0dbb\u0dcf \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2 1:886 0.0091 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 877 \u0dc4\u0dd2 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0d85\u0d82\u0d9a 1826, 5 \u0dc0\u0dd0\u0db1\u0dd2 \u0db8\u0dc4\u0dbd, \u0dc3\u0dbb\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0da0\u0dd2\u0dad\u0dca\u0dad\u0db8\u0dca\u0db4\u0dbd\u0db8\u0dca \u0d92 \u0d9c\u0dcf\u0da9\u0dca\u0db1\u0dbb\u0dca \u0db8\u0dcf\u0dc0\u0dad, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dd9\u0dba\u0dca \u0d9a\u0da7\u0dca\u0da7\u0dd2 \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 02 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0dd9\u0db8\u0dca \u0d85\u0d82\u0d9a124/2011.12.13 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db1\u0dc0\u0daf\u0dd6\u0dc0 \u0dc0\u0dd2\u0dad\u0dcf\u0db1\u0dd9\u0d9c\u0dca \u0dc0\u0dd2\u0db1\u0dd3\u0dad \u0db0\u0dbb\u0dca\u0db8 \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2 1:887 0.0098 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 877 \u0dc4\u0dd2 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0d85\u0d82\u0d9a 1826, 5 \u0dc0\u0dd0\u0db1\u0dd2 \u0db8\u0dc4\u0dbd, \u0dc3\u0dbb\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0da0\u0dd2\u0dad\u0dca\u0dad\u0db8\u0dca\u0db4\u0dbd\u0db8\u0dca \u0d92 \u0d9c\u0dcf\u0da9\u0dca\u0db1\u0dbb\u0dca \u0db8\u0dcf\u0dc0\u0dad, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dd9\u0dba\u0dca \u0d9a\u0da7\u0dca\u0da7\u0dd2 \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 02 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0dd9\u0db8\u0dca \u0d85\u0d82\u0d9a124/2011.12.13 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dd9\u0dc4\u0dda\u0dbb\u0dad\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d85\u0db1\u0dd2\u0dbd\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2 1:888 0.0139 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 877 \u0dc4\u0dd2 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0d85\u0d82\u0d9a 1826, 5 \u0dc0\u0dd0\u0db1\u0dd2 \u0db8\u0dc4\u0dbd, \u0dc3\u0dbb\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0da0\u0dd2\u0dad\u0dca\u0dad\u0db8\u0dca\u0db4\u0dbd\u0db8\u0dca \u0d92 \u0d9c\u0dcf\u0da9\u0dca\u0db1\u0dbb\u0dca \u0db8\u0dcf\u0dc0\u0dad, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dd9\u0dba\u0dca \u0d9a\u0da7\u0dca\u0da7\u0dd2 \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 02 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0dd9\u0db8\u0dca \u0d85\u0d82\u0d9a124/2011.12.13 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0d9c\u0dd3\u0dad\u0dcf \u0dd9\u0dbb\u0ddd\u0dc4\u0dd2\u0dab\u0dd2 \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2\n\n17A III \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 : \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba - 2025.06.24\n\n\u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba \u2013 (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2) \u0dc0\u0dd2\u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u0ddd \u0d89\u0db1\u0dca\u0dd9\u0da2\u0db1\u0dca\u0dc2\u0db1\u0dca \u0dad\u0dc4\u0db1\u0db8\u0dca \u0dd9\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd\u0dad\u0dca\u0dc0\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dd9\u0d9c\u0dca/\u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dd9\u0dba\u0dca \u0d85\u0dd9\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dcf\u0dd9\u0dc0\u0db1\u0dca \u0d87\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dd9\u0dc3\u0dda \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db1\u0db8/\u0db1\u0db8\u0dca \u0dc3\u0dc4 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u0dc4\u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dc4 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dca \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u0db4\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca)\n\n18 A III \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 : \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba - 2025.06.24"
