u0dad\u0dca\u0dad\u0dbb \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1; (\u0d88) \u0db8\u0dcf\u0dcf\u0dc5\u0dd4 \u0dc3\u0dc4 \u0db8\u0dcf\u0dcf\u0dc5\u0dd4 \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1; (\u0d89) \u0dbb\u0da7\u0d9a\u0da2\u0dd4, \u0dc3\u0ddd\ufffd\u0ddd\ufffd\u0dba\u0dcf\u0dcf \u0db6\u0ddd\u0d82\ufffd\u0d82\ufffd\ufffd\u0da0\u0dd2 \u0dc3\u0dc4 \u0d92\u0dc0\u0dcf\u0dcf\u0dba\u0dda\u024f \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1; (\u0d8a) \u0d9a\u0dd2\u0dbb\u0dd2 \u0dc3\u0dc4 \u0d9a\u0dd2\u0dbb\u0dd2 \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 (\u0dbd\u0dd0\u0dd0\u0d9a\u0dca\u0da7\u0ddd\ufffd\u0ddd\ufffd\u0dc3\u0dca\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca); (\u0d8b) \u0dc1\u0dcf\u0dcf\u0d9a \u0dc0\u0dbd \u0dc3\u0dd1\u0dd1\u0daf\u0dd9\u0dd9\u0db1 \u0daf\u0dd8\u0dd8\u0da9 \u0db5\u0dbd \u0dc3\u0dc4 \u0daf\u0dd8\u0dd8\u0da9 \u0db5\u0dbd \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1; (\u0d87) \u0d91\u0dc4\u0dd2 (\u0d85) \u0da1\u0dda\u0dda\u0daf\u0dba\u0dda\u024f (v) \u0d8b\u0db4 \u0da1\u0dda\u0dda\u0daf\u0dba \u0d85\u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca; \u0dc3\u0dc4(\u0d88) \u0d91\u0dc4\u0dd2 (\u0d85) \u0da1\u0dda\u0dda\u0daf\u0dba\u0dda\u024f (viii) \u0d8b\u0db4 \u0da1\u0dda\u0dda\u0daf\u0dba\u0dda\u024f, \"\u0db8\u0dd2\u0dbd\u0dd2\u0db8\u0dd3\u0da7\u0dbb\u0dca 1.5\u0da7 \u0db1\u0ddc\ufffd\u0ddc\u0d85\u0da9\u0dd4\" \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \"\u0db8\u0dd2\u0dbd\u0dd2\u0db8\u0dd3\u0da7\u0dbb\u0dca 1\u0da7 \u0db1\u0ddc\ufffd\u0ddc\u0d85\u0da9\u0dd4\" \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca;\n\n(3) 5 \u0dc0\u0db1 \u0dbb\u0dd9\u0dd9\u0d9c\u0dd4\u0dbd\u0dcf\u0dcf\u0dc3\u0dd2\u0dba\u0dda\u024f (\u0d89) \u0da1\u0dda\u0dda\u0daf\u0dba \u0d85\u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dbb \u0d92 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0da1\u0dda\u0dda\u0daf\u0dba \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca;\n\n(\u0d89) 4(1) \u0dc0\u0db1 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0d9c\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0db1, \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0dd2\u0dad \u0daf\u0dd2\u0db1\u0dba; \u0d9a\u0dbd\u0dca \u0d89\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0dd3\u0db8\u0dda\u023c \u0daf\u0dd2\u0db1\u0dba \u0dc3\u0dc4 \u0db4\u0ddd\ufffd\u0ddd\ufffd\u0dc2\u0dab \u0dbd\u0dda\ufffd\u0db6\u0dbd\u0dba \u0dc4\u0dd0\u0dd0\u0dbb\u0dd4\u0dab\u0dd4 \u0dc0\u0dd2\u0da7 \u0d85\u0db1\u0dd9\ufffd\u0d9a\u0dd4\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0db1 \u0d8b\u0dc3\u0dd2\u0db1\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0db8\u0dd3\u0da7\u0dbb\u0dca 1.5 \u0da7 \u0db1\u0ddc\ufffd\u0ddc\u0d85\u0da9\u0dd4 \u0d85\u0d9a\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0da7\u0dc0 \u0db4\u0dd9\u0dd9\u0db1\u0dd9\ufffd\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab\u0dba \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba.\n\n(4) 8 \u0dc0\u0db1 \u0dbb\u0dd9\u0dd9\u0d9c\u0dd4\u0dbd\u0dcf\u0dcf\u0dc3\u0dd2\u0dba\u0dda\u024f -(\u0d85) \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0db1 \u0d8b\u0db4\u0dbb\u0dd9\u0dd9\u0d9c\u0dd4\u0dbd\u0dcf\u0dcf\u0dc3\u0dd2\u0dba\u0dda\u024f \"x \u0dbb\u0dc3 \u0d9c\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd6\" \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \"\u0dc3\u0dca\u0dca\u0dc0\u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0d9a/\u0d9a\u0dd8\u0dd8\u0dad\u0dd3\u0db8 x \u0dbb\u0dc3 \u0d9c\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd6\" \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca ; \u0dc3\u0dc4 (\u0d86) \u0daf\u0dd9\u0dd9\u0dc0\u0db1 \u0d8b\u0db4 \u0dbb\u0dd9\u0dd9\u0d9c\u0dd4\u0dbd\u0dcf\u0dcf\u0dc3\u0dd2\u0dba\u0dda\u024f \"\u0dbd\u0dda\ufffd\u0db6\u0dbd\u0dba \u0db8\u0dad \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\" \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \"\u0dbd\u0dda\ufffd\u0db6\u0dbd\u0dba \u0db8\u0dad \u0d85\u0da9\u0d82\u0d82\u0d9c\u0dd4 \u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba\u0dba \u0dbd\u0dd0\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0\u0dd9\u0dd9\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dba. \" \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca,"
