    "chunk_text": ",t; mjptpNrl tu;j;jkhdpia www.documents.gov.lk vDk; ,izaj;jsj;jpypUe;J gjptpwf;fk; nra;a KbAk;.1A - PG 7180\u2014 364 (2025/06)\n\nI fldgi ( ^I& fPoh - YS% ,xld m%cd;dka;s%l iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'06'30gFjp I : njhFjp (I) - ,yq;ifr; rdehaf Nrhryprf; FbauR tu;j;jkhdg; gj;jpupif - mjp tpNr\\khdJ - 2025.06.302A\n\n(\u0b86) \u0bae\u0bbf\u0bbf\u0b95 \u0b85\u0ba3\u0bcd\u0bae\u0bc8\u0bc8\u0baf \u0b87\u0b9f\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0bb2 \u0ba8\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb0\u0bcd \u0b95\u0bc2\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bb3\u0bcd;\n\n(\u0b87) \u0b8f\u0bb1\u0bcd\u0baa\u0bc1\u0b9f\u0bc8\u0bc8\u0baf\u0bb1\u0bcd\u0baa\u0bbe\u0bbe\u0bb2\u0ba4\u0bbe\u0bbe\u0ba9 \u0ba4\u0b95\u0bc1\u0ba4\u0bbf\u0bbf\u0bb5\u0bbe\u0bbe\u0baf\u0bcd\u0ba8\u0bcd\u0ba4 \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0ba9\u0bbe\u0bbe\u0bb2\u0bcd \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bb0\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4 \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bc1 \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0bb5\u0ba3\u0bbf\u0bbf\u0b95\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0ba8\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf \u0b9a\u0bbe\u0bbe\u0bb0\ufffd\u0ba4 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bcd;\n\n(\u0b88) \u0b95\ufffd\u0bcb\u0bb0\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0b9f\u0ba9\u0bcd\u0baa\u0bc6\u0bc6\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0bb4\u0bc1 \u0b95\u0bbe\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0ba4\u0ba9\u0bbf\u0bbf\u0b9a\u0bc1\u0b9a\u0bcd \u0b9a\u0bc7\u0bc7\u0bb5\u0bc8\u0bc8 \u0b95\u0ba3\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd;\n\n(\u0b89) \u0b95\ufffd\u0bcb\u0bb0\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0b9f\u0ba9\u0bcd\u0baa\u0bc6\u0bc6\u0bb1\u0bcd\u0bb1 \u0bae\u0bc1\u0bb4\u0bc1 \u0b95\u0bbe\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0bb0\u0bc1\u0bb5\u0b95\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0ba3\u0bb5\ufffd\u0bcb\u0b9f\u0bcd\u0b9f \u0b95\u0ba3\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd;\n\n(\u0b8a) \u0ba8\u0bbf\u0bbf\u0bb2\u0bc1\u0bb5\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba4\u0ba9\u0bbf\u0bbf\u0b9a\u0bc1 \u0b87\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbe\u0bbe\u0ba9 \u0bb5\u0bbf\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u0bae\u0bcd (\u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bbe\u0bbe\u0ba4\u0bae\u0bcd \u0b85\u0bb3\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f, \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bbe\u0bbe\u0ba4\u0bae\u0bb3\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bbe\u0bbe\u0ba4 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0b9f\u0ba9\u0bcd \u0bae\u0bc0\u0ba4\u0bc1, \u0ba8\u0bbe\u0bbe\u0ba3\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0b95\u0b9f\u0ba9\u0bcd \u0b95\ufffd\u0bca\u0b9f\u0bc1\u0ba8\u0bb0\u0bbf\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd);\n\n(\u0b8e) \u0b92\u0bb5\u0bcd\u0bb5\ufffd\u0bca\u0bb0\u0bc1 \u0ba8\u0bbf\u0bbf\u0bb2\u0bc1\u0bb5\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba4\u0ba9\u0bbf\u0bbf\u0b9a\u0bbf\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bbf\u0baf\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bbf\u0baa\u0ba8\u0bcd\u0ba4\u0ba9\ufffd\u0b95\u0bb3\u0bcd (\u0bae\u0bc1\u0ba4\u0bbf\u0bbf\u0bb0\u0bcd\u0bb5\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0b9f\u0bcd\u0b9f\u0bbf \u0bb5\u0bbf\u0bbf\u0b95\u0bbf\u0bbf\u0ba4\u0bae\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0b9f);\n\n(\u0b8f) \u0b8f\u0bb1\u0bcd\u0baa\u0bc1\u0b9f\u0bc8\u0bc8\u0baf\u0bb1\u0bcd\u0baa\u0bbe\u0bbe\u0bb2\u0ba4\u0bbe\u0bbe\u0ba9 \u0ba4\u0b95\u0bc1\u0ba4\u0bbf\u0bbf\u0bb5\u0bbe\u0bbe\u0baf\u0bcd\u0ba8\u0bcd\u0ba4 \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0bb2\u0bcd \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bb0\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bae\u0bc1\u0ba4\u0bb2\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd \u0b95\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b9a\u0bbe\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0baf\u0b95\u0bcd\u0b95\u0bc2\u0bb1\u0bcd\u0bb1\u0bc1 \u0b86\u0baf\u0bcd\u0bb5\u0bb1\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8;\n\n(\u0b90) \u0b95\ufffd\u0bcb\u0bb0\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8 \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bb0\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1, \u0b95\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc8\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0ba9\u0bbf\u0bbf\u0b9a\u0bc1\u0b95\u0bcd \u0b95\ufffd\u0bca\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba9\u0bb5\u0bc1\u0b95\u0bb3\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0b95 \u0b95\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc8\u0bc8\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0ba4\u0bbe\u0bbe\u0bb0\u0bb0\u0bbf\u0bbf\u0ba9\u0bcd \u0b85\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0ba3\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc1;\n\n(\u0b92) \u0b8f\u0bb1\u0bcd\u0baa\u0bc1\u0b9f\u0bc8\u0bc8\u0baf\u0bb1\u0bcd\u0baa\u0bbe\u0bbe\u0bb2\u0ba4\u0bbe\u0bbe\u0baf\u0bbf\u0bbf\u0ba9\u0bcd, \u0bb5\u0bbf\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0b9a\u0baa\u0bc8\u0bc8\u0ba4\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0bbe\u0ba9\u0bae\u0bcd;\n\n(\u0b93) \u0b87\u0baf\u0bc8\u0bc8\u0baa\u0bbe\u0bbe\u0ba9 \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bb5\u0bc8\u0bc8 \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bb1\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0ba9\u0bcd \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bbe\u0bb0\u0bae\u0bc1\u0bae\u0bcd; \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd\n\n(\u0b94) \u0b95\u0b9f\u0ba9\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0bbe\u0bbe\u0ba3\u0baf \u0b87\u0b9f\u0bb0\u0bcd \u0bae\u0ba4\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bbf\u0ba9\ufffd \u0ba8\u0b9f\u0bbe\u0bbe\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb2\u0bcd \u0b85\u0bb5\u0b9a\u0bbf\u0bbf\u0baf\u0bae\u0bc6\u0bc6\u0ba9\u0b95\u0bcd \u0b95\u0bb0\u0bc1\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0b95\u0bcd\u0b95\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0bb5\ufffd\u0bb1\u0bc1 \u0b8e\u0bb5\u0bc8\u0bc8\u0baf\ufffd\u0ba9\u0bc1\u0bae\u0bcd \u0ba4\u0b95\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd.\n\n3. \u0b8f\u0bb1\u0bcd\u0baa\u0bc1\u0b9f\u0bc8\u0bc8\u0baf\u0bb1\u0bcd\u0baa\u0bbe\u0bbe\u0bb2\u0ba4\u0bbe\u0bbe\u0ba9 \u0b89\u0b9a\u0bcd\u0b9a\u0bb5\u0bb0\u0bae\u0bcd\u0baa\u0bbe\u0bbe\u0ba9\u0ba4\u0bc1, 2024 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 44 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0baa\u0b95\u0bbf\u0bbf\u0bb0\u0b99\u0bcd\u0b95 \u0ba8\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb0\u0bcd \u0bae\u0bc1\u0b95\u0bbe\u0bbe\u0bae\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1 17 \u0b87\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb0\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bbe\u0bbe\u0ba4 \u0bb5\u0bb0\u0bc8\u0bc8\u0baf\u0bb1\u0bc8\u0bc8\u0baf\u0bbe\u0bbe\u0b95\u0bc1\u0bae\u0bcd."
