9a\u0dca\u0daf\u0dda\u0dda\u0dc0\u0dd3 \u0db4\u0db4\u0dd9\u0dd9\u0da0\u0dd4\u0dc0\u0dcf\u0dcf \u0dc4\u0dd2\u0db8\u0dcf\u0dcf\u0dbd\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dc0\u0db1 \u0db8\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca, 2025 \u0d94\u0d9a\u0dca\u0dad\u0ddd\ufffd\u0ddd\u02ea\u0db6\u0dbb\u0dca 01 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2, \u0db1\u0dd2\u0dbb\u0dca\u0dc0\u0dcf\u0dcf\u0dc3\u0dd2\u0d9a \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4\u0da7 \u0d89\u0dbd\u0dd9\ufffd\u0d9a\u0dca\u0da7\u0dca\u200d\u0dbb\u0ddc\u017e\u0ddc\u0db1\u0dd2\u0d9a \u0dc0\u0dda\u0dda\u0daf\u0dd2\u0d9a\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0dc4\u0dbb\u0dc4\u0dcf\u0dcf \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0dc3\u0dd0\u0dd0\u0db4\u0dba\u0dd3\u0db8\u0dda\ufffd \u0daf\u0dd3, \u0d91\u0db8 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0dc3\u0dd0\u0dd0\u0db4\u0dba\u0dd3\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0d85\u0daf\u0dcf\u0dcf\u0dc5\u0dc0 \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u0daf\u0dd4 \u0d9c\u0dab\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0d91\u0db8 \u0db6\u0daf\u0dca\u0daf \u0d9c\u0dd9\ufffd\u0dc0\u0dd3\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0d86\u0d9a\u0dcf\u0dcf\u0dbb\u0dba \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca 1 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dc1\u0dca\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n\u0dbb\u0dd4\u0d9a\u0dca\u0daf\u0dda\u0dda\u0dc0\u0dd3 \u0db4\u0db4\u0dd9\u0dd9\u0da0\u0dd4\u0dc0\u0dcf\u0dcf \u0dc4\u0dd2\u0db8\u0dcf\u0dcf\u0dbd\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dcf\u0db1\u0dca\u0daf\u0dd4, \u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca.\n\n\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0db8\u0dca \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0,\n\n\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 02,\n\n2025 \u0da2\u0dd4\u0db1\u0dd2 \u0db8\u0dc3 30.\n\nI \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3 : (I) \u0da1\u200d\u0dd9\u0dd9\ufffd\u0daf\u0dba - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.07.012\n\n1 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db1\u0dd2\u0dbb\u0dca\u0dc0\u0dcf\u0dcf\u0dc3\u0dd2\u0d9a \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d89\u0dbd\u0dd9\ufffd\u0d9a\u0dca\u0da7\u0dca\u200d\u0dbb\u0ddc\u017e\u0ddc\u0db1\u0dd2\u0d9a \u0dc0\u0dda\u0dda\u0daf\u0dd2\u0d9a\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0dc4\u0dbb\u0dc4\u0dcf\u0dcf \u0dc3\u0dda\u02e6\u0dda\u0dc0\u0dcf\u0dcf \u0dc3\u0dd0\u0dd0\u0db4\u0dba\u0dd3\u0db8\u0dda\u023c \u0daf\u0dd3 \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u0daf\u0dca\u0daf \u0d85\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8