d3\u0db8\u0dca \u0dc3\u0dc4 \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba.\n\n2025 \u0da2\u0dd4\u0db1\u0dd2 \u0db8\u0dc3 28 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1.\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0daf\u0dd3 \u0dba.\n\nI \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3 : (I) \u0da1\u200d\u0dd9\u0dd9\ufffd\u0daf\u0dba - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.06.302\n\n\u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\n\n\u0dc3\u0d82\u0d82\u0d9b\u0db4\u0dd2\u0da7\u0dca\u0da8\u0dd2 \u0db4\u0dd4\u0dbb\u0dcf\u0dcf\u0dab \u0dc0\u0dd2\u0dc4\u0dcf\u0dcf\u0dbb \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba \u0dc3\u0d82\u0d82\u0dba\u0dd4\u0d9a\u0dca\u0dad \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba\n\n\u0db6\u0dc3\u0dca\u0db1\u0dcf\u0dcf\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\u01ae, \u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda\u024f, \u0d9a\u0da9\u0dd4\u0dc0\u0dd9\u0dd9\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dbd\u0dda\u0262\u0d9a\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f, \u0d85\u0d82\u0d82\u0d9a 473 '\u0d92', \u0d9a\u0da9\u0dd4\u0dc0\u0dd9\u0dd9\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f, \u0d9a\u0da9\u0dd4\u0dc0\u0dd9\u0dd9\u0dbd (\u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3 \u0d85\u0d82\u0d82\u0d9a 3 - \u0d9a\u0da9\u0dd4\u0dc0\u0dd9\u0dd9\u0dbd, \u0d9a\u0da9\u0dd4\u0dc0\u0dd9\u0dd9\u0dbd \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf \u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0 \u0dad\u0dd4\u0dc5) \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8\u0dba\u0dda\u024f \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2, \u0dc3\u0dbb\u0dca\u0dc0\u0dda\u0dda\u0dba\u0dbb\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0d9c\u0dda\u0118 2024 \u0d94\u0d9a\u0dca\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0db6\u0dbb\u0dca \u0db8\u0dc3 16 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0d85\u0d82\u0d82\u0d9a \u0dc3\u0dd3\u0d95/\u0d9a\u0dda\ufffd\u0da9\u0dd3\u0da9\u0db6\u0dca\u0dbd\u0dd2\u0dc0\u0dca/2024/413 \u0daf\u0dbb\u0db1 \u0d85\u0db1\u0dd4\u0dbb\u0dda\u0dda\u0d9b\u0db1\u0dba\u0dda\u024f \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a\u0dba '\u0d92' \u0dbd\u0dd9\ufffd\u0dc3 \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1 \u0dc4\u0dd9\ufffd\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dcf\u0dbb 1.2421\u0d9a \u0dc0\u0dd2\u0dc1\u0dcf\u0dcf\u0dbd\u0dad\u0dca\u0dc0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dba\u0dd4\u0d9a\u0dca\u0dad \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8\u0dca \u0dc0\u0dd6 \u0db6\u0dd2\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba :-\n\n\u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a '\u0d92' - \u0dc4\u0dd2\u0d9a\u0dca\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad \u0dc3\u0dc4 \u0db8\u0dd2\u0dbd\u0dca\u0dbd\u0d9c\u0dc4\u0dbd\u0db1\u0dca\u0daf (\u0dc4\u0dd9\ufffd\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dcf\u0dbb 1.2421)"
