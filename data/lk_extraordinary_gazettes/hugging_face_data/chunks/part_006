c0\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd \u0dcf\u0dbb\u0dd2 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba \u0dad\u0dd4\u0dcf \u0d9c\u0db8\u0dca\u0dba\u0db4\u0ddc\u0dbd\u0dba\u0dc0\u0dbd \u0db1\u0db8\u0dd0\u0dad\u0dd2 \u0d9c\u0dba\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf \u0dc0\u0dd6 \u0daf, \u0d9a\u0d82\u0d9a 327 47 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0dba\u0db8\u0dca \u0d9a\u0dbd\u0dcf\u0db4 \u0d9a\u0d82\u0d9a 8 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a 1 : 2, 1 : 135 \u0dc3\u0db1 1 : 145 \u0daf\u0dbb\u0db1 \u0dc5\u0da9\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0dba\u0dbd\u0dc3 \u0dba\u0db4\u0dca\u0dad\u0dd4\u0dc0\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7 \u0d87\u0dda\u0dcf\u0dcf \u0dc0\u0dd6 \u0daf, \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dd1\u0db8\u0dca \u0dc5\u0dd2\u0dc3\u0dbb\u0dd2\u0db4\u0dda \u0d9a\u0dbb\u0db1 \u0dba\u0dbd\u0dc3 \u0daf\u0dd0\u0dd4\u0dc0\u0db8\u0dca \u0dba\u0daf\u0db8\u0dd2\u0dca\u0dad 1998 \u0d9a\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0dd2\u0dc3\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0db4\u0db1\u0dba\u0dda 12 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb 2724072028 \u0dc0\u0dd0\u0db1\u0dd2 \u0dd2\u0dc3\u0db1 \u0d9a\u0d82\u0d9a 237 448 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda \u0dba\u0dae\u0dcf \u0db4\u0dbb\u0dd2\u0dd2\u0dc3 \u0db4\u0dcf\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u0d82\u0d9a 324793 \u0daf\u0dbb\u0db1 \u0daf\u0dd0\u0dca\u0dad\u0dc0\u0dd3\u0dba\u0db8\u0dca \u0dc3\u0db3\u0db1\u0dca\u0dad \u0dba\u0d9a\u0ddc\u0da7 \u0d87\u0dda\u0dcf\u0dcf \u0dc0\u0dd6 \u0daf, \u0dc5\u0da9\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dc3\u0dca\u0dc0\u0dbd \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0db6\u0dca\u0dad \u0dba\u0dba\u0dca\u0dad \u0dba\u0db8\u0dc4\u0dd2 \u0d8b\u0db4\u0dba\u0dbd\u0dca\u0d9b\u0db1\u0dba\u0dda \u0daf\u0dd0\u0d9a\u0dca\u0d9a\u0dba\u0dba\u0dc0\u0db1 \u0db8\u0dcf\u0dba\u0dda \u0dad\u0dd3\u0dbb\u0dab 1998 \u0d9a\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0dd2\u0dc3\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0db4\u0db1\u0dba\u0dda 14 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba\u0dba\u0dca\u0dad \u0db4\u0db1\u0dcf \u0d9a\u0dda\u0dc3\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0db8\u0dcf \u0dba\u0dc0\u0dcf \u0db4\u0dc0\u0dbb\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb, \u0db8\u0db8 \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dba \u0d9a\u0dbb\u0db8\u0dd20 \u0db4\u0dd3. \u0dc3\u0dd3. \u0da9\u0dd3. \u0dc3\u0dd2\u0dc1\u0dda\u0dbb\u0dcf, \u0dc5\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dbd\u0dca0 2725 \u0da2\u0dd4\u0db1\u0dd2 \u0db8\u0dc3 74 \u0dc0\u0dd0\u0db1\u0dd2 \u0dd2\u0dc3\u0db1, \u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0dbb\u0da2\u0dcf\u0db8\u0dbd\u0dca\u0dc0\u0dda\u0dcf \u0db4\u0dcf\u0dbb, \"\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dcf \u0db8\u0dd0\u0daf\u0dd4\u0dbb\", \u0d9a\u0d82\u0d9a 127747, \u0dc5\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dba\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dcf\u0dba\u0db8\u0dca\u0dca\u0dad\u0dad\u0dd4\u0dba\u0dda \u0daf\u0dd3 \u0dba0\n\n1A - G 044723 - 04 (2025/07) \u0dc3\u0dd00\u0dba\u0dd40- \u0dba\u0db8\u0db8 \u0d9a\u0dad\u0dd2 \u0dc0\u0dd2\u0dba\u0dba\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d