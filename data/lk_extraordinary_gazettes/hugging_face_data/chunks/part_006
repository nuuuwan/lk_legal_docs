dd4, \u0d91\u0db8 \u0db4\u0db1\u0dad\u0dda\u01ae 35 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dcf\u0dcf\u0daf\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0d9c.\n\n\u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a,\n\n\u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2.2025 \u0da2\u0dd4\u0db1\u0dd2 \u0db8\u0dc3 30 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1.\n\n\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0d94 \u0daf\u0dd3\u0dba.\n\n\u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0d9c\n\n1. \u0db8\u0dd9\ufffd\u0db8 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0d9c 2025 \u0dbb\u0dcf\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0dab\u0dba \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0d9c \u0d85\u0d82\u0d82\u0d9a 01 \u0dbd\u0dd9\ufffd\u0dc3 \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n2. \u0dab\u0dba \u0d87\u0db4\u0d9a\u0dbb \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0d9a\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0d85\u0dc3\u0dca\u0dae\u0dd2\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dbd\u0dd2\u0dba\u0d9a\u0dd2\u0dba\u0dc0\u0dd2\u0dbd\u0dd2 (\u0db8\u0dd2\u0db1\u0dca \u0db8\u0dad\u0dd4 \"\u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba\" \u0dbd\u0dd9\ufffd\u0dc3 \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1) \u0dbb\u0dcf\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0dab\u0dba \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba.\n\n(\u0d85) \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc0\u0dc3\u0dbb \u0dad\u0dd4\u0db1 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd2\u0d9c\u0dab\u0db1 \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dcf \u0dc3\u0dc4 \u0dc0\u0dd2\u0d9c\u0dab\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1, \u0d86\u0dc3\u0db1\u0dca\u0db1\u0dad\u0db8 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc0\u0dc3\u0dbb \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd2\u0d9c\u0dab\u0db1\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dbb \u0db1\u0ddc\ufffd\u0ddc\u0db8\u0dd0\u0dd0\u0dad\u0dd2 \u0dc0\u0dd2\u0da7, \u0d86\u0dc3\u0db1\u0dca\u0db1\u0dad\u0db8 \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc0\u0dc3\u0dbb \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd2\u0d9c\u0dab\u0db1\u0dba \u0db1\u0ddc\ufffd\u0ddc\u0d9a\u0dc5 \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0db1\u0dba;\n\nI \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3 : (I) \u0da1\u200d\u0dd9\u0dd9\ufffd\u0daf\u0dba - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.06.302\n\n(\u0d86) \u0d89\u0dad\u0dcf\u0dcf \u0d86\u0dc3\u0db1\u0dca\u0db1\u0dad\u0db8 \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0db1;\n\n(\u0d87) \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db1\u0dd2\u0dc3\u0dd2 \u0db6\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf, \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0dc0\u0dc3\u0dbb \u0dad\u0dd4\u0db1 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb \u0dc3\u0dd0\u0dd0\u0dbd\u0dc3\u0dd4\u0db8\u0dca \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0dc3\u0dc4 \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0db1 \u0d89\u0dbd\u0d9a\u0dca\u0d9a;\n\n(\u0d88) \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0da7 \u0db4\u0dcf\u0dcf\u0daf\u0d9a \u0dc0\u0db1 \u0dab\u0dba \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dda\ufffd \u0dc3\u0db8\u0dc3\u0dca\u0dad \u0d9a\u0dcf\u0dcf\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dab\u0dba \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dca\u0dc2\u0dda\u0dda\ufffd\u0db4\u0dab;\n\n(\u0d89) \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0da7 \u0db4\u0dcf\u0dcf\u0daf\u0d9a \u0dc0\u0db1 \u0dab\u0dba \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dda\ufffd \u0dc3\u0db8\u0dc3\u0dca\u0dad \u0d9a\u0dcf\u0dcf\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0dc3\u0dca\u0dae\u0dd2\u0dad\u0dba\u0dda\u024f \u0dc3\u0dc4 \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dd8\u0dd8\u0dad\u0dd2\u0dba\u0dda\u024f \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dcf\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dca\u0dc2\u0dda\u0dda\ufffd\u0db4\u0dab;\n\n(\u0d8a) \u0dc3\u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a\u0dc0 \u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf (\u0d87\u0db4\u0d9a\u0dbb \u0dc3\u0dc4\u0dd2\u0dad, \u0d87\u0db4\u0d9a\u0dbb \u0dbb\u0dc4\u0dd2\u0dad \u0dc3\u0dc4 \u0d8b\u0db4\u0dab\u0dba, \u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba \u0d85\u0db1\u0dd4\u0dc0, \u0dab\u0dba\u0dc4\u0dd2\u0db8\u0dd2\u0dba\u0dcf\u0dcf \u0d85\u0db1\u0dd4\u0dc0) \u0dc4\u0dd2\u0d9f \u0dab\u0dba \u0dad\u0ddc\ufffd\u0ddc\u0d9c\u0dba;\n\n(\u0d8b) \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0dc4\u0dd2\u0d9f \u0dab\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db1\u0dd2\u0dba\u0db8\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0d9a\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0daf\u0dda\u0dda\u0dc3\u0dd2 (\u0d9a\u0dbd\u0dca\u0db4\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0db4\u0ddc\ufffd\u0ddc\u0dbd\u0dd3 \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0dcf\u0dad\u0dd2\u0d9a\u0dba \u0d87\u0dad\u0dd4\u0dc5\u0dd4\u0dc0);"
