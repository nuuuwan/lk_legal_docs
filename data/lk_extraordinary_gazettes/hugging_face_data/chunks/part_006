dd0\u0da9\u0dd2\u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dd9\ufffd\u0d9a\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf) \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dda\u0dc1\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0db7\u0dd9\u0dcf\u0dca\ufffd\u0dca\ufffd\u0da2\u0db1 \u0d85\u0d9c\u0dba\u0db1\u0dca,\u0dc1\u0d9a\u0dca\u0dad\u0dd2\u0dba -\u0d9a\u0dd2\u0dbd\u0ddd\ufffd\u0ddd\ufffd \u0d9a\u0dd0\u0dd0\u0dbd\u0dbb\u0dd2 2000\u0d9a\u0dcf\u0dcf\u0db6\u0ddd\ufffd\u0ddd\ufffd\u0dc4\u0dba\u0dd2\u0da9\u0dca\u200d\u0dbb\u0dda\u0191\u0da7\u0dca - \u0d9c\u0dca\u200d\u0dbb\u0dd1\u0dd1\u0db8\u0dca 275\u0db8\u0dd4\u0dc5\u0dd4 \u0dc3\u0dd3\u0db1\u0dd2 - \u0d9c\u0dca\u200d\u0dbb\u0dd1\u0dd1\u0db8\u0dca 30\u0db8\u0dda\u023c\u0daf\u0dba - \u0d9c\u0dca\u200d\u0dbb\u0dd1\u0dd1\u0db8\u0dca 67\".\n\n(11) VII \u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dd9\ufffd\u0dc4\u0dd2, \"\u0dc3\u0d82\u0d82\u0d9d\u0da7\u0d9a\u0dba\" \u0dba\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \"\u0db8\u0dda\u023c\u0daf\u0dba\" \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0dba\u0dd2\u0dad\u0db8\u0dba \u0dc3\u0dc4 \u0d8a\u0da7 \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4\u0dd2\u0dba\u0dc0 \"\u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\" \u0dc3\u0dc4 \"\u0d9a\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0daf\u0dda\u0dda\u0dc3\u0dd2\" \u0dba\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0dc0\u0db1 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0d85\u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dbb \u0d92 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca :-\n\n\u0dc3\u0d82\u0d82\u0d9d\u0da7\u0d9a\u0dba\u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0d9a\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0daf\u0dda\u0dda\u0dc3\u0dd2\n\n\"\u0db8\u0dda\u023c\u0daf\u0dba\u0d85\u0da9\u0dd4\u0d9c\u0dca\u200d\u0dbb\u0dd1\u0dd1\u0db8\u0dca 100