2. \u0db4\u0dd3.\u0dc3\u0dd3.\u0da9\u0dd3.\u0dc3\u0dd2\u0dd9\u0d9c\u0dca\u0dbb\u0dcf, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca. 2025 \u0db8\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dc3 20 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0dbb\u0da2\u0db8\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dcf\u0dbb, \"\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dad \u0db8\u0dd0\u0daf\u0dd4\u0dbb\", \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dd9\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca \u0daf\u0dd3 \u0dba.\n\n\u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba\n\n(\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca)\n\n1:31 0.0338 \u0d9c\u0dcf\u0dbb\u0dca\u0daf\u0dd2\u0dd9\u0dba\u0dca\u0dc0\u0dc3\u0db8\u0dca \u0db4\u0dd4\u0d82\u0da0\u0dd2\u0dd9\u0dc4\u0dda\u0dc0\u0dcf\u0dd9\u0d9c\u0dca 455330505V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - - \u0db4\u0dd4\u0dab\u0255\u0dcf\u0dc0\u0d82\u0dc1 \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0dcf \u0d85\u0d82\u0d9a 35, \u0db1\u0db1\u0dca\u0daf\u0dcf \u0db8\u0dcf\u0dc0\u0dad, \u0db1\u0dd4\u0dd9\u0d9c\u0dca\u0dd9\u0d9c\u0ddc\u0da9 1:95 0.0478 1. \u0dc0\u0dd2\u0da2\u0dd2\u0dad \u0db4\u0dc3\u0db1\u0dca\u0db1 \u0db6\u0daf\u0dca\u0dd9\u0daf\u0dc0\u0dd2\u0dad\u0dcf\u0db1 640170166V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 110 \u0dc4\u0dd2 - 2. \u0d8b\u0dc4\u0db1\u0dca\u0d95\u0dc0\u0dd2\u0da7 \u0db8\u0dcf\u0dbb\u0dd9\u0d9c\u0dca \u0dc3\u0dd3\u0dd9\u0daf\u0dca\u0dc0\u0dd2 196558900440 \u0dc3\u0db8 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0dc3\u0db8\u0db1\u0dca\u0db8\u0dcf\u0dbd\u0dcf \u0d85\u0d82\u0d9a 11,12, \u0da9\u0dd3.\u0da9\u0db6\u0dca. \u0dbb\u0dd6\u0db4\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dcf\u0dc0\u0dad, \u0db1\u0dd4\u0dd9\u0d9c\u0dca\u0dd9\u0d9c\u0ddc\u0da9 EOG 06 - 0256/5\n\n5A III \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 : \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba - 2025.06.24"
