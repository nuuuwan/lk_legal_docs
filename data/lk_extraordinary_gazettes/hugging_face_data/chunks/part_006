02a3\u01e6\u0dd9\u01ca\u0286\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae\u0dc0 \u0db6\u0dbd\u0db4\u01b4 \u0d85\u0d82\u0d9a 75/260/2009 \u0dba\u0da7\u0dd9\u01ae \u0dbb\u0dab\u0286\u0d82\u0dc4 \u0d86\u0dbb\u013c\u013d\u0dbd\u0dcf\u0dd9\u0118 \u0da2\u0dba\u0286\u0d82\u0dc4 \u0d85\u0217\u021a\u0dc4\u0dcf\u023d \u0dba\u0db1 \u0d85\u0dba \u0236\u00fa\u01af \u026a\u01cf. 1:49 0.2019 \u0dbb\u0da2\u0dba \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u01ae \u0dd9\u0d9a\u02a3\u01e6\u0dd9\u01ca\u0286\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae\u0dc0 \u0db6\u0dbd\u0db4\u01b4 \u0d85\u0d82\u0d9a 53/260/2009 \u0dba\u0da7\u0dd9\u01ae \u0dbb\u0dab\u0286\u0d82\u0dc4 \u0d85\u0217\u021a\u0dc4\u0dcf\u023d\u0dbd\u0dcf\u0dd9\u0118 \u0dd9\u0dc3\u02a4\u0db8\u0db4\u0dcf\u0dbd \u0dba\u0db1 \u0d85\u0dba \u0236\u00fa\u01af \u026a\u01cf. 1:85 0.0582 \u0dbb\u0da2\u0dba \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u01ae \u0dd9\u0d9a\u02a3\u01e6\u0dd9\u01ca\u0286\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae\u0dc0 \u0db6\u0dbd\u0db4\u01b4 \u0d85\u0d82\u0d9a 141/260/2016 \u0dba\u0da7\u0dd9\u01ae \u0d92\u0d9a\u0db1\u0dcf\u0dba\u0d9a \u023f\u01ce\u0dba\u01e6\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0118 \u01b1\u0dc2\u0dcf\u025c \u0dd9\u0dc3\u0db1\u026a\u0dbb\u01ae\u0db1 \u0dba\u0db1 \u0d85\u0dba \u0236\u00fa\u01af \u026a\u01cf. 1:97 0.1152 \u0dbb\u0da2\u0dba \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u01ae \u0dd9\u0d9a\u02a3\u01e6\u0dd9\u01ca\u0286\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae\u0dc0 \u0db6\u0dbd\u0db4\u01b4 \u0d85\u0d82\u0d9a 32/260/2009 \u0dba\u0da7\u0dd9\u01ae \u0da2\u0dba\u0dbd\u01ae \u0dbb\u0dcf\u0dbd\u0dbd\u0dcf\u0dd9\u0118 \u0d8b\u00fa\u0d9a\u0dd4\u0db8\u0dd0\u019d\u0d9a\u0dcf \u0dba\u0db1 \u0d85\u0dba \u0236\u00fa\u01af \u026a\u01cf. 1:121 0.0286 \u0dbb\u0da2\u0dba \u0dc3\u023c\u02