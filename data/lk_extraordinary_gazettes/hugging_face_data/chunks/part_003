\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 321 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0 \u0dba\u0dcf\u0dcf \u0d85\u0dd2\u0dad\u0dad\u0dd2\u0dba \u0dc3\u0db8 \u0d9a\u0dca\u0dad\u0db1\u0dca\u0dad\u0d9c\u0dbb\u0dba \u0dba\u0dd9\u0dca\u0db1 \u0dd3\u0dbd\u0dbd\u0dcf\u0dc0\u0dad\u0dd3 \u0dba\u0db1 \u0d85\u0dba\u0dba \u0dd3\u0dc0\u0dc1\u0dd9\u0dcf \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dba\u0da7 \u0dba\u0da7\u0dda\u0dc0\u201d \u0dba\u0dca\u0dad\u0db1 \u0d89\u0dc0\u0dda \u0d9a\u0dbb \u201c25:1\u0d85 0.0991\u0d85 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 521010/07/34 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0 \u0dba\u0dcf\u0dcf \u0d85\u0dd2\u0dad\u0dad\u0dd2\u0dba \u0dc3\u0db8 \u0d85 \u0d89\u0dc4\u0dcf \u0dd3\u0dc0\u0dc1\u0dd9\u0dcf \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dba\u0dd9 \u0d89\u0dc0\u0dda \u0d9a\u0dbb\u201d \u0dc3\u0d82\u0dba \u0dca \u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dba\u0dda. \u0db4\u0dd3. \u0dc3\u0dd3. \u0da9\u0dd3. \u0dc3\u0dd2\u0dc1\u0dda\u0dbb\u0dcf, \u0d89 \u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0db0\u0dbb\u0dc0\u0dd4\u0db8 \u0d9a\u0dd2 \u0d9a\u0dba\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0db8. 2025 \u0da2\u0dd4\u0dbd\u0db0 \u0db8\u0dc3 30 \u0dc0\u0dd0\u0dbd\u0db0 \u0daf\u0dd2\u0db1\u0d85 \u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0db8\u0dbd \u0dbb\u0da2\u0dcf\u0db8\u0db8\u0dc0\u0dda\u0dcf \u0db4\u0dcf\u0dbb\u0d85 \u201c\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dcf \u0db8\u0dd0\u0daf\u0dd4\u0dbb\u201d, \u0d85\u0d82\u0d9a 1200/9\u0d85 \u0d89 \u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0db0\u0dbb\u0dc0\u0dd4\u0db8 \u0d9a\u0dd2 \u0d9a\u0dba\u0db8\u0dca \u0dba\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dcf\u0dba\u0db8\u0dca\u0dca\u0dad\u0dc5 \u0dba\u0dda \u0daf\u0dd3 \u0dba. EOG 07 - 0176/3\n\n\u0dc3\u0dd2\u0d82\u0dc1\u0dd9\u0ddd\u0db0\u0db1\n\n1998 \u0d85\u0dd2\u0d82 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0