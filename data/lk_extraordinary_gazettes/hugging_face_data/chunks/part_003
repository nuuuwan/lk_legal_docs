 \u0dbd\u0daf \u0d85\u0d82\u0d9a \u0dd9\u00fa\u0253/\u0dd9\u00fa\u0d86\u0259\u0d91\u01e6/2019/439 \u0daf\u0dbb\u0db1 2019.12.26 \u01ce\u0db1\u0dd0\u01af \u021d\u0d9c\u0db8\u0db1 \u0d85\u01e9\u0dd9\u0259\u0d9b\u0db1\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 1 \u0286\u0da7 11 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0dd9\u0db4\u01e6\u01e9\u023c \u0d9a\u0dbb \u0d87\u01af \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0693 \u00fa \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0db1\u023c \u0dc0\u0263\u01e6 \u0dc4\u0dcf \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0252\u01ae \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0dd0\u0263\u0dc0\u0dbd\u0da7 \u0db8\u0dcf\u0250\u023c:\n\n01. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 1 - \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a - \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 01. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 1 - \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a - \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0073 0.0073 \u0d8b\u01b1\u0dbb\u0da7: \u0d92.\u0219 \u00fd\u0dbd\u0dbb\u01ae\u0db1 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u021a\u0262\u0dbd\u0dcf\u0db1\u0dd9\u0d9a\u02a3\u017b\u0dc0 \u0dc3\u0dc4 \u0da9\u0229\u0263\u0269.\u026b \u0da0\u0dcf\u0db8\u0dbb \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u021a\u0262\u0dbd\u0dcf\u0db1\u0dd9\u0d9a\u02a3\u017b\u0dc0; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7 : \u0da9\u0229\u0263\u0269.\u026b. \u0da0\u0dcf\u0db8\u0dbb \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u021a\u0262\u0dbd\u0dcf\u0db1 \u0dd9\u0d9a\u02a3\u017b\u0dc0; \u0daf\u00fd\u0dab\u0da7 : 5 \u0dc3\u0dc4 4 \u0dc0\u0dd0\u01e7 \u022a\u023c \u0d9a\u0dd0\u0db6\u0263; \u0db6\u0da7\u028f\u0dbb\u0da7 : 3 \u0dc3\u0dc4 2 \u0dc0\u0dd0\u01e7 \u022a\u023c \u0d9a\u0dd0\u0db6\u0263.\n\n02. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d