    "chunk_text": "\u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e\u0dd9\u0118 \u0d8b\u0d9c\u01ae \u01e8\u01b0\u0da5 \u0db8\u0dc4\u0dad\u0dcf \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0dd9\u0d9c\u01e6 \u01cf\u0259\u0d9d \u0dd9\u0dbd\u0dc3 \u0dc4\u0dbb\u0dc3\u0dca \u021d\u0dc1\u0dca\u0db1 \u0d85\u0dc3\u023d\u01e6 \u0d8b\u01ae\u0dc3\u0dcf\u0dc4 \u0d9a\u0dbb\u0db1 \u0dbd\u01ca\u0dd9\u01ca \u0d89\u0262\u0265\u023c\u0d9a\u025e \u0db8\u0dcf\u0259\u0d9c \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dba \u0dba\u0da7\u0dd9\u01ae 1987.05.04 \u0dc0\u0db1 \u01ce\u0db1 \u0286\u0da7 \u0d85\u01e7\u0dba\u023c \u0d9a\u0dcf\u0259\u023d\u0d9a \u01e7\u0dc5\u0db0\u0dcf\u025d \u0db4\u01ae\u026b\u023c \u0dbd\u0db6\u0dcf\u0dd9\u0d9c\u0db1 \u0d87\u01ae\u0dd9\u01ae \u023f\u0263\u0d9a \u0288\u01d0\u0288\u0d9a\u023c \u0dc3\u021a\u0dbb\u0dcf \u0dd9\u0db1\u02a3\u01af\u022a\u0dba\u01cf \u0d85\u0dba\u0dae\u0dcf \u026a\u01ce\u0dba\u0da7 \u0db6\u0dc0\u01ae, \u0d8a\u0da7 \u0dd9\u0dc4\u02a2\u01b1 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e \u0d89\u0262\u0266\u023c\u0d9a\u025e\u0da7 \u0da2\u0dcf\u01af\u0d9a \u0d86\u01df\u01e7\u0d9a\u01ae\u0dc0 \u0db8\u019c\u0da9\u0dbd\u0dba \u0db8\u0119\u01e6 \u0218\u025c\u0db1\u0db8\u0db1 \u0dbd\u0daf \u026a\u0dd9\u0dc1\u02a2\u0dc2 \u0d86\u01df\u01e7\u0d9a\u01ae\u0dc0 \u0da2\u0dcf\u01af\u0d9a \u0dc3\u0dc4\u01af\u0d9a\u0dba \u0dbd\u0dd0\u022b \u0d87\u01ae\u0dd9\u01ae 1988.04.11 \u0dc0\u0db1 \u01ce\u0db1 \u0db6\u0dc0\u0da7 \u0dba\u01e6\u0db1\u0dba. \u0dd9\u0db8\u0db8 \u0dad\u01ae\u01ae\u0dc0\u0dba \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e\u0dd9\u0118 \u01e8\u01af\u0da5 \u0db8\u0dc4\u0dad\u0dcf \u026a\u0286\u01e6 \u01ce\u0119\u01e6 \u01ce\u0d9c\u0da7\u0db8 \u0d8b\u018d \u0dba\u0179\u00fd\u025e \u0d9a\u0dbb\u023d\u01e6 \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0dd9\u0d9c\u01e6 \u01ce\u0259\u0d9d \u0dd9\u0dbd\u0dc3 \u0dc4\u0dbb\u0dc3\u0dca \u021d\u0dc1\u0dca\u0db1 \u0d85\u0dc3\u0db1 \u0dbd\u01cf. \u0db1\u023f\u01ae \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u0dcf\u0dbb \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dd9\u0dba\u01e6 \u0d91\u0dd9\u0dc3\u02a2 \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0dd9\u0d9c\u01e6 \u0dc4\u0dbb\u0dc3\u0dca \u021d\u0dc1\u0dca\u0db1 \u0d85\u0dc3\u0dcf \u0d87\u0dad. \u0db1\u023f\u01ae \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u0dcf\u0dbb \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba \u0d91\u0dd9\u0dc3\u02a2 \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0dd9\u0d9c\u01e6 \u0dc4\u0dbb\u0dc3\u0dca \u021d\u0dc1\u0dca\u0db1 \u0d85\u0dc3\u0dcf \u0d87\u01ae\u0dd9\u01ae \u01e7\u0dd9\u0dba\u02a4\u0d9c \u0dc3\u0d82\u011e\u0dc4\u0dd9\u024f 21(2) \u01e7\u0dd9\u0dba\u02a4\u0d9c\u0dd9\u024f \u021d\u0d9a\u0dcf\u0dbb \u0dad\u0db8 \u0dd9\u0daf\u0dc0\u0db1 \u021d\u0d9a\u0dcf\u0dc1\u0dba \u0dd9\u0d9c\u02a3\u01e9 \u0d9a\u0dbb\u023d\u01e6 \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0dd9\u0118 \u0db4\u0dc5\u023f \u021d\u0d9a\u0dcf\u0dc1\u0dd9\u024f \u0d9a\u025e\u019f \u0d85\u0d82\u0d9a 1 \u0286\u0da7 8 \u0daf\u00fa\u0dc0\u0dcf \u026d \u0d9a\u025e\u019f \u0218\u0298\u0dd9\u0d9c\u0db1 \u01af\u0dd9\u0db6\u0db1 \u0db4\u0288\u022a\u0db8\u0d9a\u01cf\u0dba. \u0d92 \u0d85\u01e9\u0dc0 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u0dcf\u0dbb \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba \u026a\u0286\u01e6 \u0d9c\u025e \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dba\u0da7 \u0dc3\u0dad\u0255 \u0d9a\u025e\u019f \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u023d\u01e6 \u0dc3\u0dc4\u0dcf\u0dba \u0daf\u00fa\u0dc0\u0db1\u0dc0\u0dcf \u0dd9\u0dc0\u01e9\u0dc0\u0da7 \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0dc0 \u0db8\u0dcf\u0db1\u0286\u0d9a \u0219\u0da9\u0dcf\u0dc0\u0d9a\u0da7 \u0dbd\u00fa \u0d9a\u0dbb\u023d\u01e6 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e \u026a\u0286\u01e6\u0db8 \u0218\u0298\u0dd9\u0d9c\u0db1 \u0d87\u01af \u0d9a\u025e\u019f \u0d89\u0262\u0265\u023c\u0d9a\u025e \u0dd9\u0db1\u02a3\u0db8\u0d9f \u0dba\u0dc0\u023d\u01e6 \u0dc4\u0dbb\u0dc3\u0dca \u021d\u0dc1\u0dca\u0db1 \u0d85\u0dc3\u0dcf \u0d87\u01af \u0dad\u01ae\u01ae\u0dc0\u0dba \u026a\u0dc1\u0dca\u0dd9\u0262\u0dc2\u0dab\u0dcf\u01ae\u0db8\u0d9a\u0dc0 \u026a\u0dc1\u0dca\u0dd9\u0262\u0dc2\u0dab\u0dba \u00fb\u025d\u0dd9\u023c\u01cf \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e \u0dd9\u0118 \u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbb\u0dba \u021d\u01af\u0db6\u01e6\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0dd9\u0d9c\u0db1 \u0d87\u0dad.\n\n\u0d91\u0db8 \u0dad\u01ae\u01ae\u0dc0\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dd9\u0db8\u0db8 \u0db1\u018d\u0dd9\u0269 \u0d89\u0262\u0265\u023c\u0d9a\u025e \u023f\u0262 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u0286\u0da7\u0db8 \u0d9c\u01ae \u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbb\u0dba \u0dc0\u0db1 \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u01e8\u023c \u0db4\u0179\u0db4\u0dcf\u0179\u0dba\u0da7 \u0d85\u01e9\u0dc0 \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0da7 \u0288\u01d0\u0288\u0d9a\u023c \u01af\u022a\u0dba\u01cf \u0d92 \u0d92 \u0dc0\u0d9a\u0dc0\u0dcf\u01e9 \u0dc0\u0dbd\u01cf \u028f\u023d\u026a\u0dba \u0252\u01b1 \u0dd9\u0279\u02a2\u019d\u0d9c\u0dad \u0d8b\u0dc3\u0dc3\u0dca\u026b\u023c \u0dc4\u0dcf \u0dad\u0db1\u01b1\u025e \u0dbd\u0db6\u0dcf \u0dd9\u0db1\u02a3\u01cf\u0dd9\u0db8\u01e6 \u0dad\u0db8\u0dcf\u0da7 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0286\u01d0\u0d9a\u0dbb \u0d87\u01af \u0db6\u0dc0\u0da7 \u0dc3\u0dad\u0255\u0dad\u0dcf \u0dc0\u0dd0\u018b\u0db6\u0dbb \u0dc3\u0dcf\u00fa\u027f \u0db8\u0119\u01e6 \u0dad\u0dc4\u026c\u025e \u0d9a\u0dbb \u0d87\u0dad.\n\n7AI I \u0dd9\u0d9a\u02a3\u0da7\u0dc3: \u0dd9\u0d9a\u02a3\u0da7\u0dc3: (I) (I) \u0dd9\u0da1\u0daf\u0dba \u0dd9\u0da1\u0daf\u0dba \u2013 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u2013 2025.07.22\u2013 2025.07.22\n\n\u0d85\u0db1\u01b1\u025e\u0dc0 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e \u0dad\u0db8\u0dcf\u0dd9\u0118 \u0db1\u018d\u0dc0 \u0d86\u0dbb\u023c\u0db7 \u0d9a\u0dbb\u023d\u01e6 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e\u0dd9\u0118 \u0dc3\u0dcf\u00fa\u027f\u0d9a\u025e \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u021a\u0dc2\u0dca\u0db4\u0dcf \u0db4\u01ae\u023d\u019d \u026a\u0100\u0db8\u0286\u0d82\u0dc4 \u026a\u0dad\u0dcf\u0db1 \u0db8\u0dc4\u01ae\u023d\u0dba \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0dd9\u0118 \u023f\u0263\u0d9a \u0dc3\u0dcf\u00fa\u027f\u0dba 2022.02.02 \u01ce\u0db1 \u0d9c\u025e \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dba\u0da7 XI \u0dd9\u0262\u0d9b\u0db1\u0dba \u0dc3\u0db8\u0d9f \u0dd9\u0d9c\u02a3\u01e9 \u0d9a\u0dbb\u0db1 \u0dbd\u01cf.\n\n\u0dd9\u0db8\u0db8 \u0dc3\u0dcf\u00fa\u027f\u0d9a\u0dcf\u025c\u0dba \u0dad\u0db8 \u01ce\u026c\u025e\u023c \u021d\u0d9a\u0dcf\u0dc1\u0dd9\u024f \u0dd9\u0146\u0daf \u0d85\u0d82\u0d9a 3 \u0dc3\u0dc4 4 \u0dba\u0da7\u0dd9\u01ae \u00fb\u0dba\u01e6\u0dd9\u01e6 \u0dd9\u0db8\u0db8 \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0da7 \u0d89\u0dc4\u0dad \u0d89\u0262\u0264\u023c \u0252\u00fa\u01af \u0dc3\u0dc4\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc0\u0db1 \u0db6\u0dc0\u01ae, \u0d91\u028f \u0dd9\u0146\u0daf 4A, 4B,5 \u0dc3\u0dc4 6 \u0db8\u0119\u01e6 \u00fb\u0dba\u01e6\u0dd9\u01e6 \u0240\u0263\u0d9a \u0288\u01d0\u0288\u0d9a\u023c \u0dc3\u021a\u0dbb\u0dcf \u0dd9\u0db1\u02a3\u01af\u022a\u0dba\u01cf A1 \u0daf\u0dbb\u0db1 \u0db4\u01ae\u026b\u023c \u0dc0\u0d82\u0da0\u0dcf \u0dc3\u0dc4\u0d9c\u0dad\u0dc0 \u0dbd\u0db6\u0dcf \u0dd9\u0d9c\u0db1 \u0d87\u01af \u0db6\u0dc0\u01ae, \u0db8\u0dcf\u0259\u0d9c \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0d85\u01dd\u0d9a\u0dcf\u025d\u0dba \u0dba\u0da7\u0dd9\u01ae \u0d91\u00fb \u0db4\u01ae\u026b\u0db8 \u0db8\u0dcf\u0dc3 06 \u00fb\u01e6 \u01cf\u0259\u0d9d \u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0db8 \u0dc0\u0d82\u0da0\u0dcf \u0dc3\u0dc4\u0d9c\u0dad \u0db6\u0dc0\u01ae \u0dba\u01e6\u0db1\u0dba.\n\n\u023f\u0263\u0d9a \u0dc3\u0dcf\u00fa\u027f \u0dd9\u0146\u0daf \u0d85\u0d82\u0d9a 9 \u0dba\u0da7\u0dd9\u01ae \u00fb\u0dba\u01e6\u0dd9\u01e6 6 \u0dc0\u0db1 \u0dd9\u0279\u02a2\u019d\u0dd9\u024f \u0d9a\u0dcf\u0259\u023d\u0d9a \u01e7\u0dc5\u0db0\u0dcf\u025d \u0dad\u0db1\u01b1\u0dbb \u0dc3\u0db3\u0dc4\u0dcf A14C \u0d85\u01e9\u0dc0 7 \u0dc0\u0db1 \u0dd9\u0279\u02a2\u019d\u0dd9\u024f \u0d9a\u0dcf\u0259\u023d\u0d9a \u01e7\u0dbd\u0db0\u0dcf\u025d \u0dad\u0db1\u01b1\u0dd9\u0259 \u0dc0\u0dc3\u0dbb 7 \u00fa \u0dd9\u0dc3\u02a2\u0dc0\u0dba \u0d9a\u0dc5 \u0252\u01b1 \u0db6\u0dc0\u0da7 \u0d89\u0262\u0265\u023c\u0d9a\u025e \u0218\u0298\u0dd9\u0d9c\u0db1 \u0d87\u01af \u0db6\u0dc0\u0dba."
