dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0,\u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd \u0dc3\u0d82\u0d82\u0d9a\u0dd3\u0dbb\u0dca\u0dab\u0dba, \u0db1\u0dc0 \u0db1\u0d9c\u0dbb\u0dba, \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb.\n\n\u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\n\n\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda\u024f \u0db1\u0db8\n\n\u0dad\u0dda\ufffd\u0dbb\u0dd3\u0db4\u0dad\u0dca \u0dc0\u0dd6 \u0db0\u0dd6\u0dbb\u0dba\u0dad\u0dda\ufffd\u0dbb\u0dd3 \u0db4\u0dad\u0dca \u0dc0\u0dd6 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad\u0dda\ufffd\u0dbb\u0dd3 \u0db4\u0dad\u0dca \u0dc0\u0dd6 \u0daf\u0dd2\u0db1\u0dba\n\n\u0d9a\u0dd1\u0dd1\u0d9c\u0dbd\u0dca\u0dbd\u0daf\u0dd0\u0dd0\u0dbb\u0dab\u0dd2\u0dba\u0d9c\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dbb\u0dab\u0dc3\u0dd2\u0d82\u0d82\u0dc4 \u0d89\u0db1\u0dca\u0daf\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0dcf\u0daf\u0dca \u0dbb\u0dab\u0dc3\u0dd2\u0d82\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dcf\u0dcf2025.07.08\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0db4\u0dbb\u0dab \u0db4\u0dda\u0dda\u0da9\u0dd2\u0dba\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0dd2\u0db8\u0dbd\u0dca \u0dc3\u0ddd\ufffd\u0ddd\u02ea\u0db8\u0dc3\u0dd2\u0dbb\u0dd2 \u0db8\u0dc4\u0dad\u0dcf\u0dcf2025.07.08\n\nEOG 08 - 0066\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dbb\u0da2\u0dba\u0dda\u024f \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0d