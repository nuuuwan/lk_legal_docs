5.07.172A\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3\n\n\u0b95\u0b9f\u0bb5\u0ba4\u0bcd\u0b95\u0bae \u0bb0\u0b9c \u0baa\u0bbf\u0bb9\u0bbf\u0bb2\u0bcd\u0bb2\u0bb5\u0bbf\u0ba9\u0bcd \u0bc6\u0ba4\u0bbe\u0bb2\u0bcd\u0bc6\u0baa\u0bbe\u1f9e\u0bb3\u0bbf\u0baf\u0bb2\u0bcd \u0bc7\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0b95 \u0b92\u1f90\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0b9f\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a\u0bae\u0bcd\u0b95\u0b9f\u0bb5\u0ba4\u0bcd\u0b95\u0bae \u0bb0\u0b9c \u0baa\u0bbf\u0bb9\u0bbf\u0bb2\u0bcd\u0bb2\u0bb5\u0bbf\u0ba9\u0bcd \u0bc6\u0ba4\u0bbe\u0bb2\u0bcd\u0bc6\u0baa\u0bbe\u1f9e\u0bb3\u0bbf\u0baf\u0bb2\u0bcd \u0bc7\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0b95 \u0b92\u1f90\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0b9f\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a\u0bae\u0bcd"
