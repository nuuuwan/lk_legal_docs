\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dbb\u0da2\u0dba\u0dda\u024f \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u023c\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\n\n\u0daf\u0dd9\u0dd9\u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\n\n\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc4\u0dcf\u0dcf \u0d92 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0da7 \u0dba\u0dcf\u0dcf\u0db6\u0daf \u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0da2\u0dbd \u0dad\u0dd3\u0dbb\u0dba\n\n\u0d9c\u0db8\u0dca\u0db4\u0dc4 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc4\u0dcf\u0dcf \u0d92 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0da7 \u0dba\u0dcf\u0dcf\u0db6\u0daf \u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0da2\u0dbd \u0dad\u0dd3\u0dbb\u0dba\n\n\u0d9a\u0dc5\u0dd4\u0dad\u0dbb \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc4\u0dcf\u0dcf \u0d92 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0da7 \u0dba\u0dcf\u0dcf\u0db6\u0daf \u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0da2\u0dbd \u0dad\u0dd3\u0dbb\u0dba\n\n\u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\n\n\u0db8\u0dcf\u0dcf\u0dad\u0dbd\u0dda\u0262 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\n\n\u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\n\n\u0d9c\u0dcf\u0dcf\u0dbd\u0dca\u0dbd \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc4\u0dcf\u0dcf \u0d92 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0da7 \u0dba\u0dcf\u0dcf\u0db6\u0daf \u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0da2\u0dbd \u0dad\u0dd3\u0dbb\u0dba\n\n\u0db8\u0dcf\u0dcf\u0dad\u0dbb \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc4\u0dcf\u0dcf \u0d92 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0da7 \u0dba\u0dcf\u0dcf\u0db6\u0daf \u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0da2\u0dbd \u0dad\u0dd3\u0dbb\u0dba\n\n\u0dc4\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0ddc\ufffd\u0ddc\u0da7 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc4\u0dcf\u0dcf \u0d92 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0da7 \u0dba\u0dcf\u0dcf\u0db6\u0daf \u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0da2\u0dbd \u0dad\u0dd3\u0dbb\u0dba\n\n\u0dba\u0dcf\u0dcf\u0db4\u0db1\u0dba \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc4\u0dcf\u0dcf \u0d92 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0da7 \u0dba\u0dcf\u0dcf\u0db6\u0daf \u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0da2\u0dbd \u0dad\u0dd3\u0dbb\u0dba\n\n\u0d9a\u0dd2\u0dbd\u0dd2\u0db1\u0ddc\ufffd\u0ddc\u0da0\u0dca\u0da0\u0dd2\u0dba \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dc4\u0dcf\u0dcf \u0d92 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0da7 