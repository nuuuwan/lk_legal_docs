cd\u0bb2\u0ba4\u0bc1 \u0ba4\u0731\u0bb3\u0bcd \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd \u0736\u0b9a\u0731\u0ba8\u0bcd\u0ba4\u0b95\u0bcd\u0b95\u0731\u0bb0\u0bb0\u0bcd/ \u0736\u0b9a\u0731\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0737\u0ba4\u0b9a\u0732\u0baf \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0731\u0732\u0baf \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0ba4\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba9\u0732\u0baf\u0731\u0bb0\u0bc1\u0b95\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0731\u0bb0\u0bb0\u0bcd\u0b95\u0bb3\u0732\u0ba9\u0bcd \u0bae\u0bc1\u0bb4\u0bc1\u0baa\u0bcd \u0736\u0baa\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b85\u0738\u0b9f\u0baf\u0731\u0bb3 \u0b87\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bae\u0bcd \u0b88\u0b9f\u0bc1, \u0b95\u0bc1\u0ba4\u0bcd \u0b95\u0bc1\u0731\u0732\u0baf \u0b9a\u0b9f\u0bcd\u0b9f\u0b99\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd (\u0736\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0731\u0bb0\u0bcd) \u0bae\u0bc1\u0b95\u0bb5\u0731\u0732\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0738\u0b9f \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd \u0b87\u0baf\u0bb2\u0bcd\u0baa\u0bc1\u0bae\u0bcd \u0ba4\u0738\u0b95 \u0b95\u0bb3\u0bc1\u0bb3\u0bcd \u0b8e\u0bb5\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0b87\u0bb2. \u0ba4\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd \u0bb5\u0738\u0b95\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b87\u0bb2. \u0b95\u0b9f\u0bcd\u0b9f\u0738\u0bb3 \u0b85\u0738\u0bae\u0ba8\u0bcd\u0ba4\u0732\u0bb0\u0bc1\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0732\u0baf \u0baa\u0732\u0ba9\u0bcd \u0bb5\u0732\u0baa\u0bb0\u0b99\u0bcd \u0bb5\u0732\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bb3\u0bcd 1:86 0.2723 \u0baa\u0ba4\u0bcd\u0ba4\u0732\u0bb0\u0731\u0b9c \u0bae\u0bc1\u0ba4\u0732\u0baf\u0ba9\u0bcd\u0737\u0b9a\u0bb2\u0731\u0737\u0b95 \u0b9c\u0baf\u0737\u0b9a\u0ba9 650713311V \u0bae\u0bc1\u0bb4\u0bc1\u0bb5\u0ba4\u0bc1\u0bae\u0bcd 1\u0bae\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1 \u0baa\u0ba4\u0bcd\u0ba4\u0732\u0bb0\u0731\u0b9c _\n\n\u0b85\u0bae\u0bcd\u0baa\u0b95\u0b9f\u0bb5\u0bb0, \u0bae\u0bc1\u0ba4\u0732\u0baf\u0ba9\u0bcd\u0737\u0b9a\u0bb2\u0731\u0737\u0b95\n\n\u0b95\u0ba9\u0ba4\u0bcd\u0737\u0ba4\u0736\u0bb5\u0bb5. \u0b95\u0bb0\u0bc1\u0ba3\u0731\u0bb5\u0ba4\u0733\n\n\u0b8e\u0ba9\u0bcd\u0baa\u0bb5\u0731\u0732\u0ba9\u0bcd\n\n\u0b9a\u0733\u0bb5\u0732\u0baf\n\n\u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0732\u0bb1\u0bcd\u0b95\u0bc1\n\n\u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. EOG 07 - 0206/28\n\n1998 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0732\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\n\n14 \u0b86\u0bae\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bcd \u0b95\u0733\u0bb4\u0bcd \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba8\u0732\u0bb0\u0bcd\u0ba3\u0baf \u0b86\u0738\u0ba3\u0baf\u0731\u0bb3\u0731\u0732\u0ba9\u0bcd \u0ba4\u0733\u0bb0\u0bcd\u0bae\u0731\u0ba9\u0ba4\u0bcd\u0738\u0ba4 \u0736\u0bb5\u0bb3\u0732\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\n\n1998 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0732\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0bcd 14 \u0b86\u0bae\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bcd \u0b95\u0733\u0bb4\u0bcd \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1\u0731\u0732\u0ba4\u0bcd\u0ba4\u0731\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0732\u0ba9\u0bcd \u0baa\u0baf\u0738\u0ba9\u0b95\u0bcd\u0736\u0b95\u0731\u0ba3\u0bcd\u0b9f\u0bc1, \u0b95\u0733\u0737\u0bb4 \u0b92\u0baa\u0bcd\u0baa\u0bae\u0732\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba8\u0731\u0ba9\u0bcd, 1998 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0732\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0bcd 12 \u0b86\u0bae\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bcd \u0ba8\u0732\u0baf\u0ba4\u0732\u0b95\u0bb3\u0732\u0ba9\u0bcd\u0baa\u0b9f\u0bbf 2018.09.14 \u0b86\u0ba8\u0bcd \u0ba4\u0732\u0b95\u0ba4\u0732\u0baf, 2088/68 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0731\u0ba9\u0732\u0baf\u0732\u0bb2\u0bcd \u0b89\u0731\u0732\u0baf \u0bae\u0bc1\u0738\u0bb1\u0baf\u0732\u0bb2\u0bcd \u0736\u0bb5\u0bb3\u0732\u0baf\u0732\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\u0bae\u0bcd, \u0b95\u0731\u0ba3\u0732\u0b95\u0bcd\u0b95\u0731\u0ba9 \u0b89\u0731\u0732\u0738\u0bae\u0b95\u0bcd \u0737\u0b95\u0731\u0731\u0732\u0b95\u0bcd\u0738\u0b95\u0b95\u0738\u0bb3\u0b95\u0bcd \u0737\u0b95\u0731\u0bb0\u0bc1\u0b95\u0732\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1\u0bae\u0731\u0ba9 42/0610 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b85\u0bb1\u0732\u0bb5\u0732\u0ba4\u0bcd\u0ba4\u0bb2\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0732\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bc1 \u0736\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0b9f\u0737\u0bae\u0bb2\u0bcd \u0bae\u0731\u0b95\u0731\u0ba3\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd, \u0b95\u0bc1\u0bb0\u0bc1\u0ba8\u0731\u0b95\u0bb2\u0bcd \u0bae\u0731\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd, \u0bb5\u0731\u0731\u0732\u0baf\u0736\u0baa\u0731\u0bb2 \u0baa\u0732\u0bb0\u0737\u0ba4\u0b9a \u0736\u0b9a\u0baf\u0bb2\u0731\u0bb3\u0bb0\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0bb2\u0bcd, \u0b87\u0bb2. 1263 - \u0b85\u0bae\u0bcd\u0baa\u0b95\u0b9f\u0bb5\u0bb0 \u0b95\u0732\u0bb0\u0731\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bc1\u0bb3\u0bcd \u0b85\u0bae\u0bcd\u0baa\u0b95\u0b9f\u0bb5\u0bb0 \u0b95\u0732\u0bb0\u0731\u0bae\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0b85\u0738\u0bae\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0bae\u0bcd 420948 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb0\u0bb2\u0bcd \u0b85\u0bb3\u0738\u0bb5 \u0bb5\u0738\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0bc1 \u0b87\u0bb2. 04 \u0b87\u0bb2\u0bcd \u0b85\u0b9f\u0b99\u0bcd\u0b95\u0732\u0baf\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0bae\u0731\u0ba9 3 : 1, 3 : 2, 3 : 3 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 3 : 4 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0738\u0bb3\u0b95\u0bcd \u0736\u0b95\u0731\u0ba3\u0bcd\u0b9f \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0731\u0ba9 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0736\u0ba4\u0731\u0b9f\u0bb0\u0bcd\u0baa\u0731\u0b95 \u0b87\u0ba4\u0737\u0ba9\u0731\u0b9f\u0bc1 \u0b87\u0738\u0ba3\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0738\u0ba3\u0baf\u0732\u0bb2\u0bcd \u0ba4\u0bb0\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0bb5\u0731\u0bb1\u0731\u0ba9 \u0b8e\u0ba9\u0ba4\u0bc1 \u0ba4\u0733\u0bb0\u0bcd\u0bae\u0731\u0ba9\u0ba4\u0bcd\u0738\u0ba4 \u0b87\u0ba4\u0bcd\u0ba4\u0731\u0bb2\u0bcd \u0736\u0bb5\u0bb3\u0732\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0732\u0ba9\u0bcd\u0737\u0bb1\u0ba9\u0bcd."
