737\u0b9a\u0731\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bb0\u0b9a\u0bc1 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0731\u0ba9\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0732\u0731\u0732\u0738\u0b95 - \u0b85\u0ba4\u0732 \u0bb5\u0732\u0737\u0b9a\u0bb7\u0bae\u0731\u0ba9\u0ba4\u0bc1 - 2025.07.16\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0738\u0ba3 (\u0736\u0ba4\u0731\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0732)\n\n\u0b95\u0731\u0ba3\u0732 \u0bb5\u0732\u0737\u0b9a\u0b9f \u0bb5\u0bb4\u0b95\u0bcd\u0b95\u0732\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0ba4\u0731\u0bb3\u0bcd \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd \u0736\u0b9a\u0731\u0ba8\u0bcd\u0ba4\u0b95\u0bcd\u0b95\u0731\u0bb0\u0bb0\u0bcd/ \u0736\u0b9a\u0731\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0737\u0ba4\u0b9a\u0732\u0baf \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0731\u0732\u0baf \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0ba4\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba9\u0732\u0baf\u0731\u0bb0\u0bc1\u0b95\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0731\u0bb0\u0bb0\u0bcd\u0b95\u0bb3\u0732\u0ba9\u0bcd \u0bae\u0bc1\u0bb4\u0bc1\u0baa\u0bcd \u0736\u0baa\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b85\u0738\u0b9f\u0baf\u0731\u0bb3 \u0b87\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bae\u0bcd \u0b88\u0b9f\u0bc1, \u0b95\u0bc1\u0ba4\u0bcd \u0b95\u0bc1\u0731\u0732\u0baf \u0b9a\u0b9f\u0bcd\u0b9f\u0b99\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd (\u0736\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0731\u0bb0\u0bcd) \u0bae\u0bc1\u0b95\u0bb5\u0731\u0732\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0738\u0b9f \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd \u0b87\u0baf\u0bb2\u0bcd\u0baa\u0bc1\u0bae\u0bcd \u0ba4\u0738\u0b95 \u0b95\u0bb3\u0bc1\u0bb3\u0bcd \u0b8e\u0bb5\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0b87\u0bb2. \u0ba4\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd \u0bb5\u0738\u0b95\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b87\u0bb2. \u0b95\u0b9f\u0bcd\u0b9f\u0738\u0bb3 \u0b85\u0738\u0bae\u0ba8\u0bcd\u0ba4\u0732\u0bb0\u0bc1\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0732\u0baf \u0baa\u0732\u0ba9\u0bcd \u0bb5\u0732\u0baa\u0bb0\u0b99\u0bcd \u0bb5\u0732\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bb3\u0bcd\n\n1:94 0.2479 \u0736\u0b95\u0731\u0bb3\u0bae\u0bcd\u0baa\u0737\u0b95 \u0b85\u0bb0\u0bc1\u0ba3 \u0baa\u0732\u0bb0\u0ba4\u0733\u0baa\u0731 200151000368 \u0bae\u0bc1\u0bb4\u0bc1\u0bb5\u0ba4\u0bc1\u0bae\u0bcd 1\u0bae\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1 \u0736\u0b95\u0731\u0bb3\u0bae\u0bcd\u0baa\u0737\u0b95 _\n\n\u0736\u0b95\u0731\u0b9f\u0bbf\u0b95\u0731\u0bb0 \u0b86\u0731\u0732\u0baf\u0baa\u0731\u0bb2\n\n\u0baa\u0bb9\u0bb3 \u0b95\u0bb2\u0baa\u0732\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0731\u0b95\u0bae, \u0b8e\u0ba9\u0bcd\u0baa\u0bb5\u0731\u0732\u0ba9\u0bcd\n\n\u0ba8\u0732\u0b95\u0bcd\u0b95\u0bb5\u0bb0\u0b9f\u0bcd\u0b9f\u0bbf\u0baf. \u0b9a\u0733\u0bb5\u0732\u0baf\n\n\u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0732\u0bb1\u0bcd\u0b95\u0bc1\n\n\u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.\n\n1:95 0.1551 \u0736\u0b95\u0731\u0b9f\u0bbf\u0b95\u0731\u0bb0 \u0b86\u0bb0\u0731\u0b9a\u0bcd\u0b9a\u0732\u0bb2\u0731\u0737\u0b95 \u0bb0\u0ba4\u0bcd\u0ba9 197518100288 \u0bae\u0bc1\u0bb4\u0bc1\u0bb5\u0ba4\u0bc1\u0bae\u0bcd 1\u0bae\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1 _ _\n\n\u0736\u0b95\u0731\u0b9f\u0bbf\u0b95\u0731\u0bb0\n\n\u0baa\u0bb2\u0b95\u0bb9\u0baf\u0731\u0baf,\n\n\u0b95\u0ba9\u0ba4\u0bcd\u0737\u0ba4\u0736\u0bb5\u0bb5.\n\n1:96 0.1722 \u0736\u0b95\u0731\u0b9f\u0bbf\u0b95\u0731\u0bb0 \u0b86\u0bb0\u0731\u0b9a\u0bcd\u0b9a\u0732\u0bb2\u0731\u0737\u0b95 \u0b9c\u0baf\u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0ba9 680673160V \u0bae\u0bc1\u0bb4\u0bc1\u0bb5\u0ba4\u0bc1\u0bae\u0bcd 1\u0bae\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1 _ _\n\n\u0b9a\u0732\u0baf\u0bae\u0bcd\u0baa\u0bb2\u0731\u0b95\u0bb8\u0bcd\u0bb5\u0ba4\