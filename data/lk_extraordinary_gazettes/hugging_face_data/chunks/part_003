\u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba\u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba\n\n\u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2\n\n\u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90\n\n\u0d85\u0d82\u0d9a 2446/55 - 2025 \u0152\u0263 \u0db8\u0dc3 26 \u0dc0\u0dd0\u01e7 \u0dd9\u0dc3\u0db1\u0288\u0dbb\u0dcf\u0daf\u0dcf - 2025.07.26\u0d85\u0d82\u0d9a 2446/55 - 2025 \u0152\u0263 \u0db8\u0dc3 26 \u0dc0\u0dd0\u01e7 \u0dd9\u0dc3\u0db1\u0288\u0dbb\u0dcf\u0daf\u0dcf - 2025.07.262446/55 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd - 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8c \u1f9d\u0bc8\u0bb2 \u0bae\u0bbe\u0ba4\u0bae\u0bcd 26 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0b9a\u0ba9\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb4\u0bc8\u0bae\n\n(\u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0ba4\u0bcd\u1f90\u0b9f\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0bc1\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90)\n\n\u0baa\u0b95\u0bc1\u0ba4\u0bbf I : \u0bc6\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf (I) - \u0bc6\u0baa\u0bbe\u1f90 \u0baa\u0b95\u0bc1\u0ba4\u0bbf I : \u0bc6\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf (I) - \u0bc6\u0baa\u0bbe\u1f90\n\n\u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bcd\u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bcd\n\n\u0baf\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0b95\u0bb0\u0bcd \u0baa\u0bbf\u0bb0\u0baf\u0bbe\u0ba3\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0baf\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0b95\u0bb0\u0bcd \u0baa\u0bbf\u0bb0\u0baf\u0bbe\u0ba3\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\n\n\u0bc6\u0ba4\u0ba9\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bae\u0bbe\u0ba4\u0bcd\u0ba4\u0bc8\u0bb1 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0baa\u0bb8\u0bcd\u0bc6\u0b95\u0bbe\u0b9f \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0bc6\u0bb0\u0bbe\u0b9f\u0bcd\u1f8c\u0bae\u0bcd\u0baa \u0bc6\u0baa\u0ba4\u0bcd\u0bae\u0b99\u0bcd\u0b95 \u1f97\u0bb0\u0bbe\u0ba3 \u0bb0\u0b9c \u0bae\u0bb9\u0bbe \u0bb5\u0bbf\u0bb9\u0bbe\u0bc8\u0bb0\u0baf\u0bbf\u0ba9\u0bcd 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd \u0bb5\u1f9e\u0b9f\u0bbe\u0ba8\u0bcd\u0ba4 \u1f97\u0ba3\u0bcd\u0ba3\u0bbf\u0bc7\u0baf\u0bbe\u0bb1\u0bcd\u0b9a\u0bb5\u0bae\u0bcd 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8c \u0b86\u0b95\u0bb8\u0bcd\u0b9f\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd 12 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u1f99\u0ba4\u0bb2\u0bcd 18 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0bb5\u0bc8\u0bb0 \u0ba8\u0b9f\u0bbe\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0bc8\u0ba4 \u0baf\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0b95\u0bb0\u0bcd \u0baa\u0bbf\u0bb0\u0baf\u0bbe\u0ba3\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 175 \u0b86\u0bae\u0bcd \u0baa\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0ba9 \u0baf\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0b95\u0bb0\u0bcd \u0baa\u0bbf\u0bb0\u0baf\u0bbe\u0ba3\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 02 \u0b86\u0bae\u0bcd \u0b89\u1fa0\u0baa\u0bcd\u1f97\u0bc8\u0bb0\u0b95\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u0baa 2009.09.18 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0bc6\u0bb5\u0bd7\u0bbf\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 1620 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95\u0b9a \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0bb7\u1fa2\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u1f8a\u0baf\u0bb0\u0b9a\u0bbf\u0ba9\u0bcd \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b87\u0ba4\u0ba9\u0bcd \u1f9a\u0bb2\u0bae\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bbf \u0bc7\u0bb1\u0ba9\u0bcd.\n\n\u0b9f\u0bc0.\u0b8e\u0b9a\u0bcd. \u0ba4\u0bb0\u0bcd\u0b9a\u0ba9 \u0bb5\u0bb0\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0b9f\u0bc0.\u0b8e\u0b9a\u0bcd. \u0ba4\u0bb0\u0bcd\u0b9a\u0ba9 \u0bb5\u0bb0\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0baf, \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd, \u0baa\u0bb8\u0bcd\u0bc6\u0b95\u0bbe\u0b9f.\n\n\u0baa\u0bb8\u0bcd\u0bc6\u0b95\u0bbe\u0b9f \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u1fa4\u0bb5\u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd.2025, \u1f9d\u0bc8\u0bb2 23.\n\nEOG 07-0313\n\n\u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0b85\u0b9a\u0bcd\u0b9a\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0b9a\u0bcd\u0b9a\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90."
