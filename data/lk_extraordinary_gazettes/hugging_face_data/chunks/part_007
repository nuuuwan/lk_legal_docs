b9f \u0bc6\u0ba4\u1fb9 \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u1fb7\u0ba4\u0bbf\u1fb9, \u0b85\u1fbb\u0baa\u0bbe\u1fb8\u0bc7\u0ba4\u0bbe\u1fb5\u0bc8\u0b9f \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u1fa4\u1f94\u0b95\u1fbb\u0bc6\u0bb5\u0bc6\u0bb9\u0bb0 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf, \u0b87\u0bb2. 58 -\u0bc6\u0b95\u1fb8\u0ba4\u0b95\u1fc4\u0bae\u1fb1\u0b95\u0b9f \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0\n\n\u0bc6\u0b95\u1fb8\u0ba4\u0b95\u0bb8\u0b9a\u0bae\u1fb1\u0b95\u0b9f \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\u1f90\u1fbb 830030 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 07 \u0b87\u1fbf \u0b85\u0b9f\u1fb1\u0b95\u0bbf\u1f9c\u1fc0\u0bb3\u1f90\u0bae\u0bbe\u0ba9 13 : 3, 13 : 7, 13 : 8, 13 : 11, 13 : 14, 13 : 16, 13 : 18, 13 : 20 \u0bae\u1fbe\u1fa0\u1fbb 13 : 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb1\u0b95\u0bc8\u0bb3\u1fb0 \u0bc6\u0b95\u0bbe\u1fb6\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u1fa6\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b87\u0ba4\u0bc7\u0ba9\u0bbe\u1f8c \u0b87\u0bc8\u0ba3\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf \u0ba4\u0bb0\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b8e\u0ba9\u1f90 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4\n\n\u0b87\u1fb7\u0ba4\u0bbe\u1fbf \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u1f90\u0b95\u0bbf\u1fb9\u0bc7\u0bb1\u1fb9.\n\n\u1f96.\u0b9a\u0bc0.\u1f8b. \u0b9a\u0bbf\u0bc7\u0b95\u0bb0\u0bbe,\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd \u0ba8\u0bbe\u0baf\u0b95\u1fbb.\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fbb, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4 \u0bc6\u0bae\u1f90\u0bb0\u201d,\n\n\u0b87\u0bb0\u0b9c\u0bae\u1fbf\u0bb5\u1fb7\u0ba4 \u1faa\u0ba4\u0bbf, \u0baa\u1fb7\u0ba4\u0bb0\u1f99\u1fbf\u0bc8\u0bb2, 2025 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0bae\u0bbe\u1fb2\u1f86 \u0bae\u0bbe\u0ba4\u1fbb 17\u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf.\n\n\u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0bb5\u0bb4\u1fb0\u0b95\u0bbf\u1fbe\u1f81 \u0b85\u1fbf\u0bb2\u1f90 \u0ba4\u0bbe\u1fc0 \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0\u0b95\u0bbe\u0bb0\u1fbd/ \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0 \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb0\u1f81\u0bbe\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u0ba9\u1f90 \u0b89\u1fb5\u0baa\u1fb5\u0b9f \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1f9e\u1fb0\n\n\u0bae\u1fbe\u1fa0\u1fbb \u0b95\u0bbe\u0bb0\u1fbd\u0b95\u0bb3\u0bbf\u1fb9 \u1f99\u1fa8\u1fba \u0bc6\u0baa\u0baf\u1fbd\u0b95\u1fa6\u1fbb \u0b85\u0bc8\u0b9f\u0baf\u0bbe\u0bb3 \u0b87\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 \u0bb5\u1f81\u1fba\u1f97\u1fbb \u0b88\u1f8c, \u1f81\u1fb7 \u1f81\u0bbe\u0bbf\u0baf \u0b9a\u1fb5\u0b9f\u1fb1 \u0b95\u0bbe\u0ba3\u0bbf\u1fb7 (\u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u0bbe\u1fbd) \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u1f9c\u1fbb \u0b85\u1fb5\u0bc8\u0b9f \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0b87\u0baf\u1fbf\u1f97\u1fbb \u0ba4\u0bc8\u0b95 \u0b95\u1fa6\u1fc0 \u0b8e\u1fc2 \u1f90\u1fb6\u1f8a\u1fb9 \u0b87\u0bb2. \u0ba4\u1f8c\u1fba\u1f97\u1fb0 \u0bb5\u0bc8\u0b95\u1fb0\u1f81\u1fbb\n\n\u0b87\u0bb2. \u0b95\u1fb5\u0b9f\u0bc8\u0bb3 \u0b85\u0bc8\u0bae\u1fb8\u0ba4\u0bbf\u1f9e\u1fba \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0baa\u0bbf\u1fb9 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0 \u0b95\u1fc0 13:3 0.0506 \u0b85\u0bb0\u1f86 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 _ \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a. \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u1fb0\u1f81\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0ba8\u0b95\u0bb0 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u1fb7\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa\n\n\u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b85\u1f94\u0bae\u0ba4\u0bbf \u0b87\u0bb2.\n\n\u0bb9\u1fbb /11/58/4070 \u0b95\u0bc0\u1fc1 \u0baa\u1fbb\u0baa\u1f9e\u1fb8\u0ba4\n\n\u0b95\u0bae\u0bc7\u0b95 \u0b9a\u0bbe\u1fb8\u0ba4\u0ba9\u0bc0 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 13:7 0.0595 \u0b85\u0bb0\u1f86 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 _ \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a. \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u1fb0\u1f81\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0ba8\u0b95\u0bb0 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u1fb7\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa\n\n\u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90.\n\n5 A III \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u2013 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u2013 2025.06.24\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2025.06.24\n\n\u0b85\u1f94\u0bae\u0ba4\u0bbf \u0b87\u0bb2. \u0bb9\u1fbb/11/58/6199\n\n\u0b95\u0bc0\u1fc1 \u0b95\u1fbb \u0b86\u0b9a\u0bbe\u0bbe\u0bbf\u0bc7\u0b95 \u0bc7\u0bb0\u1f8e\u0b95\u0bbe\n\n\u0ba4\u0bae\u0baf\u1fb8\u0ba4\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90.\n\n13:8 0.0526 \u0b85\u0bb0\u1f86 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 _ \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a. \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u1fb0\u1f81\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. \u0ba8\u0b95\u0bb0 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u1fb7\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa\n\n\u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. \u0b85\u1f94\u0bae\u0ba4\u0bbf \u0b87\u0bb2.\n\n\u0bb9\u1fbb /11/58/6182 \u0b95\u0bc0\u1fc1 \u0b85\u0bc7\u0baa\u0bc7\u0b9a\u0b95\u0bb0 \u1fa2\u0baf\u0ba9\n\n\u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u1f86\u0b9c\u0bbe\u0ba4\u0bbe \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81"
