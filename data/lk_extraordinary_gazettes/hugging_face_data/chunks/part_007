    "chunk_text": "\u0daf\u0dc5\u0dd4\u0d9c\u0ddc\ufffd\u0ddc\u0da9 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda\u0118 \u0daf\u0dd3\u0db4\u0dd2\u0d9a\u0dcf\u0dcf \u0dbd\u0d9a\u0dca\u0db8\u0dcf\u0dcf\u0dbd\u0dd2\n\n\u0db8\u0dcf\u0dcf\u0db4\u0da7\u0dd4\u0db1\u0d9c\u0dda\u0118 \u200d\u200d\u0da2\u0d9c\u0dad\u0dca \u0da0\u0db1\u0dca\u200d\u0daf\u0dca\u200d\u0dbb\u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0db4\u0dd9\u0dd9\u0dbb\u0dda\u0dda\u0dbb\u0dcf\u0dcf\n\n\u0dc0\u0db1\u0dca\u0db1\u0dd2 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda\u0118 \u0db1\u0dd2\u0dbd\u0db1\u0dca\u0dad \u0dc3\u0d82\u0d82\u0da2\u0dd3\u0dc0 \u0dc6\u0ddc\u02e9\u0ddc\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0d9a\u0dcf\u0dcf\n\n\ufffd\u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dd2\u0d9a\u0dcf\u0dcf\u0dc0\u0dad\u0dca\u0dad \u0db8\u0dd4\u0dbd\u0dca\u0dbd\u0dda\u0262\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u200d\u200d\ufffd\ufffd\ufffd\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dc4\u0d82\u0d82\u0dc0\u0dd0\u0dd0\u0dbd\u0dca\u0dbd\u0d9c\u0dda\u0118 \u0dad\u0db1\u0dd6\u0da2\u0dcf\u0dcf \u0daf\u0dd2\u0dbd\u0dca\u0dbb\u0dd4\u0d9a\u0dca\u0dc2\u0dd2 \u0da9\u0dba\u0dc3\u0dca\n\n\u0dc4\u0ddd\ufffd\u0ddd\ufffd\u0db8\u0dcf\u0dcf\u0d9c\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9a\u0da7\u0dd4\u0dc0\u0dcf\u0dcf\u0dc0\u0dbd\u0d9c\u0dda\u0118 \u0daf\u0ddc\ufffd\u0ddc\u0db1\u0dca \u0d9a\u0db8\u0dbd\u0dca \u0da0\u0db1\u0dca\u0daf\u0db1\n\n\u0daf\u0ddc\ufffd\u0ddc\u0db1\u0dca \u0dc3\u0dd4\u0daf\u0dad\u0dca \u0d9a\u0dd2\u0dad\u0dca\u0dc3\u0dd2\u0dbb\u0dd2 \u0dc0\u0dd0\u0dd0\u0dbd\u0dd2\u0dc0\u0dad\u0dca\u0dad\n\n\u0d9c\u0dcf\u0dcf\u0dbb\u0dca\u0daf\u0dd2\u0d9c\u0dda\u0118 \u0dc0\u0dc3\u0db8\u0dca \u0da0\u0dcf\u0dcf\u0db1\u0dca\u0daf\u0db1\u0dd3 \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb\u0dd2 \u0d9a\u0dd4\u0dbd\u0dbb\u0dad\u0dca\u0db1\n\n\u0dc3\u0db8\u0dbb\u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0d9a\u0da7\u0dd4\u0d