    "language": "ta",
    "md5": "9d3271f4f8da1d86366facaa83531e36",
    "chunk_size_bytes": 4656,
    "chunk_text": "(\u0b86) \u0ba8\u0b95\u0bb0 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b87\u0b9f\u0baa\u0bcd\u0baa\u0bb0\u0baa\u0bcd\u0bc6\u0baa\u0bbe\u0ba9\u0bcd\u0bb1\u0bbe\u0b95 \u0bc7\u0bae\u0bc7\u0bb2 \u0bc6\u0bb5\u0bd7\u0bbf\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bbe\u0ba9 \u0ba4\u0bbf\u0b95\u0bcd\u0bc6\u0bb5\u0bb2\u0bcd\u0bb2 \u0ba4\u0bc0\u0b95\u0bb5\u1fa4\u0b95\u0bbe\u0bb0\u0bbe\u0bae \u0bb0\u0b9c\u0bae\u0bb9\u0bbe \u0bb5\u0bbf\u0b95\u0bbe\u0bc8\u0bb0\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0bc6\u0baa\u0bd7\u0ba4\u0bbf\u0b95 \u0b89\u1f9e\u0bb5\u0bc8\u0bb0 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bc6\u0bae\u0bbe\u0ba9\u0bcd\u1fa0 \u0ba4\u0baf\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bb2\u0bcd \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bc6\u0bae\u0ba9\u0baa\u0bcd \u0baa\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd.\n\n\u0b85\u1f92\u0bb0 \u0b95\u1f9e\u0ba3\u0bbe\u0ba4\u0bbf\u0bb2\u0b95\u0bcd\u0b95,\u0b85\u1f92\u0bb0 \u0b95\u1f9e\u0ba3\u0bbe\u0ba4\u0bbf\u0bb2\u0b95\u0bcd\u0b95, \u0ba8\u0b95\u0bb0 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf, \u0ba8\u0bbf\u0bb0\u0bcd\u0bae\u0bbe\u0ba3\u0bbf\u0baa\u0bcd\u1f97 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0b9f\u0bc8\u0bae\u0baa\u0bcd\u1f97 \u0b85\u0bc8\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd.\n\n\u0bc6\u0b95\u0bbe\u1fa8\u0bae\u0bcd\u1f97,2025, \u1f9d\u0ba9\u0bcd 12.\n\n\u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0b85\u0b9a\u0bcd\u0b9a\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0b9a\u0bcd\u0b9a\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90.\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3\n\n\u0ba4\u0bbf\u0b95\u0bcd\u0bc6\u0bb5\u0bb2\u0bcd\u0bb2 \u0ba4\u0bc0\u0b95\u0bb5\u1fa4\u0b95\u0bbe\u0bb0\u0bbe\u0bae \u0bb0\u0b9c\u0bae\u0bb9\u0bbe \u0bb5\u0bbf\u0b95\u0bbe\u0bc8\u0bb0 \u0b87\u0b9f\u0baa\u0bcd\u0baa\u0bb0\u0baa\u0bcd\u0baa\u0bbf\u0bc8\u0ba9\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a\u0bae\u0bcd\u0ba4\u0bbf\u0b95\u0bcd\u0bc6\u0bb5\u0bb2\u0bcd\u0bb2 \u0ba4\u0bc0\u0b95\u0bb5\u1fa4\u0b95\u0bbe\u0bb0\u0bbe\u0bae \u0bb0\u0b9c\u0bae\u0bb9\u0bbe \u0bb5\u0bbf\u0b95\u0bbe\u0bc8\u0bb0 \u0b87\u0b9f\u0baa\u0bcd\u0baa\u0bb0\u0baa\u0bcd\u0baa\u0bbf\u0bc8\u0ba9\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a\u0bae\u0bcd\n\n\u0bc6\u0ba4\u0ba9\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0bae\u0bbe\u0ba4\u0bcd\u0ba4\u0bc8\u0bb1 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0ba4\u0bbf\u0b95\u0bcd\u0bc6\u0bb5\u0bb2\u0bcd\u0bb2 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u0bcd\u0b95\u0bc1\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f, \u0b87\u0bb2. 451\u0b9a\u0bc0, \u0baa\u0ba4\u0bc0\u0b95\u0bae \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u0bb3\u0bcd, \u0baa\u0ba4\u0bc0\u0b95\u0bae \u0b8e\u1f94\u0bae\u0bcd \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3, \u0bb5\u0bbf\u0bb9\u0bbe\u0bb0\u0bc7\u0bb9\u0ba9 \u0b8e\u0ba9 \u0b85\u0bc8\u0bb4\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0ba4\u0bc8\u0bb2\u0bc8\u0bae\u0baf\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd 2023, \u0bc6\u0b9a\u0ba4\u0bcd\u0bc6\u0ba4\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd 20 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0bc8\u0baf\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0b9a\u0bc1\u0bb5\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd MA/DKW/2022/63 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u1f90\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \u0b8e\u0ba9\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u1f90\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u1f90\u0ba3\u0bcd\u1f8c\u0b95\u1fa6\u0bae\u0bcd 1.3713 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0ba4\u0bcd\u0bc8\u0ba4\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0b95\u0bbe\u0ba3\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bc6\u0b9a\u0bbe\u0bb2\u0bcd\u0bb2\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u1f90\u0ba3\u0bcd\u1f8c\u0b95\u1fa6\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b85\u0ba4\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0b95\u1fa6\u0bae\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u1f9e\u0bae\u0bbe\u1fa0 :\n\n\u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 1 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd - 1.3713 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd (3 - \u0b8f, 1 - \u1fa1, 22.2 - \u0bc7\u0baa)\u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 1 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd - 1.3713 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd (3 - \u0b8f, 1 - \u1fa1, 22.2 - \u0bc7\u0baa) \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u0b8e\u0bb8\u0bcd. \u0b8e\u0bb8\u0bcd. \u1f8a. \u0baa\u0bbf\u0bbe\u0bc0\u0ba4\u0bbf\u0b95\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bbf\u0bae\u0bcd\u1f97\u0bb2\u0bcd\u0bc6\u0b95\u0bc7\u0bb9\u0ba9, \u0b8e\u0b9a\u0bcd. \u0b8f. \u0b9f\u0bc0. \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0ba9\u0bbf\u0baf, \u1f8a. \u0bc6\u0b9a\u0bbe\u0bae\u0bbf\u0baa\u0bbe\u0bb2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0ba9\u0bbf\u0baf, \u0bb5\u1f90\u0bc7\u0bb9\u0bb5\u0bbe\u0bc7\u0b95 \u0bc6\u0baa\u0bbe\u1f8a\u0b9e\u0bcd\u0bc7\u0b9e\u0bbe \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b8f\u0bc8\u0ba9\u0bc7\u0baf\u0bbe\u0bb0\u0bcd \u0baa\u0bb2\u0bb0\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0baa\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc7\u0b95. \u0b9a\u0b9e\u0bcd\u0b9c\u0baf \u0bb5\u0b9c\u0bbf\u0ba4\u0bc7\u0ba4\u0bb5 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0ba9\u0bbf\u0baf ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u0bb5\u1f90\u0bc7\u0bb9\u0bb5\u0bbe\u0bc7\u0b95 \u0bc6\u0baa\u0bbe\u1f8a\u0b9e\u0bcd\u0bc7\u0b9e\u0bbe \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc7\u0bae\u1fa4\u0bae\u0bcd \u0baa\u0bb2\u0bb0\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0baa\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc7\u0b95. \u0b9a\u0b9e\u0bcd\u0b9c\u0baf \u0bb5\u0b9c\u0bbf\u0ba4\u0bc7\u0ba4\u0bb5 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0ba9\u0bbf\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa) ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa) ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u0b95\u0bae\u0bb2\u0bcd \u0bb0\u0bbe\u0b9c\u0baa\u0b95\u0bcd\u0bb7 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bbf\u0bae\u0bcd\u1f97\u0bb2\u0bcd\u0bc6\u0b95\u0bc7\u0bb9\u0ba9, \u0b9a\u0bc1\u0b9a\u0bbf\u0bb2\u0bbe \u0bb0\u0bbe\u0b9c\u0baa\u0b95\u0bcd\u0bb7 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bbf\u0bae\u0bcd\u1f97\u0bb2\u0bcd\u0bc6\u0b95\u0bc7\u0bb9\u0ba9 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b8e\u0bb8\u0bcd. \u0b8e\u0bb8\u0bcd. \u1f8a. \u0baa\u0bbf\u0bbe\u0bc0\u0ba4\u0bbf\u0b95\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bbf\u0bae\u0bcd\u1f97\u0bb2\u0bcd\u0bc6\u0b95\u0bc7\u0bb9\u0ba9, \u0b8e\u0b9a\u0bcd. \u0b8f. \u1f8a. \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0ba9\u0bbf\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f8a. \u0bc6\u0b9a\u0bbe\u0bae\u0bbf\u0baa\u0bbe\u0bb2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0ba9\u0bbf\u0baf.\n\nEOG 06 - 0195"
