b\u0da7 : \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 181, \u0286\u01ae\u01af \u0dc3\u00fc\u0db1\u0dcf \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u023f\u0dbb\u0dd9\u0db4\u02a3\u0dbd\u0dba\u0dcf\u0dd9\u024f \u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u0d91\u023c.\u0d91\u013c.\u0286\u0217\u0db4\u0250\u0dba\u0dcf \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u023f\u0dbb\u0dd9\u0db4\u02a3\u0dbd\u0dba\u0dcf\u0dd9\u024f \u0dc0\u01ae\u0dad; \u0daf\u0d9a\u0dd4\u0dab\u0da7 : \u0d91\u023c.\u0d91\u013c.\u0286\u0217\u0db4\u0250\u0dba\u0dcf \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u023f\u0dbb\u0dd9\u0db4\u02a3\u0dbd\u0dba\u0dcf\u0dd9\u024f \u0dc0\u01ae\u0dad, \u0db8\u0dcf\u0259\u0d9c\u0dba \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 185; \u0db6\u0da7\u028f\u0dbb\u0da7 : \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 185 \u0dc3\u0dc4 1.\n\n06. \u0db1\u018d \u0d85\u0d82\u0d9a\u0dba : LA/111/2024 \u0dc0\u01e6\u01ce \u023f\u0daf\u0dbd : \u025e\u0218\u0dba\u0262 345,000.00 (\u025e\u0218\u0dba\u0262 \u01b1\u01e6 \u0dbd\u00fa\u0dc2 \u0dc4\u0dad\u0298\u0dc3\u0dca \u0db4\u01e6\u0daf\u0dc4\u0dc3\u00fa \u0db4\u0db8\u019d) \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 : \u0db4\u0dcf\u0dd9\u0dbb\u01e6\u0db4\u0262\u0dbd \u0dc0\u01ae\u0dad (\u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a 176 \u0d92 \u0dbb\u01ae\u0dd9\u0dad\u02a3\u0da7 \u0db4\u0dcf\u0dbb) \u0218\u0249\u025e \u0d85\u0d82\u0d9a\u0dba : 1668 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a\u0dba : 55 \u021d\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0017 \u0218\u028f\u017a\u0db8 : \u0d8b\u01b1\u0dbb\u0da7 : \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 1; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7 : \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 54, \u0d92.\u0287.\u0d89\u022f\u028f\u023c \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0db4\u0dcf\u0dd9\u0dbb\u01e6\u0db4\u0262\u0dbd \u0dc0\u01ae\u0dad \u0dc3\u0dc4\n\n3AIII \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u2013 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0