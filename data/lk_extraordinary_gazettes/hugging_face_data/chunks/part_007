dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dbd\u0dca1 2\u0d9225 \u0db8\u0dcf\u0dbb\u0dca\u0dc5 \u0db8\u0dc3 18 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0dbb\u0da2\u0dcf\u0db8\u0dbd\u0dca\u0dc0\u0dda\u0dcf \u0db4\u0dcf\u0dbb, \"\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dcf \u0db8\u0dd0\u0daf\u0dd4\u0dbb\", \u0d9a\u0d82\u0d9a 12\u0d92\u0d9257, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dba\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dcf\u0dba\u0db8\u0dca\u0dca\u0dad\u0dc5 \u0dba\u0dda \u0daf\u0dd3 \u0dba1\n\n4 A III \u0dc1\u0d9a\u0ddc\u0da7\u0dc3 - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0d82\u0d9a \u200d\u0dbb\u0da2\u0dcf \u0dad \u0dca\u0daf\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8 \u0da2\u0dcf\u0dc0 \u0da2 \u0da2\u0dcf\u0db1\u0dbb\u0da2\u0dcf\u0dc1\u0d85 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u0dc2 \u0dc3\u0dd0\u0dc3 \u0db4 \u0dad\u200d\u0dbb\u0dba - 2025.06.19\n\n1998 \u0d85\u0d82\u0d9a 21 \u0dcf \u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba \u0dad\u0daf\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0dad\u0db1\u0dad"
