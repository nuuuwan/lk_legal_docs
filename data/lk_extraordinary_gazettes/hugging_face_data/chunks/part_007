dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda\u024f \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2, \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f II \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dda\u0dda \u0d8a\u0da7 \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dd9\ufffd\u0dc4\u0dd2 \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\ufffd 66\u0d87. (1) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0da7 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca\u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2, \u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dba\u0db1 \u0db0\u0dd4\u0dbb\u0db0\u0dcf\u0dcf\u0dbb\u0dd3\u0db1\u0dca\u0d9c\u0dda\u0118 \u0db1\u0db8\u0dca \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f III \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dda\u0dda \u0d8a\u0da7 \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dd9\ufffd\u0dc4\u0dd2 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc3\u0dc4 IV \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dda\u0dda \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0daf\u0dd2\u0db1\u0dba \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0db1\u0dca\u0db1\u0dda\ufffd \u0dba.\n\n\u0dc3\u0dcf\u0dcf\u0dbb\u0d82\u0d82\u0d9c\u0dd2\u0d9a\u0dcf\u0dcf \u0d9a\u0dbd\u0dca\u0dc4\u0dcf\u0dcf\u0dbb\u0dd2 \u0da2\u0dba\u0dc3\u0dd4\u0db1\u0dca\u0daf\u0dbb,\n\n\u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca,\n\n\u0db6\u0dc3\u0dca\u0db1\u0dcf\u0dcf\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dcf\u0dad.\n\n2025 \u200d\u200d \u0da2\u0dd4\u0db1\u0dd2 \u0db8\u0dc3 21 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0da9\u0dd9\u02d0\u0db1\u0dca\u0dc3\u0dd2\u0dbd\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0db6\u0dca\u0db6\u0dd1\u0dd1\u0d9a\u0da9\u0dd4\u0dc0 \u0db8\u0dcf\u0dcf\u0dc0\u0dad\u0dda\ufffd,\u0d85\u0d82\u0d82\u0d9a 204, \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf \u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9c\u0dd2\u0dbd\u0dca\u0dbd\u0dda\u0262 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2\u0db6\u0dc3\u0dca\u0db1\u0dcf\u0dcf\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\ufffd \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0daf\u0dd3 \u0dba.\n\nIV^wd& jeks fldgi \u2013 YS% ,xld m%cd;dka;s%l iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'06'232 A\n\nEOG 06 - 0231\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dbb\u0da2\u0dba\u0dda\u024f \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\n\nI \u0dad\u0dd3\u0dbb\u0dd4\u0dc0II \u0dad\u0dd3\u0dbb\u0dd4\u0dc0III \u0dad\u0dd3\u0dbb\u0dd4\u0dc0IV \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2/ \u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0d9c\u0dda\u0118 \u0db1\u0db8\u0dca\u0dad\u0dda\ufffd\u0dbb\u0dd3 \u0db4\u0dad\u0dca \u0dc0\u0dd6 \u0daf\u0dd2\u0db1\u0dba\n\n\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0db1\u0dcf\u0dcf\u0dc0 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dd2\u0da2\u0db8\u0dd4\u0db1\u0dd2\u0d9c\u0dda\u0118 \u0db8\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0da7\u0dd2 \u0daf\u0db8\u0dca\u0db8\u0dd2\u0d9a\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb\u0dad\u0dd4\u0d82\u0d82\u0d9c \u0daf\u0ddc\ufffd\u0ddc\u0da9\u0db8\u0dca\u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0d9c\u0dda\u0118 \u0dc3\u0dda\ufffd\u0dda\u0db1\u0d9a \u0dc3\u0db8\u0db1\u0dca \u0dc3\u0dd9\ufffd\u0db1\u0dd9\ufffd\u0dc0\u0dd2\u0dbb\u0dad\u0dca\u0db1\n\n2025.06.18\n\n\u0d9c\u0db8\u0dca\u0db4\u0dc4\u0db4\u0dd1\u0dd1\u0dbd\u0dd2\u0dba\u0d9c\u0ddc\ufffd\u0ddc\u0da9 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0db8\u0dcf\u0dcf\u0daf\u0dd4\u0dbb\u0d9c\u0dda\u0118 \u0d9a\u0db4\u0dd2\u0dbd \u0dc3\u0db8\u0db1\u0dca \u0d9a\u0dd3\u0dbb\u0dca\u0dad\u0dd2\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc3\u0dd4\u0dbb\u0dc0\u0dd3\u0dbb \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda\u0118 \u0d85\u0dbb\u0dd4\u0dab \u0dc1\u0dcf\u0dcf\u0db1\u0dca\u0dad\n\n2025.06.18\n\n\u0d9c\u0db8\u0dca\u0db4\u0dc4\u0dc0\u0dad\u0dca\u0dad\u0dbd \u0db8\u0dcf\u0dcf\u0db6\u0ddd\ufffd\u0ddd\ufffd\u0dbd \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dd2\u0da2\u0dba\u0dbb\u0dcf\u0dcf\u0da2\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dca\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc4\u0dd4\u0dc3\u0dda\ufffd\u0dda\u0db1\u0dca \u0db8\u0ddc\ufffd\u0ddc\u0dc4\u0ddc\ufffd\