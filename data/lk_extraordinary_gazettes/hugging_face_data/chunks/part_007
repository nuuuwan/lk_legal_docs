\u0d9a _ \u0d9a\u0d82\u0d9a 2 7, \u0daf\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dba \u0dda\u0db1\u0d9c\u0db8, \u0db8\u0dd4\u0dab\u0d9c\u0db8, \u0d92 \u0dc3 14 \u0dc4\u0dd2 \u0dba \u0ddc\u0dbb\u0dab \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf\u0dc0\u0dba \u0dc3\u0db8\u0d9f 1:23 \u0d921\u0d92345 \u0dc0\u0dd0\u0dbd\u0dd2\u0d9a\u0da9\u0dba\u0dda \u0d86\u0dbb\u0dd2\u0dba\u0dc3\u0dd2\u0daf\u0dbb\u0dd2 771771\u0d922\u0d92V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a _ \u0d9a\u0d82\u0d9a 2 451, \u0daf\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dba \u0dda\u0db1\u0d9c\u0db8, \u0db8\u0dd4\u0dab\u0d9c\u0db8, \u0d92 \u0dc3 14 \u0dc4\u0dd2 \u0dba \u0ddc\u0dbb\u0dab \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f 1:2 \u0d921\u0d92331 \u0da0\u0db8\u0dd2\u0dbd\u0dca \u0daf\u0dd2\u0dbd\u0d82\u0d9a \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dd6\u0dbb\u0dd2\u0dba 2\u0d92\u0d927\u0d9248\u0d922115 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a _ \u0d9a\u0d82\u0d9a 1 5\u0db6\u0dd3, \u0daf\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dba \u0dda\u0db1\u0d9c\u0db8, \u0db8\u0dd4\u0dab\u0d9c\u0db8 , \u0d92 \u0dc3 14 \u0dc4\u0dd2 \u0dba \u0ddc\u0dbb\u0dab \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f\n\n12 A III \u0dc1\u0d9a\u0ddc\u0da7\u0dc3 - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0d82\u0d9a \u200d\u0dbb\u0da2\u0dcf \u0dad \u0dca\u0daf\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8 \u0da2\u0dcf\u0dc0 \u0da2 \u0da2\u0dcf\u0db1\u0dbb\u0da2\u0dcf\u0dc1\u0d85 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u0dc2 \u0dc3\u0dd0\u0dc3 \u0db4 \u0dad\u200d\u0dbb\u0dba - 2025.06.19\n\n\u0dc0\u0dd2\u0db1\u0dd2\u0dba\u0dca\u0da0\u0dba\u0dca\u0dad \u0dc3 \u0dba\u0db8\u0dca \u0dc0\u0dd2