\u0d9a 110/\u0d92/1, \u0db8 \u0da9\u0dba\u0dcf\u0dba \u0db4\u0dcf\u0dbb, \u0dbb\u0db3\u0dcf\u0dc0\u0dcf\u0db1 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f 1:48 0.0360 \u0db6\u0dd2\u0db1\u0dd2\u0dd9\u0d9a\u0ddd\u0db1\u0dcf\u0dbb \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0daf\u0dba\u0dcf\u0db4\u0dcf\u0dbd 680181780V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba 511865/01/01/18 _ \u0d85\u0d82\u0d9a 18, \u0db4\u0dcf\u0dbb\u0dca\u0d9a\u0dca\u0dc0\u0dd3\u0dc0\u0dca , \u0dd9\u0db8\u0ddc\u0dbb\u0dd0\u0db1\u0dca\u0db1, \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0dba\u0d9a\u0dca\u0d9a\u0dbd \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f 1:60 0.0441 1. \u0d89\u0dbd\u0d82\u0dd9\u0d9a\u0ddd\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0d9c\u0dd4\u0dab\u0daf\u0dcf\u0dc3 591292072V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 57 \u0dc4\u0dd2 _ 2. \u0db4\u0dad\u0dd2\u0dbb\u0dab\u0dd9\u0d9c\u0dca \u0dd9\u0daf\u0ddd\u0db1 \u0daf\u0db8\u0dba\u0db1\u0dca\u0dad\u0dd2 \u0db4\u0dd3\u0dad\u0dd2\u0d9a\u0dcf 196884402532 \u0dc3\u0db8 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0d82\u0d9a 1/1, \u0db4\u0db1\u0dcf\u0dbd\u0dc0\u0dad\u0dca\u0dad, \u0dd9\u0db8\u0ddc\u0dbb\u0dd0\u0db1\u0dca\u0db1, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0dba\u0d9a\u0dca\u0d9a\u0dbd\n\n15 A III \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 - \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba - 2025.06.21\n\n16 A III \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 -