d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0d9c\u0db8\u0dca/\u0dc3\u0db8\u0dca\u0db8\u0dda\u023c\u0dbd\u0db1\u0dba\u0db1\u0dca \u0dc4\u0dd2 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0dd2\u0dad \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0 \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a \u0db8\u0dc4 \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0d9a \u0daf\u0dd3 \u0db4\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db1\u0dd2\u0dbd\u0dc0\u0dbb\u0dab\u0dba\u0d9a\u0daf\u0dd3 \u0dc3\u0dd2\u0dba \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0dad\u0ddd\ufffd\u0ddd\u02ea\u0dbb\u0dcf\u0dcf\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dad\u0dd9\ufffd\u0d9a\u0dca, \u0d89\u0dc4\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf\u0dc0\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0d9c\u0db8\u0dca/\u0dc3\u0db8\u0dca\u0db8\u0dda\u023c\u0dbd\u0db1\u0dba\u0db1\u0dca \u0dc4\u0dd2 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dba\u0db1\u0dca \u0d9a\u0dbb\u0d9c\u0dd9\ufffd\u0db1 \u0dba\u0dcf\u0dcf\u0db8 \u0dc3\u0dc4 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0dad\u0dbb\u0dd4\u0dab \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dc4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\u0dda\u024f \u0dbd\u0dda\u0262\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db6\u0dbd\u0dba \u0db4\u0dc0\u0dbb\u0dcf\u0dcf \u0daf\u0dd9\u0dd9\u0db8\u0dd2.\n\n\u0dc3\u0dd4\u0db1\u0dd2\u0dbd\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0d9c\u0db8\u0d9c\u0dda\u0118 (\u0db4\u0dcf\u0dcf. \u0db8.), \u0dad\u0db