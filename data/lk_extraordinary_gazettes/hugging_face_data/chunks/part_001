\n\n(\u0d85) \u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\u01ae \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf, \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u024f \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db7\u0dd6\u0db8\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba\u0dc0\u0db1 \u201c\u0d9a\u0da0\u0dca\u0da0\u0dd2\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dd4\u0dbb\u0dcf\u0dcf\u0dab \u0dc0\u0dd2\u0dc4\u0dcf\u0dcf\u0dbb (\u0daf\u0dd3\u0db4\u0daf\u0dd4\u0dad\u0dca\u0dad\u0dcf\u0dcf\u0dbb\u0dcf\u0dcf\u0db8\u0dba) \u0db7\u0dd6\u0db8\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba\u201d \u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba\u0d9a\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229; \u0dc3\u0dc4\n\n(\u0d86) \u201c\u0d9a\u0da0\u0dca\u0da0\u0dd2\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dd4\u0dbb\u0dcf\u0dcf\u0dab \u0dc0\u0dd2\u0dc4\u0dcf\u0dcf\u0dbb (\u0daf\u0dd3\u0db4\u0daf\u0dd4\u0dad\u0dca\u0dad\u0dcf\u0dcf\u0dbb\u0dcf\u0dcf\u0db8\u0dba) \u0db7\u0dd6\u0db8\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba\u201d \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dbb\u0dd2\u0db6\u0dcf\u0dcf\u0dc4\u0dd2\u0dbb \u0dc3\u0dd0\u0dd0\u0dbd\u0dd0\u0dd0\u0dc3\u0dca\u0db8\u0d9a\u0dca \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\u0da7 \u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n\u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0dad\u0dd2\u0dbd\u0d9a, \u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1, \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba.\n\n2025 \u0d85\u0d9c\u0ddd\ufffd\u0ddd\ufffd\u0dc3\u0dca\u0dad\u0dd4 \u0db8\u0dc3 20 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0daf\u0dd3 \u0dba.\n\n2 AI fldgi: (I) fPoh - Y%S ,xld m%cd;dka;%sl iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'09'10\n\n\u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\n\n\u0d9a\u0da0\u0dca\u0da0\u0dd2\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dd4\u0dbb\u0dcf\u0dcf\u0dab \u0dc0\u0dd2\u0dc4\u0dcf\u0dcf\u0dbb (\u0daf\u0dd3\u0db4\u0daf\u0dd4\u0dad\u0dca\u0dad\u0dcf\u0dcf\u0dbb\u0dcf\u0dcf\u0db8\u0dba) \u0db7\u0dd6\u0db8\u0dd2\u0dba \u0dc3\u0d82\u0d82\u0dba\u0dd4\u0d9a\u0dca\u0dad \u0dc0\u0db1 \u0db7\u0dd6\u0db8\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba\n\n\u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\u01ae, \u0d9c\u0dcf\u0dcf\u0dbd\u0dca\u0dbd \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda\u024f, \u0d9a\u0da9\u0dc0\u0dad\u0dca\u0dc3\u0dad\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f, (\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf. \u0db1\u0dd2. \u0dc0. \u0d85\u0d82\u0d82\u0d9a 99) \u0db8\u0dcf\u0dcf\u0d9c\u0dcf\u0dcf\u0dbd\u0dca\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f, \u0db8\u0dcf\u0dcf\u0d9c\u0dcf\u0dcf\u0dbd\u0dca\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8\u0dba\u0dda\u024f \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2, \u0dc3\u0dbb\u0dca\u0dc0\u0dda\u0dda\u0dba\u0dbb\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0dba\u0dcf