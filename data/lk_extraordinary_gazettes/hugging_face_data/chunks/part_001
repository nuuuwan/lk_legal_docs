4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db4\u0db1 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dba\u0dda\u024f \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dba \u0db4\u0dc4\u0dad II \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3\u0dd9\ufffd\u0dc4\u0dd2 \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0d86\u0d9a\u0dcf\u0dcf\u0dbb\u0dba\u0da7 \u0db1\u0dd0\u0dd0\u0dc0\u0dad \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229. \u0d91\u0dc4\u0dd2 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d85\u0db1\u0dd9\ufffd\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dc4\u0dcf\u0dcf \u0d9a\u0ddc\u02c1\u0ddc\u0db1\u0dca\u0daf\u0dda\u0dda\u0dc3\u0dd2 \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0dd9\u0dd9\u0db1\u0dc3\u0dca\u0dc0 \u0db4\u0dc0\u0dad\u0dd3.\n\n\u0dbb\u0dcf\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0d9a\u0ddc\u0dca\u02c1\u0dca\u02ea\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dba \u0db4\u0dbb\u0dd2\u0daf\u0dd2, \u0da9\u0db6\u0dca\u0dbd\u0dd2\u0dc0\u0dca. \u0d91\u0da0\u0dca. \u0d91\u0db8\u0dca. \u0d91\u0db8\u0dca. \u0dc3\u0dd3. \u0d9a\u0dda\u00fa. \u0daf\u0dba\u0dcf\u0dcf\u0dbb\u0dad\u0dca\u0db1, \u0dbd\u0dda\u0262\u0d9a\u0db8\u0dca, \u0dbb\u0dcf\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0d9a\u0ddc\u02c1\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0.\n\n2025 \u0dc3\u0dd0\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 08 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1.\n\nI \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3 \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3\n\n\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1 \u0d85\u0d82\u0d82\u0d9a 01 - 2016 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dc3 01 \u0daf\u0dd2\u0db1 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 1956/16 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\n\n\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1 \u0d85\u0d82\u0d82\u0d9a 02 - 2019 \u0dc3\u0dd0\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 16 \u0daf\u0dd2\u0db1 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2141/6 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\n\n\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1 \u0d85\u0d82\u0d82\u0d9a 03 - 2020 \u0da2\u0db1\u0dc0\u0dcf\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 21 \u0daf\u0dd2\u0db1 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2159/11 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\n\n\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1 \u0d85\u0d82\u0d82\u0d9a 04 - 2020 \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 24 \u0daf\u0dd2\u0db1 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2203/8 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\n\n\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1 \u0d85\u0d82\u0d82\u0d9a 05 - 2021 \u0da2\u0dd4\u0db1\u0dd2 \u0db8\u0dc3 23 \u0daf\u0dd2\u0db1 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2233/28 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u200d\u200d\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\n\n2 AI fldgi: (I) fPoh - Y%S ,xld m%cd