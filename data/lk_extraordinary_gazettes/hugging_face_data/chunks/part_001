    "chunk_text": "\u0dc0\u0dd2\u0db1\u0dd2\u0dbe\u0dca\u0da0\u0dba\u0dca\u0dad \u0dc0\u0dc1 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dba\u0dbe\u0dda\u0dbf \u0dba\u0dc1\u0ddd \u0d89\u0dca\u0dad\u0dba\u0da2\u0dcf\u0dca\u0dad\u0dbf\u0dca\u0dad \u0dcf\u0dc1\u0db1\u0db8\u0dca \u0dba\u0db4\u0dde\u0dca\u0db0\u0d9c\u0dbd\u0dd2\u0d9a \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dbe\u0dcf\u0dbc\u0dda\u0dbd\u0dba \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dba\u0dda4\u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dbd\u0dca\u0dad\u0dba\u0dda \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d9a\u0dba\u0dd2\u0dad\u0dd2 \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0dda \u0d9a\u0dba\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0dbf\u0dcf\u0dba\u0dbd\u0dca\u0dad \u0d87\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dda \u0dba\u0d9a\u0ddc\u0da7\u0dba\u0dc0\u0dda \u0dc0\u0db8\u0dca\u0db4\u0dd5\u0dbb\u0dca\u0dab \u0db1\u0db84\u0db1\u0db8\u0dca \u0dc0\u0dc1 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u0dc1\u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db4\u0dda \u0d89\u0da9\u0dba\u0db8\u0dca \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dc0\u0dc1 \u0d8b\u0d9a\u0dc0\u0dca \u0dc0\u0dc1 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0d82\u0d9a\u0dba \u0d9a\u0d82\u0d9a\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dc0\u0dca\u0dbd\u0db7\u0dcf\u0dbd\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb (\u0dba\u0dc1\u0d9a\u0dca\u0d9a\u0dba\u0da7\u0dba\u0dcf\u0dbb\u0dca)\n\n5 A III \u0dc1\u0d9a\u0ddc\u0da7\u0dc0 - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbc\u0d82\u0d9a \u200d\u0dbb\u0da2\u0dcf \u0dad \u0dca\u0daf\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc0\u0db8 \u0da2\u0dcf\u0dbd \u0da2 \u0da2\u0dcf\u0db1\u0dbb\u0da2\u0dcf\u0dc1\u0d85 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dbe\u0dbf \u0d9c\u0dd0\u0dc0 \u0db4 \u0dad\u200d\u0dbb\u0dba - 2025.08.14\n\n1998 \u0d85\u0d82\u0d9a 21 \u0dcf \u0dbb\u0db1 \u0d