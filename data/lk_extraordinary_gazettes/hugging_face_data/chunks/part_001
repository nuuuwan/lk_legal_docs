u0dba \u0dc0\u0db1 \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\ufffd 326 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f 2025.06.12 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0d85\u0d82\u0d82\u0d9a 2440/21 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\ufffd \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0dc4 \u0d9a\u0dd1\u0dd1\u0d9c\u0dbd\u0dca\u0dbd \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0dca\u200d\u0dba\u0dba \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc3\u0dc4 \u0dc3\u0db7\u0dd2\u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf \u0d9c\u0dd9\ufffd\u0dc0\u0dd3\u0db8\u0da7 \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db4\u0dc4\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\ufffd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db6\u0dc0 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2' \u0d92. \u0d92. \u0dc3\u0dd3. \u0da2\u0dda\u0dda. \u0dbb\u0dcf\u0dcf\u0da2\u0dbb\u0dad\u0dca\u0db1, \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb, \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dad'\n\n\u0dc0\u0dbb\u0dca\u0dc2 2025 \u0d9a\u0dca \u0dc0\u0dd6 \u0d85\u0d9c\u0ddd\ufffd\u0ddd\ufffd\u0dc3\u0dca\u0dad\u0dd4 \u0db8\u0dc3 22 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0\u0dbb \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba,\u0db1\u0dc0 \u0db1\u0d9c\u0dbb\u0dba, \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf \u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9c\u0dd2\u0dbd\u0dca\u0dbd\u0dda\ufffd \u0daf\u0dd3 \u0dba'\n\n\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1 \u0d85\u0d82\u0d82\u0d9a 01\n\n6 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dbb \u0d92 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\n\n\u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9a \u0dba\u0db8\u0dca \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0d9a\u0da7 \u0dc3\u0dc4\u0db7\u0dcf\u0dcf\u0d9c\u0dd2 \u0dc0\u0dd3\u0db8 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db4\u0dc0\u0dbb\u0db1 \u0dbb\u0dcf\u0dcf\u0da2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0dad\u0d9a\u0da7 \u0dc3\u0dc4\u0db7\u0dcf\u0dcf\u0d9c\u0dd2 \u0dc0\u0dd3\u0db8 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2, \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0dca\u200d\u0dba\u0dba \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0dc3\u0db7\u0dd2\u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0db8\u0dcf\u0dcf\u0dc3\u0dd2\u0d9a\u0dc0 \u0d9c\u0dd9\ufffd\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0dd0\u0dd0\u0db4\u0dd3\u0db8\u0dca \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf, \u0d9c\u0db8\u0db1\u0dca \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0dca\u0dc0\u0dbd \u0d91\u0d9a\u0dad\u0dd4\u0dc0 \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a \u0d85\u0dba\u0dc0\u0dd0\u0dd0\u0dba \u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u024f \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0db8\u0dca \u0dc3\u0dd0\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dca\u0dbd\u0da7 \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0d85\u0da7 \u0daf\u0dc4\u0dc3\u0d9a \u0d8b\u0db4\u0dbb\u0dd2\u0db8\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba.\n\nIV ^w& jeks fldgi - Y%S ,xld m%cd;dka;%sl iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'08'252 A\n\n\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1 \u0d85\u0d82\u0d82\u0d9a 02\n\n7 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dc0\u0db1, \u0db4\u0dbb\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dbb \u0d92 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0db4\u0dbb\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 -\n\n\u0db4\u0dbb\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da8\u0dba\n\n(\u0db8\u0dd4\u0dbd\u0dca \u0db4\u0dd2\u0da7\u0dd4\u0dc0)\n\n\u0dba\u0dd0\u0dd0\u