\u0dcf 06, \u0da2\u0dcf\u0dcf\u0dc0\u0dcf\u0dcf \u0db4\u0da7\u0dd4\u0db8\u0d9f, \u0d85\u0d82\u0d82\u0d9a 01/\u0d92 \u0dc4\u0dd2 \u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2, \u0db8\u0dc4\u0dca\u0dbb\u0dd6\u0db4\u0dca \u0db8\u0dd4\u0dc4\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0db8\u0dd4\u0db1\u0dcf\u0dcf\u0dc3\u0dca \u0db8\u0dc4\u0dad\u0dcf\u0dcf, \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0dcf\u0db8\u0dbd\u0dba \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0d9a\u0dbd\u0dcf\u0dcf\u0db4\u0dba \u0dad\u0dd4\u0dc5 \u0daf\u0dd9\u0dd9\u0db8\u0dc5 \u0db7\u0dcf\u0dcf\u0dc2\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0db1\u0ddc\u02d8\u0ddc\u0dad\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0d9a\u0dd9\ufffd\u0db1\u0dd9\u02d8\u0d9a\u0dd4 \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca;\n\n2. \u0d9c\u0db8\u0dca\u0db4\u0dc4, \u0d9a\u0dd2\u0dbb\u0dd2\u0db3\u0dd2\u0dc0\u0dd2\u0da7, \u0d85\u0d82\u0d82\u0d9a 23/2 \u0dc4\u0dd2 \u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2, \u0db8\u0dd4\u0dad\u0dd4\u0db8\u0dd4\u0dab\u0dd2 \u0dbb\u0d82\u0d82\u0d9c\u0dd2\u0d9a\u0dcf\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0db8\u0dcf\u0dcf\u0dbd\u0dd2 \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf\u0dcf \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2\u0dba, \u0d9c\u0db8\u0dca\u0db4\u0dc4 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0d9a\u0dbd\u0dcf\u0dcf\u0db4\u0dba \u0dad\u0dd4\u0dc5 \u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbd \u0db7\u0dcf\u0dcf\u0dc2\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0db1\u0ddc\u02d8\u0ddc\u0dad\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0d9a\u0dd9\ufffd\u0db1\u0dd9\u02d8\u0d9a\u0dd4 \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca;\n\n3. \u0dc0\u0dc3\u0dca\u0d9a\u0da9\u0dd4\u0dc0, \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb\u0d9c\u0db8 \u0db4\u0dcf\u0dcf\u0dbb, \u0d85\u0d82\u0d82\u0d9a 161 \u0dc4\u0dd2 \u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2, \u0d85\u0d9c\u0db8\u0dca\u0db4\u0ddc\ufffd\u0ddc\u0da9\u0dd2 \u0dc4\u0dd2\u0db8\u0dcf\u0dcf\u0dbd \u0dc3\u0db1\u0dca\u0daf\u0dda\u0dda\u0dc1\u0dca \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf\u0dcf \u0db8\u0dc4\u0dad\u0dcf\u0dcf, \u0d9a\u0dc5\u0dd4\u0dad\u0dbb \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0d9a\u0dbd\u0dcf\u0dcf\u0db4\u0dba \u0dad\u0dd4\u0dc5 \u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbd \u0db7\u0dcf\u0dcf\u0dc2\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0db1\u0ddc\u02d8\u0ddc\u0dad\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0d9a\u0dd9\ufffd\u0db1\u0dd9\u02d8\u0d9a\u0dd4 \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca;\n\n4. \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0dcf\u0db8\u0dbd\u0dba, \u0db4\u0dc0\u0dbb\u0dca \u0dc4\u0dc0\u0dd4\u0dc3\u0dca \u0db4\u0dcf\u0dcf\u0dbb, \u0d85\u0d82\u0d82\u0d9a 100 \u0dc4\u0dd2 \u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2, \u0d8b\u0dad\u0dca\u0dad\u0db1\u0dca\u0da9\u0dd2\u0da0\u0dd9\u0dd9\u0da7\u0dca\u0da7\u0dd2 \u0dc3\u0dc3\u0dd2\u0dc3\u0dd4\u0daf\u0dcf\u0dcf\u0da2\u0dd2\u0db1\u0dd3 \u0db8\u0dd9\ufffd\u0db1\u0dd9\u02d8\u0dc0\u0dd2\u0dba, \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0dcf\u0db8\u0dbd\u0dba \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0d9a\u0dbd\u0dcf\u0dcf\u0db4\u0dba \u0dad\u0dd4\u0dc5 \u0daf\u0dd9\u0dd9\u0db8\u0dc5 \u0db7\u0dcf\u0dcf\u0dc2\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0db1\u0ddc\u02d8\u0ddc\u0dad\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0d9a\u0dd9\ufffd\u0db1\u0dd9\u02d8\u0d9a\u0dd4 \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca;\n\n5. \u0dad\u0ddc\ufffd\u0ddc\u0da9\u0dd4\u0dc0\u0dcf\u0dcf\u0dc0, \u0db6\u0dbb\u0dd4\u0daf\u0dd0\u0dd0\u0dbd\u0dca\u0db4\u0ddc\ufffd\u0ddc\u0dbd, \u0d85\u0d82\u0d82\u0d9a 532/\u0d92 \u0dc4\u0dd2 \u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2, \u0db1\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a\u0dca\u0d9a\u0dcf\u0dcf\u0dbb \u0db8\u0dc4\u0d9c\u0dd4\u0dbb\u0dd4\u0d9c\u0dda\u0118 \u0da9\u0dd2\u0dbd\u0dca\u0d9a\u0dd2 \u0db8\u0db0\u0dd4\u0dc2\u0dcf\u0dcf\u0db1\u0dd2 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2\u0dba, \u0dc4\u0dbd\u0dcf\u0dcf\u0dc0\u0dad \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0d9a\u0dbd\u0dcf\u0dcf\u0db4\u0dba \u0dad\u0dd4\u0dc5 \u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbd \u0db7\u0dcf\u0dcf\u0dc2\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0db1\u0ddc\u02d8\u0ddc\u0dad\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0d9a\u0dd9\ufffd\u0db1\u0dd9\u02d8\u0d9a\u0dd4 \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca;\n\n6. \u0db6\u0d82\u0d82\u0d9c\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba, \u0da2\u0dda\u0dda. \u0db4\u0dd3. \u0dc0\u0dad\u0dca\u0dad, \u0d85\u0d82\u0d82\u0d9a 294/\u0d92 \u0dc4\u0dd2 \u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2, \u0db6\u0dcf\u0dcf\u0dbd\u0da0\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda\u0118 \u0daf\u0ddc\ufffd\u0ddc\u0db1\u0dca \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd2 \u0dad\u0dbb\u0d82\u0d82\u0d9c\u0dd2\u0d9a\u0dcf\u0dcf \u0dc0\u0dd2\u0da2\u0dda\u0dda\u0dc3\u0dd2\u0dbb\u0dd2 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2\u0dba, \u0dc4\u0dbd\u0dcf\u0dcf\u0dc0\u0dad \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0d9a\u0dbd\u0dcf\u0dcf\u0db4\u0dba \u0dad\u0dd4\u0dc5 \u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbd \u0db7\u0dcf\u0dcf\u0dc2\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0db1\u0ddc\u02d8\u0ddc\u0dad\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0d9a\u0dd9\ufffd\u0db1\u0dd9\u02d8\u0d9a\u0dd4 \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca;\n\n7. \u0daf\u0db1\u0dca\u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dd4\u0dc0, \u0db8\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dd4\u0d9a\u0dca\u0d9a\u0dd4\u0dbd\u0dd2\u0dba, \u0d85\u0d82\u0d82\u0d9a 295 \u0dc4\u0dd2 \u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2, \u0db8\u0dcf\u0dcf\u0dbb\u0dc3\u0dd2\u0d82\u0d82\u0dc4 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda\u0118 \u0dc3\u0db3\u0dd4\u0db1\u0dd2 \u0dc2\u0dd9\u0dd9\u0dbb\u0ddd\ufffd\u0ddd\ufffd\u0db1\u0dca \u0d8b\u0db8\u0dda\ufffd\u0dc2\u0dcf\u0dcf \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2\u0dba, \u0dc4\u0dbd\u0dcf\u0dcf\u0dc0\u0dad \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0d9a\u0dbd\u0dcf\u0dcf\u0db4\u0dba \u0dad\u0dd4\u0dc5 \u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbd \u0db7\u0dcf\u0dcf\u0dc2\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1 \u0db1\u0ddc\u02d8\u0ddc\u0dad\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0d9a\u0dd9\ufffd\u0db1\u0dd9\u02d8\u0d9a\u0dd4 \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca;"
