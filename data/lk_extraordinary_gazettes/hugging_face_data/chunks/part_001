\u0bbf\u0ba9\ufffd\u0bcb\u0bb2\u0bbf \u0ba4\u0bbf\u0ba9\u0bbf\u0ba4\u0bbf \u0bb9\u0b9a\u0bbe\u0bb0\u0bbe \u0b95\u0bc1\u0ba3\u0bb0\u0ba4\u0bcd\u0bcd\u0ba9 \u0b85\u0bb5\u0bbe\u0bcd\u0b95\u0bb3 \u0b95\ufffd\u0bca\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1 \u0ba8\u0bc0\u0ba4\u0bbe\u0b9a\u0ba9 \u0bb5\u0bb2\u0baf\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0b9a\u0bbf\u0b99\u0bcd\u0bcd\u0b95\u0bb3 \u0bae\ufffd\u0bca\u0bb4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0baa\u0ba3\u0bbf\u0baf\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\ufffd\u0bca\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbe\u0bbe\u0bbf\u0b9a\u0bc1 \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\u0bbe\u0b95.\n\n2. \u0ba4\u0b99\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0bb2\u0bc8, \u0b95\ufffd\u0bca\u0baf\u0bae\u0bcd\u0baa\u0bca\u0b95\u0bcd\u0bcd\u0b95, \u0bae\u0bb2\u0bcd\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bcd\u0ba4 \u0b87\u0bb2\u0bcd \u0bb5\u0ba4\u0bbf\u0baf\u0bc1\u0bae\u0bcd, \u0b9a\u0bc6\u0bb2\u0bcd\u0bcd\u0bb5\u0bb5\u0bbf \u0b95\u0bbe\u0bb5\u0bbf\u0ba8\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0baf\u0bbe \u0b9a\u0ba8\u0bcd\u0bcd\u0ba4\u0b95\u0bb2\u0ba9\u0bbf \u0b85\u0ba8\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0bb0\u0bbe\u0bb9\u0bc6\u0ba9\u0bcd\u0bcd\u0ba9\u0ba4\u0bbf \u0b85\u0bb5\u0bbe\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0b99\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0bb2\u0bc8 \u0ba8\u0bc0\u0ba4\u0bbe\u0b9a\u0ba9 \u0bb5\u0bb2\u0baf\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0b9a\u0bbf\u0b99\u0bcd\u0bcd\u0b95\u0bb3 \u0bae\ufffd\u0bca\u0bb4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0baa\u0ba3\u0bbf\u0baf\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\ufffd\u0bca\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbe\u0bbe\u0bbf\u0b9a\u0bc1 \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\u0bbe\u0b95.\n\n3. \u0baa\u0bc1\u0ba4\u0bcd\u0bcd\u0ba4\u0bb2, \u0bb0\u0b9c \u0bae\u0bbe\u0bb5\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bc8, 19 \u0b86\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0bcd\u0b9f\u0b9f\u0bc8, \u0b87\u0bb2. 70 \u0b87\u0bb2\u0bcd \u0bb5\u0ba4\u0bbf\u0baf\u0bc1\u0bae\u0bcd, \u0b9a\u0bc6\u0bb2\u0bcd\u0bcd\u0bb5\u0bb5\u0bbf \u0b9a\u0bc1\u0bb0\u0bb5\u0bc0\u0bb0 \u0b86\u0bb0\u0b9a\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf\u0b95\u0bc7 \u0bb2\u0b95\u0bcd\u0bcd\u0bae\u0bae\u0bbf\u0ba9\u0bbf \u0bae\u0ba4\u0bc1\u0bb0\u0b99\u0bcd\u0bcd\u0b95\u0b95\u0bbf \u0b85\u0bb5\u0bbe\u0bcd\u0b95\u0bb3\u0bcd \u0bae\ufffd\u0bca\u0ba9\u0bb0\u0bbe\u0b95\u0bb2\u0bc8 \u0ba8\u0bc0\u0ba4\u0bbe\u0b9a\u0ba9 \u0bb5\u0bb2\u0baf\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0b9a\u0bbf\u0b99\u0bcd\u0bcd\u0b95\u0bb3 \u0bae\ufffd\u0bca\u0bb4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0baa\u0ba3\u0bbf\u0baf\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\ufffd\u0bca\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbe\u0bbe\u0bbf\u0b9a\u0bc1 \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\u0bbe\u0b95."
