u0dda\u0dda\u0dbd\u0dcf\u0dcf\u0dc0\n\n\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba / \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dba\u0dc0\u0dcf\u0dcf\u0dc4\u0db1 \u0d85\u0d82\u0d82\u0d9a\u0dba\u0daf\u0dd4\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba\n\n\u0dc0\u0dcf\u0dcf\u0dc4\u0db1\u0dba\u0da7 \u0d9c\u0dd9\ufffd\u0dc0\u0dd6 \u0d9a\u0dd4\u0dbd\u0dd2\u0dba\u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dcf\u0dc4\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf\u0dc0 \u0dbb\u0dd4.\n\n\u0dba\u0dd0\u0dd0\u0db4\u0dd3\u0db8\u0dca \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf\u0dc0\n\nEOG 09 - 0072/1\n\n\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\u2013\n\n1989 \u0d85\u0d82\u0d82\u0d9a 12 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf (\u0d86\u0db1\u0dd4\u0dc2\u0dcf\u0d82\ufffd\u0d82\u0d9c\u0dd2\u0d9a \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1) \u0db4\u0db1\u0dad\u0dda\ufffd 2 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0d9a\u0dd2\u0dba\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 255 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba \u0dc0\u0db1 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\ufffd 193 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0daf\u0db1\u0dba\u0dba\u0dd2\n\n\u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\ufffd \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dcf\u0dcf\u0dbb \u0dc0\u0db1 \u0d92. \u0d92. \u0dc3\u0dd3. \u0da2\u0dda\u0dda. \u0dbb\u0dcf\u0dcf\u0da2\u0dbb\u0dad\u0dca\u0db1 \u0dc0\u0db1 \u0db8\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca, 1989 \u0d85\u0d82\u0d82\u0d9a 12 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf (\u0d86\u0db1\u0dd4\u0dc2\u0dcf\u0d82\ufffd\u0d82\u0d9c\u0dd2\u0d9a \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1) \u0db4\u0db1\u0dad\u0dda\ufffd 2 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0d9a\u0dd2\u0dba\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 255 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba \u0dc0\u0db1 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\ufffd 193 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb 2025.05.30 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0d85\u0d82\u0d82\u0d9a 2438/63 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\ufffd \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2, \u0d8b\u0db4\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0dc3\u0db7\u0dd2\u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf \u0d9c\u0dd9\ufffd\u0dc0\u0dd3\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc0\u0db1 \u0dbb\u0dd3\u0dad\u0dd2 \u0db8\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0 \u0db4\u0dc4\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\ufffd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db6\u0dc0 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2' \u0d92. \u0d92. \u0dc3\u0dd3. \u0da2\u0dda\u0dda. \u0dbb\u0dcf\u0dcf\u0da2\u0dbb\u0dad\u0dca\u0db1, \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb, \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dad'\n\n\u0dc0\u0dbb\u0dca\u0dc2 2025 \u0d9a\u0dca \u0dc0\u0dd6 \u0d85\u0d9c\u0ddd\ufffd\u0ddd\ufffd\u0dc3\u0dca\u0dad\u0dd4 \u0db8\u0dc3 22 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0\u0dbb \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba,\u0db1\u0dc0 \u0db1\u0d9c\u0dbb\u0dba, \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2,\u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf \u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9c\u0dd2\u0dbd\u0dca\u0dbd\u0dda\ufffd \u0daf\u0dd3 \u0dba'\n\nIV ^w& jeks fldgi - Y%S ,xld m%cd;dka;%sl iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'08'254 A\n\n\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1 \u0d85\u0d82\u0d82\u0d9a 01\n\n5 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dbb \u0d92 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\n\n\u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9a \u0dba\u0db8\u0dca \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0d9a\u0da7 \u0dc3\u0dc4\u0db7\u0dcf\u0dcf\u0d9c\u0dd2 \u0dc0\u0dd3\u0db8 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db4\u0dc0\u0dbb\u0db1 \u0dbd\u0daf \u0dbb\u0dcf\u0dcf\u0da2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0dad\u0d9a\u0da7 \u0dc3\u0dc4\u0db7\u0dcf\u0dcf\u0d9c\u0dd2 \u0dc0\u0dd3\u0db8 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2, \u0d8b\u0db4\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0dc3\u0db7\u0dd2\u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0db8\u0dcf\u0dcf\u0dc3\u0dd2\u0d9a\u0dc0 \u0d9c\u0dd9\ufffd\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0dd0\u0dd0\u0db4\u0dd3\u0db8\u0dca \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf, \u0d9c\u0db8\u0db1\u0dca \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0dca\u0dc0\u0dbd \u0d91\u0d9a\u0dad\u0dd4\u0dc0 \u0d8b\u0db4\u0dbb\u0dd2\u0db8\u0dba \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a \u0d85\u0dba\u0dc0\u0dd0\u0dd0\u0dba \u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u024f \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0db8\u0dca \u0dc3\u0dd0\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dca\u0dbd\u0da7 \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0d85\u0da7 \u0daf\u0dc4\u0dc3\u0d9a \u0d8b\u0db4\u0dbb\u0dd2\u0db8\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba.\n\n\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1 \u0d85\u0d82\u0d82\u0d9a 02"
