dca\u0dca\u0dc0\u0db7\u0dcf\u0dcf\u0dc0\u0dba/\u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dca\u0d9a\u0dbb\u0dab\u0d85\u0d82\u0d82\u0d9a\u0dba\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\ufffd\u0db0\u0db1 \u0d85\u0d82\u0d82\u0d9a\u0dba\u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0d9a\u0dbb\u0dd4\u0dab\u0dd4\n\nS.N.: 049IS-01-4.6\n\n1 \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 - 4 \u0db4\u0dbb\u0dd2\u0da0\u0dca\u0da1\u0dda\u0dda\u0daf\u0dba \u0dc3\u0db8\u0d9c\n\n\u0d85\u0db1\u0dd4\u0dc0\u0dd8\u0dd8\u0dad\u0dca\u200d\u0dba\u0dba\u0dba \u0db4\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8.\n\n\u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf\n\n\u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba\u0dad\u0dcf\u0dcf - \u0db4\u0dd2\u0dba\u0dc3\u0dbb \u0db8\u0dd9\ufffd\u0dc4\u0dd9\ufffd\u0dba\u0dd4\u0db8\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd3 / \u0db4\u0dd2\u0dba\u0dc3\u0dbb \u0db4\u0dd2\u0da7\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\n\n29.03.2021\u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dba0102\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2 \u0d85\u0d82\u0d82\u0d9a 49, 01 \u0dc0\u0db1 \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dca\u0d9a\u0dbb\u0dab\u0dba\u0dd9\ufffd\u0dc4\u0dd2\n\n\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\ufffd\u0db0\u0db1 01 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7\n\nS.N.: 050IS-1-1\n\n1 \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8 - 1 \u0db4\u0dbb\u0dd2\u0da0\u0dca\u0da1\u0dda\u0dda\u0daf\u0dba \u0dc3\u0db8\u0d9c\n\n\u0d85\u0db1\u0dd4\u0dc0\u0dd8\u0dd8\u0dad\u0dca\u200d\u0dba\u0dba\u0dba \u0db4\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8. \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba\u0dad\u0dcf\u0dcf -\n\n\u0d85\u0dbb\u0dca\u0dae \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0db4\u0ddc\ufffd\u0ddc\u0daf\u0dd4 \u0dbb\u0dd3\u0dad\u0dd2\n\n01.04.2022\u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dba0300\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2 \u0d85\u0d82\u0d82\u0d9a 050, 02 \u0dc0\u0db1 \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dca\u0d9a\u0dbb\u0dab\u0dba\u0dd9\ufffd\u0dc4\u0dd2\n\n\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\ufffd\u0db0\u0db1 02 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7\n\nS.N.: 051CA-IS-2015-PEL-003\n\n\u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf\n\n\u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba\u0dad\u0dcf\u0dcf- \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0db1\u0dd2\u0dba\u0db8\u0dd4 \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0db129.09.2015\u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dba0100\n\n\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2 \u0d85\u0d82\u0d82\u0d9a 051 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2 \u0d85\u0d82\u0d82\u0d9a 72, 01 \u0dc0\u0db1\n\n\u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dca\u0d9a\u0dbb\u0dab\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\ufffd\u0db0\u0db1 00 \u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0dad\u0dcf\u0dcf \u0dc0\u0dda\u0dda.\n\nS.N.: 052CA-IS-2016-GEN-03\u0dc3\u0dca\u0dca\u0dc0\u0dda\u0dda\u0da0\u0dca\u0da1\u0dcf\u0dcf \u0dc3\u0dc4 \u0dbb\u0dc4\u0dc3\u0dca\u200d\u0dba\u0dba \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dda\u02e6\u0dda\u0dc0\u0dcf\u0dcf \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd3\u0db8\u0dca \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba28.11.2016\u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dba0100\u0db1\u0dc0\n\nS.N.: 053\n\nUAS-IS-2025\n\n\u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca \u0dbb\u0dc4\u0dd2\u0dad \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0dcf\u0db1\u0dcf\u0dcf \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba\u0dad\u0dcf\u0dcf (\u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca \u0dbb\u0dc4\u0dd2\u0dad \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dcf\u0dcf\u0dc4\u0db1/\u0daf\u0dd4\u0dbb\u0dc3\u0dca\u0dca\u0dae\u0dc0 \u0db1\u0dd2\u0dba\u0db8\u0dd4 \u0d9a\u0dc5 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0dcf\u0db1\u0dcf\u0dcf)\n\n01.03.2025\u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dba0100\u0db1\u0dc0 \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dca\u0d9a\u0dbb\u0dab\u0dba\u0dda\u024f \u0d85\u0daf\u0dcf\u0dcf\u0dc5\u0dad\u0dca\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dbb \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0d9a\u0dbb \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2 \u0d85\u0d82\u0d82\u0d9a 053 \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dca\u0d9a\u0dbb\u0dab\u0dba 02 \u0dc4\u0dd2 \u0db6\u0dbd\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd3\u0db8 \u0dc3\u0dc4 \u0d85\u0daf\u0dcf\u0dcf\u0dc5\u0dad\u0dca\u0dc0\u0dba \u0db4\u0dd2\u0da7\u0dd4\u0dc0 \u0db6\u0dbd\u0db1\u0dca\u0db1.UAS\u2013IS-2022\n\n\u0daf\u0dd4\u0dbb\u0dc3\u0dca\u0dca\u0dae \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\n\n\u0db8\u0dd9\ufffd\u0dc4\u0dd9\ufffd\u0dba\u0dd4\u0db8\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0dc0\u0db1\n\n\u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba\u0dad\u0dcf\u0dcf (\u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca \u0dbb\u0dc4\u0dd2\u0dad \u0d9c\u0dd4\u0dc0\u0db1\u0dca\n\n\u0dc0\u0dcf\u0dcf\u0dc4\u0db1/ \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca \u0dbb\u0dc4\u0dd2\u0dad \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0dcf\u0db1\u0dcf\u0dcf \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2/\u0daf\u0dd4\u0dbb\u0dc3\u0dca\u0dca\u0dae\u0dc0 \u0db1\u0dd2\u0dba\u0db8\u0dd4 \u0d9a\u0dc5\u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0dcf\u0db1\u0dcf\u0dcf/\u0da9\u0dca\u200d\u0dbb\u0ddd\u0190\u0ddd\ufffd\u0db1 \u0dba\u0dcf\u0dcf\u0db1\u0dcf\u0dcf)\n\n06.01.2022\u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dba0103\n\nA"
