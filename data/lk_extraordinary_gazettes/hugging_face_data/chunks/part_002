14 \u0b86\u0bae\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bcd \u0b95\u0733\u0bb4\u0bcd \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1\u0731\u0732\u0ba4\u0bcd\u0ba4\u0731\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0732\u0ba9\u0bcd \u0baa\u0baf\u0738\u0ba9\u0b95\u0bcd\u0736\u0b95\u0731\u0ba3\u0bcd\u0b9f\u0bc1, \u0b95\u0733\u0737\u0bb4 \u0b92\u0baa\u0bcd\u0baa\u0bae\u0732\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba8\u0731\u0ba9\u0bcd, 1998 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0732\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0bcd 12 \u0b86\u0bae\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bcd \u0ba8\u0732\u0baf\u0ba4\u0732\u0b95\u0bb3\u0732\u0ba9\u0bcd\u0baa\u0b9f\u0bbf 2024 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0737\u0bae 14 \u0b86\u0ba8\u0bcd \u0ba4\u0732\u0b95\u0ba4\u0732\u0baf 2384/20 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0731\u0ba9\u0732\u0baf\u0732\u0bb2\u0bcd \u0b89\u0731\u0732\u0baf \u0bae\u0bc1\u0738\u0bb1\u0baf\u0732\u0bb2\u0bcd \u0736\u0bb5\u0bb3\u0732\u0baf\u0732\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\u0bae\u0bcd, \u0b95\u0731\u0ba3\u0732\u0b95\u0bcd\u0b95\u0731\u0ba9 \u0b89\u0731\u0732\u0738\u0bae\u0b95\u0bcd \u0737\u0b95\u0731\u0731\u0732\u0b95\u0bcd\u0738\u0b95\u0b95\u0738\u0bb3\u0b95\u0bcd \u0737\u0b95\u0731\u0bb0\u0bc1\u0b95\u0732\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1\u0bae\u0731\u0ba9 11/0504 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b85\u0bb1\u0732\u0bb5\u0732\u0ba4\u0bcd\u0ba4\u0bb2\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0732\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bc1 \u0736\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0b9f\u0bae\u0ba4\u0bcd\u0ba4\u0732\u0baf \u0bae\u0731\u0b95\u0731\u0ba3\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0b85\u0ba8\u0bc1\u0bb0\u0731\u0ba4\u0baa\u0bc1\u0bb0\u0bae\u0bcd \u0bae\u0731\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd, \u0b95\u0bb2\u0bcd\u0736\u0ba8\u0bb5 \u0baa\u0732\u0bb0\u0737\u0ba4\u0b9a \u0736\u0b9a\u0baf\u0bb2\u0731\u0bb3\u0bb0\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0bb2\u0bcd, \u0b87\u0bb2. 468 - \u0b9a\u0732\u0baf\u0bae\u0bcd\u0baa\u0737\u0bb2\u0736\u0bb5\u0bb5 \u0b95\u0732\u0bb0\u0731\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bc1\u0bb3\u0bcd \u0730\u0734\u0ba3\u0bc1\u0736\u0baa\u0731\u0bb2\u0b95\u0bae ( \u0b85\u0bb2\u0bc1\u0ba4\u0bcd\u0736\u0bb5\u0bb5 \u0736\u0ba8\u0bb2\u0bc1\u0bae\u0bcd\u0baa\u0ba4\u0bcd\u0b95\u0bae) \u0b95\u0732\u0bb0\u0731\u0bae\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0b85\u0738\u0bae\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0bae\u0bcd 110775 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb0\u0bb2\u0bcd \u0b85\u0bb3\u0738\u0bb5 \u0bb5\u0738\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0bc1 \u0b87\u0bb2. 1 \u0b87\u0bb2\u0bcd \u0b85\u0b9f\u0b99\u0bcd\u0b95\u0732\u0baf\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0bae\u0731\u0ba9 1 : 112, 1 : 113 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 1 : 114 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0738\u0bb3\u0b95\u0bcd \u0736\u0b95\u0731\u0ba3\u0bcd\u0b9f \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0731\u0ba9 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0736\u0ba4\u0731\u0b9f\u0bb0\u0bcd\u0baa\u0731\u0b95 \u0b87\u0ba4\u0737\u0ba9\u0731\u0b9f\u0bc1 \u0b87\u0738\u0ba3\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0738\u0ba3\u0baf\u0732\u0bb2\u0bcd \u0ba4\u0bb0\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0bb5\u0731\u0bb1\u0731\u0ba9 \u0b8e\u0ba9\u0ba4\u0bc1 \u0ba4\u0733\u0bb0\u0bcd\u0bae\u0731\u0ba9\u0ba4\u0bcd\u0738\u0ba4 \u0b87\u0ba4\u0bcd\u0ba4\u0731\u0bb2\u0bcd \u0736\u0bb5\u0bb3\u0732\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0732\u0ba9\u0bcd\u0737\u0bb1\u0ba9\u0bcd.\n\n\u0baa\u0bc0.\u0b9a\u0733.\u0b9f\u0bc0. \u0b9a\u0732\u0737\u0b95\u0bb0\u0731, \u0b95\u0731\u0ba3\u0732 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba8\u0732\u0bb0\u0bcd\u0ba3\u0baf \u0b86\u0738\u0ba3\u0baf\u0731\u0bb3\u0bb0\u0bcd \u0ba8\u0731\u0baf\u0b95\u0bae\u0bcd. \u0b95\u0731\u0ba3\u0732 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba8\u0732\u0bb0\u0bcd\u0ba3\u0baf\u0ba4\u0bcd \u0ba4\u0732\u0738\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0732\u0730\u0732\u0b95\u0ba4 \u0736\u0bae\u0ba4\u0bc1\u0bb0\u201d, \u0b87\u0bb0\u0b9c\u0bae\u0bb2\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4 \u0bb5\u0bc0\u0ba4\u0732, \u0baa\u0ba4\u0bcd\u0ba4\u0bb0\u0bae\u0bc1\u0bb2\u0bcd\u0738\u0bb2, 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0baf\u0bc2\u0738\u0bb2 \u0bae\u0731\u0ba4\u0bae\u0bcd 02 \u0b86\u0bae\u0bcd \u0ba4\u0732\u0b95\u0ba4\u0732.\n\n\u0b87\u0bb2\u0b99\u0bcd\u0738\u0b95\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0731\u0baf\u0b95 \u0737\u0b9a\u0731\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bb0\u0b9a\u0bc1 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0731\u0ba9\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0732\u0731\u0732\u0738\u0b95\n\n(\u0b85\u0bb0\u0b9a\u0731\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0bcd \u0b85\u0ba4\u0732\u0b95\u0731\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd \u0baa\u0732\u0bb0\u0b9a\u0bc1\u0731\u0732\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1)\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u02e2\u02ad\u0d9a\u02eb \u0db4\u0dca\u200d\u0dbb\u0da2\u02eb\u02d4\u02eb\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u02de\u02eb\u0da2\u02e3\u02eb\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u02f3\u024f \u02c3\u02ec\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\n\n\u0dd2 \u0dc0 \u0dc1\u0dd9\u02f3\u02e4\u0d9c \u0b85\u0ba4\u0732 \u0bb5\u0732\u0737\u0b9a\u0bb7\u0bae\u0731\u0ba9\u0ba4\u0bc1\n\n\u0dd2\u02ad\u0d9a \u0dc3 2447/46 - 2025 \u0da2\u0dd6\u0dbd\u0dd2 \u0db8\u0dc3 31 \u02e3\u02ec\u0db1\u0dd2 \u0db6\u0dca\u200d\u0dbb\u0dc4\u0dc3\u0dc3\u02ea\u0dca \u0dc0\u0dca\u0dad\u02d6\u02eb - 2025.07.31\n\n2447/46 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd - 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0baf\u0bc2\u0738\u0bb2 \u0bae\u0731\u0ba4\u0bae\u0bcd 31 \u0b86\u0ba8\u0bcd \u0ba4\u0732\u0b95\u0ba4\u0732 \u0bb5\u0732\u0baf\u0731\u0bb4\u0b95\u0bcd\u0b95\u0732\u0bb4\u0738\u0bae\n\n\u0bae\u0bc1. \u0b95\u0bc1. - \u0b87\u0bb5\u0bcd \u0b85\u0ba4\u0732\u0bb5\u0732\u0737\u0bb7\u0b9f \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0731\u0ba9\u0732\u0738\u0baf www.documents.gov.lk \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0b87\u0738\u0ba3\u0baf\u0ba4\u0bcd\u0ba4\u0bb3\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0baa\u0ba4\u0732\u0bb5\u0732\u0bb1\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0736\u0b9a\u0baf\u0bcd\u0baf \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bcd.\n\n1A - G 44997 - 04 (2025/07)"
