\u0d82.\u0d86.\u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0db4\u0dda\u0db8\u0dad\u0dd2\u0dbd\u0d9a \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 345, \u0d85\u0dbd\u0dd9\u0d9a\u0ddc\u0dbd\u0dc0\u0dd0\u0dc0 \u0db4\u0dcf\u0dbb, \u0dc0\u0dd1\u0dc0\u0dbd\u0dc0\u0dd0\u0dc0, \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0daf\u0db9\u0dd4\u0dbd\u0dca\u0dbd 1:58 0.2013 \u0db6\u0dcf\u0dbd\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dd9\u0d9c\u0dca \u0d85\u0db4\u0dca\u0db4\u0dd4\u0dc4\u0dcf\u0db8\u0dd2 702263778V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86.\u0db4\u0db1\u0dd9\u0dad\u0dca \u0dbd\u0dba\u0db1\u0dbd\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 223, \u0dc0\u0dd1\u0dc0\u0dbd\u0dc0\u0dd0\u0dc0, \u0daf\u0db9\u0dd4\u0dbd\u0dca\u0dbd \u0dba\u0da7\u0dad\u0dca\u0dc0 EOG 08-0038/24\n\n21 A III \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 - \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba - 2025.08.04\n\n\u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013--\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 \u0dc0\u0dd2\u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u0ddd \u0db4\