1998 \u0d85\u0dd2\u0d82 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2 \u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad\n\n6 A III \u0dc1 \u0ddc\u0da7\u0dc3 : \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0dd2\u0d82 \u0dcf \u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2 \u0dc3\u0db8\u0dcf\u0da2\u0dcf\u0dc0\u0dcf \u0da2 \u0da2\u0dcf\u0db1\u0dbb\u0da2\u0dcf\u0dc1\u0d85 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u0dc2 \u0dd0\u0dc3 \u0db4 \u0db4\u200d\u0dbb\u0dba - 2025.08.06\n\n\u201c \u0d89\u0da9\u0dba \u0d9a \u0dba\u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0d85\u0d82\u0d9a\u0dba 104, \u0dc1\u0dd9 \u0dcf\u0dbd\u0dda\u0dc0\u0dba (\u0dba\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 0.0109\u201d \u0dba\u0dbd\u0dc3 \u0dc3\u0db3\u0dc4\u0dca\u0dad \u0dba\u0dcf\u0ddc\u0dbb\u0dad\u0dd4\u0dbb \u0d89\u0dc0\u0dda \u0d9a\u0dbb \u201c \u0d89\u0da9\u0dba \u0d9a \u0dba\u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0d85\u0d82\u0d9a\u0dba 103 \u0dc3\u0dc4 \u0dc1\u0dd9 \u0dcf\u0dbd\u0dda\u0dc0\u0dba (\u0dba\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 0.0163 \u201d\u0dba\u0dbd\u0dc3 \u0d87\u0dad\u0dd4\u0dbd\u0dda \u0d9a\u0dbb \u0dc3\u0d82\u0dba \u0ddd \u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dba\u0dda. \u0db4\u0dd3. \u0dc3\u0dd3. \u0da9\u0dd3. \u0dc3\u0dd2\u0dc1\u0dda\u0dbb\u0dcf, \u0d89\u0da9 \u0d9a \u0dc4\u0dd2\u0db8\u0dd2\u0d9a \u0d9a \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0db8 \u0d9a\u0dd2 \u0dba \u0d9a \u0dba\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0db8. 2025 \u0da2\u0dd6\u0dbd\u0dd2 \u0db8\u0dc3 11 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0db8\u0dbd \u0dbb\u0da2\u0dcf\u0db8\u0db8\u0dc0\u0dda\u0dcf \u0db4\u0dcf\u0dbb, \u201c\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dcf \u0db8\u0dd0\u0daf\u0dd4\u0dbb\u201d, \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9 \u0d9a \u0dc4\u0dd2\u0db8\u0dd2\u0d9a \u0d9a \u0db1\u0dd2\u