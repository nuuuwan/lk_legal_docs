1\u0dbb\u0da2\u0dba\u0dda \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u200d\u0dc1\u0dd9\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.05.31gFjp IV (M) - \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0b9a\ufffd\u0bcb\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bb0\u0b9a\u0bc1 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bbf\u0b95\u0bc8 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0b9a\u0bc7\u0bb7\u0bae\u0bbe\u0ba9\u0ba4\u0bc1 - 2025.05.31\n\n\u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bb3\u0bae\u0bcd \u0b95\u0bb1\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf 01 \u0baa\u0bb3\u0bcd\u0bb3\u0bbf\u0baf\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0b85\u0baa\u0bcd\u0ba4\u0bc1\u0bb2\u0bcd \u0bb0\u0b9a\u0bbe\u0b95\u0bcd \u0bae\ufffd\u0bca\u0bb9\u0bae\u0b9f\u0bcd \u0bae\u0bc1\u0b9a\u0bae\u0bcd\u0bae\u0bbf\u0bb2\u0bcd (\u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf) \u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8 02 \u0b86\u0ba9\u0bb5\u0bbe\u0b9a\u0bb2\u0bcd \u0bb9\u0bc7\u0bb0\u0ba4\u0bcd \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0b9a\u0bae\u0ba9\u0bcd \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0bb9\u0bc7\u0bb0\u0ba4\u0bcd 03 \u0bae\u0ba3\u0bcd\u0b9f\u0bb2\u0b95\u0bcd\u0b95\u0bc1\u0b9f\u0bbe \u0bae\ufffd\u0bca\u0bb9\u0bae\u0b9f\u0bcd \u0bae\u0bc0\u0bb0\u0bbe\u0b9a\u0bbe\u0bb9\u0bbf\u0baa\u0bc1 \u0b85\u0bae\u0bc0\u0bb0\u0bcd \u0baa\u0bc8\u0bb8\u0bb2\u0bcd 04 \u0b95\u0ba8\u0bcd\u0ba4\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bbf * \u0bb5\u0bb0\u0bcd\u0ba3\u0b95\u0bc1\u0bb2\u0b9a\u0bc2\u0bb0\u0bbf\u0baf \u0b9a\ufffd\u0bcc\u0bae\u0bbf\u0baf\u0bbe \u0ba8\u0bbf\u0bb7\u0bbf\u0b95\u0bbe \u0baa\u0bb0\u0bcd\u0ba9\u0bbe\u0ba8\u0ba4\u0bc1 \u0bae\u0bc1\u0bb9\u0bae\u0bcd\u0bae\u0ba4\u0bc1 \u0ba4\u0bae\u0bcd\u0baa\u0bbf \u0b87\u0baa\u0bcd\u0bb9\u0bbe\u0bae\u0bcd 05 \u0bae\u0bc1\u0b9a\u0bb2\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf \u0bb9\u0baa\u0bc0\u0baa\u0bc1 \u0bae\u0bc1\u0bb9\u0bae\u0bcd\u0bae\u0ba4\u0bc1 \u0baa\u0bb0\u0bcd\u0bb5\u0bbf\u0ba9\u0bcd 06 \u0ba4\u0bb2\u0bb5\u0bbf\u0bb2 \u0baa\u0bc1\u0bb2\u0ba4\u0bcd\u0b9a\u0bbf\u0b99\u0bcd\u0b95\u0bb3\u0b95\u0bc7 \u0ba4\ufffd\u0bca\u0ba9\u0bcd \u0bae\u0bb2\u0bcd\u0bb7\u0bbe \u0b8f\u0ba9\u0bcd \u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bbf\u0ba3\u0bbf 07 \u0b8f\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bc8 \u0bb9\u0bbe\u0b9a\u0bbf\u0bae\u0bcd \u0bae\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0bb0\u0bcd \u0bae\ufffd\u0bca\u0bb9\u0bae\u0bcd\u0bae\u0ba4\u0bc1 \u0b9a\u0bbf\u0baa\u0bbe\u0ba9\u0bcd 08 \u0ba8\u0bc1\u0bb0\u0bc8\u0b9a\u0bcd\u0b9a\u0bcb\u0bb2\u0bc8 * \u0b85\u0baa\u0bcd\u0ba4\u0bc1\u0bb2\u0bcd \u0b9a\u0ba4\u0bcd\u0ba4\u0bbe\u0bb0\u0bcd \u0bae\u0bc1\u0bb9\u0bae\u0bcd\u0bae\u0ba4\u0bc1 \u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0bb8\u0bcd \u0bb5\u0bb0\u0bcd\u0ba3\u0b95\u0bc1\u0bb2\u0b9a\u0bc2\u0bb0\u0bbf\u0baf \u0bb0\ufffd\u0bca\u0bb9\u0bbe\u0ba9\u0bcd \u0b9a\u0b9e\u0bcd\u0b9c\u0bc0\u0bb5 \u0baa\u0bb0\u0bcd\u0ba9\u0bbe\u0ba8\u0bcd\u0ba4\u0bc1 09 \u0bae\u0bbe\u0bae\u0bcd\u0baa\u0bc1\u0bb0\u0bbf \u0b95\u0baa\u0bcd\u0bb0\u0bbf\u0baf\u0bc6\u0bb2\u0bcd \u0ba8\u0bc1\u0bb5\u0ba9\u0bcd \u0b9a\u0bbe\u0bae\u0bb0 10 \u0ba4\u0bb3\u0bc1\u0bb5 \u0bb5\u0bb0\u0bcd\u0ba3\u0b95\u0bc1\u0bb2\u0b9a\u0bc2\u0bb0\u0bbf\u0baf \u0ba8\u0bbf\u0bb7\u0bbe\u0ba8\u0bcd\u0ba4 \u0bae\u0bc6\u0b95\u0bcd\u0b9a\u0bbf\u0bae\u0bb8\u0bcd \u0baa\u0bb0\u0bcd\u0ba9\u0bbe\u0ba8\u0bcd\u0ba4\u0bc1 11 \u0b95\u0bb0\u0bae\u0bcd\u0baa \u0bae\u0bc1\u0bb9\u0bae\u0ba4\u0bc1 \u0b86\u0baa\u0bcd\u0ba4\u0bc0\u0ba9\u0bcd \u0bae\u0bc1\u0bb9\u0bae\u0ba4\u0bc1 \u0b86\u0bb8\u0bcd\u0b95\u0bc0\u0ba9\u0bcd 12 \u0bb5\u0bbf\u0bb0\u0bc1\u0ba4\ufffd\u0bcb\u0b9f\u0bc8 \u0bae\u0bc1\u0bb9\u0bae\u0bcd\u0bae\u0ba4\u0bc1 \u0b87\u0baa\u0bcd\u0bb0\u0bbe\u0bb9\u0bbf\u0bae\u0bcd \u0bae\u0bc1\u0bb9\u0bae\u0bcd\u0bae\u0ba4\u0bc1 \u0b86\u0b9a\u0bbf\u0b95\u0bcd 13 \u0baa\u0bbe\u0bb2\u0b9a\u0bcd\u0b9a\u0bcb\u0bb2\u0bc8 \u0bb5\u0bb0\u0bcd\u0ba3\u0b95\u0bc1\u0bb2\u0b9a\u0bc2\u0bb0\u0bbf\u0baf\u0b95\u0bc7 \u0b95\u0bc6\u0bb2\u0bc1\u0bae\u0bcd \u0ba4\u0bc1\u0bb7\u0bbe\u0bb0 \u0baa\u0bb0\u0bcd\u0ba9\u0bbe\u0ba8\u0bcd\u0ba4\u0bc1 14 \u0b95\u0b9f\u0bc8\u0baf\u0bbe\u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bc8 \u0b85\u0baa\u0bcd\u0ba4\u0bc1\u0bb2\u0bcd \u0bb9\u0b9a\u0ba9\u0bcd \u0bb9\u0bbe\u0bb0\u0bc2\u0ba9\u0bcd 15 \u0b9a\u0bbf\u0ba9\u0bcd\u0ba9\u0baa\u0bcd\u0baa\u0bbe\u0b9f\u0bc1 \u0bb5\u0bb0\u0bcd\u0ba3\u0b95\u0bc1\u0bb2\u0b9a\u0bc2\u0bb0\u0bbf\u0baf \u0bb0\u0bc6\u0b9c\u0bc0 \u0bb2\u0b95\u0bcd\u200d\u0bb7\u0bcd\u0bae\u0ba9\u0bcd \u0baa\u0bb0\u0bcd\u0ba9\u0bbe\u0ba8\u0bcd\u0ba4\u0bc1 16 \u0b95\ufffd\u0bca\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd \u0ba4\u0bc0\u0bb5\u0bc1 \u0b89\u0bae\u0bb0\u0bcd \u0b9c\u0bb5\u0bcd\u0baa\u0bb0\u0bcd \u0bae\ufffd\u0bca\u0bb9\u0bae\u0b9f\u0bcd \u0bb0\u0bbf\u0baa\u0bbe\u0bb8\u0bcd 17 \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0b95\u0bcd\u0b95\u0bbe\u0b9f\u0bc1 \u0bae\u0bbf\u0bb9\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1\u0b95\u0bc1\u0bb2\u0b9a\u0bc2\u0bb0\u0bbf\u0baf \u0b9a\u0ba8\u0bcd\u0ba4\u0bae\u0bbe\u0bb2\u0bbf \u0baa\u0bb0\u0bcd\u0ba9\u0bbe\u0ba8\u0bcd\u0ba4\u0bc1"
