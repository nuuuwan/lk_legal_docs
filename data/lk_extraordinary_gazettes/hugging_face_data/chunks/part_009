9\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0732\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\n\n(\u0baa\u0732\u0731\u0732\u0bb5\u0bc1 12)\n\n\u0b85\u0bb1\u0732\u0bb5\u0732\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b87\u0bb2.: 62/0937 \u0b87\u0bb0\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0baa\u0bc1\u0731\u0732 \u0bae\u0731\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\n\n\u0b9a\u0baa\u0bcd\u0baa\u0732\u0bb0\u0b95\u0bae\u0bc1\u0bb5 \u0bae\u0731\u0b95\u0731\u0ba3\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0b87\u0bb0\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0baa\u0bc1\u0731\u0732 \u0bae\u0731\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd, \u0b85\u0baf\u0b95\u0bae\n\n\u0baa\u0732\u0bb0\u0737\u0ba4\u0b9a \u0736\u0b9a\u0baf\u0bb2\u0731\u0bb3\u0bb0\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0bb2\u0bcd, \u0b87\u0bb2. 193 - \u0b85\u0baf\u0b95\u0bae \u0b95\u0732\u0bb0\u0731\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd\n\n\u0baa\u0732\u0731\u0732\u0bb5\u0732\u0bb2\u0bcd \u0b85\u0738\u0bae\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0bae\u0bcd, \u0b85\u0baf\u0b95\u0bae (\u0baa\u0b95\u0bc1\u0ba4\u0732) \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b85\u0ba4\u0ba9\u0bcd \u0b8f\u0737\u0ba4\u0ba9\u0bc1\u0bae\u0bcd\n\n\u0baa\u0731\u0b95\u0bae\u0bcd (\u0baa\u0732\u0731\u0732\u0bb5\u0bc1 04) \u0736\u0ba4\u0731\u0b9f\u0bb0\u0bcd\u0baa\u0731\u0ba9\u0ba4\u0bc1\u0bae\u0bcd, 1998 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd\n\n\u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0732\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0bcd 11 \u0b86\u0bae\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bcd \u0b95\u0733\u0bb4\u0bcd \u0ba8\u0732\u0bb2\n\n\u0b85\u0bb3\u0738\u0bb5\u0baf\u0731\u0bb3\u0bb0\u0bcd \u0ba4\u0738\u0bb2\u0738\u0bae\u0baf\u0ba4\u0732\u0baa\u0ba4\u0732\u0baf\u0732\u0ba9\u0731\u0bb2\u0bcd \u0ba4\u0baf\u0731\u0731\u0732\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 620382\n\n\u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0ba8\u0732\u0bb2 \u0b85\u0bb3\u0bb5\u0bc0\u0b9f\u0bc1 \u0b9a\u0731\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0baa\u0732\u0bb0\u0ba4\u0732\u0baa\u0bb2\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\n\n\u0bae\u0731\u0ba9 \u0b92\u0bb0\u0bc1 \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0731\u0ba9 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0737\u0bae\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\n\n\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0731\u0ba9 \u0736\u0b9a\u0731\u0ba4\u0bcd\u0ba4\u0731\u0ba3\u0bcd\u0738\u0bae\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b89\u0b9f\u0738\u0bae\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0731\u0732\u0738\u0bae\u0b95\u0bcd\n\n\u0737\u0b95\u0731\u0731\u0732\u0b95\u0bcd\u0738\u0b95\u0baf\u0bc1\u0bb3\u0bcd\u0bb3 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b85\u0b95\u0bcd\u0b95\u0738\u0bb1\u0baf\u0bc1\u0bb3\u0bcd\u0bb3 \u0b8e\u0bb5\u0737\u0bb0\u0ba9\u0bc1\u0bae\u0731\u0bb3\u0bcd 2025.06.11\n\n\u0b86\u0ba8\u0bcd \u0ba4\u0732\u0b95\u0ba4\u0732\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd \u0b95\u0733\u0737\u0bb4 \u0738\u0b95\u0736\u0baf\u0731\u0baa\u0bcd\u0baa\u0bae\u0732\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0bb5\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0ba4\u0bae\u0ba4\u0bc1\n\n\u0b89\u0731\u0732\u0738\u0bae\u0b95\u0bcd\u0737\u0b95\u0731\u0731\u0732\u0b95\u0bcd\u0738\u0b95\u0738\u0baf\u0b9a\u0bcd \u0b9a\u0bae\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0732\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0737\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0736\u0bae\u0ba9\u0bcd\u0bb1\u0bc1 \u0b87\u0ba4\u0bcd\u0ba4\u0731\u0bb2\u0bcd\n\n\u0b85\u0bb1\u0732\u0bb5\u0732\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0732\u0ba9\u0bcd\u0bb1\u0ba4\u0bc