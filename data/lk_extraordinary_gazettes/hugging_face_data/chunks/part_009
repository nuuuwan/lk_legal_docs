u0dbd\u0dd2\u0d9a\u0dcf\u0db1\u0dca\n\n\u0dad\u02d4\u0ddd\u02ea\u0dbb\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dc4\u0dbd\u0dcf\u0dc0\u0dad \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 01 \u0d9a\u0dd4\u0dbb\u0dd4\u0dc3\u0db4\u0dcf\u0da9\u0dd4\u0dc0 \u0dc0\u0dbb\u0dca\u0dab\u0d9a\u0dd4\u0dbd\u0dc3\u0dd4\u0dbb\u0dd2\u0dba \u0da2\u0dd4\u0da9\u0dca \u0da0\u0da0\u0dd2\u0db1\u0dd3 02 \u0dc0\u0da7\u0dca\u0da7\u0d9a\u0dca\u0d9a\u0dbd\u0dca\u0dbd\u0dd2\u0dba \u0db8\u0dd2\u0dc4\u0dd2\u0db3\u0dd4\u0d9a\u0dd4\u0dbd\u0dc3\u0dd4\u0dbb\u0dd2\u0dba \u0da0\u0db1\u0dca\u0daf\u0dd2\u0db8\u0dcf \u0dc3\u0dd4\u0db7\u0dcf\u0dc2\u0dd2\u0dab\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1\u0dca\u0daf\u0dd4 03 \u0dc0\u0dd9\u0dbb\u0dc5\u0db6\u0da9 \u0daf\u0d9a\u0dd4\u0dab \u0dc3\u0dd9\u0db6\u0dc3\u0dca\u0dad\u0dd2\u0dba\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dcf\u0daf\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1\u0dca\u0daf\u0dd4 04 \u0dc0\u0dd9\u0dbb\u0dc5\u0db6\u0da9 \u0d8b\u0dad\u0dd4\u0dbb \u0dc0\u0dbb\u0dca\u0dab\u0d9a\u0dd4\u0dbd\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0da2\u0dd6\u0da7\u0dca \u0d87\u0db1\u0dca\u0da7\u0db1\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1\u0dca\u0daf\u0dd4 05 \u0d85\u0dc5\u0dd4\u0dad\u0dca\u0dc0\u0dad\u0dca\u0dad \u0daf\ufffd\u0ddc\u0db1\u0dca \u0da2\u0dba\u0d9c\u0dda \u0d87\u0db1\u0dca\u0da7\u0db1\u0dca \u0dc3\u0dd4\u0daf\u0dda\u0dc1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1\u0dca\u0daf\u0dd4 06 \u0d85\u0dc5\u0dd4\u0dad\u0dca\u0dc0\u0dad\u0dca\u0dad \u0daf\u0d9a\u0dd4\u0dab \u0db1\u0dc0\u0dd3\u0db1\u0dca \u0daf\u0dd4\u0dc2\u0dca\u0db8\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0da2\u0dda\u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0d9c\u0dd4\u0dab\u0dc0\u0dbb\u0dca\u0db0\u0db1 07 \u0d89\u0da0\u0dca\u0da0\u0db8\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d85\u0dad\u0dca\u0dad\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0dbd\u0dbd\u0dd2\u0dad\u0dca \u0dc3\u0dd2\u0dc3\u0dd2\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dbb 08 \u0db8\u0dd0\u0dbd\u0dca\u0db4\u0dd4\u0dbb \u0db8\u0dbd\u0dca\u0dbd\u0dc0 \u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9c\u0dda \u0dc0\u0dd2\u0db1\u0dca\u0daf\u0dca\u200d\u0dba\u0dcf \u0dbb\u0dd4\u0dc2\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dd2 \u0db8\u0dbd\u0dca\u0dbd\u0dc0\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9c\u0dda 09 \u0db4\u0dd2\u0da7\u0dd2\u0db4\u0db1 \u0daf\u0d9a\u0dd4\u0dab \u0da2\u0dba\u0dc3\u0dd2\u0d82\u0dc4 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda \u0db8\u0d82\u0da2\u0dd4\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dc3\u0d82\u0d9c 10 \u0dc0\u0dd9\u0dbb\u0dc5\u0db6\u0da9 \u0dc0\u0dd3\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda \u0dc3\u0db8\u0db1\u0dca\u0dad \u0d89\u0db1\u0dca\u0daf\u0dd2\u0d9a 11 \u0db4\u0dd2\u0da7\u0dd2\u0db4\u0db1 \u0d8b\u0dad\u0dd4\u0dbb \u0da2\u0dba\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0db8\u0dc4\u0db4\u0da7\u0db6\u0dd0\u0db3\u0dd2\u0d9c\u0dda \u0dbb\u0dc2\u0dca\u0db8\u0dd2\u0d9a \u0db4\u0dd2\u0dba\u0dd4\u0db8\u0dcf\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1\u0dca\u0daf\u0dd4 12 \u0db4\u0dd2\u0da7\u0dd2\u0db4\u0db1 \u0db1\u0dd0\u0d9c\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0da2\u0dba\u0dc3\u0dd4\u0dbb\u0dd2\u0dba \u0d9a\u0dd4\u0dbb\u0dab\u0d9c\u0dda \u0dc3\u0dd4\u0db8\u0dda\u0db0 \u0db1\u0dd2\u0d9a\u0dca\u0dbd\u0dc3\u0dca \u0dc3\u0db3\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db4\u0dd9\u0dbb\u0dda\u0dbb\u0dcf\n\n\u0dad\u02d4\u0ddd\u02ea\u0dbb\u0dcf \u0d91\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0dc0\u0dbb\u0dca\u0dab\u0d9a\u0dd4\u0dbd\u0dc3\u0dd4\u0dbb\u0dd2\u0dba \u0d87\u0dbd\u0dd9\u0d9a\u0dca\u0dc2\u0dd2\u0dba\u0dc3\u0dca \u0dc4\u0dd2\u0dbd\u0dbb\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db1\u0dca\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dc0\u0dbb\u0dca\u0dab\u0db4\u0dd4\u0dbb\u0d9c\u0dda \u0dc1\u0dbd\u0dd2\u0d9a\u0