u0bb9\u0baa\u0bcd\u0baa\u0bbe\u0bb5\u0ba9 \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9\u0b95\u0bc7 \u0b95\u0baa\u0bbf\u0bb2 \u0baa\u0bbf\u0baf\u0b9a\u0bc7\u0ba9 06 \u0b87\u0bb9\u0bb2 \u0ba4\u0bb2\u0bcd\u0ba4\u0bc1\u0bb5 \u0b95\u0bae\u0bcd\u0bb2\u0ba4\u0bcd\u0ba4\u0bb2\u0bbe\u0b95\u0bc7 \u0baa\u0bbe\u0bb2\u0bbf\u0ba4 \u0b95\u0bc1\u0ba3\u0b9a\u0bc7\u0b95\u0bb0 07 \u0baa\u0bb9\u0bb2 \u0ba4\u0bb2\u0bcd\u0ba4\u0bc1\u0bb5 \u0ba4\u0bbf\u0bb0\u0bbf\u0bae\u0bbe\u0ba9\u0bcd\u0ba9 \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9\u0b95\u0bc7 \u0ba8\u0ba9\u0bcd\u0ba4\u0ba9 \u0b9a\u0bae\u0bb0\u0bb5\u0bc0\u0bb0 08 \u0ba4\u0bc6\u0bb9\u0bbf\u0baf\ufffd\u0bcb\u0bb5\u0bbf\u0b9f\u0bcd\u0b9f \u0b8f\u0b95\u0ba8\u0bbe\u0baf\u0b95 \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0b9a\u0bae\u0bbf\u0ba9\u0bcd\u0ba4 \u0baa\u0bbf\u0bb0\u0b9a\u0ba9\u0bcd\u0ba9 \u0b95\u0bc6\u0bb4\u0bc1\u0bae\u0bcd \u0ba4\u0bb0\u0bcd\u0bae\u0bb0\u0ba4\u0bcd\u0ba9 09 \u0bb5\u0bb2\u0bcd\u0baa\u0bca\u0bb2 \u0b95\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc8\u0baf\u0bbe \u0ba8\u0bbf\u0bb7\u0bbe\u0ba9\u0bcd 10 \u0baa\ufffd\u0bca\u0bb0\u0bb2\u0b99\u0bcd\u0b95\u0b9f \u0b95\u200d\u0bb2\u0bb9\u0bc6 \u0bb2\u0bbf\u0baf\u0ba9\u0b95\u0bc7 \u0ba4\ufffd\u0bca\u0ba9\u0bcd \u0b95\ufffd\u0bcb\u0bb0\u0bcd\u0b9f\u0ba9\u0bcd \u0bb0\u0bbf\u0b9a\u0bcd\u0bae\u0ba9\u0bcd\u0b9f\u0bcd 11 \u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc6\u0bb2\u0bcd\u0bb2 \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u0b95 \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0bb5\u0bbf\u0b95\u0bcd\u0b9f\u0bb0\u0bcd \u0b95\u0bc1\u0ba3\u0bb0\u0ba4\u0bcd\u0ba9 \u0baa\u0b99\u0bcd\u0b9f\u0bbe\u0bb0 12 \u0baa\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb2 \u0bb2\u0bbf\u0baf\u0ba9 \u0bb2\u0bc7\u0b95\u0bae\u0bb2\u0bbe\u0b95\u0bc7 \u0b9a\u0bae\u0ba9\u0bcd\u0b9a\u0bbf\u0bb1\u0bbf \u0bb5\u0bc0\u0bb0\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 13 \u0baa\ufffd\u0bcb\u0bae\u0bb2\u0bc1\u0bb5 \u0bb5\u0bc0\u0bb0\u0b95\u0bcd\u0b95\u0bca\u0b9f\u0bbf \u0b85\u0baa\u0bcd\u0baa\u0bc1\u0bb9\u0bbe\u0bae\u0bbf\u0bb2\u0bbe\u0b95\u0bc7 \u0b9a\u0b95\u0bc1\u0bb0\u0bbe \u0bb5\u0bc0\u0bb0\u0b95\u0bcd\u0b95\u0bca\u0b9f\u0bbf 14 \u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bae\u0bcd\u0b95\u0bae \u0b85\u0bb2\u0bc1\u0ba4\u0bcd \u0ba4\u0bc1\u0bb0\u0b95\u0bc7 \u0ba8\u0bbf\u0bb2\u0ba9\u0bcd\u0ba4\u0bbf \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba4\u0bb0\u0bcd\u0bb7\u0ba9\u0bc0 15 \u0bae\u0bbe\u0ba4\ufffd\u0bca\u0bb2 \u0ba4\u0bbf\u0b95\ufffd\u0bcb \u0ba4\u0bb2\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9\u0bbf \u0bb0\u0bbe\u0bb2\u0bb2\u0bbe\u0b95\u0bc7 \u0b9a\u0bc1\u0baa\u0bc1\u0ba9\u0bcd \u0bb5\u0bbf\u0bae\u0bc1\u0b95\u0bcd\u0ba4\u0bbf \u0b95\u0bc1\u0bb2\u0bb0\u0ba4\u0bcd\u0ba9 16 \u0bb5\u0bc6\u0bb2\u0ba9\u0bcd\u0b95\u0bb2\u0bcd\u0bb2 \u0b95\u0ba9\u0bcd\u0ba4\u0bc7 \u0b95\u0bae\u0bcd\u0bb2\u0ba4\u0bcd\u0ba4\u0bb2\u0bbe\u0b95\u0bc7 \u0baa\u0bbf\u0baf\u0bb2\u0bcd \u0b9a\u0bae\u0bcd\u0baa\u0ba4\u0bcd \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9 17 \u0baa\u0ba9\u0bbe\u0bb5\u0bb2 \u0bb9\u0bc6\u0b9f\u0bcd\u0b9f\u0bbf \u0ba4\u0b99\u0bcd\u0ba4\u0bbf\u0bb0\u0bbf\u0b95\u0bc7 \u0ba4\u0bae\u0bbf\u0ba4\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0ba9\u0bcd\u0ba9 \u0ba4\u0bb0\u0bcd\u0bae\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 18 \u0bb9\u0bbf\u0b99\u0bcd\u0b95\u0bc1\u0bb0\u0bb2\u0b95\u0ba8\u0bcd\u0ba4 \u0b95\u0bc0\u0bb0\u0b95\u0bb2 \u0ba4\u0bc7\u0bb5\u0b95\u0bc7 \u0baa\u0ba9\u0bcd\u0ba4\u0bc1\u0bb2 \u0b9a\ufffd\u0bcb\u0bae\u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 19 \u0b85\u0bae\u0bcd\u0baa\u0bb2\u0ba9\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0ba4\ufffd\u0bca\u0ba9\u0bcd \u0bb0\u0bb5\u0bc0\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0b9c\u0b95\u0ba4\u0bcd \u0b95\u0bc1\u0bae\u0bbe\u0bb0 20 \u0b87\u0bae\u0bcd\u0baa\u0bc1\u0bb2\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0bb9\u0bbf\u0ba8\u0bcd\u0b95\u0bc1\u0bb0\u0b95\u0bc7 \u0ba4\ufffd\u0bca\u0ba9\u0bcd \u0bb2\u0b95\u0bcd\u0ba8\u0bc1\u0bb5\u0ba9\u0bcd \u0b9c\u0baf\u0bb0\u0ba4\u0bcd\u0ba9\n\n\u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bbf\u0b95\u0bcd\u0b8e\u0bb2\u0bcd\u0bb2\u0bc7 \u0bb2\u0bc7\u0b95\u0bae\u0bb2\u0bbe\u0b95\u0bc7 \u0b9a\u0bae\u0bbf\u0ba8\u0bcd\u0ba4 \u0bb2\u0b95\u0bcd\u200c\u0bb7\u0bcd\u0bae\u0ba9\u0bcd \u0ba8\u0bc6\u0b95\u0bc6\u0ba4\u0bcd \u0b95\u0bbf\u0baf\u0ba9\u0b95\u0bc7 \u0bb2\u0bb8\u0ba9\u0bcd\u0ba4 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0bb5\u0bbf\u0bb2\u0bcd\u0baa\u0b9f\u0bcd\n\nI \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd II \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd\n\n\u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0bb5\u0b9f\u0bcd\u0b9f\u0bbe\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n\u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0b9a\u0baa\u0bc8 \u0baa\u0bc6\u0baf\u0bb0\u0bc1\u0bae\u0bcd\n\n11 IV ^wd& \u0d9a\u02c1\u0ddc\u0da7\u0dc3 - \u200d\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u200d\u0dc1\u0dd9\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.05.31gFjp IV (M) - \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0b9a\ufffd\u0bcb\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bb0\u0b9a\u0bc1 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bbf\u0b95\u0bc8 - \u0b85\u0ba4\u