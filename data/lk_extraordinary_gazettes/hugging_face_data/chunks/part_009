fd\u0dbb\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0db1\u0db8 \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda \u0db1\u0db8 \u0dc3\u0dc4 \u0db1\u0db8\n\n\u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd(\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\n\u0d8b\u0db4\u0dbd\u0dda\u0d9b\u0db1\u0dba\n\n\u0d85\u0dbd\u0dc0\u0dca\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0(\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)07\u0db1\u0dd4\u0d9c\u0dc0\u0dd9\u0dbd\u0d9a\u0db1\u0dca\u0daf\u200d \u0d8b\u0da9\u0d9c\u0dda \u0da0\u0db8\u0dd2\u0db1\u0dca\u0daf \u0db8\u0dcf\u0dbd\u0dca\n\n08\u0db6\ufffd\u0ddd\u02ea\u0dba\u0dc0\u0dbd\u0dcf\u0db1\u0dbd\u0dd9\u0dc0\u0dca\u0daf\u0dd9\u0db1\u0dd2 \u0db4\u0dad\u0dd2\u0dbb\u0db1\u0dca\u0db1\u0dd0\u0dc4\u0dd0\u0dbd\u0dcf\u0d9c\u0dda \u0da0\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc3\u0dd2\u0dbb\u0dd2 \u0db8\u0dd2\u0d9c\u0dcf\u0dbb\u0dca \u0db4\u0dad\u0dd2\u0dbb\u0dab\n\n09\u0db1\u0dc0\u0dad\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad\u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0dc3\u0dd2\u0dc3\u0dd2\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u200d\u0dc2\n\n10\u0dc4\u0dd4\u0db8\u0dca\u0db6\u0dd4\u0dbd\u0dd4\u0dc0\u0db8\u0dbd\u0dca\u0daf\u0dd9\u0db1\u0dd2\u0dba\u0d9c\u0dda \u0da0\u0db8\u0dca\u0db4\u0dcf \u0db8\u0dbd\u0dca\u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dd2 \u0db1\u0db1\u0dca\u0daf\u0dc3\ufffd\u0dda\u0db1\n\n11\u0d85\u0db6\ufffd\u0dca\u0db6\u0ddd\u0dc0\u0dc0\u0dd2\u0da2\u0dda\u0dc3\u0dd2\u0d82\u0dc4 \u0db4\u0dad\u0dd2\u0dbb\u0dab\u0dbd\u0dcf\u0d9c\u0dda \u0dc3\u0dd2\u0dbb\u0dd2\u0dbd\u0dca \u0da2\u0dba\u0dc0\u0dbb\u0dca\u0db0\u0db1\n\n12\u0dba\u0dad\u0dca\u0dad\u0dbd\u0dca\u0d9c\u0ddc\u0da9\u0dbd\ufffd\u0ddc\u0d9a\u0dd4 \u0dc4\u0dd2\u0da7\u0dd2\u0d9c\u0dda \u0dc3\u0daf\u0dd9\u0dc0\u0dca \u0dbd\u0d9a\u0dca\u0da2