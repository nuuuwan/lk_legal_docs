\u0dd2 \u0d85\u0d82\u0d9a 604 - 2011.03.25 \u0daf\u0dbb\u0db1 \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:59 0.0188 1. \u0dd9\u0db4\u0ddc\u0dbd\u0dca\u0dd9\u0d9c\u0ddc\u0da9\u0dd9\u0d9c\u0dca \u0dc1\u0dcf\u0db1\u0d9a \u0d85\u0dc0\u0db1\u0dca\u0dad 821603692V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 57 \u0dc4\u0dd2 _ \u0d9c\u0dd4\u0dab\u0dd9\u0dc3\u0dda\u0d9a\u0dbb \u0dc3\u0db8 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf 35/2 \u0d92, \u0dd9\u0dc4\u0ddd\u0da7\u0dbd\u0dca \u0db4\u0dcf\u0dbb, \u0d9c\u0dbd\u0dca\u0d9a\u0dd2\u0dc3\u0dca\u0dc3. \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0db8\u0dd3\u0db8\u0db1\u0dd9\u0d9c\u0dca 2. \u0dd9\u0db4\u0ddc\u0dbd\u0dca\u0dd9\u0d9c\u0ddc\u0da9\u0dd9\u0d9c\u0dca \u0dc1\u0dc1\u0dd2\u0d9a \u0db7\u0dcf\u0db1\u0dd4\u0d9a 842760704V \u0dbd\u0dbd\u0dd2\u0dad\u0dcf \u0d9c\u0dd4\u0dab\u0dd9\u0dc3\u0dda\u0d9a\u0dbb \u0dc4\u0dcf . \u0d9c\u0dd4\u0dab\u0dd9\u0dc3\u0dda\u0d9a\u0dbb \u0dd9\u0db4\u0ddc\u0dbd\u0dca\u0dd9\u0d9c\u0ddc\u0da9 \u0dd9\u0d9c\u0dca 35/2 \u0d92, \u0dd9\u0dc4\u0ddd\u0da7\u0dbd\u0dca \u0db4\u0dcf\u0dbb, \u0d9c\u0dbd\u0dca\u0d9a\u0dd2\u0dc3\u0dca\u0dc3 \u0db8\u0dbb\u0dca\u0dc0\u0dd2\u0db1\u0dca \u0d9c\u0dd4\u0dab\u0dd9\u0dc3\u0dda\u0d9a\u0dbb \u0dba\u0db1 \u0d85\u0dba\u0dd9\u0d9c\u0dca \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dba\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0db4\u0dca\u0dbb\u0dca.\u0dd9\u0db1\u0ddc \u0da9\u0db6\u0dca.\u0d91\u0db8\u0dca.\u0db6\u0dd2.\u0db4\u0dd3.\u0dd9\u0da2\u0dca.\u0dd9\u0dc3\u0ddd\u0db8\u0dbb\u0dad\u0dca\u0db1\u0dd9\u0d9c\u0dca \u0d85\u0d82\u0d9a 6136 \u0dc3\u0dc4 2024.04.26 \u0daf\u0dd2\u0db1 \u0daf\u0dbb\u0db1\u0db6\u0daf\u0dd4 \u0d94\u0db4\u0dca\u0db4\u0dd4\u0dd9\u0dc0\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dc0\u0dbd\u0da7 \u0dba\u0da7\u