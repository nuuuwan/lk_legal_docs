    "chunk_text": "\u0db4\u0dca\u200d\u0dbb\u0dda\u0dda\u0db8\u0d9a\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dd208 \u0d9a\u0dd2\u0dab\u0dd2\u0d9c\u0db8\u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dc3\u0dcf\u0dcf\u0d9c\u0dbb\u0daf\u0dd3\u0dbb \u0dc0\u0dd2\u0dc1\u0dca\u0dc0 \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\n\n\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0d91\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0da2\u0dba\u0dc0\u0dd3\u0dbb \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dad\u0db1\u0dd6\u0da2\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0da2\u0dd3\u0dc0\u0db1\u0dd3\u0d85\u0db1\u0dd4\u0dbb \u0da2\u0dba\u0dc3\u0dd2\u0d82\u0d82\u0dc4 \u0dc0\u0db1\u0dca\u0dad\u0dd4\u0dc4\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0db4\u0ddc\ufffd\u0ddc\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad\u0dda\u01ae \u0dbb\u0dad\u0dd4\u0db6\u0daf\u0dd4\u0d9c\u0dda\u0118 \u0da0\u0db8\u0dd2\u0db1\u0dca\u0daf \u0dbb\u0dab\u0dc3\u0dd4\u0dbb \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf\u0dcf\n\n\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0d91\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0dc3\u0dbb\u0dc3\u0dd2 \u0d85\u0db1\u0dd4\u0dad\u0dca\u0dad\u0dbb\u0dcf\u0dcf \u0d89\u0dbd\u0db1\u0dca\u0d9c\u0d9a\u0ddd\ufffd\u0ddd\ufffd\u0db1\u0dca \u0da2\u0dba\u0dc3\u0dda\ufffd\u0dda\u0d9a\u0dbb\u0d89\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba \u0daf\u0dd2\u0dbd\u0dd3\u0db4 \u0db6\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0dbd\u0dd2\u0dba\u0db1\u0d9c\u0dda\u0118\u0dbb\u0ddd\ufffd\u0ddd\ufffd\u0dc4\u0dd2\u0dad \u0d87\u0db1\u0dca\u0da7\u0db1\u0dca \u0d85\u0dbb\u0dca\u0dc3\u0d9a\u0dd4\u0dbd\u0dc3\u0dd6\u0dbb\u0dd2\u0dba\u0d85\u0db6\u0dca\u0daf\u0dd4\u0dbd\u0dca \u0da2\u0dc0\u0dcf\u0dcf\u0dc4\u0dd2\u0da9\u0dca \u0db8\u0ddc\ufffd\u0ddc\u0dc4\u0ddc\ufffd\u0ddc\u0db8\u0da9\u0dca \u0db1\u0dbd\u0dd3\u0dbb\u0dca \u0db8\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dcf\u0dcf\u0dbb\u0dca\n\n\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n01 \u0dbb\u0ddc\ufffd\u0ddc\u0da7\u0dbd\u0dc0\u0dd9\u0dd9\u0dbd\u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dbd\u0dbd\u0dd2\u0dad\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dcf\u0dba\u0d9a02 \u0d9c\u0dd2\u0db1\u0dca\u0db1\u0ddc\ufffd\u0ddc\u0dbb\u0dd4\u0dc0\u0db4\u0dd4\u0dc3\u0dca\u0d9a\u0ddc\ufffd\u0ddc\u0dbd \u0daf\u0dda\u0dda\u0dc0\u0d9c\u0dda\u0118 \u0d85\u0db8\u0dbb\u0dc3\u0dd2\u0dbb\u0dd203 \u0d8b\u0dbd\u0dca\u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dbb\u0dab\u0dc3\u0dd2\u0d82\u0d82 \u0db4\u0dda\u0dda\u0da9\u0dd2\u0d9c\u0dda\u0118 \u0db1\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0db8\u0dd2 \u0daf\u0dd2\u0dbd\u0dca\u0dc4\u0dcf\u0dcf\u0db1\u0dd2 \u0dbb\u0dab\u0dc3\u0dd2\u0d82\u0d82\u0dc404 \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dc4\u0dda\ufffd\u0dda\u0dbb\u0dad\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0dad \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb05 \u0d9c\u0dd2\u0dbb\u0dcf\u0dcf\u0daf\u0dd4\u0dbb\u0dd4\u0d9a\u0ddd\ufffd\u0ddd\ufffd\u0da7\u0dca\u0da7\u0dda\ufffd\u0dc0\u0dd3\u0dbb\u0dc3\u0dd2\u0d82\u0d82\u0dc4 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dc3\u0dcf\u0dcf\u0dbd\u0dd2\u0db1\u0dca \u0dbb\u0dc3\u0dd2\u0d9a \u0db0\u0db1\u0db4\u0dcf\u0dcf\u0dbd06 \u0daf\u0db9\u0dcf\u0dcf\u0db1\u0d85\u0dad\u0dca\u0dad\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0db1\u0dca\u0daf\u0dc3\u0dda\ufffd\u0dda\u0db107 \u0db6\u0dd9\ufffd\u0dbd\u0dd2\u0d9c\u0dbd\u0dca\u0dbd\u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0d9c\u0dd4\u0dab\u0dad\u0dd2\u0dbd\u0d9a08 \u0db6\u0dad\u0dbd\u0dba\u0dcf\u0dcf\u0dba\u0dba\u0dcf\u0dcf\u0db4\u0dcf\u0dcf \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dbd\u0d9a\u0dca\u0dc3\u0dd2\u0dbb\u0dd2 \u0dc3\u0dd4\u0dbb\u0d82\u0d82\u0d9c09 \u0dc3\u0ddc\ufffd\u0ddc\u0dbb\u0db6\u0ddc\ufffd\u0ddc\u0dbb\u0dc0\u0dd2\u0da2\u0dda\u0dda\u0dad\u0dd4\u0d82\u0d82\u0d9c \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0da0\u0dad\u0dd4\u0dbb\u0dcf\u0dcf\u0db1\u0dd2 \u0d8b\u0db4\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0dcf\u0dcf \u0dc0\u0dd2\u0da2\u0dda\u0dda\u0dad\u0dd4\u0d82\u0d82\u0d9c10 \u0db8\u0dc4\u0dd2\u0dba\u0d82\u0d82\u0d9c\u0db1\u0dba\u0db8\u0ddc\ufffd\u0ddc\u0dbb\u0da7\u0dd4\u0dc0\u0d9c\u0dda\u0118 \u0da0\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc3\u0dda\ufffd\u0dda\u0d9a\u0dbb11 \u0d87\u0dbd\u0dd1\u0dd1\u0dc0\u0dd9\u0dd9\u0dbd\u0d85\u0dbd\u0dc4\u0d9a\u0ddd\ufffd\u0ddd\ufffd\u0db1\u0dca \u0dbb\u0dcf\u0dcf\u0dbd\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0dc0\u0dbb\u0dad\u0dca\u0db1 \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf \u0d85\u0dbd\u0dc4\u0d9a\u0ddd\ufffd\u0ddd\ufffd\u0db1\u0dca12 \u0daf\u0db8\u0dca\u0db6\u0dbb\u0dcf\u0dcf\u0dc0\u0dbd\u0db6\u0dd4\u0da7\u0dd4\u0dc0\u0dda\u0dda \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0dbb\u0dcf\u0dcf\u0dbd\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dc0\u0dd2\u0db8\u0dbd\u0dbb\u0dad\u0dca\u0db1 \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb13 \u0db8\u0dcf\u0dcf\u0db4\u0dcf\u0dcf\u0d9a\u0da9\u0dc0\u0dd0\u0dd0\u0dc0\u0dbd\u0db6\u0dd4\u0da7\u0dd4\u0dc0\u0dda\u0dda \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0dbb\u0dcf\u0dcf\u0dbd\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0d86\u0dbb\u0dd2\u0dba\u0dbb\u0dad\u0dca\u0db1 \u0db6\u0d82\u0d82\u0da9\u0dcf\u0dcf\u0dbb14 \u0db4\u0d9c\u0dbb\u0d9c\u0db8\u0dca\u0db8\u0db1\u0db1\u0dcf\u0dcf\u0dbb\u0dcf\u0dcf\u0dba\u0db1 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dc3\u0dd4\u0db8\u0db1 \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb\n\n\u0dc4\u0db4\u0dd4\u0dad\u0dbd\u0dda\ufffd \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\n\n\u0db8\u0dc4\u0dd2\u0dba\u0d82\u0d82\u0d9c\u0db1\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\n\n\u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb\u0dc0\u0dd9\u0dd9\u0dbd \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0(\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\n(\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\nIV (\u0d86) \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3 - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\ufffd\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.05.314A\n\n\u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd(\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\nI \u0dad\u0dd3\u0dbb\u0dd4\u0dc0 II \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\n\n\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda\u024f \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3 \u0d85\u0d82\u0d82\u0d9a\u0dba \u0db1\u0db8 \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda\u024f \u0db1\u0db8 \u0dc3\u0dc4 \u0db1\u0db8 \u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0d91\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\n\u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb\u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0d85\u0db6\u0dca\u0daf\u0dd4\u0dbd\u0dca \u0db1\u0dc3\u0dcf\u0dcf\u0dbb\u0dca \u0db8\u0dd4\u0dc4\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0dbb\u0dd2\u0dc3\u0dca\u0dc0\u0dcf\u0dcf\u0db1\u0dca\u0db8\u0dcf\u0dcf\u0db4\u0dcf\u0dcf \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db8\u0d82\u0d82\u0da2\u0dd4\u0dbd \u0db1\u0dd2\u0dbd\u0d82\u0d82\u0d9a \u0da2\u0dba\u0dc3\u0dda\ufffd\u0dda\u0db1\u0d9a\u0ddc\ufffd\u0ddc\u0dc4\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4 \u0d9c\u0dd9\ufffd\u0daf\u0dbb \u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0d82\u0d82\u0d9a \u0dc0\u0dbb\u0dca\u0dab\u0dc3\u0dd6\u0dbb\u0dd2\u0dba\u0dc0\u0dd2\u0da2\u0dda\u0dda\u0dad\u0dd4\u0d82\u0d82\u0d9c \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0d9c\u0dde\ufffd\u0dde\u0dad\u0db8\u0daf\u0dcf\u0dcf\u0dc3 \u0dc0\u0dd2\u0da2\u0dda\u0dda\u0dad\u0dd4\u0d82\u0d82\u0d9c\u0dc4\u0dd0\u0dd0\u0dc0\u0db1\u0dca\u0db4\u0ddc\ufffd\u0ddc\u0dbd \u0dbb\u0dbd\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0d85\u0db1\u0dd2\u0dbd\u0dca \u0dbb\u0dd6\u0db4\u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0d9c\u0db8\u0d9c\u0dd9\ufffd\u0daf\u0dbb \u0dc0\u0dc3\u0db1\u0dca\u0dad\u0dd2 \u0da0\u0dad\u0dd4\u0dbb\u0d82\u0d82\u0d9c\u0db1\u0dd3\u0dba\u0dc4\u0d82\u0d82\u0d9c\u0dbd \u0db8\u0dd4\u0daf\u0dd2