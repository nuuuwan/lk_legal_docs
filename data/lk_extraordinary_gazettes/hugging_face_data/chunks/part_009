9a\u0dd4\u0dbd\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc025.06.2025\u0db4.\u0dc0.2.30\u0dc0\u0dd9\u0d82\ufffd\u0d82\u0d9c\u0dbd\u0da0\u0dca\u0dc3\u0dd9\ufffd\u0da7\u0dca\u0da7\u0dd2\u0d9a\u0dd4\u0dbd\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0db7\u0dcf\u0dcf \u0db8\u0dab\u0dca\u0da9\u0db4\u0dba\n\n26.\u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4\u0db6\u0da9\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc026.06.2025\u0db4\u0dd9\u0dd9.\u0dc0.8.30\u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4\u0db6\u0da9\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0db7\u0dcf\u0dcf \u0db8\u0dab\u0dca\u0da9\u0db4\u0dba\n\n27.\u0dad\u0dd4\u0db1\u0dd4\u0d9a\u0dca\u0d9a\u0dcf\u0dcf\u0dba\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc026.06.2025\u0db4\u0dd9\u0dd9.\u0dc0.11.30\u0dad\u0dd4\u0db1\u0dd4\u0d9a\u0dca\u0d9a\u0dcf\u0dcf\u0dba\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0db7\u0dcf\u0dcf \u0db8\u0dab\u0dca\u0da9\u0db4\u0dba\n\n28.\u0db8\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dba\u0dd2 \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc026.06.2025\u0db4.\u0dc0.2.30\u0db8\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dba\u0dd2 \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0db7\u0dcf\u0dcf \u0db8\u0dab\u0dca\u0da9\u0db4\u0dba\n\n29.\u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dcf\u0dc0 \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0daf\u0dd9\u0dd9\u0db8\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc027.06.2025\u0db4\u0dd9\u0dd9.\u0dc0.9.00\u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dcf\u0dc0 \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0daf\u0dd9\u0dd9\u0db8\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0db7\u0dcf\u0dcf \u0db8\u0dab\u0dca\u0da9\u0db4\u0dba\n\n30.\u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dcf\u0dc0 \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc027.06.2025\u0db4.\u0dc0.2.00\u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dcf\u0dc0 \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0db7\u0dcf\u0dcf \u0db8\u0dab\u0dca\u0da9\u0db4\u0dba\n\n31.\u0da9\u0dd9\ufffd\u0dbd\u0dca\u0dc6\u0dca\u0da7\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc030.06.2025\u0db4\u0dd9\u0dd9.\u0dc0.11.30\u0da9\u0dd9\ufffd\u0dbd\u0dca\u0dc6\u0dca\u0da7\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0db7\u0dcf\u0dcf \u0db8\u0dab\u0dca\u0da9\u0db4\u0dba\n\nEOG - 06 - 0020\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dbb\u0da2\u0dba\u0dda\u024f \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\n\n\u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)"
