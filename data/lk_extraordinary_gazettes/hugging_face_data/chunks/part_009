\n\n\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d9a\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3 \u0d85\u0d82\u0d9a\u0dba \u0db1\u0db8 \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda \u0db1\u0db8 \u0dc3\u0dc4 \u0db1\u0db8 \u0dad\ufffd\u0ddd\ufffd\u0dbb\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0d8b\u0db4\u0dbd\u0dda\u0d9b\u0db1\u0dba (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\nIV^wd& jeks fldgi \u2013 YS% ,xld m%cd;dka;s%l iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025.05.317 A\n\n\u0d86\u0dab\u0db8\u0da9\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba 17 \u0d9a\u0da7\u0dd4\u0db4\ufffd\u0ddc\u0dad \u0dbd\u0daf\u0dca\u0daf\u0d9c\u0dda \u0d85\u0db1\u0dd4\u0dc2\u0dca\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dc1\u0dcf\u0db1\u0dca\u0dad(\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2) \u0dc3\u0db7\u0dcf\u0dc0 (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2) 18 \u0db4\u0dbd\u0dca\u0dbd\u0db8 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0d89\u0db8\u0dbd\u0dca\u0d9a \u0daf\u0dd2\u0dbd\u0dca\u0dc1\u0dcf\u0db1\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\n\n\u0dad\ufffd\u0ddd\ufffd\u0dbb\u0dcf \u0d91\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0dc0\u0dd2\u0da2\u0dda\u0dc3\ufffd\u0dda\u0d9a\u0dbb\u0d9c\u0dda \u0dc3\u0dd4\u0da2\u0dcf\u0db1\u0dd2\u0d9a\u0dcf \u0d8b\u0daf\u0dba\u0d82\u0d9c\u0db1\u0dd2 \u0d85\u0da2\u0dd2\u0dad\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0d9c\u0dda \u0dc3\u0da0\u0dd2\u0db1\u0dd2 \u0d9a\u0dbd\u0dca\u0dc4\u0dcf\u0dbb\u0dd2 \u0dbb\u0db1\u0dca\u0d9a\u0ddc\u0dad\u0dca \u0db4\u0dda\u0da9\u0dd2 \u0daf\u0dd4\u0dbb\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0dc3\u0db3\u0db8\u0dcf\u0dbd\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dd3\u0db4\u0dcf \u0dbd\u0dd2\u0dba\u0db1 \u0d9c\u0db1\u0dd2\u0dad\u0dba\u0dbd\u0dcf\u0d9c\u0dda \u0dbb\u0dc0\u0dd2\u0db1\u0dca\u200d\u0daf\u0dca\u200d\u0dbb \u0da2\u0dba\u0dc3\u0dd2\u0d82\u0dc4 \u0d9c\u0dcf\u0dbb\u0dca\u0daf\u0dd2 \u0dc4\ufffd\u0dda\u0dc0\u0dcf\u0dc0\u0dc3\u0db8\u0dca \u0db8\u0daf\u0dca\u0daf\u0dd4\u0db8 \u0daf\ufffd\u0ddc\u0da9\u0db8\u0dca\u0d9c\u0ddc\u0da9\u0d9c\u0dda \u0da0\u0dd2\u0db1\u0dca\u0dad\u0d9a \u0db8\u0dc4\u0dd2\u0db1\u0dca\u0daf \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0da2\u0dba\u0dc0\u0dd3\u0dbb \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda \u0da2\u0db1\u0d9a \u0dba\ufffd\u0ddc\u0d9c\u0dcf \u0da0\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb \u0db1\u0db1\u0dca\u0daf\u0db1 \u0db8\u0dd4\u0dad\u0dd4\u0db8\u0dd4\u0dab \u0db8\u0dd9\u0dbd\u0dd3\u0dc2\u0dcf \u0d85\u0db6\u0dd9\u0dbd\u0dca \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf \u0dbd\u0d82\u0d9a\u0dcf \u0dc0\u0dd2\u0dbb\u0dd2\u0daf\u0dd4\u0dc0\u0dbd\u0dcf\u0d9c\u0dda \u0dbb\u0d82\u0da2\u0dd2\u0dad\u0dca \u0dc3\u0dd2\u0dc3\u0dd2\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0dbb\u0dcf\u0da2\u0d9a\u0dbb\u0dd4\u0dab\u0dcf \u0dc4\ufffd\u0dda\u0dbb\u0dad\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0dad \u0db6\u0d82\u0da9\u0dcf\u0dbb \u0dbb\u0dcf\u0da2\u0d9a\u0dbb\u0dd4\u0dab\u0dcf \u0d9a\u0da9\u0dd4\u0db4\u0dd2\u0da7\u0dd2\u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0daf\u0dd3\u0db4\u0dcf \u0dad\u0dda\u0da2\u0dcf\u0db1\u0dd2 \u0da2\u0dba\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0daf\u0dd3\u0db4\u0dca \u0da0\u0db1\u0dca\u0daf\u0db1 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0da2\u0dba\u0dc3\u0dd2\u0d82\u0dc4 \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dd9\u0dbd\u0dcf\u0d9c\u0dda \u0daf\u0dba\u0dcf\u0dbb\u0dad\u0dca\u0db1 \u0dc0\u0dd2\u0da2\u0dda\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb \u0db4\u