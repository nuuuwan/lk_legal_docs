\u0bb9\u0bc7\u0bb5\u0bbe \u0bb5\u0bbf\u0ba4\u0bbe\u0bb0\u0ba9\u0bb2\u0bbe\u0b95\u0bc7 \u0b86\u0bb0\u0bcd.\u0b8e\u0b9a\u0bcd. \u0b9c\u0baf\u0b9a\u0bbf\u0bb1\u0bbf \u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8 \u0bb5\u0bbf\u0ba4\u0bbe\u0bb0\u0ba9 \u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 03 \u0b95\u0baa\u0bcd\u0baa\u0bc1\u0b95\ufffd\u0bca\u0bb2\u0bcd\u0bb2\u0bc7\u0bb5 \u0b9c\u0bb2\u0bbe\u0bb2\u0bcd\u0ba4\u0bc0\u0ba9\u0bcd \u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf \u0ba8\u0ba4\u0bc0\u0bb0\u0bbe 04 \u0ba4\u0bc1\u0b9f\u0bcd\u0b9f\u0bc1\u0bb5\u0bc6\u0bb5 \u0b95\u0ba9\u0bcd\u0ba4\u0bbe\u0b95\u0bc7 \u0bb5\u0bc0\u0bb0\u0bb5\u0b99\u0bcd\u0bb7 05 \u0ba8\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc6\u0bb5 \u0ba8\u0bc2\u0bb0\u0bcd \u0bae\u0bc1\u0bb9\u0bae\u0bcd\u0bae\u0b9f\u0bcd \u0baa\u0bbe\u0b9a\u0bbf\u0bb2\u0bcd 06 \u0b9a\u0bbf\u0b99\u0bcd\u0bb9\u0bb2 \u0bb5\u0bb2\u0bb9\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb5\u0bc6\u0bb5 \u0b9c\u0baf\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9\u0b95\u0bc7 \u0ba4\u0bb0\u0b99\u0bcd\u0b95 \u0baa\u0bbf\u0bb0\u0b9a\u0bbe\u0ba4\u0bcd \u0b9c\u0baf\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 07 \u0bae\ufffd\u0bca\u0bb0\u0b95\u0bc7\u0bb5 \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf \u0b85\u0baa\u0bcd\u0baa\u0bc1\u0bb9\u0bbe\u0bae\u0bbf\u0bb2\u0bbe\u0b95\u0bc7 \u0bb0\u0bc2\u0baa\u0bbe\u0bb5\u0ba4\u0bbf 08 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bb0\u0bb5\u0bc6\u0bb5 \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0ba4\u0bc1 \u0bae\ufffd\u0bca\u0bb9\u0bae\u0bcd\u0bae\u0ba4\u0bc1 \u0b85\u0bb2\u0bc0 09 \u0bb9\ufffd\u0bca\u0bb0\u0bb5\u0bcd\u0baa\u0bca\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9\u0bc8 \u0b8f\u0b95\u0ba9\u0bbe\u0baf\u0b95 \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0ba8\u0bbf\u0bb7\u0bcd\u0bb7\u0b99\u0bcd\u0b95 \u0b8f\u0b95\u0ba9\u0bbe\u0baf\u0b95 10 \u0bae\u0bb0\u0ba4\u0ba9\u0bcd\u0b95\u0b9f\u0bb5\u0bb2 \u0bb9\u0bc7\u0bb0\u0ba4\u0bcd \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0b9a\u0bae\u0ba9\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0b9a\u0bbf\u0bb1\u0bbf \u0b9c\u0baf\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 11 \u0baa\u0bb1\u0b99\u0bcd\u0b95\u0bbf\u0baf\u0bbe\u0bb5\u0bbe\u0b9f\u0bbf\u0baf \u0bb9\u0bc7\u0bb0\u0ba4\u0bcd \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0b9a\u0bae\u0bc0\u0bb0 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0b89\u0baa\u0bc1\u0bb2\u0bcd\u0bb5\u0bbf\u0bb2 12 \u0ba4\u0bc7\u0b95\u0bc6\u0ba4\u0bbf\u0baa\ufffd\u0bca\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9 \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9\u0b95\u0bc7 \u0ba8\u0bc1\u0bb5\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bc0\u0baa\u0bcd \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9\n\n\u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd"
