\u0baa\u0bbf\u0b95\u0bc7 \u0bae\u0bb2\u0bc0\u0bb7 \u0bb7\u0bc6\u0bb9\u0bbe\u0ba9\u0bcd \u0bb5\u0bbf\u0bb7\u0bcd\u0bb5\u0b9c\u0bbf\u0ba4\u0bcd \u0b95\u0bc6\u0b9f\u0bbf\u0baf\u0baa\u0bc7 \u0b95\u0bae\u0b95\u0bc7 \u0b85\u0baf\u0bc7\u0bb7\u0bbe \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba4\u0bbe\u0bcd\u0bb7\u0ba9\u0bc0 \u0ba4\ufffd\u0bcb\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bbe\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0bb5\u0ba9 01 \u0b95\ufffd\u0bca\u0bae\u0b9f\u0bbf\u0baf \u0baa\u0bbe\u0ba9\u0b95\u0bb2\u0b95\u0bc7 \u0ba4\u0bb0\u0bcd\u0bae\u0b9a\u0bbf\u0bb0\u0bbf \u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8 02 \u0b9a\u0bbf\u0baf\u0bbe\u0bb0\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0b95\u0bb0\u0bb2\u0bb9\u0bc0\u0ba9\u0bcd\u0b95\u0bc7 \u0ba8\u0bbf\u0bb2\u0b99\u0bcd\u0b95\u0bbe 03 \u0bb0\u0bbf\u0b9f\u0bbf\u0b95\u0bb9\u0baf\u0bbe\u0baf \u0bb9\u0bc7\u0bb5\u0bbe\u0b95\u0bc1\u0b9f\u0bbe \u0b85\u0ba8\u0bcd\u0ba4\u0bcb\u0ba9\u0bbf\u0b95\u0bc7 \u0b86\u0ba9\u0ba8\u0bcd\u0ba4 \u0b95\u0bc1\u0bb2\u0b9a\u0bc1\u0ba8\u0bcd\u0ba4\u0bb0 04 \u0bb5\u0bc6\u0bb2\u0bbf\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0bb5\u0bbf\u0ba4\u0bbe\u0bb0\u0ba3\u0b95\u0bc7 \u0b9a\u0bbf\u0bb0\u0bbf\u0baa\u0bbe\u0bb2 05 \u0bae\u0bbf\u0ba4\u0bcd\u0ba4\u0bc6\u0ba9\u0bbf\u0baf \u0b9c\u0baf\u0b9a\u0bc7\u0b95\u0bb0\u0b95\u0bc7 \u0bb0\u0b9e\u0bcd\u0b9c\u0bbf\u0ba4\u0bcd \u0b9c\u0baf\u0b9a\u0bc7\u0b95\u0bb0 06 \u0bae\u0bc1\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0b95\u0bb8\u0bcd\u0baf\u0bbe\u0baf \u0bae\u0b9e\u0bcd\u0b9c\u0bc1\u0bb2 \u0b85\u0baa\u0bc7\u0b95\u0bc1\u0ba3\u0bb0\u0ba4\u0bcd\u0ba9 07 \u0b89\u0bb2\u0bb9\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bbe\u0bb5 \u0bb5\u0bc6\u0ba4\u0bcd\u0ba4\u0b9a\u0bbf\u0bcd\u0b99\u0bcd\u0bb9 \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bc7 \u0b9a\u0b9e\u0bcd\u0b9c\u0bc0\u0bb5 08 \u0bb9\u0730\u0bca\u0bb0\u0bb5\u0bbf\u0ba9\u0bcd\u0ba9 \u0bb5\u0bc0\u0bb0\u0b9a\u0bc7\u0b95\u0bb0 \u0b95\u0b99\u0bcd\u0b95\u0bbe\u0ba9\u0bae\u0bcd\u0b95\u0bc7 \u0bae\u0ba4\u0bc1\u0bb7\u0b99\u0bcd\u0b95 09 \u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0bb5\u0ba9 \u0bb9\u0ba4\u0bb0\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bc7 \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba8\u0bcd\u0ba4 \u0b9c\u0b95\u0ba4\u0bcd \u0b95\u0bc1\u0bae\u0bbe\u0bb0 10 \u0bb5\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0ba8\u0bcd\u0ba4 \u0b86\u0ba9\u0ba4\u0bcd\u0ba4 \u0baa\u0ba4\u0bbf\u0bb0\u0ba9\u0b95\u0bc7 \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba8\u0bcd\u0ba4 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 11 \u0bb5\u0bb2\u0bcd\u0b95\u0bae\u0bcd\u0bae\u0bc1\u0bb2\u0bcd\u0bb2 \u0bb9\u0bc6\u0b9f\u0bcd\u0b9f\u0bbf \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bc7 \u0b9a\u0bae\u0bbf\u0ba9\u0bcd\u0ba4 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 12 \u0ba8\u0bae\u0ba8\u0bc6\u0bb2\u0bbf\u0baf \u0bae\u0bb9\u0ba4\u0bc1\u0bb0\u0b95\u0bc7 \u0b9a\u0bc1\u0b95\u0ba4\u0ba4\u0bbe\u0b9a 13 \u0bb5\u0bc6\u0bb2\u0ba8\u0bcd\u0ba4\u0b95\ufffd\u0bca\u0b9f \u0b95\u0b99\u0bcd\u0b95\u0bbe\u0ba9\u0bbf \u0ba4\u0bc1\u0bb0\u0b95\u0bc7 \u0b9c\u0baf\u0bb0\u0ba4\u0bcd\u0ba9 14 \u0bb5\u0bb0\u0bbe\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0bb5\u0bc0\u0bb0\u0baa\u0bcd\u0baa\u0bc1\u0bb2\u0bbf\u0b95\u0bc7 \u0b89\u0baa\u0bbe\u0bb2\u0bbf 15 \u0ba4\u0bc6\u0bb9\u0bbf\u0b95\u0bb9\u0bb9\u0bc7\u0ba9 \u0bb5\u0bc7\u0bb2\u0bbe\u0ba4\u0ba8\u0bcd\u0ba4\u0bbf\u200d\u0bb0\u0bbf\u0b95\u0bc7 \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0b99\u0bcd\u0b95\u0bbe \u0b9a\u0bae\u0ba8\u0bcd\u0ba4\u0bbf 16 \u0b95\u0bc6\u0b95\u0bcd\u0b95\u0bbf\u0bb0\u0bbf\u0b93\u0baa\u0b9f \u0bb5\u0bbf\u0bae\u0bb2\u0b9a\u0bbf\u0bb0\u0bbf \u0bb0\u0ba3\u0b9a\u0bbf\u0b99\u0bcd \u0bb2\u0bbf\u0baf\u0ba9\u0b95\u0bc7 17 \u0bb9\u0730\u0bca\u0bb0\u0bc7\u0bb5\u0bc6\u0bb2 \u0b89\u0baa\u0bc1\u0bb2\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0ba9 \u0bae\u0bb9\u0ba4\u0bc1\u0bb0\u0b95\u0bc7 \u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0b