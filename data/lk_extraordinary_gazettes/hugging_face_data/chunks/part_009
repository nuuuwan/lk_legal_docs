 \u0dc3\u0db7\u0dcf \u0d9a\u0dcf\u0dbb\u0dca\u0dca\u0dba\u0dba\u0dcf\u0dbd \u0dc3\u0d82\u0d9a\u0dd3\u0dbb\u0dca\u0dca\u0dab\u0dba.\u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0dd1\u0d9c\u0dbd. \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\n\n\u0d85\u0db1\u0dd4 \u0d85\u0d82\u0d82\u0d9a\u0dba\u0daf\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db1\u0db8\u0dad\u0ddd\ufffd\u0ddd\u02ea\u0dbb\u0dcf\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0db0\u0dd6\u0dbb\u0dba\u0db1\u0dca\n\n\u0d9a\u0dd0\u0dd0\u0db3\u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0dba\u0d9a\u0dd0\u0dd0\u0db3\u0dc0\u0db1\n\n\u0dc0\u0dda\u0dda\u0dbd\u0dcf\u0dcf\u0dc0\n\n\u0d9a\u0dd0\u0dd0\u0db3\u0dc0\u0db1 \u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba\n\n1\u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd\u0d8b\u0da9\u0dd4\u0db6\u0daf\u0dca\u0dca\u0daf\u0daf\u0dcf\u0dc0 \u0db4\u0dca\u200d\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\n\n\u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2/ \u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd22025.06.12\u0db4\u0dd9.\u0dc0. 9.00\u0db4\u0dca\u200d\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf \u0db8\u0dc4\u0dcf \u0dc3\u0db7\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dca\u0dc0\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dbd\u0dcf\u0dc0, \u0d8b\u0da9\u0dd4\u0db6\u0daf\u0dca\u0dca\u0daf\u0daf\u0dcf\u0dc0 \u0db4\u0dca\u200d\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0, \u0d8b\u0da9\u0dd4\u0db6\u0daf\u0dca\u0dca\u0daf\u0daf\u0dcf\u0dc0.\n\n2\u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd\u0d9a\u0dd4\u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0dca\u200d\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\n\n\u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2/ \u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd22025.06.12\u0db4.\u0dc0. 2.00\u0db4\u0dca\u200d\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf \u0db8\u0dc4\u0dcf