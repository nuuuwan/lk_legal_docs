1\u0d9a\u0ddd\ufffd\u0ddd\ufffd\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0da0\u0db8\u0dd2\u0dbd\u0dcf\u0dcf \u0daf\u0dba\u0dcf\u0d82\u0d82\ufffd\u0d9c\u0db1\u0dd308 \u0d85\u0da7\u0dc0\u0d9a\u0dca\u0dc0\u0dbd\u0d8b\u0da9\u0dc0\u0dd9\u0dd9\u0dbd \u0dc0\u0dc4\u0db8\u0dca\u0db4\u0dd4\u0dbb\u0d9c\u0dda\u0118 \u0dc3\u0d82\u0d82\u0da2\u0dd3\u0dc0 \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0d9c\u0dd4\u0dab\u0dc3\u0dd2\u0d82\u0d82\u0dc409 \u0db8\u0ddc\ufffd\u0ddc\u0dbb\u0dc4\u0dd0\u0dd0\u0dbd\u0d91\u0dbb\u0db8\u0dd4\u0daf\u0dd4\u0dc4\u0dda\ufffd\u0dda\u0db1\u0dd9\ufffd \u0db8\u0db1\u0db1\u0dca\u0db1\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db7\u0dcf\u0dcf\u0dad\u0dd2\u0dba \u0d9c\u0dd4\u0dab\u0dc3\u0dda\ufffd\u0dda\u0db110 \u0dc0\u0dd1\u0dd1\u0d9c\u0db4\u0dd2\u0da7\u0dd2\u0dba\u0d9a\u0dbd\u0dbd\u0dca\u0dbd\u0dd0\u0dd0\u0dbd\u0dca\u0dbd\u0dd9\ufffd \u0dbd\u0dda\u0262\u0d9a\u0db8\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0d9a\u0dd4\u0dbd\u0dbb\u0dad\u0dca\u0db111 \u0dbb\u0dad\u0dca\u0db8\u0dbd\u0dca\u0dc0\u0dd2\u0db1\u0dca\u0db1\u0dc0\u0dd2\u0dbd\u0dda\u0262 \u0dc4\u0dd9\ufffd\u0dc0\u0db1\u0dd0\u0dd0\u0db1\u0dca\u0db1\u0dd0\u0dd0\u0dc4\u0dd0\u0dd0\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0da0\u0db8\u0dd2\u0db1\u0dca\u0daf \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a12 \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0db1\u0dd4\u0dc0\u0dbb\u0dc3\u0dd9\ufffd\u0db1\u0dbb\u0dad\u0dca \u0d9c\u0dd4\u0dab\u0dc3\u0dda\ufffd\u0dda\u0d9a\u0dbb \u0dc0\u0dd2\u0daf\u0dcf\u0dcf\u0db1\u0dda\ufffd \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0da0\u0db8\u0dd2\u0db1\u0dca\u0daf \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0d82\u0d82\u0d9a\u0dbb\n\n\u0dc3\u0dd9\ufffd\u0db1\u0dbb\u0dad\u0dca13 \u0dc4\u0dad\u0dbb\u0db6\u0dcf\u0dcf\u0d9c\u0dda\u0118\u0daf\u0dd2\u0dba\u0dbd\u0dc0\u0dad\u0dca\u0dad \u0daf\u0dd4\u0dbb\u0d9c\u0dda\u0118 \u0da0\u0db1\u0dca\u0daf\u0dca\u200d\u0d