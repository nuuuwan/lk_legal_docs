\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bc1\u0bb3\u0bcd \u0737\u0ba4\u0bb7\u0731\u0bb8\u0bcd\u0ba4\u0732\u0bb0 \u0b95\u0bb3\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0738\u0bb1 \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0b95\u0732\u0bb0\u0731\u0bae\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd, 530095 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb0\u0bb2\u0bcd \u0b85\u0bb3\u0738\u0bb5 \u0bb5\u0738\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd, \u0baa\u0732\u0731\u0732\u0bb5\u0bc1 \u0b87\u0bb2. 05 \u0b87\u0bb2\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0732\u0bb0 \u0b87\u0bb2. 01 \u0b87\u0bb2\u0bcd 261 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0736\u0ba4\u0731\u0b9f\u0bb0\u0bcd\u0baa\u0731\u0b95 \u0b85\u0bb5\u0bcd\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0738\u0ba3\u0baf\u0732\u0bb2\u0bcd,\n\n\u201c\u0b95\u0731\u0ba3\u0732 \u0baa\u0732\u0731\u0732\u0bb5\u0bc1 \u0b87\u0bb2. 1:261 \u0b87\u0ba9\u0bcd \u0b95\u0733\u0bb4\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0738\u0ba4 \u0b85\u0b95\u0bb1\u0bcd\u0bb1\u0732 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 3:261 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0ba4\u0732\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0736\u0b9a\u0baf\u0bcd\u0ba4\u0bc1 \u0736\u0b95\u0731\u0bb3\u0bcd\u0bb3 \u0737\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\u201d\n\n\u0baa\u0bc0. \u0b9a\u0733. \u0b9f\u0bc0. \u0b9a\u0732\u0737\u0b95\u0bb0\u0731, \u0b95\u0731\u0ba3\u0732 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0723\u0732\u0bb0\u0bcd\u0ba3\u0baf \u0b86\u0738\u0ba3\u0baf\u0731\u0bb3\u0bb0\u0bcd \u0723\u0731\u0baf\u0b95\u0bae\u0bcd.\n\n\u0b95\u0731\u0ba3\u0732 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0723\u0732\u0bb0\u0bcd\u0ba3\u0baf\u0ba4\u0bcd \u0ba4\u0732\u0738\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0732\u0bb9\u0732\u0b95\u0ba4 \u0736