dca\u0dad\u0dd2\u0dbd\u0d9a04\u0dc4\u0dd2\u0dbb\u0dbd\u0dca\u0dbd\u0dd4\u0d9c\u0db8\u0da2\u0ddd\ufffd\u0ddd\u0db1\u0dca\u0d9c\u0dda\u0118 \u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0da0\u0db8\u0dd2\u0db1\u0dca\u0daf \u0dc3\u0dda\ufffd\u0dda\u0db1\u0dcf\u0dcf\u0dbb\u0dad\u0dca\u0db105\u0db8\u0dc4\u0daf\u0dd2\u0dc0\u0dd4\u0dbd\u0dca\u0dc0\u0dd0\u0dd0\u0dc0\u0d9c\u0dbd\u0dca\u0d9a\u0dd0\u0dd0\u0da7\u0dd2\u0dba\u0dda\u024f \u0d9c\u0dd9\ufffd\u0daf\u0dbb \u0daf\u0dd4\u0db8\u0dd2\u0db1\u0dca\u0daf \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0dc3\u0dd4\u0d9c\u0dad\u0db4\u0dcf\u0dcf\u0dbd06\u0d89\u0dc3\u0dd2\u0db1\u0dca\u0db6\u0dd0\u0dd0\u0dc3\u0dca\u0dc3\u0d9c\u0db8\u0db0\u0db1\u0db4\u0dcf\u0dcf\u0dbd\u0d9c\u0dda\u0118 \u0dc0\u0dd2\u0db8\u0dbd\u0dca\u0dad\u0dd4\u0d82\u0d82\u0d9c07\u0dc0\u0dbd\u0dca\u0db4\u0ddc\ufffd\u0ddc\u0dbd\u0d85\u0db8\u0dd2\u0dbd \u0db8\u0db0\u0dd4\u0dc3\u0d82\u0d82\u0d9a \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0daf\u0dcf\u0dcf\u0dc308\u0dba\u0d9a\u0dcf\u0dcf\u0dc0\u0dd0\u0dd0\u0dc0\u0d9c\u0dd4\u0dab\u0dc3\u0dda\ufffd\u0dda\u0db1\u0d9c\u0dda\u0118 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0db1\u0dca\u0dad \u0dc3\u0dda\ufffd\u0dda\u0db1\u0dcf\u0dcf\u0dbb\u0dad\u0dca\u0db109\u0db4\u0dd4\u0dbd\u0dca\u0d91\u0dc5\u0dd2\u0dba\u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0d89\u0dc3\u0dd4\u0dbb\u0dd4 \u0dc0\u0dd2\u0dbb\u0dcf\u0dcf\u0da2 \u0db6\u0d82\u0d82\u0da9\u0dcf\u0dcf\u0dbb10\u0db8\u0dd0\u0dd0\u0daf\u0dc0\u0da0\u0dca\u0da0\u0dd2\u0dba\u0dbb\u0d82\u0d82\u0dc0\u0db1\u0dca\u0daf\u0dd2 \u0daf\u0dda\u0dda\u0dc0\u0d9c\u0dda\u0118 \u0dc3\u0dbb\u0dad\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0dbb\u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dc0\n\n\u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\n\n\u0dad\u0ddd\ufffd\u0ddd\u0dbb\u0dcf\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca i\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\nIV (\u0d86) \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3 - \u200d\u200d\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u200d\u200d\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.05.313A\n\n\u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\nI \u0dad\u0dd3\u0dbb\u0dd4\u0dc0 II \u0dad\u0dd3\u0dbb\u0dd4\u0dc0"
