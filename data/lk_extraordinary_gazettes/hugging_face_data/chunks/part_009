5\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0ba9\u0bc7 01 \u0ba8\u0bbe\u0b9a\u0bcd\u0b9a\u0bbe\u0ba4\u0bc2\u0bb5 \u0b85\u0baa\u0bcd\u0ba4\u0bc1\u0bb2\u0bcd \u0b95\u0bbe\u0ba4\u0bb0\u0bcd \u0bae\ufffd\u0bca\u0bb9\u0bae\u0bcd\u0bae\u0ba4\u0bc1 \u0ba8\u0bbf\u0baf\u0bbe\u0bb8\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8 02 \u0ba4\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0ba9\u0bc7 \u0b95\ufffd\u0bcb\u0bb0\u0bb2\u0bc7 \u0b95\u0b99\u0bcd\u0b95\u0bbe\u0ba9\u0bae\u0bcd\u0b95\u0bc7 \u0b9a\u0bae\u0ba8\u0bcd\u0ba4 03 \u0b89\u0b9f\u0bcd\u0b9f\u0bbf\u0bae\u0b9f\u0bc1\u0bb5 \u0b9a\u0ba8\u0bcd\u0baf\u0bbe \u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bbf \u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0b9a\u0bc7\u0b95\u0bb0 04 \u0baa\u0baf\u0bbf\u0bb0\u0bbf\u0bae\u0b9f\u0bc1\u0bb5 \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0b95\u0bc7 \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9 05 \u0b8e\u0ba4\u0bcd\u0ba4\u0bc1\u0ba9\u0bcd\u0b95\u0bae \u0bb0\u0ba9\u0bcd\u0b95\u0bca\u0ba4\u0bcd \u0ba4\u0bc7\u0bb5\u0baf\u0bb2\u0bbe\u0b95\u0bc7 \u0b9a\u0b9e\u0bcd\u0b9c\u0bbf\u0bb5 \u0baa\u0bc1\u0bb7\u0bcd\u0baa\u0b95\u0bc1\u0bae\u0bbe\u0bb0 06 \u0b9a\u0bc6\u0bb2\u0bc6\u0bb8\u0bcd\u0ba4\u0bbf\u0bae\u0b9f\u0bc1\u0bb5 \u0ba8\u0bc6\u0bb2\u0bbf\u0b95\u0bae \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0b85\u0b9a\u0b99\u0bcd\u0b95 \u0b9c\u0bc0\u0bb5\u0ba9\u0bcd \u0b9a\u0bae\u0bb0\u0b95\ufffd\u0bcb\u0ba9\u0bcd 07 \u0b86\u0bb2\u0bbf\u0bb8\u0bcd\u0ba4\u0bbe\u0ba9 \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9\u0b95\u0bc7 \u0ba4\u0bbf\u0bb2\u0bc0\u0baa \u0ba8\u0bc1\u0bb5\u0ba9\u0bcd \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9 08 \u0bb5\u0bb2\u0b95\u0bae\u0bcd\u0baa\u0bbe\u0bb9\u0bc2\u0bb5 \u0b9c\u0baf\u0ba4\u0bbf\u0bb2\u0b95\u0b95\u0bc7 \u0bb0\ufffd\u0bcb\u0bb9\u0ba3 \u0bb5\u0bbf\u0b9c\u0baf\u0ba4\u0bbf\u0bb2\u0b95 09 \u0bb2\u0baa\u0bc1\u0ba9\ufffd\u0bcb\u0bb1\u0bc1\u0bb5 \u0b8f\u0b95\u0ba8\u0bbe\u0baf\u0b95 \u0baa\u0ba4\u0bbf\u0bb0\u0ba9\u0bcd\u0ba8\u0bc6\u0bb9\u0bc6\u0bb2\u0bbe\u0b95\u0bc7 \u0bb0\ufffd\u0bca\u0bb7\u0bbe\u0ba9\u0bcd \u0b9a\u0bae\u0bc0\u0bb0 \u0bb5\u0bbf\u0b9c\u0bc7\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 10 \u0bae\u0bc1\u0bb0\u0bbf\u0baf\u0bbe\u0b95\u0b9f\u0bb5\u0bb2 \u0baf\u0bc2\u0b9a\u0bc1\u0baa\u0bcd \u0bae\ufffd\u0bca\u0bb9\ufffd\u0bcb\u0bae\u0b9f\u0bcd \u0b85\u0bb0\u0bc2\u0bb8\u0bcd\n\n\u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n\u0bb0\u0bae\u0bcd\u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0b95\u0bc7 \u0ba4\u0bb0\u0bcd\u0bb7\u0ba9 \u0baa\u0baa\u0bbe \u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bbf \u0ba4\u0bb0\u0bcd\u0bae\u0ba4\u0bbe\u0b9a\u0b95\u0bc7 \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bae\u0bbe \u0ba8\u0bbf\u0bb0\ufffd\u0bcb\u0bb7\u0ba3\u0bc0 \u0ba4\u0bb0\u0bcd\u0bae\u0ba4\u0bbe\u0b9a \u0bb0\u0bb5\u0bc0\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0b95\u0bc7 \u0b9a\u0ba4\u0bb2\u0bbf \u0b95\u0bc7\u0bb7\u0bb0\u0bbe \u0b9c\u0baf\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0b9f\u0bbf\u0b95\u0bbf\u0bb0\u0bbf \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0 \u0bb5\u0ba9\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0b9c\u0baf\u0b9a\u0bc7\u0ba9\u0b95\u0bc7 \u0b9a\u0bbf\u0b9a\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0b9c\u0baf\u0b9a\u0bc7\u0ba9 \u0baa\u0bc1\u0b9e\u0bcd\u0b9a\u0bbf\u0baa\u0baf\u0bbf\u0baf\u0bbe\u0b95\u0bc7 \u0bb2\u0baf\u0ba9\u0bb2\u0bcd \u0bb0\u0bc2\u0baa\u0b9a\u0bbf\u0b99\u0bcd\u0bb9\n\nI \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd II \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd I \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd II \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd\u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0bb5\u0b9f\u0bcd\u0b9f\u0bbe\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0bb5\u0b9f\u0bcd\u0b9f\u0bbe\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0b9a\u0baa\u0bc8 \u0baa\u0bc6\u0baf\u0bb0\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0b9a\u0baa\u0bc8 \u0baa\u0bc6\u0baf\u0bb0\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0bc8 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0bc8 (\u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf)\n\nIV (\u0d86) fldgi - YS% ,xld m%cd;dka;s%l iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'05'31gFjp IV (M) - ,yq;ifr; rdehaf Nrhryprf; FbauR tu;j;jkhdg; gj;jpupif - mjp tpNr\\khdJ - 2025.05.31\n\n11\n\nI \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd II \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd I \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd II \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd\u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\