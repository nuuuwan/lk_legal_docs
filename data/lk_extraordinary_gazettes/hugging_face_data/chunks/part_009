    "chunk_text": "\u0b8f. \u0b9a\u0ba3\u0bcd\u0bae\u0bc1\u0b95\u0ba8\u0bbe\u0ba4\u0ba9\u0bcd, \u0b8f. \u0b9a\u0ba3\u0bcd\u0bae\u0bc1\u0b95\u0ba8\u0bbe\u0ba4\u0ba9\u0bcd, \u0baa\u0bc7\u0bb0\u0bbe\u0b9a\u0bbf\u0bb0\u0bbf\u0baf\u0bb0\u0bcd \u0baa\u0bc7\u0bb0\u0bbe\u0b9a\u0bbf\u0bb0\u0bbf\u0baf\u0bb0\u0bcd \u0bb2\u0b95\u0bcd \u0bb7\u0bcd\u0bae\u0ba9\u0bcd \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95,\u0bb2\u0b95\u0bcd \u0bb7\u0bcd\u0bae\u0ba9\u0bcd \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95, \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd, \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd, \u0ba4\u0bc7\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd \u0b86\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1. \u0ba4\u0bc7\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd \u0b86\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1.\n\n\u0ba4\u0bc7\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bc6\u0baf\u0bb2\u0b95\u0bae\u0bcd,\u0b9a\u0bb0\u0ba3 \u0bae\u0bbe\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8,\u0b87\u0bb0\u0bbe\u0b9c\u0b95\u0bbf\u0bb0\u0bbf\u0baf.2025, \u0bae\u0bc7 31.\n\nI \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd II \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd I \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd II \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd\n\n\u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0bb5\u0b9f\u0bcd\u0b9f\u0bbe\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0bb5\u0b9f\u0bcd\u0b9f\u0bbe\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\n\n\u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0b9a\u0baa\u0bc8 \u0baa\u0bc6\u0baf\u0bb0\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bc6\u0baf\u0bb0\u0bcd \u0b9a\u0baa\u0bc8 \u0baa\u0bc6\u0baf\u0bb0\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n\u0bb5\u0bb5\u0bc1\u0ba9\u0bbf\u0baf\u0bbe\u0bb5\u0bb5\u0bc1\u0ba9\u0bbf\u0baf\u0bbe \u0bb5\u0bb5\u0bc1\u0ba9\u0bbf\u0baf\u0bbe 01 \u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bae\u0bcd \u0b9a\u0bc1\u0ba8\u0bcd\u0ba4\u0bb0\u0bb2\u0bbf\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc0\u0baa\u0ba9\u0bcd \u0bae\u0bbe\u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8 02 \u0baa\u0b9f\u0bcd\u0b9f\u0bbe\u0ba3\u0bbf\u0b9a\u0bcd\u0b9a\u0bbf \u0baa\u0bc1\u0bb3\u0bbf\u0baf\u0b99\u0bcd\u0b95\u0bc1\u0bb3\u0bae\u0bcd * \u0b85\u0baa\u0bcd\u0ba4\u0bc1\u0bb2\u0bcd \u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0baa\u0bcd \u0bae\u0bc1\u0b95\u0bae\u0bcd\u0bae\u0ba4\u0bc1 \u0bae\u0bc1\u0ba9\u0bb5\u0bcd\u0baa\u0bb0\u0bcd \u0baa\u0bbe\u0bb0\u0bc1\u0b95\u0bcd \u0baa\u0bb0\u0bcd\u0b9a\u0bbe\u0ba9\u0bcd 03 \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bae\u0bcd \u0b9a\u0bbf\u0bb5\u0b9a\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0bae\u0ba3\u0bbf\u0baf\u0bae\u0bcd \u0baa\u0bbf\u0bb1\u0bc7\u0bae\u0ba4\u0bbe\u0bb8\u0bcd 04 \u0bb5\u0bc8\u0bb0\u0bb5\u0baa\u0bc1\u0bb3\u0bbf\u0baf\u0b99\u0bcd\u0b95\u0bc1\u0bb3\u0bae\u0bcd \u0b95\u0ba8\u0bcd\u0ba4\u0bc8\u0baf\u0bbe \u0bb5\u0bbf\u0b9c\u0baf\u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 05 \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bc1 \u0b95\u0ba9\u0b95\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bae\u0bcd \u0b95\u0bbf\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3\u0ba4\u0bbe\u0bb8\u0bcd 06 \u0b95\u0b9f\u0bc8\u0bb5\u0bc0\u0ba4\u0bbf \u0bb2\u0b95\u0bcd\u0bb8\u0bcd\u0b9a\u0ba9\u0bbe \u0ba8\u0bbe\u0b95\u0bb0\u0bbe\u0b9c\u0ba9\u0bcd 07 \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bc1\u0bae\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc1 * \u0b9c\u0baf\u0b9a\u0bc7\u0b95\u0bb0 \u0b86\u0bb0\u0bbe\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bc7 \u0ba4\u0bae\u0bcd\u0bae\u0bbf\u0b95 \u0bb2\u0bb2\u0bbf\u0ba4\u0bcd \u0b9c\u0baf\u0b9a\u0bc7\u0b95\u0bb0 \u0baa\u0bb2\u0bb5\u0bb2\u0ba4\u0bc1\u0b99\u0bcd\u0b95\u0bbe \u0bb2\u0bc7\u0b95\u0bcd\u0b95\u0bae\u0bcd\u0bb2\u0b95\u0bc7 \u0bb5\u0bbf\u0baa\u0bc1\u0bb2\u0b95\u0bc1\u0bae\u0bbe\u0bb0 08 \u0b87\u0bb1\u0bae\u0bcd\u0baa\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bae\u0bcd \u0b9a\u0bbf\u0bb5\u0bb2\u0bbf\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0b87\u0bb0\u0bb5\u0bc0\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0ba9\u0bcd 09 \u0b9a\u0bbf\u0ba9\u0bcd\u0ba9\u0baa\u0bcd\u0baa\u0bc1\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bae\u0bcd \u0b9a\u0bbf\u0bb1\u0bbf\u0bb8\u0bcd\u0b95\u0ba8\u0bcd\u0ba4\u0bb0\u0bbe\u0b9c\u0bbe \u0b85\u0bb0\u0bc1\u0ba3\u0ba9\u0bcd 10 \u0b95\ufffd\u0bcb\u0bb5\u0bbf\u0bb2\u0bcd\u0b95\u0bc1\u0bb3\u0bae\u0bcd \u0b9a\u0bbf\u0bb5\u0b9a\ufffd\u0bcb\u0ba4\u0bbf \u0b9a\u0bbf\u0bb5\u0b9a\u0b99\u0bcd\u0b95\u0bb0\u0bcd\n\n\u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n\u200b\u0b89\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0b9a\u0bbf\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0baf\ufffd\u0bcb\u0b95\u0bc7\u0bb8\u0bcd\u0bb5\u0bb0\u0bbf \u0bb5\u0bc8\u0bb0\u0bae\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0bb5\u0bb0\u0ba4\u0bb2\u0b9f\u0bcd\u0b9a\u0bc1\u0bae\u0bbf \u0bb0\u0bb5\u0bc0\u0ba8\u