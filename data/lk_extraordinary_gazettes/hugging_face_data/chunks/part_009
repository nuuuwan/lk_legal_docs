    "chunk_text": "\u0dbb\u0dcf\u0dcf\u0da2\u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb\u0db1\u0dca \u0db0\u0db1\u0dda\ufffd\u0dc2\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db1\u0dd2\u0dba\u0dc0\u0dad\u0dca\u0dad\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db8\u0ddc\ufffd\u0ddc\u0dc4\u0dcf\u0dcf\u0db1\u0dca \u0db8\u0d82\u0d82\u0da2\u0dd4\u0dbd\u0dc0\u0dda\u0dda\u0dbd\u0dcf\u0dcf\u0dba\u0dd4\u0daf\u0db8\u0dca \u0da2\u0dd9\u0dd9\u0dc4\u0db1\u0dca \u0db8\u0ddd\ufffd\u0ddd\ufffd\u0dc4\u0db1\u0dca\u0db6\u0dcf\u0dcf\u0dbd\u0d9c\u0dda\u0118 \u0dad\u0dd4\u0dc2\u0dcf\u0dcf\u0dbb\u0dd2 \u0daf\u0db8\u0dba\u0db1\u0dca\u0dad\u0dd2 \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf\u0dcf\u0dc4\u0db4\u0dd4\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9c\u0dd9\ufffd \u0da5\u0dcf\u0dcf\u0db1\u0dbd\u0dad\u0dcf\u0dcf \u0dc4\u0db4\u0dd4\u0dad\u0db1\u0dca\u0dad\u0dd2\u0dbb\u0dd2\u0dc4\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0dc0\u0dc3\u0db8\u0dca \u0d9c\u0db8\u0d9c\u0dda\u0118 \u0dc3\u0da0\u0dd2\u0db1\u0dd2 \u0dc3\u0dd9\ufffd\u0dc0\u0dca\u0dc0\u0db1\u0dca\u0daf\u0dd2\u0db8\u0dcf\u0dcf\u0d9a\u0dcf\u0dcf\u0dc0\u0dd2\u0da7\u0d9c\u0dda\u0118 \u0dc3\u0dd4\u0dbd\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc3\u0db3\u0dbb\u0dda\u0dda\u0d9b\u0dcf\u0dcf \u0db8\u0dcf\u0dcf\u0d9a\u0dcf\u0dcf\u0dc0\u0dd2\u0da7\u0d9c\u0dbd\u0dca \u0d85\u0dc3\u0dca\u0dc3\u0dcf\u0dcf\u0db4\u0ddc\ufffd\u0ddc\u0dc5 \u0d9a\u0ddc\ufffd\u0ddc\u0dbb\u0da7\u0dd4\u0dc0\u0dd9\u0dd9\u0d9c\u0dd9\ufffd\u0daf\u0dbb \u0dc3\u0dd4\u0db8\u0dda\ufffd\u0db0 \u0dbd\u0d9a\u0dca\u0db8\u0dcf\u0dcf\u0dbd\u0dca\u0dc0\u0dd2\u0dad\u0dcf\u0dcf\u0db1\u0d9c\u0dda\u0118 \u0d89\u0db1\u0dca\u0daf\u0dd2\u0d9a \u0d8b\u0daf\u0dba \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0d9c\u0dd4\u0dab\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0db8\u0d82\u0d82\u0da2\u0dd4 \u0da9\u0dba\u0dc3\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0db1\u0dcf\u0dcf\u0dba\u0d9a\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dcf\u0db1\u0dca\u0daf\u0dd4\u0dbd\u0dcf\u0dcf\u0