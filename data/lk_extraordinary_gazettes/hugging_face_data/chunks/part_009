    "chunk_text": "\u0d89\u0db8\u0dd2\u0dc4\u0dcf\u0db8\u0dd2 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0dad\u0dd2\u0dbd\u0d9a\u0dbb\u0dad\u0dca\u0db1 \u0dbb\u0dcf\u0da2\u0d9c\u0dd4\u0dbb\u0dd4\n\n\u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0d9c\u0dda \u0dc3\u0dd4\u0db1\u0dda\u0dad\u0dca\u200d\u0dbb\u0dcf \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dd2 \u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2\n\n\u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf \u0db1\u0db1\u0dca\u0daf\u0db1\u0dd3 \u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2\n\n\u0d9c\u0db1\u0dda\u0db8\u0da9\u0dd2\u0dad\u0dca\u0dad\u0dba\u0dbd\u0dcf\u0d9c\u0dda \u0d9c\u0dd2\u0dc4\u0dcf\u0db1\u0dca \u0dc3\u0dd9\u0db1\u0dd9\u0dc0\u0dd2\u0dbb\u0dad\u0dca\u0db1\n\n\u0dc4\ufffd\u0dda\u0dbb\u0dad\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0dad\u0dd2\u0dc3\u0dca\u0dc3 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\n\n\u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0d85\u0dc3\u0d82\u0d9a \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a\n\n\u0dc4\ufffd\u0dda\u0dbb\u0dad\u0dca \u0db6\u0d82\u0da9\u0dcf\u0dbb\u0dbd\u0dcf\u0d9c\u0dda \u0db1\u0dd2\u0dc1\u0dcf\u0db1\u0dca\u0dad \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0dc4\ufffd\u0dda\u0dbb\u0dad\u0dca\n\n\u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0d89\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dcf\u0db1\u0dd2 \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a\n\n\u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a\n\n\u0dc0\u0dd3\u0dbb\u0dc3\u0dd6\