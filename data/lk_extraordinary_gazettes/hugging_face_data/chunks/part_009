    "chunk_text": "\u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bc6\u0bb2\u0bbf\u200e\u0b95\u0bc6\u200e\u0baa\ufffd\u0bca\u0bb2 01 \u0bb9\u0bc1\u0ba9\u0bc1\u0bb5\u0bb2 * \u0bb0\u0b99\u0bcd\u0b9a\u0b95\ufffd\u0bca\u0b9f \u0b95\u0b99\u0bcd\u0b95\u0bbe\u0ba9\u0bae\u0bcd\u0bb2\u0bbe\u0b95\u0bc7 \u0bb0\u0bc1\u0ba4\u0bcd\u0bb0\u0bbe \u0b89\u0ba4\u0bcd\u200d\u0baf\u0bbe\u0bae \u0b9a\u0bae\u0bcd\u0baa\u0bbf\u0bb0\u0ba4\u0bbf \u0baa\u0bbf\u0bb0\u200d\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8 \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0baa\u0b9e\u0bcd\u0b9a\u0bb5\u0bb0\u0bcd\u0ba3\u0bae\u0bcd \u0b85\u0b9e\u0bcd\u0b9c\u0bb2\u0bbe \u0ba4\u0bc7\u0bb5\u0bbf 02 \u0b89\u0b9f\u0bb5\u0bc6\u0bb2 \u0b95\u0bc1\u0b9f\u0bbe \u0bb9\u0bc7\u0bb5\u0bb2\u0bbe\u0b95\u0bc7 \u0b87\u0bb7\u0bbe\u0bb0\u0bbe \u0bb0\u0bc1\u0bb7\u0bbe\u0ba9\u0bbf \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba9\u0ba8\u0bcd\u0ba4\u0ba9 03 \u0b93\u0baa\u0ba9\u0bbe\u0baf\u0b95 \u0ba8\u0bb1\u0bbf\u0bb8\u0bcd\u0bb8 \u0b95\u0bae\u0b8e\u0ba4\u0bbf\u0b95\u0bc7 \u0b89\u0baa\u0bc1\u0bb2\u0bcd \u0bb5\u0b9a\u0ba8\u0bcd\u0ba4 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 04 \u0b85\u0b95\u0bb0\u0bc6\u0bb2\u0bcd\u0bb2 \u0b95\u0bb2\u0bcd\u0baa\u0bca\u0ba4\u0bcd\u0ba4\u0bb2\u0bbe\u0b95\u0bc7 \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0ba4\u0bbf\u0bb2\u0b95 05 \u0baa\u0ba9\u0bbe\u0ba9 \u0b8e\u0bb2\u0bcd\u0bb2\u0baa\ufffd\u0bca\u0bb2 \u0bae\u0bc6\u0ba4\u0b95\u0bc6\u0ba4\u0bb0 \u0b9a\u0bb0\u0ba4\u0bcd \u0b86\u0ba9\u0ba8\u0bcd\u0ba4 06 \u0bb0\u0b99\u0bcd\u0bb5\u0bb2 \u0ba4\u0bc7\u0bb5\u0b95\u0bc7 \u0baa\u0bbe\u0bb2\u0bbf\u0ba4 \u0bb0\u0bb5\u0bbf\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bae\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 07 \u0baa\u0ba4\u0bc1\u0bb2\u0bcd\u0bb2\u0bc7\u0b95\u0bae \u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0ba4\u0b95\u0bc7 \u0baa\u0bc1\u0bb7\u0bcd\u0baa \u0b95\u0bc1\u0bae\u0bbe\u0bb0 08 \u0bb5\u0bc6\u0bb2\u0bbf\u0b95\u0bc6\u0baa\ufffd\u0bca\u0bb2 \u0bb9\u0bc6\u0b9f\u0bcd\u0b9f\u0bbf \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0bb2\u0bbe\u0b95\u0bc7 \u0b9a\u0bae\u0bbf\u0ba8\u0bcd\u0ba4 \u0ba4\u0b9a\u0ba8\u0bbe\u0baf\u0b95 09 \u0bb9\u0ba8\u0bcd\u0ba4\u0b95\u0bbf\u0bb0\u0bbf\u0baf \u0bb9\u0baa\u0bc1\u0b95\u0bb9\u0baa\u0bbf\u0b9f\u0bbf\u0baf \u0bae\ufffd\u0bca\u0bb9\ufffd\u0bca\u0b9f\u0bcd\u0b9f\u0bbe\u0bb2\u0bb2\u0bbe\u0b95\u0bc7 \u0bb2\u0bb2\u0bbf\u0ba4\u0bcd \u0bb5\u0bbf\u0b9c\u0bc7\u0b9a\u0bbf\u0bb1\u0bbf \u0bb9\u0baa\u0bc1\u0b95\u0bb9\u0baa\u0bbf\u0b9f\u0bbf\u0baf 10 \u0b95\u0bb2\u0bcd\u0baa\u0bbe\u0baf \u0baa\u0ba9\u0bcd\u0ba9\u0bbf\u0bb2 \u0b95\u0bae \u0b8e\u0ba4\u0bbf\u0b95\u0bc7 \u0bb7\u0bbe\u0ba8\u0bcd\u0ba4 \u0b95\u0bc1\u0b9a\u0bc1\u0bae\u0bcd \u0b95\u0bc1\u0bae\u0bbe\u0bb0\n\n\u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bb2 01 \u0ba4\u0bae\u0bcd\u0baa\u0bc1\u0bb2\u0bc1\u0bb5\u0ba9 \u0b9f\u0baf\u0bbf\u0b9f\u0bb8\u0bcd \u0ba8\u0bbe\u0bb2\u0b95 \u0bb9\u0bc7\u0bb5\u0bbe\u0bb5\u0bbf\u0ba4\u0bbe\u0bb0\u0ba3 \u0baa\u0bbf\u0bb0\u200d\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8 02 \u0b95\u0bb0\u0ba9\u0bcd\u0b95\u0bca\u0b9f \u0b95\u0bc1\u0bb0\u0bc1\u0bb5\u0bbf\u0b9f \u0b95\u0b99\u0bcd\u0b95\u0ba3\u0bae\u0b95\u0bc7 \u0b93\u0bb7\u0ba4\u0bbf \u0ba8\u0bbf\u0bae\u0bcd\u0b9a\u0bb0\u0bbe \u0b9a\u0bae\u0bb0\u0ba8\u0bbe\u0baf\u0b95 03 \u0b8e\u0bb2\u0baa\u0bbe\u0ba4 \u0b95\ufffd\u0bcb\u0ba3\u0bbe\u0bb0\u0b95\u0bc7 \u0ba4\u0ba9\u0bc1\u0bb7\u0bcd\u0b95 \u0b89\u0ba4\u0baf\u0ba9\u0bcd\u0ba4 \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u0b95 04 \u0bb5\u0bc7\u0bb0\u0b95\u0bae \u0bb9\u0bc7\u0bb0\u0ba4\u0bcd \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0b9f\u0bbf\u0b9a\u0bc0\u0b95 \u0b85\u