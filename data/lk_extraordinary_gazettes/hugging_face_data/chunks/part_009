db8\u0dd3\u0dbb\u0dca \u0dc6\u0dc0\u0dd4\u0dc3\u0dca\n\n\u0d8b\u0da9\u0d9c\u0dd9\u0daf\u0dbb \u0dc3\u0dbb\u0dad\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\n\n\u0d89\u0db8\u0dd2\u0dc4\u0dcf\u0db8\u0dd2 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0d8b\u0db4\u0dcf\u0dbd\u0dd2 \u0dc3\ufffd\u0dda\u0db1\u0dcf\u0db0\u0dd3\u0dbb\n\n\u0db6\u0dcf\u0dbd\u0d9c\u0dda \u0db6\u0db1\u0dca\u0daf\u0dd4\u0dc3\ufffd\u0dda\u0db1 \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf\n\n\u0dc0\u0dd2\u0da2\u0dda\u0db4\u0dcf\u0dbd \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0dbb\u0db1\u0dca\u0db6\u0dab\u0dca\u0da9\u0dcf \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a\n\n\u0db4\u0dad\u0dd2\u0dbb\u0db1\u0dca\u0db1\u0dd0\u0dc4\u0dd0\u0dbd\u0dcf\u200d\u0d9c\u0dda \u0da9\u0dd2\u0dbd\u0dcf\u0db1\u0dd2 \u0dbd\u0d9a\u0dca\u200d\u0dc2\u0dd2\u0d9a\u0dcf \u0db4\u0dad\u0dd2\u0dbb\u0db1\n\n\u0dc3\u0dd2\u0dba\u0db1\u0dca\u0d9a\u0dcf\u0dbb\u0dd2\u0d9c\u0dda \u0dc1\u0dcf\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0da2\u0dda\u0db1\u0dcf\u0dba\u0d9a\n\n\u0dbb\ufffd\u0ddd\ufffd\u0dc4\u0dab \u0db8\u0dd4\u0daf\u0dbd\u0dd2\u0d9c\u0dda \u0dbb\u0dd4\u0dc0\u0dd2\u0db1\u0dd2 \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dd2 \u0db8\u0dd4\u0daf\u0dbd\u0dd2\u0d9c\u0dda\n\n\u0db4\u0dad\u0dd2\u0dbb\u0dcf\u0da2 \u0dc4\ufffd\u0dda\u0dbb\u0dad\u0dca\u0dbd\u0dcf\u0d9c\u0dda \u0d8b\u0db4\u0dcf\u0dbd\u0dd2 \u0d9c\u0dd4\u0dab\u0dbb\u0dad\u0dca\u0db1\n\n\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0d9c\u0db8\u0d9c\u0dda \u0d85\u0da2\u0dd2\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db1\u0dca\u0db1 \u0dbb\u0dad\u0dca\u0db1\u0dc3\u0dd6\u0dbb\u0dd2\u0dba\n\n\u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0db1\u0dd2\u0dbd\u0dd6\u0d9a\u0dcf \u0dc1\u0dca\u200d\u0dba\u0dcf\u0db8\u0dbd\u0dd3 \u0da2\u0dba\u0db1\u0dca\u0dad\n\n\u0dc4\ufffd\u0dda\u0dbb\u0dad\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda