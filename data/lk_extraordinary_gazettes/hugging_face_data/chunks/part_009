\u0dca\u0db6\u0db1\u0dca\u0dad\u0ddc\ufffd\u0ddc\u0da7 (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\u0dc3\u0dd6\u0dbb\u0dd2\u0dba\u0dc0\u0dd0\u0dd0\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc3\u0db8\u0dbb\u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dbd\u0dd2\u0dba\u0db1\u0d9c\u0dda\u0118 \u0da0\u0db8\u0dd2\u0db1\u0dca\u0daf \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0dc3\u0db8\u0dbb\u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\n\n\u0dc4\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0ddc\ufffd\u0ddc\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0d9a\u0dd4\u0dbd\u0db4\u0dca\u0db4\u0dd4\u0dc0\u0dcf\u0dcf \u0dc0\u0da9\u0dd4 \u0dc3\u0dd4\u0db8\u0dd2\u0dad\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0db8\u0dd4\u0dab\u0dc3\u0dd2\u0d82\u0d82\u0dc4 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda\u0118 \u0da0\u0db1\u0dca\u200d\u0daf\u0daf\u0dcf\u0dcf\u0dc3 \u0db8\u0dd4\u0dab\u0dc3\u0dd2\u0d82\u0d82\u0dc4\n\n\u0dbd\u0dd4\u0dab\u0dd4\u0d9c\u0db8\u0dca\u0dc0\u0dd9\u0dd9\u0dc4\u0dd9\ufffd\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc4\u0dd9\ufffd\u0da7\u0dca\u0da7\u0dd2 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda\u0118 \u0db1\u0dd2\u0dbb\u0ddd\ufffd\u0ddd\ufffd\u0dc2\u0dca \u0daf\u0dd2\u0db8\u0dd4\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc3\u0d82\u0d82\u0d9c\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0da0\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc3\u0dda\ufffd\u0dda\u0d9a\u0dbb \u0dba\u0dcf\u200d\u200d\ufffd\u0db4\u0dcf\u0dcf \u0dc3\u0dbb\u0dad\u0dca\n\n\u0d9a\u0dd2\u0dbd\u0dd2\u0db1\u0ddc\ufffd\u0ddc\u0da0\u0dca\u0da0\u0dd2\u0dba \u0d9a\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0d85\u0dbb\u0dd4\u0db1\u0dcf\u0dcf\u0dc3\u0dbd\u0db8\u0dca \u0dc0\u0dda\u0dda\u0dc5\u0db8\u0dcf\u0dcf\u0dbd\u0dd2\u0d9a\u0dd2\u0dad\u0db1\u0dca\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0db4\u0dd4\u0dc2\u0dca\u0db4\u0db1\u0dcf\u0dcf\u0daf\u0db1\u0dca \u0dc3\u0dd2\u0dc0\u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb\u0dca\n\n\u0db4\u0dd6\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc3\u0dd2\u0dc0\u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dbb\u0d82\u0d82\u0da2\u0db1\u0dca\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0d9a\u0dd4\u0dab\u0dbd\u0da0\u0dca\u0da0\u0dd2\u0db8\u0dd2 \u0d9a\u0dd4\u0dbd\u0dc0\u0dd3\u0dbb\u0dc3\u0dd2\u0d82\u0d82\u0d9c\u0db8\u0dca\n\n\u0db8\u0dd4\u0dbd\u0dad\u0dd2\u0dc0\u0dca\u0db4\u0dd4\u0dad\u0dd4\u0d9a\u0dd4\u0da9\u0dd2\u0d89\u0dbb\u0dd2\u0db4\u0dca\u0db4\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dda\u0dda\u0dbd\u0dcf\u0dcf\u0dba\u0dd4\u0db0\u0db8\u0dca \u0d9a\u0dbb\u0dd2\u0d9a\u0dcf\u0dcf\u0dbd\u0db1\u0dca\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc3\u0dd4\u0db1\u0dca\u0daf\u0dbb\u0db8\u0dca \u0db4\u0dbb\u0db1\u0dca\u0daf\u0dcf\u0dcf\u0db8\u0db1\u0dca\n\n\u0db8\u0da9\u0d9a\u0dbd\u0db4\u0dd4\u0dc0 \u0d9a\u0dcf\u0dcf\u0dad\u0dca\u0dad\u0db1\u0dca\u0d9a\u0dd4\u0da9\u0dd2 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc3\u0dcf\u0dcf\u0dc4\u0dd4\u0dbd\u0dca \u0dc4\u0db8\u0dd3\u0daf\u0dd4 \u0db8\u0dd4\u0dc4\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0d85\u0dc3\u0dca\u0db4\u0dbb\u0dca\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0db8\u0dd4\u0dc4\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0d89\u0db6\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dc4\u0dd3\u0db8\u0dca \u0db8\u0dd4\u0dc4\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0da2\u0dd9\u0dd9\u0dc3\u0dd3\u0db8\u0dca"
