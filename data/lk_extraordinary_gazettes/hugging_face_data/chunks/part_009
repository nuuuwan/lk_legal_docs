9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2025.06.04\n\n\u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u1fa6\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0 \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0b95\u0bc8\u0bb3\u1fb0\n\n\u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u1fb9\u0bb1 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u1fbf\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n(\u0baa\u0bbf\u0bbe\u0bbf\u1fab 12)\n\n\u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u1fbf \u0b87\u0bb2.: 51/1473 - \u0b95\u1fbb\u0baa\u0bb9\u0bbe \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fbb\n\n\u0bc7\u0bae\u1fbf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u1fb7\u0ba4\u0bbf\u1fbf \u0b95\u1fbb\u0baa\u0bb9\u0bbe \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0b85\u1fb7\u0ba4\u0ba9\u0b95\u1fbf\u0bb2 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a\n\n\u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf, \u0b87\u0bb2. 321 - \u0b95\u0bb2\u0bc6\u0b95\u1f8a\u0bc7\u0bb9\u0ba9 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\u1f90\u1fbb, \u0b95\u0bb2\u0bc6\u0b95\u1f8a\u0bc7\u0bb9\u0ba9 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf \u0b85\u1fbf\u0bb2\u1f90\n\n\u0b85\u0ba4\u1fb9 \u0b8f\u0bc7\u0ba4\u1f94\u1fbb \u0baa\u0bbe\u0b95\u1fbb (\u0baa\u0bbf\u0bbe\u0bbf\u1fab - 03) \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0ba9\u1f90\u1fbb, 1998\u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 21\u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 11\u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u1fbd \u0ba4\u0bc8\u0bb2\u0bc8\u0bae\u0baf\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bbe\u1fbf\n\n\u0ba4\u0baf\u0bbe\u0bbe\u0bbf\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f 510752 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u1faa\u1f8c \u0b9a\u0bbe\u1fbd\u1fb8\u0ba4 \u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0baa\u1fa2\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f\u1f90\u0bae\u0bbe\u0ba9 \u0b92\u1f9e \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u1fb0\u0b95\u0bbe\u0ba9 \u0b85\u1fbf\u0bb2\u1f90 \u0b85\u0ba4\u1fbe\u1f81 \u0bc7\u0bae\u1fbe\u0baa\u1fb5\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u1fa6\u1fb0\u0b95\u0bbe\u0ba9\n\n\u0bc6\u0b9a\u0bbe\u1fb7\u0ba4\u0bbe\u1fb6\u0bc8\u0bae\u1fb0\u1f81 \u0b85\u1fbf\u0bb2\u1f90 \u0b89\u0bc8\u0b9f\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0 \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95 \u1f9c\u1fc0\u0bb3 \u0b85\u1fbf\u0bb2\u1f90 \u0b85\u1fb0\u0b95\u0bc8\u0bb1\u1f9c\u1fc0\u0bb3 \u0b8e\u0bb5\u0bc7\u0bb0\u1f94\u0bae\u0bbe\u1fc0 2025.06.23 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u1fb0\u1f81 \u1f99\u1fb9\u0ba9\u1fbd \u0b95\u0bc0\u0bc7\u0bb4 \u0bc8\u0b95\u0bc6\u0baf\u0bbe\u1fba\u0baa\u1fbb \u0b87\u1fb5\u1f8c\u1fc0\u0bb3\u0bb5\u1f9e\u1fb0\u1f81\u1fb7 \u0ba4\u0bae\u1f90\n\n\u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0bc8\u0baf\u1fb2 \u0b9a\u0bae\u1fbd\u1fba\u0baa\u0bbf\u1fb7\u0ba4\u1fbf \u0bc7\u0bb5\u1fb6\u1f8c\u0bc6\u0bae\u1fb9\u1fa0 \u0b87\u1fb7\u0ba4\u0bbe\u1fbf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb0\u0b95\u1fba\u0baa\u1f8c\u0b95\u0bbf\u1fb9\u0bb1\u1f90. \u0bc7\u0bae\u1fbe\u1f82\u0bb1\u1fba\u0baa\u1fb5\u0b9f \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u1fb0\u1f81 \u1f99\u1fb9\u0ba9\u1fbd \u0b8f\u0bc7\u0ba4\u1f94\u1fbb \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0 \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0bc8\u0baf\u1fb2 \u0b9a\u0bae\u1fbd\u1fba\u0baa\u0bbf\u1fb0\u0b95\u1fb7 \u0ba4\u0bb5\u1fa0\u0b95\u0bbf\u1fb9\u0bb1\n\n\u0b8f\u0bc7\u0ba4\u1f94\u1fbb \u0b9a\u1fb8\u0ba4\u1fbd\u1fba\u0baa\u1fb7\u0ba4\u0bbf\u1fbf, \u0b95\u0bbe\u0ba3\u0bbf\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u1fb7\u0bc8\u0ba4\u1fb7 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u0bbf\u1fba\u0baa\u0ba4\u1fbe\u1f81 \u0bae\u1fa0\u0b95\u1fb5\u0b9a\u0bbf\u0baf\u0bbf\u1fbf\u0bb2\u0bbe\u0ba4 \u0bb5\u0bbf\u0b9a\u0bbe\u0bb0\u0bc8\u0ba3\u0bc8\u0baf \u0ba8\u0b9f\u0bbe\u1fb7\u1f90\u0bb5\u0ba4\u1fbe\u1f81\u1fbb, \u0b85\u0ba4\u1fbe\u0b95\u0bbf\u0ba3\u1fb1\u0b95 \u0bc7\u0bae\u0bc7\u0bb2\u1f9c\u1fc0\u0bb3 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 14\u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u1fb9 \u0baa\u1f8a \u0b85\u0bb0\u0b9a\u0bbe\u1fb1\u0b95\n\n\u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u1fbf \u0b85\u1fb7\u0ba4\u0bc8\u0b95\u0baf \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u1f8c\u0bb5\u0ba4\u1fbe\u1f81\u1fbb \u0ba8\u0b9f\u0bb5\u1f8a\u1fb0\u0bc8\u0b95 \u0b8e\u1f8c\u1fb0\u0b95\u1fba\u0baa\u1f8c\u1fbb.\n\n\u0bc7\u0bae\u0bc7\u0bb2 \u1f81\u0bb1\u0bbf\u1fba\u1f96\u1f8c \u0bc6\u0b9a\u1fbc\u0baf\u1fba\u0baa\u1fb5\u0b9f 510752 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u1faa\u1f8c \u0b9a\u0bbe\u1fbd\u1fb8\u0ba4 \u0baa\u0b9f\u1fbb \u0b87\u0bc8\u0baf\u0baa\u0bbe\u0ba9 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bbf\u1fb9 \u0b85\u1fa4\u0bb5\u0bb2\u0b95\u1fb7\u0ba4\u0bbf\u1fbf,"
