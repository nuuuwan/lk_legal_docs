0dc4\u0ddc\u02e7\u0ddc\u0db8\u0da9\u0dca \u0d85\u0dc3\u0dca\u0dca\u0db8\u0dd3 \u0dc0\u0db1 \u0db8\u0db8, 2012 \u0d85\u0d82\u0d82\u0d9a 22 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca (\u0dc3\u0d82\u0d82\u0dc1\u0dd9\u0dcf\u0dca\u02e4\u0dca\u02ea\u0db0\u0dd2\u0dad) \u0db4\u0db1\u0dad\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0dd2\u0dad \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\ufffd 66(\u0d87) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0, \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dcf\u0dad \u0dad\u0dd4\u0dc5 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf\u0dcf \u0dc0\u0dd6 \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db4\u0dc4\u0dad \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0db1\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2/\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2, \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0dca\u200d\u0dba\u0dba \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2/\u0d8b\u0db4\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dad\u0ddd\ufffd\u0ddd\u02ea\u0dbb\u0dcf\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dda\ufffd \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0db4\u0dc5\u0db8\u0dd4 \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8 \u0db4\u0dc4\u0dad \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd\u0db8 \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4\u0dd3\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0daf\u0dd2\u0db1\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad \u0dc0\u0dda\u0dda\u0dbd\u0dcf\u0dcf\u0dc0\u0da7 \u0d91\u0dc4\u0dd2 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba\u0dda\u024f \u0daf\u0dd3 \u0d9a\u0dd0\u0dd0\u0db3\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db6\u0dc0 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2.\n\n\u0d92. \u0d91\u0dbd\u0dca. \u0d91\u0db8\u0dca. \u0d85\u0dc3\u0dca\u0db8\u0dd2, \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca, \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca;\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0, \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dcf\u0dad. 2025 \u200d\u200d \u0da2\u0dd4\u0db1\u0dd2 \u0db8\u0dc3 02 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca;\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca \u0dba\u0dcf\u0dcf\u0dbd\u0dba,\u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dcf\u0dad,\u0d9a\u0dd2\u0db1\u0dca\u0db1\u0dd2\u0dba\u0dcf\u0dcf \u0db4\u0dcf\u0dcf\u0dbb,\u0dc0\u0dbb\u0ddd\ufffd\u0ddd\u02ea\u0daf\u0dba \u0db1\u0d9c\u0dbb\u0dca,\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0dcf\u0db8\u0dbd\u0dba.\n\nIV^wd& jeks fldgi \u2013 YS% ,xld m%cd;dka;s%l iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'06'022 A\n\n\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0d85\u0db1\u0dd4 \u0d85\u0d82\u0d82\u0d9a\u0dba\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db1\u0db8\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db0\u0dd6\u0dbb\u0dba\u0db1\u0dca\n\n\u0d9a\u0dd0\u0dd0\u0db3\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0daf\u0dd2\u0db1\u0dba\n\n\u0d9a\u0dd0\u0dd0\u0db3\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc0\u0dda\u0dda\u0dbd\u0dcf\u0dcf\u0dc0\n\n\u0d9a\u0dd0\u0dd0\u0db3\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba\n\n\u0db8\u0da9\u0d9a\u0dbd\u0db4\u0dd4\u0dc0\n\n01\u0db8\u0da9\u0d9a\u0dbd\u0db4\u0dd4\u0dc0 \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2/ \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0dca\u200d\u0dba\u0dba \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\n\n2025.06.11\n\n\u0db4\u0dd9\u0dd9.\u0dc0. 09.30\n\n\u0db8\u0da9\u0d9a\u0dbd\u0db4\u0dd4\u0dc0 \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\n\n02\u0db8\u0db1\u0dca\u0db8\u0dd4\u0db1\u0dda\ufffd\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2/ \u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0db4.\u0dc0. 02.00\n\n\u0db8\u0db1\u0dca\u0db8\u0dd4\u0db1\u0dda\ufffd\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0(\u0d86\u0dbb\u0dba\u0db8\u0dca\u0db6\u0daf\u0dd3)\n\n03\u0d91\u0dbb\u0dcf\u0dcf\u0dc0\u0dd6\u0dbb\u0dca \u0db4\u0dad\u0dca\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2/ \u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\n\n2025.06.12\n\n\u0db4\u0dd9\u0dd9.\u0dc0. 09.30"
