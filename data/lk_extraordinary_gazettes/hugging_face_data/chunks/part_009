3 27 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 2360/22 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2\u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0dc4 2024 \u0db4\u0dd9\u0dd9\u0db6\u0dbb\u0dc0\u0dcf\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 13 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 2371/13 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2\u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf 2023 \u0d85\u0d82\u0d82\u0d9a 3 \u0daf\u0dbb\u0db1 \u0dc3\u0dcf\u0dcf\u0db8\u0daf\u0dcf\u0dcf\u0db1 \u0dc0\u0dd2\u0db1\u0dd2\u0dc1\u0dca\u0dca\u0da0\u0dba\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0db1\u0dca (\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0d85\u0dad\u0dca\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dd3\u0db8, \u0d85\u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0d86\u0da0\u0dcf\u0dcf\u0dbb\u0db0\u0dbb\u0dca\u0db8 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2\u0dba) \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c, \u0d91\u0d9a\u0dd3 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c \u0dba\u0da7\u0dad\u0dda\u01ae \u0daf\u0dd0\u0dd0\u0db1\u0da7\u0db8\u0dad\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0d92 \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d9a\u0dd2\u0dc3\u0dd2\u0dc0\u0d9a\u0da7 \u0d85\u0d9c\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2, \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0dd0\u0da9\u0dd2\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229 :-\n\nI \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3 : (I) \u0da1\u200d\u0dd9\u0dd9\ufffd\u0daf\u0dba - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.06.042 A\n\n(1) \u0d91\u0dc4\u0dd2 2 \u0dc0\u0db1 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dba\u0dda\u024f -\n\n(\u0d85) \"\u0dc3\u0dcf\u0dcf\u0db8\u0daf\u0dcf\u0dcf\u0db1 \u0dc0\u0dd2\u0db1\u0dd2\u0dc1\u0dca\u0dca\u0da0\u0dba\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0d9a\u0dd4 \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf\" \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \"\u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dca\n\n\u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc3\u0dcf\u0dcf\u0db8\u0daf\u0dcf\u0dcf\u0db1 \u0dc0\u0dd2\u0db1\u0dd2\u0dc1\u0dca\u0dca\u0da0\u0dba\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0d9a\u0dd4 \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf\" \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca;\n\n(\u0d86) (\u0d86) \u0da1\u0dda\u0dda\u0daf\u0dba \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dbb \u0d92 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3 \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca :-\n\n\"(\u0d86) \u0dc0\u0dba\u0dc3 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dad\u0dd2\u0dc4\u0da7 \u0db1\u0ddc\ufffd\u0ddc\u0d85\u0da9\u0dd4 \u0dc3\u0dc4 \u0dc0\u0dba\u0dc3 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dc4\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0dd1\u0dd1 \u0db4\u0dc4\u0da7 \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0dd0\u0dd0\u0da9\u0dd2 \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0dc0\u0dd3\u0db8,\";\n\n(\u0d87) (\u0d91) \u0da1\u0dda\u0dda\u0daf\u0dba \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dbb \u0d92 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3 \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca :-\n\n\"(\u0d91) \u0d91\u0d9a\u0dca \u0dc0\u0dcf\u0dcf\u0dbb\u0dba\u0d9a \u0daf\u0dd3 \u0d85.\u0db4\u0ddc\ufffd\u0ddc.\u0dc3. \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0db1\u0dca\u200d\u0dba\u0dba \u0db4\u0dd9\u0dd9\u0dc5 \u0dc0\u0dd2\u0db7\u0dcf\u0dcf\u0d9c\u0dba\u0dda\u024f \u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbd \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0daf\u0db8\u0dd2\u0dc5 \u0db7\u0dcf\u0dcf\u0dc2\u0dcf\u0dcf\u0dc0\u0da7 \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0dcf\u0db1 \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0dae\u0dba\u0d9a\u0dca \u0daf \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0d95\u0db1\u0dd1\u0dd1\u0db8 \u0dc0\u0dd2\u0dc2\u0dba\u0d9a\u0da7 \u0dad\u0dc0\u0dad\u0dca \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0dcf\u0db1 \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0dae\u0dba\u0d9a\u0dca \u0daf \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0dcf\u0db1 \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0dae \u0daf\u0dd9\u0dd9\u0d9a\u0d9a\u0dca \u0dc3\u0db8\u0d9f \u0dc0\u0dd2\u0dc2\u0dba\u0db1\u0dca \u0dc4\u0dba\u0d9a\u0dca \u0dc3\u0db8\u0dad\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0dc0\u0dd3\u0db8; \u0dc3\u0dc4\";"
