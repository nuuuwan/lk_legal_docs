    "chunk_text": "\u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dc0 \u0d8b\u0dad\u0dd4\u0dbb \u0dc3\u0dbb\ufffd\u0ddd\ufffd\u0da2\u0dcf\u0daf\u0dda\u0dc0\u0dd2 \u0d9a\u0dab\u0dda\u0dc3\u0daf\u0dcf\u0dc3\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0dbb\u0dcf\u0da2\u0db8\u0db1\u0dd2 \u0dc3\u0dd9\u0dbd\u0dca\u0dc0\u0db8\u0dbd\u0dbb\u0dca (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2) \u0daf\u0dd4\u0dbb\u0dd9\u0dba\u0dd2\u0dbb\u0dcf\u0dc3\u0dcf \u0dad\u0db8\u0dd2\u0dbd\u0dca\u0da0\u0dca\u0da0\u0dd9\u0dbd\u0dca\u0dc0\u0db8\u0dca \u0dc3\u0dd2\u0db1\u0dca\u0db1\u0dbb\u0dcf\u0dc3\u0dcf \u0d8b\u0daf\u0dba\u0dbb\u0dcf\u0dab\u0dd2 \u0d89\u0dbd\u0d82\u0d9c\u0db1\u0dcf\u0daf\u0db1\u0dca \u0dc3\u0db1\u0dd4\u0da2\u0db1\u0dca \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0dbd\u0dad\u0dcf \u0daf\u0db8\u0dca\u0db8\u0dd4\u0dbd\u0dca\u0dbd\u0dda \u0dc3\u0dd2\u0dbb\u0dd2\u0db4\u0dcf\u0dbd \u0dbb\u0dcf\u0da2\u0d9a\u0dbb\u0dd4\u0dab\u0dcf \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0db1\u0dd2\u0dc1\u0dcf\u0db1\u0dca\u0dad \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0dbb\u0dcf\u0da2\u0d9a\u0dbb\u0dd4\u0dab\u0dcf \u0db1\u0db8\u0dca\u0db8\u0dd4\u0db1\u0dd2 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0dc4\ufffd\u0dda\u0dc0\u0dcf \u0dc0\u0dd0\u0dbd\u0dca\u0dc4\u0dda\u0db1\u0d9c\u0dda \u0db4\u0dcf\u0dbd\u0dd2\u0dad \u0dc0\u0dd3\u0dbb\u0dbb\u0dad\u0dca\u0db1\n\n\u0dad\ufffd\u0ddd\ufffd\u0dbb\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0dad\ufffd\u0ddd\ufffd\u0dbb\u0dcf \u0d91\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\n\n\u0dc3\u0dcf\u0dbd\u0dd2 \u0dc3\u0dbb\u0dcf\u0da2\u0dd3\u0db1\u0dca \u0d85\u0db6\u0dd4\u0dbd\u0dca \u0dc4\u0dc3\u0db1\u0dca \u0dc3\u0dc6\u0dca\u0dbb\u0dd6\u0dc3\