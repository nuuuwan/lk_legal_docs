9 \u0b85\u0bae\u0bc1\u0ba3\u0bc1\u0ba4\u0bc6\u0ba9\u0bcd\u0ba9 \u0b95\ufffd\u0bca\u0ba4\u0bb2\u0bbe\u0bb5\u0bb2 \u0b85\u0baa\u0bcd\u0baa\u0bc1\u0bb9\u0bbe\u0bae\u0bbf\u0bb2\u0bbe\u0b95\u0bc7 \u0bae\u0bbf\u0ba4\u0bc1\u0ba9\u0bcd \u0b9a\u0bb5\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1 10 \u0bb9\u0baa\u0bc1\u0b95\u0bb8\u0bcd\u0ba4\u0bc6\u0ba9\u0bcd\u0ba9 \u0b9a\u0ba9\u0bcd\u0bae\u0bc1\u0b95\u0bae\u0bcd \u0b9c\u0baf\u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 11 \u0bb0\u0ba4\u0bcd\u0b95\u0bae \u0b95\u0bb2\u0bcd\u0bb2\u0bc6\u0ba9\u0bb2\u0bbe\u0b95\u0bc7 \u0b85\u0ba9\u0bc1\u0bb0 \u0baa\u0bbf\u0bb0\u0baa\u0bbe\u0ba4\u0bcd \u0b85\u0bae\u0bb0\u0bb5\u0b99\u0bcd\u0bb8 12 \u0b8e\u0bae\u0bcd\u0baa\u0bc1\u0bb2\u0bcd\u0ba4\u0bc6\u0ba9\u0bbf\u0baf \u0baa\ufffd\u0bcb\u0ba4\u0bc1\u0b99\u0bcd\u0b95\u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0bb2\u0bbe\u0b95\u0bc7 \u0bb2\u0bb2\u0bbf\u0ba4\u0bcd 13 \u0bae\u0bb2\u0b99\u0bcd\u0b95\u0bae \u0bb2\u0baa\u0bc1\u0ba4\u0bb2 \u0bb5\u0bb2\u0bb5\u0bcd\u0bb5\u0bc7 \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9 14 \u0b85\u0bae\u0bc1\u0ba4\u0bbe\u0b95\ufffd\u0bca\u0b9f \u0b85\u0bae\u0bcd\u0baa\u0bb2\u0ba9\u0bcd\u0b95\u0bca\u0b9f\u0b95\u0bc7 \u0baa\u0bbf\u0bb0\u0b9a\u0ba9\u0bcd\u0ba9 \u0bae\u0b99\u0bcd\u0b95\u0bb2 \u0b9a\u0bbf\u0bb2\u0bcd\u0bb5\u0bbe 15 \u0b95\u0bb9\u0ba9\u0bcd\u0b95\u0bae \u0ba8\u0bc7\u0baa\u0b9f \u0bae\u0bc1\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bb2\u0bbe\u0b95\u0bc7 \u0bb0\u0b9a\u0bbf\u0b95\u0bbe \u0baa\u0bbf\u0bb0\u0bbf\u0baf\u0ba8\u0bcd\u0ba4\u0bbf 16 \u0b95\u0bc6\u0b9f\u0bb2\u0bbf\u0baf\u0ba9\u0bcd\u0baa\u0bb2\u0bcd\u0bb2 \u0b88\u0bb7\u0bcd\u0bb5\u0bb0\u0b95\u0bc7 \u0b95\u0bbe\u0bae\u0bbf\u0ba3\u0bc0 17 \u0b8e\u0ba4\u0bcd\u0b92\u0baf \u0b9a\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bbe\u0bb2\u0bbe\u0b95\u0bc7 \u0bb5\u0b9a\u0ba8\u0bcd\u0ba4 18 \u0b8e\u0b95\ufffd\u0bca\u0b9f \u0bae\u0bb2\u0bcd\u0bb5\u0bb2 \u0baa\u0bc6\u0bb2\u0bcd\u0bb2\u0ba9\u0bcd \u0b95\u0bae\u0b95\u0bc7 \u0bb2\u0bc6\u0bb8\u0bcd\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0b9a\u0bc6\u0b