    "chunk_text": "\u0baf\u0bbe\u0bb4\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0ba3\u0bae\u0bcd\u0baf\u0bbe\u0bb4\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0ba3\u0bae\u0bcd \u0baf\u0bbe\u0bb4\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0ba3\u0bae\u0bcd 01 \u0bb5\u0ba3\u0bcd\u0ba3\u0bbe\u0bb0\u0bcd\u0baa\u0ba3\u0bcd\u0ba3\u0bc8 \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 \u0b9a\u0bc1\u0bb5\u0bc0\u0b95\u0bb0\u0ba9\u0bcd \u0ba8\u0bbf\u0bb7\u0bbe\u0ba8\u0bcd\u0ba4\u0ba9\u0bcd \u0bae\u0bbe\u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8 02 \u0b95\u0ba8\u0bcd\u0ba4\u0bb0\u0bcd\u0bae\u0b9f\u0bae\u0bcd \u0bb5\u0b9f\u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bc1 \u0baa\u0bb0\u0bae\u0bb2\u0bbf\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0ba4\u0bb0\u0bcd\u0b9a\u0bbe\u0ba9\u0ba8\u0bcd\u0ba4\u0bcd 03 \u0b95\u0ba8\u0bcd\u0ba4\u0bb0\u0bcd\u0bae\u0b9f\u0bae\u0bcd \u0bb5\u0b9f\u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0bc1\u0bb0\u0bc8\u0b9a\u0bbf\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0baf\ufffd\u0bcb\u0b95\u0bb0\u0bbe\u0b9a\u0bbe 04 \u0ba8\u0bb2\u0bcd\u0bb2\u0bc2\u0bb0\u0bcd \u0b87\u0bb0\u0bbe\u0b9a\u0ba4\u0bbe\u0ba9\u0bbf \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0b9a\u0bc7\u0b95\u0bb0\u0bae\u0bcd \u0b87\u0bb0\u0bbe\u0b9c\u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 05 \u0b9a\u0b99\u0bcd\u0b95\u0bbf\u0bb2\u0bbf\u0baf\u0ba9\u0bcd \u0ba4\ufffd\u0bcb\u0baa\u0bcd\u0baa\u0bc1 \u0bae\u0ba4\u0bbf\u0bb5\u0ba4\u0ba9\u0bbf \u0bb5\u0bbf\u200d\u0bb5\u0bc7\u0b95\u0bbe\u0ba9\u0ba8\u0bcd\u0ba4\u0bb0\u0bbe\u0b9a\u0bbe 06 \u0b85\u0bb0\u0bbf\u0baf\u0bbe\u0bb2\u0bc8 \u0ba4\u0bbf\u0bb2\u0b95\u0bc7\u0bb8\u0bcd\u0bb5\u0bb0\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bc0\u0baa\u0bcd 07 \u0b95\u0bb2\u0bc8\u0bae\u0b95\u0bb3\u0bcd \u0ba8\u0bbe\u0b95\u0bb2\u0bbf\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0b95\u0bc1\u0bae\u0ba3\u0ba4\u0bbe\u0b9a\u0ba9\u0bcd 08 \u0b95\u0ba8\u0bcd\u0ba4\u0bb0\u0bcd\u0bae\u0b9f\u0bae\u0bcd \u0ba4\u0bc6\u0bb1\u0bcd\u0b95\u0bc1 \u0b9a\u0bbe\u0bae\u0bcd\u0baa\u0b9a\u0bbf\u0bb5\u0bae\u0bcd \u0b9a\u0bbe\u0ba8\u0bcd\u0ba4\u0bb0\u0bc2\u0baa\u0ba9\u0bcd 09 \u0b90\u0baf\u0ba9\u0bbe\u0bb0\u0bcd \u0b95\ufffd\u0bcb\u0baf\u0bbf\u0bb2\u0b9f\u0bbf \u0ba8\u0b95\u0bc1\u0bb2\u0bc7\u0bb8\u0bcd\u0bb5\u0bb0\u0bbf \u0b87\u0bb0\u0bbe\u0bae\u0b9a\u0bcd\u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0ba9\u0bcd 10 \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0b9a\ufffd\u0bcb\u0ba9\u0b95\u0ba4\u0bcd\u0ba4\u0bc6\u0bb0\u0bc1 \u0b9a\u0bc7\u0ba4\u0bc1\u0b95\u0bbe\u0bb5\u0bb2\u0bb0\u0bcd \u0bae\u0ba4\u0bc1\u0b9a\u0bbf\u0b95\u0bbe\u0ba9\u0bcd 11 \u0ba8\u0bbe\u0bb5\u0bbe\u0ba8\u0bcd\u0ba4\u0bc1\u0bb1\u0bc8 \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0ba9\u0bcd\u0bb0\u0ba9\u0bbf \u0b85\u0ba9\u0bcd\u0bb0\u0ba9\u0bcd \u0b9a\u0bbe\u0bb3\u0bcd\u0bb8\u0bcd 12 \u0ba8\u0bbe\u0bb5\u0bbe\u0ba8\u0bcd\u0ba4\u0bc1\u0bb1\u0bc8 \u0ba4\u0bc6\u0bb1\u0bcd\u0b95\u0bc1 \u0ba8\u0bc0\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bbe\u0baa\u0bcd\u0baa\u0bbf\u0bb3\u0bcd\u0bb3\u0bc8 \u0baa\u0bbf\u0bb2\u0bbf\u0baa\u0bcd 13 \u0baa\u0bb4\u0bc8\u0baf \u0b9a\ufffd\u0bcb\u0ba9\u0b95\u0ba4\u0bcd \u0ba4\u0bc6\u0bb0\u0bc1 \u0ba8\u0bc6\u0baf\u0bcd\u0ba9\u0bbe\u0bae\u0bc1\u0b95\u0bae\u0b9f\u0bcd \u0b85\u0baa\u0bcd\u0ba4\u0bc1\u0bb2\u0bcd\u0bb2\u0bbe 14 \u0baa\u0bc6\u0bb0\u0bbf\u0baf \u0b95\u0b9f\u0bc8 \u0bb5\u0bbf\u0b9c\u0baf\u0b9a\u0bbf\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0ba4\u0baf\u0bbe\u0baa\u0bb0\u0ba9\u0bcd 15 \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0b9f\u0bbf \u0b95\u0bbf\u0bb0\u0bc1\u0bb8\u0bcd\u0ba3\u0ba9\u0bcd \u0bb5\u0bbf\u0b9c\u0baf\u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 16 \u0b9a\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bbf \u0bae\u0bb0\u0bc1\u0ba4\u0b9f\u0bbf \u0b95\u0ba9\u0b95\u0bc8\u0baf\u0bbe \u0bb8\u0bcd\u0bb0\u0bc0 \u0b95\u0bbf\u0bb0\u0bc1\u0bb7\u0bcd\u0ba3\u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 17 \u0b85\u0bb0\u0bbf\u0baf\u0bbe\u0bb2\u0bc8 \u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bc1 \u0b9a\u0ba3\u0bcd\u0bae\u0bc1\u0b95\u0ba8\u0bbe\u0ba4\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bc0\u0baa\u0ba9\u0bcd 18 \u0b95\ufffd\u0bca\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb1\u0bc8 \u0b85\u0ba9\u0bcd\u0ba9\u0bb2\u0bbf\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0baa\u0bbf\u0b99\u0bcd\u0b95\u0bb3\u0ba9\u0bcd 19 \u0baa\u0bbe\u0b9a\u0bc8\u0baf\u0bc2\u0bb0\u0bcd \u0b95\u0bbf\u0bb1\u0bc7\u0bb7\u0bbf\u0baf\u0ba9\u0bcd \u0bb1\ufffd\u0bca\u0baa\u0bc7\u0b9f\u0bcd \u0b9c\ufffd\u0bca\u0ba9\u0bbf \u0ba4\u0ba9\u0bc1\u0bb8\u0bcd\u0bb0\u0ba9\u0bcd 20 \u0b88\u0b9a\u0bcd\u0b9a\u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bc8 \u0b9c\u0bc6\u0b95\u0ba4\u0bc0\u0bb8\u0bcd\u0bb5\u0bb0\u0ba9\u0bcd \u0bae\u0baf\u0bc2\u0bb0\u0ba9\u0bcd 21 \u0b95\u0ba4\u0bc0\u0b9f\u0bcd\u0bb0\u0bb2\u0bcd \u0b87\u0bae\u0bcd\u0bae\u0bbe\u0ba9\u0bc1\u0bb5\u0bb2\u0bcd \u0ba4\u0baf\u0bbe\u0bb3\u0ba9\u0bcd 22 \u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0b95\u0bb0\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0bbe \u0bb2\u0bc6\u0ba9\u0bbe\u0b9f\u0bcd 23 \u0b95\u0bc1\u0bb0\u0bc1\u0ba8\u0b95\u0bb0\u0bcd \u0b85\u0bb0\u0bc1\u0bb3\u0baa\u0bcd\u0baa\u0bc1 \u0bb1\ufffd\u0bca\u0baa\u0bbf\u0ba9\u0bcd\u0b9a\u0ba9\u0bcd 24 \u0baf\u0bbe\u0bb4\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0ba3\u0bae\u0bcd \u0ba8\u0b95\u0bb0\u0bae\u0bcd \u0b87\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bae\u0bcd \u0b9c\u0bc7\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0b9c\u0bc6\u0baf\u0bb0\u0bc6\u0b9f\u0bcd\u0b9f\u0bbf\u0ba9\u0bae\u0bcd 25 \u0b95\ufffd\u0bca\u0b9f\u0bcd\u0b9f\u0b9f\u0bbf - \u0b95\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bc8 \u0b9a\u0bbf\u0bb1\u0bc0\u0bb0\u0bbe\u0b9c\u0baa\u0bc1\u0bb2\u0bc7\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0ba9\u0bcd \u0b9a\u0bbe\u0bb0\u0bc2\u0baa\u0ba9\u0bcd 26 \u0bb0\u0bc6\u0b95\u0bcd\u0b95\u0bbf\u0bb3\u0bae\u0bc7\u0b9a\u0ba9\u0bcd \u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bb0\u0bcd\u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bcd \u0b9a\u0bc1\u0bb1\u0bc7\u0ba9\u0bcd 27 \u0bb0\u0bc6\u0b95\u0bcd\u0b95\u0bbf\u0bb3\u0bae\u0bc7\u0b9a\u0ba9\u0bcd \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0b95\u0bbf\u0bb1\u0b95\ufffd\u0bcb\u0bb0\u0bbf \u0b85\u0ba9\u0bcd\u0bb0\u0ba9\u0bbf \u200d\u0baf\u0bc7\u0b9a\u0bc1\u0bb0\u0bbe\u0b9a\u0bbe\n\n\u0ba4\u0bc6\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\