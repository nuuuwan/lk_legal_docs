dd9\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0db1 \u0db6\u0dc0 \u0db8\u0dd9\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dda.\n\n\u0d86\u0dbb\u0dca. \u0d91\u0db8\u0dca. \u0d92. \u0d91\u0dbd\u0dca. \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a, \u0d91\u0db8\u0dca. \u0d92. \u0db4\u0dd3. \u0dc3\u0dd3. \u0db4\u0dd9\u0dbb\u0dda\u0dbb\u0dcf, \u0d85\u0db8\u0dd3\u0dbb\u0dca \u0dc6\u0dcf\u0dba\u0dd2\u0dc3\u0dca, \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2, \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a, \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a, \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0. \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0. \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0.\n\n\u0d92. \u0dc2\u0db1\u0dca\u0db8\u0dd4\u0d9c\u0db1\u0dcf\u0daf\u0db1\u0dca, \u0db8\u0dc4\u0dcf\u0da0\u0dcf\u0dbb\u0dca\u0dba \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0db8\u0db1\u0dca \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a, \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a, \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a, \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0. \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0.\n\n2025 \u0db8\u0dd0\u0dba\u0dd2 \u0db8\u0dc3 31 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba,\u0dc3\u0dbb\u0dab \u0db8\u0dcf\u0dc0\u0dad,\u0dbb\u0dcf\u0da2\u0d9c\u0dd2\u0dbb\u0dd2\u0dba.\n\n\u0db8\u0dd9\u0db8 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba www.documents.gov.lk \u0dc0\u0dd9\u0db6\u0dca \u0d85\u0d