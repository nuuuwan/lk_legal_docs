dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d9a\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3 \u0d85\u0d82\u0d9a\u0dba \u0dad\u02d4\u0ddd\ufffd\u0dbb\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0db1\u0db8 \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda \u0db1\u0db8 \u0dc3\u0dc4 \u0db1\u0db8\n\n\u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd(\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\n\u0d8b\u0db4\u0dbd\u0dda\u0d9b\u0db1\u0dba\n\n\u0d9c\u0dd2\u0dbb\u0dd2\u0db6\u0dcf\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0(\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2)\n\n\u0dc0\u0db1\u0dca\u0db1\u0dd2\u0db1\u0dcf\u0dba\u0d9a \u0dad\u0dd9\u0db1\u0dca\u0db1\u0d9a\ufffd\u0ddd\ufffd\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0dc3\u0db8\u0db1\u0dca \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb \u0dc0\u0dbb\u0dcf \u0dc0\u0dd0\u0dc0\n\n\u0d92\u0d9a\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0d86\u0db1\u0db1\u0dca\u0daf \u0dbb\u0dd6\u0db4\u0dc3\u0dd2\u0d82\u0dc4\n\n\u0db1\u0dd2\u0dc1\u0dca\u0dc1\u0d82\u0d9a\u0d9c\u0dda \u0db1\u0dd2\u0dbb\u0dcf\u0dc1\u0dcf \u0d8b\u0daf\u0dd4\u0dbd\u0dcf \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2 \u0db1\u0dd2\u0dc1\u0dca\u0dc1\u0d82\u0d9a\n\n\u0dad\u0dd9\u0db1\u0dca\u0db1\u0d9a\ufffd\u0ddd\ufffd\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0dc3\u0dd4\u0daf\u0dbb\u0dca\u0db8\u0dcf \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2\n\n\u0dc0\u0dcf\u0dc3\u0dbd \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \u0db1\u0dd2\u0dc3\u0d82\u0dc3\u0dbd\u0dcf \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb\n\n\u0d92\u0d9a\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf\u0d9c\u0dda \