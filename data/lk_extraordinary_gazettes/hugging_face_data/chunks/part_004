b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u0bb2\u0bcd \u0ba4\u0bb0\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b8e\u0ba9\u1f90 \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0ba4\u0bcd\u0bc8\u0ba4 \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0bc6\u0bb5\u0bb3\u0bbf\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u1f90\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd. \u0baa\u0bc0.\u0b9a\u0bc0.\u0b9f\u0bc0. \u0b9a\u0bbf\u0bc7\u0b95\u0bb0\u0bbe, \u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u1f90 \u0ba8\u0bbf\u0bb0\u0bcd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0ba8\u0bbe\u0baf\u0b95\u0bae\u0bcd. \u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u1f90 \u0ba8\u0bbf\u0bb0\u0bcd\u0ba3\u0baf\u0ba4\u0bcd \u0ba4\u0bbf\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4 \u0bc6\u0bae\u1f90\u0bb0\u201d, \u0b87\u0bb0\u0b9c\u0bae\u0bb2\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4 \u1faa\u0ba4\u0bbf, \u0baa\u0ba4\u0bcd\u0ba4\u0bb0\u1f99\u0bb2\u0bcd\u0bc8\u0bb2, 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8c \u1f9d\u0ba9\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd 05 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf.\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3 \u0b95\u0bbe\u0ba3\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0ba4\u0bbe\u0bb3\u0bcd \u0bb5\u0bb4\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd \u0bc6\u0b9a\u0bbe\u0ba8\u0bcd\u0ba4\u0b95\u0bcd\u0b95\u0bbe\u0bb0\u0bb0\u0bcd/ \u0bc6\u0b9a\u0bbe\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u1f90\u0b95\u0bcd\u0b95\u0bc1\u0bbe\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u1f90 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1f9e\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd \u0b95\u0bbe\u0bb0\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u1f99\u1fa8\u0baa\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd\u0b95\u1fa6\u0bae\u0bcd \u0b85\u0bc8\u0b9f\u0baf\u0bbe\u0bb3 \u0b87\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97\u0bae\u0bcd \u0b88\u1f8c, \u0b95\u0bc1\u0ba4\u0bcd \u0b95\u0bc1\u0bbe\u0bbf\u0baf \u0b9a\u0b9f\u0bcd\u0b9f\u0b99\u0bcd \u1f90\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd (\u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd) \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u1f9c\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0bc8\u0b9f \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd \u0b87\u0baf\u0bb2\u0bcd\u1f97\u0bae\u0bcd \u0ba4\u0bc8\u0b95 \u0b95\u1fa6\u0bb3\u0bcd \u0b8e\u0bb5\u0bcd \u0b87\u0bb2. \u0b87\u0bb2. \u0ba4\u1f8c\u0baa\u0bcd\u1f97\u0b95\u0bcd \u0bb5\u0bc8\u0b95\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3 \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u0ba4\u0bbf\u1f9e\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0baa\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bb3\u0bcd\n\n2:2 0.6206 \u0b85\u0bb0\u0b9a\u0bc1 \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0b86\u0bae\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 _ _\n\n2:6 0.0506 \u0b85\u0bb0\u0b9a\u0bc1 \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0b86\u0bae\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 _ _\n\n2:7 0.0498 \u0b85\u0bb0\u0b9a\u0bc1 \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0b86\u0bae\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 _ _\n\n2:8 0.1181 \u0b85\u0bb0\u0b9a\u0bc1 \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0b86\u0bae\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 _ _\n\n2:18 0.0398 \u0b85\u0bb0\u0b9a\u0bc1 \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0b86\u0bae\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 _ _\n\n2:49 0.0506 \u0b85\u0bb0\u0b9a\u0bc1 \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0b86\u0bae\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 _ _\n\n2:95 0.0144 \u0b85\u0bb0\u0b9a\u0