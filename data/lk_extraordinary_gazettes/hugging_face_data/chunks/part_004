u0d9a\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dae\u0db8\u0dd2\u0d9a \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0dbd\u0dd9\ufffd\u0dc3 \u0dc3\u0dd0\u0dd0\u0dbd\u0d9a\u0dd3\u0db8\u0da7 \u0dc4\u0dda\ufffd\u0dda\u0dad\u0dd4 \u0db8\u0dd9\ufffd\u0dc4\u0dd2 II \u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u024f \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0db1 \u0db6\u0dc0\u0da7\u0dad\u0dca; (\u0d87) \u0db4\u0db1\u0dad\u0dca \u0dba\u0da7\u0dad\u0dda\u01ae \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dcf\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0daf\u0dd2\u0dbb\u0dd2\u0d9c\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0db8\u0dd9\ufffd\u0dc4\u0dd2 III \u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u024f \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\u0da7\u0dad\u0dca; \u0dc3\u0dc4\n\n(\u0d88) \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db4\u0db1\u0dad\u0dca \u0dba\u0da7\u0dad\u0dda\u01ae \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dcf\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0daf\u0dd2\u0dbb\u0dd2\u0d9c\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0db8\u0dd9\ufffd\u0dc4\u0dd2 IV \u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u024f \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0daf\u0dd2\u0db1\u0dc0\u0dbd \u0daf\u0dd3 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\u0da7 \u0dc3\u0dc4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd3\u0db8 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\u0da7\u0dad\u0dca,\n\n\u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n\u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a, \u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba.\n\n2025 \u0da2\u0dd6\u0dbd\u0dd2 \u0db8\u0dc3 12 \u0dc0\u0db1 \u0daf\u0dd2\u0db1,\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0daf\u0dd3 \u0dba.\n\n2A I fldgi: (I) fPoh - Y%S ,xld m%cd;dka;%sl iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'07'14\n\nI \u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\n\n\u0d9a\u0dca\u200d\u0dbb\u0db8\u0ddd\ufffd\u0ddd\u02ea\u0db4\u0dcf\u0dcf\u0dba \u0dc0\u0dd0\u0dd0\u0daf\u0d9c\u0dad\u0dca\u0d9a\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0dbd\u0dd9\u02e2\u0dc3 \u0db1\u0db8\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dba\u0dda\u024f \u0dc0\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dbb\n\n1. \u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0db8:ICC Port City (Private) Limited.\n\n2. \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d82\u0d9a\u0dba:2501150108\n\n3. \u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db6\u0d