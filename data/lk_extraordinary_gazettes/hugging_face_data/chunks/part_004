b9f \u0bb5\u0bb4\u0b95\u0bcd\u0b95\u0732\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd \u0736\u0b9a\u0731\u0ba8\u0bcd\u0ba4\u0b95\u0bcd\u0b95\u0731\u0bb0\u0bb0\u0bcd/ \u0736\u0b9a\u0731\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0737\u0ba4\u0b9a\u0732\u0baf \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0731\u0732\u0baf \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0ba4\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba9\u0732\u0baf\u0731\u0bb0\u0bc1\u0b95\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0b95\u0731\u0bb0\u0bb0\u0bcd\u0b95\u0bb3\u0732\u0ba9\u0bcd \u0bae\u0bc1\u0bb4\u0bc1\u0baa\u0bcd \u0736\u0baa\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0b85\u0738\u0b9f\u0baf\u0731\u0bb3 \u0b87\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bae\u0bcd \u0b88\u0b9f\u0bc1, \u0b95\u0bc1\u0ba4\u0bcd \u0b95\u0bc1\u0731\u0732\u0baf \u0b9a\u0b9f\u0bcd\u0b9f\u0b99\u0bcd \u0b87\u0bb2. (\u0736\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0731\u0bb0\u0bcd) \u0bae\u0bc1\u0b95\u0bb5\u0731\u0732\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0738\u0b9f \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd \u0b87\u0baf\u0bb2\u0bcd\u0baa\u0bc1\u0bae\u0bcd \u0ba4\u0738\u0b95 \u0b95\u0bb3\u0bc1\u0bb3\u0bcd \u0b8e\u0bb5\u0bcd \u0b87\u0bb2. \u0ba4\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd \u0bb5\u0738\u0b95\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0738\u0bb3 \u0b85\u0738\u0bae\u0ba8\u0bcd\u0ba4\u0732\u0bb0\u0bc1\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0732\u0baf \u0baa\u0732\u0ba9\u0bcd \u0bb5\u0732\u0baa\u0bb0\u0b99\u0bcd \u0bb5\u0732\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bb3\u0bcd 1:74 0.1086 \u0ba4\u0732\u0bb7\u0731\u0ba8\u0731\u0baf\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0ba4\u0732\u0baf\u0ba9\u0bcd\u0737\u0b9a\u0bb2\u0731\u0737\u0b95 742931544V \u0bae\u0bc1\u0bb4\u0bc1\u0bb5\u0ba4\u0bc1\u0bae\u0bcd 1\u0bae\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1 _ _\n\n\u0bb9\u0b99\u0bcd\u0bb7 \u0bb5\u0bb0\u0bc1\u0ba3 \u0ba4\u0732\u0bb7\u0731\u0ba8\u0731\u0baf\u0b95\u0bcd\u0b95\n\n\u0b8e\u0bb3\u0732\u0baa\u0732\u0b9a\u0bcd\u0b9a\u0732\u0baf, \u0b8e\u0bb3\u0732\u0baa\u0732\u0b9a\u0bcd\u0b9a\u0732\u0baf. EOG 07 - 0164/6\n\n8 A III \u02f3\u0d9a \u0dc3\u02a3\u0da7\u0dc3 - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u02e2\u02ad\u0d9a \u0dc3\u02eb \u200d\u0dbb\u0dcf\u02eb\u02d4\u02eb\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3 \u0dc3\u0db8\u02eb\u0dcf\u02e3\u02eb \u0da2 \u0dcf\u0da2\u0dba\u0dcf\u02f3\u024f \u0dd2 \u0dc0 \u0dc1\u0dd9\u02f3\u02e4\u0d9c \u02c3\u02ec\u0dc3 \u0db4 \u0dca\u200d\u0dbb\u02e0 - 2025.07.15\n\n\u0baa\u0b95\u0bc1\u0ba4\u0732 III - \u0b87\u0bb2\u0b99\u0bcd\u0738\u0b95\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0731\u0baf\u0b95 \u0737\u0b9a\u0731\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bb0\u0b9a\u0bc1 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0731\u0ba9\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0732\u0731\u0732\u0738\u0b95 - \u0b85\u0ba4\u0732 \u0bb5\u0732\u0737\u0b9a\u0bb7\u0bae\u0731\u0ba9\u0ba4\u0bc1 - 2025.07.15\n\n\u0b87\u0bb2\u0b99\u0bcd\u0738\u0b95 \u0b85\u0bb0\u0b9a\u0731\u0b99\u0bcd\u0b95 \u0b85\u0b9a\u0bcd\u0b9a\u0bc1\u0ba4\u0bcd \u0ba4\u0732\u0738\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0baa\u0ba4\u0732\u0baa\u0bcd\u0baa\u0732\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0736\u0baa\u0bb1\u0bcd\u0bb1\u0ba4\u0bc1.\n\n1998 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0732\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\n\n14 \u0b86\u0bae\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bcd \u0b95\u0733\u0bb4\u0bcd \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba8\u0732\u0bb0\u0bcd\u0ba3\u0baf \u0b86\u0738\u0ba3\u0baf\u0731\u0bb3\u0731\u0732\u0ba9