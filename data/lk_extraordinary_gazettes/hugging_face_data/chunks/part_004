d89\u0daf\u0dd2 \u0db4\u0dda \u0d9a\u0dc2 \u0dba\u0dd4\u0dad\u0dd4\u0dba. \u0d91\u0d9a\u0dd3 \u0daf\u0dd2\u0db1\u0da7 \u0dba\u0db4\u0dbb \u0dba \u0d9a \u0d9f\u0dd4\u0dd2\u0d9a\u0d9a \u0d9a \u0db4\u0dd1\u0db8\u0d9a\u0dca\u0d9a\u0dba \u0d89\u0daf\u0dd2 \u0db4\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd0\u0dc1\u0dd0\u0dbb \u0dc1 \u0db1\u0dd4 \u0dbc\u0dd0\u0db6\u0dd4\u0dbd\u0dba\u0dc1\u0ddc\u0dda\u0d85 \u0d92 \u0d89 \u0dba \u0d9a \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc0 \u0d9a\u0db6\u0dca\u0dad \u0dba\u0dba\u0dca\u0dad \u0d92\u0d9a \u0db4\u0dcf\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dd2\u0d9a \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0d9a\u0dba\u0dbf\u0dab\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0db4\u0dbd\u0dda\u0dbd\u0db1\u0dd4 \u0dbc\u0db6\u0db1 \u0d9a\u0dcf\u0dbb\u0d85 \u0d91\u0d9f\u0dd4 \u0daf\u0dd3 \u0d9c\u0db1\u0dd4 \u0dbc\u0db6\u0db1 \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d89\u0dc1\u0dcf \u0dc0\u0db3\u0dc1\u0dca\u0dad \u0db4\u0db1\u0dba\u0dda 14 \u0dbd\u0dd0\u0db1\u0dd2 \u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb \u0d9c\u0dd0\u0dc0\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda \u0db4\u0dc2 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbc\u0dd0\u0dba . \u0d89\u0dc1\u0dcf \u0dc0\u0db3\u0dc1\u0dca\u0dad \u0d9a\u0d82\u0d9a 120139 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0 \u0dd0\u0dc0\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0db8\u0d85 \u0d9a\u0daf\u0dcf\u0dc2 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbc \u0dcf\u0dbb\u0dd3 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbc\u0dba\u0dda \u0daf\u0dd3\u0d85 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dba \u0dba \u0db8\u0dc1 \u0dba\u0db8\u0d9a \u0d9a \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbc\u0dba\u0dda \u0daf\u0dd3\u0d85 \u0daf\u0dd2\u0dc0\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dd2\u0d9a\u0db1\u0dd4 \u0d9a \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbc\u0dba\u0dda \u0daf\u0dd3\u0d85 \u0d9f\u0dd4\u0dd2\u0d9a\u0d9a \u0d9a \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba \u0d9a \u0dba\u0d9a\u0ddc\u0db8\u0dc0\u0dcf \u0dc0\u0dca\u0dbd\u0dbb\u0dba\u0dcf\u0dba\u0dda \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbc\u0dba\u0dda \u0daf\u0dd3\u0d85 \u0dba\u0dc1\u0ddd \u0dd2\u0d9a\u0db1\u0dd4 \u0d9a\u0db4\u0dad\u0dd2 \u0dbd\u0dbb\u0dba\u0dcf\u0dba\u0dda \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbc\u0dba\u0dda \u0daf\u0dd3 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0d9a\u0dba\u0dbf\u0dcf \u0d9a\u0dbb\u0db1\u0dd4 \u0dbc\u0dd0\u0db6\u0dd2\u0dba \u0dc1\u0dd0\u0d9a\u0dd2\u0dba. \u0dbd\u0dd0\u0da9\u0dd2 \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb\u0d85 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbc \u0dcf \u0dba\u0d9c\u0dca\u0dad\u0d85 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dba \u0dba \u0dba\u0db8\u0d9a \u0d9a\u0dbd\u0dbb\u0dba\u0dcf\u0dba\u0d9c\u0dca\u0dad\u0d85 \u0dba\u0dc1\u0ddd \u0d9f\u0dd4\u0dd2\u0d9a\u0d9a \u0d9a \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba \u0d9a \u0dba\u0d9a\u0ddc\u0db8\u0dc0\u0dcf \u0dc0\u0dca\u0dbd\u0dbb\u0dba\u0dcf\u0dba\u0d9c\u0dca\u0dad \u0dbc\u0db6\u0dcf \u0d9c\u0dcf \u0dc1\u0dd0\u0d9a\u0dd2\u0dba.\n\n\u0db4\u0dd3.\u0dc3\u0dd3.\u0da9\u0dd3. \u0dc3\u0dd2\u0dc1\u0dda\u0dbb\u0dcf, \u0d89 \u0d9a \u0d9f\u0dd4\u0dd2\u0d9a\u0d9a \u0d9a \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba \u0d9a \u0dba\u0d9a\u0ddc\u0db8\u0dc0\u0dcf \u0dc0\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0db8.\n\n2025 \u0da2\u0dd6\u0dbd\u0dd2 \u0db8\u0dc0 01 \u0dbd\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1\u0d85 \u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0db8\u0dbc \u0d85 \u0dbb\u0da2\u0dcf\u0db8\u0db8\u0dbd\u0dda\u0dcf \u0db4\u0dcf\u0dbb\u0d85 \u201c\u0dd2\u0d9a\u0d9f\u0dd4\u0d9a\u0dcf \u0db8\u0dd0\u0daf\u0dd4\u0dbb\u201d\u0d85 \u0d9a\u0d82\u0d9a 1200/6\u0d85 \u0d89 \u0d9a \u0d9f\u0dd4\u0dd2\u0d9a\u0d9a \u0d9a \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba \u0d9a \u0dba\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dcf\u0dba \u0d9a\u0dca\u0dad\u0dad\u0dd4\u0dba\u0dda \u0daf\u0dd3 \u0dba.\n\nEOG 07 - 0144/1\n\n\u0d8