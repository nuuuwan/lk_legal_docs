0b9f\u1f90\u201d \u0b8e\u1fb9\u1fa0 \u0b89\u1fc0\u0bb3\u0b9f\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c \u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fba\u0baa\u0b9f\u1fbf \u0bc7\u0bb5\u1fb6\u1f8c\u1fbb. \u1f96.\u0b9a\u0bc0.\u1f8b. \u0b9a\u0bbf\u0bc7\u0b95\u0bb0\u0bbe, \u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd \u0ba8\u0bbe\u0baf\u0b95\u1fbb.\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fbb,\n\n\u0b87\u0bb2. 1200/6, \u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4 \u0bc6\u0bae\u1f90\u0bb0\u201d, \u0b87\u0bb0\u0b9c\u0bae\u1fbf\u0bb5\u1fb7\u0ba4 \u1faa\u0ba4\u0bbf, \u0baa\u1fb7\u0ba4\u0bb0\u1f99\u1fbf\u0bc8\u0bb2,\n\n2025 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u1f9d\u1fb9 \u0bae\u0bbe\u0ba4\u1fbb 25 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf.\n\nEOG 07 - 0119/ 2\n\n\u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fbb\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf \u0bc7\u0bae\u0bc7\u0bb2\u1f9c\u1fc0\u0bb3 \u0ba4\u0bc8\u0bb2\u1fba\u0baa\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 2019.12.24 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf 2155/11 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u0b9a\u0bbf\u1fb9 \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u1fbf \u0baa\u0bbf\u0bb0\u1f86\u0bb0\u0bae\u0bbe\u0ba9 \u0bc7\u0bae\u1fbf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u1fb7\u0ba4\u0bbf\u1fb9, \u0b95\u1fbb\u0baa\u0bb9\u0bbe \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0b85\u1fb7\u0ba4\u0ba9\u0b95\u1fbf\u0bb2 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf 448 -\n\n\u0bc7\u0b95\u0bbe\u1fb9\u0b95\u1fc4\u0bc6\u0ba4\u0ba3\u0bbf\u0baf \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u0bc7\u0b95\u0bbe\u1fb9\u0b95\u1fc4\u0bc6\u0ba4\u0ba3\u0bbf\u0baf \u0b8e\u1f94\u1fbb \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf, 510615 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 01 \u0b87\u1fbf \u0ba4\u0bbe\u1fc0 \u0b87\u0bb2. 01 \u0b87\u1fbf 135 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8a\u1fb9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b85\u1fc2\u0bb5\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf,\n\n\u201c\u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb (\u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u0bbe\u1fbd)\u201d \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0\u201d \u0b8e\u1fb9\u0bb1 \u0ba8\u0bbf\u0bb0\u1fa2\u1fbf \u201c0.0039\u201d \u0b8e\u1fb9\u0baa\u1f90 \u0ba8\u0bc0\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c \u201c0.0088\u201d \u0b8e\u1fb9\u1fa0 \u0b89\u1fc0\u0bb3\u0b9f\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\n\n\u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fba\u0baa\u0b9f\u1fbf \u0bc7\u0bb5\u1fb6\u1f8c\u1fbb. \u1f96.\u0b9a\u0bc0.\u1f8b. \u0b9a\u0bbf\u0bc7\u0b95\u0bb0\u0bbe, \u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd \u0ba8\u0bbe\u0baf\u0b95\u1fbb.\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fbb, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4 \u0bc6\u0bae\u1f90\u0bb0\u201d,\n\n\u0b87\u0bb0\u0b9c\u0bae\u1fbf\u0bb5\u1fb7\u0ba4 \u1faa\u0ba4\u0bbf, \u0baa\u1fb7\u0ba4\u0bb0\u1f99\u1fbf\u0bc8\u0bb2, 2025 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u1f9d\u1fb9 \u0bae\u0bbe\u0ba4\u1fbb 25 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf.\n\nEOG 07 - 0119/ 3\n\n3 A\n\nIII \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u2014 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba - 2025.07.11\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2014 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf\u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 - 2025.07.11\n\n\u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fbb\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf \u0bc7\u0bae\u0bc7\u0bb2\u1f9c\u1fc0\u0bb3 \u0ba4\u0bc8\u0bb2\u1fba\u0baa\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 2024.05.30 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf 2386/12 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb