0dd9\u0db1\u0db8\u0dca \u0dba\u0db4\u0dde\u0dca\u0db0\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0dd9 \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dba\u0dcf\u0dbd\u0dda\u0dc0\u0dba \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dba\u0dda/\u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0dca\u0dad\u0dba\u0dda \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d9a\u0dba\u0dd2\u0dad\u0dd2 \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0dda \u0d9a\u0dba\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dcf\u0dba\u0dc0\u0dca\u0dad \u0d87\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dda \u0dba\u0d9a\u0ddc\u0da7\u0dba\u0dc3\u0dda \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db1\u0db8/\u0db1\u0db8\u0dca \u0dc3\u0dd9 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u0dd9\u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db4\u0dda \u0d89\u0da9\u0dba\u0db8\u0dca \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dc3\u0dd9 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dd9 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dca \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0d82\u0d9a\u0dba \u0d9a\u0d82\u0d9a\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb\n\n(\u0dba\u0dd9\u0d9a\u0dca\u0d9a\u0dba\u0da7\u0dba\u0dcf\u0dbb\u0dca)\n\n1:7\u0d91 \u0dc608\u0dc694 \u0d9a\u0dd9\u0d9c\u0dbd\u0dca\u0dbd\u0dbd\u0dcf\u0dba\u0dda \u0dba\u0d9c\u0daf\u0dbb \u0dbd\u0dd3\u0dbd\u0dcf\u0dc0\u0dad\u0dd3 558171456V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0d890\u0dc3\u0d820\u0d860 \u0db4\u0db1\u0dba\u0dda \u0db4\u0dd4\u0dc3\u0dca\u0dc3\u0dd0\u0dbd\u0dca\u0dbd\u0dcf \u0d9a\u0dca\u0dad\u0daf, \u0dba\u0d9c\u0ddd\u0db1\u0d9c\u0dbd, \u0dba\u0d9a\u0ddc\u0dca\u0dad\u0dba\u0dca\u0db0\u0dc3\u0dd2\u0daf\u0dc0\u0dbd\u0da7 \u0db4\u0dc3\u0dca\u0dc3\u0dbb \u0dba\u0da7\u0dda\u0dc0\n\nEOG 07 - 0138/4\n\n\u0dc1\u0