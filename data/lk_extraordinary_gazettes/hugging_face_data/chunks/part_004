\u0dba\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3 1:59 014047 \u0dbb\u0da2\u0dcf\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9a\u0d82\u0d9a 09 \u0dba\u0da7\u0dba\u0dda \u0d9c\u0dd0\u0db8\u0dd4\u0dab\u0dd4\u0db4\u0dd4\u0dbb, \u0d87\u0dad\u0dd2\u0db8\u0dba\u0dbd\u0dca\u0dc0\u0dd0\u0dc0, \u0dba\u0db8\u0ddc\u0dab\u0dbb\u0dcf\u0d9c\u0dbd \u0dc4\u0dd2 \u0dc0\u0dd3\u0dbb\u0dba\u0d9a\u0ddd\u0dca\u0dad \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0dca\u0dad\u0dba\u0dc3\u0dda\u0dbd\u0dcf\u0dba\u0dda \u0dc3\u0dd4\u0db8\u0db1\u0dba\u0dc3\u0dda\u0d9a\u0dbb \u0db7\u0dd4\u0d9a\u0dca\u0d9a\u0dba\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3\n\n4 A III \u0dc1 \u0ddc\u0da7\u0dc3 : \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0dd2\u0d82 \u0dcf \u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2 \u0dc3\u0db8\u0dcf\u0da2\u0dcf\u0dc0\u0dcf \u0da2 \u0da2\u0dcf\u0db1\u0dbb\u0da2\u0dcf\u0dc1\u0d85 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u0dc2 \u0dc3\u0dd0\u0dc3 \u0db4 \u0db4\u200d\u0dbb\u0dba - 2025.07.11\n\n1:80 014047 \u0dbb\u0da2\u0dcf\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9a\u0d82\u0d9a 1\u0d9242D/2016/312787 \u0dba\u0da7\u0dba\u0dda \u0db4\u0dd0\u0dbb \u0dc4\u0db8\u0dca\u0db4\u0dd4\u0dbb, \u0d87\u0dad\u0dd2\u0db8\u0dba\u0dbd\u0dca\u0dc0\u0dd0\u0dc0, \u0dba\u0db8\u0ddc\u0dab\u0dbb\u0dcf\u0d9c\u0dbd\u0dc4\u0dd2 \u0dbb\u0dcf\u0da2\u0dcf\u0db4\u0d9a\u0dca\u0d9a\u0dba\u0dc2 \u0dba\u0dca\u0db0\u0dc0\u0dba\u0dbd\u0dcf\u0dba\u0dda \u0daf\u0dd3\u0db4\u0dd2\u0d9a\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dbb\u0dca\u0dba\u0db1\u0dd3 \u0db7\u0dd4\u0d9a\u0dca\u0d9a\u0dba\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3 1:84 018094 \u0dbb\u0da2\u0dcf\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u