0dcf\u0dbb\u0dd2\u0dc0\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dbd\u0dca0 2025 \u0db8\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dc0 14 \u0dbd\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbc, \u0dbb\u0da2\u0dcf\u0db8\u0dbd\u0dca\u0dbd\u0dda\u0dcf \u0db3\u0dcf\u0dbb, \"\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dcf \u0db8\u0dd0\u0daf\u0dd4\u0dbb\", \u0d9a\u0d82\u0d9a 1200/6, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dba\u0daf\u0db3\u0dcf\u0dbb\u0dca\u0dcf\u0dba\u0db8\u0dca\u0dca\u0dad\u0dad\u0dd4\u0dba\u0dda \u0daf\u0dd3 \u0dba0\n\n10 A III \u0dc1 \u0ddc\u0da7\u0dc0 : \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbc\u0dd2\u0d82 \u0dcf \u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2 \u0dc0\u0db8\u0dcf\u0da2\u0dcf\u0dbd\u0dcf \u0da2 \u0da2\u0dcf\u0db1\u0dbb\u0da2\u0dcf\u0dc1\u0d85 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dbe\u0dbf \u0dc3\u0dd0\u0dc0 \u0db4 \u0db4\u200d\u0dbb\u0dba - 2025.07.04\n\n\u0d8b\u0db4\u0dc1\u0dda\u0d9b\u0db1\u0dba\n\n(\u0dba\u0dc1\u0d9a\u0dca\u0d9a\u0dba\u0da7\u0dba\u0dcf\u0dbb\u0dca)\n\n1:29 001366 \u0db8\u0dcf\u0dbb\u0dc3\u0dd2\u0daf\u0d82\u0dc1 \u0db4\u0dd6\u0da2\u0dcf\u0dcf \u0dc1\u0dd2\u0db1\u0db1\u0dd2 \u0db0\u0dbb\u0dca\u0db8\u0d9a\u0dd3\u0dbb\u0dca\u0dad\u0dd2 199469103383 \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba \u0db8\u0dcf\u0dbb\u0dc3\u0dd2\u0daf\u0d82\u0dc1\u0dba\u0dda _ \u0dba\u0daf\u0ddc\u0dbb\u0dba \u0dba\u0dcf\u0dbd, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbc \u0db0\u0dbb\u0dca\u0db8\u0d9a\u0dd3\u0dbb\u0dca\u0dad\u0dd2 \u0dc0\u0dc1 \u0dba\u0dc1\u0dda\u0dbb\u0dda \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0dca\u0dad\u0dba\u0dc0\u0dda\u0dbc\u0dcf\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0daf\u0dd3\u0db4\u0dd2\u0d9a\u0dcf \u0db1\u0dd2\u0dbe\u0dcf\u0db1\u0dd2 \u0dba\u0dc1\u0dda\u0dbb\u0dda \u0dba\u0