\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1); \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd: 0.3995 \u0736\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0731\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: 576, 604 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 573 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd; \u0b95\u0732\u0bb4\u0b95\u0bcd\u0b95\u0bc1: 573 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 574 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd; \u0736\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: 574 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 576 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd; \u0737\u0bae\u0bb1\u0bcd\u0b95\u0bc1: 576 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1.\n\n114. \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 576 - \u0b95\u0731\u0ba3\u0732\u0baf\u0732\u0ba9\u0bcd \u0736\u0baa\u0baf\u0bb0\u0bcd: \u0ba4\u0ba9\u0bcd \u0b95\u0bb9\u0737\u0bb9\u0ba9, \u0737\u0b95\u0731\u0ba9\u0bcd\u0b95\u0bb9\u0737\u0bb9\u0ba9 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb3\u0bc1\u0ba4\u0bcd\u0b95\u0bae \u0737\u0bb9\u0ba9; \u0b89\u0731\u0732\u0738\u0bae \u0737\u0b95\u0731\u0bb0\u0bc1\u0737\u0bb5\u0731\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; (\u0baa\u0732. \u0b85\u0baa\u0bcd\u0baa\u0bc1\u0bb9\u0731\u0bae\u0732 \u0baf\u0732\u0ba9\u0731\u0bb2\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0733\u0bb1\u0732 \u0738\u0b95\u0baf\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0baa\u0baf\u0732\u0bb0\u0bcd\u0b9a\u0bcd \u0736\u0b9a\u0baf\u0bcd\u0738\u0b95 \u0736\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1); \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd: 0.7827 \u0736\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0731\u0bb0\u0bcd\n\n\u0bb5\