    "chunk_text": "\u026a\u01e7\u0dc1\u0dca\u0da0\u0dba\u01e6 \u0dc3\u0dc4 \u0dba\u023c \u026a\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u02a4 \u0db4\u01b4 \u0d85\u0d82\u0d9a\u0dba \u0d89\u01e6\u0dd9\u0da2\u01e6\u0dc2\u01e6 \u0dad\u0dc4\u0db1\u023c \u0dd9\u0db4\u02a5\u01ca\u0d9c\u0263\u0d9a \u0dc3\u0dc4 \u0d89\u0da9\u023c \u026a\u0dc1\u0dcf\u0dbd\u01ae\u0dc0\u0dba \u0d85\u0250\u01af\u0d9a\u025e\u0dd9\u0118/\u0d85\u0250\u01af\u0d9a\u025e\u0dc0\u01e6\u0dd9\u0118 \u0da2\u0dcf\u01af\u0d9a \u0d85\u0250\u01af \u0d85\u0250\u01af\u0dd9\u024f \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf\u0dd9\u0dc0\u01e6 \u0d87\u01af \u01e8\u01af\u0dba\u0d9a\u0da7 \u0dba\u0da7\u01ae \u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u0dda \u0dc3\u023c\u021b\u0259\u0dab \u0db1\u0db8/\u0db1\u023c \u0dc3\u0dc4 \u0263\u0218\u0db1\u0dba \u0dc4\u0dd0\u01ff\u01e9\u023c\u0db4\u01ae \u0d89\u0da9\u0dd9\u023c \u0db4\u01e6\u01af\u0dba \u0dc3\u0dc4 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u01fe\u023c \u0db1\u023c \u0d92 \u0218\u0298\u0db6\u0db3 \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u021d\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0218\u0298\u0db6\u0db3 \u026a\u0dc3\u0dca\u0dad\u0dbb \u026a\u0dc3\u0dca\u0dad\u0dbb\n\n(\u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259)"
