\u0dda\u0dda 99\u0d85 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0 \u0dba\u0da7\u0dad\u0dda\u01ae \u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dba\u0dd9\ufffd\u0d9a\u0dd4 \u0dbd\u0dd9\ufffd\u0dc3 \u0dad\u0ddd\u02d4\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dbd\u0daf \u0db6\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db8\u0dd4\u0dc4\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0dc3\u0dcf\u0dcf\u0dbd\u0dd2 \u0db1\u0dbd\u0dd3\u0db8\u0dca \u0db8\u0dc4\u0dad\u0dcf\u0dcf \u0d89\u0dbd\u0dca\u0dbd\u0dcf\u0dcf \u0d85\u0dc3\u0dca\u0dc0\u0dd3\u0db8 \u0dc4\u0dda\ufffd\u0dda\u0dad\u0dd4\u0d9a\u0ddc\ufffd\u0ddc\u0da7 \u0d9c\u0dd9\ufffd\u0db1 \u0daf\u0dc3\u0dc0\u0db1 \u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0db0\u0dd4\u0dbb\u0dba\u0d9a \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0dcf\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc0\u0dd3 \u0dad\u0dd2\u0db6\u0dd9\ufffd\u0db1 \u0db6\u0dc0, 1988 \u0d85\u0d82\u0d82\u0d9a 35 \u0daf\u0dbb\u0db1 \u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca (\u0dc0\u0dd2\u0dc1\u0dda\ufffd\u0dda\u0dc2 \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1) \u0db4\u0db1\u0dad\u0dda\u01ae 6 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0dd2\u0dad, 1981 \u0d85\u0d82\u0d82\u0d9a 1 \u0daf\u0dbb\u0db1 \u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0db4\u0db1\u0dad\u0dda\u01ae 64(5) \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0db8\u0dc4\u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd9\u0dd9\u0dad \u0daf\u0dd0\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd3 \u0d87\u0dad\u0dd2 \u0dc4\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0daf,\n\n\u0d91\u0d9a\u0dd3 \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0dcf\u0da9\u0dd4\u0dc0 \u0db4\u0dd4\u0dbb\u0dc0\u0db1\u0dd4 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0d91\u0d9a\u0dd3 \u0daf\u0dda\u0dda\u0dc1\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda\u024f \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0da7 \u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0d87\u0dad\u0dd2 \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0dd9\u02d4\u0d9a\u0dd4 \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0db1\u0dcf\u0dcf \u0d9a\u0dbb\u0db1 \u0dbd\u0dd9\ufffd\u0dc3 \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dc4\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0daf,\n\n\u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0daf\u0dda\u0dda\u0dc1\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda\u024f \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d91\u0db8 \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0dcf\u0da9\u0dd4\u0dc0 \u0db4\u0dd4\u0dbb\u0dc0\u0db1\u0dd4 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0db8\u0dd4\u0dc4\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0dc3\u0dbb\u0dd2\u0db4\u0dd4 \u0d85\u0db6\u0dca\u0daf\u0dd4\u0dbd\u0dca \u0dc0\u0dcf\u0dcf\u0dc4\u0dd2\u0daf\u0dca \u0db8\u0dc4\u0dad\u0dcf\u0dcf \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0db1\u0dcf\u0dcf \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dc4\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0daf,\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0daf\u0dc4\u0db1\u0dc0 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1\u0dba\u0dda\u024f \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0dc3\u0db8\u0d9f \u0d9a\u0dd2\u0dba\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 1981 \u0d85\u0d82\u0d82\u0d9a 1 \u0daf\u0dbb\u0db1 \u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0db4\u0db1\u0dad\u0dda\u01ae 64 (5) \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca, \u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0db8\u0dd4\u0dc4\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0dc3\u0dcf\u0dcf\u0dbd\u0dd2 \u0db1\u0dbd\u0dd3\u0db8\u0dca \u0db8\u0dc4\u0dad\u0dcf\u0dcf \u0d89\u0dbd\u0dca\u0dbd\u0dcf\u0dcf\n\nI \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3 : (I) \u0da1\u0dda\u0dda\u0daf\u0dba - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.07.032A"
  },
