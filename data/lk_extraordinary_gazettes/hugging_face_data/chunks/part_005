b4 \u0dc3\u0da7\u0dc4\u0db1\u0dd9\ufffd\u0dc4\u0dd2 \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f III \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dda\u0dda \u0d8a\u0da7 \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dd9\ufffd\u0dc4\u0dd2 \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a \u0db1\u0dcf\u0dcf\u0db8\u0dba, \u0db8\u0dd9\ufffd\u0dc4\u0dd2 IV \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dda\u0dda \u0d8a\u0da7 \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dd9\ufffd\u0dc4\u0dd2 \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2/\u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0dca\u200d\u0dba\u0dba \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2/\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2/\u0d8b\u0db4\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2, \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f V \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dda\u0dda \u0d8a\u0da7 \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dd9\ufffd\u0dc4\u0dd2 \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0daf\u0dd2\u0db1\u0dba\u0dda\u024f\u0daf\u0dd3 \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2/\u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0dca\u200d\u0dba\u0dba \u0db1\u0d9c\u0dbb\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2/\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2/\u0d8b\u0db4\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2/ \u0dad\u0ddd\ufffd\u0ddd\u02ea\u0dbb\u0dcf\u0dcf \u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2.\n\n\u0da9\u0dd3.\u0d91\u0db8\u0dca.\u0d91\u0dbd\u0dca.\u0d91\u0da0\u0dca. \u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a, \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca, \u0d8c\u0dc0 \u0db4\u0dc5\u0dcf\u0dcf\u0dad.\n\n2025 \u0da2\u0dd6\u0dbd\u0dd2 \u0db8\u0dc3 02 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0d8c\u0dc0 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\ufffd \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0daf\u0dd3 \u0dba.\n\nIV (\u0d86) \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3 - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.07.032A\n\n\u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\n\nI \u0dad\u0dd3\u0dbb\u0dd4\u0dc0 II \u0dad\u0dd3\u0dbb\u0dd4\u0dc0 III \u0dad\u0dd3\u0dbb\u0dd4\u0dc0 IV \u0dad\u0dd3\u0dbb\u0dd4\u0dc0V \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\n\n\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0dc3\u0db7\u0dd2\u0d9a \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0dad\u0db1\u0dad\u0dd4\u0dbb\u0db4\u0dad\u0dca\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0daf\u0dd2\u0db1\u0dba\n\n\u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd\u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb\u0dc0\u0dd9\u0dd9\u0dbd \u0db8\u0dc4\u0dcf\u0dcf\u0db1\u0d9c\u0dbb \u0dc3\