0b95\u0731\u0ba4\u0732\u0bb2\u0b95 850880760V \u0bae\u0bc1\u0bb4\u0bc1\u0bb5\u0ba4\u0bc1\u0bae\u0bcd 1\u0bb5\u0ba4\u0bc1 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1 \u0b95\u0bb2\u0736\u0baa\u0731\u0b9f \u0737\u0ba4\u0bb5\u0737\u0b95 _ 367/ \u0b8f, \u0baa\u0ba9\u0bcd\u0b9a\u0bb2 \u0bb5\u0bc0\u0ba4\u0732, \u0b9a\u0bc1\u0b9a\u0732\u0bb2\u0731 \u0bb0\u0b9e\u0bcd\u0b9a\u0ba9\u0733 \u0737\u0bae\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b95\u0bcd\u0b95\u0bb2\u0bcd\u0736\u0baa\u0731\u0b9f \u0b95\u0bae\u0bcd\u0baa\u0bb9\u0731. \u0b95\u0bc1\u0ba3\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb0\u0ba9\u0bcd\u0baa\u0b9f\u0bbf \u0737\u0ba4\u0bb5\u0737\u0b95 \u0bb5\u0732\u0bae\u0bb2\u0b9a\u0732\u0731\u0732 \u0b86\u0b95\u0732\u0737\u0baf\u0731\u0bb0\u0ba4\u0bc1 \u0b9a\u0733\u0bb5\u0732\u0baf \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0732\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. 1:52 0.2212 \u0b95\u0bb2\u0736\u0baa\u0731\u0b9f \u0737\u0ba4\u0bb5\u0737\u0b95 \u0bb5\u0ba4\u0bcd\u0b9a\u0bb2\u0731 \u0b9a\u0737\u0bb0\u0731\u0b9c\u0ba9\u0733 968033964V \u0bae\u0bc1\u0bb4\u0bc1\u0bb5\u0ba4\u0bc1\u0bae\u0bcd 1\u0bb5\u0ba4\u0bc1 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1 \u0b95\u0bb2\u0736\u0baa\u0731\u0b9f \u0737\u0ba4\u0bb5\u0737\u0b95 _ 367/ \u0baa\u0bc0 , \u0baa\u0ba9\u0bcd\u0b9a\u0bb2 \u0bb5\u0bc0\u0ba4\u0732, \u0737\u0bae\u0bb1\u0bcd\u0b95\u0bc1 \u0736\u0ba8\u0bb5\u0732\u0bb2\u0bcd \u0b95\u0bc1\u0ba3\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 \u0b89\u0b95\u0bcd\u0b95\u0bb2\u0bcd\u0736\u0baa\u0731\u0b9f, \u0b95\u0bae\u0bcd\u0baa\u0bb9\u0731. \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0736\u0bb5\u0bb2\u0bbf \u0b95\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0737\u0bb0 \u0736\u0b95\u0ba4\u0bb0 \u0ba8\u0ba9\u0bcd\u0ba4\u0731\u0bb5\u0ba4\u0733 \u0b86\u0b95\u0732\u0737\u0baf\u0731\u0bb0\u0ba4\u0bc1 \u0b9a\u0733\u0bb5\u0732\u0baf \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0732\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. 1:53 0.3726 \u0baa\u0ba9\u0732\u0ba8\u0bcd\u0ba4\u0bb0 \u0737\u0ba4\u0bb5\u0737\u0b95 \u0b9a\u0bc1\u0bae\u0ba9\u0731\u0bb5\u0ba4\u0733 195051800577 \u0bae\u0bc1\u0bb4\u0bc1\u0bb5\u0ba4\u0bc1\u0bae\u0bcd 1\u0bb5\u0ba4\u0bc1 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1 \u0b95\u0731.\u0ba4\u0bc1.\u0b87\u0bb2. 171 _ 382/ \u0b9f\u0bc0 /1, \u0baa\u0ba9\u0bcd\u0b9a\u0bb2 \u0bb5\u0bc0\u0ba4\u0732, \u0737\u0bae\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0ba3\u0bc1\u0b95\u0bc1\u0bb5\u0bb4\u0732 \u0b89\u0b95\u0bcd\u0b95\u0bb2\u0bcd\u0736\u0baa\u0731\u0b9f, \u0b95\u0bae\u0bcd\u0baa\u0bb9\u0731. \u0737\u0b9a\u0bb5\u0b95\u0ba4\u0bcd\u0ba4\u0732\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0732\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. 1:55 1.0245 \u0737\u0baa\u0ba4\u0bc1\u0bb0\u0bc1 \u0737\u0ba4\u0bb5\u0737\u0b95 \u0bb9\u0bb0\u0ba4 \u0bb7\u0bcd\u0bb7\u0732\u0bb0\u0bc1\u0bb5\u0ba9\u0bcd 930800589V \u0bae\u0bc1\u0bb4\u0bc1\u0bb5\u0ba4\u0bc1\u0bae\u0bcd 1\u0bb5\u0ba4\u0bc1 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bc1 \u0737\u0baa\u0ba4\u0bc1\u0bb0\u0bc1 \u0737\u0ba4\u0bb5\u0737\u0b95 _ \u0b9a\u0bae\u0bb0\u0ba8\u0731\u0baf\u0b95 \u0bb9\u0731\u0732\u0bb8\u0bcd\u0b9a\u0ba8\u0bcd\u0ba4\u0bcd\u0bb0 394/ \u0baa\u0bc0, \u0737\u0bae\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b95\u0bcd\u0b95\u0bb2\u0bcd\u0736\u0baa\u0731\u0b9f, \u0bb0\u0ba4\u0bcd\u0ba9\u0b9a\u0732\u0731\u0732 \u0b95\u0bae\u0bcd\u0baa\u0bb9\u0731. \u0b9a\u0bae\u0bb0\u0737\u0b95\u0731\u0ba9\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b87\u0bb9\u0bb2 \u0736\u0b95\u0ba4\u0bb0 \u0b95\u0bb0\u0bc1\u0ba3\u0731 \u0bb5\u0bb0\u0bcd\u0bb7\u0bae\u0731\u0ba9 \u0b86\u0b95\u0732\u0737\u0baf\u0731\u0bb0\u0ba4\u0bc1 \u0b9a\u0733\u0bb5\u0732\u0baf \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0732\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. 1:60 0.0514 \u0bae\u0ba9\u0bcd\u0b9f\u0731\u0bb5\u0bb2 \u0b95\u0b99\u0bcd\u0b95\u0731\u0ba9\u0bae\u0737\u0b95 860130726V \u0bae\u0bc1\u0bb4\u0bc1\u0b