u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd (1) \u0b86\u0bae\u0bcd \u0b89\u0baa \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0bbe\u0bb0\u0bae\u0bcd \u0b95\u0bae\u0ba4\u0bcd\u0bc6\u0ba4\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd, \u0b95\u0bbe\u0bb2\u0bcd\u0ba8\u0bc8\u0b9f \u0bb5\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0b9a\u0ba9 \u0b85\u0bc8\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b95\u0bc1\u0bb0\u0b95\u0bae\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u0ba9\u0bcd \u0bb2\u0bbe\u0bb2\u0bcd \u0b95\u0bbe\u0ba8\u0bcd\u0ba4 \u0b86\u0b95\u0bbf\u0baf \u0ba8\u0bbe\u0ba9\u0bcd, \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0bae\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd.\n\n\u0bb5\u0b9f\u0bc7\u0bae\u0bb2\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bc1\u1f9e\u0ba8\u0bbe\u0b95\u0bb2\u0bcd \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0ba9\u0bcd\u0ba9\u0bb2 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0b87\u0bb2.1598, \u0bc6\u0bb5\u0bb2\u0bcd\u0baa\u0bb2\u0bcd\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0bc6\u0bb5\u0bb2\u0bcd\u0baa\u0bb2\u0bcd\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0ba8\u0bbe\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd 2021.09.14 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0ba4\u0baf\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0bb5\u0bc8\u0bb0\u0baa\u0b9f \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd KU/PNN/2020/315 \u0b87\u0bb2\u0bcd \u0bb5\u0bbf\u0baa\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0bc6\u0baa\u0baf\u0bbe\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0ba4\u0bcd\u0bc8\u0ba4 \u1f9c\u0bc8\u0b9f\u0baf \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u1f90\u0ba3\u0bcd\u1f8c\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0b95\u0bb3\u0bcd :\n\n01. \u1f90\u0ba3\u0bcd\u1f8c 01. \u1f90\u0ba3\u0bcd\u1f8c \u2018A\u2019\u2018A\u2019 - \u0bc6\u0b95\u0bbe\u0bc6\u0bb0\u0bbe\u0b95\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0768 - \u0bc6\u0b95\u0bbe\u0bc6\u0bb0\u0bbe\u0b95\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0768 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u0bc7\u0b9c. \u0b8e\u0b9a\u0bcd. \u0ba8\u0bbf\u0bae\u0bb2\u0bbe \u0baa\u0bbf\u0baf\u0b9a\u0bc0\u1fa2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0bbe\u0bc6\u0bb0\u0bbe\u0b95\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0ba4; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1faa\u0ba4\u0bbf; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c B; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u0b8e\u0bae\u0bcd. \u0b8e\u0bae\u0bcd. \u0b8f. \u0ba4\u0bb0\u0bcd\u0bae\u0bb5\u0bbe\u0bcd\u0ba4\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0ba4.\n\n02. \u1f90\u0ba3\u0bcd\u1f8c 02. \u1f90\u0ba3\u0bcd\u1f8c \u2018B\u2019\u2018B\u2019 - \u0bc6\u0b95\u0bbe\u0bc6\u0bb0\u0bbe\u0b95\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0091 - \u0bc6\u0b95\u0bbe\u0bc6\u0bb0\u0bbe\u0b95\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0091\n\n\u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c A; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c A \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1:\n\n\u0b8e\u0b9a\u0bcd. \u0b8f. \u0bb5\u0bbf\u0bc7\u0b9c\u0b9a\u0bbf\u0b99\u0bcd\u0b95 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b8e\u0b9a\u0bcd. \u0b8f. \u0b95\u1f9e\u0ba3\u0bbe\u0bb5\u0ba4\u0bbf \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd\n\n\u0b9a\u0bbf\u0baf\u0bae\u0bcd\u0baa\u0bb2\u0bbe\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0ba4; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u0b8e\u0bae\u0bcd. \u0b8e\u0bae\u0bcd. \u0b8f. \u0ba4\u0bb0\u0bcd\u0bae\u0bb5\u0bbe\u0bcd\u0ba4\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\n\n\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0ba4.\n\n\u0bc7\u0b95.\u1f8a. \u0bb2\u0bbe\u0bb2\u0bcd \u0b95\u0bbe\u0ba8\u0bcd\u0ba4,\n\n\u0b95\u0bae\u0ba4\u0bcd\u0bc6\u0ba4\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd, \u0b95\u0bbe\u0bb2\u0bcd\u0ba8\u0bc8\u0b9f \u0bb5\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd,\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0b9a\u0ba9 \u0b85\u0bc8\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd.\n\n\u0b8e\u0ba9\u1f90 \u0b87\u0bb2.: 4-3/8/2018/PC/153.\n\n\u0b95\u0bae\u0ba4\u0bcd\u0bc6\u0ba4\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd, \u0b95\u0bbe\u0bb2\u0bcd\u0ba8\u0bc8\u0b9f \u0bb5\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd\n\n\u0ba8\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0b9a\u0ba9 \u0b85\u0bc8\u0bae\u0b9a\u0bcd\u0b9a\u0bc1,\n\n\u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4\u0bc6\u0bae\u1f90\u0bb0\u201d, \u0b87\u0bb2.1200/6,\n\n\u0bb0\u0b9c\u0bae\u0bb2\u0bcd\u0bb5\u0b