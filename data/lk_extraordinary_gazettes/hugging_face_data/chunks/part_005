\u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: 643 \u0dc3\u0dc4 645 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0daf\u0d9a\u0dd4\u0dab\u0da7: 645 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: 645, 637 \u0dc3\u0dc4 639 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 177. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 645 - \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0d9a\u0ddd\u0db1\u0dca\u0d9c\u0dc4\u0dd9\u0dc4\u0dda\u0db1, \u0d89\u0d9f\u0dd2\u0db1\u0dd2\u0d9c\u0dc4\u0dd9\u0dc4\u0dda\u0db1 \u0dc4\u0dcf \u0daf\u0db1\u0dca\u0d9c\u0dc4\u0dd9\u0dc4\u0dda\u0db1; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba (\u0d91\u0da0\u0dca.\u0d91\u0db8\u0dca.\u0da9\u0db6\u0dca.\u0db4\u0dd4\u0d82\u0da0\u0dd2\u0db6\u0dab\u0dca\u0da9\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dc0\u0dc3\u0dbb\u0dd9\u0dba\u0db1\u0dca \u0dc0\u0d9c\u0dcf \u0d9a\u0dbb\u0d87\u0dad); \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca.0.2333\n\n\u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca- \u0d8b\u0dad\u0dd4\u0dbb\u0da7: 637, 639, 644, 643, 642 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: 647 \u0dc3\u0dc4 646 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0daf\u0d9a\u0dd4\u0dab\u0da7: 646 \u0dc3\u0dc4 635 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: 635, 636 \u0dc3\u0dc4 637 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 178. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 646 - \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0d9a\u0ddd\u0db1\u0dca\u0d9c\u0dc4\u0dd9\u0dc4\u0dda\u0db1, \u0d89\u0d