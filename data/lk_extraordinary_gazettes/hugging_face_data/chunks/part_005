u0bcd\u0bb1\u0bc1\u0bae\u0bcd 282 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd.\n\n52. \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 282 - \u0b95\u0731\u0ba3\u0732\u0baf\u0732\u0ba9\u0bcd \u0736\u0baa\u0baf\u0bb0\u0bcd: \u0ba4\u0bb0\u0ba3 \u0736\u0bb5\u0bb5 \u0baf\u0731\u0baf; \u0b89\u0731\u0732\u0738\u0bae \u0737\u0b95\u0731\u0bb0\u0bc1\u0737\u0bb5\u0731\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd: 1.0252 \u0736\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0731\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: 283 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 286 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd; \u0b95\u0732\u0bb4\u0b95\u0bcd\u0b95\u0bc1: 286 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 281 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd; \u0736\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: 280 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 279 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd; \u0737\u0bae\u0bb1\u0bcd\u0b95\u0bc1: 279 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 283 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd.\n\n53. \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 283 - \u0b95\u0731\u0ba3\u0732\u0baf\u0732\u0ba9\u0bcd \u0736\u0baa\u0baf\u0bb0\u0bcd: \u0736\u0bb5\u0bb5 \u0baa\u0731\u0bb5\u0bc1\u0bb2 \u0737\u0bb9\u0ba9; \u0b89\u0731\u0732\u0738\u0bae \u0737\u0b95\u0731\u0bb0\u0bc1\u0737\u0bb5\u0731\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd: 0.5959 \u0736\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0731\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: 284, 285 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 286 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u