 330 \u0dc3\u0dc4 338 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: 338 \u0dc3\u0dc4 340 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0daf\u0d9a\u0dd4\u0dab\u0da7: 338 \u0dc3\u0dc4 340 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: 338 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd 107. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 338 - \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: (\u0dd9\u0dc4\u0ddc\u0dd9\u0dbb\u0ddc\u0dc0\u0dca \u0d87\u0dbd \u0daf\u0dd2\u0dd9\u0d9c\u0dca \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dc5 \u0db6\u0dd2\u0db8); \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db4\u0db8\u0dcf\u0dab\u0dba: 0.6507 \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca- \u2013 108. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 339 - \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dc0\u0dd0\u0dc0\u0db4\u0dcf\u0dc0\u0dd4\u0dbd\u0dd9\u0dc4\u0dda\u0db1; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca.0.3722\n\n\u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca - \u0d8b\u0dad\u0dd4\u0dbb\u0da7: 362 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: 362 \u0dc3\u0dc4 361 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0daf\u0d9a\u0dd4\u0dab\u0da7: 361 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: 362 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd 109. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 340 - \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dc0\u0dd0\u0dc0\u0db4\u0dcf\u0dc0\u0dd4\u0dbd\u0dd9\u0dc4\u0dda\u0db1; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db4\u0db8\u0dcf\u0dab\u0dba:\u0dd9\u0dc4\u0d9a\u0dca.0.2406 \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca - \u0d8b\u0dad\u0dd4\u0dbb\u0da7: 337 \u0dc3\u0dc4 338 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: 338 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd; \u0daf\u0d9a\u0dd4\u0dab\u0da7: 338 \u0dc3\u0dc4 341 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: 338 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd 110. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 341 - \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dc0\u0dd0\u0dc0\u0db4\u0dcf\u0dc0\u0dd4\u0dbd\u0dd9\u0dc4\u0dda\u0db1; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca.0.3945\n\n\u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca - \u0d8b\u0dad\u0dd4\u0dbb\u0da7: 340 \u0dc3\u0dc4 338 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: 338 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd; \u0daf\u0d9a\u0dd4\u0dab\u0da7: 338, 360 \u0dc3\u0dc4 342 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: 342 \u0dc3\u0dc4 338 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2\n\n111. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 342 - \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0db8\u0dd2\u0d9c\u0dc4\u0dd9