\u0bbf\u0bbf\u0bb0\u0bc1. \u0b9a\u0bc1\u0bb0\u0bbf\u0bbf\u0baf\u0b95\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0bb0\u0bc7\u0bc7 \u0b95\u0bc6\u0bc6\u0ba4\u0bb0 \u0b9a\u0bae\u0bbf\u0bbf\u0ba8\u0bcd\u0ba4 \u0b9a\u0bc1\u0bb0\u0bbf\u0bbf\u0baf\u0b95\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0bb02025.06.24\n\n\u0b95\u0ba3\u0bcd\u0b9f\u0bbf\u0b89\u0b9f\u0baa\u0bb2\u0bbe\u0bbe\u0ba4 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bc1.\u0b9a\u0bbf\u0bbf\u0b99\u0bcd\u0b95\u0ba9\u0bcd\u0b95\u0bc1\u0b9f\u0bcd\u0b9f\u0bbf \u0b86\u0bb0\u0731\u0b9a\u0bcd\u0b9a\u0bbf\u0bbf\u0bb2\u0bbe\u0bbe\u0b95\u0bc7\u0bc7 \u0ba8\u0bb5\u0bb0\u0ba4\u0bcd\u0ba9 \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bbe\u0bb02025.06.24\n\n\u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bbf\u0bbf\u0ba4\u0bcd \u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bc1.\u0bae\u0bb2\u0bcd\u0b95\u0bb9\u0baa\ufffd\u0bb2\ufffd \u0b95\u0bc6\u0bc6\u0ba4\u0bb0 \u0ba8\u0bb5\u0bb0\u0b9f\u0bcd\u0ba3 \u0bae\u0bb2\u0bcd\u0b95\u0bb9\u0baa\ufffd\u0bb22025.06.24\n\n\u0b95\u0ba3\u0bcd\u0b9f\u0bbf\u0ba8\u0bbe\u0bbe\u0bb5\u0bb2\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf \u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8\u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bc1.\u0b95\ufffd\u0bca\u0bb8\u0bcd\u0bb8\u0bbf\u0ba9\u0bbe\u0bbe\u0baa\u0ba4\u0bc1\u0b95\u0bc7\u0bc7 \u0b85\u0bae\u0bb2\u0bcd\n\n\u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0baf\u0b99\u0bcd\u0b95\u0bb02025.06.25\n\n\u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bbf\u0bbf\u0ba4\u0bcd \u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bc1. \u0b95\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0ba3\u0bcd\u0ba3\u0ba9\u0bcd \u0b9a\u0bc1\u0bb0\u0bc7\u0bc7\u0bb7\u0bcd\u0bb5\u0bb0\u0ba9\u0bcd2025.06.25\n\n\u0ba8\u0bc1\u0bb5\u0bb0\u0bc6\u0bc6\u0bb2\u0bbf\u0baf\u0bbe\u0bbe\u0b95\ufffd\u0bca\u0ba4\u0bcd\u0bae\u0bb2\u0bc8\u0bc8 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bc1. \u0bae\u0bc1\u0bb0\u0bae\u0bc1\u0ba4\u0bb2\u0bbf \u0b95\u0bc6\u0bc6\u0ba4\u0bb0 \u0b85\u0b9c\u0bbf\u0bbf\u0ba4\u0bcd \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0bb0 \u0bae\u0bc1\u0bb0\u0bae\u0bc1\u0ba4\u0bb2\u0bbf2025.06.25\n\n\u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bbf\u0bbf\u0ba4\u0bcd \u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bc1. \u0b9a\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0bb0\u0bae\u0ba3\u0bbf\u0bbf\u0baf\u0bae\u0bcd \u0b9a\u0ba3\u0bcd\u0bae\u0bc1\u0b95\u0ba4\u0bbe\u0bbe\u0b9a2025.06.25\n\n\u0ba8\u0bc1\u0bb5\u0bb0\u0bc6\u0bc6\u0bb2\u0bbf\u0baf\u0bbe\u0bbe\u0b85\u0bae\u0bcd\u0baa\u0b95\u0bae\u0bc1\u0bb5 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bc1. \u0ba8\u0bbe\u0bbe\u0b95\u0ba8\u0bcd\u0ba4\u0bb2\u0b95\u0bc7\u0bc7 \u0b9f\ufffd\u0bca\u0ba9\u0bcd \u0b95\u0baa\u0bbf\u0bbf\u0bb2 \u0ba8\u0ba8\u0bcd\u0ba4\u0ba9 \u0ba8\u0bbe\u0bbe\u0b95\u0ba8\u0bcd\u0ba4\u0bb22025.06.26"
