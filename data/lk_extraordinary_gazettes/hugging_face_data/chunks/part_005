u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: 310 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd 74. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 305 - \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0daf\u0d82\u0d9c\u0dc4\u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0d86\u0dbb\u0dca.\u0da7\u0dd2\u0d9a\u0dd2\u0dbb\u0dd2\u0db6\u0d82\u0da9\u0dcf; \u0db4\u0db8\u0dcf\u0dab\u0dba:\u0dd9\u0dc4\u0d9a\u0dca.0.0696\n\n\u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca - \u0d8b\u0dad\u0dd4\u0dbb\u0da7: 304 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: 306 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd; \u0daf\u0d9a\u0dd4\u0dab\u0da7: 315 \u0dc3\u0dc4 314 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: 310 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd 75. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 306 - \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0daf\u0d82\u0d9c\u0dc4\u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0db4\u0dd3.\u0db4\u0dd4\u0d82\u0da0\u0dd2\u0db6\u0dab\u0dca\u0da9\u0dcf; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca.0.4932\n\n\u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca - \u0d8b\u0dad\u0dd4\u0dbb\u0da7: 328 \u0dc3\u0dc4 304 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: 328 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd; \u0daf\u0d9a\u0dd4\u0dab\u0da7: 328 \u0dc3\u0dc4 307 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0db