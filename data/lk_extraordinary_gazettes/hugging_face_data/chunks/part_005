2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc4\u0dcf\u0dcf \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0dad\u0dd2\u0dbd\u0d9a \u0dc0\u0db1 \u0db8\u0db8, \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f I \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dd9\u0dd9\u0dc4\u0dd2 \u0db1\u0dd2\u0dc1\u0dca\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dca\u0dad\u0dcf\u0dcf \u0dc0\u0dd6 \u0daf, \u0d91\u0db8 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dd9\ufffd\u0dc4\u0dd2 II \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dd9\u0dd9\u0dc4\u0dd2 \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dd9\ufffd\u0dc4\u0dd2 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8\u0dca \u0dc4\u0dcf\u0dcf \u0d89\u0db8\u0dca \u0dc3\u0dbd\u0d9a\u0dd4\u0dab\u0dd4 \u0db1\u0dd2\u0dc1\u0dca\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dca\u0dad\u0dcf\u0dcf \u0dc0\u0dd6 \u0daf, \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4 \u0db6\u0dd0\u0dd0\u0dc0\u0dca \u0db8\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db8\u0dad\u0dba \u0dc0\u0db1 \u0dc4\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca, \u0d92 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba \u0d92 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd0\u0dd0\u0dba\u0dd2 \u0db8\u0dd9\ufffd\u0db8 \u0db1\u0dd2\u0dba\u0db8\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1 \u0d9a\u0dbb\u0db8\u0dd2.\n\n\u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0dad\u0dd2\u0dbd\u0d9a, \u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1, \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc4\u0dcf\u0dcf \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba.\n\n2025 \u0da2\u0dd6\u0dbd\u0dd2 \u0db8\u0dc3 01 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1, \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc4\u0dcf\u0dcf \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba,\u201c\u0dc3\u0dd9\ufffd\u0dad\u0dca\u0dc3\u0dd2\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dba\u201d,\u0d85\u0daf\u0dd2\u0dba\u0dbb - II,\u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd.\n\nI \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3 : (I) \u200d\u200d\u0da1\u0dd9\u0dd9\u0daf\u0dba - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.07.082A\n\nI \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dad\u0dd3\u0dbb\u0dd4\u0dc0"
