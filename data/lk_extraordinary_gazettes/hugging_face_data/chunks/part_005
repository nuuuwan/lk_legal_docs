\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0db1\u0dca\u200d\u0d9c\u0dda\ufffd\u0dda\u0118 \u0d91\u0dc3\u0dca. \u0da9\u0db6\u0dca\u0dbd\u0dd2\u0dc0\u0dca. \u0d86\u0dbb\u0dca. \u0da9\u0dd3. \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d85\u0db1\u0dd4\u0dc3\u0dca\u0db8\u0dbb\u0dab \u0db4\u0daf\u0db1\u0db8\u0dda\ufffd \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0db8\u0dab\u0dca\u0da9\u0dbd \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0dc0\u0dc4\u0dcf\u0dcf\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0db6\u0dc0 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\ufffd.\n\n01. \u0d91\u0db1\u0dca. \u0db8\u0dd4\u0dbb\u0dd4\u0d9c\u0dda\u0118\u0dc3\u0dd4 \u0db8\u0dc4\u0dad\u0dcf\u0dcf 02. \u0da2\u0dda\u0dda. \u0d91\u0db8\u0dca. \u0d91\u0dc3\u0dca. \u0db6\u0dca\u200d\u0dbb\u0dd2\u0da7\u0ddd\u02ce\u0ddd\ufffd \u0db8\u0dc4\u0dad\u0dcf\u0dcf 03. \u0d85\u0db6\u0dca\u0db6\u0dcf\u0dcf\u0dc3\u0dca \u0dba\u0dd4\u0dc3\u0dd4\u0dc6\u0dbd\u0dd2 \u0db8\u0dc4\u0dad\u0dcf\u0dcf 04. \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dbb\u0dcf\u0dcf \u0db8\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2\u0dba\n\n\u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db4\u0dbb\u0dd2\u0daf\u0dd2, \u0d86\u0da0\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0d91\u0db1\u0dca. \u0d91\u0dc3\u0dca. \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a, \u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca.\n\n2025 \u0da2\u0dd6\u0dbd\u0dd2 \u0db8\u0dc3 02 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba,\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 01.\n\nEOG 07 - 0039\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dbb\u0da2\u0dba\u0dda\u024f \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.1A - G 44736 \u2014 05 (2025/07)"
