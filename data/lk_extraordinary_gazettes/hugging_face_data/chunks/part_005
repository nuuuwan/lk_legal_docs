db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2\n\n126. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 357 - \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dc0\u0dd0\u0dc0\u0db4\u0dcf\u0dc0\u0dd4\u0dbd\u0dd9\u0dc4\u0dda\u0db1; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0d86\u0dbb\u0dca.\u0db8\u0dbd\u0dca\u0dc4\u0dcf\u0db8\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca.-0.5910 \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca - \u0d8b\u0dad\u0dd4\u0dbb\u0da7: 353 \u0dc3\u0dc4 358 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7:358 \u0dc3\u0dc4 371 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0daf\u0d9a\u0dd4\u0dab\u0da7: 371 \u0dc3\u0dc4 356 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: 356 \u0dc3\u0dc4 353 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 127. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 358 - \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dc0\u0dd0\u0dc0\u0db4\u0dcf\u0dc0\u0dd4\u0dbd\u0dd9\u0dc4\u0dda\u0db1; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dd9\u0d9a\u0dca.\u0dd9\u0dc3\u0db1\u0dc0\u0dd2\u0dbb\u0dad\u0dca\u0db1; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca.0.4078\n\n\u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca - \u0d8b\u0dad\u0dd4\u0dbb\u0da7: 353 \u0dc3\u0dc4 359 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: 359 \u0dc3\u0dc4 371 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0daf\u0d9a\u0dd4\u0dab\u0da7: 371 \u0dc3\u0dc4 357 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: 357 \u0dc3\u0dc4 353 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 128. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 359 - \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dc0\u0dd0\u0dc0\u0db4\u0dcf\u0dc0\u0dd4\u0dbd\u0dd9\u0dc4\u0dda\u0db1; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0db4\u0dd3.\u0d8b\u0d9a\u0dca\u0d9a\u0dd4\u0dc0\u0dcf; \u0db4\u0db8\u0dcf\u0dab\u0dba:\u0dd9\u0dc4\u0d9a\u0dca.0.5271\n\n\u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca - \u0d8b\u0dad\u0dd4\u0dbb\u0da7: 353,328 \u0dc3\u0dc4 363 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: 364,365,368 \u0dc3\u0dc4 371 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0daf\u0d9a\u0dd4\u0dab\u0da7: 371 \u0dc3\u0dc4 358 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2: \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: 358 \u0dc3\u0dc4 353 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 129. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 360 - \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dc0\u0dd0\u0dc0\u0db4\u0dcf\u0dc0\u0dd4\u0dbd\u0dd9\u0dc4\u0dda\u0db1; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca.0.2786\n\n\u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca - \u0d8b\u0dad\u0dd4\u0dbb\u0da7: 341 \u0dc3\u0dc4 338 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: 338 \u0dc3\u0dc4 353 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0daf\u0d9a\u0dd4\u0dab\u0da7: 353 \u0dc3\u0dc4 342 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: 342 \u0dc3\u0dc4 341 \u0dc0\u0dd0\u0db1\u0dd2 \u0db