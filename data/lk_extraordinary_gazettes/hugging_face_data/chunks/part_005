9\u0ba9, \u0737\u0b95\u0731\u0ba9\u0bcd\u0b95\u0bb9\u0737\u0bb9\u0ba9 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb3\u0bc1\u0ba4\u0bcd\u0b95\u0bae\u0737\u0bb9\u0ba9; \u0b89\u0731\u0732\u0738\u0bae \u0737\u0b95\u0731\u0bb0\u0bc1\u0737\u0bb5\u0731\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; (\u0b9f\u0baa\u0bcd.\u0b8e\u0b8e\u0bae\u0bcd. \u0bae\u0bc1\u0ba4\u0bc1\u0baa\u0ba3\u0bcd\u0b9f\u0731 \u0bb5\u0732\u0ba9\u0731\u0bb2\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0733\u0bb1\u0732 \u0738\u0b95\u0baf\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0732 \u0baa\u0baf\u0732\u0bb0\u0bcd\u0b9a\u0bcd \u0736\u0b9a\u0baf\u0bcd\u0738\u0b95 \u0736\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1); \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd: 0.8513 \u0736\u0bb9\u0b95\u0bcd\u0b9f \u0baf\u0731\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: 604 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 587 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd; \u0b95\u0732\u0bb4\u0b95\u0bcd\u0b95\u0bc1: 587, 588, 589 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 20 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd; \u0736\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: 20 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 593 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd; \u0737\u0bae\u0bb1\u0bcd\u0b95\u0bc1: 593, 592, 591 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 604 \u0b86\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd.\n\n129. \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 591 - \u0b95\u0731\u0ba3\u0732\u0baf\u0732\u0ba9\u0bcd \u0736\u0baa\u0baf\u0bb0\u0bcd: \u0ba4\u0ba9\u0bcd\u0b95\u0bb9 \u0737\u0bb9\u0ba9, \u0737\u0b95\u0731\u0ba9\u0bcd\u0b95\u0bb9\u0737\u0bb9\u0ba9 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb3\u0bc1\u0ba4\u0bcd\u0b95\u0bae\u0737\u0bb9\u0ba9; \u0b89\u0731\u0732\u0738\u0bae \u0737\u0b95\u0731\u0bb0\u0bc1\u0737\u0bb5\u0731\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; (\u0b9f\u0baa\u0bcd.\u0b8e\u0bae\u0bcd. \u0bb0\u0ba9\u0bcd\u0736\u0bae\u0ba3\u0732\u0b95\u0731 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9f\u0bbf.\u0b8e\u0bae\u0bcd. \u0bb0\u0ba9\u0bcd\u0baa\u0ba3\u0bcd\u0b9f\u0731\u0bb5\u0732\u0ba9\u0731\u0bb2\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0733\u0bb1\u0732 \u0738\u0b95\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0732 \u0baa\u0baf\u0732\u0bb0\u0bcd\u0b9a\u0bcd \u0736\u0b9a\u0baf\u0bcd\u0738\u0b95 \u0736\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1); \u0bb5\u0732\u0bb8\u0bcd\u0ba4\u0733\u0bb0\u0ba3\u0bae\u0bcd: 0.2534 \u0736\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0731\u0bb0\u0bcd"
