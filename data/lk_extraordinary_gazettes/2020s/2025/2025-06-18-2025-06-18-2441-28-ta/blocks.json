    "text": "01. \u1f90\u0ba3\u0bcd\u1f8c \u2018A\u2019 - \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb8\u0bcd\u0bb2\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: \u1f90\u0ba3\u0bcd\u1f8c \u2018A\u2019 - \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb8\u0bcd\u0bb2\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 6.2185 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd6.2185 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u0b8e\u0ba9\u0bcd. \u0bc7\u0b95. \u0b9c\u0baf\u0ba4\u0bbf\u0bb2\u0b95\u0bcd\u0b95 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b8f\u0bc8\u0ba9\u0baf \u0ba8\u0baa\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb8\u0bcd\u0bb2\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0baa\u0bb5\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0bb5\u0bbf\u0baf\u1fa2\u0bc6\u0ba4\u0ba9\u0bcd\u0ba9, \u0b95\u0bb2\u0b85\u0bb8\u0bcd\u0bc7\u0bb8\u0bc6\u0b95\u0bc6\u0bb2\u0bc7\u0bb9\u0ba9 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba8\u0ba8\u0bcd\u0ba4\u0bbe \u0bb0\u0bbe\u0b9c\u0baa\u0b95\u0bcd \u0bb7 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb8\u0bcd\u0bb2\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u0ba8\u0ba8\u0bcd\u0ba4\u0bbe \u0bb0\u0bbe\u0b9c\u0baa\u0b95\u0bcd \u0bb7 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb8\u0bcd\u0bb2\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0b9f\u0bc0 \u0baa\u0bc0.\u0bb5\u0bbf\u0bae\u0bb2\u0bc7\u0b9a\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb8\u0bcd\u0bb2\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0b8e\u0ba9\u0bcd. \u0b8e\u0bb8\u0bcd. \u0b9a\u0bae\u0ba9\u0bcd \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb8\u0bcd \u0bb2\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0bbe\u0ba4\u0bcd \u0bc6\u0b95\u0bbe\u1f8a\u1f90\u0bb5\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb8\u0bcd\u0bb2\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b9a\u0bb0\u0ba4\u0bcd \u0bc6\u0b95\u0bbe\u1f8a\u1f90\u0bb5\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u0b95\u0bc1\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb8\u0bcd\u0bb2\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u0b9a\u0bb0\u0ba4\u0bcd \u0bc6\u0b95\u0bbe\u1f8a\u1f90\u0bb5\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb8\u0bcd\u0bb2\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u1f90\u0ba3\u0bcd\u1f8c\u0b95\u0bb3\u0bcd E, F, B, C \u0baa\u0bbe\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b86\u0bb0\u0bcd.\u0baa\u0bc0.\u0b9f\u0bc0. \u0b89\u0bc7\u0ba4\u0ba9\u0bbf \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba9\u0bcd\u0ba4\u0bbf \u0b9a\u0bb0\u0ba4\u0bcd \u0bc6\u0b95\u0bbe\u1f8a\u1f90\u0bb5\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb8\u0bcd\u0bb2\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u0baa\u0bbe\u0bc8\u0ba4, \u0b86\u0bb0\u0bcd. \u0baa\u0bc0. \u0b9c\u0baf\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb8\u0bcd\u0bb2\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0baa\u0bbe\u0bc8\u0ba4, \u0b8e\u0ba9\u0bcd. \u0bc7\u0b95. \u0b9c\u0baf\u0ba4\u0bbf\u0bb2\u0b95\u0bcd\u0b95 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b8f\u0bc8\u0ba9\u0baf \u0ba8\u0baa\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb8\u0bcd\u0bb2\u0ba8\u0bcd\u0ba4 \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd.",
