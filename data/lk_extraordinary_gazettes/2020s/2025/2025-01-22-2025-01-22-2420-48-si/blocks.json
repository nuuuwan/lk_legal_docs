dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1:29 0.5889 \u0dc0\u0dcf\u0dc3\u0dbd \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0da0\u0db1\u0dca\u0daf\u0dcf\u0dc0\u0dad\u0dd3 195874702392 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0d89\u0dc4\u0dbd \u0dc0\u0dad\u0dca\u0dad, \u0dd9\u0d9a\u0ddd\u0db1\u0dca\u0dc0\u0dd0\u0dc0. \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:40 0.7788 \u0d9a\u0dc4\u0db3\u0dc0 \u0d85\u0db4\u0dca\u0db4\u0dd4\u0dc4\u0dcf\u0db8\u0dd2\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0daf\u0dba\u0dcf\u0dc0\u0dad\u0dd3 656550910V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86 \u0db4\u0db1\u0dd9\u0dad\u0dca 432/29, \u0db8\u0da9\u0dd4\u0d9c\u0dc3\u0dca\u0dd9\u0d9c\u0ddc\u0da9\u0dd0\u0dbd\u0dca\u0dbd, \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0d9a\u0da7\u0dca\u0da7\u0db9\u0dd4\u0dc0\u0dcf\u0dc0, \u0dd9\u0d9a\u0ddd\u0db1\u0dca\u0dc0\u0dd0\u0dc0. \u0d85\u0daf\u0dcf\u0dbd\u0dc0 1:41 0.4925 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:42 0.6070 \u0dc0\u0dcf\u0dc3\u0dbd \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0da9\u0dd2\u0d82\u0d9c\u0dd2\u0dbb\u0dd2 \u0d85\u0db8\u0dca\u0db8\u0dcf 586241796V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca 203/1, \u0dd9\u0d9a\u0ddd\u0db1\u0dca\u0dc0\u0dd0\u0dc0, \u0dd9\u0d9a\u0ddd\u0db1\u0dca\u0dc0\u0dd0\u0dc0. \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:43 0.3847 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:44 0.1375 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:45 0.8094 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:47 0.0420 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:48 0.0433 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:49 0.8094 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:50 0.4047 \u0dc0\u0dcf\u0dc3\u0dbd \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc1\u0dd2\u0dbb\u0db1\u0dca\u0dad \u0dbb\u0dd4\u0dc0\u0db1\u0dca 199122200940 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dc0\u0dcf\u0dc3\u0dbd \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0db8\u0da9\u0dd4\u0d9c\u0dc3\u0dca\u0dd9\u0d9c\u0ddc\u0da9\u0dd0\u0dbd\u0dca\u0dbd, \u0dd9\u0d9a\u0ddd\u0db1\u0dca\u0dc0\u0dd0\u0dc0, \u0db8\u0dc4\u0dc0. \u0dba\u0da7\u0dad\u0dca\u0dc0 1:51 0.2803 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:55 0.1048 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:56 0.3243 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 1:57 0.8094 \u0dc0\u0dcf\u0dc3\u0dbd \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dd9\u0d9c\u0dca \u0d9a\u0db4\u0dd4\u0dbb\u0dd4\u0db6\u0db1\u0dca\u0da9\u0dcf 196230403479 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddd\u0db1\u0dca\u0dc0\u0dd0\u0dc0, \u0dd9\u0d9a\u0ddd\u0db1\u0dca\u0dc0\u0dd0\u0dc0, \u0db8\u0dc4\u0dc0. \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:58 0.1265 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ EOG 01-0215/1",
