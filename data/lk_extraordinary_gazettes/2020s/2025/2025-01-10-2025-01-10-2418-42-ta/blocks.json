    "text": "\u0ba8\u0ba4\u0bc1\u0ba7\u0bbe\u0ba6\u0b99\u0bcd\u0bc8\u0bb3\u0bcd \u0ba8\u0bc0\u0ba4\u0bbe\u0ba6 \u0ba8\u0ba4\u0bc1\u0baf\u0bbe\u0bbf\u0ba4\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0b95\u0baf \u0bc8\u0bbe\u0bac\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0bc8\u0bbe\u0bac\u0bae\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0ba7\u0b9f\u0bcd\u0b9f\u0baf\u0bbe\u0bab\u0bbe\u0ba6 \u0ba8\u0ba4\u0bc1\u0baf\u0bbe\u0bbf\u0b95\u0bcd \u0bc8\u0b9f\u0bcd\u0b9f\u0b95\u0bad\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd (52 \u0b86\u0bae\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0ba9\u0bae\u0bcd) 22 \u0b86\u0bae\u0bcd \u0ba7\u0bbf\u0bbe\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc8\u0bc0\u0bb4\u0bcd \u0b8e\u0ba6\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbe\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0ba7\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bad \u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0baf\u0b99\u0bcd\u0bc8\u0bad\u0bbf\u0ba9\u0bcd \u0ba7\u0bbf\u0baa\u0bc8\u0bbe\u0baa\u0bae\u0bcd, \u0ba5\u0bbf\u0ba4\u0bbf, \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba8\u0bbf\u0b9f\u0bb2\u0bcd \u0ba8\u0bb1\u0bcd\u0bb0\u0bc3\u0bae\u0bcd \u0bb5\u0ba7\u0bbe\u0bb0\u0bc1\u0bad\u0bbe\u0ba4\u0bbe\u0baa \u0b85\u0ba7\u0bbf\u0baf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0b95\u0ba8\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b85\u0ba4\u0bc3\u0baa \u0b95\u0bc1\u0ba8\u0bbe\u0baa \u0ba4\u0bbf\u0b9a\u0bbe\u0ba5\u0bbe\u0ba9\u0b95\u0bcd\u0bc8 \u0b86\u0bc8\u0bbf\u0ba9 \u0ba5\u0bbe\u0ba9\u0bcd, \u0b87\u0ba8\u0bcd\u0ba4 \u0bc8\u0b9f\u0bcd\u0b9f\u0b95\u0bad\u0ba9\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bac\u0bae\u0bcd 2025 \u0b9a\u0ba6\u0baf\u0bbe\u0bbf 11 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf \u0bae\u0bc1\u0ba4\u0bb2\u0bcd \u0ba7\u0ba9\u0ba9\u0bcd\u0baf\u0bb2\u0bc1\u0baa\u0bcd\u0bb5\u0ba7\u0bb0\u0bc3\u0bae\u0bcd \u0baf\u0b95\u0bc8\u0ba9\u0bbf\u0bb2\u0bcd \u0ba7\u0bbf\u0ba9\u0bcd\u0baf\u0bb0\u0bc1\u0ba8\u0bbe\u0bb0\u0bc3 \u0ba7\u0ba3\u0bbf\u0b95\u0bcd\u0bc8\u0bbf\u