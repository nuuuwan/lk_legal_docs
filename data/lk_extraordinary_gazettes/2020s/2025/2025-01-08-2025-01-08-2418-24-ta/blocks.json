    "text": "\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3 I. \u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bc7\u0baf\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd : \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd, \u0bae\u0bbf\u0ba9\u0bbf\u0baa\u0bcd\u0bc7\u0baa. II. \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd : \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0bae\u0bcd, \u0b95\u0ba3\u0bcd\u1f8a \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0bae\u0bbf\u0ba9\u0bbf\u0baa\u0bcd\u0bc7\u0baa \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0b87\u0bb2. 899, \u0b89\u0b9f\u0b95\u0bb2\u0bcd\u0bc6\u0ba4\u0bc6\u0baa\u0bbe\u0b95\u0bcd\u0b95 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b89\u0b9f\u0b95\u0bb2\u0bcd \u0bc6\u0ba4\u0bc6\u0baa\u0bbe\u0b95\u0bcd\u0b95 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3, \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5 \u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0ba8\u0bbe\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0ba4\u0baf\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0bb2. \u0b87.\u0b95\u0bbf.\u0bb5.320, \u0b95\u0bbe\u0ba3\u0bbf \u0bb5\u0bbf\u0baa\u0bb0\u0baa\u0bcd \u0baa\u0b9f\u0bcd\u1f8a\u0baf\u0bb2\u0bcd \u0baa\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0b87\u0bb2. 38, \u0baa\u0bbf\u0bb1\u0bcd\u0bc7\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0bc8\u0b95 \u0b87\u0bb2. 2, \u0ba4\u0bbe\u0bb3\u0bcd \u0b87\u0bb2. 2, 2020.11.25 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf \u0b87\u1fa0\u0ba4\u0bbf \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bbe\u0b95 \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u1f9e\u0bae\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bcd, \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0b99\u0bcd\u0b95\u0bc8\u0bb3\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u1f90\u0ba3\u0bcd\u1f8c \u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0b95\u0bb3\u0bcd: 01. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 310 \u2013 \u0baf\u0bb9\u0ba9\u0bcd\u0b95\u0bb2 \u0bb5\u0ba4\u0bcd\u0bc8\u0ba4- \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 19.4734 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 301 ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 301, 311 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 312; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 312, \u0baa\u0bb2\u0bcd\u0bc7\u0bb2 \u0b95\u0bb2\u0bc6\u0ba4 \u0bc6\u0baa\u0bbe\u0b95\u0bcd\u0b95 (\u0b87.\u0b95\u0bbf.\u0bb5. 319), \u0b89\u0b9f\u0b87\u1fa4\u0b95 (\u0b87.\u0b95\u0bbf.\u0bb5. 486) \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 173; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 173 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 308. 02. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 311 \u2013 \u0baf\u0bb9\u0ba9\u0bcd\u0b95\u0bb2 \u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 4.1399 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 301 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 313 ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u0baa\u0bb2\u0bcd\u0bc7\u0bb2 \u0b95\u0bb2\u0bc6\u0ba4\u0bc6\u0baa\u0bbe\u0b95\u0bcd\u0b95 (\u0b87.\u0b95\u0bbf.\