    "text": "2017 \u0d85\u0d82\u0d82\u0d9a 24 \u0daf\u0dbb\u0db1 \u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0db8\u0dca \u0db4\u0db1\u0dad\u0dda\u01ae \u0db4\u0dc3\u0dca\u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f 1(\u0d85) \u0da1\u0dda\u0dda\u0daf\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0 \u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0dc0\u0db1 \u0db8\u0db8, \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db4\u0dc4\u0dad \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f \u0dc3\u0db3\u0dc4\u0db1\u0dca \"\u0db6\u0dd2\u0d82\u0d82\u0d9c\u0dd2\u0dbb\u0dd2\u0dba \u0dc3\u0db8\u0dcf\u0dcf\u0da2 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0d9c\u0db8\u0dba\u0da7 \u0d85\u0dba\u0dad\u0dca \u0da2\u0dda\u0dda. \u0d91\u0dbd\u0dca. \u0dc3\u0dd2\u0dbb\u0dd2\u0dc3\u0dda\ufffd\u0dda\u0db1 \u0d85\u0db1\u0dd4\u0dc3\u0dca\u0db8\u0dbb\u0dab \u0dc0\u0dd0\u0dd0\u0da9\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3\u0dba\" \u0dba\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba \u0d91\u0d9a\u0dd3 \u0da1\u0dda\u0dda\u0daf\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0db1\u0dd4\u0db8\u0dad \u0db4\u0dd4\u0dab\u0dca\u200d\u0dba\u0dcf\u0dcf\ufffd\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dca \u0dbd\u0dd9\ufffd\u0dc3 \u0db8\u0dd9\ufffd\u0db8 \u0daf\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0dd9\ufffd\u0db1\