bc0\u1f8c \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bc7\u0bae\u0bb2\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0b95\u0bae\u0bcd\u0baa\u0bb9\u0bbe \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0bae\u0bc0\u0bbe\u0bbf\u0b95\u0bae \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b87\u0bb2. 32 - \u0b85\u1fa2\u0baf\u0bbe\u0bc6\u0bb5\u1f8c\u1f8e\u0bc6\u0bb5\u0bb5 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u0bb3\u0bcd \u0b85\u1fa2\u0baf\u0bbe\u0bc6\u0bb5\u1f8c\u1f8e\u0bc6\u0bb5\u0bb5 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3\u1f90\u0bae\u0bcd 420987 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bb2\u0bcd \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 01 \u0b87\u0bb2\u0bcd \u0b85\u0b9f\u0b99\u0bcd\u0b95\u0bbf\u1f9c\u0bb3\u0bcd\u0bb3\u1f90\u0bae\u0bbe\u0ba9 2 : 37, 2 : 50, 3 : 50, 3 : 51, 3 : 52, 3 : 53, 3 : 54, 3 : 55, 3 : 56 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 3 : 57 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bc8\u0bb3\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u1f90\u0ba3\u0bcd\u1f8c\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u1f90 \u0bc6\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0b95 \u0b87\u0ba4\u0bc7\u0ba9\u0bbe\u1f8c \u0b87\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u0bb2\u0bcd \u0ba4\u0bb0\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b8e\u0ba9\u1f90 \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9