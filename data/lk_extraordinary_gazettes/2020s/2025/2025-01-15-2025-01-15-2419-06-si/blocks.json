    ],
    "text": "04. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 4 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0d8a\u0dbb\u0dd2\u0d9a\u0dd1\u0dc0 \u0db8\u0dd6\u0d9a\u0dbd\u0dcf\u0db1, \u0dd9\u0db8\u0ddc\u0dbb\u0d9c\u0dc4\u0dc0\u0dd0\u0dc0\u0dba\u0dcf\u0dba, \u0dc3\u0dd2\u0dba\u0db9\u0dbd\u0dd1\u0dc0\u0d9a\u0dd0\u0dd9\u0dbd\u0dca; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dc0\u0dad\u0dca\u0dad; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba, \u0da2\u0db1\u0dc1\u0d9a\u0dca\u0dad\u0dd2 \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0d9c\u0dcf \u0d9a\u0dbb\u0dba\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca 0.0053. \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca: \u0d8b\u0dad\u0dd4\u0dbb\u0da7: \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029 \u0dc3\u0dc4 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 2; \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 2 \u0dc3\u0dc4 \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029. 05. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 5 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0d8a\u0dbb\u0dd2\u0d9a\u0dd1\u0dc0 \u0db8\u0dd6\u0d9a\u0dbd\u0dcf\u0db1, \u0dd9\u0db8\u0ddc\u0dbb\u0d9c\u0dc4\u0dc0\u0dd0\u0dc0\u0dba\u0dcf\u0dba, \u0dc3\u0dd2\u0dba\u0db9\u0dbd\u0dd1\u0dc0\u0d9a\u0dd0\u0dd9\u0dbd\u0dca; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dc0\u0dad\u0dca\u0dad; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba, \u0da2\u0db1\u0dc1\u0d9a\u0dca\u0dad\u0dd2 \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0d9c\u0dcf \u0d9a\u0dbb\u0dba\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca 0.0117. \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca: \u0d8b\u0dad\u0dd4\u0dbb\u0da7: \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029, \u0dd9\u0db8\u0db8 \u0db4\u0dd2\u0db9\u0dd4\u0dd9\u0dbb\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 6 \u0dc3\u0dc4 2; \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029. 06. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 6 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0d8a\u0dbb\u0dd2\u0d9a\u0dd1\u0dc0 \u0db8\u0dd6\u0d9a\u0dbd\u0dcf\u0db1, \u0dd9\u0db8\u0ddc\u0dbb\u0d9c\u0dc4\u0dc0\u0dd0\u0dc0\u0dba\u0dcf\u0dba, \u0dc3\u0dd2\u0dba\u0db9\u0dbd\u0dd1\u0dc0\u0d9a\u0dd0\u0dd9\u0dbd\u0dca; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dc0\u0dad\u0dca\u0dad; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba, \u0da2\u0db1\u0dc1\u0d9a\u0dca\u0dad\u0dd2 \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0d9c\u0dcf \u0d9a\u0dbb\u0dba\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca 0.0340. \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca: \u0d8b\u0dad\u0dd4\u0dbb\u0da7: \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029; \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 2, 5 \u0dc3\u0dc4 \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029. 07. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 7 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0d8a\u0dbb\u0dd2\u0d9a\u0dd1\u0dc0 \u0db8\u0dd6\u0d9a\u0dbd\u0dcf\u0db1, \u0dd9\u0db8\u0ddc\u0dbb\u0d9c\u0dc4\u0dc0\u0dd0\u0dc0\u0dba\u0dcf\u0dba, \u0dc3\u0dd2\u0dba\u0db9\u0dbd\u0dd1\u0dc0\u0d9a\u0dd0\u0dd9\u0dbd\u0dca; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dc0\u0dad\u0dca\u0dad; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba, \u0da2\u0db1\u0dc1\u0d9a\u0dca\u0dad\u0dd2 \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0d9c\u0dcf \u0d9a\u0dbb\u0dba\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca 0.0142. \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca: \u0d8b\u0dad\u0dd4\u0dbb\u0da7: \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029 \u0dc3\u0dc4 \u0dd9\u0db8\u0db8 \u0db4\u0dd2\u0db9\u0dd4\u0dd9\u0dbb\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 2; \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 2 \u0dc3\u0dc4 \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029. 08. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 8 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0d8a\u0dbb\u0dd2\u0d9a\u0dd1\u0dc0 \u0db8\u0dd6\u0d9a\u0dbd\u0dcf\u0db1, \u0dd9\u0db8\u0ddc\u0dbb\u0d9c\u0dc4\u0dc0\u0dd0\u0dc0\u0dba\u0dcf\u0dba, \u0dc3\u0dd2\u0dba\u0db9\u0dbd\u0dd1\u0dc0\u0d9a\u0dd0\u0dd9\u0dbd\u0dca; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dc0\u0dad\u0dca\u0dad \u0dc3\u0dc4 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba, \u0da2\u0db1\u0dc1\u0d9a\u0dca\u0dad\u0dd2 \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0d9c\u0dcf \u0d9a\u0dbb\u0dba\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca 0.0542. \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca: \u0d8b\u0dad\u0dd4\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 2 \u0dc3\u0dc4 \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029; \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 8\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1029 \u0dc3\u0dc4 \u0dd9\u0db8\u0db8 \u0db4\u0dd2\u0db9\u0dd4\u0dd9\u0dbb\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 9; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 2. 09. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 9 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0d8a\u0dbb\u0dd2\u0d9a\u0dd1\u0dc0 \u0db8\u0dd6\u0d9a\u0dbd\u0dcf\u0db1, \u0dd9\u0db8\u0ddc\u0dbb\u0d9c\u0dc4\u0dc0\u0dd0\u0dc0\u0dba\u0dcf\u0dba, \u0dc3\u0dd2\u0dba\u0db9\u0dbd\u0dd1\u0dc0\u0d9a\u0dd0\u0dd9\u0dbd\u0dca; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dc0\u0dad\u0dca\u0dad; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba, \u0da2\u0db1\u0dc1\u0d9a\u0dca\u0dad\u0dd2 \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0d9c\u0dcf \u0d9a\u0dbb\u0dba\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca 0.0711.",
