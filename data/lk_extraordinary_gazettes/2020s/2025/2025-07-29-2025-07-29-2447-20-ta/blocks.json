    ],
    "text": "\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u0b8e\u0bb8\u0bcd.\u0b8e\u0bb8\u0bcd.\u0b8f. \u0ba4\u0bbf\u0bb2\u0b95\u0b9a\u0bbf\u0bb1\u0bbf \u0b89\u0bb0\u0bbf\u0bae\u0bc8\u0b95\ufffd\u0bcb\u0bb0\u0bc1\u0bae\u0bcd \u0bb0\u0baa\u0bb0\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0bb5\u0bc0\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bb0\u0bbf\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0b95\u0ba3\u0bcd\u0b9f\u0bc1\u0baa\u0bbf\u0b9f\u0bbf\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 B; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 B, \u0b86.\u0bb5 .\u0b95\ufffd\u0bca. 9583 \u0b87\u0bb2\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 40 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bb2\u0bc1\u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bc7 \u0b95\u0bae\u0bb2\u0bbe\u0bb5\u0ba4\u0bbf \u0b89\u0bb0\u0bbf\u0bae\u0bc8\u0b95\ufffd\u0bcb\u0bb0\u0bc1\u0bae\u0bcd \u0bb0\u0baa\u0bb0\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0bb5\u0bc0\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bb0\u0bbf \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 85 \u0b90\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0b95\u0bbe\u0ba3\u0bbf; \u0ba4\u0bc6\u0bb1\u0bcd\u0b95\u0bc1 : \u0b95\u0bb2\u0bc1\u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bc7 \u0b95\u0bae\u0bb2\u0bbe\u0bb5\u0ba4\u0bbf \u0b89\u0bb0\u0bbf\u0bae\u0bc8\u0b95\ufffd\u0bcb\u0bb0\u0bc1\u0bae\u0bcd \u0bb0\u0baa\u0bb0\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0bb5\u0bc0\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bb0\u0bbf\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 85 \u0b90\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb0\u0baa\u0bb0\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0bb5\u0bc0\u0ba4\u0bbf; \u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bc1 : \u0bb0\u0baa\u0bb0\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0bb5\u0bc0\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b8e\u0bb8\u0bcd.\u0b8e\u0bb8\u0bcd.\u0b8f. \u0ba4\u0bbf\u0bb2\u0b95\u0b9a\u0bbf\u0bb1\u0bbf \u0b89\u0bb0\u0bbf\u0bae\u0bc8\u0b95\ufffd\u0bcb\u0bb0\u0bc1\u0bae\u0bcd \u0bb0\u0baa\u0bb0\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0bb5\u0bc0\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bb0\u0bbf\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0b95\u0ba3\u0bcd\u0b9f\u0bc1\u0baa\u0bbf\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf.",
