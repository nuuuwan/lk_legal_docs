    "text": "\u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dba\u0db4 \u0dba\u0dbb \u0dda\u0dad\u0dd4 \u0dc0\u0db1 \u0d89\u0da9\u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb : \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0db4\u0dc5\u0dcf\u0dba\u0dda, \u0dc4\u0db8\u0dca\u0db6\u0dca\u0dad\u0dba\u0dcf \u0da7 \u0daf\u0dd2\u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0dbb\u0dd2\u0dbb\u0dd2\u0dba\u0dc0\u0dd0\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba \u0dba \u0dba\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dba\u0d9a \u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba\u0dda, \u0db6\u0dd0\u0daf\u0dd2\u0d9c\u0d82\u0dba\u0dcf \u0da7 \u200d\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dba\u0d9a \u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba\u0dda, \u0db6\u0dd0\u0daf\u0dd2\u0d9c\u0d82\u0dba\u0dcf \u0da7 \u0d9c\u0dba\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2, \u0dc3\u0dbb\u0dca\u0dba\u0dc0\u0dca\u0dba\u0dbb\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dbd\u0dca \u0dba\u0dc0\u0db1\u0dd4\u0dc0\u0da7 \u0dc4\u0db8\u0dca\u0db6\u0dca\u0dad\u0dba\u0dcf \u0da7 \u0dba\u0da2\u0dcf\u200d\u0dc2\u0dca\u0dc3 \u0db8\u0dd2\u0db1\u0dd2\u0dca\u0dad\u0dba\u0daf\u0ddd \u0d85 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2 \u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0dba\u0dbd \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0db8\u0dca \u0d85\u0d82\u0d9a 830521 \u0dc4\u0dd2 \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 05 \u0dc4\u0dd2 \u0db4\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d9a 01 \u0daf\u0dbb\u0db1 2024.12.25 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0db4\u0dd2\u0dd4\u0dbb\u0dba\u0dbb\u0dca \u0d9a\u0dd0\u0db6\u0dd2 \u0d85\u0d82\u0d9a 01 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dba\u0dba\u0dba\u0dca\u0dad \u0dba\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.0503 \u0d9a\u0dca \u0dd6 \u0db4\u0dc4\u0dcf \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb \u0dba\u0d9a\u0dba\u0dbb\u0db1 \u0d8