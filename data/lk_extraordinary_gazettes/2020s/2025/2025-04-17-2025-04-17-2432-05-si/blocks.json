    "text": "1974 \u0d85\u0d82\u0d9a 02 \u0daf\u0dbb\u0db1 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0dbd\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0dc4\u0dcf \u0da2\u0dbd\u0dcf\u0db4\u0dc0\u0dc4\u0db1 \u0db8\u0dab\u0dca\u0da9\u0dbd \u0db4\u0db1\u0dad\u0dda, 92 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dca \u0db8\u0dcf \u0dc0\u0dd9\u0dad \u0db4\u0dd0\u0dc0\u0dbb\u0dd2 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb, \u0db1\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1, \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba, \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dad\u0dd2\u0dbd\u0d9a \u0dc0\u0db1 \u0db8\u0db8, \u0d91\u0d9a\u0dd3 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0da7, \u0db8\u0dcf\u0dad\u0dbb \u0d85\u0daf\u0dd2\u0dba\u0dbb IV \u0da2\u0dbd \u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda \u0db8\u0dcf\u0dad\u0dbb - \u0dc4\u0d9a\u0dca\u0db8\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba, \u0dad\u0dd2\u0dc4\u0d9c\ufffd\u0ddc\u0da9 \u0d9a\ufffd\u0ddd\ufffd\u0db4\u0dd2\u0dc0\u0dad\u0dca\u0dad \u0d87\u0dbd \u0dc4\u0dbb\u0dc4\u0dcf \u0da2\u0dbd \u0db1\u0dbd \u0d91\u0dc5\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0da9\u0db8\u0dca \u0d9a\ufffd\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dc0 \u0d87\u0dad\u0dd2 \u0dc4\u0dd9\u0dba\u0dd2\u0db1\u0dca, \u0db8\u0dd9\u0dc4\u0dd2 \u0db4\u0dc4\u0dad \u0d8b\u0db4\u0dbd\u0dda\u0d9b\u0db1\u0dba\u0dd9\u0dc4\u0dd2 \u0daf\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0db1 \u0d89\u0da9\u0db8\u0dca \u0d9a\ufffd\u0ddc\u0da7\u0dc3\u0dd9\u0dc4\u0dd2 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dbd \u0daf\u0dda\u0db4\u0dc5 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0d85\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0db8\u0dd9\u0db8 \u0db1\u0dd2\u0dba\u0db8\u0dba\u0dd9\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dbb\u0db8\u0dd2.",
