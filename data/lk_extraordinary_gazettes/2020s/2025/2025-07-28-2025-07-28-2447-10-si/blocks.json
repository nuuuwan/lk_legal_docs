    ],
    "text": "\u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013--\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 \u0dc0\u0dd2\u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u0ddd \u0db4\u0dad \u0d85\u0d82\u0d9a\u0dba \u0d89\u0db1\u0dca\u0dd9\u0da2\u0db1\u0dca\u0dc2\u0db1\u0dca \u0dad\u0dc4\u0db1\u0db8\u0dca \u0dd9\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0dc4 \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd\u0dad\u0dca\u0dc0\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dd9\u0d9c\u0dca/\u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dd9\u0dba\u0dca \u0d85\u0dd9\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dcf\u0dd9\u0dc0\u0db1\u0dca \u0d87\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dd9\u0dc3\u0dda \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db1\u0db8/\u0db1\u0db8\u0dca \u0dc3\u0dc4 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u0dc4\u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dc4 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dca \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u0db4\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1 : 2 0.0880 \u0d87\u0dbd\u0dca\u0dc3\u0dca\u0da7\u0db1\u0dca \u0da0\u0db1\u0dca\u0daf\u0dbd\u0dcf\u0dbd\u0dca \u0db4\u0dd0\u0db1\u0dca\u0dc3\u0dd2\u0dc3\u0dca 562401261V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 01 \u0dc4\u0dd2 \u0da2\u0dba\u0dad\u0dd2\u0dbd\u0d9a \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0d82\u0d9a 44, \u0db8\u0dbd\u0dca\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb 1 : 3 0.0253 \u0db0\u0db1\u0dd9\u0dc3\u0dda\u0d9a\u0dbb \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d85\u0db1\u0dd4\u0dbb 197328801603\u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 01 \u0dc4\u0dd2 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0d82\u0d9a 122/\u0db6\u0dd3, \u0db8\u0dbd\u0dca\u0dc0\u0dbd \u0db4\u0dcf\u0dbb. \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c, \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb \u0dba\u0dd6\u0db1\u0dd2\u0dba\u0db1\u0dca \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0dad\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0d82\u0d9a 3512 \u0dc4\u0dcf 2017.02.01 \u0daf\u0dbb\u0db1 \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1 : 5 0.0189 \u0dd9\u0dc4\u0dda\u0dc0\u0dcf \u0db8\u0dcf\u0dbb\u0db9\u0dd9\u0d9c\u0dca \u0d9c\u0dd4\u0dab\u0dc3\u0dd2\u0dbb\u0dd2 420920725V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d85\u0d82\u0d9a 31. \u0dc1\u0dd3 \u0dd9\u0db6\u0ddd\u0db0\u0dd2\u0dbb\u0dcf\u0da2 \u0db8\u0dcf\u0dc0\u0dad, \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb 1 : 6 0.1291 \u0dad\u0dd4\u0da9\u0dd4\u0d9c\u0dbd \u0db8\u0dd4\u0daf\u0dbd\u0dd2\u0dd9\u0d9c\u0dca \u0dd9\u0dc4\u0dda\u0db8\u0da0\u0db1\u0dca\u0daf 194109600761\u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 01 \u0dc4\u0dd2 \u0dd9\u0db4\u0dd9\u0dbb\u0dca\u0dbb\u0dcf \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0d82\u0d9a 122, \u0dc1\u0dd3 \u0db4\u0dcf\u0daf \u0db8\u0dcf\u0dc0\u0dad, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb 1 : 18 0.0195 \u0d85\u0db6\u0dca\u0daf\u0dd4\u0dbd\u0dca \u0d9a\u0dcf\u0daf\u0dbb\u0dca \u0dc3\u0dd2\u0dad\u0dca\u0dad\u0dd2 \u0da2\u0db1\u0dd4\u0db6\u0dcf 548290740V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0dc1\u0dd3 \u0db4\u0dcf\u0daf \u0db8\u0dcf\u0dc0\u0dad, \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb 1 : 19 0.0367 \u0dd9\u0db8\u0ddc\u0dc4\u0db8\u0da9\u0dca \u0d85\u0dbd\u0dc0\u0dd2 \u0dd9\u0db8\u0ddc\u0dc4\u0db8\u0da9\u0dca \u0d85\u0dc6\u0dca\u0dad\u0dcf\u0db6\u0dca 813511320V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 17 \u0dc4\u0dd2 \u0d85\u0d82\u0d9a \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf 108/1, \u0db8\u0dc4\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0dc1\u0dd3 \u0db4\u0dcf\u0daf \u0db8\u0dcf\u0dc0\u0dad, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb 1 : 26 0.0242 \u0d85\u0dc4\u0db8\u0da9\u0dca \u0dd9\u0db8\u0ddc\u0dd9\u0dc4\u0ddc\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0db4\u0dcf\u0dc4\u0dd2\u0db1\u0dca 680614024V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d85\u0d82\u0d9a 94/\u0da9\u0dd3, \u0dc1\u0dd3 \u0db4\u0dcf\u0daf \u0db8\u0dcf\u0dc0\u0dad, \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb 1 : 29 0.0360 \u0d85\u0dad\u0dd4\u0dd9\u0d9a\u0ddd\u0dbb\u0dcf\u0dbd\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0db8\u0dbd\u0dd2\u0dad\u0dd2 \u0dc1\u0db8\u0dd2\u0db1\u0dca\u0daf\u0dd2 918232575V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 31 \u0dc4\u0dd2 \u0dc0\u0dd3\u0dbb\u0dad\u0dd4\u0d82\u0d9c \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0d82\u0d9a 47, \u0dc1\u0dd3 \u0db4\u0dcf\u0daf \u0db8\u0dcf\u0dc0\u0dad, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb 1 : 30 0.0075 \u0d85\u0dad\u0dd4\u0dd9\u0d9a\u0ddd\u0dbb\u0dbd\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dad\u0dcf\u0dbb\u0d9a \u0db8\u0dd2\u0dc4\u0dbb\u0dcf\u0db1\u0dca 880490621V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 31 \u0dc4\u0dd2 \u0dc0\u0dd3\u0dbb\u0dad\u0dd4\u0d82\u0d9c \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0d82\u0d9a 47, \u0dc1\u0dd3 \u0db4\u0dcf\u0daf \u0db8\u0dcf\u0dc0\u0dad, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb 1 : 32 0.0253 \u0d85\u0dad\u0dd4\u0dd9\u0d9a\u0ddc\u0dbb\u0dc5\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0db8\u0db0\u0dd4\u0dc2\u0dcf \u0d91\u0dbb\u0db1\u0dca\u0daf\u0dd2 816540550V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 31 \u0dc4\u0dd2 \u0dc0\u0dd3\u0dbb\u0dad\u0dd4\u0d82\u0d9c \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0d82\u0d9a 47, \u0dc1\u0dd3 \u0db4\u0dcf\u0daf \u0db8\u0dcf\u0dc0\u0dad, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb 1 : 49 0.0474 \u0dbb\u0dcf\u0da2\u0dbd\u0dd2\u0d82\u0d9c\u0db8\u0dca \u0dbb\u0dcf\u0da2\u0dca\u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dca 196933401566 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 01 \u0dc4\u0dd2 \u0d85\u0d82\u0d9a 04, \u0dd9\u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0dc0\u0dd3\u0daf\u0dd2\u0dba, \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c 1 : 55 0.2343 \u0d85\u0db6\u0dca\u0daf\u0dd4\u0dbd\u0dca \u0dc0\u0daf\u0dd4\u0daf\u0dd4 \u0dd9\u0db8\u0ddc\u0dc4\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0db1\u0dc0\u0dcf\u0dc3\u0dca 541793038V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dd9\u0d9a\u0ddc\u0db8\u0dbb\u0dca\u0dc2\u0dbd\u0dca \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0d85\u0d82\u0d9a 68, \u0dad\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0d82\u0d9a 7552 - \u0dc1\u0dd3 \u0db4\u0dcf\u0daf \u0db8\u0dcf\u0dc0\u0dad, \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb 2007.02.26 \u0dc4\u0dcf 919 - 2018.10.04 \u0daf\u0dbb\u0db1 \u0d8b\u0d9a\u0dc3\u0dca \u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1 : 59 0.0939 \u0d91\u0daf\u0dd2\u0dbb\u0dd2\u0db8\u0dd4\u0db1\u0dd2 \u0d9a\u0dd4\u0dc2\u0dcf\u0db1\u0dca\u0dad \u0dd9\u0dbd\u0db1\u0dcf\u0da9\u0dca \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf 1978