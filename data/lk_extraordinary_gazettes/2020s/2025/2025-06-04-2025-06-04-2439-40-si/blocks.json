    ],
    "text": "\u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0db8\u0dcf\u0dad\u0dd9\u0262 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0db1\u0dcf \u0d8b\u0dbd \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d85\u0d82\u0d9a \u0d8a 415 \u0d8a - \u0dd9\u0db6\u02a3\u0db6\u0dd0\u0262\u0dbd \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u01b1\u0dc5 \u0218\u028f\u0179 \u0dd9\u0db6\u02a3\u0db6\u0dd0\u0262\u0dbd \u0d9c\u0db8\u0da7 \u0dd9\u0dc4\u02a4 \u0d89\u01e6 \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0d9a\u0da7 \u0dd9\u0dc4\u02a4 \u0d9a\u0dc5\u0dcf\u0db4 \u0d85\u0d82\u0d9a 02 \u0da7 \u0d85\u0daf\u0dcf\u0dbd\u0dc0 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u00fb\u025d\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 11 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u023d\u01e9\u023c\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0dc3\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a 310196 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0dd9\u023c \u0daf\u00fa\u0dc0\u0dcf \u0d87\u01af \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0d91\u0d9a\u0d9a \u0dd9\u0dc4\u02a4 \u0d8a\u0da7 \u0dc0\u0dd0\u018b \u0d9c\u0dab\u0db1\u0d9a \u0dd9\u0dc4\u02a4 \u0d85\u0250\u01af\u0dba\u0da7 \u0db1\u0dd0\u0dad\u0dd9\u0dc4\u02a3\u01ae \u0dc3\u01e6\u0dad\u0d9a\u0dba\u0da7 \u0dd9\u0dc4\u02a4 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dad\u0dcf\u0dc0\u0dba\u0d9a\u0da7 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u0db1 \u0d9a\u0dc0\u0dbb \u026c\u0dc0\u0daf \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u0d9a\u0dd4 \u026a\u0286\u01e6 \u0dad\u0db8 \u028f\u023d\u0d9a\u023c\u0db4\u0dd1\u0db8 2025 \u0152\u01e7 \u0db8\u0dc3 16 \u0dc0\u0dd0\u01e7 \u01ce\u0db1\u0da7 \u0dd9\u0db4\u0dbb, \u0db4\u0dc4\u0dad \u0d85\u01ae\u0dc3\u01e6 \u0d9a\u0dbb\u0db1 \u0d85\u0dba \u0dd9\u0dc0\u0dad \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dc5 \u0252\u01b1\u0dba. \u0d91\u00fc \u01ce\u0db1\u0da7 \u0dd9\u0db4\u0dbb \u0dba\u023c \u028f\u023d\u0d9a\u023c \u0db4\u0dd1\u0db8\u00fa \u0d89\u01ce\u025c\u0db4\u01ae \u00fb\u025d\u0db8 \u0db4\u0dd0\u0dc4\u0dd0\u0dbb \u0dc4\u025c\u01e9 \u0dbd\u0dd0\u022c\u0dc0\u0dd9\u0dc4\u02a3\u01ae, \u0d92 \u0d89\u0da9\u0dd9\u023c \u0d85\u0250\u01af\u0dba \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d92\u0d9a \u0db4\u0dcf\u00fa\u027f\u0d9a \u0db4\u025d\u00fa\u0dc2\u0dab\u0dba\u00fa \u0db4\u0dc0\u01ae\u0dc0\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0d91\u028f \u01cf \u0d9c\u01e9 \u0dbd\u0db6\u0db1 \u01b0\u0dbb\u0dab\u0dba \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0db4\u0db1\u0dd9\u01ae 14 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u021d\u0d9a\u0dcf\u0dbb \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229 . \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0d85\u0d82\u0d9a 310196 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0db8, \u0d85\u0daf\u0dcf\u0dc5 \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025d \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dd9\u024f \u01cf, \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0db8\u0dc4 \u0dd9\u0262\u0d9a\u023c \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dd9\u024f \u01cf, \u01ce\u0dc3\u0dca\u01b5\u00fa \u023d\u01e9\u023c \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dd9\u024f \u01cf, \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dd9\u0118 \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dd9\u024f \u01cf, \u0dd9\u0dc4\u02a4 \u023d\u01e9\u023c\u0db4\u01af \u0dc0\u0dbb\u0dba\u0dcf\u0dd9\u0118 \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dd9\u024f \u01cf \u0db4\u025d\u00fa\u0dc2\u0dcf \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0dc4\u0dd0\u00fb\u0dba.",
    "fonts": [
