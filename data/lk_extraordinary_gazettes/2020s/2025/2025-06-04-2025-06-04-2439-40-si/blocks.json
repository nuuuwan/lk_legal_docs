    "text": "\u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0db8\u0dc4\u01e9\u0dc0\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0dc4\u0dcf\u025c\u0dc3\u0dca\u0db4\u01ae\u01b1\u0dc0 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d85\u0d82\u0d9a 420 - \u0dd9\u0db4\u02a3\u0262\u0dc0\u01ae\u0dad \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u01b1\u0dc5 \u0218\u028f\u0179 \u0dd9\u0db4\u02a3\u0262\u0dc0\u01ae\u0dad \u0d9c\u0db8\u0da7 \u0dd9\u0dc4\u02a4 \u0d89\u01e6 \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0d9a\u0da7 \u0dd9\u0dc4\u02a4 \u0d9a\u0dc5\u0dcf\u0db4 \u0d85\u0d82\u0d9a 04 \u0da7 \u0d85\u0daf\u0dcf\u0dbd\u0dc0 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u00fb\u025d\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 11 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u023d\u01e9\u023c\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0dc3\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a 320461 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0dd9\u023c \u0daf\u00fa\u0dc0\u0dcf \u0d87\u01af \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0d91\u0d9a\u0d9a \u0dd9\u0dc4\u02a4 \u0d8a\u0da7 \u0dc0\u0dd0\u018b \u0d9c\u0dab\u0db1\u0d9a \u0dd9\u0dc4\u02a4 \u0d85\u0250\u01af\u0dba\u0da7 \u0db1\u0dd0\u0dad\u0dd9\u0dc4\u02a3\u01ae \u0dc3\u01e6\u0dad\u0d9a\u0dba\u0da7 \u0dd9\u0dc4\u02a4 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dad\u0dcf\u0dc0\u0dba\u0d9a\u0da7",
