fd\u0ddc\u0da0\u0dca\u0da0\u0dd2 \u0db1\u0d9c\u0dbb\u0dba \u0d9a\u0dab\u0db4\u0dad\u0dd2\u0db4\u0dca\u0db4\u0dd2\u0dbd\u0dca\u0dbd\u0ddb\u0ddb \u0d86\u0db1\u0db1\u0dca\u0daf\u0dc0\u0da9\u0dd2\u0dc0\u0dda\u0dda\u0dbd\u0dca11 \u0d9c\u0db1\u0dda\ufffd\u0dc1\u0db4\u0dd4\u0dbb\u0db8\u0dca \u0d85\u0dbb\u0dd4\u0db1\u0dcf\u0dcf\u0dc3\u0dbd\u0db8\u0dca \u0dc0\u0dda\u0dda\u0dc5\u0db8\u0dcf\u0dcf\u0dbd\u0dd2\u0d9a\u0dd2\u0dad\u0db1\u0dca12 \u0db4\u0dd9\u0dd9\u0dbb\u0dd2\u0dba\u0db4\u0dbb\u0db1\u0dca\u0dad\u0db1\u0dca \u0d9a\u0dde\ufffd\u0dde\u0dc3\u0dbd\u0dcf\u0dcf \u0dc0\u0ddb\u0ddb\u0dad\u0dca\u0dad\u0dd3\u0dc1\u0dca\u0dc0\u0dbb\u0db8\u0dd6\u0dbb\u0dca\u0dad\u0dd213 \u0d8b\u0dbb\u0dd4\u0dad\u0dca\u0dad\u0dd2\u0dbb\u0db4\u0dd4\u0dbb\u0db8\u0dca \u0db6\u0dcf\u0dcf\u0dbb\u0dad\u0dd2\u0daf\u0dcf\u0dcf\u0dc3\u0db1\u0dca \u0d91\u0dc5\u0dd2\u0dbd\u0dca\u0dc0\u0dda\u0dda\u0db1\u0dca\u0daf\u0db1\u0dca14 \u0d85\u0d9a\u0dca\u0d9a\u0dbb\u0dcf\u0dcf\u0dba\u0db1\u0dca \u0dad\u0da9\u0dca\u0dc3\u0dab\u0dcf\u0dcf\u0db8\u0dd6\u0dbb\u0dca\u0dad\u0dca\u0dad\u0dd2 \u0db8\u0dd4\u0dbb\u0dbd\u0dd215 \u0dc0\u0db1\u0dca\u0db1\u0dda\ufffd\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dd4\u0dbd\u0db8\u0dca \u0db1\u0dcf\u0dcf\u0d9c\u0dda\u0118\u0db1\u0dca\u0dad\u0dd2\u0dbb\u0db8\u0dca \u0dc3\u0dd9\ufffd\u0dbd\u0dca\u0dc0\u0db1\u0dcf\u0dcf\u0dba\u0d9c\u0db8\u0dca16 \u0d9a\u0ddd\ufffd\u0ddd\ufffd\u0db1\u0dcf\u0dcf\u0dc0\u0dd2\u0dbd\u0dca \u0dc3\u0dd2\u0dc0\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0d9c\u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0db8\u0dd2 \u0dc3\u0db1\u0dca\u0dad\u0dd2\u0dbb\u0db6\u0ddd\ufffd\u0ddd\ufffd\u0dc1\u0dca17 \u0dc3\u0dd9\ufffd\u0dbd\u0dca\u0dc0\u0dcf\u0dcf\u0db1\u0d9c\u0dbb\u0dca \u0db8\u0dcf\u0d82\u0d82\ufffd\u0d9a\u0dd4\u0da9\u0dd2 \u0dad\u0dd2\u0dba\u0dcf\u0dcf\u0d9c\u0dbb\u0dcf\u0dcf\u0dc3\u0dcf\u0dcf18 \u0d8b\u0daf\u0dba\u0db1\u0d9c\u0dbb\u0dca \u0d9a\u0dab\u0dda\u019c\u0dc3\u0dd4 \u0dad\u0dd4\u0dbb\u0ddb\u0ddb\u0dbd\u0dd2\u0d82\u0d82\u0d9c\u0db8\u0dca19 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc1\u0dca\u0dab\u0db4\u