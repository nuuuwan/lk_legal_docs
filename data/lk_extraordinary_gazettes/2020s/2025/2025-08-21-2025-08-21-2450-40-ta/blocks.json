    ],
    "text": "1978 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 16 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95, \u0baa\u0bb2\u0bcd\u0bcd\u0b95\u0bb2\u0bc8\u0b95\u0bcd\u0bcd\u0b95\u0bb4\u0b95\u0b99\u0bcd\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd 25\u0b85 \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc1\u0b9f\u0ba9\u0bcd \u0b9a\ufffd\u0bcb\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bbe\u0b9a\u0bbf\u0b95\u0bcd\u0bcd\u0b95\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd 27 (1) (\u0b86) \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1\u0bbe\u0bbf\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbe\u0b95\u0bcd\u0bcd\u0b95\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f \u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0b99\u0bcd\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0baf\u0ba9\u0bc8\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1, \u0b95\u0bb2\u0bcd\u0bcd\u0bb5\u0bb5\u0bbf, \u0b89\u0baf\u0bbe\u0bcd \u0b95\u0bb2\u0bcd\u0bcd\u0bb5\u0bb5\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bb1\u0bcd\u0bcd\u0b95\u0bb2\u0bcd\u0bcd\u0bb5\u0bb5\u0bbf \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0bcd\u0b9a\u0b9a\u0bbe\u0bcd \u0b95\u0bb2\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf \u0bb9\u0bbe\u0bbf\u0ba3\u0bbf \u0b85\u0bae\u0bb0\u0b9a\u0bc2\u0bbe\u0bbf\u0baf \u0b86\u0b95\u0bbf\u0baf \u0ba8\u0bbe\u0ba9\u0bcd, 2007 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 07 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95, \u0b95\u0bae\u0bcd\u0bcd\u0baa\u0baa\u0bc6\u0ba9\u0bbf\u0b95\u0bb3\u0bcd \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0b87\u0bb2\u0b99\u0bcd\u0bcd\u0b95\u0b95\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bbf\u0ba3\u0bc8\u0b95\u0bcd\u0bcd\u0b95\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f \u0b95\u0bae\u0bcd\u0bcd\u0baa\u0baa\u0bc6\u0ba9\u0bbf\u0baf\ufffd\u0bca\u0ba9\u0bcd\u0bcd\u0bb1\u0bb1\u0bbe\u0b95\u0bb5\u0bc1\u0bb3\u0bcd\u0bcd\u0bb3\u0ba4\u0bc1\u0bae\u0bcd, \u0baa\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bc8 \u0b85\u0bb3\u0bbf\u0b95\u0bcd\u0bcd\u0b95\u0b95\u0bbf\u0ba9\u0bcd\u0bcd\u0bb1 \u0ba8\u0bbf\u0bb1\u0bc1\u0bb5\u0b95\u0bae\ufffd\u0bca\u0ba9\u0bcd\u0bcd\u0bb1\u0bb1\u0bbe\u0b95 \u0b8f\u0bb1\u0bcd\u0bcd\u0bb1\u0b99\u0bcd\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bbf\u0b95\u0bcd\u0bcd\u0b95\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f GL 24 \u0b86\u0bae\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bbf\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bc8\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0bcd\u0b9f\u0ba4\u0bc1\u0bae\u0bbe\u0ba9 \u0bb8\u0bcd\u0bb0\u0bc0\u0bb2\u0b99\u0bcd\u0bcd\u0b95\u0b95\u0bbe \u0b87\u0ba9\u0bcd\u0bb8\u0bcd\u0b9f\u0bbf\u0b9f\u0bbf\u0baf\u0bc2\u0b9f\u0bcd \u0b92\u0baa\u0bcd \u0b87\u0ba9\u0bcd\u0baa\u0bcb\u0bae\u0bc7\u0bb7\u0ba9\u0bcd \u0b9f\u0bc6\u0b95\u0bcd\u0bc7\u0ba9\u0bbe\u0bb2\ufffd\u0bca\u0b9c\u0bbf (\u0b89\u0ba4\u0bcd\u0bcd\u0ba4\u0bb0\u0bb5\u0bbe\u0ba4\u0bae\u0bcd) \u0bb2\u0bbf\u0bae\u0bbf\u0b9f\u0bcd\u0bcd\u0b9f\u0b9f\u0bc6\u0b9f\u0bcd \u0ba4\ufffd\u0bca\u0b9f\u0bbe\u0bcd\u0baa\u0bbf\u0bb2\u0bcd, \u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bc2\u0bb1\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd 70\u0b87 \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bbe\u0ba9 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0bc8\u0b95\u0baf\ufffd\u0bca\u0ba9\u0bcd\u0bcd\u0bb1\u0bb1\u0bc8\u0baa\u0bcd \u0baa\u0bc6\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1, \u0b9a\ufffd\u0bca\u0bb2\u0bcd\u0bcd\u0bb2\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0b86\u0b95\u0bcd\u0bcd\u0b95\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bc1\u0bae\u0bcd, 2025, \u0baa\u0bc6\u0baa\u0bcd\u0baa\u0bc1\u0bb0\u0bc1\u0bb5\u0bbe\u0bbf 20 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf 2424/59 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95 \u0b85\u0ba4\u0bbf\u0bb5\u0bbf\u0b9a\u0bc7\u0b9f \u0bb5\u0bbe\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\ufffd\u0bcc\u0bbf\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bc1\u0bae\u0bbe\u0ba9 \u0b95\u0b9f\u0bcd\u0bcd\u0b9f\u0bb3\u0bc8\u0b95\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0ba9 II \u0b86\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0bcd\u0b9f\u0bb5\u0ba3\u0bc8\u0baf\u0bc8 \u0b85\u0ba4\u0bb1\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0ba9 \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd I \u0b87\u0bb2\u0bcd \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \"\u0b9a\u0bc6\u0baf\u0bb1\u0bcd\u0bcd\u0b95\u0b95\u0bc8 \u0ba8\u0bc1\u0ba3\u0bcd\u0bcd\u0ba3\u0bb1\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0b9e\u0bcd\u0bcd\u0b9e\u0b9e\u0bbe\u0ba9 \u0bae\u0bc1\u0ba4\u0bc1\u0bae\u0bbe\u0ba3\u0bbf\" \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd II \u0b87\u0bb2\u0bc1\u0bb3\u0bcd\u0bcd\u0bb3 \u0b85\u0ba4\u0ba9\u0bcd \u0ba8\u0bc7\u0bb0\ufffd\u0bca\u0ba4\u0bcd\u0bcd\u0ba4 \u0baa\u0ba4\u0bbf\u0bb5\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b89\u0b9f\u0ba9\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1, \u0b85\u0ba4\u0bb1\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0ba9 \u0b85\u0b9f\u0bcd\u0bcd\u0b9f\u0bb5\u0ba3\u0bc8 I \u0b87\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb0\u0bc8\u0b95\u0bcd\u0bcd\u0b95\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f \u0ba8\u0bbf\u0baa\u0ba8\u0bcd\u0bcd\u0ba4\u0ba9\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bc8\u0bb5\u0bbe\u0b95 \u0b87\u0ba4\u0bb1\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0ba9 \u0b85\u0b9f\u0bcd\u0bcd\u0b9f\u0bb5\u0ba3\u0bc8 II \u0b87\u0ba9\u0bcd \u0bae\u0bc1\u0bb1\u0bc8\u0baf\u0bc7 \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd I \u0b87\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd II \u0b87\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bc1\u0bae\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb0\u0bc8\u0b95\u0bcd\u0bcd\u0b95\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f \u0baa\u0ba4\u0bbf\u0bb5\u0bc1\u0b95\u0bb3\u0bc8\u0b9a\u0bcd \u0b9a\ufffd\u0bcb\u0bcd\u0baa\u0bcd\u0bcd\u0baa\u0ba4\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0b87\u0b95\u0bcd\u0bcd\u0b95\u0b9f\u0bcd\u0bcd\u0b9f\u0bb3\u0bc8\u0baf\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bcd\u0bb1\u0bb1\u0bc7\u0ba9\u0bcd :-",
