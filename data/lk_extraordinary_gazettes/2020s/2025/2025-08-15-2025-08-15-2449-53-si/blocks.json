d9c\u0dca 571382016V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dad\u0dd2\u0dbd\u0d9a\u0dbb\u0dad\u0dca\u0db1 \u0d85\u0d82\u0d9a 62, \u0db6\u0dbd\u0dbd\u0dca\u0dbd. 1:103 0.0877 \u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0dd9\u0db4\u0dca\u0dbb\u0dd4 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca 541701478V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0d86\u0dbb\u0dd2\u0dba\u0dbb\u0dad\u0dca\u0db1 \u0db1\u0dcf\u0dba\u0d9a \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb \u0dd9\u0db4\u0ddc\u0dbd \u0db4\u0dcf\u0dbb, \u0db6\u0dc5\u0dbd\u0dca\u0dbd. 1:104 0.0717 \u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0db4\u0dca\u0dd9\u0db4\u0dca\u0dbb\u0dd4 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca 521646420V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0d9c\u0dd4\u0dab\u0daf\u0dcf\u0dc3 \u0dad\u0dcf\u0db1\u0dcf\u0dba\u0db8 \u0db4\u0dcf\u0dbb, \u0d9a\u0dd0\u0d9a\u0dd4\u0db1\u0dcf\u0dc0, \u0db8\u0dc4\u0dc0. 1:107 0.4884 \u0d85\u0dd9\u0db6\u0dca\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dbb\u0d82\u0db6\u0dab\u0dca\u0da9\u0dcf 613643281V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0d85\u0dd9\u0db6\u0dca\u0dc3\u0dd2\u0d82\u0dc4 \u0dd9\u0db1\u0ddc.62, \u0dd9\u0db4\u0ddc\u0dbd \u0dc4\u0d82\u0daf\u0dd2\u0dba, \u0db6\u0dbd\u0dbd\u0dca\u0dbd. 1:108 0.4120 \u0dd9\u0dc4\u0dda\u0dbb\u0dad\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc3\u0db8\u0db1\u0dca\u0dad 197521202261 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0dc4\u0dda\u0dbb\u0dad\u0dca \u0db4\u0dbd\u0dcf\u0db4\u0dad