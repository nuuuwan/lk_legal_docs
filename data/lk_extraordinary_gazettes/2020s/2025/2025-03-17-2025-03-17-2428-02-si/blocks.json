    "text": "7. \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0daf\u0dd2\u0dad \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba\u0d9a \u0daf\u0dd3 \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1\u0dda\ufffd \u0db4\u0ddc\ufffd\u0ddc\u0daf\u0dd4 \u0db1\u0dd3\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0db1\u0dd3\u0dad\u0dd2 \u0d8b\u0dbd\u0dca\u0dbd\u0d82\u0d82\u0d9d\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.",
