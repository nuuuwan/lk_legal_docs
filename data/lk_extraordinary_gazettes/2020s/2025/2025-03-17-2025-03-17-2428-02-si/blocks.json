    "text": ". 6\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dba \u0dbd\u0db6\u0dcf\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dbd\u0daf \u0d85\u0db4\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0d9a\u0dba\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dc0\u0dcf\u0dcf\u0dc4\u0db1\u0dba\u0dda\u024f \u0db4\u0db8\u0dab\u0d9a\u0dca \u0d85\u0db4\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0da0\u0dcf\u0dcf\u0dbb\u0d9a \u0db4\u0ddd\ufffd\u0ddd\ufffd\u0dc3\u0dca\u0da7\u0dbb\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da9\u0dd2 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db4\u0dad\u0dcf\u0dcf\u0d9a \u0db4\u0dca\u200d\u0dbb\u0daf\u0dbb\u0dca\u0dc1\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dc0\u0dc3\u0dbb \u0dbd\u0db6\u0dcf\u0dcf\u0daf\u0dd9\u0dd9\u0db1 \u0d85\u0dad\u0dbb, \u0d85\u0db4\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0d9a\u0dba\u0dd9\ufffd\u0d9a\u0dd4 \u0d9c\u0db8\u0db1\u0dca \u0db1\u0ddc\ufffd\u0ddc\u0d9a\u0dbb\u0db1 \u0dc0\u0dcf\u0dcf\u0dc4\u0db1\u0dba\u0d9a \u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0d85\u0dad\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf\u0dcf, \u0db4\u0dca\u200d\u0dbb\u0daf\u0dbb\u0dca\u0dc1\u0db1 \u0db4\u0dad\u0dca\u200d\u0dbb, \u0daf\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0dc5, \u0da0\u0dd2\u0dad\u0dca\u200d\u0dbb, \u0d85\u0db4\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0d9c\u0dda\u0118 \u0da1\u0dcf\u0dcf\u0dba\u0dcf\u0dcf\u0dbb\u0dd6\u0db4, \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dbb\u0dca\u0dc1\u0db1\u0dba \u0d9a\u0dc5 \u0db1\u0ddc\ufffd\u0ddc\u0dc4\u0dd0\u0dd0\u0d9a. \u0d85\u0db4\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0d9a\u0dba\u0d9a\u0dd4 \u0d9c\u0dd9\ufffd\u0db1 \u0dba\u0dcf\u0dcf\u0db8\u0da7 \u0d89\u0da9 \u0d87\u0dad\u0dd0\u0dd0\u0dba\u0dd2 \u0dc3\u0dbd\u0d9a\u0dcf\u0dcf \u0dc0\u0dd2\u0dc1\u0dcf\u0dcf\u0dbd \u0dc0\u0dcf\u0dcf\u0dc4\u0db1 \u0dc3\u0d82\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0\u0d9a \u0db8\u0dd9\ufffd\u0dc3\u0dda\ufffd\u0dda \u0d9a\u0ddc\ufffd\u0ddc\u0da9\u0dd2 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db4\u0dad\u0dcf\u0dcf\u0d9a \u0db4\u0dca\u200d\u0dbb\u0daf\u0dbb\u0dca\u0dc1\u0db1\u0dba \u0d9a\u0dc5 \u0db1\u0ddc\ufffd\u0ddc\u0dc4\u0dd0\u0dd0\u0d9a. \u0db8\u0dc4\u0da2\u0db1\u0dba\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0d9c\u0db8\u0db1\u0dcf\u0dcf\u0d9c\u0db8\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dba\u0ddc\ufffd\u0ddc\u0daf\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba, \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0d9c\u0db8\u0db1\u0dcf\u0dcf\u0d9c\u0db8\u0db1 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0db6\u0dc3\u0dca \u0dbb\u0dae \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db4\u0dde\ufffd\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0db6\u0dc3\u0dca \u0dbb\u0dae\u0dc0\u0dbd \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0db4\u0dde\ufffd\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc0\u0dcf\u0dcf\u0dc4\u0db1\u0dc0\u0dbd \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db8\u0dd9\ufffd\u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd1\u0dd1 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dbb\u0dca\u0dc1\u0db1\u0dba \u0d9a\u0dc5 \u0db1\u0ddc\ufffd\u0ddc\u0dc4\u0dd0\u0dd0\u0d9a.",
