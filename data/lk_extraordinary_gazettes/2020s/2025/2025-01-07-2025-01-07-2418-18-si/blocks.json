    "text": "\u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba 1. \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u01e7\u0dbd\u0db0\u0dcf\u025c. - \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c, \u023d\u019e\u0dd9\u0217. 2. \u0d89\u0da9\u0dd9\u023c \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba.- \u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0db8\u0dc4\u01e9\u0dc0\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u023d\u019d\u0dd9\u0217 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d85\u0d82\u0d9a 899 \u0d8b\u0da9\u0d9c\u0262\u0dd9\u0daf\u0dd9\u0db6\u02a3\u00fa\u0d9a \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d8b\u0da9\u0d9c\u0262\u0dd9\u0daf\u0dd9\u0db6\u02a3\u00fa\u0d9a \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a \u0d85. \u0d9c. \u0218. 320, \u0d89\u0da9\u023c \u026a\u0dc3\u0dca\u0dad\u0dbb \u0dbd\u0dd0\u0250\u0dc3\u0dca\u01b1\u0dc0 \u0218\u017b \u0d85\u0d82\u0d9a 36, \u0d85\u01af\u0dd9\u0259\u0d9a \u0d85\u0d82\u0d9a 1, \u0db4\u01b4 \u0d85\u0d82\u0d9a 1 \u0dc4\u0dcf 2019.06.03 \u01ce\u0db1\u0dd0\u01af \u0d85\u0dc0\u0dc3\u01e6 \u0d9c\u023c \u0218\u0249\u0dd9\u0259 \u0dc3\u026a\u0dc3\u0dca\u0dad\u0dbb\u0dc0 \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0db1\u023c\u0dc0\u0263\u01e6 \u0dc4\u0dcf \u021d\u0db8\u0dcf\u0dab\u0dba\u01e6\u0dd9\u0d9c\u01e6 \u0252\u00fa\u0dad \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca\u0dc0\u0dbd\u0da7 \u0db8\u0dcf\u0250\u023c: 01. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 308 - \u0dba\u0dc4\u01e6\u0d9c\u0dbd\u0dc0\u01ae\u0dad - \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 9.8093 \u0d8b\u01b1\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0263