u0db8\u0d9f \u0db6\u0d9a\u0dca\u0db8\u0dd3\u0dd9\u0d9c\u0ddc\u0dbd\u0dca\u0dbd, \u0d89\u0db6\u0dca\u0db6\u0dcf\u0d9c\u0db8\u0dd4\u0dc0. 2:1 0.0297 \u0db8\u0dd4\u0dc4\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0dbb\u0dd2\u0dba\u0dcf\u0dbd\u0dca \u0db8\u0dd4\u0dc4\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0d85\u0dad\u0dca\u0dad\u0dcf\u0dc3\u0dca 196606610120 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d85\u0d82\u0d9a 49, _ \u0db6\u0daf\u0d9c\u0dd9\u0db1\u0dca, \u0d9a\u0dd4\u0db9\u0dbd\u0dca \u0d85\u0d82\u0d9c, \u0d89\u0db6\u0dca\u0db6\u0dcf\u0d9c\u0db8\u0dd4\u0dc0. \u0db1\u0dcf\u0dbb\u0db8\u0dca\u0dd9\u0db4\u0ddc\u0dbd, \u0dd9\u0dad\u0ddd\u0dbb\u0dba\u0dcf\u0dba, \u0d89\u0db6\u0dca\u0db6\u0dcf\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0db8\u0dd4\u0dad\u0dd4\u0db1\u0dcf\u0dba\u0d9a\u0dd9\u0d9c\u0dca \u0db8\u0d82\u0da2\u0dd4\u0dbd \u0db8\u0dd4\u0dad\u0dd4\u0db1\u0dcf\u0dba\u0d9a \u0db1\u0db8\u0dd2\u0db1\u0dca 2025/03/01 \u0dc3\u0dd2\u0da7 2027/02/28 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0db6\u0daf\u0dd4 \u0daf\u0dd3 \u0d87\u0dad. EOG 06-0229/1",
