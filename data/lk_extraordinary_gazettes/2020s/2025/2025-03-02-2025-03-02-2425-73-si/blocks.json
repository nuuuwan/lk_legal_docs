    "text": "\u0db8\u0dda\u023c \u0dc3\u0db8\u0d9c \u0d87\u0dad\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f 1 \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\u0dda\u024f \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dda\u01e6 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba \u0d9a\u0ddc\u02c1\u0ddc\u0da7 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0dad\u0dd4\u0dc5 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0d91\u0db8 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f 2 \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\u0dda\u024f \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dda\u01e6 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba \u0d9a\u0ddc\u02c1\u0ddc\u0da7 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca \u0daf\u0dda\u0dda\u0dc1\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0d9a\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc3\u0dca\u0dc0\u0dcf\u0dcf\u0db0\u0dd3\u0db1 \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dba\u0db8\u0d9a\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca 3 \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\u0dda\u024f \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dda\u01e6 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba \u0d9a\u0ddc\u02c1\u0ddc\u0da7 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3 \u0dc3\u0d82\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db4\u0dc5\u0db8\u0dd4 \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0db1\u0dcf\u0dcf \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0db1\u0dcf\u0dcf \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0db4\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0d9a \u0dc3\u0d82\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0 \u0d91\u0db8 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f 4 \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\u0dda\u024f \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dda\u01e6 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba \u0d9a\u0ddc\u02c1\u0ddc\u0da7 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0db1 \u0db6\u0dc0\u0dad\u0dca; \u0d85\u0dad\u0dd2\u0dbb\u0dda\u0dda\u0d9a \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0db1\u0dcf\u0dcf \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0db1\u0dcf\u0dcf \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0db4\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0d9a \u0dc3\u0d82\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0 \u0d91\u0db8 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f 5 \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\u0dda\u024f \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dda\u01e6 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba \u0d9a\u0ddc\u02c1\u0ddc\u0da7 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0db1 \u0db6\u0dc0\u0dad\u200d\u0dca\u0dca\ufffd; \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0db1\u0dcf\u0dcf \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0db8\u0dd4\u0dc5\u0dd4 \u0d85\u0db4\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0d9a \u0dc3\u0d82\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0 \u0d91\u0db8 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f 10 \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\u0dda\u024f \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dda\u01e6 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba \u0d9a\u0ddc\u02c1\u0ddc\u0da7 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0db1 \u0db6\u0dc0\u0dad\u200d\u0dca\u0dca\ufffd; \u0db4\u0dc5\u0db8\u0dd4 \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0db1\u0dcf\u0dcf \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0db1\u0dcf\u0dcf \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dc0\u0db8 \u0d9a\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dcf\u0dcf \u0d85\u0db4\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0dd2\u0d9a\u0dcf\u0dcf\u0dc0\u0db1\u0dca \u0dc3\u0d82\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0 \u0d91\u0db8 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f 6 \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\u0dda\u024f \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dda\u01e6 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba \u0d9a\u0ddc\u02c1\u0ddc\u0da7 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0db1 \u0db6\u0dc0\u0dad\u0dca; \u0d85\u0dad\u0dd2\u0dbb\u0dda\u0dda\u0d9a \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0db1\u0dcf\u0dcf \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0db1\u0dcf\u0dcf \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dc0\u0db8 \u0d9a\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dcf\u0dcf \u0d85\u0db4\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0dd2\u0d9a\u0dcf\u0dcf\u0dc0\u0db1\u0dca \u0dc3\u0d82\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0 \u0d91\u0db8 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f 7 \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\u0dda\u024f \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dda\u01e6 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba \u0d9a\u0ddc\u02c1\u0ddc\u0da7 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db4\u0dbb\u0dd2