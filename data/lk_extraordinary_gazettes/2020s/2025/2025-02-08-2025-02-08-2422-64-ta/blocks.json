    "text": "\u0b87\u0baf\u0b99\u0bcd\u0b95\u0bc8\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0bac\u0bc8 \u0b9a\u0b9a\u0bbe\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0bac\u0bad\u0b9a\u0bbf\u0ba9\u0bcd 2023.12.31 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf\u0baf\u0bc1\u0bae\u0bcd 2364/39 \u0b86\u0bae\u0bcd \u0b87\u0baf\u0b95\u0bcd\u0bc8\u0bae\u0bc1\u0bae\u0bcd \u0baa\u0bc8\u0bbe\u0ba3\u0bcd\u0b9f \u0bb2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bab\u0bbe\u0ba9\u0bbf\u0bac\u0bbf\u0bb2\u0bcd IV (\u0b86) \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0bac\u0bbf\u0bb2\u0bcd \u0bab\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 2024.10.29 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf\u0baf\u0bc1\u0bae\u0bcd 2408/10 \u0b86\u0bae\u0bcd \u0b87\u0baf\u0b95\u0bcd\u0bc8\u0bae\u0bc1\u0bae\u0bcd \u0baa\u0bc8\u0bbe\u0ba3\u0bcd\u0b9f \u0b85\u0ba4\u0bbf\u0bb2\u0bbf\u0b9a\u0bb3\u0b9f \u0bb2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bab\u0bbe\u0ba9\u0bbf\u0bac\u0bbf\u0bb2\u0bcd IV (\u0b86) \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0bac\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bae\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bc8\u0bbe\u0baa\u0baf\u0bbe\u0ba9\u0bcd\u0ba9 \u0baa\u0bbf\u0bad\u0b9a\u0ba4\u0b9a \u0b9a\u0b95\u0baa\u0bac\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b9a\u0b95\u0baa\u0bac\u0bbf\u0ba9\u0bcd \u0b85\u0ba4\u0bbf\u0bc8\u0bbe\u0bad\u0baa\u0bcd \u0baa\u0bbf\u0bad\u0b9a\u0ba4\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bbe\u0b95\u0ba4\u0bc8\u0bb3\u0bcd, \u0b91\u0bb3\u0bc3\u0b99\u0bcd\u0b95\u0bc8\u0bc8\u0bb3\u0bcd, \u0b9a\u0b95\u0baa\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9\u0ba4\u0bbe\u0ba9 \u0baa\u0bbe\u0b95\u0ba4\u0bc8\u0bb3\u0bcd, \u0b91\u0bb3\u0bc3\u0b99\u0bcd\u0b95\u0bc8\u0bc8\u0bb0\u0bbe\u0bc8 \u0baa\u0bbf\u0bad\u0bc8\u0b9f\u0ba9\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bab\u0bbe\u0ba9\u0bbf, \u0b85\u0bae\u0bbf\u0bb2\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\u0bc8\u0bb3\u0bcd \u0b87\u0bad\u0ba3\u0bcd\u0b9f\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0b95\u0bc1\u0bae\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb0 \u201c1987 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 15 \u0b86\u0bae\u0bcd \u0b87\u0baf\u0b95\u0bcd\u0bc8 \u0baa\u0bbf\u0bad\u0b9a\u0ba4\u0b9a \u0b9a\u0b95\u0baa \u0b9a\u0b9f\u0bcd\u0b9f\u0bb2\u0bbe\u0b95\u0bcd\u0bc8\u0bbf\u0ba9\u0bcd 24 \u0b86\u0bae\u0bcd \u0b9a\u0bad\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bc1\u0b9f\u0ba9\u0bcd \u0baa\u0bab\u0bbe\u0bb1\u0bbf\u0bac\u0baa\u0bcd\u0baa\u0b9f \u0b9a\u0bb2\u0ba3\u0bcd\u0b9f\u0bbf\u0bac \u0b9a\u0baa\u0bcd\u0baa\u0bbf\u0bad\u0bc8\u0bae\u0bc1\u0bb2 \u0bab\u0bbe\u0bc8\u0bbe\u0bc8 \u0baa\u0bc8\u0bcc\u0bad\u0bb2 \u0bae\u0bc1\u0ba4\u0baf\u0b95\u0bab\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b85\u0bb2\u0bb0\u0bcd\u0bc8\u0bb0\u0bbe\u0bb2\u0bcd 2316/20 \u0b86\u0bae\u0bcd \u0b87\u0baf\u0b95\u0bcd\u0bc8\u0bae\u0bc1\u0bae\u0bcd 2022 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0b9a\u0ba9\u0bb2\u0bbe\u0bbf \u0bab\u0bbe\u0ba4\u0bae\u0bcd 24 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf \u0baa\u0bc8\u0bbe\u0ba3\u0bcd\u0b9f \u0b85\u0ba4\u0bbf\u0bb2\u0bbf\u0b9a\u0bb3\u0b9f \u0bb2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bab\u0bbe\u0ba9\u0bbf\u0bac\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bad\u0b9a\u0bc1\u0bbe\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb0\u0ba4\u0bc1\u201d \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u201c1987 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 15 \u0b86\u0bae\u0bcd \u0b87\u0baf\u0b95\u0bcd\u0bc8 \u0baa\u0bbf\u0bad\u0b9a\u0ba4\u0b9a \u0b9a\u0b95\u0baa \u0b9a\u0b9f\u0bcd\u0b9f\u0bb2\u0bbe\u0b95\u0bcd\u0bc8\u0bbf\u0ba9\u0bcd 24 \u0b86\u0bae\u0bcd \u0b9a\u0bad\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bc1\u0b9f\u0ba9\u0bcd \u0baa\u0bab\u0bbe\u0bb1\u0bbf\u0bac\u0baa\u0bcd\u0baa\u0b9f \u0b9a\u0bb2\u0ba3\u0bcd\u0b9f\u0bbf\u0bac \u0b9a\u0baa\u0bcd\u0baa\u0bbf\u0bad\u0bc8\u0bae\u0bc1\u0bb2 \u0bab\u0bbe\u0bc8\u0bbe\u0bc8 \u0baa\u0bc8\u0bcc\u0bad\u0bb2 \u0bae\u0bc1\u0ba4\u0baf\u0b95\u0bab\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b85\u0bb2\u0bb0\u0bcd\u0bc8\u0bb0\u0bbe\u0bb2\u0bcd 2316/20 \u0b86\u0bae\u0bcd \u0b87\u0baf\u0b95\u0bcd\u0bc8\u0bae\u0bc1\u0bae\u0bcd 2023, \u0b9a\u0ba9\u0bb2\u0bbe\u0bbf 24 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf \u0baa\u0bc8\u0bbe\u0ba3\u0bcd\u0b9f \u0b85\u0ba4\u0bbf\u0bb2\u0bbf\u0b9a\u0bb3\u0b9f \u0bb2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bab\u0bbe\u0ba9\u0bbf\u0bac\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bad\u0b9a\u0bc1\u0bbe\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb0\u0ba4\u0bc1\u201d \u0b8e\u0ba9\u0bcd\u0bae\u0bb2\u0bbe\u0bb1\u0bc1 \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f \u0b9a\u0bb2\u0ba3\u0bcd\u0b9f\u0bc1\u0baa\u0bab\u0ba9\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bc1\u0bae\u0bbf\u0ba4\u0bcd\u0ba4 \u0bb2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bab\u0bbe\u0ba9\u0bbf\u0bac\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bae\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb0 \u0b8f\u0b95\u0ba9\u0bac \u0bb2\u0bbf\u0b9f\u0bac\u0b99\u0bcd\u0bc8\u0bb3\u0bcd \u0bab\u0bbe\u0bb1\u0bcd\u0bae\u0bae\u0bcd \u0baa\u0baa\u0bae\u0bab\u0bbe\u0b9f\u0bcd\u0b9f\u0bbe\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0b95\u0ba4\u0baf\u0bc1\u0bae\u0bcd \u0baa\u0baa\u0bbe\u0ba4\u0bc1\u0bab\u0b95\u0bcd\u0bc8\u0bb3\u0bcd \u0b85\u0bae\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1 \u0baa\u0bc8\u0bbe\u0bb3\u0bcd\u0bb3\u0bc1\u0bae\u0bcd \u0baa\u0baa\u0bbe\u0bb0\u0bc1\u0b9f\u0bcd\u0b9f\u0bc1 \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0b85\u0bae\u0bbf\u0bb2\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bc8\u0bbf\u0ba9\u0bcd\u0bae\u0ba4\u0bc1.",
    "fonts": [
