    "text": "\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0ba3\u0bcd\u1f8a \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0baf\u0b9f\u0bcd\u1f8a\u1f92\u0bb5\u0bb0 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bbe\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0b95\u0bbe\u0ba3 \u0bc7\u0b95\u0bbe\u0bb0\u0bc8\u0bb3\u0baf\u0bbf\u0ba9\u0bcd (\u0baf\u0b9f\u0bcd\u1f8a\u1f92\u0bb5\u0bb0) \u0b87\u0bb2. 204, \u0b95\u0b9f\u0bb5\u0ba4\u0bcd\u0b95\u0bae \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0b9f\u0bb5\u0ba4\u0bcd\u0b95\u0bae \u0b8e\u1f94\u0bae\u0bcd \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0b95\u0b9f\u0bb5\u0ba4\u0bcd\u0b95\u0bae \u0bb0\u0b9c \u0baa\u0bbf\u0bb9\u0bbf\u0bb2\u0bcd\u0bb2 \u0b8e\u0ba9 \u0b85\u0bc8\u0bb4\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd 20.10.2023 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u0bbe\u0bcd \u0ba8\u0bbe\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0bc7\u0ba4\u0b9f\u0bb2\u0bcd \u0b87\u0bb2. Maha/YIN/2023/605 \u0bb5\u0bbf\u0bb2\u0bcd \u1f90\u0ba3\u0bcd\u1f8c A \u0b8e\u0ba9\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe\u0ba4\u0bcd \u1f90\u0ba3\u0bcd\u1f8c\u0b95\u1fa6\u0bae\u0bcd \u0b8f\u1fa8 \u0ba4\u0b9a\u0bae\u0bcd \u0baa\u0ba9\u0bcd\u0ba9\u0bbf\u0bc6\u0bb0\u0ba3\u0bcd\u1f8c \u0bc7\u0baa\u0bbe\u0bcd\u0b9a\u0bcd ( 7.12 \u0bc7\u0baa\u0bbe\u0bcd\u0b9a\u0bcd) \u0b85\u0bb2\u0