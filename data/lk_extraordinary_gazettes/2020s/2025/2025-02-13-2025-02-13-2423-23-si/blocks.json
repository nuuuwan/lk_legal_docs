    "text": "\u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dcf\u0dc0\u0dd4\u0dbd\u0dca \u0db4\u0db1\u0dad - 131 \u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dba\u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dcf\u0dc0\u0dd4\u0dbd\u0dca \u0db4\u0db1\u0dad - 131 \u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dba \u0d85\u0d82\u0d9a 2394/34 \u0daf\u0dbb\u0db1 \u0dc4\u0dcf 2024.07.23 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dd9\u0dba\u0dca \u0db4\u0dc3\u0dd2\u0daf\u0dca\u0db0\u0dd2\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd4 \u0d91\u0d9a\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dc1\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0dc0\u0dc1\u0dd9\u0dba\u0db1\u0dca \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba, \u0d87\u0dbb\u0dd0\u0dc0\u0dca\u0dc0\u0dbd, \u0dc3\u0dd4\u0dc4\u0daf \u0db8\u0dcf\u0dc0\u0dad, \u0d85\u0d82\u0d9a 179/6 \u0d92 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dd9\u0dba\u0dc4\u0dd2 \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d91\u0da0\u0dca. \u0d92. \u0d8b\u0dd9\u0daf\u0dca\u0db1\u0dd2 \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dd2 \u0db8\u0dd2\u0dba \u0dc3\u0dc4 \u0d85\u0dd9\u0db1\u0d9a\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dc1\u0dca\u0dc0\u0dba \u0dc0\u0dc1\u0dd9\u0dba\u0db1\u0dca \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 05, \u0d9a\u0dd2\u0dbb\u0dd4\u0dc5 \u0db4\u0dcf\u0dbb, \u0d85\u0d82\u0d9a 200 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dd9\u0dba\u0dc4\u0dd2 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0db8\u0db1\u0dcf\u0d9c\u0db8\u0db1 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0d85\u0dad\u0dbb \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d8