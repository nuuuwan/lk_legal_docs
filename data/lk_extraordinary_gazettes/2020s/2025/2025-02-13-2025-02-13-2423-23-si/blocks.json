    "text": "\u201c \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0db8\u0db1\u0dcf \u0d9c\u0db8\u0db1 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dd9\u0dba\u0dca \u0dd9\u0dc4\u0ddc\u0dd9\u0dbb\u0ddc\u0dc0\u0dca\u0db4\u0dad\u0dcf\u0db1 \u0da9\u0dd2\u0dd9\u0db4\u0ddd\u0dd9\u0dc0\u0dca \u0dd9\u0dc3\u0dda\u0dc0\u0dba \u0d9a\u0dbb\u0db1 \u0da9\u0db6\u0dca.\u0d85\u0dc3\u0d82\u0d9a \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0db8\u0dba\u0dcf \u0dc3\u0dc4 \u0da9\u0db6\u0dca. \u0d91\u0db8\u0dca. \u0d9a\u0db4\u0dd2\u0dbd \u0dc0\u0dd2\u0dd9\u0da2\u0dca\u0dd9\u0d9a\u0ddd\u0db1\u0dca \u0db8\u0dba\u0dcf \u0dba\u0db1 \u0dd9\u0daf\u0dd9\u0daf\u0db1\u0dcf\u0da7 \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0db8\u0db1\u0dcf \u0d9c\u0db8\u0db1 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dd9\u0dba\u0dca \u0db8\u0dcf\u0db1\u0dc0 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dc5\u0db8\u0dab\u0dcf\u0d9a\u0dbb\u0db1 \u0da0\u0d9a\u0dd9\u0dbd\u0dca\u0d9b \u0db4\u0d9a\u0dcf\u0dbb\u0dc0 2019 \u0dc0\u0dbb\u0dca\u0dc2\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0dad\u0dd2\u0dbb\u0dd2 \u0dc0\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a \u0db1\u0dd2\u0dc0\u0dcf\u0da9\u0dd4 \u0dd9\u0dc0\u0db1\u0dd4\u0dd9\u0dc0\u0db1\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd3\u0daf? \u0d91\u0dd9\u0dc3\u0dda \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd3 \u0db1\u0db8\u0dca \u0d91\u0dba \u0dd9\u0db1\u0ddc\u0dd9\u0d9c\u0dc0\u0dd3\u0db8 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd3 \u0dad\u0dd2\u0dd9\u0db6\u0dca\u0daf \u0dba\u0db1\u0dca\u0db1\u0dad\u0dca \u0d91\u0dd9\u0dc3\u0dda \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc0 \u0dad\u0dd2\u0dd9\u0db6\u0dca \u0db1\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dc4\u0db1 \u0d9a\u0dc0\u0dd9\u0dbb\u0dca\u0daf \u0dba\u0db1\u0dca\u0db1\u0dad\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0