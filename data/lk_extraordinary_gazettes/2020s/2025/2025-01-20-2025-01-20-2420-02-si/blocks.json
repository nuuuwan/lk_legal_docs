    ],
    "text": "\u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dcf\u0dc0\u0dd4\u0dbd\u0dca \u0db4\u0db1\u0dad -131 \u0dc0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dba \u0d85\u0d82\u0d9a 2369/40 \u0daf\u0dbb\u0db1 \u0dc4\u0dcf 2024.02.02 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0dc4\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dcf\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dcf\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0dcf\u0db1\u0dbb\u0da2\u0dcf\u0dba\u0dda \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dba\u0dd9\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dd2\u0daf\u0dca\u0db0\u0dd2\u0dba\u0dba \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd6 , \u0d91\u0d9a\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dd9\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0dc0\u0dd9\u0dba\u0dba\u0dca\u0dad \u0d9a\u0dbd\u0dba\u0d9c\u0da9\u0dd2\u0dba\u0dc4\u0dda\u0db1, \u0dc4\u0dbd\u0dca\u0d9c\u0db8\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba, \u0d85\u0dca\u0dad\u0db1\u0dcf\u0dc3\u0dd2\u0daf\u0dc0\u0dad\u0dca\u0dcf, \u0d85\u0d82\u0d9a 8/4\u0d92 \u0dc4\u0dd2 \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d86\u0dbb\u0dca.\u0db4\u0dd3. \u0d86\u0db1\u0dca\u0dad\u0daf \u0dc3\u0dcf\u0d9c\u0dbb \u0db8\u0dba\u0dcf \u0dc3\u0dc4 \u0d85\u0dba\u0db1\u0d9a\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dd9\u0dca\u0dc0\u0dba \u0dc0\u0dd9\u0dba\u0dba\u0dca\u0dad \u0dba\u0d9a\u0ddc\u0dc5\u0db9 01, \u0da0\u0ddb\u0dcf\u0dba \u0db4\u0dcf\u0dbb, \u0d85\u0d82\u0d9a 19 \u0dc4\u0dd2 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dc0\u0dbb\u0dcf\u0dba \u0d85\u0dd2\u0dba\u0d9a\u0dcf\u0dba \u0dba \u0d85\u0dcf\u0dbb \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dcf\u0dc0\u0dd4\u0dbd \u0dc3\u0db8\u0dca\u0db6\u0dca\u0dad\u0db0\u0dba\u0dba\u0dca\u0dad \u0dba\u0db6\u0dca\u0dbb\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0daf\u0dca\u0dad \u0db8\u0dcf \u0dba\u0dc0\u0dcf \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0d87\u0dad\u0dd2 A 60/2020 \u0daf\u0dbb\u0db1 2023.12.28 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0db1\u0dba \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dca\u0dba\u0dc2\u0dda\u0db4 \u0d9a\u0dbb\u0db1 \u0db6\u0dc0 \u0daf\u0dca\u0dad\u0dc0\u0db8\u0dd2\u0dca\u0dad \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dc0\u0dbb\u0dcf\u0dba \u0d85\u0dd2\u0dba\u0d9a\u0dcf\u0dba \u0dba \u0dba\u0dc0\u0dad\u0dd2\u0dca\u0dad \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dcf\u0dc0\u0dd4\u0dbd\u0dca \u0db4\u0db1\u0dba\u0dad\u0dca 20(1) \u0dba \u0dba\u0dad\u0dca \u0dc0\u0dda\u0dba\u0db1\u0daf\u0db1\u0dba\u0d9a\u0dca \u0db8\u0dcf \u0dba\u0dc0\u0dcf \u0dbd\u0dd0 \u0d87 \u0d87\u0dcf. \u0d91\u0dba\u0dc4\u0dba\u0dd2\u0dca\u0dad \u0d85\u0d82\u0d9a A 60/2020 \u0daf\u0dbb\u0db1 \u0dba\u0db6\u0dca\u0dbb\u0dd4\u0db8\u0dca\u0d9a\u0dcf\u0dbb \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0db1\u0dba \u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0db8 \u0db8 2020.02.02 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0daf \u0d85\u0dc0\u0dc3\u0dca\u0dad \u0dc0\u0db1 \u0db6\u0dc0 \u0db4\u0db1\u0dba\u0dad\u0dca 20(2) (\u0d86) \u0dc0\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dba \u0dba\u0dad\u0dca \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dd9\u0dba \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dba\u0db6\u0dca.",
