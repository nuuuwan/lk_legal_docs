  {
    "page_number": 0,
    "bbox": [
      304.14,
      434.98,
      539.7,
      670.0
    ],
    "text": "01. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 1 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u2013 1796, \u0db8\u0dc4\u0dbb\u0d9c\u0db8 \u0db4\u0dcf\u0dbb; \u0d89\u0da9\u0dd9\u023c \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u00fa. \u018c. \u0dbd\u00fa\u0dc2\u0dca\u0db8\u01e6 \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf, \u0d85\u0d82\u0d9a 672/B5, \u0d87\u025a\u0269\u0dc0\u0dbd, \u0db4\u01e6\u01e7\u0218\u0179\u0dba (\u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0d9a\u0da7\u0252\u01b1 \u0d85\u0dc0\u0dc3\u01e6 \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf); \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0010. 02. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 2 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u2013 \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a, \u0db8\u0dc4\u0dbb\u0d9c\u0db8 \u0db4\u0dcf\u0dbb; \u0d89\u0da9\u0dd9\u023c \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: (\u0218\u0298\u0dba\u01e6\u0daf\u0dc5 \u2014 \u0db8\u0dc4\u0dbb\u0d9c\u0db8 \u0db8\u0dcf\u0259\u0d9c\u0dba \u021a\u029a\u0262 \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u026b \u0d87\u0dad); \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0024. 03. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 3 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u2013 1689, \u0db8\u0dc4\u0dbb\u0d9c\u0db8 \u0db4\u0dcf\u0dbb; \u0d89\u0da9\u0dd9\u023c \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0d92. \u0d92. \u0dd9\u014e. \u0d85\u0db8\u0dbb\u0286\u0d82\u0dc4, \u0d85\u0d82\u0d9a 584/3C, \u0d87\u025a\u0269\u0dc0\u0dbd, \u0db4\u01e6\u01e7\u0218\u0179\u0dba (\u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0d9a\u0da7\u0252\u01b1 \u0d85\u0dc0\u0dc3\u01e6 \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf); \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0007.",
