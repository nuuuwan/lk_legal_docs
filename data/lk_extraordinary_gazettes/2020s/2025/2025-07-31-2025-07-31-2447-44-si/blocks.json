0 5:42 0.0294 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0d89.\u0dc3\u0d82.\u0d86 \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dbd\u0dd2\u0dba\u0db1 \u0dbb\u0dcf\u0dbd\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc3\u0dbb\u0dad\u0dca \u0d9c\u0dd4\u0dab\u0dc0\u0d82\u0dc1 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 507791 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc0\u0d9c\u0dcf\u0d9a\u0dbb \u0d87\u0dad 5:43 0.0253 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0d89.\u0dc3\u0d82.\u0d86 \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc3\u0dd3\u0db8\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0dc3\u0dd4\u0db8\u0dad\u0dd2\u0db4\u0dcf\u0dbd \u0db8\u0dbd\u0dca\u0dbd\u0dd2\u0d9a\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 507801 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc0\u0d9c\u0dcf\u0d9a\u0dbb \u0d87\u0dad 5:44 0.0160 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 04 \u0dc4\u0dd2 \u0d9a\u0da7\u0dca\u0da7\u0dd2\u0d9a\u0dbb\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0d9a\u0dbd \u0dc0\u0dd0\u0da9\u0dd2\u0db4\u0dd4\u0dbb \u0dc0\u0d9c\u0dcf\u0dc0 5:45 0.0896 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0d89.\u0dc3\u0d82.\u0d86 \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dbd\u0dd2\u0dba\u0db1 \u0dbb\u0dcf\u0dbd\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0db1\u0dd2\u0dbd\u0dd6\u0d9a\u0dcf \u0dc3\u0db3\u0db8\u0dcf\u0dbd\u0dd2 \u0d9c\u0dd4\u0dab\u0dc0\u0d82\u0dc1 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 507788 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc0\u0d9c\u0dcf\u0d9a\u0dbb \u0d87\u0dad 5:46 0.