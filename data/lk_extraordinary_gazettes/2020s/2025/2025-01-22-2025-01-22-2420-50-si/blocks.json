    "text": "\u0d8b\u0d9a\u0dca\u0dcf \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dba \u0dba\u0da7\u0dba\u0dda 2022 \u0dba\u0db1\u0dc3\u0dd0 \u0d9a\u0db6\u0dbb\u0dca \u0db8\u0dc3 03 \u0dc0\u0db1 \u0db1 \u0db1 \u0d85\u0d82\u0d9a 2308157 \u0db1\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dcf\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dcf\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0dcf\u0db1\u0dbb\u0da2\u0dcf\u0dba\u0dda \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dba\u0dd9\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda \u0db4\u0dc5\u0d9a\u0dbb\u0db1 \u0dbd\u0db1 \u0db8 \u0dba\u0db8 \u0db4\u0dc5\u0dcf\u0dba\u0dda \u0db8\u0dd9\u0db1\u0dd4\u0dc0\u0dbb \u0db1 \u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0d8b\u0db1\u0dd4\u0db1\u0dd4\u0dc0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dc1\u0dd3\u0dba \u0dba\u0dbd\u0dca \u0db8\u0d9a \u0d9a \u0dba\u0d9a\u0dca\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba\u0dda \u0d85\u0d82\u0d9a 54 - \u0d85\u0dbb\u0dda\u0dcf\u0db1 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0daf\u0dbd \u0dcf \u0d9a \u0dba\u0d9a\u0dca\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba \u0dad\u0dd4\u0dc5 \u0d85\u0dbb\u0dda\u0dcf\u0db1 \u0db1\u0db8\u0dd0\u0dad\u0dd2 \u0d9c\u0dba \u0d9a \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf \u0dc0\u0dd6 \u0db1, \u0d85\u0d82\u0d9a 320344 \u0db1\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0dba \u0d9a \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 01 \u0dc4\u0dd2 \u0db4\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d9a 01 \u0dc4\u0dd2\u0d9a\u0dd0\u0db6\u0dba\u0daf \u0d85\u0d82\u0d9a 34 \u0db1\u0dbb\u0db1 \u0d89\u0da9 \u0d9a \u0dba\u0d9a\u0dca\u0da7\u0dc3 \u0dc3 \u0d9a\u0db6\u0dca\u0dad \u0dba\u0dba\u0dca\u0dad \u0d91\u0dc4\u0dd2 \u0d8b\u0db4\u0dba\u0dbd\u0dca \u0db8\u0d9b\u0db1\u0dba\u0dba\u0dc4\u0dd2; \u201c\u0dc4\u0dd2\u0db8\u0dd2\u0d9a \u0d9a \u0daf\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0db8 \u0d9a\u0dd2 \u0d9a\u0dba \u0d9a \u0dba\u0d9a\u0dca\u0db8\u0dc3\u0dcf\u0daf\u0dd3\u0dc3\u0dca\u0dba\u0dda \u0dad\u0dd3\u0dbb\u0dab \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dd9\u0dba\u0dda \u0dc3\u0db3\u0dd9\u0dca\u0dad\u201d \u201c\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0daf\u0dbd \u0dcf\u0daf\u0dd3 \u0dba\u0d9a\u0dca\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba - \u0d9c\u0da9\u0dbd\u0dcf\u0dba\u0db1\u0dab\u0dd2\u0dba, \u0d9c\u0db8 - \u0d9c\u0da9\u0dbd\u0dcf\u0dba\u0db1\u0dab\u0dd2\u0dba, \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0dba \u0d9a \u0d85\u0d82\u0d9a 320347 \u201d \u0dba\u0dca\u0dad\u0db1 \u0d87\u0dad\u0dd4\u0dc5\u0dda \u0d9a\u0dbb \u0dc3\u0d82\u0dba\u0dd9\u0ddd \u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dba\u0dda \u0db4\u0dd3. \u0dc3\u0dd3. \u0da9\u0dd3. \u0dc3\u0dd2\u0dc1\u0dda\u0dbb\u0dcf, \u0d89\u0da9 \u0d9a \u0dc4\u0dd2\u0db8\u0dd2\u0d9a \u0d9a \u0daf\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0db8 \u0d9a\u0dd2 \u0d9a\u0dba \u0d9a \u0dba\u0d9a\u0dca\u0db8\u0dc3\u0dcf\u0daf\u0dd3\u0dc3\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dbd\u0dca \u0db8. 2024 \u0dba\u0db1\u0dc3\u0dd0 \u0d9a\u0db6\u0dbb\u0dca \u0db8\u0dc3 2\u0dc0 \u0dc0\u0dd0 \u0daf \u0db1 \u0db1, \u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca \u0db8\u0dbd \u0dbb\u0da2\u0dcf\u0db8\u0dbd\u0dca \u0db8\u0dc0\u0dda\u0dcf \u0db4\u0dcf\u0dbb, \u201c\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dcf \u0db8\u0dd0\u0daf\u0dd4\u0dbb\u201d, \u0d85\u0d82\u0d9a 12001\u0dc0, \u0d89\u0da9 \u0d9a \u0dc4\u0dd2\u0db8\u0dd2\u0d9a \u0d9a \u0daf\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0db8 \u0d9a\u0dd2 \u0d9a\u0dba \u0d9a \u0dba\u0db1\u0db4\u0dcf\u0dbb\u0dca\u0dcf\u0dba \u0d9a\u0dca\u0dad\u0dad\u0dd4\u0dba\u0dda \u0daf\u0dd3 \u0dba.",
