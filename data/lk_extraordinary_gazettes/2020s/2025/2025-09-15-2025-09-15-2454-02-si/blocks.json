    "text": "\u0daf\u0d9a\u0dd4\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dd9\u0269 2019 \u0d85\u0d82\u0d9a 06 \u0daf\u0dbb\u0db1 \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u021d\u0da5\u0217\u01af\u0dd9\u024f 2.(4) \u0dc0\u0d9c\u01e6\u01af\u0dd9\u0dba\u01e6 \u0daf\u0d9a\u0dd4\u019f \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u026a\u0dc2\u0dba \u0db7\u0dcf\u0dbb \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0dc0\u0dbb\u0dba\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u0d91\u00fc \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dc0 \u026a\u0288\u025e\u0dc0\u0dcf \u0dc4\u0dd0\u0dbb \u0d87\u01af \u0dd9\u0dc4\u0250\u01e6 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d86\u019c\u018d\u0100\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 154\u0d87. \u0dc0\u0dca\u200d\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0dc0\u01e6 \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0dd9\u0dc4\u0250\u01e6 \u0d91\u00fc \u0db6\u0dbd\u0dad\u0dbd \u021d\u0d9a\u0dcf\u0dbb\u0dc0 \u0daf\u0d9a\u0dd4\u019f \u0db4\u0dc5\u0dcf\u01ae \u0d86\u019c\u018d\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb \u0db8\u01ca\u01d0\u0db8 \u0d9a\u0d82\u0d9a\u0dcf\u0db1\u0db8\u0dbd\u0dcf\u0dd9\u0118 \u0db6\u01e6\u01d0\u0dbd \u0dc4\u025c\u0dc3\u0dca\u0da0\u01e6\u01d6 \u0dc0\u0db1 \u0db8\u0db8, \u0daf\u0d9a\u0dd4\u019f \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0dd9\u0d9a\u0dcf\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0dc3\u0dc4\u0dba \u026b\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u01ae\u0d9a\u0dbb \u0d87\u01ae\u0dad\u0dcf \u026d \u0db4\u0dc4\u0dad \u0daf\u00fa\u0dc0\u0dcf \u0d87\u01af \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u0dba\u028f I \u0dc0\u0dd0\u01e7 \u01b0\u025e\u0dd9\u0269 \u0dc3\u0db3\u0dc4\u01e6 \u0d85\u0dba \u0dd9\u0dc0\u0dad \u0daf\u0d9a\u0dd4\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dd9\u0269 2019 \u0d85\u0d82\u0d9a 06 \u0daf\u0dbb\u0db1 \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u021d\u0da5\u0217\u01af\u0dba \u0dc4\u0dcf \u0d92 \u0dba\u0da7\u0dd9\u01ae \u0db4\u0db1\u0dc0\u0dcf \u0d87\u01af \u025d\u01af \u021d\u0d9a\u0dcf\u0dbb\u0dc0 \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u0dd9\u0d9a\u0dcf\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0dd9\u0dbb\u014f\u0dc3\u0dca\u017e\u0dcf\u0259 \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01ae\u0dad\u0dcf \u026d \u0d91\u00fc \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f III \u0dc0\u0dd0\u01e7 \u01b0\u025e\u0dd9\u0269 \u0dc3\u0db3\u0dc4\u01e6 \u0286\u0dba\u029a\u0db8 \u0db6\u0dbd\u0dad\u0dbd \u0dc4\u0dcf \u0d8b\u00fa\u0dad \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u021d\u0da5\u0217\u01af\u0dd9\u024f \u021b\u0259\u026a\u0d9a\u0dcf\u0dc0 \u0dc3\u0db8\u0d9f \u00fb\u0dba\u0dd9\u0dc0\u0db1 1972 \u0d85\u0d82\u0d9a 05 \u0daf\u0dbb\u0db1 \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u0db4\u0db1\u0dd9\u01ae (\u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u01dd\u0dad) \u0d85\u0db1\u01e9\u0d9a\u0dd6\u0dbd \u0dd9\u0db1\u0dcf\u0d9a\u0dbb\u0db1 \u0dbd\u0daf III \u0dc0\u0dd0\u01e7 \u01b0\u025e\u0dd9\u0269 \u0dc3\u0db3\u0dc4\u01e6 \u0286\u0dba\u029a\u0db8 \u0db6\u0dbd\u0dad\u0dbd \u0d91\u00fc \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f II \u0dc0\u0db1 \u01b0\u025e\u0dd9\u0269 \u0dc3\u0db3\u0dc4\u01e6 \u01ce\u0db1 \u0286\u0da7 \u0dd9\u0db8\u0250\u01e6 \u0db4\u0dc0\u0dbb\u023d.",
