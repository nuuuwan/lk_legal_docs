    "text": "\u0d8b\u0d9a\u0dca\u0dcf \u0dba \u0dbb\u0dca\u0dc2\u0dba \u0dba\u0da7\u0dba\u0dda \u0d85\u0d82\u0d9a 2006/11 \u0dc4\u0dcf 2015.02.13 \u0daf\u0dd2\u0db1 \u0daf\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dcf\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dcf\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0dcf\u0db1\u0dbb\u0da2\u0dcf\u0dba\u0dda \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dba\u0dd9\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda \u0db8\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dad \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0daf\u0dd0\u0dca\u0dad\u0dc0\u0dd3\u0dba\u0db8\u0dc4\u0dd2 \u0d85\u0dda\u0d9a\u0dbb\u0d9c\u0dcf\u0dba\u0dd4\u0dad\u0dd4 \u0d89\u0da9\u0dba\u0db8\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dba\u0dba \u0dba\u0dc4\u0d9a\u0dca. 651.6299 \u0d9a\u0dca \u0dba\u0dbd\u0dc3 \u0daf, \u0d85\u0dda\u0d9a\u0dbb \u0d9c\u0dcf\u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0dd0\u0dba\u0dd2 \u0dc3\u0db3\u0dc4\u0dca\u0dad \u0d89\u0da9\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0d9c\u0db8\u0dc0\u0d9c\u0db8\u0dca\u0dad 1452, 1454, 1455, 1456, 1455 \u0dc4\u0dcf 1480 \u0dba\u0db1 \u0d89\u0da9\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0d9c\u0db8 \u0d85\u0dda\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d9a\u0dd0\u0db6\u0d9c\u0db8 \u0dbd\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dad\u0dd4\u0dba\u0dc0\u0dca\u0dad \u0d89\u0dc0\u0dda\u0d9a\u0dbb\u0db1 \u0db6\u0dc0\u0daf, \u0d91\u0db1\u0db8\u0dca \u0d85\u0dda\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dc1 \u0ddc\u0dc0 \u0db6\u0dc0 \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0dba\u0daf\u0db1\u0dd4 \u0dbd\u0dd0\u0dba\u0db6\u0dca. \u0daf\u0db8\u0dca\u0dc3\u0dbb \u0d9a\u0dbb\u0dd4\u0dba\u0da2\u0dd3\u0dc0 \u0dbd\u0dca\u0dad\u0daf\u0dba\u0dda, \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba \u0dba \u0dba\u0dbd\u0dca\u0d9a\u0db8\u0dca, \u0dba\