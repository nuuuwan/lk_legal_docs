    ],
    "text": "\u0dc3\u0db6\u0dbb\u0d9c\u023f\u0dc0 \u0db4\u0dc5\u0dcf\u0dad \u01b1\u0dc5 \u0218\u028f\u0179 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u026a\u0286\u01e6 \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1 \u0dba\u01e9 \u0dbd\u0db6\u0db1 \u0db8\u0dcf\u0259\u0d9c\u0dc0\u0dbd \u0dc4\u0dcf \u0db4\u017b \u0db8\u0dcf\u0dc0\u01ae\u0dc0\u0dbd \u0dc3\u0dca\u01c2\u0dbb \u0dbd\u00fd\u019f \u0dc4\u0dcf \u0287\u0db8\u0dcf \u0dbd\u00fd\u019f \u00fb\u025d\u0db8 \u0daf, \u0dc3\u0dd0\u0dbd\u0288\u023c \u0218\u0298\u0dd9\u0dba\u0dc5 \u00fb\u025d\u0db8\u0da7 \u0d9a\u0da7\u0252\u01b1 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u026b\u0db8 \u0daf, \u0d92\u0dc0\u0dcf\u0dd9\u0dba\u028f \u0db1\u0dcf\u0db8 \u0dd9\u0262\u0d9b\u0db1\u0dba\u00fa \u0daf\u00fa\u0dc0\u023d\u01e6 \u0daf\u0dd0\u01e6\u026b\u023c \u0db4\u0dc5 \u00fb\u025d\u0dd9\u023c \u0d9a\u0da7\u0252\u01b1 \u0dc3\u0db3\u0dc4\u0dcf, \u0d9a\u0dcf\u0259\u0dba\u0dba \u0db4\u0179\u0db4\u0dcf\u0179 \u01e7\u0dba\u0db8 \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u01e7\u0dd9\u0dba\u02a4\u0d9c \u0db8\u0dcf\u0dbd\u0dcf\u0dc0 2023.01.24 \u01ce\u0db1\u0dd0\u01af \u0d85\u0d82\u0d9a 2316/20 \u0daf\u0dbb\u0db1 \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u0db8\u0135\u01e6 \u021d\u0286\u01ca\u0db0 \u0d9a\u0dbb\u023d\u01e6 \u0dbd\u0db6\u0dcf\u01d0\u01e6 \u0dc0\u0dc3\u0dbb\u0d9a \u0d9a\u0dcf\u0dbd\u0dba \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db4\u0db1\u0dd9\u01ae 24 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (1) \u0dc0\u0db1 \u0d8b\u0db4 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u0dba\u01e6 \u0dc3\u0dc4 223 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u0dba\u01e6 \u0dbd\u0dd0\u022b \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u021d\u0d9a\u0dcf\u0dbb\u0dc0, \u0d91\u00fc \u021d\u0dcf\u0dd9\u01ca\u0275 \u0dc3\u0db7\u0dcf \u0db4\u0db1\u0dd9\u01ae 24 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dc0\u0db1 \u0d9a\u0dcf\u0259\u0dba\u0dba \u0d89\u017b \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 2024.01.24 \u0dc0\u0db1 \u01ce\u0db1 \u0286\u0da7 \u0db8\u0dcf\u0dc3 \u026a\u0286\u0dc4\u0dad\u0dbb\u0d9a \u0dc0\u0dd0\u018b\u01d0\u0dbb \u0d9a\u0dcf\u0dbd\u0dba\u00fa \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0db6\u0dbb\u0d9c\u023f\u0dc0 \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0dd9\u0dc0\u0dad \u0dd9\u0db8\u0250\u01e6 \u0d85\u0dc0\u0dc3\u0dbb \u0dd9\u0daf\u01e9 \u0dbd\u0dd0\u0dd9\u0229.",
