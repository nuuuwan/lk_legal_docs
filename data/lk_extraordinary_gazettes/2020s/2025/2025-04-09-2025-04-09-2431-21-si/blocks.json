    ],
    "text": "\u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013--\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 \u0dc0\u0dd2\u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u0ddd \u0db4\u0dad \u0d85\u0d82\u0d9a\u0dba \u0d89\u0db1\u0dca\u0dd9\u0da2\u0db1\u0dca\u0dc2\u0db1\u0dca \u0dad\u0dc4\u0db1\u0db8\u0dca \u0dd9\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0dc4 \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd\u0dad\u0dca\u0dc0\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dd9\u0d9c\u0dca/\u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dd9\u0dba\u0dca \u0d85\u0dd9\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dcf\u0dd9\u0dc0\u0db1\u0dca \u0d87\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dd9\u0dc3\u0dda \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db1\u0db8/\u0db1\u0db8\u0dca \u0dc3\u0dc4 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u0dc4\u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dc4 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dca \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u0db4\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1:21 0.0286 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 318383 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dd9\u0dc0\u0dca\u0db4\u0dad\u0d89\u0dbb\u0dd9\u0dc4\u0dda\u0db1, \u0dc0\u0dad\u0dd4\u0dd9\u0d9a\u0ddc\u0dc5\u0d9a\u0db1\u0dca\u0daf, \u0d9a\u0dd2\u0dbb\u0dd2\u0db1\u0dca\u0daf, \u0db4\u0dd4\u0dc4\u0dd4\u0dbd\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d85\u0da2\u0db1\u0dca\u0dad\u0dcf \u0da2\u0dd3\u0dc0\u0dbb\u0dcf\u0db1\u0dd2 \u0d9a\u0dd4\u0db8\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3. 1:63 0.1015 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 449/\u0da9\u0dd3/54 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dba\u0da7\u0dd2\u0dba\u0db1, \u0dc0\u0dbd\u0dca\u0db6\u0dd4\u0dc5\u0dd4\u0d9c\u0dc4\u0dd9\u0dc4\u0dda\u0db1, \u0db8\u0db0\u0dd4\u0dc2\u0dcf\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dc3 \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d85\u0db1\u0dca\u0daf\u0dcf \u0dd9\u0dc4\u0dda\u0db1\u0dd9\u0d9c\u0dca \u0d86\u0dbb\u0dd2\u0dba\u0dd9\u0dc3\u0dda\u0db1 \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3. 1:73 0.0505 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 357654 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0d85\u0d82\u0d9a 693/15/2, \u0dc0\u0dbd\u0dca\u0db6\u0dd4\u0dc5\u0dd4\u0d9c\u0dc4\u0dd9\u0dc4\u0dda\u0db1, \u0db4\u0dd4\u0dc4\u0dd4\u0dbd\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0dba\u0da7\u0dd2\u0dba\u0db1 \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da7\u0dcf\u0daf\u0dd6\u0dc0 \u0d9c\u0db8\u0dd9\u0d9c\u0dca \u0d9c\u0dba\u0dcf\u0db1\u0dca \u0d85\u0db1\u0dd4\u0dc2 \u0dba\u0db1 \u0d85\u0dba \u0db6\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3 1:84 0.1439 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 050380 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db8\u0dbd\u0dca\u0dbd\u0dc0 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dd9\u0d9c\u0dca \u0dc3\u0dd2\u0dc3\u0dd2\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3 1:91 0.1633 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 357653 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db1\u0dd4\u0d9c\u0dd9\u0dc3\u0dc0\u0db1, \u0dc0\u0dbd\u0dca\u0db6\u0dd4\u0dc5\u0dd4\u0d9c\u0dc4\u0dd9\u0dc4\u0dda\u0db1, \u0db4\u0dd4\u0dc4\u0dd4\u0dbd\u0dca\u0dd9\u0dc4\u0dda\u0db1,\u0dba\u0da7\u0dd2\u0dba\u0db1 \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dc0\u0dd2\u0dad\u0dcf\u0dbb\u0dab\u0dd9\u0d9c\u0dca \u0dc3\u0dd3\u0dbd\u0dc0\u0dad\u0dd3 \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3 1:96 0.1148 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 357652 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0d89\u0dc4\u0dbd\u0dd9\u0d9c\u0daf\u0dbb\u0dd9\u0dc4\u0dda\u0db1 \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dd9\u0dc4\u0dda\u0dc0\u0dcf \u0dad\u0dd4\u0dba\u0dd2\u0d85\u0db4\u0dca\u0db4\u0dd4 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dd9\u0d9c\u0dca \u0db1\u0dd2\u0dc1\u0dcf\u0db1\u0dca\u0dad\u0dd2 \u0dba\u0db1 \u0d85\u0dba \u0db6\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3 1:98 0.1708 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 50388 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc0\u0dbd\u0dca\u0db6\u0dd4\u0dc5\u0dd4\u0d9c\u0dc4\u0dd9\u0dc4\u0dda\u0db1 \u0dba\u0da7\u0dd2\u0dba\u0db1 \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dd9\u0d9a\u0ddc\u0d82\u0da9\u0dcf\u0dbb\u0db9\u0dd9\u0d9c\u0dca \u0dad\u0dd4\u0dc2\u0dcf\u0dbb \u0db4\u0dd2\u0dba\u0daf\u0dbb\u0dca\u0dc1\u0db1 \u0dba\u0db1 \u0d85\u0dba \u0db6\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3 EOG 04-0065/1",
