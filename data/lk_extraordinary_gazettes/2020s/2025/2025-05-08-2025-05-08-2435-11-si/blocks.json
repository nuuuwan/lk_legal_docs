    "text": "\u0dbd\u0db6\u0dcf\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dba\u0db4\u0ddc\u0dba\u0dbb\u0ddc\u0dda\u0dad\u0dd4\u0dc0\u0db1 \u0d89\u0da9\u0dba\u0db8\u0dca/\u0db4\u0dbb\u0dc0\u0dd9\u0dcf\u0dcf\u0dba\u0dc0\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb : \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dba\u0dda, \u0d9a\u0dd1\u0d9c \u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0d85\u0dbb\u0dab\u0dcf\u0dba\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba\u0dba \u0dba \u0d9a\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba\u0dda, \u0d9c\u0dca\u0dad\u0dc4\u0dcf \u0db4\u0dc5\u0dcf\u0dcf \u0dc5\u0dd4\u0dc5\u0dd4 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba\u0dda \u0d85\u0d82\u0d9a 45\u0da9\u0dd3, \u0db1\u0dcf\u0dbb\u0d82\u0d9c\u0db8\u0dca\u0db8\u0db1 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba\u0dda, \u0db1\u0dcf\u0dbb\u0d82\u0d9c\u0db8\u0dca\u0db8\u0db1 \u0d9c\u0dba\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc3\u0dbb\u0dca\u0dba\u0dc0\u0dca\u0dba\u0dbb\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dad 2025.02.11 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0db8\u0dca \u0d85\u0d82\u0d9a 610383 \u0db4\u0dd2\u0db9\u0dd4\u0dba\u0dbb\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 01 \u0dc0\u0dd9\u0dba\u0dba\u0dca\u0dad \u0dba\u0db4\u0dca\u0dad\u0db1\u0dd4\u0db8\u0dca \u0d9a\u0dbb \u0dad\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dba\u0dca\u0dad \u0dba\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.1035\u0d9a\u0dca \u0db4\u0db8\u0dab \u0dc0\u0dd6 \u0d85\u0db9\u0dba\u0daf\u0dab\u0dd2\u0dba \u0d9c\u0dd0\u0dc0\u0dd2\u0dbd\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0