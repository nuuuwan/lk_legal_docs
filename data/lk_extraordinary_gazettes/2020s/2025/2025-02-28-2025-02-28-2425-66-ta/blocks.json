e\u1fa8\u1fb7\u0ba4\u0bbf\u1fbf \u0b87\u1f9e \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0b95\u0bb3\u0bbe\u0b95 \u0b8e\u0ba9\u1fb0\u1f81 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb0\u1f81\u1fbb \u0baa\u1f8a\u1f9c\u1fbb \u0b87\u1fb7\u0ba4\u0bbe\u1fbf \u0bc7\u0b95\u1fb5\u1f8c\u1fb0 \u0bc6\u0b95\u0bbe\u1fc0\u0bb3\u1fba\u0baa\u1f8c\u0b95\u0bbf\u1fb9\u0bb1\u0ba9\u1fbd. \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc8\u0baf \u0b89\u1fa0\u0ba4\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u1f90\u0bb5\u0ba4\u1fbe\u1f81 \u0b85\u0bb5\u0b9a\u0bbf\u0baf\u0bae\u0bbe\u0ba9 \u0b85\u0bc8\u0ba9\u1fb7\u1f90 \u0b95\u0bbe\u0ba3\u0bbf \u0b89\u1fa0\u0ba4\u0bbf\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bb0\u1fb1\u0b95\u1fc0 \u0bae\u1fbe\u1fa0\u1fbb \u0bc7\u0bae\u0bb2\u0ba4\u0bbf\u0b95 \u0b86\u0bb5\u0ba3\u1fb1\u0b95\u1fc0 \u0baa\u0bbe\u0bc0\u1fb5\u0bc8\u0b9a\u0baf\u0bbf\u1fb9\u0bc7\u0baa\u0bbe\u1f90 \u1f99\u1fb9\u0bc8\u0bb5\u1fb0 \u0b95\u1fba\u0baa\u1f8c\u0ba4\u1fbf \u0bc7\u0bb5\u1fb6\u1f8c\u1fbb.",
