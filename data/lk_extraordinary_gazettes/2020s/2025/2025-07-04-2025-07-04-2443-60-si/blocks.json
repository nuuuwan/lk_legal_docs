    "text": "\u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f I \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dda\u0dda \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda\u024f \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2, \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f II \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dda\u0dda \u0d8a\u0da7 \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dd9\ufffd\u0dc4\u0dd2 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc0\u0db1 \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0d91\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0d9c\u0dda\u0118 \u0db1\u0db8\u0dca \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0db1 \u0db6\u0dc0 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229. \u0db8\u0dd9\ufffd\u0db8 \u0db1\u0db8\u0dca 2025.06.27 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2442/60 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba, 2025.06.20 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2441/55 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba, 2025.06.13 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0