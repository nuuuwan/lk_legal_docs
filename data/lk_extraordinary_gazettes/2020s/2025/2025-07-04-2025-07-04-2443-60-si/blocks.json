    "text": "\u0d92. \u0dc2\u0db1\u0dca\u0db8\u0dd4\u0d9c\u0db1\u0dcf\u0dcf\u0daf\u0db1\u0dca, \u0db8\u0dc4\u0dcf\u0dcf\u0da0\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0db8\u0db1\u0dca \u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a, \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a, \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a, \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0. \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0. 2025 \u200d\u200d \u0da2\u0dd6\u0dbd\u0dd2 \u0db8\u0dc3 04 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba,\u0dc3\u0dbb\u0dab \u0db8\u0dcf\u0dcf\u0dc0\u0dad,\u0dbb\u0dcf\u0dcf\u0da2\u0d9c\u0dd2\u0dbb\u0dd2\u0dba.",
