    "text": "\u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba 2 \u0d8c\u0dc0 \u0db4\u0dc5\u0dcf\u0dd9\u0dad\u0dca, \u0dd9\u0db8\u0ddc\u0db1\u0dbb\u0dcf\u0d9c\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca, \u0dad\u0dab\u0db8\u0dbd\u0dca\u0dc0\u0dd2\u0dbd \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca \u0dd9\u0d9a\u0ddd\u0db1\u0dca\u0d9c\u0dbd \u0db6\u0dd2\u0db1\u0dca\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0dd9\u0d9a\u0ddd\u0dbb\u0dd9\u0dc5\u0dda \u0dc3\u0dd4\u0dc5\u0dd4 \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dd9\u0dc0\u0dd9\u0dc4\u0dbb\u0db8\u0d82\u0d9a\u0da9 \u0d9c\u0dd9\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0d85.\u0db7\u0dd6.\u0db4\u0dd2. 67, \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dd2\u0db9\u0dd4\u0dbb\u0dd4 \u0d85\u0d82\u0d9a 62, \u0db4\u0dad \u0d85\u0d82\u0d9a 60 \u0dc4\u0dd2 \u0daf\u0dd0\u0d9a\u0dca\u0dd9\u0dc0\u0db1 \u0d89\u0da9\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1562 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0d9a\u0ddc\u0da7\u0dd9\u0dc0\u0dd9\u0dc4\u0dbb\u0db8\u0d82\u0d9a\u0da9 \u0d9a\u0dd0\u0dd9\u0dc5\u0dda; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca 230.0596. \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d89\u0da9\u0db8\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8\u0dca \u0dd9\u0dc4\u0ddd \u0dd9\u0dc0\u0db1\u0dad\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dd9\u0daf\u0db1\u0dcf\u0db8 \u0dad\u0db8 \u0dad\u0db8\u0db1\u0dca \u0dd9\u0dc4\u0ddd \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dd9\u0d9c\u0dca \u