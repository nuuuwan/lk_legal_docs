    ],
    "text": "\u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dba\u0dda, \u0d9a\u0dd1\u0d9c\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0d85\u0dbb\u0db1\u0dcf\u0dba\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba \u0dba \u0dba\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba\u0dda, \u0d9c\u0dca\u0dad\u0dc4\u0dcf \u0db4\u0dc5\u0dcf\u0dcf \u0dc3\u0dd4\u0dc5\u0dd4 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba\u0dda \u0d85\u0d82\u0d9a 47\u0da9\u0dd3, \u0d9a\u0dbd\u0dd4\u0d9c\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0dbb\u0dcf\u0dbb\u0dd2 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba\u0dda, \u0d9a\u0dbd\u0dd4\u0d9c\u0dbd \u0d9c\u0dba\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc3\u0dbb\u0dca\u0dba\u0dc0\u0dca\u0dba\u0dbb\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dad 2024.08.08 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0db8\u0dca \u0d85\u0d82\u0d9a 610395 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 01, 02, 03, 04, 05, 06, 07, 08, 09 \u0dc4\u0dcf 10 \u0dc0\u0dd9\u0dba\u0dba\u0dca\u0dad \u0dba\u0db4\u0dca\u0dad\u0db1\u0dd4\u0db8\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dba\u0dba\u0dba\u0dca\u0dad \u0dba\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 10.7207 \u0d9a\u0dca \u0db4\u0db8\u0dba \u0dc0\u0dd6 \u0dba\u0daf\u0db6\u0dda\u0d9c\u0db8\u0dc0\u0dda\u0dcf (\u0d9a\u0dbd\u0dd4\u0d9c\u0dbd) \u0dba\u0d9a\u0ddc\u0da7\u0dc3 \u0db1\u0db8\u0dd0\u0dad\u0dd2 \u0d89\u0da9\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca :",
