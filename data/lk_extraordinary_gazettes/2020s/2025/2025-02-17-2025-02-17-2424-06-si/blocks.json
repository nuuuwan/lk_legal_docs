    "text": "\u0db8\u0dc4\u0dcf \u0dc0\u0dd2\u0dc4\u0dcf\u0dbb\u0dc0\u0d82\u0dc1\u0dd2\u0d9a \u0dc1\u0dca\u200d\u0dba\u0dcf\u0dd9\u0db8\u0ddd\u0db4\u0dcf\u0dbd\u0dd3 \u0db8\u0dc4\u0dcf \u0db1\u0dd2\u0d9a\u0dcf\u0dd9\u0dba\u0dca \u0dc1\u0dd3 \u0dd9\u0dbb\u0ddc\u0dca\u0dc4\u0dab \u0db8\u0dc4\u0dcf \u0dc3\u0d82\u0d9d \u0dc3\u0db7\u0dcf\u0dd9\u0dc0\u0dca 40 \u0dc0\u0db1 \u0d8b\u0db4\u0dc3\u0db8\u0dca\u0db4\u0daf\u0dcf \u0db8\u0dd9\u0dc4\u0ddd\u0dad\u0dca\u0dc3\u0dc0\u0dba\u0db8\u0dc4\u0dcf \u0dc0\u0dd2\u0dc4\u0dcf\u0dbb\u0dc0\u0d82\u0dc1\u0dd2\u0d9a \u0dc1\u0dca\u200d\u0dba\u0dcf\u0dd9\u0db8\u0ddd\u0db4\u0dcf\u0dbd\u0dd3 \u0db8\u0dc4\u0dcf \u0db1\u0dd2\u0d9a\u0dcf\u0dd9\u0dba\u0dca \u0dc1\u0dd3 \u0dd9\u0dbb\u0ddc\u0dca\u0dc4\u0dab \u0db8\u0dc4\u0dcf \u0dc3\u0d82\u0d9d \u0dc3\u0db7\u0dcf\u0dd9\u0dc0\u0dca 40 \u0dc0\u0db1 \u0d8b\u0db4\u0dc3\u0db8\u0dca\u0db4\u0daf\u0dcf \u0db8\u0dd9\u0dc4\u0ddd\u0dad\u0dca\u0dc3\u0dc0\u0dba \u0db8\u0dcf\u0dad\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca, \u0db8\u0dcf\u0dad\u0dbb \u0d9a\u0da9\u0dc0\u0dad\u0dca\u0dc3\u0dad\u0dbb \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca \u0dc1\u0dd3 \u0dd9\u0dbb\u0ddc\u0dca\u0dc4\u0dab \u0db8\u0dc4\u0dcf \u0dc3\u0d82\u0d9d \u0dc3\u0db7\u0dcf\u0dd9\u0dc0\u0dca 40 \u0dc0\u0db1 \u0d8b\u0db4\u0dc3\u0db8\u0dca\u0db4\u0daf\u0dcf \u0db8\u0dd9\u0dc4\u0ddd\u0dad\u0dca\u0dc3\u0dc0\u0dba 2025 \u0dc0\u0dd6 \u0d85\u0dd9\u0db4\u0dda\u0dbd\u0dca \u0db8\u0dc3 18, 19 \u0dc4\u0dcf 20 \u0dba\u0db1 \u0daf\u0dd2\u0db1\u0dba\u0db1\u0dca \u0dc4\u0dd2 \u0dc1\u0dd3 \u0dd9\u0dbb\u0ddd\u0dc4\u0dab \u0dc3\u0d82\u0d9d \u0dc3\u0db7\u0dcf\u0dd9\u0dc0\u0dca \u0d8b\u0db4\u0dc3\u0db8\u0dca\u0db4\u0daf\u0dcf \u0db8\u0dd6\u0dbd\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0dc0\u0db1 \u0db8\u0dcf\u0dad\u0dbb \u0dd9\u0d9a\u0ddc\u0da7\u0dd4\u0dd9\u0dc0\u0dca\u0dd9\u0d9c\u0ddc\u0da9 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dbb\u0db1\u0dca\u0daf\u0dd6\u0db4\u0dad \u0d8b\u0dd9\u0db4\u0ddd\u0dc3\u0dae\u0dcf\u0d9c\u0dcf\u0dbb \u0db8\u0dc4\u0dcf \u0dc0\u0dd2\u0dc4\u0dcf\u0dbb\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dd9\u0dba\u0dca \u0dc3\u0dd3\u0db8\u0dcf \u0db8\u0dcf\u0dbd\u0d9a\u0dd9\u0dba\u0dca \u0daf\u0dd3 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dd9\u0dc0\u0db1 \u0db6\u0dc0\u0dad\u0dca, \u0d91\u0db8 \u0d8b\u0dad\u0dca\u0dc3\u0dc0\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dd0\u0db8\u0dd2\u0dd9\u0dab\u0db1 \u0dc0\u0db1\u0dca\u0daf\u0db1\u0dcf\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0da7 \u0db4\u0dca\u0dbd\u0dcf\u0dc3\u0dca\u0da7\u0dd2\u0d9a\u0dca \u0dc4\u0dcf \u0dd9\u0db4\u0ddc\u0dbd\u0dd2\u0dad\u0dd3\u0db1\u0dca \u0d86\u0dc1\u0dd2\u0dad \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0dbb\u0dd0\u0dd9\u0d9c\u0db1 \u0d92\u0dd9\u0db8\u0db1\u0dca \u0dc0\u0dc5\u0d9a\u0dd2\u0db1 \u0dd9\u0dbd\u0dc3, 1991 \u0d94\u0d9a\u0dca\u0dd9\u0dad\u0ddd\u0db6\u0dbb\u0dca \u0db8\u0dc3 14 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0db4\u0d9a\u0dcf\u0dc1\u0dd2\u0dad \u0d91\u0dbd\u0dca. \u0da9\u0dd3. \u0db6\u0dd3. 11/60 \u0daf\u0dbb\u0db1 175 \u0dc0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dba \u0dc0\u0db1 \u0dc0\u0db1\u0dca\u0daf\u0db1\u0dcf \u0d9c\u0db8\u0db1\u0dca \u0d86\u0da5\u0dcf\u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0daf\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db4\u0d9a\u0dcf\u0dbb\u0dc0 \u0db4\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca\u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3. \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba \u0db8\u0dd2\u0db1\u0dca \u0db4\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db1\u0dd2\u0dad\u0dca\u200d\u0dba \u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0d9c \u0dc4\u0dcf \u0dd9\u0dbb\u0d9c\u0dd4\u0dbd\u0dcf\u0dc3\u0dd2 \u0d8b