    "text": "\u0d91\u0db8 \u0db4\u0db1\u0dad\u0dda\u01ae 20 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb \u0dc0, \u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0db6\u0dbd\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd6 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0daf\u0dd2\u0db1 30\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db8\u0dc4 \u0db6\u0dd0\u0d82\u0d82\ufffd\u0d9a\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dc5 \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0d9a\u0dcf\u0dcf\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0d85\u0daf\u0dca\u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dc3\u0dd2\u0d9a\u0dbb\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dda\ufffd\u0dc2\u0db1\u0dca \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc6\u0dd2\u0db1\u0dd1\u0dd1\u0db1\u0dca\u0dc3\u0dca\u0dca \u0db4\u0dd3.\u0d91\u0dbd\u0dca.\u0dc3\u0dd3. \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda\u024f \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0db8 \u0dc0\u0dad\u0dca\u0d9a\u0db8\u0dca \u0dc3\u0dc4 \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0d9a\u0dca \u0dc3\u0d9a\u0dc3\u0dcf\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dba.",
