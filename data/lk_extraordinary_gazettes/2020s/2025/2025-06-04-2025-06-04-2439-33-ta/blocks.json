    "text": "\u0bb5\u0b9f \u0bae\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0bbe\u0b9f\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf \u0b86\u0ba3\u0bc8\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0b9f\u0baa\u0bbf\u0bb3\u0bcd\u0baf\u0bc2.\u0b8e\u0bae\u0bcd.\u0bb0\u0bc1\u0bb5\u0ba9\u0bcd \u0bb5\u0bbf\u0b9c\u0bc7\u0b9a\u0bbf\u0b99\u0bcd\u0bcd\u0b95\u0bb9 \u0b86\u0b95\u0bbf\u0baf \u0ba8\u0bbe\u0ba9\u0bcd, 2012 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 22 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd \u0b89\u0b9f\u0bc8\u0baf \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0bbe\u0b9f\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf \u0bae\u0ba9\u0bcd\u0bcd\u0bb1\u0b99\u0bcd\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0ba9 \u0ba4\u0bc7\u0bb0\u0bcd\u0bcd\u0ba4\u0bb2\u0bcd\u0bcd\u0b95\u0bb3\u0bcd (\u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0baf) \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0baf 262 \u0b86\u0bb5\u0ba4\u0bc1 \u0b85\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0baf\u0bbe\u0baf\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0bbe\u0b9f\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf \u0bae\u0ba9\u0bcd\u0bcd\u0bb1 \u0ba4\u0bc7\u0bb0\u0bcd\u0bcd\u0ba4\u0bb2\u0bcd\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0b9f\u0bcd\u0bcd\u0b9f\u0bb3\u0bc8\u0b9a\u0bcd\u0bcd\u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd 66\u0b87 \u0b86\u0bb5\u0ba4\u0bc1 \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b8e\u0ba9\u0b95\u0bcd\u0bcd\u0b95\u0bb3\u0bbf\u0b95\u0bcd\u0bcd\u0b95\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bcd\u0bb3 \u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0b99\u0bcd\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0bbe\u0bb0\u0bae\u0bcd \u0bb5\u0b9f \u0bae\u