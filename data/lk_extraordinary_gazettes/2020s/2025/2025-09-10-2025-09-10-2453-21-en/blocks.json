    "bbox": [
      302.35,
      473.08,
      541.75,
      533.13
    ],
    "text": "All persons interested in the aforesaid lands are hereby required to appear personally or by agent duly authorized in writing, before me at Divisional Secretariat, Maharagama on the date of 29th October, 2025 at 10.00 a.m.",
    "fonts": [
      "Times New Roman"
    ],
    "sizes": [
      9.960000038146973,
      15.960000038146973
    ]
