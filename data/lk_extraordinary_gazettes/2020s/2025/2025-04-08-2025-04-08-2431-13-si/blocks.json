    "text": "\" \u0dc0\u0dc3\u0dbb 05\u0d9a \u0dc3\ufffd\u0dda\u0dc0\u0dcf \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8\u0d9a\u0dca \u0dba\u0da7\u0dad\u0dda \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0db1\u0dca \u0d91\u0dba\u0dcf\u0dbb\u0dca\u0dbd\u0dba\u0dd2\u0db1\u0dca\u0dc3\u0dca \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca \u0dc0\u0dd9\u0dad \u0d9a\u0db4\u0dd2\u0dad\u0dcf\u0db1\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0dc3\ufffd\u0dda\u0dc0\u0dba\u0da7 \u0db6\u0dd0\u0daf\u0dd4\u0dab\u0dd4 \u0d86\u0dbb\u0dca. \u0dbb\ufffd\u0ddc\u0dc4\u0dd2\u0dad\u0dca \u0da0\ufffd\u0dde\u0db0\u0dbb\u0dd2 \u0dc3\u0dc4 \u0dbb\u0dcf\u0da2\u0dda\u0dc2\u0dca \u0d9a\u0dda. \u0db1\u0dcf\u0dbb\u0dcf\u0db1\u0dca\u0d9c\u0dca \u0dba\u0db1 \u0d85\u0dba 2020.04.01 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 2021.01.13 \u0daf\u0dd2\u0db1 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d9a\u0dcf\u0dbd\u0dc3\u0dd3\u0db8\u0dcf\u0dc0 \u0dad\u0dd4\u0dc5 \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dbb\u0dca\u0dba \u0db1\u0dd2\u0dc0\u0dcf\u0da9\u0dd4 \u0dba\u0dd0\u0dc0\u0dd3\u0db8 \u0db1\u0dd3\u0dad\u0dca\u200d\u0dba\u0dcf\u0db1\u0dd4\u0d9a\u0dd6\u0dbd \u0dc0\u0dda\u0daf \u0d91\u0db8 \u0d9a\u0dcf\u0dbd\u0dc3\u0dd3\u0db8\u0dcf\u0dc0\u0da7 \u0d85\u0daf\u0dcf\u0dc5\u0dc0 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc4\u0dcf \u0dc3\ufffd\u0dda\u0dc0\u0dcf \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8\u0dda \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0daf\u0dd3\u0db8\u0db1\u0dcf \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0dc4\u0dd2\u0db8\u0dd2 \u0daf \u0dba\u0db1\u0dca\u0db1\u0dad\u0dca \u0d91\u0dc3\ufffd\u0dda \u0dc4\u0dd2\u0db8\u0dd2\u0db1\u0db8\u0dca \u0d91\u0dba \u0db1\ufffd\u0ddc\u0d9c\u0dd9\u0dc0\u0dd3\u0db8 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd3 \u0dad\u0dd2\u0db6\u0dda \u0daf \u0dba\u0db1\u0dca\u0db1\u0dad\u0dca \u0d91\u0dc3\ufffd\u0dda \u0d85\u0dc3\u0dcf\u