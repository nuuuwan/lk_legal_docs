    ],
    "text": "\u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (\u0d85) \u0d85\u01b1\u025e \u026a\u0db0\u0dcf\u0db1\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dbd 2022 \u0d85\u0d82\u0d9a 53 \u0daf\u0dbb\u0db1 \u0d86\u0da5\u0dcf\u0dd9\u0269 \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 72 \u028f \u0daf\u0d9a\u0dd4\u019f \u0db8\u0dcf\u0250\u0db8 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 65 \u0dc3\u0dc4 72 \u0dba\u01e6\u0db1 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 65 \u0dc3\u0dc4 69 \u0dd9\u0dbd\u0dc3\u0daf, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 73 \u028f \u0daf\u0d9a\u0dd4\u019f \u0db8\u0dcf\u0250\u0db8 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 65 \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 69 \u0dba\u01e6\u0db1. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 65 \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 72 \u0dd9\u0dbd\u0dc3\u0daf, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 105 \u028f \u0db6\u0da7\u028f\u0dbb \u0db8\u0dcf\u0250\u0db8 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 86 \u0dba\u01e6\u0db1 \u0dbb\u0da2\u0dd9\u024f \u0dd9\u0dc4\u0dda\u0db1 \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 86 \u0dd9\u0dbd\u0dc3\u0daf, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 203 \u028f \u0db6\u0da7\u028f\u0dbb \u0db8\u0dcf\u0250\u0db8 \u0da2\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dd9\u024f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dc3\u0dc4 \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u0dbb \u0dba\u01e6\u0db1, \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u0dbb \u0dc3\u0dc4 \u0da2\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dd9\u024f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dd9\u0dbd\u0dc3\u0daf \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 227 \u028f \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u00fb\u0249\u0dbd\u0dd1\u0dc0\u0d9a\u0dd0\u0dd9\u0262 \u0dba\u01e6\u0db1 \u0db1\u0db8 \u0dc3\u0db3\u0dc4\u01e6 \u0dd9\u0db1\u02a3\u0dd9\u0269 \u0dd9\u0dbd\u0dc3\u0daf \u0daf\u0d9a\u0dd4\u019f \u0db8\u0dcf\u0250\u0db8 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 229,228, \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u0dbb \u0dc3\u0dc4 \u0da2\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dd9\u024f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dba\u01e6\u0db1, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 229, \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u0dbb, \u0da2\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dd9\u024f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 228 \u0dd9\u0dbd\u0dc3\u0daf, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 228 \u028f \u0db6\u0da7\u028f\u0dbb \u0db8\u0dcf\u0250\u0db8 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 223 \u0dc3\u0dc4 \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u0dbb \u0dba\u01e6\u0db1, \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u0dbb \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 223 \u0dd9\u0dbd\u0dc3\u0daf, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 238 \u028f \u0db6\u0da7\u028f\u0dbb \u0db8\u0dcf\u0250\u0db8 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 230,237.236,235,234, 233, 247 \u0dc0\u0dd0\u01e7 \u022a\u023c \u0d9a\u0dd0\u0db6\u0263, \u0da2\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dd9\u024f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dc3\u0dc4 \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u0dbb \u0dba\u01e6\u0db1, \u0da2\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dd9\u024f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u0dbb, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 230, 237, 236, 235, 234, 233 \u0dc3\u0dc4 247 \u0dd9\u0dbd\u0dc3\u0daf \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 239 \u028f \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u00fb\u0249\u0dbd\u0dd1\u0dc0\u0d9a\u0dd0\u0dd9\u0262 \u0dba\u01e6\u0db1 \u0db1\u0db8 \u0dc3\u0db3\u0dc4\u01e6 \u0dd9\u0db1\u02a3\u0dd9\u0269 \u0dd9\u0dbd\u0dc3\u0daf \u0daf\u0d9a\u0dd4\u019f \u0db8\u0dcf\u0250\u0db8 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 238 \u0dc3\u0dc4 \u0da2\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dd9\u024f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dba\u01e6\u0db1, \u0da2\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dd9\u024f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 238 \u0dd9\u0dbd\u0dc3\u0daf, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 240\u028f \u0daf\u0d9a\u0dd4\u019f \u0db8\u0dcf\u0250\u0db8 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 239, \u0da2\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dd9\u024f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dc3\u0dc4 \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u0dbb \u0dba\u01e6\u0db1, \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u0dbb, \u0da2\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dd9\u024f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 239 \u0dd9\u0dbd\u0dc3 \u0daf \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 252 \u028f \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb \u0db8\u0dcf\u0250\u0db8 \u0db8\u0262\u0dc0\u01b1\u0d94\u0dd9\u024f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dc4\u0dcf \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u025e \u0dba\u01e6\u0db1, \u0db8\u0262\u0dc0\u01b1\u0d94\u0dd9\u024f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dc3\u0dc4 \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u0dbb \u0dd9\u0dbd\u0dc3\u0daf \u0daf\u0d9a\u0dd4\u019f \u0db8\u0dcf\u0250\u0db8 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 241,242,243,244, 249, 250, 251 \u0dc3\u0dc4 215, \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u025e \u0dba\u01e6\u0db1, \u0dbb\u0da2\u0dd9\u024f \u0d9a\u0dd4\u0249\u0dbb, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 241, 242, 243, 244, 249, 250,2 51 \u0dc3\u0dc4 215 \u0dd9\u0dbd\u0dc3\u0daf, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 254 \u028f \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb \u0db8\u0dcf\u0250\u0db8 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 99 \u0dba\u01e6\u0db1 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 99 \u0dc3\u0dc4 \u0dbb\u0da2\u0dd9\u024f \u0dbd\u01ff \u0d9a\u0dd0\u0dbd\u0dba \u0dd9\u0dbd\u0dc3 \u0daf, \u01e7\u0dc0\u0dd0\u0dbb\u01ce \u026a\u0dba \u0252\u01b1 \u0db6\u0dc0 \u0d