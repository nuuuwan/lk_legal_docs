  },
  {
    "page_number": 0,
    "bbox": [
      49.0,
      523.3,
      543.05,
      548.44
    ],
    "text": "(1) declare that the area of land called \u201cDadagamuwa Sumitta Sri Sundararama Rajamaha Vihara Sacred Area\u201d specified in the Schedule hereto shall be an urban development area for the purpose of the aforesaid Ordinance; and",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      49.0,
      559.3,
      543.25,
      572.44
    ],
    "text": "(2) direct that an outline physical plan shall be prepared for the \u201cDadagamuwa Sumitta Sri Sundararama Rajamaha Vihara",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
