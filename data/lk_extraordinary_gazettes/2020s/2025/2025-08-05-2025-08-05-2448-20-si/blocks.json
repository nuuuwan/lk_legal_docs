    "text": "\u201c\u027c \u0dbd\u0d82\u0d9a\u0dcf \u026a\u0dd9\u01ca\u0dc1 \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u01e7\u0252\u00fa\u01af \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0d82\u0dc1\u0dd9\u024f S-IV \u0dd9\u0279\u02a2\u019d\u0dd9\u024f \u0dd9\u0db4\u02a3\u01d0 \u0dc3\u0dc4\u0d9a\u0dcf\u0dbb \u0dad\u0db1\u01b1\u0dd9\u0dbb\u028f \u0dd9\u0dc3\u02a2\u0dc0\u0dba \u0d9a\u0dbb\u023d\u01e6 \u0286\u0da7 2019.01.10 \u01ce\u0db1 \u0286\u0da7 \u0dc0\u0dd0\u0da9 \u0dad\u0dc4\u0db1\u0db8\u0da7 \u0dbd\u00fa\u026d \u017a. \u0d92. \u0dd9\u0dbb\u02a3\u0dc2\u0dcf\u01e6 \u0d85\u0dc2\u0dca\u0dbb\u0dc6\u0dca \u0db8\u0dc4\u0dad\u0dcf\u0da7 \u0d91\u0dd9\u0dbb\u028f\u0dc0 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u026a\u0dd9\u01ca\u0dc1 \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u01e7\u0252\u00fa\u01af \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0d82\u0dc1\u0dba \u0db8\u0119\u01e6 \u0db4\u0dc0\u01ae\u0dc0\u01e9 \u0dbd\u0dd0\u022d \u026a\u01dd\u0db8\u01ae \u026a\u0db1\u0dba \u0db4\u025d\u00fa\u0dc2\u0dab\u0dba \u0d85\u01e9\u0dc0 \u0dbd\u0db6\u0dcf\u01d0\u01e6 \u026a\u0db1\u0dba \u01e7\u0dd9\u0dba\u02a4\u0d9c\u0dd9\u024f \u0daf\u01a8\u0dc0\u023c \u0dd9\u0dc4\u02a2\u01b1\u0dd9\u0dc0\u01e6 \u0d94\u0291\u0da7 \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0286\u01d0\u0dc0 \u01af\u0dd9\u0229\u0daf, \u0dba\u01e6\u0db1\u01ae \u0d91\u0dd9\u0dc3\u02a2 \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0286\u01d0\u026b \u01af\u0dd9\u0229 \u0db1\u023c \u0d94\u0291\u0da7 \u028f\u023d\u026a\u0dba \u0252\u01b1 \u0dc3\u0dc4\u0db1 \u0d9a\u0dc0\u0dd9\u0259\u0daf \u0dba\u01e6\u0db1\u01ae \u0218\u0298\u0db6\u0db3\u0dc0 \u0dd9\u0269.\u201d",
