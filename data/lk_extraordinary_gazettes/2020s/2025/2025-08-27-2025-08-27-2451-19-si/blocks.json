    "text": "2002 \u0d85\u0d82\u0d82\u0d9a 34 \u0daf\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dc3\u0dda\u02e6\u0dda\u0dc0\u0dcf\u0dcf \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba \u0db4\u0db1\u0dad\u0dda\u01ae 9 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb, \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dcf\u0dc4\u0db1, \u0db8\u0dc4\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c, \u0dc0\u0dbb\u0dcf\u0dcf\u0dba \u0dc4\u0dcf\u0dcf \u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dc3\u0dda\u02e6\u0dda\u0dc0\u0dcf\u0dcf \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba \u0db6\u0dd2\u0db8\u0dbd\u0dca \u0db1\u0dd2\u0dbb\u0ddd\ufffd\u0ddd\ufffd\u0dc2\u0db1\u0dca \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0dc0\u0db1 \u0db8\u0db8, \u0db8\u0dda\u023c \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca, \u0d85\u0d82\u0d82\u0d9a 2050/38 \u0daf\u0dbb\u0db1 \u0dc3\u0dc4 2017 \u0daf\u0dd9\u0dd9\u0dc3\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 21 \u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd2\u0dba\u0db8\u0dba\u0dda\u024f \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba, \u0d91\u0dc4\u0dd2 \u201c\u0d9c\u0d9c\u0db1 \u0db1\u0dcf\u0dcf\u0dc0\u0dd2\u0d9a \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0dc4 \u0d9c\u0d9c\u0db1 \u0dba\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf\u0d82\u0d82\ufffd\u0d9c\u0db1\u0dc0\u0dbd\u0da7 \u0d86\u0db6\u0daf\u0dca\u0db0 \u0d89\u0da9\u0db8\u0dca (\u0dad\u0dd4\u0db1\u0dca\u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u