    "text": "1978 \u0d85\u0d82\u0d82\u0d9a 16 \u0daf\u0dbb\u0db1 \u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dbd \u0db4\u0db1\u0dad\u0dda\u01ae 25\u0d85 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0d9a\u0dd2\u0dba\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 27(1)(\u0d86) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0, \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db4\u0db1, \u0d8b\u0dc3\u0dc3\u0dca \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db4\u0db1 \u0dc3\u0dc4 \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd3\u0dba \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db4\u0db1 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba \u0d86\u0da0\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0dc4\u0dbb\u0dd2\u0db1\u0dd2 \u0d85\u0db8\u0dbb\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0dc0\u0db1 \u0db8\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca, 2007 \u0d85\u0d82\u0d82\u0d9a 07 \u0daf\u0dbb\u0db1 \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8\u0dca \u0db4\u0db1\u0dad \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8\u0d9a\u0dca \u0dc0\u0db1, \u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2 \u0d85\u0d82\u0d82\u0d9a PV 94125 \u0daf\u0dbb\u0db1, \u0db8\u0dcf\u200d\u200d\ufffd\u0db1\u0dd9\ufffd\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad, \u0db6\u0ddc\ufffd\u0ddc\u0dbd\u0dca\u0dbd\u0dd1\u0dd1\u0d9c\u0dbd, \u0d9a\u0dd0\u0dd0\u0dbd\u0dab\u0dd2\u0dba \u0dba\u0db1 \u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba\u0dda\u024f \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2, \u0d8b\u0db4\u0dcf\u0dcf\u0db0\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dcf\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dca \u0dbd\u0dd9\ufffd\u0dc3 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db1\u0dcf\u0dcf\u0d9c\u0dcf\u0dcf\u0db1\u0db1\u0dca\u0daf \u0d89\u0db1\u0dca\u0da7\u0dbb\u0dca\u0db1\u0dd0\u0dd0\u0dc2\u0db1\u0dbd\u0dca \u0d89\u0db1\u0dca\u0dc3\u0dca\u0da7\u0dd2\u0da7\u0dd2\u0dba\u0dd4\u0da7\u0dca \u0dc6\u0ddc\u02e9\u0ddc \u0db6\u0dd4\u0da9\u0dd2\u0dc3\u0dca\u0da7\u0dca \u0dc3\u0dca\u0da7\u0da9\u0dd3\u0dc3\u0dca (\u0db4\u0dca\u200d\u0dbb\u0dba\u0dd2\u0dc0\u0da7\u0dca) \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d91\u0d9a\u0dd3 \u0db4\u0db1\u0dad\u0dda\u01ae 70 \u0d87 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0dbd\u0db6\u0dcf\u0dcf \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dc3\u0dd4, \u0db8\u0dd9\ufffd\u0db8 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca, \u0d91\u0d9a\u0dd3 \u0db4\u0db1\u0dad \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc3\u0dcf\u0dcf\u0daf\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd6 2015 \u0daf\u0dd9\u0dd9\u0dc3\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 07 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 1944/2 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\ufffd\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd2\u0dba\u0db8\u0dba\u0dda\u024f \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad I \u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba \u0dc4\u0dcf\u0dcf II \u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0d91\u0d9a\u0dd3 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.",
