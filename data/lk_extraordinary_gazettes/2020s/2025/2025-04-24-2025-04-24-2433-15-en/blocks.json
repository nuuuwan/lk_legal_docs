    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      57.0,
      479.85,
      542.49,
      492.99
    ],
    "text": "(1) appoint the persons specified in the schedule attached hereto be members of the panel of which Industrial Courts",
