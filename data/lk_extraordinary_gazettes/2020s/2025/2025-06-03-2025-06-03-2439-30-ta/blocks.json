    "text": "\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd, \u0b89\u0baa\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd2025.06.19\u0bae\u0bc1.\u0baa. 09.30\u0ba4\ufffd\u0bca\u0b9f\u0b99\u0bcd\u0b95\ufffd\u0bca\u0b9f \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f \u0bae\u0ba3\u0bcd\u0b9f\u0baa\u0bae\u0bcd08\u0baa\ufffd\u0bb0\u0bc1\u0bb5\u0bb3\u0bc8\u0bc8 \u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd, \u0b89\u0baa\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd2025.06.19\u0baa\u0bbf\u0bbf.\u0baa.01.30\u0baa\ufffd\u0bb0\u0bc1\u0bb5\u0bb3\u0bc8\u0bc8 \u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f \u0bae\u0ba3\u0bcd\u0b9f\u0baa\u0bae\u0bcd09\u0baa\ufffd\u0bb0\u0bc1\u0bb5\u0bb3\u0bc8\u0bc8 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd, \u0b89\u0baa\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd2025.06.20\u0bae\u0bc1.\u0baa. 09.30\u0baa\ufffd\u0bb0\u0bc1\u0bb5\u0bb3\u0bc8\u0bc8 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f \u0bae\u0ba3\u0bcd\u0b9f\u0baa\u0bae\u0bcd, \u0baa\u0bc1\u0ba4\u0bbf\u0bbf\u0baf \u0b95\u0b9f\u0bcd\u0b9f\u0b9f\u0ba4\u0bcd \u0ba4\ufffd\u0bca\u0b95\u0bc1\u0ba4\u0bbf\u0bbf 2\u0bae\u0bcd \u0bae\u0bbe\u0bbe\u0b9f\u0bbf, \u0b85\u0bb3\u0bc1\u0ba4\u0bcd\u0b95\u0bae10\u0b95\u0bb3\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb1\u0bc8\u0bc8 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd, \u0b89\u0baa\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd2025.06.20\u0baa\u0bbf\u0bbf.\u0baa.01.30\u0b95\u0bb3\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb1\u0bc8\u0bc8 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f \u0bae\u0ba3\u0bcd\u0b9f\u0baa\u0bae\u0bcd11\u0b95\u0bb3\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb1\u0bc8\u0bc8 \u0bae\u0bbe\u0bbe\u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8\u0bae\u0bc1\u0ba4\u0bb2\u0bcd\u0bb5\u0bb0\u0bcd, \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bbf\u0bbf \u0bae\u0bc1\u0ba4\u0bb2\u0bcd\u0bb5\u0bb0\u0bcd2025.06.23\u0bae\u0bc1.\u0baa. 09.30\u0b9a\u0ba8\u0bcd\u0ba4\u0bc8\u0bc8\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0b9f\u0ba4\u0bcd \u0ba4\ufffd\u0bca\u0b95\u0bc1\u0ba4\u0bbf\u0bbf \u0b9a\u0baa\u0bc8\u0bc8 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f \u0bae\u0ba3\u0bcd\u0b9f\u0baa\u0bae\u0bcd , \u0b95\u0baa\u0b9f\u0bbe\u0bbe \u0bb5\u0bc0\u0ba4\u0bbf\u0bbf, \u0b95\u0bb3\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb1\u0bc8\u0bc8 \u0ba4\u0bc6\u0bc6\u0bb1\u0bcd\u0b95\u0bc112\u0bae\u0bbf\u0bbf\u0bb2\u0bcd\u0bb2\u0ba9\u0bbf\u0bbf\u0baf \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd, \u0b89\u0baa\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd2025.06.23\u0baa\u0bbf\u0bbf.\u0baa.01.30\u0bae\u0bbf\u0bbf\u0bb2\u0bcd\u0bb2\u0ba9\u0bbf\u0bbf\u0baf \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f \u0bae\u0ba3\u0bcd\u0b9f\u0baa\u0bae\u0bcd13\u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0b95\u0bae \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd, \u0b89\u0baa\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd2025.06.24\u0bae\u0bc1.\u0baa. 09.30\u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0b95\u0bae \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8 \u0b95\u0bb2\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0bbf\u0bb5\u0ba4\u0bcd\u0ba4 \u0b89\u0baa \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0b95\u0bae\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f \u0bae\u0ba3\u0bcd\u0b9f\u0baa\u0bae\u0bcd, \u0b85\u0bb3\u0bc2\u0baa\ufffd\u0bcb\u0bae\u0bc1\u0bb2\u0bcd\u0bb214\u0baa\u0bbe\u0bbe\u0ba3\u0ba8\u0bcd\u0ba4\u0bc1\u0bb1\u0bc8\u0bc8 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd, \u0b89\u0baa",
