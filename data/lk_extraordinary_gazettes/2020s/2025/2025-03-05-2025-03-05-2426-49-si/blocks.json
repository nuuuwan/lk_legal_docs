    ],
    "text": "\u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dad (460 \u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dbb\u0dd2\u0da0\u0dca\u0dd9\u0da1\u0dca\u0daf\u0dba) 7 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0daf\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0db8\u0dd9\u0d9c\u0dca \u0d85\u0d82\u0d9a\u0dba: WGSWD&EIP/ACQ/KB/18. \u0d9a\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8, \u0db4\u0dc1\u0dd4 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dcf \u0dc0\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0dcf\u0dad\u0255\u0dcf\u0d82\u0dc1\u0dd9\u0dba\u0dca \u0d85\u0d82\u0d9a\u0dba: 4/3/10/2012/LRB/328. \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dd9\u0dad\u0dca 07 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0d85\u0d82\u0d9a 2262/22 \u0dc4\u0dcf 2022.01.11 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dd9\u0dba\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d85\u0d82\u0d9a 521203/20/02 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0dd9\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 179 \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf 7 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0daf\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0d85\u0d82\u0d9a CO/DSO/2023/43 \u0dc4\u0dcf 2023.05.16 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0db1\u0dd4\u0dd9\u0dbb\u0dca\u0d9b\u0dab\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0db4\u0dc4\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db6\u0dc0 \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db8\u0dd2. 1. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d9a\u0dca\u0dc2\u0dbb\u0dba: A (\u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 179\u0db1\u0dca \u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0dd2\u0dad) \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0db8\u0dd0\u0daf\u0dca\u0dd9\u0daf\u0dca\u0d95\u0dc0\u0dd2\u0da7 \u0d9a\u0dd4\u0db9\u0dd4\u0dbb, \u0db8\u0dd2\u0dd9\u0daf\u0dbd\u0dca\u0dbd\u0d9c\u0dc4 \u0d9a\u0dd4\u0db9\u0dd4\u0dbb, \u0d9a\u0dd4\u0dbb\u0dd4\u0db3\u0dd4\u0d9c\u0dc4 \u0d9a\u0dd4\u0db9\u0dd4\u0dbb \u0dc3\u0dc4 \u0dd9\u0dbb\u0dca\u0dbb\u0dd4\u0dc0\u0dbd \u0d9a\u0dd4\u0db9\u0dd4\u0dbb \u0dd9\u0db1\u0ddc\u0dd9\u0dc4\u0ddc\u0dad\u0dca \u0dd9\u0dc3\u0dda\u0dbb\u0dd4\u0dc0\u0dbd \u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0dc0\u0d9c\u0dd4\u0dbb\u0dd4 \u0db6\u0dd2\u0db8; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: -; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca 0.0036. 2. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d9a\u0dca\u0dc2\u0dbb\u0dba: B (\u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 179\u0db1\u0dca \u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0dd2\u0dad) \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: -; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d87\u0dc5 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: -; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca 0.1019. 3. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d9a\u0dca\u0dc2\u0dbb\u0dba: C (\u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 179\u0db1\u0dca \u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0dd2\u0dad) \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0db8\u0dd0\u0daf\u0dca\u0dd9\u0daf\u0dca\u0d95\u0dc0\u0dd2\u0da7 \u0d9a\u0dd4\u0db9\u0dd4\u0dbb, \u0db8\u0dd2\u0dd9\u0daf\u0dbd\u0dca\u0dbd\u0d9c\u0dc4 \u0d9a\u0dd4\u0db9\u0dd4\u0dbb, \u0d9a\u0dd4\u0dbb\u0dd4\u0db3\u0dd4\u0d9c\u0dc4 \u0d9a\u0dd4\u0db9\u0dd4\u0dbb \u0dc3\u0dc4 \u0dd9\u0dbb\u0dca\u0dbb\u0dd4\u0dc0\u0dbd \u0d9a\u0dd4\u0db9\u0dd4\u0dbb \u0dd9\u0db1\u0ddc\u0dd9\u0dc4\u0ddc\u0dad\u0dca \u0dd9\u0dc3\u0dda\u0dbb\u0dd4\u0dc0\u0dbd \u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad, \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 30\u0d9a\u0dca \u0dc0\u0dba\u0dc3\u0dd0\u0dad\u0dd2 \u0dd9\u0db4\u0ddc\u0dbd\u0dca \u0d9c\u0dc3\u0dca 08\u0d9a\u0dca \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0dbd\u0dd2\u0d9a \u0dd9\u0d9c\u0ddc\u0da9\u0db1\u0dd0\u0d9c\u0dd2\u0dbd\u0dd2 03 \u0d9a\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0da2\u0db1\u0d9a \u0dba\u0db1\u0dca\u0dad\u0dba\u0d9a\u0dca \u0dc3\u0dc4 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 25 \u0d9a\u0dca 30 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0dc0\u0dba\u0dc3\u0dd0\u0dad\u0dd2 \u0db8\u0dd2\u0dc1 \u0dc0\u0d9c\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dad; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: -; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.0940. \u0d91\u0da0\u0dca. \u0dad\u0dd2\u0dbd\u0d9a\u0dc0\u0dbb\u0dca\u0db0\u0db1, \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2, \u0dd9\u0dc0\u0dca\u0dbb\u0dc3\u0dca \u0d9c\u0d9f \u0dc0\u0dd0\u0dc3\u0dd2 \u0da2\u0dbd \u0d85\u0db4\u0dc0\u0dc4\u0db1 \u0dc4\u0dcf \u0db4\u0dbb\u0dd2\u0dc3\u0dbb\u0dba \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dc0\u0255\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba, \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba. 2025 \u0dd9\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 26 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0dd9\u0dc0\u0dca\u0dbb\u0dc3\u0dca \u0d9c\u0d9f \u0dc0\u0dd0\u0dc3\u0dd2 \u0da2\u0dbd \u0d85\u0db4\u0dc0\u0dc4\u0db1 \u0dc4\u0dcf \u0db4\u0dbb\u0dd2\u0dc3\u0dbb\u0dba \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dc0\u0255\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba, \u0d85\u0d82\u0d9a 03, \u0dc1\u0dd3 \u0da2\u0dba\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0db4\u0dd4\u0dbb \u0db8\u0dcf\u0dc0\u0dad, \u0dc0\u0dd0\u0dbd\u0dd2\u0d9a\u0da9, \u0dbb\u0dcf\u0da2\u0d9c\u0dd2\u0dbb\u0dd2\u0dba. EOG 03 - 0067",
