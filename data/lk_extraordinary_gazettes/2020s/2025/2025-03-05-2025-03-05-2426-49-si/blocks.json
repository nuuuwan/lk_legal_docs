    ],
    "text": "02. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 02 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb\u0dd9\u0daf\u0db1\u0dd2\u0dba \u0d9a\u0dd4\u0db9\u0dd4\u0dbb \u0dc3\u0dc4 \u0d95\u0dc0\u0dd2\u0da7; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d9a\u0dd4\u0db9\u0dd4\u0dbb, \u0dc3\u0dca\u0dae\u0dd2\u0dbb \u0dd9\u0d9c\u0ddc\u0da9\u0db1\u0dd0\u0d9c\u0dd2\u0dbd\u0dca\u0dbd\u0d9a \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0d87\u0dad; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.1203. 03. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 03 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb\u0dd9\u0daf\u0db1\u0dd2\u0dba \u0d9a\u0dd4\u0db9\u0dd4\u0dbb \u0dc3\u0dc4 \u0d95\u0dc0\u0dd2\u0da7; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d95\u0dc0\u0dd2\u0da7; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dbb\u0dad\u0dca\u0db1 \u0dd9\u0db4\u0dd9\u0dbb\u0dca\u0dbb\u0dcf \u0db8\u0dba\u0dcf \u0dc3\u0dc4 \u0dad\u0dc0\u0dad\u0dca \u0d85\u0dba; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.3756. 04. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 04 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d95\u0dc0\u0dd2\u0da7; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.0010. 05. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 05 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad, \u0dc3\u0dca\u0dae\u0dd2\u0dbb \u0dd9\u0d9c\u0ddc\u0da9\u0db1\u0dd0\u0d9c\u0dd2\u0dbd\u0dca\u0dbd\u0d9a \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dc3\u0dc4 \u0dbd\u0dd2\u0db3\u0d9a\u0dca \u0d87\u0dad; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: -; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.0442. 06. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba 06 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb\u0dd9\u0daf\u0db1\u0dd2\u0dba \u0d9a\u0dd4\u0db9\u0dd4\u0dbb \u0dc3\u0dc4 \u0d95\u0dc0\u0dd2\u0da7; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d95\u0dc0\u0dd2\u0da7; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0d91\u0db1\u0dca. \u0d85\u0dd9\u0db6\u0dca\u0d9c\u0dd4\u0dab\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db8\u0dba\u0dcf; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.2456.",
