    "text": "0250 0.0256 \u0bb5\u0bbf\u0b95\u0bcd\u0bb0\u0bae\u0bc7\u0b95 \u0ba4\u0bb0\u0b99\u0bcd\u0b95 \u0b9a\u0b9e\u0bcd\u0b9a\u0bc0\u0bb5 870031866V \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0b86\u0bb5\u1f90 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 \u0b85\u1f8e\u0b95\u0bc1\u0bb5\u0bb4\u0bbf \u2013 \u0b87\u0bb2. 242/2/\u0b8f, \u0b95\u1fa4\u0bb5\u0bb2\u0bc6\u0ba4\u0ba9\u0bbf\u0baf, \u0bc7\u0b9a\u0bb5\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0baa\u0bbf\u1f8a\u0baa\u0ba9 \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1, \u0bc7\u0bb9\u0bbe\u0bae\u0bbe\u0b95\u0bae. \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90. EOG 01 - 0201 / 1 1998 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u1f90\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u1fab\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 14 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u1f90 \u0ba8\u0bbf\u0bb0\u0bcd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u0ba9\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0ba4\u0bcd\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd 1998 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u1f90\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u1fab\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 14 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0ba4\u0ba4\u0bcd\u1f90\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0baf\u0bc8\u0ba9\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u1f8c, \u0b95\u0bc0\u0bc7\u0bb4 \u0b92\u0baa\u0bcd\u0baa\u0bae\u0bbf\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0ba8\u0bbe\u0ba9\u0bcd, 1998 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u1f90\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u1fab\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 55 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd\u0baa\u1f8a 2024.08.18 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf , \u0b95\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0b95\u0bcd \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0bc8\u0b95\u0b95\u0bc8\u0bb3\u0b95\u0bcd \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u1f90\u0bae\u0bbe\u0ba9 2397/87 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u1fa2\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u1f8c \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bc7\u0bae\u0bb2\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bc6\u0b95\u0bbe\u1fa8\u0bae\u0bcd\u1f97 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0bc7\u0bb9\u0bbe\u0bae\u0bbe\u0b95\u0bae \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b87\u0bb2. 587\u0baa\u0bc0 - \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bae\u0ba4\u0bcd\u0bc7\u0ba4\u0bc6\u0b95\u0bbe\u0b9f \u0b8f \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u0bb3\u0bcd \u0bae\u0ba4\u0bcd\u0bc7\u0ba4\u0bc6\u0b95\u0bbe\u0b9f \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3\u1f90\u0bae\u0bcd 520008 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bb2\u0bcd \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0