dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1:1 0.1789 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d8b\u0dbd\u0dca\u0db4\u0dd9\u0dad\u0dca \u0d87\u0dc5. 1:2 0.0045 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d8b\u0dbd\u0dca\u0db4\u0dd9\u0dad\u0dca \u0d87\u0dd9\u0dc5\u0dda \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dd2. 1:3 0.0044 \u0dbb\u0da2\u0dba \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0db8\u0dd4\u0da9\u0dd4 \u0db6\u0dd2\u0db8. 1:8 0.0040 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d8b\u0dbd\u0dca\u0db4\u0dd9\u0dad\u0dca \u0d87\u0dc5 \u0daf\u0dd2\u0dd9\u0d9c\u0dca \u0dd9\u0dc0\u0db1\u0dca \u0d9a\u0dc5 \u0db6\u0dd2\u0db8. 1:9 0.0059 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d8b\u0dbd\u0dca\u0db4\u0dd9\u0dad\u0dca \u0d87\u0dd9\u0dc5\u0dda \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dd2. 1:10 0.0051 \u0dbb\u0da2\u0dba \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dcf\u0dab\u0dd4\u0dc0. 1:12 0.1359 \u0db4\u0dd4\u0dc3\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd\u0dd9\u0d9c\u0dca \u0da2\u0dba\u0db1\u0dca\u0dad \u0d85\u0dd9\u0db6\u0dca\u0dc0\u0dd3\u0dbb. 671970969V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0d8b\u0dbd\u0dca\u0d9c\u0dbd\u0dba\u0dcf\u0dba, \u0dc0\u0dd0\u0dbd\u0dca\u0dd9\u0d9a\u0db1\u0dd2\u0dba\u0dcf\u0dba, \u0dd9\u0d9c\u0ddc\u0da9\u0d9a\u0dd9\u0dc0\u0dbd. 1:13 0.0651 \u0dc0\u0dd2\u0dc4\u0dcf\u0dbb\u0db0\u0dd2\u0db4\u0dad\u0dd2. _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc1\u0dd2\u0dc2\u0255\u0dcf\u0db1\u0dd4 \u0dc1\u0dd2\u0dc2\u0255 _ \u0dc1\u0dd3 \u0dc3\u0dd4\u0db8\u0db1\u0dcf\u0dbb\u0dcf\u0db8 \u0db4\u0dd4\u0dbb\u0dcf\u0dab \u0db8\u0dd6\u0dbd \u0db8\u0dc4\u0dcf \u0db4\u0dbb\u0db8\u0dca\u0db4\u0dbb\u0dcf\u0dd9\u0dc0\u0dca \u0dc0\u0dd2\u0dc4\u0dcf\u0dbb\u0dba, \u0dc0\u0dd0\u0dbd\u0dca\u0dd9\u0d9a\u0db1\u0dd2\u0dba\u0dcf\u0dba, \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0db4\u0dca\u0dad\u0dd2\u0dba\u0da7 \u0dd9\u0d9c\u0ddc\u0da9\u0d9a\u0dd9\u0dc0\u0dbd. \u0dc4\u0dcf \u0dd9\u0d9c\u0ddc\u0da9\u0d9a\u0dd9\u0dc0\u0dbd, \u0dc0\u0dd0\u0dbd\u0dca\u0dd9\u0d9a\u0db1\u0dd2\u0dba\u0dcf\u0dba, \u0d8b\u0d9c\u0dca\u0d9c\u0dbd\u0dba\u0dcf\u0dba \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dbb\u0dd4\u0dba\u0dd2\u0d9c\u0db8\u0dba\u0dcf\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0db4\u0dd4\u0d82\u0da0\u0dd2\u0db8\u0dc4\u0dad\u0dca\u0db8\u0dba\u0dcf \u0dba\u0db1 \u0d85\u0dba\u0da7 \u0dc0\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a\u0dc0 \u0dbd\u0db6\u0dcf \u0daf\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0daf\u0dca\u0daf\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:16 0.0107 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d85\u0da9\u0dd2 \u0db4\u0dcf\u0dbb. 1:17 0.0134 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d85\u0da9\u0dd2 \u0db4\u0dcf\u0dbb. 1:18 0.0916 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:19 0.4263 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:21 0.0130 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d8b\u0dbd\u0dca\u0db4\u0dad \u0d87\u0dd9\u0dc5\u0dda \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dd2. 1:22 0.5314 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d87\u0dc5 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba. 1:23 0.0050 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db4\u0dbd\u0dca\u0dd9\u0dbd\u0dca\u0d9a\u0dd4\u0db9\u0dd4\u0dd9\u0dbb\u0dca \u0d87\u0dd9\u0dc5\u0dda \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dd2. 1:24 0.0032 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:33 0.0092 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db4\u0dbd\u0dca\u0dd9\u0dbd\u0dca\u0d9a\u0dd4\u0db9\u0dd4\u0dd9\u0dbb\u0dca \u0d87\u0dd9\u0dc5\u0dda \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dd2. 1:40 0.2789 \u0d85\u0d9c\u0db8\u0dca\u0dd9\u0db4\u0ddc\u0da9\u0dd2\u0dd9\u0d9c\u0dca \u0dd9\u0dbb\u0ddd\u0dc4\u0dab \u0db1\u0dd2\u0db8\u0dbd\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dbb 712630353V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0dd9\u0daf\u0dc0\u0db1 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0d8b\u0dbd\u0dca\u0d9c\u0dbd\u0dba\u0dcf\u0dba, \u0dc0\u0dd0\u0dbd\u0dca\u0dd9\u0d9a\u0db1\u0dd2\u0dba\u0dcf\u0dba, \u0dd9\u0d9c\u0ddc\u0da9\u0d9a\u0dd9\u0dc0\u0dbd. 1:44 0.3704 \u0dd9\u0db6\u0ddc\u0dbb\u0dc5\u0dd4\u0dc0\u0dd9\u0d9c\u0dca \u0dd9\u0dc3\u0dd9\u0db1\u0dc0\u0dd2\u0dbb\u0dad\u0dca\u0db1 683141607V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0d8b\u0dbd\u0dca\u0d9c\u0dbd\u0dba\u0dcf\u0dba, \u0dc0\u0dd0\u0dbd\u0dca\u0dd9\u0d9a\u0db1\u0dd2\u0dba\u0dcf\u0dba, \u0dd9\u0d9c\u0ddc\u0da9\u0d9a\u0dd9\u0dc0\u0dbd. 1:61 0.1030 \u0dd9\u0daf\u0ddd\u0dbd\u0dcf\u0d9a\u0dcf\u0dbb\u0dd9\u0d9c\u0dca \u0db1\u0dd2\u0db8\u0dbd\u0dca \u0db1\u0db1\u0dca\u0daf\u0dc3\u0dd2\u0dbb\u0dd2 682981083V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0d8b\u0dbd\u0dca\u0d9c\u0dbd\u0dba\u0dcf\u0dba, \u0dc0\u0dd0\u0dbd\u0dca\u0dd9\u0d9a\u0db1\u0dd2\u0dba\u0dcf\u0dba, \u0dd9\u0d9c\u0ddc\u0da9\u0d9a\u0dd9\u0dc0\u0dbd. 1:75 0.5962 \u0d8c\u0dbd\u0dd2\u0dba\u0d9a\u0dca\u0d9a\u0dcf\u0dbb\u0dd9\u0d9c\u0dca \u0dbd\u0dd4\u0dc3\u0dd2\u0dba\u0dcf 556281912V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0d8b\u0dbd\u0dca\u0d9c\u0dbd\u0dba\u0dcf\u0dba, \u0dc0\u0dd0\u0dbd\u0dca\u0dd9\u0d9a\u0db1\u0dd2\u0dba\u0dcf\u0dba, \u0dd9\u0d9c\u0ddc\u0da9\u0d9a\u0dd9\u0dc0\u0dbd. 1:85 0.0754 \u0dbb\u0da2\u0dba \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d87\u0dc5 \u0daf\u0dd2\u0dd9\u0d9c\u0dca \u0dd9\u0dc0\u0db1\u0dca \u0d9a\u0dc5 \u0db6\u0dd2\u0db8. EOG 03 - 0085",
