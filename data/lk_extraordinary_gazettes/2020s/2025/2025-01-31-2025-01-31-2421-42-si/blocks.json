    "text": "\u0dc3\u0d82\u0dc1\u02e4\u0ddd\u02ea\u0db0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2, 1989 \u0d85\u0d82\u0d9a 13 \u0daf\u0dbb\u0db1 \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0db6\u0daf\u0dd4 (\u0dc0\u0dd2\u0dc1\u02e4\u0dda\u0dc2 \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1) \u0db4\u0db1\u0dad\u0dda 3 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda \u0db8\u0dcf \u0dc0\u0dd9\u0dad \u0db4\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb\u0dc0, \u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0dc0\u0db1 \u0db8\u0db8, \u0db8\u0dd9\u0db8 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db8\u0d9f\u0dd2\u0db1\u0dca, \u0db8\u0dd9\u0db8 \u0db4\u0db1\u0dad\u0dda 3 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf 2025 \u0da2\u0db1\u0dc0\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 10 \u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0d82\u0d9a 2418/43 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0dc0\u0dda\u0daf\u0db1\u0dba\u0dda I \u0dc0\u0dd0\u0db1\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\u0d9b\u0db1\u0dba\u0dd9\u0dca\u200d \u0d85\u0db1\u0dd4\u0dbb \u0dd1\u0db4\u0dd3 \u0db7\u0dcf\u0dab\u0dca\u0da9 \u0db8\u0dad \u0d85\u0daf\u0dcf\u0dbd \u0dc0\u0db1 \u0d91\u0d9a\u0dd3 \u0d8b\u0db4\u200d\u0dbd\u0dda\u0d9b\u0db1\u0dba\u0dda IV \u0dc0\u0dd0\u0db1\u0dd2 \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dd9\u0dc4\u0dd2 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0daf\u0dd4 \u0d85\u0db1\u0dd4\u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0db1\u0dca, \u0db8\u0dd9\u0db8 \u0d8b\u0db4\u0dbd\u0dda\u0d9b\u0db1\u0dba\u0dd9\u0dca I, II \u0dc3\u0dc4 III \u0dc0\u0dd0\u0db1\u0dd2 \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dbd \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6 \u0d87\u0dad\u0dd2 \u0dc3\u0dd1\u0db8 \u0d85\u0db1\u0dd4\u0dbb \u0dd1\u0db4\u0dd3 \u0db7\u0dcf\u0dab\u0dca\u0da9\u0dba\u0d9a\u0dca\u0db8 \u0db8\u0dad \u0d85\u0daf\u0dcf\u0dc5\u0dc0\u0db1 \u0d91\u0db8 \u0d8b\u0db4\u0dbd\u0dda\u0d9b\u0db1\u0dba\u0dda IV \u0dc0\u0dd0\u0db1\u0dd2 \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dda \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0db6\u0daf\u0dd4 \u0d85\u0db1\u0dd4\u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0db1\u0dca \u0db8\u0d9f\u0dd2\u0db1\u0dca, 2025 \u0db4\u0dd9\u0db6\u0dbb\u0dc0\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 01 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0db6\u0dbd \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd9\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0dca\u0dae\u0dcf\u0db4\u0db1\u0dba \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db8\u0dd2.",
