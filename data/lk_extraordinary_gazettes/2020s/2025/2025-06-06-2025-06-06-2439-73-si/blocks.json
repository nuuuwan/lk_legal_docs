\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f 1:111 0.0153 \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dd9\u0dc3\u0dda\u0d9a\u0dbb\u0dd9\u0d9c\u0dca \u0dd9\u0da9\u0db1\u0dd2\u0dc3\u0dca \u0d87\u0db1\u0dca\u0dad\u0db1\u0dd2 593303250V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a - \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dbb\u0dad\u0dca\u0db1 63 \u0dc3\u0dc4113 \u0dc4\u0dd2 \u0d85\u0d82\u0d9a 37/7, \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8 \u0db4\u0dcf\u0dbb, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0dc3\u0db8\u0d9f 1:178 0.0255 \u0dd9\u0db4\u0ddd\u0daf\u0dca\u0daf\u0dd2\u0dc0\u0dbd \u0db8\u0dcf\u0dbb\u0dd9\u0d9c\u0dca \u0da0\u0dd9\u0db8\u0dca\u0db1\u0dca\u0daf \u0dd9\u0dc3\u0ddd\u0db8\u0dad\u0dd4\u0d82\u0d9c 693470820V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 164 \u0dc4\u0dd2 - \u0d85\u0d82\u0d9a 106/6\u0db6\u0dd3, \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0dc3\u0db8\u0d9f EOG 06-0082/4",
