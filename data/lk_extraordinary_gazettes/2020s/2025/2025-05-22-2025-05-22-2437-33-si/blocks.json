    ],
    "text": "\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0dd2\u0dad 1973 \u0d85\u0d82\u0d82\u0d9a 25 \u0daf\u0dbb\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0db4\u0db1\u0dad\u0dda\u01ae 39 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2 \u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0dad\u0dbb\u0dd4\u0dab \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc4\u0dcf\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dcf\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea \u0d9c",
