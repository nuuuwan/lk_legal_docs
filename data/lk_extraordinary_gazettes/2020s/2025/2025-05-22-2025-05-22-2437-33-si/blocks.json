  {
    "page_number": 0,
    "bbox": [
      47.99,
      379.5,
      542.47,
      456.06
    ],
    "text": "\u0dad\u0dbb\u0dd4\u0dab \u0d9a\u0da7\u0dba\u0dd4 \u0dad\u0dd4 \u0dc4\u0dcf\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba \u0dc3\u0dd4\u0db1\u0dd2\u0dbd\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0d9c\u0db8\u0d9c\u0dda\u0118 \u0dc0\u0db1 \u0db8\u0db8, 1973 \u0d85\u0d82\u0d82\u0d9a 25 \u0daf\u0dbb\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0db4\u0db1\u0dad \u0dc3\u0dc4 \u0d91\u0dc4\u0dd2 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1 \u0dc0\u0dbd 39 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2 \u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dc0\u0dbb\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb \u0dc0, 2025 \u0db8\u0dd0\u0dd0\u0dba\u0dd2 \u0db8\u0dc3 22 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d82\u0d9a 2437/32 \u0daf\u0dbb \u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dda\u02e4\u0dda\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0daf\u0db1\u0dba \u0db8\u0d9f\u0dd2 \u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0d9a\u0dcf\u0dcf\u0dbb\u0dd3 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0db6\u0dbd\u0d9a\u0dcf\u0dcf\u0dba (Working Task Force) \u0dc0\u0dd9\u0dd9\u0dad \u0dbd\u0ddd\ufffd\u0ddd\u02ea\u0d9a \u0dbb\u0d9c\u0dca\u0db6\u0dd2 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dad\u0dca\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf \u0dc3\u0db8\u0dcf\u0dcf\u0dbd\u0ddd\ufffd\u0ddd\u02ea\u0da0 \u0db1 \u0dc3\u0db8\u0dd6\u0dc4\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0db1\u0dcf\u0dcf \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0dc4 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0db8 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dca\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d91\u0d9a\u0d9f \u0dc0\u0dd6, \u0dc3\u0dc4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca (\u0dbd\u0dda\ufffd\u0d9b\u0db1 \u0d85\u0d82\u0d82\u0d9a\u0dba: DSD/NSA/COM/01/2024 \u0dc3\u0dc4 2024. 06. 24) \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0daf\u0dd0\u0dd0\u0db1\u0dd4\u0db8\u0dca\u0daf\u0dd3\u0db8 \u0dc3\u0db8\u0d9f \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dd2\u0daf\u0dca\u0db0 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dbb\u0d9c\u0dca\u0db6\u0dd2 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0dc0 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0d9a\u0dbb\u0db8\u0dd2.",
    "fonts": [
      "IskoolaPota",
