    ],
    "text": "2. \u0d89\u0da9\u0dc1\u0db8\u0dca \u0dc0\u0dd2\u0dc0\u0db4\u0dad\u0dbb\u0dba.\u2013 \u0db6\u0dc0\u0dc4\u0db1\u0dc5\u0dd2 \u0dbb \u0db3\u0dc2\u0dc5\u0dba\u0dda, \u0d9c\u0d9c\u0dda\u0db3\u0dc1 \u0daf\u0dd2\u0dc0\u0dc4\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0db8\u0dc1\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dc5\u0dba\u0dd3\u0dba \u0dba \u0dba\u0db8\u0d9a\u0d9c\u0dda \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dc5\u0dc0\u0dba\u0dda, \u0d85\u0d82\u0d9a 245\u0d92, \u0dc3\u0dd6\u0dbb\u0dd2\u0dba\u0db3\u0dc5\u0dbd\u0dd4\u0dbd \u0daf\u0d9a\u0dd4\u0dab \u0d9c\u0dca\u200d\u0dbb\u0dc5\u0db8 \u0db1\u0dd2\u0dbc\u0db0\u0dc5 \u0d9a \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dc5\u0dc0\u0dba\u0dda, \u0dc3\u0dd6\u0dbb\u0dd2\u0dba\u0db3\u0dc5\u0dbd\u0dd4\u0dbd \u0daf\u0d9a\u0dd4\u0dab \u0d9c\u0dba\u0db8\u0dd2 \u0db4\u0dd2\u0dd2 \u0da7\u0dd2 \u0dc0\u0dbb\u0dca\u0dba\u0dda\u0dba\u0dbb\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dc5\u0db8 \u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0dba\u0dc2 \u0d9a\u0dbb\u0db1 \u0dbc\u0daf \u0d85\u0d82\u0d9a GM/MAH/2023/418 \u0dc1\u0dc5 2023.12.19 \u0daf\u0dd2\u0db1\u0dc6\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0db8\u0dab \u0d85\u0dd4\u0dbb\u0dba\u0dbb\u0dca\u0d9b\u0db1\u0dba\u0dda \u0dc0\u0dc0\u0dd2\u0dc0\u0dc4\u0dcf\u0dbb\u0dbd \u0daf\u0dc6\u0d9a\u0dca\u0dba\u0dbd\u0db1 \u0d9a\u0dc6\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a \u0d92 \u0dc3\u0dd2\u0da7 \u0d91\u0da0\u0dca \u0dbd\u0dbe\u0dba\u0dba\u0dca\u0dad \u0dba\u0db3\u0dca\u0dad\u0db1\u0dd4\u0d9c\u0dda \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc5\u0dab\u0dba\u0dba\u0dca\u0dad \u0dba\u0dc1\u0d9a\u0dca\u0da7\u0dba\u0dc5\u0dbb\u0dca 0.0321\u0d9a\u0dca \u0db3\u0db8\u0dab \u0dbd\u0db1 \u0db3\u0dc1\u0dcf \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0db1\u0d9c\u0dda\u0dbd\u0dbd\u0dd2\u0dca\u0dad \u0dc1\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc5\u0dab\u0dba\u0dca\u0dad\u0dba\u0d9c\u0dca\u0dad \u0dd4\u0d9a\u0d9a\u0dca\u0dcf \u0d89\u0da9\u0d9c\u0dda \u0d9a\u0dc6\u0db6\u0dc