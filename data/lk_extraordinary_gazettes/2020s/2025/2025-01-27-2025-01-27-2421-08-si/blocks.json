    "text": "\u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dda \u0db4\u0db1\u0dad\u0dda (460 \u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dbb\u0dd2\u0da0\u0dca\u0da1\u0dda\u0daf\u0dba) 38 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda (\u0d85) \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0dc0\u0dd2\u0db0\u0dcf\u0db1\u200d\u0dba\u0dd9\u0db1\u0dca \u0db8\u0dcf \u0dc0\u0dd9\u0dad \u0db4\u0dc0\u0dbb\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0d85\u0db1\u0dd4\u0dc0 \u0d9a\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8, \u0db4\u0dc1\u0dd4\u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dcf \u0dc0\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0d9a\u0dd4\u0dbb\u0d9c\u0db8\u0d9c\u0dda \u0daf\ufffd\u0ddc\u0db1\u0dca \u0dbd\u0dcf\u0dbd\u0dca \u0d9a\u0dcf\u0db1\u0dca\u0dad \u0dc0\u0db1 \u0db8\u0db8 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d8b\u0db4\u0dbd\u0dda\u0d9b\u0db1\u0dba\u0dda 1 \u0dc0\u0db1 \u200d\u0da1\u0dda\u0daf\u0dba\u0dda \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dda \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0dcf\u0da7 \u0db1\u0dd0\u0dad\u0dc4\ufffd\u0ddc\u0dad\u0dca, \u0d91\u0d9a\u0dd3 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0db6\u0dbd\u0dba \u0daf\u0dd9\u0db1 \u0dbd\u0daf \u0dc0\u0dd9\u0db1\u0dad\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0dd9\u0d9a\u0dd4\u0da7, \u0d91\u0db8 \u0d8b\u0db4\u0dbd\u0dda\u0d9b\u0db1\u0dba\u0dda 2 \u0dc0\u0db1 \u200d\u0da1\u0dda\u0daf\u0dba\u0dda \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad \u0d89\u0da9\u0db8 \u0dc3\u0dca\u0dc0\u0dcf\u0db8\u0dd2\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db8\u0dd9\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb\u0db8\u0dd2.",
