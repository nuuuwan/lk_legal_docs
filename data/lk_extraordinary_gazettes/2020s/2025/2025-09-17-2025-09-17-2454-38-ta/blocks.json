    "text": "\u0b95\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf \u0b85\u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd 6(1) \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1. \u0bae\u0bbe\u0bbe\u0bb2\u0bbf\u0bae\u0bcd\u0baa\u0b9f \u0bb5\ufffd\u0ba4 \u0b86\u0bb0\ufffd\u0baf\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0bbf\u0bb9\u0730 \u0ba8\u0bbe\u0bbe\u0bb2\u0b95 \u0ba4\u0bb0\u0b99\u0bcd\u0b95 \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0b85\u0bb5\u0bb0\u0ba4\u0bc1 \u0b95\u0b9f\u0bae\u0bc8\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bb2\u0ba4\u0bbf\u0bbf\u0b95\u0bae\u0bbe\u0bbe\u0b95 2021.11.13 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf \u0ba4\ufffd\u0bca\u0b9f\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0ba4\u0bc6\u0bc6\u0ba9\u0bcd \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0b95\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0baf\u0727\u0bcb\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\ufffd\u0b95 \u0ba8\u0bbf\u0bbf\u0baf\u0bae\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0bbe\u0bbe\u0bb0\u0bcd. \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4 \u0baa\u0ba4\u0bb5\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0b9a\u0bc7\u0bc7\u0bb5\u0bc8\u0bc8\u0baf\u0bbe\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bb0\u0bc8\u0bc8 \u0b87\u0ba8\u0bcd\u0ba8\u0bbf\u0bbf\u0baf\u0bae\u0ba9\u0bae\u0bcd \u0bb5\u0bb2\u0bbf\u0ba4\u0bbe\u0bbe\u0b95\u0bc1\u0bb5\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd, \u0b87\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0baa\u0bc1 \u0bb5\ufffd\u0bb1\ufffd\u0bca\u0bb0\u0bc1 \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0b95/\u0bae\u0bbe\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0b95 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b9a\u0bbf\u0bbf\u0bb2 \u0bae\u0bbe\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0b95 \u0b95\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0baf\u0727\u0bcb\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\ufffd\u0b95 \u0ba8\u0bbf\u0bbf\u0baf\u0bae\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbe\u0bbe\u0bb2\u0bcd \u0b85\u0ba8\u0bcd\u0ba8\u0bbf\u0bbf\u0baf\u0bae\u0ba9\u0bae\u0bcd \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb2\u0bcd \u0b87\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b9a\u0bcd \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bbf\u0bb1\u0ba4\u0bc1.",
