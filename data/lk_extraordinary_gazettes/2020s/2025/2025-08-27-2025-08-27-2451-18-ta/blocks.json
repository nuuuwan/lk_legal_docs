    "text": "\u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95\u0b9a\u0bcd\u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a \u0b95\u0bc1\u1f8a\u0baf\u0bb0\u0b9a\u0bbf\u0ba9\u0bcd 2007.10.03\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 1517/14 \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0b85\u0ba4\u0bbf\u0bb5\u0bbf\u0bc7\u0bb7\u0b9f \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0bbf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u1fa4\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bae\u0bb5\u0bbe\u0b95. \u0ba8\u0b95\u0bb0 \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0ba9\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a\u0bae\u0bbe\u0b95 \u0baa\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bb5\u0b9f\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd, \u0b85\u1f94\u0bb0\u0bbe\u0ba4\u1f97\u0bb0 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f \u0bae\u0ba4\u0bb5\u0bbe\u0b9a\u0bcd\u0b9a\u0bbf \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u0bb3\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3\u1f90\u0bae\u0bbe\u0ba9 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u0bb3\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd: 58 \u0b87\u0b9a\u0ba9\u0bcd\u0bc6\u0baa\u0bb8\u0bcd\u0bb8\u0b95\u0bb2, \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 59: \u0b8e\u0b95\u0bbf\u0bbe\u0bbf\u0b95\u0ba8\u0bcd\u0ba4, \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 61 \u0b87\u0bb0\u0baf\u0bbf\u0bb2\u0bcd\u0bc7\u0bb5 \u0ba8\u0b95\u0bb0\u0bae\u0bcd,\u0b87\u0bb2. 66: \u0b95\u0b9f\u0bcd\u1f8c\u0bc6\u0bb5\u0bb2, \u0b87\u0bb2: 67 \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1, \u0bae\u0ba4\u0bb5\u0bbe\u0b9a\u0bcd\u0b9a\u0bbf, \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae:68 \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1, \u0bc6\u0bae\u0ba4\u0bb5\u0bbe\u0b9a\u0bcd\u0b9a\u0bbf, \u0b86\u0b95\u0bbf\u0baf \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u0bb3\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0bc7\u0bae\u0bb2\u0bbe\u0b95 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd: 46 \u0bae\u0bb9\u0b95\u0bc1\u0bae\u0bcd\u1f97\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bc7\u0bb2\u0bb5, \u0b87\u0bb2: 69 \u0b95\u0ba9\u0ba4\u0bb0\u0bbe \u0ba4\u0bbf\u1fab\u0bb2\u0bcd\u0bc6\u0bb5\u0bb5, \u0b87\u0bb2: 78 \u0b9a\u0b99\u0bcd\u0b95\u0bbf\u1fa2\u0b95\u0ba9\u0ba4\u0bb0\u0bbe\u0bb5, \u0b87\u0bb2: 65 \u0bb5\u0bb2\u0bcd\u0bc6\u0baa\u0bbe\u0bb2, \u0b87\u0bb2: 60 \u0b95\u0b9f\u0bb5\u0ba4\u0bcd\u0b95\u0bae, \u0b87\u0bb2: 47 \u1f98\u0bc7\u0ba9\u0bb5, \u0b86\u0b95\u0bbf\u0baf \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u0bc8\u0bb3 \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u1f99\u1fa8 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bc8\u0ba9 \u0b89\u0bb3\u0bcd\u0bb3\u0b9f\u0b95\u0bcd\u0b95\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbe\u0b95\u0bc1\u0bae\u0bcd.",
