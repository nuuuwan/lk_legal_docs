    "text": "\u0b95\u0bc8\u0b9f\u0b9a\u0bbf\u0baf\u0bbe\u0b95 \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f \u1f97\u0bb3\u0bcd\u0bb3\u0bbf \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd: 12\u0b87\u1f9e\u0ba8\u0bcd\u1f90 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd: 1517/14 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 2007.10.03 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0bbf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b8a\u0b9f\u0bbe\u0b95 \u0baa\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bb4\u0bbf\u0baf\u0bbe\u0b95 \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0bbf\u0bc8\u0b9a\u0baf\u0bbf\u0bc8\u0ba9 \u0bc7\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0bbf \u0baa\u0baf\u0ba3\u0bbf\u0ba4\u0bcd\u1f90 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd:64 \u0bb5\u0bbf\u0bb0\u0bb2\u0bcd\u1f99\u0bbe\u0bbf\u0baa\u0bcd\u1f97 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd (13)\u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bb4\u0bbf\u0baf\u0bbe\u0b95 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0baf\u0bbf\u0ba9\u0bcd \u0b8a\u0b9f\u0bbe\u0b95 \u0bb5\u0b9f\u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd",
