    "text": "\u0bb5\u0b9f\u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 \u0ba4\u0bbf\u0bc8\u0b9a\u0baf\u0bbf\u0bc8\u0ba9 \u0bc7\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0bbf \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 \u1f97\u0bc8\u0b95\u0baf\u0bbf\u0bb0\u0ba4 \u0baa\u0bbe\u0bc8\u0ba4\u0bc8\u0baf \u0b95\u0bc1\u1fa0\u0b95\u0bcd\u0b95\u0bc1 \u0bc6\u0bb5\u0b9f\u0bcd\u1f8a\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u1f8c \u0baa\u0baf\u0ba3\u0bbf\u0ba4\u0bcd\u1f90, \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd:62\u1f97\u0bb2\u0bcd\u0b8e\u0bb4\u0bbf\u0baf \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0baf\u0bbf\u0bc8\u0ba9 \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 (14) \u1f97\u0bb3\u0bcd\u0bb3\u0bbf\u0bb5\u0bc8\u0bb0, \u0b85\u0ba8\u0bcd\u0ba4 \u0b87\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b87\u1f9e\u0ba8\u0bcd\u1f90 \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0baf\u0bbf\u0ba9\u0bcd \u0b8a\u0b9f\u0bbe\u0b95 \u0bb5\u0b9f\u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 \u0ba4\u0bbf\u0bc8\u0b9a\u0baf\u0bbf\u0bc8\u0ba9 \u0bc7\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0bbf \u0baa\u0baf\u0ba3\u0bbf\u0ba4\u0bcd\u1f90 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd :51\u0b95\u0bc1\u0b9f\u0bbe\u0b95\u0bc1\u0bae\u0bcd\u1f97\u0b95\u0bcd\u0bc7\u0b95\u0bbe\u0bb2\u0bcd\u0bc7\u0bb2\u0bb5 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2(15)\u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bb5\u0bc8\u0bb0, \u0b85\u0ba8\u0bcd\u0ba4 \u0b87\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b87\u1f9e\u0ba8\u0bcd\u1f90 \u0b95\u0bc1\u0bb1\