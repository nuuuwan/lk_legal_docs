  },
  {
    "page_number": 0,
    "bbox": [
      50.82,
      589.13,
      289.01,
      654.9
    ],
    "text": "Undermentioned land shown, in Block No. 01, Sheet No. 1, in the Surveyor General\u2019s plan of C. M. 321289 situated in the Village of Pubbiliya in the Grama Niladhari Division of No.321 Pubbiliya in Thumpane Divisional Secretary\u2019s Division in Kandy District of Central Province.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      1.0199999809265137,
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.82,
      654.77,
      286.62,
      705.72
    ],
    "text": "1. Lot No. 01 Name of the Land: Bebilegedarawaththa; Description: Land; Claimant: Government; Original Claimant: Pallegedara Nandawathi; Extent: 0.1257 Hectares.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      1.0199999809265137,
      7.019999980926514,
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.5,
      443.47,
      539.93,
      571.03
    ],
    "text": "All persons interested in the aforesaid land on which a servitude is to be acquired are hereby required to appear personally, or by agents duly authorized in writing, before me at Divisional Secretariat, Thumpane on the 10th day of April, 2025 at 10.00 a.m. and are hereby requested to notify me in writing (in duplicate) on or before the 03rd day of April, 2025 the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land/ servitude, the amount of computation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.020000457763672
    ]
  },
