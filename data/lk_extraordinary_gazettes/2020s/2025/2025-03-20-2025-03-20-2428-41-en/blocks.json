  {
    "page_number": 0,
    "bbox": [
      50.82,
      571.13,
      279.47,
      589.2
    ],
    "text": "Description of the land or Servitude to be acquired:",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      1.0199999809265137,
      4.980000019073486,
      10.020000457763672
