    "text": "\u0db6\u0dc0\u0dca\u0db1\u0dcf\u0dd2\u0dbb \u0db3\u0dc2\u0dcf\u0dba\u0dda, \u0dba\u0d9a\u0ddc\u0dc2\u0db9 \u0daf\u0dd2\u0dc0\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0d9a\u0dd0\u0dc0\u0dca\u0db6\u0dd1\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba\u0dba \u0dba\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc0\u0dba\u0dda, 576A \u0dad\u0dd4\u0db8\u0dca\u0dba\u0db6\u0ddd\u0dbd\u0dbc \u0d8b\u0dad\u0dd4\u0dbb \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbc\u0db0\u0dcf\u0dbb\u0dd2 \u0dba\u0d9a\u0da7\u0dca\u0da8\u0dcf\u0dc0\u0dba\u0dda, \u0dad\u0dd4\u0db8\u0dca\u0dba\u0db6\u0ddd\u0dc0\u0dd2\u0dbc (\u0dba\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dbe \u0d85\u0d82\u0d9a 10 \u0dad\u0dd4\u0db8\u0dca\u0dba\u0db6\u0ddd\u0dc0\u0dd2\u0dbc, \u0d9a\u0dd0\u0dc0\u0dca\u0db6\u0dd1\u0dbd \u0db1\u0d9c\u0dbb \u0dc0\u0db7\u0dcf \u0dc3\u0dd3\u0db8\u0dcf\u0dbd \u0dad\u0dd4\u0dbc) \u0d9c\u0dba\u0db8\u0dca \u0db4\u0dd2\u0dd2\u0da7\u0dd2 \u0dc0\u0dbb\u0dca\u0dba\u0dda\u0dba\u0dbb\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0dba\u0dbc \u0d9a\u0dbb\u0db1 \u0dbc\u0daf \u0d85\u0d82\u0d9a CO/DSO/2024/281 \u0dc1\u0dcf 2024.07.08 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0db1\u0dd4\u0dba\u0dbb\u0dca\u0d9b\u0dab\u0dba\u0dba\u0dd2 \u0dc0\u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb\u0dbd \u0daf\u0dd0\u0d9a\u0dca\u0dba\u0dbd\u0db1 \u0db3\u0dc1\u0dcf \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0db1\u0db8\u0dca \u0dbd\u0dbd\u0dd2\u0dca\u0dad \u0dc1\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dca\u0dad\u0dba\u0d9c\u0dca\u0dad \u0dd4\u0d9a\u0d9a\u0dca\u0dcf \u0dc0\u0dd6 \u0d89\u0da9\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dc0\u0da7 \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca:",
