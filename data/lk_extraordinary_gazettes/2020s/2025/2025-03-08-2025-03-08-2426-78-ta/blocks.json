    ],
    "text": "\u0baf\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u0baf\u0bac\u0bb9\u0ba8\u0bcd\u0ba4\u0bc1\u0baf\u0baf\u0ba4\u0bcd\u0ba4 \u0bb5\u0bc0\u0ba4\u0bbf, \u0b87\u0b9a\u0bbf\u0ba7\u0ba4\u0ba6 \u0ba8\u0bc1\u0bc8\u0b95\u0b9a\u0baf\u0ba6, \u0baf\u0bac\u0bb9\u0ba8\u0bcd\u0ba4\u0bc1\u0baf\u0baf\u0ba4\u0bcd\u0ba4\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0b95\u0ba8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bad\u0ba4\u0bc1 \u0ba8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc8.\u0b9f\u0bbf \u0ba4\u0ba9\u0bc1\u0bb7\u0bcd\u0bc8. \u0b8b\u0b9a\u0bcd.\u0b8b\u0b9a\u0bcd \u0b85\u0ba8\u0baa\u0bbe\u0baf\u0ba4\u0bbf, \u0b9f\u0bbf. \u0b87\u0bb2\u0bcd\u0bac\u0b9a\u0bbf\u0b99\u0bcd\u0bc8 \u0ba8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0ba8\u0bbf\u0ba8\u0bcd\u0ba4 \u0b87\u0bb2\u0bcd\u0bac\u0b9a\u0bbf\u0b99\u0bcd\u0bc8 \u0b86\u0bc8\u0bbf\u0b9a\u0ba9\u0bbe\u0baf\u0bc3\u0b95\u0bcd\u0b95\u0bc1 \u0b95\u0b9a\u0bbe\u0ba8\u0bcd\u0ba4\u0ba8\u0bbe\u0ba6 \u0bb5\u0bc0\u0ba4\u0bbf; \u0bc8\u0bbf\u0bae\u0b95\u0bcd\u0b95\u0bc1 :",
