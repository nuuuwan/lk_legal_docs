    "text": "\u0b8a\u0baf\u0bbe \u0ba8\u0bbe\u0bc8\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0ba7\u0ba4\u0bc1\u0b95\u0bad \u0ba8\u0bbe\u0baf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0bb9\u0bbe\u0bb2\u0bbf\u0b8b\u0bac \u0ba7\u0bbf\u0baa\u0b9a\u0ba4\u0b9a \u0b95\u0b9a\u0ba9\u0bac\u0bbe\u0bad\u0bb0\u0bcd \u0ba7\u0bbf\u0bbe\u0bbf\u0baf\u0bbf\u0bb2\u0bcd, \u0b95\u0ba4\u0bb9\u0bbf\u0baf\u0bbf\u0ba5\u0bbf\u0ba7\u0bac\u0bbe\u0ba4 \u0b9a\u0bc8\u0bbe\u0bab\u0bad \u0b9a\u0bbf\u0bb1\u0bc1 \u0ba7\u0bbf\u0bbe\u0bbf\u0baf\u0bbf\u0bb2\u0bcd, \u0ba7\u0bb2\u0bcd\u0b9a\u0bac\u0bc8\u0ba8 (55\u0b8c) \u0bc8\u0bbf\u0baa\u0bbe\u0ba8 \u0b85\u0bb2\u0bc1\u0baf\u0bac\u0bb0\u0bcd \u0ba7\u0bbf\u0bbe\u0bbf\u0baf\u0bbf\u0bb2\u0bcd, \u0b95\u0baf\u0bb2\u0bcd\u0b9a\u0bac\u0b95\u0baf\u0bac (\u0b87.\u0bc8\u0bbf.\u0baf 18) \u0bc8\u0bbf\u0baa\u0bbe\u0ba8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0b95\u0ba8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bad, \u0ba5\u0bbf\u0bac \u0b85\u0bad\u0b95\u0baf\u0ba9\u0bbe\u0bad\u0bb0\u0bcd \u0ba5\u0bbe\u0ba9\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0ba6\u0bbe\u0bb2\u0bcd \u0ba4\u0ba9\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0ba7\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bad \u0b87\u0bac\u0b95\u0bcd\u0bc8\u0bae\u0bcd: B/HLE/2019/393 \u0ba8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 2021.06.30 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf\u0ba9\u0bbf\u0b9f\u0baa\u0bcd\u0ba7\u0b9f\u0bcd\u0b9f \u0b9a\u0ba8\u0bae\u0bcd\u0ba7\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0ba7\u0b9f\u0bcd\u0b9f \u0baf\u0b95\u0baa\u0ba7\u0b9f\u0baa\u0bcd \u0ba7\u0b9f\u0bbf\u0b95\u0ba9\u0b9f\u0bc1\u0baa\u0bcd\u0ba7\u0bbf\u0bb2\u0bcd \u0baf\u0bbf\u0ba7\u0bbe\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0ba7\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bad \u0ba7\u0bbf\u0ba9\u0bcd\u0baf\u0baf\u0bc3\u0bae\u0bcd \u0bc8\u0bbe\u0ba3\u0bbf\u0baa\u0bcd \u0ba7\u0b95\u0bc1\u0ba4\u0bbf\u0bc8\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bbe\u0bbf\u0ba9 \u0b8b\u0bb2\u0bcd\u0b95\u0bac\u0bc8\u0bad\u0bbe\u0baf\u0ba6. :",
