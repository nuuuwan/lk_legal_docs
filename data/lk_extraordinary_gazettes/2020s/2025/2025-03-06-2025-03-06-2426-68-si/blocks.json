dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1:14 0.1045 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d86\u0dbb \u0daf\u0dd2\u0dd9\u0d9c\u0dca \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dbd \u0db6\u0dd2\u0db8 1:15 0.0262 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d86\u0dbb 1:16 3.0304 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0daf\u0db9\u0dcf\u0db1 \u0dd9\u0dbb\u0ddd\u0dc4\u0dbd 1:17 0.1962 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf \u0db4\u0dcf\u0dbb \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dbd \u0db6\u0dd2\u0db8 1:18 0.4967 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db4\u0dcf\u0dbb(\u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd2\u0dba \u0dc3\u0db7\u0dcf) 1:19 0.1881 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd2\u0dba \u0dc3\u0db7\u0dcf \u0db4\u0dcf\u0dbb \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dbd \u0db6\u0dd2\u0db8 1:90 0.0098 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 1:91 0.2745 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db4\u0dcf\u0dbb \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dbd \u0db6\u0dd2\u0db8 1:92 0.2571 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db4\u0dcf\u0dbb 1:93 0.1345 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:94 0.0252 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 1:99 0.7589 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:119 0.1242 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db4\u0dcf\u0dbb 1:131 0.4571 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:133 0.3663 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:134 0.6972 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:139 0.6070 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d91\u0da0\u0dca.\u0d91\u0db8\u0dca.\u0daf\u0dd3\u0db4\u0dca\u0dad\u0dd2 \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a \u0dad\u0d9a\u0dca\u0dc2\u0dd2\u0dbd\u0dcf(\u0daf\u0dd4\u0dc0) 9/\u0d91\u0dbd\u0dca \u0da9\u0dd3 \u0d95/\u0daf\u0db9\u0dcf/434 \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0db4\u0dca\u0dad\u0dd2\u0d9a\u0dbb\u0dd4 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dd9\u0dbd\u0dc3 \u0db1\u0db8\u0dca \u0d9a\u0dbb \u0d87\u0dad. \u0dd9\u0dc0\u0dbd\u0dca\u0db4\u0dbd\u0dca\u0dd9\u0dbd\u0dca\u0dd9\u0dc0\u0dbd, \u0daf\u0db9\u0dcf\u0db1, \u0db8\u0dc4\u0dd2\u0dba\u0d82\u0d9c\u0db1\u0dba \u0dc4\u0dd2 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc0\u0dd2\u0db8\u0dbd\u0dcf \u0db8\u0dd0\u0dab\u0dd2\u0dd9\u0d9a\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3. \u0d89.\u0dc3\u0d82.\u0d86 \u0db4\u0db1 \u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0. 1:155 0.2023 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 9/\u0d91\u0dbd\u0dca \u0da9\u0dd3 \u0d95//\u0daf\u0db9\u0dcf/547 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dd9\u0dc0\u0dbd\u0dca\u0db4\u0dbd\u0dca\u0dd9\u0dbd\u0dca\u0dd9\u0dc0\u0dbd, \u0daf\u0db9\u0dcf\u0db1 \u0dc4\u0dd2 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d85\u0dd9\u0db6\u0dca\u0dbb\u0dad\u0dca\u0db1 \u0db6\u0dab\u0dca\u0da9\u0dcf \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3. \u0d89.\u0dc3\u0d82.\u0d86 \u0db4\u0db1 \u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0. 1:174 0.8094 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:182 0.3555 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d86\u0dbb \u0daf\u0dd2\u0dd9\u0d9c\u0dca \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dbd \u0db6\u0dd2\u0db8 1:183 0.0866 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d86\u0dbb 1:184 0.3424 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:185 0.3111 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d86\u0dbb \u0daf\u0dd2\u0dd9\u0d9c\u0dca \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dbd \u0db6\u0dd2\u0db8 1:186 0.2245 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d86\u0dbb 1:187 0.6221 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d86\u0dbb \u0daf\u0dd2\u0dd9\u0d9c\u0dca \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dbd \u0db6\u0dd2\u0db8",
