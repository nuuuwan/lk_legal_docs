    "text": "\u0db4\u0dc0\u0dbb\u0dcf \u0d9c\u0dca\u0dad\u0db1\u0dcf \u0dbd\u0daf \u0d89\u0da9\u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb\u0dba:- \u0dba\u0d9a\u0ddc\u0dc5\u0db9 \u0daf\u0dd2\u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dba\u0dda, \u0d9a\u0dd0\u0dc3\u0dca\u0db6 \u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dba \u0dba \u0dba\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba\u0dda 578\u0d92 \u0d9a\u0da7\u0dd4\u0dc0\u0dcf\u0dc0\u0dbd (\u0dba\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3 \u0d85\u0d82\u0d9a 09 \u0d9a\u0da7\u0dd4\u0dc0\u0dcf\u0dc0\u0dbd, \u0dba\u0db6\u0ddc\u0dbb\u0dbd\u0dd0\u0dc3\u0dca\u0d9c\u0db8\u0dd4\u0dc0 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0dc3\u0dd3\u0db8\u0dcf\u0dc0 \u0dad\u0dd4\u0dc5) \u0db4\u0dd2\u0da7\u0dcf\u0da7\u0dd2 \u0dc3\u0dbb\u0dca\u0dba\u0dda\u0dba\u0dbb\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0daf\u0dca\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0dba\u0dbd \u0d9a\u0dbb \u0dd2\u0dad\u0dd2 \u0d85\u0d82\u0d9a 521239 \u0dc4\u0dcf 2025/04/10 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0dba\u0db8\u0dca \u0d9a\u0dbd\u0dcf\u0db4 03 \u0db4\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d9a 06 \u0da7\u0dcf \u0d9a\u0dd0\u0db6\u0dd2 \u0d85\u0d82\u0d9a 01 \u0dc0\u0dc1\u0dba\u0dba\u0dca\u0dad \u0daf\u0dd0\u0d9a\u0dca\u0d9a\u0dba\u0dba\u0dc0\u0db1 \u0db6\u0dd2\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dc3.",
