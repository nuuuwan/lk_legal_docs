    "text": "\u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0bbf\u0bb9\u0bbe\u0bae\u0bbf, \u0b8e\u0bae\u0bcd. \u0b8e\u0bae\u0bcd. \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba8\u0bcd\u0ba4 \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0bbf \u0b8e\u0ba9\u0bcd\u0baa\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0bb5\u0ba4\u0bcd\u0ba4\u0bc6\u0b95\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bae\u0bbe\u1fa2\u0baa\u0bcd\u0bc6\u0baa\u0bbe\u0ba4 \u0b95\u0bc1\u0bb3 \u0b92\u1f90\u0b95\u0bcd\u0b95\u0bae\u0bcd; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u0b8e\u0bae\u0bcd. \u0b8e\u0b9a\u0bcd. \u0b8e\u0bae\u0bcd. \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0bbf\u0bb9\u0bbe\u0bae\u0bbf, \u0b8e\u0bae\u0bcd. \u0b8e\u0bae\u0bcd. \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba8\u0bcd\u0ba4 \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0bbf \u0b8e\u0ba9\u0bcd\u0baa\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0bb5\u0ba4\u0bcd\u0ba4\u0bc6\u0b95\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bae\u0bbe\u1fa2\u0baa\u0bcd\u0bc6\u0baa\u0bbe\u0ba4 \u0b95\u0bc1\u0bb3 \u0b92\u1f90\u0b95\u0bcd\u0b95\u0bae\u0bcd; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c A \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b9f\u0baa\u0bcd\u0bb3\u0bbf\u1f9d. \u0b9f\u0baa\u0bcd\u0bb3\u0bbf\u1f9d. \u0bc6\u0b9a\u0ba9\u0bb5\u0bbf\u0bb0\u0ba4\u0bcd\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0bb5\u0ba4\u0bcd\u0ba4\u0bc6\u0b95\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf.",
