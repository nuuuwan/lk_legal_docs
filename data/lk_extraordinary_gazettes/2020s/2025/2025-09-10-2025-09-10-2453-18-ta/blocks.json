    ],
    "text": "7 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b8e\u0ba9\u1f90 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd: \u0baa\u0bbf/\u0b87/03/01/02/\u0bc6\u0ba4\u0bb9\u0bbf\u0b95\u0bb2/\u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd/15. \u0b95\u0bbe\u0ba3\u0bbf \u0b85\u0bc8\u0bae\u0b9a\u0bcd\u0b9a\u0bbf\u0ba9\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd: 4-3/15/2019/VE/374. \u0b92\u1f9e \u0bc6\u0baa\u0bbe\u1f90\u0ba4\u0bcd \u0bc7\u0ba4\u0bc8\u0bb5\u0b95\u0bcd\u0b95\u0bc1 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8a\u0baf\u0ba4\u0bbe\u0ba9 \u0b95\u0bc0\u0bb4\u0bcd\u0b95\u0bcd \u0b95\u0bbe\u1f8e\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0bc8\u0baf \u0b8e\u1f8c\u0ba4\u0bcd\u1f90\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3 \u0b85\u0bb0\u0b9a\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0bbe\u0bb0\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf \u0baf\u0bbf\u1f9e\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0bc8\u0ba4 1964 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 28 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u0bb1\u0bcd (\u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0b9a\u0bcd) \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u0bb1\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd (\u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0baf\u0bae\u0bcd 460) 7 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd (1) \u0b86\u0bae\u0bcd \u0b89\u0b9f\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd, \u0ba8\u0bbe\u0ba9\u0bcd \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd. \u0b8e\u1f8c\u0ba4\u0bcd\u1f90\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0bb5\u0bbf\u1f9e\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u0b8a\u0bb5\u0bbe \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bc6\u0bae\u0bbe\u0ba3\u0bb0\u0bbe\u0b95\u0bc8\u0bb2 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0baa\u0bbf\u0bc8\u0bb2 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bb0\u0b95\u0bb9 \u0bc6\u0bb5\u0bc8\u0bb2 \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bb0\u0b95\u0bb9 \u0bc6\u0bb5\u0bc8\u0bb2 \u0b8a\u0bbe\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0bc6\u0bae\u0bbe\u0ba3\u0bb0\u0bbe\u0b95\u0bc8\u0bb2 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd \u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b9a\u0bbf\u0bc7\u0bb0\u0bb7\u0bcd\u0b9f \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0ba8\u0bbe\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b85\u1f94\u0bae\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bae\u0bb5\u0bbe\u0b95 \u0bb5\u0bbf\u0baa\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0bb2. 720165, \u0bb5\u0bb2\u0baf \u0b87\u0bb2. 05, \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0 \u0b87\u0bb2. 01 \u0b87\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u1f90\u0ba3\u0bcd\u1f8c \u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u1f9e\u