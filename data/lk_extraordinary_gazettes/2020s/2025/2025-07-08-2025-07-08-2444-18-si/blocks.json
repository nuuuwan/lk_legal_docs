    ],
    "text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd2 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dda\u02e4\u0dda\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2 \u0db6\u0dbd \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba \u0dbd\u0dd9\ufffd\u0dc3 \u0d85\u0d82\u0d82\u0d9a 2209/12 \u0dc4\u0dcf\u0dcf 2021 \u0da2\u0db1\u0dc0\u0dcf\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 04 \u0daf\u0dd2\u0db1 \u0daf\u0dbb\u0db1 \u0db8\u0dcf\u0dcf\u0dad\u0dbd\u0dda\u0262 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda\u024f \u0d8b\u0d9a\u0dd4\u0dc0\u0dd9\u0dd9\u0dbd \u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba\u0da7 \u0d85\u0dba\u0dad\u0dca \u0dc0\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dc0\u0dd6 \u0d85\u0d82\u0d82\u0d9a 355 \u0d8b\u0d9a\u0dd4\u0dc0\u0dd9\u0dd9\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 359 \u0db8\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0db6\u0ddc\ufffd\u0ddc\u0da9 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 359A \u0db4\u0dbb\u0d9c\u0dc4\u0dc0\u0dd9\u0dd9\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8 \u0dba\u0db1 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dca \u0dc0\u0dbd\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0, \u0d85\u0d82\u0d82\u0d9a 347B, \u0d9a\u0dd0\u0dd0\u0db1\u0dca\u0daf\u0d9c\u0ddc\ufffd\u0ddc\u0dbd\u0dca\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0d8b\u0d9a\u0dd4\u0dc0\u0dd9\u0dd9\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0da7 \u0d85\u0dba\u0dad\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0daf, \u0d85\u0d82\u0d82\u0d9a 355C \u0d9a\u0ddc\ufffd\u0ddc\u0dc4\u0ddc\ufffd\u0ddc\u0db9\u0dd2\u0dbd\u0dd2\u0dc0\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0d8b\u0d9a\u0dd4\u0dc0\u0dd9\u0dd9\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0da7 \u0d85\u0dba\u0dad\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0daf, \u0d85\u0d82\u0d82\u0d9a 356A \u0daf\u0dd9\u0dd9\u0dc4\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 355A \u0d87\u0dbd\u0dca\u0dc0\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 357A \u0d9a\u0dc5\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 359B \u0db8\u0dcf\u0dcf\u0db6\u0dda\u0229\u0dbb\u0dd2\u0dba \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 360 \u0db8\u0dcf\u0dcf\u0dbb\u0dd4\u0d9a\u0ddc\ufffd\u0ddc\u0db1 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 356B \u0db8\u0dd3\u0daf\u0dd9\u0dd9\u0dab\u0dd2\u0dba \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 346B \u0db1\u0dcf\u0dcf\u0d9c\u0dc4\u0dad\u0dd0\u0dd0\u0db1\u0dca\u0db1 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 355D \u0db1\u0dcf\u0dcf\u0d9c\u0ddc\ufffd\u0ddc\u0dbd\u0dca\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 346A \u0db4\u0dc4\u0dc5\u0dc0\u0dd9\u0dd9\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 346 \u0db4\u0dd4\u0dbb\u0dd2\u0da2\u0dca\u0da2\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 355B \u0dad\u0dc0\u0dbd\u0d82\u0d82\u0d9a\u0ddc\ufffd\u0ddc\u0dba \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 347 \u0d8b\u0da9\u0dd4\u0db4\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 357B \u0d8b\u0da9\u0dd4\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 356 \u0dc0\u0dbb\u0d9a\u0dcf\u0dcf\u0db8\u0dd4\u0dbb \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0d85\u0d82\u0d82\u0d9a 355E \u0dc0\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0db4\u0ddc\ufffd\u0ddc\u0dc5 \u0dc0\u0dad\u0dca\u0dad \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf, \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 347A \u0dc4\u0dbd\u0d82\u0d82\u0d9c\u0ddc\ufffd\u0ddc\u0da9 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0daf, \u0d87\u0dad\u0dd4\u0dbd\u0dad\u0dca \u0dc0\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dc0\u0dd4 \u0db8\u0dd4\u0dc5\u0dd4\u0db8\u0dc4\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba \u0d87\u0dad\u0dd4\u0dbd\u0dad\u0dca \u0dc0\u0dda\u0dda.",
