    ],
    "text": "\u0d85\u0d82\u0d82\u0d9a 347B \u0d9a\u0dd0\u0dd0\u0db1\u0dca\u0daf\u0d9c\u0ddc\ufffd\u0ddc\u0dbd\u0dca\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8\u0dca \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u200d\u0dba\u0dba\u0dba \u0dc4\u0dcf\u0dcf \u0db8\u0dcf\u0dcf\u0dad\u0dbd\u0dda\u0262 \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf \u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db1\u0dd2\u0dbb\u0dd2\u0dad \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8 \u0dc4\u0db8\u0dd4\u0dc0\u0db1 \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u200d\u0dba\u0dba\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0dc0\u0dd3 \u0db8\u0dcf\u0dcf\u0dad\u0dbd\u0dda\u0262 \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf \u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0 \u0d94\u0dc3\u0dca\u0dc3\u0dda\ufffd\u0dda \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb \u0daf\u0dd2\u0dc1\u0dcf\u0dcf\u0db1\u0dd4\u0d9c\u0dad\u0dc0 \u0d87\u0db3\u0dd2 \u0dbb\u0dda\u0dda\u0d9b\u0dcf\u0dcf\u0dc0 \u0d85\u0d82\u0d82\u0d9a 347B \u0d9a\u0dd0\u0dd0\u0db1\u0dca\u0daf\u0d9c\u0ddc\ufffd\u0ddc\u0dbd\u0dca\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0d8a\u0dc3\u0dcf\u0dcf\u0db1 \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8 \u0dc4\u0db8\u0dd4\u0dc0\u0db1 \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u200d\u0dba\u0dba\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf\u0daf, \u0d91\u0dad\u0dd0\u0dd0\u0db1\u0dca \u0dc3\u0dd2\u0da7 \u0d85\u0d82\u0d82\u0d9a 347B \u0d9a\u0dd0\u0dd0\u0db1\u0dca\u0daf\u0d9c\u0ddc\ufffd\u0ddc\u0dbd\u0dca\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0d8a\u0dc3\u0dcf\u0dcf\u0db1 \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8 \u0d94\u0dc3\u0dca\u0dc3\u0dda\ufffd\u0dda \u0d9c\u0dd2\u0db1\u0dd2\u0d9a\u0ddc\ufffd\u0ddc\u0db1 \u0daf\u0dd2\u0dc1\u0dcf\u0dcf\u0db1\u0dd4\u0d9c\u0dad \u0d87\u0db3\u0dd2 \u0dbb\u0dda\u0dda\u0d9b\u0dcf\u0dcf\u0dc0 \u0d85\u0d82\u0d82\u0d9a 346A \u0db4\u0dc4\u0dbd\u0dc0\u0dd9\u0dd9\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0dc0\u0dba\u0db9 \u0daf\u0dd2\u0d9c \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8 \u0dc4\u0db8\u0dd4\u0dc0\u0db1 \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u200d\u0dba\u0dba\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf\u0daf, \u0d91\u0dad\u0dd0\u0dd0\u0db1\u0dca \u0dc3\u0dd2\u0da7 \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb, \u0d8a\u0dc3\u0dcf\u0dcf\u0db1, \u0d8b\u0dad\u0dd4\u0dbb, \u0d9c\u0dd2\u0db1\u0dd2\u0d9a\u0ddc\ufffd\u0ddc\u0db1, \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb \u0dc4\u0dcf\u0dcf \u0d8a\u0dc3\u0dcf\u0dcf\u0db1 \u0daf\u0dd2\u0dc1\u0dcf\u0dcf\u0db1\u0dd4\u0d9c\u0dad\u0dc0 \u0d87\u0db3\u0dd2 \u0dbb\u0dda\u0dda\u0d9b\u0dcf\u0dcf\u0dc0 \u0d85\u0d82\u0d82\u0d9a 355C \u0d9a\u0ddc\ufffd\u0ddc\u0dc4\u0ddc\ufffd\u0ddc\u0db9\u0dd2\u0dbd\u0dd2\u0dc0\u0dd9\u0dd9\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0db1\u0dd2\u0dbb\u0dd2\u0dad \u0daf\u0dd2\u0d9c \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8 \u0dc4\u0db8\u0dd4\u0dc0\u0db1 \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u200d\u0dba\u0dba\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf\u0daf \u0d91\u0dad\u0dd0\u0dd0\u0db1\u0dca \u0dc3\u0dd2\u0da7 \u0d85\u0d82\u0d82\u0d9a 355C \u0d9a\u0ddc\ufffd\u0ddc\u0dc4\u0ddc\ufffd\u0ddc\u0db9\u0dd2\u0dbd\u0dd2\u0dc0\u0dd9\u0dd9\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0db1\u0dd2\u0dbb\u0dd2\u0dad \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8 \u0d94\u0dc3\u0dca\u0dc3\u0dda\ufffd\u0dda \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0daf\u0dd2\u0dc1\u0dcf\u0dcf\u0db1\u0dd4\u0d9c\u0dad\u0dc0 \u0d87\u0db3\u0dd2 \u0dbb\u0dda\u0dda\u0d9b\u0dcf\u0dcf\u0dc0 \u0db8\u0dcf\u0dcf\u0dad\u0dbd\u0dda\u0262 \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf \u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0d9c\u0dd2\u0db1\u0dd2\u0d9a\u0ddc\ufffd\u0ddc\u0db1 \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8 \u0dc4\u0db8\u0dd4\u0dc0\u0db1 \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u200d\u0dba\u0dba\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf\u0daf, \u0d91\u0dad\u0dd0\u0dd0\u0db1\u0dca \u0dc3\u0dd2\u0da7 \u0db8\u0dcf\u0dcf\u0dad\u0dbd\u0dda\u0262 \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf \u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8 \u0d94\u0dc3\u0dca\u0dc3\u0dda\ufffd\u0dda, \u0d8b\u0dad\u0dd4\u0dbb \u0dc4\u0dcf\u0dcf \u0d8a\u0dc3\u0dcf\u0dcf\u0db1 \u0daf\u0dd2\u0dc1\u0dcf\u0dcf\u0db1\u0dd4\u0d9c\u0dad\u0dc0 \u0d87\u0db3\u0dd2 \u0dbb\u0dda\u0dda\u0d9b\u0dcf\u0dcf\u0dc0 \u0d85\u0d82\u0d82\u0d9a 355E \u0dc0\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0db4\u0ddc\ufffd\u0ddc\u0dbd \u0dc0\u0dad\u0dca\u0dad \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 352H \u0d94\u0dba \u0db4\u0dc4\u0dc5 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dca \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8 \u0dc4\u0db8\u0dd4\u0dc0\u0db1 \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u200d\u0dba\u0dba\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf\u0daf, \u0d91\u0dad\u0dd0\u0dd0\u0db1\u0dca \u0dc3\u0dd2\u0da7 \u0d85\u0d82\u0d82\u0d9a 355E \u0dc0\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0db4\u0ddc\ufffd\u0ddc\u0dbd\u0dc0\u0dad\u0dca\u0dad \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8 \u0d94\u0dc3\u0dca\u0dc3\u0dda\ufffd\u0dda \u0d8a\u0dc3\u0dcf\u0dcf\u0db1 \u0daf\u0dd2\u0dc1\u0dcf\u0dcf\u0dc0\u0da7 \u0d85\u0d82\u0d82\u0d9a 370 \u0d8b\u0dbd\u0dca\u0db4\u0dad\u0dcf\u0dcf\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0db3\u0dd2 \u0dbb\u0dda\u0dda\u0d9b\u0dcf\u0dcf\u0dc0 \u0d85\u0d82\u0d82\u0d9a 370 \u0d8b\u0dbd\u0dca\u0db4\u0dad\u0dcf\u0dcf\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8 \u0dc4\u0db8\u0dd4\u0dc0\u0db1 \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u200d\u0dba\u0dba\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf\u0daf,",
