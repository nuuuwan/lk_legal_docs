    ],
    "text": "ATU/LND/04/DO62. \u0d89\u0da9\u0dda \u0d85\u0dda\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dba\u0dda \u0db3\u0db1\u0dba\u0dda (460 \u0dbd\u0dd0\u0db1\u0dd2 \u0db3\u0dbb\u0dd2\u0da0\u0dca\u0dba\u0dda\u0daf\u0dba) 38 \u0dbd\u0dd0\u0db1\u0dd2 \u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba\u0dda (\u0d85) \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba\u0dba\u0dca\u0dad \u0db8\u0dcf \u0dba\u0dbd\u0dcf \u0db3\u0dbd\u0dbb\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dbc\u0dcf\u0dbc \u0d85\u0db1\u0dd4\u0dbd, \u0d9a\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8, \u0db3\u0dc1\u0dd4 \u0dc0\u0dda\u0db3\u0dda, \u0d89\u0da9\u0dda \u0dc1\u0dcf \u0dbd\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0dcf\u0dcf\u0dba \u0d9a\u0dd4\u0dbb\u0d9c\u0db8\u0dba\u0dda \u0dba\u0daf\u0ddc\u0dca\u0dad \u0dbc\u0dcf\u0dbd\u0dca \u0d9a\u0dcf\u0dca\u0dad\u0dcf \u0dbd\u0db1 \u0db8\u0db8 \u0db3\u0dc1\u0dcf \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0d8b\u0db3\u0dba\u0dbd\u0dca\u0d9b\u0db1\u0dba\u0dda 1 \u0dbd\u0dd0\u0db1\u0dd2 \u0dba\u0dda\u0daf\u0dba\u0dda \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0d89\u0da9\u0dda \u0d85\u0dda\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dba\u0dda \u0db1\u0dd2\u0dbc\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0dcf\u0da7 \u0db1\u0dd0\u0dcf\u0dba\u0dc1\u0ddc\u0dda, \u0d91\u0d9a\u0dd3 \u0db1\u0dd2\u0dbc\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dad \u0d92 \u0dc0\u0db2\u0dc1\u0dcf \u0db6\u0dbc\u0dba \u0dba\u0daf\u0db1 \u0dbc\u0daf \u0dba\u0dbd\u0db1\u0dda \u0db1\u0dd2\u0dbc\u0db0\u0dcf\u0dbb\u0dd2 \u0dba \u0dba\u0d9a\u0dd4\u0da7, \u0d91\u0db8 \u0d8b\u0db3\u0dba\u0dbd\u0dca\u0d9b\u0db1\u0dba\u0dba\u0dd2 2 \u0dbd\u0dd0\u0db1\u0dd2 \u0dba\u0dda\u0daf\u0dba\u0dda \u0daf\u0dd0\u0d9a\u0dca\u0dba\u0dbd\u0db1 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dcf \u0d89\u0da9\u0db8 \u0dc0\u0dca\u0dbd\u0dcf\u0db8\u0dd2\u0dda\u0dbd\u0dba\u0da7 \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb\u0db8\u0dd2. \u0dba\u0d9a\u0dca.\u0da9\u0dd3. \u0dbc\u0dcf\u0dbd\u0dca \u0d9a\u0dcf\u0dca\u0dad\u0dcf, \u0d9a\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8, \u0db3\u0dc1\u0dd4 \u0dc0\u0dda\u0db3\u0dda, \u0d89\u0da9\u0dda \u0dc1\u0dcf \u0dbd\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0dcf\u0dcf\u0dba. 2024 \u0dba\u0daf\u0dc0\u0dd0\u0dda\u0db6\u0dbb\u0dca \u0db8\u0dc0 04 \u0dbd\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0d9a\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8, \u0db3\u0dc1\u0dd4 \u0dc0\u0dda\u0db3\u0dda, \u0d89\u0da9\u0dda \u0dc1\u0dcf \u0dbd\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0dcf\u0dcf\u0dba\u0dcf\u0d82\u0dbe\u0dba, \u0d89\u0da9\u0dda \u0db8\u0dc1 \u0dba\u0dbd\u0dca\u0d9a\u0dda \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbc\u0dba, \u2015\u0db8\u0dd2\u0dd2 \u0d9a\u0dcf \u0db8\u0dd0\u0daf\u0dd4\u0dbb\u2016, \u0d85\u0d82\u0d9a 1200/6, \u0dbb\u0da2\u0dcf\u0db8\u0dbd\u0dca\u0dbd\u0dda\u0dcf \u0db3\u0dcf\u0dbb, \u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbc.",
