    "text": "\u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013--\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 \u0dc0\u0dd2\u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u0ddd \u0db4\u0dad \u0d85\u0d82\u0d9a\u0dba \u0d89\u0db1\u0dca\u0dd9\u0da2\u0db1\u0dca\u0dc2\u0db1\u0dca \u0dad\u0dc4\u0db1\u0db8\u0dca \u0dd9\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0dc4 \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd\u0dad\u0dca\u0dc0\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dd9\u0d9c\u0dca/\u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dd9\u0dba\u0dca \u0d85\u0dd9\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dcf\u0dd9\u0dc0\u0db1\u0dca \u0d87\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dd9\u0dc3\u0dda \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db1\u0db8/\u0db1\u0db8\u0dca \u0dc3\u0dc4 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u0dc4\u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dc4 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dca \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u0db4\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1:25 0.0509 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d91\u0dbd\u0dca \u0d91\u0dbd\u0dca \u0db1\u0dd2\u0dba\u0dcf/ 35\u0db6\u0dd3/3060 \u0dba\u0db1 \u0db6\u0dbd\u0db4\u0dad\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc3\u0dd3\u0dbd\u0dc0\u0dad\u0dd3 \u0db6\u0dca\u0dd9\u0dbd\u0ddc\u0d9a\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0db1\u0dd4 \u0dbd\u0db6\u0dba\u0dd2. 1:58 0.0857 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d91\u0dbd\u0dca \u0d91\u0dbd\u0dca \u0db1\u0dd2\u0dba\u0dcf/ 35\u0db6\u0dd3/3102 \u0dba\u0db1 \u0db6\u0dbd\u0db4\u0dad\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0d8b\u0dd9\u0daf\u0dca\u0dc1\u0dd2\u0d9a\u0dcf \u0dc3\u0db3\u0db8\u0dcf\u0dbd\u0dd2 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0db1\u0dd4 \u0dbd\u0db6\u0dba\u0dd2. 1:67 0.0421 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d91\u0dbd\u0dca \u0d91\u0dbd\u0dca \u0db1\u0dd2\u0dba\u0dcf/ 35\u0db6\u0dd3/3667\u0dba\u0db1 \u0db6\u0dbd\u0db4\u0dad\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc0\u0dd0\u0dba\u0dd2\u0dd9\u0dc4\u0dda\u0db1\u0dd9\u0d9c\u0dca \u0dc0\u0dd2\u0d9a\u0dd4\u0db8\u0dca \u0dbd\u0d9a\u0dca\u0db8\u0dcf\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0db1\u0dd4 \u0dbd\u0db6\u0dba\u0dd2. 1:71 0.0467 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d91\u0dbd\u0dca \u0d91\u0dbd\u0dca \u0db1\u0dd2\u0dba\u0dcf/ 35\u0db6\u0dd3/3104\u0dba\u0db1 \u0db6\u0dbd\u0db4\u0dad\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc3\u0dd4\u0db8\u0dd2\u0dad\u0dca \u0dc0\u0dd2\u0dd9\u0da2\u0dca\u0dd9\u0dc3\u0dda\u0d9a\u0dbb \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0db1\u0dd4 \u0dbd\u0db6\u0dba\u0dd2. 1:80 0.0545 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d91\u0dbd\u0dca \u0d91\u0dbd\u0dca \u0db1\u0dd2\u0dba\u0dcf/ 35\u0db6\u0dd3/3537\u0dba\u0db1 \u0db6\u0dbd\u0db4\u0dad\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc4\u0dd1\u0dd9\u0d9c\u0ddc\u0da9 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0dad\u0dd2\u0dbd\u0d9a\u0dcf\u0dc0\u0dad\u0dd3 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0db1\u0dd4 \u0dbd\u0db6\u0dba\u0dd2. 1:88 0.0576 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d91\u0dbd\u0dca \u0d91\u0dbd\u0dca \u0db1\u0dd2\u0dba\u0dcf/ 35\u0db6\u0dd3/2586 \u0dba\u0db1 \u0db6\u0dbd\u0db4\u0dad\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0d9a\u0dc5\u0dd4 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0dc0\u0dc3\u0db1\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0db1\u0dd4 \u0dbd\u0db6\u0dba\u0dd2. 1:113 0.0575 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u