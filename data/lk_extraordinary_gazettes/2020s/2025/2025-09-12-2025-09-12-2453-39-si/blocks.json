    "bbox": [
      55.14,
      614.13,
      298.17,
      709.69
    ],
    "text": "01. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb \u201c\u0d92\u201d \u2013 \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0729 \u0d8b\u01b1\u0dbb\u0da7: \u027c \u0dbb\u0dcf\u0291\u0dbd \u0db8\u0dcf\u0dc0\u0dad \u0dc3\u0dc4 \u0219.\u0150. \u0d85\u01e7\u0262 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dd9\u0daf\u0262\u0d9c\u0dc4\u0dc0\u01ae\u0dad \u0dd9\u0db1\u02a3\u0dd9\u0dc4\u02a3\u01ae \u0db6\u0dd0\u0da7\u025c\u0dc0\u01ae\u0dad; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0219.\u0150. \u0d85\u01e7\u0262 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dc3\u0dc4 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u00fb \u0dd9\u0daf\u0262\u0d9c\u0dc4\u0dc0\u01ae\u0dad \u0dd9\u0db1\u02a3\u0dd9\u0dc4\u02a3\u01ae \u0db6\u0dd0\u0da7\u025c\u0dc0\u01ae\u0dad; \u0daf\u00fd\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb, \u022b.\u0287. \u0dc3\u0dc4 \u0dbb\u0da2\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u027c \u0dbb\u0dcf\u0291\u0dbd \u0db8\u0dc4\u0dcf \u026a\u0daf\u0255\u0dcf\u0dbd\u0dba; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0dd9\u0dad\u01e6\u0db1\u0dd9\u0d9a\u02a4\u01e6 \u023f\u01ce\u0dba\u01e6\u0dd9\u0dc3\u02a2\u0dbd\u0dcf\u0dd9\u0118 \u0dc0\u0259\u0dab\u0dbb\u01ae\u0db1 \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dc3\u021a\u0d9c\u0dc4\u0dc0\u01ae\u0dad.",
    "fonts": [
      "IskoolaPota",
      "IskoolaPota-Bold"
    ],
    "sizes": [
      10.0
    ]
  },
