    "text": "\u0dc1\u0dd9\u0db1\u0dd3 \u0dc3\u0dd2\u0daf\u0da7\u0dd3\u0db8 \u0dc0\u0dc1 \u0dc1\u0dda\u0dbb\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dab \u0dc0\u0dd2\u0db7\u0dcf\u0d9c \u0dd9\u0da7\u0dd2\u0dd9\u0dcf\u0da7\u0dd2\u0dba \u0dba\u0db8\u0db8 \u0db3\u0dbb\u0dd3\u0dca\u0dbf\u0db4 2024 \u0da2\u0dd4\u0dd2\u0dba 03 \u0daf\u0dd2\u0db1\u0da7 \u0db8\u0dd4\u0dbd\u0dca\u0dbd\u0dbb\u0da7 \u0d9a\u0dd0\u0db2\u0dbd\u0db1 \u0dbc\u0daf \u0daf\u0dd2\u0db1\u0dba\u0dda \u0dc3\u0dd2\u0daf\u0da7 \u0dba\u0db6\u0dca\u0dbb\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0db4 \u0dc0\u0dd2\u0db7\u0dcf\u0d9c\u0dba \u0d85\u0dbd\u0dc0\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0dbc\u0daf \u0d9a\u0dcf\u0dbc\u0dba \u0dad\u0dd4\u0dbc \u0dc0\u0dd0\u0db8 \u0daf\u0dd2\u0db1\u0d9a\u0db8 \u0dba\u0daf\u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0dba\u0db8 \u0db3\u0dd0\u0db8\u0dd2\u0db4 \u0dc3\u0dd2\u0daf\u0da7\u0dd2\u0db1 \u0dbc\u0daf\u0dd2. \u0db3\u0dbc\u0db8\u0dd4 \u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dbd\u0db1 \u0d9a\u0dc0\u0dca. \u0db4\u0dd4\u0dbf\u0dca\u0db3\u0dbb\u0dcf\u0dab\u0dd2 \u0db8\u0dc1\u0dda\u0db8\u0dd2\u0dba \u0d85\u0dc0\u0db1\u0dd3\u0db3 \u0db6\u0dd0\u0dc0\u0dd2\u0dca\u0dad 2024 \u0da2\u0dd4\u0dd2\u0dba 03 \u0daf\u0dd2\u0db1 \u0dba\u0db1\u0ddc\u0db3\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dba\u0daf \u0d92 \u0dba\u0dbd\u0dd4 \u0dba\u0dbd\u0dca\u0dad \u0d87\u0dba\u0dda \u0dc0\u0dca\u0dbd\u0dcf\u0db8\u0dd2 \u0db4\u0dd4\u0dbb\u0dd4\u0dbf\u0dba\u0dcf \u0db3\u0dd0\u0db8\u0dd2\u0db4 \u0dc3\u0dd2\u0daf\u0da7\u0dd2\u0db1 \u0dbc\u0daf\u0dd2. (\u0db1\u0db8\u0dd4\u0dda \u0dc0\u0dd2\u0dbd\u0dcf\u0dc1 \u0dc0\u0dc1\u0dad\u0dd2\u0d9a\u0dba \u0dba\u0dc1\u0ddd \u0db6\u0dbc\u0dba \u0db3\u0dbd\u0dbb\u0db1 \u0dbc\u0daf \u0dd2\u0db1\u0dd2\u0dba\u0dba\u0dca \u0dc4\u0daf\u0dd2\u0dbb\u0dd2\u0db3\u0dda \u0dba\u0db1\u0ddc\u0d9a\u0dbb\u0db1 \u0dbc\u0daf\u0dd2.) \u0dba\u0daf\u0dbd\u0db1 \u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0dba \u0dba\u0dbd\u0dd4 \u0dba\u0dbd\u0dca\u0dad \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0dc4\u0dca\u0db0\u0daf\u0db8\u0dbd\u0dca\u0dba\u0d9c\u0ddc\u0da9 \u0dba\u0db8\u0db1\u0dc0\u0dd2\u0dba \u0dba\u0db3\u0db1\u0dd3 \u0dc3\u0dd2\u0daf\u0da7\u0dd2 \u0dbe\u0dcf\u0dca\u0dad\u0dcf \u0dc0\u0dd2\u0dca\u0dad\u0dba\u0dc0\u0dca\u0dad\u0dad\u0dd2 \u0dd2\u0dba\u0dbd\u0dcf\u0dc0 \u0db7\u0dcf\u0dbb\u0d9a\u0dbb\u0dd4 \u0da2\u0dd5\u0da9\u0dca \u0dc0\u0db3\u0dbb\u0db8\u0dcf\u0daf\u0dd4 \u0dd2\u0dba\u0dba\u0dad\u0dd4\u0db8\u0dcf \u0db3\u0dd0\u0db8\u0dd2\u0db4 \u0dc3\u0dd2\u0daf\u0da7\u0dd2. \u0d9a\u0daf\u0dd2\u0db1 \u0da9\u0dd3. \u0db4\u0dd3. \u0da2\u0dd3. \u0dc3\u0dd4\u0db7\u0dcf\u0dbf\u0dca \u0da0\u0db8\u0dd2\u0dca\u0dad\u0daf \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dca\u0dad\u0daf\u0dd4 \u0dd2\u0dba\u0dba\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0db3\u0dd0\u0db8\u0dd2\u0dd3\u0db8\u0db8\u0da7 \u0dba\u0db1\u0ddc\u0dc1\u0dd0\u0d9a\u0dd2 \u0db6\u0dbd\u0dda \u0dc5\u0dc2 \u0daf\u0dd2\u0db1\u0dba\u0dda \u0dc3\u0dd2\u0daf\u0da7 \u0db3\u0dd0\u0db8\u0dd2\u0dba\u0db4\u0db1 \u0db6\u0dbd\u0dda \u0daf\u0dca\u0dad\u0dbd\u0db1 \u0dbc\u0daf\u0dd3. 2024/05/27 \u0dbd\u0db1 \u0daf\u0dd2\u0db1 \u0dd2\u0db1\u0dd2\u0dba\u0dba \u0db8\u0d9c\u0dd2\u0dca\u0dad \u0dc0\u0db8\u0dca\u0db4\u0dd5\u0dbb\u0dca\u0db4 \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbe (\u0dd6\u0dbd\u0dbc\u0dba\u0dba\u0dba \u0d85\u0d9c\u0dba\u0dba\u0dca\u0dad \u0d87\u0dda\u0db1\u0db8\u0dca \u0d92 \u0dd2\u0dba\u0dc5\u0dd2\u0db6\u0db2\u0dbd \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbe\u0dba) \u0dd2\u0dba\u0da7\u0db3\u0dda 3 \u0dca \u0dbb\u0dd0\u0dba\u0d9c\u0db1 \u0d9a\u0db1 \u0dba\u0dbc\u0dc0\u0da7 \u0daf\u0dca\u0dad\u0dbd\u0dcf \u0dc3\u0dd2\u0daf\u0da7\u0dd2\u0dba\u0daf \u0d85\u0daf \u0daf\u0dd2\u0db1 \u0d9a\u0db8 \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbe \u0dba\u0daf\u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0dba\u0db8 \u0dc4\u0daf\u0dd2\u0dbb\u0dd2\u0db3\u0dda \u0dba\u0db1\u0ddc\u0d9a\u0dbb\u0dd2\u0db1. \u0dba\u0db8\u0db8 \u0db3\u0dbb\u0dd3\u0dca\u0dbf\u0db4 2024 \u0da2\u0dd5\u0dd2\u0db1 07 \u0daf\u0dd2\u0db1 \u0d9a\u0dd0\u0db2\u0dc0\u0dd4 \u0d85\u0dbd\u0dc0\u0dca\u0dae\u0dcf\u0dba\u0dda \u0db3\u0dc2\u0db8\u0dd4 \u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0dba \u0dba\u0dbd\u0dd4 \u0dba\u0dbd\u0dca\u0dad \u0d9a\u0dca\u0da1. \u0dc3\u0dd3. \u0dc5. \u0db4\u0dd3\u0dbb\u0dd2\u0dc0\u0dca \u0db8\u0dc1\u0dcf\u0dcf \u0dba\u0db3\u0db1\u0dd3 \u0dc3\u0dd2\u0daf\u0da7\u0dd3. \u0dba\u0daf\u0dbd\u0db1 \u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0dba \u0dba\u0dbd\u0dd4 \u0dba\u0dbd\u0dca\u0dad \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0da9\u0dd3. \u0db4\u0dd3. \u0da2\u0dd3. \u0dc3\u0dd4\u0db7\u0dcf\u0dbf\u0dca \u0da0\u0db8\u0dd2\u0dca\u0dad\u0daf \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dca\u0dad\u0daf\u0dd4 \u0dd2\u0dba\u0dba\u0dad\u0dd4\u0db8\u0dcf \u0dc0\u0db8\u0d9c \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0dc3\u0dd4\u0daf\u0dbb\u0dca\u0dbe \u0da9\u0dd3. \u0daf \u0dc3\u0dd2\u0daf\u0dbd\u0dca\u0dbd\u0dcf \u0db8\u0dc1\u0dcf\u0dcf \u0dba\u0db3\u0db1\u0dd3 \u0dc3\u0dd2\u0daf\u0da7\u0dd3. \u0dc0\u0dcf\u0dca\u0dc2\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0da5\u0dcf \u0daf\u0dd3\u0dba\u0db8\u0dca\u0dad \u0db3\u0dc3\u0dd4\u0dbd \u0dc0\u0dcf\u0dca\u0dc2\u0dd2 \u0dbc\u0db6\u0dcf \u0dba\u0daf\u0dd2\u0db1. \u0dc0\u0dcf\u0dca\u0dc2\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dc0\u0dcf\u0dca\u0dad\u0dcf \u0dc0\u0dd2\u0dca\u0dad\u0dba\u0dc0\u0dca\u0dad\u0dad\u0dd2 \u0dd2\u0dba\u0dbd\u0dba\u0dc0\u0dda \u0dba\u0dc0\u0dda\u0dbd\u0dba \u0dc0\u0db2\u0dc1\u0dcf 2012.09.24 \u0dba\u0dbd\u0dd2\u0dba \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0daf\u0da7 \u0dba\u0dc0\u0dda\u0dbd\u0dba\u0da7 \u0db6\u0dd0\u0db3\u0dd3 \u0dad\u0dd2\u0dba\u0db6\u0dca. \u0d87\u0dba\u0da7 2016.06.01 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0daf\u0da7 \u0daf\u0daf\u0dd2\u0dba\u0d9a\u0dbd \u0dba\u0d9c\u0dbd\u0db1 \u0dbc\u0daf \u0dbd\u0dd0\u0da7\u0dd4\u0db3 \u0db8\u0dcf\u0dc3\u0dd2\u0daf\u0d9a\u0dbd \u0dbd\u0dd0\u0da7\u0dd4\u0db3\u0dca \u0dba\u0dbc\u0dc0\u0da7 \u0db8\u0dcf\u0dbb\u0dd4\u0d9a\u0dbb \u0dd2\u0dba\u0dbd\u0dcf\u0da9\u0dd4 \u0daf \u0dbc\u0db6\u0dcf \u0daf\u0dd3 \u0d87\u0dcf. \u0dbd\u0dbb\u0dca\u0dbf \u0d85\u0dbd\u0dc0\u0dcf\u0db1\u0dba\u0dda \u0d87\u0dba\u0da7 \u0dc4\u0dad\u0dd2\u0dbb\u0dd2 \u0dd2\u0dba\u0dbd\u0dcf\u0da9\u0dd4 \u0dbd\u0dbc\u0da7 \u0dba\u0d9c\u0dd3 \u0db8\u0dca \u0d9a\u0dbb\u0db1 \u0db6\u0dbd\u0da7 \u0daf \u0daf\u0dca\u0dad\u0dbd\u0dcf \u0d87\u0dcf. \u0d9a\u0db8 \u0dd2\u0db1\u0dd2\u0dba\u0dba \u0d87\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0daf\u0dca\u0dad \u0db7\u0dcf\u0dbb \u0dba\u0d9c\u0db1 \u0d85\u0dda\u0dc0\u0dca\u0dad \u0d9a\u0dbb \u0d87\u0dcf. 2014.04.23 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0dd2\u0db1\u0dd2\u0dba\u0dba\u0dba\u0dca\u0dad \u0d87\u0dba\u0da7 \u0dc0\u0dc1 \u0d87\u0dba\u0dda \u0dc0\u0dca\u0dbd\u0dcf\u0db8\u0dd2 \u0db4\u0dd4\u0dbb\u0dd4\u0dbf\u0dba\u0dcf\u0da7 2012.09.24 \u0db3\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0dba\u0da7 \u0d9a\u0db8 \u0d86\u0dba\u0dcf\u0db1\u0dba \u0dad\u0dd4\u0dbc \u0dba\u0d9a\u0ddc\u0dca\u0dad\u0dba\u0dca\u0db0\u0dc3\u0dd2\u0daf \u0db1\u0dbd\u0dba\u0dca (09) \u0dc0\u0dc4\u0dd2\u0dcf \u0dd2\u0db1\u0dd2\u0dba\u0dba\u0d9a\u0dd2\u0dca\u0dad \u0dd2\u0dba\u0dbd\u0dc0\u0dca \u0db7\u0dcf\u0dbb \u0daf\u0dd3 \u0d87\u0dcf. \u0d9a\u0db8 \u0dd2\u0db1\u0dd2\u0dba\u0dba \u0d87\u0dba \u0d85\u0dda\u0dc0\u0dca\u0dad \u0d9a\u0dbb \u0db7\u0dcf\u0dbb\u0d9c\u0dda \u0db6\u0dbd\u0da7 \u0dd2\u0dba\u0dd2\u0db1 \u0d9c\u0db1\u0dd3. \u0dc0\u0dcf\u0dca\u0dc2\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0daf\u0dca\u0dad 2016.09.30 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0dd2\u0db1\u0dd2\u0dba\u0dba \u0d87\u0dba 2016/10/03 \u0daf\u0dd2\u0db1 \u0db7\u0dcf\u0dbb\u0dba\u0d9c\u0db1 \u0d87\u0dcf. \u0d9a\u0dc4\u0dd2 \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0d9a\u0dbb \u0d87\u0dda\u0dba\u0dda \u0d87\u0dba\u0dba\u0dda \u0dc0\u0dca\u0dbd\u0dcf\u0db8\u0dd2\u0db4\u0dd4\u0dbb\u0dd4\u0dbf\u0dba\u0dcf \u0dbd\u0db1 \u0dba\u0dca. \u0d92. \u0da9\u0dd3. \u0dba\u0da2\u0dcf\u0dbb\u0dd3 \u0db1\u0dcf\u0db1\u0dcf\u0dba\u0dca\u0d9a\u0dcf\u0dbb \u0dba\u0db1 \u0d85\u0dba\u0dba\u0dda \u0dba\u0dc0\u0dda\u0dbd\u0dba 2016.09.25 \u0dc3\u0dd2\u0daf\u0da7 \u0d85\u0dda\u0dc4\u0dd2\u0da7\u0dd4\u0dbd\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dd0\u0dc0\u0dd2\u0dca\u0dad 2016.10.15 \u0dca\u0dad \u0db3\u0dc3\u0dd4 \u0d9a\u0db8 \u0dd2\u0dba\u0dbd\u0dba\u0dc0\u0dda \u0dc3\u0dd2\u0daf\u0da7\u0dd2\u0dba \u0dba\u0db1\u0ddc\u0dc1\u0dd0\u0d9a\u0dd2 \u0db6\u0dbd\u0dda \u0d87\u0dba \u0dd2\u0dba\u0da7\u0dcf \u0dc3\u0dd2\u0daf\u0da7 \u0dba\u0dc0\u0dda\u0dbd\u0dba\u0da7 \u0db3\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dbd\u0dda \u0dba. \u0d87\u0dba \u0dba\u0dc0\u0dda\u0dbd\u0dba\u0da7 \u0dd2\u0dba\u0da7\u0dcf \u0dc3\u0dd2\u0daf\u0da7 \u0db3\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0db6\u0dbd \u0daf\u0dca\u0dad\u0dbd\u0dcf \u0dc3\u0dd2\u0daf\u0da7\u0dd2\u0dba\u0daf \u0d87\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0daf\u0dca\u0dad \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0db8 \u0dba\u0dbd\u0dca\u0d9b\u0db1\u0dba\u0dca \u0d85\u0dda\u0dc0\u0dca\u0dad \u0d9a\u0dbb \u0db1\u0dd0\u0dcf. \u0d87\u0dba \u0daf\u0dca\u0dad\u0dbd\u0dcf \u0dc3\u0dd2\u0daf\u0da7\u0dd2\u0dca\u0dad\u0dba\u0dca\u0dad \u0d87\u0dba\u0da7 \u0dba\u0dc0\u0dda\u0dbd\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dbd\u0dc0\u0dca\u0dae\u0dcf\u0dbd \u0dbc\u0db6\u0dcf \u0dba\u0db1\u0ddc\u0daf\u0dd3\u0db8\u0dd2\u0db1. \u0db3\u0dbb\u0dd3\u0dca\u0dbf\u0db4\u0dba\u0dda \u0daf\u0dd3 \u0dba\u0db3\u0db1\u0dd3 \u0dba\u0dca\u0dad\u0dba\u0dca\u0dad \u0d87\u0dba \u0dba\u0dc0\u0dda\u0dbd\u0dba\u0da7 \u0dbd\u0dcf\u0dbb\u0dca\u0dcf\u0dcf \u0dba\u0db1\u0ddc\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd2\u0db1. \u0db3\u0dbc\u0db8\u0dd4 \u0dbd\u0db1 \u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0dba \u0dba\u0dbd\u0dd4 \u0dba\u0dbd\u0dca\u0dad \u0dc0\u0dcf\u0dca\u0dc2\u0dd2 \u0daf\u0dd3\u0db8\u0da7 \u0d9a\u0dd0\u0db2\u0dd6 \u0d9a\u0dc0\u0dca. \u0db4\u0dd4\u0dbf\u0dca\u0db3\u0dbb\u0dcf\u0dab\u0dd2\u0dba\u0dda \u0dc0\u0dca\u0dbd\u0dcf\u0db8\u0dd2\u0db4\u0dd4\u0dbb\u0dd4\u0dbf\u0dba\u0dcf \u0dbd\u0db1 \u0dba\u0dca. \u0d92. \u0da9\u0dd3. \u0dba\u0da2\u0dcf\u0dbb\u0dd3 \u0db1\u0dcf\u0db1\u0dcf\u0dba\u0dca\u0d9a\u0dcf\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0da5\u0dcf \u0daf\u0dd3\u0dba\u0db8\u0dca\u0dad \u0db3\u0dc3\u0dd4\u0dbd \u0dc0\u0dcf\u0dca\u0dc2\u0dd2 \u0dbc\u0db6\u0dcf \u0daf\u0dd3\u0dba\u0db8\u0dca \u0daf\u0dd3 \u0dbc\u0db6\u0dcf \u0daf\u0dd3 \u0d87\u0dad\u0dd2 \u0dc0\u0dcf\u0dca\u0dc2\u0dd2\u0dbd\u0dbc 75% \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0db4\u0dba\u0dda \u0dc0\u0dcf\u0dca\u0dc2\u0dd2 \u0dc0\u0dcf\u0dbd\u0daf\u0dba \u0dc0\u0dc1 \u0db8\u0da9 \u0d9c\u0dd0\u0dc3\u0dd3\u0dba\u0db8\u0dca \u0dba\u0dca\u0da1\u0dcf\u0db1\u0dcf\u0dba\u0dbd\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0dbc\u0daf \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbe \u0db6\u0dbd\u0da7 \u0dd2\u0dba\u0dbb\u0dca\u0dba\u0dca\u0db0\u0dbe \u0d9a\u0dbb\u0db1 \u0d85\u0dcf\u0dbb \u0d94\u0dc4\u0dd4\u0dba\u0dda \u0dc0\u0dcf\u0dca\u0dc2\u0dd2 \u0dd2\u0dba\u0dbf\u0dca\u0db4\u0dca\u200d\u0dbb\u0db7\u0dcf \u0d9a\u0dbb\u0db1 \u0db6\u0dbd\u0dda\u0dba. \u0db1\u0dd2\u0dbb\u0dd2\u0dda\u0dbf\u0dab 1). \u0db3\u0dc2\u0db8\u0dd4\u0dbd\u0dd0\u0dd2\u0dba \u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0dba \u0dc4\u0dbd\u0dca\u0dbc\u0dcf \u0dc3\u0dd2\u0daf\u0da7\u0dd2\u0dca\u0dad\u0dba\u0dca\u0dad \u0d87\u0dba\u0da7 \u0dbb\u0dd4\u0dd2\u0dba\u0dba\u0dbd\u0dca 1 000 000/- \u0d9a \u0dbd\u0dca\u0dad\u0daf\u0dd2\u0dba\u0dca \u0dbc\u0db6\u0dcf \u0daf\u0dd3\u0db8\u0da7\u0dba. 2). \u0d87\u0dba\u0dba\u0dda \u0dc0\u0dca\u0dbd\u0dcf\u0db8\u0dd2\u0db4\u0dd4\u0dbb\u0dd4\u0dbf\u0dba\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0daf\u0dca\u0dad \u0db3\u0dc2\u0db8\u0dd4\u0dbd\u0dd0\u0dd2\u0dba \u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0dba\u0da7 \u0dbc\u0db6\u0dcf \u0daf\u0dd3 \u0d87\u0dad\u0dd2 \u0dba\u0db3\u0ddc\u0dba\u0dbb\u0ddc\u0dca\u0dad\u0daf\u0dd4 \u0db3\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda \u0dc0\u0dcf\u0dca\u0dc2\u0dd2\u0d9a\u0dbb\u0dd4 \u0dbd\u0dbe\u0dba\u0dba\u0dca\u0dad \u0d85\u0dda\u0dc0\u0dca\u0dad \u0d9a\u0dbb \u0dad\u0dd2\u0dba\u0db6\u0dca. 3). \u0dc4\u0dc1\u0dcf \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0dba\u0d9a\u0ddc\u0dca\u0dad\u0dba\u0dca\u0db0\u0dc3\u0dd2\u0daf \u0d85\u0dd4 \u0dbd \u0db3\u0dc2\u0db8\u0dd4\u0dbd\u0dd0\u0dd2\u0dba \u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0dba \u0d9a\u0db8 \u0dd2\u0dba\u0dbd\u0dc0 \u0d87\u0dad\u0dd2 \u0d85\u0d82\u0d9a 10 \u0daf\u0dbb\u0db1 \u0dd2\u0db1\u0dd2\u0dba\u0dba \u0d85\u0dd4 \u0dbd \u0db7\u0dcf\u0dbb\u0daf\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba. 4). \u0dcf\u0dbd \u0daf \u0db3\u0dc2\u0db8\u0dd4 \u0dbd\u0dd0\u0dd2\u0dba \u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0daf\u0dca\u0dad \u0d9a\u0db8 \u0dd2\u0dba\u0dbd\u0dba\u0dc0\u0dda \u0dc3\u0dd2\u0daf\u0da7\u0dd2\u0db1 \u0dba\u0dca\u0dad\u0dbd\u0dcf\u0dc3\u0dd2\u0daf\u0d9a \u0daf\u0dbb\u0dd4\u0dbd\u0dca\u0dad\u0da7 \u0daf\u0dd4\u0db8\u0dca\u0dba\u0d9a\u0ddc\u0dbc \u0dbc\u0db6\u0dcf \u0daf\u0dd3 \u0dbd\u0dbb\u0daf\u0dca \u0d9a\u0dc2 \u0db6\u0dbd \u0daf \u0dd2\u0dba\u0dc5\u0dd2\u0dba\u0d9c\u0db1 \u0dad\u0dd2\u0dba\u0db6\u0dca. 5). \u0dcf\u0dbd\u0daf \u0d9a\u0db8 \u0d86\u0dba\u0dcf\u0db1\u0dba\u0dda \u0db3\u0dc2\u0db8\u0dd4 \u0dbd\u0dd0\u0dd2\u0dba \u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0dba \u0dba\u0dc0\u0dda\u0dbd\u0dba\u0dda \u0dba\u0dba\u0daf\u0dd3 \u0dc3\u0dd2\u0daf\u0da7\u0dd2\u0db1 \u0dc0\u0dd2\u0da7\u0daf\u0dd3 \u0dba\u0daf\u0dbd\u0dd0\u0dd2\u0dba \u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0dba \u0dc0\u0db2\u0dc1\u0dcf \u0db1\u0db8\u0dca \u0d9a\u0dbb \u0db1\u0da9\u0dd4 \u0db3\u0dbd\u0dbb\u0dcf \u0d87\u0dda\u0dba\u0dda \u0d9a\u0db8",
