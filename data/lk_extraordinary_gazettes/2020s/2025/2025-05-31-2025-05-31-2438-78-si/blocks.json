    "text": "\u0dad\ufffd\u0ddd\ufffd\u0dbb\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dc0 \u0d8b\u0dad\u0dd4\u0dbb 01 \u200d\u0d9a\u0db1\u0d9c\u0dbb\u0dcf\u0dba\u0db1\u0dca\u0d9a\u0dd4\u0dbd\u0db8\u0dca \u0d8b\u0dad\u0dd4\u0dbb - \u0d9a\u0db1\u0d9a\u0dbb\u0dcf\u0dc3\u0dcf \u0db4\u0dca\u200d\u0dbb\u0daf\u0dd3\u0db4\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0db8\u0db1\u0dca\u0db1\u0d9a\u0dd4\u0dbd\u0db8\u0dca 02 \u0d9a\u0db1\u0d9c\u0dbb\u0dcf\u0dba\u0db1\u0dca\u0d9a\u0dd4\u0dbd\u0db8\u0dca \u0daf\u0d9a\u0dd4\u0dab \u0d9a\u0dd4\u0dbd\u0dda\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0db1\u0dca \u0d85\u0db1\ufffd\u0ddd\ufffd\u0da2\u0db1\u0dca 03 \u0dc3\u0dd2\u0db1\u0dca\u0db1\u0d85\u0da9\u0db8\u0dca\u0db4\u0db1\u0dca - \u0db1\u0dba\u0dd2\u0db1\u0db8\u0da9\u0dd4 \u0dc0\u0dd2\u0db1\u0dcf\u0dba\u0d9c\u0db8\u0dd4\u0dbb\u0dca\u0dad\u0dca\u0dad\u0dd2 \u0dc3\u0d82\u0da2\u0dd4\u0daf\u0db1\u0dca 04 \u0d9a\u0dd4\u0dbd\u0dc0\u0dd2\u0dc3\u0dd4\u0da9\u0dca\u0da9\u0dcf\u0db1\u0dca - \u0db8\u0dcf\u0dbb\u0dcf\u0d89\u0dbd\u0dd4\u0db4\u0dca\u0db4\u0dd9\u0dba\u0dd2 \u0da5\u0dcf\u0db1\u0db8\u0dd4\u0dad\u0dca\u0dad\u0dd4 \u0d85\u0d9a\u0dd2\u0dbd\u0db1\u0dca 05 \u0db1\u0dd9\u0da9\u0dd4\u0db1\u0dca\u0d9a\u0dbb\u0dca\u0dab\u0dd2 \u0db4\ufffd\u0ddc\u0db1\u0dca\u200d\u0dca\u0db1\u0ddb\u0dba\u0dcf \u0dad\u0dda\u0dc0\u0dbb\u0dcf\u0dc3\u0dcf 06 \u0d94\u0dbd\u0dd4\u0db8\u0da9\u0dd4 - \u0db8\u0dcf\u0db8\u0da9\u0dd4 \u0dc3\u0dd9\u0dbd\u0dca\u0dc0\u0dbb\u0dcf\u0dc3\u0dcf \u0dc3\u0dd4\u0dc3\u0dd2\u0dbd\u0db1\u0dca 07 \u0db4\u0dd4\u0dbd\u0dd2\u0dba\u0db1\u0dca\u0d9a\u0dd4\u0dbd\u0db8\u0dca \u0d8b\u0dad\u0dd4\u0dbb \u0dc4\u0dcf \u0daf\u0d9a\u0dd4\u0dab \u0db0\u0dbb\u0dca\u0db8\u0dbd\u0dd2\u0d82\u0d9c\u0db8\u0dca \u0db0\u0db1\u0dd4\u0dc2\u0db1\u0dca 08 \u0db4\u0dbb\u0db1\u0dca\u0dad\u0db1\u0dca - \u0d85\u0db1\u0db1\u0dca\u0daf\u0dbb\u0dca \u0d9a\u0dc