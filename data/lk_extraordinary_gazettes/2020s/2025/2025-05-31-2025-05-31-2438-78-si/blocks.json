    "text": "\u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dc0 \u0daf\u0d9a\u0dd4\u0dab (\u0dc3\u0dd2\u0d82\u0dc4\u0dbd) \u0dc1\u0dcf\u0db1\u0dd2\u0d9a\u0dcf \u0d8b\u0daf\u0dba\u0d82\u0d9c\u0db1\u0dd2 \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0 (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2) \u0dc3\ufffd\u0dda\u0db1\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0d9c\u0dda \u0d85\u0db1\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf\u0dd2\u0d9a\u0dcf \u0dc3\ufffd\u0dda\u0db1\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0d86\u0dc3\u0dd2\u0dbb\u0dd2 \u0db1\u0dd4\u0dc0\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0daf\u0dbb\u0dca\u0dc1\u0db1 \u0dc3\ufffd\u0ddd\ufffd\u0db8\u0dbb\u0dad\u0dca\u0db1 \u0d9c\u0dd4\u0dab\u0dc3\ufffd\u0dda\u0d9c\u0dbb\u0d9c\u0dda \u0da2\u0dba\u0db1\u0dca\u0dad \u0d9c\u0dd4\u0dab\u0dc3\u0dd2\u0dbb\u0dd2 \u0dc0\u0dd3\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0d9c\u0dda \u0d85\u0da0\u0dd2\u0dbb \u0d9a\u0dd0\u0dbd\u0dd4\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a",
