    "text": "01. \u1f90\u0ba3\u0bcd\u1f8c 'A' \u2013 \u1f90\u0ba3\u0bcd\u1f8c 'A' \u2013 \u0b85\u0bae\u0bcd\u0baa\u0bb2\u0bae\u0bb2\u0b99\u0bcd\u0b95 \u0bae\u0bb2\u0baa\u0bb2\u0bbe\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4\u0b85\u0bae\u0bcd\u0baa\u0bb2\u0bae\u0bb2\u0b99\u0bcd\u0b95 \u0bae\u0bb2\u0baa\u0bb2\u0bbe\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 - - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0557 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0557 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd \u0b95\u0ba3\u0bcd\u1f8c\u0baa\u0bbf\u1f8a\u0b95\u0bcd\u0b95 \u1f99\u1f8a\u0baf\u0bbe\u0ba4 \u0b85\u0bae\u0bcd\u0baa\u0bb2\u0bae\u0bb2\u0b99\u0bcd\u0b95 \u0bae\u0bb2\u0baa\u0bb2\u0bbe\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0bb9\u0bbf\u0b95\u0bcd\u0b95\u1f8c\u0bb5 \u1fa2\u0baf\u0ba9\u0bc7\u0b95 \u0b85\u0b9c\u0ba8\u0bcd\u0ba4 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b85\u0bae\u0bcd\u0baa\u0bb2\u0bae\u0bb2\u0b99\u0bcd\u0b95 \u0bae\u0bb2\u0baa\u0bb2\u0bbe\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u1f90\u0ba3\u0bcd\u1f8c B \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0b9a\u0bc8\u0baa); \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0b9a\u0bc8\u0baa) \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd \u0b95\u0ba3\u0bcd\u1f8c\u0baa\u0bbf\u1f8a\u0b95\u0bcd\u0b95 \u1f99\u1f8a\u0baf\u0bbe\u0ba4 \u0b85\u0bae\u0bcd\u0baa\u0bb2\u0bae\u0bb2\u0b99\u0bcd\u0b95 \u0bae\u0bb2\u0baa\u0bb2\u0bbe\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd \u0b95\u0ba3\u0bcd\u1f8c\u0baa\u0bbf\u1f8a\u0b95\u0bcd\u0b95 \u1f99\u1f8a\u0baf\u0bbe\u0ba4 \u0b85\u0bae\u0bcd\u0baa\u0bb2\u0bae\u0bb2\u0b99\u0bcd\u0b95 \u0bae\u0bb2\u0baa\u0bb2\u0bbe\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0b9a\u0bc8\u0baa)",
