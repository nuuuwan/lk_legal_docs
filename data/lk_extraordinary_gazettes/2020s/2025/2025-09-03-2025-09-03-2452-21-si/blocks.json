    "text": "1988 \u0d85\u0d82\u0d82\u0d9a 64 \u0dc4\u0dcf\u0dcf 2011 \u0d85\u0d82\u0d82\u0d9a 49 \u0daf\u0dbb\u0db1 \u0db4\u0db1\u0dad\u0dca \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0dd2\u0dad 1981 \u0d85\u0d82\u0d82\u0d9a 57 \u0daf\u0dbb\u0db1 \u0dc0\u0dd9\u0dd9\u0dbb\u0dc5 \u0dc3\u0d82\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0dc3\u0dc4 \u0dc0\u0dd9\u0dd9\u0dbb\u0dc5 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0db4\u0db1\u0dad\u0dda\ufffd 16(1) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0dc0\u0dbd\u0da7 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0dcf\u0dcf\u0dbb, \u0d85\u0d82\u0d82\u0d9a 1087 \u0daf\u0dbb\u0db1 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba\u0dda\u024f \u0dc4\u0ddd\ufffd\u0ddd\u02ea\u0db8\u0dca \u0dbd\u0dd1\u0dd1\u0db1\u0dca\u0da9\u0dca \u0dc3\u0dca\u0dca\u0d9a\u0dba\u0dd2\u0dbd\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db8\u0dd3\u0d9c\u0db8\u0dd4\u0dc0, \u0db6\u0ddd\u02dc\u0ddd\u02ea\u0dbd\u0dc0\u0dbd\u0dcf\u0dcf\u0db1, \u0d85\u0d9c\u0dbb\u0daf\u0d9c\u0dd4\u0dbb\u0dd4 \u0db1\u0dd2\u0d9a\u0dbd\u0dc3\u0dca\u0dca \u0db8\u0dcf\u0dcf\u0d9a\u0dc3\u0dca\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0db8\u0dcf\u0dcf\u0dc0\u0dad, \u0d85\u0d82\u0d82\u0d9a 13 \u0daf\u0dbb\u0db1 \u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba\u0dda\u024f \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dba\u0ddd\u02e0\u0ddd\u02ea\u0da2\u0dd2\u0dad \u0d92\u0d9a\u0d9a 288\u0d9a\u0dd2\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dca \u0db8\u0dc4\u0dbd\u0dca \u0db1\u0dd2\u0dc0\u0dcf