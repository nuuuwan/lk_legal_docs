    "text": "\u0baa\u0bbe\u1f9f\u0b95\u0bcd \u0baa\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0bbe \u0bb7\u0bbe\u0ba4\u0bbf\u0baf\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bc6\u0ba4\u0b95\u0bcd\u0b95\u0bbf\u0ba8\u0bcd\u0ba4 \u0bb5\u0ba4\u0bcd\u0bc8\u0ba4; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u0bc6\u0bae\u0bbe\u0bb9\u0bae\u0b9f\u0bcd \u0baa\u0bbe\u1f9f\u0b95\u0bcd \u0baa\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bae\u0bbe \u0bb7\u0bbe\u0ba4\u0bbf\u0baf\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bc6\u0ba4\u0b95\u0bcd\u0b95\u0bbf\u0ba8\u0bcd\u0ba4 \u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc6\u0bae\u0bbe\u0bb9\u0bae\u0b9f\u0bcd \u0baa\u0bbe\u1f9f\u0b95\u0bcd \u0ba4\u0bbe\u0bbe\u0bbf\u0b95\u0bcd \u0bb9\u0bb2\u0bc0\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bc6\u0ba4\u0b95\u0bcd\u0b95\u0bbf\u0ba8\u0bcd\u0ba4 \u0bb5\u0ba4\u0bcd\u0bc8\u0ba4; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u0bc6\u0bae\u0bbe\u0bb9\u0bae\u0b9f\u0bcd \u0baa\u0bbe\u1f9f\u0b95\u0bcd \u0ba4\u0bbe\u0bbe\u0bbf\u0b95\u0bcd \u0bb9\u0bb2\u0bc0\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bc6\u0ba4\u0b95\u0bcd\u0b95\u0bbf\u0ba8\u0bcd\u0ba4 \u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bb9\u0bae\u0bc0\u0b9f\u0bcd \u0b85\u0baa\u0bcd\u1f90\u0bb2\u0bcd \u0bc6\u0bae\u0bbe\u0bb9\u0bae\u0b9f\u0bcd \u0bb9\u0bbe\u0bbe\u0bc0\u0b9a\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bc6\u0ba4\u0b95\u0bcd\u0b95\u0bbf\u0ba8\u0bcd\u0ba4 \u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0bb5\u0bcd \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 3; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 3 \u0bae\u0bb1\