    ],
    "text": "\u0bb2\u0bad\u0bb5\u0bc1 \u0bb5\u0b9a\u0baf\u0bb5\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f \u0b9a\u0bc1\u0bb0\u0bc1\u0b95\u0bcd\u0bc8 \u0bb2\u0b95\u0bad\u0bb5\u0bc1 \u2013 2025 1987 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 15 \u0b86\u0bae\u0bcd \u0b87\u0baf\u0b95\u0bcd\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0bc8\u0bbe\u0ba9 \u0baa\u0bbf\u0bad\u0b9a\u0ba4\u0b9a \u0b9a\u0b95\u0baa\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd \u0b9a\u0b9a\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1 \u0bb2\u0bbe\u0b9a\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f \u0b9a\u0bb2\u0ba3\u0bcd\u0b9f\u0bbf\u0bac \u0bb2\u0b9f\u0b9a\u0bab\u0bb2\u0bcd \u0bab\u0bbe\u0bc8\u0bbe\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b86\u0bb3\u0bc1\u0ba8\u0bb0\u0bcd \u0b85\u0bb2\u0bb0\u0bcd\u0bc8\u0bb0\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd 2020.10.29 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf\u0bac 2199/15 \u0b86\u0bae\u0bcd \u0b87\u0baf\u0b95\u0bcd\u0bc8 \u0b87\u0baf\u0b99\u0bcd\u0b95\u0bc8\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0bac\u0bc8 \u0b9a\u0b9a\u0bbe\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0bac\u0bad\u0b9a\u0bbf\u0ba9\u0bcd \u0b85\u0ba4\u0bbf\u0bb2\u0bbf\u0b9a\u0b9a\u0b9f \u0bb2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bab\u0bbe\u0ba9\u0bbf\u0bac\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bad\u0b9a\u0bc1\u0bbe\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bbf\u0bad\u0b9a\u0ba4\u0b9a \u0b9a\u0b95\u0baa \u0bb2\u0bad\u0bb5\u0bc1 \u0bb5\u0b9a\u0baf\u0bb5\u0bc1 \u0bb5\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bab\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0b9a\u0bac\u0bb2\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb2\u0ba4\u0bb1\u0bcd\u0bc8\u0bbe\u0ba9 \u0bb2\u0bbf\u0ba4\u0bbf \u0b87\u0baf\u0b95\u0bcd\u0bc8\u0bae\u0bcd 10(2)(\u0b86) \u0baa\u0b9f\u0bbf, \u0bc8\u0bbf\u0bbe\u0bbf\u0baa\u0bbe\u0bb2 \u0baa\u0bbf\u0bad\u0b9a\u0ba4\u0b9a \u0b9a\u0b95\u0baa\u0bac\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0bb1\u0bcd\u0bc8\u0bbe\u0bc8 \u0b92\u0bb3\u0bc3\u0b99\u0bcd\u0bc8\u0b95\u0bab\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb2\u0bad\u0bb5\u0bc1 \u0bb5\u0b9a\u0baf\u0bb5\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f \u0b9a\u0bc1\u0bb0\u0bc1\u0b95\u0bcd\u0bc8 \u0bb2\u0b95\u0bad\u0bb5\u0bc1 \u0b86\u0bb2\u0bc8\u0ba4\u0bcd\u0b95\u0ba4 2024.12.02 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf \u0bb5\u0ba4\u0bbe\u0b9f\u0b95\u0bcd\u0bc8\u0bae\u0bcd 2024.12.10 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf \u0bb2\u0b95\u0bad \u0b85\u0bad\u0b9a\u0bbe\u0b99\u0bcd\u0bc8 \u0b9a\u0bb2\u0b95\u0baf \u0ba8\u0bbe\u0b9f\u0bcd\u0bc8\u0bb0\u0bbf\u0bb2\u0bcd \u0b85\u0bb2\u0bc1\u0bb2\u0baf\u0bc8 \u0b9a\u0ba8\u0bad\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0bc8\u0bbf\u0bbe\u0bbf\u0baa\u0bbe\u0bb2 \u0baa\u0bbf\u0bad\u0b9a\u0ba4\u0b9a \u0b9a\u0b95\u0baa \u0baa\u0bbf\u0bad\u0ba4\u0bbe\u0ba9 \u0b85\u0bb2\u0bc1\u0bb2\u0baf\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bb5\u0baa\u0bbe\u0ba4\u0bc1 \u0bab\u0b95\u0bcd\u0bc8\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0bbe\u0bbf\u0b9a\u0bc0\u0bb2\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0bc8\u0bbe\u0bc8 \u0b9a\u0ba8\u0bcd\u0ba4\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bae\u0bcd \u0bb2\u0bb1\u0b99\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb0\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0b95\u0ba4 \u0b87\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd \u0bb5\u0ba4\u0bbe\u0bbf\u0bb2\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0bb5\u0bc8\u0bbe\u0bb3\u0bcd\u0bc8\u0bbf\u0ba9\u0bcd\u0b9a\u0bae\u0ba9\u0bcd.",
