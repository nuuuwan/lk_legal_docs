    "text": "\u0b87\u0baf\u0b99\u0bcd\u0b95\u0bc8\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0bac\u0bc8 \u0b9a\u0b9a\u0bbe\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0bac\u0bad\u0b9a\u0bbf\u0ba9\u0bcd \u0b85\u0bad\u0b9a\u0bbf\u0bac\u0baf\u0b95\u0bab\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bcd 44 \u0b86\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bad\u0bac\u0bbf\u0ba9\u0bcd (3) \u0b86\u0bae\u0bcd \u0baa\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bc1\u0b9f\u0ba9\u0bcd \u0b9a\u0b9a\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1 \u0bb2\u0bbe\u0b9a\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd 2024 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 33 \u0b86\u0bae\u0bcd \u0b87\u0baf\u0b95\u0bcd\u0bc8, \u0b9a\u0baa\u0bbe\u0ba4\u0bc1 \u0ba4\u0ba9\u0bbf\u0b9a\u0bc1 \u0bae\u0bc1\u0bc8\u0bbe\u0b95\u0bab\u0ba4\u0bcd\u0ba4\u0bc1\u0bb2\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 32 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb2\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbe\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0bb2\u0b99\u0bcd\u0bc8\u0bb0\u0bbf\u0ba9\u0bcd \u0baa\u0bac\u0b95\u0ba9\u0b95\u0bcd\u0b9a\u0bc8\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1, \u0b9a\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u0b85\u0ba8\u0bc1\u0bad \u0b95\u0bc1\u0bab\u0bbe\u0bad \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0bac\u0b95\u0bcd\u0bc8 \u0b86\u0bc8\u0bbf\u0bac \u0ba8\u0bbe\u0ba9\u0bcd, \u0b87\u0b95\u0bcd \u0bc8\u0b9f\u0bcd\u0b9f\u0b95\u0bb0 \u0bae\u0bc2\u0baf\u0bae\u0bcd, \u0b87\u0ba4\u0bb1\u0bcd\u0bc8\u0bbe\u0ba9 \u0b85\u0b9f\u0bcd\u0b9f\u0bb2\u0b95\u0bc8\u0bac\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bad\u0bb2\u0bcd I \u0b87\u0bb2\u0bcd \u0b95\u0bc1\u0bae\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bad\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0bb2\u0b99\u0bcd\u0bc8\u0b95\u0bb0, \u0b85\u0bb5\u0bcd \u0b85\u0b9f\u0bcd\u0b9f\u0bb2\u0b95\u0bc8\u0bac\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bad\u0bb2\u0bcd II \u0b87\u0bb2\u0bc1\u0bb3\u0bcd\u0bb0 \u0b9a\u0ba8\u0b9a\u0bad\u0bbe\u0ba4\u0bcd\u0ba4 \u0baa\u0ba4\u0bbf\u0bb5\u0bc1\u0bc8\u0bb0\u0bbf\u0bb2\u0bcd \u0ba8\u0bbf\u0bad\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc1\u0bc8\u0bb0\u0bbf\u0bb2\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u0b9f\u0bc1 \u0b9a\u0b9a\u0baf\u0bcd\u0bac\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb2\u0bbe\u0bb1\u0bc1 \u0ba4\u0bbf\u0b95\u0bae\u0b9a\u0bcd\u0b9a\u0b9a\u0bbe\u0bbf\u0b9a\u0bcd \u0b9a\u0b9a\u0bac\u0baf\u0bbe\u0bb0\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b95\u0bc8\u0bac\u0bb0\u0bbf\u0b95\u0bcd\u0bc8\u0bbf\u0ba9\u0bcd\u0b9a\u0bae\u0ba9\u0bcd.",
