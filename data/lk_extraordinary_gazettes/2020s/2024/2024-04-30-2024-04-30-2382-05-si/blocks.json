    "text": "\u0db6\u0dc0\u0dc4\u0db1\u0dc5\u0dc4\u0dd2\u0dbb \u0db4\u0dc2\u0dc5\u0dba\u0dda, \u0dba\u0d9a\u0ddc\u0dc2\u0db9 \u0daf\u0dd2\u0dc0\u0dc4\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dba\u0dda, \u0dba\u0d9a\u0ddc\u0dc2\u0db9 \u0db4\u0dca\u200d\u0dbb\u0dc5\u0dba\u0dca\u0db0\u0dba \u0dba \u0dba\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dc5\u0dc0\u0dba\u0dda \u0d85\u0d82\u0d9a 17 \u0d85\u0dad\u0dca\u0dda \u0db8\u0dc5\u0dbd\u0dcf (\u0dba\u0d9a\u0ddc\u0dc2\u0db9 \u0db8\u0dc1\u0db1\u0d9c\u0dbb \u0dc0\u0db7\u0dc5 \u0dc3\u0dd3\u0db8\u0dc5\u0dbd \u0dad\u0dd4\u0dbc) \u0d9c\u0dca\u200d\u0dbb\u0dc5\u0db8 \u0db1\u0dd2\u0dbc \u0dc5\u0d9a \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dc5\u0dc0\u0dba\u0da7 \u0d85\u0dba\u0dda \u0d85\u0dad\u0dca\u0dda \u0db8\u0dc5\u0dbd\u0dcf \u0d9c\u0dca\u200d\u0dbb\u0dc5\u0db8\u0dba\u0dba\u0dc4\u0dd2 \u0db4\u0dd2\u0dc4\u0dd2 \u0dc3 \u0dc0\u0db0\u0db1\u0dba\u0dbb\u0dba\u0db0\u0db1 \u0da2\u0dcf\u0db1\u0dbb\u0dc5\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0daf\u0dca\u0dad 2024.03.15 \u0daf\u0dd2\u0db1\u0dc6\u0dad\u0dd2\u0dbd \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0dba\u0dbc \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d9a\u0dc6\u0da9\u0dc6\u0dc0\u0dc4\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0db8\u0dca \u0d85\u0d82\u0d9a 520406, \u0d9a\u0dbc\u0dc5\u0db4 \u0d85\u0d82\u0d9a 04 \u0db4\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d9a 01\u0dc4\u0dd2 \u0d9a\u0dc6\u0db6\u0dd2 \u0d85\u0d82\u0d9a 1 \u0dc3\u0dd2\u0daf\u0da7 8 \u0dbd\u0dbe\u0dba\u0dba\u0dca\u0dad \u0daf\u0d9a\u0dca\u0d9a\u0dba\u0dbd\u0dc5 \u0d87\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc5\u0dba\u0dba\u0dba\u0dca\u0dad \u0dba\u0dc1\u0d9a\u0dca\u0d9a\u0dba\u0da7\u0dba\u0dc5\u0db0\u0db1 0.0149 \u0dbd\u0db1 \u0db4\u0dc1\u0dcf \u0dc0\u0dd2\u0dc0\u0dc4\u0dcf\u0dbb \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d89\u0da9\u0db8\u0dca \u0d9a\u0dc6\u0db6\u0dd2 . 1. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 01 \u0d89\u0da9\u0dba\u0db8\u0dca \u0db1\u0db8: \u0dbd\u0d9a \u0db4\u0db1\u