      418.43,
      549.82,
      470.9
    ],
    "text": "3. The Order made under Section 2 of the Special Commodity Levy Act, No. 48 of 2007 and published in the Extraodinary Gazette Notification No. 2321/76 of March 04, 2023 in respect of importation of Cowpeas (HS Code 0713.35.90) and Kuerakkan/Other - Millet (HS Codes, 1008.21.10, 1008.21.90, 1008.29.10, 1008.29.90) is hereby rescinded with effect from February 20, 2024.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
