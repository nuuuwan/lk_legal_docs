    "text": "\u0b87\u0bb2. 03 \u0b8f, \u0ba8\u0bbe\u0bb2\u0bcd\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u0b9a\u0bbe\u0bb0\u0bcd\u0baa\u0bbe\u0b95 \u0b95\u0bae\u0bcd\u0baa\u0bb9\u0bbe \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0ba8\u0bbe\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd 2017.10.25 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0ba4\u0baf\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0bc8\u0bb0\u0baa\u0b9f \u0b87\u0bb2. \u0b95.\u0bb5. 510289, \u0bc6\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf \u0b87\u0bb2. 16 \u0b87\u0bb2\u0bcd 07, \u0ba4\u0bbe\u0bb3\u0bcd \u0b87\u0bb2. 02 \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u1f90\u0bae\u0bbe\u0ba9 0.0105 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u1f99\u0bc8\u0b9f\u0baf 96 \u0bc6\u0ba4\u0bbe\u0b9f\u0b95\u0bcd\u0b95\u0bae\u0bcd 104 (\u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u1f90\u0ba3\u0bcd\u1f8c\u0b95\u0bb3\u0bcd 05) \u0bb5\u0bc8\u0bb0\u0baf\u0bbe\u0ba9 \u0bb5\u0bbf\u0baa\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u1f90\u0ba3\u0bcd\u1f8c\u0b95\u0bb3\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bbe\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0b8e\u1f8c\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u1f90. 01. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 96 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd : \u0bc6\u0b95\u0bbe\u0bb8\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd : \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd : \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd : \u0b95\u0ba3\u0bcd\u1f8c\u0baa\u0bbf\u1f8a\u0b95\u0bcd\u0b95 \u1f99\u1f8a\u0baf\u0bbe\u1f90 (\u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u1fa4\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b87\u1fa0\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9f \u0ba8\u0b9f\u0bb5\u1f8a\u0b95\u0bcd\u0bc8\u0b95); \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : 0.0001 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 02. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 98 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd : \u0bc6\u0b95\u0bbe\u0bb8\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd : \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd : \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd : \u0bc7\u0b95.\u0b8e\u0bae\u0bcd.\u0b8e\u0bae\u0bcd.\u0baa\u0bbf. \u0b95\u1f9e\u0ba3\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9, \u0ba4\u0bbf\u1fab\u0bb2\u0bcd\u0bc6\u0ba4\u0ba3\u0bbf\u0baf, \u0ba8\u0bbe\u0bb2\u0bcd\u0bb2, (\u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd \u0ba4\u1fa4\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b87\u1fa0\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9f \u0ba8\u0b9f\u0bb5\u1f8a\u0b95\u0bcd\u0bc8\u0b95); \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : 0.0026 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 03. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 100 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd : \u0bc6\u0b95\u0bbe\u0bb8\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd : \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd : \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd : \u0b9f\u0baa\u0bbf\u0bb3\u0bcd\u1f9d.\u0b8e\u0bae\u0bcd. \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0b9c\u0bbf\u0ba4\u0bcd \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0, \u0b87\u0bb2. 10/1, \u0ba4\u0bbf\u1fab\u0bb2\u0bcd\u0bc6\u0ba4\u0ba3\u0bbf\u0baf, \u0ba8\u0bbe\u0bb2\u0bcd\u0bb2, (\u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u1fa4\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b87\u1fa0\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9f \u0ba8\u0b9f\u0bb5\u1f8a\u0b95\u0bcd\u0bc8\u0b95); \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : 0.0052 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 04. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 102 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd : \u0bc6\u0b95\u0bbe\u0bb8\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd : \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd : \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd : \u0bc7\u0b9c.\u0b8f. \u0ba4\u0bbf\u0bb8\u0bcd\u0ba9\u0bbe \u0bc7\u0bb0\u0bbe\u0bb7\u0ba9\u0bbf \u0b9c\u0baf\u0b9a\u0bbf\u0b99\u0bcd\u0bb9, \u0b87\u0bb2. 4/10, \u0ba4\u0bbf\u1fab\u0bb2\u0bcd\u0bc6\u0ba4\u0ba3\u0bbf\u0baf, \u0ba8\u0bbe\u0bb2\u0bcd\u0bb2, (\u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u1fa4\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b87\u1fa0\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9f \u0ba8\u0b9f\u0bb5\u1f8a\u0b95\u0bcd\u0bc8\u0b95); \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : 0.0020 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 05. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 104 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd : \u0bc6\u0b95\u0bbe\u0bb8\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd : \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd : \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd : \u0bc7\u0b9c.\u0b8f. \u0baa\u0bbf\u0bc7\u0bb0\u0bae\u0b9a\u0bbf\u0bb1\u0bbf \u0b9c\u0baf\u0bc6\u0b95\u0bbe\u1f8a, \u0b87\u0bb2. 2/\u0baa\u0bc0/43, \u0bae\u0bbe\u0b92\u0baf\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0ba8\u0bbe\u0bb2\u0bcd\u0bb2, \u0ba4\u0bbf\u1fab\u0bb2\u0bcd\u0bc6\u0ba4\u0ba3\u0bbf\u0baf, (\u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u1fa4\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b87\u1fa0\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9f \u0ba8\u0b9f\u0bb5\u1f8a\u0b95\u0bcd\u0bc8\u0b95); \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : 0.0006 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd.",
