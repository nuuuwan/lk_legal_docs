dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 4:120 0.3046 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db6/\u0db4\u0dcf/250/4594 \u0daf\u0dbb\u0dab \u0db6\u0dbd\u0db4\u0dad\u0dba \u0db8\u0dad \u0db8\u0dcf\u0dd9\u0dad\u0ddc\u0da7 \u0d9c\u0db8\u0dbb\u0dcf\u0dbd\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dd9\u0db4\u0dda\u0db8\u0dbb\u0dad\u0dca\u0db1 \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. 4:123 0.0951 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db6/\u0db4\u0dcf/253/4597 \u0daf\u0dbb\u0dab \u0db6\u0dbd\u0db4\u0dad\u0dba \u0db8\u0dad \u0d9a\u0db4\u0dd4\u0dbb\u0dd4\u0d9c\u0dbd \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0db1\u0dd2\u0dc4\u0dcf\u0dbd\u0dca \u0dd9\u0dc3\u0ddd\u0db8\u0dad\u0dd2\u0dbd\u0d9a \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. 4:124 0.1012 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db6/\u0db4\u0dcf/256/4600 \u0daf\u0dbb\u0dab \u0db6\u0dbd\u0db4\u0dad\u0dba \u0db8\u0dad \u0dc0\u0dd3\u0dbb\u0dd9\u0dc3\u0dda\u0d9a\u0dbb \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc0\u0dd2\u0dd9\u0da2\u0dca\u0dad\u0dd2\u0dbd\u0d9a \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. 4:128 0.1518 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db6/\u0db4\u0dcf/423/4767 \u0daf\u0dbb\u0dab \u0db6\u0dbd\u0db4\u0dad\u0dba \u0db8\u0dad \u0d9a\u0db4\u0dd4\u0dbb\u0dd4\u0d9c\u0dbd \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d9c\u0dd2\u0db8\u0dca\u0dc4\u0dcf\u0db1\u0dca \u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. 4:129 0.1291 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db6/\u0db4\u0dcf/424/4768 \u0daf\u0dbb\u0dab \u0db6\u0dbd\u0db4\u0dad\u0dba \u0db8\u0dad \u0d85\u0dbd\u0dca\u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dd9\u0dad\u0dca \u0dba\u0db8\u0dd4\u0db1\u0dcf \u0da0\u0db1\u0dca\u0daf\u0dcf\u0db1\u0dd2 \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. 4:132 0.1728 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db6/\u0db4\u0dcf/249/4593 \u0daf\u0dbb\u0dab \u0db6\u0dbd\u0db4\u0dad\u0dba \u0db8\u0dad \u0db8\u0dcf\u0dd9\u0dc0\u0dbd \u0db8\u0db1\u0db1\u0dca\u0db1\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc3\u0dd2\u0dbb\u0dd2\u0dba\u0dbd\u0dad\u0dcf \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. 4:133 0.1967 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db6/\u0db4\u0dcf/248/4592 \u0daf\u0dbb\u0dab \u0db6\u0dbd\u0db4\u0dad\u0dba \u0db8\u0dad \u0d9a\u0dd0\u0d9a\u0dd4\u0dd9\u0dbd\u0dca \u0dc0\u0dd2\u0dba\u0db1\u0dbd\u0dcf\u0dba \u0dd9\u0db6\u0dca\u0db6\u0dd2\u0dd9\u0db1\u0ddd\u0db1\u0dcf \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. 4:134 0.1824 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db6/\u0db4\u0dcf/241/4585 \u0daf\u0dbb\u0dab \u0db6\u0dbd\u0db4\u0dad\u0dba \u0db8\u0dad \u0dc0\u0dd0\u0dbd\u0dd2\u0dd9\u0d9c\u0dca \u0dc0\u0dd2\u0d9a\u0db8\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc0\u0dd2\u0d9a\u0db8\u0dc3\u0dd2\u0d82\u0dc4 \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. 4:135 0.1935 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db6/\u0db4\u0dcf/242/4586 \u0daf\u0dbb\u0dab \u0db6\u0dbd\u0db4\u0dad\u0dba \u0db8\u0dad \u0dc3\u0db1\u0dca\u0daf\u0dbb \u0daf\u0dd4\u0dbb\u0dd9\u0d9c\u0dca \u0db8\u0dc4\u0dd2\u0db1\u0dca\u0daf \u0dd9\u0db4\u0dca\u0db8\u0dc3\u0dd2\u0dbb\u0dd2 \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. 4:137 0.2178 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db6/\u0db4\u0dcf/244/4588 \u0daf\u0dbb\u0dab \u0db6\u0dbd\u0db4\u0dad\u0dba \u0db8\u0dad \u0dd9\u0db4\u0ddc\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad\u0dd9\u0d9c\u0dca \u0d9c\u0dd4\u0dab\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. EOG 10 - 0129/1",
