    "text": "\u201c\u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u02a2 \u0d85\u0d82\u0d9a\u0dba \u026a\u0dc1\u0dcf\u0dbd\u01ae\u0dc0\u0dba (\u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259)\u201d \u0dba\u0db1 \u01b0\u025e\u0dd9\u0dc0\u028f \u0dc3\u0db3\u0dc4\u01e6 \u201c11 \u0dc3\u0dc4 0.0723\u201d\u0dba\u01e6\u0db1 \u0d89\u0dc0\u01ae \u0d9a\u0dbb \u201c12 \u0dc3\u0dc4 0.1184\u201d \u0dba\u01e6\u0db1 \u0dc3\u0dc4 \u201c\u0d85\u0250\u01af\u0d9a\u025e\u0dd9\u0118/\u0d85\u0250\u01af\u0d9a\u025e\u0dc0\u01e6\u0dd9\u0118 \u0dc3\u023c\u021b\u0259\u0dab \u0db1\u0db8/\u0db1\u023c \u0dc3\u0dc4 \u0263\u0218\u0db1\u0dba\u201d, \u0da2\u0dcf\u01af\u0d9a \u0dc4\u0dd0\u01ff\u01e9\u023c\u0db4\u01ae \u0d85\u0d82\u0d9a\u0dba \u01b0\u025e\u0dd9\u0269 \u0db1\u0dcf\u026c\u0262\u0dbd\u0dd9\u0118 \u0286\u025c\u0dba\u0dcf\u01e7 \u0dd9\u0dc4\u0dc0\u01ae \u0db1\u0dcf\u026c\u0262\u0dbd\u0dd9\u0118 \u027b\u0dba\u0dcf\u01e7, \u0d85\u0d82\u0d9a 29/2, \u0218\u0179\u0db4\u0db1 \u0daf\u00fd\u0dab, \u021d\u0dc3\u01e6\u0db1\u021a\u0dbb, \u0da2\u0dcf.\u0dc4\u0dd0. 67643980V \u0dba\u01e6\u0db1 \u0d89\u0dc0\u01ae \u0d9a\u0dbb \u0db1\u0dcf\u026c\u0262\u0dbd\u0dd9\u0118 \u021d\u0dc3\u01e6\u0db1 \u0288\u0db8\u0db1\u0286\u025c, \u0d85\u0d82\u0d9a 387, \u0218\u0179\u0db4\u0db1 \u0daf\u00fd\u0dab, \u0dd9\u0dc4\u02a4\u0db8\u0dcf\u0d9c\u0db8, \u0da2\u0dcf.\u0dc4\u0dd0. 713532118V \u0d87\u01b1\u0dbd\u01ae \u0d9a\u0dbb \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229. \u0219. \u0287. \u018c. \u0286\u0dd9\u0118\u0dbb\u0dcf, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0262. 2024 \u0dc3\u0dd0\u0217\u0dad\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 11 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd \u0dbb\u0da2\u0db8\u0262\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbb, \u201c\u023d\u028f\u0d9a\u0dad \u0db8\u0dd0\u01d0\u0dbb\u201d,