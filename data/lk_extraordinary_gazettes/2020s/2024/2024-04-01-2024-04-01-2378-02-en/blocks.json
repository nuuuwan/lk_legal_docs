    "page_number": 0,
    "bbox": [
      55.25,
      507.62,
      297.8,
      566.69
    ],
    "text": "I, Nalaka Jude Harin Fernando, Minister of Tourism & Lands hereby declare, under Sub-section (1) of Section 5 of the Land Acquisition Act, that the lands described below are needed for a public purpose and will be acquired under the provisions of that Act.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.25,
      579.62,
      297.77,
      662.69
    ],
    "text": "The allotments of land described in below names and de-picted in the Surveyor General\u2019s Advance Tracing No. KU/PLG/2019/222 dated 06.12.2019 situated at Polwaththege-dara Village in No. 891 Medakalugamuwa Grama Niladhari Division, of Minor Division Udapola Medalassa Korale in Polgahawela Divisional Secretary\u2019s Division of Kurunagala District, North West Province and bounded as follows:",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
