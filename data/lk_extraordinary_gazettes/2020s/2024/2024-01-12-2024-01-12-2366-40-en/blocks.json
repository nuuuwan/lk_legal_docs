  },
  {
    "page_number": 1,
    "bbox": [
      57.6,
      259.04,
      291.47,
      321.92
    ],
    "text": "The land in the extent of 0.0945 ha (37.4 perches) cited in the original plan No. C. M. 511614 Division 03 Sheet No. 01 dated 30.10.2023 of the Senior Superintendent of Surveys, Gampaha located in Iriyawetiya Village of Kelaniya Divisional Secretary\u2019s Division in Gampaha District of Western Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      57.6,
      322.4,
      291.44,
      374.96
    ],
    "text": "1. Lot No. 01 Name of the land: Wewahena; Present land utilization: Home Garden, Five permanent buildings are available; Owner: Chief Incumbent, Vidyalankara",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
