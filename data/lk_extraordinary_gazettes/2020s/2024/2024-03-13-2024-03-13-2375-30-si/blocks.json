    "text": "\u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013--\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 \u026a\u01e7\u0dc1\u0dca\u0da0\u0dba\u01e6 \u0dc3\u0dc4 \u0dba\u023c \u026a\u0dd9\u0dc1\u02a2\u0dc2 \u0dd9\u0dc4\u02a4 \u0db4\u01b4 \u0d85\u0d82\u0d9a\u0dba \u0d89\u01e6\u0dd9\u0da2\u01e6\u0dc2\u01e6 \u0dad\u0dc4\u0db1\u023c \u0dd9\u0db4\u02a5\u01ca\u0d9c\u0263\u0d9a \u0dc3\u0dc4 \u0d89\u0da9\u023c \u026a\u0dc1\u0dcf\u0dbd\u01ae\u0dc0\u0dba \u0d85\u0250\u01af\u0d9a\u025e\u0dd9\u0118/\u0d85\u0250\u01af\u0d9a\u025e\u0dc0\u01e6\u0dd9\u0118 \u0da2\u0dcf\u01af\u0d9a \u0d85\u0250\u01af \u0d85\u0250\u01af\u0dd9\u024f \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf\u0dd9\u0dc0\u01e6 \u0d87\u01af \u01e8\u01af\u0dba\u0d9a\u0da7 \u0dba\u0da7\u01ae \u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u02a2 \u0dc3\u023c\u021b\u0259\u0dab \u0db1\u0db8/\u0db1\u023c \u0dc3\u0dc4 \u0263\u0218\u0db1\u0dba \u0dc4\u0dd0\u01ff\u01e9\u023c\u0db4\u01ae \u0d89\u0da9\u0dd9\u023c \u0db4\u01e6\u01af\u0dba \u0dc3\u0dc4 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u01fe\u023c \u0db1\u023c \u0d92 \u0218\u0298\u0db6\u0db3 \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u021d\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0218\u0298\u0db6\u0db3 \u026a\u0dc3\u0dca\u0dad\u0dbb \u026a\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014- (\u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259) 1:13 1.5224 \u0db8\u0dd0\u00fa\u0dbd\u0dd0\u0dbb\u01e6\u0dc3\u0dca \u018b\u0dc0\u0dd9\u0dbd\u02a3\u0db4\u0259\u0dc3\u0dca \u021a\u01ca\u0d9c\u0263\u0d9a _ \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0dd9\u0d9a\u02a3\u0db8\u0259\u0dc2\u0262 \u0db6\u0dd0\u0d82\u00fd\u0dc0\u0da7 _ \u0dc3\u0db8\u0dcf\u0d9c\u0db8, \u0d85\u0d82\u0d9a 284, \u0dd9\u0dc0\u02a3\u00fa\u0dd9\u0dc2\u02a4\u0262 \u026a\u01cf\u0dba, \u0dad\u0db6\u0dcf \u0d87\u01af \u0dd9\u0d9a\u02a3\u0dc5\u0db9 02. \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u01ae\u0dc0 (\u0d85\u0d82\u0d9a 2449 \u0dc4\u0dcf 2022/09/20 \u01ce\u0db1) \u0dc3\u0dc4 \u0d94\u0217\u021a \u0d85\u0d82\u0d9a 68 \u0dc4\u0dcf 2023/3/29 \u01ce\u0db1\u0dd0\u01af \u0db6\u01d0 \u0d94\u0217\u021a\u0dd9\u0269 \u0dd9\u0d9a\u02a3\u01e6\u0dd9\u01ca\u0286\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae\u0dc0 6:139 0.0408 \u00fa\u0dc2\u019d\u00fa \u0db8\u0290\u0dbd \u0da2\u0dba\u0dc0\u0259\u0db0\u0db1 643162075V \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a _ \u0d85\u0d82\u0d9a 511/2, \u023e\u0d9c\u023f \u0db4\u0dcf\u0dbb, \u0dc0\u01ae\u0dad\u0dbd. 142 \u0dc3\u0dc4 141 \u028f \u0db8\u0dcf\u0259\u0d9c \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 141 \u0dd9\u0db4\u02a3\u01d0 \u023d\u01d0\u0dd9\u0262 \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, \u0dd9\u0daf\u02a4\u0db1 \u0286\u0286\u0263 \u0d87\u0118\u0db1\u0dc3\u0dca \u0da2\u0dba\u0dc0\u0259\u0db0\u0db1 \u0dba\u0db1 \u0d85\u0dba\u0dd9\u0118 \u0150\u026a\u0dad \u0236\u00fa\u01af\u0dba\u0da7 \u0dba\u0da7\u01ae\u0dc0 6:140 0.0368 \u00fa\u0dc2\u019d\u00fa \u0db8\u0290\u0dbd \u0da2\u0dba\u0dc0\u0259\u0db0\u0db1 643162075V \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 142 \u028f _ \u0d85\u0d82\u0d9a 511/1, \u023e\u0d9c\u023f \u0db4\u0dcf\u0dbb, \u0dc0\u01ae\u0dad\u0dbd. \u0db8\u0dcf\u0259\u0d9c \u0d85\u0250\u01af\u0dba \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 141 \u028f \u0dd9\u0db4\u02a3\u01d0 \u023d\u01d0\u0dd9\u0262 \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, \u0dd9\u0daf\u02a4\u0db1 \u0286\u0286\u0263 \u0d87\u0118\u0db1\u0dc3\u0dca \u0da2\u0dba\u0dc0\u0259\u0db0\u0db1 \u0dba\u0db1 \u0d85\u0dba\u0dd9\u0118 \u0150\u026a\u0dad \u0236\u00fa\u01af\u0dba\u0da7 \u0dba\u0da7\u01ae\u0dc0 6:141 0.0072 1. \u00fa\u0dc2\u019d\u00fa \u0db8\u0290\u0dbd \u0da2\u0dba\u0dc0\u0259\u0db0\u0db1 643162075V \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba _ _ 2. \u0d9a\u0dd0\u0dbb\u0269\u0dd9\u0d9c\u02a3\u0da9\u0dd9\u0118 \u0dbb\u014f\u01e6\u018a \u0dc3\u0dcf\u0d9c\u025c\u00fa 692944216V \u0dc3\u0db8 \u0d85\u0250\u01af\u0dba \u0da2\u0dba\u0dc0\u0259\u0db0\u0db1 \u0d85\u0d82\u0d9a 511, \u023d\u0d9c\u023f \u0db4\u0dcf\u0dbb, \u0dc0\u01ae\u0dad\u0dbd. 6:142 0.0156 1. \u0d9a\u0dd0\u0dbb\u0269\u0dd9\u0d9c\u02a3\u0da9\u0dd9\u0118 \u0dbb\u014f\u01e6\u018a \u0dc3\u0dcf\u0d9c\u025c\u00fa 692944216V \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 141, _ \u0da2\u0dba\u0dc0\u0259\u0db0\u0db1 \u0dc3\u0db8 \u0d85\u0250\u01af\u0dba 143 \u0dc3\u0dc4 139 \u028f 2. \u00fa\u0dc2\u019d\u00fa \u0db8\u0290\u0dbd \u0da2\u0dba\u0dc0\u0259\u0db0\u0db1 643162075V \u0db8\u0dcf\u0259\u0d9c \u0d85\u0250\u01af\u0dba \u0da2\u0dba\u0dc0\u0259\u0db0\u0db1 \u0dc3\u0db8\u0d9f \u0d85\u0d82\u0d9a 511, \u023d\u0d9c\u023f \u0db4\u0dcf\u0dbb, \u0dc0\u01ae\u0dad\u0dbd. 6:143 0.0885 \u0d9a\u0dd0\u025a\u0269\u0dd9\u0d9c\u02a3\u0da9\u0dd9\u0118 \u0dbb\u014f\u01e6\u018a \u0dc3\u0dcf\u0d9c\u025c\u00fa 692944216V \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 142 \u028f _ \u0da2\u0dba\u0dc0\u0259\u0db0\u0db1 \u0db8\u0dcf\u0259\u0d9c \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, \u0d85\u0d82\u0d9a 511, \u023e\u0d9c\u023f \u0db4\u0dcf\u0dbb, \u0dc0\u01ae\u0dad\u0dbd. \u0288\u01e7\u0dad \u0dd9\u0db8\u0dbd\u0dcf\u01e7 \u0da2\u0dba\u0dd9\u0d9a\u02a3\u018b \u0dc3\u0dc4 \u0dd9\u0daf\u02a4\u0db1 \u0286\u0286\u0263 \u0d87\u0118\u0db1\u0dc3\u0dca \u0da2\u0dba\u0dc0\u0259\u0db0\u0db1 \u0dba\u0db1 \u0d85\u0dba\u0dd9\u0118 \u0150\u026a\u0dad \u0236\u00fa\u01af\u0dba\u0da7 \u0dba\u0da7\u01ae\u0dc0 EOG 03-0119",
