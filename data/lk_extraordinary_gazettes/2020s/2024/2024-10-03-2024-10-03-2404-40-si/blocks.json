dd4\u0dc0\u0dbb \u0dd9\u0d9c\u0daf\u0dbb \u0da0\u0db1\u0dca\u0daf\u0dcf\u0dc0\u0dad\u0dd3 587582481V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 35 \u2013 \u0d85\u0d82\u0d9a 06,\u0d9c\u0db8\u0dca\u0dd9\u0db4\u0ddc\u0dbd\u0dd9\u0dc0\u0dbd,\u0d9c\u0db8\u0dca\u0dd9\u0db4\u0ddc\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c 1 : 29 0.0384 \u0da2\u0dd4\u0db1\u0dba\u0dd2\u0daf\u0dd2\u0db1\u0dca \u0dd9\u0db8\u0ddc\u0dd9\u0dc4\u0ddc\u0db8\u0da9\u0dca \u0dad\u0dcf\u0dbb\u0dd2\u0d9a\u0dca 592762021V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 35 \u2013 \u0d85\u0d82\u0d9a 7/1,\u0d9c\u0db8\u0dca\u0dd9\u0db4\u0ddc\u0dbd\u0dd9\u0dc0\u0dbd,\u0d9c\u0db8\u0dca\u0dd9\u0db4\u0ddc\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c 1 : 90 0.0249 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 91, 92,93,94,95,96, 97,98,99 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0dc0\u0dbd\u0da7 \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 1 : 92 0.0040 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0dd9\u0db4\u0ddc\u0daf\u0dd4 \u0db4\u0dbb\u0dc4\u0dbb\u0dab\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca \u0dd9\u0d9a\u0ddc\u0da7 \u0d87\u0dad. (\u0dc0\u0dad\u0dca\u0dad \u0dc4\u0dcf \u0dc5\u0dd2\u0daf\u0d9a\u0dca) 1 : 94 0.0170 \u0d85\u0da2\u0dd2\u0da9\u0dd3\u0db1\u0dca \u0dad\u0dd4\u0dc0\u0dcf\u0db1\u0dca \u0dc4\u0dbb\u0dd6\u0db1\u0dca 463010072V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 90 \u2013 \u0d85\u0d82\u0d9a 3/4,\u0d9c\u0db8\u0dca\u0dd9\u0db4\u0ddc\u0dbd\u0dd9\u0dc0\u0dbd \u0d89\u0dc4\u0dbd, \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0db8\u0dca\u0dd9\u0db4\u0ddc\u0dbd \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0dc3\u0db8\u0d9c \u0dc4\u0dcf \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 92 \u0dc5\u0dd2\u0dd9\u0daf\u0db1\u0dca \u0dc0\u0dad\u0dd4\u0dbb \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca, \u0dc5\u0dd2\u0daf\u0da7 \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0dd9\u0db8\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c 1 : 148 0.0016 \u0dbb\u0da2\u0dba \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad \u0dc4\u0dcf \u0db6\u0dd4\u0daf\u0dd4\u0db8\u0dd0\u0daf\u0dd4\u0dbb 1 : 149 0.0159 \u0dbb\u0da2\u0dba \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0dbb\u0da2 \u0d87\u0dc5 1 : 152 0.0134 \u0dd9\u0db8\u0ddc\u0dd9\u0dc4\u0ddc\u0db8\u0da9\u0dca \u0d89\u0dc3\u0dca\u0db8\u0dba\u0dd2\u0dbd\u0dca \u0dd9\u0db8\u0ddc\u0dd9\u0dc4\u0ddc\u0db8\u0da9\u0dca 941550290V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d85\u0db6\u0dca\u0daf\u0dd4\u0dbd\u0dca \u0dc3\u0dbd\u0dcf\u0db8\u0dca \u2013 \u0d89\u0dbb\u0dca\u0dc6\u0dcf\u0db1\u0dca \u0dd9\u0db8\u0ddc\u0dd9\u0dc4\u0ddc\u0db8\u0da9\u0dca \u0d89\u0dc3\u0dca\u0db8\u0dba\u0dd2\u0dbd\u0dca \u0d85\u0d82\u0d9a2/2,\u0d9c\u0db8\u0dca\u0dd9\u0db4\u0ddc\u0dbd\u0dd9\u0dc0\u0dbd,\u0d9c\u0db8\u0dca\u0dd9\u0db4\u0ddc\u0dbd \u0dc3\u0