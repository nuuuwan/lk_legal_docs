      581.1,
      542.48,
      606.4
    ],
    "text": "The Crown Lands Regulations, 1948 published in the Gazette Extraordinary No. 9912 of October 15, 1948 are hereby amended as follows:-",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
