    ],
    "text": "203 \u0b86\u0bb2\u0ba4\u0bc1 \u0bb2\u0bb0\u0bc1\u0b9f\u0bb6\u0ba8\u0bcd\u0ba4 \u0bbb\u0bc8\u0bb6\u0b9f\u0bbf\u0bbc\u0bac\u0bb1\u0bcd\u0bae \u0bb2\u0bb7\u0bb1\u0bb6 \u2013 2024 \u0bbc\u0bab\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bb7\u0baa\u0bcd\u0baa\u0bb7\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb0 \u0bc8\u0bb2\u0bcd\u0bae\u0bc1\u0bbd\u0ba9 \u0bc8\u0b9f\u0bb1\u0bcd\u0bc8\u0bbd\u0bad\u0baa\u0bcd \u0baa\u0bb3\u0bcd\u0bb0\u0bb7\u0bb2\u0bb6\u0b9a\u0bb2\u0bcd \u0ba8\u0bb6\u0bb5\u0bba\u0bb0\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbd\u0bc8 \u0ba4\u0bb0\u0bcd\u0bb5\u0bb6 \u0bb3\u0bb6\u0bb8\u0b83\u0baa\u0bb7\u0bb2\u0bcd \u0b85\u0bb8\u0bcd \u0bbb\u0bb4\u0baf\u0bcd\u0bac\u0bb7\u0ba4\u0bcd \u0b85\u0baa\u0bcd\u0ba4\u0bc1\u0bb2\u0bcd \u0bc8\u0bb6\u0ba4\u0bb7\u0bb0\u0bcd \u0bb3\u0bb6\u0bb5\u0bb9\u0bb2\u0bcd \u0bb5\u0bab\u0bb8\u0ba4\u0bc1 \u0bb2\u0bb2\u0bbf\u0baf\u0bcd\u0baf\u0bc1\u0bb2\u0bcd\u0baf\u0bb6\u0bb9\u0bcd \u0b85\u0bb2\u0bb0\u0bcd\u0bc8\u0bb0\u0bb7\u0ba9\u0bcd \u0ba8\u0bb7\u0bbd\u0ba9\u0bb2\u0bb6\u0bc8 203 \u0b86\u0bb2\u0ba4\u0bc1 \u0bb2\u0bb0\u0bc1\u0b9f\u0bb6\u0ba8\u0bcd\u0ba4 \u0bbb\u0bc8\u0bb6\u0b9f\u0bbf\u0bbc\u0bac\u0bb1\u0bcd\u0bae \u0bb2\u0bb7\u0bb1\u0bb6\u0bb2\u0bb6\u0ba9\u0ba4\u0bc1 2024, \u0ba4\u0bb7\u0bbb\u0b9a\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bab\u0bb6\u0ba4\u0bae\u0bcd 02 \u0b86\u0ba8\u0bcd \u0ba4\u0bb7\u0bc8\u0ba4\u0bb7 \u0bae\u0bc1\u0ba4\u0bb2\u0bcd 2024, \u0ba4\u0bb7\u0bbb\u0b9a\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bab\u0bb6\u0ba4\u0bae\u0bcd 14 \u0b86\u0ba8\u0bcd \u0ba4\u0bb7\u0bc8\u0ba4\u0bb7 \u0bb2\u0bbd\u0bad \u0ba8\u0bbd\u0b9f\u0bbb\u0baa\u0bb1\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0bbd\u0ba4 \u0bbb\u0baa\u0bb6\u0ba4\u0bc1 \u0bab\u0b95\u0bcd\u0bc8\u0bb3\u0bcd \u0b85\u0bae\u0bb7\u0ba8\u0bcd\u0ba4\u0bc1 \u0bbb\u0bc8\u0bb6\u0bb3\u0bcd\u0bb3\u0bc1\u0bae\u0bcd \u0bbb\u0baa\u0bb6\u0bb0\u0bc1\u0b9f\u0bcd\u0b9f\u0bc1 \u0b87\u0ba4\u0bcd\u0ba4\u0bb6\u0bb2\u0bcd \u0b85\u0bae\u0bb7\u0bb2\u0bb7\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bc8\u0bb7\u0ba9\u0bcd\u0bae\u0ba4\u0bc1. \u0bac\u0bb6\u0ba4\u0bcd\u0ba4\u0bb7\u0bbd\u0bad\u0bc8\u0bb3\u0bcd \u0bc8\u0b9f\u0bcd\u0b9f\u0bbd\u0bb0\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bb7\u0ba9\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0bb6\u0b9f\u0bc1\u0bc8\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0bc8\u0b99\u0bcd\u0bc8 1963 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0bbb\u0baa\u0baa\u0bcd\u0baa\u0bc1\u0bb0\u0bc1\u0bb2\u0bb6\u0bb7 \u0bab\u0bb6\u0ba4\u0bae\u0bcd 22 \u0b86\u0ba8\u0bcd \u0ba4\u0bb7\u0bc8\u0ba4\u0bb7\u0bac 13529 \u0b86\u0bae\u0bcd \u0b87\u0baf\u0b95\u0bcd\u0bc8 \u0b87\u0baf\u0b99\u0bcd\u0bbd\u0bc8 \u0b85\u0bad\u0b9a\u0bb6\u0b99\u0bcd\u0bc8 \u0bb2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bab\u0bb6\u0ba9\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0bb7\u0bb6\u0bb7\u0bbd\u0bc8\u0bac\u0bb7\u0bb2\u0bcd \u0baa\u0bb7\u0bad\u0b9a\u0bc1\u0bb6\u0bb7\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb0 \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1 \u0bb2\u0bb7\u0ba4\u0bb7\u0bc8\u0bb3\u0bcd \u0bac\u0bb6\u0ba4\u0bcd\u0ba4\u0bb7\u0bbd\u0bad\u0b95\u0bcd \u0bc8\u0bb6\u0baf\u0ba4\u0bcd\u0ba4\u0bb7\u0bb2\u0bcd \u0b85\u0bae\u0bc1\u0bb2\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0bbd\u0ba4 \u0bbb\u0baa\u0bb6\u0ba4\u0bc1 \u0bab\u0b95\u0bcd\u0bc8\u0bb0\u0bb7\u0ba9\u0bcd \u0bc8\u0bb2\u0ba9\u0ba4\u0bcd\u0ba4\u0bb7\u0bb1\u0bcd\u0bc8\u0bb6\u0bc8 \u0b85\u0bae\u0bb7\u0bac\u0ba4\u0bcd \u0ba4\u0bb0\u0bc1\u0bc8\u0bb7\u0ba9\u0bcd\u0bbc\u0bae\u0ba9\u0bcd.",
