    "text": "\u0d8b\u0db4\u0dc1\u0dda\u0d9b\u0db1\u0dba \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013--\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 \u0dc0\u0dd2\u0db1\u0dd2\u0dbe\u0dca\u0da0\u0dba\u0dca\u0dad \u0dc0\u0dc1 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dba\u0dbe\u0dda\u0dbf \u0dba\u0dc1\u0ddd \u0db3\u0dad\u0dca\u200d\u0dbb \u0d9a\u0d82\u0d9a\u0dba \u0dca\u0dca\u0dad\u0dba\u0da2\u0dcf\u0dca\u0dad\u0dbf\u0dca\u0dad \u0dcf\u0dc1\u0db1\u0db8\u0dca \u0dba\u0db3\u0dde\u0dca\u0db0\u0d9c\u0dbd\u0dd2\u0d9a \u0dc0\u0dc1 \u0dca\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dbe\u0dcf\u0dbc\u0dda\u0dbd\u0dba \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dba\u0dda2\u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dbd\u0dca\u0dad\u0dba\u0dda \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d9a\u0dba\u0dd2\u0dad\u0dd2 \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0dda \u0d9a\u0dba\u0db4\u0dca\u0d9a\u0dca\u0d9a\u0dba\u0dbf\u0dcf\u0dba\u0dbd\u0dca\u0dad \u0d87\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dda \u0dba\u0d9a\u0ddc\u0da7\u0dba\u0dc0\u0dda \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db1\u0db82\u0db1\u0db8\u0dca \u0dc0\u0dc1 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u0dc1\u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db3\u0dda \u0dca\u0da9\u0dba\u0db8\u0dca \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dc0\u0dc1 \u0d8b\u0d9a\u0dc0\u0dca \u0dc0\u0dc1 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dca \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db2 \u0d9a\u0d82\u0d9a\u0dba \u0d9a\u0d82\u0d9a\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dc0\u0dca\u0dbd\u0db7\u0dcf\u0dbd\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db2 \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dba\u0dc1\u0d9a\u0dca\u0d9a\u0dba\u0da7\u0dba\u0dcf\u0dbb\u0dca) 4=5 3146:; \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=6 317<46 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0d94\u0dba 4=7 317899 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=45 3135<: \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0dbe \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 4=4< 313653 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0dbe \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 4=63 315639 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=64 319687 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dc0\u0d82\u0dbd\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0dc0\u0dad\u0dd4 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 4=65 3149;3 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=66 314;3; \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0d94\u0dba 4=67 31<79; \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0d94\u0dba 4=68 313659 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=69 315;68 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=8; 315:7: \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=94 317:3< \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0d87\u0dc2 4=95 315386 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=:6 313<9: \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=:8 313487 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=:9 3134<9 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0da2\u0dcf\u0dbc \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 4=:: 31348< \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=;4 313735 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=;5 314587 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=;6 315477 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dc0\u0dd2\u0dbd\u0dd8\u0dcf \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 4=;< 313449 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0dbe \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 4=<8 313397 \u0dbb\u0da2\u0dcf\u0dba \