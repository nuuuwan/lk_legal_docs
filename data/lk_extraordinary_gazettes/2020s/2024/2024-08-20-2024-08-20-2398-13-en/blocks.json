    "bbox": [
      55.3,
      129.03,
      551.1,
      154.5
    ],
    "text": "The Fertilizer (Import, Manufacture and Formulation) Regulations, No. 1 of 2010, published in Gazette Extraordinary No. 1,683/5 of December 06, 2010 is hereby amended as follows :-",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
