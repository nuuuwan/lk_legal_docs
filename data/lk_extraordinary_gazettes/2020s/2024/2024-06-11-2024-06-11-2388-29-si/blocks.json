    "text": "\u0dbc\u0db6\u0dcf\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db6\u0dbc\u0dcf\u0dba\u0db3\u0ddc\u0dba\u0dbb\u0ddc\u0dda\u0dad\u0dd4 \u0dbd\u0db1 \u0da9\u0da9\u0dba\u0db8\u0dca \u0db3\u0dbb\u0dbd\u0dbe\u0dcf\u0dcf\u0dba\u0dda \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb : \u0dbd\u0dba\u0db9 \u0db3\u0dc2\u0dcf\u0dba\u0dda, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbc \u0daf\u0dd2\u0dc0\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0db8\u0dbd\u0dca\u0dbc\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba \u0dba \u0dba\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc0\u0dba\u0dda, \u0d85\u0d82\u0d9a 715 - \u0dc1\u0dd0\u0dbd\u0db1 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbc\u0db0\u0dcf\u0dbb\u0dd2 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc0\u0dba\u0dda, \u0dc1\u0dd0\u0dbd\u0db1\u0dbd\u0dda\u0dcf \u0d9c\u0dba\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2, \u0dc0\u0dbb\u0dca\u0dba\u0dda \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dbd\u0dca\u0dba\u0dda \u0d9a\u0dd0\u0da9\u0dd0\u0dc0\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0db8\u0dca \u0d85\u0d82\u0d9a 420204 \u0d9a\u0dbc\u0dcf\u0db3 \u0d85\u0d82\u0d9a 01 \u0dc1\u0dcf 2023.10.31 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0db3\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d9a 20 \u0dca\u0dad \u0dba\u0db3\u0dca\u0dad\u0db1\u0dd4\u0db8\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0dba\u0dca\u0dad \u0dba\u0dc1\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.2639 \u0db3\u0db8\u0dab \u0dc0\u0dd5 \u0db3\u0dc1\u0dcf \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb \u0dba\u0d9a\u0dba\u0dbb\u0db1 \u0da9\u0da9\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 09 :",
