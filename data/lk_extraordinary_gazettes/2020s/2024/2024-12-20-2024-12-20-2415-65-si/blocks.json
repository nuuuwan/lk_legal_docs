    "text": "\u0dba\u0dca\u0dc0. \u0dc3\u0dd4\u0d9c\u0dda \u0db8\u0dd4\u0dad\u0dd4\u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dba \u0db8\u0dc1\u0dcf\u0dcf \u0dad\u0dad\u0dd4\u0dc5\u0dd4 11 \u0dba\u0d9a\u0db1\u0dcf \u0d85\u0d82\u0d9a 329/5/1 \u0da2\u0dcf\u0dba\u0dba\u0ddd\u0d9a\u0dcf \u0db8\u0dcf\u0dbd\u0dcf \u0dc1\u0db6\u0dbb\u0d9a\u0da9 \u0dba\u0dc1\u0ddd\u0db8\u0dcf\u0d9c\u0db8. \u0dc0\u0dc1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbc\u0d82\u0d9a\u0dcf \u0dbd\u0dbb\u0dcf\u0dba \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba \u0d85\u0d82\u0d9a 19 \u0dad\u0dcf\u0dcf\u0dba \u0db3\u0dcf\u0dbb \u0dba\u0d9a\u0ddc\u0dc20 01. \u0d89\u0dc1\u0dcf \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0db3\u0dcf\u0dbb\u0dca\u0dbe\u0dca\u0dbd\u0dba\u0dca\u0dad \u0d85\u0dcf\u0dbb \u0dad\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0dd2\u0d9a\u0d9a \u0dbb\u0dbb\u0dcf\u0dc0\u0dd4\u0dbc\u0da7 \u0dc1\u0dc1\u0dda\u0dad\u0dd4\u0dc0\u0dd3 \u0db1\u0dbd\u0dca\u0dc0 \u0dcf \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dbd\u0db1\u0dd4\u0dc1\u0dda, \u2015\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbc\u0d82\u0d9a\u0dcf \u0dbd\u0dbb\u0dcf\u0dba \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0dda \u0dba\u0dc0\u0dbb\u0dbd\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbc\u0db6\u0db1 \u0dba\u0dca\u0dc0. \u0dc3\u0dd4\u0d9c\u0dda \u0db8\u0dd4\u0dad\u0dd4\u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dba \u0db8\u0dc1\u0dcf\u0dcf \u0dad\u0dad\u0dd4\u0dc5\u0dd4 \u0db3\u0dc1\u0dcf \u0db1\u0db8\u0dca \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0db3\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dd2\u0db6\u0d9a\u0dbb\u0dd4\u0dbd\u0dca\u0dad 11 \u0dba\u0d9a\u0db1\u0dcf\u0da7 2005.10.18 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0db1\u0dd2\u0dc3\u0dd2 \u0dbd\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0db3\u0dbb\u0dd2\u0db8\u0dcf\u0dba\u0dba\u0dca\u0dad\u0dc4\u0dd2 \u0dba\u0db1\u0ddc\u0dd2\u0dbd\u0dc4\u0dd2\u0da7\u0dd4\u0dbd\u0dcf \u0d91\u0db8 \u0dbd\u0dd0\u0da7\u0dd4\u0db3 \u0dba\u0db1\u0ddc\u0dba\u0d9c\u0dc0\u0dd3\u0db8 \u0db8\u0d9c\u0dd2\u0dca\u0dad \u0d85\u0dc0\u0dcf\u0db0\u0dcf\u0dbb\u0dba\u0dba\u0dca\u0dc0 \u0dc3\u0dd2\u0daf\u0dd4\u0dbd \u0dad\u0dd2\u0dba\u0dda \u0d9a \u0dba\u0dca\u0dad\u0db1\u0dda \u0d91\u0dba\u0dc0\u0dbb \u0d85\u0dc0\u0dcf\u0db0\u0dcf\u0dbb\u0dba\u0dba\u0dca\u0dc0 \u0dc3\u0dd2\u0daf\u0dd4\u0dbd \u0dad\u0dd2\u0dba\u0dda\u0db1\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0dc0\u0dd2\u0dba \u0dad\u0dd4\u0dad\u0dd4 \u0dc0\u0dc1\u0db1\u0dba\u0dca\u0dad \u0d9a\u0dbd\u0dba\u0dbb\u0dca \u0d9a \u0d9a\u0dbd\u0dbb\u0d9a\u0dcf \u0dc3\u0dd2\u0da7\u0d9a \u0dba\u0dca\u0dad\u0db1\u0dda \u0dd2\u0dbd\u0dc5\u0dd2\u0db6\u0db2 \u0dba .\u2016 1. \u0d91\u0db8\u0dca. \u0dba\u0dca\u0dc0. \u0dbc\u0dca\u0dc0\u0dbf\u0dca\u0db8\u0dd2 \u0dcf\u0dca\u0dad\u0daf\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf 2. \u0daf\u0dd3\u0dd2\u0dbd\u0d9a\u0dcf \u0d91\u0dca\u0dad. \u0dc4\u0dd2\u0dda\u0dcf\u0dd0\u0da7\u0dd2\u0dba\u0dba\u0dda 3. \u0db4\u0dca\u200d\u0dbb\u0daf\u0dd3\u0dd2\u0dbd\u0d9a\u0dcf \u0d85\u0dba\u0dda\u0dc3\u0dd4\u0dca\u0dad\u0d9a\u0dbb 4. \u0db6\u0dd3. \u0d91\u0db8\u0dca. \u0db4\u0dd3. \u0db6\u0dc0\u0dca\u0db1\u0dcf\u0dba\u0d9a 5. \u0d91\u0db8\u0dca. \u0dc3\u0dd3. \u0d91\u0db8\u0dca. \u0dba\u0dc4\u0dd2\u0dba\u0dcf 6. \u0db6\u0dd2. \u0d91\u0db8\u0dca. \u0d92. \u0d92. \u0dba\u0dc0\u0dbb\u0db1\u0dcf\u0dbb\u0dda\u0db1 7. \u0db6\u0dd3. \u0da9\u0dd3. \u0d91\u0dc0\u0dca. \u0da2\u0dd3. \u0d85\u0db8\u0dbb\u0dba\u0dc0\u0dbb\u0d9a\u0dbb 8. \u0da2\u0dd3. \u0d85\u0dba\u0dd2. \u0da9\u0dd3. \u0db4\u0dd3. \u0dba\u0dca\u0dc0. \u0da9\u0dd3. \u0d9c\u0db8\u0dca\u0db8\u0dca\u0dad\u0dd2\u0dbd\u0dbc 9. \u0dba\u0dca\u0dc0. \u0d91\u0dc0\u0dca. \u0db8\u0dd4\u0dad\u0dd4\u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dba 10. \u0da9\u0dda. \u0d91\u0dca\u0dad. \u0da2\u0dcf\u0dba\u0db8\u0dd2\u0dab\u0dd2 11. \u0db4\u0dd3. \u0d91\u0dca\u0da1. \u0d91\u0dbd\u0dca. \u0dcf\u0dcf\u0db8\u0dbb\u0dd2\u0d9a\u0dcf \u0d91\u0dca\u0da1. \u0dc1\u0dda. \u0dc1\u0dda. \u0d92. \u0da2\u0dba\u0dc3\u0dd4\u0db1\u0dca\u0dd9\u0dbb, \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dba\u0d9a\u0ddc\u0db8\u0dc0\u0dcf\u0dbb\u0dd2\u0dc0\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dbd\u0dca. 2024 \u0d