    "text": "\u0d85\u0dba\u0dd2.\u0da9\u0dd3.\u0dc0\u0dd2\u0dba\u0dda\u0db8\u0dcf\u0dca\u0dad\u0db1 \u0db8\u0dd2\u0dba \u0d85\u0d82\u0d9a 8/295 \u0dba\u0d9a\u0ddd\u0dca\u0dad\u0d9c\u0dc1\u0db8\u0dd4\u0dbc \u0db3\u0dbc\u0dcf\u0db3\u0dda\u0dbd\u0dbc \u0db8\u0dcf\u0dcf\u0dba\u0dbd\u0dca \u0dc0\u0dc1 \u0db3\u0dc2\u0dcf\u0dda \u0db3\u0dcf\u0dbc\u0db1\u0dba \u0dd2\u0dbd\u0dc5\u0dd2\u0db6\u0db2 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbc\u0d82\u0d9a\u0dcf \u0dad\u0dba\u0dcf\u0db1\u0dba \u0d85\u0d82\u0d9a 17 \u0db8\u0dbc\u0dbc\u0dba\u0dc0\u0dbb\u0d9a\u0dbb \u0db8\u0dcf\u0dbd\u0dcf \u0dba\u0d9a\u0ddc\u0dc20 07 \u0d85\u0dcf\u0dbb \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0dad\u0dbb\u0dcf\u0dc0\u0dd4\u0dbc\u0dca\u0dc0 \u0db3\u0dbd\u0dad\u0dd2\u0db1 \u0dba\u0dc1\u0dba\u0dd2\u0dca\u0dad\u0d9a \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d85\u0db8\u0dcf\u0dcf\u0dba \u0db8\u0dc1\u0dcf\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0d85\u0db1\u0dd2\u0dbd\u0dca \u0da2\u0dcf\u0dba\u0dca\u0dad\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dca\u0dad\u0daf\u0dd4 \u0dbd\u0db1 \u0db8\u0db8 1957 \u0d85\u0d82\u0d9a 14 \u0dc1\u0dcf 1957 \u0d85\u0d82\u0d9a 62 \u0dc1\u0dcf 1962 \u0d85\u0d82\u0d9a 4 \u0dc1\u0dcf 1968 \u0d85\u0d82\u0d9a 39 (1968 \u0d85\u0d82\u0d9a 37 \u0d9a\u0dbb\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0dad\u0dbb\u0dcf\u0dc0\u0dd4\u0dbd\u0dca (\u0dc0\u0dd2\u0dba\u0dbe\u0dbb\u0dbf \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db3\u0dcf\u0d9a\u0db1) \u0db3\u0db1\u0dcf \u0dc0\u0db8\u0d9c \u0dd2\u0dba\u0dba\u0dbd\u0dcf ) \u0d9a\u0dbb\u0db1 \u0db3\u0db1\u0dda \u0dbd\u0dd2\u0db6\u0dca\u0dad \u0dc0\u0d82\u0dba\u0dbe\u0ddd\u0db0\u0dd2\u0dcf \u0dc0\u0dd5 \u0dbc\u0d82\u0d9a\u0dcf\u0dba \u0dbd\u0dba\u0dbd\u0dc0\u0dca\u0dcf\u0dcf\u0dd2\u0dbd\u0dcf \u0d85\u0dba\u0db3\u0db1\u0dda\u0dbd\u0dbc 131 \u0dbd\u0db1 \u0db3\u0dbb\u0dd2\u0dca\u0da1\u0dba\u0daf\u0d9a\u0dba (1956 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dba\u0dbe\u0ddd\u0db0\u0dd2\u0dcf \u0db8\u0dd4\u0dca\u200d\u0dbb\u0dba\u0dba) \u0dbd\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0dad\u0dbb\u0dcf\u0dc0\u0dd4\u0dbd\u0dca \u0db3\u0db1\u0dba\u0dda 4(1) \u0dbd\u0db1 \u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba\u0dba\u0dca\u0dad \u0db8\u0dcf \u0dba\u0dbd\u0dcf \u0db3\u0dd0\u0dbd\u0dbb\u0dd3 \u0dad\u0dad\u0dd2 \u0db6\u0dbc\u0dcf\u0dbc \u0d85\u0db1\u0dd4\u0dbd \u0d91\u0d9a\u0dd3 \u0dad\u0dbb\u0dcf\u0dc0\u0dd4\u0dbc \u0dba\u0dda\u0dbb\u0dd4\u0db8\u0dca \u0dd2\u0dba\u0dbb\u0dd3\u0dba\u0db8\u0dca\u0dad \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0dd2\u0dba\u0dbb\u0dd3\u0db8 \u0dc0\u0db2\u0dc1\u0dcf \u0dba\u0dda\u0dbb\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dbd\u0dbe\u0dba\u0dba\u0dca\u0dad \u0d9c\u0dcf\u0dbd\u0dca\u0dbc \u0dba\u0d9a\u0ddc\u0dba\u0dc1\u0ddc\u0db8\u0dca\u0db6\u0dca\u0dad\u0dbd\u0dda\u0dcf \u0d85\u0d82\u0d9a 66/2 \u0d92 \u0d91\u0dca\u0da1. \u0dad\u0dbb\u0dca. \u0d91\u0dbd\u0dca. \u0dc3\u0dd4\u0d9c\u0dcf\u0d9a\u0dcf\u0dc0 \u0db8\u0dba\u0dcf \u0db3\u0dda \u0d9a\u0dbb \u0d94\u0dc4\u0dd4 \u0dba\u0dbd\u0dcf \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0dba\u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbc\u0dd0\u0dba\u0dda.",
