    "text": "\u0dd9\u0dc0\u0dca\u0dbb\u0dc3\u0dca \u0d9c\u0d9f \u0dc0\u0dd0\u0dc3\u0dd2 \u0da2\u0dbd \u0d85\u0db4\u0dc0\u0dc4\u0db1 \u0dc4\u0dcf \u0db4\u0dbb\u0dd2\u0dc3\u0dbb\u0dba \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca, \u0dd9\u0db6\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dad\u0dbb \u0dc4\u0dd2\u0d9a\u0dca\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dcf\u0dd9\u0dbb\u0dca \u0d9a\u0dcf\u0dab\u0dd4 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2\u0dba \u0dd9\u0db6\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dc0\u0dd2\u0dbd \u0dc0\u0dd0\u0dc0\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dbd\u0dd4\u0dad\u0dd2\u0db1\u0dca \u0d87\u0dc5 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0d9a\u0dca \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d89\u0da9\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0dbb\u0da2\u0dba\u0da7 \u0db4\u0dc0\u0dbb\u0dcf\u0dd9\u0d9c\u0db1 \u0d87\u0dad\u0dd2 \u0db6\u0dd0\u0dc0\u0dca \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dd9\u0dad\u0dca 7 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dd9\u0dba\u0dca (1) \u0dc0\u0dd0\u0db1\u0dd2 \u0d8b\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db8\u0dd2. \u0db4\u0dc0\u0dbb\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dbd\u0daf \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba:- \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca, \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca, 535A, \u0dd9\u0db6\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0dc0\u0dd2\u0dbd \u0d9c\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0dd9\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2, \u0dc3\u0dbb\u0dca\u0dd9\u0dc0\u0dca\u0dba\u0dbb\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dd9\u0dba\u0dc5\u0d9a\u0dbb \u0d87\u0dad\u0dd2 2024.10.16 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0d82\u0d9a 521216 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0dd9\u0db8\u0dca 02 \u0dc0\u0dd0\u0db1\u0dd2 \u0d9a\u0dbd\u0dcf\u0db4\u0dd9\u0dba\u0dca \u0db4\u0dad \u0d85\u0d82\u0d9a 01\u0dc4\u0dd2, \u0db4\u0dc4\u0dad \u0d85\u0d82\u0d9a\u0db1\u0dba \u0d9a\u0dbb \u0dd9\u0db4\u0db1\u0dca\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0dca:",
