    "text": "\u0dba\u0db8\u0db8 \u0db1\u0dd2\u0dba\u0dba \u0d9c\u0dba \u0d85\u0db1\u0dd4\u0db6\u0dca\u0db0\u0dd2\u0dad\u0dcf \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dba\u0d9a\u0ddc\u0db8\u0dc0\u0dcf\u0dd2\u0da0\u0dc0\u0db4 \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dca \u0dbd\u0dbb\u0dba\u0dcf\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbe\u0db1\u0dba\u0dda \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb \u0dcf \u0dca\u0dc0\u0dbd\u0dcf \u0dad\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0db4\u0dba \u0db4\u0dd2\u0dd2\u0db6\u0db6\u0dc0\u0dbd - 1. \u0d9a\u0dc0\u0db4. \u0da9\u0dd3. \u0dbb\u0dc0\u0dd3\u0dca\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dd4\u0dd4\u0db8\u0db8\u0dcf\u0dca \u0db8\u0dba\u0dcf, \u0d85\u0d82\u0d9a. 9/3, \u0db1\u0dd2\u0dbc\u0db1\u0dd2\u0dbd\u0dcf\u0dc0, \u0db8\u0dc1\u0dba\u0dca \u0dbd\u0dcf\u0dba, \u0dc1\u0db8\u0dca\u0db6\u0dca\u0dad\u0dba\u0dcf\u0ddc\u0da7. 2. \u0d9a\u0dc0\u0db4. \u0d9a\u0dca\u0da1. \u0d9a\u0dca\u0dad. \u0dcf\u0dca\u0dad\u0dcf \u0db1 \u0dcf \u0dc3\u0dd2\u0daf\u0dca \u0dbd\u0dcf \u0db8\u0dba\u0dcf, \u0d85\u0d82\u0d9a. 152/3, \u0dbd\u0dbc\u0dc0\u0db4\u0dd4\u0daf\u0dca \u0dbc \u0db4\u0dcf\u0dbb, \u0dba\u0db6\u0dbd\u0dd2\u0d85\u0dca\u0dc0\u0dcf. \u0dc0\u0dc1 \u0dbc\u0d82\u0d9a\u0dcf \u0dba\u0dc0 \u0dca \u0da7\u0dca \u0dbd\u0dd2\u0dd2\u0d9a\u0da7\u0da9\u0dca, \u0db8\u0dc1\u0dba\u0dca \u0dbd\u0dcf\u0dba, \u0dc1\u0db8\u0dca\u0db6\u0dca\u0dad\u0dba\u0dcf\u0ddc\u0da7. \u0d85\u0dcf\u0dbb \u0d9a\u0dcf\u0dbb\u0dca\u0dd2\u0d9a\u0d9a \u0dbb\u0dbb\u0dcf\u0dc0\u0dd4\u0dbc\u0dca\u0dc0 \u0db4\u0dbd\u0dad\u0dd2\u0db1 \u0dba\u0dc1\u0dba\u0dd2\u0dca\u0dad \u0dcf , \u0d85\u0dd2\u0dad\u0d9a\u0dbb\u0db4, \u0dbb\u0dcf\u0da2\u0dcf\u0dba \u0db4\u0dd2\u0da0\u0db4\u0dcf\u0dbc\u0db1, \u0dc0\u0db4\u0dbd\u0dba\u0dca\u0db0\u0dbe \u0d9a\u0da7\u0dd4\u0dad\u0dd4,, \u0db4\u0dc2\u0dcf\u0dca\u0dc0 \u0dc0\u0dcf\u0dcf, \u0db4\u0dc2\u0dcf\u0dca\u0dc0 \u0db4\u0dcf\u0dbc\u0db1 \u0dc0\u0dc1 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d85\u0db8\u0dcf\u0dcf\u0dba \u0dbb\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0dc1\u0dd2\u0