      605.92,
      542.51,
      631.39
    ],
    "text": "Rules made under section 7 of the Council of Legal Education Ordinance (Chapter 276) as amended from time to time, are hereby further amended in rule 23 thereof as follows:-",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      48.0,
      641.92,
      542.5,
      667.39
    ],
