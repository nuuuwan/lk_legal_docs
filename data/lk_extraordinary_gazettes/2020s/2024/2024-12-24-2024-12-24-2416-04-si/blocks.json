    "text": "\u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0d9c 1. \u0dd9\u0db8\u0db8 \u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0d9c 2024 \u0d85\u0d82\u0d9a 2 \u0daf\u0dbb\u0db1 \u201c\u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dc3\u0dca\u0d9a\u0db1\u0dca\u0db0 \u0dc4\u0dcf \u0dc3\u0dd4\u0dbb\u0dd0\u0d9a\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca (\u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0da2\u0dd9\u0dba\u0dca \u0dd9\u0dc1\u0dda\u0dc2 \u0db4\u0dad\u0dba\u0da7 \u0db4\u0dd0\u0dc0\u0dbb\u0dd6 \u0dbd\u0d82\u0d9a\u0dcf \u0d9b\u0db1\u0dd2\u0da2 \u0dd9\u0dad\u0dbd\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0d9c\u0dad \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0dc0\u0dca \u0dab\u0dba \u0db4\u0dad\u0dd2\u0dc0\u0256\u0dc4\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca\u0daf\u0dd3 \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0d9a\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc3\u0dd4\u0dbb\u0dd0\u0d9a\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dab\u0dba \u0db4\u0dd2\u0dba\u0dc0\u0dd3\u0db8 \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8)\u201d \u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0d9c \u0dd9\u0dbd\u0dc3 \u0daf\u0dd0\u0d9a\u0dca\u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a\u0dd2\u0dba. 2. \u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0d9a\u0db8\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\u0dc1\u0dd9\u0dba\u0dca \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dc3\u0dc4 \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0dab\u0dba \u0dd9\u0dbd\u0dca\u0d9b\u0d9a\u0dcf\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd3\u0dc0\u0dbb\u0dba\u0dcf \u0dd9\u0dc0\u0dad \u0db8\u0db8 \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dc