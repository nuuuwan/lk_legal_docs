  {
    "page_number": 0,
    "bbox": [
      302.47,
      496.43,
      541.75,
      549.81
    ],
    "text": "All persons interested in the aforesaid land are hereby required to appear personally, or by agents duly authorized in writing before me at 10.00 a.m. on the 05th day of March, 2025 at the Divisional Secretariat, Walasmulla.",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Bold"
    ],
    "sizes": [
      9.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      302.47,
      549.35,
      541.93,
      623.87
    ],
    "text": "And further you are hereby requested to notify to me in writing (in duplicate) on or before the 26th day of February, 2025, the nature of their interests in the Land, the particulars of their claims for compensation for the acquisition of the said land, the amount of compensation and the details of the computation of such amount.",
