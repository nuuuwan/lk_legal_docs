    "text": "\u0dbb\u0dad\u0dca\u0db8\u0dbd\u0dcf\u0db1 \u0dd9\u0db8\u0ddc\u0dbb\u0da7\u0dd4\u0dc0 \u0d85\u0db4\u0da2\u0dbd \u0db4\u0dad\u0dd2\u0da0\u0d9a\u0dd3\u0d9a\u0dbb\u0dab\u0dba \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0d85\u0daf\u0dd2\u0dba\u0dbb II \u0dba\u0da7\u0dd9\u0dad\u0dca 11 \u0dc0\u0db1 \u0dd9\u0db4\u0ddc\u0db8\u0dca\u0db4\u0dcf\u0d9c\u0dcf\u0dbb\u0dba \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0d9a\u0dca\u0dd9\u0dc0\u0db1 \u0d89\u0da9\u0db8 \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dbb\u0da2\u0dba \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0db6\u0dd0\u0dc0\u0dca \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dd9\u0dad\u0dca 7 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dd9\u0dba\u0dca (1) \u0dc0\u0db1 \u0d8b\u0db4 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db8\u0dd2. \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u0ddc\u0dd9\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0db1 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb: \u0db6\u0dc3\u0dca\u0db1\u0dcf\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dd9\u0dad\u0dca, \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca, \u0dd9\u0db8\u0ddc\u0dbb\u0da7\u0dd4\u0dc0 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca \u0d85\u0d82\u0d9a 547, \u0d85\u0d9f\u0dd4\u0dbd\u0dcf\u0db1 \u0d8b\u0dad\u0dd4\u0dbb \u0d9c\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd3 \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca \u0d85\u0d9f\u0dd4\u0dbd\u0dcf\u0db1 \u0d9c\u0dd9\u0