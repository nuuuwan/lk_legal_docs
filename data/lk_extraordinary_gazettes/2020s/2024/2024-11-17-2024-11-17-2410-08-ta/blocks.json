    "text": "\u0b87\u0b99\u0bcd\u0b95\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bac\u0b95\u0ba0\u0ba6\u0bbf\u0ba9\u0bcd II \u0b86\u0bac\u0ba4\u0bc1 \u0ba2\u0bbf\u0ba7\u0bb2\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0ba8\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0ba7\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0baa \u0ba2\u0ba4\u0bb0\u0bcd\u0bc8\u0bb3\u0bc1\u0bb3\u0bcd \u0b92\u0bb5\u0bcd\u0bb5\u0bac\u0bbe\u0bb0\u0bc1 \u0ba2\u0ba4\u0bb0\u0bc1\u0bae\u0bcd, \u0b85\u0bb5\u0bcd\u0bb5\u0bc1\u0ba4 \u0b85\u0b9f\u0bcd\u0b9f\u0bac\u0b95\u0ba0\u0ba6\u0bbf\u0ba9\u0bcd I \u0b86\u0bae\u0bcd \u0ba2\u0bbf\u0ba7\u0bb2\u0bbf\u0ba9\u0bcd \u0b9a\u0ba2\u0bb5\u0ba7\u0bbe\u0ba4\u0bcd\u0ba1 \u0b95\u0bc1\u0ba8\u0bbf\u0baa\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0ba8\u0bbf\u0baa\u0bcd\u0ba4\u0bbf\u0b9f\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0baa \u0bc8\u0b9f\u0bcd\u0b9a\u0bbf \u0b9a\u0bbe\u0bb0\u0bcd\u0ba4\u0bbe\u0bc8 \u0b85\u0ba7\u0b9a\u0bbf\u0ba6\u0ba9\u0b95\u0ba5\u0baa\u0bcd\u0baa\u0bc1 \u0ba6\u0bbe\u0baa\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 99\u0b85 \u0b86\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0ba7\u0ba6\u0bbf\u0ba9\u0bcd \u0bc8\u0bc0\u0bb4\u0bcd \u0ba4\u0bbe\u0ba7\u0bbe\u0bb3\u0bc1\u0ba5\u0ba9\u0bcd\u0ba8 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0ba4\u0bbf\u0ba3\u0bb0\u0bcd\u0bc8\u0baa\u0bbe\u0bc8\u0ba4\u0bcd \u0b9a\u0ba1\u0bb0\u0bcd\u0ba8\u0bcd\u0bb5\u0ba1\u0b9f\u0bc1\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0baa\u0bbe\u0bb0\u0bcd\u0bc8\u0bb5\u0baa\u0ba3 \u0b87\u0ba4\u0bcd\u0ba1\u0bbe\u0bb2\u0bcd \u0b85\u0ba8\u0bbf\u0bac\u0bbf\u0ba4\u0bcd\u0ba1\u0bb2\u0bcd \u0bb5\u0bc8\u0bbe\u0b9f\u0bc1\u0b95\u0bcd\u0bc8\u0bbf\u0ba9\u0bcd\u0b9a\u0ba8\u0bbe\u0bae\u0bcd. \u0b86\u0bb0\u0bcd. \u0b8e\u0bae\u0bcd. \u0b8f. \u0b8e\u0bb2\u0bcd. \u0ba7\u0ba4\u0bcd\u0ba2\u0bbe\u0ba6\u0b95\u0bcd\u0bc8, \u0b8e\u0bae\u0bcd. \u0b8f. \u0baa\u0bc0. \u0b9a\u0bc0. \u0bb5\u0ba4\u0b9a\u0ba7\u0ba7\u0bbe, \u0b85\u0ba5\u0bc0\u0bb0\u0bcd \u0ba4\u0bbe\u0ba6\u0bbf\u0bb8\u0bcd, \u0ba1\u0bac\u0bbf\u0b9a\u0bbe\u0baa\u0bb0\u0bcd, \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0ba4\u0bbf\u0ba3\u0bb0\u0bcd, \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0ba4\u0bbf\u0ba3\u0bb0\u0bcd, \u0b9a\u0ba1\u0bb0\u0bcd\u0ba1\u0bb2\u0bcd \u0b86\u0b95\u0ba0\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1. \u0b9a\u0ba1\u0bb0\u0bcd\u0ba1\u0bb2\u0bcd \u0b86\u0b95\u0ba0\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1. \u0b9a\u0ba1\u0bb0\u0bcd\u0ba1\u0bb2\u0bcd \u0b86\u0b95\u0ba0\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1. \u0b8f. \u0b9a\u0ba3\u0bcd\u0bae\u0bc1\u0bc8\u0ba2\u0bbe\u0ba1\u0ba9\u0bcd, \u0b9a\u0ba4\u0ba7\u0bbe\u0b9a\u0bbf\u0bbe\u0bbf\u0ba6\u0bb0\u0bcd \u0ba9\u0b95\u0bcd\u0bb7\u0bcd\u0ba5\u0ba9\u0bcd \u0ba1\u0bbf\u0b9a\u0bbe\u0ba2\u0bbe\u0ba6\u0b95\u0bcd\u0bc8, \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0ba4\u0bbf\u0ba3\u0bb0\u0bcd, \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0ba4\u0bbf\u0ba3\u0bb0\u0bcd, \u0b9a\u0ba1\u0bb0\u0bcd\u0ba1\u0bb2\u0bcd \u0b86\u0b95\u0ba0\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1. \u0b9a\u0ba1\u0bb0\u0bcd\u0ba1\u0bb2\u0bcd \u0b86\u0b95\u0ba0\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1. \u0b9a\u0ba1\u0bb0\u0bcd\u0ba1\u0bb2\u0bcd \u0b86\u0b95\u0ba0\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1, \u0b9a\u0ba1\u0bb0\u0bcd\u0ba1\u0bb2\u0bcd \u0b86\u0b95\u0ba0\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1 \u0b85\u0bb2\u0bc1\u0bac\u0ba9\u0bc8\u0bae\u0bcd, \u0b9a\u0ba7\u0ba0 \u0ba5\u0bbe\u0bac\u0ba4\u0bcd\u0b95\u0ba1, \u0b87\u0ba7\u0bbe\u0b9c\u0bc8\u0bbf\u0bbe\u0bbf\u0ba6, 2024, \u0ba2\u0bb5\u0bac\u0bae\u0bcd\u0ba4\u0bb0\u0bcd 17.",
