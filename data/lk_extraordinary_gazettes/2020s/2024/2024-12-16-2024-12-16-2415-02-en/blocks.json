  {
    "page_number": 0,
    "bbox": [
      48.0,
      501.21,
      542.49,
      550.35
    ],
    "text": "The Public is hereby informed that, due to the amalgamation of Multi Finance PLC with LB Finance PLC as part of the Masterplan for Consolidation of Non-Bank Financial Institutions Sector, the Governing Board of the Central Bank of Sri Lanka, in terms of the Finance Business Act, No. 42 of 2011, has cancelled the Licence issued to Multi Finance PLC of No. 275/75, Prof. Stanley Wijesundera Mawatha, Colombo 07, to carry on finance business, with effect from 25.07.2024.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
