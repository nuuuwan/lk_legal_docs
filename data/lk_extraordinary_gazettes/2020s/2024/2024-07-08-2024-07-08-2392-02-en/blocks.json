    ],
    "text": "Notice that the Supplementary Electoral Register 2024(1) has been certified under the Registration of Electors Act",
    "fonts": [
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      11.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      48.0,
      503.57,
      542.49,
      600.21
    ],
    "text": "In terms of Section 20A (10) of the Registration of Electors Act, notice is given on behalf of the Registering Officer of each electoral district that the Supplementary Electoral Register 2024(1) including the names of the registered electors, who has attained the age of 18 years on a specified date within the period from 01 February 2024 to 31 May 2024 has been certified on 08 July 2024 in accordance with the Registration of Electors Act, No. 44 of 1980 as amended by the Registration of Electors (Amendment) Act, No. 22 of 2021; that the electoral register for the electoral districts mentioned in column I of the schedule below has been certified by the Assistant Registering Officer in the corresponding entry in Column II thereof; that inspection may be made during normal office hours at the District Election Office/offices mentioned in the corresponding entry in Column III thereof.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
