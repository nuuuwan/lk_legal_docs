    "text": "\u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0d9c\u0dda \u0d9a\u0dd2\u0dba\u0dca\u0dad\u0db1\u0dcf : \u0dbb\u0da2\u0dcf\u0dba. \u0d89\u0dc1\u0dcf \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0d89\u0da9\u0db8\u0da70\u0db3\u0dbb\u0dbd\u0dbe\u0dcf\u0dcf\u0dbd\u0dba\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0d9c\u0dda, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dbd\u0dcf\u0dc3\u0dd2\u0d9a\u0d9c\u0dda \u0dba\u0dc1\u0da2 \u0dba\u0dbd\u0db1\u0dda \u0dc0\u0d9c\u0dda\u0db6\u0dca\u0dad\u0db0\u0d9a\u0d9c\u0dda \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dba\u0daf\u0db1\u0dcf\u0db8 \u0dcf\u0db8 \u0dcf\u0db8\u0dca\u0dad \u0dba\u0dc1\u0da2 \u0d94\u0dc0\u0dd4\u0dca\u0dad\u0dba\u0dba \u0dbd\u0dd2\u0dba\u0dc0\u0dd2\u0dbd\u0dd2\u0dbd\u0dbd\u0dd2\u0dca\u0dad \u0db6\u0dbc\u0dba\u0dbc\u0dda \u0d85\u0dba\u0dbd\u0dbd\u0dd4\u0dca\u0dad \u0dba\u0dc1\u0da2 2025 \u0da2\u0dcf\u0db1\u0dbd\u0dcf\u0dbb\u0dd2 \u0db8\u0dc0 27 \u0dbd\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dba\u0db3.\u0dbd. 10.30 \u0da7 \u0d87\u0dbc\u0db3\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba \u0dba \u0dba\u0db8\u0d9a\u0d9c\u0dda \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbc\u0dba\u0dda \u0daf\u0dd3 \u0db8\u0dcf \u0dc0\u0d9c\u0dda \u0d85\u0d9b \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.",
