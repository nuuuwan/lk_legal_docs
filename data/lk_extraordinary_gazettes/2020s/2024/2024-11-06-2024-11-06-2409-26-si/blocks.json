    "text": "\u0dba\u0db3\u0dd4\u0daf\u0dd4 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dba\u0d9a\u0dca \u0dc0\u0db2\u0dc1\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dba\u0dba\u0da2\u0da2\u0dcf\u0db1\u0dba\u0da7 \u0d9c\u0dd0\u0dd3\u0db8\u0db8 \u0dd2\u0dab\u0dd2\u0dc3\u0dc0 \u0db6\u0dd4\u0dd3\u0db0\u0dbe\u0dcf\u0dc0\u0db1, \u0d86\u0d9c\u0db8\u0dd2\u0d9a \u0dc0\u0dc1 \u0dc0\u0d82\u0dc0\u0dca\u0d9a\u0dd8\u0dad\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4, \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d92\u0d9a\u0dcf\u0db6\u0dd3\u0db0\u0dcf\u0dcf, \u0dc0\u0db8\u0dcf\u0da2\u0dcf \u0d86\u0dbb\u0d9a\u0dca\u0dbf\u0dab \u0dc0\u0dc1 \u0da2\u0dcf\u0db1\u0db8\u0dcf\u0db0\u200d \u0d85\u0db8\u0dcf\u0dcf\u200d\u0dcf\u0d82\u0dbe\u0dba\u0da7 \u0d85\u0dbd\u0dbe\u200d \u0db3\u0dc1\u0dcf \u0daf\u0dd0\u0d9a\u0dca\u0dba\u0dbd\u0db1 \u0d89\u0da9\u0db80\u0db3\u0dbb\u0dbd\u0dbe\u0dcf\u0dcf\u0dbd\u0dba \u0dbc\u0db6\u0dcf \u0d9c\u0dd0\u0dd3\u0db8\u0db8\u0da7 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dbd \u0d85\u0daf\u0dc1\u0dc0\u0dca \u0d9a\u0dbb\u0db1 \u0db6\u0dd0\u0dc0\u0dca, 1964 \u0d85\u0d82\u0d9a 28 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u0d9c\u0dda \u0d85\u0dda\u0d9a\u0dbb \u0d9c\u0dd0\u0dd3\u0db8\u0dba\u0d9c\u0dda (\u0dc0\u0d82\u0dba\u0dbe\u0da2\u0db0\u0db1) \u0db3\u0db1\u0dad\u0dd2\u0dca\u0dad \u0dc0\u0d82\u0dba\u0dbe\u0da2\u0db0\u0dd2\u0dcf \u0db3\u0dbb\u0dd2\u0daf\u0dd2 \u0d89\u0da9\u0d9c\u0dda \u0d85\u0dda\u0d9a\u0dbb \u0d9c\u0dd0\u0dd3\u0db8\u0dba\u0d9c\u0dda \u0db3\u0db1\u0dba\u0dda 7 \u0dbd\u0dd0\u0db1\u0dd2 \u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba\u0dda (1) \u0dbd\u0dd0\u0db1\u0dd2 \u0d8b\u0db3\u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dba\u0dda \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0daf\u0dd0\u0db1\u0dd4\u0d9c\u0dda \u0daf\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db8\u0dd2.",
