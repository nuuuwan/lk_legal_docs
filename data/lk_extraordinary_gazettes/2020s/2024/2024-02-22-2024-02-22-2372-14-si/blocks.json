    ],
    "text": "01. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 152 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0db8\u0dca \u0d85\u0d82\u0d9a\u0dba: 320740(03)1 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0db8\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dad\u0dca\u0dad \u0d91\u0dc3\u0dca\u0dd9\u0da7\u0dca\u0da7\u0dca ; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0d91\u0db1\u0dca. \u0dc3\u0db8\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dba\u0dcf, \u0d85\u0d82\u0d9a 863, \u0daf\u0dd4\u0db1\u0dca\u0dc4\u0dd2\u0db3 \u0db4\u0dcf\u0dbb, \u0d87\u0dad\u0dca\u0d9c\u0dcf\u0dbd, \u0d9c\u0db8\u0dca\u0dd9\u0db4\u0ddc\u0dbd; \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0d9c\u0dad\u0dca \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca: 0.0904. \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca: \u0d8b\u0dad\u0dd4\u0dbb\u0da7 : 145 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dca\u0dbd; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7 : 145, 148 \u0dc3\u0dc4 151 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0daf\u0d9a\u0dd4\u0dab\u0da7 : 151 \u0dc3\u0dc4 150 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7 : 150 \u0dc3\u0dc4 145 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2. 02. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 153 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0db8\u0dca \u0d85\u0d82\u0d9a\u0dba: 320740(03)1 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0db8\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dad\u0dca\u0dad \u0d91\u0dc3\u0dca\u0dd9\u0da7\u0dca\u0da7\u0dca ; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0d91\u0db1\u0dca \u0dc3\u0db8\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dba\u0dcf, \u0d85\u0d82\u0d9a 863, \u0daf\u0dd4\u0db1\u0dca\u0dc4\u0dd2\u0db3 \u0db4\u0dcf\u0dbb, \u0d87\u0dad\u0dca\u0d9c\u0dcf\u0dbd, \u0d9c\u0db8\u0dca\u0dd9\u0db4\u0ddc\u0dbd; \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0d9c\u0dad\u0dca \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca: 0.0597. \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca: \u0d8b\u0dad\u0dd4\u0dbb\u0da7 : 144, 145 \u0dc3\u0dc4 150 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dbd\u0dd2; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7 : 150 \u0dc3\u0dc4 154 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dca\u0dbd; \u0daf\u0d9a\u0dd4\u0dab\u0da7 : 154 \u0dc3\u0dc4 143 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7 : 143, 144 \u0dc3\u0dc4 145 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2. \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d89\u0da9\u0db8\u0da7/ \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8\u0dca \u0dd9\u0dc4\u0ddd \u0dd9\u0dc0\u0db1\u0dad\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dd9\u0daf\u0db1\u0dcf\u0da7\u0db8 \u0dad\u0db8 \u0dad\u0db8\u0db1\u0dca \u0dd9\u0dc4\u0ddd \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dd9\u0d9c\u0db1\u0dca \u0dbd\u0dd2\u0dba\u0dc0\u0dd2\u0dbd\u0dd2\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0d85\u0dba\u0dc0\u0dbd\u0dd4\u0db1\u0dca \u0dd9\u0dc4\u0ddd 2024.03.25 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u0db4\u0dbb \u0db7\u0dcf\u0d9c 2.00 \u0da7, \u0d9c\u0d9f \u0d89\u0dc4\u0dc5 \u0dd9\u0d9a\u0ddd\u0dbb\u0dd9\u0dc5\u0dda \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dd9\u0dba\u0dca \u0daf\u0dd2 \u0db8\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0d9b \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0dad\u0dc0\u0daf, 2024.03.04 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1\u0da7 \u0db8\u0dad\u0dca\u0dd9\u0dad\u0db1\u0dca \u0d92 \u0d89\u0da9\u0db8/ \u0d89\u0da9\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd9\u0dba\u0db1\u0dca \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8\u0dca\u0dc0\u0dbd \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba\u0dad\u0dca \u0d91\u0d9a\u0dd3 \u0d89\u0da9\u0db8/ \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0dba\u0da7 \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d9c\u0dd0\u0db1 \u0dc0\u0db1\u0dca\u0daf\u0dd2 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0da7 \u0d87\u0dad\u0dd2 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dad\u0dca \u0dc0\u0db1\u0dca\u0daf\u0dd2 \u0db8\u0dd4\u0daf\u0dbd \u0dc4\u0dcf \u0d92 \u0db8\u0dd4\u0daf\u0dbd \u0d9c\u0dab\u0db1\u0dca \u0db6\u0dd0\u0dbd\u0dd6 \u0dc4\u0dd0\u0da7\u0dd2\u0dad\u0dca \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd2\u0da7\u0db4\u0dad\u0dca \u0dd9\u0daf\u0d9a\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd6 \u0dbd\u0dd2\u0dba\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0d9a\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0dc3\u0dd3. \u0dd9\u0d9a\u0dca. \u0d85\u0db8\u0dbb\u0dd9\u0d9a\u0ddd\u0db1\u0dca, \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca, \u0d9c\u0d9f \u0d89\u0dc4\u0dc5 \u0dd9\u0d9a\u0ddd\u0dbb\u0dd9\u0dc5\u0dda,",
