  {
    "page_number": 0,
    "bbox": [
      302.35,
      466.55,
      541.7,
      520.05
    ],
    "text": "All persons who entitled or claim ownership for the aforesaid land/servitude are required to appear personally or by agent duly authorized in writing before me at Divisional Secretariat Attanagalla on 22.03.2024 at 10.00 a.m.",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Bold"
    ],
    "sizes": [
      9.960000038146973
