  {
    "page_number": 0,
    "bbox": [
      302.35,
      519.35,
      541.64,
      593.97
    ],
    "text": "Further hereby requested to notify in writing (in duplicate) on or before 15.03.2024, that the nature of the ownership of the said land/lands, reason of the claim, compensation for the acquisition of said land/servitude, the amount of compensation and the method of the computation of such amount.",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Bold"
    ],
