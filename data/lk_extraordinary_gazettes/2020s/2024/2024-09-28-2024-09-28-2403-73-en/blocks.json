    ]
  },
  {
    "page_number": 0,
    "bbox": [
      48.02,
      573.23,
      286.71,
      658.31
    ],
    "text": "Description of the Land/servitude to be acquired : All allotments of land described below and depicted as Lot No. 1 - 2 in Cad Map No. 522025, Block 02, sheet No. 1 dated 24.07.2024 prepared by the Surveyor General situated in the Village of Palawaththa in 479B, Asiri Uyana Grama Niladhari Division, Divisional Secretary\u2019s Division of Kaduwela, Colombo District, Western Province:",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Bold",
      "Times New Roman,Italic"
    ],
    "sizes": [
