bcd\u0b95\u0bc1\u0bae\u0bcd, \u0bc7\u0ba4\u0bbe\u0ba9 \u0b9a\u0bbf\u0b9a\u0bbf\u1fa2 \u0b8e\u0b95\u0bcd\u0ba9\u0bb8\u0bcd \u0b9c\u0baf\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 \u0b8e\u0ba9\u0bcd\u0baa\u0bb5\u0bbe\u0bbf\u0ba9\u0bcd \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90. 6:140 0.0368 \u0b95\u0bcd \u0bb7\u0ba9\u0bbf\u0b95\u0bcd \u0bae\u0bb9\u0bc0\u0bb2 \u0b9c\u0baf\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 643162075V \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0bb5\u1f90 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 142 _ \u0b87\u0bb2. 511/1, \u0ba8\u0bc0\u0bb0\u0bcd\u0bc6\u0b95\u0bbe\u1fa8\u0bae\u0bcd\u1f97 \u0baa\u0bbe\u0bc8\u0ba4, \u0b87\u0ba9\u0bcd \u0b85\u1f8e\u0b95\u0bc1\u0bb5\u0bb4\u0bbf \u0bb5\u0ba4\u0bcd\u0ba4\u0bc8\u0bb3. \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 141 \u0b87\u0ba9\u0bcd \u0bc6\u0baa\u0bbe\u1f90 \u1f99\u0bb1\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd, \u0bc7\u0ba4\u0bbe\u0ba9 \u0b9a\u0bbf\u0b9a\u0bbf\u1fa2 \u0b8e\u0b95\u0bcd\u0ba9\u0bb8\u0bcd \u0b9c\u0baf\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 \u0b8e\u0ba9\u0bcd\u0baa\u0bb5\u0bbe\u0bbf\u0ba9\u0bcd \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90.",
