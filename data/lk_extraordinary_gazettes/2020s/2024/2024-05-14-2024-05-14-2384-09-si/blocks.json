ca \u0db8\u0dc3 0 \u0dc0\u02ec\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0dbb\u0da2\u0db8\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad \u0db4\u02eb\u0dbb, \"\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dad \u0db8\u02ec\u0daf\u0dd4\u0dbb\", \u0d85\u02ad\u0d9a 120004, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u02f3\u0db8\u0dca \u02f3 \u0db4\u02eb\u0dbb\u0dca\u0dad\u02f3\u0db8\u0dca\u0dca\u0dad\u0dad\u0dd4\u02f3\u0269 \u0daf\u0dd3 \u0dba0",
