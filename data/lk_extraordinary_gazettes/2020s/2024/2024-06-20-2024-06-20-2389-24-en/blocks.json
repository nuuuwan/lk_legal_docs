      55.3,
      98.53,
      549.8,
      124.0
    ],
    "text": "2. The Institute shall conduct the degree programme in relation to the degree specified in Schedule II hereto, only at No. 19, Mcleod Road, Colombo 4.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
