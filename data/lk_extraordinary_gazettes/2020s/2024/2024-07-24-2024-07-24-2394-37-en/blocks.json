      55.25,
      484.26,
      297.78,
      543.33
    ],
    "text": "I, Nalaka Jude Harin Fernando, Minister of Tourism and Lands, hereby declare, under Sub-section (1) of Section 5 of the Land Acquisition Act, that the land described below is needed for a public purpose and will be acquired under the provisions of that Act.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
