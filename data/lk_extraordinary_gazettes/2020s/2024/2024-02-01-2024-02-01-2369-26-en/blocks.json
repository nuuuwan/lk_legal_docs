  },
  {
    "page_number": 1,
    "bbox": [
      55.3,
      98.53,
      549.8,
      123.0
    ],
    "text": "(b) the tolerance deficiency for each type of bread specified in the Column I of Schedule hereto, shall be as specified in the corresponding entry in Column 3 of that Schedule ;",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
