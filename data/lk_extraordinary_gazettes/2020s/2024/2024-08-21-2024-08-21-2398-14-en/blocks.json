    ],
    "text": "THE NATIONAL WATER SUPPLY AND DRAINAGE BOARD LAW, No. 2 OF 1974 Notice under Section 84",
    "fonts": [
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      11.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      48.99,
      462.41,
      542.5,
      499.88
    ],
    "text": "NOTICE is hereby given in terms of Section 84 of the National Water Supply and Drainage Board Law No. 02 of 1974 that the following tariffs will be revised with effect from the 21st day of August 2024, for sewerage services from customers connected to all sewerage systems/sewer networks owned, operated and maintained by the National Water Supply and Drainage Board.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.829999923706055,
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      49.0,
      510.41,
      542.49,
      547.88
    ],
    "text": "This notice replaces the notice appearing in the Gazette Extraordinary No. 2343/29 dated 02nd August, 2023 in respect of the sewerage tariff with effect from the 01st day of August 2023 and applicable to all customers connected to all sewerage systems/networks owned, operated and maintained by the National Water Supply and Drainage Board.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.829999923706055,
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      49.02,
      558.41,
      536.63,
      583.88
    ],
    "text": "Jeevan Thondaman, Minister of Water Supply and Estate Infrastructure Development.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      49.02,
      594.41,
      310.77,
      631.88
    ],
    "text": "Ministry of Water Supply and Estate Infrastructure Development,Battaramulla,16th of August, 2024.",
