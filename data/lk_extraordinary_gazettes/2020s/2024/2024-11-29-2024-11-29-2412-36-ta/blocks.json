  {
    "page_number": 0,
    "bbox": [
      50.9,
      448.95,
      539.93,
      647.08
    ],
    "text": "\u0bc8\u0b9f\u0bcd\u0b9f\u0b95\u0baa 1978 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 16 \u0b86\u0bae\u0bcd \u0b87\u0ba9\u0b95\u0bcd\u0bc8, \u0ba4\u0bb2\u0bcd\u0bc8\u0b95\u0ba9\u0b95\u0bcd\u0bc8\u0bab\u0bc8\u0b99\u0bcd\u0bc8\u0bb3\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba1\u0bbf\u0ba9\u0bcd 27(1) \u0b85 \u0ba4\u0bbf\u0bbe\u0bbf\u0bac\u0bbf\u0ba9\u0bcd \u0bc8\u0bc0\u0bb4\u0bcd \u0b8e\u0ba3\u0b95\u0bcd\u0b95\u0bc1\u0bbe\u0bbf\u0ba4\u0bcd\u0ba1\u0bbe\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f \u0ba1\u0ba4\u0bcd\u0ba4\u0bc1\u0bac\u0b99\u0bcd\u0bc8\u0baa\u0bbf\u0ba9\u0bcd \u0ba4\u0ba6\u0b95\u0ba3\u0b95\u0bcd \u0ba4\u0bc8\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1 \u0bc8\u0bb2\u0bcd\u0bac\u0bbf, \u0bac\u0bbf\u0b9e\u0bcd\u0b9e\u0bbe\u0ba3\u0bae\u0bcd \u0ba5\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0ba1\u0bbe\u0bab\u0bbf\u0ba9\u0bc1\u0b9f\u0bcd\u0ba4 \u0b85\u0b95\u0ba5\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0bb9\u0bbe\u0bbf\u0ba0\u0bbf \u0b85\u0ba5\u0ba7\u0b9a\u0bc2\u0bbe\u0bbf\u0ba6 \u0b86\u0bc8\u0bbf\u0ba6 \u0ba2\u0bbe\u0ba9\u0bcd, \u0ba4\u0bb2\u0bcd\u0bc8\u0b95\u0ba9\u0b95\u0bcd\u0bc8\u0bab\u0bc8 \u0ba5\u0bbe\u0ba3\u0bbf\u0ba6 \u0b86\u0b95\u0ba0\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1\u0bac\u0bbf\u0ba9\u0bcd \u0ba4\u0bbe\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1\u0b95\u0ba7\u0ba6\u0bbf\u0ba9\u0bcd \u0ba4\u0bbf\u0ba7\u0bc8\u0bbe\u0ba7\u0bae\u0bcd, \u0b9a\u0ba5\u0bb1\u0bcd\u0ba4\u0b9a\u0bbe\u0bb2\u0bcd\u0ba9\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba1\u0bbf\u0ba9\u0bcd 139 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbe\u0bbf\u0bac\u0bbf\u0ba9\u0bcd \u0b8f\u0bb1\u0bcd\u0ba4\u0bbe\u0b9f\u0bc1\u0bc8\u0baa\u0bbf\u0ba9\u0bcd \u0ba4\u0ba6\u0b95\u0ba3\u0b95\u0bcd \u0ba4\u0bc8\u0bbe\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0b9a\u0bbe\u0bb2\u0bcd\u0ba9\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba1\u0bbf\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbe\u0bbf\u0bac\u0bbf\u0ba9\u0bcd \u0bc8\u0bc0\u0bb4\u0bcd \u0ba1\u0bbe\u0ba4\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f \u0ba4\u0bb2\u0bcd\u0bc8\u0b95\u0ba9\u0b95\u0bcd\u0bc8\u0bab\u0bc8\u0ba4\u0ba5\u0bbe\u0ba9\u0bcd\u0ba8\u0bbe\u0bc8 \u0bc8\u0bb0\u0bc1\u0ba1\u0baa\u0bcd\u0ba4\u0b9f\u0bc1\u0bc8\u0bbf\u0ba9\u0bcd\u0ba8 \u0b87\u0ba9\u0b99\u0b95\u0bc8 \u0ba4\u0ba5\u0bbe\u0ba7\u0b9f\u0bcd\u0b9f\u0bc1\u0bac \u0ba4\u0bb2\u0bcd\u0bc8\u0b95\u0ba9\u0b95\u0bcd\u0bc8\u0bab\u0bc8\u0ba4\u0bcd\u0ba1\u0bbf\u0ba9\u0bcd \u0baa\u0bc0\u0b9f\u0b99\u0bcd\u0bc8\u0b95\u0baa\u0baf\u0bc1\u0bae\u0bcd \u0ba4\u0bc1\u0b95\u0ba8\u0bc8\u0b95\u0baa\u0baf\u0bc1\u0bae\u0bcd \u0b95\u0bc1\u0ba8\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0ba7\u0b95\u0bcd\u0bc8\u0bbf\u0ba9\u0bcd\u0ba8\u0ba4\u0bc1\u0bae\u0bcd (\u0bc8\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd\u0bc8\u0bbe\u0ba9\u0bae\u0bcd \u0ba1\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba1\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f\u0bac\u0bbe\u0ba8\u0bbe\u0ba3\u0ba4\u0bc1\u0bae\u0bcd) 2006 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0ba2\u0ba4\u0bac\u0bae\u0bcd\u0ba4\u0bb0\u0bcd \u0ba5\u0bbe\u0ba1\u0bae\u0bcd 03 \u0b86\u0ba8\u0bcd \u0ba1\u0bbf\u0bc8\u0ba1\u0bbf\u0ba6 1469/ 38 \u0b86\u0bae\u0bcd \u0b87\u0ba9\u0b95\u0bcd\u0bc8, \u0b85\u0ba1\u0bbf\u0bac\u0bbf\u0b9a\u0b9a\u0b9f \u0bac\u0bb0\u0bcd\u0ba4\u0bcd\u0ba1\u0ba5\u0bbe\u0ba3\u0bbf\u0ba6\u0bbf\u0bb2\u0bcd \u0ba4\u0bac\u0baa\u0bbf\u0ba6\u0bbf\u0b9f\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\u0ba5\u0bbe\u0ba3, \u0bc8\u0b9f\u0bcd\u0b9f\u0b95\u0baa\u0b95\u0bcd\u0bc8\u0bbe\u0ba3 \u0b85\u0b9f\u0bcd\u0b9f\u0bac\u0b95\u0ba0\u0ba6\u0bbf\u0ba9\u0bcd \u0b85\u0ba1\u0ba9\u0bcd \u0ba2\u0bbf\u0ba7\u0bb2\u0bcd I \u0b87\u0bb2\u0bcd \u0bc8\u0bbe\u0ba0\u0baa\u0bcd\u0ba4\u0b9f\u0bc1\u0bc8\u0bbf\u0ba9\u0bcd\u0ba8\u0ba4\u0bc1\u0bae\u0bcd, 2020 \u0ba4\u0ba4\u0baa\u0bcd\u0baa\u0bc1\u0bb0\u0bc1\u0bac\u0bbe\u0bbf 19 \u0b86\u0bae\u0bcd \u0ba1\u0bbf\u0bc8\u0ba1\u0bbf\u0ba6 2163/ 22 \u0b86\u0bae\u0bcd \u0b87\u0ba9\u0b95\u0bcd\u0bc8 \u0b85\u0ba1\u0bbf\u0bac\u0bbf\u0b9a\u0b9a\u0b9f \u0bac\u0bb0\u0bcd\u0ba4\u0bcd\u0ba1\u0ba5\u0bbe\u0ba3\u0bbf\u0ba6\u0bbf\u0bb2\u0bcd \u0ba4\u0bac\u0baa\u0bbf\u0ba6\u0bbf\u0b9f\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f \u0bc8\u0b9f\u0bcd\u0b9f\u0b95\u0baa\u0ba6\u0bbf\u0bb1\u0bcd \u0b95\u0bc1\u0ba8\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0ba7\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\u0ba5\u0bbe\u0ba3 \u2018\u2018\u0ba5\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bac \u0baa\u0bc0\u0b9f\u0bae\u0bcd\u201d \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0bac\u0bbf\u0b9f\u0ba6\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd \u0ba4\u0ba1\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bc1\u0ba4\u0b9f\u0bc1\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0b9f\u0bac\u0b95\u0ba0\u0b95\u0bcd\u0b95\u0bc1\u0bbe\u0bbf\u0ba6 \u0ba2\u0bbf\u0ba7\u0bb2\u0bcd II \u0b87\u0bb2\u0bcd \u0b9a\u0ba1\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bac\u0bbf\u0b9f\u0ba6 \u0b87\u0ba9\u0b95\u0bcd\u0bc8\u0bae\u0bcd \u2018\u201806. \u0b9a\u0bae\u0bc2\u0bc8 \u0ba5\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bac\u0bae\u0bcd \u0ba5\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bc1\u0b9f\u0bc1\u0bae\u0bcd\u0ba4 \u0ba5\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bac \u0ba1\u0bbf\u0b95\u0ba0\u0b95\u0bcd\u0bc8\u0baa\u0bae\u0bcd\u2019\u2019 \u0b8e\u0ba9\u0bcd\u0ba4\u0ba1\u0bb1\u0bcd\u0b95\u0bc1 \u0ba4\u0ba1\u0bbf\u0ba9\u0bbe\u0bc8 \u0ba4\u0bbf\u0ba9\u0bcd\u0bac\u0bb0\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b95\u0b9f \u0ba5\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bac\u0ba1\u0ba9\u0bcd \u0bae\u0bc2\u0ba9\u0bae\u0bcd : \u2018\u20186. \u0ba4\u0ba4\u0bbe\u0ba4\u0bc1\u0b9a\u0bcd \u0b9a\u0bc1\u0bc8\u0bbe\u0ba1\u0bbe\u0ba7\u0bae\u0bcd \u0ba5\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bc1\u0b9f\u0bc1\u0bae\u0bcd\u0ba4 \u0ba5\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bac \u0ba1\u0bbf\u0b95\u0ba0\u0b95\u0bcd\u0bc8\u0baa\u0bae\u0bcd\u201d",
