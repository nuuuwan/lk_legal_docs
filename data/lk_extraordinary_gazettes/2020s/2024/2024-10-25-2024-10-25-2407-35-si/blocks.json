    "text": "1992 \u0d85\u0d82\u0d9a 59 \u0daf\u0dbb\u0db1 \u0dc0\u0dad\u0dca\u0dad\u0dca\u0dbd \u0dba\u0dbb\u0ddd\u0d9c \u0db3\u0db1\u0dba\u0dad\u0dca \u0db3\u0dc2\u0db8\u0dd4 \u0dbd\u0db1 \u0d8b\u0db3 \u0dba\u0dda\u0d9b\u0db1\u0dba\u0dda \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0dc0\u0d82\u0dc0\u0dca\u0db3\u0dbb\u0dca\u0dbe\u0d9a \u0dba\u0dbb\u0ddd\u0d9c\u0dba\u0d9a\u0dca \u0dbd\u0db1 \u0d85\u0db4\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf\u0db1\u0dd4 \u0d9a\u0dbb\u0d9a\u0dbb \u0d8b \u0dba\u0dbb\u0ddd\u0d9c\u0dba (AFS) \u0dc0\u0dc1 2014 \u0da2\u0dd4\u0db1\u0dd2 \u0db8\u0dc0 17 \u0dbd\u0db1 \u0daf\u0dd2\u0db1 \u0dc1\u0dcf \u0d85\u0d82\u0d9a 1867/8 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dba\u0dbe\u0dda\u0dbf \u0d9c\u0dd0\u0dc0\u0da7\u0dca \u0db3\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0dbd\u0db1 \u0d85\u0dd2\u0da2\u0da2\u0dcf\u0db1\u0db1 \u0dc1\u0dcf \u0dbe\u0dca\u0dbd\u0dc0\u0db1 \u0dc0\u0dc1\u0dbc\u0d9a\u0dca\u0dbf \u0dba\u0dbb\u0ddd\u0d9c\u0dba ( PRRS) \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbc\u0d82\u0d9a\u0dcf\u0dbd \u0dad\u0dd4\u0dc2 \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba \u0dba \u0dba\u0dda\u0d9a \u0d9a \u0dba\u0d9a\u0dca\u0da7\u0dca\u0dc3\u0dcf\u0dc0\u0dbd\u0dbc \u0db3\u0dd0\u0dad\u0dd2 \u0dba \u0dba\u0db1 \u0db6\u0dd0\u0dc0\u0dd2\u0dca\u0dad \u0dc1\u0dcf \u0db3\u0dd0\u0dad\u0dd2\u0db8\u0da7\u0db8\u0da7 \u0da9 \u0d87\u0dad\u0dd2 \u0db6\u0dd0\u0dc0\u0dd2\u0dca\u0dad, \u0dc0\u0dad\u0dca\u0dad\u0dca\u0dbd \u0db1\u0dd2\u0dbf\u0dca\u0db3\u0dcf\u0daf\u0db1 \u0dc1\u0dcf \u0dba\u0dc0\u0dde\u0d9b\u0dba \u0d85\u0db0\u0dba\u0d9a\u0dca\u0dbf \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dda \u0d9a\u0dc0\u0dca\u0dad\u0dd4\u0db8\u0da7 \u0d86\u0dbb\u0dca\u0da0\u0dd2\u0d9c\u0dba \u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf \u0dba\u0dc1\u0dda\u0db8\u0dcf \u0d85 \u0d85\u0dba\u0db6\u0dca\u0dbb\u0dad\u0dca\u0db1 \u0dba\u0d9a\u0dca\u0dcf\u0dbc\u0dcf\u0dbd\u0dbc \u0dbd\u0db1 \u0db8\u0dcf \u0db8 \u0db3\u0db1\u0dba\u0dcf\