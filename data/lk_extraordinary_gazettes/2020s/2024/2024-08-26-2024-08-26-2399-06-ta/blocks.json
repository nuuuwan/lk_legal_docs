c0\u1f8c \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0b9f \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0b85\u1f92\u0bb0\u0bbe\u0ba4\u1f97\u0bb0\u0bae\u0bcd \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0bae\u0bbf\u0bb9\u0bbf\u0ba8\u0bcd\u0ba4\u0bc8\u0bb2 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b87\u0bb2. 572 - \u0bc7\u0bb9\u0bc7\u0ba9\u0bb5\u0ba4\u0bcd\u0ba4 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u0bb3\u0bcd \u0bc7\u0bb9\u0ba9\u0bb5\u0ba4\u0bcd\u0ba4 (\u0b85.\u0b95.\u0baa\u0bbf. \u0ba8\u0bb2\u0bcd\u0bb2\u0baa\u0bbe\u0bae\u0bcd\u1f97\u0b95\u0bc1\u0bb3\u0bae \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b85.\u0b95.\u0baa\u0bbf \u1f97\u1fa2\u0baf\u0ba9\u0bcd\u0b95\u0bc1\u0bb3\u0bae \u0baa\u0bbf\u0bbe\u0bbf\u1fab) \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3\u1f90\u0bae\u0bcd 110511 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bb2\u0bcd \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 01 \u0b87\u0bb2\u0bcd \u0b85\u0b9f\u0b99\u0bcd\u0b95\u0bbf\u1f9c\u0bb3\u0bcd\u0bb3\u1f90\u0bae\u0bbe\u0ba9 1 : 14, 1 : 15, 1 : 45, 1 : 46, 1 : 47, 1 : 48, 1 : 49, 1 : 50, 1 : 51, 1 : 52, 1 : 53, 1 : 54, 1 : 55, 1 : 56, 1 : 57, 1 : 58, 1 : 92, 1 : 93, 1 : 94, 1 : 95, 1 : 96, 1 : 98, 1 : 99 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 1 : 101 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bc8\u0bb3\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u1f90\u0ba3\u0bcd\u1f8c\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b8