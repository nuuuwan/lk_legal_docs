9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u02eb\u0db4\u0daf\u0dd2\u02ad\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u02f3\u0db8\u0dca \u0db4\u0db1\u02f3\u0dad\u0dca 55 \u0dc0\u02ec\u0db1\u0dd2 \u0dc0\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u02eb\u0dbb 202.00 022 \u0dc0\u02ec\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u02ad\u0d9a 2.4\u0db6222 \u0daf\u0dbb\u0db1 \u0d9c\u02ec\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u02f3\u024f \u0dba\u0dae\u0db8\u02eb \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db4\u0dc5\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0daf\u02ec\u0dca\u0dad\u0dc0\u0dd3\u02f3\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0dca\u0dad \u02f3\u0d9a\u02a3\u0da7 \u0d87\u0dad\u0dca\u0dad\u02eb \u0dc0\u0dd6 \u0daf, \u0d89\u0da9\u0db8\u0dca \u02f3\u0d9a\u02a3\u0da7\u0dc3\u02ea\u0dc0\u0dbd \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0db6\u0dca\u0dad \u02f3\u0dba\u0dca\u0dad \u02f3\u0db8\u0dc4\u0dd2 \u0d8b\u0db4\u02f3\u0dbd\u0dca\u0d9b\u0db1\u02f3\u024f \u0daf\u02ec\u0d9a\u0dca\u0d9a\u0dba\u02f3\u0dc0\u0db1 \u0db8\u02eb\u02f3\u0118 \u0dad\u0dd3\u0dbb\u0dab 199 \u0d85\u02ad\u0d9a 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u02eb\u0db4\u0daf\u0dd2\u02ad\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u02f3\u0db8\u0dca \u0db4\u0db1\u02f3\u0dad\u0dca 14 \u0dc0\u02ec\u0db1\u0dd2 \u0dc0\u0d9c\u0dca\u0dad\u0dad\u0dd2\u02f3\u0dba\u0dca\u0dad \u0db4\u0dc4\u0dad \u0d85\u0dad\u0dca\u0dc3\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0db8\u02eb \u02f3\u0dc0\u0dad \u0db4\u0dc0\u0dbb\u02eb \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u02eb\u0dbb, \u0db8\u0db8 \u02f3\u0db8\u0dba\u0dd2\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0d9a\u02eb \u0d9a\u0dbb\u0db8\u0dd20 \u0db4\u0dd3. \u0dc3\u0dd3. \u0da9\u0dd3. \u0dc3\u0dd2\u02f3\u0118\u0dbb\u02eb, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u02f3\u0db8\u0dca \u02f3\u0d9a\u02a3\u0db8\u0dc3\u02eb\u0dbb\u0dd2\u0dc3\u