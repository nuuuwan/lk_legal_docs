32\u0bb2\u0bcd, \u0baa\u0732\u0731\u0732\u0bb5\u0bc1 \u0b87\u0bb2. 08 \u0b87\u0bb2\u0bcd 58 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0736\u0ba4\u0731\u0b9f\u0bb0\u0bcd\u0baa\u0731\u0b95 \u0b85\u0bb5\u0bcd\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0738\u0ba3\u0baf\u0732\u0bb2\u0bcd, \u201c\u0b95\u0731\u0ba3\u0732 \u0bb5\u0bb4\u0b95\u0bcd\u0b95\u0732\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b88\u0b9f\u0bc1 \u0b95\u0bc1\u0ba4\u0bcd\u0ba4\u0738\u0b95 \u0ba4\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0738\u0bb3 \u0baa\u0bb1\u0bcd\u0bb1\u0732\u0baf \u0bb5\u0732\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd\u201d \u0b8e\u0ba9\u0bcd\u0bb1 \u0723\u0732\u0bb0\u0bb2\u0bbf\u0bb2\u0bcd \u201c 510822/09/114 \u0b85\u0ba3\u0bc1\u0b95\u0bc1\u0bb5\u0bb4\u0732 \u0737\u0b9a\u0bb5\u0b95\u0ba4\u0bcd\u0ba4\u0732\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\u201d \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0723\u0733\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u201c510822/08/29 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 510812/09/44 \u0b87\u0ba9\u0bcd \u0b85\u0ba3\u0bc1\u0b95\u0bc1\u0bb5\u0bb4\u0732 \u0737\u0b9a\u0bb5\u0b95\u0ba4\u0bcd\u0ba4\u0732\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\u201d \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b89\u0bb3\u0bcd\u0bb3\u0b9f\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0ba4\u0732\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bb2\u0bcd \u0737\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd. \u0baa\u0bc0.\u0b9a\u0733.\u0b9f\u0bc0.\u0b9a\u0732\u0737\u0b95\u0bb0\u0731, \u0b95\u0731\u0ba3\u0732 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0723\u0732\u0bb0\u0bcd\u0ba3\u0baf \u0b86\u0738\u0ba3\u0baf\u0731\u0bb3\u0bb0\u0bcd \u0723\u0731\u0baf\u0b95\u0bae\u0bcd.",
