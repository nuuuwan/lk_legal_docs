    "text": "\u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u0ddc\u0dd9\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0db1 \u0d89\u0da9\u0dd9\u0db8\u0dca / \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dd9\u0dc0\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba :",
