    "text": "\u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dd9\u0dad\u0dca, \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca, \u0d9a\u0dbd\u0dc0\u0dcf\u0db1 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca, \u0d9a\u0dd4\u0d9a\u0dd4\u0dc5\u0dd4 \u0dd9\u0d9a\u0ddd\u0dbb\u0dbd\u0dd9\u0dba\u0dca, \u0d8b\u0da9 \u0db4\u0dad\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca \u0dc3\u0dd4\u0dc5\u0dd4 \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca \u0d9c\u0d9c\u0dbd\u0d9c\u0db8\u0dd4\u0dc0 \u0d9c\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0dd9\u0db8\u0dca \u0d9c\u0d9c\u0dbd\u0d9c\u0db8\u0dd4\u0dc0 \u0d9c\u0dd9\u0db8\u0dca \u0d8b\u0da9\u0dd9\u0daf\u0db1\u0dd2\u0dba\u0dd9\u0dc4\u0dda\u0db1, \u0db4\u0db1\u0dca\u0dc0\u0dd2\u0dd9\u0dbd\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db1\u0dcf\u0dc0\u0dd2\u0db1\u0dca\u0db1\u0dd9\u0dc4\u0dda\u0db1, \u0db4\u0dd0\u0dc5\u0dd4\u0db8\u0dca\u0d9c\u0dbd\u0d9c\u0dcf\u0dc0\u0dd9\u0dc4\u0dda\u0db1, \u0d9c\u0dbd\u0dca\u0d92\u0daf\u0dab\u0dca\u0da9\u0dd9\u0daf\u0ddc\u0dd9\u0dbd\u0dca\u0dd9\u0dc4\u0dda\u0db1 \u0db1\u0dd0\u0db8\u0dad\u0dd2 \u0d89\u0da9\u0db8. \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0dd9\u0db8\u0dca \u0d85\u0d82\u0d9a\u0dba : \u0d85.\u0d9c.\u0db4\u0dd2. 948 \u0dc4\u0dd2 \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dbd\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dad\u0dd4 \u0db4\u0dd2\u0da7\u0dd4 \u0d85\u0d82\u0d9a 154\u0dc4\u0dd2 \u0d85\u0dad\u0dd2\u0dd9\u0dbb\u0dca\u0d9a \u0d85\u0d82\u0d9a 06 \u0dc4\u0dd2 \u0db4\u0dad \u0d85\u0d82\u0d9a 07 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1226 \u0dc4\u0dd2 \u0db4\u0db8\u0dcf\u0dab\u0dd9\u0dba\u0db1\u0dca \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 1.8450 \u0db4\u0db8\u0dab \u0dc0\u0dd6 \u0d85\u0d9a\u0dca\u0d9a\u0dbb 4 \u0dbb\u0dd6\u0da9\u0dca 02 \u0db4\u0dbb\u0dca\u0da0\u0dc3\u0dca 9.5 \u0dc0\u0db1 \u0d89\u0da9\u0db8\u0da7 \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca, 01. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1226 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0db1\u0dcf\u0dc0\u0dd2\u0db1\u0dca\u0db1\u0dd9\u0dc4\u0dda\u0db1; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0d85\u0d9a\u0dca\u0d9a\u0dbb 04 \u0dbb\u0dd6\u0da9\u0dca 02 \u0db4\u0dbb\u0dca\u0da0\u0dc3\u0dca 9.5 \u0d9a\u0dca \u0db4\u0db8\u0dab. \u0d8b\u0dad\u0dd4\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 857 \u0dc3\u0dc4 869, \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 869 \u0dc3\u0dc4 873 2/2, \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 873 2/2 \u0dc3\u0dc4 869, \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 869 \u0dc3\u0dc4 857. \u0dd9\u0db4\u0ddc\u0daf\u0dd4\u0da2\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0dad : \u0dc3\u0dd2\u0d82\u0dc4\u0dbb\u0dcf\u0da2 \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb\u0dba \u0dc3\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dab\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8.",
