    "text": "\u0dd9\u0db8\u0db8 \u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0d9c\u0dba \u0d85\u0db1\u0dd4\u0db6\u0daf\u0dca\u0db0\u0dd2\u0dad \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dd9\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dd9\u0d9c\u0dca \u0db4\u0d9a\u0dcf\u0dc1\u0db1\u0dd9\u0dba\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 - \u0db4\u0dd3.\u0da2\u0dd3. \u0dc3\u0dd4\u0dc3\u0db1\u0dca\u0dad \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0db8\u0dba\u0dcf, \u0d85\u0d82\u0d9a 355/1, \u0dc0\u0d9a\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd \u0db4\u0dcf\u0dbb, \u0dc4\u0db4\u0dd4\u0d9c\u0dbd, \u0d9c\u0dcf\u0dbd\u0dca\u0dbd. \u0dc3\u0dc4 \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba, \u0d85\u0d82\u0d9a 19, \u0db4\u0dc4\u0dc5 \u0da9\u0dd2\u0d9a\u0dca\u0dc3\u0db1\u0dca \u0db4\u0dcf\u0dbb, \u0d9c\u0dcf\u0dbd\u0dca\u0dbd. \u0d85\u0dad\u0dbb \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dcf\u0dc0\u0dd4\u0dbd\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dd9\u0dc4\u0dba\u0dd2\u0db1\u0dca \u0daf, \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab, \u0dbb\u0dcf\u0da2\u0255 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1, \u0dc3\u0dca\u0dc0\u0dd9\u0daf\u0dca\u0dc1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4, \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf, \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0dc3\u0dc4 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0255 \u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba \u0dc4\u0dbb\u0dd2\u0db1\u0dd2 \u0d85\u0db8\u0dbb\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0dc0\u0db1 \u0db8\u0db8 1957 \u0d85\u0d82\u0d9a 14 \u0dc4\u0dcf 1957 \u0d85\u0d82\u0d9a 62 \u0dc4\u0dcf 1962 \u0d85\u0d82\u0d9a 4 \u0dc4\u0dcf 1968 \u0d85\u0d