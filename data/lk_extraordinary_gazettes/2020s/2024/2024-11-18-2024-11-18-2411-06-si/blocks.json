    "text": "\u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0dc0\u0dca \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0db4\u0dd2\u0dad \u0d85\u0dab\u0db4\u0db1\u0dad\u0dca\u0dc0\u0dbd 131 \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0da0\u0dca\u0dd9\u0da1\u0dca\u0daf\u0dba (1956 \u0db4\u0dad\u0dd2\u0dd9\u0dc1\u0ddd\u0db0\u0dd2\u0dad \u0db8\u0dd4\u0daf\u0dab\u0dba) \u0dc0\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dcf\u0dc0\u0dd4\u0dbd\u0dca \u0db4\u0db1\u0dd9\u0dad\u0dca 4(1) \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0d9c\u0dba",
