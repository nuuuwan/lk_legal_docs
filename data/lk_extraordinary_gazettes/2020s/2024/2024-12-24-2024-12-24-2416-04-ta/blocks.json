    "text": "\u0b85\u0ba7\u0b9a\u0bbf\u0ba6\u0ba9\u0b95\u0ba5\u0baa\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 44 \u0b86\u0bac\u0ba4\u0bc1 \u0b89\u0baf\u0bc5\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0ba7\u0ba6\u0bbf\u0ba9\u0bcd (2) \u0b86\u0bac\u0ba4\u0bc1 \u0ba4\u0ba8\u0bcd\u0ba1\u0bbf\u0baf\u0bc1\u0b9f\u0ba9\u0bcd \u0b9a\u0b9a\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1 \u0bac\u0bbe\u0b9a\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0ba4\u0b9f\u0bc1\u0bae\u0bcd \u0ba4\u0ba1\u0bbf\u0bb5\u0bc1\u0b9a\u0b9a\u0baf\u0bcd\u0ba6\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f \u0ba4\u0b99\u0bcd\u0b95\u0bc1 \u0ba5\u0bb1\u0bcd\u0baf\u0bc5\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba0\u0ba6\u0b99\u0bcd\u0bc8\u0bb3\u0bcd \u0bc8\u0b9f\u0bcd\u0b9f\u0b95\u0baa\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba1\u0bbf\u0ba9\u0bcd (\u0b85\u0ba4\u0bcd\u0ba1\u0bbf\u0ba6\u0bbe\u0ba6\u0bae\u0bcd 420) \u0ba4\u0bbf\u0bbe\u0bbf\u0bb5\u0bc1 2, \u0ba4\u0bbf\u0bbe\u0bbf\u0bb5\u0bc1 5 \u0ba5\u0bb1\u0bcd\u0baf\u0bc5\u0bae\u0bcd \u0ba4\u0bbf\u0bbe\u0bbf\u0bb5\u0bc1 21\u0b87 \u0b89\u0b9f\u0ba9\u0bcd \u0bac\u0bbe\u0b9a\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0ba4\u0b9f\u0bc1\u0bae\u0bcd \u0ba4\u0bbf\u0bbe\u0bbf\u0bb5\u0bc1 55 \u0b87\u0ba9\u0bcd \u0bc8\u0bc0\u0bb4\u0bcd \u0b87\u0ba9\u0b99\u0bcd\u0b95\u0bc8\u0b9a\u0bcd \u0b9a\u0ba3\u0ba2\u0bbe\u0ba6\u0bc8 \u0b9a\u0b9a\u0bbe\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0ba6\u0ba7\u0b9a\u0bbf\u0ba9\u0bcd \u0b9a\u0ba3\u0bbe\u0ba1\u0bbf\u0ba4\u0ba1\u0bbf\u0ba6\u0bbf\u0ba3\u0bbe\u0bb2\u0bcd \u0b89\u0baf\u0bc3\u0bac\u0bbe\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f \u0b91\u0bb3\u0bc3\u0b99\u0bcd\u0b95\u0bc1\u0bac\u0bbf\u0ba1\u0bbf\u0bc8\u0bb3\u0bcd. \u0b85\u0ba8\u0bc1\u0ba7 \u0b95\u0bc1\u0ba5\u0bbe\u0ba7 \u0ba1\u0bbf\u0b9a\u0bbe\u0ba2\u0bbe\u0ba6\u0b95\u0bcd\u0bc8, \u0b9a\u0ba3\u0bbe\u0ba1\u0bbf\u0ba4\u0ba1\u0bbf. \u0b9a\u0bc8\u0bbe\u0bb3\u0bc3\u0bae\u0bcd\u0baa\u0bc1, 2024, \u0ba1\u0bbf\u0b9a\u0b9a\u0bae\u0bcd\u0ba4\u0bb0\u0bcd 24. 2024, \u0b92\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1 21 \u0b86\u0ba8\u0bcd \u0ba1\u0bbf\u0bc8\u0ba1\u0bbf \u0ba2\u0b95\u0b9f\u0b9a\u0ba4\u0bb1\u0bcd\u0ba8 MF/PE/017/CM/2024/222 \u0b86\u0bae\u0bcd \u0b87\u0ba9\u0b95\u0bcd\u0bc8 \u0b85\u0b95\u0ba5\u0b9a\u0bcd\u0b9a\u0ba7\u0b95\u0bac\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba1\u0bbf\u0bb2\u0bcd, \u0b87\u0ba9\u0b99\u0bcd\u0b95\u0bc8 \u0b9a\u0ba4\u0bb1\u0bcd\u0b9a\u0ba8\u0bbe\u0bb2\u0bbf\u0ba6\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd\u0ba1\u0bbe\u0ba4\u0ba3\u0ba4\u0bcd\u0ba1\u0bbf\u0ba9\u0bcd 2022.12.31 \u0b87\u0ba9\u0bcd \u0ba4\u0b9f\u0bbf \u0ba5\u0bbe\u0bb1\u0bcd\u0ba8\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f \u0bc8\u0b9f\u0ba9\u0bcd \u0ba5\u0bc0\u0ba1\u0bbf\u0ba6\u0bbf\u0ba9\u0bcd \u0b9a\u0bbe\u0bb0\u0bcd\u0ba4\u0bbe\u0bc8 \u0b87\u0ba9\u0b99\u0bcd\u0b95\u0bc8 \u0baf\u0bc4\u0ba4\u0bbe \u0bc8\u0b9f\u0ba9\u0bcd \u0ba1\u0bc0\u0bb0\u0bcd\u0bb5\u0bc1 \u0ba1\u0bbf\u0bc8\u0ba1\u0bbf\u0ba6\u0bbf\u0bb2\u0bcd, \u0ba1\u0bb1\u0bcd\u0b9a\u0ba4\u0bbe\u0b95\u0ba1\u0ba6 \u0bc8\u0b9f\u0ba9\u0bcd \u0bac\u0b9a\u0ba1\u0bbf\u0ba6\u0bbf\u0ba9\u0bcd \u0bc8\u0bc0\u0bb4\u0bcd \u0ba2\u0bbf\u0bb2\u0bc1\u0b95\u0bac\u0ba6\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0baa \u0b87\u0ba9\u0b99\u0bcd\u0b95\u0bc8 \u0baf\u0bc4\u0ba4\u0bbe \u0bae\u0bc2\u0ba9\u0ba1\u0ba3\u0ba4\u0bcd \u0b9a\u0ba1\u0bbe\u0b95\u0bc8 \u0ba5\u0bb1\u0bcd\u0baf\u0bc5\u0bae\u0bcd \u0b9a\u0b9a\u0bb2\u0bc1\u0ba4\u0bcd\u0ba1 \u0b9a\u0bac\u0ba3\u0bcd\u0b9f\u0bbf\u0ba6 \u0bac\u0b9f\u0bcd\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba8\u0bcd\u0b95\u0ba1\u0ba6 \u0b87\u0ba9\u0b99\u0bcd\u0b95\u0bc8 \u0baf\u0bc4\u0ba4\u0bbe \u0bae\u0bc2\u0ba9\u0ba1\u0ba3\u0bae\u0bcd \u0b89\u0b9f\u0bcd\u0ba4\u0b9f 2026, 2028, 2030, 2032 \u0ba5\u0bb1\u0bcd\u0baf\u0bc5\u0bae\u0bcd 2034 \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0bc8\u0baa\u0bbf\u0bb2\u0bcd \u0ba5\u0b95\u0bcd\u0bc8\u0bb3\u0bcd \u0bac\u0b99\u0bcd\u0bc8\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0b9a\u0ba5\u0bbe\u0ba4\u0bcd\u0ba1\u0bae\u0bcd \u0baf\u0bc4\u0ba4\u0bbe 262,582,862,854.00 \u0bae\u0bc1\u0ba1\u0bbf\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0ba6\u0b95\u0b9f\u0baf\u0bc1\u0bae\u0bcd 5 \u0baa\u0bc1\u0ba1\u0bbf\u0ba6 \u0ba1\u0bbf\u0b95\u0ba8\u0b9a\u0b9a\u0bbe\u0bbf \u0bae\u0bc1\u0ba8\u0bbf \u0b9a\u0bbe\u0ba1\u0ba3\u0b99\u0bcd\u0bc8\u0b95\u0baa \u0b9a\u0bac\u0baa\u0bbf\u0ba6\u0bbf\u0b9f\u0bc1\u0bac\u0ba1\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0b99\u0bcd\u0bc8\u0bc0\u0bc8\u0bbe\u0ba7\u0bae\u0bcd \u0bac\u0bab\u0b99\u0bcd\u0bc8\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1. 1937 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 7 \u0b86\u0bae\u0bcd \u0b87\u0ba9\u0b95\u0bcd\u0bc8 \u0ba4\u0ba1\u0bbf\u0bb5\u0bc1\u0b9a\u0b9a\u0baf\u0bcd\u0ba6\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f \u0ba4\u0b99\u0bcd\u0b95\u0bc1\u0bc8\u0bb3\u0bcd \u0ba5\u0bb1\u0bcd\u0baf\u0bc5\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba0\u0ba6\u0b99\u0bcd\u0bc8\u0bb3\u0bcd \u0bc8\u0b9f\u0bcd\u0b9f\u0b95\u0baa\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba1\u0bbf\u0ba9\u0bcd \u0ba4\u0bbf\u0bbe\u0bbf\u0bb5\u0bc1 2, \u0ba4\u0bbf\u0bbe\u0bbf\u0bb5\u0bc1 5 \u0ba5\u0bb1\u0bcd\u0baf\u0bc5\u0bae\u0bcd \u0ba4\u0bbf\u0bbe\u0bbf\u0bb5\u0bc1 21\u0b87 \u0b89\u0b9f\u0ba9\u0bcd \u0bac\u0bbe\u0b9a\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0ba4\u0bbf\u0bbe\u0bbf\u0bb5\u0bc1 55 \u0b87\u0ba9\u0bcd \u0bc8\u0bc0\u0bb4\u0bcd \u0b8e\u0ba3\u0b95\u0bcd\u0b95\u0bc1 \u0bac\u0bab\u0b99\u0bcd\u0bc8\u0baa\u0bcd\u0ba4\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0baa \u0b85\u0ba1\u0bbf\u0bc8\u0bbe\u0ba7\u0b99\u0bcd\u0bc8\u0baa\u0bbf\u0ba9\u0bcd \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0ba4\u0b95\u0b9f\u0ba6\u0bbf\u0bb2\u0bcd, \u0ba2\u0bbf\u0ba1\u0bbf, \u0ba1\u0bbf\u0b9f\u0bcd\u0b9f\u0ba5\u0bbf\u0b9f\u0bb2\u0bcd \u0ba5\u0bb1\u0bcd\u0baf\u0bc5\u0bae\u0bcd \u0b9a\u0ba4\u0bbe\u0baf\u0bc3\u0baa\u0bbe\u0ba1\u0bbe\u0ba7 \u0b85\u0ba4\u0bbf\u0bac\u0bbf\u0baf\u0bc3\u0ba4\u0bcd\u0ba1\u0bbf \u0b85\u0b95\u0ba5\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b85\u0ba8\u0bc1\u0ba7 \u0b95\u0bc1\u0ba5\u0bbe\u0ba7 \u0ba1\u0bbf\u0b9a\u0bbe\u0ba2\u0bbe\u0ba6\u0b95\u