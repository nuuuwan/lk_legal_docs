    "bbox": [
      47.99,
      458.52,
      542.47,
      531.66
    ],
    "text": "I, Harin Fernando, the Minister of Sports and Youth Affairs, temporarily suspend the registration of the National Association/ Federation of Sports for the below-mentioned Sports by virtue of the power vested in me under the Section 32 and 33 of the Sports Law, No. 25 of 1973 and its amendments, and hereby appoint Professor (Rear Admiral) Shemal Fernando, the Director General of the Department of Sports Development, as the competent authority with effect from 29th May, 2024 as a temporary mechanism to proceed with administrative and other required activities of the said National Association/ Federation of Sports and to call and conduct relevant elections as well as to perform the duties appropriately until then.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
