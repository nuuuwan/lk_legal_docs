d4\u0dc0 _ 47, \u0dbb\u0da2\u0dc3\u0dd2\u0dbb\u0dd2\u0dbd, \u0db6\u0d9a\u0dca\u0db8\u0dd3\u0dd9\u0d9c\u0ddc\u0dbd\u0dca\u0dbd, \u0d85\u0db0\u0dd2\u0dd9\u0dc1\u0dda\u0dab\u0dd2\u0dd9\u0dba\u0dca \u0d89\u0db6\u0dca\u0db6\u0dcf\u0d9c\u0db8\u0dd4\u0dc0 \u0d85\u0d82\u0d9a.2785 \u0dc4\u0dcf 2006.04.17 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 (\u0db4.\u0dd9\u0db1\u0ddc. \u0dc3\u0dd3.\u0dc3\u0dd3.\u0dc0\u0dd2\u0dd9\u0da2\u0dca\u0dbb\u0dad\u0dca\u0db1) 421861/03//19 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0dba\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0. 1:25 0.0458 \u0dc0\u0dbd\u0dd2\u0db8\u0dd2\u0db1\u0dd2 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dad\u0db8\u0dbb\u0dcf \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2 197881402439 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba 421861/03/19 \u0dc4\u0dcf _ \u0dc3\u0dd2\u0dbb\u0dd2\u0dba\u0dbd\u0dad\u0dcf 50 \u0db8\u0dcf\u0dbb\u0dca\u0d9c 6 \u0db4\u0da7\u0dd4\u0db8\u0d9c, \u0dbb\u0da2\u0dc3\u0dd2\u0dbb\u0dd2\u0dbd, \u0db6\u0d9a\u0dca\u0db8\u0dd3\u0dd9\u0d9c\u0ddc\u0dbd\u0dca\u0dbd, \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0dba\u0da7 \u0d89\u0db6\u0dca\u0db6\u0dcf\u0d9c\u0db8\u0dd4\u0dc0 \u0dba\u0da7\u0dad\u0dca\u0dc0. 1:35 0.0384 \u0dd9\u0dad\u0db1\u0dca\u0db1\u0dd9\u0d9a\u0ddd\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca 666800265V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba 421861/03/30 , 50 _ \u0db1\u0db1\u0dca\u0daf\u0dcf\u0dc0\u0dad\u0dd3 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2\u0dc4\u0dcf\u0db8\u0dd2 \u0dc4\u0dcf 71 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0d82\u0d9a 603, \u0d9a\u0dab\u0dca\u0da9\u0dbd\u0db8, \u0daf\u0db9\u0dd4\u0dbd\u0dca\u0dbd. \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0dba\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0. 1:36 0.0379 \u0d9a\u0db1\u0dca\u0d9a\u0dcf\u0db1\u0db8\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0da0\u0dcf\u0db1\u0dca\u0daf\u0dd2\u0db8\u0dcf \u0daf\u0dd3\u0db4\u0dca\u0dad\u0dd2\u0db8\u0dad\u0dd3 197566201769 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba 421861/03/30, 50 _ \u0db6\u0db1\u0dca\u0da9\u0dcf\u0dbb \u0dc4\u0dcf 71 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0d82\u0d9a 44, \u0dc4\u0dad\u0dca\u0dc0\u0db1 \u0db4\u0da7\u0dd4\u0db8\u0d9c, \u0dbb\u0da2\u0dc3\u0dd2\u0dbb\u0dd2\u0dbd, \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0da7 \u0db6\u0d9a\u0dca\u0db8\u0dd3\u0dd9\u0d9c\u0ddc\u0dbd\u0dca\u0dbd, \u0d89\u0db6\u0dca\u0db6\u0dcf\u0d9c\u0db8\u0dd4\u0dc0 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0db8\u0dc4\u0da2\u0db1 \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0 \u0d85\u0d82\u0d9a. 16051 \u0dc4\u0dcf 2020.10.26 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 (\u0db4.\u0dd9\u0db1\u0ddc. ) \u0dd9\u0d9a\u0dca \u0d85\u0dad\u0dca\u0dad\u0db1\u0dcf\u0dba\u0d9a 1:37 0.0406 \u0dc4\u0dbd\u0dca\u0dd9\u0d9a\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d89\u0db1\u0dca\u0daf\u0dd4\u0d9a \u0d9a\u0dd4\u0db8\u0dcf\u0dbb 701050258V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba 421861/03/30, 50 _ \u0dc3\u0db8\u0dbb\u0db1\u0dcf\u0dba\u0d9a \u0dc4\u0dcf 71 \u0dd9\u0db1\u0ddc.44, \u0dc4\u0dad\u0dca\u0dc0\u0db1 \u0db4\u0da7\u0dd4\u0db8\u0d9c, \u0dbb\u0da2\u0dc3\u0dd2\u0dbb\u0dd2\u0dbd, \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0dba\u0da7 \u0db6\u0d9a\u0dca\u0db8\u0dd3\u0dd9\u0d9c\u0ddc\u0dbd\u0dca\u0dbd, \u0d89\u0db6\u0dca\u0db6\u0dcf\u0d9c\u0db8\u0dd4\u0dc0 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0db8\u0dc4\u0da2\u0db1 \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0 \u0d85\u0d82\u0d9a. 2170 \u0dc4\u0dcf 2007.03.01 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0db4.\u0dd9\u0db1\u0ddc. \u0daf\u0dba\u0dcf\u0db1\u0dd2 \u0dd9\u0db4\u0dd9\u0dbb\u0dca\u0dbb\u0dcf 1:46 0.0380 \u0d85\u0dad\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0daf\u0dbb\u0dca\u0dc1\u0dd2\u0d9a\u0dcf 847802006V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba 421861/03/30, 50 _ \u0dc0\u0dd9\u0dba\u0ddd\u0db8\u0dd2 \u0d85\u0dad\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0dc4\u0dcf 71 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dd9\u0db1\u0ddc.10, \u0dc3\u0db1\u0dca\u0dbd\u0dd2\u0da7\u0dca \u0dc0\u0dad\u0dca\u0dad, \u0dd9\u0dad\u0ddd\u0dbb\u0dba\u0dcf\u0dba. \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf\u0dc0\u0dba 1:52 0.0382 \u0dbb\u0dcf\u0da2\u0d9c\u0dd4\u0dbb\u0dd4 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca 665907651V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba 421861/03/30 , 50 _ \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb\u0db8\u0dd0\u0dab\u0dd2\u0dd9\u0d9a\u0dca \u0dc4\u0dcf 71 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dad\u0dbd\u0dca\u0db4\u0dad\u0dca\u0dc0\u0dd0\u0dc0, \u0dd9\u0db4\u0ddc\u0dbd\u0dca\u0db4\u0dd2\u0dad\u0dd2\u0d9c\u0db8. \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf\u0dc0\u0dba EOG 11-0098/2",
