      536.13,
      540.53,
      549.27
    ],
    "text": "1. This Rule may be cited as the Practice of Electrician and Registration of Qualified Electricians as Engineering Technicians.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
