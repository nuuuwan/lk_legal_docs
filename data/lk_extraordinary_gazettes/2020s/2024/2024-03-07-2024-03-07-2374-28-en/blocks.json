      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      49.03,
      649.13,
      322.78,
      673.27
    ],
    "text": "-National Vocational Qualification (NVQ) Level 4 certification -Registration with the Engineering Council, Sri Lanka.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      49.03,
      682.13,
      543.12,
      706.27
    ],
