  },
  {
    "page_number": 0,
    "bbox": [
      50.82,
      633.59,
      286.59,
      704.64
    ],
    "text": "Allotment of land of Lot No. 1, Extent of about 0.0106 Hectare, depicted in Preliminary Plan No. 3701, situated in the Village of Bulathkohupitiya in the Grama Niladhari Division of No. 129 B, Bulathkohupitiya in the Divisional Secretary\u2019s Division of Bulathkohupitiya in Kegalle District.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      1.0199999809265137,
      6.0,
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.5,
      443.86,
      539.96,
      603.85
    ],
    "text": "01. Lot No. 1 Name of the Land: Giniwalapitiya Watta; Claimant: State; Original Claimant : M. R. Gunawardhana; Extent: 0.0106 Hectare. All person interested in the aforesaid land are hereby required to appear personally or by agent duly authorized in writing, before me at Divisional Secretariat of Bulathkohupitiya on the 29th of May 2024 at 10.00 a.m. andare hereby requested to notify to me in writing on or before the 20th of May 2024, the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land, the amount of compensation and the details of the compution of such amount.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
