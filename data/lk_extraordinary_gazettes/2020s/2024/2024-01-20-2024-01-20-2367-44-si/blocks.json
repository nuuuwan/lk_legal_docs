    "text": "\u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc5\u0dcf\u0dd9\u0dad\u0dca \u0db8\u0db1\u0dca\u0db1\u0dcf\u0dbb\u0db8 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca \u0db8\u0dcf\u0db1\u0dca\u0dd9\u0dad\u0dba\u0dd2 (\u0d91\u0dc0\u0d9a\u0da7 \u0db8\u0dcf\u0db1\u0dca\u0dd9\u0dad\u0dba\u0dd2 \u0db6\u0dc3\u0dca\u0db1\u0dcf\u0dc4\u0dd2\u0dbb) \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc1\u0dd9\u0dba\u0dca \u0daf\u0dd0\u0db1\u0da7 \u0db8\u0da9\u0dd4 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc1\u0dd9\u0dba\u0dca \u0d89\u0dbb\u0dcf\u0dd9\u0db1\u0dba\u0dd2 \u0d89\u0dbd\u0dd4\u0db4\u0dca\u0dd9\u0db4\u0dba\u0dd2\u0d9a\u0dd4\u0dbd\u0db8\u0dca \u0d9c\u0dcf\u0db8 \u0dd9\u0dc3\u0dda\u0dc0\u0dcf \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc1\u0dd9\u0dba\u0dca \u0db4\u0db1\u0dca\u0da9\u0dcf\u0dbb \u0d89\u0dbd\u0dd4\u0db4\u0dca\u0dd9\u0db4\u0dba\u0dd2\u0d9a\u0dd4\u0dbd\u0db8\u0dca \u0db1\u0dd0\u0db8\u0dad\u0dd2 \u0d9c\u0dd9\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0d9a \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dcf \u0dad\u0dd2\u0dd9\u0db6\u0db1 \u0d85\u0d82\u0d9a 45 (\u0d8b\u0dad\u0dd4\u0dbb) \u0daf\u0dbb\u0dab \u0dbd\u0d82\u0d9a\u0dcf \u0db8\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0db7\u0dd6 \u0dbd\u0d9a\u0dca\u0dc2\u0dab\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0db8\u0dd4\u0dbd\u0dd2\u0d9a \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0dd9\u0db8\u0dca \u0d85\u0d82\u0d9a 66, 67, 68 \u0dc3\u0dc4 71 \u0dba\u0db1 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0da7\u0dca\u0da7\u0dd2 \u0dc0\u0dc1\u0dd9\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dd9\u0d9a\u0ddc\u0da7 \u0daf\u0dd0\u0d9a\u0dca\u0dd9\u0dc0\u0db1 \u0d89\u0da9\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd9\u0dba\u0db1\u0dca \u0d89\u0da9\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0d86\u0da5\u0dcf \u0db4\u0db1\u0dd9\u0dad\u0dca 4 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0daf\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0d9a\u0dca 1980 \u0dc3\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 19 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d9a 107 \u0daf\u0dbb\u0dab \u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dd9\u0dba\u0dca (\u0d85\u0d82\u0d9a 4945 (\u0db8\u0db1\u0dca\u0db1\u0dcf\u0dbb\u0db8) \u0daf\u0dbb\u0dab \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0daf\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0db6\u0dbd\u0db1\u0dd4.) \u0dc3\u0dc4 \u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dd9\u0dba\u0db1\u0dca \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad \u0d85\u0db1\u0dca \u0d85\u0dba\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0daf \u0db1\u0dd2\u0dc3\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db4 \u0dc3\u0dd2\u0daf\u0dca\u0db0 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd6 \u0dd9\u0dc4\u0dba\u0dd2\u0db1\u0dca \u0daf : \u0d91\u0dd9\u0dc3\u0dda\u0db8 \u0d91\u0d9a\u0dd3 \u0daf\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0d85\u0db1\u0dd4\u0dc0 \u0db7\u0dcf\u0dbb\u0d9c\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd6 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d91\u0d9a\u0dd3 \u0d86\u0da5\u0dcf \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dc0\u0dbd\u0da7 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0d9a\u0dbb \u0dad\u0dd2\u0dd9\u0db6\u0db1 \u0dd9\u0dc4\u0dba\u0dd2\u0db1\u0dca \u0daf: \u0dd9\u0db8\u0dc4\u0dd2 \u0db4\u0dc4\u0dad \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0db8\u0db8, \u0d91\u0d9a\u0dd3 \u0d86\u0da5\u0dcf \u0db4\u0db1\u0dd9\u0dad\u0dca 5 (5) \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0d85\u0db1\u0dd4\u0dc0 \u0d91\u0d9a\u0dd3 \u0d89\u0da9\u0db8\u0dca \u0dd9\u0dc4\u0ddd \u0d92\u0dc0\u0dcf\u0dd9\u0dba\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0dd9\u0db8\u0dca \u0d86\u0da5\u0dcf\u0dd9\u0dc0\u0dca \u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dd9\u0dba\u0dc4\u0dd2 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad \u0dc0\u0dc1\u0dd9\u0dba\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db6\u0dc0\u0da7 \u0d86\u0da5\u0dcf\u0dc0\u0d9a\u0dca \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca\u0d9a\u0dbb \u0dc3\u0dd2\u0da7\u0dd2\u0db8\u0dd2. \u0d91\u0dbd\u0dca.\u0da2\u0dd3.\u0db4\u0dd3.\u0db4\u0dc3\u0dcf\u0daf\u0dca, \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dc3\u0dc4\u0d9a\u0dcf\u0dbb \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 /, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd2\u0dd9\u0db8\u0dca \u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0da2\u0255 \u0dd9\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca (\u0d89\u0da9\u0db8\u0dca). 2023 \u0dd9\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 14 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dd9\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca \u0daf\u0dd3 \u0db1\u0d