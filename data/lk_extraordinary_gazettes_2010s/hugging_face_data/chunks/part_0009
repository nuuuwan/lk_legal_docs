0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba - 2019.12.24\n\n(i) \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u027c \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0dcf\u0da2\u0255 \u0d85\u0d82\u0dc1 \u0119\u019f\u023c\u0d9a\u0dbb\u0dab \u021d\u023d\u0dad \u0db8\u0119\u01e6 \u0dc4\u01ff\u0db1\u0dcf\u0d9c\u0dd0\u01e8\u0db8 \u0d85\u0dc0\u0dc1\u0255 \u0d9a\u0dbb\u0db1 \u0286\u0dba\u0265 \u0db8 \u0dc0\u01ae\u0d9a\u023c \u0dc3\u0dc4 \u0dc0\u0d9c\u00fc\u023c \u0dc4\u01ff\u0db1\u0dcf\u0d9c\u0dad \u0252\u01b1\u0dba. (ii) \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u026d \u0dbb\u0dcf\u0da2\u0255 \u0119\u019f\u023c\u0d9a\u0dbb\u0dab \u021d\u023d\u0dad \u0db8\u0119\u01e6 \u0dc4\u01ff\u0db1\u0dcf\u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0d85\u0dc0\u0dc3\u0dbb \u0dd9\u0db1\u02a3\u0dd9\u0daf\u0db1 \u0dc0\u01ae\u0d9a\u023c \u0dd9\u0dc4\u02a4 \u0dc0\u0d9c\u00fc\u023c \u0d85\u0250\u0dad\u0db8 \u0dc4\u01ff\u0db1\u0dcf \u0dd9\u0db1\u02a3\u0d9c\u0dad \u0252\u01b1\u0dba. (iii) \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u026d \u027c \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0dcf\u0da2\u0255 \u0d85\u0d82\u0dc1 \u0119\u019f\u023c\u0d9a\u0dbb\u0dab \u021d\u023d\u0dad \u0dba\u0da7\u0dd9\u01ae \u0dd9\u0dc0\u0db1\u0dc3\u0dca \u0dc0\u0259\u0d9c\u0dc0\u0dbd \u0dc0\u01ae\u0d9a\u023c, \u0dc0\u0d9c\u00fc\u023c \u0dd9\u0dc4\u02a4 \u0dc3\u0dca\u0d9a\u01e6\u0db0\u0dd9\u024f \u0dc3\u0d82\u0dbb\u0da0\u0d9a, \u0d91\u028f \u0dd9\u0db4\u0dbb \u026d \u0db4\u0daf\u0db1\u0dd9\u023c \u023f\u0dbd\u0255 \u0dc0\u0dcf\u0259\u0dad\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0dba\u0da7\u0dd9\u01ae \u0d91\u0d9a \u0dc0\u0259\u0d9c\u0dba\u0d9a \u0dc0\u01ae\u0d9a\u023c \u0dc0\u0d9c\u00fc\u023c \u0dd9\u0dc4\u02a4 \u0dc3\u0dca\u0d9a\u01e6\u0db0\u0dd9\u024f \u0dc3\u0d82\u0dbb\u0da0\u0d9a\u0dba\u01e6 \u0dd9\u0dbd\u0dc3 \u0dc4\u01ff\u0db1\u0dcf\u0d9c\u01ae \u0dc3\u0dd1\u0db8 \u0d85\u0250\u0dad\u0db8\u0dba\u00fa \u0db8 \u0dba\u0298 \u0dc0\u0259\u011a\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dc5 \u0252\u01b1\u0dba. (iv) \u0286\u0dba\u0265 \u0dc4\u01ff\u0db1\u0dcf\u0d9c\u01ae \u0dc0\u01ae\u0d9a\u023c \u0dc3\u0dc4 \u0dc0\u0d9c\u00fc\u023c \u0db8\u0dd0\u01e8\u0dd9\u023c \u01cf \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u026d \u027c \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0dcf\u0da2\u0255 \u0d85\u0d82\u0dc1 \u0119\u019f\u023c\u0d9a\u0dbb\u0dab \u021d\u023d\u0dad \u0dc0\u0255\u0dc0\u0dc4\u0dcf\u0dbb \u0d9a\u0dc5 \u0252\u01b1\u0dba.\n\n48 A\n\nIV (\u0d85) \u0dd9\u0d9a\u02a3\u0da7\u0dc3 - \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba - 2019.12.24\n\n430. \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u026d \u027c \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0dcf\u0da2\u0255 \u0d85\u0d82\u0dc1 \u0119\u019f\u023c\u0d9a\u0dbb\u0dab \u021d\u023d\u0dad \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u00fa \u0d91\u028f \u0d86\u0dbb\u023c\u0db7\u0d9a \u0dc0\u01ae\u0d9a\u023c \u0dc3\u0dc4 \u0dc0\u0d9c\u00fc\u023c \u021d\u0d9a\u0dcf\u0dc1\u0db1\u0dd9\u024f \u0db7\u0dcf\u026a\u0dad \u0d9a\u0dc5 \u0119\u019f\u023c\u0d9a\u0dbb\u0dab \u021d\u01af\u0db4\u01ae\u01af 2020 \u0da2\u0db1\u0dc0\u0dcf\u025c 01 \u0dc0\u0dd0\u01e7 \u01ce\u0db1\u0da7 \u0dd9\u0db4\u0dbb \u026d \u0db4\u0daf\u0db1\u0dd9\u023c \u023f\u0dbd\u0255 \u021d\u0d9a\u0dcf\u0dc1\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0db7\u0dcf\u026a\u0dad \u0d9a\u0dc5 \u0d92\u0dc0\u0dcf\u0250\u01e6 \u0dd9\u0dc0\u0db1\u0dc3\u0dca \u026a\u0dba \u0dc4\u0dd0\u00fb\u0dba. \u0dd9\u0dc0\u0db1\u01ae \u0286\u01ca\u01de\u01e6 \u0dd9\u0dc4\u02a4 \u0dad\u01ae\u01ae\u0dc0\u0dba\u01e6 \u0dd9\u0dc4\u02a4 \u021d\u01af\u0db5\u0dbd\u0dba\u00fa \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0d9c\u0dd0\u0dc5\u021a\u023c \u0db4\u0dd0\u0db1\u0db1\u0136. \u0d91\u0db6\u0dd0\u026a\u01e6 \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u027c \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0dcf\u0da2\u0255 \u0d85\u0d82\u0dc1 \u0119\u019f\u023c\u0d9a\u0dbb\u0dab \u021d\u023d\u0dad\u0dba\u01e6\u0da7 \u0dc3\u0d82\u0100\u0dcf\u01e6\u01af \u026d \u01ce\u0db1 \u0dc0\u0db1 2020 \u0da2\u0db1\u0dc0\u0dcf\u025c 01 \u0dc0\u01e7 \u01ce\u0db1\u0da7 \u0d85\u01af\u025c\u00fa\u0dad\u0dba\u0da7 \u0dd9\u0dc4\u02a4 \u0d8c\u0dab\u0dad\u0dcf\u0dc0\u0da7 (\u0dd9\u0dc4\u02a4 \u0d8b\u013d\u0dad \u0dc0\u01e6\u0dd9\u01e6 \u0db1\u023c \u0276\u01ca\u0db0 \u0dc0\u01ae\u0d9a\u023c/\u0dc3\u0dca\u0d9a\u01e6\u0db0\u0dba \u01b1\u0dc5 \u0dd9\u0dc0\u0db1\u01ae \u021d\u0dd9\u0233\u0daf\u0dba\u00fa) \u0d9c\u0dd0\u0dc5\u021a\u023c \u0dd9\u0dbd\u0dc3 \u0d92\u0dc0\u0dcf \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u026a\u0286\u01e6 \u0dc4\u01ff\u0db1\u0dcf\u0d9c\u0dad \u0252\u01b1\u0dba. 431. \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u026d \u027c \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0dcf\u0da2\u0255 \u0d85\u0d82\u0dc1 \u0119\u019f\u023c\u0d9a\u0dbb\u0dab \u021d\u023d\u0dad \u0dc3\u0db8\u0d9f \u0d85\u01e9\u00fe\u0dbd\u0dc0 \u0dc0\u0da9\u0dcf\u01ae \u0db8\u0dd1\u0dad\u0d9a \u0dd9\u0db4\u0dbb \u026d \u0d91\u028f \u023f\u0dbd\u0255 \u021d\u0d9a\u0dcf\u0dc1\u0db1 \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dc5 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u00fa \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u026d \u027c \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0dcf\u0da2\u0255 \u0d85\u0d82\u0dc1 \u0119\u019f\u023c\u0d9a\u0dbb\u0dab \u021d\u023d\u0dad\u0dba\u01e6\u0da7 \u0d85\u01e9\u00fe\u0dbd\u0dc0 \u023f\u0dbd\u0255 \u021d\u0d9a\u0dcf\u0dc1\u0db1 \u0d89\u01ce\u025c\u0db4\u01ae \u00fb\u025d\u0dd9\u023c \u01cf \u0db7\u0dcf\u026a\u0dad \u0d9a\u0dc5 \u0dd9\u01ca\u0db4\u0dc5 \u0218\u025c\u0dba\u0dad \u0dc3\u0dc4 \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0d85\u0250\u0dad\u0db8\u0dba\u0d9a \u021d\u0dad\u0255\u0dcf\u0d9c\u0dab\u0db1\u0dba \u0d9a\u0dc5 \u0dc0\u0179\u0db1\u0dcf\u0d9a\u0db8 \u0db7\u0dcf\u026a\u0dad \u00fb\u025d\u0db8\u0da7 \u0dd9\u0dad\u02a4\u0dbb\u0dcf\u0d9c\u0dad \u0dc4\u0dd0\u00fb\u0dba. \u0d91\u0dc0\u0dd0\u01e7 \u021d\u0dad\u0255\u0dcf\u0d9c\u0dab\u0db1\u0dba \u00fb\u025d\u0db8 \u0db8\u0119\u01e6 \u0d91\u0db8 \u01ce\u0db1 \u0d91\u0db8 \u0d85\u0250\u0dad\u0db8\u0dd9\u024f \u0db0\u0dcf\u0dbb\u0dab \u0d85\u0d9c\u0dba \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u01e7\u0dc3\u0dcf \u0dd9\u0db8\u0db8 \u021d\u023d\u0dad\u0dba\u0da7 \u0d85\u01e9\u00fe\u0dbd\u0dc0 \u023f\u0dbd\u0255 \u021d\u0d9a\u0dcf\u0dc1\u0db1 \u0d89\u01ce\u025c\u0db4\u01ae \u00fb\u025d\u023c \u0dd9\u0dbd\u0dc3 \u0d91\u0dba \u0dc3\u0dd0\u0dbd\u00fb\u0dba \u0dc4\u0dd0\u00fb\u0dba. 432. \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u00fa \u026a\u0286\u01e6 \u0dd9\u0db4\u0dbb \u026d \u0240\u0dbd\u0255 \u021d\u0d9a\u0dcf\u0dc1\u0db1\u0dc0\u0dbd \u0dc4\u01ff\u0db1\u0dcf \u0dd9\u0db1\u02a3\u0d9c\u01ae \u0dd9\u01ca\u0db4\u0dc5, \u0218\u025c\u0dba\u0dad \u0dc3\u0dc4 \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0dd9\u0dc4\u02a4 \u0dba\u023c \u0dd9\u01ca\u0db4\u0dc5, \u0218\u025c\u0dba\u0dad \u0dc3\u0dc4 \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0db4\u01e6\u01af."
