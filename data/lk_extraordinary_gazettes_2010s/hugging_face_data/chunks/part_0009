u0bb5\u0ba4\u1fbe\u0b95\u0bbe\u0b95 26 0.0274 \u0b85\u0bb0\u1f86 \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe\u1fbf\u0bb5\u0bbe\u1fbc 34 0.1154 \u0bc6\u0ba4\u0bbe\u1fb9 \u0b9a\u0bae\u0bc0\u0bb0 \u1f9e\u1fb0\u0bae\u0bbe\u1fbf \u1fa2\u0baf\u0ba9\u0baa\u0ba4\u0bbf\u0bb0\u0ba3 810181516v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 178 \u0b87\u1fb9 \u2013 \u0b87\u0bb2. 23/\u0bc7\u0b95, \u0b95\u1fb8\u0bc7\u0ba4\u0bb5\u1fb7\u0ba4, \u0baa\u0bbe\u0bc8\u0ba4 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0bae\u0bbe\u0bb9\u1fbf\u0bc6\u0bb2\u0bbe\u1fa6\u0bb5, \u0b95\u0bbf\u0bbe\u0bbf\u1fb8\u0ba4\u0bbf\u0bc6\u0bb5\u0bb2 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 57 0.0430 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa - \u0bc6\u0ba4\u0bbe\u1fbb\u0bc7\u0baa \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 61 0.0207 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa - \u0bc6\u0ba4\u0bbe\u1fbb\u0bc7\u0baa \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013\n\n5 A\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.11.21\n\n\u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3 - \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2