a\u0dd9\u0da9\u02a3\u0dbd\u0dcf\u0db1 \u0dc0\u0db1\u0dcf\u01e6\u0dad\u0dbb\u0dba \u0dc0\u0259\u0dc2 2019 \u00fa \u026d \u0dd9\u0db1\u02a3\u0dc0\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 04 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0286\u0da7 \u0dd9\u01ca\u01ca\u01d1\u0dc0 \u0dad\u0dbd\u01e6 \u0d9a\u0dbd\u021a\u0dc0 \u0d9a\u0dd9\u0da9\u02a3\u0dbd\u0dcf\u0db1\n\n\u0dbb\u00fa\u027f\u0dad \u0dc0\u0db1\u0dcf\u01e6\u0dad\u0dbb\u0dba \u0dd9\u0dbd\u0dc3 \u0dd9\u0db8\u0250\u01e6 \u021d\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u01ae \u0d9a\u0dbb\u023d.\n\n\u0ddb\u0db8\u01b6\u0db4\u0dcf\u0dbd \u0286\u025c\u0dd9\u0dc3\u02a2\u0db1, \u0da2\u0db1\u0dcf\u01dd\u0db4\u01af 2019 \u0dd9\u0db1\u02a3\u0dc0\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 04 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0dd9\u0d9a\u02a3\u0dc5\u0db9 \u01cf \u0dba.\n\n3A\n\nI \u0dd9\u0d9a\u02a3\u0da7\u0dc3 : I \u0dd9\u0da1\u0daf\u0dba : \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba : 2019.11.20\n\n\u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba \u027c \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269, \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0d9c\u0dcf\u0262\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0dd9\u0db6\u01e6\u0dad\u0dbb \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u01b1\u0dbd \u0218\u028f\u0179 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 64.7 \u0252\u00fa\u0dad \u026d \u0db4\u0dc4\u0dad \u0237\u023d\u01af\u0d9a \u0db4\u0dcf\u0da8\u0dcf\u0d82\u0d9a \u0dc0\u0263\u01e6 \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u021d\u0dd9\u01ca\u0dc1\u0dba \u01b1\u0dbd \u0218\u028f\u0179 \u0dbb\u0da2\u0dd9\u024f \u0d89\u0da9\u023c \u021d\u0db8\u0dcf\u0dab\u0dba. (\u0db8\u0dd0\u01e9\u023c \u0100\u0db8\u0dba - \u0237\u023d\u01af\u0d9a \u0d9b\u0dab\u0da9\u0dcf\u0d82\u0d9a, (EPSG: 5234 \u0100\u0db8\u0dba \u0dd9\u0269)."
