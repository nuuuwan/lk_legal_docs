b5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb, \u0b87\u0bb2. 13458 \u0bae\u1fbe\u1fa0\u1fbb 2018.07.16 \u0ba4\u0bbf\u0ba9\u1fb7\u0ba4\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fbb \u0bc6\u0b95\u0bbe\u0bae\u1fbd\u0bb7\u1fbf \u0bc7\u0baa\u1fb1\u1fb0 \u0b92\u1fba \u0b9a\u0bbf\u0bc7\u0bb2\u0bbe\u1fb9 PLC \u0b87\u1fbf \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 29 0.0039 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa - \u1f81\u1f9e\u0ba8\u0bbe\u0b95\u1fbf \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 33 0.0389 \u0b9c\u0baf\u0b9a\u0bbf\u1fb1\u0bb9 \u1f99\u0ba4\u1fa2\u0bc7\u0b95 \u0ba4\u1f94\u0b9c\u0bbe \u0ba8\u0bbf\u0bae\u0bbe\u1fa2 797624071v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. \u2013 \u0b9c\u0baf\u0b9a\u0bbf\u1fb1\u0bb9 26 \u0bae\u1fbe\u1fa0\u1fbb 34 \u0b87\u0bb2. 9/2, \u0bc6\u0b9a\u0ba9\u1f86\u0bae \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0ba8\u0bc0\u1fbd\u0bc6\u0b95\u0bbe\u1fa8\u1fbb\u1f97 \u1faa\u0ba4\u0bbf, \u1f81\u1f9e\u0ba8\u0bbe\u0b95\u1fbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb, \u0b87\u0bb2. 2270 \u0bae\u1fbe\u1fa0\u1fbb 2014.06.20 \u0ba4\u0bbf\u0ba9\u1fb7\u0ba4\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fbb \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0bc7\u0b9a\u0bae\u0bbf\u1fba\u1f97 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fbf \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90.\n\n12 A III \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2013 \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000e\u000f\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0012 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0015 \u0d85\u0017 \u0018\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0dba \u2013 2019.11.28\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u