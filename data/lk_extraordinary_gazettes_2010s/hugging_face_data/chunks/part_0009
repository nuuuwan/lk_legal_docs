\u0dba !y\u0db6\u0db3 \u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0dca\u0dad\u0dbb\n\n(\u0dd9\u0dc4F\u0da7\u0dba\u0dcfc)\n\n30 0.0651 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 - E;\u0dad\u0dbd\u0db8 \u2013 \u0dc3-uc\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 \u0db8\u0dcfc\u0d9c\u0dba 105 0.0110 \u0dd9\u0db8)\u0dc4\u0db8i \u0d94\u0db8c \u0dc6\u0dcf\u001b\u0db8\u0dcf \u0dc3\u0dc6\u0dca\u0db1\u0dcf\u0dc3\u0dca 978410588v \u0dc3-uc\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 \u2013 \u0d85\u0d82\u0d9a 34/5, \u0d9a\u0dd0\u0db1= \u0db4\u0dcf\u0dbb, E;\u0dad\u0dbd\u0db8 107 0.0117 \u0dd9\u0db8)\u0dc4\u0db8} \u0dbb\u2039} \u0dc3-\u0192 (\u0dc4\u0dcfc \u0d8b-\u0db8\u0dcf 747521662v \u0dc3-uc\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 \u2013 \u0d85\u0d82\u0d9a 34/6, \u0d9a\u0dd0\u0db1= \u0db4\u0dcf\u0dbb, E;\u0dad\u0dbd\u0db8 108 0.0082 \u0d85li= \u0dbd\u001bf \u0dd9\u0da2 \u0db1M= \u0dc64\u0da9\u0dcf 757353504v \u0dc3-uc\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 \u2013 \u0d85\u0d82\u0d9a 32/8, \u0d9a\u0dd0\u0db1= \u0db4\u0dcf\u0dbb, E;\u0dad\u0dbd\u0db8 112 0.0116 M\u0dc0\u0dcf Rc \u0dc3\u0db6\u0dcfc \u0dd9\u0db1r\u0db1\u0dcf tY\u0db1\u0dcf 806964328v \u0dc3-uc\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 \u2013 \u0d85\u0d82\u0d9a 32/7, \u0d9a\u0dd0\u0db1= \u0db4\u0dcf\u0dbb, E;\u0dad\u0dbd\u0db8\n\n12 A III \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 : \u0001 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007\u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4