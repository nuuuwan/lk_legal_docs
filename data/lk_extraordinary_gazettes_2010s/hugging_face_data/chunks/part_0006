bae\u0bbf\u0bb2\u0bbe\u0bc7\u0b95 \u0b9a\u0bae\u0bbf\u0bb2\u0bbe 856190943v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b85\u0bc7\u0baa\u0bb0\u1fb7\u0ba9 \u2013 \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u1fbd\u0bb8\u0ba9\u0bc0 \u1f86\u0baa\u0b9a\u0bbf\u1fb1\u0bb9 \u0bc7\u0bb9\u0bb0\u1fb7 \u0b87\u0bb2. 70, \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u1f90\u1fbb\u0bae\u0bb2\u0bc6\u0ba4\u0ba9\u0bbf\u0baf, \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u1f8a\u0b95\u0bbf\u0bbe\u0bbf \u0baa\u1fb6\u0b9f\u0bbe\u0bc7\u0b95 \u0b9a\u0bbe\u0bb2\u1fb5 \u0bc7\u0baa\u0bae\u0bbe\u0bb5\u0ba4\u0bc0 \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 36 0.0723 \u0bc6\u0baa\u1fb8\u0ba4\u0bb0 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0b9a\u0bae\u0bbf\u1fb8\u0ba4 \u0b9a\u1fbb\u0baa\u1fb7 197323002000 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 35 \u2013 \u0b87\u0bb2. 68 \u0b8f, \u0bb5\u0bbf\u0bb9\u0bbe\u0bb0 \u1faa\u0ba4\u0bbf, \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u0bae\u1fbe\u1fa0\u1fbb 39 \u0b87\u1fb9 \u1f90\u1fbb\u0bae\u0bb2\u0bc6\u0ba4\u0ba9\u0bbf\u0baf, \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 37 0.0507 \u0b87\u1f81\u1f9e\u0bb5\u1fb7\u0ba4\u0bc7\u0b95 \u0ba8\u0ba4\u0bc0 \u0b9a\u0bbf\u0bbe\u0bbf\u0baf\u0bbe\u0ba9\u0bbf 815784936v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 39 \u0b87\u1fb9 \u2013 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 71 \u0b9c\u0bc0, \u0baa\u1fb9\u0b9a\u0bb2 \u0bc6\u0ba4\u0bb5\u0b9f \u1faa\u0ba4\u0bbf, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u1f90\u1fbb\u0bae\u0bb2\u0bc6\u0ba4\u0ba9\u0bbf\u0baf, \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u0bc7\u0bb9\u0bb0\u1fb7 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0bb5\u0bbf\u0bae\u0bb2\u0bbe \u0bb0\u1fb4\u0b9c\u0ba9\u0bc0 \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90,\n\n28 A\n\nIII \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2013 \b \u0dbd\u0d82\u0d9a\u0dcf \u0dbd\u0d82\u0d9a\u0dcf \u0dbd\u0d82\u0d9a\u0dcf \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000f\u0010\u0da2\u0dcf\u0dad\u0dcf\u000f\u0010\u0da2\u0dcf\u0dad\u0dcf\u000f\u0010\u0da2\u0dcf\u0dad\u0dcf\u000f\u0010\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0013 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0016 \u0d85\u0018 \u0019\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0013 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0016 \u0d85\u0018 \u0019\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0013 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0016 \u0d85\u0018 \u0019\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0013 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0016 \u0d85\u0018 \u0019\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0dba \u0dba \u0dba \u0dba \u2013 2019201920192019.09090909.10101010\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.09.10"
