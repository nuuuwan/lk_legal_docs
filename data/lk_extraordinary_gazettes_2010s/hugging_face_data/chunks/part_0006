c \u0b87\u0bb2. 102 ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 102, \u0b8e\u0bae\u0bcd.\u0b9a\u0bae\u0bc0\u0bb0 \u0bae\u1f90\u0b9a\u0b99\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bb2\u0bb5\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u0b87\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf, \u0bc7\u0b95.\u0b8f.\u0bb5\u0bbf\u0bae\u0bb2\u0bbe\u0bb5\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc7\u0b95.\u0b8f.\u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0bb2\u0ba4\u0bbe \u0b95\u0bc1\u1f9e\u0baa\u0bcd\u1f97 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bb2\u0bb5\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 104 ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 104 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa).\n\n104. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 104 - \u0b95\u0bb2\u0bb5\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0194 \u0bc6\u0bb9\u0b95\u0bcd\u0bc7\u0b9f\u0baf\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa) \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 103 ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 103, \u0b8e\u0bae\u0bcd.\u0b95\u0bb5\u0bbf\u0bb7 \u0bae\u0bbe\u1fa2\u0b99\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bb2\u0bb5\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u0b87\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf, \u1faa\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 105 ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 105 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa).\n\n105. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 105 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0022 \u0bc6\u0bb9\u0b95\u0bcd\u0bc7\u0b9f\u0baf\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa) \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 104 ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 104 , \u0bc7\u0b95.\u0b8f.\u0bb5\u0bbf\u0bae\u0bb2\u0bbe\u0bb5\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc7\u0b95.\u0b8f. \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bb2\u0ba4\u0bbe \u0b95\u0bc1\u1f9e\u0baa\u0bcd\u1f97 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bb2\u0bb5\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u1faa\u0ba4\u0bbf, \u0bc7\u0b95.\u0b8f.\u0b9c\u0bbe\u1fa2\u0bb8\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bb2\u0bb5\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 106 ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 106 \u0