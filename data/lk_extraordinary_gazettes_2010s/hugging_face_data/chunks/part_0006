f\u0bbe\u0bbf \u0b9a\u0bb0\u0ba3\u1fb1\u0b95\u0bb0 \u1faa\u0ba4\u0bbf \u0b95\u1fa6\u0bc7\u0baa\u0bbe\u0bb5\u0bbf\u0bb2, \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb2 97 0.0042 \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1fbd \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 98 \u0bae\u1fbe\u1fa0\u1fbb 99 \u1fbe\u1f81 \u0baa\u0bbf\u0bb0\u0bc7\u0bb5\u0b9a\u0bbf\u1fba\u0baa- \u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 98 0.0090 \u0bae\u1fb9\u0b9f\u0bbe\u0bb5\u0bb2 \u0b95\u1fb9\u0b95\u0bbe\u0ba9\u1fbb\u0bc7\u0b95 \u0bae\u0bc7\u0bb9\u0bb7\u0bbf\u0b95\u0bbe 867720030v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bc6\u0b9f\u0ba9\u0bbf\u0bc6\u0baf\u1fbf\u0bc7\u0b95 \u2013 \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u1fbd\u0bb8\u0ba9\u0bc0 \u1f9c\u0ba9\u0bc0\u0ba4\u0bbe \u0bc7\u0b95\u0bbe\u0bae\u1fc4 \u0b87\u0bb2. 27/2, \u0b9a\u0bbf\u0bbe\u0bbf \u0b9a\u0bb0\u0ba3\u1fb1\u0b95\u0bb0 \u1faa\u0ba4\u0bbf \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b95\u1fa6\u0bc7\u0baa\u0bbe\u0bb5\u0bbf\u0bb2, \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb2 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 97 \u0b87\u1fb9 \u0baa\u0bbe\u0bc8\u0ba4 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 147 0.0361 \u0ba8\u0bbe\u0bae\u1fa3 \u0bc7\u0bae\u0bbe\u0bbf\u0b8f\u1fb9 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe 785443446v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bc6\u0ba8\u0bb5\u0bbf\u1fbf \u0ba4\u0bbf\u0bc7\u0bb2\u0bbe \u2013 \u0b87\u0bb2. 16/ \u1f96, \u0b9a\u0bbf\u0bbe\u0bbf \u0bae\u0bb9\u0bbe \u0bb5\u0bbf\u0bb9\u0bbe\u0bb0 \u1faa\u0ba4\u0bbf, \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0baa\u0bbe\u0bae\u1fb1\u0b95\u0b9f, \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb2 \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9