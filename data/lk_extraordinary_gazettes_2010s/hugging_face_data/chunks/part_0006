1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc6\u0b95\u0bbe\u0bb9\u0bc1\u0bb5\u0bb2 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bc6\u0b95\u0ba4\u0bbe\u0bbf\u1fb9 \u0bb5\u1fbd\u0b9c\u0bbf\u1fb9 \u0b9c\u0baf\u0bae\u0bb9 (\u0ba4\u0bbf\u1f9e\u0bae\u0ba3\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u1f99\u1fb9\u0bc7\u0baa \u0b9f\u0baf\u1fc4) \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 20 0.0315 \u0b8e\u1fb5\u0bb5\u1fb5 \u0b92\u1fc4\u0bb5\u1fbf \u0bb5\u0bbf\u1fbf\u0b9a\u1fb9 \u0b8e\u1fa2\u0b9a\u0baa\u1fb7 525392430v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 06 \u0b87\u1fb9 \u2013 \u0bc6\u0baa\u0ba9\u1fb5 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 55, \u1f86\u0bc7\u0ba9\u1fb7\u0bb0\u0bbe\u0bc7\u0ba4\u0bb5\u0bbf \u1faa\u0ba4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bc6\u0b95\u0bbe\u0bb9\u0bc1\u0bb5\u0bb2, \u1f92\u0bc7\u0b95\u0bc6\u0b95\u0bbe\u0b9f \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b87\u0bb2. 620 \u0bae\u1fbe\u1fa0\u1fbb 2018.10.01 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u1f81\u1fb7\u0ba4\u0bc8\u0b95 \u0b85\u1fb7\u0ba4\u0bbe\u1fb5\u0b9a\u0bbf \u0baa\u1fb7\u0ba4\u0bbf\u0bb0\u1fb7\u0ba4\u0bbf\u1fb9 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 40 0.0261 \u0bae\u0bb9\u0bbe\u0bb0\u1fb0\u0b95\u0bb2\u0bc7\u0b95 \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u1fb8\u0ba4 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe 632360630v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 41 \u0b87\u1fb9 \u2013 \u0b87\u0bb2. 63 \u0b8f, \u1f86\u0bc7\u0ba9\u1fb7\u0bb0\u0bbe\u0bc7\u0ba4\u0bb5\u0bbf \u1faa\u0ba4\u0bbf, \u0baa\u0bbe\u0bc8\u0ba4 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0bc6\u0b95\u0bbe\u0bb9\u0bc1\u0bb5\u0bb2 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 