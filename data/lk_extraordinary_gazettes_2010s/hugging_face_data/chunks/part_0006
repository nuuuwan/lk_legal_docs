\u0bb5\u0bbf\u0bb2\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd\n\n0.0063 \u0bc6\u0bb9\u0b95\u0bcd\u0bc7\u0b9f\u0baf\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 58, \u0bc7\u0b95.\u0b8f.\u0baf\u0b9a\u0baa\u0bbe\u0bb2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd\n\n\u0bb5\u0bbf\u0bb2\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 :\n\n\u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf \u0b86\u0ba9\u0ba8\u0bcd\u0ba4 \u0b95\u0bb2\u0bc6\u0b95\u0ba4\u0bb0 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd\n\n\u0bb5\u0bbf\u0bb2\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 60 ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2.\n\n60 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf (\u1faa. \u0b85. \u0b85.) ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u1faa\u0ba4\u0bbf (\u1faa. \u0b85. \u0b85.) \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd\n\n\u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 58\n\n60. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 60 - \u0bb5\u0bbf\u0bb2\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd\n\n0.0082 \u0bc6\u0bb9\u0b95\u0bcd\u0bc7\u0b9f\u0baf\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 59, \u0bae\u0bbf\u0ba4\u0bbf\u0bb2\u0bbe\u0ba9\u0bbf \u1faa\u0bb0\u0bc7\u0b95\u0bbe\u0ba9\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0