b9\u1fb5 \u0bc6\u0ba4\u0bc7\u0bb0\u0b9a\u0bbe \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u0bc8\u0ba8\u0ba9\u0bae\u0b9f\u0bae, \u0bc8\u0ba8\u0ba9\u0bae\u0b9f\u0bae 24 0.0470 \u0bb5\u1fbd\u0ba9\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0bb5\u0bbf\u0ba9\u0bc0\u0ba4\u0bbe \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b87\u0bb2. 11939 \u0bae\u1fbe\u1fa0\u1fbb \u2013 \u0baa\u1fbd\u0ba9\u0bbe\u1fb8\u1f90 2018.07.24 \u0ba4\u0bbf\u0ba8\u0ba4\u0bbf \u0bc6\u0b9a\u0ba9\u1f86\u0bae, \u0bc6\u0b9a\u0baf\u0bbf\u1fb9\u1fb5 \u0bc6\u0ba4\u0bc7\u0bb0\u0b9a\u0bbe \u1f81\u1fb7\u0ba4\u0bc8\u0b95 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u0bc8\u0ba8\u0ba9\u0bae\u0b9f\u0bae, \u0b92\u1fba\u0baa\u1fb8\u0ba4\u1fb7\u0ba4\u0bbf\u1fb9 \u0bc8\u0ba8\u0ba9\u0bae\u0b9f\u0bae \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 30 0.0154 \u0bb5\u1fbd\u0ba9\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0b87\u1fb2\u0b9a\u1fbb\u1f97\u1fbf\u1fa2\u0bc7\u0b95 608102736v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 29 \u0b87\u1fb9 \u2013 \u0bc7\u0b9f\u0b9a\u0bbf \u0bb5\u0bbf\u0b95\u0bbf\u0baa\u0bbf\u0bbe\u0bc0\u0b9f\u0bbe \u0baa\u1fbd\u0ba9\u0bbe\u1fb8\u1f90 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 23/\u1f96, \u0bc6\u0b9a\u0baf\u0bbf\u1fb9\u1fb5 \u0bc6\u0ba4\u0bc7\u0bb0\u0b9a\u0bbe \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u0bc8\u0ba8\u0ba9\u0bae\u0b9f\u0bae, \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bc8\u0ba8\u0ba9\u0bae\u0b9f\u0bae 46 0.0377 \u0bb5\u0bbf\u0b9c\u0bbf\u0ba4\u0bbe \u0b9c\u0baf\u1fb8\u0ba4\u0bbf \u0baa\u1fbd\u0ba9\u0bbe\u1fb8\u1f90 687303172v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0b87\u0bb2. 25/\u0b9a\u0bc0, \u0bc6\u0b9a\u0baf\u0bbf\u1fb9\u1fb5 \u0bc6\u0ba4\u0bc7\u0bb0\u0b9a\u0bbe \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u0bc8\u0ba8\u0ba9\u0bae\u0b9f\u0bae, \u0bc8\u0ba8\u0ba9\u0bae\u0b9f\u0bae\n\n38 A III \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2013 \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000e\u000f\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0012 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0015 \u0d85\u0017 \u0018\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0dba \u2013 2019.09.02\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.09.02"
