\u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0ba4\u0bc8\u0b95\u0bc8\u0bae\u0b95\u0bc8\u0bb3 \u1f98\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0bbe\u0ba4 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 1\n\n\u0ba4\u0bb0\u0bae\u0bcd 1 \u0b87\u0bb1\u0bcd\u0b95\u0bc1 \u0baa\u0ba4\u0bb5\u0bbf \u0b89\u0baf\u0bb0\u0bcd\u1fab \u0bc6\u0baa\u1fa0\u0bae\u0bcd \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bc7\u0baf\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0ba4\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0baa\u0ba4\u0bb5\u0bbf\n\n\u0b89\u0baf\u0bb0\u0bcd\u1fab \u0bc6\u0baa\u1fa0\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0ba4\u0bc8\u0b95\u0bc8\u0bae \u0bc6\u0baa\u1fa0\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 10.3.1.1(V) \u0b87\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd\n\n\u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0ba4\u0bc8\u0b95\u0bc8\u0bae\u0b95\u0bc8\u0bb3\u0baa\u0bcd \u1f98\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf \u0bc6\u0b9a\u0baf\u0bcd\u0ba4\u0bb2\u0bcd \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd.\n\n10.4.2 \u0baa\u0ba4\u0bb5\u0bbf \u0b89\u0baf\u0bb0\u0bcd\u1fab \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u1f99\u0bc8\u0bb1:-\n\n\u0ba4\u0bc8\u0b95\u0bc8\u0bae\u0b95\u0bc8\u0bb3\u0baa\u0bcd \u1f98\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf \u0bc6\u0b9a\u0baf\u0bcd\u1f9c\u0bae\u0bcd \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0ba4\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0baa\u0ba4\u0bb5\u0bbf\n\n\u0b89\u0baf\u0bb0\u0bcd\u1fab\u0b95\u0bcd\u0b95\u0bbe\u0b95 \u0ba8\u0bbf\u0baf\u0bae\u0ba9 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bbe\u0bbf\u0baf\u0bbf\u0b9f\u0bae\u0bcd \u0b8f\u0bb1\u0bcd\u1f97\u0bc8\u0b9f\u0baf \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bc7\u0baf\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bbe\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b89\u0bbe\u0bbf\u0baf\n\n\u0bae\u0bbe\u0ba4\u0bbf\u0bbe\u0bbf\u0baa\u0bcd \u0baa\u1f8a\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bae\u0baf \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0bc8\u0b95 \u0bb5\u0bbf\u1f8c\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bbf\u0b9f\u0ba4\u0bcd\u1f90 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0bc7\u0b9a\u0bc8\u0bb5\n\n\u0b86\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0bc1\u1fa8\u0bb5\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b85\u0ba8\u0bcd\u0ba4 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bc7\u0baf\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bbe\u0bbf\u0ba9\u0bcd \u0ba4\u0bc8\u0b95\u0bc8\u0bae \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0bc7\u0ba8\u0bb0\u0bcd\u1f99\u0b95\u0baa\u0bcd\n\n\u0baa\u0bbe\u0bc0\u0b9f\u0bcd\u0bc8\u0b9a\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u1fa0\u0bc7\u0baa\u1fa0\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bae\u0baf \u0baa\u0ba4\u0bb5\u0bbf \u0b89\u0baf\u0bb0\u0bcd\u1fab \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bb5\u0bb0\u0bcd.\n\n\u0bc6\u0bb5\u0bb1\u0bcd\u0bb1\u0bbf\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0bc8\u0b95\u0bc8\u0baf\u0baa\u0bcd \u0bc7\u0baa\u0bbe\u0ba9\u0bcd\u1fa0 \u0b87\u0bb0\u0ba3\u0bcd\u1f8c \u0bae\u0b9f\u0b99\u0bcd\u0b95\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b95\u0bc1\u0bc8\u0bb1\u0baf\u0bbe\u0ba4\n\n\u0bb5\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bc8\u0bb3 \u0b9a\u0bae\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bc7\u0baf\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u1fa2\u1f9e\u0ba8\u0bcd\u1f90 \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u1f90 \u0bc7\u0b9a\u0bc8\u0bb5\n\n\u1f9a\u0baa\u0bcd\u1f97\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bae\u0baf \u0ba4\u0bc8\u0b95\u0bc8\u0bae \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0bc7\u0ba8\u0bb0\u0bcd\u1f99\u0b95\u0baa\u0bcd \u0baa\u0bbe\u0bc0\u0b9f\u0bcd\u0bc8\u0b9a\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bb4\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bb5\u0bb0\u0bcd.\n\n\u0b85\u1f8a\u0baa\u0bcd\u0baa\u0bc8\u0b9f\u0ba4\u0bcd \u0ba4\u0bc8\u0b95\u0bc8\u0bae\u0b95\u1fa6\u0bae\u0bcd \u0ba4\u0bc8\u0b95\u0bc8\u0bae \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0bc7\u0ba8\u0bb0\u0bcd\u1f99\u0b95\u0baa\u0bcd \u0baa\u0bbe\u0bc0\u0b9f\u0bcd\u0bc8\u0b9a\u0baf\u0bbf\u0ba9\u0bcd \u0bc7\u0baa\u0bbe\u1f90\n\n\u0baa\u0bbe\u0bbf\u0bc7\u0b9a\u0bbe\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd.\n\n19A\n\nI \u0dd9\u0d9a\u0ddc\u0da7\u0dc3:(I) \u0dd9\u0da1\u0dca\u0daf\u0dba - \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba - 2019.09.27\n\n\u0baa\u0b95\u0bc1\u0ba4\u0bbf I: \u0bc6\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf (I) - \u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u1f8a\u0baf\u0bb0\u0b9a\u0bc1 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 - 2019.09.27\n\n\u0ba4\u0bbf\u0bb1\u0bc8\u0bae\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u1f97\u0bb3\u0bcd\u0bb3\u0bbf\u0b95\u0bb3\u0bcd \u0bc7\u0bae\u0bb2\u0ba4\u0bbf\u0b95 \u0b95\u0bb2\u0bcd\u0bb5\u0bbf\u0ba4\u0bcd \u0ba4\u0bc8\u0b95\u0bc8\u0bae\u0b95\u0bb3\u0bcd, \u0bc7\u0bae\u0bb2\u0ba4\u0bbf\u0b95 \u0bc6\u0ba4\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd \u0ba4\u0bc8\u0b95\u0bc8\u0bae\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0bc8\u0bb1\u0b95\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u1f97\u0bc8\u0b9f\u0baf \u1f99\u0ba9\u0bcd\u0bc8\u0bb5\u0baa\u0bcd\u1f97\u0b95\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd.\n\n\u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u1f97 :-"
