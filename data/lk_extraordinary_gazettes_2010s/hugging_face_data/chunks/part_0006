\u0ba8\u0b9f\u0bbe\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0bb5\u0bbf\u0bc8\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bcd\u0b95\u0bbe\u0ba3\u0bcd \u0ba4\u0bc8\u0b9f\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb2\u0bcd \u0baa\u0bbe\u0bc0\u0b9f\u0bcd\u0bc8\u0b9a\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bbe\u0b9f\u0b99\u0bcd\u0b95\u0bc8\u0bb3 \u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bc8\u0b9f\u0bb5\u0ba4\u0ba9\u0bcd \u1f9a\u0bb2\u0bae\u0bcd \u0bb5\u0bbf\u0bc8\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bcd\u0b95\u0bbe\u0ba3\u0bcd \u0ba4\u0bc8\u0b9f\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bc8\u0bb2 \u1f98\u0bb0\u0ba3\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4 \u1f99\u1f8a\u1f9c\u0bae\u0bcd. \u0b92\u0ba4\u0bcd\u0ba4 \u0baa\u0bbe\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0bbf\u0bc8\u0ba3\u0baa\u0bcd\u1f97 09 \u0b87\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u1f90.\n\n8.2 \u0bb5\u0bbf\u0bc8\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bcd\u0b95\u0bbe\u0ba3\u0bcd \u0ba4\u0bc8\u0b9f\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb2\u0bcd \u0ba8\u0b9f\u0bbe\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0b95\u0bbe\u0bb2 \u0b87\u0bc8\u0b9f\u0bc6\u0bb5\u0bb3\u0bbf \u0bb5\u0bbf\u0bc8\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bcd\u0b95\u0bbe\u0ba3\u0bcd \u0ba4\u0bc8\u0b9f\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb2\u0bcd \u0baa\u0bbe\u0bc0\u0b9f\u0bcd\u0bc8\u0b9a\u0b95\u0bb3\u0bcd \u0bb5\u1f9e\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b87\u0bb0\u0ba3\u0bcd\u1f8c \u0ba4\u0b9f\u0bc8\u0bb5\u0b95\u0bb3\u0bcd \u0ba8\u0b9f\u0bbe\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd.\n\n8.3 \u0bb5\u0bbf\u0bc8\u0ba9\u0ba4\u0bcd \u0ba4\u0bbf\u0bb1\u0ba9\u0bcd \u0b95\u0bbe\u0ba3\u0bcd \u0ba4\u0bc8\u0b9f\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb2\u0bcd \u0baa\u0bbe\u0bc0\u0b9f\u0bcd\u0bc8\u0b9a\u0b95\u0bc8\u0bb3 \u0ba8\u0b9f\u0bbe\u0ba4\u0bcd\u1f90\u0bae\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bbe\u0bbf\u0b95\u0bb3\u0bcd: \u0bc6\u0bb5\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0bb3 / \u0b85\u1fa4\u0bb5\u0bb2\u0b95 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bc7\u0baf\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd \u0bb5\u0b95\u0bc1\u0ba4\u0bbf - 2 \u0b89\u0ba4\u0bb5\u0bbf \u0bb5\u0bbf\u0bc8\u0bb2\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0ba9\n\n1 \u0b86\u0bae\u0bcd \u0bb5\u0bbf\u0bc8\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bcd\u0b95\u0bbe\u0ba3\u0bcd \u0ba4\u0bc8\u0b9f\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bbe\u0ba9 \u0bb5\u0bbf\u0bc8\u0bb2 \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bbe\u0bb3\u0bbe\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd 2 \u0b86\u0bae\u0bcd \u0bb5\u0bbf\u0bc8\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bcd\u0b95\u0bbe\u0ba3\u0bcd \u0ba4\u0bc8\u0b9f\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb2\u0bcd \u0b85\u1f94\u0bae\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0ba8\u0bbf\u1fa0\u0bb5\u0ba9\u0bc6\u0bae\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd\n\n\u0ba8\u0bbf\u0bc8\u0bb1\u0bc7\u0bb5\u0bb1\u0bcd\u1fa0\u0ba4\u0bcd\u0ba4\u0bb0 \u0bb5\u0b95\u0bc1\u0ba4\u0bbf\u0bc8\u0baf\u0b9a\u0bcd \u0bc7\u0b9a\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bc7\u0baf\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0ba9\n\n1 \u0b86\u0bae\u0bcd \u0bb5\u0bbf\u0bc8\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bcd\u0b95\u0bbe\u0ba3\u0bcd \u0ba4\u0bc8\u0b9f\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bbe\u0ba9 \u0bb5\u0bbf\u0bc8\u0bb2 \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bbe\u0bb3\u0bbe\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd 2 \u0b86\u0bae\u0bcd \u0bb5\u0bbf\u0bc8\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bcd\u0b95\u0bbe\u0ba3\u0bcd \u0ba4\u0bc8\u0b9f\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb2\u0bcd \u0b85\u1f94\u0bae\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0ba8\u0bbf\u1fa0\u0bb5\u0ba9\u0bc6\u0bae\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd 3 \u0b86\u0bae\u0bcd \u0bb5\u0bbf\u0bc8\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bcd\u0b95\u0bbe\u0ba3\u0bcd \u0ba4\u0bc8\u0b9f\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb2\u0bcd\n\n9. \u0bc6\u0bae\u0bbe\u0bb4\u0bbf\u0ba4\u0bcd \u0bc7\u0ba4\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf :"
