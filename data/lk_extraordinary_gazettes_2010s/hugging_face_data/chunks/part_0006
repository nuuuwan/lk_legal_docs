\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 - \u0db8\u0dc4F\u0dc0\u0dbb \u2013 \u0dc3-tc\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 #\u0dd9\u0db8 \u001b \u0d9a\u0dcf\u2018\u0dc0 2 0.0383 1. \u0dc3\u0db8\u0dbbM\u0d82\u0d9c f1\u0dba \u0dd9\u0dc3p\u0dbd\u0dcf\u0dd9@ \u0dc3\u0dbb; 613604065v \u0dc3-tc\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u0dbb;\u0db1\u0dcf\u0dba\u0d9a \u0dbb \u0da2 \u0dc3\u0db8\u0dbbM\u0d82\u0d9c \u0dc3\u0db8 \u0d85\\\u001b\u0dba f1\u0dba \u0dd9\u0dc3p\u0dbd\u0dcf\u0dd9@ 2. \u0d9a\u017e!\u0da7 \u0daf\u0dc4\u0db1\u0dcf\u0dba\u0d9a f\u0daf0\u0dd9@ \u0dbbZ\u0dab 716811514v \u0db4$\u0db8\u0da0 \u2022\u0dcf \u0dd9\u0dc4p\u0db8\u0db8\u0dcf\u0178 \u0dbb;\u0db1\u0dcf\u0dba\u0d9a \u0d85\u0d82\u0d9a31/5, \u0ddb\u0db8;4 \u0db8\u0dcf\u0dc0\u0dad, \u0dba\u0db1 \u0d85\u0dba\u0dd9@ \u0dc0\u0da7z\u2022\u0dc0, \u0db8\u0dc4F\u0dc0\u0dbb \u2022 \u0dad \u201cG\u001b\u0dba\u0da7 \u0dba\u0da7;\u0dc0 \u0dc4\u0dcf \u0d9a\u0dd0\u0db60 \u0d85\u0d82\u0d9a 65 . \u0db8\u0dcfc\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\\\u001b\u0dba \u0dc3\u0db8\u0d9f, \u0db8\u0dc4F\u0dc0\u0dbb \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0db8\u0d9f \u0d87\u001b\u0d9a\u0dbb\u0d9c; (\u0dbb\u0dc0 1 \u2020 \u0192\u0db8\u0da7 \u0dba\u0da7;\u0dc0 3 0.0197 \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 - \u0db8\u0dc4F\u0dc0\u0dbb \u2013 \u0dc3-tc\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 \u0db8\u0dcfc\u0d9c\u0dba 6 0.0651 1. \u0dd9\u0dad \u0db1\u0dd9\u0d9aH f1\u0dba \u0dd9\u0dc3p\u0dbd\u0dcf\u0dd9@ 545333333v \u0dc3-tc\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u0d9a\u0dd0\u0db60 \u0d85\u0d82\u0d9a 65 . \u2013 \u0da2\u0dba\u0192 \u0daf\u0dbb \u0db8\u0dd0\u20ac\u0dd9G \u0dc3\u0db8 \u0d85\\\u001b\u0dba \u0db8\u0dcfc\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf 2. \u0daf\u0dc3\u0db1\u0dcf\u0dba\u0d9a \u0dbb\u0dcf\u0dbd\u0dbd\u0dcf\u0dd9@ \u0db7\u0dcf\u0dbb\u0dad \u0dbb#\u0d9a 801200117v \u0d85\\\u001b\u0dba \u0dc3\u0db8\u0d9f \u0dbb\u0dabM\u0d82\u0d9c \u0da2\u0dbd\u0db1\u0dbd, h0 \u0d85\u0d82\u0d9a48/\u0d92, \u0ddb\u0db8\u00a1 \u0db8\u0dcf\u0dc0\u0dad, 1 \u0dc0\u0db1 \u00a2\u0dc4\u0dd0 \u0dc3\u0dc4 \u0db4\u0161\u0db8\u0d9c, \u0dc0\u0da7z\u2022\u0dc0, \u0db8\u0dc4F\u0dc0\u0dbb h\u0dbb\u0d9a\u0dae\u0db1 \u00a2\u0dc4\u0dd0 \u0d871\u0dd9- \u0d85\\\u001b\u0dba \u0dc3\u0dc4 \u0db8\u0dc4F\u0dc0\u0dbb \u0db1\u0d9c\u0dbb\u0dcf|\u0db4\u001b \u0dc3\u0db8\u0d9f \u0d87\u001b (\u0dbb\u0dc0 1 \u2020 \u0192\u0dd9- \u0dd9\u0d9a) \u0dd9$#\u0dc0\u0dbd\u0da7 \u0dba\u0da7;\u0dc0\n\n20 A III \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 : \u0001 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007\u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0dba \u0dba \u0dba \u0dba - 2019201920192019.10101010.10101010\n\n\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba \u2013 (\u0dc3-\u0db6 |\u0dad\\\u0dc3-\u0db6 |\u0dad\\\u0dc3-\u0db6 |\u0dad\\\u0dc3-\u0db6 |\u0dad\\) (\u0dc1\u0dca\u0da0\u0dba \u0dc3\u0dc4 \u0dba- \u0dd9\u0dc1p\u0dc2 \u0dd9\u0dc4H \u0d89 \u0dd9\u0da2 \u0dc2 \u0dad\u0dc4\u0db1- \u0dd9\u0db4q$\u0d9c0\u0d9a \u0d89\u0da9- \u0dc1\u0dcf\u0