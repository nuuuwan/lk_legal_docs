a\u0bb0\u1fb1\u0b95\u1fc0 \u0b95\u1fc0 \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014-- 87 0.0506 \u0b95\u1f8c\u0ba9\u0bbe\u0baf\u0b95\u0bc7\u0b95 \u0ba8\u0bbf\u0bb7\u0bbe\u0ba9\u0bbf \u0bc7\u0bae\u0bbe\u0bbf\u0baf\u1fb9 665861201v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u1fb7\u0ba4\u0bbf \u2013 \u0bae\u0bc7\u0ba9\u0bbe\u0bbe\u0bbf \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b87\u0bb2. 594/\u0b8e\u0b83\u1fba, \u0b9a\u0ba4\u0bbe\u0b9a\u0bb0\u0ba9 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 88 0.0485 \u0b95\u1f8c\u0ba9\u0bbe\u0baf\u0b95\u0bc7\u0b95 \u0bc6\u0b95\u1fbf\u0bae\u0bbf \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0bb8\u0bbe\u1fb8\u0ba4 692102460v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe ''\u0b9a\u0bbf\u0b9a\u0bbf\u0bb2\u0bbe'', \u0bc7\u0bb2\u1fb0 \u1faa\u0ba4\u0bbf, \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 89 0.1751 \u0b95\u1f8c\u0ba9\u0bbe\u0baf\u0b95\u0bc7\u0b95 \u1fc4\u0bc6\u0b9f\u0bb2\u0bbe \u0bae\u0bbe\u0bbe\u0bbf 637590855v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u1f81\u1f99\u1f90\u0ba9\u0bc0 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b87\u0bb2. 594 / \u0b88, \u0b9a\u0ba4\u0bbe\u0b9a\u0bb0\u0ba9 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 92 0.0517 \u0bb5\u1fbd\u0ba9\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bb2\u0bc7\u0b95 \u1f86\u0b9a\u0bbf\u0ba4\u0bbe 817140491v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bb5\u1fbd\u0ba9\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u2013 \u0bc6\u0bae\u1fb7\u0ba4\u0bbf\u0ba9\u0bc0 \u0bc6\u0b95\u0bbe\u1fc4\u0ba4\u0bbe \u0bc7\u0bae\u0bbe\u0bbf \u0b95\u1fbd\u1fb5\u1f9f\u1fb5 \u0b87\u0bb2. 575 / \u0b8f / 1, \u1f86\u0bb5\u0bbf\u0ba9\u0bc0\u0ba4\u0bbe \u0bc6\u0b95\u0bbe\u1fc4\u0ba4\u0bbe ''\u0bc6\u0bae\u1fb7\u0b9a\u0bbf\u0bbe\u0bbf'', \u0b9a\u0ba4\u0bbe\u0b9a\u0bb0\u0ba9 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0b87\u0bb2. 9156 \u0bae\u1fbe\u1fa0\u1fbb 2018.09.11 \u0ba4\u0bbf\u0ba8\u0ba4\u0bbf \u1f81\u1fb7\u0ba4\u0bc8\u0b95 \u0b92\u1fba\u0baa\u1fb8\u0ba4\u1fb7\u0ba4\u0bbf\u1fb9 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 96 0.0515 \u0b95\u1f8c\u0ba9\u0bbe\u0baf\u0b95\u0bc7\u0b95 \u0ba8\u0bbf\u1fc3\u0b95\u0bbe \u0baa\u0bbf\u0bb0\u0bc7\u0baa\u0bbe\u0ba4\u0bbf 927980231v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 98 \u0b87\u1fb9 \u2013 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 123, \u0b95\u1fbf\u0bb2\u0bc8\u0bb1\u0baf\u0bbf\u1fbf \u1faa\u0ba4\u0bbf, \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b95\u0bbf\u0bbe\u0bbf\u0bc6\u0bae\u1f8a\u0baf\u0bbe\u0ba9, \u1fa4\u1f8e\u0bb5\u0bbf\u0bb2 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0b95\u1f8c\u0ba9\u0bbe\u0baf\u0b95\u0bc7\u0b95 \u1fb0\u0bc6\u0bb2\u1fb5\u0bb5\u0bbf\u1fb9 \u0ba8\u0bbf\u0bae\u1fbf \u0b86\u1fb0\u0bb5\u0baf\u0bbf\u0ba9\u1fb2 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 99 0.1195 \u0b95\u1f8c\u0ba9\u0bbe\u0baf\u0b95\u0bc7\u0b95 \u1f9e\u0bb5\u0bbf\u0ba9\u0bbe \u0bae\u0bbf\u0bc7\u0ba9\u0bbe\u0bb7\u0bbf 957520766v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u1f8c\u0ba9\u0bbe\u0baf\u0b95\u0bc7\u0b95 \u2013 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0bc7\u0b9c\u0bbe\u1fb9 \u0bb5\u0bbf\u1fb0\u0bae\u1fb9 \u0b87\u0bb2. 580/\u0b8f, ''\u0bc6\u0bb2\u0bbe\u0bc6\u0bb0\u1fb5\u0bc7\u0b9f\u0bbe''', \u0b86\u1fb6\u0b9f\u0ba9\u0bbf \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b9a\u0ba4\u0bbe\u0b9a\u0bb0\u0ba9 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u0bae\u1fbe\u1fa0\u1fbb \u0bb0\u1f90\u0b95\u0bae\u0bc7\u0b95 \u0baa\u0bbf\u0bb0\u0b9a\u1fb8\u0ba4\u0bbe \u0bc6\u0bb9\u0bb2\u1fb9 \u0bae\u1fbf\u0b95\u0bbe\u1fb8\u0ba4\u0bbf \u0baa\u1fbd\u0ba9\u0bbe\u1fb8\u1f90 \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.09.02\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u