b\u0dca/265. \u0daf\u0dd0\u0daf\u0dd4\u0dbb\u0dd4 \u0d94\u0dba \u0da2\u0dbd\u0dcf\u0dc1 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc0\u0db8\u0dca \u0d87\u0dbd \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0d9a\u0dca\u0dd9\u0dc0\u0db1 \u0d89\u0da9\u0db8\u0dca \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0db6\u0dd0\u0dc0\u0dca, 1964 \u0d85\u0d82\u0d9a 28 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca (\u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0db1) \u0db4\u0db1\u0dd9\u0dad\u0db1\u0dca \u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dd9\u0dad\u0dca 7 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dd9\u0dba\u0dca (1) \u0dc0\u0dd0\u0db1\u0dd2 \u0d8b\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db8\u0dd2.\n\n\u0dbd\u0db6\u0dcf\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u0ddc\u0dd9\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0db1 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb :- \u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0dcf\u0dd9\u0dad\u0dca \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca \u0dd9\u0d9a\u0ddc\u0dd9\u0db6\u0dba\u0dd2\u0d9c\u0dd9\u0db1\u0dca \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca \u0d85\u0d82\u0d9a 1311 - \u0dd9\u0dc4\u0ddc\u0dc5\u0db9\u0dbd\u0dd1\u0dc0 \u0d9c\u0dcf\u0db8 \u0db1\u0dd2\u0dc5\u0db0\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0dd9\u0db8\u0dca \u0dd9\u0dc4\u0ddc\u0dc5\u0db9\u0dbd\u0dd1\u0dc0 \u0d9c\u0dd9\u0db8\u0dca, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0db8\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd3 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dd9\u0dba\u0dbd \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9c\u0db8\u0dca \u0db4\u0dd2\u0db9\u0dd4\u0dbb\u0dd4 \u0d85\u0d82\u0d9a 1651\u0dc4\u0dd2, \u0d85\u0dad\u0dd2\u0dd9\u0dbb\u0dca\u0d9a \u0d85\u0d82\u0d9a 03, \u0db4\u0dad \u0d85\u0d82\u0d9a 05 \u0dc4\u0dd2 \u0db4\u0dc4\u0dad \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d89\u0da9\u0db8\u0dca 1. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 174 - \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba - \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba : \u0dbb\u0da2\u0dba - \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.0020\n\n\u0d8b\u0dad\u0dd4\u0dbb\u0da7 : \u0db4\u0dc4\u0dc5 \u0dd9\u0d9a\u0ddc\u0dd9\u0db6\u0dba\u0dd2\u0d9c\u0dd9\u0db1\u0dca \u0d9c\u0db8 (\u0d85.\u0d9c.\u0db4\u0dd2. 1649), \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7 : \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 175, \u0daf\u0d9a\u0dd4\u0dab\u0da7 : \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 184, \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7 : \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 178. 2. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 175 - \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba - \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba : \u0dbb\u0da2\u0dba - \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.0125\n\n\u0d8b\u0dad\u0dd4\u0dbb\u0da7 : \u0db4\u0dc4\u0dc5 \u0dd9\u0d9a\u0ddc\u0dd9\u0db6\u0dba\u0dd2\u0d9c\u0dd9\u0db1\u0dca \u0d9c\u0db8 (\u0d85.\u0d9c.\u0db4\u0dd2. 1649), \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7 : \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 176, \u0daf\u0d9a\u0dd4\u0dab\u0da7 : \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 185 \u0dc3\u0dc4 184, \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7 : \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 174. 3. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 176 - \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba - \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba : \u0dbb\u0da2\u0dba - \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.0019 \u0d8b\u0dad\u0dd4\u0dbb\u0da7 : \u0db4\u0dc4\u0dc5 \u0dd9\u0d9a\u0ddc\u0dd9\u0db6\u0dba\u0dd2\u0d9c\u0dd9\u0db1\u0dca \u0d9c\u0db8 (\u0d85.\u0d9c.\u0db4\u0dd2. 1649) \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7 : \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 177, \u0daf\u0d9a\u0dd4\u0dab\u0da7 : \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 22A \u0dc3\u0dc4 185, \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7 : \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 184 \u0dc3\u0dc4 175. 4. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 178 - \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba - \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba : \u0dbb\u0da2\u0dba - \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.1895"
