95\u0bbe\u0b95\u0bc6\u0bb0\u1fbf\u0bb2 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 266 0.0275 \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1fbd \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 264, 265 \u1fbe\u1f81 \u0baa\u0bbf\u0bb0\u0bc7\u0bb5\u0b9a\u0bbf\u1fba\u0baa- \u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 10 - 339/17\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b8e\u0ba9\u1fb0\u1f81\u0bbe\u0bbf\u1fb7\u0ba4\u0bbe\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0ba4\u1fb7\u1f90\u0bb5\u1fb1\u0b95\u0bb3\u0bbf\u1fb9\n\n\u0baa\u0baf\u0bc8\u0ba9\u1fb0\u0bc6\u0b95\u0bbe\u1fb6\u1f8c\" \u0b95\u0bc0\u0bc7\u0bb4 \u0b92\u1fba\u0baa\u0bae\u0bbf\u1fb5\u1f8c\u1fc0\u0bb3 \u0ba8\u0bbe\u1fb9\" 1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 12 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9\n\n\u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u1fb9\u0baa\u1f8a 2012.07.11 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf 1766/21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u1fbf \u0b89\u0bbe\u0bbf\u0baf \u1f99\u0bc8\u0bb1\u0baf\u0bbf\u1fbf \u0bc6\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u0b9f\u1fba\u0baa\u1fb5\u0b9f\u1f90\u1fbb, \u0b95\u0bbe\u0ba3\u0bbf\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\n\n\u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0b95\u0bc8\u0bb3\u1fb0 \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u1fb9\u0bb1\u1f90\u0bae\u0bbe\u0ba9 42/0251 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u1fa2\u1fbf \u1f81\u0bb1\u0bbf\u1fba\u1f96\u1f8c \u0bc6\u0b9a\u1fbc\u0baf\u1fba\u0baa\u1fb5\u0b9f \u0bb5\u0b9f\u0bc7\u0bae\u1fbf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u1fb7\u0ba4\u0bbf\u1fbf\" \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf\n\n\u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0bbe\u0bbf\u0ba4\u0bc0\u0b95\u0bae \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf, \u0b87\u0bb2. 546 - \u0baa\u0bb2\u0bb5\u1fb7\u0ba4\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u0baa\u0bb2\u0bb5\u1fb7\u0ba4\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf\n\n\u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\u1f90\u1fbb 420176 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 03 \u0b87\u1fbf \u0b85\u0b9f\u1fb1\u0b95\u0bbf\u1f9c\u1fc0\u0bb3\u1f90\u0bae\u0bbe\u0ba9 224, 225, 226, 227, 228,\n\n229, 230, 383, 410, 411, 412, 413, 416, 417, 441, 442, 443, 444, 445, 446 \u0bae\u1fbe\u1fa0\u1fbb 447 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb1\u0b95\u0bc8\u0bb3\u1fb0 \u0bc6\u0b95\u0bbe\u1fb6\u0b9f\n\n\u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u1fa6\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb7 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b87\u0ba4\u0bc7\u0ba9\u0bbe\u1f8c \u0b87\u0bc8\u0ba3\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf \u0ba4\u0bb0\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b8e\u0ba9\u1f90 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4\n\n\u0b87\u1fb7\u0ba4\u0bbe\u1fbf \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u1f90\u0b95\u0bbf\u1fb9\u0bc7\u0bb1\u1fb9.\n\n\u0baa\u0bbf.\u0b8e\u1fbb.\u0b8e\u1fb2. \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u1fbd\u0bb7\u0ba9\u0bbf,\n\n\u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd.\n\n(\u0b95\u0b9f\u0bc8\u0bae\u0bc8\u0baf \u0b95\u0bb5\u0ba9\u0bbf\u1fb7\u0ba4\u1fbf)\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fbb,\n\n\u0b87\u0bb2. 1200/6, \u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4 \u0bc6\u0bae\u1f90\u0bb0\u201d,\n\n\u0b87\u0bb0\u0b9c\u0bae\u1fbf\u0bb5\u1fb7\u0ba4 \u1faa\u0ba4\u0bbf,\n\n\u0baa\u1fb7\u0ba4\u0bb0\u1f99\u1fbf\u0bc8\u0bb2,\n\n2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0b93\u0b95\u1fb7\u1f90 \u0bae\u0bbe\u0ba4\u1fbb 22 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf.\n\n19 A"
