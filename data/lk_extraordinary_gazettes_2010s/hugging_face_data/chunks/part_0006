b0\u0bbe 702753627v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bb0\u0bbe\u0bc7\u0bb5 \u2013 \u0b95\u0bbf\u1fb1 \u0b92\u0baf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4 \u0b87\u0bb2. 01, \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u0ba4\u1fb9\u0ba4\u0bbf\u0bbe\u0bbf\u0bc7\u0b95 \u0ba8\u1fbc\u0ba9\u0bae\u0b9f\u0bae, \u0ba8\u1fbc\u0ba9\u0bae\u0b9f\u0bae \u0bbe\u0bc0\u0b9f\u0bbe \u0bb5\u0baf\u0bb2\u1fb5 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 77 0.0746 \u0b87\u1f90\u1f9e\u0bb5 \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u1fb9 702231108v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0bc7\u0baa\u1fbb \u0bb0\u1fb4\u0b9c\u0bbf\u1fb7 \u0bc6\u0b9c\u0bb0\u0bbe\u1fb5 \u0b85\u1fba\u1f97\u0bb9\u0bbe\u0bae\u0bbf \u0b87\u0bb2. 277/\u0b8f, \u0b95\u0bbf\u1fb1 \u0b92\u0baf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u0ba8\u1fbc\u0ba9\u0bae\u0b9f\u0bae, \u0ba8\u1fbc\u0ba9\u0bae\u0b9f\u0bae 78 0.0550 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u1f81\u0bae\u0bbe\u0bb0\u0bc7\u0b95 \u1f9e\u0bb7\u0bbe\u1fb9 803160139v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 98 \u0b87\u1fb9 \u2013 \u0bae\u0bbe\u1fa2 \u1f86\u0bae\u0bbf\u1fb8\u0ba4 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 277/\u0b8f, \u0b95\u0bbf\u1fb1 \u0b92\u0baf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u0ba8\u1fbc\u0ba9\u0bae\u0b9f\u0bae, \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0ba8\u1fbc\u0ba9\u0bae\u0b9f\u0bae 79 0.0420 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u1f81\u0bae\u0bbe\u0bb0\u0bc7\u0b95 727591141v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 98 \u0b87\u1fb9 \u2013 \u0b9a\u1fb8\u0ba4\u0bbf\u0bae\u0bbe\u1fa2 \u0b95\u0bc0\u0ba4\u0bbe\u0ba9\u0bbf \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 277/\u0b8f, \u0b95\u0bbf\u1fb1 \u0b92\u0baf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u0ba8\u1fbc\u0ba9\u0bae\u0b9f\u0bae, \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0ba8\u1fbc\u0ba9\u0bae\u0b9f\u0bae 86 0.1138 \u0b87\u1fa2\u1fba\u1f97\u1fa2 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0b89\u0bc7\u0baa\u1fb8\u0ba4\u0bbf\u0bb0 810440210v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b87\u1fa2\u1fba\u1f97\u1fa2 \u2013 \u1f86\u0bc6\u0baa\u1f90\u1fbb \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0b8e\u1fb9\u0b9f\u0ba9\u0bc0 \u0b87\u0bb2. 282/\u1f96, \u0bc6\u0bb5\u0ba4 \u0ba8\u0bbf\u0bb5\u0bbe\u0bb7, \u0bc6\u0baa\u0ba9\u0bbf\u0bc7\u0b9f\u0bbe \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u0ba8\u1fbc\u0ba9\u0bae\u0b9f\u0bae, \u0bae\u1fbe\u1fa0\u1fbb \u0bae\u1f90\u0bb0\u0bc7\u0b95 \u0ba8\u1fbc\u0ba9\u0bae\u0b9f\u0bae \u0b9a\u0bbf\u1fbf\u0bb5\u0bbf\u0baf\u0bbe \u0bae\u0bbe\u0b95\u0bb0\u1fb5 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90,\n\n15 A\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.10.04\n\n\u0bc6\u0baa\u0