e\u0ba3\u1fb7\u0ba4\u0bbf\u1fbf \u0b85\u1f92\u0bb0\u0bbe\u0ba4\u1f97\u0bb0\u1fbb \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u1f92\u0bb5\u0bb0\u0b95\u1fbb \u0baa\u0bb2\u0bbe\u0ba4 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf, \u0b87\u0bb2. 240- \u0ba4\u1fbb\u0bc6\u0bae\u1fb9\u0ba9\u0bbe\u1f81\u0bb2\u0bae \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u0b86\u1fb7\u0ba4\u0bbf\u1f81\u0bb2\u0bae, \u0b86\u1fb7\u0ba4\u0bbf\u1f81\u0bb2\u0bae \"\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf \u0b87\u0bb2. 07 \u0b85\u1f94\u0bb0\u0bbe\u0ba4\u1f97\u0bb0\u1fbb \u0ba8\u0b95\u0bb0\u0bbe\u1fb5\u0b9a\u0bbf \u0bae\u1fb9\u0bb1 \u0bb5\u0bb0\u1fbb\u1f97\u0b95\u1fc0, \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf \u0b87\u0bb2. 07 \u0b85\u1f94\u0bb0\u0bbe\u0ba4\u1f97\u0bb0\u1fbb \u0ba8\u0b95\u0bb0\u0bbe\u1fb5\u0b9a\u0bbf \u0b8e\u1fbf\u0bc8\u0bb2\u1fb0\u1f81\u1fc0 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\u1f90\u1fbb 110196 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 10 \u0b87\u1fbf \u0b85\u0b9f\u1fb1\u0b95\u0bbf\u1f9c\u1fc0\u0bb3\u1f90\u0bae\u0bbe\u0ba9 3 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb1\u0b95\u0bc8\u0bb3\u1fb0 \u0bc6\u0b95\u0bbe\u1fb6\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u1fa6\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb7 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b87\u0ba4\u0bc7\u0ba9\u0bbe\u1f8c \u0b87\u0bc8\u0ba3\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf \u0ba4\u0bb0\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b8e\u0ba9\u1f90 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0b87\u1fb7\u0ba4\u0bbe\u1fbf \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u1f90\u0b95\u0bbf\u1fb9\u0bc7\u0bb1\u1fb9.\n\n\u0baa\u0bbf\u0baa\u0bbf\u0baa\u0bbf\u0baa\u0bbf.\u0b8e\u1fbb\u0b8e\u1fbb\u0b8e\u1fbb\u0b8e\u1fbb.\u0b8e\u1fb2\u0b8e\u1fb2\u0b8e\u1fb2\u0b8e\u1fb2. . . . \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u1fbd\u0bb7\u0ba9\u0bbf\u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u1fbd\u0bb7\u0ba9\u0bbf\u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u1fbd\u0bb7\u0ba9\u0bbf\u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u1fbd\u0bb7\u0ba9\u0bbf, \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd. (\u0b95\u0b9f\u0bc8\u0bae\u0bc8\u0baf \u0b95\u0bb5\u0ba9\u0bbf\u1fb7\u0ba4\u1fbf) \u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fbb, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4 \u0bc6\u0bae\u1f90\u0bb0\u201d, \u0b87\u0bb0\u0b9c\u0bae\u1fbf\u0bb5\u1fb7\u0ba4 \u1faa\u0ba4\u0bbf, \u0baa\u1fb7\u0ba4\u0bb0\u1f99\u1fbf\u0bc8\u0bb2, 2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0b93\u0b95\u1fb7\u1f90 \u0bae\u0bbe\u0ba4\u1fbb 02 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf.\n\n\u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95\n\n\b \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000f\u0010\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0013 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0016 \u0d9c\u0dd0\u0dc3 \u0db4 \u0dba\n\n\u0d85\u0018 \u0019\u0dd9\u0dc1\u0dc2\u0d85\u0018 \u0019\u0dd9\u0dc1\u0dc2\u0d85\u0018 \u0019\u0dd9\u0dc1\u0dc2\u0d85\u0018 \u0019\u0dd9\u0dc1\u0dc2 \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90\n\n(\u0b85\u0bb0\u0b9a\u0bbe\u1fb1\u0b95\u1fb7\u0ba4\u0bbf\u1fb9 \u0b85\u0ba4\u0bbf\u0b95\u0bb