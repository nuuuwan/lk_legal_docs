\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf, \u0b9a\u0bbf\u0ba4\u0bcd\u0bb0\u0bbe \u0bb0\u0b9e\u0bcd\u0b9c\u0ba9\u0bbf\n\n\u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b9c\u0bae\u0bcd\u0baa\u0bb2\u0b95\u0bb8\u0bcd\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c 107 ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 :\n\n\u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 107 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa).\n\n107. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 107 - \u0b9c\u0bae\u0bcd\u0baa\u0bb2\u0b95\u0bb8\u0bcd\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0052 \u0bc6\u0bb9\u0b95\u0bcd\u0bc7\u0b9f\u0baf\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 :\u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa) \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 106 ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 106, \u0bc7\u0b95.\u0b8f.\u0b9c\u0bbe\u1fa2\u0bb8\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bb2\u0bb5\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf, \u0bae\u0bbe\u0ba4\u0bb0\u0bc7\u0b95 \u0baa\u0ba8\u0bcd\u1f90\u0bae\u0ba4\u0bbf \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bb5\u0bbf\u0bb2\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 108 ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 108 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa). 108. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 108 - \u0bb5\u0bbf\u0bb2\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0060 \u0bc6\u0bb9\u0b95\u0bcd\u0bc7\u0b9f\u0baf\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa) \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 107 ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 107, \u0b9a\u0bbf\u0ba4\u0bcd\u0bb0\u0bbe \u0bb0\u0b9e\u0bcd\u0b9c\u0ba9\u0bbf \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b9c\u0bae\u0bcd\u0baa\u0bb2\u0b95\u0bb8\u0bcd\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf\u0baa\u0b95\u0bc1\u0ba4\u0bbf; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf, \u0bae\u0bbe\u0ba4\u0bb0\u0bc7\u0b95 \u0bc7\u0bb9\u0bae\u0baa\u0bbe\u0bb2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bb5\u0bbf\u0bb2\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 109 ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 109 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa).\n\n109. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 109 - \u0bb5\u0bbf\u0bb2\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0053 \u0bc6\u0bb9\u0b95\u0bcd\u0bc7\u0b9f\u0baf\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa) \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 108 ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 108, \u0bae\u0bbe\u0ba4\u0bb0\u0bc7\u0b95 \u0baa\u0ba8\u0bcd\u1f90\u0bae\u0ba4\u0bbf \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bb5\u0bbf\u0bb2\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf, \u0bae\u0bbe\u0ba4\u0bb0\u0bc7\u0b95 \u0b95\u0baa\u0bbf\u0bb2 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bb5\u0bbf\u0bb2\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 110 ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 110 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa).\n\n110. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 110 - \u0bb5\u0bbf\u0bb2\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0112 \u0bc6\u0bb9\u0b95\u0bcd\u0bc7\u0b9f\u0baf\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa) \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 109; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 109 , \u0bae\u0bbe\u0ba4\u0bb0\u0bc7\u0b95 \u0bc7\u0bb9\u0bae\u0baa\u0bbe\u0bb2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bb5\u0bbf\u0bb2\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf, \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bbe\u0bae\u0bcd \u0b92\u1fa8\u0b99\u0bcd\u0bc8\u0b95 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 111 ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 111 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf (\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa)."
