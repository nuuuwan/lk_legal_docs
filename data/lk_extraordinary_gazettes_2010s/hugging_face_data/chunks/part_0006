89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 219 0.0788 \u0bc7\u0baa\u0bbe\u1f9e\u0bc6\u0ba4\u0bbe\u0b9f\u0bc7\u0b95 \u0bae\u0bb5\u0bbf\u1fb9 \u0bc6\u0bb2\u1fc4\u1fa2 660463534v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 217 \u2013 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0bae\u1fbe\u1fa0\u1fbb 218 \u0b87\u1fb9 \u0b87\u0bb2. 219 \u0b8e\u1fba, \u0bae\u1fb7\u0ba4\u0bbf\u0baf \u0ba8\u1fbc\u0ba9\u0bae\u0b9f\u0bae, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0ba8\u1fbc\u0ba9\u0bae\u0b9f\u0bae \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 237 0.0508 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0bc7\u0baa\u0bbe\u1f9e\u0bc6\u0ba4\u0bbe\u0b9f\u0bc7\u0b95 772432577v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 231 \u0b87\u1fb9 \u2013 \u0bc6\u0baa\u1fc4\u1fa2 \u0b87\u1fb8\u0ba4\u0bbf\u0b95 \u0bae\u0bc7\u0bb9\u1fc3 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 267 \u1f96, \u0bc7\u0bae\u1fbe\u1f81 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bc6\u0b95\u0bbe\u0bb3\u0bbf\u1fb9\u0b9c\u0bbe\u1f8a\u0baf, \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bb5\u1fbd\u0ba3\u1f81\u0bb2 \u0baa\u0b9f\u0bc6\u0baa\u0ba4\u0bbf\u0bc7\u0b95 \u0bc6\u0b9c\u0bb0\u0bbe\u1fb5 \u0bc6\u0bb0\u0b9c\u0bbf\u0bc7\u0ba9\u0bbe\u1fbf\u1fb5 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0baa\u0bbe\u0bbf\u1f86 \u0bb5\u0bb4\u1fb1\u1f81\u0ba9\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b95\u0bbe\u0bb2\u1fbb \u1f99\u1fa8\u0bb5\u1f90\u1fbb \u0baa\u0bbe\u0bbf\u1f86 \u0bc6\u0baa\u1fa0\u0ba9\u0bb0\u0bbe\u1fbf \u0b89\u1fb7\u0ba4\u0bb0\u0bb5\u0bbe\u0ba4 \u0b85\u0bc8\u0b9f\u0bae\u0