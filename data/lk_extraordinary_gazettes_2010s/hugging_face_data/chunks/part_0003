db6\u0db3 \u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0dca\u0dad\u0dbb\n\n(\u0dd9\u0dc4G\u0da7\u0dba\u0dcfe)\n\n11 0.0115 \u2026$\u0d9c0\u0d9a \u2013 \u0dc3-se\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 \u0d9a\u0dd0.\u0d85. 14 \u0da7 \u0d9a\u0dd0\u0db6=\u0dbd\u0da7 \u0007\u0dd9i\u0dc1 ^\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 16 0.0180 \u2026$\u0d9c0\u0d9a \u2013 \u0dc3-se\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 \u0d9a\u0dd0.\u0d85.109 \u0dc3\u0dc4 111 \u0da7 \u0007\u0dd9i\u0dc1 ^\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 19 0.0026 \u2026$\u0d9c0\u0d9a \u2013 \u0dc3-se\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 \u0d9a\u0dd0.\u0d85. 20 \u0da7 \u0007\u0dd9i\u0dc1 ^\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\n\n28 A III \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 : \u0001 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007\u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0dba \u0dba \u0dba \u0dba - 2019201920192019.05050505.30303030\n\n\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba \u2013 (\u0dc3-\u0db6 \u2020\u0dad`\u0dc3-\u0db6 \u2020\u0dad`\u0dc3-\u0db6 \u2020\u0dad`\u0dc3-\u0db6 \u