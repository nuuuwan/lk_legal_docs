9\u0bbe \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0bae\u0bb9\u0bb0 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf 300 - \u1f97\u1fb7\u0baa\u0bbf\u1f8a\u0baf \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u1f97\u1fb7\u0baa\u0bbf\u1f8a\u0baf \u0b8e\u1f94\u1fbb \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf, 510803 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 02 \u0b87\u1fbf 229 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8a\u1fb9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b85\u1fc2\u0bb5\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf,\n\n\u201c\u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u0ba9\u1f90 \u0bb5\u1f81\u1fba\u1f97\u1fbb \u0b87\u0baf\u1fbf\u1f97\u1fbb\u201d \u0b8e\u1fb9\u1f94\u1fbb \u0ba8\u0bbf\u0bb0\u1fa2\u1fbf \u0b89\u1fc0\u0bb3\u0b9f\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3\n\n\u201c2\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u201c \u0b8e\u1fb9\u0baa\u1f90 \u0ba8\u0bc0\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c \u201c1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97\u201d \u0b8e\u1fb9\u1fa0 \u0b89\u1fc0\u0bb3\u0b9f\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c \u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fba\u0baa\u1f8c\u0ba4\u1fbf \u0bc7\u0bb5\u1fb6\u1f8c\u1fbb.\n\n\u0bc7\u0b95.\u0b8f.\u0bc7\u0b95. \u0bb0\u1fb4\u0b9a\u0bbf\u1fb7 \u0ba4\u1fbd\u0bae\u0baa\u0bbe\u0bb2, \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd. (\u0baa\u0ba4\u0bbf\u1fbf \u0b95\u0b9f\u0bc8\u0bae \u1f97\u0bbe\u0bbf\u0baa\u0bb5\u1fbd)\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fbb, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4 \u0bc6\u0bae\u1f90\u0bb0\u201d, \u0b87\u0bb0\u0b9c\u0bae\u1fbf\u0bb5\u1fb7\u0ba4 \u1faa\u0ba4\u0bbf, \u0baa\u1fb7\u0ba4\u0bb0\u1f99\u1fbf\u0bc8\u0bb2, 2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0b93\u0b95\u1fb7\u1f90 \u0bae\u0bbe\u0ba4\u1fbb 20 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf.\n\n09 - 173\n\n\u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95\n\n(\u0b85\u0bb0\u0b9a\u0bbe\u1fb1\u0b95\u1fb7\u0ba4\u0bbf\u1fb9 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u1fb7\u1f90\u0b9f\u1fb9 \u0baa\u0bbf\u0bb0\u1f86\u0bbe\u0bbf\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f\u1f90)\n\n\u0002 \u0dbd\u0d82\u0d9a\u0dcf \u0007\u0da2\u0dcf\u0dad\u0dcf \u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0dba\n\n\u0d85\u0018 \u0019\u0dd9\u0dc1\u0dc2 \u0b85\u0ba4\u0bbf\u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90\n\n\u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0b85\u0bb0\u0b9a\u0bbe\u1fb1\u0b95 \u0b85\u1fb2\u1f86\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0ba4\u0bbf\u1fba\u0baa\u0bbf\u1fb0\u0b95\u1fba\u0bc6\u0baa\u1fbe\u0bb1\u1f90.\n\n\u1f99.\u1f81. - \u0b87\u1fc2 \u0b85\u0ba4\u0bbf\u0bb5\u0bbf\u0bc7\u0bb7\u0b9f \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0bc8\u0baf www.documents.gov.lk \u0b8e\u1f94\u1fbb \u0b87\u0bc8\u0ba3\u0baf\u1fb7\u0ba4\u0bbf\u1fa2\u1f9e\u1fb8\u1f90 \u0baa\u0ba4\u0bbf\u0bb5\u0bbf\u0bb1\u1fb0\u0b95\u1fbb \u0bc6\u0b9a\u1fbc\u0baf \u1f99\u1f8a\u1f9c\u1fbb.\n\n1A - G 30803 - 14 (2019/ 08)\n\n\u0d85\u0d82\u0d9a 2137 / 71 - 2019 \u0d85\u0dd9\u0d9c,\u0dc3\u0dca. 23 \u0dc0\u0dd0/ 01\u0dbb\u0dcf\u0daf\u0dcf - 2019.08.23\n\n2137 / 71 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fbb - 2019 \u0b86\u1fbb \