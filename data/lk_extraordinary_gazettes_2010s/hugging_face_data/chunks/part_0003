u0bb5\u0b9a\u0ba4\u0bbf \u0bc6\u0ba4\u0bbe\u0bc8\u0bb2\u0bc7\u0baa\u0b9a\u0bbf \u0b95\u1fbb\u0baa\u0bbf \u0bb5\u0b9a\u0ba4\u0bbf \u0bae\u1fbe\u1fa0\u1fbb \u0b8f\u0bc8\u0ba9\u0baf \u0b85\u0bc8\u0ba9\u1fb7\u1f90 \u0bb5\u0b9a\u0ba4\u0bbf\u0b95\u0bc8\u0bb3\u1f9c\u1fbb \u0bc6\u0baa\u1fbe\u1fa0\u1fb0 \u0bc6\u0b95\u0bbe\u1fc0\u0bb5\u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 78 0.0379 \u0bb0\u0ba9\u1f90\u1fb1\u0b95 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0baa\u1fb7\u0bae\u0b9a\u0bbf\u0bbe\u0bbf 683480851v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 53 \u2013 \u0bb5\u0bbf\u1f97\u1fbf \u0bb0\u0ba9\u1f90\u1fb1\u0b95 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 441/11, \u1f87\u0bbe\u0bbf\u0baf \u0bc6\u0b9f\u0bb0\u1fc4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u1f87\u0bbe\u0bbf\u0baf\u0bc6\u0b95\u0bbe\u0b9f, \u1f99\u1f9e\u0ba4\u0bb2\u0bbe\u0bb5 \u0bae\u1fbe\u1fa0\u1fbb \u0b8f\u0bc8\u0ba9\u0baf \u0bb5\u0b9a\u0ba4\u0bbf\u0b95\u1fa6\u1fb0\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b87\u0bb2. 3067 \u0bae\u1fbe\u1fa0\u1fbb 2019.01.05 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u1f81\u1fb7\u0ba4\u0bc8\u0b95 \u0b85\u1fb7\u0ba4\u0bbe\u1fb5\u0b9a\u0bbf \u0baa\u1fb7\u0ba4\u0bbf\u0bb0\u1fb7\u0ba4\u0bbf\u1fbf \u1f81\u0bb1\u0bbf\u1fba\u0baa\u0bbf\u0b9f\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 81 0.0256 \u0bb5\u0bbe\u0bbf\u0b9a\u0bbe \u1f90\u0bb0\u0bc7\u0b95 \u0b85\u0bc7\u0bb7\u0bbe\u0b95 \u0b9a\u0bb0\u1fb7 \u1f81\u0bae\u0bbe\u0bb0 671161513v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 53 \u2013 \u0b87\u0bb2. 349 / \u0b8e\u1fba, \u0b8e\u1fbb\u0baa\u0bbf\u1fbf\u0bae\u0bc0\u0b95\u0bae \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc6\u0b9f\u0bb0\u1fc4, \u0b8e\u1fbb\u0baa\u0bbf\u1fbf\u0bae\u0bc0\u0b95\u0bae, \u0baa\u0bbf\u1fa2\u0bae\u0ba4\u0bb2\u0bbe\u0bb5 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bae\u1fbe\u1fa0\u1fbb \u0bae\u0bbf\u1fb9\u0b9a\u0bbe\u0bb0\u1fbb, \u0ba8\u0bc0\u1fbd\u0baa\u0bbe\u0b9a\u0ba9 \u0bb5\u0b9a\u0ba4\u0bbf, \u0bc6\u0ba4\u0bbe\u0bc8\u0bb2\u0bc7\u0baa\u0b9a\u0bbf \u0b95\u1fbb\u0baa\u0bbf \u0bb5\u0b9a\u0ba4\u0bbf \u0bae\u1fbe\u1fa0\u1fbb \u0baa\u0bb0\u0bbe\u0bae\u0bbe\u0bbf\u1fba\u0baa\u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0bb5\u0b9a\u0ba4\u0bbf\u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90,\n\n20 A III \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2013 \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000e\u000f\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0012 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0015 \u0d85\u0017 \u0018\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0dba \u2013 2019.06.25\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.06.25\n\n\u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3 - \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd"
