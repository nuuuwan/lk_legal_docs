MN 5-2006- A \u0b9a\u0bae\u0bcd\u0baa\u0bb3 \u0b85\u0bb3\u1fab\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b9a\u0bae\u0bcd\u0baa\u0bb3\u0bae\u0bcd \u0bc6\u0baa\u1fa0\u0bae\u0bcd \u0b85\u0bc8\u0ba9\u0ba4\u0bcd\u1f90 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bc7\u0baf\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd\u0b95\u1fa6\u0bae\u0bcd \u0ba4\u0bbe\u0baa\u0ba9 \u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bcd \u0bc7\u0b95\u0bbe\u0bc8\u0bb5\u0baf\u0bbf\u0ba9\u0bcd VII \u0b86\u0bae\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 04 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u1f8c\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u1f9e\u0bae\u0bbe\u1fa0 \u0b89\u0bb3\u0bcd\u0bb3\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u1f97\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u1f8c\u0bb5\u0bb0\u0bcd. \u0b85\u0ba8\u0bcd\u0ba4\u0ba8\u0bcd\u0ba4 \u0baa\u0ba4\u0bb5\u0bbf\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bbf\u0baf\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b85\u1f8a\u0baa\u0bcd\u0baa\u0bc8\u0b9f\u0baf\u0bbf\u0bb2\u0bcd \u0bc7\u0b9a\u0bc8\u0bb5\u0b95\u0bcd \u0b95\u0bbe\u0bb2\u0bae\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd. \u0b86\u0baf\u0bbf\u1f94\u0bae\u0bcd, \u0b89\u0bb3\u0bcd\u0bb3\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u1f97 \u0b95\u0bbe\u0bb0\u0ba3\u0bae\u0bbe\u0b95 \u0b8f\u0bb1\u0bcd\u1f97\u0bc8\u0b9f\u0baf \u0b86\u0b9f\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b9a\u0bae\u0bcd\u0baa\u0bb3 \u0b8f\u0bb1\u0bcd\u0bb1\u0ba4\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bae\u0bcd \u0ba8\u0bbf\u0b95\u0bb4\u0bbe\u1f90 \u0b85\u0ba8\u0bcd\u0ba4\u0ba4\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0b89\u0bb3\u0bcd\u0bb3\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u1f97\u0b95\u0bcd\u0b95\u0bc1 \u1f99\u0ba9\u0bcd\u0ba9\u0bb0\u0bbe\u0ba9 \u0b9a\u0bae\u0bcd\u0baa\u0bb3 \u0b8f\u0bb1\u0bcd\u0bb1\u0ba4\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbe\u0b95 \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bae\u0bbf\u0ba9\u0bcd\u0bb1\u0bbf \u0ba8\u0bc8\u0b9f\u1f99\u0bc8\u0bb1\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bb2\u0bcd \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd. \u0b85\u0bb5\u0bcd\u0bb5\u0bbe\u0bc7\u0bb1, \u0b9a\u0bae\u0bcd\u0baa\u0bb3 \u0bae\u0bbe\u0bb1\u0bcd\u1fa0\u0bc8\u0b95\u0baf\u0bbf\u0ba9\u0bcd \u0bc7\u0baa\u0bbe\u1f90 \u0b8f\u0bb1\u0bcd\u1f97\u0bc8\u0b9f\u0baf \u0b86\u0bb3\u0bcd \u0b87\u1fa0\u0ba4\u0bbf\u0baf\u0bbe\u0b95 \u0bc6\u0baa\u0bb1\u0bcd\u1fa0\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0b9a\u0bae\u0bcd\u0baa\u0bb3 \u0baa\u1f8a\u1f99\u0bc8\u0bb1 \u1f97\u0ba4\u0bbf\u0baf \u0b9a\u0bae\u0bcd\u0baa\u0bb3 \u0baa\u1f8a\u1f99\u0bc8\u0bb1\u0bc8\u0baf \u0b92\u0ba4\u0bcd\u0ba4\u0ba4\u0bbe\u0b95 \u0b87\u1f9e\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0bb0\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0ba4\u0bbe\u0baa\u0ba9 \u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bcd \u0bc7\u0b95\u0bbe\u0bc8\u0bb5\u0baf\u0bbf\u0ba9\u0bcd VII \u0b86\u0bae\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 4.4 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bae\u0baf \u0b85\u1f8c\u0ba4\u0bcd\u1f90\u0bb5\u1f9e\u0bae\u0bcd \u0bc7\u0bae\u0bb2\u0bcd \u0b9a\u0bae\u0bcd\u0baa\u0bb3\u0baa\u0bcd \u0baa\u1f8a\u1f99\u0bc8\u0bb1\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u1fa4\u0bae\u0bcd \u0b86\u0b95\u0bbe\u1f90. (i) \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 II \u0ba4\u0bb0\u0bae\u0bcd II \u0b87\u0bb1\u0bcd\u0b95\u0bc1\n\n(\u0b85) \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 III \u0ba4\u0bb0\u0bae\u0bcd II \u0b89\u0ba4\u0bb5\u0bbf \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0bc8\u0bb2\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0ba4\u0bb5\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b86\u0b95\u0b95\u0bcd \u0b95\u0bc1\u0bc8\u0bb1\u0ba8\u0bcd\u0ba4\u1f90 10 \u0bb5\u1f9e\u0b9f \u0bc7\u0b9a\u0bc8\u0bb5\u0b95\u0bcd \u0b95\u0bbe\u0bb2\u0ba4\u0bcd\u0bc8\u0ba4 \u1f98\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0bbe\u0ba4 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bc7\u0baf\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd\u0b95\u0bb3\u0bcd.\n\n(\u0b86) \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 III \u0ba4\u0bb0\u0bae\u0bcd II \u0b89\u0ba4\u0bb5\u0bbf \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0bc8\u0bb2 \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0ba4\u0bb5\u0bbf\u0baf\u0bbf\u0bb2\u0bcd\u0b86\u0b95\u0b95\u0bcd \u0b95\u0bc1\u0bc8\u0bb1\u0ba8\u0bcd\u0ba4\u1f90 10 \u0bb5\u1f9e\u0b9f \u0bc7\u0b9a\u0bc8\u0bb5\u0b95\u0bcd \u0b95\u0bbe\u0bb2\u0ba4\u0bcd\u0bc8\u0ba4\u0baa\u0bcd \u1f98\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf \u0bc6\u0b9a\u0baf\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0bc7\u0baa\u0bbe\u0ba4\u0bbf\u1fa4\u0bae\u0bcd \u0b85\u1f99\u1fa2\u0bb2\u0bcd \u0b87\u1f9e\u0ba8\u0bcd\u0ba4 \u0bc7\u0b9a\u0bc8\u0bb5\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bae\u0bbe\u0ba3\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u1f97\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bae\u0baf \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 III \u0ba4\u0bb0\u0bae\u0bcd I \u0b87\u0bb1\u0bcd\u0b95\u0bc1 \u0baa\u0ba4\u0bb5\u0bbf \u0b89\u0baf\u0bb0\u0bcd\u1fab\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0b95\u0bc8\u0bae\u0baa\u0bcd\u0bc6\u0baa\u0bb1\u0bbe\u0ba4 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bc7\u0baf\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd\u0b95\u0bb3\u0bcd, \u0b89\u0ba4\u0bb5\u0bbf \u0bb5\u0bbf\u0bc8\u0bb2 \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bbe\u0bb3\u0bb0\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 II \u0ba4\u0bb0\u0bae\u0bcd II \u0b87\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0bb3\u0bcd\u0bb3\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u1f97\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u1f8c\u0bb5\u0bb0\u0bcd.\n\n(ii) \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 II \u0ba4\u0bb0\u0bae\u0bcd I \u0b87\u0bb1\u0bcd\u0b95\u0bc1"
