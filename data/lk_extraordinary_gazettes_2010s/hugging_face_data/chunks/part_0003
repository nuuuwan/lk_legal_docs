1\u0bae\u0bbe\u0bbe\u0bbf \u0b87\u1fbf\u0bc8\u0bb2 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 169 \u0b87\u1fb9 \u2013 \u0b95\u1fb7\u0bbe\u0bbf\u0b86\u0bb0\u1fb2\u0b9a\u0bbf \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 414 \u0b88, \u0bc7\u0bb2\u0bb2\u1fb8\u1fb5 \u1faa\u0ba4\u0bbf, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0baa\u0ba9\u0bbe\u0bc6\u0b95\u0bbe\u0bc8\u0b9f, \u0bc7\u0bb9\u0bbe\u0bae\u0bbe\u0b95\u0bae \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 196 0.0255 1. \u0bae\u0bbe\u0bc6\u0ba4\u0bbe\u0b9f \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bb2\u0bbe\u0bc7\u0b95 \u0bb5\u0b9c\u0bbf\u0bb0 197908202870 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u1f97\u1fc3\u0baa \u1f81\u0bae\u0bbe\u0bb0 \u0bae\u0bbe\u0bc6\u0ba4\u0bbe\u0b9f \u0b9a\u0bae \u0b89\u0bbe\u0bbf\u0bc8\u0bae 2. \u0b95\u0bc0\u0ba4\u0bbe \u0bae\u0bbe\u0bc6\u0ba9\u1fbf \u1f81\u0bae\u0bbe\u0bbe\u0bbf \u0b95\u1fb7\u0bbe\u0bbf 858242886v \u0b86\u0bb0\u1fb2\u0b9a\u0bbf \u0b87\u0bb2. 414/\u0b88/2, \u0bc7\u0bb2\u0bb2\u1fb8\u1fb5 \u1faa\u0ba4\u0bbf, \u0baa\u0ba9\u0bbe\u0bc6\u0b95\u0bbe\u0bc8\u0b9f, \u0bc7\u0bb9\u0bbe\u0bae\u0bbe\u0b95\u0bae 197 0.0378 \u1f9a\u0ba3\u1fb9\u1fb7\u0bbe\u0bbf\u0bc7\u0b95 \u0bb0\u1fb9\u0b9c\u0bbf\u1fb7 700910300v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0b87\u0bb2. 414/7, \u0bc7\u0bb2\u0bb2\u1fb8\u1fb5 \u1faa\u0ba4\u0bbf, \u0baa\u0ba9\u0bbe\u0bc6\u0b95\u0bbe\u0bc8\u0b9f, \u0bc7\u0bb9\u0bbe\u0bae\u0bbe\u0b95\u0bae 09-24/32\n\n28 A\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.08.19\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b8e\u0ba9\u1fb0\u1f81\u0bbe\u0bbf\u1fb7\u0ba4\u0bbe\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0ba4\u1fb7\u1f90\u0bb5\u1fb1\u0b95\u0bb3\u0bbf\u1fb9\n\n\u0baa\u0baf\u0bc8\u0ba9\u1fb0\u0bc6\u0b95\u0bbe\u1fb6\u1f8c \u0b95\u0bc0\u0bc7\u0bb4 \u0b92\u1fba\u0baa\u0bae\u0bbf\u1fb5\u1f8c\u1fc0\u0bb3 \u0ba8\u0bbe\u1fb9 1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 12 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9\n\n\u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u1fb9\u0baa\u1f8a 2012.03.01 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf 1747/23 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u1fbf \u0b89\u0bbe\u0bbf\u0baf \u1f99\u0bc8\u0bb1\u0baf\u0bbf\u1fbf \u0bc6\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u0b9f\u1fba\u0baa\u1fb5\u0b9f\u1f90\u1fbb, \u0b95\u0bbe\u0ba3\u0bbf\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\n\n\u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0b95\u0bc8\u0bb3\u1fb0 \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u1fb9\u0bb1\u1f90\u0bae\u0bbe\u0ba9 52/0622 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u