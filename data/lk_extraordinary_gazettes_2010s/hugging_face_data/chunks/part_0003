u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.07.05\n\n203 0.0261 \u0bc7\u0b95\u0bbe\u0ba9\u0bbf\u0baf\u0bbe\u0bae\u0bbe\u1fa2\u0bae\u0bc7\u0b95 \u0b9a\u0bbe\u1fb8\u0ba4\u0ba9\u0bbf \u0ba4\u0bae\u0baf\u1fb8\u0ba4\u0bbf 716502228v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. \u2013 \u0b85\u0bc7\u0baa\u0bbe\u1fb9\u1f86 520038/14/49 \u0b87\u0bb2. 172/9, \u0b8e\u1fa2\u0b95\u0bbe \u0b95\u0bbe\u1fb5\u0ba9\u0bbe, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b9a\u1fbb\u0bc7\u0baa\u0bbe\u0ba4\u0bbf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bc6\u0bb5\u0ba9\u0bbf\u0bc6\u0bb5\u1fbf\u0bc6\u0b95\u0bbe\u0bb2, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb, \u0bc6\u0baa\u0bbe\u1fbf\u0b95\u1fc4\u0b93\u0bb5\u0bbf\u0b9f \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0bc7\u0b9a\u0bae\u0bbf\u1fba\u1f97 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fbf \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 210 0.0959 \u0ba8\u0bbf\u0bb9\u0bbe\u1fbf \u0bb0\u1fb7\u0ba9\u0b9a\u0bbf\u0bbe\u0bbf \u0b85\u1fbf\u0bb5\u0bbf\u1fc4 621422014v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u1faa\u0bb0\u0b9a\u0bbf\u1fb1\u0bb9 \u0b87\u0bb2. 172/\u0b86\u1fbd/1/\u0baa\u0bbf, \u1faa\u0ba4\u0bbf\u0baf\u0bc6\u0b95\u0bbe\u0b9f \u1faa\u0ba4\u0bbf, \u0ba4\u0bbf\u0baf\u0b95\u0b9f, \u0bc6\u0baa\u0bbe\u1fbf\u0b95\u1fc4\u0b93\u0bb5\u0bbf\u0b9f 213 0.0496 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa - \u0bc7\u0bb9\u0bbe\u0bae\u0bbe\u0b95\u0bae \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 223 0.0232 \u0bc7\u0bb2\u1fb9\u1f90\u0bb5 \u0bc6\u0bb2\u0bbe\u1f81\u0bc7\u0b95 \u0ba4\u0baf\u0bbe\u0ba8\u1fb8\u0ba4 620380407v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 183 \u2013 \u0b87\u0bb2. 173/25, \u0b85\u0bb0\u1fa2\u0baf \u0b89\u0baf\u0ba9