    "doc_type": "lk_extraordinary_gazettes_2010s",
    "doc_id": "2019-12-05-2019-12-05-2152-34-en",
    "num": "2019-12-05-2152-34-en",
    "date_str": "2019-12-05",
    "description": "Sabaragamuwa Provincial Council  -   By laws of Balangoda Urban  Council",
    "url_metadata": "https://documents.gov.lk/view/extra-gazettes/egz_2019.html",
