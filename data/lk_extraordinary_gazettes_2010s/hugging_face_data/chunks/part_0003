/10, \u0ba4\u0bbf\u0baf\u0b95\u0b9f \u1faa\u0ba4\u0bbf, 520038/14/49 \u0bc6\u0bb5\u0ba9\u0bbf\u0bc6\u0bb5\u1fbf\u0bc6\u0b95\u0bbe\u0bb2, \u0bc6\u0baa\u0bbe\u1fbf\u0b95\u1fc4\u0b93\u0bb5\u0bbf\u0b9f \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 211 0.0496 \u0b87\u0bc7\u0bb2\u0bc6\u0baa\u1f9e\u0bae \u0b85\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0ba4\u0bbf\u0bb2\u0b95\u0bb0\u1fb7\u0ba9 511920825v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 213 \u2013 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0bae\u1fbe\u1fa0\u1fbb \u0b87\u0bb2. 172/2/\u0b8e, \u0bc6\u0bb5\u0ba9\u0bbf\u0bc6\u0bb5\u1fbf\u0bc6\u0b95\u0bbe\u0bb2, 520038/14/49 \u0bc6\u0baa\u0bbe\u1fbf\u0b95\u1fc4\u0b93\u0bb5\u0bbf\u0b9f \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 215 0.0522 \u0b87\u0bc7\u0bb2\u0bc6\u0baa\u1f9e\u0bae \u0b85\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0ba4\u0bbf\u0bb2\u0b95\u0bb0\u1fb7\u0ba9 511920825v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. \u2013 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe 520038/08/213 \u0b87\u0bb2. 172/2/\u0b8e, \u0bc6\u0bb5\u0ba9\u0bbf\u0bc6\u0bb5\u1fbf\u0bc6\u0b95\u0bbe\u0bb2, \u0bae\u1fbe\u1fa0\u1fbb \u0bc6\u0baa\u0bbe\u1fbf\u0b95\u1fc4\u0b93\u0bb5\u0bbf\u0b9f 520038/14/49 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 216 0.0500 \u0baa\u1fb9\u0ba9\u0bbf\u0bb2\u0bc7\u0b95 \u1f99\u0ba9\u0bbf\u0ba4\u0bbe\u0b9a 603332571v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. \u2013 \u0b87\u0bb2. 172/2/\u0b8e/1, \u0bc6\u0bb5\u0ba9\u0bbf\u0bc6\u0bb5\u1fbf\u0bc6\u0b95\u0bbe\u0bb2, 520038/14/49 \u0bc6\u0baa\u0bbe\u1fbf\u0b95\u1fc4\u0b93\u0bb5\u0bbf\u0b9f \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0