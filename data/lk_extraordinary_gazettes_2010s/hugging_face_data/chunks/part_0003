0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b85\u1fb7\u0ba4\u0bbe\u1fb5\u1f8a \u0baa\u1fb7\u0ba4\u0bbf\u0bb0 \u0b87\u0bb2. \u0bb9\u1fbb/11/75/6467 \u0baf\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0bb5\u1fb9\u0ba9\u0bbf \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0bae\u0bc7\u0ba9\u0bbe\u1fb3 \u1f97\u1fc3\u0baa \u1f81\u0bae\u0bbe\u0bb0\u0bb5\u0bbf\u1fb9 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 7 0.1012 \u0b85\u0bb0\u1f86 \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe. \u0b85. \u0b95.\u0b9a. \u0b87\u1fb9 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9- \u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0ba8. \u0b85. \u0b86. \u0b87\u1fb9 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9- \u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b85\u1fb7\u0ba4\u0bbe\u1fb5\u1f8a \u0baa\u1fb7\u0ba4\u0bbf\u0bb0 \u0b87\u0bb2. \u0bb9\u1fbb/11/75/6469 \u0baf\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0bc6\u0bb9\u1fb5\u1f8a \u0bc7\u0bb9\u0bb5\u0bc7\u0b95 \u0b9a\u0bae\u0bbf\u1fbf \u1f97\u1fc3\u0baa \u1f81\u0bae\u0bbe\u0bb0\u0bb5\u0bbf\u1fb9 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 8 0.0274 \u0b85\u0bb0\u1f86 \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 9 0.0627 \u0b85\u0bb0\u1f86 \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe. \u0b85. \u0b95.\u0b9a. \u0b87\u1fb9 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9- \u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0ba8. \u0b85. \u0b86. \u0b87\u1fb9 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9- \u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b85\u1fb7\u0ba4\u0bbe\u1fb5\u1f8a \u0baa\u1fb7\u0ba4\u0bbf\u0bb0 \u0b87\u0bb2. \u0bb9\u1fbb/11/75/6468 \u0baf\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0baa\u0bbf\u0bb0\u0ba4\u0bc0\u1fba \u0b9a\u1fb8\u0ba4\u0ba9 \u1f81\u0bae\u0bbe\u0bb0 \u1faa\u0bb0\u