0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.12.04\n\n116 0.0640 1. \u0bb5\u0bbf\u1fbf\u0baa\u0bbf\u1fb5\u0b9f\u0bc7\u0b95 \u0bb9\u0bbe\u0bbf\u1fc4\u0b9a\u1fb8\u0bb0 194827402432 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0bb5\u0bbf\u1fb0\u0bb0\u0bae\u0b9a\u0bbf\u0bb1\u0bbf \u0b9a\u0bae 2. \u0baf\u0bbe\u0bb2\u0b95\u0bae\u0bc7\u0b95 \u0baa\u0bbf\u0bc7\u0b9a\u0bbe\u0bc6\u0bae\u0ba3\u0bbf\u0bc7\u0b95 458221944v \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0baa\u0bb2\u0baa\u1fb7\u0ba4\u0bbe\u0bb5, \u0b95\u1fa2\u0b95\u1f99\u0bb5 \u0ba8\u0b95\u0bb0\u1fbb 122 0.4729 1. \u0b86\u0ba9\u1fb8\u0ba4 \u1f81\u0bae\u0bbe\u0bb0\u0bc7\u0b95 \u0ba8\u0bbf\u0bb2\u1fb8\u0ba4\u0bbf 696640084v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b87\u0bb2. 821 \u0bae\u1fbe\u1fa0\u1fbb \u2013 \u1fc4\u0bb5\u1fbd\u0ba3\u0bae\u0bbe\u1fa2 \u0bb5\u0bbf\u0b9c\u0baf\u0bc7\u0b9a\u0bbe\u0bae \u0b9a\u0bae 2019-01-02 \u0bb9\u1fb9\u0bb9\u1f99\u1f94\u0bb5, \u0bae\u0bbe\u1fc4\u0bc6\u0baa\u0bbe\u0ba4 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0ba4\u0bbf\u0ba9 \u1f81\u1fb7\u0ba4\u0bc8\u0b95\u1fba 2. \u0b86\u0ba9\u1fb8\u0ba4 \u1f81\u0bae\u0bbe\u0bb0\u0bc7\u0b95 \u0b85\u1f94\u0baa\u0bae\u0bbe 807421891v \u0baa\u1fb7\u0ba4\u0bbf\u0bb0\u1fb7\u0ba4\u0bbf\u1fb9 \u0bae\u0bbe\u0ba9\u0bb5\u0bbf\u0b95\u0bbe \u0bb5\u0bbf\u0b9c\u0baf\u0bc7\u0b9a\u0bbe\u0bae \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u0b95\u1fa6\u1fb0\u1f81 \u0bb5\u0bbf\u1fb0\u0bb0\u0bae\u0b86\u0bb0\u1fb2\u0b9a\u0bbf \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. \u0b87\u0bb2. 21/11, \u1faf\u1fb9\u0bc6\u0bb5\u1fa2, \u0bc6\u0bb5\u0bb5\u0bc6\u0ba4\u1fb9\u0ba9 \u1faa\u0ba4\u0bbf, \u0b85\u1fbb\u0baa\u0bbf\u1fb5\u1f8a\u0baf 144 0.1512 \u1f81\u1f9e\u0bc6\u0baa\u1fb7\u0ba4\u0bb2\u0bbe\u0bc7\u0b95 \u0b9a\u1fb8\u0bb0\u0bbe \u1f9f\u0baa\u0bb2\u0ba4\u0bbe 598020418v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \"\u0b9a\u0bb0\u0b9a\u0bb5\u0bbf\", \u0baa\u0bb2\u0