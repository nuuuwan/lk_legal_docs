a\u0dd0\u0db60 \u0d85\u0d82\u0d9a 02 . \u2013 (\u0dd9\u0dbbr\u0dc2( \u0007\u0db1\u0dcf i \u0db8\u0dcff\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0d82\u0d9a 670 L/1, \u0da0\u0dcf=\u0dc3\u0dca 0\u0dba- \u0d85a\u001b\u0dba \u0dc3\u0db8\u0d9f, \u0db8\u0dcf\u0dc0\u0dad, \u0dd9\u0dc0 \u0db1GE\u0dc0 \u2022t\u0d9c\u0db8\u0dd9@ \u0dd9\u0db1\u203a \u0dd9-> \u0db6f\u0db1\u0dd9\u0daf; \u0dd9\u0db4\u0dd9f\u0dbb\u0dcf \u0dc3\u0dc4 \u0dc0f\u0dab\u2022\u0dbd\u201a>\u0dba \u0d87 \u0da7 (F\u0dbd\u0dc3\u0dca \u0dd9\u0dbd\u0db1\u0dcf\u2022 \u0007\u0db1\u0dcf i \u0dba\u0db1 \u0d85\u0dba\u0dd9@ \u2039 \u0dad \u2022F\u001b\u0dba\u0da7 \u0dba\u0da7;\u0dc0, 10 0.0245 t\u0dc0 \u0da2\u0dba\u0dc3\u0d82\u0d9b \u0dd9\u0daf.!R \u0d86\u0dbb\u01602 770191483v \u0dc3-vf\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba ^\u0dbb\u0dd9\u0d9a)M\u0da9 \u2013 \u0d85\u0d82\u0d9a 675/2, \u0da2\u0db4\u0db8\u0dcf\u0dbd \u0db8\u0dcf\u0dc0\u0dad, \u0d86\u0dbb\u01602\u0dd9@ \u0dd9-> \u0dd9\u0dc0 \u0db1GE\u0dc0 \u0dd9\u0dad\u0dd9\u0dbb\u0dc3\u0dca ~#\u0da9\u0dcf \u0007\u0db1\u0dcf i \u0dba\u0db1 \u0d85\u0dba\u0dd9@ \u2039 \u0dad \u2022F\u001b\u0dba\u0da7 \u0dba\u0da7;\u0dc0, \u0d9a\u0dd0\u0db60 \u0d85\u0d82\u0d9a 48 . \u0db8\u0dcff\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85a\u001b\u0dba \u0dc3\u0db8\u0d9f, 11 0.0208 \u0dd9\u0daf) ##\u0dbb \u2022\u2018-#> 743330960v \u0dc3-vf\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u0d9a\u0dd0\u0db60 \u0d85\u0d82\u0d9a 48 . \u2013 \u0dd9\u0daf.!R \u0d86\u0dbb\u01602 \u0db8\u0dcff\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0d82\u0d9a 675/2, \u0da2\u0db4\u0db8\u0dcf\u0dbd \u0db8\u0dcf\u0dc0\u0dad, \u0d85a\u001b\u0dba \u0dc3\u0db8\u0d9f, \u0dd9\u0dc0 \u0db1GE\u0dc0 ^\u0dbb\u0dd9\u0d9a)M\u0da9 \u0d86\u0dbb\u01602\u0dd9@ \u0dd9-> \u0dd9\u0dad\u0dd9\u0dbb\u0dc3\u0dca ~#\u0da9\u0dcf \u0007\u0db1\u0dcf i \u0dba\u0db1 \u0d85\u0dba\u0dd9@ \u2039 \u0dad \u2022F\u001b\u0dba\u0da7 \u0dba\u0da7;\u0dc0,\n\n\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba\u0d8b\u0db4\u0dd9=\u0d9b\u0