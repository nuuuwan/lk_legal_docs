f\u1f90, 74 0.1191 \u0bc6\u0bae\u0bbe\u0b9f\u0b95\u1fbb\u0bae\u0ba9 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bb2\u0bbe\u0bc7\u0b95 \u0bb5\u0bbf\u0bae\u0bb2\u0bb0\u1fb7\u0ba9 540260770v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013\n\n\u0b87\u0bb2. 63, \u1f86\u0ba4\u1fbd\u0bae \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bae\u0bbf\u1fbf\u0bb2\u0bb5, \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf\n\n75 0.0665 \u0bb5\u0bbf\u0baf\u1fb9\u0ba9\u0bb2\u0bbe\u0bc7\u0b95 \u0b95\u0bbe\u0bae\u0bbf\u0ba9\u0bbf \u1faa\u0bb0\u0b9a\u0bbf\u1fb1\u0b95. 632822219v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0b87\u0bb2. 62, \u1f86\u0ba4\u1fbd\u0bae \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bae\u0bbf\u1fbf\u0bb2\u0bb5,\n\n\u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf 83 0.0469 \u0bb0\u0bbe\u0bae\u0b9a\u0bbf\u1fb1\u0b95 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0bc6\u0b95\u0ba4\u0bbe\u0bbf\u1fb9 647250025v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. \u2013 \u0bc6\u0b9c\u0ba9\u1fb5 39 \u0bae\u1fbe\u1fa0\u1fbb 88\n\n\u1f86\u0b9a\u1fb8\u0ba4 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bae\u0bbf\u1fbf\u0bb2\u0bb5, \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b88\u1fb5\u1f8c \u0bae\u1fbe\u1fa0\u1fbb\n\n\u1f99\u0ba4\u1fa3\u1fb5\u1f8c \u0bb5\u1fb1\u0b95\u0bbf, \u0bc6\u0b95\u0bbe\u1fa8\u1fbb\u1f97 03 \u0bb1\u0bbf\u1fbf\n\n\u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 86 0.0431 \u0bb5\u0bbf\u0bc7\u0b9c\u1fb8\u0ba4\u0bbf\u0bb0 \u0b95\u1fbb\u0bb2\u1fb7\u0ba4\u0bb2\u0bbe\u0bc7\u0b95 \u0b85\u1f9e\u0ba3 710402205v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013\n\n\u0ba4\u1fbd\u0bae\u0b9a\u0bbf\u0bbe\u0bbf \u0b9a\u0bbe\u0bae\u0bbf\u1fb8\u0ba4. \u0b87\u0bb2. 17/12, \u0bc6\u