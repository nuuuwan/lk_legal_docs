    "chunk_text": "\u0d85\u0002 \u0004\u0dd9\u0dc1\u0dc2 \u0b85\u0ba4\u0bbf\u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90\n\n\u0d85\u0d82\u0d9a 2142/52 - 2019 \u0dc3\u0dd0\u0014\u0dad\u0dd0\u0016\u0db6\u0018 25 \u0dc0\u0dd0\u001a \u0db6\u0daf\u0dcf\u0daf\u0dcf - 2019.09.25\n\n2142/52 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fbb - 2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0bc6\u0b9a\u1fb7\u0bc6\u0ba4\u1fbb\u0baa\u1fbd \u0bae\u0bbe\u0ba4\u1fbb 25 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u1f97\u0ba4\u1fb9\u0b95\u0bbf\u0bb4\u0bc8\u0bae\n\n2A\n\nIII \u0dd9\u0d9a \u0da7\u0dc3 \u2013 \u0dbd\u0d82\u0d9a\u0dcf \"\u0da2\u0dcf\u0dad\u0dcf$%\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf' \u0da2\u0db1\u0dbb\u0da2\u0dd9* \u0d85\u0002 \u0004\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3, \u0db4.\u0dba \u2013 2019.09.25\n\n\u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u1fa6\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0 \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0b95\u0bc8\u0bb3\u1fb0\n\n\u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u1fb9\u0bb1 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u1fbf\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n(\u0baa\u0bbf\u0bbe\u0bbf\u1fab 12)\n\n\u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u1fbf \u0b87\u0bb2: 42/0434 \u1f81\u1f9e\u0ba8\u0bbe\u0b95\u1fbf \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fbb\n\n\u0bb5\u0b9f\u0bc7\u0bae\u1fbf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u1fb7\u0ba4\u0bbf\u1fbf \u1f81\u1f9e\u0ba8\u0bbe\u0b95\u1fbf \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0bbe\u0bbf\u0ba4\u0bc0\u0b95\u0bae \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a\n\n\u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf, \u0b87\u0bb2. 562 - \u0b95\u0bbf\u0ba9\u0bbf\u0bb9\u0bbf\u0bbe\u0bbf\u0baf \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd\n\n\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\u1f90\u1fbb, \u0ba4\u0baa\u0bb0\u0baf\u0bbe\u0baf \u0b85\u1fbf\u0bb2\u1f90 \u0b85\u0ba4\u1fb9 \u0b8f\u0bc7\u0ba4\u1f94\u1fbb \u0baa\u0bbe\u0b95\u1fbb\n\n(\u0baa\u0bbf\u0bbe\u0bbf\u1fab 10) \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0ba9\u1f90\u1fbb, 1998\u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 21\u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\n\n\u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba\u0baa\u0ba4\u0bbf\u1fab\u1fb2\u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 11\u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u1fbd\n\n\u0ba4\u0bc8\u0bb2\u0bc8\u0bae\u0baf\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bbe\u1fbf \u0ba4\u0baf\u0bbe\u0bbe\u0bbf\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f 420319 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0ba8\u0bbf\u0bb2\n\n\u0b85\u0bb3\u1faa\u1f8c \u0b9a\u0bbe\u1fbd\u1fb8\u0ba4 \u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0baa\u1fa2\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f\u1f90\u0bae\u0bbe\u0ba9 \u0b92\u1f9e\n\n\u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u1fb0\u0b95\u0bbe\u0ba9 \u0b85\u1fbf\u0bb2\u1f90 \u0b85\u0ba4\u1fbe\u1f81 \u0bc7\u0bae\u1fbe\u0baa\u1fb5\u0b9f\n\n\u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u1fa6\u1fb0\u0b95\u0bbe\u0ba9 \u0bc6\u0b9a\u0bbe\u1fb7\u0ba4\u0bbe\u1fb6\u0bc8\u0bae\u1fb0\u1f81 \u0b85\u1fbf\u0bb2\u1f90 \u0b89\u0bc8\u0b9f\u0bc8\u0bae\u1fb0\u1f81\n\n\u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0 \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u1f9c\u1fc0\u0bb3 \u0b85\u1fbf\u0bb2\u1f90 \u0b85\u1fb0\u0b95\u0bc8\u0bb1\u1f9c\u1fc0\u0bb3 \u0b8e\u0bb5\u0bc7\u0bb0\u1f94\u0bae\u0bbe\u1fc0\n\n2019.11.04 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u1fb0\u1f81 \u1f99\u1fb9\u0ba9\u1fbd \u0b95\u0bc0\u0bc7\u0bb4\n\n\u0bc8\u0b95\u0bc6\u0baf\u0bbe\u1fba\u0baa\u0bae\u0bbf\u1fb5\u1f8c\u1fc0\u0bb3\u0bb5\u1f9e\u1fb0\u1f81\u1fb7\u0ba4\u0bae\u1f90\u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0bc8\u0baf\u1fb2\n\n\u0b9a\u0bae\u1fbd\u1fba\u0baa\u0bbf\u1fb7\u0ba4\u1fbf \u0bc7\u0bb5\u1fb6\u1f8c\u0bc6\u0bae\u1fb9\u1fa0 \u0b87\u1fb7\u0ba4\u0bbe\u1fbf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb0\u0b95\u1fba\u0baa\u1f8c\u0b95\u0bbf\u1fb9\u0bb1\u1f90.\n\n\u0bc7\u0bae\u1fbe\u1f82\u0bb1\u1fba\u0baa\u1fb5\u0b9f \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u1fb0\u1f81 \u1f99\u1fb9\u0ba9\u1fbd \u0b8f\u0bc7\u0ba4\u1f94\u1fbb \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\n\n\u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0bc8\u0baf\u1fb2 \u0b9a\u0bae\u1fbd\u0baa\u0bbf\u1fb0\u0b95\u1fb7 \u0ba4\u0bb5\u1fa0\u0b95\u0bbf\u1fb9\u0bb1 \u0b8f\u0bc7\u0ba4\u1f94\u1fbb \u0b9a\u1fb8\u0ba4\u1fbd\u1fba\u0baa\u1fb7\u0ba4\u0bbf\u1fbf,\n\n\u0b95\u0bbe\u0ba3\u0bbf\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u1fb7\u0bc8\u0ba4\u1fb7 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u0bbf\u1fba\u0baa\u0ba4\u1fbe\u1f81 \u0bae\u1fa0\u0b95\u1fb5\u0b9a\u0bbf\u0baf\u0bbf\u1fbf\u0bb2\u0bbe\u0ba4\n\n\u0bb5\u0bbf\u0b9a\u0bbe\u0bb0\u0bc8\u0ba3\u0bc8\u0baf \u0ba8\u0b9f\u0bbe\u1fb7\u1f90\u0bb5\u0ba4\u1fbe\u1f81\u1fbb, \u0b85\u0ba4\u1fbe\u0b95\u0bbf\u0ba3\u1fb1\u0b95 \u0bc7\u0bae\u0bc7\u0bb2\u1f9c\u1fc0\u0bb3\n\n\u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 14\u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u1fb9 \u0baa\u1f8a \u0b85\u0bb0\u0b9a\u0bbe\u1fb1\u0b95\n\n\u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u1fbf \u0b85\u1fb7\u0ba4\u0bc8\u0b95\u0baf \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u1f8c\u0bb5\u0ba4\u1fbe\u1f81\u1fbb\n\n\u0ba8\u0b9f\u0bb5\u1f8a\u1fb0\u0bc8\u0b95 \u0b8e\u1f8c\u1fb0\u0b95\u1fba\u0baa\u1f8c\u1fbb.\n\n\u0bc7\u0bae\u0bc7\u0bb2 \u1f81\u0bb1\u0bbf\u1fba\u1f96\u1f8c \u0bc6\u0b9a\u1fbc\u0baf\u1fba\u0baa\u1fb5\u0b9f 420319 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u1faa\u1f8c\n\n\u0b9a\u0bbe\u1fbd\u1fb8\u0ba4 \u0baa\u0b9f\u1fbb \u0b87\u0bc8\u0baf\u0baa\u0bbe\u0ba9 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bbf\u1fb9\n\n\u0b85\u1fa4\u0bb5\u0bb2\u0b95\u1fb7\u0ba4\u0bbf\u1fbf, \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0b95\u1fb7\u0ba4\u0bbf\u1fbf, \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\n\n\u0b85\u1fa4\u0bb5\u0bb2\u0b95\u1fb7\u0ba4\u0bbf\u1fbf, \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1f9e\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd \u0b85\u1fa4\u0bb5\u0bb2\u0b95\u1fb7\u0ba4\u0bbf\u1fbf,\n\n\u0b85\u1fbf\u0bb2\u1f90 \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u1fbd \u0ba4\u0bc8\u0bb2\u0bc8\u0bae\u0baf\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u1fa4\u0bb5\u0bb2\u0b95\u1fb7\u0ba4\u0bbf\u1fbf\n\n\u1f92\u0ba9\u0bbf\u1fb7\u0ba4\u0bbe\u0bb0\u0bbe\u0baf\u1fba\u0baa\u0b9f\u0bb2\u0bbe\u1fbb.\n\n\u0bc7\u0bae\u0bb2\u0ba4\u0bbf\u0b95 \u0ba4\u0b95\u0bb5\u1fbf , \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bbf\u0b9f\u0bae\u0bbf\u1f9e\u1fb8\u1f90, \u0b85\u1fbf\u0bb2\u1f90\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1f9e\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u0b9f\u0bae\u0bbf\u1f9e\u1fb8\u1f90\n\n\u0bc6\u0baa\u1fbe\u1fa0\u1fb0\u0bc6\u0b95\u0bbe\u1fc0\u0bb3\u1fba\u0baa\u0b9f\u0bb2\u0bbe\u1fbb.\n\n\u0baa\u0bbf.\u0b8e\u1fbb.\u0b8e\u1fb2. \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u1fbd\u0bb7\u0ba9\u0bbf,\n\n\u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd.\n\n(\u0b95\u0b9f\u0bc8\u0bae\u0bc8\u0baf \u0b95\u0bb5\u0ba9\u0bbf\u1fb7\u0ba4\u1fbf)\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fbb,\n\n\u0b87\u0bb2. 1200/6, \u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4 \u0bc6\u0bae\u1f90\u0bb0\u201d,\n\n\u0b87\u0bb0\u0b9c\u0bae\u1fbf\u0bb5\u1fb7\u0ba4 \u1faa\u0ba4\u0bbf,\n\n\u0baa\u1fb7\u0ba4\u0bb0\u1f99\u1fbf\u0bc8\u0bb2,\n\n2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0bc6\u0b9a\u1fb7\u0bc6\u0ba4\u1fbb\u0baa\u1fbd \u0bae\u0bbe\u0ba4\u1fbb 17 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf.\n\n10 - 336/ 2\n\n\u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u1fa6\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0 \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0b95\u0bc8\u0bb3\u1fb0\n\n\u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u1fb9\u0bb1 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u1fbf\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n(\u0baa\u0bbf\u0bbe\u0bbf\u1fab 12)\n\n\u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u1fbf \u0b87\u0bb2: 32/0582 \u0b95\u1fb6\u1f8a \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fbb\n\n\u0bae\u1fb7\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u1fb7\u0ba4\u0bbf\u1fbf \u0b95\u1fb6\u1f8a \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0bb9\u0bbe\u0bbe\u0bbf\u1fc4\u0baa\u1fb7\u1f90\u0bb5 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a\n\n\u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf, \u0b87\u0bb2. 450 - \u0bae\u0bbe\u0baa\u0bbe\u0bae\u1f8c\u1fbf\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bc7\u0b9a\u0bc8\u0bb5\n\n\u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\u1f90\u1fbb, \u0bae\u0bbe\u0baa\u0bbe\u0bae\u1f8c\u1fbf\u0bb2 \u0b85\u1fbf\u0bb2\u1f90 \u0b85\u0ba4\u1fb9\n\n\u0b8f\u0bc7\u0ba4\u1f94\u1fbb \u0baa\u0bbe\u0b95\u1fbb (\u0baa\u0bbf\u0bbe\u0bbf\u1fab 01) \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0ba9\u1f90\u1fbb, 1998\u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9"
