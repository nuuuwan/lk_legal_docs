0b9f\u1fb7\u0ba4\u0bbf\u1fb9 \u0bb5\u1f81\u1fba\u1f97\u1fbb \u0b88\u1f8c\u1f81\u1fb7 \u1f81\u0bbe\u0bbf\u0baf \u0b9a\u1fb5\u0b9f\u1fb1 \u0b87\u0bb2. \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u1f9c\u1fbb \u0b85\u1fb5\u0bc8\u0b9f \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0b87\u0baf\u1fbf\u1f97\u1fbb \u0ba4\u0bc8\u0b95 \u0b95\u1fa6\u1fc0 \u0b8e\u1fc2 (\u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u0bbe\u1fbd) \u0b87\u0bb2. \u0ba4\u1f8c\u1fba\u1f97\u1fb0 \u0bb5\u0bc8\u0b95\u1fb0\u1f81\u1fbb \u0b95\u1fb5\u0b9f\u0bc8\u0bb3 \u0b85\u0bc8\u0bae\u1fb8\u0ba4\u0bbf\u1f9e\u1fba \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0baa\u0bbf\u1fb9 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0 \u0b95\u1fc0\n\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 \u2013 \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014- 89 0.0230 \u1fa2\u0baf\u0ba9\u0bb0\u1fb7\u0ba9 \u0b95\u0bbe\u0bae\u0bbf\u0ba3\u0bbf \u0b85\u1f94\u0bb0 \u0bb5\u0bbe\u0ba4\u0b9a\u0bbf\u1fb1\u0b95 563361972v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 53 \u2013 \u0b87\u0bb2. 350\u0b88, \u0b8e\u1fbb\u0baa\u0bbf\u1fbf\u0bae\u0bc0\u0b95\u0bae \u0bc6\u0b9f\u0bb0\u1fc4, \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0b8e\u1fbb\u0baa\u0bbf\u1fbf\u0bae\u0bc0\u0b95\u0bae, \u0baa\u0bbf\u1fa2\u0bae\u0ba4\u0bb2\u0bbe\u0bb5 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 90 0.0252 \u1f81\u1f9e\u1fba\u1f97 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u1f90\u0bb7\u0bbe\u0bbe\u0bbf 727601856v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 53 \u2013 \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u1fbd\u0bb7\u0ba9\u0bbf \u1f81\u1f9e\u1fba\u1f97 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 350/\u1f8b, \u0b8e\u1fbb\u0baa\u0bbf\u1fbf\u0bae\u0bc0\u0b95\u0bae \u0bc6\u0b9f\u0bb0\u1fc4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b8e\u1fbb\u0baa\u0bbf\u1fbf\u0bae\u0bc0\u0b95\u0bae, \u0baa\u0bbf\u1fa2\u0bae\u0ba4\u0bb2\u0bbe\u0bb5 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b95\u1f8c\u0b95\u1fc4\u0bc6\u0ba4\u0bbe\u0b9f \u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b87\u0bb2. 4651 \u0bae\u1fbe\u1fa0\u1fbb 2006.3.17 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0bae\u1fbe\u1fa0\u1fbb \u0b87\u0bb2. 5595 \u0bae\u1fbe\u1fa0\u1fbb 2007.2.20 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 91 0.0717 \u0bc6\u0bb9\u1fb5\u1f8a \u0baa\u1fb7\u0ba4\u0bbf\u0bb0\u1fb9\u0bc7\u0ba9\u0bb2\u0bbe\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u1fb9 590310867v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 52 \u2013 \u0bb5\u0bbf\u0bae\u1fbf \u0bb0\u0bbe\u1fb3 \u0b9a\u0bb0\u1fb7 \u0b9a\u0bbe\u1fb8\u0ba4 \u0bae\u1fbe\u1fa0\u1fbb 53 \u0b87\u0bb2. 350/\u1f96, \u1f97\u0bb5\u1fb0 \u0b85\u1fb1\u0b95 \u0bb5\u1fb7\u0ba4, \u0b86\u0b95\u0bbf\u0baf\u0ba9 \u0b8e\u1fbb\u0baa\u0bbf\u1fbf\u0bae\u0bc0\u0b95\u0bae, \u0baa\u0bbf\u1fa2\u0bae\u0ba4\u0bb2\u0bbe\u0bb5 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0baa\u0bbf\u1fa2\u0bae\u0ba4\u0bb2\u0bbe\u0bb5 \u0bae\u1fb0\u0b95\u1fc0 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b87\u0bb2. 6541 \u0bae\u1fbe\u1fa0\u1fbb 2016/12/23 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 92 0.0323 \u0b85\u0bb0\u1f86 \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe\u1fbf\u0bb5\u0bbe\u1fbc 94 0.0348 \u0b85\u0bb0\u1f86 \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe\u1fbf\u0bb5\u0bbe\u1fbc 96 0.0257 \u1fa2\u0baf\u0ba9\u0bc7\u0b95 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bc7\u0bb2 578151940v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 52 \u2013 \u0bc7\u0baa\u0bbe\u0ba4\u0bbf\u0bc7\u0b95\u0bbe\u1f8c\u0bc7\u0bb5 \u0bc6\u0b95\u0ba4\u0bb0 \u0b9c\u0baf\u1fb8\u0ba4\u0bbe \u0bae\u1fbe\u1fa0\u1fbb \u0bc6\u0bae\u0ba3\u0bbf\u1fb0\u0bc7\u0b95 53 \u0b86\u0b95\u0bbf\u0baf\u0ba9 \u0b87\u0bb2. 350/\u0b8e\u1fb2/1, \u0b8e\u1fbb\u0baa\u0bbf\u1fbf\u0bae\u0bc0\u0b95\u0bae \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc6\u0b9f\u0bb0\u1fc4, \u0b8e\u1fbb\u0baa\u0bbf\u1fbf\u0bae\u0bc0\u0b95\u0bae, \u0baa\u0bbf\u1fa2\u0bae\u0ba4\u0bb2\u0bbe\u0bb5 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90,"
