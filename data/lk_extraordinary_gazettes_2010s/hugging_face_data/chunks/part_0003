0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u2013 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0bc6\u0b9a\u0baa\u1fc4\u0ba4\u0bbf\u0baf\u1fb9 \u0bae\u0bbf\u0bbe\u0bbf\u1fc4\u0bb8\u1fb9\u0bc6\u0b95\u0bbe\u1f8c\u0bb5, \u1fa4\u1f8e\u0bb5\u0bbf\u0bb2 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0bae\u1fbe\u1fa0\u1fbb \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0b86\u0ba9\u0bbe \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 53 0.1554 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0ba8\u0bbf\u0bb7\u0bbe\u1fb9 \u1f8a\u1fbf\u1f9e\u1fb0 197333200508 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u2013 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0bc6\u0b9a\u0baa\u1fc4\u0ba4\u0bbf\u0baf\u1fb9 \u0bae\u0bbf\u0bbe\u0bbf\u1fc4\u0bb8\u1fb9\u0bc6\u0b95\u0bbe\u1f8c\u0bb5, \u1fa4\u1f8e\u0bb5\u0bbf\u0bb2 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0bae\u1fbe\u1fa0\u1fbb \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0b86\u0ba9\u0bbe \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 54 0.3098 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0ba8\u0bbf\u0bb7\u0bbe\u1fb9 \u1f8a\u1fbf\u1f9e\u1fb0 197333200508 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u2013 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0bc6\u0b9a\u0baa\u1fc4\u0ba4\u0bbf\u0baf\u1fb9 \u0bae\u0bbf\u0bbe\u0bbf\u1fc4\u0bb8\u1fb9\u0bc6\u0b95\u0bbe\u1f8c\u0bb5, \u1fa4\u1f8e\u0bb5\u0bbf\u0bb2 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0bae\u1fbe\u1fa0\u1fbb \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0b86\u0ba9\u0bbe \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 55 0.3929 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0ba8\u0bbf\u0bb7\u0bbe\u1fb9 \u1f8a\u1fbf\u1f9e\u1fb0 197333200508 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u2013 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0bc6\u0b9a\u0baa\u1fc4\u0ba4\u0bbf\u0baf\u1fb9 \u0bae\u0bbf\u0bbe\u0bbf\u1fc4\u0bb8\u1fb9\u0bc6\u0b95\u0bbe\u1f8c\u0bb5, \u1fa4\u1f8e\u0bb5\u0bbf\u0bb2 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0bae\u1fbe\u1fa0\u1fbb \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0b86\u0ba9\u0bbe \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90,\n\n28 A"
