f90.\u0b87\u0bb2. 16 \u2013 \u201c\u0bb0\u1fc4\u0bae\u0bbf\u201d, \u0bc6\u0b95\u0b9f\u0b95\u0bbe\u0bb2\u0b95\u0bb9\u0bb5\u1fb7\u0ba4, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b95\u1fbb\u1f97\u1f9e\u0b95\u1f99\u0bb5 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 114 0.0270 \u0b85\u0bc7\u0baa\u1f97\u1fc4\u0bb8\u0bc7\u0b95 \u0b86\u0ba9\u1fb8\u0ba4 \u1fba\u0bc7\u0bb0\u0bae\u0bb0\u1fb7\u0ba9 703082416v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0bc6\u0b95\u0bbe\u0bc7\u0b9f\u0bb5\u1fb7\u0ba4, \u0baa\u1fb6\u0b9f\u1fb7\u0ba4\u0bb0, \u0ba4\u0bbf\u0bb9\u0bc6\u0b95\u0bbe\u0b9f 152 0.0292 \u0bc6\u0bb2\u0bbe\u1f81 \u0bc7\u0baa\u0bbe\u0b95\u0bb9\u0bb5\u1fb7\u0ba4\u0bc7\u0b95 \u0ba4\u0bbf\u0bb2\u0bbe\u0ba9\u0bbf 716221024v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 179 \u2013 \u0b9a\u1fbb\u0baa\u0bbf\u0b95\u0bbe \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 239, \u1fc4\u0bb5\u1fbd\u0ba3\u1f97\u0bb0\u0bb5\u0bb0, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb, \u0ba4\u1fbf\u0baa\u0bbe\u0bb5\u0bbf\u0bb2, \u0bc6\u0b95\u0b95\u0ba9\u1f90\u0bb0 \u0bae\u1fb0\u0b95\u1fc0 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fbf \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 223 0.0264 \u1f97\u1fb6\u0baf\u0b9a\u0bbf\u0bbe\u0bbf \u0b85\u0bb4\u0bb9\u0bc7\u0b95\u0bbe\u1fb9 632081677v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 179 \u2013 \u0b87\u0bb2. 301, \u1fc4\u0bb5\u1fbd\u0ba3\u1f97\u0bb0\u0bb5\u0bb0, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0ba4\u1fbf\u0baa\u0bbe\u0bb5\u0bbf\u0bb2, \u0bc6\u0b95\u0b95\u0ba9\u1f90\u0bb0 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 224 0.0360 \u0b87\u1fb8\u1f90\u0b95\u0bbe \u0b9a\u0bbe\u0bae\u1fa3 \u0bb5\u0b9f\u0ba9\u1fbb\u0baa\u0bbf 6475013