ba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 188 \u2013 \u0b85\u0bae\u0bb0\u0b9a\u0bbf\u1fb1\u0b95 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0baa\u0bbf\u1f9c\u1fc4\u0bb5\u1fb7\u0ba4, \u0bae\u0bbf\u1fbf\u0bb2\u0bb5, \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 222 0.0171 \u0b85\u0bae\u0bb0\u0b9a\u0bbf\u1fb1\u0b95 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0baa\u0bbf\u0baf\u0ba4\u0bbf\u1fc4\u0b9a 633263191v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 181 \u2013\n\n\u0baa\u0bbf\u1f9c\u1fc4\u0bb5\u1fb7\u0ba4, \u0bae\u0bbf\u1fbf\u0bb2\u0bb5, \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 224 0.1927 \u0bb9\u0bbe\u0bbf\u1fc4\u0b9a\u1fb8\u0ba4\u0bbf\u0bb0 \u0baa\u1fb8\u1f90\u0bb2 \u0ba4\u0ba9\u0baa\u0bbe\u0bb2 560854390v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 188 \u2013\n\n\u0baa\u0bbf\u1f9c\u1fc4\u0bb5\u1fb7\u0ba4, \u0bae\u0bbf\u1fbf\u0bb2\u0bb5 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90,\n\n\u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0bb5\u1fb1\u0b95\u0bbf, \u0bae\u0bbe\u0bb5\u1fb7\u0ba4\u0b95\u0bae\u0bb5\u0bbf\u1fbf\n\n\u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90\n\n227 0.0174 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u2013 \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0baa\u0bbe\u0bc8\u0ba4 234 0.0676 \u0b85\u1f90\u0b95\u1fbf \u0bc7\u0baa\u1f8a\u0bc7\u0b95 \u0b9c\u0ba9\u0b95 \u0baa\u0bbf\u0bb0\u0b9a\u1fb9\u0ba9 820240634v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b8e\u1f90\u0b