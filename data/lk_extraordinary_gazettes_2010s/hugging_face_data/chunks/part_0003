0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 26 \u2013 \u0b87\u0bb2. 542/4, \u0ba8\u0bc0\u1fbd\u0bc6\u0b95\u0bbe\u1fa8\u1fbb\u1f97 \u1faa\u0ba4\u0bbf, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bb5\u1fb7\u0ba4\u0bc8\u0bb3 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 109 0.0243 \u0b85\u1fb8\u0bc7\u0ba4\u0bbe\u0ba9\u0bbf\u0baa\u0bbf\u1fc0\u0bc8\u0bb3 \u0bc7\u0b9c\u1f86\u0bb0\u1fb7\u0ba9\u1fbb 581461658v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0b87\u0bb2. 14/10, 14/11, \u0b9a\u0bc0\u0bb5\u1fa2 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0bb5\u1fb7\u0ba4\u0bc8\u0bb3 112 0.0271 \u0bb5\u0bbe\u0b9a\u0bb2\u0ba4\u1fb9\u0ba4\u0bbf\u0bbe\u0bbf\u0bc7\u0b95 \u0bc7\u0ba4\u0bbe\u0ba9 \u0bc6\u0b9c\u0ba9\u0bbf\u0baa\u1fbd 697462902v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 113 \u2013 \u0baa\u1fbd\u0ba9\u0bc6\u0ba4\u1fb7 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 195/2, \u0b89\u1fc4\u0bb5\u1fb7\u0ba4 \u1faa\u0ba4\u0bbf, \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b8e\u0bc7\u0b9f\u0bb0\u1f99\u1fbf\u0bb2 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 154 0.0424 \u0b85\u0b95\u1fbb\u0bc6\u0baa\u0bbe\u1f8a\u0bc7\u0b95 \u0bc6\u0b9c\u0bb0\u0bbe\u1fb5 \u0b9a\u0bb0\u1fb7 \u0bae\u0bb9\u0bbf\u1fb8\u0ba4 540240620v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 147 \u2013 \u0b9a\u0bbf\u1fbf\u0bb5\u0bbe \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 75/1, \u1f97\u0bc8\u0b95\u0baf\u0bbf\u0bb0\u0ba4 \u0ba8\u0bbf\u0bc8\u0bb2\u0baf \u1faa\u0ba4\u0bbf, \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bb5\u1fb7\u0ba4\u0bc8\u0bb3 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 174 0.0437 1. \u0bc7\u0baa\u0bbe\u0bc6\u0baa \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0b9c\u1fc4\u1f8a\u1fb9 581050194v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 173 \u2013 \u0ba8\u0bbf\u0bae\u1fbf \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe (\u0bc7\u0bb5\u1fa0 \u0bc6\u0baa\u0baf\u1fbd \u0b9a\u0bae \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b9c\u1fc4\u1f8a\u1fb9 \u0ba8\u0bbf\u0bae\u1fbf \u0bc7\u0baa\u0bbe\u0bc6\u0baa \u0b86\u0bb0\u1fb2\u0b9a\u0bbf) \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 2. \u1f8a\u1fbf\u0bb7\u0bbf\u0baf\u0bbe \u1fb0\u0bc6\u0bb5\u1fb9\u0b9f\u1fa2\u1fb9 \u0bc7\u0baa\u0bbe\u0bc6\u0baa 557450696v \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. \u0b86\u0bb0\u1fb2\u0b9a\u0bbf(\u1f8a\u1fbf\u0bb7\u0bbf\u0baf\u0bbe \u1fb0\u0bc6\u0bb5\u1fb9\u0b9f\u1fa2\u1fb9 \u0bc6\u0bb0\u0b95\u0bae\u1fb9 ) \u0b87\u0bb2. 47/1, \u1f97\u0bc8\u0b95\u0baf\u0bbf\u0bb0\u0ba4 \u1faa\u0ba4\u0bbf, \u0bb5\u1fb7\u0ba4\u0bc8\u0bb3 186 0.0395 \u0bc7\u0ba4\u0bbe\u0ba9 \u0b8e\u1fb9\u0b9f\u0ba9\u1fb5 \u0b9a\u1fb8\u0ba4\u0bae\u0bbe\u1fa2 \u0bc6\u0bb9\u1fb8\u0ba4\u0bb2\u0bc7\u0b95 648242190v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 99 \u2013 \u0b87\u0bb2. 14, \u1fb0\u0bc7\u0bb0\u0ba9\u0bbf\u0baf\u1fbd \u1faa\u0ba4\u0bbf, \u0bc6\u0baa\u0bbe\u0bb0\u0bc8\u0bb3, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc6\u0b95\u0bbe\u1fa8\u1fbb\u1f97 08 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb, 2017/11/21 \u0bc6\u0ba4\u0bbe\u0b9f\u1fb0\u0b95\u1fbb 2019/10/26 \u0bb5\u0bc8\u0bb0 \u0bc7\u0b95\u0bb5\u0bbf\u0baf\u1fb5 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u0b95\u1fa6\u1fb0\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 198 0.0462 \u0bc6\u0bb7\u0bbe\u0bbf\u1fbf \u0b95\u0baf\u1fb8\u0ba4 \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u1fb7\u0ba4 782872087v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 407 \u2013 \u0b87\u0bb2. 53/\u0b8e, \u0b95\u0bc7\u0ba3\u1f99\u1fbf\u0bb2 \u1faa\u0ba4\u0bbf, \u0baa\u0b9f\u0b95\u0bae \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bb5\u0b9f\u1fb0\u1f81, \u0b9c\u0bbe-\u0b8e\u0bb2 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb, \u0b87\u0bb2. 19831 \u0bae\u1fbe\u1fa0\u1fbb 2014.3.20 \u0ba4\u0bbf\u0ba9\u1fb7\u0ba4\u0bbf\u1fb9 \u1f81\u1fb7\u0ba4\u0bc8\u0b95 \u0baa\u1fb7\u0ba4\u0bbf\u0bb0\u1fb7\u0ba4\u0bbf\u1fb9 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u0b95\u1fa6\u1fb0\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90.\n\n3 A III \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u2013 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u2013 2019.08.20\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.08.20\n\n\u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0b85\u0bb0\u0b9a\u0bbe\u1fb1\u0b95 \u0b85\u1fb2\u1f86\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0ba4\u0bbf\u1fba\u0baa\u0bbf\u1fb0\u0b95\u1fba\u0bc6\u0baa\u1fbe\u0bb1\u1f90."
