\u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb\n\n\u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4 \u0bae\u1fbe\u1fa0\u1fbb \u1f90\u1fb6\u1f8c Dn ; \u0b95\u0bbf\u0bb4\u1fb0\u1f81 :\u1f90\u1fb6\u1f8c Dn \u0bae\u1fbe\u1fa0\u1fbb\n\nDm ; \u0bc6\u0ba4\u1fbe\u1f81 : \u1f90\u1fb6\u1f8c Dm \u0bae\u1fbe\u1fa0\u1fbb Dq ; \u0bc7\u0bae\u1fbe\u1f81 : \u1f90\u1fb6\u1f8c Dq, \u0bbe\u0bc0.\u1f8b.\n\n\u0bc7\u0bb9\u0bae\u1fb8\u0ba4\u0bbe \u1f86\u0bb5\u1fbd\u0ba3\u0bae\u0bbe\u1fa3 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4\n\n\u0bae\u1fbe\u1fa0\u1fbb \u0bc7\u0b9c.\u0b9f\u1fba.\u0b9c\u0bc0. \u1f86\u0baa\u0bbe\u0bb7\u0bbf\u0ba9\u0bbf \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb\n\n\u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4.\n\n100. \u1f90\u1fb6\u1f8c Dq \u2013 \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4 - \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb: 0.0791\n\n\u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u0bbe\u1fbd\n\n\u0bb5\u0b9f\u1fb0\u1f81 :\u0bbe\u0bc0.\u1f8b. \u0bc7\u0bb9\u0bae\u1fb8\u0ba4\u0bbe \u1f86\u0bb5\u1fbd\u0ba3\u0bae\u0bbe\u1fa3 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb\n\n\u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4, \u0bc7\u0b9c.\u0b9f\u1fba.\u0b9c\u0bc0. \u1f86\u0baa\u0bbe\u0bb7\u0bbf\u0ba9\u0bbf \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae\n\n\u0bc7\u0b95\u0bbe\u1f9e\u1fbb \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4 \u0bae\u1fbe\u1fa0\u1fbb \u1f90\u1fb6\u1f8c Dp ; \u0b95\u0bbf\u0bb4\u1fb0\u1f81 :\u1f90\u1fb6\u1f8c Dp,\n\nDm, \u0bb5\u0bbe\u1fbc\u1fb0\u0b95\u0bbe\u1fbf \u0bae\u1fbe\u1fa0\u1fbb \u0bbe\u0bc0.\u1f8b. \u0bc7\u0bb9\u0bae\u1fb8\u0ba4\u0bbe \u1f86\u0bb5\u1fbd\u0ba3\u0bae\u0bbe\u1fa3 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\n\n\u0bc7\u0b95\u0bbe\u1f9e\u1fbb \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4 ; \u0bc6\u0ba4\u1fbe\u1f81 : \u0bbe\u0bc0.\u1f8b. \u0bc7\u0bb9\u0bae\u1fb8\u0ba4\u0bbe \u1f86\u0bb5\u1fbd\u0ba3\n\n\u0bae\u0bbe\u1fa3 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4, \u0bc7\u0b9c.\u0b9f\u1fba.\u1f96. \u1f86\u0bb0\u1fb4\u0b9a\u0bbf\u1fb7\n\n\u0ba8\u1fb8\u0ba4\u0b9a\u0bbe\u1fa2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4 \u0bae\u1fbe\u1fa0\u1fbb \u1f90\u1fb6\u1f8c Ds ;\n\n\u0bc7\u0bae\u1fbe\u1f81 :\u1f90\u1fb6\u1f8c Ds, \u0bc7\u0b9c.\u0b9f\u1fba.\u1f96. \u1f86\u0bb0\u1fb4\u0b9a\u0bbf\u1fb7 \u0ba8\u1fb8\u0ba4\u0b9a\u0bbe\u1fa2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\n\n\u0bc7\u0b95\u0bbe\u1f9e\u1fbb \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4 \u0bae\u1fbe\u1fa0\u1fbb \u0bbe\u0bc0.\u1f8b. \u0bc7\u0bb9\u0bae\u1fb8\u0ba4\u0bbe \u1f86\u0bb5\u1fbd\u0ba3\u0bae\u0bbe\u1fa3\n\n\u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4.\n\n101. \u1f90\u1fb6\u1f8c Ds \u2013 \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4 - \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb: 0.2107\n\n\u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u0bbe\u1fbd\n\n\u0bb5\u0b9f\u1fb0\u1f81 :\u0bc7\u0b9c.\u0b9f\u1fba.\u1f96. \u1f86\u0bb0\u1fb4\u0b9a\u0bbf\u1fb7 \u0ba8\u1fb8\u0ba4\u0b9a\u0bbe\u1fa2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb\n\n\u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4, \u0bbe\u0bc0.\u1f8b. \u0bc7\u0bb9\u0bae\u1fb8\u0ba4\u0bbe \u1f86\u0bb5\u1fbd\u0ba3\u0bae\u0bbe\u1fa3 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb\n\n\u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4 \u0bae\u1fbe\u1fa0\u1fbb \u1f90\u1fb6\u1f8c Dq ; \u0b95\u0bbf\u0bb4\u1fb0\u1f81 : \u1f90\u1fb6\u1f8c Dq, \u0bbe\u0bc0.\u1f8b.\n\n\u0bc7\u0bb9\u0bae\u1fb8\u0ba4\u0bbe \u1f86\u0bb5\u1fbd\u0ba3\u0bae\u0bbe\u1fa3 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4\n\n\u0bae\u1fbe\u1fa0\u1fbb \u0bc7\u0b9c.\u0b9f\u1fba.\u1f96. \u1f86\u0bb0\u1fb4\u0b9a\u0bbf\u1fb7 \u0ba8\u1fb8\u0ba4\u0b9a\u0bbe\u1fa2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb\n\n\u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4 ; \u0bc6\u0ba4\u1fbe\u1f81 :\u0bc7\u0b9c.\u0b9f\u1fba.\u1f96. \u1f86\u0bb0\u1fb4\u0b9a\u0bbf\u1fb7 \u0ba8\u1fb8\u0ba4\u0b9a\u0bbe\u1fa2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\n\n\u0bc7\u0b95\u0bbe\u1f9e\u1fbb \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4, \u0bc7\u0b9c.\u0b9f\u1fba.\u1f96. \u0b95\u0bc0\u1fbd\u1fb7\u0ba4\u0bbf\u0baa\u0bbe\u0bb2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\n\n\u0bc7\u0b95\u0bbe\u1f9e\u1fbb \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4 \u0bae\u1fbe\u1fa0\u1fbb \u1f90\u1fb6\u1f8c Dt ; \u0bc7\u0bae\u1fbe\u1f81 :\u1f90\u1fb6\u1f8c Dt,\n\n\u0bc7\u0b9c.\u0b9f\u1fba.\u1f96. \u0b95\u0bc0\u1fbd\u1fb7\u0ba4\u0bbf\u0baa\u0bbe\u0bb2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4 \u0bae\u1fbe\u1fa0\u1fbb\n\n\u0bc7\u0b9c.\u0b9f\u1fba.\u1f96. \u1f86\u0bb0\u1fb4\u0b9a\u0bbf\u1fb7 \u0ba8\u1fb8\u0ba4\u0b9a\u0bbe\u1fa2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4.\n\n102. \u1f90\u1fb6\u1f8c Dt \u2013 \u0bb9\u0bbf\u1fb8\u0ba4\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0ba4 - \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb: 0.1627\n\n\u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u0bbe\u1fbd\n\n\u0bb5\u0b9f\u1fb0\u1f81 :\u0bc7\u0b9c.\u0b9f\u1fba.\u1f96. \u0b95\u0bc0\u1fbd\u1fb7\u0ba4\u0bbf\u0baa\u0bbe\u0bb2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u1fbb \u0bb9\u0bbf\u1fb8\u0ba4\n\n\u0bae\u0b9f\u0baf\u0bbe\u0bb5\u1fb7\u0