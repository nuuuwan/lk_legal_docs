u0dba\u0dd2\u0db8\u0dca :-\n\n\u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d89\u0da9\u0db8\u0da7/\u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba\u0dad\u0dcf\u0dc0\u0dba\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8\u0dca \u0dd9\u0dc4\u0ddd \u0dd9\u0dc0\u0db1\u0dad\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0dd9\u0daf\u0db1\u0dcf\u0db8 \u0dad\u0db8 \u0dad\u0db8\u0db1\u0dca \u0dd9\u0dc4\u0ddd \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0dbd\u0dd2\u0dba\u0dc0\u0dd2\u0dbd\u0dd2\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0d85\u0dba\u0dc0\u0dc5\u0dd4\u0db1\u0dca \u0dd9\u0dc4\u0ddd 2019 \u0d9a\u0dca \u0dc0\u0dd6 \u0d85\u0dd9\u0d9c\u0ddd\u0dc3\u0dca\u0dad\u0dd4 \u0db8\u0dc3 07 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85. \u0db7\u0dcf. 2.00\u0da7 \u0db6\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dd9\u0dba\u0dca \u0daf\u0dd3 \u0db8\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0d9b \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba.\n\n\u0dad\u0dc0 \u0daf 2019 \u0da2\u0dd6\u0dbd\u0dd2 \u0db8\u0dc3 31 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1\u0da7 \u0db8\u0dad\u0dca\u0dd9\u0dad\u0db1\u0dca \u0d92 \u0d89\u0da9\u0db8/\u0d89\u0da9\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd9\u0dba\u0db1\u0dca \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8\u0dca\u0dc0\u0dbd \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba\u0dad\u0dca \u0d91\u0d9a\u0dd3 \u0d89\u0da9\u0db8/ \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0dba \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d9c\u0dd0\u0db1 \u0dc0\u0db1\u0dca\u0daf\u0dd2 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0da7 \u0d87\u0dad\u0dd2 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dad\u0dca \u0dc0\u0db1\u0dca\u0daf\u0dd2 \u0db8\u0dd4\u0daf\u0dbd \u0dc4\u0dcf \u0d91\u0db8 \u0db8\u0dd4\u0daf\u0dbd \u0d9c\u0dab\u0db1\u0dca \u0db6\u0dd0\u0dbd\u0dd6 \u0dc4\u0dd0\u0da7\u0dd2\u0dad\u0dca \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd2\u0da7\u0db4\u0dad\u0dca \u0dd9\u0daf\u0d9a\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd6 \u0dbd\u0dd2\u0dba\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0d9a\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba.\n\n\u0db6\u0dd3. \u0db4\u0dd3. \u0d91\u0dc3\u0dca. \u0d85\u0db1\u0dd4\u0dbb\u0dcf\u0db0\u0dd2, \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca, \u0db6\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba.\n\n2019 \u0db8\u0dd0\u0dba\u0dd2 \u0db8\u0dc3 15 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db6\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dd9\u0dba\u0dca \u0daf\u0dd3 \u0dba.\n\n06 - 509\n\n\u0dc1\u0dd4\u0daf\u0dca\u0db0\u0dd2 \u0db4\u0dad\u0dd2\u0d9a\u0dcf\u0dc0\n\n\u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9c\u0dca \u0dd9\u0dba\u0ddc\u0db8\u0dd4 \u0d85\u0d82\u0d9a\u0dba: 11/3/3/1/14/K \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dcf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4 \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\u0dc1\u0dd9\u0dba\u0dca \u0dd9\u0dba\u0ddc\u0db8\u0dd4 \u0d85\u0d82\u0d9a\u0dba : LD/05/2008/MV/408B.\n\n\u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dd9\u0dad\u0dca, 7 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0d85\u0d82\u0d9a 2122/31 \u0