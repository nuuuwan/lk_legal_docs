1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0baa\u0bbe\u0bc8\u0ba4 280 0.0349 \u0bc6\u0baa\u1fc4\u0bc7\u0ba4\u1f9e\u0bc7\u0bb5 \u1fa2\u0baf\u0ba9\u0bb0\u0bbe\u0bb2\u0bb2\u0bbe\u0bc7\u0b95 535711780v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. \u2013 \u0baa\u0bbf\u0bb0\u0b9a\u0bbf\u0bb2\u0bbe \u0bc6\u0b9f\u1fbf\u0b9a\u0bbf \u1f81\u0bc7\u0bb0 197 \u0bae\u1fbe\u1fa0\u1fbb 273 1 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0bc6\u0ba4\u0bbe\u1fc4\u0ba4\u0bb0 \u0bb5\u1fb7\u0ba4, \u0bae\u0bbf\u1fbf\u0bb2\u0bb5, \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 282 0.0450 \u0bc7\u0baa\u0bbe\u0bc7\u0baa \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0bc7\u0ba4\u0bbe\u0ba9 \u0bc6\u0bb0\u0bbe\u0bb7\u0bbe\u0ba9\u0bbf 198176100145 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bc7\u0baa\u0bbe\u0bc7\u0baa \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u2013 \u0ba4\u1fbd\u0bae\u0bb5\u1fb1\u0b9a \u0bc6\u0ba4\u0bbe\u1fb9 \u0bb0\u1fb4\u0b9a\u0bbf\u1fb7 \u0bc6\u0b95\u1f99\u1f94 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, 01 \u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95. \u0ba4\u1fbd\u0bae\u0bb5\u1fb1\u0bb7 \u0bae\u0bbf\u1fbf\u0bb2\u0bb5, \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf \u0bae\u1fbe\u1fa0\u1fbb \u0bc6\u0bb2\u0bbe\u1f81 \u0bc7\u0b95\u0bbe\u0ba9\u1f90\u0bb5\u0bc7\u0b95 \u0bc7\u0bb0\u0bbe\u0bb7\u0bbf\u0ba9\u0bbf \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 284 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bc7\u0baa\u0bbe\u0bc7\u0baa \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u1fb9 \u0bb0\u1fb4\u0b9a\u0bbf\u1fb7 \u0ba4\u1fbd\u0bae\u0bb5\u1fb1\u0b9a \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0ba8\u0bbf\u0bb0\u0bbe\u0b95\u0bbe\u0bbf\u1fba\u0baa\u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 283 0.0532 \u0bc7\u0baa\u0bbe\u0bc7\u0baa \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0bc7\u0ba4\u0bbe\u0ba9 \u0bc6\u0bb0\u0bbe\u0bb7\u0bbe\u0ba9\u0bbf 198176100145 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bc7\u0baa\u0bbe\u0bc7\u0baa \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u2013 \u0ba4\u1fbd\u0bae\u0bb5\u1fb1\u0bb7 \u0bc6\u0ba4\u0bbe\u1fb9 \u0bb0\u1fb4\u0b9a\u0bbf\u1fb7 \u0bc6\u0b95\u1f99\u1f94 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, 01 \u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0ba4\u1fbd\u0bae\u0bb5\u1fb1\u0bb7 \u0bae\u0bbf\u1fbf\u0bb2\u0bb5, \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf \u0bae\u1fbe\u1fa0\u1fbb \u0bc6\u0bb2\u0bbe\u1f81 \u0bc7\u0b95\u0bbe\u0ba9\u1f90\u0bb5\u0bc7\u0b95 \u0bc7\u0bb0\u0bbe\u0bb7\u0bbf\u0ba9\u0bbf \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 284 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bc7\u0baa\u0bbe\u0bc7\u0baa \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0bc7\u0ba4\u0bbe\u0ba9 \u0ba8\u0bbf\u0bc7\u0bae\u0bb7\u0bbe \u0ba4\u1fbd\u0bae\u0bb5\u1fb1\u0bb7 \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0ba8\u0bbf\u0bb0\u0bbe\u0b95\u0bbe\u0bbf\u1fba\u0baa\u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90\n\n15 A III \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2013 \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000e\u000f\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0012 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u