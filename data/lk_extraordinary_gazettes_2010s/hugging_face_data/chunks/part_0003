d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 685; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 685. 19. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 684 - \u0dc0\u0dad\u0dca\u0dad - \u0d8b\u0dba\u0db1\u0dca\u0d9c\u0dbd\u0dca\u0dbd \u0db8\u0dd6\u0d9a\u0dbd\u0dcf\u0db1 - \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba : \u0dbb\u0da2\u0dba; \u0db6\u0dd4\u0daf\u0dca\u0daf\u0dbb\u0dd9\u0d9c\u0dca \u0dc3\u0dbb\u0dad\u0dca \u0d9a\u0dd3\u0dbb\u0dca\u0dad\u0dd2\u0dc3\u0dd2\u0dbb\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb 0.0523\n\n\u0d8b\u0dad\u0dd4\u0dbb\u0da7 : \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 739; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 739; \u0daf\u0d9a\u0dd4\u0dab\u0da7; \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 683; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 683. 20. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 685 - \u0d87\u0dc5 - \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba : \u0dbb\u0da2\u0dba; \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb 0.2481 \u0d8b\u0dad\u0dd4\u0dbb\u0da7 : - \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb\u0da7: - \u0daf\u0d9a\u0dd4\u0dab\u0da7: - \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: - 21. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 686 - \u0dc0\u0dad\u0dca\u0dad - \u0d8b\u0dba\u0db1\u0dca\u0d9c\u0dbd\u0dca\u0dbd \u0db8\u0dd6\u0d9a\u0dbd\u0dcf\u0db1 - \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba : \u0dbb\u0da2\u0dba; \u0dbb\u0dcf\u0da2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dc0\u0dad\u0dd3; \u0db4\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba