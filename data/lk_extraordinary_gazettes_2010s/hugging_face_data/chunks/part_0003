3321637v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0bb0\u1fb1\u0b95\u0bae \u0b9a\u1fb8\u0ba4\u0bbf, \u0bc6\u0bb5\u1fbf\u0bb2\u0bb5 6 0.0665 \u0baf\u0bbe\u0baa\u0bbe \u0baa\u0ba4\u0bbf\u0bb0\u0ba9\u0bb2\u0bbe\u0bc7\u0b95 \u0b95\u0bbe\u0bae\u0bbf\u0ba3\u0bbf \u0bc7\u0b9a\u0ba9\u0bbe\u0ba4\u0bc0\u0bb0 611741812v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0bb0\u1fb1\u0b95\u0bae \u0b9a\u1fb8\u0ba4\u0bbf, \u0bc6\u0bb5\u1fbf\u0bb2\u0bb5 15 0.0379 \u0bc7\u0bb9\u0bb5\u0bbe \u0ba8\u0bbe\u1f90\u0bc6\u0b95\u0bbe\u0b9f \u0bc6\u0bae\u0bbe\u0bc6\u0bb9\u0bbe\u1fb5\u1f8a\u0bc7\u0b95 198207201489 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf \u2013 \u0b9a\u0bae\u0bbf\u1fb8\u0ba4 \u1fa3\u0bb2\u0bbe\u0ba9\u1fb8\u0ba4 \u0baa\u0bb2\u0bc7\u0ba8\u0bbe\u1fb0\u1f81 \u0bc6\u0ba4\u1fa2\u0b95\u1f94\u0bb5\u0bbe\u0bb5, \u0bb0\u1fb1\u0b95\u0bae, \u0bc6\u0bb5\u1fbf\u0bb2\u0bb5 \u1f82\u1fb5\u1f8c\u0bb1\u1fab \u0b9a\u1fb1\u0b95 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bbf\u0baf \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 18 0.0387 \u0bae\u0bbe\u0bc6\u0ba4\u1fbf\u0bc7\u0b95 \u0b85\u0bae\u0bb0\u0bbe\u0bb5\u0ba4\u0bbf \u1f96\u0bbe\u0bbf\u1fc4 197252302241 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. \u2013 \u0bc6\u0ba4\u1fa2\u0b95\u1f94\u0bb5\u0bbe\u0bb5, \u0bb0\u1fb1\u0b95\u0bae, \u0bc6\u0bb5\u1fbf\u0bb2\u0bb5 420358/07/17 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 19 0.0379 \u0ba4\u0bbe\u0b9a\u0ba8\u0bbe\u0baf\u1fb0\u0b95 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0b95\u0bbe\u0bae\u0bbf\u0ba9\u0bbf 753371583v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. \u2013 \u1f81\u0bae\u0bbe\u0bb0 \u0ba4\u0bbe\u0b9a\u0ba8\u0bbe\u0baf\u1fb0\u0b95 420358/07/94 \u0bc6\u0baa\u0bbe\u1f90\u0bb5\u0bbf\u0bb2, \u0bae\u0bb9\u1f99\u0b95\u0bb2\u1fb9\u0baf\u0bbe\u0baf \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 20 0.0401 \u0b95\u0bb9\u1fb8\u0ba4\u0bb5 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0b9a\u0bae\u0bc0\u0bb0 \u0b9a\u0bae\u1fb9 870742819v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. \u2013 \u1f81\u0bae\u0bbe\u0bb0 420358/07/17 \u0bc6\u0ba4\u1fa2\u0b95\u1f94\u0bb5\u0bbe\u0bb5, \u0bb0\u1fb1\u0b95\u0bae, \u0bc6\u0bb5\u1fbf\u0bb2\u0bb5 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b87\u0bb2.01, \u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0bb5\u1fb1\u0b95\u0bbf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bc6\u0b95\u0bbe\u1fa8\u1fbb\u1f97 01 \u0baf\u0bbf\u1fbf \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0 \u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 23 0.0390 \u0bc6\u0baa\u1f9e\u1fbb\u1f97\u1fc0\u0bb3\u0bbf \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 650551869v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 17 \u2013 \u0b87\u1fb8\u0ba4\u0bbf\u0bb0\u0ba4\u0bbe\u0b9a \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bae\u0bbe\u0bb2\u0b95\u1f99\u0bb5, \u0ba8\u0bbf\u0b95\u0ba4\u1fa4\u0bc6\u0baa\u0bbe\u0ba4 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bae\u1fb0\u0b95\u1fc0 \u0bb5\u1fb1\u0b95\u0bbf \u0b8e\u1f90\u0b95\u1fbf\u1f97\u0bb0 \u0b95\u0bbf\u0bc8\u0bb3\u0baf\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1