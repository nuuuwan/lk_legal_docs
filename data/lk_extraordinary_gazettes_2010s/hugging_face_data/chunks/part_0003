f9e\u0ba3\u0bbe\u0bb0\u1fb7\u0ba9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf 1 \u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0bae\u0bbf\u1fbf\u0bb2\u0bb5 \u0bb5\u1fb7\u0ba4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bae\u0bbf\u1fbf\u0bb2\u0bb5 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0b85\u1f94\u0bb0\u0bbe\u0ba4\u1f97\u0bb0\u1fbb, \u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 214 0.0488 \u0bb2\u1fa2\u1fb7 \u0bb5\u0b9a\u1fb8\u0ba4 \u0baf\u0bbe\u0baa\u0bbe \u0baa\u0ba4\u0bbf\u0bb0\u0ba9 702592534v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0baf\u0bbe\u0baa\u0bbe \u2013 \"\u1fad\u0bbe\u0bbf\u0baf\u0bbe \u0bb5\u0bbe\u0b9a\", \u0ba4\u0bbf\u0baf\u0baa\u0bbe\u0bb5, \u0baa\u0ba4\u0bbf\u0bb0\u1fb9\u0bc6\u0ba9\u0bc6\u0bb9\u0bb2\u0bbe\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u0bb0\u1f8a\u0baf\u0bbe\u0bb5 \u0b95\u1f9e\u0ba3\u0bbe\u0ba4\u0bbf\u1fc4\u0bb8 \u0bae\u1fbe\u1fa0\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u1fb5\u0bbe\u0bbf\u1fc4 \u0bb8\u0bc1\u0bb5\u1fbd\u0ba9\u0bb2\u0ba4\u0bbe \u0baf\u0bbe\u0baa\u0bbe \u0baa\u0ba4\u0bbf\u0bb0\u0ba9 \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bae\u1fbe\u1fa0\u1fbb \u0baf\u0bbe\u0baa\u0bbe \u0baa\u0ba4\u0bbf\u0bb0\u1fb9\u0bc6\u0ba9\u0bc6\u0bb9\u0bb2\u0bbe\u0bc7\u0b95 \u0b95\u1f9e\u0ba3\u0bbe\u0ba4\u0bbf\u1fc4\u0bb8 \u0bc7\u0ba4\u0bc8\u0bb5\u0baf\u0bbe\u0ba9 \u0bc7\u0ba8\u0bb0\u1fb7\u0ba4\u0bbf\u1fb9 \u0ba8\u0bbf\u0bb0\u0bbe\u0b95\u0bbe\u0bbf\u1fb0\u0b95 \u1f82\u1f8a\u0baf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 221 \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5