 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u1faa\u0ba4\u0bbf, \u0b85\u0bb0\u0b9a\u0bc1 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba8\u0bb5\u0ba4\u0bcd\u0bc7\u0ba4 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0, \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u1faa\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c By; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c By \u0b89\u0bae\u0bcd, Bw \u0b89\u0bae\u0bcd.\n\n70. \u1f90\u0ba3\u0bcd\u1f8c By \u2013 \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u1f90 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0248 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u1faa\u0ba4\u0bbf, \u0b9f\u0baa\u0bcd.\u0b8e\u0bae\u0bcd.\u0bc7\u0b95.\u0b9c\u0bc0. \u0ba8\u0ba8\u0bcd\u0ba4\u0ba9\u0bc0 \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0bbf\u0bb9\u0bbe\u0bae\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b9a\u0bbf\u0bb2\u0bb0\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba8\u0bb5\u0ba4\u0bcd\u0bc7\u0ba4 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c Bv, Bw \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd Bx; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Bv, Bw, Bx, \u1faa\u0ba4\u0bbf, \u0b85\u0bb0\u0b9a\u0bc1 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba8\u0bb5\u0ba4\u0bcd\u0bc7\u0ba4 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u1faa\u0ba4\u0bbf; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u1faa\u0ba4\u0bbf, \u0b8f.\u0bc7\u0b95. \u0b8e\u0ba4\u0bbf\u0bbe\u0bbf\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0bb9\u0bb2\u0bc6\u0b95\u0ba4\u0bb0 \u0bb5\u0ba4\u0bcd\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c Cb, Ca \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd Bz; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Cb, Ca, Bz \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc8\u0bae\u0b95\u0bcd\u0b95\u0bb2\u0bcd \u0bb5\u0bbf\u0bc7\u0b9c\u0bb0\u0ba4\u0bcd\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0bb9\u0bb2\u0bc6\u0b95\u0ba4\u0bb0 \u0bb5\u0ba4\u0bcd\u0ba4.\n\n71. \u1f90\u0ba3\u0bcd\u1f8c Bz \u2013 \u0b87\u0bb9\u0bb2\u0bc6\u0b95\u0ba4\u0bb0 \u0bb5\u0ba4\u0bcd\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0252 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u0bc8\u0bae\u0b95\u0bcd\u0b95\u0bb2\u0bcd \u0bb5\u0bbf\u0bc7\u0b9c\u0bb0\u0ba4\u0bcd\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0bb9\u0bb2\u0bc6\u0b95\u0ba4\u0bb0 \u0bb5\u0ba4\u0bcd\u0ba4, \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u1faa\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c By; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c By; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Ca; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1f92\u0bb5\u0ba9\u0bcd \u0bae\u0bc0\u0b95\u0bb8\u0bcd\u0bc6\u0b95\u0bbe\u0b9f\u0bcd\u1f8c\u0bb5 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0bb9\u0bb2\u0bc6\u0b95\u0ba4\u0bb0 \u0bb5\u0ba4\u0bcd\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc8\u0bae\u0b95\u0bcd\u0b95\u0bb2\u0bcd \u0bb5\u0bbf\u0bc7\u0b9c\u0bb0\u0ba4\u0bcd\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0bb9\u0bb2\u0bc6\u0b95\u0ba4\u0bb0 \u0bb5\u0ba4\u0bcd\u0ba4.\n\n72. \u1f90\u0ba3\u0bcd\u1f8c Ca \u2013 \u0b87\u0bb9\u0bb2\u0bc6\u0b95\u0ba4\u0bb0 \u0bb5\u0ba4\u0bcd\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.1534 \u0bc6\u