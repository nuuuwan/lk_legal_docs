f\u0bbf\u0bb0\u0ba4 \u0ba8\u0bbf\u0bc8\u0bb2\u0baf \u1faa\u0ba4\u0bbf, \u0bb5\u1fb7\u0ba4\u0bc8\u0bb3 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 203 0.0718 \u1f82\u0bb0\u0b95\u0bae\u0bc7\u0b95 \u0bb2\u1fa3\u1fb9 \u1fba\u0bbe\u0bbf\u0ba9\u0bbe\u1fb7 881500019v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u1f82\u0bb0\u0b95\u0bae\u0bc7\u0b95 \u2013 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u1f96\u1fa2\u1fb0\u1fc4 \u0bb2\u1fa2\u1fb7 570/22, \u0bc6\u0bb5\u0bc6\u0bb0\u1fbf\u0bb2\u1f90\u1f8c\u0bb5 \u1faa\u0ba4\u0bbf, \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0bae\u1fbe\u1fa0\u1fbb \u0bae\u0bbe\u0bc7\u0baa\u0bbe\u0bb2, \u0bb5\u1fb7\u0ba4\u0bc8\u0bb3 \u0bc6\u0b9a\u0ba9\u0bb0\u1fb7 \u1f99\u0ba4\u1fa2\u0bc7\u0b95 \u0bb2\u1fa2\u0ba4\u0bbe \u0bb0\u1fb4\u0b9c\u0ba9\u0bbf \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bb0\u1f90 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81, \u0b87\u0bb2. 7313 \u0bae\u1fbe\u1fa0\u1fbb 2017.07.11 \u0ba4\u0bbf\u0ba9 \u1f81\u1fb7\u0ba4\u0bc8\u0b95\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bb0\u1fb7\u0ba4\u0bbf\u1fb9 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 211 0.0124 \u0bae\u0bbe\u0b95\u0bb5\u0bbf\u1fb5\u0b9f\u0bc7\u0b95 \u0b9a\u1fbd\u1fa2 \u0bb2\u0baf\u0ba9\u1fbf \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe 572331792v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 428, \u0ba8\u0bc0\u1fbd\u0bc6\u0b95\u0bbe\u1fa8\u1fbb\u1f97 \u1faa\u0ba4\u0bbf, \u0bb5\u1fb7\u0ba4\u0bc8\u0bb3 07 - 288\n\n\u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0b85\u0bb0\u0b9a\u0bbe\u1fb1\u0b95 \u0b85\u1fb2\u1f86\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0ba4\u0bbf\u1fba\u0baa\u0bbf\u1fb0\u0b95\u1fba\u0bc6\u0baa\u1fbe\u0bb1\u1f90."
