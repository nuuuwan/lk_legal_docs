0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.06.07\n\n29 0.0458 \u0b85\u0bb0\u1f86 \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bb0 \u0b87\u0bb2. \u0b8e\u1fbf \u0b8e\u1fbf 142 \u0b95\u0bc0\u1fc1 \u0b87\u0bb2. 29, \u0bc6\u0b9a\u0bb5\u0ba9 \u0baa\u0bbf\u0baf\u0b9a, \u0ba4\u0bc0\u0bb5\u0bb0 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fbb, \u0b9a\u0bbf\u0bbe\u0bbf\u0bae\u0bbe\u1f97\u0bb0 \u0bc7\u0b9a\u1fbd\u1fb8\u0ba4 \u1f81\u0b9f\u0bbe\u0b95\u1fbb\u0bae\u0ba9\u0bc7\u0b95 \u1f8a\u0bc7\u0bae\u0bbe\u1f8a\u0baf\u1fb9 \u0bb0\u0ba3\u0bb0\u0bbe\u1fb3 \u0b8e\u1fb9\u0baa\u0bb5\u1fbd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc6\u0b95\u0bbe\u1fc0\u0b95\u0bbf\u0bb1\u0bbe\u1fbd. 30 0.0387 \u0b85\u0bb0\u1f86 \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bb0 \u0b87\u0bb2. \u0b8e\u1fbf \u0b8e\u1fbf 145 \u0b95\u0bc0\u1fc1 \u0bc6\u0b9a\u0bb5\u0ba9 \u0baa\u0bbf\u0baf\u0b9a, \u0ba4\u0bc0\u0bb5\u0bb0 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fbb \u0bc7\u0b9a\u1fbd\u1fb8\u0ba4 \u1f81\u0b9f\u0bbe\u0b95\u1fbb\u0bae\u0ba9\u0bc7\u0b95 \u0bb2\u0bbe\u0b9a\u0bc6\u0bb0\u1fc4 \u0baa\u0bbf\u0bb0\u0ba9\u0bbe\u1fb8\u1f90 \u0b8e\u1fb9\u0baa\u0bb5\u1fbd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc6\u0b95\u0bbe\u1fc0\u0b95\u0bbf\u0bb1\u0bbe\u1fbd. 31 0.0601 \u0b85\u0bb0\u1f86 \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bb0 \u0b87\u0bb2. \u0b8e\u1fbf \u0b8e\u1fbf 166 \u0b95\u0bc0\u1fc1 \u0b87\u0bb2. 10, \u0bc6\u0b9a\u0bb5\u0ba9 \u0baa\u0bbf\u0baf\u0b9a, \u0ba4\u0bc0\u0bb5\u0bb0 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fbb, \u0b9a\u0bbf\u0bbe\u0bbf\u0bae\u0bbe\u1f97\u0bb0 \u0bc7\u0b9a\u1fbd\u1fb8\u0ba4 \u0baa\u1fc4\u0ba8\u0bbe\u0baf\u0b95 \u0b85\u1fba\u1f97\u0bb9\u0bbe\u0bae\u0bbf\u0bb2\u0bbe\u0bc7\u0b95 \u0bc7\u0ba4\u0bb5\u0bbf\u0b95\u0bbe \u0b85\u0bae\u0bb0\u0bbe \u1f90\u0bb7\u0bbe\u0bbe\u0bbf \u0b8e\u1fb9\u0baa\u0bb5\u1fbd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc6\u0b95\u0bbe\u1fc0\u0b95\u0bbf\u0bb1\u0bbe\u1fbd. 32 0.0692 \u0b85\u0bb0\u1f86 \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bb0 \u0b87\u0bb2. \u0b8e\u1fbf \u0b8e\u1fbf 144 \u0b95\u0bc0\u1fc1 \u0bc6\u0bb5\u0b9a\u0ba9 \u0baa\u0bbf\u0baf\u0b9a, \u0ba4\u0bc0\u0bb5\u0bb0 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fbb, \u0b9a\u0bbf\u0bbe\u0bbf\u0bae\u0bbe\u1f97\u0bb0 \u0bc7\u0b9a\u1fbd\u1fb8\u0ba4 \u0bc6\u0baa\u1f9e\u0bae\u0bbe\u1fbf \u1f86\u0b9a\u1fb8\u0ba4 \u1f81\u0bae\u0bbe\u0bb0\u1f90\u1fb1\u0b95 \u0b8e\u1fb9\u0baa\u0bb5\u1fbd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc6\u0b95\u0bbe\u1fc0\u0b95\u0bbf\u0bb1\u0bbe\u1fbd."
