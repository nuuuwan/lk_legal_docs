bae \u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u0bb0\u0bbe\u0bb5\u0ba4\u0bbe\u0bb5\u1fb7\u0ba4 \u0b8e\u1f94\u1fbb \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf, 520201 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 07 \u0b87\u1fbf 162 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8a\u1fb9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b85\u1fc2\u0bb5\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf,\n\n\u201c\u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0\u0b95\u0bbe\u0bb0\u1fbd / \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0\u0b95\u0bbe\u0bb0\u1fbd\u0b95\u0bb3\u0bbf\u1fb9 \u0bc6\u0baa\u0baf\u1fbd\u0b95\u1fa6\u1fbb \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u1f9c\u1fbb\u201d \u0bae\u1fbe\u1fa0\u1fbb \u201c\u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0b85\u0bc8\u0b9f\u0baf\u0bbe\u0bb3\u0b85\u1fb5\u0bc8\u0b9f \u0b87\u0bb2.\u201d \u0b86\u0b95\u0bbf\u0baf \u0ba8\u0bbf\u0bb0\u1fbf\u0b95\u0bb3\u0bbf\u1fbf\n\n\u201c\u1f99\u1f90\u1fb9\u0bc6\u0b95\u0bbe\u1fb5\u1f8c\u0bb5\u0bc7\u0b95 \u0bc7\u0ba4\u0bbe\u0ba9 \u0b95\u0bb5\u0bbf\u1fb8\u0bb0\u0bbe \u0b9a\u0bae\u1fb8\u0ba4\u0bbf \u0b85\u0bc7\u0baa\u0ba8\u0bbe\u0baf\u0b95, \u0b87\u0bb2. 91/\u1f8b, 3\u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0bb0\u0bbe\u0bb5\u0ba4\u0bbe\u0bb5\u1fb7\u0ba4 \u1faa\u0ba4\u0bbf\u201d \u0bae\u1fbe\u1fa0\u1fbb \u201c787713076v \u201d \u0b8e\u1fb9\u1fa0\n\n\u0b89\u1fc0\u0bb3\u0b9f\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c \u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fba\u0baa\u1f8c\u0ba4\u1fbf \u0bc7\u0bb5\u1fb6\u1f8c\u1fbb.\n\n\u0bc7\u0b95.\u0b8f.\u0bc7\u0b95. \u0bb0\u1fb4\u0b9a\u0bbf\u1fb7 \u0ba4\u1fbd\u0bae\u0baa\u0bbe\u0bb2, \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd. (\u0baa\u0ba4\u0bbf\u1fbf \u0b9