bf\u1fb9 \u0b87\u0bb2. 458, \u0bc6\u0bb2\u1fb0\u1fb2 \u0b9f\u0baf\u1fc4 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bae\u1fb7\u0ba4\u0bbf\u0baf \u0b89\u1fbf\u0bb9\u0bbf\u1f8a\u0baf\u0bbe\u0bb5, \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 76 0.0953 \u0bb5\u1fbd\u0ba9\u1f81\u0bb2 \u0baa\u0b9f\u0bc6\u0baa\u1fb8\u0ba4\u0bbf\u0bc7\u0b95 \u0ba4\u1f95\u0b9c\u0bbe \u0b9a\u0bbe\u0bae\u1fa3 775331577v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 179 \u0b87\u1fb9 \u2013 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 458 \u1f96, \u0b9a\u1fb9\u0b9a\u0ba9\u0bc0, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fbf\u0bb9\u0bbf\u1f8a\u0baf\u0bbe\u0bb5, \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 43 \u0b87\u1fb9 \u0baa\u0bbe\u0bc8\u0ba4 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 217 0.0887 \u0bc6\u0baa\u1fb8\u0ba4\u0bb0\u0bc7\u0b95 \u0b8e\u1fb5\u0ba9\u0bbe \u0b9a\u0bbf\u0bb2\u0bbe\u1fb9 \u1fad\u0bbe\u0bc0\u0bae\u0bbe\u1fa2 687003578v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u2013 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0bae\u0bb9\u0bc6\u0ba4\u1fbf\u0bc7\u0b95 \u0bbe\u0bc0\u1fb5\u0b9f\u0bbe \u0b87\u0bb2. 192/\u0b8f, ''\u0b85\u1f9e\u0ba9'', \u0bc7\u0bae\u0baa\u1fbf \u0baa\u1fbd\u0ba9\u0bbe\u1fb8\u1f90 \u1f97\u1f9e\u1fbf\u0bb2\u0baa\u0bbf\u1fb5\u1f8a\u0baf, \u0bae\u0bbf\u1f94\u0bb5\u1fb1\u0bc6\u0b95\u0bbe\u0bc8\u0b9f \u0bae\u1fbe\u1fa0\u1fbb \u0bc6\u0baa\u1fb8\u0ba4\u0bb0\u0bc7\u0b95 \u0b8e\u1fb5\u0bb5\u1fb5 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0