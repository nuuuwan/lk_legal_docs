c\u0bb5, 153 0.0253 \u0bae\u0bc7\u0bb9\u0bb7\u0bbe \u0b8e\u0bb0\u1fb2\u0ba4\u0bbf \u0b95\u0bb9\u1fb8\u0ba4\u0bb0\u1fb7\u0ba8\u0bbe\u0baf\u1fb0\u0b95 197877301147 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 87 \u0b87\u1fb9 \u2013 \u0b87\u0bb2. 272 \u0b9a\u0bc0, \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0baa\u0bbe\u0bc8\u0ba4 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b95\u1fbf\u0bb2\u0bc8\u0bb1 \u1faa\u0ba4\u0bbf, \u0bc7\u0baa\u0bbe\u0bc7\u0bb0, \u0b85\u1f90\u1f9e\u0b95\u0bbf\u0bbe\u0bbf\u0baf \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 197 0.0760 \u0b95\u1fb8\u0bb5\u0bbe\u0bbe\u0bbf\u0bc7\u0b95 \u1faa\u0bb0\u0b9a\u0bbf\u0bbe\u0bbf \u0baa\u1fbd\u0ba9\u0bbe\u1fb8\u1f90 513470940v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0baa\u0bb2\u0bc7\u0ba8\u0bbe\u1fb0\u1f81 \u2013 \u0b87\u0bb2. 161\u0b88/3, \u0b9c\u0baf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u1f82\u1fb5\u1f8c\u0bb1\u1fab \u0b9a\u1fb1\u0b95\u1fb7\u0ba4\u0bbf\u1fb9 \u0baa\u0ba9\u0bbe\u0baa\u0bbf\u1fb5\u1f8a\u0baf, \u0bb5\u1fc4\u0b95\u1f8c\u0bb5, \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 07 - 863/26\n\n27 A\n\nIII \u0dd9\u0d9a \u0da7\u0dc3 \u2013 \" \u0dbd\u0d82\u0d9a\u0dcf $\u0da2\u0dcf\u0dad\u0dcf\u001b'\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf) \u0da2\u0db1\u0dbb\u0da2\u0dd9, \u0d85\u0002 \u0004\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3. \u0db4/\u0dba \u2013 2019.07.11\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1