\u0dba !t\u0db6\u0db3 \u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0dca\u0dad\u0dbb\n\n(\u0dd9\u0dc4E\u0da7\u0dba\u0dcfa)\n\n4 0.0743 \u0dbb\u0db1#\u0d82\u0dc4 \u0d86\u0dbbw2\u0dd9@ #>\u0dd9\u0dc3m\u0db1 473080770v \u0dc3-qa\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u0d9a\u0dd0\u0db60 \u0d85\u0d82\u0d9a 03 \u0dc3\u0dc4 \u0d85\u0d82\u0d9a 1615 \u0d85\u0d82\u0d9a 33, \u0db8\u0dd01\u0d9a\u0dd0\u0dd9=\u0dc0;\u0dad, \u0d9a\u0db3\u0dc0\u0dbd, 13 \u0dba\u0db1 \u0d9a\u0dd0\u0db60 \u0dc0\u0dbd \u0d94o\u0192\u0dd9e \u0dc3\u0db3\u0dc4 \u0d9a\u0da7\u0dcf\u0db1 \u0db8\u0dcfa\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d89.\u0007.\u0dd9\u0d9a). \u0dc3\u0db7\u0dcf\u0dd9e \u0d85\\\u001b\u0dba \u0dc3\u0db8\u0d9f, \u0dd9\u0d9a) \u0dd9$#\u0dc0\u0dbd\u0da7 \u0dba\u0da7;\u0dc0\n\n13A III \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 : \u0001 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007\u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0dba \u0dba \u0dba \u0dba - 2019201920192019.08080808.20202020\n\n\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba \u2013 (\u0dc3-\u0db6 \u2039\u0dad\\\u0dc3-\u0d