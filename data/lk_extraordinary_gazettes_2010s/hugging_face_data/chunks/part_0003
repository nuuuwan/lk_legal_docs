\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0 \u0b95\u1fc0 158 0.0151 \u0bc6\u0bae\u1fbf\u0bb2\u0bb5 \u0ba4\u1fb9\u0ba4\u0bbf\u0bbe\u0bbf\u0bc7\u0b95 \u0bb5\u0bbf\u0ba9\u0bbf\u0baa\u0bbf\u0bbe\u0bbf\u0b9f\u0bbe 583293963v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 165 \u2013 \u0b87\u0bb2. 170/\u0b9a\u0bbf, 02 \u0baa\u0bbf, \u1f97\u1f97\u1f90 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc6\u0bb5\u0bc6\u0bb0\u1fbf\u0bb2\u0bb5\u1fb7\u0ba4 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 335 0.0318 \u0bc6\u0b95\u0bbe\u0bb2\u1fbb\u0baa \u0baa\u0b9f\u0bc6\u0baa\u1fb8\u0ba4\u0bbf\u0bc7\u0b95 \u0b8e\u0bb0\u1fbf \u0baa\u0bbf\u0bb0\u0b9a\u0bbe\u1fb7 522672955v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 347 \u2013 \u0b8e\u1fb8\u0ba4\u0ba9\u0bbf \u0baa\u0bbf\u0bb0\u0ba9\u0bbe\u1fb8\u1f90 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 4/1\u1f8a, \u0bc6\u0b95\u1f99\u1f94 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb, \u0b85\u1fb7\u0ba4\u0bbe\u1f8a\u0baf \u1faa\u0ba4\u0bbf, \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb2 \u0bc6\u0b95\u0bbe\u0bb2\u1fbb\u0baa \u0baa\u0b9f\u0bc6\u0baa\u1fb8\u0ba4\u0bbf\u0bc7\u0b95 \u0b8e\u0bb0\u1fbf \u0baa\u0bbf\u0bb0\u0b9a\u0bbe\u1fb7 \u0b8e\u1fb8\u0ba4\u0ba9\u0bbf \u0baa\u0bbf\u0bb0\u0ba9\u0bbe\u1fb8\u1f90 \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 2018.06.19 - 2020.06.18 \u0bb5\u0bc8\u0bb0 \u0bc7\u0b95\u0bb5\u0bbf\u0baf\u1fb5 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u0b95\u1fa6\u1fb0\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 396 0.0363 1. \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u0b95 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0ba8\u0bbf\u0bb2\u1fb8\u0ba4\u0bbf 736091100v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb