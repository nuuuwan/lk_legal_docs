u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c Bk; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0ba8\u0bb5\u0ba4\u0bcd\u0bc7\u0ba4 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b86\u0bb0\u0bcd.\u0bc7\u0b95.\u0b8e\u0bae\u0bcd. \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bbe \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0bbf \u0bb0\u0bbe\u0b9c\u0baa\u0b95\u0bcd \u0bb7 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b9a\u0bbf\u0bb2\u0bb0\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba8\u0bb5\u0ba4\u0bcd\u0bc7\u0ba4 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0.\n\n57. \u1f90\u0ba3\u0bcd\u1f8c Bk \u2013 \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u1f90 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0160 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Bj; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1faa\u0ba4\u0bbf, \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0ba8\u0bb5\u0ba4\u0bcd\u0bc7\u0ba4 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c Bl; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Bl, \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0ba8\u0bb5\u0ba4\u0bcd\u0bc7\u0ba4 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1faa\u0ba4\u0bbf, \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0ba8\u0bb5\u0ba4\u0bcd\u0bc7\u0ba4 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c Bj.\n\n58. \u1f90\u0ba3\u0bcd\u1f8c Bl \u2013 \u0ba8\u0bb5\u0ba4\u0bcd\u0bc7\u0ba4 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0041 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd"
