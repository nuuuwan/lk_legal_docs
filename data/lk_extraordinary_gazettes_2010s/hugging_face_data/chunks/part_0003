1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf \u0bc7\u0bae\u0bc7\u0bb2\u1f9c\u1fc0\u0bb3 \u0ba4\u0bc8\u0bb2\u1fba\u0baa\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 2014.03.19 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf 1854/27 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u0b9a\u0bbf\u1fb9 \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u1fbf \u0baa\u0bbf\u0bb0\u1f86\u0bb0\u0bae\u0bbe\u0ba9 \u0bae\u1fb7\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u1fb7\u0ba4\u0bbf\u1fbf, \u0b95\u1fb6\u1f8a \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0b95\u1fb1\u0b95\u0bb5\u1fb5\u0b9f \u0bc7\u0b95\u0bbe\u0bb0\u0bc8\u0bb3 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf 273 - \u0b89\u1fbf\u0baa\u0ba4\u1f81\u1fbb\u1f97\u0bb0 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u0ba4\u0bb2\u0baa\u0bbf\u0baf\u1fb9\u0ba9\u0bbe\u0bb5 \u0b8e\u1f94\u1fbb \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf, 320310 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 02 \u0b87\u1fbf 127 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8a\u1fb9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b85\u1fc2\u0bb5\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf, \u201c\u0b95\u0bbe\u0ba3\u0bbf \u0bb5\u0bb4\u1fb0\u0b95\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0b9f\u0baa\u1fb5\u0b9f \u0b88\u1f8c \u1f81\u1fb7\u0ba4\u0bc8\u0b95 \u0ba4\u1f8c\u1fba\u1f97\u1fb0 \u0b95\u1fb5\u0b9f\u0bc8\u0bb3 \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0\u201d \u0b8e\u1fb9\u1f94\u1fbb \u0ba8\u0bbf\u0bb0\u1fa2\u1fbf \u0b89\u1fc0\u0bb3\u0b9f\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u201c\u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 44 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90.\u201d \u0b8e\u1fb9\u0baa\u1f90 \u0ba8\u0bc0\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c \u201c\u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 44 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90.\u201d \u0b8e\u1fb9\u1fa0 \u0b89\u1fc0\u0bb3\u0b9f\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c \u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fba\u0baa\u1f8c\u0ba4\u1fbf \u0bc7\u0bb5\u1fb6\u1f8c\u1fbb.\n\n\u0bc7\u0b95.\u0b8f.\u0bc7\u0b95. \u0bb0\u1fb4\u0b9a\u0bbf\u1fb7 \u0ba4\u1fbd\u0bae\u0baa\u0bbe\u0bb2, \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd. (\u0baa\u0ba4\u0bbf\u1fbf \u0b95\u0b9f\u0bc8\u0bae \u1f97\u0bbe\u0bbf\u0baa\u0bb5\u1fbd)\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fbb, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4 \u0bc6\u0bae\u1f90\u0bb0\u201d, \u0b87\u0bb0\u0b9c\u0bae\u1fbf\u0bb5\u1fb7\u0ba4 \u1faa\u0ba4\u0bbf, \u0baa\u1fb7\u0ba4\u0bb0\u1f99\u1fbf\u0bc8\u0bb2, 2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0bc7\u0bae \u0bae\u0bbe\u0ba4\u1fbb 30 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf.\n\n07 - 867 / 9\n\n6 A\n\nIII \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2014 \b \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000f\u0010\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0013 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0016 \u0d85\u0018 \u0019\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0dba