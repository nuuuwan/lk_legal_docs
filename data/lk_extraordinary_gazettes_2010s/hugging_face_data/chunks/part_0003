5.\u0b9a\u0ba4\u0bbf\u1fb9 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bb0 \u0b87\u0bb2. \u0b85\u1f92/\u0bc6\u0ba8\u1f92\u0baa/ 2015-04/277/12 \u0b95\u0bc0\u1fc1 \u0b95\u1fbf\u0bc6\u0baa\u0bbe\u1fb0\u0b95 \u0baa\u0bbe\u0bb2 \u0baa\u0b9f\u0bc6\u0baa\u1fb8\u0ba4\u0bbf\u0bc7\u0b95 \u1f81\u1f86\u0bae\u0bbe\u0bb5\u0ba4\u0bbf \u0b8e\u1fb9\u0baa\u0bb5\u1fbd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc6\u0b95\u0bbe\u1fc0\u0b95\u0bbf\u0bb1\u0bbe\u1fbd. 50 0.5055 \u0b85\u0bb0\u1f86 \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a\u0ba4\u0bbf\u1fb9 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bb0 \u0b87\u0bb2. 741/ 256 \u0b95\u0bc0\u1fc1 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bbe\u0bbf \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0b9c\u0baf\u1fb8\u0ba4 \u0b9a\u1fb8\u0ba4\u0bbf\u0bb0\u0bb0\u1fb7\u0ba9 \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0bc6\u0baa\u0baf\u0bb0\u0bbe\u1fbf \u0bc6\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u0b9f\u1fba \u0baa\u1fb5\u1f8c\u1fc0\u0bb3\u1f90.\n\n\u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3 - \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd \u0b95\u0bbe\u0ba3\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0bb5\u0bb4\u1fb0\u0b95\u0bbf\u1fbe\u1f81 \u0b85\u1fbf\u0bb2\u1f90 \u0b95\u0bbe\u0ba3\u0bbf\u1fb7 \u0bb5\u0bbf\u1fc4 \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0\u0b95\u0bbe\u0bb0\u1fbd/ \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0 \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb0\u1f81\u0bbe\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u0ba9\u1f90 \u0b89\u1fb5\u0baa\u1fb5\u0b9f \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1f9e\u1fb0 \u1f90\u1fb6\u1f8a\u1fb9 \u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0b95\u0bbe\u0bb0\u1fbd\u0b95\u0bb3\u0bbf\u1fb9 \u1f99\u1fa8\u1fba \u0b85\