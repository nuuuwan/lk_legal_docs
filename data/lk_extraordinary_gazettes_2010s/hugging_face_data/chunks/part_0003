f90.\u0b87\u0bb2. 166 \u2013 \u0b87\u0bb2. 517/5, \u0ba8\u0bbf\u1fc2\u0b9a\u0bbf\u1f8a \u0bb5\u1fb7\u0ba4, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b95\u0bbe\u0ba9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf, \u0bb0\u1fbb\u1f99\u1f90\u0b95\u0bb2, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b95\u0b9f\u0bb5\u1fb7\u0bc8\u0ba4 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 98 0.0265 \u0bc7\u0baf\u0bbe\u0b95\u0bbe\u0ba9\u0bbf \u0bb0\u1fb7\u0ba9\u0bbe\u0bb5\u1fa2 \u0ba8\u0bb2\u0b95\u0bae \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u0b95 556581410v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 166 \u2013 \u0b87\u0bb2. 517/10, \u0ba8\u0bbf\u1fc2\u0b9a\u0bbf\u1f8a \u1faa\u0b9f\u0bc8\u0bae\u1fba\u1f97, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bb0\u1fbb\u1f99\u1f90\u0b95\u0bb2, \u0b95\u0b9f\u0bb5\u1fb7\u0bc8\u0ba4 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 99 0.0263 \u0bb5\u1f9e\u0ba3\u0bbf \u0bb0\u1fb1\u0b95\u0bbf\u0b95\u0bbe \u0b9a\u0bae\u0bb0\u0ba8\u0bbe\u0baf\u0b95 778490285v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 166 \u2013 \u0b87\u0bb2. 517/9, 4 \u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0ba8\u0bbf\u1fc2 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b9a\u0bbf\u1f8a \u1faa\u0b9f\u0bc8\u0bae\u1fba\u1f97, \u0bc7\u0b95\u0bbe\u0ba9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bb0\u1fbb\u1f99\u1f90\u0b95\u0bb2, \u0b95\u0b9f\u0bb5\u1fb7\u0bc8\u0ba4 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 100 0.0265 \u0ba4\u0bbf\u1f99\u1f90 \u1f97\u1fb7\u0ba4\u0bbf\u0b95 \u0b9a\u0bae\u0bb0\u0ba8\u0bbe\u0baf\u0b95 813031175x \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 166 \u2013 \u0b87\u0bb2. 517/9, 4 \u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0ba8\u0bbf\u1fc2\u0b9a\u0bbf\u1f8a \u1faa\u0b9f\u0bc8\u0bae\u1fba\u1f97, \u0bc7\u0b95\u0bbe\u0ba9\u0bc7\u0bb9\u0ba9 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u1faa\u0ba4\u0bbf, \u0bb0\u1fbb\u1f99\u1f90\u0b95\u0bb2, \u0b95\u0b9f\u0bb5\u1fb7\u0bc8\u0ba4 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90.\n\n16 A III \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u2013 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u2013 2019.08.21\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.08.21\n\n103 0.0304 \u0b85\u1fbd\u0b9a\u0bbe \u0bae\u0bb0\u1fb0\u0b95\u0bb2 \u0ba4\u0baf\u0bbe\u0ba8\u1fb8\u0ba4 195922901290 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 166 \u2013 \u0b87\u0bb2. 517/12, \u0ba8\u0bbf\u1fc2\u0b9a\u0bbf\u1f8a, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf\n\n\u0bb0\u1fbb\u1f99\u1f90\u0b95\u0bb2, \u0b95\u0b9f\u0bb5\u1fb7\u0bc8\u0ba4 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb, \u0b85\u0bb0\u0b9a \u0baa\u0bbe\u1f90\u0b95\u0bbe\u1fba\u1f97 \u0b85\u0bc8\u0bae\u1fb2\u0b9a\u0bbf\u1fb9\n\n\u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bbe\u0bbf\u0ba9\u0bbe\u1fbf \u0ba8\u0bbf\u0bb0\u0bbe\u0b95\u0bbe\u0bbf\u1fb0\u0b95 \u1f99\u1f8a\u0baf\u0bbe\u0ba4\n\n\u0b85\u1fb5\u0bc7\u0b9f\u0bbe\u1fbd\u0ba9\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90.\n\n104 0.0530 \u0b85\u1f81\u0bb2\u0bc7\u0bb9\u0ba9 \u1f90\u0bb0\u0bc7\u0b95 \u0b95\u0bbe\u0bae\u0bbf\u0ba9\u0bbf 197127400353 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 166 \u2013 \u0b87\u0bb2. 517/14, \u0ba8\u0bbf\u1fc2\u0b9a\u0bbf\u1f8a \u1faa\u0b9f\u0bc8\u0bae\u1fba\u1f97, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b95\u0bbe\u0ba9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf, \u0bb0\u1fbb\u1f99\u1f90\u0b95\u0bb2, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81"
