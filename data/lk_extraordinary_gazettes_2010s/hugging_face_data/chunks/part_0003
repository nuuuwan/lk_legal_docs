    "chunk_text": "\u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u00fa \u0dd9\u0dc0\u01e6\u0dd9\u0dc0\u01e6 \u0dba\u023c \u0dc0\u0255\u0dcf\u0db4\u0dcf\u0dbb\u0dba\u0d9a \u0dc3\u0d82\u026a\u0db0\u0dcf\u0db1\u0dba, \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0dd9\u0dc4\u02a4 \u0d9a\u0dc5\u0db8\u0dab\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0db4\u0dd0\u0dc0\u025c \u0d87\u01af \u0dd9\u0dc0\u0db1\u01ae \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u00fd\u0daf\n\n\u0d87\u01b1\u0dc5\u01ae \u0dd9\u0269.\n\n25. \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u0286\u0d82\u0dc4\u0dbd \u0dd9\u0daf\u0db8\u0dc5 \u0db7\u0dcf\u0dc2\u0dcf \u0db4\u0dcf\u0da8 \u0d85\u0dad\u0dbb \u0dba\u023c \u0d85\u0db1\u01e9\u00fe\u0dbd\u0dad\u0dcf\u0dc0\u0dba\u00fa \u0d87\u01af \u026c\u0dc0\u0dd9\u0dc4\u02a3\u01ae \u0d91\u026a\u0da7 \u0286\u0d82\u0dc4\u0dbd \u0db4\u0dcf\u0da8\u0dba \u021d\u023f\u0d9b \u0dd9\u0269.\n\n\u0dc0\u01ae\u0dad\u0dbd \u0db8\u0dcf\u0dd9\u0db6\u02a4\u0dbd \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0db6\u01ca\u0daf\u00fa \u0dc4\u0dcf \u0d9c\u0dcf\u0dc3\u0dca\u01b1\u0dc0\u00fa \u01e7\u0dba\u0db8 \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\n\n\u0dd9\u0dad\u02a3\u0dbb\u01b1\u025e \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8 \u0218\u0298\u0db6\u0db3 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0.\n\n8. \u0dc3\u0db7\u0dcf\u0db4\u01af \u0dd9\u0dc0\u0dad \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u0db1 \u0dd9\u0dad\u02a3\u0dbb\u01b1\u025e \u0dc3\u0dad\u0255 \u0dd9\u0dad\u02a3\u0dbb\u01b1\u025e \u026a\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb \u0d9a\u025e\u019f \u0dc0\u0dc3\u01e6 \u0dd9\u0db1\u02a3\u0d9a\u0dc5\u0252\u01b1\u0dba.\n\n9. \u0d89\u0dc4\u0dad 5 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0d89\u0262\u0dbd\u0dcf \u0286\u0179\u01e9 \u0dbd\u0db6\u0db1 \u0dc0\u0dcf\u0dbb \u0dc0\u0dcf\u0259\u0dad\u0dcf\u0dc0\u0dbd\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dd9\u0dad\u02a3\u0dbb\u01b1\u025e \u0db4\u025c\u00fa\u0dc2\u0dcf \u00fb\u025d\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u0255 \u0dc0\u01e6\u0dd9\u01e6 \u0db1\u023c\n\n\u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u0255\u0dcf\u0db4\u0dcf\u025c\u0d9a \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0da7 \u0d9a\u0259\u0db8\u0dcf\u01e6\u0dad \u0db4\u025c\u0279\u0dba\u0da7 \u0db4\u0dd0\u023d\u0dab \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0dd9\u0dc4\u02a4 \u0db6\u0dbd\u0dba \u0db4\u0dd0\u0dc0\u025f \u01e7\u0dbd\u0db0\u0dcf\u025c\u0dba\u0dcf\u0da7 \u0d91\u0db8 \u0dd9\u0db4\u02a3\u01ae \u0db4\u01ae\u0dc0\u0dbd \u0dc3\u0dad\u0255\u0dad\u0dcf\u0dc0\u0dba \u0db4\u025c\u00fa\u0dc2\u0dcf \u00fb\u025d\u0db8 \u01e8\u0dad\u0255\u0dcf\u01e9\u00fe\u0dbd\u0dc0\u01e6\u0dd9\u01e6\u0dba. 10. \u0dd9\u023c \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbd \u0d9a\u0dc0\u0dbb \u026d \u0dd9\u0dc4\u02a4 \u026a\u01dd\u026a\u0db0\u0dcf\u0db1\u0dba\u00fa \u0d9a\u0da9\u00fb\u025d\u0db8 \u0dd9\u0dc4\u02a4 \u0d8b\u0262\u0dbd\u0d82\u0d9d\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc0\u0dbb\u0daf\u00fa \u0dc0\u0db1 \u0d85\u0dad\u0dbb, \u01e7\u0286 \u0db6\u0dbd\u0dba \u0d87\u01af \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dba\u00fa \u0db8\u0119\u01e6 \u0d92 \u0dc0\u0dbb\u0daf\u0d9a\u0da7 \u0dc0\u0dbb\u0daf\u0d9a\u025e \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022d\u026a\u0da7 \u01e7\u0dba\u0db8 \u0d9a\u0dc5 \u0dc4\u0dd0\u00fb \u0d8b\u0db4\u025c\u0db8 \u0daf\u0da9\u0dba \u0dc3\u0dc4 \u0d91\u0db8 \u0d9a\u0da9 \u00fb\u025d\u0db8 \u0dd9\u0dc4\u02a4 \u0d8b\u0262\u0dbd\u0d82\u0d9d\u0db1\u0dba \u0dd9\u0db1\u02a3\u0d9a\u0da9\u0dc0\u0dcf \u0dad\u0dc0\u01d0\u0dbb\u0da7\u01ae \u0d9a\u0dbb\u0dd9\u0d9c\u0db1 \u0dba\u0db1 \u026a\u0dd9\u0da7\u0d9a \u0d92 \u0218\u0298\u0db6\u0db3\u0dc0 \u0dc0\u0dbb\u0daf\u0d9a\u025e \u00fb\u025d\u0dd9\u0db8\u01e6 \u0db4\u0288\u0dc0 \u0dd9\u0dc4\u02a4 \u0d8b\u0262\u0dbd\u0d82\u0d9d\u0db1\u0dba \u0d9c\u0dd0\u0db1 \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0dd9\u0dba\u02a3\u023f\n\nIV (\u0d85) \u0dd9\u0d9a\u02a3\u0da7\u0dc3 : \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba - 2019.06.04 36 A\n\n\u0d9a\u0dbb\u023d\u01e6 \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0dd9\u0dc4\u02a4 \u0db6\u0dbd\u0dba\u0dbd\u01ae \u0dd9\u0dc0\u0db1\u01ae \u01e7\u0dbd\u0db0\u0dcf\u025c\u0dd9\u0dba\u00fd \u026a\u0286\u01e6 \u0263\u0110\u0dad \u0daf\u0dd0\u01e6\u026b\u0db8\u00fa \u0db7\u0dcf\u0dbb \u0dd9\u0daf\u01e9 \u0dbd\u0dd0\u022b\u0dd9\u0db8\u01e6 \u0db4\u0288\u0dc0 \u0d9a\u0da9 \u00fb\u025d\u0db8 \u0dd9\u0dc4\u02a4 \u0d8b\u0262\u0dbd\u0d82\u0d9d\u0db1\u0dba \u0dad\u0dc0\u01d0\u0dbb\u0da7\u01ae \u0dd9\u0db1\u02a3\u0d9a\u0da9\u0dc0\u0dcf \u0d9a\u0dbb\u0dd9\u0d9c\u0db1 \u0dba\u0db1 \u0dc3\u0dd1\u0db8 \u0d91\u00fa \u01ce\u0db1\u0dba\u00fa \u0dc3\u0db3\u0dc4\u0dcf\u0db8 \u01e7\u0dba\u0db8 \u0d9a\u0dc5 \u0dc4\u0dd0\u00fb \u0d85\u01af\u0dd9\u0259\u0d9a \u0daf\u019c\u0da9\u0db1\u0dd9\u024f \u0d8b\u0db4\u025c\u0db8\u0dba \u0218\u0298\u0dd9\u0dc0\u0263\u01e6, 255 \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dba \u0dc0\u0db1 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0d86\u0da5\u0dcf \u0db4\u0db1\u0dd9\u01ae 153 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u0dba\u028f (2) \u0d8b\u0db4 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u0dba\u01e6 \u01e7\u0dba\u0db8 \u0d9a\u0dbb \u0d87\u01af \u0d8b\u0db4\u025c\u0db8 \u0daf\u0da9 \u023f\u0daf\u0dbd \u0dc4\u0dcf \u0d85\u01af\u0dd9\u0259\u0d9a \u0daf\u019c\u0da9\u0db1\u0dd9\u024f \u0d8b\u0db4\u025c\u0db8\u0dba\u0d9a\u0da7 \u0dba\u0da7\u01ae \u026a\u0dba \u0252\u01b1\u0dba. 11. \u0db4\u0daf \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d85\u0db1\u0255 \u0d85\u0259\u0dae\u0dba\u00fa \u0d85\u0dc0\u0dc1\u0255\u0dc0\u01e6\u0dd9\u01e6 \u0db1\u023c \u023d\u0dc3 \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269,\n\n\u201c\u0dc3\u0db7\u0dcf\u0db4\u01af\u201d\u0dba\u01e6\u0dd9\u0db1\u01e6 \u0dc0\u01ae\u0dad\u0dbd \u0db8\u0dcf\u0dd9\u0db6\u02a4\u0dbd \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u0daf,\n\n\u201c\u0dc3\u0db7\u0dcf\u0dc0\u201d\u0dba\u01e6\u0dd9\u0db1\u01e6 \u0dc0\u01ae\u0dad\u0dbd \u0db8\u0dcf\u0dd9\u0db6\u02a4\u0dbd \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dd9\u0269.\n\n\u201c\u0db6\u0dbd\u0dba\u0dbd\u01ae \u01e7\u0dbd\u0db0\u0dcf\u025c\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6 \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0db6\u0dbd\u0dba \u0db4\u0dc0\u0dbb\u0db1 \u0dbd\u0daf \u01e7\u0dbd\u0db0\u0dcf\u025c\u0dd9\u0dba\u00fd \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dd9\u0d9a\u0dd9\u0259.\n\n12. \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u0286\u0d82\u0dc4\u0dbd \u0dd9\u0daf\u0db8\u0dc5 \u0db7\u0dcf\u0dc2\u0dcf \u0db4\u0dcf\u0da8 \u0d85\u0dad\u0dbb \u0dba\u023c \u0d85\u0db1\u01e9\u00fe\u0dbd\u0dad\u0dcf\u0dc0\u0dba\u00fa \u0d87\u01af \u026c\u0dc0\u0dd9\u0dc4\u02a3\u01ae \u0d91\u026a\u0da7 \u0286\u0d82\u0dc4\u0dbd \u0db4\u0dcf\u0da8\u0dba \u021d\u023f\u0d9b \u0dd9\u0269."
  },
