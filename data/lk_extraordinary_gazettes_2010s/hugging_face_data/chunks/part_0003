u0bcd\u0baf\u0bbe\u0baf - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0654 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c De \u1f9c\u0bae\u0bcd, Da \u1f9c\u0bae\u0bcd; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Da, Cy, \u0bc7\u0b9c.\u0b8f. \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bbe\u1fa2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0bcd\u0baf\u0bbe\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b8e\u0b9a\u0bcd.\u0baa\u0bbf.\u0baa\u0bc0.\u0bc7\u0b95. \u0bb5\u0bbf\u0bc7\u0b9c\u0bb0\u0ba4\u0bcd\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0bcd\u0baf\u0bbe\u0baf; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u0b8e\u0b9a\u0bcd.\u0baa\u0bbf.\u0baa\u0bc0.\u0bc7\u0b95. \u0bb5\u0bbf\u0bc7\u0b9c\u0bb0\u0ba4\u0bcd\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0bcd\u0baf\u0bbe\u0baf, \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0ba4\u0bbf\u0b95\u0bcd\u0baf\u0bbe\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c Dc; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Dc \u1f9c\u0bae\u0bcd, De \u1f9c\u0bae\u0bcd. 105. \u1f90\u0ba3\u0bcd\u1f8c Dc \u2013 \u0ba4\u0bbf\u0b95\u0bcd\u0baf\u0bbe\u0baf - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0121 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Dc \u1f9c\u0bae\u0bcd, Db \u1f9c\u0bae\u0bcd; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Db, \u0b8e\u0b9a\u0bcd.\u0baa\u0bbf.\u0baa\u0bc0.\u0bc7\u0b95. \u0bb5\u0bbf\u0bc7\u0b9c\u0bb0\u0ba4\u0bcd\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0bcd\u0baf\u0bbe\u0baf \u0ba