95\u1fc0 \u0b95\u1fc0 300 0.0303 \u0b9c\u0bc1\u0bb5\u1fb9 \u0bc6\u0bb9\u1fb5\u1f8a\u0bc7\u0b95 \u0b85\u0bae\u0bbf\u0bb2 \u0bc6\u0bb0\u0bbe\u0bb9\u0bbe\u1fb9 683150762v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 296 \u2013 \u1f81\u0bae\u0bbe\u0bb0 \u0b9a\u0bbf\u1fbf\u0bb5\u0bbe \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 48/1, \u0bc7\u0ba4\u0bb5\u0bbe\u0bb2\u0baf \u1faa\u0ba4\u0bbf, \u0bc7\u0bb5\u0bb5\u0bb2, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb, \u0baa\u0bbf\u1fa2\u0baf\u1fb8\u0ba4\u0bc8\u0bb3 \u0bc6\u0b95\u0bbe\u0bae\u1fbd\u0bb7\u1fbf \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fbf \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 800 0.0460 \u0b85\u0bc7\u0baa\u0b9a\u0bbf\u1fb1\u0bb9 \u0bc6\u0bb9\u1fb5\u1f8a\u0bc7\u0b95 \u1f90\u0bb7\u0bbf\u0ba4\u0bbe 656351365v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0bc7\u0bb9\u0bae\u0bbe\u1fa2 \u1faa\u0bb0\u0bc7\u0b95\u0bbe\u1fb9 \u0b87\u0bb2. 63/\u0b8f, \u0bc7\u0ba4\u0bb5\u0bbe\u0bb2\u0baf \u1faa\u0ba4\u0bbf, \u0bc7\u0bb5\u0bb5\u0bb2, \u0baa\u0bbf\u1fa2\u0baf\u1fb8\u0ba4\u0bc8\u0bb3 08 - 365 / 48\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1