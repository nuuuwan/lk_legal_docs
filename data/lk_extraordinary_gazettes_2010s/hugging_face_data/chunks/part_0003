3051125v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0bb5\u1fb1\u0b95\u0bbf, \u2013 \u0bb0\u1fc4\u0bc6\u0b9f\u0bbe\u1fba \u0b90\u0ba4\u1fbd \u0baa\u0bbe\u1fb2\u0b9a\u0bbe 2\u0bb5\u1f90 \u0b95\u0bbf\u0bc8\u0bb3, \u0b87\u0bb2. 210, \u0b95\u1fb6\u1f8a \u1faa\u0ba4\u0bbf, \u0bae\u1fbf\u0bb2\u0bb5\u0baa\u0bbf\u1f8a\u0baf \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fa2\u1fbf \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 46 0.0539 \u0b95\u0bc7\u0b9f\u0bb5\u1fb7\u0bc7\u0ba4 \u0bc6\u0b95\u0ba4\u0bb0 \u0b95\u0bae\u1fbf \u0baa\u0bbf\u0baf\u0bc7\u0b9a\u0ba9 541612858v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 57 \u2013 \u0b87\u0bb2. 266/9, \u0bae\u1fbf\u0bb2\u0bb5\u0baa\u0bbf\u1f8a\u0baf, \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bb9\u1fbe\u0bb1\u1fb9 \u0bc6\u0ba8\u0bb7\u0ba9\u1fbf \u0bb5\u1fb1\u0b95\u0bbf, \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fa2\u1fbf \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 71 0.0393 1. \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u1fb0\u0b95 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 197331703955 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 67 \u2013 \u0b87\u1fb8\u1f90\u0ba9\u0bbf\u1fbf \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u1fb0\u0b95 \u0b9a\u0bae \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf 2. \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u1fb0\u0b95 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 742223400v \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b87\u1fb8\u0ba4\u0bbf\u1fb0\u0b95 \u0b9a\u1fb4\u0b9c\u0bc0\u0bb5 \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u1fb0\u0b95 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 3. \u0b9a\u0bae\u0bbf\u1fb8\u0ba4 \u0baa\u0bbf\u0bb0\u0ba4\u0bc0\u1fba \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u1fb0\u0b95 770262852v \u0b87\u0bb2. 608/5, \u0bc6\u0b95\u0bbe\u1fc4\u0b95\u0bb9\u1f99\u0bb2\u0bb5\u1fb7\u0ba4, \u0b95\u1fb6\u1f8a \u1faa\u0ba4\u0bbf, \u0bae\u1fbf\u0bb2\u0bb5\u0baa\u0bbf\u1f8a\u0baf, \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf 91 0.0557 \u1f99\u0bb9\u1fb8\u0ba4\u0bbf\u0bb0\u1fbb\u0bb0\u0bbe\u0bb2\u0bb2\u0bbe\u0bc7\u0b95 \u0ba4\u0bb2\u0ba4\u0bbe \u0b9e\u0bbe\u0ba3\u0bb5\u0ba4\u0bbf 498644694v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 145 \u2013 \u0bae\u1fbf\u1fa2\u0b95\u0bbe \u1f81\u0bae\u0bbe\u0bbe\u0bbf\u0bb9\u0bbe\u0bae\u0bbf \u0baa\u0bbe\u0bc8\u0ba4 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b87\u0bb2. 49/5, \u0bc6\u0bb2\u1fbb\u0baa\u1fb5 \u0bb5\u1fb7\u0ba4, \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bae\u1fbf\u0bb2\u0bb5\u0baa\u0bbf\u1f8a\u0baf, \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf 92 0.0570 \u0bb0\u1fb7\u0ba8\u0bbe\u0baf\u1fb0\u0b95 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0bae\u0bbe\u0bb2\u0b95 822630596v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 145 \u2013 \u0bae\u0bbf\u0bb9\u0bbf\u0bb0 \u0baa\u1fb6\u0b9f\u0bbe\u0bb0 \u0baa\u0bbe\u0bc8\u0ba4 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0bae\u0bbf\u1fbf\u0bb2\u0bb5, \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 190 0.0643 1. \u0bb5\u1fbf\u0bb2\u0bb9\u0bc6\u0b95\u0bbe\u1fbf\u0bc7\u0bb2 \u0bc6\u0b95\u0ba4\u0bb0 \u1f99\u1fb4\u1f86\u0bb2 742431444v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 197 \u2013 \u1f81\u0bae\u0bbe\u0bb0 \u0b9c\u0bbf\u0ba9\u0ba4\u0bbe\u0b9a \u0b9a\u0bae \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf 2. \u0b85\u1fa4\u1fb7\u0bb5\u1fb7\u0bc7\u0ba4 \u0bc6\u0b95\u0ba4\u0bb0 \u0ba4\u1f95\u0b9c\u0bbe 715690217v \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u1f81\u0bae\u0bbe\u0bbe\u0bbf \u1f81\u0ba3\u0bb0\u1fb7\u0ba9 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 1 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0bae\u0bbf\u1fbf\u0bb2\u0bb5 \u0bb5\u1fb7\u0ba4, \u0bc6\u0b95\u0bbe\u0bae\u1fbd\u0bb7\u1fbf \u0bb5\u1fb1\u0b95\u0bbf, \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fa2\u1fbf \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 196 0.0515 \u0b85\u1fa4\u1fb7\u0bb5\u1fb7\u0bc7\u0ba4 \u0bc6\u0b95\u0ba4\u0bb0 \u0ba4\u1f95\u0b9c\u0bbe \u1f81\u0bae\u0bbe\u0bbe\u0bbf 715690217v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 197 \u2013 \u1f81\u0ba3\u0bb0\u1fb7\u0ba9 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf 1 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0bae\u0bbf\u1fbf\u0bb2\u0bb5 \u0bb5\u1fb7\u0ba4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fbf \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0bb5\u1fb1\u0b95\u0bbf, \u1f81\u1f9e\u0ba3\u0bbe\u0b95\u1fa2\u1fbf \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90\n\n13 A III \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2013 \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000e\u000f\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0012 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0015 \u0d85\u0017 \u0018\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0dba \u2013 2019.05.29\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bb