f9e\u0ba3\u0bbe\u0bb0\u1fb7\u0ba9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf 1 \u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0bae\u0bbf\u1fbf\u0bb2\u0bb5 \u0bb5\u1fb7\u0ba4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bae\u0bbf\u1fbf\u0bb2\u0bb5 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0b85\u1f94\u0bb0\u0bbe\u0ba4\u1f97\u0bb0\u1fbb, \u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 214 0.0488 \u0bb2\u1fa2\u1fb7 \u0bb5\u0b9a\u1fb8\u0ba4 \u0baf\u0bbe\u0baa\u0bbe \u0baa\u0ba4\u0bbf\u0bb0\u0ba9 702592534v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0baf\u0bbe\u0baa\u0bbe \u2013 \"\u1fad\u0bbe\u0bbf\u0baf\u0bbe \u0bb5\u0bbe\u0b9a\", \u0ba4\u0bbf\u0baf\u0baa\u0bbe\u0bb5, \u0baa\u0ba4\u0bbf\u0bb0\u1fb9\u0bc6\u0ba9\u0bc6\u0bb9\u0bb2\u0bbe\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u0bb0\u1f8a\u0baf\u0bbe\u0bb5 \u0b95\u1f9e\u0ba3\u0bbe\u0ba4\u0bbf\u1fc4\u0bb8 \u0bae\u1fbe\u1fa0\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u1fb5\u0bbe\u0bbf\u1fc4 \u0bb8\u0bc1\u0bb5\u1fbd\u0ba9\u0bb2\u0ba4\u0bbe \u0baf\u0bbe\u0baa\u0bbe \u0baa\u0ba4\u0bbf\u0bb0\u0ba9 \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bae\u1fbe\u1fa0\u1fbb \u0baf\u0bbe\u0baa\u0bbe \u0baa\u0ba4\u0bbf\u0bb0\u1fb9\u0bc6\u0ba9\u0bc6\u0bb9\u0bb2\u0bbe\u0bc7\u0b95 \u0b95\u1f9e\u0ba3\u0bbe\u0ba4\u0bbf\u1fc4\u0bb8 \u0bc7\u0ba4\u0bc8\u0bb5\u0baf\u0bbe\u0ba9 \u0bc7\u0ba8\u0bb0\u1fb7\u0ba4\u0bbf\u1fb9 \u0ba8\u0bbf\u0bb0\u0bbe\u0b95\u0bbe\u0bbf\u1fb0\u0b95 \u1f82\u1f8a\u0baf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 221 \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 215 0.1370 \u0bb2\u1fa2\u1fb7 \u0bb5\u0b9a\u1fb8\u0ba4 \u0baf\u0bbe\u0baa\u0bbe \u0baa\u0ba4\u0bbf\u0bb0\u0ba9 702592534v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0baf\u0bbe\u0baa\u0bbe \u2013 \u201c\u1fae\u0bbe\u0bbf\u0baf\u0bbe \u0bb5\u0bbe\u0b9a\u201d, \u0ba4\u0bbf\u0baf\u0baa\u0bbe\u0bb5, \u0baa\u0ba4\u0bbf\u0bb0\u1fb9\u0bc6\u0ba9\u0bc6\u0bb9\u0bb2\u0bbe\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u0bb0\u1f8a\u0baf\u0bbe\u0bb5 \u0b95\u1f9e\u0ba3\u0bbe\u0ba4\u0bbf\u1fc4\u0bb8 \u0bae\u1fbe\u1fa0\u1fbb \u0baa\u0bbf\u0baf\u1fb5\u0bbe\u0bbf\u1fc4 \u0bb8\u0bc1\u0bb5\u1fbd\u0ba9\u0bb2\u0ba4\u0bbe \u0baf\u0bbe\u0baa\u0bbe \u0baa\u0ba4\u0bbf\u0bb0\u0ba9 \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0bae\u1fbe\u1fa0\u1fbb \u0baf\u0bbe\u0baa\u0bbe \u0baa\u0ba4\u0bbf\u0bb0\u1fb9\u0bc6\u0ba9\u0bc6\u0bb9\u0bb2\u0bbe\u0bc7\u0b95 \u0b95\u1f9e\u0ba3\u0bbe\u0ba4\u0bbf\u1fc4\u0bb8 \u0bc7\u0ba4\u0bc8\u0bb5\u0baf\u0bbe\u0ba9 \u0bc7\u0ba8\u0bb0\u1fb7\u0ba4\u0bbf\u1fb9 \u0ba8\u0bbf\u0bb0\u0bbe\u0b95\u0bbe\u0bbf\u1fb0\u0b95 \u1f82\u1f8a\u0baf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90\n\n31 A\n\nIII \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2013 \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000e\u000f\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0012 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0015 \u0d85\u0017 \u0018\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0dba \u2013 2019.08.19"
