0\u0ba3\u0bcd\u1f8c Ae \u1f9c\u0bae\u0bcd, Ab \u1f9c\u0bae\u0bcd.\n\n27. \u1f90\u0ba3\u0bcd\u1f8c Ad \u2013 \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0193 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Ac, Z \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd Y; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Y, \u0b8e\u0ba9\u0bcd.\u0baa\u0bc0. \u0ba8\u0ba8\u0bcd\u0ba4\u0b95\u0bbe\u0ba8\u0bcd\u0ba4\u0bbf \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc7\u0b95.\u0baa\u0bc0. \u0b9a\u0bb0\u0ba4\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u0bc7\u0b95.\u0baa\u0bc0. \u0b9a\u0bb0\u0ba4\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u0b9c\u0bc0.\u0b90. \u0b95\u0bc1\u0b9a\u0bc1\u0bae\u0bb2\u0ba4\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c Ac \u1f9c\u0bae\u0bcd, Z \u0b89\u0bae\u0bcd.\n\n28. \u1f90\u0ba3\u0bcd\u1f8c Ae \u2013 \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u1f90 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0149 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Af \u0b89\u0bae\u0bcd, Aa \u1f9c\u0bae\u0bcd; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Ab, Ac \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b9c\u0bc0.\u0b90. \u0b95\u0bc1\u0b9a\u0bc1\u0bae\u0bb2\u0ba4\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u0b9c\u0bc0.\u0b90. \u0b95\u0bc1\u0b9a\u0bc1\u0bae\u0bb2\u0ba4\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf, \u1faa\u0ba4\u0bbf, \u0b8e\u0bae\u0bcd.\u0baa\u0bc0.\u0b8f. \u0bae\u0b99\u0bcd\u0b95\u0bb2\u0b95\u0bae \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c Ak \u1f9c\u0bae\u0bcd, Aj \u1f9c\u0bae\u0bcd; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Ak, Aj, Ah, Af \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd Aa.\n\n29. \u1f90\u0ba3\u0bcd\u1f8c Af \u2013 \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0854 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Ag \u1f9c\u0bae\u0bcd, Aa \u1f9c\u0bae\u0bcd; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Ae; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Ae \u1f9c\u0bae\u0bcd, Ah \u0b89\u0bae\u0bcd; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Ah \u0b89\u0bae\u0bcd, Ag \u1f9c\u0bae\u0bcd.\n\n30. \u1f90\u0ba3\u0bcd\u1f8c Ag \u2013 \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0294 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u0b85\u0bb0\u0b9a\u0bc1 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bc7\u0b95 \u0bc7\u0b9a\u0bbe\u0bae\u0bbe\u0bb5\u0ba4\u0bc0 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Aa, Af \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd Ah; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Ah \u0b89\u0bae\u0bcd, An \u0b89\u0bae\u0bcd; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c An, \u0b9f\u0baa\u0bcd.\u0b8e\u0bae\u0bcd.\u0baa\u0bc0. \u0bb5\u0bbf\u0bc7\u0b9c\u0b9a\u0bc2\u0bbe\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b85\u0bb0\u0b9a\u0bc1 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf.\n\n31. \u1f90\u0ba3\u0bcd\u1f8c Ah \u2013 \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0baf\u0bbe\u0baf - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.1409 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Ag \u1f9c\u0bae\u0bcd, Af \u0b89\u0bae\u0bcd; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Af \u0b89\u0bae\u0bcd, Ae \u1f9c\u0bae\u0bcd; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Aj \u1f9c\u0bae\u0bcd, Am \u0b89\u0bae\u0bcd; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Am, An \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd Ag.\n\n32. \u1f90\u0ba3\u0bcd\u1f8c Aj \u2013 \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bc6\u0b95\u0bbe\u0bb