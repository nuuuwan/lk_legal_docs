2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba\n\n\u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0b85\u0ba4\u0bbf\u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90\n\n\u0d85\u0d82\u0d9a 2156 / 5 - 2019 \u0dd9\u0daf\u0dc3\u0dd0\u023c\u0db6\u0259 30 \u0dc0\u0dd0\u01e7 \u0dc3\u01ff\u0daf\u0dcf - 2019.12.30\n\n2156 / 5 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fbb - 2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0ba4\u0bbf\u0bc6\u0b9a\u1fbb\u0baa\u1fbd \u0bae\u0bbe\u0ba4\u1fbb 30 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0ba4\u0bbf\u1fb1\u0b95\u1fb5\u0b95\u0bbf\u0bb4\u0bc8\u0bae\n\n1A - G 31728 - 14 (2019/12 )\n\n\u1f99. \u1f81. - \u0b87\u1fc2 \u0b85\u0ba4\u0bbf\u0bb5\u0bbf\u0bc7\u0bb7\u0b9f \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0bc8\u0baf www.documents.gov.lk \u0b8e\u1f94\u1fbb \u0b87\u0bc8\u0ba3\u0baf\u1fb7\u0ba4\u0bb3\u1fb7\u0ba4\u0bbf\u1fa2\u1f9e\u1fb8\u1f90 \u0baa\u0ba4\u0bbf\u0bb5\u0bbf\u0bb1\u1fb0\u0b95\u1fbb \u0bc6\u0b9a\u1fbc\u0baf \u1f99\u1f8a\u1f9c\u1fbb.\n\n2 A III \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u2013 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u2013 2019.12.30\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.12.30\n\n\u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0bb5\u0bb4\u1fb0\u0b95\u0bbf\u1fbe\u1f81 \u0b85\u1fbf\u0bb2\u1f90 \u0b95\u0bbe\u0ba3\u0bbf\u1fb7 \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0\u0b95\u0bbe\u0bb0\u1fbd/ \u0bc6\u0b9a\u0bb