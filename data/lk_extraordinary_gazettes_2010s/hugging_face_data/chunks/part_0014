d9\u0d9a$\u0016\u0da8\u0dcf\u0dc1\u0dba \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4#\u0d9a\u0dd9\u0013 \u0d9a\u0dcfO\u0dba\u0dcf\u0dbd\u0dba \u0d85\u0d82\u0d9a\u0dba\n\n(\u0dd9\u0dc4)\u0da7\u0dba\u0dcfO) \u0dd9\u0db8$\u0dbbs\u0dc0 \u0d9a,\u0dd9\u0daf5,\u0dbd 520213 \u0d9a\u0dbd\u0dcf\u0db4 07 0.0136 00042541 \u0dd9\u0daf,\u0d9a\u0db3 \u0d9a\u0dd0\u0db6S \u0d85\u0d82\u0d9a 0423 \u0dc3\u0dd0\u0dc5/\u0dba NOP. - \u0d91\u0dc0\u0dd0X \u0d85 #\u0db8 \u0d9a\u0dd0\u0db8# \u0db4\u0018\u0dba) \u0dd9\u0db1$\u0db8\u0dd0# \u0dd9 \u0db4\u0dc5\u0d9a\u0da7 B3\u0d9a- H\u0dba\u0dcf I\u0db1 SV-\u0dc0\u0dbd, \u0d92 \u0dd9 \u0db4\u0dc5\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb #\u0dba\u0dd9- \u0d85\u0d82\u0d9a\u0dba, \u0d89\u0da9- \u0dd9\u0d9a$\u0da7\u0dd9\u0dc39 \u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4 \u0d92 \u0d89\u0da9-\u0da7 B3\u0d9a- \u0db4\u0dd1\u0db8\u0da7 \u0dad\u0db8\u0dcf\u0da7 \u0d87# \u0d85>#\u0dba \u0dc3\u0db3\u0dc4 \u0d9a\u0dbb #o\u0dba VW\u0dba. SV- \u0d9a\u0dc0\u0dd9\u0dbb\u0dd9\u0013 \u0dc0-\u0db4\u0dc3 \u0d8b\u0da9 \u0dd9\u0d9a\u0dc5\u0dc0\u0dd9O \u201c\u0d85 #\u0db8 \u0d9a\u0dd0\u0db8# \u0db4\u0018\u0dba) \u0dd9\u0db1$\u0db8\u0dd0# \u0dd9 \u0db4\u0dc5 c\u0db6\u0db3 \u0d89,q- \u0db4\u0018\u0dba\u201d \u0dbaZ\u0dd9\u0dc0 S\u0dba\u0dcf #o\u0dba VW \u0dba.\n\n01-172/ 2\n\n3 A III \u0dd9\u0d9a \u0da7\u0dc3 - B \u0dbd\u0d82\u0d9a\u0dcf C\u0da2\u0dcf\u0dad\u0dcf\u0013E\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcfF \u0da2\u0db1\u0dbb\u0da2\u0dd9G \u0d85\u0002 \u0004\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3I \u0db4\u0016\u0dba - 2019.12.19\n\n\u0d85\u0013\u0002\u0db8 \u0d9a\u0dd0\u0db8\u0002 \u0db4\u0016\u0dba\u0018 \u0dd9\u0db1 \u0db8\u0dd0\u0002 \u0dd9\u001a\u0db4\u0dbd \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0012\u0db4\u0dd1\u0012 \u0d89\"#\u0db4$ \u0d9a\u0dbb\u0db1 \u0dd9\u0dbd\u0dc3 \u0daf\u0dd0\u0013'\u0db8 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u0d9a\u0012 -\u0dba\u0dcf\u0db4\"\u0d82. /0\u0dd9\u0012 \u0db4\u0db1\u0dad (5