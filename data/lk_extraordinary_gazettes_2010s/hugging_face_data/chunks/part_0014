III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.12.27\n\n\u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0bb5\u0bb4\u1fb0\u0b95\u0bbf\u1fbe\u1f81 \u0b85\u1fbf\u0bb2\u1f90 \u0b95\u0bbe\u0ba3\u0bbf\u1fb7 \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0\u0b95\u0bbe\u0bb0\u1fbd/ \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0 \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb0\u1f81\u0bbe\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u0ba9\u1f90 \u0b89\u1fb5\u0baa\u1fb5\u0b9f \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1f9e\u1fb0 \u1f90\u1fb6\u1f8a\u1fb9 \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0b95\u0bbe\u0bb0\u1fbd\u0b95\u0bb3\u0bbf\u1fb9 \u1f99\u1fa8\u1fba \u0bc6\u0baa\u0baf\u1fbd\u0b95\u1fa6\u1fbb \u0b85\u0bc8\u0b9f\u0baf\u0bbe\u0bb3 \u0b87\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 \u0bb5\u1f81\u1fba\u1f97\u1fbb \u0b88\u1f8c, \u1f81\u1fb7 \u1f81\u0bbe\u0bbf\u0baf \u0b9a\u1fb5\u0b9f\u1fb1 \u0b87\u0bb2. \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u1f9c\u1fbb \u0b85\u1fb5\u0bc8\u0b9f \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0b87\u0baf\u1fbf\u1f97\u1fbb \u0ba4\u0bc8\u0b95 \u0b95\u1fa6\u1fc0 \u0b8e\u1fc2 (\u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u0bbe\u1fbd) \u0b87\u0bb2. \u0ba4\u1f8c\u1fba\u1f97\u1fb0 \u0bb5\u0bc8\u0b95\u1fb0\u1f81\u1fbb \u0b95\u1fb5\u0b9f\u0bc8\u0bb3 \u0b85\u0bc8\u0bae\u1fb8\u0ba4\u0bbf\u1f9e\u1fba \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0baa\u0bbf\u1fb9 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0 \u0b95\u1fc0\n\n140 0.0032 \u0ba4\u1f81\u0bb0\u0bbe\u1fbd\u0ba4 \u0bc7\u0ba4\u0bb5\u0bbe\u0ba4\u0bbf\u1fb7\u0baf \u0bae\u0bb9\u0baa\u0b9f\u0bc6\u0baa\u1fb8\u0ba4\u0bbf 615863670v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 - - \u0b95\u0bbe\u0bb0\u1fb7\u0baf\u0bb5\u0b9a\u1fbb \u1fa2\u1fb8\u0ba4\u1f99\u0bb2\u0bc7\u0b95 \u0b95\u0bbe\u0bae\u1fa2 \u0b9a\u0bae\u1fb9\u0bb2\u0ba4\u0bbe \u0ba4 \u0b9a\u0bbf\u1fbf\u0bb5\u0bbe \u0b87\u0bb2. 4/\u0b8e, \u0baa\u1fbb\u1f97\u1f8c\u0bb5 \u1faa\u0ba4\u0bbf, \u0baa\u0bb9\u0bb2 \u0b87\u1fb8\u0ba4\u0bbf\u0bc6\u0baa\u1fb7\u0ba4, \u0bc6\u0bae\u0bbe\u0bb0\u1f8c\u0bb5 01 - 352 / 1 1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb 14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf 1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b8e\u0ba9\u1fb0\u1f81\u0bbe\u0bbf\u1fb7\u0ba4\u0bbe\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0ba4\u1fb7\u1f90\u0bb5\u1fb1\u0b95\u0bb3\u0bbf\u1fb9 \u0baa\u0baf\u0bc8\u0ba9\u1fb0\u0bc6\u0b95\u0bbe\u1fb6\u1f8c, \u0b95\u0bc0\u0bc7\u0bb4 \u0b92\u1fba\u0baa\u0bae\u0bbf\u1fb5\u1f8c\u1fc0\u0bb3 \u0ba8\u0bbe\u1fb9, 1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 55 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u1fb9\u0baa\u1f8a 2017.06.06 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf 2022/13 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\