d0 \u0dd9\u02c6{\u0dd9< \u0dbdN \u0dd9{3\u0dba \u0db8\u0dc4\u0dad\u0dcf\u0dd9< \u0d85 #\u0db8 \u0d9a\u0dd0\u0db8# \u0db4\u0018\u0dba) \u0dd9\u0db1$\u0db8\u0dd0# \u0dd9 \u0db4\u0dc5 \u0dc3-\u0db6 \u0db0\u0dc0>. 3\u0dba4\u0dba 1\u0da2\u0dba\u0dbd0 \u0dd9\u02c6{\u0dd9< \u0dbdN \u0dd9{3\u0dba \u0db8\u0dc4\u0dad\u0dcf\u0da7 \u0d85\u0dba0 \u0dc0 #@A \u0dc4\u0dcf \u0dd9\u0db8B \u0d8b\u0db4\u0dd9,\u0d9b\u0db1\u0dd9\u0013 1\u0dc3\u0dca\u0dad\u0dbb \u0dd9\u0d9a$\u0da7 \u0d870\u0dad\u0dcf F, \u0d85 #\u0db8 \u0d9a\u0dd0\u0db8# \u0db4\u0018\u0dba) \u0dd9\u0db1$\u0db8\u0dd0# \u0dd9 \u0db4\u0dc5\u0da7 B3\u0d9a- H\u0dba\u0dcf I\u0db1 \u0dd9\u0dc4J \u0dc3-\u0db6 \u0db0\u0dad\u0dcf\u0dc0\u0dba) \u0d87# \u0dd9\u0dc4J \u0db1\u0dd0\u0dad\u0dd00\u0dd9\u0dadK/ \u0dad\u0dd0\u0db1\u0dd00\u0dad 1 \u0d91N \u0d85 #\u0db8 \u0d9a\u0dd0\u0db8# \u0db4\u0018\u0dba) \u0dd9\u0db1$\u0db8\u0dd0# \u0dd9 \u0db4\u0dc5\u0da7 \u0dad\u0db8\u0dcf\u0dd9< \u0d87# \u0d85>#\u0dba \u0dd9\u0dc4J \u0dc3-\u0db6 \u0db0\u0dad\u0dcf\u0dc0 \u0d9a\u0dc0\u0dd9O\u0daf\u0dd0> 2020 \u0da2\u0db1\u0dc0\u0dcf8 20 '\u0db1\u0da7 \u0dd9\u0db4\u0dbb \u0db4\u0dc4\u0dad \u0d850\u0dc3 \u0d9a\u0dbb\u0db1 \u0d85\u0dba \u0dd9\u0dc0\u0dad ST\u0dad\u0dc0 \u0d89'8\u0db40 \u0d9a\u0dc5 VW \u0db6\u0dc0 \u0dd9\u0db8> X\u0dd9Y\u0daf\u0db1\u0dba \u0d9a\u0dbbZ \u0dbd\u0dd0\u0dd9[. \u0d91\u0dd9\u0dc39 H\\\u0db8 \u0db4\u0dd0\u0dc4\u0dd0\u0dbb \u0dc48Z \u0dbd\u0dd0@\u0dc0\u0dd9\u0dc4$0, 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 B3\u0d9a- S\u0dba\u0dcf\u0db4'\u0d82` H\\\u0dd9- \u0db4\u0db1\u0dd90 55 \u0dc0\u0db1 \u0dc0\u0d9c #\u0dd9\u0013 (2) \u0dc0\u0db1 \u0dc3\u0dc4 (3) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c # \u0dba\u0da7\u0dd90 \u0d92 \u0dd9 \u0db4\u0dc5 c\u0db6\u0db3 \u0d85>#\u0dba S\u0dba\u0dcf\u0db4'\u0d82` H\\\u0db8\u0da7 \u0d92\u0d9a\u0db4\u0dcf)e\u0d9a\u0dc0 \u0dba\u0dc0\u0dbb \u0d9cZ \u0dbd\u0dd0\u0dd9[.\n\n2.\u0d91\u0012.\u0d915. 6\u0dba\u0daf7\u0dc18, B3\u0d9a- X\u0dbbf, H\\\u0dd9- \u0dd9\u0d9a$\u0db8\u0dc3\u0dcf8\u0dc3\u0dca \u0da2\u0d