0b95\u1fc4 \u0b9a\u1fb8\u0ba4\u0bbf, \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 23 0.0336 \u0b95\u1fa4\u0b95\u0bae\u0bc7\u0b95 \u0bb0\u0ba9\u0bbf\u1fbf \u0b86\u1fb6\u0b9f\u0ba9\u0bbf \u0baa\u1fbd\u0ba9\u0bbe\u1fb8\u1f90 803581711v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u2013 \u0b87\u0bb2. 126 \u0b8f, \u0ba8\u1f8c\u0bb5\u0bbf\u1fbf \u1f90\u1fbb\u0bae\u0bb2\u0bc7\u0ba4\u0ba9\u0bbf\u0baf, \u0b87\u1fb2\u0b9a\u1fbb\u1f97\u1fbf\u1fa2\u0bc7\u0b95 \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u0b9c\u0b9a\u0bbf\u1fb8\u0ba4\u0bbe \u0bae\u0bbf\u0bb2\u0bbe\u0ba9\u0bbf \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 25 \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 56 0.1270 \u0b86\u1fa0\u1f99\u0b95\u1fbb \u1f97\u1fc3\u0baa\u0bb0\u0bbe\u0b9c\u0bbe 602700577v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 42 \u0b87\u1fb9 \u2013 \u0b87\u0bb2. 133/\u1f8b, \u0ba8\u1f8c\u0bb5\u0bbf\u1fbf \u1f90\u1fbb\u0bae\u0bb2\u0bc7\u0ba4\u0ba9\u0bbf\u0baf, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 72 0.0067 \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1fbd \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 71 \u1fbe\u1f81 \u0baa\u0bbf\u0bb0\u0bc7\u0bb5\u0b9a\u0bbf\u1fba\u0baa- \u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 84 0.0530 \u0b95\u1fa4\u0b95\u0bae\u0bc7\u0b95 \u0bb0\u1faa\u1fb9 \u0ba4\u1f94\u1fc3\u0b95 \u0baa\u1fbd\u0ba9\u0bbe\u1fb8\u1f90 890901212v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u2013 \u0b87\u0bb2. 114/1, \u0bc6\u0ba4\u1fbe\u1f81 \u0b95\u0b9f\u0bb5\u0ba4, \u0b87\u1fb2\u0b9a\u1fbb\u1f97\u1fbf\u1fa2\u0bc7\u0b95 \u0b89\u1fbf\u0bb9\u0bbf\u1f8a\u0baf\u0bbe\u0bb5 \u0b9c\u0b9a\u0bbf\u1fb8\u0ba4\u0bbe \u0bae\u0bbf\u0bb2\u0bbe\u0ba9\u0bbf \u0baa\u1fbd\u0ba9\u0bbe\u1fb8\u1f90 \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 25 \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bae\u1fb0\u0b95\u1fc0 \u1f81\u1fb7\u0ba4\u0bc8\u0b95 \u0bae\u1fbe\u1fa0\u1fbb \u0baa\u0bbf\u0bc7\u0ba9\u1fb9\u1fc4 \u0b95\u1fbb\u0baa\u0ba9\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 2018.11.08 \u0bc6\u0ba4\u0bbe\u0b9f\u1fb0\u0b95\u1fbb 2 \u0bb5\u1f9e\u0b9f\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bc7\u0b95\u0bb5\u0bbf\u0baf\u1fb5 \u0ba4\u0bc8\u0b9f\u0bc6\u0baf\u0bbe\u1fb9\u1fa0 \u0b8f\u1fbe\u0baa\u1f8c\u1fb7\u0ba4\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3\u1f90 108 0.1784 \u0b86\u0bbe\u0bbf\u0baf\u0bb5\u1fb1\u0bb8 \u0bc7\u0bb9\u0bb5\u0bbe \u0bb5\u0bbf\u0b95\u0bbf\u0bb0\u0bae\u1f90\u1fb1\u0b95 470692243v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u1fad\u0bbe\u0bc0\u0baa\u0bbe\u1fa2, \u0b87\u0bb2. 353, \u1f90\u1fbb\u0bae\u0bb2\u0bc7\u0ba4\u0ba9\u0bbf\u0baf, \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5\n\n8 A\n\nIII \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2013 \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000e\u000f\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0012 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0015 \u0d85\u0017 \u0018\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0dba \u2013 2019.09.25\n\n\u0baa\u