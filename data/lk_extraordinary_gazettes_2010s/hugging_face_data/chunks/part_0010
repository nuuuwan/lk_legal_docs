ba4\u0bbf\u0bb1\u0bc8\u0bae \u0b85\u1f8a\u0baa\u0bcd\u0baa\u0bc8\u0b9f\u0baf\u0bbf\u0bb2\u0bcd \u0b86\u0b9f\u0bcd\u0bc7\u0b9a\u0bb0\u0bcd\u0baa\u0bcd\u1f97\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0ba4\u0bb2\u0bcd\n\n7.5.1 \u0b86\u0b9f\u0bcd\u0bc7\u0b9a\u0bb0\u0bcd\u0baa\u0bcd\u1f97\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0ba4\u0bb0\u0bae\u0bcd - \u0ba8\u0bbf\u0bc8\u0bb1\u0bc7\u0bb5\u0bb1\u0bcd\u1fa0\u0ba4\u0bcd\u0ba4\u0bb0 \u0bb5\u0bc8\u0b95 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 I \u0ba4\u0bb0\u0bae\u0bcd III\n\n7.5.2 \u0ba4\u0bc8\u0b95\u0bc8\u0bae\u0b95\u0bb3\u0bcd :-\n\nI. \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 II \u0ba4\u0bb0\u0bae\u0bcd I \u0b89\u0ba4\u0bb5\u0bbf \u0bb5\u0bbf\u0bc8\u0bb2\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bbe\u0bb3\u0bb0\u0bbe\u0b95 \u0b87\u1f9e\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd.\n\nII \u0bc6\u0bb5\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0bb3 / \u0b85\u1fa4\u0bb5\u0bb2\u0b95 \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bc7\u0baf\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd \u0bb5\u0b95\u0bc1\u0ba4\u0bbf 2 \u0b95\u0bcd\u0b95\u0bc1\u0bbe\u0bbf\u0baf \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 II \u0ba4\u0bb0\u0bae\u0bcd I \u0b87\u0bb1\u0bcd\u0b95\u0bc1\u0bbe\u0bbf\u0baf \u0bb5\u0bbf\u0bc8\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0ba9\u0bcd\u0b95\u0bbe\u0ba3\u0bcd \u0ba4\u0bc8\u0b9f\u0ba4\u0bbe\u0ba3\u0bcd\u0b9f\u0bb2\u0bcd \u0baa\u0bbe\u0bc0\u0b9f\u0bcd\u0bc8\u0b9a\u0baf\u0bbf\u0bb2\u0bcd \u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bc8\u0b9f\u0ba8\u0bcd \u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd.\n\nIII. \u0bb5\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bc7\u0b95\u0bbe\u0bb0\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0bbf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u1fa2\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0ba9\u0bcd \u1f99\u0ba9\u0bcd\u0ba9\u0bb0\u0bbe\u0ba9 05 \u0bb5\u1f9e\u0b9f \u0ba4\u0bbf\u1f9e\u0baa\u0bcd\u0ba4\u0bbf\u0b95\u0bb0\u0bae\u0bbe\u0ba9 \u0bc7\u0b9a\u0bc8\u0bb5\u0b95\u0bcd \u0b95\u0bbe\u0bb2\u0ba4\u0bcd\u0bc8\u0ba4 \u1f98\u0bb0\u0ba3\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0bbf \u0b87\u1f9e\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd.\n\nIV \u0bb5\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bc7\u0b95\u0bbe\u0bb0\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0ba9\u0bcd \u1f99\u0ba9\u0bcd\u0ba9\u0bb0\u0bbe\u0ba9 05 \u0bb5\u1f9e\u0b9f \u0b95\u0bbe\u0bb2\u0baa\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b92\u1fa8\u0b95\u0bcd\u0b95\u0bbe\u0bb1\u0bcd\u1fa0\u0ba4\u0bcd \u0ba4\u0ba3\u0bcd\u0b9f\u0bc8\u0ba9\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bbe\u0bae\u1fa2\u1f9e\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\n\n7.5.3 \u0bb5\u0baf\u1f90 :- \u0b8f\u0bb1\u0bcd\u1f97\u0bc8\u0b9f\u0baf\u0ba4\u0ba9\u0bcd\u1fa0\n\n7.5.4 \u0b86\u0b9f\u0bcd\u0bc7\u0b9a\u0bb0\u0bcd\u0baa\u0bcd\u1f97 \u1f99\u0bc8\u0bb1 :- \u0ba4\u0bc8\u0b95\u0bc8\u0bae \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0bc7\u0ba8\u0bb0\u0bcd\u1f99\u0b95\u0baa\u0bcd \u0baa\u0bbe\u0bc0\u0b9f\u0bcd\u0bc8\u0b9a\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u1fa0\u0bc7\u0baa\u1fa0\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bae\u0baf \u0b86\u0b9f\u0bcd\u0bc7\u0b9a\u0bb0\u0bcd\u0baa\u0bcd\u1f97\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd.\n\n7.5.4.1 \u0b8e\u1fa8\u0ba4\u0bcd\u1f90\u1f9a\u0bb2\u0baa\u0bcd \u0baa\u0bbe\u0bc0\u0b9f\u0bcd\u0bc8\u0b9a :- \u0b8f\u0bb1\u0bcd\u1f97\u0bc8\u0b9f\u0baf\u0ba4\u0ba9\u0bcd\u1fa0\n\n7.5.4.2 \u0bc6\u0ba4\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd \u0bc7\u0ba4\u0bb0\u0bcd\u1fab :- \u0b8f\u0bb1\u0bcd\u1f97\u0bc8\u0b9f\u0baf\u0ba4\u0ba9\u0bcd\u1fa0\n\n7.5.4.3 \u0b9a\u0bbe\u0ba4\u0bbe\u0bb0\u0ba3 \u0bc7\u0ba8\u0bb0\u0bcd\u1f99\u0b95\u0baa\u0bcd \u0baa\u0bbe\u0bc0\u0b9f\u0bcd\u0bc8\u0b9a :- \u0b8f\u0bb1\u0bcd\u1f97\u0bc8\u0b9f\u0baf\u0ba4\u0ba9\u0bcd\u1fa0\n\n7.5.4.4 \u0ba4\u0bc8\u0b95\u0bc8\u0bae \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0bc7\u0ba8\u0bb0\u0bcd\u1f99\u0b95\u0baa\u0bcd \u0baa\u0bbe\u0bc0\u0b9f\u0bcd\u0bc8\u0b9a:-\n\n\u0bc6\u0bb5\u0bb1\u0bcd\u0bb1\u0bbf\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0b95\u0bcd\u0bc8\u0b95\u0bc8\u0baf\u0baa\u0bcd \u0bc7\u0baa\u0bbe\u0ba9\u0bcd\u1fa0 \u0b87\u0bb0\u0ba3\u0bcd\u1f8c \u0bae\u0b9f\u0b99\u0bcd\u0b95\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b95\u0bc1\u0bc8\u0bb1\u0baf\u0bbe\u0ba4, \u0bb5\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bc8\u0bb3 \u0b9a\u0bae\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b89\u0ba4\u0bcd\u0ba4\u0bbf\u0bc7\u0baf\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u1f90 \u0bc7\u0b9a\u0bc8\u0bb5\u1f9a\u0baa\u0bcd\u1f97\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bae\u0baf \u0ba4\u0bc8\u0b95\u0bc8\u0bae \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0bc7\u0ba8\u0bb0\u0bcd\u1f99\u0b95\u0baa\u0bcd \u0baa\u0bbe\u0bc0\u0b9f\u0bcd\u0bc8\u0b9a\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bb4\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bb5\u0bb0\u0bcd. \u0b85\u1f8a\u0baa\u0bcd\u0baa\u0bc8\u0b9f\u0ba4\u0bcd \u0ba4\u0bc8\u0b95\u0bc8\u0bae\u0b95\u1fa6\u0bae\u0bcd \u0ba4\u0bc8\u0b95\u0bc8\u0bae \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0bc7\u0ba8\u0bb0\u0bcd\u1f99\u0b95\u0baa\u0bcd \u0baa\u0bbe\u0bc0\u0b9f\u0bcd\u0bc8\u0b9a\u0baf\u0bbf\u0ba9\u0bcd \u0bc7\u0baa\u0bbe\u1f90 \u0baa\u0bbe\u0bbf\u0bc7\u0b9a\u0bbe\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd.\n\n\u1f97\u0bb3\u0bcd\u0bb3\u0bbf\u0b95\u0bb3\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0ba4\u0bbe\u0ba9 \u1f90\u0bc8\u0bb1\u0b95\u0bb3\u0bcd\n\n\u0b85\u0ba4\u0bbf\u0b95\u0baa\u0b9f\u0bcd\u0b9a\u0baa\u0bcd \u1f97\u0bb3\u0bcd\u0bb3\u0bbf\u0b95\u0bb3\u0bcd"
