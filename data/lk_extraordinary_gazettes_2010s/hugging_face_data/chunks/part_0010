f\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0b87\u0bb2. 159 \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 172 0.0441 \u0bb9\u1f97\u0ba4\u1fb8\u0ba4\u0bbf\u0bbe\u0bbf\u0bc7\u0b95 \u0bc6\u0bae\u0bb2\u1fb8\u0ba4\u0bbf \u0b95\u0baf\u0ba9\u0bbf\u0b95\u0bbe 197374101737 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bb9\u1f97\u0ba4\u1fb8\u0ba4\u0bbf\u0bbe\u0bbf\u0bc7\u0b95 \u2013 \u1f81\u0ba3\u0bc7\u0b9a\u0b95\u0bb0 \u1fa3\u0bb2\u0bbe\u0bb0\u1fb7\u0ba9 \u0b87\u0bb2. 217\u0b9c\u0bc0/1, \u0b86\u0bc7\u0bb2\u0bbe\u0b95 \u0baa\u0bbe\u1fbd\u1fb0, \u1f81\u0ba3\u0bc7\u0b9a\u0b95\u0bb0 \u0bc6\u0b95\u1fc4\u0bc7\u0baa\u0bc8\u0bb5 \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0b87\u0bb2. 138 \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 182 0.0677 \u0b87\u0bc7\u0bb2\u0bc6\u0baa\u1f9e\u0bae \u0b85\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0b9c\u0bbe\u0ba9\u0b95 731771715v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bc6\u0baa\u1fbf\u0bc6\u0baa\u0bbe\u0bb2\u0bc7\u0b95 \u0bc7\u0ba4\u0bbe\u0ba9 \u2013 \u0b87\u0bc7\u0bb2\u0bc6\u0baa\u1f9e\u0bae (\u0bae\u1fbe\u0bb1 \u0bc6\u0baa\u0baf\u1fbd\u0b95\u1fc0 \u0b9c\u0bbe\u0ba9\u0b95 \u0bb5\u0bbf\u0b9a\u0bbe\u0b95\u0bbe \u1fc4\u0bb5\u1fbd\u0ba9\u0baa\u0bbe\u1fa2 \u0b87\u0bc7\u0bb2\u0bc6\u0baa\u1f9e\u0bae ) \u1f81\u0ba3\u0bb5\u1fbd\u0ba4\u0ba9 \u0b87\u0bb2. 215/3, \u1fa2\u0baa\u1fbd\u1f8a \u0baa\u0bbe\u1fbd\u1fb0, \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0baa\u1fb6\u0b9f\u0bbe\u0bb0\u0b95\u0bae \u1faa\u0ba4\u0bbf, \u0bc6\u0b95\u1fc4\u0bc7\u0baa\u0bc8\u0bb5 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 189 \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 191 0.1366 \u0bc6\u0baa\u1fbf\u0bc6\u0baa\u0bbe\u0bb2\u0bc7\u0b95 \u0bc7\u0ba4\u0bbe\u0ba9 \u0baa\u0bbf\u0bb0\u0baa\u0bbe \u1f86\u0bb0\u1fb1\u0b95\u0ba9\u0bc0 657650587v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 190 \u0b87\u1fb9 \u2013 \u1f81\u0ba3\u0bb5\u1fbd\u0ba4\u0ba9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 217/3, \u0baa\u1fb6\u0b9f\u0bbe\u0bb0\u0b95\u0bae \u1faa\u0ba4\u0bbf, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bc6\u0b95\u1fc4\u0bc7\u0baa\u0bc8\u0bb5 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bc6\u0baa\u1fbf\u0bc6\u0baa\u0bbe\u0bb2\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u1fb9 \u0b86\u0b9f\u1fa2\u1fb9 \u1f81\u0ba3\u0bb5\u1fbd\u0ba4\u0ba9 \u0bae\u1fbe\u1fa0\u1fbb \u0b9c\u0baf\u0baa\u1fb7 \u0b85\u1fba\u1f97\u0bb9\u0bbe\u0bae\u0bbf\u0bb2\u0bbe\u0bc7\u0b95 \u0bc7\u0b9a\u0bbe\u0bae\u0bbe\u0bb5\u0ba4\u0bc0 \u0b8e\u1fa2\u0b9a\u0bc6\u0baa\u1fb7 \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90\n\n10 - 341/20\n\n20 A\n\nIII \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2013 \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000e\u000f\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0012 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0015 \u0d85\u0017 \u0018\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0dba \u2013 2019.09.25\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0