\u1fb5\u0b9f\u1f90, 181 0.0590 \u0bc7\u0bb9\u0bb0\u1fb7 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0ba8\u0bbf\u1fbf\u0bae\u0bbf\u0ba3\u0bbf 917413789v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 182 \u0b87\u1fb9 \u2013 \u0ba4\u0bbf\u0b9a\u0bbe\u0ba9\u0bbe\u0baf\u0b95 \u0bc7\u0bb9\u0bb0\u1fb7 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b92\u0bb2\u0b95\u0bae, \u0bb0\u1fbb\u0baa\u0b9f\u0b95\u1fbf\u0bb2, \u0bbe\u0bbf\u0ba4\u0bc0\u0b95\u0bae \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 184 0.0690 \u0bc7\u0bb9\u0bb0\u1fb7 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0ba4\u0ba9\u0bb5\u0ba4\u0bc0 607313083v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 182 \u0b87\u1fb9 \u2013 \u1f81\u0bae\u0bbe\u0bbe\u0bbf\u0bb9\u0bbe\u0bae\u0bbf \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b92\u0bb2\u0b95\u0bae, \u0bb0\u1fbb\u0baa\u0b9f\u0b95\u1fbf\u0bb2, \u0bbe\u0bbf\u0ba4\u0bc0\u0b95\u0bae \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 190 0.0465 \u0bc7\u0bb9\u0bb0\u1fb7 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0ba4\u0ba9\u0bb5\u0ba4\u0bc0 607313083v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 182 \u0b87\u1fb9 \u2013 \u1f81\u0bae\u0bbe\u0bbe\u0bbf\u0bb9\u0bbe\u0bae\u0bbf \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b92\u0bb2\u0b95\u0bae, \u0bb0\u1fbb\u0baa\u0b9f\u0b95\u1fbf\u0bb2, \u0bbe\u0bbf\u0ba4\u0bc0\u0b95\u0bae \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90,\n\n9 A\n\nIII \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2013 \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000e\u000f\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0012 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0015 \u0d85\u0017 \u0018\u0dd9\u0dc1\u0dc2 \u0d9c\u0