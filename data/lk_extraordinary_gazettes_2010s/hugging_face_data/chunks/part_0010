90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 01 \u0b87\u1fb9 \u2013 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 30/39, \u0ba4 \u0b9a\u0bbf\u1fbf\u0bb5\u0bbe \u1fb0\u0bc6\u0bb1\u0bbe\u1fc4 \u1faa\u0ba4\u0bbf, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b95\u1fa6\u0bc7\u0baa\u0bbe\u0bb5\u0bbf\u0bb2, \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb3. \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 28 0.0015 \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb3 \u0b95\u1fbf\u0b95\u0bbf\u1fc4\u0bc8\u0b9a \u0bae\u0bbe\u0b95\u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b9a\u0bc0\u0bc6\u0bae\u1fb8\u1f90 \u0b95\u0bbe\u1fbf\u0bb5\u0bbe\u1fbc 36 0.0031 \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb3 \u0b95\u1fbf\u0b95\u0bbf\u1fc4\u0bc8\u0b9a \u0bae\u0bbe\u0b95\u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b9a\u0bc0\u0bc6\u0bae\u1fb8\u1f90 \u0b95\u0bbe\u1fbf\u0bb5\u0bbe\u1fbc 41 0.0008 \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb3 \u0b95\u1fbf\u0b95\u0bbf\u1fc4\u0bc8\u0b9a \u0bae\u0bbe\u0b95\u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b9a\u0bc0\u0bc6\u0bae\u1fb8\u1f90 \u0b95\u0bbe\u1fbf\u0bb5\u0bbe\u1fbc 54 0.0010 \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb3 \u0b95\u1fbf\u0b95\u0bbf\u1fc4\u0bc8\u0b9a \u0bae\u0bbe\u0b95\u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b9a\u0bc0\u0bc6\u0bae\u1fb8\u1f90 \u0b95\u0bbe\u1fbf\u0bb5\u0bbe\u1fbc 55 0.0064 \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb3 \u0b95\u1fbf\u0b95\u0bbf\u1fc4\u0bc8\u0b9a \u0bae\u0bbe\u0b95\u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b9a\u0bc0\u0bc6\u0bae\u1fb8\u1f90 \u0b95\u0bbe\u1fbf\u0bb5\u0bbe\u1fbc 63 0.0122 \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1fbd \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 64, 65, 66 \u0bae\u1fbe\u1fa0\u1fbb 67 \u1fbe\u1f81 \u0baa\u0bbf\u0bb0\u0bc7\u0bb5\u0b9a\u0bbf\u1fba\u0baa- \u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 69 0.0019 \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb3 \u0b95\u1fbf\u0b95\u0bbf\u1fc4\u0bc8\u0b9a \u0bae\u0bbe\u0b95\u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b9a\u0bc0\u0bc6\u0bae\u1fb8\u1f90 \u0b95\u0bbe\u1fbf\u0bb5\u0bbe\u1fbc 71 0.0018 \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb3 \u0b95\u1fbf\u0b95\u0bbf\u1fc4\u0bc8\u0b9a \u0bae\u0bbe\u0b95\u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b9a\u0bc0\u0bc6\u0bae\u1fb8\u1f90 \u0b95\u0bbe\u1fbf\u0bb5\u0bbe\u1fbc 84 0.0114 \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb3 \u0b95\u1fbf\u0b95\u0bbf\u1fc4\u0bc8\u0b9a \u0bae\u0bbe\u0b95\u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b9a\u0bc0\u0bc6\u0bae\u1fb8\u1f90 \u0b95\u0bbe\u1fbf\u0bb5\u0bbe\u1fbc 90 0.0044 \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb3 \u0b95\u1fbf\u0b95\u0bbf\u1fc4\u0bc8\u0b9a \u0bae\u0bbe\u0b95\u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b9a\u0bc0\u0bc6\u0bae\u1fb8\u1f90 \u0b95\u0bbe\u1fbf\u0bb5\u0bbe\u1fbc 98 0.0211 \u0bc6\u0bb8\u0bb0\u1fb9\u0baf\u0bbe \u0ba4\u0bbf\u0bbe\u0bbf\u1fc4 \u0ba4 \u0b9a\u0bbf\u1fbf\u0bb5\u0bbe 936433707v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0ba8\u0bc0\u0b9f\u0bbe \u0ba4 \u0b9a\u0bbf\u1fbf\u0bb5\u0bbe \u2013 \u0b87\u0bb2. 30/35 \u0b8f, \u0ba4 \u0b9a\u0bbf\u1fbf\u0bb5\u0bbe \u1fb0\u0bc6\u0bb1\u0bbe\u1fc4 \u1faa\u0ba4\u0bbf (\u0ba4\u0bbf\u1f9e\u0bae\u0ba3\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b95\u1fa6\u0bc7\u0baa\u0bbe\u0bb5\u0bbf\u0bb2, \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb3 \u1f99\u1fb9 \u0bc6\u0baa\u0baf\u1fbd \u0ba4\u1fb5\u0bb9\u0bbe\u0ba9\u0bbf) \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 27 \u0b87\u1fb9 \u0baa\u0bbe\u0bc8\u0ba4 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90,\n\n8 A\n\nIII \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2013 \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000e\u000f\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0012 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0015 \u0d85\u0017 \u0018\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0dba \u2013 2019.09.30"
