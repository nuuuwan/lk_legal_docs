b5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 182 \u2013 \u0b87\u0bb2. 92/17, \u1faa\u0bb0 \u0b89\u0ba4\u0bbf\u0ba4 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bae\u1fbe\u1fa0\u1fbb 188 \u0b87\u1fb9 \u0bc6\u0bb9\u1f8a\u0b95\u0bae, \u0baa\u0bbf\u1fa2\u0baf\u1fb8\u0ba4\u0bc8\u0bb2 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0bc6\u0b95\u0bbe\u0bae\u1fbd\u0bb7\u1fbf \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 190 0.0168 \u0baa\u1fb5\u1f8a\u0baf\u0bc7\u0b95 \u0ba4\u0bc0\u1fba\u0ba4\u0bbf \u0b87\u0bc7\u0bb0\u0bbe\u0bae\u0bbf 196950800549 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 182 \u2013 \u0bb5\u0bbf\u0bc7\u0b9c\u0bb0\u1fb7\u0ba9 \u0bae\u1fbe\u1fa0\u1fbb 188 \u0b87\u1fb9 \u0b87\u0bb2. 92/20, \u1faa\u0bb0 \u0b89\u0ba4\u0bbf\u0ba4 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc6\u0bb9\u1f8a\u0b95\u0bae, \u0baa\u0bbf\u1fa2\u0baf\u1fb8\u0ba4\u0bc8\u0bb2 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 209 0.0181 \u0b85\u0bb5\u1fa2\u0b95\u0bbe\u0bb0 \u0baa\u0bb2\u0baa\u1fb7\u0ba4\u0bbf\u0bc7\u0b95 \u0b9a\u0bae\u0bbf\u1fb8\u0ba4 760450596v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 182 \u0b87\u1fb9 \u2013 \u0bc7\u0bb9\u0bae\u0bbe\u1fbf \u0bb5\u0bbf\u0bae\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 92/3, \u1faa\u0bb0 \u0b89\u0ba4\u0bbf\u0ba4 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bc6\u0bb9\u1f8a\u0b95\u0bae, \u0baa\u0bbf\u1fa2\u0baf\u1fb8\u0ba4\u0bc8\u0bb2 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0bc7\u0b9a\u0bae\u0bbf\u1fba\u1f97 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 210 0.0157 \u0bb8\u0bbe\u0ba9\u0bbe\u1fb2 \u0baa\u1fbd\u0ba9\u0bc6\u0b9f\u1fb7 \u1f81\u0ba3\u0bb5\u1fbd\u0ba4\u0ba9 776181250v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 182 \u0b87\u1fb9 \u2013 \u0b87\u0bb2. 92/13, \u1faa\u0bb0 \u0b89\u0ba4\u0bbf\u0ba4 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc6\u0bb9\u1f8a\u0b95\u0bae, \u0baa\u0bbf\u1fa2\u0baf\u1fb8\u0ba4\u0bc8\u0bb2 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0bc7\u0b9a\u0bae\u0bbf\u1fba\u1f97 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 213 0.0234 \u0b9a\u0bae\u0bb0\u1f90\u1fb1\u0b95 \u1fa2\u0baf\u0ba9\u0bc7\u0b95 \u0ba4\u0bbf\u1fa2\u0ba9\u0bbf \u0b9a\u0bbe\u0bae\u0bbf\u0b95\u0bbe 815043243v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 182 \u0b87\u1fb9 \u2013 \u0b87\u0bb2. 92/16, \u1faa\u0bb0 \u0b89\u0ba4\u0bbf\u0ba4 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc6\u0bb9\u1f8a\u0b95\u0bae, \u0baa\u0bbf\u1fa2\u0baf\u1fb8\u0ba4\u0bc8\u0bb2 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0bc6\u0b95\u0bbe\u0bae\u1fbd\u0bb7\u1fbf \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 218 0.0168 \u0bae\u1fb7\u1f90\u0bae\u0bc7\u0b95 \u0b85\u0b9c\u0bbf\u1fb7 \u0b95\u0baf\u0bbe\u1fb9 \u0ba8\u0bbf\u0bb8\u0bbe\u1fb8\u0ba4 733633824v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 182 \u0b87\u1fb9 \u2013 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 92/5, \u1faa\u0bb0 \u0b89\u0ba4\u0bbf\u0ba4 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bc6\u0bb9\u1f8a\u0b95\u0bae, \u0baa\u0bbf\u1fa2\u0baf\u1fb8\u0ba4\u0bc8\u0bb2 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0bb9\u1fb5\u0b9f\u1fb9 \u0bc7\u0ba8\u0bb7\u0ba9\u1fbf \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90\n\n40 A"
