fb7 \u0bb5\u0bbf\u1fc4 \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0\u0b95\u0bbe\u0bb0\u1fbd/ \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0 \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb0\u1f81\u0bbe\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u0ba9\u1f90 \u0b89\u1fb5\u0baa\u1fb5\u0b9f \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1f9e\u1fb0 \u1f90\u1fb6\u1f8a\u1fb9 \u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0b95\u0bbe\u0bb0\u1fbd\u0b95\u0bb3\u0bbf\u1fb9 \u1f99\u1fa8\u1fba \u0b85\u0bc8\u0b9f\u0baf\u0bbe\u0bb3 \u0b87\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 \u0bb5\u1f81\u1fba\u1f97\u1fbb \u0b88\u1f8c, \u1f81\u1fb7 \u1f81\u0bbe\u0bbf\u0baf \u0b9a\u1fb5\u0b9f\u1fb1 \u0b87\u0bb2. \u0bc6\u0baa\u0baf\u1fbd\u0b95\u1fa6\u1fbb \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u1f9c\u1fbb \u0b85\u1fb5\u0bc8\u0b9f \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0b87\u0baf\u1fbf\u1f97\u1fbb \u0ba4\u0bc8\u0b95 \u0b95\u1fa6\u1fc0 \u0b8e\u1fc2 (\u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u0bbe\u1fbd) \u0b87\u0bb2. \u0ba4\u1f8c\u1fba\u1f97\u1fb0 \u0bb5\u0bc8\u0b95\u1fb0\u1f81\u1fbb \u0b95\u1fb5\u0b9f\u0bc8\u0bb3 \u0b85\u0bc8\u0bae\u1fb8\u0ba4\u0bbf\u1f9e\u1fba \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0baa\u0bbf\u1fb9 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0 \u0b95\u1fc0\n\n9 A III \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u2013 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u2013 2019.12.13\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.12.13\n\n93 0.0516 \u0b85\u0bb4\u0b95\u0bc7\u0b95\u0bbe\u1fb9 \u0b85\u1fba\u1f97\u0bb9\u0bbe\u0bae\u0bbf\u1fbf\u0bb2\u0bbe\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u1fb9 603291026v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0bb2\u1fa2\u1fb7 \u0b89\u0ba4\u0baf \u0baa\u1fb6\u0b9f\u0bbe\u0bb0 \u0b85\u0bb4\u0b95\u0bc7\u0b95\u0bbe\u1fb9 \u0b87\u0bb2. 75, \u0baa\u0bbf\u1fa2\u0bae\u0ba4\u0bb2\u0bbe\u0bb5 \u0b89\u1fb7\u0baf\u0bbe\u0ba9\u0baf, \u0baa\u0bbf\u1fa2\u0bae\u0ba4\u0bb2\u0bbe\u0bb5 150 0.0226 \u0b95\u1fb8\u0bc7\u0ba4 \u0bc6\u0b95\u0ba4\u0bb0 \u0ba4\u0bbf\u0bc7\u0ba9\u1fc3 \u0b9c\u0bbe\u0ba9\u0b95 851161430v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 149 \u2013 \u0b95\u1fb8\u0bc7\u0ba4\u0bc6\u0b95\u0ba4\u0bb0 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 47/3, \u0bb9\u1f97\u0bb5\u0bb2, \u0bb9\u1fb1\u1f81\u0bb0\u1fb1\u0bc6\u0b95\u0ba4 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 151 0.0228 \u0bae\u0bbe\u0bb2\u0bc7\u0b95 \u1f81\u1fbb\u1f97\u0bc7\u0bb0 \u0bc6\u0b95\u0ba4\u0bb0 \u0b85\u0ba9\u0bbf\u1fbf \u1f81\u0bae\u0bbe\u0bb0 820060997v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 149 \u2013 \u0b87\u0bb2. 02, \u0bae\u0bbe\u0bb2\u0bc7\u0b95 \u1f81\u1fbb\u1f97\u0bb0, \u0bae\u0bc0\u0b95\u1fbb\u0bae\u0ba9, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bb5\u1fb7\u0bc7\u0ba4\u0b95\u0bae \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bae\u1fbe\u1fa0\u1fbb \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 152 \u0bb5\u1f8a\u0b95\u0bbe\u1fbf \u0ba8\u0bc0\u1fbd \u0bb5\u0bb4\u0bbf\u1fb8\u0bc7\u0ba4\u0bbe\u1f8c\u0bb5\u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 152 0.0005 \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1fbd \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 150 \u2013 \u0bae\u1fbe\u1fa0\u1fbb 151 \u0ba8\u0bc0\u1fbd \u0bb5\u0bb