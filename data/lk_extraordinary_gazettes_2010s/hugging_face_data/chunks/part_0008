9f\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c \u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fba\u0baa\u1f8c\u0ba4\u1fbf \u0bc7\u0bb5\u1fb6\u1f8c\u1fbb.\n\n\u0baa\u0bbf.\u0b8e\u1fbb.\u0b8e\u1fb2. \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u1fbd\u0bb7\u0ba9\u0bbf, \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd.\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fbb, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4 \u0bc6\u0bae\u1f90\u0bb0\u201d, \u0b87\u0bb0\u0b9c\u0bae\u1fbf\u0bb5\u1fb7\u0ba4 \u1faa\u0ba4\u0bbf, \u0baa\u1fb7\u0ba4\u0bb0\u1f99\u1fbf\u0bc8\u0bb2, 2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0b92\u1fbe\u0bc7\u0bb1\u0bbe\u0baa\u1fbd \u0bae\u0bbe\u0ba4\u1fbb 18 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf.\n\n11 - 951 / 6\n\n\u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fbb\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf \u0bc7\u0bae\u0bc7\u0bb2\u1f9c\u1fc0\u0bb3 \u0ba4\u0bc8\u0bb2\u1fba\u0baa\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 2009.11.19 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf 1628/39 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u0b9a\u0bbf\u1fb9 \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u1fbf \u0baa\u0bbf\u0bb0\u1f86\u0bb0\u0bae\u0bbe\u0ba9 \u0bae\u1fb7\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u1fb7\u0ba4\u0bbf\u1fbf, \u0b95\u1fb6\u1f8a \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0b89\u1f8c\u1f92\u0bb5\u0bb0 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf 43 - \u0baa\u0bbf\u0b9f\u0bb5\u0bb2\u0bb5\u1fb7\u0ba4 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u0bc6\u0ba4\u0bb9\u0bbf\u0baa\u0bbe\u0bc6\u0b95\u0bbe\u0bc8\u0b9f \u0b8e\u1f94\u1fbb \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf, 511839 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 04 \u0b87\u1fbf 86 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8a\u1fb9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b85\u1fc2\u0bb5\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf,\n\n\u201c\u0b85\u0bc8\u0ba9\u1fb7\u1f90 \u0bb5\u0bbf\u0b9f\u0baf\u1fb1\u0b95\u1fa6\u1fbb\u201d \u0ba8\u0bc0\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c \u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fba\u0baa\u1f8c\u0ba4\u1fbf \u0bc7\u0bb5\u1fb6\u1f8c\u1fbb.\n\n\u0baa\u0bbf.\u0b8e\u1fbb.\u0b8e\u1fb2. \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u1fbd\u0bb7\u0ba9\u0bbf, \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd.\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fbb, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4 \u0bc6\u0bae\u1f90\u0bb0\u201d, \u0b87\u0bb0\u0b9c\u0bae\u1fbf\u0bb5\u1fb7\u0ba4 \u1faa\u0ba4\u0bbf, \u0baa\u1fb7\u0ba4\u0bb0\u1f99\u1fbf\u0bc8\u0bb2, 2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0b92\u1fbe\u0bc7\u0bb1\u0bbe\u0baa\u1fbd \u0bae\u0bbe\u0ba4\u1fbb 18 \u0b86\u1fbb \u0ba4\u0bbf\