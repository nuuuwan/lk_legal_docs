90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 40 \u0b87\u1fb9 \u2013 \u0ba8\u0bbe\u0bae\u1fbf \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 21/37\u0b8f, \u0b85\u1f9e\u1fba\u0baa\u0bb2, \u0b95\u1fb6\u1f8a \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 56 0.0570 \u0bae\u0bbe\u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa - \u0b95\u1fb6\u1f8a \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0baa\u0bbe\u0bc8\u0ba4 64 0.0268 \u0bc6\u0bae\u0bbe\u0bb9\u0bae\u1fb5 \u0bb9\u0ba9\u0bc0\u0baa\u0bbe \u0bc6\u0bb2\u0bc7\u0baa \u0b9a\u0bbf\u1fb7\u0ba4\u0bbf \u0b9a\u0bb9\u0bbf\u0bb0\u0bbe 576460830v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 63 \u0b87\u1fb9 \u2013 \u0b87\u0bb2. 21/6 2\u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0b85\u1f9e\u1fba\u0baa\u0bb2, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b95\u1fb6\u1f8a \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 65 0.0308 \u0bc6\u0bae\u0bbe\u0bb9\u0bae\u1fb5 \u0b87\u1fc4\u0bae\u0bbe\u0baf\u0bbf\u1fbf 601270994v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 63 \u0b87\u1fb9 \u2013 \u0b87\u0bb2. 21/6\u0b8f, 2\u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b85\u1f9e\u1fba\u0baa\u0bb2 \u1faa\u0ba4\u0bbf, \u0b95\u1fb6\u1f8a \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 79 0.0074 \u0b85\u0bb0\u1f86 \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 80 0.0308 \u0b95\u0ba9\u0b95\u0bc6\u0b9a\u0b95\u0bb0 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bb2\u0bbe\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u1fb9 710203555v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 78 \u0b87\u1fb9 \u2013 \u0b85\u0bc7\u0bb8\u0bbe\u0b95 \u0b