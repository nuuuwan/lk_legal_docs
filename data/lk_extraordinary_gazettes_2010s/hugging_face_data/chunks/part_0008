    "chunk_text": "\u0d85\u0dba\u0db7\u0dcf\u0dbb\u0dba \u0db8\u0dd0\u01e8\u0db8 206. \u021d\u01af\u0dc2\u0dca\u0da8\u0dcf\u0dd9\u0269 \u0dbd\u0dd0\u022c\u0dab \u0dd9\u0dc4\u02a4 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0dc0\u0179\u0db1\u0dcf\u0d9a\u0db8\u0da7 \u0d85\u0dba\u0db7\u0dcf\u0dbb\u0dba \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u00fa \u026a\u0286\u01e6 \u0db8\u0dd0\u01e7\u0dba \u0252\u01b1\u0dba. \u0dbd\u0dd0\u022c\u0dab \u0dd9\u0dc4\u02a4 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u021d\u01af\u0dc2\u0dca\u0da8\u0dcf\u0dc0 \u0dc0\u01e9\u0dd9\u024f \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u01e9\u0db8\u0dad \u0dba\u023c \u0dd9\u0dc0\u0dd9\u0dc5\u0db3 \u0dc0\u0178\u0da7\u023c, \u0d85\u021d\u0db8\u0dcf\u0daf\u0dc0 \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dc0\u0178\u0da7\u023c \u0dc3\u0dc4 \u0db4\u025c\u0db8\u0dcf \u021d\u01af\u0daf\u0dcf\u0db1 \u0d85\u018d \u0d9a\u0dc5 \u0db4\u0288 \u0dc0\u0db1 \u0dc0\u0179\u0db1\u0dcf\u0d9a\u0db8 \u0250. 207. \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u00fa \u0d85\u0dba \u0db7\u0dcf\u0dbb\u0dd9\u024f \u0d87\u01b1\u0dc5\u01ae \u0d9a\u0dc5\u0252\u01ae\u0dd9\u01ae \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0d91\u028f \u0dc3\u0dca\u0dc0\u00fc\u0dba \u0119\u019f\u0db8\u0da7 \u0dbd\u0dd0\u022c\u0dab \u0dd9\u0dc4\u02a4 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0d86\u0259\u01c2\u0d9a \u021d\u01af\u0dbd\u0dcf\u0db7\u0dc0\u0dbd \u0daf\u0dc5 \u0d9c\u0dbd\u0dcf\u0d92\u023c \u0db4\u0db8\u019d. \u01b1\u01e6\u0dc0\u0db1 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0 \u0dd9\u0dc0\u01e9\u0dd9\u0dc0\u01e6 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u025a\u0dc3\u0dca\u0d9a\u0dbb\u0d9c\u01ae \u0286\u0dba\u0265 \u0dc0\u0179\u0db1\u0dcf\u0d9a\u023c \u0d85\u0dba\u0db7\u0dcf\u0dbb\u0dd9\u0dba\u01e6 \u0db6\u0dd0\u0dc4\u0dd0\u0dbb \u0d9a\u0dc5 \u0252\u01b1\u0dba. \u0dbb\u0da2\u0dba \u0dd9\u0dc4\u02a4 \u0db6\u0dc3\u0dca\u0db1\u0dcf\u028f\u0dbb \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dc0 \u0dd9\u0dc0\u01e9\u0dd9\u0dc0\u01e6 \u025a\u0dc3\u0dca\u0d9a\u0dbb\u0d9c\u01ae \u026a\u00fd\u019f\u023c \u0dd9\u0dc4\u02a4 \u0d91\u0d9a\u01b1 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db4\u0daf\u0db1\u023c \u0dc0\u0db1 \u0286\u0dba\u0265 \u0db6\u01d0 \u0d85\u0dba\u0db7\u0dcf\u0dbb\u0dd9\u024f \u0d87\u01b1\u0dc5\u01ae \u0d9a\u0dc5\u0252\u01ae\u0dd9\u01ae \u0d91\u028f \u0dd9\u0d9a\u02a3\u023d\u0dc3\u0dca \u023f\u0daf\u0dbd \u0db4\u0db8\u0dab\u00fb. \u021d\u0db0\u0dcf\u01e7\u0dba\u0dcf \u0dd9\u0dc0\u01e9\u0dd9\u0dc0\u01e6 \u025a\u0dc3\u0dca\u0d9a\u0dbb\u0d9c\u01ae \u0dc0\u0179\u0db1\u0dcf\u0d9a\u023c \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0d85\u0dba\u0db7\u0dcf\u0dbb\u0dba \u0dd9\u0db1\u02a3\u0dd9\u0269. \u0db7\u0dcf\u019c\u0da9 \u026a\u00fb\u019e\u0db8 208. \u0db7\u0dcf\u019c\u0da9 \u026a\u00fb\u019e\u0dd9\u0db8\u01e6 \u0dc0\u0db1 \u0d85\u0dba\u0db7\u0dcf\u0dbb\u0dba \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u00fa \u0dc4\u01ff\u0db1\u0dcf\u0d9c\u0dad \u0252\u01ae\u0dd9\u01ae \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0286\u0dba\u0265 \u0dd9\u0d9a\u02a3\u01e6\u0dd9\u01ca\u0286 \u0dc3\u021a\u0dbb\u0dcf\u0dbd\u0db1 \u026a\u0da7 \u01cf \u0dba. (\u0d85) \u0db7\u0dcf\u019c\u0da9\u0dc0\u0dbd \u0d85\u0250\u01af\u0dd9\u024f \u0dc3\u0dd0\u0dbd\u00fb\u0dba \u0252\u01b1 \u0d85\u01e6\u0daf\u0dd9\u023c \u0d85\u0dc0\u0daf\u0dcf\u0db1\u023c \u0dc3\u0dc4 \u021d\u01af\u0dbd\u0dcf\u0db7 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0d9c\u0dd0\u01e9\u023c\u0d9a\u025e\u0da7 \u0db4\u0dc0\u0dbb\u0dcf\n\n\u0d87\u01af\u026a\u0da7, (\u0d86) \u026a\u00fb\u01a0 \u0db6\u018d \u0db8\u0dad \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0255\u0dd9\u0dba\u01e6 \u0d85\u0250\u01af\u0dba \u0d86\u027b\u0dad \u0d85\u0d9b\u019c\u0da9 \u0d9a\u0dbd\u0db8\u0db1\u0dcf\u0d9a\u0dcf\u025d\u01ae\u0dc0\u0dba \u0dc3\u023c\u0db6\u01e6\u0db0\u0dc0\n\n(\u0d91\u0db1\u023c \u0286\u01d0\u026a\u0dba \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u00fb \u0dc0\u0db1\u0dc0\u0dcf\u0da7 \u0dc0\u0da9\u0dcf \u0286\u01d0\u026a\u0dba \u0dc4\u0dd0\u00fb); \u0dc3\u0dc4 (\u0d89) \u0d9c\u01e9\u0dd9\u0daf\u01e9\u0dc0 \u0dc3\u023c\u0db6\u01e6\u0db0 \u0daf\u0dbb\u0db1 \u0dbd\u0daf \u0dd9\u0dc4\u02a4 \u0daf\u0dd0\u025c\u0dba \u0252\u01b1 \u0218\u025c\u0dc0\u0dd0\u0dba \u026a\u0dc1\u0dca\u0dc0\u0dcf\u0dc3\u0daf\u0dcf\u0dba\u0d9a \u0dd9\u0dbd\u0dc3 \u0db8\u0dd0\u01e7\u0dba \u0dc4\u0dd0\u00fb \u0db6\u0dc0 209. \u0d9c\u0dd0\u01e9\u023c\u0d9a\u025e\u0da7 \u028f\u023d\u0d9a\u0dd9\u023c \u0dc3\u0dd0\u0dbd\u00fb\u0dba \u0252\u01b1 \u0d85\u01e6\u0daf\u0dd9\u023c \u0d85\u0dc0\u0daf\u0dcf\u0db1\u023c \u0dc3\u0dc4 \u021d\u01af\u0dbd\u0dcf\u0db7 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dd9\u0dc0\u01e6 \u0db4\u0dd0\u0dc0\u0dd0\u025e\u0dd9\u024f \u00fd\u0db8\u0db1 \u026a\u0da7\u0d9a \u01cf \u0daf \u0dba\u01e6\u0db1 \u0dad\u00fa\u0dd9\u0dc3\u02a2\u025e \u00fb\u025d\u0dd9\u023c \u01cf \u0d9c\u01e9\u0dd9\u0daf\u01e9\u0dd9\u0269 \u0dc3\u0dd0\u0dbd\u00fb\u0262\u0dbd\u0da7 \u0d9c\u0dad\u0252\u01b1 \u0d9a\u025e\u019f \u0db4\u025d\u00fa\u0dc2\u0dcf \u0d9a\u0dc5\u0252\u01b1\u0dba. \u0dd9\u0db6\u02a3\u0dd9\u0dc4\u02a4 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbd \u01cf \u0d85\u0250\u01af\u0dd9\u024f \u0d85\u0dc0\u0daf\u0dcf\u0db1\u023c \u0dc3\u0dc4 \u021d\u01af\u0dbd\u0dcf \u0db7 \u0db4\u0dd0\u0dc0\u0dd9\u0dbb\u01e6\u0dd9\u01e6 \u0ddb\u0db1\u01af\u0d9a \u028f\u023d\u0d9a\u0db8 \u0db4\u0dd0\u0dc0\u025d\u0db8 \u0dd9\u0dc4\u02a4 \u0d9c\u0dd0\u01e9\u023c\u0d9a\u025e\u0dc4\u0da7 \u0236\u00fa\u01af\u0dba \u0db4\u01ae\u026b\u0db8 \u0dba\u0db1 \u0d9a\u025e\u019f \u0dd9\u0daf\u0d9a\u0da7 \u0dc3\u0db8\u0dcf\u01e9\u0db4\u0dcf\u0dad\u0dc0 \u0dba. \u0dd9\u0db6\u02a3\u0dd9\u0dc4\u02a4 \u0286\u0262\u0dbd\u0dbb \u026a\u00fd\u019f\u023c\u0dc0\u0dbd \u0dad\u01ae\u01ae\u0dc0\u0dba \u0dd9\u0db8\u0dba \u0dd9\u0269. \u0d85\u0250\u01af\u0dd9\u024f \u0dc3\u0dd0\u0dbd\u00fb\u0dba \u0252\u01b1 \u0d85\u01e6\u0daf\u0dd9\u023c \u0d85\u0dc0\u0daf\u0dcf\u0db1\u023c \u0dd9\u0dc4\u02a4 \u021d\u01af\u0dbd\u0dcf\u0db7 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0dbb\u0db3\u0dc0\u0dcf\u0d9c\u01e6\u0dd9\u01e6 \u0d91\u0dba \u0d85\u0dba\u0db7\u0dcf\u0dbb\u0dba \u0dd9\u0dbd\u0dc3 \u0dc4\u01ff\u0db1\u0dcf \u0dd9\u0db1\u02a3\u0d9c\u0dad \u0252\u01b1\u0dba \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u0dc3\u0dd0\u0db4\u0251\u0db8 210. \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u0dc3\u0dd0\u0db4\u0251\u0db8 \u0dc4\u0dcf \u0dc3\u023c\u0db6\u01e6\u0db0 \u0dc0\u0db1 \u0d9c\u01e9\u0dd9\u0daf\u01e9\u0dc0\u0d9a \u021d\u01af\u0db5\u0dbd\u0dba \u026a\u0dc1\u0dca\u0dc0\u0dcf\u0dc3\u0daf\u0dcf\u0dba\u0d9a \u0dd9\u0dbd\u0dc3 \u0d87\u0dc3\u0dca\u0dad\u0dd9\u023c\u01e6\u01b1 \u0d9a\u0dc5\u0dc4\u0dd0\u00fb \u0db1\u023c, \u0d9c\u01e9\u0dd9\u0daf\u01e9\u0dc0 \u0dc4\u0dcf \u0d86\u027b\u0dad \u0d85\u0dba\u0db7\u0dcf\u0dbb\u0dba \u0dc0\u0dcf\u0259\u0dad\u0dcf\u0d9a\u0dbb\u0dab \u0d9a\u0dcf\u0dbd\u0db4\u025c\u013c\u0dd9\u0146\u0daf\u0dba \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dd9\u024f \u01cf \u0d91\u0dba \u01e7\u0db8\u00fb\u025d\u0dd9\u023c \u0d85\u01ce\u0dba\u0dbb\u0da7 \u0dd9\u0dba\u02a3\u023f \u0d9a\u0dbb\u023d\u01e6 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0dc4\u01ff\u0db1\u0dcf\u0d9c\u0dad \u0252\u01b1\u0dba. 211. \u021d\u01af\u0dc1\u0dad\u0dba\u00fa \u01e7\u0db8\u00fb\u025d\u0dd9\u023c \u0100\u0db8\u0dba \u0dd9\u0dbd\u0dc3 \u0dc4\u0dd0\u01fd \u01e6\u0dd9\u0dc0\u0db1 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0286\u0dba\u0265 \u0dd9\u0d9a\u02a3\u01e6\u0dd9\u01ca\u0286 \u0dad\u0dd8\u0217\u0dad \u0d9a\u0dbb\u01e6\u0dd9\u01e6 \u0db1\u023c \u0d9c\u01e9\u0dd9\u0daf\u01e9\u0dc0\u0d9a \u021d\u01af\u0db5\u0dbd\u0dba \u026a\u0dc1\u0dca\u0dc0\u0dcf\u0dc3\u0daf\u0dcf\u0dba\u0d9a \u0dd9\u0dbd\u0dc3 \u0d87\u0dc3\u0dca\u0dad\u0dd9\u023c\u01e6\u01b1 \u0d9a\u0dc5\u0dc4\u0dd0\u00fb\u0dba. (i) \u0d85\u0dba\u0db7\u0dcf\u0dbb\u0dd9\u024f \u0dc0\u0179\u0db1\u0dcf\u0d9a\u0db8 \u026a\u0dc1\u0dca\u0dc0\u0dcf\u0dc3\u0daf\u0dcf\u0dba\u0d9a \u0dd9\u0dbd\u0dc3 \u0db8\u0dd0\u01e7\u0dba \u0dc4\u0dd0\u00fb\u026b\u0db8,\n\n(ii) \u0d9c\u01e9\u0dd9\u0daf\u01e9\u0dc0 \u0dc4\u0dcf \u0d86\u027b\u0dad \u0d86\u0259\u01c2\u0d9a \u021d\u01af\u0dbd\u0dcf\u0db7 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0d9c\u0dbd\u0dcf\u0d92\u0db8 \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf \u0d9a\u0dc5 \u0dc4\u0dd0\u00fb\u026b\u0db8,\n\n(iii) \u0d9c\u01e9\u0dd9\u0daf\u01e9\u0dc0 \u01e7\u0db8\u0d9a\u0dbb \u0d87\u01af \u0d85\u01ce\u0dba\u0dbb \u0119\u019f\u023c\u0d9a\u0dbb\u0dab \u0d9a\u0dcf\u0dbd\u0db4\u025c\u013c\u0dd9\u0146\u0daf\u0dba \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dd9\u024f \u026a\u0dc1\u0dca\u0dc0\u0dcf\u0dc3\u0daf\u0dcf\u0dba\u0d9a \u0dd9\u0dbd\u0dc3 \u0db8\u0dd0\u01e7\u0dba\n\n\u0dc4\u0dd0\u00fb\u026b\u0db8,\n\n(iv) \u0d9c\u01e9\u0dd9\u0daf\u01e9\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0dbb\u0db1 \u0dbd\u0daf \u0218\u025c\u0dc0\u0dd0\u0dba \u0dc3\u0dc4 \u0d9c\u01e9\u0dd9\u0daf\u01e9\u0dc0 \u01e7\u0db8\u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0218\u025c\u0dc0\u0dd0\u0dba \u026a\u0dc1\u0dca\u0dc0\u0dcf\u0dc3\u0daf\u0dcf\u0dba\u0d9a \u0dd9\u0dbd\u0dc3 \u0db8\u0dd0\u01e7\u0dba"
  },
