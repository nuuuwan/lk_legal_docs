    "chunk_text": "\u0b92\u1f9e \u0baa\u0b95\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0ba4\u0bcd \u0bc7\u0ba4\u0bc8\u0bb5\u0b95\u0bcd\u0b95\u0bc1 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8a\u0baf\u0ba4\u0bbe\u0ba9 \u0b95\u0bc0\u0bb4\u0bcd\u0b95\u0bcd \u0b95\u0bbe\u1f8e\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0bc8\u0baf \u0b8e\u1f8c\u0ba4\u0bcd\u1f90\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3 \u0b85\u0bb0\u0b9a\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0bbe\u0bb0\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0bbf\u0baf\u0bbf\u1f9e\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0bc8\u0ba4 1964 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 28 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u0bb1\u0bcd (\u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bae\u0bcd) \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u0bb1\u0bcd\n\n4A\n\n\u0baa\u0b95\u0bc1\u0ba4\u0bbf III - \u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u1f8a\u0baf\u0bb0\u0b9a\u0bc1 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 - 2019.12.09\n\n\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd (\u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0baf\u0bae\u0bcd 460) 7 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd (1) \u0b86\u0bae\u0bcd \u0b89\u0b9f\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0bbe\u0bb0\u0bae\u0bcd \u0ba8\u0bbe\u0ba9\u0bcd, \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd.\n\n\u0b8e\u1f8c\u0ba4\u0bcd\u1f90\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0bb5\u0bbf\u1f9e\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd :\n\n\u0bb5\u0b9f\u0bc7\u0bae\u0bb2\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0bae\u0bcd, \u0b95\u0bc1\u1f9e\u0ba8\u0bbe\u0b95\u0bb2\u0bcd \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0bae\u0bb2\u0bcd\u0bb2\u0bb5\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u1f8a \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b87\u0bb2. 713, \u0bc6\u0bae\u0bb9\u0bbf\u0b8e\u0bb2\u0bcd\u0bb2 \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0bc6\u0bae\u0bb9\u0bbf\u0b8e\u0bb2\u0bcd\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3, \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5 \u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0ba8\u0bbe\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0ba4\u0baf\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 2019.09.25 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf 420202 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bb2\u0bcd \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd (\u0bc6\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf \u0b87\u0bb2. 07, \u0ba4\u0bbe\u0bb3\u0bcd \u0b87\u0bb2. 5) \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2.158, 161, 162, 164, 166, 167, 170, 171, 174, 175, 177, 180, 182, 183, 186, 187, 188 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 189 \u0b8e\u0ba9\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 0.7831 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u1f99\u1fa8 \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3 \u1f99\u0bc8\u0b9f\u0baf \u0baa\u0ba4\u0bbf\u0bc6\u0ba9\u0b9f\u0bcd\u1f8c (18) \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd \u1f90\u0ba3\u0bcd\u1f8c\u0b95\u0bb3\u0bbf\u0ba9\u1f90\u0bae\u0bcd 2019.09.25 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf 420202 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bb2\u0bcd \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd (\u0bc6\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf \u0b87\u0bb2. 02, \u0ba4\u0bbe\u0bb3\u0bcd \u0b87\u0bb2. 16) \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 205, 207, 208, 209, 210, 213, 214, 216, 217, 218, 221, 222, 223, 224, 226, 229, 230, 231, 232 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 233 \u0b8e\u0ba9\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 0.5457 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u1f99\u1fa8 \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u1f99\u0bc8\u0b9f\u0baf \u0b87\u1f9e\u0baa\u1f90(20) \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd \u1f90\u0ba3\u0bcd\u1f8c\u0b95\u0bb3\u0bbf\u0ba9\u1f90\u0bae\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd : 2019.09.25 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf 420202 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bc6\u0ba4\u0bbe\u0b95\u0bc1\u0ba4\u0bbf \u0b87\u0bb2. 07, \u0ba4\u0bbe\u0bb3\u0bcd \u0b87\u0bb2. 05 \u0b87\u0ba9\u0bcd \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bb2\u0bcd \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0bae\u0bcd"
  },
