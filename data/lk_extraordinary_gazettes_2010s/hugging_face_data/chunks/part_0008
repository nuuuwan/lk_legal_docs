021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u2013 2019.12.18\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.12.18\n\n417 0.0363 1. \u0ba8\u0bbf\u1fa3 \u1f97\u1fb9\u0baf\u0bb2\u0ba4\u0bbe \u0b8e\u0bb0\u1fb8\u0ba4 \u0baa\u1fb6\u0b9f\u0bbe\u0bb0 635230010v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 2. \u0b8f\u0b95\u0ba8\u0bbe\u0baf\u0b95 \u0b85\u0bc7\u0baa\u0bc7\u0b95\u0bbe\u1fb9 921810423v \u0b9a\u0bae \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0b95\u0ba9\u0bbf\u1fc3\u0b95 \u0b9f\u1fb9\u0b9f\u0bbe\u0bb0 \u0b8f\u0b95\u0ba8\u0bbe\u0baf\u0b95 \u0b87\u0bb2. \u0b8e-4, \u0b9a\u0bbf\u0bbe\u0bbf\u0bae\u1fbf \u0b89\u0baf\u0ba9 \u1faa\u0ba4\u0bbf, \u1f97\u0ba4\u0bbf\u0baf \u0bc6\u0b95\u0b9f\u1fbb\u1f97\u0bb5\u0bbe\u0ba9 \u1faa\u0ba4\u0bbf, \u0baa\u0bbf\u1fa2\u0baf\u1fb8\u0ba4\u0bc8\u0bb2 01 - 132 / 18\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf"
