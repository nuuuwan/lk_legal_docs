e\u1f8c \u0bc7\u0baa\u0ba3\u0bb1\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 64. (1) \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b9f\u0ba9\u0bcd \u0bc7\u0b9a\u0bb0\u0bcd\u0ba4\u0bcd\u1f90 \u0bb5\u0bbe\u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bc7\u0bb5\u0ba3\u0bcd\u1f8a\u0baf 3. \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bbe\u0ba9 \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3.\n\n\u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\n\n\u0bc8\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0baa\u0bbe\u0bb2 \u0b9a\u0bbf\u0bb1\u0bbf\u0bc7\u0b9a\u0ba9, \u0b9a\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf.\n\n\u0bc6\u0baa\u0bbe\u0bb2\u0ba9\u0bcd\u0ba9\u1fa0\u0bc8\u0bb5, 2019, \u0b92\u0bb1\u0bcd\u0bc7\u0bb1\u0bbe\u0baa\u0bb0\u0bcd 12.\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3\n\n\u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0ba4\u0ba9\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bbe\u1fa2 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0ba8\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0bc8\u0b9f \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd 1.024 \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0ba4\u0bcd\u0bc8\u0ba4\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0b95\u0bc0\u0bc7\u0bb4 \u1f97\u0bb5\u0bbf\u0b9a\u0bbe\u0bb0\u0bcd \u0b85\u0bb3\u1faa\u0b9f\u0bcd\u1f8a\u0bb2\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf (\u0b85\u0bb3\u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u1f97\u0bb5\u0bbf \u0b85\u0bb3\u0bb5\u0bbf\u0baf\u0bb2\u0bcd \u0b92\u1f9e\u0b99\u0bcd\u0b95\u0bbf\u0bc8\u0ba3\u0baa\u0bcd\u1f97 EPSG : 5234 \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd).\n\n(\u0b95\u0bbf.114755, \u0bb5.136364) \u0b87\u1f9e\u0ba8\u0bcd\u1f90 (\u0b95\u0bbf.114706, \u0bb5.136462), (\u0b95\u0bbf.114696, \u0bb5.136490), (\u0b95\u0bbf.114674, \u0bb5.136510), (\u0b95\u0bbf.114661, \u0bb5.136533), (\u0b95\u0bbf.114633, \u0bb5.136510), (\u0b95\u0bbf.114626, \u0bb5. 136493), (\u0b95\u0bbf.114639, \u0bb5.136489), (\u0b95\u0bbf.114643, \u0bb5.136472), (\u0b95\u0bbf.114661, \u0bb5.136461), (\u0b95\u0bbf.114661, \u0bb5.136461), (\u0b95\u0bbf.114659, \u0bb5.136445), (\u0b95\u0bbf.114677, \u0bb5.136368), (\u0b95\u0bbf.114685, \u0bb5.136349), (\u0b95\u0bbf.114724, \u0bb5.136349) \u0bb5\u0bc8\u0bb0\u1f9c\u0bae\u0bcd, \u0b85\u0ba4\u0bbf\u1fa2\u1f9e\u0ba8\u0bcd\u1f90 \u0b86\u0bb0\u0bae\u0bcd\u0baa\u0bbf\u0ba4\u0bcd\u1f90 \u0b92\u1f9e\u0b99\u0bcd\u0b95\u0bbf\u0bc8\u0ba3\u0baa\u0bcd\u1f97 (\u0b95\u0bbf.114755, \u0bb5.136364) \u0bb5\u0bc8\u0bb0\u1f9c\u0bae\u0bcd, \u1f99\u0bc8\u0ba9\u0b95\u0bb3\u0bcd \u1f99\u0bc8\u0bb1\u0bc7\u0baf \u0b87\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b87\u0b9f\u0baa\u0bcd\u0baa\u0bb0\u0baa\u0bcd\u1f97\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbe\u0b95\u0bc1\u0bae\u0bcd.\n\n\u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : 1.024 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd.\n\n11 - 77/4\n\n7A\n\nI \u0dd9\u0d9a\u0ddc\u0da7\u0dc3: (I) \u0dd9\u0da1\u0daf\u0dba - \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0