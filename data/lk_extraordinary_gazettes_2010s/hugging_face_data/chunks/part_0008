    "description": "Sabaragamuwa  Provincial Council   -  By-Laws of  Ayagama   Pradeshiya  Sabha",
    "url_metadata": "https://documents.gov.lk/view/extra-gazettes/egz_2019.html",
    "lang": "en",
    "url_pdf": "https://documents.gov.lk/view/extra-gazettes/2019/12/2152-59_E.pdf",
