    "chunk_text": "255 \u0dc0\u0db1 \u0d85\u01dd\u0d9a\u0dcf\u0dbb\u0dba \u0dc0\u0db1 1939 \u0d85\u0d82\u0d9a 61 \u0daf\u0dbb\u0db1 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0d85\u0da5\u0dcf \u0db4\u0db1\u0dd9\u01ae 157 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0db8\u0d9f \u00fb\u0dba\u026a\u0dba \u0252\u01b1 \u0d91\u00fc \u0d86\u0da5\u0dcf \u0db4\u0db1\u0dd9\u01ae 153 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u0dba\u01e6 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u021d\u0d9a\u0dcf\u0dbb \u0db6\u0dbd\u01e6\u0dd9\u0d9c\u02a3\u0da9 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u026a\u0286\u01e6 \u0dc3\u0dcf\u0daf\u01e9 \u0dbd\u0dd0\u022d \u0dc4\u0dcf 2019.06.11 \u0dc0\u0db1 \u01ce\u0db1 \u0db4\u0dd0\u0dc0\u01af \u0db8\u0dc4\u0dcf \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0dc3\u0db7\u0dcf \u0dc3\u023c\u0db8\u0dad\u0dc0 \u0d87\u01af \u0dd9\u0db8\u028f \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0db6\u0dbd\u01e6\u0dd9\u0d9c\u02a3\u0da9 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0db6\u0dbd \u021d \u0dd9\u01ca\u0dc1\u0dba \u01b1\u0dc5 \u0dd9\u01ae \u0dd9\u0d9a\u02a4\u0218 \u0d9a\u0da9 \u0dc4\u0dcf \u0dd9\u0d9a\u0179 \u0d86\u0dc4\u0dcf\u0dbb \u026a\u00fb\u019e\u0dd9\u023c \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0db8 \u0218\u0298\u0db6\u0db3 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0, 1989 \u0d85\u0d82\u0d9a 12 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf (\u0d86\u01e9\u0dc2\u0dcf\u0d82\u0119\u0d9a \u026a\u01dd\u026a\u0db0\u0dcf\u0db1) \u0db4\u0db1\u0dd9\u01ae 2 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0db8\u0d9f \u00fb\u0dba\u026a\u0dba \u0252\u01b1 \u0d89\u0dc4\u0dad \u00fc \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0d86\u0da5\u0dcf \u0db4\u0db1\u0dd9\u01ae 154(1) \u0dc0\u0d9c\u01e6\u01af\u0dba \u021d\u0d9a\u0dcf\u0dbb \u0dc3\u0db6\u0dbb\u0d9c\u023f\u0dc0 \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0d86\u019c\u018d\u0d9a\u0dcf\u0dbb \u0db0\u023c\u0db8 \u01ce\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0dc0\u0db1 \u0db8 \u026a\u0286\u01e6 \u0d85\u01e9\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db6\u0dc0\u01ae, \u0dd9\u0db8\u0db8 \u01e7\u0dd9\u0269\u0daf\u0db1\u0dba \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u01ce\u0db1 \u0286\u0da7 \u0d91\u00fc \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0db6\u0dbd\u01e6\u0dd9\u0d9c\u02a3\u0da9 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0db6\u0dbd \u021d\u0dd9\u01ca\u0dc1\u0dba \u0d87\u01b1\u0dc5\u0dad \u0db6\u0dbd\u0dcf\u01ae\u0db8\u0d9a \u0dc0\u0db1 \u0db6\u0dc0\u01ae \u0dd9\u0db8\u0250\u01e6 \u01e7\u0dd9\u0269\u0daf\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229.\n\n\u0db0\u023c\u0db8 \u01ce\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a, \u0d86\u019c\u018d\u0d9a\u0dcf\u0dbb, \u0dc3\u0db6\u0dbb\u0d9c\u023f\u0dc0 \u0db4\u0dc5\u0dcf\u0dad. 2019 \u0d94\u00fa\u0dd9\u0dad\u02a4\u0db6\u0259 \u0db8\u0dc3 30 \u0dc0\u0db1 \u01ce\u0db1, \u0dc3\u0db6\u0dbb\u0d9c\u023f\u0dc0 \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u01cf\u0dba.\n\n48 A\n\n\u0db6\u0dbd\u01e6\u0dd9\u0d9c\u02a3\u0da9 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0db6\u0dbd \u021d\u0dd9\u01ca\u0dc1\u0dba \u01b1\u0dc5 \u0dd9\u01ae \u0dd9\u0d9a\u02a4\u0218 \u0d9a\u0da9 \u0dc4\u0dcf \u0dd9\u0d9a\u0179 \u0d86\u0dc4\u0dcf\u0dbb \u026a\u00fb\u019e\u0dd9\u023c \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0db4\u0dc0\u01ae\u0dc0\u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0db8 \u0218\u0298\u0db6\u0db3 \u0d85\u01b1\u025e\n\n\u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\n\n1. \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0db6\u0dbd\u01e6\u0dd9\u0d9c\u02a3\u0da9 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0db6\u0dbd \u021d\u0dd9\u01ca\u0dc1\u0dba \u01b1\u0dc5 \u0dd9\u01ae \u0dd9\u0d9a\u02a4\u0218 \u0d9a\u0da9, \u0dd9\u0d9a\u0179 \u0d86\u0dc4\u0dcf\u0dbb \u026a\u00fb\u019e\u0dd9\u023c \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0db8 \u0db4\u0dcf\u0dbd\u0db1\u0dba \u00fb\u025d\u0db8, \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc4\u0dcf \u026a\u01dd\u0db8\u01ae \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0db1\u0dc0\u01e9 \u0dbd\u0dd0\u0dd9\u0229.\n\n2. \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0db6\u0dbd\u01e6\u0dd9\u0d9c\u02a3\u0da9 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0db6\u0dbd\u021d\u0dd9\u01ca\u0dc1\u0dba \u01b1\u0dc5 \u0dd9\u01ae \u0dd9\u0d9a\u02a4\u0218 \u0d9a\u0da9 \u0dc4\u0dcf \u0dd9\u0d9a\u0179 \u0d86\u0dc4\u0dcf\u0dbb \u026a\u00fb\u019e\u0dd9\u023c \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0218\u0298\u0db6\u0db3 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc4\u01ff\u01e6\u0dc0\u01e9 \u0dbd\u0dd0\u0dd9\u0229.\n\n3.(1) \u0d9a\u0dc0\u0dbb \u0dd9\u0dc4\u02a4 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u026a\u0286\u01e6 \u0db6\u0dbd\u01e6\u0dd9\u0d9c\u02a3\u0da9 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0db6\u0dbd\u021d\u0dd9\u01ca\u0dc1\u0dba \u01b1\u0dc5 (\u0dd9\u0db8\u028f \u023d\u01e6\u0db8\u01b1 \u0db6\u0dbd \u021d\u0dd9\u01ca\u0dc1\u0dba \u0dd9\u0dbd\u0dc3 \u0dc4\u01ff\u01e6\u0dc0\u01e9\n\n\u0dbd\u0db6\u0db1) \u0d9a\u0dc0\u0dbb \u0dd9\u0dc4\u02a4 \u0db4\u025c\u0279\u0dba\u0d9a \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u01e7\u00fd\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc0\u0dbd\u0d82\u011b \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0d87\u01ae\u0dd9\u01ae\u0db1\u023c \u023d\u0dc3 \u0dd9\u01ae \u0dd9\u0d9a\u02a4\u0218 \u0d9a\u0da9\u0dba\u00fa \u0dd9\u0dc4\u02a4\u0dd9\u0d9a\u0179 \u0d86\u0dc4\u0dcf\u0dbb \u026a\u00fb\u019e\u0dd9\u023c \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u00fa \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0db8 \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1\u0dba.\n\n3.(2) \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dba\u0da7\u0dd9\u01ae \u026d \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u0255 \u0dba\u023c \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u00fd \u026a\u0286\u01e6 \u0dd9\u0db8\u028f \u0db4\u0dc5\u023f\u0dc0\u0db1\n\n\u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0d86\u0d9a\u0dd8\u01af\u0dba\u0da7 \u0dc3\u0dcf\u0dbb\u0dcf\u01e9\u00fe\u0dbd\u0dc0 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d89\u0262\u0265\u023c\u0db4\u01b4\u0dba\u00fa \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u0dd9\u0dc0\u0dad \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dc5\u0252\u01b1\u0dba.\n\n3.(3) \u0dd9\u0db8\u0db8 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u026d \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dba \u0d9a\u0dc5\u0252\u01b1 \u0d9c\u0dcf\u0dc3\u0dca\u01b1 \u0dc3\u0db7\u0dcf\u0dc0 \u026a\u0286\u01e6 \u0240\u0263\u0d9a \u01e8\u01af\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u026a\u01dd\u026a\u0db0\u0dcf\u0db1\u0dba\u01e6\u0da7 \u0dba\u0da7\u01ae\u0dc0 \u01b0\u0dbb\u0dab\u0dba \u0d9a\u0dbb \u0db4\u0db1\u0dc0\u0dcf \u0d85\u0dba\u0d9a\u0dc5\u0252\u01b1 \u0d9c\u0dcf\u0dc3\u0dca\u01b1 \u026a\u0dba \u0252\u01b1\u0dba.\n\n4.(1) \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u026b\u0dd9\u0db8\u01e6 \u0db4\u0288 \u0d89\u0dc4\u0dad 3(1) \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0db6\u0dbd\u0db4\u01b4\u0dba\u0d9a\u0da7 \u0dba\u0da7\u01ae\u0dc0\u0db1 \u0db4\u025c\u0279\u0dba\u00fa \u0d86\u0dbb\u023c\u0db7 \u0d9a\u0dbb \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1\u0dba\u0dcf\u0db8\u0da7 \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf \u0d9a\u0dbb\u0db1 \u0d9a\u0dc0\u0dbb \u0dd9\u0dc4\u02a4 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u00fa, \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0dd9\u0dba\u02a4\u0d9c\u0255\u0db7\u0dcf\u0dc0\u0dba \u0218\u0298\u0db6\u0db3\u0dc0 \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u0dd9\u0dc0\u01af\u01e6 \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dba\u0da7\u0dd9\u01ae \u026d \u021b\u0259\u0dc0 \u0d85\u01e9\u0db8\u0dd0\u01af\u0dba\u00fa \u0dbd\u0db6\u0dcf\u0dd9\u0d9c\u0db1 \u0d87\u01ae\u0dd9\u01ae\u0db1\u023c \u023d\u0dc3 , \u0d89\u0dc4\u0dad 3(I) \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0262\u0265\u023c \u00fb\u025d\u0db8\u0da7 \u028f\u023d\u0d9a\u0db8\u00fa \u0dd9\u0db1\u02a3\u0db8\u0dd0\u01ae\u0dd9\u01ae\u0dba.\n\n4.(2) \u0dd9\u0db8\u0db8 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u021b\u0259\u0dc0 \u0d85\u01e9\u0db8\u0dd0\u01af\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0d89\u0262\u0264\u0db8\u00fa \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0db8\u0dc4\u0da2\u0db1 \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0db4\u025d\u00fa\u0dc2\u0d9a \u0dc0\u0dcf\u0259\u0dad\u0dcf\u0dc0 \u0dc4\u0dcf\n\n\u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0ddb\u0dc0\u0daf\u0255 \u01e7\u0dbd\u0db0\u0dcf\u025d\u0dd9\u0118 \u01e7\u0259\u0dd9\u01ca\u0dc1\u0dba \u0db8\u0dad \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0d85\u01e9\u0db8\u0dd0\u01af\u0dba \u0dbd\u0db6\u0dcf \u01ce\u0dba \u0252\u01b1\u0dba."
