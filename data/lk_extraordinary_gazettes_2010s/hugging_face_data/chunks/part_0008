d82\u0dc4 \u0d86\u0dbba2\u0dbd\u0dcf\u0dd9@ \u02c6\u0dc3 730071108v \u0dc3-tc\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u0daf\u0d82\u0dd9\u0d9a)\u02c6\u0dc0, \u0d85\u0d82\u0d9a 1646 b\u0dba\u0dbd\u0dcf= \u0db8\u0dcf\u0dc0\u0dad\u0d9c\u0db8, \u0d85\u0d82\u0d9a 34 \u0d94s{\u0dd9j \u0dc3\u0db3\u0dc4 \u0d85\u0d82\u0d9a 23, \u0db8\u0dd01\u0d9a\u0dd0\u0dd9= \u0da2\u0db1\u0db4\u0daf\u0dba, \u0d9a\u0db3\u0dc0\u0dbd, . \u0db41\u0d822 \u0d89.\u0007.\u0dd9\u0d9a). \u0d9a\u0da7\u0dcf\u0db1 \u0dd9\u0dc4\u0016N\u0d86\u0dbba2\u0dd9@ \u0dc3\u0db7\u0dcf\u0dd9j \u0dd9-\u0d9a\u0dbd\u0dcf \u0dd9\u0d9a) \u0dd9$#\u0dc0\u0dbd\u0da7 \u0dd9\u0dc4\u0016N\u0d86\u0dbba2 \u0dba\u0db1 \u0dba\u0da7;\u0dc0 \u0d85\u0dba\u0da7 (\u0dc0\u0dc3 2019.03.20 - 2020.03.19 \u0dafE\u0dc0\u0dcf \u0dad\u0db6\u0dcf \u0d87\u001b \u0db6$\u0daf\u0da7 \u0dba\u0da7;\u0dc0 92 0.0912 \u0db4=\u0dd9= \u0dd9\u0d9c\u0daf\u0dbb i\u0dbb\u0dba\u0dbd\u0dd1 \u20ac\u0dab\u0dbb;\u0db1 521431547v \u0dc3-tc\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u0d9a\u0dd0\u0db60 \u0d85\u0d82\u0d9a 03, \u0d85\u0d82\u0d9a 1648 \u0d85\u0d82\u0d9a 38, \u0db8\u0dd01\u0d9a\u0dd0\u0dd9=\u0dc0;\u0dad, \u0d9a\u0db3\u0dc0\u0dbd, 91 \u0dc3\u0dc4 244 \u0dba\u0db1 \u0d94s{\u0dd9j \u0dc3\u0db3\u0dc4 \u0d9a\u0da7\u0dcf\u0db1 \u0d9a\u0dd0\u0db60 \u0dc0\u0dbd \u0db8\u0dcfc\u0d9c \u0d89.\u0007.\u0dd9\u0d9a). \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85]\u001b\u0dba \u0dc3\u0db7\u0dcf\u0dd9j \u0dc3\u0db8\u0d9f, \u0d87;\u0d9c\u0dcf\u0dbd, \u0dd9\u0d9a) \u0dd9$#\u0dc0\u0dbd\u0da7 \u0d9a\u0da7\u0dcf\u0db1, 1 \u0db1\u0dd0\u20ac\u0db8 \u0dba\u0da7;\u0dc0 \u0007\u0da2\u0dcf ~\u0dbd \u0db6\u0dd0\u0d82|\u0dc0\u0da7 \u0dad\u0db6\u0dcf \u0d87\u001b \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7;\u0dc0 134 0.0317 3>\u0dd9\u0db6f\u0dd9\u0d9a)\u02c6\u0dd9j \u0dc1/\u0dbd\u0dcf \u0192\u0dc3 \u001b 777280414v \u0dc3-tc\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u0d9a\u0dd0\u0db60 \u0d85\u0d82\u0d9a 137 \u2013 \u0db8\u0dd0\u0161\u0dd9E 3>\u0dd9\u0db6f\u0dd9\u0d9a)\u02c6\u0dd9j 