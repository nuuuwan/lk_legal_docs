bbf\u0baa\u0ba4\u0bbf \u0bc8\u0bae\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0baa\u0bbe\u0bb2 \u0b9a\u0bbf\u0bb1\u0bbf\u0bc7\u0b9a\u0ba9 \u0b86\u0b95\u0bbf\u0baf \u0ba8\u0bbe\u1fb9, \u0b95\u0bc0\u1fc1 \u0b87\u0bc8\u0ba3\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf \u0bb5\u0bc8\u0bb0\u0baf\u1fa0\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0b8e\u1fbf\u0bc8\u0bb2\u0b95\u1fa6\u1fb0\u1f81\u1fc0 \u0b89\u1fb5\u0baa\u1fb5\u0b9f 1273.462 \u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u0bbe\u1fbd \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fb7\u0bc8\u0ba4\u1fb0 \u0bc6\u0b95\u0bbe\u1fb6\u0b9f \u0bc6\u0bae\u0ba4\u0b89\u1fbf\u0baa\u1fb7\u0ba4 \u0b95\u0bbe\u1fb5\u0bc8\u0b9f 2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0b92\u1fbe\u0bc7\u0bb1\u0bbe\u0baa\u1fbd \u0bae\u0bbe\u0ba4\u1fbb 12 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbf\u1fa2\u1f9e\u1fb8\u1f90 \u0bc6\u0bae\u0ba4\u0b89\u1fbf\u0baa\u1fb7\u0ba4 \u0b92\u1f90\u1fb0\u1f81\u1fb0 \u0b95\u0bbe\u1f8c \u0b8e\u0ba9 \u0b87\u1fb7\u0ba4\u0bbe\u1fbf \u0baa\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u1fba\u0baa\u1f8c\u1fb7\u1f90\u0b95\u0bbf\u1fb9\u0bc7\u0bb1\u1fb9.\n\n\u0bc8\u0bae\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0baa\u0bbe\u0bb2 \u0b9a\u0bbf\u0bb1\u0bbf\u0bc7\u0b9a\u0ba9, \u0b9a\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf. \u0bc6\u0baa\u0bbe\u0bb2\u1fb9\u0ba9\u1fa0\u0bc8\u0bb5, 2019, \u0b92\u1fbe\u0bc7\u0bb1\u0bbe\u0baa\u1fbd 12."
