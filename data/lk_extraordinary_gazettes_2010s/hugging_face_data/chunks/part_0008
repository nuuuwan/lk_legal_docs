    "chunk_text": "\u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a, \u0dc0\u0259\u0dc2\u0dd9\u0dba\u028f \u0d89\u01af\u025c \u0d9a\u0dcf\u0dbd\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0119\u026a\u0288\u023c\u0d9a\u025e\u0dc0\u01e6 \u0dc4\u01ff\u0db1\u0dcf\u0d9c\u0dd0\u01e8\u0db8 \u0d8a\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u021b\u0259\u0dc0 \u0dbd\u0d82\u0288 \u0d9a\u0dd0\u0db3\u026b\u0dd9\u0db8\u01e6 \u0288\u01d0\u0288\u0d9a\u023c \u0dbd\u01ae \u0dbd\u0d82\u0288 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0d87\u0d9c\u0251\u023c \u0d9a\u023d\u017b\u0dc0 \u01e7\u0259\u0dd9\u01ca\u0dc1 \u0dbd\u0d82\u0288\u0d9a\u025e\u0dc0\u01e6 \u0d85\u0dad\u025c\u01e6 \u0dbd\u0d82\u0288\u0d9a\u025e\u0dd9\u0dc0\u00fd \u0dd9\u0da7\u01e6\u0da9\u0dbb \u0d9a\u023d\u017b\u0dc0 \u026a\u0286\u01e6 \u01e7\u0259\u0dd9\u01ca\u0dc1 \u0d9a\u0dc5\u0dc4\u0dd0\u00fb \u0d85\u0dad\u0dbb, \u0db1\u0dd0\u0dad\u0dd9\u0dc4\u02a3\u01ae \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0dc0\u0dcf\u0286\u0daf\u0dcf\u0dba\u0d9a \u026a\u0d9a\u0262\u0db4 \u0101\u0dba\u0dcf\u0db8\u0dcf\u0259\u0d9c\u0dba \u00fd\u0db8\u00fa\u0daf \u0dba\u01e6\u0db1 \u0d91\u0db8 \u0dbd\u0d82\u0288 \u0d9a\u0dd0\u0db3\u026b\u0db8\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u026d \u0dd9\u0da7\u01e6\u0da9\u0259 \u0d9a\u023d\u017b\u0dc0 \u026a\u0286\u01e6 \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u01e7\u0259\u0dd9\u01ca\u0dc1 \u0d9a\u0dc5\u0252\u01b1\u0dba. \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0da7\u01e6\u0da9\u0259 \u0d9a\u023d\u017b\u0dc0 \u0d89\u01ce\u025c\u0dba\u0da7 \u0dbd\u0d82\u0288\u0d9a\u025e\u0dc0\u01e6 \u0d9a\u0dd0\u0db3\u0dc0\u0dcf \u0dc3\u0dcf\u0d9a\u013c\u0da1\u0dcf \u00fb\u025d\u0db8 \u01e8\u0dad\u0255\u01e9\u00fe\u0dbd \u0dba. 405. \u021d\u0daf\u0dcf\u0db1 \u0db4\u01b4\u0dba\u00fa \u0dba\u0da7\u0dd9\u01ae \u0119\u026a\u0dc3\u0d9c\u0dd0\u01e8\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbd\u0db6\u0dcf\u0dd9\u0daf\u0db1 \u01e7\u0dc1\u0dca\u013d\u0dad \u01ce\u0db1 \u0dd9\u0dc4\u02a4 \u021b\u0259\u0dc0\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u02a4 \u026a\u01dd\u0db8\u01ae \u0119\u026a\u0288\u0db8\u0d9a\u0da7 \u0d87\u01b1\u0dc5\u01ae \u026b\u0db8\u0da7\n\n45A\n\nIV (\u0d85) \u0dd9\u0d9a\u02a3\u0da7\u0dc3 - \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba - 2019.12.24\n\n(ii) \u0d89\u0dc4\u0dad \u025d\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u026d \u0dc0\u0dcf\u0259\u0dad\u0dcf\u0dc0\u00fa \u0dd9\u0262\u0d9a\u023c \u026a\u0286\u01e6 \u0dc3\u0db7\u0dcf\u0db4\u01af \u0dd9\u0dc0\u0dad \u0d89\u01ce\u025c\u0db4\u01ae \u00fb\u025d\u0dd9\u0db8\u01e6 \u0db4\u0288 \u0dc3\u0db7\u0dcf\u0db4\u01af \u026a\u0286\u01e6 \u0d8a\u0da7\n\n\u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0d85\u0dc0\u0dc3\u0dbb\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dba\u02a4\u0da2\u0db1\u0dcf\u0dc0\u00fa \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb \u0d85\u01e9\u0db8\u0dd0\u01af\u0dba \u0dbd\u0db6\u0dcf\u0d9c\u0dad \u0252\u01b1\u0dba. (iii) \u0dd9\u0da7\u01e6\u0da9\u0259 \u0d9a\u0dcf\u0259\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dca\u01c2\u0dbb \u0dd9\u0da7\u01e6\u0da9\u0259 \u0d9a\u023d\u017b\u0dc0 \u0dd9\u0dc4\u02a4 \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0db8 \u0db4\u01ae\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dd9\u0da7\u01e6\u0da9\u0259 \u0d9a\u023d\u017b\u0dc0\u00fa \u026a\u0286\u01e6\n\n\u0dd9\u0da7\u01e6\u0da9\u0259 \u0d9a\u0dcf\u0259\u0dba\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dd9\u01ca\u0db4\u0dc5 \u01e7\u0dc1\u0dca\u013d\u0dad\u0dc0 \u0dc4\u01ff\u0db1\u0dcf\u0d9c\u0dad \u0252\u01b1 \u0d85\u0dad\u0dbb, \u0d8a\u0da7 \u0dc3\u0db8\u0dcf\u01e6\u0dad\u0dbb\u0dc0 \u0d91\u0db8 \u0d9a\u0dcf\u0259\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0db8 \u0db4\u01ae\u0dc0 \u0d87\u01af \u0d87\u0d9c\u0251\u023c \u0d9a\u023d\u017b\u0dc0 \u0dba\u0da7\u0dd9\u01ae \u026a\u00fb\u019e\u0db8 \u0d85\u0daf\u0dcf\u0dc5 \u0dd9\u01ca\u0db4\u0dc5 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dc0 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0dc0\u02a4\u013d\u0dad\u0dc0 \u0dc0\u0dbb\u0dbd\u01ae \u0dad\u00fa\u0dd9\u0dc3\u02a2\u025e\u0d9a\u025e\u0dd9\u0dc0\u00fd \u0dba\u0da7\u0dd9\u01ae \u0dd9\u0dc4\u02a4 \u0da0\u0d82\u0da0\u0dbd \u0dd9\u01ca\u0db4\u0dc5\u00fa \u0dd9\u0269 \u0db1\u023c \u0dd9\u0dc4\u02a4 \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u026a\u0dd9\u0dc1\u02a2\u027f\u0dad \u0daf\u0dd0\u01e9\u0db8\u0dd0\u01af \u0d85\u0dba\u0dc0\u0265\u01e6\u0dd9\u0d9c\u01e6 \u0dbd\u0db6\u0dcf\u0d9c\u01ae \u0dad\u00fa\u0dd9\u0dc3\u02a2\u025e \u0dc0\u0dcf\u0259\u0dad\u0dcf \u0db4\u0daf\u0db1\u023c \u0d9a\u0dbb \u0d9c\u01e7\u023d\u01e6 \u0dd9\u01ca\u0db4\u0dc5 \u0dc0\u0179\u0db1\u0dcf\u0d9a\u023c \u0218\u0298\u0db6\u0db3 \u01e7\u0259\u0dd9\u01ca\u0dc1 \u0dd9\u0da7\u01e6\u0da9\u0259 \u0d9a\u023d\u017b\u0dc0 \u0dd9\u0dc0\u0dad \u0dbd\u0db6\u0dcf \u01ce\u0dba \u0252\u01b1\u0dba. (iv) \u0da0\u0d82\u0da0\u0dbd \u0dd9\u01ca\u0db4\u0dc5 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0dc0\u0db1\u026a\u0da7 \u01cf \u0dd9\u0da7\u01e6\u0da9\u0259 \u0d9a\u023d\u017b\u0dc0 \u026a\u0286\u01e6 \u0d85\u0daf\u0dcf\u0dc5 \u0db7\u0dcf\u019c\u0da9\u0dc0\u0dbd \u0dd9\u0dc0\u01e6 \u0dd9\u0dc0\u01e6 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u026d\n\n\u0dad\u00fa\u0dd9\u0dc3\u02a2\u025e \u0dc0\u0179\u0db1\u0dcf\u0d9a\u0db8 \u0db4\u0daf\u0db1\u023c \u0d9a\u0dbb\u0d9c\u01e7\u023d\u01e6 \u0d92 \u0d92 \u0db7\u0dcf\u019c\u0da9\u0dd9\u024f \u0dbd\u0d82\u0288 \u0d85\u0d9c\u0dba \u01b0\u0dbb\u0dab\u0dba \u0d9a\u0dc5 \u0252\u01b1 \u0d85\u0dad\u0dbb, \u0d91\u00fc \u0d85\u0d9c\u0dba \u0db8\u0dad \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0d8b\u0db4\u025c\u0db8 \u0240\u0dbd\u0255 \u0dc0\u0dcf\u0286\u0dba\u00fa \u0286\u01d0\u0dc0\u0db1 \u0db4\u025c\u01ce \u0286\u01d0\u0d9a\u0dc5 \u0252\u01b1 \u0288\u01d0\u0288 \u0dd9\u0da7\u01e6\u0da9\u0259 \u0100\u0db8\u0dba \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u01e7\u0259\u0dd9\u01ca\u0dc1, \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dc5 \u0252\u01b1\u0dba. \u0d91\u00fc \u01e7\u0259\u0dd9\u01ca\u0dc1 \u0db4\u0daf\u0db1\u023c \u0d9a\u0dbb\u0d9c\u01e7\u023d\u01e6 \u0d85\u01e9\u0d9c\u0db8\u0db1\u0dba \u0d9a\u0dc5\u0252\u01b1 \u0dd9\u0da7\u01e6\u0da9\u0259 \u0100\u0db8\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u01b0\u0dbb\u0dab\u0dba \u0d9a\u0dc5 \u0252\u01b1\u0dba. (v) \u01e7\u0dc1\u0dca\u0da0\u0dbd \u0dd9\u01ca\u0db4\u0dc5\u00fa \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0dc0\u0db1\u026a\u0da7 \u0da2\u0dcf\u01af\u0d9a \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u021d\u0286\u01ca\u0db0 \u021a\u0dc0\u01ae\u0db4\u01ae \u0dba\u0da7\u0dd9\u01ae \u0db8\u0dc4\u0da2\u0db1\u0dba\u0dcf \u0dd9\u0dc0\u0dad \u021d\u0286\u01ca\u0db0\n\n\u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u01e7\u0dd9\u0269\u0daf\u0db1 \u0db8\u0119\u01e6 \u0dc3\u0dc4 \u0dd9\u0da7\u01e6\u0da9\u0259 \u0d9a\u023d\u017b \u0dd9\u0dba\u02a4\u0da2\u0db1\u0dcf \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0dd9\u0dc0\u0db1\u01ae \u0d86\u0d9a\u0dcf\u0dbb\u0dba\u01e6\u0dd9\u0d9c\u01e6 \u021d\u0286\u01ca\u0db0 \u0d9a\u0dbb \u021d\u0286\u01ca\u0db0 \u0dd9\u0dc0\u01e6\u0dd9\u01ca\u0286\u0dba\u00fa \u0dba\u0da7\u0dd9\u01ae \u0dbd\u0d82\u0288 \u0d9a\u0dd0\u0db3\u026b\u0db8 \u0db8\u0dad \u0dc4\u01ff\u0db1\u0dcf\u0d9c\u01e9 \u0dbd\u0db6\u0db1 \u0dc0\u0da9\u0dcf\u01ae \u0dc0\u0dcf\u0286\u0daf\u0dcf\u0dba\u0d9a \u023d\u0dbd\u0da7 \u026a\u00fb\u019e\u0db8 \u0d9a\u0dc5 \u0252\u01b1\u0dba. (vi) \u0da0\u0d82\u0da0\u0dbd \u0dd9\u01ca\u0db4\u0dc5\u00fa \u0dba\u0da7\u0dd9\u01ae \u0d91\u0d9a\u0dc0\u0dbb \u026a\u00fb\u019e\u0db8\u0da7 \u0d87\u01af \u0db7\u0dcf\u019c\u0da9 \u0dd9\u0dc0\u01e6 \u0dd9\u0dc0\u01e6\u0dc0 \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb \u0d9a\u018b\u0db1\u023d\u01e6 \u0d92 \u0dc3\u0db3\u0dc4\u0dcf\n\n\u0dd9\u0da7\u01e6\u0da9\u0259 \u0101\u0dba\u0dcf\u0dc0\u0263\u0dd9\u024f \u0dbd\u0d82\u0288 \u0dc0\u0179\u0db1\u0dcf\u0d9a\u0db8 \u0dbd\u0db6\u0dcf\u0d9c\u0dad \u0252\u01b1 \u0d85\u0dad\u0dbb, \u0d92\u0dd9\u0dc3\u02a2 \u0d85\u0250\u0dad\u0db8\u0dba\u01e6 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0dd9\u0db1\u02a3\u0dc3\u0dbd\u0d9a\u0dcf \u0dbd\u0d82\u0288 \u0dc0\u0179\u0db1\u0dcf\u0d9a\u0db8\u00fa \u0dbd\u0db6\u0dcf\u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0dd9\u0dc4\u02a2\u01b1 \u0d87\u01ae\u0dd9\u01ae \u0db1\u023c \u0d8a\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dd9\u0dc4\u02a2\u01b1 \u0d87\u0d9c\u0251\u023c \u0d9a\u023d\u017b\u0dc0 \u0dc3\u0dc4 \u0dd9\u0da7\u01e6\u0da9\u0259 \u0d9a\u023d\u017b\u0dc0 \u0d91\u00fa\u0dc0 \u0db4\u0dc0\u01ae\u0dc0\u0db1 \u025a\u0dc3\u0dca\u026b\u0db8\u0d9a \u01ce \u01b0\u0dbb\u0dab\u0dba \u0d9a\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u01e9\u0db8\u0dd0\u01af\u0dba \u0dbd\u0db6\u0dcf \u01af\u022a\u0dba \u0252\u01b1\u0dba. 411. \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u01b1 \u0d89\u0da9\u023c, \u0dd9\u0d9c\u02a3\u0da9\u0db1\u0dd0\u0135\u0263 \u01cf\u0259\u0d9d \u0d9a\u0dcf\u0264\u0db1\u0dc0 \u0db6\u01d0\u01cf\u0db8, \u00fd\u0263\u0dba\u0da7 \u01cf\u0db8 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0dd9\u0db8\u0db8 \u025d\u01af \u0dba\u0da7\u0dd9\u01ae \u021b\u0259\u0dc0\u0dd9\u0dba\u01e6 \u00fd\u0db8\u00fa \u0dc3\u0db3\u0dc4\u01e6 \u026d\u0dc0\u0daf \u0db4\u0dc4\u0dad \u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u0d92 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u021d\u023f\u0d9b \u026a\u0dba \u0252\u01b1\u0dba. (i) \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u01b1 \u0d89\u0da9\u023c \u0dc0\u0dc3\u0dbb\u0d9a\u0da7 \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u018b \u0d9a\u0dcf\u0dbd\u0287\u0db8\u0dcf\u0dc0\u0d9a\u0da7 \u0db6\u01d0\u01cf\u0db8, \u00fd\u0263\u0dba\u0da7 \u01cf\u0db8\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dd9\u0da7\u01e6\u0da9\u0259 \u0101\u0dba\u0dcf\u0dc0\u0263\u0dba\u0d9a \u01cf"
