u0baf\u0bae\u0bcd) \u0b95\u0bbe\u1f8c \u0bc7\u0baa\u0ba3\u0bb1\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 3\u0b85. \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba4\u0bcd\u1f90\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0baf\u0bc8\u0ba9\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u1f8c \u0b9a\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u0bc8\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0baa\u0bbe\u0bb2 \u0b9a\u0bbf\u0bbe\u0bbf\u0bc7\u0b9a\u0ba9 \u0b86\u0b95\u0bbf\u0baf \u0ba8\u0bbe\u0ba9\u0bcd, \u0b95\u0bc0\u0bb4\u0bcd \u0b87\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bc8\u0bb0\u0baf\u1fa0\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 0.4 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0ba4\u0bcd\u0bc8\u0ba4\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0b95\u0bc1\u1f9e\u0bb5\u0bbf\u0ba4\u0bcd \u0ba4\u0bc0\u1fab \u0b95\u0ba3\u0bcd\u0b9f\u0bb2\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0bc8\u0b9f 2019 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8c \u0b92\u0bb1\u0bcd\u0bc7\u0bb1\u0bbe\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd 12 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbf\u1fa2\u1f9e\u0ba8\u0bcd\u1f90 \u0b95\u0bc1\u1f9e\u0bb5\u0bbf\u0ba4\u0bcd \u0ba4\u0bc0\u1fab \u0b95\u0ba3\u0bcd\u0b9f\u0bb2\u0bcd \u0bc7\u0baa\u0ba3\u0bb2\u0bcd \u0b95\u0bbe\u1f8c \u0b8e\u0ba9 \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u1f90\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd. \u0bc8\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0baa\u0bbe\u0bb2 \u0b9a\u0bbf\u0bb1\u0bbf\u0bc7\u0b9a\u0ba9, \u0b9a\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf. \u0bc6\u0baa\u0bbe\u0bb2\u0ba9\u0bcd\u0ba9\u1fa0\u0bc8\u0bb5, 2019, \u0b92\u0bb1\u0bcd\u0bc7\u0bb1\u0bbe\u0baa\u0bb0\u0bcd 12.\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 :- \u0b95\u0bbf.094137 \u0bb5.254403, \u0b95\u0bbf.094192 \u0bb5.254397, \u0b95\u0bbf.094215 \u0bb5.254384, \u0b95\u0bbf.0.94199 \u0bb5.254322 \u0b92\u1f9e\u0b99\u0bcd\u0b95\u0bbf\u0bc8\u0ba3\u0baa\u0bcd\u1f97 \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2. \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 :- \u0b95\u0bbf.094133 \u0bb5.254237, \u0b95\u0bbf.094063 \u0bb5.254165 \u0b92\u1f9e\u0b99\u0bcd\u0b95\u0bbf\u0bc8\u0ba3\u0baa\u0bcd\u1f97 \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2. \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 :- \u0b95\u0bbf.094029 \u0bb5.254035, \u0b95\u0bbf.093988 \u0bb5.254068, \u0b95\u0bbf.093980 \u0bb5.254101 \u0b92\u1f9e\u0b99\u0bcd\u0b95\u0bbf\u0bc8\u0ba3\u0baa\u0bcd\u1f97 \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2. \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 :- \u0b95\u0bbf.093994 \u0bb5.254153, \u0b95\u0bbf.093978 \u0bb5.254183, \u0b95\u0bbf.093964 \u0bb5.254242, \u0b95\u0bbf.093989 \u0bb5.254278, \u0b95\u0bbf.094049 \u0bb5.254330, \u0b95\u0bbf.094137 \u0bb5.254403 \u0b92\u1f9e\u0b99\u0bcd\u0b95\u0bbf\u0bc8\u0ba3\u0baa\u0bcd\u1f97 \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0baa\u0bae\u0bcd\u0baa\u0bb2\u0b95\u0bcd \u0b95\u0bb3\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bbf\u1f9c\u0bb3\u0bcd\u0bb3 \u0b87\u0b9f\u0baa\u0bcd\u0baa\u0bb0\u0baa\u0bcd\u1f97\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbe\u0b95\u0bc1\u0bae\u0bcd. . \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : 0.4 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd 11