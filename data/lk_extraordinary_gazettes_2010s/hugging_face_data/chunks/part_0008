b5\u1f8a\u1fbf \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\u0ba4 \u0b9a\u0bbf\u1fb1\u0bb9\u1f97\u1fb7\u0bb0 \u0baa\u0bbf\u0bc7\u0ba9\u1fb9\u1fc4 \u0b95\u1fbb\u0baa\u0ba9\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 30 0.0226 \u0bb0\u1fb4\u0b9c\u1fb9 \u0baa\u1fb6\u0b9f\u0bbe\u0bb0 \u0bc6\u0b9a\u0ba9\u0bb5\u0bbf\u0bb0\u1fb7\u0ba9 880263285v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 47 \u0b87\u1fb9 \u2013 \u0b87\u0bb2. 50/1\u1f96/2, \u0bc8\u0bae\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf 1 \u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0baa\u1fb5\u0b9f\u1f97\u1fa4\u0bb5, \u0b95\u1fb6\u1f8a \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb \u0bc6\u0ba4\u0bbe\u0bc8\u0bb2\u0bc7\u0baa\u0b9a\u0bbf \u0bb5\u0b9a\u0ba4\u0bbf, \u0ba8\u0bc0\u1fbd \u0bae\u1fbe\u1fa0\u1fbb \u0bae\u0bbf\u1fb9\u0b9a\u0bbe\u0bb0\u1fb0 \u0b95\u1fbb\u0baa\u0bbf\u0b95\u0bc8\u0bb3 \u0b87\u0bc8\u0ba3\u1f90\u1fb0 \u0bc6\u0b95\u0bbe\u1fc0\u0bb5\u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 31 0.0216 \u0bc7\u0ba4\u0bae\u0bbf\u0baf \u0baa\u1fb6\u0b9f\u0bbe\u0bb0 \u0bc6\u0b9a\u0ba9\u0bb5\u0bbf\u0bb0\u1fb7\u0ba9 831733748v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 47 \u0b87\u1fb9 \u2013 \u0b87\u0bb2. 50/1, \u0bc8\u0bae\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0baa\u1fb5\u0b9f\u1f97\u1fa4\u0bb5, \u0b95\u1fb6\u1f8a \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 32 0.0507 \u0bb0\u1fb7\u0ba8\u0bbe\u0baf\u1fb0\u0b95 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc6\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0bb2\u1fa2\u0ba4 762021730v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 47 \u0b87\u1fb9 \u2013 \u0b95\u1f86\u1fb9 \u0bb0\u1fb7\u0ba8\u0bbe\u0baf\u1fb0\u0b95 ( \u0baa\u0bbf\u0bb1 \u0bc6\u0baa\u0baf\u1fbd\u0b95\u1fc0 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bb2\u0b9a\u1fb8\u0ba4 \u0bb0\u1fb7\u0ba8\u0bbe\u0baf\u1fb0\u0b95 ) \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b87\u0bb2. 50/7/\u0b9a\u0bc0, \u0bc8\u0bae\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 1 \u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0baa\u1fb5\u0b9f\u1f97\u1fa4\u0bb5, \u0b95\u1fb6\u1f8a 33 0.0249 \u0bb0\u1fb7\u0ba8\u0bbe\u0baf\u1fb0\u0b95 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc6\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0b95\u0baf\u0bbe\u0ba9\u0bbf 847003685v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90. 47 \u2013 \u0ba4\u0bbf\u1fbf\u1f9e\u1fb0 \u0bb7\u0bbf ( \u0baa\u0bbf\u0bb1 \u0bc6\u0baa\u0baf\u1fbd\u0b95\u1fc0 \u0b95\u0baf\u0bbe\u0ba9\u0bbf \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0ba4\u0bbf\u1fbf\u1f9e\u1fb0 \u0bb7\u0bbf \u0bb0\u1fb7\u0ba8\u0bbe\u0baf\u1fb0\u0b95 ) \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b87\u0bb2. 50/1\u0b92\u1fbc, \u0bc8\u0bae\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 1 \u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0baa\u1fb5\u0b9f\u1f97\u1fa4\u0bb5, \u0b95\u1fb6\u1f8a 34 0.0231 \u0bc7\u0bb9\u0bb0\u1fb7 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc6\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0b9a\u0bbf\u1fb7\u0bb0\u0bbe 615632481v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 47 \u0b87\u1fb9 \u2013 \u1f81\u0bae\u0bbe\u0bbe\u0bbf\u0bb9\u0bbe\u0bae\u0bbf \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 01, \u0bb0\u0bb5\u1fb9\u0b92\u0baf, \u0b9a\u0bb0\u0b9a\u0bb5\u0bbf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bc6\u0baa\u0bbe\u1fbf\u0bc6\u0b95\u0bbe\u1fbf\u0bb2 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 35 0.0228 \u0bae\u0bbe\u1f90\u0bc7\u0bb5 \u0bc7\u0bb9\u0bb5\u0bc7\u0b95 \u0bc6\u0bae\u0bbe\u0bb9\u0bbe\u1fb9 \u0ba4 \u0b9a\u0bbf\u1fbf\u0bb5\u0bbe 791271410 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 47 \u0b87\u1fb9 \u2013 \u0b87\u0bb2. 50/5, \u0bc8\u0bae\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf 1 \u0bb5\u1f90 \u0b92\u1fa8\u1fb1\u0bc8\u0b95, \u0baa\u1fb5\u0b9f\u1f97\u1fa4\u0bb5, \u0b95\u1fb6\u1f8a \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 37 0.0185 \u0b86\u1f97\u1fb9\u0b95\u0bb9 \u0bc6\u0b95\u0ba4\u0bb0 \u0b9a\u0bbe\u1f94\u0b95 \u0ba4\u0bb0\u1fb1\u0b95\u0ba9\u0bc0 867110151v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bb5\u1fb7\u0bc7\u0ba4\u0b95\u0bc6\u0ba4\u0bb0 \u2013 \u0b87\u0bb2. 44/4, \u0bc6\u0baa\u0bbe\u0bae\u1fa4\u0bb5 \u0bc7\u0ba4\u0bb5\u1fb5\u0b9f \u1faa\u0ba4\u0bbf, \u0baf\u0b9a\u0bb5\u0ba4\u0bc0 \u0baa\u1fb5\u0b9f\u1f97\u1fa4\u0bb5 \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90\n\n26 A\n\nIII \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2013 \b \u0dbd\u0d82\u0d9a\u0dcf \u0dbd\u0d82\u0d9a\u0dcf \u0dbd\u0d82\u0d9a\u0dcf \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000f\u0010\u0da2\u0dcf\u0dad\u0dcf\u000f\u0010\u0da2\u0dcf\u0dad\u0dcf\u000f\u0010\u0da2\u0dcf\u0dad\u0dcf\u000f\u0010\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0013 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0016 \u0d85\u0018 \u0019\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0013 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0016 \u0d85\u0018