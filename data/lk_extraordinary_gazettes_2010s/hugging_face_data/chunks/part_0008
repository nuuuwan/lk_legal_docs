\u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 106, 105, 109 \u0bae\u1fbe\u1fa0\u1fbb 189 \u1fbe\u1f81 \u0baa\u0bbf\u0bb0\u0bc7\u0bb5\u0b9a\u0bbf\u1fba\u0baa- \u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 189 0.0508 \u0bb0\u0bbe\u0b9c\u0baa\u1fb0 \u0bb7 \u0bb5\u1fa2\u1f99\u0ba9\u0bbf \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc6\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 571381753v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 90 \u2013 \u0ba8\u0bbf\u0bae\u1fbf \u0bb5\u0bbf\u0bc7\u0b9c\u0bb0\u1fb7\u0ba9 \u0bae\u1fbe\u1fa0\u1fbb 188 \u0b87\u1fb9 \u0b87\u0bb2. 147/7, \u0ba4\u1fbd\u0bae\u0bbe\u0bc7\u0bb8\u0bbe\u0b95 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0bb2\u0bc6\u0bb5\u1fbf\u0bb2, \u0b95\u1fb6\u1f8a \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 190 0.0608 \u0bb0\u0bbe\u0b9c\u0baa\u1fb0 \u0bb7 \u0bb5\u1fa2\u1f99\u0ba9\u0bbf \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc6\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 571381753v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 90 \u0b87\u1fb9 \u2013 \u0ba8\u0bbf\u0bae\u1fbf \u0bb5\u0bbf\u0bc7\u0b9c\u0bb0\u1fb7\u0ba9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 147/7, \u0ba4\u1fbd\u0bae\u0bbe\u0bc7\u0bb8\u0bbe\u0b95 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bc7\u0bb2\u0bc6\u0bb5\u1fbf\u0bb2, \u0b95\u1fb6\u1f8a \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 191 0.0838 \u0ba8\u0bbf\u0bb2\u0bbe\u1fb9 \u0b85\u0bb0\u1fb1\u0b95 \u0bc6\u0b95\u0bbe\u0bb2\u0bc6\u0b95\u0bbe\u1fbf\u0bb2 720700891v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0ba8\u0bbe\u1fa2\u0ba9\u0bbf \u0bc6\u0bae\u0ba9\u0bbf\u0bc7\u0b95 \u2013 \u0b87\u0bb2. 147/09, \u0ba4\u1fbd\u0bae\u0bbe\u0bc7\u0bb9\u0bbe\