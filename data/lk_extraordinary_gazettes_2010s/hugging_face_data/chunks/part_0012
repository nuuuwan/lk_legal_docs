9\u01ae \u0286\u0da7 \u0db1\u0dc0\u01af\u0dc3\u0dca\u0db4\u0dd9\u01e6\u0da7 \u0dba\u0db1 \u0db8\u0dcf\u0259\u0d9c\u0dba \u0daf, \u0db6\u0dc3\u0dca\u0db1\u0dcf\u028f\u0dbb\u0da7 : \u023f.\u0218-\u01e93053 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a \u023f.\u0218. -A329/35, \u023f.\u0218.-A 329/297 \u0daf \u0dd9\u0269. \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 4.3827 11-76/2\n\n\u0dc0\u0db1 \u0dc3\u0d82\u0dbb\u00fa\u0dc2\u0dab \u0d86\u0da5\u0dcf\u0db4\u0db1\u0dad \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d86\u019c\u018d\u0100\u0db8 \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 19 \u0dc0\u0db1 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1\u0dd9\u024f 51 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0db8\u0d9c \u00fb\u0dba\u026a\u0dba \u0252\u01b1 1979 \u0d85\u0d82\u0d9a 56, 1982 \u0d85\u0d82\u0d9a 13, 1988 \u0d85\u0d82\u0d9a 84, 1995 \u0d85\u0d82\u0d9a 23 \u0dc4\u0dcf 2009 \u0d85\u0d82\u0d9a 65 \u0daf\u0dbb\u0db1 \u0db4\u0db1\u01ae \u0dc0\u0263\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u01dd\u0dad 1966 \u0d85\u0d82\u0d9a 13 \u0daf\u0dbb\u0db1 (451 \u0dc0\u0dd0\u01e7 \u0d85\u01dd\u0d9a\u0dcf\u0dbb\u0dba \u026d) \u0dc0\u0db1 \u0dc3\u0d82\u0dbb\u00fa\u0dc2\u0dab \u0d86\u0da5\u0dcf\u0db4\u0db1\u0dd9\u01ae 64. (1) \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0db8\u0d9c \u00fb\u0dba\u026a\u0dba \u0252\u01b1 3. \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u026d \u01e7\u0dba\u0db8\u0dba.\n\n\u01e7\u0dba\u0db8\u0dba\n\n\u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d86\u019c\u018d\u0100\u0db8 \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 19 \u0dc0\u0db1 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1\u0dd9\u024f 51 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0db8\u0d9c \u00fb\u0dba\u026a\u0dba \u0252\u01b1 1979 \u0d85\u0d82\u0d9a 56, 1982 \u0d85\u0d82\u0d9a 13, 1988 \u0d85\u0d82\u0d9a 84, 1995 \u0d85\u0d82\u0d9a 23 \u0dc4\u0dcf 2009 \u0d85\u0d82\u0d9a 65 \u0daf\u0dbb\u0db1 \u0db4\u0db1\u01ae \u0dc0\u0263\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u01dd\u0dad 1966 \u0d85\u0d82\u0d9a 13 \u0daf\u0dbb\u0db1 (451 \u0dc0\u0dd0\u01e7 \u0d85\u01dd\u0d9a\u0dcf\u0dbb\u0dba \u026d) \u0dc0\u0db1 \u0dc3\u0d82\u0dbb\u00fa\u0dc2\u0dab \u0d86\u0da5\u0dcf\u0db4\u0db1\u0dd9\u01ae 3. \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u021d\u0d9a\u0dcf\u0dbb\u0dc0 \u0da2\u0db1\u0dcf\u01dd\u0db4\u01af, \u0ddb\u0db8\u01b6\u0db4\u0dcf\u0dbd \u0286\u025c\u0dd9\u0dc3\u02a2\u0db1 \u0dc0\u0db1 \u0db8\u0db8, \u0db4\u0dc4\u0dad \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f \u0db8\u0dcf\u0250\u023c \u01b1\u0dc5 \u0218\u028f\u0179 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 10.7048 \u0d9a \u026a\u0dc1\u0dcf\u0dbd\u01ae\u0dc0\u0dd9\u0dba\u01e6 \u0252\u01b1 \u0dc0\u0dd0\u0da7\u0dc3\u0dca\u0dad\u0dd0\u01e6\u0db1 \u0dc0\u0db1\u0dcf\u01e6\u0dad\u0dbb\u0dba \u0dc0\u0259\u0dc2 2019 \u00fa \u026c \u0d94\u00fa\u0dd9\u0dad\u02a4\u0db6\u0259 \u0db8\u0dc3 12 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0286\u0da7 \u0dc0\u0dd0\u0da7\u0dc3\u0dca\u0dad\u0dd0\u01e6\u0db1 \u0dbb\u00fa\u027f\u0dad \u0dc0\u0db1\u0dcf\u01e6\u0dad\u0dbb\u0dba \u0dd9\u0dbd\u0dc3 \u0dd9\u0db8\u0250\u01e6 \u021d\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u01ae \u0d9a\u0dbb\u023d. \u0ddb\u0db8\u01b6\u0db4\u0dcf\u0dbd \u0286\u025c\u0dd9\u0dc3\u02a2\u0db1, \u0da2\u0db1\u0dcf\u01dd\u0db4\u01af. 2019 \u0d94\u00fa\u0dd9\u0dad\u02a4\u0db6\u0259 \u0db8\u0dc3 12 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0dd9\u0db4\u02a3\u0dd9\u0dc5\u02a3\u01e6\u0db1\u025e\u0dd9\u0269 \u01cf \u0dba.\n\n\u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba\n\n\u0db8\u0db0\u0255\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u01e9\u0dc0\u0dbb\u0d91\u0298\u0dba \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0dc4\u0137\u0dbb\u01e6\u0dd9\u0d9a\u0dad \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0dc0\u0dd0\u0da7\u0dd0\u0dc3\u0dca\u0dad\u0dd0\u01e6\u0db1, \u0dc4\u0db3\u0dc0\u0dbd \u0218\u0179\u0dba, \u0dd9\u0daf\u0dbd\u0db4\u01ae\u0d9a\u0da9 \u0d9c\u023c \u01e7\u0dd9\u0dba\u02a4\u0da2\u0db1\u0dba \u0dc0\u0db1 \u0db4\u025c\u01ce \u027c \u0dbd\u0d82\u0d9a\u0dcf \u023d\u01e7\u01e6\u0dd9\u0daf\u02a4\u025e \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dc0 \u026a\u0286\u01e6 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u023f.\u0218.\u01e9.3175 \u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 1, 2, 3, 4, 5 \u0dc3\u0dc4 7 \u0d87\u01b1\u0dc5\u01ae \u021d\u0db8\u0dcf\u0dab\u0dba \u0dd9\u0dc4\u00fa 10.7048 \u00fa \u026d \u026a\u0dc1\u0dcf\u0dbd\u01ae\u0dc0\u0dd9\u0dba\u01e6 \u0252\u01ae \u023f\u029a \u022a\u0db8 \u021d\u0db8\u0dcf\u0dab\u0dba \u0dd9\u0269.\n\n\u0d8b\u01b1\u0dbb\u0da7 : \u0dc0\u0dd0\u0da7\u0dc3\u0dca\u0dad\u0dd0\u01e6\u0db1 \u0d9c\u0dd9\u0db8\u028f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dc4\u0dcf \u0dd9\u0daf\u0262\u0db4\u01ae\u0d9a\u0da9 \u0d9c\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa\n\n\u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb : \u0dc0\u0dd0\u0da7\u0dc3\u0dca\u0dad\u0dd0\u01e6\u0db1 \u0d9c\u0db8"
