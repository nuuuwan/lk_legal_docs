    "chunk_text": "5.(10) \u0d85\u0dc0\u0dc1\u0255\u0dad\u0dcf\u0dc0 \u0db8\u0dad \u0db4\u0298\u0dd9\u0db6\u02a4\u0db0\u0d9a\u0250\u01e6 \u0db6\u0dd0\u0dc4\u0dd0\u0dbb \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4 \u0db4\u025c\u0279\u0dba \u0db4\u0298\u0dd9\u0db6\u02a4\u0db0\u0d9a\u0250\u01e6\u0dd9\u0d9c\u01e6 \u0dd9\u0dad\u02a3\u0dbb\u0dc0 \u0dad\u0dd0\u022b\u0db8\u0da7 \u0288\u01d0\u0288 \u0db4\u0dcf\u0dbd\u0db1 \u0100\u0db8\u0dba\u00fa \u0d85\u01e9\u0d9c\u0db8\u0db1\u0dba \u0d9a\u0dc5 \u0252\u01b1 \u0d85\u0dad\u0dbb, \u0286\u0dba\u0265 \u0da2\u0dd9\u0db1\u0262 \u0dc3\u0dc4 \u0218\u026a\u0288\u023c \u0dd9\u0daf\u02a3\u0dbb\u017b \u0288\u01d0\u0288 \u0daf\u0dd0\u0262 \u0db8\u0135\u01e6 \u0d86\u0dc0\u0dbb\u0dab\u0dba \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0218\u0dba\u0dc0\u0dbb \u0d9c\u0dad \u0252\u01b1\u0dba.\n\n99A\n\nIV (\u0d85) \u0dd9\u0d9a\u02a3\u0da7\u0dc3 - \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba - 2019.12.05\n\n5.(12) \u0db4\u025c\u0279\u0dd9\u024f \u0db7\u0dcf\u026a\u0dad\u0dcf \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0286\u0dba\u0265 \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0dc3\u0dc4 \u0dd9\u0db8\u0dc0\u0dbd\u023c, \u0dba\u023c \u026a\u0dc2 \u01d6\u0dc0\u0255\u00fa, \u01d0\u0d9c\u0db3\u00fa \u0dd9\u0dc4\u02a4 \u0dbb\u0dc3\u0dba\u00fa \u0dd9\u021d\u02a2\u0dc2\u0dab\u0dba \u0dd9\u0db1\u02a3\u0d9a\u0dbb\u0db1\n\n\u01d6\u0dc0\u0255\u0dc0\u0263\u01e6 \u0dc3\u0dcf\u0daf\u0dcf \u01af\u022a\u0dba \u0252\u01b1\u0dba. \u0d91\u0dc0\u0dd0\u01e7 \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0dc3\u0dc4 \u0dd9\u0db8\u0dc0\u0dbd\u023c \u0d85\u0dc0\u0dd9\u0dc1\u02a4\u0dc2\u0dab\u0dba \u0dd9\u0db1\u02a3\u0dc0\u0db1 \u0dc3\u0dc4 \u0db8\u0dc5 \u0dd9\u0db1\u02a3\u0db6\u0dd0\u0dd9\u0db3\u0db1 \u01d6\u0dc0\u0255\u0dc0\u0263\u01e6 \u0dc3\u0dcf\u0daf\u0dcf \u01af\u022a\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb, \u0d92\u0dc0\u0dcf \u01ce\u0119\u01e6 \u01ce\u0d9c\u0da7\u0db8 \u0218\u025c\u0286\u01d0 \u00fb\u025d\u023c\u0dc0\u0dbd\u0da7 \u0dc4\u0dcf \u026a\u0dc2\u022b\u0da2\u0db1\u0dcf\u0dc1\u0d9a\u0dc0\u0dbd\u0da7 \u0d94\u0dd9\u0dbb\u02a3\u01ae\u01b1 \u0dd9\u0daf\u0db1 \u01d6\u0dc0\u0255\u0dc0\u0263\u01e6 \u0dc3\u0dcf\u0daf\u0dcf \u01af\u022a\u0dba \u0252\u01b1\u0dba. \u028f\u0da9\u0dd0\u0dc3\u0dca \u0dc3\u0dc4 \u0286\u0252\u023c \u026a\u0dc0\u0dbb\u0dc0\u0263\u01e6 \u0dd9\u0dad\u02a3\u0dbb \u0288\u0db8\u0da7 \u0db8\u01b1\u0218\u0da7\u0dc0\u0262 \u01af\u022a\u0dba \u0252\u01b1\u0dba. \u0db4\u0dc4\u0288\u0dd9\u0dc0\u01e6 \u0218\u025c\u0286\u01d0 \u0d9a\u0dc5 \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u00fb \u0dc3\u0dc4 \u026a\u0dc2\u022b\u0da2\u0db1\u0dcf\u0dc1\u0d9a \u0dd9\u0dba\u0daf\u026a\u0dba \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u00fb \u0264 \u0dc0\u0259\u0d9c \u0dc3\u0dc4 \u0dd9\u0dc0\u0db1\u01ae \u01d6\u0dc0\u0255 \u0db7\u0dcf\u026a\u0dad\u0dcf \u00fb\u025d\u0dd9\u0db8\u01e6 \u0dc0\u0dd0\u0dc5\u00fc \u0286\u0179\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb, \u0d92\u0dc0\u0dcf \u0db4\u0dd0\u0dc4\u0dd0\u01ce\u0263\u0dc0\u0db8 \u01d1\u0dc4\u0db1\u0dba \u026b\u0dd9\u023c \u0240\u0dbd\u0dcf\u0279\u0dba\u00fa \u0dd9\u0db1\u02a3\u0dc0\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbd\u01cf \u0db4\u0db8\u0dab\u00fa \u0d91\u0dd9\u0dc3\u02a2 \u0db7\u0dcf\u026a\u0dad\u0dcf \u0d9a\u0dc5 \u0dc4\u0dd0\u00fb\u0dba.\n\n5.(13) \u0d86\u0dc4\u0dcf\u0dbb \u01d6\u0dc0\u0255 \u0d91\u01b0\u0db8 \u0dc3\u0dc4 \u0d87\u0286\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db7\u0dcf\u026a\u0dad\u0dcf \u0d9a\u0dbb\u0db1 \u01d6\u0dc0\u0255,\u01d1\u0dc4\u0db1 \u023f\u0dbd\u0dcf\u0279 \u0dd9\u0db1\u02a3\u026a\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb \u0d91\u01b0\u0db8\u0da7 \u0d9c\u01e6\u0db1\u0dcf \u01d6\u0dc0\u0255 \u01d1\u0dc4\u0db1\u0dba \u026b\u0dd9\u023c \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0d9a\u0da7 \u0dbd\u00fa \u0dd9\u0db1\u02a3\u0dc0\u0db1 \u0db4\u025c\u01ce \u0d9c\u0db6\u0da9\u0dcf \u0d9a\u0dbb \u01af\u022a\u0dba \u0252\u01b1\u0dba.\n\n6. \u0d85\u0dd9\u0dbd\u026a\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0db6\u0dcf \u0d87\u01af \u01d6\u0dc0\u0255 \u0d91\u00fb\u0dd9\u0db1\u0d9a \u023f\u0288 \u0dd9\u0db1\u02a3\u0dc0\u0db1 \u0db4\u025c\u01ce \u0dc4\u0dcf \u0dd9\u0dc0\u01e6 \u0dd9\u0dc0\u01e6 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u021d\u0daf\u0259\u0dc1\u0db1\u0dba \u0dc0\u0db1 \u0db4\u025c\u01ce \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0d9c\u0dad \u0252\u01b1\u0dba.\n\n7. \u0db4\u025c\u0279\u0dba \u01b1\u0dc5 \u0dd9\u0dc0\u0db1\u01ae \u00fb\u0286\u0dba\u023c \u0263\u0110\u0dad \u01e8\u01af\u0dba\u00fa \u0dba\u0da7\u0dd9\u01ae \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0d85\u0daf\u0dcf\u0dc5 \u026a\u0dba \u0252\u01b1 \u01d6\u0dc0\u0255\u0dba\u00fa \u0dd9\u0dc0\u0dc5\u0db3\u0dcf\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0db6\u0dcf \u0d87\u01ae\u0dd9\u01ae \u0db1\u023c \u0d8a\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0db6\u0dbd\u0db4\u01b4\u0dba \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 3(1) \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u026d \u0db6\u0dbd\u0db4\u01b4\u0dba\u0da7 \u0d85\u01af\u0dd9\u0259\u0d9a \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0db4\u025c\u0279\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0daf\u0dcf\u0dc5 \u026a\u0dba \u0252\u01b1\u0dba.\n\n8. \u026a\u00fd\u019f\u023c \u01d6\u0dc0\u0255 \u021d\u0daf\u0259\u0dc1\u0db1\u0dba \u00fb\u025d\u0dd9\u023c\u01cf \u0db4\u0dcf\u025c\u0dd9\u0db7\u02a4\u0119\u0d9a\u0dba\u0dcf\u0dd9\u0118 \u0daf\u0259\u0dc1\u0db1 \u0db4\u0dae\u0dba \u0d85\u0dc0\u028f\u0dbb \u0dc0\u0db1 \u0dd9\u0dbd\u0dc3 \u0dc4\u0dcf \u0d86\u0dc4\u0dcf\u0dbb \u01d6\u0dc0\u0255\u0dc0\u0dbd\u0da7 \u0d85\u028f\u0dad\u0d9a\u0dbb \u0dd9\u0dbd\u0dc3 \u0d87\u0286\u025d\u023c \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1\u0dba.\n\n9. \u0d86\u0dc4\u0dcf\u0dbb \u01d6\u0dc0\u0255 \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u0dba\u023c \u01d6\u0dc0\u0255\u0dba\u00fa \u0db6\u0dc4\u0dcf\u0265\u023c\u0dc0\u0dbd \u0db6\u0dc4\u0dcf \u021d\u0daf\u0259\u0dc1\u0db1\u0dba \u0d9a\u0dbb\u0250 \u0db1\u023c \u0d91\u028f \u0db4\u0dc0\u01af\u0db1 \u01d6\u0dc0\u0255 \u0dd9\u0dc4\u02a4 \u0dd9\u0db4\u02a3\u01d0 \u0db1\u0dcf\u0db8\u0dba \u0dc4\u0dcf \u023d\u0dbd \u0db4\u0dcf\u025c\u0dd9\u0db7\u02a4\u0119\u0d9a\u0dba\u0dcf\u0da7 \u0dd9\u0db4\u0dd9\u0db1\u0db1 \u0dd9\u0dbd\u0dc3 \u021d\u0daf\u0259\u0dc1\u0db1\u0dba \u0d9a\u0dc5 \u0252\u01b1\u0dba.\n\n10. \u00fb\u0286\u0db8 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u00fd \u026a\u0286\u01e6 \u0db6\u0dbd\u0db4\u01b4\u0dbd\u0dcf\u0235 \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a \u0db6\u0262\u0dbd\u01e6 \u021b\u0dc3\u01e6 \u0dc0\u0dd0\u01e7 \u0dc3\u01b1\u01e6 \u0dd9\u0dc4\u02a4 \u00fd\u025e\u0262\u0dbd\u01e6 \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u0d9a\u0dc0\u0dbb \u0dd9\u0dc4\u02a4 \u0288\u0dbb\u0dad\u0262 \u0dc3\u01b1\u01e6 \u0d87\u01af \u00fb\u025d\u0db8 \u0dd9\u0dc4\u02a4 \u0d87\u01af \u00fb\u025d\u0db8\u0da7 \u0d9a\u0da7\u0252\u01b1 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u026b\u0db8 \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1\u0dba.\n\n11. \u0db6\u0dbd\u0db4\u01b4\u0dbd\u0dcf\u0235 \u0d86\u0dba\u0dad\u0db1\u0dd9\u024f \u0d86\u0dc4\u0dcf\u0dbb \u01d6\u0dc0\u0255 \u026a\u00fb\u019e\u023c \u0d9a\u0dbb\u0db1 \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0db4\u0298\u0dd9\u0db6\u02a4\u0db0\u0d9a\u0250\u01e6 \u0dd9\u0d9c\u01e6 \u0dd9\u0dad\u02a3\u0dbb \u026a\u0dba \u0252\u01b1\u0dba. \u0db4\u0298\u0dd9\u0db6\u02a4\u0db0\u0d9a\u0250\u01e6 \u0db4\u0dcf\u0dbd\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0dcf\u0259\u0dba\u00fa\u0dc2\u0db8 \u0dc4\u0dcf \u0d85\u0d9b\u019c\u0da9 \u0dc0\u0dd0\u0da9 \u0218\u0298\u0dd9\u0dc0\u0dc5\u00fa \u01af\u022a\u0dba \u0252\u01b1\u0dba.\n\n12. \u0db4\u025c\u0279\u0dba \u01b1\u0dc5 \u026a\u00fb\u019e\u0dd9\u023c \u0d9a\u0262 \u0d89\u00fd\u01ae \u026b \u0d87\u01af \u0db7\u0dcf\u019c\u0da9 \u0dd9\u0dc4\u02a4 \u01d6\u0dc0\u0255 \u0dd9\u0dc4\u02a4 \u0d85\u0dd9\u0dbd\u026a \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1 \u0db6\u0dc0\u0da7 \u01e7\u0dba\u0db8 \u0d9a\u0dbb \u0d87\u01af \u0db7\u0dcf\u019c\u0da9 \u0dd9\u0dc4\u02a4 \u01d6\u0dc0\u0255 \u0dc3\u0dd1\u0db8 \u026a\u0da7\u0db8 \u026a\u00fb\u019e\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0db6\u0dcf \u0d87\u01af \u0db7\u0dcf\u019c\u0da9 \u0dc4\u0dcf \u01d6\u0dc0\u0255 \u0d85\u0dad\u025c\u01e6 \u0d89\u0dc0\u01ae \u0d9a\u0dbb \u0dd9\u0dc0\u0db1\u0db8 \u0d9c\u0db6\u0da9\u0dcf \u0d9a\u0dbb \u0dd9\u0262\u0db6\u0262 \u0d9a\u0dbb \u0db4\u0dc0\u01ae\u0dc0\u0dcf \u0d9c\u0dad \u0252\u01b1\u0dba.\n\n13. \u0db6\u0dc4\u0dcf\u0265\u023c\u0dc0\u0dbd \u0d86\u0dc4\u0dcf\u0dbb \u01d6\u0dc0\u0255 \u01d1\u0dc4\u0db1\u0dba \u0dd9\u0db1\u02a3\u0dc0\u0db1 \u0d86\u0d9a\u0dcf\u0dbb\u0dba\u0da7 \u0d86\u0dbb\u00fa\u0dc2\u0dcf\u0d9a\u0dcf\u025d \u0dd9\u0dbd\u0dc3 \u0dad\u0dd0\u01e6\u0db4\u01ae \u0d9a\u0dc5 \u0252\u01b1\u0dba.\n\n14. \u0dc3\u0dd1\u0db8 \u0d86\u0dc4\u0dcf\u0dbb \u0db6\u0dc4\u0dcf\u0265\u0db8\u00fa \u0db8 \u0d86\u0dc4\u0dcf\u0dbb \u028f\u0dad\u0d9a\u0dbb \u0db6\u0dc4\u0dcf\u0265\u023c \u026a\u0dba \u0252\u01b1\u0dba."
