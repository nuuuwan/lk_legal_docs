    "chunk_text": "11. \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbd \u01e7\u0dba\u0db8\u0dba\u01e6 \u0db4\u025d\u00fa\u0dc2\u0dcf \u00fb\u025d\u0db8\u0da7 \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0dd9\u0dc4\u02a4 \u0d94\u0291 \u026a\u0286\u01e6 \u0db6\u0dbd\u0dba \u0db4\u0dc0\u0dbb\u0db1 \u0dbd\u0daf \u01e7\u0dbd\u0db0\u0dcf\u025c\u0dd9\u0dba\u00fd\u0da7,\u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0ddb\u0dc0\u0daf\u0255 \u01e7\u0dbd\u0db0\u0dcf\u025d\u0da7, \u0db8\u0dc4\u0da2\u0db1 \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0db4\u025d\u00fa\u0dc2\u0d9a\u0da7 \u0d95\u0db1\u0dd1\u0db8 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0dd9\u0269\u0dbd\u0dcf\u0dc0\u0d9a \u0db6\u0dbd\u0dba \u0d87\u01af \u0d85\u0dad\u0dbb \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0db6\u0dbd\u0db4\u01b4\u0dbd\u0dcf\u0234\u0dba\u0dcf \u026a\u0286\u01e6 \u0dc3\u0dd1\u0db8 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0dc3\u0dc4\u0dcf\u0dba\u00fa\u0db8 \u0dbd\u0db6\u0dcf\u01ce\u0dba \u0252\u01b1\u0dba.\n\n13. \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u01e7\u00fd\u01ae\u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0db6 \u0d87\u01af \u00fb\u0286\u0dba\u023c \u0db4\u025c\u0279\u0dba\u00fa \u0dba\u0da7\u0dd9\u01ae \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u00fb\u0286\u0dba\u023c \u0dc0\u0d9c\u01e6\u01af\u0dba\u0d9a \u0dc3\u0db3\u0dc4\u01e6 \u01e7\u0dba\u0db8\u0dba\u01e6 \u0d8b\u0262\u0dbd\u0d82\u0d9d\u0db1\u0dba \u0dd9\u0dc0\u023d\u01e6 \u0dd9\u0dc4\u02a4 \u0d8a\u0da7 \u0db4\u0da7\u0dc4\u0dd0\u01e7\u0dc0\u0db1 \u0db4\u025c\u01ce \u0d9a\u0da7\u0252\u01b1 \u0dd9\u0d9a\u0dd9\u0dbb\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a, \u01e7\u0dc1\u0dca\u013d\u0dad\u0dc0 \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u01ce\u0db1\u0dba\u0d9a\u0da7 \u0dd9\u0db4\u0dbb \u0d91\u00fc \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0d92 \u01e7\u0dba\u0db8\u0dba\u01e6\u0da7 \u0d85\u01e9\u00fe\u0dbd \u0dad\u01ae\u01ae\u0dc0\u0dba\u0da7 \u0dd9\u0d9c\u0db1 \u0d92\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u0255 \u0286\u0dba\u0265 \u0dd9\u01ca \u0d89\u017b \u0d9a\u0dbb\u0db1 \u0dd9\u0dbd\u0dc3\u0da7 \u0db6\u0dbd\u0db4\u01b4\u0db0\u0dcf\u025c\u0dba\u0dcf\u0da7 \u01e7\u0dba\u0db8 \u0d9a\u0dbb\u0db1 \u0daf\u0dd0\u01e6\u026b\u0db8\u00fa \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0d91\u00fc \u0db6\u0dbd\u0db4\u01b4\u0db0\u0dcf\u025c\u0dba\u0dcf \u0dd9\u0dc0\u0dad \u0db6\u0dcf\u0dbb\u0dd9\u0daf\u01e9 \u0dbd\u0dd0\u022b\u0db8\u0da7 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u026a\u0dba \u0252\u01b1\u0dba. \u0d91\u00fc \u0daf\u0dd0\u01e6\u026b\u0dd9\u0db8\u01e6 \u0dbd\u0db6\u0dcf\u0dd9\u0daf\u0db1 \u0d8b\u0db4\u025c\u0db8 \u0d9a\u0dcf\u0dbd\u0dba \u01ce\u0db1 30 \u0d9a\u0da7 \u0dd9\u0db1\u02a3\u0dc0\u0dd0\u018b \u026a\u0dba \u0252\u01b1\u0dba.\n\n14. \u0dd9\u0db8\u028f 13 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u0d86\u0d9a\u0dcf\u0dbb\u0dd9\u024f \u0daf\u0dd0\u01e6\u026b\u0db8\u00fa \u0dbd\u0dd0\u022c\u019f \u0d9a\u0dc0\u0dbb \u0dd9\u0dc4\u02a4 \u0db6\u0dbd\u0db4\u01b4\u0dbd\u0dcf\u0234\u0dd9\u0dba\u00fd \u026a\u0286\u01e6 \u0d91\u00fc \u0daf\u0dd0\u01e6\u026b\u0dd9\u023c \u01e7\u0dc1\u0dca\u013d\u0dad\u0dc0 \u0dc3\u0db3\u0dc4\u01e6 \u01ce\u0db1\u0dba\u0da7 \u0dd9\u0db4\u0dbb \u0d92 \u0daf\u0dd0\u01e6\u026b\u0dd9\u023c \u01e7\u0dba\u0db8 \u0d9a\u0dbb \u0d87\u01af \u0d86\u0d9a\u0dcf\u0dbb\u0dba\u0da7 \u0101\u0dba\u0dcf \u0d9a\u0dc5\u0252\u01b1\u0dba. \u0db6\u0dbd\u0db4\u01b4 \u0dbd\u0dcf\u0234\u0dba\u0dcf \u026a\u0286\u01e6 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0263\u0110\u0dad \u0d89\u0262\u0264\u0db8\u00fa \u0db8\u0dad \u0d91\u00fc \u0daf\u0dd0\u01e6\u026a\u0dd9\u023c \u01e7\u0dc1\u0dca\u013d\u0dad\u0dc0 \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dcf\u0dbd\u0dba \u01cf\u0259\u0d9d \u00fb\u025d\u0db8\u0da7 \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0db6\u0dbd\u0dba \u01af\u022a\u0dba \u0252\u01b1\u0dba. \u0d91\u0dd9\u0dc3\u02a2 \u026c\u0dc0\u0daf \u01cf\u0259\u0d9d \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d9a\u0dcf\u0dbd\u0dba \u01ce\u0db1 14 \u0da7 \u0dd9\u0db1\u02a3\u0dc0\u0dd0\u018b \u026a\u0dba \u0252\u01b1\u0dba.\n\n15. \u0dd9\u0db8\u028f 13 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u0d86\u0d9a\u0dcf\u0dbb\u0dd9\u024f \u0daf\u0dd0\u01e6\u026b\u0db8\u00fa \u0dbd\u0dd0\u022d \u0d9a\u0dc0\u0dbb \u0dd9\u0dc4\u02a4 \u0db6\u0dbd\u0db4\u01b4\u0dbd\u0dcf\u0234\u0dd9\u0dba\u00fd \u0d91\u00fc \u0daf\u0dd0\u01e6\u026b\u0dd9\u023c \u01e7\u0dc1\u0dca\u013d\u0dad\u0dc0 \u01e7\u0dba\u0db8 \u0d9a\u0dbb \u0d87\u01af \u01ce\u0db1\u0dba \u0dd9\u0dc4\u02a4 \u01cf\u0259\u0d9d \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022d \u01ce\u0db1\u0dba\u0da7 \u0dd9\u0db4\u0dbb \u0d92 \u0daf\u0dd0\u01e6\u026b\u0dd9\u023c \u01e7\u0dba\u0db8 \u0d9a\u0dbb \u0d87\u01af \u0d86\u0d9a\u0dcf\u0dbb\u0dd9\u0dba\u01e6 \u0101\u0dba\u0dcf\u00fb\u025d\u0db8 \u0db4\u0dd0\u0dc4\u0dd0\u0dbb \u0dc4\u0dd0\u0dbb \u0d87\u01af \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a, \u0d92 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0dd9\u0dc0\u0dad \u01e7\u00fd\u01ae \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022d \u0db6\u0dbd\u0db4\u01b4\u0dba \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0d85\u0dc0\u0dbd\u0d82\u011b \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022b\u0db8 \u01e8\u0dad\u0255\u0dcf\u01e9\u00fe\u0dbd \u026a\u0dba \u0252\u01b1\u0dba.\n\n16. \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dba\u0da7\u0dd9\u01ae \u0dbd\u0db6\u0dcf \u0d9c\u0dad \u0252\u01b1 \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fb\u01e6 \u0dd9\u0dad\u02a3\u0dbb\u0dc0 \u0db4\u025c\u0279\u0dba\u00fa \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0db8 \u0dd9\u0dc4\u02a4 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dc0\u0dbb \u0dd9\u0dc4\u02a4 \u01e7\u0dba\u0db8\u0dba\u00fa \u0d8b\u0262\u0dbd\u0d82\u0d9d\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc0\u0dbb\u0daf\u00fa\u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0d91\u0db8 \u0dc0\u0dbb\u0daf \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u01e7\u0286 \u0d85\u01dd\u0d9a\u0dbb\u0dab \u0db6\u0dbd\u0dba \u0dc3\u028f\u0dad \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dba\u00fa \u026a\u0286\u01e6 \u0dc0\u0dbb\u0daf\u0d9a\u0da7 \u0dc0\u0dbb\u0daf\u0d9a\u025e \u00fb\u025d\u0dd9\u0db8\u01e6 \u0d85\u0db1\u01b1\u025e\u0dc0 \u0d91\u00fc \u0dc0\u0dbb\u0daf \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 1987 \u0d85\u0d82\u0d9a 15 \u0daf\u0dbb\u0db1 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db4\u0db1\u0dd9\u01ae 122 (2) \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u0daf\u0da9\u0dba\u0d9a\u0da7 \u0dba\u0da7\u01ae\u026a\u0dba \u0252\u01b1\u0dba. \u0d91\u00fc \u0dc0\u0dbb\u0daf \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u01e7\u0286 \u0db6\u0dbd\u0dba \u0dc3\u028f\u0dad \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dba\u00fb\u01e6 \u0dc0\u0dbb\u0daf\u0d9a\u0da7 \u0dc0\u0dbb\u0daf\u0d9a\u025e\u026b\u0dd9\u0db8\u01e6 \u0d85\u0db1\u01b1\u025e\u0dc0 \u0daf\u0da9\u0dba\u0d9a\u0da7 \u0dba\u0da7\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u00fd \u026a\u0286\u01e6 \u0d91\u00fc \u0d9a\u0da9\u00fb\u025d\u0db8 \u0dd9\u0dc4\u02a4 \u0d8b\u0262\u0dbd\u0d82\u0d9d\u0db1\u0dba \u00fb\u025d\u0db8 \u0dad\u0dc0\u01d0\u0dbb\u0da7\u01ae \u0dd9\u0db1\u02a3\u0d9a\u0da9\u0dc0\u0dcf \u0d9a\u0dbb\u0dd9\u0d9c\u0db1 \u0dba\u01e9 \u0dbd\u0db6\u0db1 \u026a\u0da7\u0d9a \u0d91\u0db8 \u0d8b\u0262\u0dbd\u0d82\u0d9d\u0db1\u0dba \u0218\u0298\u0db6\u0db3 \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0dd9\u0dba\u02a3\u023f \u0d9a\u0dbb\u023d\u01e6 \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0dd9\u0dc4\u02a4 \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0ddb\u0dc0\u0daf\u0255 \u01e7\u0dbd\u0db0\u0dcf\u025d \u0dd9\u0dc4\u02a4 \u0db8\u0dc4\u0da2\u0db1 \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0db4\u025d\u00fa\u0dc2\u0d9a\u026a\u0286\u01e6 \u0263\u0110\u0dad \u0daf\u0dd0\u01e6\u026b\u0db8\u00fa \u0db7\u0dcf\u0dbb \u0dd9\u0daf\u01e9 \u0dbd\u0dd0\u022b\u0dd9\u0db8\u01e6 \u0db4\u0288\u0dc0 \u0d8b\u0262\u0dbd\u0d82\u0d9d\u0db1\u0dba \u0dad\u0dc0\u01d0\u0dbb\u0da7\u01ae \u0dd9\u0db1\u02a3\u0d9a\u0da9\u0dc0\u0dcf\u0d9a\u0dbb\u0dd9\u0d9c\u0db1 \u0dba\u0db1 \u0dc3\u0dd1\u0db8 \u0d91\u00fa \u01ce\u0db1\u0dba\u00fa \u0dc3\u0db3\u0dc4\u0dcf\u0db8 \u0d89\u0dc4\u0dad \u00fc \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u0d85\u01af\u0dd9\u0259\u0d9a \u0daf\u0da9\u0dba\u0d9a\u0da7\u0daf \u0dba\u0da7\u01ae \u026a\u0dba \u0252\u01b1\u0dba.\n\n17. \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u0db4\u0daf \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d85\u0db1\u0255\u0dcf\u0259\u0dae\u0dba\u00fa \u0d85\u0dc0\u0dc1\u0255 \u026c\u0dc0\u0dd9\u0dc4\u02a3\u01ae \u023d\u0dc3,\n\n\u201c\u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6 \u0d87\u0dc4\u0dd0\u0263\u0dba\u0dd9\u0d9c\u02a3\u0da9 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0dad\u01ae\u0d9a\u0dcf\u0dbd\u0dd9\u0dba\u028f \u0dc3\u0db7\u0dcf\u0db4\u01af\u01e0\u0dbb\u0dba \u0daf\u0dbb\u0db1 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u0dcf \u0dd9\u0dc4\u02a4 \u0d91\u0db8 \u01e0\u0dbb\u0dd9\u024f \u0d9a\u0dcf\u0259\u0dba \u0d9a\u0259\u0dad\u0dc0\u0255 \u0d89\u017b \u0d9a\u0dbb\u0db1 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u0dcf \u0daf,\n\n\u201c\u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6 \u0d87\u0dc4\u0dd0\u0263\u0dba\u0dd9\u0d9c\u02a3\u0da9 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0daf,"
