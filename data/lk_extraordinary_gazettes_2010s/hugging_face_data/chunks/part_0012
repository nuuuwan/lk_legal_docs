    "chunk_text": "7. \u0d89\u0dc4\u0dad 4\u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u01e7\u00fd\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0dd1\u0db8 \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa\u0db8 \u0d9a\u0263\u01e6 \u0d85\u0dc0\u0dbd\u0d82\u011b \u0d9a\u0dbb\u01e9 \u0dd9\u0db1\u02a3\u0dbd\u0dd0\u022c\u0dc0 \u0dd9\u0dc4\u02a3\u01ae \u023d\u0dc3 \u0d92 \u0db6\u0dbd\u0db4\u01b4\u0dba \u01e7\u00fd\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u01ca\u0dd9\u01ca \u00fb\u0db1\u023c \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0da7 \u0daf \u0d91\u0db8 \u0d9a\u0dcf\u0dbd\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0daf\u0dcf\u0dc5 \u026a\u0dba \u0252\u01b1\u0dba.\n\n8. \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dba\u0da7\u0dd9\u01ae \u0db6\u0dbd\u0db4\u01b4\u0dbd\u01ae \u0dc3\u0dd1\u0db8 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u00fa\u0db8 \u0dd9\u0db8\u028f \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0dd9\u0d9a\u02a3\u01e6\u01ca\u0286\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae\u0dc0 \u0dd9\u0dc0\u0dc5\u0db3\u0dcf\u0dd9\u023c \u0dd9\u0dba\u01ce\u0dba \u0252\u01b1\u0dba.\n\n8.(2) \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dba\u0da7\u0dd9\u01ae \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0dc3\u0db7\u0dcf \u0db6\u0dbd \u021d\u0dd9\u01ca\u0dc1\u0dd9\u024f \u00fb\u0286\u0dba\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0d9a \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dd9\u0dc0\u0dc5\u0db3\u0dcf\u0db8 \u0dad\u0dc4\u0db1\u023c \u0d9a\u0dbb \u0d87\u01af \u026a\u0da7\u0d9a, \u0d9a\u0dc0\u0dbb \u0dd9\u0dc4\u02a4 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u026a\u0286\u01e6 \u0d91\u00fc\u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u02a2 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dd9\u0dc0\u0dc5\u0db3\u0dcf\u0db8 \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1 \u0d85\u0dad\u0dbb \u0db6\u0dbd\u0db4\u01b4\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d9a\u0dbd\u0dcf\u0db4\u0dd9\u024f \u0dd9\u0dc4\u02a4 \u0db8\u0dcf\u0259\u0d9c\u0dba\u01e6\u028f \u0db4\u0db8\u0dab\u00fa \u0d85\u0daf\u0dcf\u0dc5 \u0dd9\u0dc0\u0dc5\u0db3\u0dcf\u023c \u0d9a\u0dc5 \u0252\u01b1\u0dba.\n\n8.(3) \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dd9\u0dc0\u0dc5\u0db3\u0dcf\u0dd9\u023c \u0dd9\u0dba\u0dd9\u0daf\u0db1 \u0db6\u0dbd\u0db4\u01b4\u0dbd\u01ae \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u0dcf \u0dd9\u0dc4\u02a4 \u0d94\u0291 \u0dba\u0da7\u0dd9\u01ae \u0dd9\u0dc3\u02a2\u0dc0\u0dba \u0d9a\u0dbb\u0db1 \u0d9a\u0dc0\u0dbb \u0dd9\u0dc4\u02a4 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u00fa,\u0dc3\u0dca\u0db4\u0259\u0dc1\u0dd9\u0dba\u01e6 \u0dd9\u0db6\u02a4\u0dc0\u0db1 \u0dd9\u0dbb\u02a4\u0d9c\u0dba\u00fa \u0dd9\u0dc4\u02a4 \u0d8b\u0daf\u0dbb\u0dcf\u027c\u0dad \u0dd9\u0dbb\u02a4\u0d9c \u0dad\u01ae\u01ae\u0dc0\u0dba\u00fa \u0dd9\u0dc4\u02a4 \u0d91\u0dc0\u01e6 \u026d \u0dd9\u0db6\u02a4\u0dc0\u0db1 \u0dd9\u0dbb\u02a4\u0d9c \u0dad\u01ae\u01ae\u0dc0\u0dba\u00fb\u01e6 \u0dd9\u0db4\u0299 \u0286\u0179\u023d\u01e6 \u0d91\u028f \u022b\u0dd9\u0da2\u02a5\u0dc2\u0db1 \u0d9a\u0dcf\u0dbd \u0dc3\u0db8\u0dba \u0d9c\u0dad\u00fb\u025d\u0db8\u0da7 \u0db8\u01ae\u0dd9\u0dad\u01e6 \u0dd9\u0dc4\u02a4 \u0d91\u0dc0\u01e6 \u026d \u0dd9\u0dbb\u02a4\u0d9c \u0dad\u0dad\u01ae\u0dc0\u0dba\u00fa \u0dba\u0da7\u0dd9\u01ae \u0dd9\u0db4\u0dd9\u0dc5\u023d\u01e6 \u0286\u0179 \u0d85\u0dd9\u0dba\u00fd\u0da7 \u0d8b\u0dc0\u0da7\u0dd0\u01e6 \u0d9a\u0dc5 \u0d85\u0dd9\u0dba\u00fa \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0d9a\u0da7\u0252\u01b1 \u0d9a\u0dbb\u023d\u01e6 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dd9\u0dc0\u0dc5\u0db3\u0dcf\u023c \u0d9a\u0dcf\u0259\u0dba\u0dba\u01e6\u028f \u0dd9\u0db1\u02a3\u0dd9\u0dba\u01ce\u0dba \u0252\u01b1\u0dba.\n\n9. \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dba\u0da7\u0dd9\u01ae \u01e7\u00fd\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc0\u0dbd\u0d82\u011b \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0d87\u01ae\u0dd9\u01ae \u026c\u0dc0\u0daf \u0db6\u0dbd\u0db4\u01b4\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d9a\u0dbd\u0dcf\u0db4\u0dba \u0dd9\u0dc4\u02a4 \u0db8\u0dcf\u0259\u0d9c\u0dba\u01e6 \u0dd9\u0dc4\u02a4 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db6\u0dbd \u021d\u0dd9\u01ca\u0dc1\u0dba \u01b1\u0dc5 \u0dd9\u0db6\u02a4\u0dc0\u0db1 \u0dd9\u0dc4\u02a4 \u0dc0\u0dc3\u0d82\u0d9c\u0dad \u0dd9\u0dbb\u02a4\u011a \u0dad\u01ae\u01ae\u0dc0\u0dba\u00fa \u0db4\u0dd0\u01af\u0dd9\u0dbb\u0db1 \u0db6\u0dc0\u0da7 \u0dd9\u0dc4\u02a4 \u0d91\u0dc0\u01e6 \u0dd9\u0dbb\u02a4\u0d9c \u0dad\u01ae\u01ae\u0dc0\u0dba\u00fa \u0db4\u0dd0\u01af\u025d\u0dd9\u023c \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u00fa \u0db4\u0dc0\u01af\u0db1 \u0db6\u0dc0\u0da7 \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0ddb\u0dc0\u0daf\u0255 \u01e7\u0dbd\u0db0\u0dcf\u025d \u026a\u0286\u01e6 \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0d9a\u025e\u019f \u0dc0\u0dcf\u0259\u0dad\u0dcf \u0d9a\u0dbb \u0d87\u01af \u0dba\u023c \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a,\n\ni. \u0d92 \u0218\u0298\u0db6\u0db3 \u0263\u0110\u0dad \u0d9a\u025e\u019f \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb\u023d\u01e6 \u0dd9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u02a2 \u01e7\u0dba\u0db8\u0dba\u01e6 \u0dba\u0da7\u0dd9\u01ae \u01e7\u00fd\u01ae \u0d9a\u0dc5 \u00fb\u0286\u0dba\u023c \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0263\u0d9a\u0dc0 \u0d85\u01ae\u028f\u017b\u026b\u0db8\u0da7,\n\nii. \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db6\u0dbd \u021d\u0dd9\u01ca\u0dc1\u0dd9\u024f \u00fb\u0286\u0dba\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0d9a \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dd9\u0dc0\u0dc5\u0db3\u0dcf\u0db8 \u0dad\u0dc4\u0db1\u023c \u00fb\u025d\u0db8\u0da7,\n\niii. \u0d89\u0dc4\u0dad 9.(i) \u0d85\u01e9 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0263\u0d9a\u0dc0 \u0d85\u01ae\u028f\u0da7\u0dc0\u0db1 \u0dbd\u0dd0\u022c \u0db6\u0dbd\u0db4\u01b4\u0dba,\u0d91\u0dd9\u0dc3\u02a2 \u0d85\u01ae\u028f\u0da7\u0dc0\u0db1 \u0dbd\u0dd0\u022d \u0d9a\u0dcf\u0dbd\u0dba \u0d87\u01b1\u0dc5\u0dad \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf\u0dd9\u0118 \u0db7\u0dcf\u0dbb\u0dba\u0da7 \u0d9c\u0dd0\u01e8\u0db8\u0da7, \u0dc3\u0dc4\n\niv. \u0db6\u0dbd\u0db4\u01b4\u0dba \u0d85\u01ae\u028f\u0da7\u026b\u0db8\u00fa \u0286\u01d0 \u0d9a\u0dbb\u01e9 \u0dd9\u0db1\u02a3\u0dbd\u0dd0\u022c\u0dd9\u01e6 \u0db1\u023c \u0d91\u00fc \u0db6\u0dbd\u0db4\u01b4\u0dd9\u024f \u0dc0\u0dbd\u0d82\u011b \u0d9a\u0dcf\u0dbd\u0dba \u0d89\u00fd\u01ae \u026b\u0db8\u0da7 \u01e7\u0dba\u023d\u0dad \u01ce\u0db1\u0da7 \u0dd9\u0db4\u0dbb \u0d91\u00fc \u0dd9\u0dbb\u02a4\u0d9c \u0db4\u0dd0\u01af\u025d\u0dd9\u023c \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8 \u0d85\u0dc0\u0dc3\u01e6 \u026b\u0d87\u01af \u0db6\u0dc0 \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0ddb\u0dc0\u0daf\u0255 \u01e7\u0dbd\u0db0\u0dcf\u025d \u026a\u0286\u01e6 \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u0dd9\u0dc0\u0dad \u0d9a\u025e\u019f \u0dc0\u0dcf\u0259\u0dad\u0dcf \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0db6 \u0d87\u01ae\u0db1\u023c \u0d85\u01ae\u028f\u0da7\u0dc0\u0db1 \u0dbd\u0dd0\u022d \u0db6\u0dbd\u0db4\u01b4\u0dba \u021d\u01af\u0dc3\u0dcf\u0db0\u0db1\u0dba \u00fb\u025d\u0db8\u0da7\u01ae \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0db6\u0dbd\u0dba \u01af\u022a\u0dba \u0252\u01b1\u0dba.\n\nv. \u0d89\u0dc4\u0dad 9.(ii) \u0dc0\u0db1 \u0d85\u01e9 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db6\u0dbd\u021d\u0dd9\u01ca\u0dc1\u0dd9\u024f \u00fb\u0286\u0dba\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0d9a \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dd9\u0dc0\u0dc5\u0db3\u0dcf\u0db8 \u0dad\u0dc4\u0db1\u023c \u00fb\u025d\u0db8\u0da7 \u0dd9\u0dc4\u02a2\u01b1 \u026d \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8 \u0d85\u0dc0\u0dc3\u01e6 \u026b \u0d87\u01af \u0db6\u0dc0 \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0ddb\u0dc0\u0daf\u0255 \u01e7\u0dbd\u0db0\u0dcf\u025d \u026a\u0286\u01e6 \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0d9a\u025e\u019f \u0dc0\u0dcf\u0259\u0dad\u0dcf \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0db6 \u0d87\u01ae\u0db1\u023c \u0d91\u00fc \u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u02a2 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dd9\u0dc0\u0dc5\u0db3\u0dcf\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dd0\u0dc0\u0dad \u0d85\u0dc0\u0dc3\u0dbb \u0dd9\u0daf\u01e9 \u0dbd\u0db6\u0db1 \u0db6\u0dc0 \u0db6\u0dbd\u0db4\u01b4\u0dbd\u0dcf\u0235\u01e6\u0da7 \u0daf\u0dd0\u01e6\u026b\u0db8 \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf\u0dd9\u0118 \u0d9a\u0dcf\u0259\u0dba\u0dba \u026a\u0dba \u0252\u01b1\u0dba.\n\n10. \u0d89\u0dc4\u0dad 9 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u00fb\u0286\u0dba\u023c \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0263\u0d9a\u0dc0 \u0d85\u01ae\u028f\u017b\u026b\u0db8 \u0dd9\u0dc4\u02a2\u01b1\u0dd9\u0dc0\u01e6 \u0db6\u0dbd\u0db4\u01b4\u0dbd\u0dcf\u0234\u0dba\u0dcf\u0da7 \u0286\u01d0\u0dc0\u0db1 \u0dba\u023c \u0db4\u0dcf\u018d\u0dc0\u00fa \u0dd9\u0dc4\u02a4 \u0dc4\u0dcf\u01e7\u0dba\u00fa \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0, \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf, \u0db6\u0dbd\u0dba\u0dbd\u01ae \u01e7\u0dbd\u0db0\u0dcf\u025d\u0dba\u0dcf \u0dd9\u0dc4\u02a4 \u0dc0\u0d9c\u00fc\u0db8\u0da7 \u0dba\u0da7\u01ae \u0dd9\u0db1\u02a3\u0dc0\u0db1 \u0d87\u0dad."
