e \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd\n\n\u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u1fa6\u0bae\u0bcd \u0b85\u0bb5\u0bb1\u0bcd\u0bb1\u0bbf\u0ba9\u0bcd\n\n\u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u1fa6\u0bae\u0bcd\n\n\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0b95\u0baa\u0bcd\n\n\u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bb0\u0bcd\u0bb5\u0bbe\u0b95\n\n\u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0b95\u0bb3\u0bcd\n\n\u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u1f8c\u0b95\u0bb3\u0bcd\n\n\u0ba8\u0bc8\u0b9f\u1f99\u0bc8\u0bb1\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\n\n\u0baa\u1f8c\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\n\n\u0baa\u0bb2\u0bbe\u0b99\u0bcd\u0bc6\u0b95\u0bbe\u0bc8\u0b9f (\u0bc6\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf)\n\n\u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1-\u0bc6\u0bb5\u1fa2\u0bc7\u0b95\u0bc6\u0baa\u0bbe\u0bb2 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd 240-C \u0baa\u0bb0\u0b95\u0bb9\u0bae\u1f8a\u0ba4\u0bcd\u0ba4, 240-A \u0b87\u1fa4\u0b95\u0bcd\u0b95\u0bc1\u1f97\u0bb0, 240 \u0baa\u0ba9\u0bbe\u0ba9, 240-B \u0b95\u0bb2\u0bcd\u0bc6\u0b95\u0bbe\u0b9f\u0b95\u0bae, 239-A \u0bc7\u0b95\u0bbe\u0ba9\u0bcd\u0b95\u0bb8\u0bcd\u0bc6\u0ba4\u0ba9\u0bcd\u0ba9, 247-A \u0b89\u0b9f\u0b95\u0b99\u0bcd\u0bc6\u0b95\u0bbe\u0bc8\u0b9f, 247 \u0bc6\u0baa\u1fa2\u0bae\u0bbe\u1fa2\u0baf\u0ba4\u0bcd\u0ba4, 249 \u0bb9\u0ba4\u0b95\u0bbf\u0bbe\u0bbf\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 249-A \u0bb9\u0ba4\u0b95\u0bbf\u0bbe\u0bbf\u0bc6\u0b95\u0bbe\u0bc8\u0b9f \u0bc7\u0baa\u0bbe\u0ba9\u0bcd\u0bb1 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0baf\u0bbe\u0b95\u1fab\u0bae\u0bcd, \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 - \u0b87\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u1f97\u0bbe\u0bbf \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd 165-B \u0b85\u1fa6\u0bc6\u0baa\u0bbe\u0bb2, 164-E \u0baa\u0bb2\u0bc6\u0b95\u0bbe\u1f8c\u0ba9\u0bcd\u0ba9 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 164-B \u0b95\u0bc1\u1f9e\u0bc6\u0baa\u0bb5\u0bcd\u0bb2\u0bbe\u0b95\u0bae \u0bc7\u0baa\u0bbe\u0ba9\u0bcd\u0bb1 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0baf\u0bbe\u0b95\u1fab\u0bae\u0bcd, \u0b93\u0baa\u0ba8\u0bbe\u0baf\u0b95 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd 244 \u0bc6\u0baa\u0bbe\u0bb2\u0bcd\u0bb5\u0ba4\u0bcd\u0bc7\u0ba4\u0bc7\u0bb9\u0ba9, 244-C \u0bc6\u0bae\u1f8a\u0bb9\u0b95\u0bcd\u0bb5\u0bb2, 244-B \u0bae\u0bb2\u0bcd\u0bae\u0bc0\u0b95\u0ba9\u0bcd\u0ba8\u0bcd\u0ba4, 245-A \u0bae\u0bc0\u0b95\u0bb9\u0bc6\u0bb5\u0bb2, 245-B \u0bc6\u0b95\u0ba9\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b95\u1f8a\u0baf, 246 \u0bae\u0bbe\u0bc6\u0ba4\u0bbe\u0bb2 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 246-A \u0b89\u0b9f\u0bc6\u0bb5\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0b95\u0bb3\u0bbe\u0b95 \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3\u1f90.\n\n2019.05.07\n\n\u0b87\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u1f97\u0bbe\u0bbf \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd (\u0bc6\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf)\n\n22A\n\nI \u0dd9\u0d9a\u0ddc\u0da7\u0dc3:(I) \u0dd9\u0da1\u0dca\u0daf\u0dba - \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba - 2019.10.29"
