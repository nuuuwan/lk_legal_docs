    "chunk_text": "5.(17) \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dd9\u024f \u0dd9\u0dc3\u02a2\u0dc0\u0d9a\u0dba\u01e6\u0da7 \u01e7\u0daf\u0dcf\u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0dd9\u0dc0\u01e6\u0d9a\u0dc5 \u01e7\u0daf\u0db1 \u0d9a\u0dcf\u0db8\u0dbb\u0dc0\u0dbd \u0d91\u00fa \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u00fd\u0da7 \u01e7\u0daf\u0dcf\u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0dd9\u0dc0\u01e6\u0d9a\u0dc5 \u0d89\u0da9 \u021d\u0db8\u0dcf\u0dab\u0dba \u0d85\u0dc0\u0db8 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0dc0\u0259\u0d9c \u023e\u0da7\u0259 4 \u0d9a\u0da7 \u0dd9\u0db1\u02a3\u0d85\u018d \u026a\u0dba\u0252\u01b1\u0dba.\n\n5.(18) \u0dd9\u0dc3\u02a2\u0dc0\u0d9a\u0dba\u01e6\u0dd9\u0118 \u0db4\u0dcf\u026a\u013c\u013d\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dca\u01b6 \u0dc4\u0dcf \u021a\u025e\u0dc2 \u0dd9\u0daf\u0db4\u00fa\u0dc2\u0dba\u0da7 \u021d\u0db8\u0dcf\u0dab\u0dc0\u01ae \u0dc0\u0dd0\u0286\u00fb\u0298 \u0dc4\u0dcf \u0d9a\u0dd0\u0286\u00fb\u0298 \u0dc3\u0db4\u0dba\u0dcf \u01af\u022a\u0dba \u0252\u01b1\u0dba.\n\n5.(19) \u0dc0\u0255\u0dcf\u0db4\u0dcf\u0dbb \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0db8\u0dad \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dd9\u024f \u0dd9\u0dc3\u02a2\u0dc0\u0dd9\u024f \u01e7\u0252\u00fa\u0dad \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u01e6\u0dd9\u0118 \u0db4\u0dcf\u026a\u013c\u013d\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dcf\u0db1 \u0d9a\u0dcf\u0db8\u0dbb \u021d\u0db8\u0dcf\u0dab\u0dc0\u01ae \u0dc3\u0d82\u0d9b\u0255\u0dcf\u0dc0\u00fa\n\n5.(20) \u0dc3\u0db4\u0dba\u0dcf \u0d87\u01af \u0dc3\u0dd1\u0db8 \u0dc0\u0dd0\u0286\u00fb\u0298\u0dba\u00fa, \u0d9a\u0dd0\u0286\u00fb\u0298\u0dba\u00fa \u0dc4\u0dcf \u0db1\u0dcf\u0db1 \u0d9a\u0dcf\u0db8\u0dbb\u0dba\u00fa \u0db8 \u0dc3\u0dca\u01c2\u0dbb \u0d89\u01ce\u00fb\u025d\u023c \u01d6\u0dc0\u0255\u0dba\u00fb\u01e6 \u0db8\u0db1\u0dcf \u0dd9\u0dbd\u0dc3 \u0d89\u01ce\u0d9a\u0dbb \u01af\u022a\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb \u0d91\u028f \u0d85\u0db7\u0255\u01e6\u0dad\u0dbb \u0dd9\u0db4\u02a3\u0dd9\u0dbd\u02a3\u0dc0 \u0263\u0dc3\u0dca\u0dc3\u0dcf \u0dd9\u0db1\u02a3\u0dba\u0db1 \u0db4\u025c\u01ce \u0d89\u01ce\u0d9a\u0dbb \u0dba\u0dc4\u0db4\u01ae \u0dad\u01ae\u01ae\u0dc0\u0dd9\u0dba\u01e6 \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1 \u0dba\u0dcf \u0252\u01b1\u0dba.\n\n5.(21) \u0d85\u0db4\u0da2\u0dbd\u0dba, \u0dc3\u0dc4 \u0db8\u0dc5 \u0d85\u0db4\u01d6\u0dc0\u0255 \u0d85\u0dc0\u0dc1\u0255 \u0db6\u0dd1\u026c\u0db8 \u0dc3\u028f\u0dad\u0dc0 \u0d85\u0db4\u01d6\u0dc0\u0255 \u0dbb\u0db3\u0dcf \u0dd9\u0db1\u02a3\u0286\u0179\u0db1 \u0db4\u025c\u01ce \u0d89\u01ce\u0d9a\u0dc5 \u0dc3\u0d82\u0dc0\u0dd8\u0dad \u0d9a\u0dcf\u019f \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u0288\u01d0\u0288 \u0d89\u01ce\u00fb\u025d\u023c \u01d6\u0dc0\u0255\u0dba\u00fb\u01e6 \u01e7\u0db8 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u01e9\u0db8\u0dad \u0100\u0db8\u0dd9\u0269\u0daf\u0dba\u00fa \u0db8\u0135\u01e6 \u021b\u01af\u0d9a \u0dc0\u0dc5\u0dc0\u0262 \u0dc4\u0dcf \u0d8b\u0dbb\u0dcf\u0d9c\u0dd0\u01e8\u0dd9\u023c \u0dc0\u0dc5\u0dc0\u0262 \u0dd9\u0dc4\u02a4 \u0db8\u0db0\u0255 \u021d\u01af\u0d9a\u0dcf\u0dbb \u0d92\u0d9a\u0d9a\u0dba\u0d9a\u0da7 \u0dd9\u0dba\u02a3\u023f \u0d9a\u0dbb \u01af\u022a\u0dba \u0252\u01b1\u0dba. \u0d91\u0dd9\u0dc3\u02a2\u0db8 \u0db4\u025c\u0279\u0dba \u0dc3\u0dc4 \u0d85\u0dc0\u0dc3\u01e6 \u0db6\u0dd0\u0dc4\u0dd0\u0dbb\u0264\u0db8 \u0d85\u0dad\u0dbb \u01d1\u0dc4\u0db1\u0dba \u0dc0\u0dd0\u0dc5\u0dd0\u00fa\u026b\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0da2\u0dbd \u0d8b\u011b\u0dbd\u00fa \u0dd9\u0dc4\u02a4 \u0d85\u01e9\u0db8\u0dad \u0288\u01d0\u0288 \u0100\u0db8\u0dd9\u0269\u0daf\u0dba\u00fa \u0db7\u0dcf\u026a\u0dad\u0dcf \u0d9a\u0dbb \u01af\u022a\u0dba \u0252\u01b1\u0dba.\n\n(i) \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0100\u0db8\u0dd9\u0269\u0daf\u0dba\u0da7 \u023d\u0dc3, \u0d85\u0db4\u0da2\u0dbd\u0dba \u0dc4\u0dcf \u0db8\u0dc5 \u0d85\u0db4\u01d6\u0dc0\u0255 \u00fb\u0286\u0dba\u023c \u0dd9\u0db4\u02a3\u01d0 \u0da2\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dba\u0d9a\u0da7, \u0d9a\u0dcf\u019f\u0dc0\u0d9a\u0da7, \u026a\u0dc0\u0dd8\u0dad\n\n\u0237\u023d\u0dba\u0d9a\u0da7 \u0d9c\u0dbd\u0dcf\u0dba\u0dcf\u0db8 \u0dc0\u0dd0\u0dc5\u0dd0\u00fa\u026b\u0db8\u0da7 \u021d\u0db8\u0dcf\u0dab\u0dc0\u01ae \u0218\u0dba\u0dc0\u0dbb \u0dd9\u0d9c\u0db1 \u01af\u022a\u0dba \u0252\u01b1\u0dba.\n\n(ii) \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0d85\u0db4\u0da2\u0dbd\u0dba,\u0db8\u0dc5 \u0d85\u0db4\u01d6\u0dc0\u0255 \u0d9c\u0dbd\u0dcf \u0dba\u0dcf\u0db8\u0da7 \u0dc3\u0dbd\u0dc3\u0dca\u0dc0\u0db1 \u0dbd\u0daf \u021b\u01af\u0d9a \u0dc0\u0dc5 \u0dc4\u0dcf \u0d8b\u0dbb\u0dcf \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0dc0\u0dc5 \u0dc0\u0dcf\u0dad\u0dba\u0da7\n\n\u01e7\u0dbb\u0dcf\u0dc0\u0dbb\u0dab\u0dba \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1 \u0d85\u0dad\u0dbb \u0d91\u0db8 \u0d8b\u0dbb\u0dcf \u0d9c\u01e6\u0db1\u0dcf \u0dc0\u0dd9\u0dc5\u01e6 \u0237\u0d9c\u0dad \u0da2\u0dbd\u0dba \u01d1\u0dc2\u0dab\u0dba \u0dd9\u0db1\u02a3\u026a\u0dba \u0252\u01b1\u0dba.\n\n(iiii) \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0d85\u0db4\u0da2\u0dbd\u0dba,\u0db8\u0dc5 \u0d85\u0db4\u01d6\u0dc0\u0255 \u0d9c\u0dbd\u0dcf \u0dba\u0dcf\u0db8\u0da7 \u0dc3\u0dbd\u0dc3\u0dca\u0dc0\u0db1 \u0dbd\u0daf \u021b\u01af\u0d9a\u0dc0\u0dc5 \u0d85\u01e9\u0db8\u0dad \u021d\u023d\u01af\u0dba\u0da7 \u0d89\u01ce\u0d9a\u0dbb \u01af\u022a\u0dba \u0252\u01b1\u0dba.\n\n(iv) \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0d8b\u0dbb\u0dcf\u0d9c\u0dd0\u01e8\u0dd9\u023c \u0dc0\u0dc5 \u00fb\u0286\u0dba\u023c \u0da2\u0dbd \u0240\u0dbd\u0dcf\u0279\u0dba\u0d9a \u0286\u0da7 \u0d85\u0dc0\u0db8 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u023e\u0da7\u0259 15.25 \u0d9a \u01d0\u0dbb\u00fb\u01e6 \u0d89\u01ce\u0d9a\u0dbb\n\n\u01af\u022a\u0dba \u0252\u01b1\u0dba.\n\n(v) \u0dba\u023c \u01e7\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0101\u0dba\u0dcf\u0dc0\u0263\u0dba\u00fa \u0db8\u0135\u01e6 \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u0dba\u023c \u0dd9\u0dc4\u02a2\u01b1\u0dc0\u00fb\u01e6 \u0da2\u0db1\u0db1\u0dba\u0dc0\u0db1 \u0dbb\u0dc3\u0dcf\u0dba\u01e7\u0d9a \u0d85\u0db4\u0da2\u0dbd\u0dba \u0dd9\u0269 \u0db1\u023c \u0d92\n\n\u0dc3\u023c\u0db6\u01e6\u0db0 \u0d85\u01dd\u0d9a\u0dcf\u0dbb\u0dba\u00fa \u0dd9\u0dc4\u02a4 \u0d85\u0d82\u0dc1 \u026a\u0286\u01e6 \u01e7\u0dba\u0db8 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0100\u0db8\u0dd9\u0269\u0daf\u0dba\u0d9a\u0da7 \u0db6\u0dd0\u0dc4\u0dd0\u0dbb \u0d9a\u0dc5 \u0252\u01b1\u0dba.\n\n5.(22) \u0db4\u025c\u0279\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0da2\u0dbd \u0dc3\u0dd0\u0db4\u0252\u023c \u0dc3\u0dc4 \u0d9c\u0db6\u0da9\u0dcf \u00fb\u025d\u023c \u0db4\u0dc4\u0288\u0d9a\u023c \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0db4\u025c\u01ce \u026a\u0dba \u0252\u01b1\u0dba.\n\n(i) \u0d91\u0db8 \u0db4\u025c\u0279\u0dc0\u0dbd \u0db4\u0dcf\u01e8\u0dba \u0da2\u0dbd\u0dba \u021d\u0db8\u0dcf\u0dab\u0dc0\u01ae \u0db4\u025c\u01ce \u0dc3\u0db4\u0dba\u0dcf \u01af\u022a\u0dba \u0252\u01b1\u0dba. \u0da2\u0dbd\u0dba \u0218\u025c\u0286\u01d0 \u0db7\u0dcf\u0da2\u0db1\u0dc0\u0dbd \u025a\u0dc3\u0dca\u0d9a\u0dbb \u0dad\u0dd0\u022a\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb\n\n\u0d91\u0db8 \u0db7\u0dcf\u0da2\u0db1 \u0d85\u0db1\u01b1\u025e\u0daf\u0dcf\u0dba\u0d9a \u01d6\u0dc0\u0255\u0dc0\u0263\u01e6 \u0dc3\u0dc4 \u01d1\u0dc4\u0db1 \u01d6\u0dc0\u0255\u0dc0\u0263\u01e6 \u0dd9\u0dad\u02a3\u0dbb\u0dc0 \u01af\u022a\u0dba \u0252\u01b1\u0dba.\n\n(ii) \u0dd9\u0dc0\u0db1\u01ae \u0dc3\u0db8\u0dcf\u0db1 \u0d9a\u0dcf\u0259\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0db7\u0dcf\u026a\u0dad \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0db4\u0dcf\u01e8\u0dba \u0dd9\u0db1\u02a3\u0dc0\u0db1 \u0da2\u0dbd\u0dba \u0dd9\u0dc0\u01e6 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u026d \u0db1\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dc0\u0263\u01e6\n\n\u025a\u0dd9\u0d9c\u0db1 \u0dba\u0dcf \u0252\u01b1 \u0d85\u0dad\u0dbb \u0d92\u0dc0\u0dcf \u0dc0\u0259\u0dab\u0dba\u00fb\u01e6 \u0dc4\u01ff\u0db1\u0dcf\u0d9c\u0dad \u0dc4\u0dd0\u00fb \u026a\u0dba \u0252\u01b1\u0dba. \u0dad\u0dc0 \u0daf, \u0d91\u00fc \u0da2\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dc0\u0263\u01e6 \u0db4\u0dcf\u01e8\u0dba \u0da2\u0dbd\u0dba \u025a\u0dd9\u0d9c\u0db1 \u0dba\u0db1 \u0db1\u0dbd \u0dc3\u0db8\u0d9f \u0dc4\u0dbb\u0dc3\u0dca \u01d1\u0dc4\u0db1\u0dba\u026b\u0dd9\u023c \u0dd9\u0dc4\u02a4 \u0d86\u0218\u0da7 \u0d85\u0db4\u0d9c\u0db8\u0db1\u0dba\u026b\u0dd9\u023c \u0dc4\u0dd0\u00fb\u0dba\u0dcf\u0dc0\u00fa \u0dd9\u0db1\u02a3\u01af\u022a\u0dba \u0252\u01b1\u0dba.\n\n6. \u0db6\u0dbd\u0db4\u01b4\u0dbd\u0dcf\u0235 \u0dc3\u0dd1\u0db8 \u0db4\u025c\u0279\u0dba\u0d9a\u0da7\u0db8 \u0d85\u0daf\u0dcf\u0dc5\u0dc0 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0dd9\u0d9a\u02a3\u01e6\u0dd9\u01ca\u0286\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae\u0dc0 \u0db4\u025c\u0279\u0dba \u0db4\u0dc0\u01ae\u0dc0\u0dcf \u0d9c\u0dad \u0252\u01b1\u0dba.\n\n6.(1) \u021d\u0dae\u0db8\u0dcf\u0db0\u0dcf\u0dbb \u0dc3\u0db3\u0dc4\u0dcf \u021a\u0291\u019f \u0dd9\u0dc3\u02a2\u0dc0\u0d9a\u0dba\u01e6 \u0286\u0179\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb \u021d\u0dae\u0db8\u0dcf\u0db0\u0dcf\u0dbb \u0db4\u0dc4\u0288\u0d9a\u023c \u0dc3\u0db4\u0dba\u0dcf \u01af\u022a\u0dba \u0252\u01b1\u0dba.\n\n6.(2) \u0db4\u025c\u0279\u0dd9\u024f \u0dd9\u0dc3\u02a2\u0dc0\u0d9a\u0dba\u01e6 \u0288\u01d0\u0288 \u0dbb\u00fa\u0dc2\u0dab\u0dba\u00fa \u0dba\u0da7\u0dd9\u01ae \u0dbb\u00fa\u0dc2\u0dab\u0dba \u0d9a\u0dbb \u01af\u022a\u0dba \u0252\u01b1\u0dba."
