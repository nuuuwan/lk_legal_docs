    "date_str": "2019-12-05",
    "description": "Sabaragamuwa  Provincial Council   -  By-Laws of  Nivithigala  Pradeshiya Sabha",
    "url_metadata": "https://documents.gov.lk/view/extra-gazettes/egz_2019.html",
    "lang": "en",
    "url_pdf": "https://documents.gov.lk/view/extra-gazettes/2019/12/2152-40_E.pdf",
