1\u0dbb\u0da2\u0dd9\u0016 \u0d85\u0018 \u0019\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3 \u0db4 \u0dba - 2019.05.29\n\n\u0baa\u1f81\u0ba4\u0bbf III \u2014 \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u1fba \u0baa\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf\u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 - 2019.05.29\n\n\u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0b85\u0bb0\u0b9a\u0bbe\u1fb1\u0b95 \u0b85\u1fb2\u1f86\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0ba4\u0bbf\u1fba\u0baa\u0bbf\u1fb0\u0b95\u1fba\u0bc6\u0baa\u1fbe\u0bb1\u1f90.\n\n\u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3 \u0bc6\u0baa\u1f9e\u1fbb\u0baa\u0bbe\u0b95\u1fb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fbb \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u1faa\u1f8c \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u1fb9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb2 \u0baa\u0ba4\u0bbf\u1fab\n\n\u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b9a\u0bbe\u1fbd\u1fb8\u0ba4 \u0baa\u0b9f \u0b87\u0bb2. \u0b87\u0bb2. \u0baa\u0bb0\u1fba\u0baa\u0bb3\u1fab \u0b9a\u0bbe\u1fb9\u0bb1\u0bbf\u0ba4\u1fc1 \u0b85\u1fa4\u0bb5\u0bb2\u0b95\u1fbb\n\n(\u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u1fbd) \u0b87\u0bb2.\n\n\u0bc6\u0bb5\u1fa2\u0bc6\u0b95\u0bc6\u0baa\u0bbe\u0bb2 \u0bae\u0b9f\u0bb5\u0bb2\u0bb2\u1fb8\u0ba4 620214 \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2.01 0.2793 0039313 \u0b87\u0bb0\u1fb7\u0ba4\u0bbf\u0ba9\u1f97\u0bbe\u0bbf\n\n\u0b95\u0bbe.\u1f90.\u0b87\u0bb2.83\n\n\u0bc6\u0bb5\u1fa2\u0bc6\u0b95\u0bc6\u0baa\u0bbe\u0bb2 \u0bae\u0b9f\u0bb5\u0bb2\u0bb2\u1fb8\u0ba4 620214 \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2.01 1.3009 0039314 \u0b87\u0bb0\u1fb7\u0ba4\u0bbf\u0ba9\u1f97\u0bbe\u0bbf\n\n\u0b95\u0bbe.\u1f90.\u0b87\u0bb2.148\n\n\u1f99. \u1f81:- \u0bae\u0bb0\u0ba3\u0b9a\u0bbe\u0ba4\u0ba9\u0bae\u0bbf\u1fbf\u0bb2\u0bbe\