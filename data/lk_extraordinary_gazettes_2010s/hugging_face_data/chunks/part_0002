a\u0dcf\u0d9c\u0db8\u0dd9\u0dc4\u02a2\u01e6\u0dba\u0dcf\u0dba/ \u0db6\u0dbd\u0d9c\u0262\u0dbd\u0dc0\u01ae\u0dad - \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dc3\u0db8\u0dbb\u0dd9\u0d9a\u02a4\u01e6 \u01ce\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dbd\u0dcf\u0dd9\u0118 \u0dc3\u0dbb\u01ae \u011b\u0dab\u01b1\u0d82\u0d9c \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0dbb 0.0374\n\n\u0d8b\u01b1\u0dbb\u0da7 : \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 37 \u0dc3\u0dc4 14; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 15,17 \u0dc3\u0dc4 31; \u0daf\u00fd\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 31; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 35 \u0dc3\u0dc4 37\n\n31. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 37 - \u0d9c\u0dbd - \u0d9a\u029a\u0dd9\u0dc4\u02a2\u0db1\u0dba\u0dcf\u0d9c\u0db8\u0dd9\u0dc4\u02a2\u01e6\u0dba\u0dcf\u0dba/ \u0db6\u0dbd\u0d9c\u0262\u0dbd\u0dc0\u01ae\u0dad - \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba : \u0dbb\u0da2\u0dba; \u0dc3\u0db8\u0dbb\u0dd9\u0d9a\u02a4\u01e6 \u01ce\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dbd\u0dcf\u0dd9\u0118 \u0dc3\u0dbb\u01ae \u011b\u0dab\u01b1\u0d82\u0d9c \u021d\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0dbb 0.1170\n\n\u0d8b\u01b1\u0dbb\u0da7 : \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 12 \u0dc3\u0dc4 14; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: 15 \u0dc3\u0dc4 36; \u0daf\u00fd\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 36 \u0dc3\u0dc4 35; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 35 \u0dc3\u0dc4 38\n\n32. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 38 - \u0dc0\u01ae\u0dad - \u0d9a\u029a\u0dd9\u0dc4\u02a2\u0db1\u0dba\u0dcf\u0d9c\u0db8\u0dd9\u0dc4\u02a2\u01e6\u0dba\u0dcf\u0dba/ \u0db6\u0dbd\u0d9c\u0262\u0dbd\u0dc0\u01ae\u0dad - \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dc3\u0db8\u0dbb\u0dd9\u0d9a\u02a4\u01e6 \u01ce\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dbd\u0dcf\u0dd9\u0118 \u0dc3\u0dbb\u01ae \u011b\u0dab\u01b1\u0d82\u0d9c \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0dbb 0.0219\n\n\u0d8b\u01b1\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 12816; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 12,14 \u0dc3\u0dc4 37; \u0daf\u00fd\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 37 \u0dc3\u0dc4 35; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 35 \u0dc3\u0dc412816\n\n33. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 39 - \u0dc0\u01ae\u0dad - \u0d9a\u029a\u0dd9\u0dc4\u02a2\u0db1\u0dba\u0dcf\u0d9c\u0db8\u0dd9\u0dc4\u02a2\u01e6\u0dba\u0dcf\u0dba - \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba : \u0da2\u0dba\u0286\u0d82\u0dc4 \u0d86\u0dbb\u013c\u013d\u0dbd\u0dcf\u0dd9\u0118 \u021d\u0dc3\u0d82\u0d9c \u0da0\u023d\u01ae \u0da2\u0dba\u0286\u0d82\u0dc4, \u0dc3\u023c\u0db4\u01ae \u0dc0\u018d\u0dd9\u0118 \u0dd9\u0da9\u0262\u026a\u01e6 \u01e7\u0dd9\u0dbb\u02a4\u0dc2\u0dcf, \u0dd9\u0dc4\u0178\u0179 \u0d86\u0dbb\u013c\u013d\u0dd9\u0118 \u021d\u01af\u0db8\u0dcf \u01af\u0dd9\u0dc3\u02a2\u0dbb\u0dcf \u021d\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0dbb 0.0031\n\n\u0d8b\u01b1\u0dbb\u0da7 : \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 5; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: 5 \u0dc3\u0dc4 12 ; \u0daf\u00fd\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 12816; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 8 \u0dc3\u0dc4 5"
