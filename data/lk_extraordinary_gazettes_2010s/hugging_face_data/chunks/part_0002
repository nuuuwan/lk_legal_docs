90\u0ba3\u0bcd\u1f8c Ap \u1f9c\u0bae\u0bcd, Ar \u0b89\u0bae\u0bcd; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Ar \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f9d.\u0b9c\u0bc0.\u0b9f\u0baa\u0bcd.\u0bc7\u0b9c. \u0ba4\u0bb0\u0bcd\u0bae\u0bc7\u0b9a\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc7\u0bb2\u0baf\u0bbe\u0baf; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1f9d.\u0b9c\u0bc0.\u0b9f\u0baa\u0bcd.\u0bc7\u0b9c. \u0ba4\u0bb0\u0bcd\u0bae\u0bc7\u0b9a\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc7\u0bb2\u0baf\u0bbe\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b8f.\u0b9c\u0bc0.\u0b9c\u0bc0.\u0baa\u0bc0. \u0bae\u1f90\u0b9a\u0b99\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc7\u0bb2\u0baf\u0bbe\u0baf.\n\n42. \u1f90\u0ba3\u0bcd\u1f8c Ar \u2013 \u0ba4\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc7\u0bb2\u0baf\u0bbe\u0baf - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.1201 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Aq, Ap, Ao, An, Am \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b9f\u0baa\u0bcd.\u0baa\u0bbf.\u0b9f\u0baa\u0bcd.\u0b8e\u0bae\u0bcd.\u0b86\u0bb0\u0bcd.\u0b8e\u0bb8\u0bcd.\u0b8f. \u0b85\u1fa6\u0bb5\u0bbf\u0b95\u0bbe\u0bc7\u0bb0 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc7\u0bb2\u0baf\u0bbe\u0baf; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f9d.\u0b9c\u0bc0.\u0b9f\u0baa\u0bcd.\u0bc7\u0b9c. \u0ba4\u0bb0\u0bcd\u0bae\u0bc7\u0b9a\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc7\u0bb2\u0baf\u0bbe\u0baf, \u1f9d.\u0b9c\u0bc0. \u0ba4\u0bb0\u0bcd\u0bae\u0bc7\u0b9a\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc7\u0bb2\u0baf\u0bbe\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c As; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c As \u0b89\u0bae\u0bcd, At \u1f9c\u0bae\u0bcd; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c At, \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u1faa\u0ba4\u0bbf, \u1f9d.\u0b9c\u0bc0.\u0b9a\u0bc0.\u0bc7\u0b95. \u0ba4\u0bb0\u0bcd\u0bae\u0bc7\u0b9a\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc7\u0bb2\u0baf\u0bbe\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b8f.\u0b9c\u0bc0.\u0b9c\u0bc0.\u0baa\u0bc0. \u0bae\u1f90\u0b9a\u0b99\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc7\u0bb2\u0baf\u0bbe\u0baf.\n\n43. \u1f90\u0ba3\u0bcd\u1f8c As \u2013 \u0ba4\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc7\u0bb2\u0baf\u0bbe\u0baf - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0811 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u1f90\u0ba3\u0bcd\u1f8c Ar \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f9d.\u0b9c\u0bc0.\u0b9a\u0bc0.\u0bc7\u0b95. \u0ba4\u0bb0\u0bcd\u0bae\u0bc7\u0b9a\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc7\u0bb2\u0baf\u0bbe\u0baf; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1f9d.\u0b9c\u0bc0. \u0ba4\u0bb0\u0bcd\u0bae\u0bc7\u0b9a\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0bae\u0bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc7\u0bb2\u0baf\u0bbe\u0baf; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u1faa\u0ba4\u0bbf