    "chunk_text": "8.(5) \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 6(3) \u0dc3\u0dc4 6(4) \u0dc0\u0d9c\u01e6\u01af \u0dba\u0da7\u0dd9\u01ae \u0db4\u0dd0\u0dc0\u01af\u0dba \u0252\u01b1 \u01d0\u0dbb \u0287\u0db8\u0dcf\u0dc0\u01e6 \u0dc0\u0255\u0dcf\u0db4\u0dcf\u0dbb\u0dd9\u024f \u0d9a\u0259\u0db8\u0dcf\u01e6\u0dad\u0dba \u0db4\u0dd0\u0dc0\u0dd9\u0dad\u023d\u01e6 \u01af\u022a\u0dba \u01cf \u0db6\u0dbd\u0db4\u01b4\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0263\u01ae \u0dc0\u0259\u0dc2\u0dba \u01b1\u0dc5 \u0d86\u0dc3\u01e6\u0db1 \u0d85\u0d9c\u0dba\u0d9a\u0da7 \u0db4\u01ae\u026b \u0d87\u01af \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a.\n\n8.(6) \u0d9a\u0259\u0db8\u0dcf\u01e6\u0dad\u0dba \u0dd9\u0dc4\u02a2\u01b1\u0dd9\u0dc0\u01e6 \u0db8\u0dc4\u0da2\u0db1 \u0219\u0da9\u0dcf\u0dc0\u00fa \u0286\u01d0\u0dc0\u0db1 \u0db6\u0dc0\u0da7 \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dba \u026a\u0286\u01e6 \u01b0\u01e6\u01d0\u0dc0\u00fa \u0dbd\u0db6\u0dcf \u01cf \u0d87\u01af \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a.\n\n48 A\n\nIV (\u0d85) \u0dd9\u0d9a\u02a3\u0da7\u0dc3 - \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba - 2019.12.05\n\n\u0101\u0dba\u0dcf\u00fb\u025d\u0db8 \u0db4\u0dd0\u0dc4\u0dd0\u0dbb \u0dc4\u0dd0\u0dbb \u0d87\u01af \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a, \u0d85\u0daf\u0dcf\u0dc5 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0dd9\u0dc0\u0dad \u01e7\u00fd\u01ae \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022d \u0db6\u0dbd\u0db4\u01b4\u0dba \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0d85\u0dc0\u0dbd\u0d82\u011b \u00fb\u025d\u0db8 \u01e8\u0dad\u0255\u0dcf\u01ea\u00fe\u0dbd \u026a\u0dba \u0252\u01b1\u0dba. 15. \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dba\u0da7\u0dd9\u01ae \u0dbd\u0db6\u0dcf \u0d9c\u0dad \u0252\u01b1 \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fb\u01e6 \u0dd9\u0dad\u02a3\u0dbb\u0dc0 \u0db4\u025c\u0279\u0dba\u00fa \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0db8 \u0dd9\u0dc4\u02a4 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dc0\u0dbb \u0dd9\u0dc4\u02a4 \u01e7\u0dba\u0db8\u0dba\u00fa \u0d8b\u0262\u0dbd\u0d82\u0d9d\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc0\u0dbb\u0daf\u00fa\u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0d91\u0db8 \u0dc0\u0dbb\u0daf \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u01e7\u0286 \u0d85\u01dd\u0d9a\u0dbb\u0dab \u0db6\u0dbd\u0dba \u0dc3\u028f\u0dad \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dba\u00fa \u026a\u0286\u01e6 \u0dc0\u0dbb\u0daf\u0d9a\u0da7 \u0dc0\u0dbb\u0daf\u0d9a\u025e \u00fb\u025d\u0dd9\u0db8\u01e6 \u0d85\u0db1\u01b1\u025e\u0dc0 \u0d91\u00fc \u0dc0\u0dbb\u0daf \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 1987 \u0d85\u0d82\u0d9a 15 \u0daf\u0dbb\u0db1 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db4\u0db1\u0dd9\u01ae 122 (2) \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u0daf\u0da9\u0dba\u0d9a\u0da7\u0dba\u0da7\u01ae\u026a\u0dba \u0252\u01b1\u0dba. \u0d91\u00fc \u0dc0\u0dbb\u0daf \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u01e7\u0286 \u0d85\u01dd\u0d9a\u0dbb\u0dab \u0db6\u0dbd\u0dba \u0dc3\u028f\u0dad \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dba\u00fb\u01e6 \u0dc0\u0dbb\u0daf\u0d9a\u0da7 \u0dc0\u0dbb\u0daf\u0d9a\u025e\u026b\u0dd9\u0db8\u01e6 \u0d85\u0db1\u01b1\u025e\u0dc0 \u0daf\u0da9\u0dba\u0d9a\u0da7 \u0dba\u0da7\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u00fd \u026a\u0286\u01e6 \u0d91\u00fc \u0d9a\u0da9\u00fb\u025d\u0db8 \u0dd9\u0dc4\u02a4 \u0d8b\u0262\u0dbd\u0d82\u0d9d\u0db1\u0dba \u00fb\u025d\u0db8 \u0dad\u0dc0\u01d0\u0dbb\u0da7\u01ae \u0dd9\u0db1\u02a3\u0d9a\u0da9\u0dc0\u0dcf \u0d9a\u0dbb\u0dd9\u0d9c\u0db1 \u0dba\u01e9 \u0dbd\u0db6\u0db1 \u026a\u0da7\u0d9a \u0d91\u0db8 \u0d8b\u0262\u0dbd\u0d82\u0d9d\u0db1\u0dba \u0218\u0298\u0db6\u0db3 \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0dd9\u0dba\u02a3\u023f \u0d9a\u0dbb\u023d\u01e6 \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0dd9\u0dc4\u02a4 \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0ddb\u0dc0\u0daf\u0255 \u01e7\u0dbd\u0db0\u0dcf\u025c,\u0db8\u0dc4\u0da2\u0db1 \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0db4\u025d\u00fa\u0dc2\u0d9a \u026a\u0286\u01e6 \u0263\u0110\u0dad \u0daf\u0dd0\u01e6\u026b\u0db8\u00fa \u0db7\u0dcf\u0dbb \u0dd9\u0daf\u01e9 \u0dbd\u0dd0\u022b\u0dd9\u0db8\u01e6 \u0db4\u0288\u0dc0 \u0d8b\u0262\u0dbd\u0d82\u0d9d\u0db1\u0dba \u0dad\u0dc0\u01d0\u0dbb\u0da7\u01ae \u0dd9\u0db1\u02a3\u0d9a\u0da9\u0dc0\u0dcf \u0d9a\u0dbb\u0dd9\u0d9c\u0db1 \u0dba\u0db1 \u0dc3\u0dd1\u0db8 \u0d91\u00fa \u01ce\u0db1\u0dba\u00fa \u0dc3\u0db3\u0dc4\u0dcf\u0db8 \u0d89\u0dc4\u0dad \u00fc \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u0d85\u01af\u0dd9\u0259\u0d9a \u0daf\u0da9\u0dba\u0d9a\u0da7\u0daf \u0dba\u0da7\u01ae\u026a\u0dba \u0252\u01b1\u0dba.. 16. \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u0db4\u0daf \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d85\u0db1\u0255\u0dcf\u0259\u0dae\u0dba\u00fa \u0d85\u0dc0\u0dc1\u0255 \u0dc0\u01e6\u0dd9\u01e6 \u0db1\u023c \u023d\u0dc3,\n\n\u201c\u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6 \u0d9a\u0dc4\u0dc0\u01ae\u0dad \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0dad\u01ae\u0d9a\u0dcf\u0dbd\u0dd9\u0dba\u028f \u0dc3\u0db7\u0dcf\u0db4\u01af \u01e0\u0dbb\u0dba \u0daf\u0dbb\u0db1 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u0dcf \u0dd9\u0dc4\u02a4 \u0d91\u0db8 \u01e0\u0dbb\u0dd9\u024f \u0d9a\u0dcf\u0259\u0dba\u0dba \u0d9a\u0259\u0dad\u0dc0\u0255 \u0d89\u017b \u0d9a\u0dbb\u0db1 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u0dcf \u0daf, \u201c\u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6 \u0d9a\u0dc4\u0dc0\u01ae\u0dad \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0daf, \u201c\u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0ddb\u0dc0\u0daf\u0255 \u01e7\u0dbd\u0db0\u0dcf\u025d\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6 \u0dad\u01ae\u0d9a\u0dcf\u0dbd\u0dd9\u0dba\u028f \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db6\u0dbd \u021d\u0dd9\u01ca\u0dc1\u0dba\u01b1\u0dc5 \u0218\u028f\u0179 \u00fb\u0286\u0dba\u023c \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0ddb\u0dc0\u0daf\u0255 \u01e7\u0dbd\u0db0\u0dcf\u025d \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba\u0d9a \u0d91\u0db8 \u01e0\u0dbb\u0dba \u0daf\u0dbb\u0db1 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u0dcf \u0daf, \u201c\u0db8\u0dc4\u0da2\u0db1 \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0db4\u025d\u00fa\u0dc2\u0d9a\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6 \u0dad\u01ae\u0d9a\u0dcf\u0dbd\u0dd9\u0dba\u028f \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db6\u0dbd \u021d\u0dd9\u01ca\u0dc1\u0dba\u01b1\u0dc5 \u0218\u028f\u0179 \u00fb\u0286\u0dba\u023c \u0db8\u0dc4\u0da2\u0db1 \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0db4\u025d\u00fa\u0dc2\u0d9a \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba\u0d9a \u0d91\u0db8 \u01e0\u0dbb\u0dba \u0daf\u0dbb\u0db1 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u0dcf \u0daf, \u201c\u0db6\u0dbd\u0dba\u0dbd\u01ae \u01e7\u0dbd\u0db0\u0dcf\u025c\u0dba\u0dcf\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6 \u0dad\u01ae\u0d9a\u0dcf\u0dbd\u0dd9\u0dba\u028f \u0dc3\u0db7\u0dcf\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0263\u0110\u0dad\u0dc0 \u0db6\u0dbd\u0dba \u0db4\u0dc0\u0dbb\u0db1 \u0dbd\u0daf \u0dba\u023c \u01e7\u0dbd\u0db0\u0dbb\u0dd9\u0dba\u00fa \u0daf, \u201c\u0db6\u0dbd\u0db4\u01b4\u0dbd\u0dcf\u0234\u0dba\u0dcf\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6 \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dba\u0da7\u0dd9\u01ae \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0dbd\u0db6\u0dcf \u0d9c\u01ae \u0d86\u0dba\u0dad\u0db1\u0dba\u00fa \u0dd9\u0dc4\u02a4 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u00fa \u0dd9\u0dc4\u02a4 \u021a\u01ca\u0d9c\u0dbd\u0dd9\u0dba\u00fd \u0daf, \u201c\u0db4\u0dcf\u01e8\u0dba \u0da2\u0dbd\u0dba\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6 \u0dd9\u0dbb\u02a4\u0d9c \u0d87\u01af \u00fb\u025d\u0db8\u0da7 \u0dd9\u0dc4\u02a4 \u0dc1\u025d\u0dbb\u0dba\u0da7 \u0d85\u028f\u0dad\u0d9a\u0dbb \u0d9a\u0dcf\u0250\u0d9a \u0db6\u0dbd\u0db4\u0dd1\u023c \u0d87\u01af \u00fb\u025d\u0db8\u0da7 \u021d\u0db8\u0dcf\u0dab\u0dc0\u01ae \u0db4\u025c\u01ce \u0d85\u0db4\u026a\u01b4\u0d9a\u0dcf\u0dbb\u0d9a \u0dd9\u0dad\u02a3\u0dbb \u0dc3\u0dc4 \u0d85\u01e6\u0dad\u0259\u0d9c\u0dad \u0db6\u0dd0\u00fa\u017a\u025c\u0dba\u0dcf \u0dc3\u0dc4 \u0dbb\u0dc3\u0dcf\u0dba\u01e7\u0d9a \u0dad\u01ae\u0dc0\u0dba\u01e6 \u0da2\u0dcf\u01af\u0d9a \u021d\u023d\u01b0\u01e6\u0da7 \u0d85\u01e9\u00fe\u0dbd\u0dc0\u0db1 \u0da2\u0dbd\u0dba \u0daf, \u201c\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0dd9\u0269\u0dbd\u0dcf\u0dc0\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6 \u0db6\u0dbd\u0db4\u01b4\u0dbd\u01ae \u0d9a\u0259\u0dad\u0dc0\u0255 \u0dd9\u0dc4\u02a4 \u0d8a\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d9a\u0dcf\u0259\u0dba\u01e6\u028f \u01e7\u0dbb\u0dad\u0dc0\u0db1 \u0dd9\u0269\u0dbd\u0dcf\u0dc0\u00fa \u0daf, \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dd9\u0269. 17. \u0dd9\u0db8\u0db8 \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u0286\u0d82\u0dc4\u0dbd,\u0dd9\u0daf\u0db8\u0dc5, \u0d89\u0d82\u0121\u0286 \u0218\u0da7\u0db4\u01ae\u0dc0\u0dbd \u0db7\u0dcf\u0dc2\u0dcf \u0db4\u0dcf\u0da8 \u0d85\u0dad\u0dbb \u0dba\u023c \u0d85\u0db1\u01e9\u00fe\u0dbd\u0dad\u0dcf\u0dc0\u00fa \u0d87\u01af \u026c\u0dc0\u0dd9\u0dc4\u02a3\u01ae \u0286\u0d82\u0dc4\u0dbd \u0db4\u0dcf\u0da8\u0dba\n\n\u0db6\u0dbd\u0db4\u0dd0\u0dc0\u0dd0\u01ae\u0dd9\u0269."
  },
