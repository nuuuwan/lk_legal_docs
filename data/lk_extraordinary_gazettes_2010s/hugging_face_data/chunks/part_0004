bbf\u0baa\u0ba4\u0bbf \u0bc8\u0bae\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0baa\u0bbe\u0bb2 \u0b9a\u0bbf\u0bb1\u0bbf\u0bc7\u0b9a\u0ba9 \u0b86\u0b95\u0bbf\u0baf \u0ba8\u0bbe\u1fb9, \u0b95\u0bc0\u1fc1 \u0b87\u0bc8\u0ba3\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf \u0bb5\u0bc8\u0bb0\u0baf\u1fa0\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0b8e\u1fbf\u0bc8\u0bb2\u0b95\u1fa6\u1fb0\u1f81\u1fc0 \u0b89\u1fb5\u0baa\u1fb5\u0b9f 73.902 \u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u0bbe\u1fbd \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fb7\u0bc8\u0ba4\u1fb0 \u0bc6\u0b95\u0bbe\u1fb6\u0b9f \u0b88\u1fb2\u0b9a\u1fb8\u0ba4\u0bc0\u1fab \u0b95\u1fb6\u0b9f\u1fbf \u0b95\u0bbe\u1fb5\u0bc8\u0b9f 2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0ba8\u0bc6\u0bb5\u1fbb\u0baa\u1fbd \u0bae\u0bbe\u0ba4\u1fbb 04 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbf\u1fa2\u1f9e\u1fb8\u1f90 \u0b88\u1fb2\u0b9a\u1fb8\u0ba4\u0bc0\u1fab \u0b95\u1fb6\u0b9f\u1fbf \u0b92\u1f90\u1fb0\u1f81\u1fb0 \u0b95\u0bbe\u1f8c \u0b8e\u0ba9 \u0b87\u1fb7\u0ba4\u0bbe\u1fbf \u0baa\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u1fba\u0baa\u1f8c\u1fb7\u1f90\u0b95\u0bbf\u1fb9\u0bc7\u0bb1\u1fb9. \u0bc8\u0bae\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0baa\u0bbe\u0bb2 \u0b9a\u0bbf\u0bb1\u0bbf\u0bc7\u0b9a\u0ba9, \u0b9a\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf. \u0bc6\u0b95\u0bbe\u1fa8\u1fbb\u1f97, 2019, \u0ba8\u0bc6\u0bb5\u1fbb\u0baa\u1fbd 04.\n\n5A\n\nI \u0dd9\u0d9a\u02a3\u0da7\u0dc3: (I) \u0dd9\u0146\u0daf\u0dba - \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba - 2019.11.20\n\n\u0baa\u1f81\u0ba4\u0bbf I: \u0bc6\u0ba4\u0bbe\u1f81\u0ba4\u0bbf (I) - \u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u1f86 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe