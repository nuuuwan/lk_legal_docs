u0d82\u0d9a 56, 1982 \u0d85\u0d82\u0d9a 13, 1988 \u0d85\u0d82\u0d9a 84, 1995 \u0d85\u0d82\u0d9a 23 \u0dc4\u0dcf 2009 \u0d85\u0d82\u0d9a 65 \u0daf\u0dbb\u0db1 \u0db4\u0db1\u0dad\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0dd2\u0dad 1966 \u0d85\u0d82\u0d9a 13 \u0daf\u0dbb\u0db1 (451 \u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dba \u0dc0\u0dd6) \u0dc0\u0db1 \u0dc3\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d86\u0da5\u0dcf\u0db4\u0db1\u0dd9\u0dad\u0dca 3. \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0d9a\u0dcf\u0dbb\u0dc0 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2, \u0ddb\u0db8\u0dad\u0dd3\u0db4\u0dcf\u0dbd \u0dc3\u0dd2\u0dbb\u0dd2\u0dd9\u0dc3\u0dda\u0db1 \u0dc0\u0db1 \u0db8\u0db8, \u0db4\u0dc4\u0dad \u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dd9\u0dba\u0dca \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca \u0dad\u0dd4\u0dc5 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 22.644 \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd\u0dad\u0dca\u0dc0\u0dd9\u0dba\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0da7\u0dca\u0da7\u0db8\u0dd4\u0dbb\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dd9\u0da9\u0ddc\u0dbd\u0dcf\u0db1 \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb\u0dba \u0dc0\u0dbb\u0dca\u0dc2 2019 \u0d9a\u0dca \u0dc0\u0dd6 \u0dd9\u0db1\u0ddc\u0dc0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 04 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0d9a\u0da7\u0dca\u0da7\u0db8\u0dd4\u0dbb\u0dd2\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dd9\u0da9\u0ddc\u0dbd\u0dcf\u0db1 \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb\u0dba \u0dd9\u0dbd\u0dc3 \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dca \u0db4\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db8\u0dd2.\n\n\u0ddb\u0db8\u0dad\u0dd3\u0db4\u0dcf\u0dbd \u0dc3\u0dd2\u0dbb\u0dd2\u0dd9\u0dc3\u0dda\u0db1, \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2. 2019 \u0dd9\u0db1\u0ddc\u0dc0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 04 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 \u0daf\u0dd3 \u0dba.\n\n\u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba\n\n\u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0dc0\u0dca, \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dd9\u0dad\u0dca, \u0db8\u0da9\u0d9a\u0dbd\u0db4\u0dd4\u0dc0 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca, \u0dd9\u0d9a\u0ddd\u0dbb\u0dd9\u0dbd\u0dca \u0db4\u0dad\u0dca\u0dad\u0dd4 \u0d8b\u0dad\u0dd4\u0dbb \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba \u0dad\u0dd4\u0dc5 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 22.644 \u0d9a\u0dd2\u0db1\u0dca \u0dba\u0dd4\u0d9a\u0dca\u0dad \u0dc0\u0dd6 \u0db4\u0dc4\u0dad \u0db7\u0dd6\u0db8\u0dd2\u0dad\u0dd2\u0d9a \u0db4\u0dcf\u0da8\u0dcf\u0d82\u0d9a \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0d9a\u0dca\u0dd9\u0dc0\u0db1 \u0db4\u0dd9\u0daf\u0dca\u0dc1\u0dba \u0dad\u0dd4\u0dbd \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d89\u0da9\u0db8\u0dca \u0db4\u0db8\u0dcf\u0dab\u0dba (\u0db8\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0d9a\u0db8\u0dba, \u0db7\u0dd6\u0db8\u0dd2\u0dad\u0dd2\u0d9a \u0d9b\u0dab\u0da9\u0dcf\u0d82\u0d9a EPSG : 5234 \u0d9a\u0db8\u0dba \u0dd9\u0dc0\u0dca)."
