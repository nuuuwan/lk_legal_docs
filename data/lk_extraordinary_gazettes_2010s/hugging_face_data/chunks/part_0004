0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 127 0.0253 \u0b86\u0bbe\u0bbf\u0baf\u0ba4\u0bbe\u0b9a \u0b85\u0ba4\u0baa\u1fb7\u1f90 361041275v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 124 \u0b87\u1fb9 \u2013 \u1f86\u0bae\u1fb1\u0b95\u0bb2 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bb5\u0bbe\u0bbe\u0bbf\u0baf\u0bc6\u0baa\u0bbe\u0bb2 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 128 0.0254 \u0b86\u0bbe\u0bbf\u0baf\u0ba4\u0bbe\u0b9a \u0b85\u0ba4\u0baa\u1fb7\u1f90 361041275v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 124 \u0b87\u1fb9 \u2013 \u1f86\u0bae\u1fb1\u0b95\u0bb2 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bb5\u0bbe\u0bbe\u0bbf\u0baf\u0bc6\u0baa\u0bbe\u0bb2 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 129 0.0253 \u0b86\u0bbe\u0bbf\u0baf\u0ba4\u0bbe\u0b9a \u0b85\u0ba4\u0baa\u1fb7\u1f90 361041275v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 124 \u0b87\u1fb9 \u2013 \u1f86\u0bae\u1fb1\u0b95\u0bb2 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bb5\u0bbe\u0bbe\u0bbf\u0baf\u0bc6\u0baa\u0bbe\u0bb2 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 130 0.0253 \u0b86\u0bbe\u0bbf\u0baf\u0ba4\u0bbe\u0b9a \u0b85\u0ba4\u0baa\u1fb7\u1f90 361041275v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 124 \u0b87\u1fb9 \u2013 \u1f86\u0bae\u1fb1\u0b95\u0bb2 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bb5\u0bbe\u0bbe\u0bbf\u0baf\u0bc6\u0baa\u0bbe\u0bb2 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u