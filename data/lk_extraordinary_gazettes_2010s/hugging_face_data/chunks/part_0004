    "chunk_text": "\u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u1fa4\u0bae\u0bcd 2009 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 65 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u1fa4\u0bae\u0bcd \u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 1966 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 13 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u1fa4\u0bae\u0bcd (451 \u0b86\u0bb5\u1f90 \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0baf\u0bae\u0bcd) \u0b95\u0bbe\u1f8c \u0bc7\u0baa\u0ba3\u0bb1\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 3. \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba4\u0bcd\u1f90\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0baf\u0bc8\u0ba9\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u1f8c \u0b9a\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u0bc8\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0baa\u0bbe\u0bb2 \u0b9a\u0bbf\u0bb1\u0bbf\u0bc7\u0b9a\u0ba9 \u0b86\u0b95\u0bbf\u0baf \u0ba8\u0bbe\u0ba9\u0bcd, \u0b95\u0bc0\u0bb4\u0bcd \u0b87\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bc8\u0bb0\u0baf\u1fa0\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 1648.69 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0ba4\u0bcd\u0bc8\u0ba4\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0bb8\u0bcd\u0bb5\u0bb0\u0b99\u0bcd\u0b95\u0bb2\u0bbe\u0bb5 \u0b95\u0bbe\u0b9f\u0bcd\u0bc8\u0b9f 2019 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8c \u0ba8\u0bc6\u0bb5\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd 04 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbf\u1fa2\u1f9e\u0ba8\u0bcd\u1f90 \u0bb8\u0bcd\u0bb5\u0bb0\u0b99\u0bcd\u0b95\u0bb2\u0bbe\u0bb5 \u0b92\u1f90\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bbe\u1f8c \u0b8e\u0ba9 \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u1f90\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd. \u0bc8\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0baa\u0bbe\u0bb2 \u0b9a\u0bbf\u0bb1\u0bbf\u0bc7\u0b9a\u0ba9, \u0b9a\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf. \u0bc6\u0b95\u0bbe\u1fa8\u0bae\u0bcd\u1f97, 2019, \u0ba8\u0bc6\u0bb5\u0bae\u0bcd\u0baa\u0bb0\u0bcd 04.\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 - \u1f97\u0ba4\u0bcd\u0ba4\u0bb3\u0bae\u0bcd \u0b95\u0bc1\u1f9e\u0ba8\u0bbe\u0b95\u0bb2\u0bcd \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2 \u0b87.\u0b95\u0bbf.\u0bb5. 3405 \u0b87\u0ba9\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 283, 280, 279,277, 276, 275, 274, 272, 269, 268, 267, 266, 265, 264, 261, 260, 257 2/2, 256 2/2, 255 \u00bd, 254, 253, 252 ,251, 249, 248, 247, 43, 245, 243, \u0b95\u1f9e\u0bb5\u0bb2\u0b95\u0bb8\u0bcd\u0bc6\u0bb5\u0bb5 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2, \u0b87.\u0b95\u0bbf.\u0bb5. 3404 \u0b87\u0ba9\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 42, 49 \u0b95\u1f9e\u0bb5\u0bb2\u0b95\u0bb8\u0bcd\u0bc6\u0bb5\u0bb5 \u0b86\u1fa0 (4) 51; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 - \u0b95\u0b9f\u0bcd\u1f8c\u0bc6\u0bb5\u0bb5 \u0b95\u1f9e\u0bb5\u0bb2\u0b95\u0bb8\u0bcd\u0bc6\u0bb5