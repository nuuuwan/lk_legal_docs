n121 0.0395 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u1fb9 \u0baa\u0bbf\u0bb0\u0b9a\u1fb9\u0ba9 197126800202 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 117 \u2013 \u1f9f\u0baa\u0b9a\u0bbf\u1fb1\u0bb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2 9/6, \u0bae\u0bb9\u0b95\u1f8c\u0bb5\u0bbe\u0ba9 \u1faa\u0ba4\u0bbf, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bc7\u0bb9\u0bbe\u0bae\u0bbe\u0b95\u0bae \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 09 - 806 / 6\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b8e\u0ba9\u1fb0\u1f81\u0bbe\u0bbf\u1fb7\u0ba4\u0bbe\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0ba4\u1fb7\u1f90\u0bb5\u1fb1\u0b95\u0bb3\u0bbf\u1fb9 \u0baa\u0baf\u0bc8\u0ba9\u1fb0\u0bc6\u0b95\u0bbe\u1fb6\u1f8c, \u0b95\u0bc0\u0bc7\u0bb4 \u0b92\u1fba\u0baa\u0bae\u0bbf\u1fb5\u1f8c\u1fc0\u0bb3 \u0ba8\u0bbe\u1fb9, 1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 12 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u1fb9\u0baa\u1f8a 2009.01.08 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf 158