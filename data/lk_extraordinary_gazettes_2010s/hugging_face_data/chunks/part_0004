5\u1fbb\u0baa\u0bb9\u0bbe \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0bae\u0bb9\u0bb0 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf 245\u0b8e - \u1f87\u0bbe\u0bbf\u0baf\u0baa\u0bbe\u1fa8\u0bb5 \u0bc6\u0ba4\u1fbe\u1f81 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u1f87\u0bbe\u0bbf\u0baf\u0baa\u0bbe\u1fa8\u0bb5 \u0b8e\u1f94\u1fbb \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf, 510821 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 01\u0b87\u1fbf 171 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8a\u1fb9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b85\u1fc2\u0bb5\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf,\n\n\u201c\u0b95\u0bbe\u0ba3\u0bbf \u0bb5\u0bb4\u1fb0\u0b95\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0b9f\u0baa\u1fb5\u0b9f\u0ba4\u0bbe \u0b88\u1f8c \u1f81\u1fb7\u0ba4\u0bc8\u0b95 \u0ba4\u1f8c\u1fba\u1f97\u1fb0 \u0b95\u1fb5\u0b9f\u0bc8\u0bb3 \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0\u201d \u0b8e\u1fb9\u1f94\u1fbb \u0ba8\u0bbf\u0bb0\u1fa2\u1fbf \u0b89\u1fc0\u0bb3\u0b9f\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3\n\n\u201c\u0b95\u0bbe\u0ba3\u0bbf\u1fb7 \u1f90\u1fb6\u1f8a\u1fb9 \u0b87\u0bb2. 182 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90\u201d \u0b8e\u1fb9\u0baa\u1f90 \u0ba8\u0bc0\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c \u201c\u0b95\u0bbe\u0ba3\u0bbf\u1fb7 \u1f90\u1fb6\u1f8a\u1fb9 \u0b87\u0bb2. 128 \u0bae\u1fbe\u1fa0\u1fbb 207 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf\n\n\u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\