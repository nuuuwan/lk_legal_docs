b95\u0bbe\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b9a\u0bbf\u0bbe\u0bbf \u1faa\u1f8c \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bb5\u0bbf\u0bb2\u0bbe\u0b95\u1f8c\u0bc6\u0baa\u0bbe\u0ba4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bb5\u0bbe\u0bbe\u0bbf\u0baf\u0bc6\u0baa\u0bbe\u0bb2 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 163 0.0393 \u0bc6\u0bae\u0bbe\u0bb9\u0bae\u1fb5 \u0b85\u1fb9\u0b9a\u0bbe\u1fbd \u0bc6\u0bae\u0bbe\u0bb9\u0bae\u1fb5 \u0b9a\u0bbf\u1fbf\u0bae\u0bbf 197003710030 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 80 \u2013 \u0b87\u0bb2. 12, \u1f97\u1fb7\u0ba4\u0bb3\u1fbb \u1faa\u0ba4\u0bbf, \u0bae\u1fbe\u1fa0\u1fbb 167 \u0b87\u1fb9 \u0bb5\u0bbe\u0bbe\u0bbf\u0baf\u0bc6\u0baa\u0bbe\u0bb2 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 164 0.0418 \u0bb5\u0bbf\u0bc7\u0b9c\u1fb2\u0ba4\u0bbf\u0bb0 \u0ba8\u0baf\u0bbf\u0bc6\u0ba4\u0bb2\u0bbe\u0bc7\u0b95 \u0ba4\u0bbf\u1fc4\u0bb8 196106701080 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 167 \u0b87\u1fb9 \u2013 \u0bb5\u0bbf\u0bc7\u0b9c\u0b9a\u0bbf\u1fb1\u0bb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf 272/10, \u0bc6\u0bb5\u1f8a\u0baf\u0bc6\u0bb5\u0bb2\u0bb5\u1fb7\u0ba4, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bb5\u0bbf\u0bb2\u0bbe\u0b95\u1f8c\u0bc6\u0baa\u0bbe\u0ba4, \u0bb5\u0bbe\u0bbe\u0bbf\u0baf\u0bc6\u0baa\u0bbe\u0bb2 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 168 0.1221 \u1f81\u1f9e\u0bb5\u0bbf\u0b9f \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bb2\u0bbe\u0bc7\u0b95 \u0bc7\u0b9a\u0bbe\u0bae\u0ba4\u0bbe\u0b9a 491862220v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 167 \u2013 \u0bb5\u0bbf\u0bb2\u0bbe\u0b95\u1f8c\u0bc6\u0baa\u0bbe\u0ba4, \u0bb5\u0bbe\u0bbe\u0bbf\u0baf\u0bc6\u0baa\u0bbe\u0bb2 \u0bae\u1fbe\u1fa0\u1fbb 175 \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0b