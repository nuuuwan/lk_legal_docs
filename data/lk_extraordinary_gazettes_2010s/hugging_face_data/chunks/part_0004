\u0baf\u1fb0\u0b95\u0bbe\u0bb0\u1fbd \u1f9a\u0bb2\u0bae\u0bbe\u0b95 2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0ba8\u0bc6\u0bb5\u1fbb\u0baa\u1fbd \u0bae\u0bbe\u0ba4\u1fbb 06 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u1f99.\u0baa. 10.00 \u0bae\u0ba3\u0bbf\u1fb0\u1f81 \u0ba4\u0bbf\u0bb9\u0bc6\u0b95\u0bbe\u0b9f \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0b95\u1fb7\u0ba4\u0bbf\u1fbf \u0b8e\u1fb9 \u1f99\u1fb9\u0baa\u0bbe\u0b95 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u1f90\u1fbb\u0baa\u1f8a\u1f9c\u1fbb \u0b85\u1fb0\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u1fbf \u0b85\u0bb5\u1fbd\u0b95\u1fa6\u1fb0\u1f81\u1fc0\u0bb3 \u0b89\u0b9f\u1fb8\u0bc8\u0ba4\u0b95\u0bb3\u0bbf\u1fb9 \u0ba4\u1fb9\u0bc8\u0bae\u0bc8\u0baf\u1f9c\u1fbb \u1f81\u0bb1\u0bbf\u1fb7\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf\u0bc8\u0baf \u0b8e\u1f8c\u1fb7\u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0ba8\u1fc3\u0b9f\u0b88\u1f8c \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0b85\u0bb5\u1fbd\u0b95\u0bb3\u0bbf\u1fb9 \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0b95\u0bb3\u0bbf\u1fb9 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u0bc8\u0bb3\u1f9c\u1fbb \u0ba8\u1fc3\u0b9f \u0b88\u1fb5\u1f8c\u1fb7 \u0bc6\u0ba4\u0bbe\u0bc8\u0b95\u0bc8\u0baf\u1f9c\u1fbb \u0b85\u1fb7\u0bc6\u0ba4\u0bbe\u0bc8\u0b95 \u0b95\u0ba3\u0bbf\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u0bc8\u0bb3\u1f9c\u1fbb 2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0b92\u1fbe\u0bc7\u0bb1\u0bbe\u0baa\u1fbd \u0bae\u0bbe\u0ba4\u1fbb 30 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u1fb0\u1f81 \u1f99\u1fb9\u0ba9\u1fbd \u0b8e\u1fa8\u1fb7\u0ba4\u0bbf\u1fbf \u1f99\u1fba\u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0b95\u0bb3\u0bbe\u0b95\n\n\u0b8e\u0ba9\u1fb0\u1f81 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb0\u1f81\u1fbb\u0baa\u1f8a\u1f9c\u1fbb \u0b87\u1fb7\u0ba4\u0bbe\u1fbf \u0bc7\u0b95\u1fb5\u1f8c\u1fb0\u0bc6\u0b95\u0bbe\u1fc0\u0bb3\u1fba \u0baa\u1f8c\u0b95\u0bbf\u1fb9\u0bb1\u0ba9\u1fbd. \u0b89\u0bc7\u0bae\u0b9a\u0bbe \u1f86\u0bb0\u1fb1\u0b95\u0bbf \u0bae\u0bbe\u0ba4\u0bb0\u0bc7\u0b95, 