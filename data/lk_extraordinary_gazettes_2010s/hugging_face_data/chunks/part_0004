db8)\u0dd9\u0dc4)-\u0db8l \u0dad\u0dcf\u0dc4\u0dcf \u0dd9\u0db8)\u0dd9\u0dc4)-\u0db8l 871012920v \u0dc3-wf\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u0d9a\u0dd0\u0db60 \u0d85\u0d82\u0d9a 124 . \u2013 \u0db4<\u0dc2\u0dcf \u0db8\u0dcff\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf .}F\u0dc0\u0dd0\u0dc0, \u0db6\u2022\u0da9\u0dcf\u0dbb\u0dd9\u0d9a)\u0dc3\u0dca\u0dc0;\u0dad, \u0d85_\u001b\u0dba \u0dc3\u0db8\u0d9f 115 0.0253 \u0db1\u201dj\u000f \u0dc4\u0dbb\u0dcf\u0db1\u0dcf 928590712v \u0dc3-wf\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u0d9a\u0dd0\u0db60 \u0d85\u0d82\u0d9a 124 . \u2013 \"\u2022lf\", \u0db8\u2022\u0dd9@ /1\u0dba\u0dcf\u0dbd, \u0db8\u0dcff\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0db6\u2022\u0da9\u0dcf\u0dbb \u0dd9\u0d9a)\u0dc3\u0dca\u0dc0;\u0dad \u0d85_\u001b\u0dba \u0dc3\u0db8\u0d9f 117 0.0166 \u0d850\u0d9a-\u017e\u0dd9@ \u0db1\u201dj\u000f 572122522v \u0dc3-wf\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u0d9a\u0dd0\u0db60 \u0d85\u0d82\u0d9a 124 . \u2013 940, \u0db8\u2022\u0dd9\u0d9c /1\u0dba\u0dcf\u0dbd, \u0db8\u0dcff\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0db6\u0d82\u0da9\u0dcf\u0dbb\u0dd9\u0d9a)\u0dc3\u0dca\u0dc0;\u0dad \u0d85_\u001b\u0dba \u0dc3\u0db8\u0d9f, \u0dc4\u0dd0\u0da7 \u0db1\u0dd0\u0dc2\u0db1= \u0db6\u0dd0\u0d82E\u0dc0, EF\u0dab\u0dd1\u0d9c\u0dbd . \u0dad\u0db6\u0dcf \u0d87\u001b \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7;\u0dc0, \u0d8b\u0d9a\u0dc3\u0dca \u0d85\u0d82\u0d9a\u0dba - 4272, 1\u0db1\u0dba - 2015.10.22\n\n16 A III \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 : \u0001 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007\u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db