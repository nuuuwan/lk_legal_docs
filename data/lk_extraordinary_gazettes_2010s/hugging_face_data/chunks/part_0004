0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0008 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 17. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 17 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u1fac\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0baa\u0b9a\u0bbe\u0bb0\u0bcd; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa); \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e \u0baa\u0bb5\u0bb0\u0bcd: \u0b8f. \u1faa\u0bb0\u1f97\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd, \u1fac\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0baa\u0b9a\u0bbe\u0bb0\u0bcd, \u0bc6\u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0b95\u0bc8\u0bb2; \u0b85\u1f94\u0baa\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bb5\u0bb0\u0bcd: \u1f9d. \u0b87\u0bb0\u0bbe\u0bae\u0ba8\u0bbe\u0ba4\u0ba9\u0bcd; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0012 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 18. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 18 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u1fac\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0baa\u0b9a\u0bbe\u0bb0\u0bcd; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa); \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e \u0baa\u0bb5\u0bb0\u0bcd: \u0b8f. \u1faa\u0bb0\u1f97\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd, \u1fac\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0baa\u0b9a\u0bbe\u0bb0\u0bcd, \u0bc6\u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0b95\u0bc8\u0bb2; \u0b85\u1f94\u0baa\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bb5\u0bb0\u0bcd: \u0bb5\u0bbf. \u0b9a\u0bc1\u0bc7\u0bb0\u0bb8\u0bcd; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0007 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd.\n\n3A\n\nIII \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 - \u0dc1\u0