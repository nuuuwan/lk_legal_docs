6\u0baa\u0baf\u0bb0\u0bcd: \u1fac\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0baa\u0b9a\u0bbe\u0bb0\u0bcd; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa); \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0baa\u0bb5\u0bb0\u0bcd: \u0bc6\u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0b95\u0bc8\u0bb2 \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2 \u0bc6\u0baa\u1f9e\u0ba8\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0bc6\u0b95\u0bbe\u0b9f\u0bcd\u0b9f \u0b95\u0bc8\u0bb2; \u0b85\u1f94\u0baa\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bb5\u0bb0\u0bcd: \u0b8e\u0bb8\u0bcd. \u0baa\u0bb0\u0bcd\u0bc6\u0ba9\u0ba9\u0bcd\u0bc7\u0b9f\u0bbe; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0006 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 140. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 140 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u1fac\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0baa\u0b9a\u0bbe\u0bb0\u0bcd; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa); \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0baa\u0bb5\u0bb0\u0bcd: \u0bc6\u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0b95\u0bc8\u0bb2 \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2 \u0bc6\u0baa\u1f9e\u0ba8\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0b85\u1f94\u0baa\u0bb5\u0bbf\u0baa\u0bcd \u0baa\u0bb5\u0bb0\u0bcd: \u0baa\u0bbf. \u0bc6\u0b9c\u0baf\u0b95\u0bbf\u1f9e\u0bb8\u0bcd\u0ba3\u0ba9\u0bcd; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0007 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 141. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 141 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u1fac\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0baa\u0b9a\u0bbe\u0bb0\u0bcd; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa); \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0baa\u0bb5\u0bb0\u0bcd: \u0bc6\u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0b95\u0bc8\u0bb2 \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2 \u0bc6\u0baa\u1f9e\u0ba8\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0b85\u1f94\u0baa\u0bb5\u0bbf\u0baa\u0bcd \u0baa\u0bb5\u0bb0\u0bcd: \u0b8e\u0bb8\u0bcd. \u0bae\u0bbe\u0bbe\u0bbf; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0008 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 142. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 142 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u1fac\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0baa\u0b9a\u0bbe\u0bb0\u0bcd; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa); \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0baa\u0bb5\u0bb0\u0bcd: \u0bc6\u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0b95\u0bc8\u0bb2 \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2 \u0bc6\u0baa\u1f9e\u0ba8\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0b85\u1f94\u0baa\u0bb5\u0bbf\u0baa\u0bcd \u0baa\u0bb5\u0bb0\u0bcd: \u0b8e\u0bae\u0bcd. \u0bc7\u0bb2\u0bbe\u0bc7\u0b95\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bbe\u0b9c\u0bbe; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0011 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 143. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 143 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u1fac\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0baa\u0b9a\u0bbe\u0bb0\u0bcd; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa); \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0baa\u0bb5\u0bb0\u0bcd: \u0bc6\u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0b95\u0bc8\u0bb2 \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2\u0baa\u0bcd \u0bc6\u0baa\u1f9e\u0ba8\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0b85\u1f94\u0baa \u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bb5\u0bb0\u0bcd: \u0b86\u0bb0\u0bcd. \u0baa\u0ba4\u0bcd\u0bae\u0ba4\u0bb0\u0bcd\u0bb7\u0bbf\u0ba9\u0bbf; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0014 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 144. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 144 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u1fac\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0baa\u0b9a\u0bbe\u0bb0\u0bcd; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa); \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0baa\u0bb5\u0bb0\u0bcd: \u0bc6\u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0b95\u0bc8\u0bb2 \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2 \u0bc6\u0baa\u1f9e\u0ba8\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0b85\u1f94\u0baa\u0bb5\u0bbf\u0baa\u0bcd \u0baa\u0bb5\u0bb0\u0bcd: \u0b86\u0bb0\u0bcd. \u0bb0\u0bbe\u0bae\u0bcd\u0b95\u0bc1\u0bae\u0bbe\u0bb0\u0bcd; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0019 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 145. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 145 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u1fac\u0b9f\u0bcd\u0b9f\u0ba9\u0bcd \u0baa\u0b9a\u0bbe\u0bb0\u0bcd; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa); \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0baa\u0bb5\u0bb0\u0bcd: \u0bc6\u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0b95\u0bc8\u0bb2 \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2 \u0bc6\u0baa\u1f9e\u0ba8\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0019 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd.\n\n11A\n\nIII \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 - \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba - 2019.11.11\n\n\u0baa\u0b95\u0bc1\u0ba4\u0bbf III - \u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u1f8a\u0baf\u0bb0\u0b9a\u0bc1 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 - 2019.11.11"
