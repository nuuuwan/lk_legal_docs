db6\u0db3 \u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0dca\u0dad\u0dbb\n\n(\u0dd9\u0dc4I\u0da7\u0dba\u0dcff)\n\n1 0.5712 \u0007\u0dcf\u0dd9$\u2020\u0dba \u0dc3\u0db7\u0dcf\u0dc0, \u2013 \u0dc3-uf\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 \u0db8\u0dcff\u0d9c\u0dba3. 2 0.2137 \u0dbb\u0da2\u0dba \u2013 \u0dc3-uf\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 \u2013 3 0.0331 \u0dbb\u0da2\u0dba \u2013 \u0dc3-uf\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 \u2013 4 0.2023 \u0dbb\u0da2\u0dba \u2013 \u0dc3-uf\u0dab \u0007\u0dae\u0db8 \u0db4 \u001b\u0dba \u2013 \u2013\n\n11A III \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 \u0dd9\u0d9a)\u0da7\u0dc3 : \u0001 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0007\u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0da2\u0dcf\u0dad\u0dcf \u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u000f \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0013 \u0d85\u001b \u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0016 \u0db4\u0018\u0dba \u0dba \u0dba \u0dba - 2019201920192019.11111111.20202020\n\n\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba\u0d8b\u0db4\u0dd9=\u0d9b\u0db1\u0dba \u2013 (\u0dc3-\u0db6 \u201e\u0dad`\u0dc3-\u0db6 \u201e\u0dad`\u0dc3-\u0db6 \u201e\u0dad`\u0dc3-\u0db6 \u201e\u0dad`) (\u0dc1\u0dca\u0da0\u0dba \u0dc3\u0dc4 \u0dba- \u0dd9\u0dc1r\u0dc2 \u0dd9\u0dc4s \u0d89 \u0dd9\u0da2 \u0dc2 \u0da