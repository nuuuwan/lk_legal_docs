\u1fba\u1f97 \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u2013 \u0ba4 \u0b9a\u0bbf\u1fbf\u0bb5\u0bbe \u0bc8\u0bae\u0b95\u1fbf \u0b87\u0bb2. 125, \u0bb5\u0b9f\u1fb0\u1f81 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0bae\u0bbf\u0bbe\u0bbf\u1fc4\u0bb8\u1fb9\u0bc6\u0b95\u0bbe\u1f8c\u0bb5, \u1fa4\u1f8e\u0bb5\u0bbf\u0bb2 \u0bae\u1fbe\u1fa0\u1fbb \u1f81\u0bb2\u1fba\u1f97\u0bb5\u1f8c\u0bc7\u0b95 \u0b9a\u0bae\u1fb8\u0ba4 \u0bc7\u0baa\u0bae\u1f81\u0bae\u0bbe\u1fbd \u0ba4 \u0b9a\u0bbf\u1fbf\u0bb5\u0bbe \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 207 \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 203 0.0229 \u1f81\u0bb2\u1fba\u1f97\u0bb5\u1f8c\u0bc7\u0b95 \u0bb0\u0bc7\u0ba9\u1fc3 \u0bc7\u0bb9\u0bb7\u0bbe\u1fb8 200105302669 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 207 \u0b87\u1fb9 \u2013 \u0ba4 \u0b9a\u0bbf\u1fbf\u0bb5\u0bbe \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 125, \u0bb5\u0b9f\u1fb0\u1f81 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bae\u0bbf\u0bbe\u0bbf\u1fc4\u0bb8\u1fb9\u0bc6\u0b95\u0bbe\u1f8c\u0bb5, \u1fa4\u1f8e\u0bb5\u0bbf\u0bb2 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bb5\u1fbd\u0ba3\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0bc8\u0bae\u0b95\u1fbf \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0bae\u1fbe\u1fa0\u1fbb \u1f81\u0bb2\u1fba\u1f97\u0bb5\u1f8c\u0bc7\u0b95 \u0b9a\u0bae\u1fb9 \u0bc7\u0baa\u0bae\u1f81\u0bae\u0bbe\u1fbd \u0ba4 \u0b9a\u0bbf\u1fbf\u0bb5\u0bbe \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90,\n\n53 A\n\nIII \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u0dd9\u0d9a\u0003\u0d