a\u0bbf\u1fb9 \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u1fbf \u0baa\u0bbf\u0bb0\u1f86\u0bb0\u0bae\u0bbe\u0ba9 \u0b9a\u1fba\u0bb0\u0b95\u1f99\u0bb5 \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u1fb7\u0ba4\u0bbf\u1fbf, \u0b87\u0bb0\u1fb7\u0ba4\u0bbf\u0ba9\u1f97\u0bbe\u0bbf \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0baa\u0bb2\u0bbe\u1fb1\u0bc6\u0b95\u0bbe\u0bc8\u0b9f \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf 256\u0b9a\u0bbf - \u1f90\u1fbb\u0baa\u0bc6\u0b95\u0bbe\u0b9f \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u0baa\u1fbf\u0bc6\u0bb2\u0bc6\u0bb5\u0bb2 \u0b8e\u1f94\u1fbb \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf, 620086 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 02 \u0b87\u1fbf 133 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8a\u1fb9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b85\u1fc2\u0bb5\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf,\n\n\u201c\u0b95\u0bbe\u0ba3\u0bbf \u0bb5\u0bb4\u1fb0\u0b95\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0b9f\u0baa\u1fb5\u0b9f\u0ba4\u0bbe \u0b88\u1f8c \u1f81\u1fb7\u0ba4\u0bc8\u0b95 \u0ba4\u1f8c\u1fba\u1f97\u1fb0 \u0b95\u1fb5\u0b9f\u0bc8\u0bb3 \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0\u201d \u0b8e\u1f94\u1fbb \u0ba8\u0bbf\u0bb0\u1fa2\u1fbf \u201c620086/02/135 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf\n\n\u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90\u201d \u0b8e\u1fb9\u1fa0 \u0b89\u1fc0\u0bb3\u0b9f\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c \u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fba\u0baa\u1f8c