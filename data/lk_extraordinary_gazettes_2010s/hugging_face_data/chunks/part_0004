u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf, \u0b87\u0bb2. 110 - \u0baa\u1fc0\u0bb3\u0bbf\u0baf\u0bc6\u0b95\u0bbe\u0bc6\u0b9f\u1fbf\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u0baa\u1fc0\u0bb3\u0bbf\u0baf\u0bc6\u0b95\u0bbe\u0bc6\u0b9f\u1fbf\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\u1f90\u1fbb 120084 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 05 \u0b87\u1fbf \u0b85\u0b9f\u1fb1\u0b95\u0bbf\u1f9c\u1fc0\u0bb3\u1f90\u0bae\u0bbe\u0ba9 132, 138 \u0bae\u1fbe\u1fa0\u1fbb 324 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb1\u0b95\u0bc8\u0bb3\u1fb0 \u0bc6\u0b95\u0bbe\u1fb6\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u1fa6\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb7 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b87\u0ba4\u0bc7\u0ba9\u0bbe\u1f8c \u0b87\u0bc8\u0ba3\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf \u0ba4\u0bb0\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b8e\u0ba9\u1f90 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0b87\u1fb7\u0ba4\u0bbe\u1fbf \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u1f90\u0b95\u0bbf\u1fb9\u0bc7\u0bb1\u1fb9.\n\n\u0baa\u0bbf.\u0b8e\u1fbb.\u0b8e\u1fb2. \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u1fbd\u0bb7\u0ba9\u0bbf, \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd. (\u0b95\u0b9f\u0bc8\u0bae\u0bc8\u0baf \u0b95\u0bb5\u0ba9\u0bbf\u1fb7\u0ba4\u1fbf)\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf\u1fb7 \u0ba4\u0bbf\u0bc8\u0ba3\u1fb0\u0b95\u0bb3\u1fbb, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4 \u0bc6\u0bae\u1f90\u0bb0\u201d, \u0b87\u0bb0\u0b9c\u0bae\u1fbf\u0bb5\u1fb7\u0ba4 \u1faa\u0ba4\u0bbf, \u0baa\u1fb7\u0ba4\u0bb0\u1f99\u1fbf\u0bc8\u0bb2. 2016 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0b9a\u0ba9\u0bb5\u0bbe\u0bbf \u0bae\u0bbe\u0ba4\u1fbb 15 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf.\n\n\u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\n\n132 0.1932 \u0ba4\u0bbf\u0b9a\u0bbe\u0ba8\u0bbe\u0baf\u0b95 \u0bc6\u0b95\u0ba4\u0bb0 \u0b9c\u0baf\u0ba4\u0bbf\u0bb2\u0b95 683533890v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a.\u0ba4\u0bbf\u1fb9 \u1f92\u0b95\u0bc6\u0b9a\u0bb5\u0ba9 \u0bc6\u0baa\u0bbe\u1fa0\u1fba\u1f97, \u0baf\u0bbe\u0baf 08 \u0b9a\u1fb8\u0ba4\u0bbf, \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9 \u0bae\u0bb9\u0ba4\u0bb2\u0bbe\u0bc6\u0b95\u0bbe\u0bb2\u0bc6\u0bb5\u0bb5 - \u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 138 0.6627 \u0baa\u1fb9\u0b9a\u0bb2 \u0bb5\u1fb7\u0bc7\u0ba4 \u0bc6\u0b95\u0ba4\u0bb0 \u0bc6\u0baa\u0bbe\u1f8a 582221081v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a.\u0ba4\u0bbf\u1fb9 \u0b85\u1fba\u1f97\u0bb9\u0bbe\u0bae\u0bbf \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9 \u1f92\u0b95\u0bc6\u0b9a\u0bb5\u0ba9 \u0bc6\u0baa\u0bbe\u1fa0\u1fba\u1f97, \u0baf\u0bbe\u0baf 08 \u0b9a\u1fb8\u0ba4\u0bbf, - \u0b95\u1fa6\u1fb0\u1f81 \u0ba4\u1fbb\u0bc7\u0b9a\u0bbe\u1f97\u0bb0 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 324 0.2346 \u0bc6\u0baa\u0bbe\u1fbf\u0bb5\u1f90\u0bc7\u0bb0 \u0bc6\u0b95\u0ba4\u0bb0 \u0b9a\u1fb8\u0ba4\u0ba9 \u1f81\u0bae\u0bbe\u0bb0 801990940v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a.\u0ba4\u0bbf\u1fb9 \u0b87\u0bb2. 68/1, \u0ba4\u1fbb\u0bc7\u0b9a\u0bbe\u1f97\u0bb0, \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9 \u0bae\u0bb9\u0ba4\u0bb2\u0bbe\u0bc6\u0b95\u0bbe\u0bb2\u0bc6\u0bb5\u0bb5 - \u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 09 - 590/ 9"
