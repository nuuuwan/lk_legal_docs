b5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 20 \u2013\n\n\u0b87\u0bb2. 88\u0b8e, \u0ba8\u0baf\u0bbf\u0bc6\u0ba4\u0bc6\u0b95\u0bb5\u1fb7\u0ba4, \u0baf\u1f8a\u0baf\u0ba9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf\n\n\u1faa\u0ba4\u0bbf, \u0bc7\u0bb5\u0bb0\u1f90\u0bb5, \u0bae\u0bbe\u1fb7\u0ba4\u0bc8\u0bb1 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90.\n\n19 0.0420 \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9 \u0b95\u0bae\u0bc7\u0b95 \u0b9a\u0bbf\u1fb7\u0bb0\u0bbe \u0ba8\u1fb8\u0ba4\u0ba9\u0bbf 588431975v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 20 \u2013\n\n\u0b87\u0bb2. 88\u0b8e, \u0ba8\u0baf\u0bbf\u0bc6\u0ba4\u0bc6\u0b95\u0bb5\u1fb7\u0ba4, \u0baf\u1f8a\u0baf\u0ba9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf\n\n\u1faa\u0ba4\u0bbf, \u0bc7\u0bb5\u0bb0\u1f90\u0bb5 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90.\n\n22 0.0539 \u0baa\u1fbf\u1fa2 \u1f99\u1fbf\u0bc7\u0bb2 \u0bc7\u0bb9\u0bb5\u0bbe \u0b95\u0bc0\u0b95\u0ba9\u0bc7\u0b95 \u1f86\u1f97\u1fbf 603161211v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013\n\n\u0b9a\u0bb0\u1fb7 \u0bb0\u1fb7\u0ba9\n\n\u0bb5\u0bbf\u0b9c\u0baf \u1f81\u0bae\u0bbe\u0bb0\u1f90\u1fb1\u0b95 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4,\n\n\u0bc7\u0bb5\u0bb0\u1f90\u0bb5, \u0bae\u0bbe\u1fb7\u0ba4\u0bc8\u0bb1\n\n29 0.0485 \u0bb5\u0bbf\u0ba9\u0bbf\u0bb7\u0bbf\u0baf\u0bbe \u0bc6\u0bb9\u1fb9\u0bbe\u0bbf\u0baf\u0b9f\u0bbe \u0bb5\u0bbf\u0bc7\u0b9c\u0b9a\u0bbf\u1fb1\u0bb9 497421322v\u1f99\u1fa8\u0bb5\u1f90\u1fbb1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013\n\n\u0b87\u0bb2. 82/5, \u0ba8\u0baf\u0bbf\u0bc6\u0ba4\u0bc6\u0b95\u0bb5\u1fb7\u0ba4,\n\n\u0bc7\u0bb5\u0bb0\u1f90\u0bb5, \u0bae\u0bbe\u1fb7\u0ba4\u0bc8\u0bb1\n\n116 0.0258 \u1f86\u0b9c\u0bbf\u1fb7 \u0bae\u0bb9\u0bbf\u1fb8\u0ba4 \u1faa\u0bb0\u0b9a\u0bbf\u0bbe\u0bbf 693372593v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f9