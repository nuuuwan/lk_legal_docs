    "chunk_text": "\u027c \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u0db6\u0dc3\u0dca\u0db1\u0dcf\u028f\u0dbb \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0d9c\u023c\u0db4\u0dc4 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0d85\u01ae\u0dad\u0db1\u0d9c\u0262\u0dbd \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u01b1\u0dc5 \u0d85\u0dbd\u0dc0\u0dbd \u0dc3\u0dc4 \u0d87\u0dad\u0dcf\u0d8b\u0da9\u0d9a\u01e6\u0daf \u0dba\u0db1 \u0d9c\u023c\u0dc0\u0dbd \u0218\u028f\u0179 \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 103, 104, 107, 110, 111, 112, 113, 115, 116, 120, 124, 129, 131, 138, 140, 141, 145, 147, 149,151, 153,156, 158, 159, 163, 165, 169, 172, 184, 187, 194, 197, 198, 202, 204, 208, 209, 212, 214, 217, 219 \u0dc3\u0dc4 \u0219.\u0219. \u0d9c\u023c 3516 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 01, 03 \u0dba\u0db1 \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0d92\u0d9a\u0dcf\u0db6\u01ca\u0db0 \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219.96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 106, 108, 130, 155, 160, 188, 190 \u0dc3\u0dc4 \u0d85\u0d82\u0d9a 225041 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0218\u0249\u0dd9\u0259 \u0dd9\u0daf\u0262\u0d9c\u0dc4\u0dd9\u0dc4\u02a2\u0db1 \u0db1\u0dd0\u0db8\u01af \u0dd9\u014e.\u0219. \u0d94\u0dd9\u0229\u0dd9\u0dc3\u02a2\u0d9a\u0dbb \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d89\u0da9\u0db8 \u0daf, \u0d85\u0d82\u0d9a 225040 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0218\u0249\u0dd9\u0259 \u0db4\u0dbb\u0d9c\u0dc4\u0dd9\u0dc4\u02a2\u0db1 \u0db1\u0dd0\u0db8\u01af \u0dd9\u014e.\u0219. \u0d94\u0dd9\u0229\u0dd9\u0dc3\u02a2\u0d9a\u0dbb \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d89\u0da9\u0db8 \u0daf, \u0d85\u0d82\u0d9a 225042 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0218\u0249\u0dd9\u0259 \u0d8a\u025c\u0dba\u0d9c\u0dc4\u0dd9\u0dc4\u02a2\u0db1 \u0db1\u0dd0\u0db8\u01af \u0dd9\u014e.\u0219. \u0d94\u0dd9\u0229\u0dd9\u0dc3\u02a2\u0d9a\u0dbb \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d89\u0da9\u0db8 \u0daf \u0dba\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0dc4\u0dd0\u0dbb \u023f\u029a \u022a\u023c \u021d\u0db8\u0dcf\u0dab\u0dba \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 320.758 \u00fa \u026d \u026a\u0dc1\u0dcf\u0dbd\u01ae\u0dc0\u0dba\u00fa \u0d87\u01af \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0db8\u0dcf\u0250\u023c\u0dc0\u0263\u01e6 \u0252\u00fa\u0dad \u026d \u0dbb\u0da2\u0dd9\u024f \u0d89\u0da9\u023c \u021d\u0db8\u0dcf\u0dab\u0dba \u0dd9\u0269. \u0d8b\u01b1\u0dbb\u0da7 : \u0dc3\u0db6\u0dbb\u0d9c\u023f\u0dc0 \u0db4\u0dc5\u0dcf\u01ae \u0db8\u0dcf\u0250\u0db8 (\u0db4\u0dbb\u0db1\u0dcf\u0dad\u0dbd \u0d9c\u0db8) \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 168 \u0daf, \u0dc3\u0db6\u0dbb\u0d9c\u023f\u0dc0 \u0db4\u0dc5\u0dcf\u01ae \u0db8\u0dcf\u0250\u0db8 (\u0d8b\u018d\u0dc0\u0d9a \u0d9c\u0db8) \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 109 \u0daf, \u0d91\u0db8 \u0218\u0249\u0dd9\u0259\u0db8 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 31 \u0dc4\u0dcf 32 \u0daf\u0dbb\u0db1 \u0d92. \u0dd9\u0dc3\u02a2\u01b1\u0dc4\u0dcf\u023d \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0db9\u0d9c\u0dc4\u0dc0\u01ae\u0dad \u0db1\u0db8\u01af \u0d89\u0da9\u023c \u0daf \u0d85\u0d82\u0d9a 16926 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 01 \u0dc3\u0dc4 02 \u0daf ; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7 : \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 33 \u0daf\u0dbb\u0db1 \u0d92. \u0db6\u019c\u0da9\u0217\u021a \u0dc4\u0dcf \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0219\u0262\u0dd9\u0262 \u00fd\u0249\u0dbb \u0dc3\u0dc4 \u0d92.\n\n4 A\n\nI \u0dd9\u0d9a\u02a3\u0da7\u0dc3 : (I) \u0dd9\u0da1\u0daf\u0dba - \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba - 2019.11.20\n\n\u027c \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0da2\u0dd9\u024f \u023f\u01d6\u0dab \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dd9\u0269 \u023f\u01d6\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u01cf.\n\n\u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba 02\n\n\u027c \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u0db6\u0dc3\u0dca\u0db1\u0dcf\u028f\u0dbb \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0d9c\u023c\u0db4\u0dc4 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0d85\u01ae\u0dad\u0db1\u0d9c\u0262\u0dbd \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u01b1\u0dc5 \u0d85\u0dbd\u0dc0\u0dbd \u0dba\u0db1 \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 174, 182 \u0dba\u0db1 \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0d92\u0d9a\u0dcf\u0db6\u01ca\u0db0 \u023f\u029a \u022a\u023c \u021d\u0db8\u0dcf\u0dab\u0dba \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0dbb 35.787 \u00fa \u026d \u026a\u0dc1\u0dcf\u0dbd\u01ae\u0dc0\u0dba\u00fa \u0d87\u01af \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0db8\u0dcf\u0250\u023c \u01b1\u0dc5 \u0218\u028f\u0179 \u0dbb\u0da2\u0dd9\u024f \u0d89\u0da9\u023c \u021d\u0db8\u0dcf\u0dab\u0dba \u0dd9\u0269.\n\n\u0d8b\u01b1\u0dbb\u0da7 : \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 173 \u0daf\u0dbb\u0db1 \u0dd9\u0daf\u02a3\u023c\u0d9c\u0dc4\u0dd9\u0dc4\u02a2\u0db1 \u0d87\u0dc5 \u0dd9\u0dc4\u0dc0\u01ae \u0d9a\u01e6\u0dd9\u0daf \u00fd\u0249\u0dbb \u0d87\u0dc5 \u0daf, \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 43 \u0daf, \u0d85\u0d82\u0d9a 19953 \u0daf\u0dbb\u0db1 \u0240\u0263\u0d9a \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 43 \u0daf, \u0d85\u0d82\u0d9a 19953 \u0daf\u0dbb\u0db1 \u0240\u0263\u0d9a \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 06 \u0daf, \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 42 \u0daf; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7 : \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 95, 94 \u0dc4\u0dcf 45 \u0daf, \u0d87\u0daf\u0dc5\u0daf \u0dd9\u0daf\u02a3\u023c\u0d9c\u0dc4\u0dd9\u0dc4\u02a2\u0db1 \u0d87\u0dc5 \u0daf, \u0dc0\u0dbd\u0dbb\u023c\u0db6\u0dcf \u0db1\u0dd0\u0db8\u01af \u0d91\u023c."
