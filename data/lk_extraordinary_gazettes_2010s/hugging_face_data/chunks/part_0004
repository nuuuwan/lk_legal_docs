b5\u0b9f\u1fb7\u0ba4\u0bbf\u0ba9\u0bbe\u1fa4\u1fbb 1995 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 23 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u0ba9\u0bbe\u1fa4\u1fbb 2009 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 65 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u0ba9\u0bbe\u1fa4\u1fbb \u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fba\u0baa\u1fb5\u0b9f\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 1966 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 13 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u0ba9\u0bbe\u1fa4\u1fbb (451 \u0b86\u0bb5\u1f90 \u0b85\u1fb7\u0ba4\u0bbf\u0baf\u0bbe\u0baf\u1fbb) \u0b95\u0bbe\u1f8c \u0bc7\u0baa\u0ba3\u1fbe \u0b95\u1fb5\u0b9f\u0bc8\u0bb3\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 64. (1) \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b9f\u1fb9 \u0bc7\u0b9a\u1fbd\u1fb7\u1f90 \u0bb5\u0bbe\u0b9a\u0bbf\u1fb0\u0b95\u1fba\u0baa\u0b9f\u0bc7\u0bb5\u1fb6\u1f8a\u0baf 3. \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u0bb4\u0bbe\u0ba9 \u0b95\u1fb5\u0b9f\u0bc8\u0bb3.\n\n\u0b95\u1fb5\u0b9f\u0bc8\u0bb3\n\n\u0b87\u0bb2\u1fb1\u0bc8\u0b95\u1fb2 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u1fb0 \u1f81\u1f8a\u0baf\u0bb0\u0b9a\u0bbf\u1fb9 \u0b85\u0bb0\u0b9a\u0bbf\u0baf\u0bb2\u0bc8\u0bae\u1fba\u0baa\u0bbf\u1fb9 19 \u0b86\u0bb5\u1f90 \u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fb7\u0ba4\u0bbf\u1fb9 51 \u0b86\u0bb5\u1f90 \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b9f\u1fb9 \u0bc7\u0b9a\u1fbd\u1fb7\u1f90 \u0bb5\u0bbe\u0b9a\u0bbf\u1fb0\u0b95\u1fba\u0baa\u0b9f\u0bc7\u0bb5\u1fb6\u1f8a\u0baf 1979 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 56 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u0ba9\u0bbe\u1fa4\u1fbb 1982 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 13 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u0ba9\u0bbe\u1fa4\u1fbb 1988 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 84 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u0ba9\u0bbe\u1fa4\u1fbb 1995 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 23 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u0ba9\u0bbe\u1fa4\u1fbb 2009 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 65 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u0ba9\u0bbe\u1fa4\u1fbb \u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fba\u0baa\u1fb5\u0b9f\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 1966 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 13 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u0ba9\u0bbe\u1fa4\u1fbb (451 \u0b86\u0bb5\u1f90 \u0b85\u1fb7\u0ba4\u0bbf\u0baf\u0bbe\u0baf\u1fbb) \u0b95\u0bbe\u1f8c \u0bc7\u0baa\u0ba3\u1fbe \u0b95\u1fb5\u0b9f\u0bc8\u0bb3\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 3. \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b8e\u0ba9\u1fb0\u1f81 \u0b85\u0bb3\u0bbf\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f \u0ba4\u1fb7\u1f90\u0bb5\u1fb1\u0b95\u0bb3\u0bbf\u1fb9 \u0baa\u0baf\u0bc8\u0ba9\u1fb0\u0bc6\u0b95\u0bbe\u1fb6\u1f8c \u0b9a\u0ba9\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u0bc8\u0bae\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf\u0baa\u0bbe\u0bb2 \u0b9a\u0bbf\u0bb1\u0bbf\u0bc7\u0b9a\u0ba9 \u0b86\u0b95\u0bbf\u0baf \u0ba8\u0bbe\u1fb9, \u0b95\u0bc0\u1fc1 \u0b87\u0bc8\u0ba3\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3 01, \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3 02, \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3 03, \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3 04 \u0bae\u1fbe\u1fa0\u1fbb \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3 05 \u0b8e\u1fb9\u0baa\u0bb5\u1fbe\u0bb1\u0bbf\u1fbf \u0bb5\u0bc8\u0bb0\u0baf\u1fa0\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0b8e\u1fbf\u0bc8\u0bb2\u0b95\u1fa6\u1fb0\u1f81\u1fc0 \u0b89\u1fb5\u0baa\u1fb5\u0b9f 27.542 \u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u0bbe\u1fbd \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fb7\u0bc8\u0ba4\u1fb0 \u0bc6\u0b95\u0bbe\u1fb6\u0b9f \u0b95\u1fb6\u1f8a\u0bb2\u1f8a\u0bb5\u0bbe\u0b