4\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 145 0.0247 \u0bb5\u0bbf\u0bb9\u0bbe\u0bb0\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 77 \u0b87\u1fb9 \u2013 \u0ba8\u0bbf\u1fb7\u0ba4\u0bc6\u0bb5\u0bb2 \u0bb0\u0b9c\u0bae\u0bb9\u0bbe \u0bb5\u0bbf\u0bb9\u0bbe\u0bb0, \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0ba8\u0bbf\u1fb7\u0ba4\u0bc6\u0bb5\u0bb2, \u0b95\u1fb6\u1f8a \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u1fbe\u1fa0\u1fbb 2017/09/01 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0bc6\u0ba4\u0bbe\u0b9f\u1fb0\u0b95\u1fbb 22 \u0bb5\u1f9e\u0b9f\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b87\u0bb2. 47/16, \u0ba8\u0bbe\u0b95\u0bb9\u0b86\u1fbf\u0bb2 \u1faa\u0ba4\u0bbf, \u0bae\u0bbe\u0bb5\u0bbf\u1fbf\u0bae\u0b9f, \u0b95\u1fb6\u1f8a \u0bb5\u0b9a\u0bbf\u1fb0\u1f81\u1fbb \u0b85\u0bc6\u0baa\u0b9a\u0bbf\u1fb1\u0bb9 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u1f97\u1fb9\u0baf\u0bb5\u0ba4\u0bc0 \u0bc6\u0bae\u0ba9\u0bbf\u0bc7\u0b95 \u0b8e\u1fb9\u0baa\u0bb5\u1f9e\u1fb0\u1f81 \u1f81\u1fb7\u0ba4\u0bc8\u0b95\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 146 0.0316 \u0bb5\u0bbf\u0bb9\u0bbe\u0bb0\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b87\u0bb2. 8681 \u0bae\u1fbe\u1fa0\u1fbb \u2013 \u0ba8\u0bbf\u1fb7\u0ba4\u0bc6\u0bb5\u0bb2 \u0bb0\u0b9c\u0bae\u0bb9\u0bbe \u0bb5\u0bbf\u0bb9\u0bbe\u0bb0, 2010/09/01 \u0ba8\u0bbf\u1fb7\u0ba4\u0bc6\u0bb5\u0bb2, \u0b95\u1fb6\u1f8a \u0b87\u0bb2. 47/15, \u0ba8\u0bbe\u0b95\u0bb9\u0b86\u1fbf\u0bb2 \u1faa\u0ba4\u0bbf, \u0bae\u0bbe\u0bb5\u0bbf\u1fbf\u0bae\u0b9f, \u0b95\u1fb6\u1f8a \u0bb5\u0b9a\u0bbf\u1fb0\u1f81\u1fbb \u1f90\u1fbc\u0baf\u0bbe\u1f90\u0bb0 \u0b95\u0bbf\u0bbe\u0bbf\u0bb8\u0bbe\u1fb8\u0ba4\u0bbf \u0ba4 \u0b9a\u0bbf\u1fbf\u0bb5\u0bbe \u0b8e\u1fb9\u0baa\u0bb5\u1f9e\u1fb0\u1f81 \u1f81\u1fb7\u0ba4\u0bc8\u0b95\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 147 0.0004 \u0bb5\u0bbf\u0bb9\u0bbe\u0bb0\u0bbe\u0ba4\u0bbf\u0baa\u0ba4\u0bbf \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0ba8\u0bbf\u1fb7\u0ba4\u0bc6\u0bb5\u0bb2 \u0bb0\u0b9c\u0bae\u0bb9\u0bbe \u0bb5\u0bbf\u0bb9\u0bbe\u0bb0, \u0ba8\u0bbf\u1fb7\u0ba4\u0bc6\u0bb5\u0bb2, \u0b95\u1fb6\u1f8a 150 0.0226 \u0b85\u0bc6\u0baa\u0b9a\u0bbf\u1fb1\u0bb9 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0b9c\u0bbe\u0ba9\u0b95 680931267v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u1fb6\u1f8a, \u2013 \u0b85\u0bc6\u0baa\u0b9a\u0bbf\u1fb1\u0bb9 \u0bae\u1fb0\u0b95\u1fc0 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fb9 \u0b87\u0bb2. 47/5 \u0b88, \u0ba8\u0bbe\u0b95\u0bb9\u0b86\u1fbf\u0bb2 \u1faa\u0ba4\u0bbf, \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0bae\u0bbe\u0bb5\u0bbf\u1fbf\u0bae\u0b9f, \u0b95\u1fb6\u1f8a 154 0.0125 \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1fbd \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe. \u0b87\u0bb2. 150, 151, 152 \u0bae\u1fbe\u1fa0\u1fbb 153 \u1fbe\u1f81 \u0baa\u0bbf\u0bb0\u0bc7\u0bb5\u0b9a\u0bbf\u1fba\u0baa- \u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 155 0.0015 \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1fbd \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe. \u0b87\u0bb2.156 \u0bae\u1fbe\u1fa0\u1fbb 157 \u0b87\u1fb9 \u0bb5\u1f8a\u0b95\u0bbe\u