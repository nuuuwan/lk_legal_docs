2014\u2014-\n\n197 0.0474 \u0b8f\u1fb0\u0b95\u0ba8\u0bbe\u0baf\u1fb0\u0b95 \u1f90\u0ba9\u0bbe\u0b95\u0bb0 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 583122893v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 257 \u2013 \u0bb5\u0bbf\u0b9c\u0bbf\u0ba4 \u0baa\u1fb6\u0b9f\u0bbe\u0bb0 \u0bc6\u0baa\u0ba4\u0bbf\u0baf\u0bbe\u0bc6\u0b95\u0bbe\u0b9f \u0bae\u1fbe\u1fa0\u1fbb 196 \u0b87\u0bb2. 19/1, \u0baa\u0bbf\u0bb2\u0baa\u0bbf\u1f8a\u0baf, \u0b86\u0b95\u0bbf\u0baf\u0ba9 \u0b95\u0bbf\u0bbe\u0bbf\u0baa\u1fb7\u1f81\u1fbb\u1f97\u0bb0 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 256 0.0357 \u0bb7\u0bbe\u0bae\u1fa3 \u0b85\u0bc7\u0ba9\u0bbe\u0bae\u0bbe \u0bc6\u0baa\u0ba4\u0bbf\u0baf\u0bbe\u0bc6\u0b95\u0bbe\u0b9f 556640998v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 196 \u2013 \u0b87\u0bb2. 41\u0b8f, \u0bc8\u0bae\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bae\u1fbe\u1fa0\u1fbb 257 \u0bb5\u0b9f\u1f97\u1fa4\u0bb5, \u0b95\u1fb6\u1f8a \u0b86\u0b95\u0bbf\u0baf\u0ba9 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 257 0.0296 \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1fbd \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2.256, 258, 259, 260, 261, 262, 263 \u0bae\u1fbe\u1fa0\u1fbb 264 \u1fbe\u1f81 \u0baa\u0bbf\u0bb0\u0bc7\u0bb5\u0b9a\u0bbf\u1fba\u0baa\u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 258 0.0358 \u0baa\u0bbe\u1fa2\u1fb7\u0ba4 \u0b9c\u0b95\u1fb7 \u0baa\u1fb6\u0b9f\u0bbe\u0bb0 \u0bc6\u0baa\u0ba4\u0bbf\u0baf\u0bbe\u0bc6\u0b95\u0bbe\u0b9f 563140526v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 196 \u2013 \u0b87\u0bb2. 89/53\u0b8e\u1fba, \u0bc7\u0bb2\u1fb5 \u0bc7\u0b95\u0bbe\u1fbd\u1fb5\u1fb9\u1fc4 \u0bae\u1fbe\u1fa0\u1fbb 257 \u1faa\u0ba4\u0bbf, \u0b95\u1fb6\u1f8a \u0b86\u0b95\u0bbf\u0baf\u0ba9 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 259 0.0353 \u0b8f\u1fb0\u0b95\u0ba8\u0bbe\u0baf\u1fb0\u0b95 \u1f90\u1f94\u0b95\u0bb0 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 617923726v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 196 \u2013 \u0b9a\u1fb8\u0ba4\u0bbf\u0bbe\u0bbf\u0b95\u0bbe \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0bbe\u0ba9\u0bbf \u0bc6\u0baa\u0ba4\u0bbf\u0baf\u0bbe\u0bc6\u0b95\u0bbe\u0b9f \u0bae\u1fbe\u1fa0\u1fbb 257 \u0b87\u0bb2. 37/6, \u1f97\u0ba4\u0bbf\u0baf \u0bc8\u0bb5\u1fb7\u0ba4\u0bbf\u0baf\u0b9a\u0bbe\u0bc8\u0bb2 \u1faa\u0ba4\u0bbf, \u0b86\u0b95\u0bbf\u0baf\u0ba9 \u0baa\u1f99\u1f94\u0bb5, \u0bae\u0bb9\u0bb0\u0b95\u0bae \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 260 0.0357 \u0bb7\u0bbe\u0bae\u1fa2 \u0b85\u0bc7\u0ba9\u0bbe\u0bae\u0bbe \u0bc6\u0baa\u0ba4\u0bbf\u0baf\u0bbe\u0bc6\u0b95\u0bbe\u0b9f 556640998v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe\u0ba3\u0bbf \u0b87\u0bb2. 196 \u2013 \u0b87\u0bb2. 41\u0b8f, \u0bc8\u0bae\u1fb7\u0ba4\u0bbf\u0bbe\u0bbf \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0bae\u0bb9\u0bc6\u0bb5\u1fa2 \u0bae\u1fbe\u1fa0\u1fbb 257 \u0b89\u0baf\u0ba9, \u0baa\u0b9f\u1f97\u1fa4\u0bb5, \u0b95\u1fb6\u1f8a \u0b86\u0b95\u0bbf\u0baf\u0ba9 \u0b85\u1f94\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 261 0.0361 \u0bae\u0bb9\u0bbf\u1fb8\u0ba4 \u0bc7\u0ba4\u0b9c\u0bbe \u0baa\u1fb6\u0b9f\u0bbe\u0bb0 \u0bc6\u0baa\u0ba4\u0bbf\u0baf\u0bbe\u0bc6\u0b95\u0bb