2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014-- 133 0.0212 \u0b95\u1f8c\u0ba9\u0bbe\u0baf\u0b95\u0bc7\u0b95 \u0baa\u0bbf\u1f9c\u0bae\u0bbf \u0ba4\u0bbf\u1f95\u0bb7\u0bbe 816620082v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u1f8c\u0ba9\u0bbe\u0baf\u0b95\u0bc7\u0b95 \u2013 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0bc6\u0bb2\u0ba9\u0bbe\u1fb5 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b87\u0bb2. 459, \u0bc6\u0bae\u1fb7 \u0ba8\u0bbf\u0bb5\u0bbe\u0bb7 \u1f99\u1fb9\u0baa\u0bbe\u0b95, \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 131 \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 134 0.0240 \u0b95\u1f8c\u0ba9\u0bbe\u0baf\u0b95\u0bc7\u0b95 \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u1fb1\u0b95\u0ba9\u0bc0 \u0bb2\u0bbe\u0bb2\u0ba9\u0bc0 745632408v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u1f8c\u0ba9\u0bbe\u0baf\u0b95\u0bc7\u0b95 \u2013 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0bc6\u0bb2\u0ba9\u0bbe\u1fb5 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b87\u0bb2. 459, \u0bae\u0b9f\u0bae \u1faa\u0ba4\u0bbf, \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 131 \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 143 0.0346 1. \u0bae\u0bc6\u0b9a\u1fc2\u0bc7\u0b95 \u0b9c\u0bc2\u1fb5 \u1f86\u0ba4\u1fb7 \u0bc6\u0bb0\u0bbe\u0bb9\u0bbe\u1fb9 661882018v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 145 \u0b87\u1fb9 \u2013 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0b9a\u0bae \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf 2. \u0bae\u0bbf\u0bb9\u0bbf\u1fb8\u1f90\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf \u0bae\u0bbe\u0bc6\u0ba9\u1fbf 646902932v \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0baa\u1fbd\u0ba9\u0bc6\u0ba4\u1fb7 \u0bc6\u0baa\u1fbd\u0ba9\u0bbe\u1fb6\u0bc7\u0b9f\u0bbe \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 \u0b87\u0bb2. 460/1, \u0bc6\u0bae\u1fb7 \u0ba8\u0bbf\u0bb5\u0bbe\u0bb7 \u1f99\u1fb9\u0baa\u0bbe\u0b95, \u0bae\u0b9f\u0bae \u1faa\u0ba4\u0bbf, \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 146 0.0515 \u0ba8\u0b9f\u0bb0\u0bbe\u0b9c\u0bbe \u1f8a\u0bb2\u0bbe\u1fb9 \u0b9a\u1fb4\u0b9c\u0bc0\u0bb5\u1fb9 852461993v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 145 \u0b87\u1fb9 \u2013 \u0b87\u0bb2. 459 \u1f8b, \u0bae\u0b9f\u0bae \u1faa\u0ba4\u0bbf, \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc6\u0bb5\u1fb9\u0ba9\u1fba\u1f97\u0bb5 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bc6\u0baa\u0bbe\u0ba4\u0bbf\u0bc6\u0baa\u1fbf\u0baa\u1fb9\u1f8a\u0ba4\u1fbd \u0bb2\u1fa2\u0ba4\u0bbe\u0bae\u0ba9\u0bbf \u0b85\u1fbf\u0bb2\u1f90 \u0bc6\u0baa\u0bbe\u0ba4\u0bbf \u0baa\u0bbe\u1fbf \u0bb2\u1fa2\u0ba4\u0bbe\u0bae\u0ba9\u0bbf \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 153 0.0057 \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1fbd \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe. \u1f90. \u0b87\u0bb2. 152 \u0bae\u1fbe\u1fa0\u1fbb 154 \u1fbe\u1f81 \u