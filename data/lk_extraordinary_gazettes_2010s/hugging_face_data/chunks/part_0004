u1fbd/ \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0 \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb0\u1f81\u0bbe\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u0ba9\u1f90 \u0b89\u1fb5\u0baa\u1fb5\u0b9f \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1f9e\u1fb0 \u1f90\u1fb6\u1f8a\u1fb9 \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0b95\u0bbe\u0bb0\u1fbd\u0b95\u0bb3\u0bbf\u1fb9 \u1f99\u1fa8\u1fba \u0bc6\u0baa\u0baf\u1fbd\u0b95\u1fa6\u1fbb \u0b85\u0bc8\u0b9f\u0baf\u0bbe\u0bb3 \u0b87\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 \u0bb5\u1f81\u1fba\u1f97\u1fbb \u0b88\u1f8c, \u1f81\u1fb7 \u1f81\u0bbe\u0bbf\u0baf \u0b9a\u1fb5\u0b9f\u1fb1 \u0b87\u0bb2. \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u1f9c\u1fbb \u0b85\u1fb5\u0bc8\u0b9f \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0b87\u0baf\u1fbf\u1f97\u1fbb \u0ba4\u0bc8\u0b95 \u0b95\u1fa6\u1fc0 \u0b8e\u1fc2 (\u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u0bbe\u1fbd) \u0b87\u0bb2. \u0ba4\u1f8c\u1fba\u1f97\u1fb0 \u0bb5\u0bc8\u0b95\u1fb0\u1f81\u1fbb \u0b95\u1fb5\u0b9f\u0bc8\u0bb3 \u0b85\u0bc8\u0bae\u1fb8\u0ba4\u0bbf\u1f9e\u1fba \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0baa\u0bbf\u1fb9 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0 \u0b95\u1fc0\n\n503 2.0300 \u0bb0\u1fb8\u0bc6\u0ba4\u1fb5\u1f8a \u0bc7\u0baa\u1f8a\u0bc7\u0b95 \u0b95\u1f9e\u0ba3\u0bbe\u0bb5\u0ba4\u0bc0 337641318v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0baa\u0bbf\u0bbe\u0bbf\u1fb0\u0b95\u1fba\u0baa\u0b9f\u0bbe\u0ba4 \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a.\u0ba4\u0bbf\u1fb9 \u0b87\u0bb2. 77, \u0baf\u0bbe\u0baf 09, \u0b95\u1fb5\u1f8a\u0baf\u0bbe\u0bb5 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u1fbf \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9 \u0bc6\u0bb9\u1fb0.02 - \u0b95\u1fa6\u1fb0\u1f81 \u0b95\u0b95\u0baa\u0b9f\u0bb0\u0bbe\u0bb2\u0bb2\u0bbe\u0bc7\u0b95 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. \u1f81\u0ba3\u0ba4\u0bbf\u0bb2\u0b95 \u0b8e\u1fb9\u0baa\u0bb5\u1f9e\u1fb0\u1f81\u1fbb \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u1fbf \u0bc6\u0bb9\u1fb0.01 \u1f9f\u1fb5 02 \u0baa\u1fb1\u1f81 \u0b95\u0b95\u0baa\u0b9f\u0bb0\u0bbe\u0bb2\u0bb2\u0bbe\u0bc7\u0b95 \u0b86\u0bbe\u0bbf\u0baf\u0bb5\u0ba4\u0bc0 \u0b8e\u1fb9\u0baa\u0bb5\u1f9e\u1fb0\u1f81\u1fbb \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u1fbf \u0bc6\u0bb9\u1fb0.01 \u1f9f\u1fb5 02 \u0baa\u1fbd.04 \u0baa\u1fb1\u1f81 \u0b95\u0b95\u0baa\u0b9f\u0bb0\u0bbe\u0bb2\u0bb2\u0bbe\u0bc7\u0b95 \u0b9e\u0bbe\u0ba9\u0bb5\u0ba4\u0bc0 \u0b8e\u1fb9\u0baa\u0bb5\u1f9e\u1fb0\u1f81\u1fbb \u0bc6\u0baa\u1fbe\u1fa0\u1fb0\u0bc6\u0b95\u0bbe\u1fc0\u1fa6\u1fbb \u0baa\u0bbf\u1fb9\u1f94\u0bbe\u0bbf\u1fb7\u0ba4\u0bbe\u0bb3\u0bbf\u0b95\u0bb3\u0bbf\u1fb9 \u0bc6\u0baa\u0baf\u0bbe\u0bbf\u0b9f\u1fba \u0baa\u1fb5\u1f8c\u1fc0\u0bb3\u1f90. 555 0.1973 \u0bb0\u1fb8\u0bc6\u0ba4\u1fb5\u1f8a \u0bc7\u0baa\u1f8a\u0bc7\u0b95 \u0b95\u1f9e\u0ba3\u0bbe\u0bb5\u0ba4\u0bc0 337641318v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0b95\u0baa\u0b9f\u0bb0\u0bbe\u0bb2\u0bb2\u0bbe\u0bc7\u0b95 \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a. \u0b87\u0bb2. 77, \u0baf\u0bbe\u0baf 09, \u0b95\u1fb5\u1f8a\u0baf\u0bbe\u0bb5 \u0ba4\u0bbf\u0bb2\u0b95\u0bb0\u1fb7\u0ba9 \u0ba4\u0bbf\u1fb9 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9 \u0b8e\u1fb9\u0baa\u0bb5\u1f9e\u1fb0\u1f81 - \u0b95\u1fa6\u1fb0\u1f81 \u0bc6\u0b95\u0bbe\u0bb2\u0ba3\u0bbf \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. \u0b87\u1fbf\u0bb2\u1fbb \u0bae\u1fbe\u1fa0\u1fbb \u0baa\u1fbd\u0b9a\u1fc4 39 \u0b89\u1fbb \u1fa2\u0baf\u0ba9\u0bc6\u0b95\u0ba4\u0bb0 \u1f9e\u0bb5\u1fb9 \u0b85\u1f9e\u0ba3\u0b9c\u0bbf\u1fb7 \u1fa2\u0baf\u0ba9\u0bc6\u0b95\u0ba4\u0bb0 \u0b8e\u1fb9\u0baa\u0bb5\u1f9e\u1fb0\u1f81 \u0baa\u1fbd\u0b9a\u1fc4 39 \u0b89\u1fbb \u0bc6\u0baa\u1fbe\u1fa0\u1fb0\u0bc6\u0b95\u0bbe\u1fc0\u1fa6\u1fbb \u0baa\u0bbf\u1fb9\u1f94\u0bbe\u0bbf\u1fb7\u0ba4\u0bbe\u0bb3\u0bbf\u0baf\u0bbe\u0b95 \u0bc6\u0baa\u0baf\u0bbe\u0bbf\u0b9f\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3\u1f90.\n\n10 A III \u0dd9\u0d9a\u0003\u0da7\u0dc3 \u2013 \u0007 \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0dcf\u0dad\u0dcf\u000e\u000f\u0d9a \u0dc3\u0db8\