7\u0dad\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 18 \u01ce\u0db1,\n\n\u01e7\u0dba\u0db8\u0dcf\u0dc0\u0263\u0dba\n\n1. \u0dd9\u023c \u01e7\u0dba\u0db8\u0dcf\u0dc0\u0263\u0dba 2019 \u0d85\u0d82\u0d9a 03 \u0daf\u0dbb\u0db1 \u0ddb\u0dc0\u0daf\u0255 \u026a\u0daf\u0255\u0dcf \u0db4\u0dc1\u0dca\u0da0\u0dcf\u01ae \u0d8b\u0db4\u0dcf\u01dd \u0d86\u0dba\u0dad\u0db1\u0dba \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc4\u01ff\u01e6\u0dc0\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb, \u0d91\u0dba 2019 .09.09 \u01ce\u0db1 \u0286\u0da7 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0dc0\u01e6\u0dd9\u01e6 \u0dba.\n\n2. \u0dd9\u023c \u01e7\u0dba\u0db8\u0dcf\u0dc0\u0263\u0dba 2019 \u0d85\u0d82\u0d9a 2141/13 \u0daf\u0dbb\u0db1 \u0d85\u01af\u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf (\u0dd9\u0db8\u028f \u023d\u01e6 \u0db8\u01b1 \u201c\u0db4\u0db1\u0dad\u201d \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc3\u0daf\u0dc4\u01e6 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1) 1978 \u0d85\u0d82\u0d9a 16 \u0daf\u0dbb\u0db1 \u026a\u0dc1\u0dca\u0dc0\u026a\u0daf\u0255\u0dcf\u0dbd \u0db4\u0db1\u0dd9\u01ae 24\u0d85(1) \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0d85\u0db8\u0dcf\u0dad\u0255\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0dc3\u0dcf\u0daf\u01e9 \u0dbd\u0dd0\u022d \u01e7\u0dba\u0db8\u0dba \u0db8\u0119\u01e6 \u0218\u028f\u017b\u0dc0\u01e9 \u0dbd\u0dd0\u022d (\u0dd9\u0db8\u028f \u023d\u01e6\u0db8\u01b1 \u201c\u0d86\u0dba\u0dad\u0db1\u0dba\u201d \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc3\u0daf\u0dc4\u01e6 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1) \u0ddb\u0dc0\u0daf\u0255 \u026a\u0daf\u0255\u0dcf \u0db4\u0dc1\u0dca\u0da0\u0dcf\u01ae \u0d8b\u0db4\u0dcf\u01dd \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u01e6\u0dd9\u01e6 \u0dba.\n\n3. \u0dd9\u023c \u0d86\u0dba\u0dad\u0db1\u0dba, (\u0dd9\u0db8\u028f \u023d\u01e6 \u0db8\u01b1 \u201c\u026a\u0dc1\u0dca\u0dc0\u026a\u0daf\u0255\u0dcf\u0dbd\u0dba\u201d \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0dd9\u0217\u0dbb\u0dcf\u0dd9\u0daf\u019d\u0dba \u026a\u0dc1\u0dca\u0dc0\u026a\u0daf\u0255\u0dcf\u0dbd\u0dba\u0da7 \u0d85\u01e9\u0db6\u01ca\u0db0 \u0dc0\u01e6\u0dd9\u01e6\u0dba.\n\n4. \u0db4\u0db1\u0dd9\u01ae, \u01e7\u0dba\u0db8\u0dcf\u0dc0\u0263\u0dd9\u024f \u0dc3\u0dc4 \u0dba\u023c \u0d8b\u013d\u0dad \u0dc3\u0dcf\u0db0\u0db1 \u0db4\u01b4\u0dba\u0d9a \u026a\u01dd\u026a\u0db0\u0dcf\u0db1\u0dc0\u0dbd\u0da7 \u0dc3\u0dc4 (\u0dd9\u0db8\u028f \u023d\u01e6 \u0db8\u01b1 \u201c\u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0\u201d \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1) \u026a\u0dc1\u0dca\u0dc0\u026a\u0daf\u0255\u0dcf\u0dbd \u021d\u01af\u0db4\u0dcf\u0daf\u0db1 \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0dc3\u0dc4 \u026a\u0dc1\u0dca\u0dc0\u026a\u0daf\u0255\u0dcf\u0dbd\u0dd9\u024f \u0db6\u0dbd\u0dad\u0dbd, \u0d9a\u0dcf\u0259\u0dba \u0dc3\u0dc4 \u0d9a\u0259\u0dad\u0dc0\u0255\u01e6\u0da7 \u0dba\u0da7\u01ae\u0dc0 \u0d86\u0dba\u0dad\u0db1\u0dba\u0da7 -\n\n2 A\n\nI \u0dd9\u0d9a\u02a3\u0da7\u0dc3 : I \u0dd9\u0146\u0daf\u0dba : \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba : 2019.09.20\n\n(\u0d85) \u0286\u0288\u01e6 \u0d87\u01b1\u0dc5\u01ae \u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0db8 ;"
