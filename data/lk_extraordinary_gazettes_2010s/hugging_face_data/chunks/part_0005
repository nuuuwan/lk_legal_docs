21373428v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bc6\u0b9a\u0ba9\u0bb5\u0bbf\u0bb0\u1fb7\u0ba9 \u2013 \u1f81\u0bae\u0bbe\u0bb0 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u1fbf\u0bb2\u0bbe\u0bc7\u0b95 \u0bc6\u0b95\u0bbe\u1fc4\u0bc6\u0bb5\u1f8a\u0baf, \u0baa\u0bbe\u0ba9\u0b95\u0bbe\u0bb5, \u0bc7\u0b95\u0b95\u0bbe\u0bc8\u0bb2 \u0bc6\u0bae\u0b95\u0bbf \u0bc6\u0b9a\u0ba9\u0bb5\u0bbf\u0bb0\u1fb7\u0ba9 \u0b8e\u1fb9\u0baa\u0bb5\u0bb0\u1f90 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb, \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 66 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 8 0.1433 \u0baa\u1fa2\u0bb9 \u0bb0\u0bbe\u0bb2\u0bb2\u0bbe\u0bc7\u0b95 \u0b89\u0bc7\u0ba4\u0ba9\u0bbf \u1f81\u0bae\u0bbe\u0bbe\u0bbf 665463540v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 65 \u2013 \u0bb0\u0ba3\u1faa\u0bb0 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0baa\u0bbe\u0ba9\u0b95\u0bbe\u0bb5, \u0bc7\u0b95\u0b95\u0bbe\u0bc8\u0bb2 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb, \u0b9a\u0ba3\u0b9a \u1f8a\u0bb5\u0bc6\u0bb2\u0bbe\u1fba\u0bae\u1fb9\u1fb5 \u0bc7\u0baa\u1fb1\u1fb0 \u0baa\u0bbf.\u0b8e\u1fbf.\u0b9a\u0bbf \u0b87\u0bb2. 12, \u0b8e\u1fb5\u0bae\u0bbf\u0ba9\u0bbf\u1fc4\u0b9f\u1fb9 \u1faa\u0ba4\u0bbf, \u0b95\u0bbf\u1f9e\u0bb2\u0baa\u0ba9, \u0bc6\u0b95\u0bbe\u1fa8\u1fbb\u1f97 06 \u0b87\u1fbf \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 18 0.0257 \u0bb9\u0baa\u1fb9 \u0bc7\u0baa\u1f8a\u0bc7\u0b95 \u0b95\u0bbe\u1fb8\u0ba4\u0bbf \u1f81\u0ba3\u1f90\u1fb1\u0b95 718131316v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 32 \u2013 \u0b87\u0bb2. \u0baa\u0bbf 126/2, \u0baa\u0bbe\u0ba9\u0b95\u0bbe\u0bb5, \u0bc7\u0b95\u0b95\u0bbe\u0bc8\u0bb2 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 21 0.1226 \u1f81\u0b9f\u0bbe \u0bb0\u0bbe\u0bb2\u0bb2\u0bbe\u0bc7\u0b95 \u0bb9\u0bbe\u0bbf\u0ba9\u0bbf \u0bc6\u0b95\u0bd7\u1f99\u0ba4\u0bbf 896021702v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u1f81\u0bae\u0bbe\u0bbe\u0bbf \u0ba8\u0bbe\u0b95\u0bb9\u0bb5\u1fb7\u0ba4 \u0b87\u0bb2. \u0baa\u0bbf 132/2, \u0baa\u0bbe\u0ba9\u0b95\u0bbe\u0bb5, \u0bc7\u0b95\u0b95\u0bbe\u0bc8\u0bb2 26 0.0240 \u0b95\u0bc7\u0ba9 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bb2\u0bbe\u0bc7\u0b95 \u0b9a\u0bae\u1fb8\u0ba4 \u0bc7\u0b9a\u0ba9\u0bbe\u0bb0\u1fb7\u0ba9 740981439v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0b87\u0bb2. \u0baa\u0bbf 121/3/\u0b87\u0bb2. \u0baa\u0bbf, \u0baa\u0bbe\u0ba9\u0b95\u0bbe\u0bb5, \u0bc7\u0b95\u0b95\u0bbe\u0bc8\u0bb2 27 0.0308 \u1f86\u1f90 \u0bb9\u1f81\u1f9e\u0bc7\u0b95 \u0b9a\u0bae\u1fb8\u0ba4 \u1f81\u0bae\u0bbe\u0bb0 761421042v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 51 \u2013 \u0baa\u0bbe\u0ba9\u0b95\u0bbe\u0bb5, \u0bc7\u0b95\u0b95\u0bbe\u0bc8\u0bb2 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 30 0.0644 1. \u0b95\u0bae\u0bb0\u0bbe\u1fbf\u0bb2\u0bbe\u0bc7\u0b95 \u0b9c\u0b95\u1fb7 \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u1fb1\u0b95\u0bb0 683400556v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 32 \u2013 2. \u0bb9\u1f97 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u1fbf\u0bb2\u0bbe\u0bc7\u0b95 \u1f86\u0ba4\u1fb8\u0ba4\u0bbf 697844511v \u0b9a\u0bae \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0ba4\u1fbb\u0bae\u0bbf\u0b95\u0bbe \u0bc6\u0b9a\u0ba9\u0bb5\u0bbf\u0bb0\u1fb7\u0ba9 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0bc6\u0ba4\u1fb9\u0ba9\u0baa\u0bbf\u0b9f\u0bb5\u1fb7\u0ba4, \u0baa\