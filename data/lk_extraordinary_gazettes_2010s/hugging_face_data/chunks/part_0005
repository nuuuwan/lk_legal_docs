\u0bb2, \u0b95\u1fa2\u0b95\u1f99\u0bb5 \u0ba8\u0b95\u0bb0\u1fbb 93 0.0099 \u0bae\u0bbe\u0bb2\u0bbe \u0ba4\u1fbd\u0bae\u0bb5\u0ba4\u0bbf \u0b9c\u0baf\u0bb0\u1fb7\u0ba9 428621433v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 83 \u2013 \u0baa\u0bbf\u0bc7\u0b9a\u0bbe\u0bc6\u0bb5\u0bb2, \u0b95\u1fa2\u0b95\u1f99\u0bb5 \u0ba8\u0b95\u0bb0\u1fbb \u0bae\u1fbe\u1fa0\u1fbb 100 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 96 0.0269 \u0bae\u0bbe\u0bb2\u0bbe \u0ba4\u1fbd\u0bae\u0bb5\u0ba4\u0bbf \u0b9c\u0baf\u0bb0\u1fb7\u0ba9 428621433v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 83 \u2013 \u0baa\u0bbf\u0bc7\u0b9a\u0bbe\u0bc6\u0bb5\u0bb2, \u0b95\u1fa2\u0b95\u1f99\u0bb5 \u0ba8\u0b95\u0bb0\u1fbb \u0bae\u1fbe\u1fa0\u1fbb 100 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 97 0.0271 \u0bae\u0bbe\u0bb2\u0bbe \u0ba4\u1fbd\u0bae\u0bb5\u0ba4\u0bbf \u0b9c\u0baf\u0bb0\u1fb7\u0ba9 428621433v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 83 \u2013 \u0baa\u0bbf\u0bc7\u0b9a\u0bbe\u0bc6\u0bb5\u0bb2, \u0b95\u1fa2\u0b95\u1f99\u0bb5 \u0ba8\u0b95\u0bb0\u1fbb \u0bae\u1fbe\u1fa0\u1fbb 100 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 105 0.0470 \u0bc6\u0bb5\u1fc4\u0b9a\u0bbf\u1fb9 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u1fbf\u0bb2\u0bbe\u0bc7\u0b95 900431732v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 2\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0b9a\u1fb7\u1f9e\u0bb5\u1fb9 \u0baa\u1fb6\u0b9f\u0bbe\u0bb0 \u0bae\u0bbf\u1fbf\u0bb2\u0bc6\u0ba4\u0ba9\u0bbf\u0baf, \u0baa\u0bbf\u0bc7\u0b9a\u0bbe\u0bc6\u0bb5\u0bb2, \u0b95\u1fa2\u0b95\u1f99\u0bb5 \u0ba8\u0b95\u0bb0\u1fbb 107 0.0181 \u0ba4\u0ba9\u0bbf