5\u0b9f\u1f90.\n\n127 0.0381 1. \u0b95\u0bbe\u0bb9\u0bb2 \u0ba8\u0bbf\u1fbb\u0b9a\u0bbf\u0bbe\u0bbf \u0b85\u0baa\u0baf\u0b9a\u0bbf\u1fb1\u0bb9 782390554v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 124 \u2013\n\n2. \u0baa\u0bb0\u0ba3 \u0baa\u1fbf\u1fa2\u0baf \u1f81\u1f9e\u0bc7\u0b95 \u0ba8\u0bc7\u0bb5\u0bbe\u0ba4\u0bbe 786540038v \u0b9a\u0bae \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf\n\n\u0b9c\u1f90\u0bb0\u0bbe\u0ba3\u0bbf \u0b9a\u0bbf\u0bbe\u0bbf\u0bb5\u1fbd\u0ba4\u0ba9 \u0b85\u1fbf\u0bb2\u1f90 \u0baa\u0bb0\u0ba3 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb,\n\n\u0baa\u1fbf\u1fa2\u0baf \u1f81\u1f9e\u0bc7\u0b95 \u0ba8\u0bc7\u0bb5\u0bbe\u0ba4\u0bbe \u0b9c\u1f90\u0bb0\u0bbe\u0ba3\u0bbf \u1f81\u1f9e\u1f81\u0bb2\u1f87\u0bbe\u0bbf\u0baf\n\n\u0b9a\u0bbf\u0bbe\u0bbf\u0bb5\u1fbd\u0ba4\u0ba9 \u0b85\u0baa\u0baf\u0b9a\u0bbf\u1fb1\u0bb9 \u0bc6\u0bae\u1fb0\u0bbe\u0bbf\u0ba9\u0bbe\n\n\u0b87\u0bb2. 77/3, \u1f81\u1f99\u1f90 \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0ba8\u0bbf\u1fbd\u0bae\u1fa2\n\n\u0ba8\u0bbe\u1fbb\u0baa\u1f99\u1f8e\u0bb5, \u0baa\u0bbf\u1fa2\u0baf\u1fb8\u0ba4\u0bc8\u0bb2 \u0b85\u0baa\u0baf\u0b9a\u0bbf\u1fb1\u0bb9\n\n\u0bae\u1fbe\u1fa0\u1fbb \u0b95\u0bbf\u1fb7\u0b9a\u0bbf\u0bbe\u0bbf\n\n\u0bb0\u1fb7\u0ba8\u0bbe\u0baf\u0b95\n\n\u0b85\u0baa\u0baf\u0b9a\u0bbf\u1fb1\u0bb9\n\n\u0baa\u1fb6\u0b9f\u0bbe\u0bb0\n\n\u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bb0\u1f90\n\n\u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90.\n\n08 - 514/ 9\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b8e\u0ba9\u1fb0\u1f81\u0bbe\u0bbf\u1fb7\u0ba4\u0bbe\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0ba4\u1fb7\u1f90\u0bb5\u1fb1\u0b95\u0bb3\u0bbf\u1fb9\n\n\u0baa\u0baf\u0bc8\u0ba9\u1fb0\u0bc6\u0b95\u0bbe\u1fb6\u1f8c, \u0b95\u0bc0\u0bc7\u0bb4 \u0b92\u1fba\u0baa\u0bae\u0bbf\u1fb5\u1f8c\u1fc0\u0bb3 \u0ba8\u0bbe\u1fb9, 1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 12 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9\n\n\u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u1fb9\u0baa\u1f8a 2018.08.24 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf 2085/39 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u1fbf \u0b89\u0bbe\u0bbf\u0baf \u1f99\u0bc8\u0bb1\u0baf\u0bbf\u1fbf \u0bc6\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u0b9f\u1fba\u0baa\u1fb5\u0b9f\u1f90\u1fbb, \u0b95\u0bbe\u0ba3\u0bbf\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0\n\n\u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0b95\u0bc8\u0bb3\u1fb0 \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u1fb9\u0bb1\u1f90\u0bae\u0bbe\u0ba9 32/0655 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u1fa2\u1fbf \u1f81\u0bb1\u0bbf\u1fba\u1f96\u1f8c \u0bc6\u0b9a\u1fbc\u0baf\u1fba\u0baa\u1fb5\u0b9f \u0bae\u1fb7\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u1fb7\u0ba4\u0bbf\u1fbf \u0b95\u1fb6\u1f8a\n\n\u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0baf\u1f8a\u1f92\u0bb5\u0bb0 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf, \u0b87\u0bb2. 167 - \u0b8e\u1fbb\u0baa\u0bbf\u1fbf\u0b95\u0bae \u0bc6\u0ba4\u1fbe\u1f81 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u0b8e\u1fbb\u0baa\u0bbf\u1fbf\u0b95\u0bae \u0bc6\u0ba4\u1fbe\u1f81\n\n\u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3 - \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f\n\n\u0bb5\u0bb4\u1fb0\u0b95\u0bbf\u1fbe\u1f81 \u0b85\u1fbf\u0bb2\u1f90\n\n\u0b95\u0bbe\u0ba3\u0bbf\u1fb7 \u0bb5\u0bbf\u1fc4 \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0\u0b95\u0bbe\u0bb0\u1fbd/ \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0 \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb0\u1f81\u0bbe\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u0ba9\u1f90 \u0b89\u1fb5\u0baa\u1fb5\u0b9f \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1f9e\u1fb0\n\n\u1f90\u1fb6\u1f8a\u1fb9 \u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0b95\u0bbe\u0bb0\u1fbd\u0b95\u0bb3\u0bbf\u1fb9 \u1f99\u1fa8\u1fba \u0b85\u0bc8\u0b9f\u0baf\u0bbe\u0bb3 \u0b87\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 \u0bb5\u1f81\u1fba\u1f97\u1fbb \u0b88\u1f8c, \u1f81\u1fb7 \u1f81\u0bbe\u0bbf\u0baf \u0b9a\u1fb5\u0b9f\u1fb1"
