8\u0ba4\u0bbf\u1f9e\u1fba \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0baa\u0bbf\u1fb9 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0 \u0b95\u1fc0\n\n147 0.0997 \u0b85\u0bb0\u1f86 \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b85\u1f94\u0bae\u0ba4\u0bbf\u1fba\u0baa\u1fb7\u0ba4\u0bbf\u0bb0 \u0b87\u0bb2. \u0b8e\u1fbf.\u0b8e\u1fbf 10601 \u0b95\u0bc0\u1fc1 138/ \u0b8f, \u0b9a\u0ba9\u0b9a\u1f9a\u0b95 \u0bae\u1fb6\u0b9f\u0baa\u1fbb \u0b85\u1f9e\u0b95\u0bbf\u1fbf, \u1f81\u0b9f\u0bbe\u0bc6\u0bb5\u0bb5, \u0b95\u0bc7\u0bb2\u0bc6\u0bb5\u0bb2 \u0b87\u1fa4\u1fc0\u0bb3 \u1f90\u0ba9\u0bbe\u0bc6\u0b95\u0bbe\u0b9f\u0bc7\u0b95 \u1fba\u0bc7\u0bb0\u0bae\u0ba4\u0bbe\u0b9a \u0b87\u1fb9 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 270 0.1801 \u0ba4\u0bb9\u0ba9\u0b95 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0bc7\u0b9a\u0bbe\u0bae\u0bbe\u0bb5\u0ba4\u0bc0 516940654v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a.\u0ba4\u0bbf\u1fb9 \u1f81\u0b9f\u0bbe\u0bc6\u0bb5\u0bb5, \u0b95\u0bc7\u0bb2\u0bc6\u0bb5\u0bb2 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 08 - 717 / 8\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1