    "chunk_text": "\u0d91\u0dd9\u0dc3\u0dda \u0dc0\u0dd4\u0dc0 \u0daf \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0d9a\u0dca\u0dd9\u0dc0\u0db1 \u0dad\u0dd0\u0db1\u0dd0\u0dad\u0dca\u0dad\u0db1\u0dca, \u0d91\u0dd9\u0dc3\u0dda \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0d9c\u0dcf\u0dc3\u0dca\u0dad\u0dd4 \u0dd9\u0d9c\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd3\u0dd9\u0db8\u0db1\u0dca \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0dc0\u0db1\u0dca\u0dd9\u0db1\u0dca \u0dba : (\u0d85) \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0db8\u0dd4\u0dad\u0dca\u0dad\u0db1\u0dca, (\u0d86) \u0d8b\u0daf\u0dca\u0db7\u0dd2\u0daf \u0d8b\u0daf\u0dca\u200d\u0dba\u0dcf\u0db1 \u0dad\u0dd4\u0dc5 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3\u0dc0\u0dbd \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca, (\u0d87) \u0db1\u0dd2\u0dbd \u0d9a\u0dcf\u0dbb\u0dca\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d8b\u0daf\u0dca\u0db7\u0dd2\u0daf \u0d8b\u0daf\u0dca\u200d\u0dba\u0dcf\u0db1\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0dbd\u0dd4\u0dc0\u0db1 \u0dbb\u0da2\u0dd9\u0dba\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd3\u0db1\u0dca, (\u0d88) \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d8b\u0daf\u0dca\u0db7\u0dd2\u0daf \u0d8b\u0daf\u0dca\u200d\u0dba\u0dcf\u0db1 \u0d85\u0db0\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1, \u0dd9\u0dc0\u0db1\u0dad\u0dca \u0dba\u0db8\u0dca \u0dad\u0dd0\u0db1\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4. \u0d91\u0dd9\u0dc3\u0dda\u0db8 \u0dad\u0dc0 \u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca, \u0dc0\u0dcf\u0dc4\u0db1 \u0d87\u0dad\u0dd4\u0dbd\u0dd4\u0dc0\u0dd3\u0db8 \u0dd9\u0db1\u0ddc\u0d9a\u0dbb\u0db1 \u0d8b\u0daf\u0dca\u0db7\u0dd2\u0daf \u0d8b\u0daf\u0dca\u200d\u0dba\u0dcf\u0db1\u0dba\u0db1\u0dca\u0da7 \u0d85\u0daf\u0dcf\u0dc5\u0d