    "chunk_text": "\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 105 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 105, \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 107 ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 107, \u0bae\u0bbf\u0b9a\u0bcd\u0b9a\u0bbf\u0bc7\u0ba8\u0bbe\u0ba9\u0bbe \u0b85\u0bb0\u0b99\u0bcd\u0b95\u0bb3 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb9\u0bc6\u0ba4\u0bbe\u0bb2\u0bb2\u0ba8\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 105. 107. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 107 - \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb9\u0bc6\u0ba4\u0bbe\u0bb2\u0bb2\u0ba8\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0089 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 107 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 107 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 109, \u0b9f\u0b9f\u0bcd\u1fa2 \u0b95\u0bc1\u0ba3\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb9\u0bb2\u0ba8\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf. 109. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 109 - \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb9\u0bb2\u0ba8\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0058 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 108 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 110 ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 110, \u1fa2\u0baf\u0ba3\u0bc7\u0b95 \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0b95\u0bbe\u0ba8\u0bcd\u0ba4\u0bbf \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb9\u0bb2\u0ba8\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b89\u0baa\u0bbe\u1fa2 \u0b95\u0bc1\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb9\u0bc6\u0ba4\u0bbe\u0bb2\u0bb2\u0ba8\u0bcd\u0bc8\u0ba4. 110. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 110 - \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb9\u0bb2\u0ba8\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0046 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 109 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 111; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 111, \u0b92\u1fa2\u0bb5\u0bb0\u0bcd \u0b9c\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb9\u0bb2\u0ba8\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf\u0baa\u0b95\u0bc1\u0ba4\u0bbf, \u0b9f\u0b9f\u0bcd\u1fa2 \u0b95\u0bc1\u0ba3\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb9\u0bb2\u0ba8\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 109 111. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 111 - \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb9\u0bb2\u0ba8\u0bcd\u0bc8\u0ba4 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0016 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 110 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 112 ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 112, \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf, \u1fa2\u0baf\u0ba9\u0bc7\u0b95 \u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0b95\u0bbe\u0ba8\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb9\u0bb2\u0ba8\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 110 112. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 112 - \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bb5\u0bbf\u0bb2\u0bcd\u0bc8\u0bb2 \u2013 \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0026 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u0b92\u1fa2\u0bb5\u0bb0\u0bcd \u0b9c\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0ba4\u0bb2\u0bcd\u0b95\u0bb9 \u0bb2\u0ba8\u0bcd\u0bc8\u0ba4, \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 111 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0b