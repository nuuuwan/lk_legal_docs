\u0bb2. 56 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf, \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 58 ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 58, \u1faa\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u0b87\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0b9a\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf, \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bbe\u0bbf \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. 556A \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 56.\n\n58. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 58 - \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd : \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0017 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 57 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 59 ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 59, \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc6\u0bae\u0bbe\u0bb0\u0b95\u0bb9\u0bc7\u0bb9\u0ba9 \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bbe\u0bbf \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. 99 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf ; \u0bc