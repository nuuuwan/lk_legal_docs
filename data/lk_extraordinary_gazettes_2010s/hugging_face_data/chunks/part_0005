, \u0b95\u1fa2\u0b95\u1f99\u0bb5 \u0ba8\u0b95\u0bb0\u1fbb 128 0.0466 1. \u0bc6\u0b95\u0bbe\u0b9f\u0baf\u0bb2\u0bbe\u0bc7\u0b95 \u0bc6\u0b95\u1fa4\u1fbb \u0b9a\u1fb8\u0ba4\u0bbf\u0bae 813150450v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u1faa\u0bb0\u1f87\u0bbe\u0bbf\u0baf \u0b9a\u0bae \u0b89\u0bbe\u0bbf\u0bc8\u0bae 2. \u0bc6\u0b95\u0bbe\u0b9f\u0baf\u0bb2\u0bbe\u0bc7\u0b95 \u0baa\u0bbf\u0bb0\u0b9a\u0bbe\u1fb7 \u0b9a\u0bae\u0bbf\u0bb0 872671846v \u1faa\u0bb0\u1f87\u0bbe\u0bbf\u0baf \u0baa\u0bbf\u0bc7\u0b9a\u0bbe\u0bc6\u0bb5\u0bb2, \u0b95\u1fa2\u0b95\u1f99\u0bb5 \u0ba8\u0b95\u0bb0\u1fbb 129 0.2883 \u0bc6\u0b95\u0bbe\u0b9f\u0baf\u0bb2\u0bbe\u0bc7\u0b95 \u0bc6\u0b95\u1fa4\u1fbb \u0b9a\u1fb8\u0ba4\u0bbf\u0bae 813150450v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u1faa\u0bb0\u1f87\u0bbe\u0bbf\u0baf \u0baa\u0bbf\u0bc7\u0b9a\u0bbe\u0bc6\u0bb5\u0bb2, \u0b95\u1fa2\u0b95\u1f99\u0bb5 \u0ba8\u0b95\u0bb0\u1fbb 130 0.3161 \u0bc6\u0b95\u0bbe\u0b9f\u0baf\u0bb2\u0bbe\u0bc7\u0b95 \u0baa\u0bbf\u0bb0\u0b9a\u0bbe\u1fb7 \u0b9a\u0bae\u0bbf\u0bb0 872671846v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u1faa\u0bb0\u1f87\u0bbe\u0bbf\u0baf \u0baa\u0bbf\u0bc7\u0b9a\u0bbe\u0bc6\u0bb5\u0bb2, \u0b95\u1fa2\u0b95\u1f99\u0bb5 \u0ba8\u0b95\u0bb0\u1fbb 08 - 516 / 13\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8c 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1