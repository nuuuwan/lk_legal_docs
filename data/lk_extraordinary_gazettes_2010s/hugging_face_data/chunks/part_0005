277 \u1faa\u0bb0\u0bc6\u0b95\u0bbe\u1f8a \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bb2\u0bbe\u0bc7\u0b95 \u0bb2\u0bbe\u0bb2\u0ba9\u0bbf 706192816v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b85\u0bb2\u0bb9\u0bc7\u0b95\u0bbe\u1fb9 \u2013 \u0ba4\u1fbb\u0bae\u0bbf\u0b95\u0bbe \u1f99\u0ba4\u1fa2\u0bc7\u0b95 \u0baa\u0bbe\u0bbf\u1f86\u1fb7\u0ba4 \u1f81\u1f8c\u1fbb\u0baa\u1fb7\u0ba4\u0bbf\u1fb9 \u0b95\u0bbe\u1fb9\u0bc6\u0bb5\u1fb9\u1fb5, \u0bc6\u0ba4\u0bbe\u1fb9 \u0bb5\u1fbd\u0ba3\u1fb9 \u0b85\u1f94\u0bb0\u0bbe\u0ba4\u1f97\u0bb0\u1fbb \u1faa\u0ba4\u0bbf, \u0bc7\u0b9a\u0ba9\u1f81\u1f8a\u0bbe\u0bbf\u1fba\u1f97\u0bb5, \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u1f97\u1fb7\u0ba4\u0bb3\u1fbb \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 31 0.0332 \u0b90\u0baf\u0bbe\u0b9a\u0bbe\u0bae\u0bbf \u0b88\u1fc4\u0bb5\u0bbe\u0bbf 875132598v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u1fb8\u0ba4\u0b9a\u0bbe\u0bae\u0bbf \u2013 \u0b85\u0baa\u0baf \u1f97\u0bb0, \u0bc7\u0b9a\u0ba9\u1f81\u1f8a\u0bbe\u0bbf\u1fba\u1f97\u0bb5, \u0ba8\u0bbf\u1fb7\u0ba4\u0bbf\u0baf\u0b95\u1fbf\u0baf\u0bbe\u0ba9\u0bbf \u1f97\u1fb7\u0ba4\u0bb3\u1fbb \u0b8e\u1fb9\u0baa\u0bb5\u0bbe\u0bbf\u1fb9 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, 34 0.0410 \u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa - \u1f97\u1fb7\u0ba4\u0bb3\u1fbb \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe\u1fc0\u0bb5\u0bbe\u1fbc 36 0.0394 \u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa - \u1f97\u1fb7\u0ba4\u0bb3\u1fbb \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe\u1fc0\u0bb5\u0bbe\u1fbc 38 0.0950 \u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa - \u1f97\u1fb7\u0ba4\u0bb3\u1fbb \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u0b95\u0bbe\u1fc0\u0bb5\u0