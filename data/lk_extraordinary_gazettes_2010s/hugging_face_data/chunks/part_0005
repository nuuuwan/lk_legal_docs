8\u0b95 - \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0bb7\u0bae\u0bbe\u0ba9\u1f90 \u2013 2019.07.11\n\n111 0.0126 \u0bc6\u0bae\u0bbe\u0bb9\u0bae\u1fb5 \u0baa\u0bbe\u1f9e\u1fb0 \u0b85\u0bb9\u0bae\u1fb5 \u0ba4\u0bbe\u0bb9\u0bbf\u1fbd 701910737v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0b87\u0bb2. 438/9\u0b8e, \u0bb9\u0bbf\u1fb3\u0bb0\u0bbe \u0bae\u0bbe\u0bb5\u1fb7\u0bc8\u0ba4, \u0ba4\u0bbf\u0bb9\u0bbe\u0bbe\u0bbf\u0baf, \u0b95\u0bb2\u0bc6\u0bb9\u1f8a\u0bc7\u0bb9\u0ba9 117 0.0353 \u0bc6\u0bae\u0bbe\u0bb9\u0bae\u1fb5 \u0b89\u0bb5\u0baf\u0bbf\u1fc4 \u0bbe\u0bbf\u1fc4\u0bb5\u0bbf \u0bc6\u0bae\u0bbe\u0bb9\u0bae\u1fb5 822532586v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 114 \u2013 \u0b87\u0bb2. 3/3/\u0baa\u0bbf, \u0b95\u1fb7\u0bc6\u0ba4\u0bbe\u0b9f, \u0ba8\u0bbf\u1fb5\u0b9f\u1fbb\u1f97\u0bb5 \u0bae\u1fbe\u1fa0\u1fbb 180 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 118 0.0363 \u0b95\u0bbe\u0bbe\u0bbf\u0baf\u0bb5\u0b9a\u1fbb \u0b95\u0bae\u0bc7\u0b95 \u0b95\u1fb1\u0b95\u0bbe \u1f86\u0bb0\u1fb1\u0b95\u0ba9\u0bbf 788133294v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 114 \u2013 \u0b95\u0bbe\u0bbe\u0bbf\u0baf\u0bb5\u0b9a\u1fbb \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 3/5, \u0b95\u1fb7\u0bc6\u0ba4\u0bbe\u0b9f, \u0ba8\u0bbf\u1fb5\u0b9f\u1fbb\u1f97\u0bb5 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb, \u0baa\u0bbe\u1f8a \u0b95\u0bae\u0bc7\u0b95 \u0baa\u0bbf\u0bc7\u0bb0\u0bae\u0b9a\u0bc0\u1fa2 \u0b8e\u1fb9\u0baa\u0bb5\u0bb0\u1f90 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 119 0.0270 \u0bc7\u0b9a\u0ba9\u0bbe\u0ba8\u0bbe\u0baf\u0b95 \u0b85\u0bae\u0bb0\u0b9a\u0bbf\u1fb1\u0bb9 \u0bc6\u0bae\u0bbe\u0bc6\u0bb9\u0bbe\u1fb5\u1f8a 652071708v