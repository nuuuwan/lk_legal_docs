    "text": "\u0b8e\u1f8c\u0ba4\u0bcd\u1f90\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0bb5\u0bbf\u1f9e\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd:- \u0b8a\u0bb5 \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0baa\u1f90\u0bc8\u0bb3 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0b8e\u0bb2\u0bcd\u0bb2 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u1fa8\u0bb3\u0bcd\u0bb3 \u0b95\u0bc1\u0bae\u0bcd\u0baa\u0bb3\u0bcd\u0bb5\u0bc8\u0bb3 \u0bc7\u0b95\u0bbe\u0bb1\u0bc8\u0bb3\u0baf\u0bbf\u0bb2\u0bcd \u0b9a\u0bbf\u1fa0 \u0baa\u0b95\u0bc1\u0ba4\u0bbf 71 B \u0bc6\u0ba4\u0bbe\u0b9f\u0b99\u0bcd\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0bb8\u0bcd\u0ba4\u0bbf\u0bbe\u0bc0\u1f97\u0bc7\u0bb0 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bae\u0bcd (\u0b87.\u0b95\u0bbf.\u0bb5. 275) \u0baa\u0bbf\u0b9f\u0bb9\u0bc6\u0b95\u0ba4\u0bb0 (\u0b87.\u0b95\u0bbf.\u0bb5. 276) \u0b89\u0b9f\u0bb5\u0bbe\u1f8a\u0baf (\u0b87.\u0b95\u0bbf.\u0bb5 277) \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd (\u0b87.\u0b95\u0bbf.\u0bb5. 272) \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0baa\u1f90\u0bc8\u0bb3 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f \u0ba8\u0bbf\u0bb2\u0b85\u0bb3\u0bc8\u0bb5 \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0b9f\u0bcd \u0b9a\u0b95\u0bbe\u0bbf\u0ba9\u0bcd \u0b87\u0bb2. LRC/\u0db6/64/\u0db6/2 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd1974/4/19 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u1f9c\u0bc8\u0b9f\u0baf \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0bc8\u0bae\u0baf \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 89,35,195 \u0b8e\u0ba9 \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u1f8c\u0bae\u