    "text": "\u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd3\u0db8 : \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dd9\u0dad\u0dca \u2018\u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca \u0db6\u0dbd\u0d82\u0dd9\u0d9c\u0ddc\u0da9 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca, \u0dd9\u0dc4\u0dbd \u0d8b\u0da9 \u0db4\u0dc5\u0dcf\u0dd9\u0dad\u0dca \u0dc0\u0dad\u0dd4\u0d9a\u0dcf\u0dbb\u0dd9\u0d9c\u0ddc\u0da9 \u0d9c\u0dd9\u0db8\u0dca (\u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dca) \u0dc3\u0dd0\u0dc5\u0dd0\u0dc3\u0dca\u0dd9\u0db8\u0dca \u0d85\u0d82\u0d9a\u0dba : \u0d85. \u0d9c. \u0dc3\u0dd2. 477 \u0d85\u0dad\u0dd2\u0dd9\u0dbb\u0dca\u0d9a 14 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a\u0dba: 219 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0d89\u0dc4\u0dbd \u0db6\u0dbd\u0d82\u0dd9\u0d9c\u0ddc\u0da9 \u0dc0\u0dad\u0dca\u0dad, \u0d8b\u0da9\u0d9a\u0db1\u0dca\u0daf\u0dc0\u0dad\u0dca\u0dad, \u0d9a\u0dc5\u0dd4\u0db1\u0dca\u0daf\u0dba\u0dc0\u0dad\u0dca\u0dad, \u0d9a\u0da2\u0dd4\u0dd9\u0d9a\u0ddc\u0dbb\u0da7\u0dd4 \u0dd9\u0dc0\u0dca\u0dc0\u0dad\u0dca\u0dad. \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba : 01. \u0d9a\u0db1\u0dca\u0daf\u0dba\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0dc0\u0dc3\u0dd2\u0dad\u0db8\u0dca\u0db6\u0dbb\u0db8\u0dca \u0db8\u0dba\u0dcf, \u0dc3\u0dd4\u0d9c\u0dad\u0dca\u0db1\u0dcf\u0dad\u0dca, \u0dd9\u0d9a\u0ddd\u0db4\u0dcf\u0dba\u0dd2. 02. \u0dd9\u0dc3\u0dbd\u0dca\u0dbd\u0db8\u0dca\u0db8\u0dcf \u0da5\u0dcf\u0db1\u0dc3\u0dd4\u0db1\u0dca\u0daf\u0dbb\u0db8\u0dca \u0db8\u0dd2\u0dba, \u201c \u0dd9\u0dc3\u0dbd\u0dca\u0dc0\u0dd9\u0d9a\u0ddc\u0da7\u0dca, \u0dd9\u0db4\u0ddc\u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca. 03. \u0db8\u0dd9\u0dc4\u0dda\u0dc3\u0dca\u0dc0\u0dbb\u0dd3 \u0d85\u0dbb\u0dd4\u0dbd\u0dcf\u0db1\u0db1\u0dca\u0daf\u0db8\u0dca \u0db8\u0dd2\u0dba, \u0d85\u0d82\u0d9a 38, \u0dd9\u0d9a\u0ddc\u0dbd\u0dd2\u0db1\u0dca\u0dc0\u0dd4\u0da9\u0dca\u0dc3\u0dca \u0dd9\u0dbd\u0dca\u0db1\u0dca, \u0dc0\u0dd0\u0dbd\u0dca\u0dbd\u0dc0\u0dad\u0dca\u0dad. 03. \u0dd9\u0dbb\u0dca\u0dab\u0dd4\u0d9a\u0dcf \u0dd9\u0daf\u0dca\u0dc0\u0dd3 \u0d9a\u0db1\u0d9c\u0dc3\u0dd9\u0db6\u0dca \u0db8\u0dd2\u0dba, \u0d85\u0d82\u0d9a 11, \u0dbb\u0dcf\u0db8\u0d9a\u0dd2\u0dc2\u0dca\u0dab \u0d9c\u0dcf\u0dbb\u0dca\u0da9\u0dca\u0db1\u0dca, \u0dc0\u0dd0\u0dbd\u0dca\u0dbd\u0dc0\u0dad\u0dca\u0dad, \u0dd9\u0d9a\u0ddc\u0dc5\u0db9. \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 2.428 \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d89\u0da9\u0db8\u0da7 \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0dba\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8\u0dca \u0dd9\u0dc4\u0ddd \u0dd9\u0dc0\u0db1\u0dad\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0dd9\u0daf\u0db1\u0dcf\u0db8 \u0dad\u0db8 \u0dad\u0db8\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0dd9\u0dc4\u0ddd \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0dbd\u0dd2\u0dba\u0dc0\u0dd2\u0dbd\u0dd2\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0d85\u0dba\u0dc0\u0dbd\u0dd4\u0db1\u0dca \u0dd9\u0dc4\u0ddd \u201c 1986.04.21 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0db4\u0dd6. \u0db7\u0dcf. 10.00\u0da7 \u0db6\u0dbd\u0d82\u0dd9\u0d9c\u0ddc\u0da9 \u0d8b\u0db4 \u0daf\u0dd2\u0dc3\u0dcf\u0db4\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dd9\u0dba\u0dca \u0daf\u0dd3 \u0db8\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0d9b \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2\u201d \u0dba\u0db1\u0dca\u0db1, \u201c2015.02.16 \u0daf\u0dd2\u0db1 \u0db4\u0dd6. \u0db7\u0dcf. 10.00 \u0da7 \u0db6\u0dbd\u0d82\u0dd9\u0d9c\u0ddc\u0da9 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dd9\u0dba\u0dca \u0daf\u0dd3 \u0db8\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0d9b \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u201d \u0dba\u0db1\u0dd4\u0dd9\u0dc0\u0db1\u0dca \u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0db1\u0dba \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0db1 \u0d85\u0dad\u0dbb, 2015.02.16 \u0daf\u0dd2\u0db1 \u0dd9\u0db4. \u0dc0. 10.00\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d89\u0dc4\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0dc4\u0dcf \u0dad\u0dc0 \u0daf, \u201c1986.04.07\u201d \u0daf\u0dd2\u0db1\u0da7 \u0db8\u0dad\u0dca\u0dd9\u0dad\u0db1\u0dca \u0dba\u0db1\u0dca\u0db1 \u201c2015.02.02\u201d \u0daf\u0dd2\u0db1\u0da7 \u0db8\u0dad\u0dca\u0dd9\u0dad\u0db1\u0dca \u0dba\u0db1\u0dca\u0db1 \u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0db1\u0dba \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dad\u0dbb, \u0d91\u0daf\u0dd2\u0db1\u0da7 \u0db8\u0dad\u0dca\u0dd9\u0dad\u0db1\u0dca \u0d92 \u0d89\u0da9\u0db8/\u0d89\u0da9\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd9\u0dba\u0db1\u0dca \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8\u0dca\u0dc0\u0dbd \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba\u0dad\u0dca, \u0d91\u0d9a\u0dd3 \u0d89\u0da9\u0db8/\u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0dba \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d9c\u0dd0\u0db1 \u0dc0\u0db1\u0dca\u0daf\u0dd2 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0da7 \u0d87\u0dad\u0dd2 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dad\u0dca, \u0dc0\u0db1\u0dca\u0daf\u0dd2 \u0db8\u0dd4\u0daf\u0dbd \u0dc4\u0dcf \u0d92 \u0db8\u0dd4\u0daf\u0dbd \u0d9c\u0dab\u0db1\u0dca \u0db6\u0dd0\u0dbd\u0dd6 \u0dc4\u0dd0\u0da7\u0dd2\u0dad\u0dca \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd2\u0da7\u0db4\u0dad\u0dca \u0dd9\u0daf\u0d9a\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd6 \u0dbd\u0dd2\u0dba\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0d9a\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba. \u0da0\u0db8\u0dca\u0db4\u0dd2\u0d9a \u0db1\u0dd2\u0dd9\u0dbb\u0ddd\u0dc2\u0dca \u0db0\u0dbb\u0dca\u0db8\u0db4\u0dcf\u0dbd, \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca, \u0db6\u0dbd\u0d82\u0dd9\u0d9c\u0ddc\u0da9. 2014 \u0dd9\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 23 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0db6\u0dbd\u0d82\u0dd9\u0d9c\u0ddc\u0da9 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dd9\u0dba\u0dca \u0daf\u0dd3 \u0dba, 01-332",
