    ],
    "text": "\u0db4\u0dd2\u0db9\u0dd4\u0dbb\u0dd4 \u0d85\u0d82\u0d9a \u0d85.\u0d9c.\u0db4\u0dd2. 276 \u0d85\u0dad\u0dd2\u0dd9\u0dbb\u0dca\u0d9a \u0d85\u0d82\u0d9a 1 02. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 35 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0d9a\u0dc5\u0dd4\u0d9c\u0dbd\u0dc0\u0dad\u0dca\u0dad: \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0d92 \u0d9a\u0dbb\u0dd4\u0db4\u0dca\u0db4\u0db1\u0dca \u0dd9\u0da0\u0da7\u0dca\u0da7\u0dd2\u0dba\u0dcf\u0dbb\u0dca, \u0d9a\u0dc5\u0dd4\u0d9c\u0dbd\u0dc0\u0dad\u0dca\u0dad,\u0d9a\u0dc5\u0dd4\u0d9c\u0dbd; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0d85\u0d9a\u0dca\u0d9a\u0dbb 07\u0dba\u0dd2,\u0db4\u0dbb\u0dca\u0da0\u0dc3\u0dca 15. \u0db4\u0dd2\u0db9\u0dd4\u0dbb\u0dd4 \u0d85\u0d82\u0d9a \u0d85.\u0d9c.\u0db4\u0dd2. 277 \u0d85\u0dad\u0dd2\u0dd9\u0dbb\u0dca\u0d9a \u0d85\u0d82\u0d9a 1 03. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 195 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0d9a\u0dc5\u0dd4\u0d9c\u0dbd\u0dc0\u0dad\u0dca\u0dad: \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0d92 \u0d9a\u0dbb\u0dd4\u0db4\u0dca\u0db4\u0db1\u0dca \u0dd9\u0da0\u0da7\u0dca\u0da7\u0dd2\u0dba\u0dcf\u0dbb\u0dca, \u0d9a\u0dc5\u0dd4\u0d9c\u0dbd\u0dc0\u0dad\u0dca\u0dad, \u0d9a\u0dc5\u0dd4\u0d9c\u0dbd; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0d85\u0d9a\u0dca\u0d9a\u0dbb 30\u0dba\u0dd2, \u0dbb\u0dd6\u0da9\u0dca 3\u0dba\u0dd2 \u0db4\u0dbb\u0dca\u0da0\u0dc3\u0dca 18. \u0d91\u0d9a\u0dad\u0dd4\u0dc0 : \u0d85\u0d9a\u0dca\u0d9a\u0dbb 53, \u0dbb\u0dd6\u0da9\u0dca 0, \u0db4\u0dbb\u0dca\u0da0\u0dc3\u0dca 0. \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d89\u0da9\u0db8\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8\u0dca \u0dd9\u0dc4\u0ddd \u0dd9\u0dc0\u0db1\u0dad\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dd9\u0daf\u0db1\u0dcf\u0db8 \u0dad\u0db8 \u0dad\u0db8\u0db1\u0dca \u0dd9\u0dc4\u0ddd \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dd9\u0d9c\u0db1\u0dca \u0dbd\u0dd2\u0dba\u0dc0\u0dd2\u0dbd\u0dd2\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0d85\u0dba\u0dc0\u0dbd\u0dd4\u0db1\u0dca 2014 \u0dd9\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 17 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dd9\u0db4. \u0dc0. 10.00 \u0da7 \u0d87\u0dbd\u0dca\u0dbd \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dd9\u0dba\u0dca \u0daf\u0dd3 \u0db8\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0d9b \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2. \u0dad\u0dc0 \u0daf, 2014 \u0dd9\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 17 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1\u0da7 \u0db8\u0dad\u0dca\u0dd9\u0dad\u0db1\u0dca \u0d92 \u0d89\u0da9\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd9\u0dba\u0db1\u0dca \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8\u0dca\u0dc0\u0dbd \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba\u0dad\u0dca \u0d91\u0d9a\u0dd3 \u0d89\u0da9\u0db8 \u0dbd\u0db6\u0dcf\u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d9c\u0dd0\u0db1 \u0dc0\u0db1\u0dca\u0daf\u0dd2 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0da7 \u0d87\u0dad\u0dd2 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0daf \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dad\u0dca, \u0dc0\u0db1\u0dca\u0daf\u0dd2 \u0db8\u0dd4\u0daf\u0dbd \u0dc4\u0dcf \u0d92 \u0db8\u0dd4\u0daf\u0dbd \u0d9c\u0dab\u0db1\u0dca \u0db6\u0dd0\u0dbd\u0dd6 \u0dc4\u0dd0\u0da7\u0dd2\u0dad\u0dca \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd2\u0da7\u0db4\u0dad\u0dca \u0dd9\u0daf\u0d9a\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd6 \u0dbd\u0dd2\u0dba\u0dc0\u0dd2\u0dbd\u0dca\u0dbd\u0d9a\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd2\u0dba 