    "text": "\u0bc7\u0bae\u0bb2\u0ba4\u0bbf\u0b95 \u0ba4\u0b95\u0bb5\u1fbf , \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bbf\u0b9f\u0bae\u0bbf\u1f9e\u1fb8\u1f90, \u0b85\u1fbf\u0bb2\u1f90 \u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1f9e\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u0b9f\u0bae\u0bbf\u1f9e\u1fb8\u1f90 \u0bc6\u0baa\u1fbe\u1fa0\u1fb0\u0bc6\u0b95\u0bbe\u1fc0\u0bb3\u1fba\u0baa\u0b9f\u0bb2\u0bbe\u1fbb. \u0b95\u0bbe\u0bae\u0bbf\u0ba3\u0bc0 \u0b87\u0bb2\u1fb1\u0b95\u0bb0\u1fb7\u0ba9\u0b95\u0bbe\u0bae\u0bbf\u0ba3\u0bc0 \u0b87\u0bb2\u1fb1\u0b95\u0bb0\u1fb7\u0ba9\u0b95\u0bbe\u0bae\u0bbf\u0ba3\u0bc0 \u0b87\u0bb2\u1fb1\u0b95\u0bb0\u1fb7\u0ba9\u0b95\u0bbe\u0bae\u0bbf\u0ba3\u0bc0 \u0b87\u0bb2\u1fb1\u0b95\u0bb0\u1fb7\u0ba9,",
