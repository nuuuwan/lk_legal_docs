  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      428.17,
      538.03,
      475.24
    ],
    "text": "By virtue of the powers vested in me by Section 33 of the Antiquities Ordinance (Chapter 188), I, Dissanayake MudiyanselageSenerath Bandara Dissanayake, Director General of Archaeology, being satisfied that the provisions of the aforesaid sectionhave been complied with, do by this notification declare the area of state land specified in the Schedule to this Order, shalldeemed to be an \u201carchaeological reserve\u201d for the purposes of the aforesaid Odinance.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      483.73,
      521.83,
      538.36
    ],
