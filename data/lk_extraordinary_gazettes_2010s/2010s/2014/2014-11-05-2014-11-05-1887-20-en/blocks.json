    ]
  },
  {
    "page_number": 0,
    "bbox": [
      125.85,
      606.73,
      539.93,
      641.8
    ],
    "text": "Authority shall, for the purpose of these regulations, authorize any vehicle emission testing center to bean accredited vehicle emission testing center for the purpose of testing and certifying the vehicularexhaust emission levels of any motor vehicle.",
