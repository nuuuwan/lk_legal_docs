  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      372.97,
      539.93,
      422.44
    ],
    "text": "IT is hereby notified that by virtue of the powers vested in the Monetary Board established under the Monetary Law Act(Chapter 422), in terms of Section 192 of the Civil Procedure Code, as amended by the Civil Procedure Code (Amendment)Act, No. 06 of 1990, the Monetary Board has, having regard to the current rates of bank interest, determined that with effectfrom 01st January 2015, the Legal Rate of Interest shall be seven point seven six per cent (7.76%) per annum.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
