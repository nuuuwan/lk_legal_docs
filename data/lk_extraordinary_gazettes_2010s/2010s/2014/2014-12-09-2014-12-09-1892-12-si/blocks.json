    "text": "\u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc1\u0dba \u0dad\u0dd4\u0dc5 \u0db8\u0dad\u0dca\u0dd9\u0dad\u0dd9\u0d9c\u0ddc\u0da9 \u0db1\u0db8\u0dd0\u0dad\u0dd2 \u0d9c\u0dd9\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf \u0dc0\u0dd6 \u0daf, \u0d85\u0d82\u0d9a 520008 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0dd9\u0db8\u0dca \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 30 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 30 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0db1\u0dba\u0db1\u0dca \u0d91\u0dc4\u0dd2 \u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dd9\u0dba\u0dc4\u0dd2; \u201c \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dd9\u0d9c\u0dca/\u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db1\u0db8/\u0db1\u0db8\u0dca \u0dc3\u0dc4 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u201d \u0dba\u0db1 \u0dad\u0dd3\u0dbb\u0dd4\u0dd9\u0dc0\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u201c \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u201d \u0dba\u0db1\u0dca\u0db1 \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dbb \u201c\u0dd9\u0db4\u0ddc\u0dad\u0dd4\u0db4\u0dd2\u0da7\u0dd2\u0dba\u0dd9\u0d9c\u0dca \u0dd9\u0dbb\u0ddc\u0dc4\u0dcf\u0db1\u0dca \u0dd9\u0db4\u0dd9\u0dbb\u0dca\u0dbb\u0dcf, \u0dd9\u0db1\u0ddc.192/144 \u0d92, 10\u0dc0\u0db1 \u0db4\u0da7\u0dd4\u0db8\u0d9c, \u0d86\u0dc3\u0dd2\u0dbb\u0dd2 \u0d8b\u0dba\u0db1, \u0db8\u0dad\u0dca\u0dd9\u0dad\u0dca\u0dd9\u0d9c\u0ddc\u0da9 \u201d \u0dba\u0db1\u0dca\u0db1\u0daf, \u201c \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc4\u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0d85\u0d82\u0d9a\u0dba\u2019\u2019 \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0da7 \u201c 653340281v\u201d \u0dba\u0db1\u0dca\u0db1\u0daf,\u201c \u0dc0\u0dd2\u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba\u0db1\u0dca \u0dc3