  },
  {
    "page_number": 0,
    "bbox": [
      81.69,
      416.65,
      539.93,
      451.72
    ],
    "text": "(a)declare that the area of land specified in the Schedule hereto shall be an Urban Development Area for thepurpose of the aforesaid Ordinance and shall be called the \u201cSoragune Kuda Kataragama Devalaya SacredArea\u201d ; and",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
