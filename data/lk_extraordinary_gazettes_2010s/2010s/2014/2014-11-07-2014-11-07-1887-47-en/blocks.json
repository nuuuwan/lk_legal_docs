  },
  {
    "page_number": 0,
    "bbox": [
      50.76,
      380.59,
      286.62,
      460.78
    ],
    "text": "I, hereby give notice, under Subsection (1) of Section 7 of the Land Acquisition Act, that the Government intends to acquire the following land which is required for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.980000019073486,
      10.020000457763672,
      16.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.76,
      461.05,
      286.5,
      553.8
    ],
    "text": "Description of the Land to be acquired: Three (03) allotments of land in total extent of 0.0017 Hectare, shown in Preliminary Plan No. GAM. 3937 prepared by Survey Superintendent of Gampaha District, situated at Wanawasala village in Minor Division Ram Pattuwa in the Divisional Secretary\u2019s Division in Kelaniya in Gampaha District in the Western Province.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.020000457763672,
      10.979999542236328
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.76,
      553.95,
      286.53,
      640.02
    ],
    "text": "1. Lot No. 01 Name of the Land: Assessment, No. not known; Description: Waste Land; Claimant: State; Original Claimant: Encroached by W. A. Vialot, No. 29, Wanawasala Road, Thorana Junction, Kelaniya; Extent: 0.0003 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      3.0,
      10.020000457763672,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.76,
      640.64,
      286.57,
      713.64
    ],
    "text": "2. Lot No. 02 Name of the Land: Assessment, No. not known; Description: Waste Land; Claimant: State; Original Claimant: W. A. Vialot, No. 29, Wanawasala Road, Thorana Junction, Kelaniya; Extent: 0.0010 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.020000457763672,
      13.979999542236328
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.14,
      346.27,
      539.56,
      429.06
    ],
    "text": "3. Lot No. 03 Name of the Land: Assessment, No. not known; Description: Waste Land; Claimant: State; Original Claimant: K. W. Sureka Chandani, No. 29, Wanawasala Road, Thorana Junction, Kelaniya; Extent: 0.0004 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.14,
      441.55,
      564.64,
      714.0
    ],
    "text": "All persons interested in the aforesaid land are hereby required to appear personally, or by agents duly authorized in writing, before me at Divisional Secretariat, Kelaniya on the 20th day of November, 2014 at 10.00 a. m. and are hereby requested to notify to me in writing (in duplicate) on or before the 13th day of November, 2014 the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land the amount of compensation and the details of the computation of such amount. PUBUDIKA S. BANDARA, Divisional Secretary, Kelaniya. Kelaniya Divisional Secretariat, Mahara, Kadawatha, 05th November, 2014. 11-681",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.980000019073486,
      10.020000457763672
    ]
