      "TimesNewRoman"
    ],
    "sizes": [
      9.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      86.59,
      536.22,
      489.11,
      546.19
    ],
    "text": "02.What should be the retiring age of Mr. P. A. A. Gunatilake according to the said date of first appointment?",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      9.0
    ]
