    ],
    "text": "Notice Calling for Nominations for the Appointment of Mediators",
    "fonts": [
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      54.0,
      414.12,
      539.87,
      676.88
    ],
    "text": "The Mediation Boards Commission, by virtue of the powers vested in it by Section 5(1) of The Mediation Boards Act, No.72 of 1988, invites nominations for the appointment of Chairman and Mediators in respect of the following Panels of Mediation Boards who are to vacate post in terms of Sections 6 to 11 in Schedule 1 of the Mediation Boards Act. Administrative District Mediation Board Areas Date of Vacation of Post Colombo 01. Hanwella 2019.10.15 Kalutara 01. Madurawala 2019.12.15 02. Baduraliya 2019.12.15 Kandy 01. Medadumbara 2019.11.01 02. Kandy (T&G) 2019.12.01 03. Deltota 2019.12.15 Mathale 01. Pussella 2019.10.14 02. Mathale 2019.11.15 Nuwaraeliya 01. Walapane 2019.10.01 Galle 01. Thawalama 2019.10.01 02. Bope Poddala 2019.11.15",
    "fonts": [
      "IskoolaPota",
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
