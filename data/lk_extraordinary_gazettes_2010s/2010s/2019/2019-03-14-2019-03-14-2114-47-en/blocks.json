    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.29,
      462.73,
      546.42,
      512.8
    ],
    "text": "I, Harin Fernando, the Minister of Telecommunication, Foreign Employment and Sports, in pursuance of powers vested inme under Sections 32(b) and 33 of the Sports Act, No. 25 of 1973, do hereby suspend the registration of Sri LankaArchery Association, the National Association for Archery with immediate effect and appoint the following InterimCommittee to continue the activities thereof as a provisional arrangement.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      85.17,
      527.65,
      325.89,
      564.76
    ],
    "text": "01.Dr. Seevali Jayawickrama-President02.Mrs. Nadeeka Damayanthi-Member03.Mr. W. D. S. Fernando-Member",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.29,
      579.73,
      546.38,
      628.12
    ],
    "text": "And I, do hereby authorize the Director General of the Department of Sports Development to convene a SpecialGeneral Meeting of Sri Lanka Archery Association and appoint an Election Committee in terms of the Sports Act, No. 25of 1973 and subsequent amendments made thereto and convene and conduct the election under supervision of the DirectorGeneral.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
