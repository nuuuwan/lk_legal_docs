      496.08,
      531.32,
      542.15
    ],
    "text": "SAJITH PREMADASA,Minister of Housing, Construction and Cultural Affairs.Colombo,06th March, 2019.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      6.953384876251221,
