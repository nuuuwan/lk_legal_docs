  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      429.97,
      539.91,
      452.08
    ],
    "text": "This Order shall be valid for a period of 06 months commencing from February 09, 2019, subject to provisionsof Sub Section (3) of Section 2 of the Special Commodity Levy Act, No. 48 of 2007.",
