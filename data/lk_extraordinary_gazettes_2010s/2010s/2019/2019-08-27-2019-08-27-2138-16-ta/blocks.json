    "text": "\u0bc6\u0ba4\u0ba9\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0bae\u0bcd, \u0b95\u0bbe\u1fa2 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0b95\u0bbe\u1fa2 \u0ba8\u0bbe\u0ba9\u0bcd\u0b95\u0bc1 \u0b95\u0b9f\u0bc8\u0bb5\u0b95\u0bb3\u0bcd \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b95\u0bbe\u1fa2 \u0bae\u0bbe\u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0baf\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 101 \u0baa\u0bc0 \u0bae\u0bbf\u0bb3\u0bbf\u0ba4\u0bcd\u1f90\u0bb5 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0bae\u0bbf\u0bb3\u0bbf\u0ba4\u0bcd\u1f90\u0bb5 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3, \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0ba8\u0bbe\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd",
