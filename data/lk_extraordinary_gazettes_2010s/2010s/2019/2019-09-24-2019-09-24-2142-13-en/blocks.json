      701.53,
      295.09,
      736.6
    ],
    "text": "01. Lot No. 4035Name of the land: Kumarawattha; Claimant: Land reformcommission; Extent: 0.2860 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
