87\u0bb2. 400 - \u0bae\u0bc0\u0b95\u1fc4\u0bc6\u0b9a\u0b95\u0bae, 403 - \u1f81\u1f9e\u1fb8\u1f90\u0bc6\u0bb5\u0bb5, 404 - \u0b87\u0bb9\u0bb2\u0ba4\u0bb2\u0bbe\u0bb5, 406 - \u0b95\u0bb0\u0b95\u0bb9\u0bc6\u0bb5\u0bb5 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u0b95\u1fbb\u0baa\u0bbf\u0bbe\u0bbf\u0b95\u1fc4\u0bc6\u0bb5\u0bb5, \u0b87\u0bb9\u0bb2\u0ba4\u0bb2\u0bbe\u0bb5, \u1f81\u1f9e\u1fb8\u1f90\u0bc6\u0bb5\u0bb5, \u0bae\u0bc0\u0b95\u1fc4\u0bc6\u0b9a\u0b95\u0bae, \u0ba4\u1fbb\u0bc6\u0bae\u1fb9\u0ba9\u0bbe\u0bb5, \u0ba4\u0bb2\u0bbe\u0bb5, \u0bb5\u0bb0\u0bbe\u0bc6\u0b95\u0bbe\u0b9f \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\u1f90\u1fbb 110135 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 01 \u0b87\u1fbf \u0b85\u0b9f\u1fb1\u0b95\u0bbf\u1f9c\u1fc0\u0bb3\u1f90\u0bae\u0bbe\u0ba9 1074, 1075, 1080, 1100, 1101, 1102, 1111, 1122, 1131, 1132, 1141, 1142, 1144, 1145, 1150, 1151, 1180, 1181, 1195, 1208, 1220, 1222, 1223 \u0bae\u1fbe\u1fa0\u1fbb 1267 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb1\u0b95\u0bc8\u0bb3\u1fb0 \u0bc6\u0b95\u0bbe\u1fb6\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u1fa6\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb7 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b87\u0ba4\u0bc7\u0ba9\u0bbe\u1f8c \u0b87\u0bc8\u0ba3\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf \u0ba4\u0bb0\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b8e\u0ba9\u1f90 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0b87\u1fb7\u0ba4\u0bbe\u1fbf \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u1f90\u0b95\u0bbf\u1fb9\u0bc7\u0bb1\u1fb9.",
