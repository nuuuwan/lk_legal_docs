87\u0bb2. 379 - \u0bc6\u0b95\u0bc7\u0bb2\u0ba4\u0bbf\u1fab\u1fbf\u0bc6\u0bb5\u0bb5, 345 - \u1f90\u1f94\u0bc6\u0baa\u0bbe\u0ba4\u0b95\u0bae, 373 - \u0b8e\u1fba\u0baa\u0bbe\u0bb5\u0bb2, 375 - \u0b95\u0bbf\u0bbe\u0bbf\u0b85\u1f99\u1f8e\u0bc6\u0b95\u0bbe\u0bc7\u0bb2, 378 - \u0b95\u1fbf\u0bae\u1f8c\u0bb5, 380 - \u0bc6\u0b95\u0bc7\u0bb2\u0b9a\u0bbf\u0baf\u1fbb\u0baa\u0bc6\u0bb2\u0bb5, 381 - \u0bc6\u0bae\u0ba4\u0b95\u0bae, 382 - \u0b87\u0bb9\u0bb2\u0b95\u0bae, 393 - \u0b8e\u1fb8\u0ba4\u0b95\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u0b8e\u1fb8\u0ba4\u0b95\u0bb2, \u0b85\u1fa8\u1fb7\u0bc6\u0bb5\u0bb5, \u0b87\u0bb9\u0bb2\u0b95\u0bae, \u0b8e\u1fba\u0baa\u0bbe\u0bb5\u0bb2, \u0b95\u1fbf\u0bae\u1f8c\u0bb5, \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fbb 07, \u0b95\u1fbb\u0bae\u0bbe\u0ba9\u0baf 8, \u0b95\u1fb5\u1f8a\u1f81\u0bb2\u0bae, \u0bc6\u0bae\u0ba4\u0b95\u0bae, \u0bae\u0bc0\u0b95\u0bb9\u0bc6\u0bb5\u0bb5, \u0bae\u0bc0\u0b95\u1fc4\u0bc6\u0b9a\u0b95\u0bae,\u0ba4\u1fbf\u0bb2\u1f99\u1fb7\u0bb0\u0bbe\u0bb5 \u1faa\u0ba4\u0bbf, \u0bc6\u0baa\u0bbe\u1fb7\u0bc7\u0ba4\u0b95\u0bae, \u0ba4\u1fbb\u0bc6\u0bae\u1fb9\u0ba9\u0bbe\u0bb5, \u0ba4\u1fbb\u0bc6\u0bae\u1fb9\u0ba9\u0bbe\u0b95\u0bae \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\u1f90\u1fbb 110101 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 01 \u0b87\u1fbf \u0b85\u0b9f\u1fb1\u0b95\u0bbf\u1f9c\u1fc0\u0bb3\u1f90\u0bae\u0bbe\u0ba9 849, 850, 851, 852, 853, 854, 855, 856, 857, 858, 859, 860, 861, 862, 863, 864, 865, 866, 867, 868, 869, 870, 871 \u0bae\u1fbe\u1fa0\u1fbb 872 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb1\u0b95\u0bc8\u0bb3\u1fb0 \u0bc6\u0b95\u0bbe\u1fb6\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u1fa6\u1fb0\u0b95\u0b