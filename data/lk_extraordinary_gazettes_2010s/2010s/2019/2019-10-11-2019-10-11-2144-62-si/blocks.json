  {
    "page_number": 0,
    "bbox": [
      50.88,
      604.39,
      539.66,
      665.6
    ],
    "text": "\u0db8\u0db0\u0255\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0db8\u0dcf\u0dad\u0dd9\u0262 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0dbb\u01ae\u0dd9\u0dad\u02a3\u0da7 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d85\u0d82\u0d9a E 375A, \u0dd9\u0db6\u02a4\u01dd\u0dd9\u0d9a\u02a3\u017b\u0dc0, \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0dd9\u0db6\u02a4\u01dd\u0dd9\u0d9a\u02a3\u017b\u0dc0 \u0d9c\u0dd9\u023c \u0218\u028f\u0179, \u0db6\u0dbd\u0dba \u0dbd\u01ae \u023d\u01e7\u01e6\u0dd9\u0daf\u02a4\u025e \u018c.\u0d86\u0259.\u0d91\u023c.\u018c.\u0db6\u019c\u0da9\u0dcf\u0dbb \u0db8\u0dc4\u0dad\u0dcf \u026a\u0286\u01e6 \u0db8\u0dd0\u0db1 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a 2498 \u0daf\u0dbb\u0db1 \u0db6\u0dbd\u0dba\u0dbd\u01ae \u023d\u01e7\u01e6\u0dd9\u0daf\u02a4\u025e \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0dd9\u023c \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 1,2,3,4 \u0dc4\u0dcf 5 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u2018\u2018\u0db4\u01e6\u0dc3\u0dd9\u0262 \u00fd\u0249\u0dbb, \u0db4\u0262\u0dd9\u0262\u0db4\u0dd1\u0dbd \u0db1\u0dc0\u0dd9\u01ae \u00fd\u0249\u0dbb (\u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa), \u0db1\u0dc0\u0dd9\u01ae \u00fd\u0249\u0dbb (\u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa), \u0d85\u023f\u0dd9\u01e6\u0dd9\u0dc0\u0dd9\u0262 \u0dd9\u0d9c\u0daf\u0dbb \u0dc0\u01ae\u0dad (\u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa),\u2019\u2019 \u0db1\u0db8\u0dd0\u01af \u0d89\u0da9\u023c \u0dc0\u0263\u01e6 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0db8\u0dcf\u0250\u023c \u01b1\u0dc5 \u0218\u028f\u0179 \u025f\u018a 1 \u0db4\u0259\u0da0\u0dc3\u0dca 38.6 \u00fa \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0db4\u0dc4 .",
