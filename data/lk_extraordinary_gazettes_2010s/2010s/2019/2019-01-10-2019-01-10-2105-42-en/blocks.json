    "bbox": [
      321.84,
      331.92,
      562.01,
      377.99
    ],
    "text": "01. Lot No. 01 & 02Name of Land: Kulaielanthai; Present use of the land: Bareland; Claimant: Government; OriginalClaimant: Mr. M. S. M.Salihu, Tharapuram, Mannar; Extent: 2.8518Hectares.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      321.84,
      384.72,
      562.12,
      502.79
    ],
    "text": "All persons interested in the aforesaid land/lands onwhich a servitude is to be acquired are hereby required toappear personally, or by agents duly authorised in writing,before me at 10.00 a.m. on the 15th day of February, 2019 atMannar town Divisional Secretariat, and are hereby requestedto notify to me in writing [in duplicate] on or before the08.02.2019, the nature of their interests in the land, theparticulars of their claims for compensation for the acquisitionof the said land/servitude, the amount of compensation and thedetails of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
