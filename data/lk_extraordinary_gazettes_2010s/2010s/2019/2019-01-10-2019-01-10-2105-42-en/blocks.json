  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      411.36,
      308.28,
      469.43
    ],
    "text": "I hereby give notice under Sub-section (1) of Section 7 ofthe Land Acquisition Act, as amended by the Land (Amendment)Act, No. 28 of 1964 that the Government intends to acquirethe following lands/Servitude which is required for a publicpurpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      483.36,
      296.25,
      493.43
    ],
    "text": "Description of the land or Servitude to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      510.48,
      308.32,
      609.35
    ],
    "text": "The land allotment called Kulaielanthai in total extent ofabout 2.8518 Hectares depicted as Lot No. 1 & 2 in Plan No;MN778 and prepared by Surveyor General situated in theVillage called Nadukkuda, in the Grama Niladhari DivisionNo. 54 of Tullukkudiyiruppu, in the Divisional Secretary'sDivision of Mannar Town of Mannar District in NorthernProvince.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
