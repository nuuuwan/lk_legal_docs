  },
  {
    "page_number": 0,
    "bbox": [
      321.84,
      414.96,
      561.96,
      449.03
    ],
    "text": "Name and address of the claimant: Chandrasiri Alawatta, No.135, New Galle Road, Kapparatota, Weligama; Extent: 0.0986Hectare.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      321.84,
      462.96,
      562.22,
      581.03
    ],
    "text": "All persons interested in the aforesaid land/lands on whicha servitude is to be acquired are hereby required to appearpersonally or by agents duly authorized in writing, before meat Divisional Secretariat of Weligama, on the 28th day ofAugust, 2019 at 9.30 a.m. and are hereby requested to notifyto me in writing (in duplicate) on or before the 21st day ofAugust, 2019 the nature of their interests in the land, theparticulars of their claims for compensation for the acquisitionof the said land/servitude, the amount of compensation andthe details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
