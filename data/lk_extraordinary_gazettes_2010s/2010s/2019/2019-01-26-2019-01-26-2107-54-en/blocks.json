      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      56.4,
      631.28,
      294.49,
      652.88
    ],
    "text": "Name of land: Selluvari; Present use of the land: Gardencontains Palmyra Trees; Claimant by: Land Reform",
