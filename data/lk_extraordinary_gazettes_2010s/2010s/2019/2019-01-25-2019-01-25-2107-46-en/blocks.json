      403.03,
      295.16,
      425.12
    ],
    "text": "My No.: EMDS/LND/05/ACQ/02/09.Ministry of Land Reference No.: 4-3/15/2013/VE/619.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
