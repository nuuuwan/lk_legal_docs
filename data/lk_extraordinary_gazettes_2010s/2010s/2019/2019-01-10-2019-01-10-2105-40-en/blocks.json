    "bbox": [
      50.64,
      378.32,
      286.44,
      416.25
    ],
    "text": "My No.: MN/DS/L/D1/AQ/WPP/14. Land Ministry Ref. No.: 4-3/2/2017/CEB/251.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.9994001388549805,
