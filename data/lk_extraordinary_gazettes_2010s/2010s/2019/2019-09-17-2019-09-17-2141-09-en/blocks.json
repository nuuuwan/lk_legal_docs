  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      478.63,
      286.68,
      573.92
    ],
    "text": "Land Ministry\u2019s Reference No.: 4-3/8/2016/HA/284. I hereby give notice, under Sub-section (1) of Section 7 of the land Acquisition Act, as amended by Land Acquisition (Amendment) Act, No. 28 of 1964, that the Government intends to acquire the following land/servitude which is required for a public purpose.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613,
      13.918607711791992
