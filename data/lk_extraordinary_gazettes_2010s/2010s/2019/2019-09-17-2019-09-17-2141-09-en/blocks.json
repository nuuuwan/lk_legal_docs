  },
  {
    "page_number": 0,
    "bbox": [
      58.08,
      575.35,
      221.4,
      585.44
    ],
    "text": "Description of the Land to be acquired :",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      587.1,
      286.64,
      643.99
    ],
    "text": "Situated in the Village of Kahawatta in the Grama Niladhari Division of Kahawatta (189A), in Pallepaththu of the Divisional Secretary\u2019s Division of Elapatha, in Ratnapura District, Sabaragamuwa Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613,
      11.038795471191406
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      645.89,
      286.73,
      680.96
    ],
    "text": "Plan No. F. V. P. 58, Supplement No. 11, Sheet No. 12.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613,
      11.998800277709961
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      682.4,
      286.67,
      715.56
    ],
    "text": "Lot No. 232 - Name of the land: Gangagawawatta; Extent: 0.0126 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.56,
      418.16,
      542.49,
      451.28
    ],
    "text": "Bounded by North : Lot No. 9; East : Lot No. 9; South: Lot No. 9; West: Lot No. 9.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.56,
      452.0,
      539.85,
      480.08
    ],
    "text": "Claimed by: Konara Mudiyanselage Subasinghe, Kahawatta, Dambuluwana.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.039495944976807,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.56,
      480.34,
      542.46,
      543.2
    ],
    "text": "All persons interested in the aforesaid land/servitude are hereby required to appear personally, or by agent duly authorized in writing, before me at the Divisional Secretariat, Elapatha at 10.30 a. m. On the 16th day of December 2019.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      1.9198079109191895,
      3.119687795639038,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.56,
      543.66,
      539.85,
      625.99
    ],
    "text": "Further, they should notify me in writing and in duplicate before the 09th December 2019, the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land/servitude, the amount of compensation and the details of the computation of such amount. Documents should be submitted to me on the same date to prove the interests.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      1.9198079109191895,
      10.078991889953613
    ]
  },
