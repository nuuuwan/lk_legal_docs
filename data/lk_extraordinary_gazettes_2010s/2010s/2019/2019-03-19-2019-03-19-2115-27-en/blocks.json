    "bbox": [
      55.29,
      468.73,
      546.42,
      531.76
    ],
    "text": "I, Harin Fernando, Minister of Telecommunication, Foreign Employment and Sports in pursuance of powers vested in meunder Sections 32(b) and 33 of the Sports Act, No. 25 of 1973 do hereby further extend the period of suspension of theSri Lanka Hokey Federation, the National Federation for Hokey and the following Interim Committee is appointed as aprovisional arrangement to continue the activities of the above Hokey Federation to finalize the election activities underthe supervision of Director General of the Department of the Sports Development.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      90.33,
      546.73,
      345.94,
      583.72
    ],
    "text": "Mr. Nishantha Anuruddha Weerasinghe-PresidentMr. H. A. W. Abayakumara-SecretaryMrs. K. K. S. K. Wijesinghe-Treasurer",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
