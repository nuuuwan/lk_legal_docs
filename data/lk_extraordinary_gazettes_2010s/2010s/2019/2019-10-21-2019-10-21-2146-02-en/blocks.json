      516.24,
      310.07,
      538.31
    ],
    "text": "My No.: KEG/LAN/AQUIS/A3/1/110.Land Ministry Ref. No.: 4-3/15/2016/VE/322.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
