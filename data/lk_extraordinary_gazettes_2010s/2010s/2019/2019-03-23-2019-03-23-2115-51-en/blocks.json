  {
    "page_number": 0,
    "bbox": [
      71.04,
      504.48,
      311.28,
      562.55
    ],
    "text": "IT is hereby give notice under Sub-section (1) of Section 7 ofthe Land Acquisition Act as amended by the Land Acquisition(amendment) Act, No. 28 of 1964 that the government intendedto acquire the following land or servitude which is requiredfor public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      71.04,
      571.68,
      311.13,
      641.75
    ],
    "text": "Below mentioned land depicted as Lot No. 1 in plan No. PP/MR/2761 situated in the village of Malimbada, in MalimbadaDivisional Secretariat Division, in Matara District, in SouthernProvince was acquired for the construction of \"ThulumanLinda\" and pumping station under water supply scheme ofIV th Step, Matara.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      71.04,
      650.88,
      310.91,
      708.95
    ],
    "text": "Sub Schedule01. Lot No. 01Name of the land: Hettigewatta; Description of the Land:Scrub; Initial claimant of the Land: K. K. Nilantha Lakmal,Kithalagama East (iii), Thihagoda; Extent: 0.0846 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      330.96,
      435.12,
      562.27,
      445.19
    ],
    "text": "All persons interested in the aforesaid land/servitude is to",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
