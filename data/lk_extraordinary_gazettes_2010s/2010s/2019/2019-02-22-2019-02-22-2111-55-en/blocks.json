  },
  {
    "page_number": 0,
    "bbox": [
      321.84,
      330.0,
      562.12,
      376.07
    ],
    "text": "All those who make claims or other connections to theabove-named land, or those who have been authorized inwriting by them have to meet at 10.00 a.m. on the day of27.03.2019.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
