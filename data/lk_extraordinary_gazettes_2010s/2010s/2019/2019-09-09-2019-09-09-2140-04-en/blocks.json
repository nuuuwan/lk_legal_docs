    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      440.65,
      537.98,
      478.72
    ],
    "text": "THE Public Service Commission has ordered to amend the Service Minute of the Public Management Assistants ServicePublished in the Gazette Extraordinary of the Democratic Socialist Republic of Sri Lanka No. 1840/34 dated 11.12.2013as amended by the Gazette Extraordinary No. 2032/26 dated 16.08.2017 and No. 2052/26 dated 04.01.2018 as follows :",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      77.01,
      494.65,
      537.82,
      519.16
    ],
    "text": "1.The title of the Service Minute referred to as the \u201cMinute of the Public Management Assistants\u2019 Service\u201dwill be substituted by the following title.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      98.85,
      535.09,
      356.3,
      546.16
    ],
    "text": "\u201cService Minute of the Management Service Officers Service\u201d",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      77.01,
      562.09,
      537.98,
      613.72
    ],
    "text": "2.Every term referred to as \u201cPublic Management Assistants\u2019 Service\u201d and every term referred to as \u201cPublicManagement Assistant\u201d in the relevant Service Minute shall be amended as \u201cManagement Service OfficersService\u201d and \u201cManagement Service Officers\u201d respectively and the term referred to as \u201cOfficer\u201d in the saidService Minute shall be reckoned as Management Service Officers.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      315.09,
      629.65,
      482.5,
      654.16
    ],
    "text": "K. V. P. M. J. GAMAGE,Director General of Combined Services.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.0,
      10.0
    ]
