    ]
  },
  {
    "page_number": 0,
    "bbox": [
      70.08,
      391.68,
      310.07,
      445.91
    ],
    "text": "I hereby give notice, under Sub section (1) of Section 7 ofthe land Acquisition Act, (Chapter 460) as amended by theLand Acquisition (Amendment) Act, No. 28 of 1964, that theGovernment intends to acquire the following Land for a publicpurpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      80.16,
      454.8,
      283.12,
      464.87
    ],
    "text": "Description of the land or servitude to be acquired:",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      70.08,
      473.76,
      310.0,
      560.87
    ],
    "text": "The Lots 01 and 02 of the land called Ambalampitiyawatte& Hapugodadeniya Kumbura in total extent of Hectare 0.0592depicted in the preliminary plan No. Maha/6868 and dated on06th December 2018, prepared by the Surveyor Generalsituated at Alwathugoda Village of Alawathugoda GramaNiladhari Division at Udagampaha Korale Minor division inthe Akurana Divisional Secretary's Division of Kandy Districtin the Central Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      70.08,
      571.68,
      309.81,
      592.84
    ],
    "text": "01. Lot No. 1 - Name of the land: Ambalampitiyawatte,Hapugodadeniya Kumbura; Extent: 0.0084 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      70.08,
      615.84,
      310.09,
      669.83
    ],
    "text": "North: Lot No. 05 of B.P.A 2222 & AmbalampitiyawatteHapugodadeniya Kumbura claimed by M.O.A.Kareem andOthers; East: Lot No. 2; South: Lot No. 2 and Lot No. 01 ofB.P. Maha-1527; West: Lot No. 01 and B.P.Maha - 1527 and LotNo. 05 of B.P.A 2222.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      71.28,
      739.65,
      155.21,
      747.56
    ],
    "text": "G 29205 - 27 (2019/01)",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
