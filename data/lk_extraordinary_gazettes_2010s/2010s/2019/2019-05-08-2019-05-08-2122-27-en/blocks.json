      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.44,
      527.36,
      295.52,
      622.88
    ],
    "text": "Land called in Ketangahakoratuwa, Pallemeathmaga, Pallamaand Ambagahawela depicted as Lot Nos. 732 and 733 (Lots02) in total extent of about 0.0058 Hectare, of land in FinalVillage Plan No. 328 dated 30.09.2016 prepared by the SurveyorGeneral situated in the village Ranna and Minor Division ofNegenahira Giruwa Pattuwa in the Grama Niladari Division ofRanna West Divisional Secretary's Division of Tangalle inHambanthota District in Southern Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
