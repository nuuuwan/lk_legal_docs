    "bbox": [
      55.44,
      419.36,
      295.4,
      453.44
    ],
    "text": "I hereby give notice under Sub-section (1) of Section 7 of theLand Acquisition Act, that the Government intends to acquirethe following land which is required for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      65.52,
      467.35,
      275.91,
      477.43
    ],
    "text": "Description of the land or Servitude to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.44,
      491.36,
      295.09,
      513.43
    ],
    "text": "Land Acqusition of the Bridge No. 210/3 of Colombo, Galle,Hambanthota, Wellawaya Road.",
