  {
    "page_number": 1,
    "bbox": [
      63.31,
      159.17,
      538.78,
      197.87
    ],
    "text": "2.The amount of the fees levied to enter person and vehicles to any Botanic Gardens shall be as mentioned in theschedule here.Even though the below mentioned persons will be exempted from paying this entrance fee :",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      10.0
    ]
  },
