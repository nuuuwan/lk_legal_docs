    "text": "\u0db8\u0dcf\u0dd9\u0d9c\u01e6 \u0dd9\u0dc4\u02a4 \u0db6\u0dbd\u0dba \u0dbd\u01ae \u01e7\u0dbd\u0db0\u0dcf\u025c\u0dba\u00fd\u0dd9\u0118 \u0263\u0110\u0dad \u0d85\u0db1\u0dc3\u0dbb\u0dba\u00fb\u01e6 \u0dd9\u0dad\u02a3\u0dbb\u0dc0 \u00fb\u0286\u0dc0\u00fd \u026a\u0286\u01e6 \u0dd9\u0dc4\u02a4 2019 \u0dd9\u0daf\u0dc3\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 10 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0286\u0da7 2020 \u0db8\u0dd0\u0250 \u0db8\u0dc3 08 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf \u0d9a\u0dcf\u0dbd\u0dba \u01b1\u0dc5 \u0dc3\u0dca\u01c2\u0dbb \u0dd9\u0dc4\u02a4 \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0263\u0d9a \u0dd9\u0d9c\u02a3\u0da9\u0db1\u0dd0\u0119\u0262\u0dbd\u00fa \u0dd9\u0dc4\u02a4 \u0db1\u0dc0\u0dcf\u0dad\u0dd0\u0db1\u00fa \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0dc5\u0db3\u0dc3\u0dd0\u0dbd\u00fa \u0d89\u01ce\u00fb\u025d\u0db8 \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1\u0dba. 03. \u0dba\u0dcf\u0da0\u0d9a\u0dd9\u0dba\u02a4 : \u0286\u025c\u0db4\u0dcf \u0db8\u029a\u0dc0 \u021d\u0dd9\u01ca\u0dc1\u0dd9\u024f \u0dd9\u0dc4\u02a4 \u0d85\u023c\u0db6\u0dbd\u023c/\u026a\u0279\u0dcf\u0db8\u0dc1\u0dcf\u0dbd\u0dcf \u021d\u0dd9\u01ca\u0dc1\u0dd9\u024f \u00fb\u0286\u0db8 \u0dad\u0dd0\u0db1\u0d9a \u01cf \u0dba\u0dcf\u0da0\u0d9a\u0dba\u01e6 \u026a\u0286\u01e6 \u028f\u0d9f\u0db8\u01e6 \u0d89\u0262\u0264\u0db8 \u0dd9\u0dc4\u02a4 \u0dbd\u0db6\u0dcf\u0d9c\u0dd0\u01e8\u0db8 \u0daf \u00fb\u0286\u0dc0\u00fd \u026a\u0286\u01e6 \u028f\u0d9f\u0db8\u01e6 \u01cf\u0db8 \u0dd9\u0dc4\u02a4 \u0dd9\u0db6\u0daf\u0dcf\u01cf\u0db8 \u0daf \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1\u0dba. 04. \u0db1\u0dd1\u0db8 \u0dc3\u0dc4 \u0dd9\u0dc3\u02a2\u01cf\u0db8 : 4.1 \u0daf\u0dd0\u0db1\u0da7\u0db8\u01ae \u0dc0\u0db1 \u0dc3\u0d82\u0dbb\u00fa\u0dc2\u0dab \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dc0, \u0db8\u0db0\u0255\u0db8 \u0db4\u025c\u0dc3\u0dbb \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dba \u0dc3\u0dc4 \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0db8\u0119\u01e6 \u0dc4\u01ff\u0db1\u0dcf\u0dd9\u0d9c\u0db1 \u0db1\u023c\u0d9a\u0dbb \u0d87\u01af \u0d86\u0dbb\u00fa\u027f\u0dad \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dc0\u0dbd \u01cf \u0dc4\u0dd0\u0dbb \u01ce\u0dba \u0db1\u0dd1\u0db8 \u0dd9\u0dc4\u02a4 \u0dd9\u0dbb\u01ce \u0dd9\u0dc3\u02a2\u01cf\u0db8 \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1\u0dba. 4.2 \u0dd9\u0db4\u02a5\u01ca\u0d9c\u0263\u0d9a \u0d86\u0dba\u0dad\u0db1 \u0db8\u0119\u01e6 \u01ce\u0dba\u0db1\u0dd1\u0db8 \u0dd9\u0dc4\u02a4 \u0dd9\u0dbb\u01ce \u0dd9\u0dc3\u02a2\u01cf\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc4\u0288\u0d9a\u023c \u0dc3\u0dd0\u0dbd\u0287\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u02a3\u0dd9\u0dbb\u02a3\u01ae\u01b1 \u0dc0\u01e6\u0dd9\u01e6 \u0db1\u023c \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0dc3\u0d82\u0dbb\u00fa\u0dc2\u0dab \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dc0, \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc3\u0dc4 \u0db8\u0db0\u0255\u0db8 \u0db4\u025c\u0dc3\u0dbb \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dba \u0dd9\u0dc0\u01af\u01e6 \u026a\u01dd\u0db8\u01ae \u021b\u0259\u0dc0 \u0263\u0110\u0dad \u0d85\u0dc0\u0dc3\u0dbb\u0dba\u00fa \u0dbd\u0db6\u0dcf\u0d9c\u0dad \u0252\u01b1\u0dba. 05. \u0dc0\u0dcf\u0dc4\u0db1 /\u0d9c\u0db8\u01e6 \u0db8\u0dcf\u0259\u0d9c : 5.1 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0dd9\u0dc4\u02a4 \u0d85\u0daf\u0dcf\u0dc5 \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba \u026a\u0286\u01e6 \u0dd9\u0dc0\u01e6\u0d9a\u0dbb \u0d87\u01af \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dc0\u0dbd \u0dc4\u0dd0\u0dbb \u0dd9\u0dc0\u0db1\u01ae \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dc0\u0dbd \u0dc0\u0dcf\u0dc4\u0db1 \u0d9c\u0dcf\u0262 \u00fb\u025d\u0db8 \u0dd9\u0dc4\u02a4 \u0d87\u01b1\u029a \u00fb\u025d\u0db8 \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1\u0250. 5.2 \u0dc0\u01e6\u0daf\u0db1\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc0\u01e6\u0d9a\u0dbb \u0d87\u01af \u0db8\u0dcf\u0259\u0d9c\u0dc0\u0dbd \u0dc4\u0dd0\u0dbb \u0dd9\u0dc0\u0db1\u01ae \u026a\u0d9a\u0262\u0db4 \u0db8\u0dcf\u0259\u0d9c \u0dc3\u0d9a\u0dc3\u0dca \u00fb\u025d\u0db8 \u0dd9\u0dc4\u02a4 \u0db7\u0dcf\u026a\u0dad\u0dcf \u00fb\u025d\u0db8 \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1\u0250. 06. \u0db4\u025c\u0dc3\u0dbb\u0dba \u0dc4\u0dcf \u0dc3\u01e8\u0db4\u0dcf\u0dbb\u00fa\u0dc2\u0dcf\u0dc0 : 6.1 \u0dc0\u01e6\u0daf\u0db1\u0dcf \u0db8\u0dcf\u0259\u0d9c\u0dd9\u024f \u0dd9\u0dc4\u02a4 \u0286\u025c\u0db4\u0dcf \u0db8\u029a\u0dc0 \u0db4\u025c\u0279\u0dd9\u024f \u0dd9\u0dc4\u02a4 \u026a\u0279\u0dcf\u0db8 \u0dc1\u0dcf\u0dbd\u0dcf \u0d85\u0dc0\u0da7 \u0db4\u025c\u0dc3\u0dbb\u0dba\u0da7 \u0dd9\u0db4\u02a3\u0263\u01af\u01e6, \u0217\u0dbd\u0dcf\u0dc3\u0dca\u0179\u00fa \u0d85\u026a\u01dd\u0db8\u01ae \u0db4\u025c\u01ce \u0db4\u025c\u0dc3\u0dbb\u0dba\u0da7 \u0db6\u0dd0\u0dc4\u0dd0\u0dbb \u00fb\u025d\u0db8 \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1\u0250. 6.2 \u027c \u0db4\u0dcf\u0daf \u0d85\u0da9\u026a\u0dba \u01b1\u0dc5 \u00fb\u0286\u0db8 \u0dd9\u0dc4\u02a2\u01b1\u0dc0\u00fa \u01e7\u0dc3\u0dcf \u0119\u01e6\u0db1\u00fa \u0d87\u01af\u0dc0\u0db1 \u0d86\u0d9a\u0dcf\u0dbb\u0dd9\u024f \u0119\u01e7 \u0db8\u0dd0\u0dbd \u0dc3\u0dd0\u0d9a\u0287\u0db8 \u0dd9\u0dc4\u02a4 \u0119\u01e7 \u0daf\u0dd0\u0262\u026b\u0db8 \u0286\u01d0 \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1\u0dba. 6.3 \u0dc0\u01e6\u0daf\u0db1\u0dcf \u0dc0\u0dcf\u0dbb\u0dba \u01b1\u0dc5 \u0db6\u0dd0\u01af\u0db8\u01b1\u01e6 \u0dc3\u0daf\u0dc4\u0dcf \u0dc3\u01e8\u0db4\u0dcf\u0dbb\u00fa\u0dc2\u0d9a \u0db4\u0dc4\u0288\u0d9a\u023c \u0dc3\u0dd0\u0dbd\u0287\u0db8 \u0dc4\u0dcf \u0d85\u0db4\u01d6\u0dc0\u0255 \u0d89\u0dc0\u01ae \u00fb\u025d\u0dd9\u023c \u0d9a\u0da7\u0252\u01b1 \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dc0\u0dbd\u0da7 \u0dc4\u0dcf \u0db4\u0dc5\u0dcf\u01ae \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0d85\u0db0\u0255\u00fa\u0dc2 \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dba\u0da7 \u0db4\u0dc0\u0dbb\u023d. 07. \u0ddb\u0dc0\u0daf\u0255 \u0db4\u0dc4\u0288\u0d9a\u023c : \u0dd9\u0db4\u02a5\u01ca\u0d9c\u0263\u0d9a \u0d86\u0dba\u0dad\u0db1 \u0db8\u0119\u01e6 \u0db4\u0dd0\u0dc0\u0dd0\u01ae\u026b\u0db8\u0da7 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0ddb\u0dc0\u0daf\u0255 \u021d\u01af\u0d9a\u0dcf\u0dbb/\u021d\u0dae\u0db8\u0dcf\u0db0\u0dcf\u0dbb \u0db8\u0db0\u0255\u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc5\u0dcf\u01ae \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0d85\u0db0\u0255\u00fa\u0dc2\u0d9a\u0dd9\u0118 \u0dc3\u0dc4 \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dd9\u024f \u021b\u0259\u0dc0 \u0263\u0110\u0dad \u0d85\u0dc0\u0dc3\u0dbb\u0dba\u00fb\u01e6 \u0dbd\u0db6\u0dcf\u0d9c\u0dad \u0252\u01b1\u0250.",
