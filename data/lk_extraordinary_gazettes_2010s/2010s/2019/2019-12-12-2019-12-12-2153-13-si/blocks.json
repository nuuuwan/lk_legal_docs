    "text": "\u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 423 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0d9a\u0dd4\u0dbb\u0dd4\u0db3\u0dd4\u0dc0\u0dad\u0dca\u0dad\u0db4\u0dc3\u0dca\u0dc4\u0dc0\u0dd4\u0dbd\u0d95\u0dc0\u0dd2\u0da7, \u0db4\u0dc3\u0dca\u0dc4\u0dc0\u0dd4\u0dbd\u0d95\u0dc0\u0dd2\u0da7 \u0dd9\u0dc4\u0dc0\u0dad\u0dca \u0d9a\u0dd4\u0dbb\u0dd4\u0db3\u0dd4\u0dc0\u0dad\u0dca\u0dad\u0d85\u0daf\u0dca\u0daf\u0dbb \u0db8\u0dc4\u0dbd\u0dd2\u0dba\u0daf\u0dca\u0daf \u0dc3\u0dc4 \u0d9a\u0dd4\u0d9a\u0dbd\u0dcf\u0dd9\u0db1\u0d95\u0dc0\u0dd2\u0da7, \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1",
