    "text": "\u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0db4\u0dc5\u0dcf\u0dd9\u0dad\u0dca \u0d9c\u0dcf\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca, \u0db6\u0dc5\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca, \u0d85\u0d82\u0d9a 89 \u0db6\u0dc5\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d9c\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0dd9\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc0\u0dd0\u0dbd\u0dca\u0dbd\u0dc0\u0dad\u0dca\u0dad , \u0db8\u0dd2\u0dd9\u0d9c\u0da7\u0dca\u0da7\u0dd4\u0dc0\u0dad\u0dca\u0dad \u0dc3\u0dc4 \u0db6\u0dc5\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d9c\u0db8\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca\u0dc0 \u0dc3\u0dbb\u0dca\u0dd9\u0dc0\u0dca \u0dd9\u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9c\u0dcf. 2910 \u0dc4\u0dcf 2018.09.27 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0dd2\u0dad \u0db8\u0dd6\u0dbd\u0dd2\u0d9a \u0db4\u0dd2\u0db9\u0dd4\u0dd9\u0dbb\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 33 \u0dc3\u0dc4 34 \u0dd9\u0dbd\u0dc3 \u0dd9\u0db4\u0db1\u0dca\u0db1\u0dd4\u0db8\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db4\u0db8\u0dcf\u0dab\u0dd9\u0dba\u0db1\u0dca \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.0127 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0dc0\u0dd6 \u0dd9\u0db4\u0dd9\u0db1\u0da2\u0dca\u0da2\u0dcf\u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad \u0db1\u0dd0\u0db8\u0dd0\u0dad\u0dd2 \u0d89\u0da9\u0db8 \u0d9c\u0dcf\u0dbd\u0dca\u0dbd-\u0dd9\u0d9a\u0ddc\u0dc5\u0db9 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8.",
