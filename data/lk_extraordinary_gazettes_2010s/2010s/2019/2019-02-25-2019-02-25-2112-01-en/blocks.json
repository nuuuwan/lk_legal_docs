      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      465.25,
      539.87,
      500.32
    ],
    "text": "The notification relating to the Rates of Exchange published in Gazette Extraordinary, No. 2111/1 of 18th February,2019 is hereby rescinded and the said Rates of Exchange are Scheduled to be rescinded by a similar notification to bepublished on or before 03rd March, 2019.",
