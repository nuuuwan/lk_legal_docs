    "bbox": [
      304.32,
      427.28,
      539.57,
      460.4
    ],
    "text": "2. Lot No. 02 Name of the land: Kuruntuwatta; Details: Cemetery; Extent: 0.1241 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
