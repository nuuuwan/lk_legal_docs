  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      680.24,
      286.6,
      713.36
    ],
    "text": "1. Lot No. 01 Name of the land: Kuruntuwatta; Details: Cemetery; Extent: 0.0791 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.9994001388549805,
      10.078991889953613
