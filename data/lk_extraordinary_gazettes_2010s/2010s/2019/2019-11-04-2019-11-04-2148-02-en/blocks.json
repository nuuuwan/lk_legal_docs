    "bbox": [
      47.85,
      515.41,
      539.91,
      565.48
    ],
    "text": "IT is hereby notified that by virtue of powers vested in me under Section 17 of the Customs Ordinance (Chapter 235)I, C. Jayasuriya, Acting Director General of Customs, determine that with effect from 04th November, 2019, all duties ofCustoms as well as other charges, penalties and forfeitures incurred under the Customs Ordinance (Chapter 235), shall be paidand received at the Rates of Exchange set out in the Schedule.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      580.33,
      539.91,
      617.44
    ],
    "text": "The notification relating to the Rates of Exchange published in Gazette Extraordinary, No. 2147/1 of28th October, 2019 is hereby rescinded and the said Rates of Exchange are Scheduled to be rescinded by a similarnotification to be published on or before 10th November, 2019.",
