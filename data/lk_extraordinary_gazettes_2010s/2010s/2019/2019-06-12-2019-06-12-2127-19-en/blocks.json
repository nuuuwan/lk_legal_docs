    "bbox": [
      55.05,
      696.01,
      295.11,
      731.08
    ],
    "text": "01. Lot No. 1Name of the Land: Katuwalage watta andPunchilamahamilage Koratuwa; Description of the land:",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      307.05,
      439.69,
      547.09,
      474.76
    ],
    "text": "Jungle with scrub; Initial claimant of the land: N. B.Palihawadana and Ramasiri Palihawadana; Extent: 1.4164Hectares.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      307.05,
      487.69,
      547.37,
      606.76
    ],
    "text": "All persons interested in the aforesaid land/lands on whicha land / servitude is to be acquired are hereby to appear,personally, or by agent duly authorized in writing, beforeme at Divisional Secretariat Malimbada on the 27th day ofJune 2019 at 10.30 a.m. and are hereby requested to notifyto me in writing (in duplicate) on or before the 20th day ofJune the nature of their interests in the land, the particularsof their claims for compensation for the acquisition of thesaid land/servitude, the amount of compensation and thedetails of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
