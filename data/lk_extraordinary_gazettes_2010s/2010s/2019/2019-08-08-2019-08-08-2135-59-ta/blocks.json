    "text": "\u0bb1\u0bbe\u0b95\u0bae \u0bc7\u0ba4\u0bb5\u0ba4\u0bcd\u0ba4 \u0bb2\u0b99\u0bcd\u0b95\u0bbe \u0b85\u0baa \u0bb8\u0bcd\u0bb5\u0bbe\u0bae\u0bbf\u1f91\u0bc7\u0b95 \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0baa\u0b9a\u0bbf\u1fa2\u0b95\u0bbe \u0bc7\u0ba4\u0bb5\u0bbe\u0bb2\u0baf \u0bb5\u1f9e\u0b9f\u0bbe\u0ba8\u0bcd\u0ba4 \u0b89\u0bb1\u0bcd\u0b9a\u0bb5\u0bae\u0bcd (\u0bc7\u0ba8\u0bbe\u0baf\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b89\u0bb1\u0bcd\u0b9a\u0bb5\u0bae\u0bcd) 2019, \u0b93\u0b95\u0ba4\u0bcd\u1f90 \u0bae\u0bbe\u0ba4\u0bae\u0bcd 26 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0ba8\u0bc8\u0b9f\u0bc6\u0baa\u1fa0\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u1fa0\u0bae\u0bcd, 2019.08.18 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u1f99\u0ba4\u0bb2\u0bcd 2019.08.27 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0bb5\u0bc8\u0bb0 \u0b89\u0bb1\u0bcd\u0b9a\u0bb5\u0bae\u0bcd \u0ba8\u0bc8\u0b9f\u0bc6\u0baa\u1fa0\u0bae\u0bcd \u0b95\u0bbe\u0bb2\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0bc8\u0ba4\u1f9c\u0bae\u0bcd \u0bc6\u0baa\u0bbe\u1f90 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bb1\u0bbf\u0ba8\u0bcd\u1f90 \u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bb5\u0bbf\u1f8c\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0bb1\u1f90. 1. \u0b87\u1f90 \u0bc6\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0b95 362 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0bae\u0bcd \u0bc6\u0baa\u0bb1\u0bcd\u0bb1 \u0baf\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bc8\u0bb0\u0baa\u0bcd \u0baa\u0baf\u0ba3\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd 2016, \u0bc6\u0baa\u0baa\u0bcd\u1f97\u1f9e\u0bb5\u0bbe\u0bbf \u0bae\u0bbe\u0ba4\u0bae\u0bcd 12 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf 1953/43 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b99\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0bbf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bc6\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0b95 \u0bc6\u0baa\u0bbe\u1f90 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b85\u0bb5\u0ba4\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u1f8c\u0bb5\u0bb0\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0bb1\u1f90. 2. \u0baa\u0b95\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0ba8\u0bcd\u0ba4 \u0b89\u0bb1\u0bcd\u0b9a\u0bb5\u0bae\u0bcd \u0ba8\u0bc8\u0b9f\u0bc6\u0baa\u1fa0\u0bae\u0bcd \u0b95\u0bbe\u0bb2\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u1f99\u0bb2\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u1f8c\u0bae\u0bcd.",
