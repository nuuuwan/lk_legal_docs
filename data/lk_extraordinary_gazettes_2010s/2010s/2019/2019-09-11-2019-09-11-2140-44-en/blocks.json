    ],
    "text": "My Ref. No.: BKP/LAND/ACQUI/D2/1/3.Land Ministry's No. : 4-3/15/2016/VE/426.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
