    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      70.56,
      544.56,
      310.32,
      638.63
    ],
    "text": "I hereby give notice under Sub-section (1) of Section 07 ofLand Acquisition Act, as Amended by Land Acquisition(Amendment) Act of, No. 28 of 1964, that Government intendsto acquire the allotments of lands which have been enclosedin the land called Kiriporuwa Part II mentioned in the schedulefor acquisition of land for resettlement of displaced personsby landslides in 2016 in Divisional Secretary's Division ofBulathkohupitiya.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      80.64,
      651.36,
      240.64,
      661.43
    ],
    "text": "Description of the Land to be Acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
