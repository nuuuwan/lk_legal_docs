    "page_number": 0,
    "bbox": [
      322.56,
      436.56,
      562.54,
      506.63
    ],
    "text": "Allotment of lands No. 6, 7 (Lots 02) mentioned in theSchedule and enclosed in the P.P.K. No. 3679 of Superintendentof Surveys, Kegalle situated in the Village of Kiriporuwa inGrama Niladhari Division of Kiriporuwa in DivisionalSecretary's Division of Bulathkohupitiya in Kegalle District inSabaragamuwa Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
