    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.2,
      419.6,
      293.71,
      465.68
    ],
    "text": "I hereby give notice under Sub-section (1) of Section 7 ofthe Land Acquisition (Amendment) Act, No. 28 of 1964 thatthe Government intends to acquire the following land whichis required for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.2,
      472.87,
      277.19,
      482.95
    ],
    "text": "Description of the land or Servitude to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.2,
      490.4,
      293.71,
      572.47
    ],
    "text": "The land called Doctorthoddam, Elanthalirodai in totalextent of about 3.4560 Hectares depicted as Lot Nos. 1, 2 and3 in Plan No. MN779 and prepared by the Surveyor Generalsituated in the Village called Nadukkuda, in the Grama NiladhariDivision No. 54 of Tullukkudiyiruppu, in the DivisionalSecretary's Division of Mannar Town of Mannar District inNorthern Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.2,
      586.39,
      128.53,
      596.47
    ],
    "text": "Plan No. MN 779.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.2,
      603.68,
      293.77,
      637.76
    ],
    "text": "01. Lot Nos. 01, 02 and 03Name of Land: Doctorthoddam Elanthalirodai; Present useof the land: Bare land; Claimant: Government; Original",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
