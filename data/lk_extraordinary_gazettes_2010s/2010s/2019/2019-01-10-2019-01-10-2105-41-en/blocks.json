      63.84,
      388.52,
      285.54,
      410.72
    ],
    "text": "My Reference No.: MN/DS/L/D1/AQ/WPP/12' Land Ministry No.: 4-3/2/2017/CEB/249.",
    "fonts": [
      "FMAbhayax",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.07889175415039,
