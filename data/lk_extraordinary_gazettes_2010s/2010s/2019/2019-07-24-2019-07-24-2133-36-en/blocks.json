  {
    "page_number": 0,
    "bbox": [
      57.6,
      546.08,
      493.59,
      592.16
    ],
    "text": "THALATHA ATUKORALE,Minister of Justice and Prison Reforms.Colombo,18th July 2019.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      6.959303855895996,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      280.56,
      606.12,
      325.74,
      616.2
    ],
