      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      64.08,
      629.76,
      303.75,
      675.83
    ],
    "text": "In the last map of the village map prepared by the SurveySuperintendent of Monaragala in Bibila in the MonaragalaDistrict of the Uva Province, the Survey Plan of the F.V.P. 573Supplement No. 87 of the Sheet No. 88 is as follows:",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
