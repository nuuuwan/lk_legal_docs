      595.92,
      302.76,
      641.99
    ],
    "text": "1. Lot No.1Name of the Land: -; Description of Land: Road; Claimant:Government; Original Claimant: Dambulu Raja MahaViharaya; Extent: 0.0124 Hectare.",
