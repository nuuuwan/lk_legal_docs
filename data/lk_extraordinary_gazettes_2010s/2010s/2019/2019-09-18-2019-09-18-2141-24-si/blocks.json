    ],
    "text": "\u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1, \u0dc0\u0db1\u0150\u026b \u0dc4\u0dcf \u0101\u0dc3\u0dca\u01af\u0dba\u0dcf\u01e7 \u0d86\u0d9c\u023d\u0d9a \u0d9a\u0da7\u0252\u01b1 \u0218\u0298\u0db6\u0db3 \u0d85\u0db8\u0dcf\u0dad\u0255 \u0dd9\u0da2\u02a4\u01e6 \u0d87\u01e6\u0dad\u01e8 \u0d89\u0db8\u0dd0\u01e9\u0dd9\u0dc0\u0262 \u0d85\u0db8\u0dbb\u01b1\u0d82\u0d9c \u0dc0\u0db1 \u0db8\u0db8, 2005 \u0d85\u0d82\u0d9a 38 \u0daf\u0dbb\u0db1 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0d9a\u0da7\u0252\u01b1 \u0db4\u0db1\u0dd9\u01ae 70 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0db4\u0dd0\u0dc0\u025e\u019f \u0db6\u0dbd\u0dad\u0dbd \u0dba\u0da7\u0dd9\u01ae, \u027c \u0dbd\u0d82\u0d9a\u0dcf \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dba \u026a\u0286\u01e6 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0d9a\u0dcf\u0259\u0dba\u0dba\u01e6 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc4\u0dad \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f \u0daf\u00fa\u0dc0\u0dcf \u0d87\u01af \u0d89\u0da9\u023c \u0d85\u01ae\u0db4\u01ae \u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0db8 \u0d85\u0dc0\u0dc1\u0255 \u0db6\u0dc0 \u0d89\u0da9\u023c \u0d85\u01ae\u0db4\u01ae \u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u023c \u0db4\u0db1\u0dd9\u01ae 49 (\u0d85) \u0dc0\u0d9c\u01e6\u01af\u0dba\u0da7 \u0d85\u01e9\u00fe\u0dbd\u0dc0 \u0dd9\u0db8\u0250\u01e6 \u01e7\u0dba\u0db8 \u0d9a\u0dbb\u023d. \u0dd9\u0da2\u02a4\u01e6 \u0d87\u01e6\u0dad\u01e8 \u0d89\u0db8\u0dd0\u01e9\u0dd9\u0dc0\u0262 \u0d85\u0db8\u0dbb\u01b1\u0d82\u0d9c, \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1, \u0dc0\u0db1\u0150\u026b \u0dc4\u0dcf \u0101\u0dc3\u0dca\u01af\u0dba\u0dcf\u01e7 \u0d86\u0d9c\u023d\u0d9a \u0d9a\u0da7\u0252\u01b1 \u0218\u0298\u0db6\u0db3 \u0d85\u0db8\u0dcf\u0dad\u0255. 2019 \u0dc3\u0dd0\u0217\u0dad\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 18 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0