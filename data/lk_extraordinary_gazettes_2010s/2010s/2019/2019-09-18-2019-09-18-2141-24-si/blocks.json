  {
    "page_number": 0,
    "bbox": [
      51.12,
      655.76,
      539.87,
      732.08
    ],
    "text": "\u0d8b\u01b1\u0dbb\u0da7 : \u023f\u0291\u0daf, \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7 : \u021a\u01e6\u0db1\u01e6 \u021a\u01d0\u0d9a\u0dcf\u018d, \u0d85\u0262\u0dc0\u01e6\u0db8\u0ddb\u0dbd\u0dba\u018b, \u0db4\u01ae\u01af\u0dbb\u0dcf\u0dba\u01e6 \u021a\u01d0\u0d9a\u0dcf\u018d, \u0dd9\u0269\u0dbd\u0259\u0d9a\u0dcf\u018d \u0dc3\u0dc4 \u0dd9\u0dc3\u02a4\u0dbd\u0286\u0d82\u0d9c \u0dd9\u0dc3\u02a2\u0db1\u0dcf\u01dd\u0dbb\u0dcf\u0da2\u01e6 \u021a\u01d0\u0d9a\u0dcf\u018d \u0dba\u0db1 \u0d89\u0da9\u023c, \u0daf\u00fd\u0dab\u0da7 : \u021d\u0db0\u0dcf\u0db1 \u0db8\u0dcf\u0259\u0d9c\u0dba, \u0db6\u0da7\u028f\u0dbb\u0da7 : \u0dd9\u0dc3\u0262\u0dc0\u0db1\u0dcf\u0dba\u0dc4\u023c \u0dd9\u0dc3\u01e6\u01ce\u0262\u0db1\u0dcf\u0daf\u01e6 \u0dc3\u0dc4 \u0dc1\u0dcf\u01e6\u0dad \u0dbd\u00fa\u0dc2\u0dca\u023d \u0d85\u0234\u0db8\u0dcf\u0db1\u0255\u0286\u0d82\u0d9c\u023c \u0dba\u0db1 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0 \u026a\u0286\u01e6 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dbd\u0daf \u0dd9\u0269\u0dbd\u0259\u0d9a\u0dcf\u018d, \u0d85\u0262\u0dc0\u01e6\u0db8\u0ddb\u0dbd\u0dba\u018b \u0dd9\u0dc4\u02a4 \u0d85\u0262\u0dc0\u01e6\u0db8\u0ddb\u0dbd\u0dba\u018b \u0dd9\u0269\u0dbd\u0259\u0d9a\u0dcf\u018d \u0d89\u0da9\u023c.",
