    ]
  },
  {
    "page_number": 0,
    "bbox": [
      70.32,
      456.72,
      308.58,
      502.79
    ],
    "text": "I, hereby give notice under Sub-section (1) of Section 7, ofLand Acquisition Act No.28 of 1964 (Amended) that theGovernment intends to acquire the following lands which arerequired for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      80.4,
      510.72,
      241.31,
      520.79
    ],
    "text": "Description of the Land to be Acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      70.32,
      529.92,
      308.54,
      611.99
    ],
    "text": "Four allotment of land depicted in the Preliminary PlanNo. KU.2419 situated in the village called Hunukumbura inDewamadi Hathpaththuwe Walgampaththu Korale in theGrama Niladhari Division No. 1211 of Mirihampitiya in theDivisional Secretary's Division of Bamunakotuwa inKurunegala District of the North Western Province and morefully described as follows.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      70.32,
      621.12,
      308.36,
      655.19
    ],
    "text": "01. Lot No. 01, P.P.KU. 2419Name of land: Udupitiya Kumbura; Claimant: K.V. Piyadasa;Extent: 0.0136 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      70.32,
      661.92,
      308.31,
      695.99
    ],
    "text": "02. Lot No. 02, P.P.KU. 2419Name of land: Udupitiya Kumbura; Claimant: K.V. PemaJayawardhana; Extent: 0.0186 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
