      71.28,
      437.52,
      307.38,
      447.59
    ],
    "text": "My Reference No.: DIVBA/LND/ACQSTN/01/01/02.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
