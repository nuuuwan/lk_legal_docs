    ]
  },
  {
    "page_number": 0,
    "bbox": [
      62.64,
      499.2,
      554.48,
      521.27
    ],
    "text": "BY virtue of powers vested to me under Section 32(1) of the Provincial Council Act, No. 42 of 1987, I, President's CounselMarshall Perera, Governor of Uva Province, do hereby notify that the following appointments have been made by me:",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      80.64,
      535.2,
      554.94,
      569.27
    ],
    "text": "1.Mr. M. B. R. M. S. G. B. Rathnayaka, Class I officer of the Sri Lanka Animal Product and Health Service, asDeputy Provincial Director of Badulla at Department of Animal Product and Health of Uva Province withimmediate effect (from the date 24.01.2019),",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      80.64,
      583.2,
      554.85,
      605.27
    ],
    "text": "2.Mr. W. M. M. G. Abesinghe Banda, Special Grade officer of the Sri Lanka Administrative Service, as DeputyChief Secretary (Personnel & Training) of Uva Province with immediate effect (from the date 13.02.2019),",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      80.64,
      619.2,
      554.92,
      653.27
    ],
    "text": "3.Mrs. G. W. C. S. Priyabhashini, Class III officer of the Sri Lanka Administrative Service, to Perform the dutiesof the Municipal Commissioner of Badulla Municipal Council, in addition to her permanent post, with effect(from the date 18.02.2019),",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
