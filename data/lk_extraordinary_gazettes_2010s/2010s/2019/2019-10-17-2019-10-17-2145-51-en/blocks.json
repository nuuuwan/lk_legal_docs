  {
    "page_number": 0,
    "bbox": [
      69.36,
      523.92,
      309.13,
      581.99
    ],
    "text": "I hereby give notice under Sub-section (1) of Section 7 of theLand Acquisition Act, as amended by the Land Acquisition(Amendment) Act, No. 28 of 1964, that the Government intendsthe following land/servitude which is required for a publicpurpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.36,
      601.92,
      308.96,
      635.99
    ],
    "text": "Description of the Land/Servitude to be Acquired :The allotment of the land mentiones below depicted in PPMR 2813, situated in No. 331, Mapalana Magin Pahala Grama",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      321.36,
      436.56,
      561.59,
      458.63
    ],
    "text": "Niladhari Division, in the Divisional Secretary's Division ofKamburupitiya in Matara District in Southern Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      321.36,
      466.61,
      561.47,
      598.55
    ],
    "text": "Lot No. 1Name of the land: Giragahahenawatta; Description:Garden, 22 Jak trees about 10-50 years old, 13 Mango trees,one Mahogani tree, 54 Rubber trees, 39 Kithul trees, one Cocoatree, 2 Durian trees, 2 Goraka trees, 9 aettoniya trees, 80 Arecatrees, 2 Ambarella trees, 2 Donga trees, one Olinda mara tree,one Thimbiri tree, one Turpentine tree, 4 Rukaththana trees,10 Clove trees, 3 Cashew trees, one Ketakala tree, 2 Beli trees,a mixed cropping, 3 permanent building and a well; Name andAddress of Claimant: Land Reform Commission; HectorKobbekaduwa mw., Colombo 07; Extent: 1.8525 Hectares.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
