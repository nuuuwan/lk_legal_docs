    "text": "\u0dbb\u0db3\u0dc0\u0dcf \u0dad\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u00fa \u0dd9\u0dc3\u02a4\u01ce\u0286 \u00fb\u025d\u0db8\u00fa \u0d85\u0dad\u0dbb\u01b1\u0dbb \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0d9a\u0dc5 \u0252\u01b1 \u0db6\u0dbd\u0dad\u0dbd 5. \u0dba\u023c \u0db6\u0dbd\u0dba \u0db4\u0dc0\u0dbb\u0db1 \u0dbd\u0daf \u01e7\u0dc1\u0dca\u013d\u0dad \u01e7\u0dbd\u0db0\u0dbb\u0dba\u00fd \u026a\u0286\u01e6 (\u0d85) \u0dba\u023c \u0dbb\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a \u0db4\u025c\u0279\u0dd9\u024f \u0dba\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dd9\u0dc3\u02a4\u01ce\u0286 \u00fb\u025d\u0db8; (\u0d86) \u0dbb\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0dad\u01ae\u01ae\u0dc0\u0dba\u01e6 \u0dd9\u0dc4\u02a4 \u0d95. \u0d91\u023c. \u0219. \u028f \u0d9a\u0dcf\u0259\u0dba\u0db7\u0dcf\u0dbb\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dba\u023c \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u026a\u0db8\u0dc3\u0dcf \u0db6\u0dd0\u0264\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d91\u00fc \u0dbb\u0db3\u0dc0\u0dcf \u0dad\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dd9\u024f \u0286\u0179\u0db1 \u0dba\u023c \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd\u0dd9\u0d9c\u01e6 \u021d\u0dc1\u0dca\u0db1 \u00fb\u025d\u0db8 ; (\u0d87) \u0d91\u00fc \u0dbb\u0db3\u0dc0\u0dcf \u0dad\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dd9\u0dba\u01e6 \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u01ae \u0dba\u023c \u0dd9\u0262\u0d9b\u0db1\u0dba\u00fa \u0dd9\u0dc4\u02a4 \u0dc0\u0dc3\u0dca\u01b1\u0dc0\u00fa \u0dbb\u0db3\u0dc0\u0dcf \u0dad\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8 ; (\u0d88) (\u0d87) \u0dd9\u0146\u0daf\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u0dba\u023c \u0dd9\u0262\u0d9b\u0db1\u0dba\u0d9a \u0218\u0da7\u0db4\u01ae \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8; (\u0d89) \u0d91\u00fc \u0dbb\u0db3\u0dc0\u0dcf \u0dad\u0db6\u0dcf\u0d9c\u0dd0\u01e8\u0dd9\u023c \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dd9\u024f \u0dd9\u0dc4\u02a4 \u0d91\u00fc \u0dbb\u0db3\u0dc0\u0dcf \u0dad\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dd9\u0dba\u01e6 \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u01ae \u0dba\u023c \u0dc3\u0dbd\u00fd\u0dab\u00fa \u0dd9\u0dc4\u02a4 \u0dd9\u0db7\u02a5\u01af\u0d9a \u0dc3\u0dcf\u00fa\u027f\u0dba\u00fa \u0daf \u0d87\u01b1\u029a\u0dc0 \u0dba\u023c \u0dc0\u0dc3\u0dca\u01b1\u0dc0\u0d9a, \u0dd9\u0262\u0d9b\u0db1\u0dba\u0d9a, \u0dc0\u0dcf\u0dc4\u0db1\u0dba\u0d9a \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u0dba\u023c \u0dd9\u0daf\u0dba\u0d9a \u0da1\u0dcf\u0dba\u0dcf\u025f\u0db4 \u0d9c\u0dd0\u01e8\u0db8 ; \u0dd9\u0dc4\u02a4 (\u0d8a) \u0dba\u023c \u0dbb\u0db3\u0dc0\u0dcf \u0dad\u0db6\u0dcf\u0d9c\u0dd0\u01e8\u0dd9\u023c \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a \u01af\u0dd9\u0db6\u0db1 \u0dc0\u0dcf\u0dc4\u0db1\u0dba\u00fa \u0dd9\u0dc3\u02a4\u01ce\u0286 \u00fb\u025d\u0db8 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0dc4\u0dd0\u00fb \u0dba.",
