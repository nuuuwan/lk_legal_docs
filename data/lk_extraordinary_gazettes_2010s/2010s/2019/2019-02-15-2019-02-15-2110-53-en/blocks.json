    "bbox": [
      110.37,
      446.53,
      547.2,
      468.52
    ],
    "text": "1.It was amended the Limit of Rs 175,000/= given for one year the free postal facilities of the Hon. Membersof Parliament up to Rs. 350,000/=",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      110.37,
      479.53,
      547.2,
      501.52
    ],
    "text": "2.It was amended the limit of Rs. 24,000/= given for one year the free postal facilities of the Hon. Membersof Provincial Council up to Rs. 48,000/=",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      104.13,
      512.53,
      394.45,
      523.6
    ],
