  {
    "page_number": 2,
    "bbox": [
      47.85,
      101.65,
      539.94,
      136.72
    ],
    "text": "11. Any candidate who is unable to achieve the required standards at the oral or written test may be granted afurther period of time by the Director-General to undergo training at any of the institutions referred to in regulation 5(b)and such candidate shall be given only two opportunities to sit for such oral or written test.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      83.85,
      149.65,
      186.43,
      160.72
    ],
