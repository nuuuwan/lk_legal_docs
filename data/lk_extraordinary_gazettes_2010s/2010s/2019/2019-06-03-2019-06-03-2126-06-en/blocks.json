    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      95.85,
      173.65,
      539.92,
      208.72
    ],
    "text": "\u201cSkipper\u201d means the person having command of a fishing vessel and provides instructions on the route, estimateof the catch and management of the boat workers and the crew and includes a Master or Captain whoserves in the same capacity in a fishing vessel.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
