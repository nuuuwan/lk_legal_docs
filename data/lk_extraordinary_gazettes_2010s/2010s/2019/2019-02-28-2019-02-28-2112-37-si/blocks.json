    "text": "92 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u01e7\u0dba\u0db8\u0dba. 1974 \u0d85\u0d82\u0d9a 02 \u0daf\u0dbb\u0db1 \u0da2\u0dcf\u01af\u0d9a \u0da2\u0dbd \u0dc3\u023c\u0db4\u0dcf\u0daf\u0db1 \u0dc4\u0dcf \u0da2\u0dbd\u0dcf\u0db4\u0dc0\u0dc4\u0db1 \u0db8\u019c\u0da9\u0dbd \u0db4\u0db1\u0dd9\u01ae 92 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u0dba\u01e6 \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u021d\u0d9a\u0dcf\u0dbb \u0db1\u0d9c\u0dbb \u0dc3\u0dd0\u0dbd\u0288\u023c \u0da2\u0dbd \u0dc3\u023c\u0db4\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0d8b\u0dc3\u0dc3\u0dca \u0d85\u0db0\u0255\u0dcf\u0db4\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0255, \u0dbb\u026c\u0dc6\u0dca \u0dc4\u00fc\u023c \u0dc0\u0db1 \u0db8\u0db8, \u0da2\u0dcf\u01af\u0d9a \u0da2\u0dbd \u0dc3\u023c\u0db4\u0dcf\u0daf\u0db1 \u0dc4\u0dcf \u0da2\u0dbd\u0dcf\u0db4\u0dc0\u0dc4\u0db1 \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f, \u0dc4\u0dad\u0dbb\u0263\u0dba\u01ca\u0daf \u0da2\u0dbd \u0dc3\u023c\u0db4\u0dcf\u0daf\u0db1 \u0dc0\u0255\u0dcf\u0db4\u0dd8\u01af\u0dd9\u024f, \u023d\u019d\u0d9c\u023f\u0dc0 \u0da2\u0dbd \u0d9c\u0db6\u0da9\u0dcf \u0da7\u0dd0\u0d82\u00fb\u0dba \u0dc4\u0dcf \u0db1\u0dbd \u0db8\u0dcf\u0259\u0d9c\u0dba \u0d91\u0298\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca",
