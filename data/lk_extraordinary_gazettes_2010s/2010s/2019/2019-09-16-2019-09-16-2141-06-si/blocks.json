    "text": "\u027c \u0dbd\u0d82\u0d9a\u0dcf \u0d85\u0db0\u0255\u0dcf\u0db4\u0db1 \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1 \u0dd9\u0dc3\u02a2\u0dc0\u0dd9\u024f \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 2015 \u0d85\u0dd9\u0d9c\u02a4\u0dc3\u0dca\u01b1 \u0db8\u0dc3 21 \u01ce\u0db1\u0dd0\u01af \u0dc4\u0dcf \u0d85\u0d82\u0d9a 1928/28 \u0daf\u0dbb\u0db1 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d \u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0dc4 2016 \u0db8\u0dcf\u0259\u01b1 \u0db8\u0dc3 01 \u01ce\u0db1\u0dd0\u01af \u0dc4\u0dcf \u0d85\u0d82\u0d9a 1956/16 \u0d85\u0d82\u0d9a \u0daf\u0dbb\u0db1 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d \u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4 \u0dba \u0db8\u0119\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u01dd\u0dad \u027c \u0dbd\u0d82\u0d9a\u0dcf \u0d85\u0db0\u0255\u0dcf\u0db4\u0db1 \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1 \u0dd9\u0dc3\u02a2\u0dc0\u0dd9\u024f \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf \u0dc3\u0d82\u011e \u0dc4\u0dba \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0d86\u0d9a\u0dcf\u0dbb\u0dba\u0da7 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb \u0dd9\u0db8\u0db8 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u01dd\u0dad \u026a\u01dd\u026a\u0db0\u0dcf\u0db1\u0dba\u01e6 \u0d85\u0db8\u0dcf\u0dad\u0255 \u0db8\u019c\u0da9\u0dbd\u0dba \u026a\u0286\u01e6 \u021d\u01af\u0db4\u01ae\u01af\u0db8\u0dba \u01b0\u0dbb\u0dab\u0dba \u0d9c\u01e9 \u0dbd\u0dd0\u022d 2019 \u0dd9\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u025c \u0db8\u0dc3 26 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0286\u0da7 \u0