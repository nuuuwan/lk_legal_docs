      48.03,
      223.78,
      469.47
    ],
    "text": "Report of the Auditor General :\u2013 Report on Review of the Balance Sheet of the Central Bank of Sri Lanka as at 31st August, 2019",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Bold",
      "TimesNewRoman,BoldItalic",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      7.5
