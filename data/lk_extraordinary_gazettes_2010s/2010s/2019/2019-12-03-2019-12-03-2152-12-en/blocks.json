      47.85,
      509.65,
      283.02,
      544.72
    ],
    "text": "Ministry of Finance, Economic and Policy Development,Colombo 01,December 03, 2019.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
