    "bbox": [
      406.29,
      461.65,
      535.3,
      496.72
    ],
    "text": "MAHINDA RAJAPAKSA,Minister of Finance, Economicand Policy Development.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      7.0,
      10.0
    ]
  },
