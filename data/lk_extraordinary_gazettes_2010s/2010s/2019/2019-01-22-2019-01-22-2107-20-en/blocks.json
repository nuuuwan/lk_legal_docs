    "page_number": 0,
    "bbox": [
      80.4,
      475.44,
      237.52,
      485.51
    ],
    "text": "Description of the land to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      70.32,
      506.4,
      308.94,
      600.47
    ],
    "text": "An allotment of land in Total Extent of about 0.0152 Hectaredepicted as Lot No.1 in the P.P.GAM.No.4109 dated 14.11.2018prepared by the Senior Superintendent of Surveys - GampahaDistrict situated in the Village called Parakandeniya, in theGrama Niladhari Division No. 244B of Parakandeniya North,in the Divisional Secretary's Division of Gampaha of GampahaDistrict in Western Province and morefully described asfollows.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
