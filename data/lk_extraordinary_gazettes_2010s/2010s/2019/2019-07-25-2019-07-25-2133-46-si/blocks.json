    ],
    "text": "362 \u0d85\u01dd\u0d9a\u0dcf\u0dbb\u0dba \u026d \u0dc0\u01e6\u0daf\u0db1\u0dcf \u0d9c\u0db8\u01e6 \u0d86\u0da5\u0dcf \u0db4\u0db1\u0dd9\u01ae \u0db4\u0dc5\u0d9a\u0dbb \u0d87\u01af 1948 \u0dc3\u0dd0\u0217\u0dad\u0dd0\u023c\u0db6\u0259 10 \u0daf\u0dcf\u0dad\u0db8 \u0d85\u0d82\u0d9a 9902 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f\u0daf , 1951 \u0d85\u0dd9\u0d9c\u02a4\u0dc3\u0dca\u01b1 17 \u0daf\u0dcf\u0dad\u0db8 \u0d85\u0d82\u0d9a 10283 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f\u0daf, 1955 \u0db8\u0dcf\u0259\u01b1 25 \u0daf\u0dcf\u0dad\u0db8 \u0d85\u0d82\u0d9a 14778 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f\u0daf, 1992 \u0d85\u0d82\u0d9a 58 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dd0\u0dc0\u025d\u0db8 (\u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c\u0dc0\u025e) \u0db4\u0db1\u0dad \u0d85\u01e9\u0dc0, 2009.10.02 \u0dc0\u0db1 \u01ce\u0db1 \u0d85\u0d82\u0d9a 1622 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f\u0daf \u0db4\u0dc5\u026d \u0db6\u01d0\u0262\u0dbd \u0d9a\u0dad\u0dbb\u0d9c\u0db8 \u0dd9\u01ca\u0dc0\u0dcf\u0dbd\u0dd9\u024f (\u0dc0\u0dcf\u0259\u027f\u0d9a \u0dd9\u0db4\u0dbb\u0dc4\u0dd0\u0dbb) \u0218\u0298\u0db6\u0db3 \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0d85\u01e9\u0dc0\u0daf \u0db6\u01d0\u0262\u0dbd \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u01e7\u0dc4\u0dcf\u0262 \u011b\u0dab\u0dbb\u01ae\u0db1 \u0dc0\u0db1 \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u0d85\u01e9\u0dc0 2019 \u0db6\u01d0\u0262\u0dbd \u0d9a\u0dad\u0dbb\u0d9c\u0db8 \u0dd9\u01ca\u0dc0\u0dcf\u0dbd\u0dd9\u024f \u0dc0\u0dcf\u0259\u027f\u0d9a \u0dd9\u0db4\u0dbb\u0dc4\u0dd0\u0dbb \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0db4\u0dc4\u0dad \u01e7\u0dd9\u0dba\u02a4\u0d9c \u0db4\u0db1\u0dc0\u023d. (1) 2019 \u0d85\u0dd9\u0d9c\u02a4\u0dc3\u0dca\u01b1 \u0db8\u0dc3 31 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0d85\u029a\u0dba\u0db8 \u0d9a\u0217 \u0286\u017b\u026b\u0dd9\u0db8\u01e6 \u0db6\u01d0\u0262\u0dbd \u0d9a\u0dad\u0dbb\u0d9c\u0db8 \u0dd9\u01ca\u0dc0\u0dcf\u0dbd\u0dd9\u024f \u0dc0\u0dcf\u0259\u027f\u0d9a \u0dd9\u0db4\u0dbb\u0dc4\u0dd0\u0dbb \u0d86\u0dbb\u023c\u0db7 \u026b, 2019 \u0d85\u0dd9\u0d9c\u02a4\u0dc3\u0dca\u01b1 \u0db8\u0dc3 31 \u0dc0\u0db1 \u01ce\u0db1 \u0286\u0da7 \u0dc3\u0dd0\u0217\u0dad\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 04 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf (\u01ce\u0db1 05) \u0d85\u0db7\u0255\u01e6\u0dad\u0dbb \u0dd9\u0db4\u0dbb\u0dc4\u0dd0\u0dbb, 2019 \u0dc3\u0dd0\u0217\u0dad\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 05 \u01ce\u0db1 \u0286\u0da7 \u0dc3\u0dd0\u0217\u0dad\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 09 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf (\u01ce\u0db1 05) \u00fd\u0db9\u0262 \u0dd9\u0db4\u0dbb\u0dc4\u0dd0\u0dbb, 2019 \u0dc3\u0dd0\u0217\u0dad\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 10 \u01ce\u0db1 \u0286\u0da7 14 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf (\u01ce\u0db1 05) \u0dbb\u01e6\u0dd9\u0daf\u02a4\u0263 \u0dd9\u0db4\u0dbb\u0dc4\u0dd0\u0dbb, 2019 \u0dc3\u0dd0\u0217\u0dad\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 15 \u01ce\u0db1 \u0d85\u029a\u0dba\u0db8 \u01ce\u0dba \u0d9a\u0dd0\u0219\u0dd9\u023c \u0db8\u0d82\u0d9c\u0dbd\u0255, 2019 \u0dc3\u0dd0\u0217\u0dad\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 15 \u01ce\u0db1 \u0daf\u0dc4\u0dc0\u0262 \u0dd9\u0db4\u0dbb\u0dc4\u0dd0\u0dbb \u0dd9\u0d9c\u0dc0\u01cf\u0dd9\u0db8\u01e6 \u0d85\u0dc0\u0dc3\u01e6 \u0dc0\u0db1 \u0db6\u0dc0 \u0daf\u0dd0\u01e9\u023c \u0dd9\u0daf\u023d. (2) \u0dd9\u0db4\u0dbb\u0dc4\u0dd0\u0dd9\u0259 \u0d9c\u0db8\u01e6 \u0db8\u0dcf\u0259\u0d9c\u0dba \u0db6\u01d0\u0262\u0dbd \u0d9a\u0dad\u0dbb\u0d9c\u0db8 \u0dd9\u01ca\u0dc0\u0dcf\u0dbd\u0dd9\u024f \u0286\u0da7 \u0db6\u01d0\u0262\u0dbd \u0db4\u0dc4\u0dbd \u026b\u01ce\u0dba, \u0db4\u0dc3\u0dca\u0dc3\u0dbb \u0db4\u0dcf\u0dbb (\u023f\u01af\u0dba\u0d82\u0d9c\u0dab \u0dc0\u0da7 \u0dbb\u026c\u0db8) \u0dd9\u0dbd\u02a3\u01e6\u0da9\u01e6 \u0db4\u0dcf\u0dbb, \u0d85\u0db1\u0d9c\u0dcf\u025c\u0d9a \u0db0\u0259\u0db8\u0db4\u0dcf\u0dbd \u0db8\u0dcf\u0dc0\u0dad, \u0dd9\u0d9a\u02a3\u0dd9\u0d9a\u02a4\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbb, \u0d8b\u0daf\u0dba\u0dbb\u0dcf\u0da2 \u0db8\u0dcf\u0dc0\u0dad, \u0dbb\u0da2 \u026b\u01ce\u0dba, \u0d9a\u0da9 \u026b\u01ce\u0dba, \u0db4\u0dc4\u0dc5 \u026b\u01ce\u0dba, \u0db6\u01d0\u0262\u0dbd \u0d9a\u0dad\u0dbb\u0d9c\u0db8 \u0dd9\u01ca\u0dc0\u0dcf\u0dbd\u0dba\u0da7 \u0dd9\u0d9c\u0dc0\u01cf\u0db8 (3) \u0db6\u01d0\u0262\u0dbd \u0d9a\u0dad\u0dbb\u0d9c\u0db8 \u0dd9\u01ca\u0dc0\u0dcf\u0dbd \u0237\u023d\u0dba \u0dc4\u0dcf \u0dd9\u01ca\u0dc0\u0dcf\u0dbd\u0dba\u0da7 \u0d85\u0dba\u01ae \u0286\u0d82\u0dc4\u0dcf\u0dc3\u0db1\u0dba \u0218\u028f\u0179 \u0237\u023d\u0dba \u0dba\u0db1 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u01e6 \u0dc4\u0dcf \u0d92 \u0d85\u0dc0\u0da7 \u0237\u023d\u0db7\u0dcf\u0d9c\u0dc0\u0dbd \u0d86\u0dc4\u0dcf\u0dbb \u0218\u0287\u0db8 \u0dc4\u0dcf \u0dd9\u0dc0\u0dc5\u0db3\u0dcf\u023c \u00fb\u025d\u0db8 \u0dad\u0dc4\u0db1\u023c \u0d9a\u0dbb\u023d. (4) \u0dd9\u0db4\u0dbb\u0dc4\u0dd0\u0dbb \u0d9a\u0dcf\u0dbd\u0dba \u01b1\u0dc5\u01cf \u021d\u0db0\u0dcf\u0db1 \u0db8\u0dcf\u0259\u0d9c\u0dc0\u0dbd \u0dd9\u0db4\u02a5\u01ca\u0d9c\u0263\u0d9a \u0dc0\u0dcf\u0dc4\u0db1 \u0db1\u0dad\u0dbb \u00fb\u025d\u0db8 \u0dad\u0dc4\u0db1\u023c \u0d9a\u0dbb\u023d. \u0db6\u0250\u0286\u0d9a\u0262 \u0dc4\u0dcf \u0d9a\u0dbb\u01ae\u0dad \u0d87\u01b1\u029a\u0dc0 \u0286\u0dba\u029a\u0db8 \u0dbb\u0dae \u0dc0\u0dcf\u0dc4\u0db1 \u0db8\u0dd9\u0d9c\u01e6 \u0dd9\u0dc4\u02a4 \u0dd9\u01ca\u0dc0\u0dcf\u0dbd \u0db7\u0dcf\u0dbb \u01e7\u0dbd\u0dd9\u023c \u01b1\u0db8\u0dcf\u0dd9\u0d9c\u01e6 \u0db6\u0dbd\u0db6\u01b4\u0dba\u00fa \u0dd9\u0db1\u02a3\u0db8\u0dd0\u01af\u0dc0 \u0dd9\u01ca\u0dc0\u0dcf\u0dbd \u0237\u023d\u0dba\u0da7 \u0d87\u01b1\u029a \u00fb\u025d\u0db8 \u0dad\u0dc4\u0db1\u023c \u0d9a\u0dbb\u023d. (5) \u0dd9\u0db4\u0dbb\u0dc4\u0dd0\u0dbb \u0d9c\u0db8\u01e6 \u0d9c\u01e6\u0db1\u0dcf \u0db8\u0dcf\u0259\u0d9c\u0dba\u01e6\u028f \u0db6\u01d0\u0262\u0dbd \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u0db8\u0119\u01e6 \u026a\u01dd\u0db8\u01ae \u0d85\u01e9\u0db8\u0dd0\u01af\u0dba\u00fb\u01e6 \u0d89\u01ce \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0dd9\u0d9c\u02a3\u0da9\u0db1\u0dd0\u0119\u0263 \u0dc4\u0dcf \u0daf\u0dd0\u0db1\u0da7 \u0d87\u01af \u0dc3\u0dca\u01c2\u0dbb \u0dd9\u0d9c\u02a3\u0da9\u0db1\u0dd0\u0119\u0263 \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dd9\u0269 \u0d8b\u0db4\u0dd9\u0daf\u0dc3\u0dca \u0dc0\u0dbd\u0da7 \u0d85\u01e9\u00fe\u0dbd \u026a\u0dba \u0252\u01b1\u0dba. \u022a\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0db6\u01d0 \u0d9c\u01e6\u0db1\u0dcf",
