1 \u0240\u0263\u0d9a \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 01 \u0daf, \u0d85\u0d82\u0d9a 14625 \u0daf\u0dbb\u0db1 \u0240\u0263\u0d9a \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 2097 \u0daf, \u0d85\u0d82\u0d9c\u01e6\u0dad\u0dd0\u01e6\u0db1 \u0d87\u0dc5 \u0daf, \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 11 \u0dc3\u0dc4 10 \u0daf, \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 193 \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 195 \u0daf, \u0db8\u0dbd\u0dd9\u0daf\u02a3\u0dc5 \u0daf, \u0d85\u0d82\u0d9a 14625 \u0daf\u0dbb\u0db1 \u0240\u0263\u0d9a \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 2107 \u0daf, \u0dd9\u0db8\u0db8 \u0218\u0249\u0dd9\u0259\u0db8 \u0d85\u0d82\u0d9a 195 \u0daf, \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 15 \u0daf, \u0d85\u0d82\u0d9a \u0d92 970 \u0daf\u0dbb\u0db1 \u0240\u0263\u0d9a \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 04 \u0daf, \u0218\u0d82\u0dc0\u01ae\u0dad \u0db1\u0db8\u01af \u027c \u0da0\u01e6\u01d6\u0dc3\u0dcf\u0dbb \u0db1\u0dcf\u0dba\u0d9a \u0dd9\u0dad\u025e\u01e6\u0dc0\u0dc4\u01e6\u0dd9\u0dc3\u02a2\u0da7 \u0d85\u0dba\u01ae \u0d89\u0da9\u0db8 \u0daf, \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 13 \u0daf, \u0d87\u0262\u0dd9\u0dbd\u0dc0\u01ae\u0dad \u00fd\u0249\u0dbb \u0db1\u0dd0\u0db8\u01af \u0d91\u013c.\u0dd9\u0dc3\u0dbd\u0dcf \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u00fd\u0db9\u0dd6\u0dbb \u0daf, \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 12 \u0daf, \u0d85\u0d82\u0d9a \u0d92 970 \u0daf\u0dbb\u0db1 \u0240\u0263\u0d9a \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 25, 24, 23, 37, 21 \u0daf, \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 186 \u0daf, \u0d85\u0d82\u0d9a 183 \u0daf\u0dbb\u0db1 \u021a\u0dc3\u0dca\u0dc3\u0dd9\u0dc4\u02a2\u0db1 \u0dd9\u0daf\u02a3\u0dc5 \u0daf, \u0d85\u0d82\u0d9a 14745 \u0daf\u0dbb\u0db1 \u0240\u0263\u0d9a \u0218\u0db9\u0dd6\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 2659 \u0daf, \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 08 \u0daf, \u0d85\u0d82\u0d9a 14745 \u0daf\u0dbb\u0db1 \u0240\u0263\u0d9a \u0218\u0db9\u0dd6\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 2655 \u0daf, \u023f\u025e\u0dad\u0d9c\u0dc4\u0dd9\u0dc4\u02a2\u0db1 \u0d87\u0dc5 \u0daf, \u0d85\u0d82\u0d9a 14745 \u0daf\u0dbb\u0db1 \u0240\u0263\u0d9a \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 2664 \u0daf, \u0d85\u0d82\u0d9a 14745 \u0daf\u0dbb\u0db1 \u0240\u0263\u0d9a \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 2663 \u0daf, \u0d9a\u01e6\u0dd9\u0daf \u00fd\u0249\u0dbb \u0d87\u0dc5 \u0daf, \u0dd9\u0dad\u01e9\u00fa\u0d9c\u0dc4\u0dbd\u01e6\u0daf \u0dd9\u0db1\u02a3\u0dd9\u0dc4\u02a3\u01ae \u0dd9\u0d9c\u017b\u023f\u025e\u0dad\u0dbd\u01e6\u0daf \u0db1\u0dd0\u0db8\u01af \u0dd9\u014e.\u0219 \u0d94\u0dd9\u0229\u0dd9\u0dc3\u02a2\u0d9a\u0dbb \u0dba\u0db1 \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d89\u0da9\u0db8 \u0daf, \u0d91\u0dc6\u0dca.\u0d91\u0dc3\u0dca.\u0219.\u0219. 96 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 171 \u0daf, \u0dc3\u0db6\u0dbb\u0d9c\u023f\u0dc0 \u0db4\u0dc5\u0dcf\u01ae \u0db8\u0dcf\u0250\u0db8 \u0daf \u0dd9\u0269. \u021d\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u00fa. 320.758",
