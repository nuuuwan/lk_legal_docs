      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.05,
      491.53,
      295.29,
      550.6
    ],
    "text": "The allotment of land in extent about 0.0041 Ha. depicted 07Zone from 07 Zonal Sheet No. 12 in C.M. No. 620074 preparedby the Surveyor General situated at Kiridigala Village No. 256Kiridigala G.S. Division, Balangoda Divisional Secretariat,Rathnapura District and Sabaragamuwa Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.05,
      556.33,
      295.1,
      603.4
    ],
    "text": "01. Lot No. 368Name of the Land: Kiridigala Thalawa Madugalle GodawatteDorawela laga Kella or Paddy field near the Dorawela Bridge;Claimant: L. T. H. Chandralal; Extent: 0.0011 Hectare.",
    "fonts": [
