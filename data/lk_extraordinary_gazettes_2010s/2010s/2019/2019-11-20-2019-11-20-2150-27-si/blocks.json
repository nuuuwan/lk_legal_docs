    "text": "\u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0dcf\u0dd9\u0dad\u0dca, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca, \u0db8\u0dc4\u0dc0 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca, \u0dbb\u0dd9\u0db1\u0ddd\u0dbb\u0dcf\u0dc0 \u0d9c\u0dd9\u0db8\u0dca \u0d85.\u0d9c.\u0db4\u0dd2. 3484 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 54, 55, 56, 57, 58, 59, \u0d85.\u0d9c.\u0db4\u0dd2. 3491 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 118, 120, \u0d85.\u0d9c.\u0db4\u0dd2. 3486 \u0db1\u0dd9\u0dad\u0dca\u0dc0 \u0d9c\u0dd9\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 3, 24, 25, \u0d85.\u0d9c.\u0db4\u0dd2. 3453 \u0dc4\u0dd0\u0dbd\u0db9\u0dd1\u0dc0 \u0d9c\u0dd9\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 17, 18, 19, 20, \u0d85.\u0d9c.\u0db4\u0dd2. 3512 \u0dc0\u0dd3\u0dbb\u0dd9\u0dc3\u0ddd\u0dd9\u0dbd \u0d9c\u0dd9\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 38, 39, \u0d85.\u0d9c.\u0db4\u0dd2. 3515 \u0db4\u0dc4\u0dc5 \u0db6\u0d9a\u0dca\u0db8\u0dd3\u0dc0\u0dd0\u0dc0 \u0d9c\u0dd9\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 80, \u0db8\u0dd3\u0dc0\u0dd0\u0dbd\u0dca\u0dbd\u0dcf\u0dc0 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca \u0db7\u0dd6\u0dbd\u0d9a\u0dca\u0dc2\u0dab\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0db8\u0dd6\u0dbd\u0dd2\u0d9a \u0db4\u0dd2\u0db9\u0dd4\u0dbb\u0dd4 24\u0dc4\u0dd2 (Topo P.P. 24) \u0db4\u0dbd\u0dd4\u0dd9\u0d9c\u0ddc\u0dbd\u0dca\u0dbd, \u0dbb\u0dd9\u0db1\u0ddd\u0dbb\u0dcf\u0dc0, \u0db4\u0dbd\u0dd4\u0d9c\u0dc3\u0dca\u0dc0\u0dd0\u0dc0 \u0d9c\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0d85\u0dba\u0dad\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 955, 957, 959, 961, 963, 966, 967, 970