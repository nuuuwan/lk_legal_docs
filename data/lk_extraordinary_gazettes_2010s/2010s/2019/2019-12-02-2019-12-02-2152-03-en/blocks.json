      428.87
    ],
    "text": "15- 20 years, present ownership; Claimants: KelaniweliPlantations PLC, No. 400, Deans Road, Colombo 10; Extent:0.8094 hec.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
