  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      394.56,
      308.36,
      452.63
    ],
    "text": "I hereby give notice, under Sub-section (1) of Section 7 ofthe Land Acquisition Act, as amended by the LandAcquisition (Amendment) Act, No. 28 of 1964 that theGovernment intends to acquire the following land which isrequired for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      465.36,
      294.83,
      475.43
    ],
    "text": "Description of the land or servitude to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      482.64,
      308.32,
      564.71
    ],
    "text": "The land called Doctorthoddam and Doctorodai in totalextent of about 3.2657 Hectares depicted as Lot Nos. 1, 2 and 3in Plan No. MN781 and prepared by the Surveyor Generalsituated in the Village called Nadukkuda, in the Grama NiladhariDivision No. 54 of Tullukkudiyiruppu, in the DivisionalSecretary's Division of Mannar Town of Mannar District inNorthern Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      576.24,
      308.44,
      610.31
    ],
    "text": "01. Lot Nos. 01, 02 and 03Name of Land: Doctorthoddam Doctorodai; Present use ofthe land: Bare land; Claimant: Government; Original Claimant:",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
