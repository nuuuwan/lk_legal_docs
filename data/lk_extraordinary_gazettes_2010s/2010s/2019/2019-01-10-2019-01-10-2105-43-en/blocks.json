      303.77,
      385.67
    ],
    "text": "My No.: MN/DS/L/D1/AQ/WPP/11' Land Ministry No.: 4-3/2/2017/CEB/248.",
    "fonts": [
      "FMAbhayax",
      "TimesNewRomanPS-ItalicMT",
