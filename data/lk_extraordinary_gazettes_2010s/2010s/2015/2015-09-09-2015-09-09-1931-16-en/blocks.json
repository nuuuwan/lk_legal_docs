      169.44,
      371.59,
      286.68,
      381.68
    ],
    "text": "My Ref. : \u0d85\u01ae/\u0d9a\u018d/130/UDA.",
    "fonts": [
      "IskoolaPota",
      "IskoolaPota,Italic",
      "TimesNewRomanPS-ItalicMT",
