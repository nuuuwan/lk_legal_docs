  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      334.4,
      539.5,
      356.0
    ],
    "text": "Claimant: Soraguna Kuda Katharagama Devalaya, Haldummulla; Extent: 0.2802 Hectare.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      370.14,
      539.4,
      487.04
    ],
    "text": "All persons interested in the aforesaid land are hereby required to appear personally or by agents duly authorized in writing, before me at Divisional Secretariat, Haldummulla on the 02nd March, 2015 at 10.00 a.m. and are hereby requested to notify me in writing (in duplicate) on or before the 23rd February, 2015 and the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land, the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
