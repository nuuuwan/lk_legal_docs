  },
  {
    "page_number": 0,
    "bbox": [
      49.77,
      399.13,
      540.0,
      494.2
    ],
    "text": "BY VIRTUE of the powers vested in me by Subsection (4) of the Section 20 of the Universities Act, No. 16 of 1978, I,Sarath Amunugama, Minister of Higher Education and Research, on being satisfied that the administration of the affiarsof the Gampaha Wickramarachchi Aryurveda Institute have been seriously dislocated and that the authorities of the saidInstitute have failed to restore normal conditions, do by this order appoint Professor Jayantha Walihinda with effect fromAugust 25, 2015 to be the Competent Authority for the purpose of exercising, performing or discharging in lieu ofDirector any power, duty and function respectively which have been conferred or imposed on, or assigned to the Directorof the Gampaha Wickramarachchi Aryurveda Institute, under the said Act or any Order, Ordinance, Statute, By-law,Regulation or Rule made thereunder.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
