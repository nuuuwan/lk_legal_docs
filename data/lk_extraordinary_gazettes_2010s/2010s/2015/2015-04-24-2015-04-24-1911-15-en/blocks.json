  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      398.89,
      540.01,
      493.96
    ],
    "text": "BY virtue of the powers vested in me by Subsection (4) of Section 20 of the Universities Act, No. 16 of 1978, I, SarathAmunugama, Minister of Higher Education and Research, on being satisfied that the administration of the affairs of theTrincomalee Campus of the Eastern University, Sri Lanka have been seriously distrupted and that the authorities of theTrincomalee Campus of the University have failed to restore normal conditions, do by this Order appoint Professor RanjithPremalal de Silva to be the Competent Authority with effect from April 15, 2015, for the purpose of exercising, performing ordischarging in lieu of Rector of Trincomalee Campus any powers, duties and functions respectively which have beenconferred or imposed on, or assigned to the said Rector of the Trincomalee Campus, Eastern University, Sri Lanka under thesaid Act or any Order, Ordinance, Statute, By law, Regulation or Rule made thereunder.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
