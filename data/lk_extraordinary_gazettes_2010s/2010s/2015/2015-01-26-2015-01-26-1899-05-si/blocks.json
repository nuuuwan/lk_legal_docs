    "text": "\u01e9\u0dc0\u0dbb\u0d91\u0298\u0dba \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0dd9\u0d9a\u02a3\u01ae\u0db8\u0dd9\u0262 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d8b\u0da9\u0db4\u0dd9\u01e6 \u0dd9\u0d9a\u02a4\u0dbb\u0dd9\u0dc5\u02a2 \u0288\u029a \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0dc4\u0dcf\u0262\u0dd9\u0db4\u02a3\u0dbd \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a \u023f.\u0218.\u01e9. 2964 \u0daf\u0dbb\u0db1 2014.08.04 \u01ce\u0db1\u0dd0\u01af \u0240\u0263\u0d9a \u0218\u0249\u0dd9\u0259 \u0daf\u00fa\u0dc0\u0dcf \u0d87\u01af, \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0101\u00fa \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0db4\u0dc4\u0dad \u026a\u0dc3\u0dca\u0dad\u0dbb \u0d9a\u0dbb \u0d87\u01af \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0dd0\u0262\u0dbd.",
