  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      662.47,
      286.63,
      714.56
    ],
    "text": "03. Lot No. 3 Name of the Land: Pulartanwatta; Description: Road; Claimant: Government. Previous claimant D. A. Mallikarachchi; Extent: 0.0016 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.9994001388549805,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.32,
      331.28,
      539.64,
      479.36
    ],
    "text": "All persons interested in the aforesaid land/lands on which a servitude is to be acquired are hereby required to appear personally or by agents duly authorized in writing, before me at Divisional Secretariat, Kalutara on the 21st day of September, 2015 at 10.30 a.m. and are hereby requested to notify to me in writing (in duplicate) on or before the 14th day of September, 2015 the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land/ servitude the amount of compensation and the details of the computation of such amount. You should present relevant deeds, plans and other documents to prove ownership to the land on the inquiry date.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
