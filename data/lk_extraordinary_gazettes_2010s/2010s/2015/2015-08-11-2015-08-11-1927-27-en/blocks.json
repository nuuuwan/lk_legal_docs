      50.88,
      379.52,
      286.67,
      455.13
    ],
    "text": "I hereby give notice, under Sub - section (1) of Section 7 of the Land Acquisition Act, as amended by the Land Acquisition (Amendment) Act, No. 28 of 1964 that the Government intends to acquire the following lands / servitude which is required for a public purpose",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      0.9599039554595947,
      4.079591751098633,
      9.118988037109375,
