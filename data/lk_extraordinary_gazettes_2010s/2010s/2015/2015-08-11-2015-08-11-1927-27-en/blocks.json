    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      456.55,
      286.67,
      544.4
    ],
    "text": "Description of the Land or servitude to be acquired: The following allotment of land situated in the Village of Nagoda in Grama Niladhari Division of 729 Nagoda South Divisional Secretary\u2019s Division of Kalutara in the District of Kalutara in Western Province and marked in Surveyor General\u2019s Plan No. P. P. K. 4512 and contains in extent of 0.0026 Hectare.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.9994001388549805,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      545.33,
      286.63,
      598.4
    ],
    "text": "01. Lot No. 1 Name of the Land: Kobeihela; Description: Road; Claimant: Government. Previous claimant Jestin Silva; Extent: 0.0003 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      6.959303855895996,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      599.12,
      286.65,
      661.52
    ],
    "text": "02. Lot No. 2 Name of the Land: Kobeihela; Description: Road; Claimant: Government. Previous claimant U. S. Jayaneththi, R. Jayaneththi, S. Jayaneththi; Extent: 0.0007 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.039495944976807,
      10.078991889953613
