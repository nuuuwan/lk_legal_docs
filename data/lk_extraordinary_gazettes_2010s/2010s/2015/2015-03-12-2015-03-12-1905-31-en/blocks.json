  },
  {
    "page_number": 0,
    "bbox": [
      50.76,
      387.71,
      286.6,
      442.76
    ],
    "text": "I hereby give notice, under Sub-section (1) of Section 7 of the Land Acquisition Act, that the Government intends to acquire the following land which is required for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      1.0199999809265137,
      7.019999980926514,
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      65.16,
      443.23,
      226.57,
      454.32
    ],
    "text": "Description of the Land to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.76,
      454.54,
      286.52,
      539.4
    ],
    "text": "An allotment of land extent about 0.0177 Hectare, shown in Preliminary Plan No. GAM 3950, prepared by survey Superintendent of Gampaha, situated at Telangapatha village in Grama Niladari Division of 175, Talangapatha in Minor Division of Adikari Pattuwa in the Divisional Secretary\u2019s Division of Wattala in Gampaha District in the Western Province.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      1.9800000190734863,
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.76,
      539.72,
      286.52,
      583.68
    ],
    "text": "01. Lot No. 01 Name of the Land: Uluwala Kumbura; Description: Garden; Claimant: State; Original Claimant: Deepani",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.019999980926514,
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      330.25,
      539.43,
      352.8
    ],
    "text": "Chintha Kulathunga, No. 14/7, Wisal Sewana, Pananwala, Delgoda; Extent: 0.0177 Hectare.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      353.2,
      541.97,
      477.84
    ],
    "text": "All persons interested in the aforesaid land are hereby required to appear personally, or by agents duly authorized in writing, before me at Divisional Secretariat, Wattala on the 23rd day of March, 2015 at 10.00 a. m. and are hereby requested to notify me in writing (with 2 copies) on or before the 16th day of March, 2015 the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.019999980926514,
      10.020000457763672
    ]
  },
