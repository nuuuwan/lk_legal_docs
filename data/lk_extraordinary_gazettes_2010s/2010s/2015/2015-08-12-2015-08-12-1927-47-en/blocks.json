  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      401.83,
      286.64,
      467.59
    ],
    "text": "I hereby give notice under Sub section (1) of Section 7 of the Land Acquisition Act, as amended by the Land Acquisition (Amendment) Act, No. 28 of 1964, that the Government intends to acquire the following Land which is required for a public purpose :-",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      0.9599039554595947,
      5.9994001388549805,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      65.28,
      470.47,
      276.84,
      480.55
    ],
    "text": "Description of the land or servitude to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      481.29,
      286.68,
      566.72
    ],
    "text": "An allotment of land called the name mentioned below in Total Extent of 0.0049 Hectare depicted in Final Village Plan No. 658 Supplement No. 66 as Lot 1605 prepared by the Surveyor General situated in the Village of Ihalagoda in Grama Niladhari Division of 109 B Ihalagoda South in the Divisional Secretary\u2019s Division of Akmeemana in Galle District Southern Province.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.079591751098633,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      568.16,
      286.64,
      615.68
    ],
    "text": "01. Lot No. 1605 Name of the land: Kalugalmawatha Kanda, Nagaha Okanda Watta; Description: Part of distribution pipe line;",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.32,
      331.28,
      539.58,
      364.4
    ],
    "text": "Claimant: State; Previous Claimant: K. P. Dayawathi, No.389/1, Pinthaliya Road, Kadawatha; Extent: 0.0049 Hectare.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.32,
      363.44,
      542.25,
      499.52
    ],
    "text": "All persons interested in the aforesaid land is to be acquired are hereby required to appear personally or by agents duly authorized in writing, before me at the Divisional Secretariat of Akmeemana on 30th day of September, 2015 at 10.00 a. m. and are hereby requested to notify to me in writing (in duplicate) on or before the 23rd day of September, 2015 the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said Land the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.32,
      500.96,
      538.92,
      601.96
    ],
