      124.32,
      382.43,
      286.68,
      398.24
    ],
    "text": "My Reference No.: DS/AK/5/1/393(vi).",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      3.119687795639038,
