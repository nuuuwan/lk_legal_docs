      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      453.13,
      539.86,
      488.2
    ],
    "text": "The notification relating to the Rates of Exchange published in Gazette Extraordinary, No. 1909/1 of06th April, 2015 is hereby rescinded and the said Rates of Exchange are Scheduled to be rescinded by a similar notificationto be published on or before 19th April 2015.",
