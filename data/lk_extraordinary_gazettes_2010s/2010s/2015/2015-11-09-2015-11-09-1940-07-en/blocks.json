      405.97,
      525.55,
      453.04
    ],
    "text": "DAYASIRI JAYASEKARA,Minister of Sports.Colombo,09th November, 2015.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      7.0,
      10.0
