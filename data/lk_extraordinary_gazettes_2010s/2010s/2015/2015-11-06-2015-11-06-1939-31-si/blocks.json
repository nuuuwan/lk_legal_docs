    "text": "\u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8 \u0d9c\u0dd0\u0db1 \u0dc0\u01e6\u01ce \u0d89\u0262\u0264\u0db8\u0da7 \u0d87\u01af \u0d9a\u025e\u019f \u0218\u0298\u0db6\u0db3 \u026a\u0dc3\u0dca\u0dad\u0dbb\u01ae, \u0dc0\u01e6\u01ce \u023f\u0daf\u0dbd \u0dc4\u0dcf \u0d92 \u023f\u0daf\u0dbd \u0d9c\u0dab\u01e6 \u0db6\u0dd0\u0266 \u0dc4\u0dd0\u0179\u01ae \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0218\u0da7\u0db4\u01ae \u0dd9\u0daf\u0d9a\u00fa \u0dc3\u028f\u0dad \u026d \u0263\u0dba\u026a\u0262\u0dbd\u00fb\u01e6 \u0daf\u0dd0\u01e9\u023c \u01ce\u0dba \u0252\u01b1 \u0dba. \u0d85\u0250\u01af\u0dba \u0dad\u0dc4\u026c\u025e \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d94\u0db6 \u0dd9\u0dc0\u0dad \u0d87\u01af \u0286\u0dba\u029a\u0db8 \u0d94\u0217\u021a \u0dc4\u0dcf \u0263\u0dba\u026a\u0263\u0daf, \u0d8a\u0da7 \u0d85\u0daf\u0dcf\u0dbd \u0db4\u01ae\u0d89\u025e \u0218\u0da7\u0db4\u01ae \u0daf, \u0db4\u025d\u00fa\u0dc2\u0dab \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf \u0dd9\u0269 \u01cf \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dc5 \u0252\u01b1 \u0dba.",
