    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      497.35,
      286.44,
      612.32
    ],
    "text": "Description of the Land to be acquired: Preliminary Plan No. \u2014 Co. 9511. Position \u2014 Colombo District Sri Jayawardhanapura Divisional Secretary\u2019s Division of Municipal Council Limits of Kotte, Village of Pagoda East, Lots from 1 in total extent of about 0.0007 Hectare, of land in Preliminary Plan No. Co:9511 and dated 26th December, 2014 Surveyor Superintendent of Pagoda East, situated in the Western Province.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.039495944976807,
      10.078991889953613
