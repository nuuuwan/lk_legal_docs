    "page_number": 0,
    "bbox": [
      50.64,
      613.76,
      286.42,
      662.96
    ],
    "text": "01. Lot No. 01 Name of the Land: Mirihana Road Asst. No. 30/1A Part of the Land; Description: Road; Claimant: State;",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.079591751098633,
