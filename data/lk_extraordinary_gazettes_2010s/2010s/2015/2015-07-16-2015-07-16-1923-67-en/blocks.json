  },
  {
    "page_number": 0,
    "bbox": [
      48.81,
      411.13,
      538.92,
      434.2
    ],
    "text": "IT this hereby notified for the information of the pilgrims the attended the above festival and other concerned that theabove festival commences 2015.07.28 and terminates on 2015.08.14 with water cutting ceremony.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      48.81,
      447.13,
      538.94,
      482.2
    ],
    "text": "The attention of the pilgrims who attend the festival and others concerned is drawn to standing regulation publishedin the Government Gazette No. 10247 dated 11th May 1951 which will be in force during the duration of the abovefestival.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
