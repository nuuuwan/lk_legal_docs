  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      404.65,
      538.03,
      505.72
    ],
    "text": "BY virtue of the powers vested in me by Sub-section (4) of Section 20 of the Universities Act, no. 16 of 1978, I, SarathAmunugama, Minister of Higher Education and Research, on being satisfied that the administration of the affairs of theTrincomalee Campus of the Eastern University, Sri Lanka have been seriously dislocated and that the authorities of theTrincomalee Campus of the University have failed to restore normal conditions, do by this Order appoint Professor RanjithPremalal de Silva to be the Competent Authority with effect from July 15, 2015, for the purpose of exercising, performing ordischarging in lieu of Rector of Trincomalee Campus any powers, duties and functions respectively which have beenconferred or imposed on, or assigned to the said Rector of the Trincomalee Campus, Eastern University, Sri Lanka, under thesaid Act or any Order, Ordinance, Statute, By Law, Regulation or Rule made thereunder.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
