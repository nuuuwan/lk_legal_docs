    "bbox": [
      55.15,
      103.93,
      547.26,
      165.16
    ],
    "text": "NOW THEREFORE, I, Maithripala Sirisena, President of the Democratic Socialist Republic of Sri Lanka reposing greattrust and confidence in their prudence, ability and fidelity, do, in pursuance of the provisions of Section 3 of the Commissionsof Inquiry Act, by these Presents, appoint Preethi Padman Surasena Esquire and Degiri Amendra Mendis Seneviratne Esquire,Judges of the High Court, to be the Commissioners of the Commission of inquiry constituted in terms of the Warrant referredto above.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      55.15,
      191.53,
      547.15,
      215.08
    ],
    "text": "AND, I do hereby appoint the said Preethi Padman Surasena Esquire, Judge of the High Court to be the Chairmanof the said Commission.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
