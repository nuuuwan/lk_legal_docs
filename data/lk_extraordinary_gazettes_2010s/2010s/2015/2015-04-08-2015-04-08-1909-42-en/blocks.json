  {
    "page_number": 0,
    "bbox": [
      47.85,
      604.57,
      539.95,
      628.12
    ],
    "text": "WHEREAS, in pursuance of the provisions of Section 2 of the Commissions of Inquiry Act (Chapter 393), a Commission ofInquiry was by Warrant dated March 03, 2015 appointed by me;",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      642.01,
      539.94,
      678.04
    ],
    "text": "AND WHEREAS, Hon. Justice Wewage Priyasath Gerard Dep Esquire, PC, Judge of the Supreme Court, a memberand the Chairman and Hon, Justice Anil Goonaratne Esquire, Judge of the Supreme Court, a member of the said Commissionof Inquiry, have resigned from their positions;",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      83.85,
      692.17,
      441.5,
      703.24
    ],
    "text": "AND WHEREAS, the need to fill the vacancies of the said positions have been identified;",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
