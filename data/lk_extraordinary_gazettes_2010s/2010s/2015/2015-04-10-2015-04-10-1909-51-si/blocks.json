    "text": "\u0d85\u0dba\u0dd2. \u0dd9\u0d9a\u0dca. \u0da2\u0dd3. \u0db8\u0dd4\u0dad\u0dd4\u0db6\u0dab\u0dca\u0da9\u0dcf, \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca, \u0dc0\u0dbd\u0db4\u0dd9\u0db1\u0dca. 2015 \u0db8\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dc3 11 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0dc0\u0dbd\u0db4\u0dd9\u0db1\u0dca \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dd9\u0dba\u0dca \u0daf\u0dd3 \u0dba. 04 - 826 \u0dc1\u0dd4\u0daf\u0dca\u0db0\u0dd2 \u0db4\u0dad\u0dba\u0dba\u0dd2",
