    "text": "\u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d89\u0da9\u0db8\u0da7 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0d9a\u0db8\u0dca \u0dd9\u0dc4\u0ddd \u0dd9\u0dc0\u0db1\u0dad\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dd9\u0daf\u0db1\u0dcf\u0db8 \u0dad\u0db8 \u0dad\u0db8\u0db1\u0dca \u0dd9\u0dc4\u0ddd \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0dd9\u0d9c\u0db1\u0dca \u0dbd\u0dd2\u0dba\u0dc0\u0dd2\u0dbd\u0dd2\u0dc0\u0dbd\u0dd2\u0db1\u0dca",
