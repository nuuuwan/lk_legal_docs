  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      380.89,
      538.01,
      472.36
    ],
    "text": "BY virtue of the powers vested in me by Section 20(4) of the Universities Act, No. 16 of 1978,I, Lakshman Kiriella, the Minister of University Education and Highways, on being satisfied that the administration ofthe affairs of the Eastern University, Sri Lanka have been seriously dislocated and that the authorities of the saidUniversity have failed to restore normal conditions, do by this Order, appoint Prof. Uma Coomarasamy to be theCompetent Authority with effect from October 1, 2015, for the purpose of exercising, performing or discharging in lieu ofVice- Chancellor any power, duty or function respectively which have been conferred or imposed on, or assigned to,the Said Vice- Chancellor of the Eastern University, Sri Lanka under the aforesaid Act, or any Order, Ordinance, Statute,By law, Regulation or Rule made thereunder.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
