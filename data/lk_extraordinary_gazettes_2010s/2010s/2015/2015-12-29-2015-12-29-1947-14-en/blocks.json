    ],
    "text": "PERMISSION IN TERMS OF SECTION 7 OF THE EXCHANGE CONTROL ACT",
    "fonts": [
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
