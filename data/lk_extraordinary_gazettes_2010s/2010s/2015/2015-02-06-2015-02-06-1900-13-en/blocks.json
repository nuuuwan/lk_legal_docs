  },
  {
    "page_number": 0,
    "bbox": [
      307.05,
      378.9,
      547.37,
      442.86
    ],
    "text": "04. Lot No. 4Name of land: Kosgaha watta; Description: Garden, Contains APermanent building with One Jack tree about 30 years, One Teaktree about 30 years and One Coconut trees about 30 year; Claimant:State; Original Claimant: G. Jude Fernando, No. 154, Chilaw Road,Manaweriya, Kochchikade; Extent: 0.0366 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      9.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      307.05,
      454.5,
      547.1,
      507.66
    ],
    "text": "05. Lot No. 5Name of land: Kosgaha watta; Description: Estate, Contains AOne Jack tree about 30 years; Claimant: State; Original Claimant:Dushanthi Samarasingha, No. 105, Main Street, Kochchikade; Extent:0.0214 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      9.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      307.05,
      515.46,
      547.12,
      601.02
    ],
    "text": "All persons interested in the aforesaid lands are hereby requiredto appear personally or by agent duly authorized in writing, beforeme at Divisional Secretariat office of Katana on 04th day of March,2015 at 10.00 a.m. and are hereby requested to notify to me inwriting (in duplicate) on or before the 25 th day of February, 2015,the nature of their interests in the land, the particulars of their claimsfor compensation for the acquisition of the said lands, the amount ofcompensation and the details of the computation of such amount.",
