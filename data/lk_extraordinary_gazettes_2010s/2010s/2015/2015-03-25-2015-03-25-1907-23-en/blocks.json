    ],
    "text": "THE LAND ACQUISITION ACT (CHAPTER 460) Notice under Section 7",
    "fonts": [
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      1.0199999809265137,
      7.019999980926514,
      10.020000457763672
