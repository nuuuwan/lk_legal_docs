    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      157.15,
      726.73,
      266.61,
      737.8
    ],
    "text": "and are due to vacate post.",
    "fonts": [
