    "text": "\u0dbd\u0db6\u0dcf\u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u02a3\u0dd9\u0dbb\u02a3\u01ae\u01b1\u0dc0\u0db1 \u0d89\u0da9\u0dd9\u023c \u026a\u0dc3\u0dca\u0dad\u0dbb: \u0db6\u0dc3\u0dca\u0db1\u0dcf\u028f\u0dbb \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0dd9\u0d9a\u02a3\u0dc5\u0db9 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0db8\u0dc4\u0dbb\u0d9c\u0db8 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0dd9\u0d9a\u02a3\u0178\u0da7\u0dcf\u0dc0 \u0dc3\u0dc4 \u0db4\u01e6\u01e7\u0218\u0179\u0dba \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0db8\u0dd0\u01e9\u023c\u0db4\u01af \u026a\u0286\u01e6 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0240\u0263\u0d9a \u0218\u0249\u025e \u0d85\u0d82\u0d9a 9501, 9534, 9533 \u028f \u0dd9\u0db4\u01e6\u01e9\u023c \u0d9a\u0dbb \u0d87\u01af \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0dbb 0.1095\u00fa \u0db4\u0db8\u0dab \u026d \u0db4\u0dc4\u0dad \u026a\u0dc3\u0dca\u0dad\u0dbb \u0dd9\u0d9a\u0dd9\u0dbb\u0db1 \u0d89\u0da9\u0db8.",
