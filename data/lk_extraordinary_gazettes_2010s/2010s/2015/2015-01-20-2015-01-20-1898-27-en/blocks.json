  {
    "page_number": 0,
    "bbox": [
      50.76,
      397.79,
      286.57,
      468.01
    ],
    "text": "I, hereby give notice, under Sub section (1) of Section 7 of the Land Acquisition Act, No. 28 of 1964, (amendment) that the Government intends to acquire the following land which is required for a public purpose:-",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      1.0199999809265137,
