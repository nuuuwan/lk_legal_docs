    "text": "\u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dad (460 \u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dbb\u0dd2\u0da0\u0dca\u0dd9\u0da1\u0dca\u0daf\u0dba) 7 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0daf\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0db8\u0dd9\u0d9c\u0dca \u0d85\u0d82\u0d9a\u0dba : \u0db6\u0dd2\u0dba/3/1/1//262/I \u0dd9\u0d9c\u0ddc\u0db1\u0dd4\u0dc0. \u0dc0\u0dbb\u0dca\u0dc2 2015 \u0da2\u0dd6\u0dbd\u0dd2 \u0db8\u0dc3 20 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d9a 1924/2 \u0daf\u0dbb\u0db1 \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2\u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dd9\u0dba\u0dca \u0db4\u0dc5\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0daf\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0dd9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dd9\u0dba\u0dc4\u0dd2 \u0dc3\u0dd2\u0d82\u0dc4\u0dbd \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dd9\u0dba\u0dc4\u0dd2 \u0dc0\u0dbb\u0dca\u0dc2 2015 \u0d85\u0dd9\u0d9c\u0ddd\u0dc3\u0dca\u0dad\u0dd4 \u0db8\u0dc3 06 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dd9\u0db4.\u0dc0. 10.00 \u0da7 \u0db8\u0dc4\u0dbb\u0d9c\u0db8 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dd9\u0dba\u0dca \u0daf\u0dd3 \u0db8\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0d9b \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba \u0dba\u0db1\u0dca\u0db1 \u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0dd9\u0dbd\u0dc3\u0da7 \u0daf, \u0d89\u0d82\u0d9c\u0dd3\u0dc3\u0dd2 \u0dc3\u0dc4 \u0dd9\u0daf\u0db8\u0dc5 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dd9\u0dba\u0dc4\u0dd2 \u0db6\u0dd2\u0dba\u0d9c\u0db8 \u0daf\u0dd3 \u0dba\u0db1\u0dca\u0db1 \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0dd9\u0dbd\u0dc3\u0da7 \u0daf \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc0\u0dd3 \u0d87\u0dad. \u0d91\u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0d91\u0dba \u0dc0\u0dbb\u0dca\u0dc2 2015 \u0d9a\u0dca \u0dc0\u0dd6 \u0dc3\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 21 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dd9\u0db4. \u0dc0. 10.00 \u0da7 \u0db6\u0dd2\u0dba\u0d9c\u0db8 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dd9\u0dba\u0dca \u0daf\u0dd3 \u0db8\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0d9b \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dd9\u0dbd\u0dc3\u0da7 \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0 \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dca \u0daf\u0db1\u0dca\u0dc0\u0db8\u0dd2. \u0da9\u0db6\u0dca. \u0d91\u0da0\u0dca. \u0dc0\u0dd3. \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0db8\u0dcf\u0dbd\u0dcf, \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca, \u0db6\u0dd2\u0dba\u0d9c\u0db8.",
