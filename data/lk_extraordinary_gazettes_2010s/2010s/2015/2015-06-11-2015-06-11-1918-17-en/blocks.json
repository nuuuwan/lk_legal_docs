    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      397.69,
      539.97,
      435.88
    ],
    "text": "ACTING under the powers vested in it by Section 10 (1) (a) of the Consumer Affairs Authority Act, No. 09 of 2003, theConsumer Affairs Authority directs all Private Healthcare Institutions that they shall include the following information/details in the receipts/ bills issued to all patients who seek indoor treatment at their institutions.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      94.89,
      451.69,
      539.89,
      476.2
    ],
    "text": "*Details of all drugs and vitamins administered on the patient, including their Generic/ brand name, quantityused and the total cost for each and every drug and/ or vitamin.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      94.89,
      492.25,
      539.87,
      516.76
    ],
    "text": "*Details of all devices used for treatment specifying the quantity and the cost for each and every such deviceused.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      94.89,
      532.81,
      358.93,
      543.88
    ],
    "text": "This Direction shall come into effect from 01st of November, 2015.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
