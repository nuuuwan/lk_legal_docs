    ],
    "text": "Direction under Section 12 (2)",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      397.69,
      539.95,
      449.32
    ],
    "text": "ACTING under the powers vested in it by Section 12 (2) of the Consumer Affairs Authority Act, No. 09 of 2003, the ConsumerAffairs Authority directs that no trader, caterer, supplier of processed food and / or any other person / persons shall engagein the business of Mass Catering and / or outdoor catering or other similar or connected activity / activities unless theyobtain the Good Manufacturing Practices (GMP) process certification from the Sri Lanka Standards Institution (SLSI).",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      94.89,
      465.13,
      412.2,
      476.2
    ],
    "text": "This Direction shall come into operation with effect from 01st of January, 2017.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      492.25,
      137.13,
      503.32
    ],
