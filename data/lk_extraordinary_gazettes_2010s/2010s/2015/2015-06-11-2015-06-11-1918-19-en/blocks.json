    "fonts": [
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      64.89,
      519.13,
      490.89,
      530.2
    ],
    "text": "Mass Catering - the preparation, storage and / or delivery and serving of food to a large number of people",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      546.25,
      539.88,
      570.76
    ],
