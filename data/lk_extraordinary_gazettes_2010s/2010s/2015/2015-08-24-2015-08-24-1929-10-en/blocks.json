  {
    "page_number": 0,
    "bbox": [
      74.49,
      447.13,
      539.91,
      470.2
    ],
    "text": "(a)declare that the area of land specified in the Schedule hereto shall be an Urban Development Area for thepurpose of the aforesaid Ordinance and shall be called the \u201cGalpihilla Rajamaha Vihara Sacred Area\u201d ; and",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
