    "text": "\u0d9a\u0dd1\u0d9c\u0262\u0dbd \u0dc3\u01af\u0dd9\u0db4\u02a3\u0dbd \u021d\u0dd9\u0269\u0dc1 \u0db8\u0dcf\u0259\u0d9c\u0dba \u021a\u029a\u0262 \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0255 \u0d85\u023f\u0dab\u0dcf \u0d87\u01af \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0263 \u0d85\u01ae\u0db4\u01ae \u0d9a\u0dbb\u0d9c\u0dd0\u01e7\u0db8\u0da7 \u0d86\u019c\u018d\u0dc0 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0db6\u0dd0\u0269 1964 \u0d85\u0d82\u0d9a 28 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c (\u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1) \u0db4\u0db1\u01af\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u01dd\u0dad \u0db4\u025c\u01ce \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 7 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (1) \u0dc0\u0dd0\u01e7 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dd9\u0db8\u0250\u01e6 \u0daf\u0dd0\u01e9\u023c \u01cf \u0286\u0179\u023d. \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u02a3\u0dd9\u0dbb\u02a3\u01ae\u01b1\u0dc0\u0db1 \u0d89\u0da9\u0dd9\u023c \u026a\u0dc3\u0dca\u0dad\u0dbb : \u0dc3\u0db6\u0dbb\u0d9c\u023f\u0dc0 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0d9a\u0dd1\u0d9c\u0262\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0d9a\u0dd1\u0d9c\u0262\u0dbd \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0dd9\u0d9c\u02a3\u0dbd\u0dc4\u0dd0\u0dbd \u0dc3\u0dc4 \u0dbb\u0d82\u0dc0\u0dbd \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dc0\u0dc3\u023c\u0dc0\u0dbd (\u0d9a\u0dd1\u0d9c\u0262\u0dbd \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0dc3\u0dc4 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0287\u0db8\u0dcf\u0dc0 \u01b1\u0dc5) \u0218\u028f\u0179 \u0d9a\u0dd1\u0d9c\u0262\u0dbd \u