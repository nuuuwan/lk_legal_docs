    "text": "\u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u02a3\u0dd9\u0dbb\u02a3\u01ae\u01b1\u0dc0\u0db1 \u0d89\u0da9\u0dd9\u023c \u026a\u0dc3\u0dca\u0dad\u0dbb : \u0db8\u0dcf\u0dad\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0dc0\u0dd0\u0263\u0d9c\u0db8 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0dd9\u0db4\u02a3\u0262\u0dc0\u01ae\u0dad, \u0db4\u0dd0\u0dbd\u0dd1\u0db1 \u0db6\u0da7\u028f\u0dbb \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dc0\u0dc3\u023c\u028f \u0db4\u0dd0\u0dbd\u0dd1\u0db1 \u0d9c\u0dd9\u0db8\u028f \u0218\u028f\u0179 \u0240. \u0218. \u0db8\u0dcf\u0dbb 2635 \u0218\u0249\u0dd9\u0259 \u0db8\u01b1 \u0dc3\u0db3\u0dc4\u01e6 \u0d89\u0da9\u023c \u0dd9\u0db4\u02a3\u0262\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbd\u0db8 \u0db1\u0dd0\u0dc0\u0dad \u0d89\u01ce \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u0255\u0dc0 \u0d87\u0dad.",
