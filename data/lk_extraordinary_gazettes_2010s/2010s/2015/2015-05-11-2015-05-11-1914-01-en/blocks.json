      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      453.25,
      539.85,
      488.32
    ],
    "text": "The notification relating to the Rates of Exchange published in Gazette Extraordinary, No. 1913/1 of04th May, 2015 is hereby rescinded and the said Rates of Exchange are Scheduled to be rescinded by a similar notificationto be published on or before 17th May 2015.",
