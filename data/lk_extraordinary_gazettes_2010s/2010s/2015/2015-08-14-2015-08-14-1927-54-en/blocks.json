  },
  {
    "page_number": 0,
    "bbox": [
      50.7,
      507.61,
      286.48,
      648.06
    ],
    "text": "Preliminary Plan - Ya 1888 Situation : Village - Chankanai Center GN Division - Chankanai Center J/181 DS Division - Valikamam West, Chankanai District - Jaffna Province - Northern 01. Lot No. 1 Name of the land: Kommandarollai; Description: Open Land; Name of the Claimant: Sabapathipillai Ranganathan, Chankanai East, Chankanai; Extent: 0.6188 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      327.97,
      539.49,
      453.42
    ],
    "text": "All persons interested in the aforesaid land are hereby required to appear personally, or by agents duly authorized in writing before me at Valikaman West, Chankanai DS Office on the day 04th day of November 2015 at 10 a.m. and hereby requested to notify to me in writing (in duplicate) on or before the day 20th day of October 2015, the nature of their interest in the land, the particulars of their claims for compensation for the Acquisition of the said land, the amount of compensation and the details of the Computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      454.3,
      539.44,
      497.16
    ],
    "text": "All deeds and documents in support of claim should be produced before me at the inquiry.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.020000457763672,
      18.0
