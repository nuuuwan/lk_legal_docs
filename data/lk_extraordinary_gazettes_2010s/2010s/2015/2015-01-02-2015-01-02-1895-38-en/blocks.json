      309.84,
      118.44,
      546.85,
      165.68
    ],
    "text": "Boundaries. North: Lot. No.2046; East: Lot. No.2046; South: Part later of the land; West: Lot. No.251; Claimant: G. A. Somasena.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
