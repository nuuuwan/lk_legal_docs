  {
    "page_number": 1,
    "bbox": [
      309.84,
      164.72,
      546.8,
      266.24
    ],
    "text": "All persons who have claims for the ownership or any other interest for the above land are requested to meet me on 16th day of January, 2015 at 9.30 a. m. at the Divisional Secretary Office of Nuwaragam Palatha Central. In case of persons who need to make representations on behalf of them, are request to authorize their nominees with a letter of consent for such representations.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 1,
    "bbox": [
