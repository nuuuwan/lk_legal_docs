    "text": "\u0dd9\u0db8\u0dc4\u0dd2 \u0db8\u0dc4\u0da2\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0dad\u0d9a\u0dca \u0dba\u0db1\u0dd4 \u0dd9\u0db8\u0ddc\u0dbb\u0d9c\u0dc4\u0d9a\u0db1\u0dca\u0daf \u0dc4\u0dcf \u0d9a\u0dc5\u0dd4\u0d9f\u0d9c \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc0\u0255\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dd9\u0dc0\u0dca. \u0db8\u0db0\u0255\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u0dad\u0dca, \u0db8\u0dcf\u0dad\u0dd9\u0dbd\u0dca \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca, \u0db1\u0dcf\u0d8b\u0dbd \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca. \u0d9c\u0d9f\u0dbd \u0db4\u0dbd\u0dca\u0dd9\u0dbd\u0dca\u0dc3\u0dd2\u0dba \u0db4\u0dad\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca, E 407\u0d92 \u0dad\u0dbd\u0dcf\u0dd9\u0d9c\u0ddc\u0da9 \u0dc0\u0dc3\u0dd9\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2, \u0dc3\u0dbb\u0dca\u0dd9\u0dc0\u0dca\u0dba\u0dbb\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca 2014 \u0dd9\u0db1\u0ddc\u0dc0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 20 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf, \u0db7\u0dd6\u0dbd\u0d9a\u0dca\u0dc2\u0dab\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0db8\u0dd6\u0dbd\u0dd2\u0d9a \u0db4\u0dd2\u0db9\u0dd4\u0dbb\u0dd4 \u0d85\u0d82\u0d9a 17 \u0dc4\u0dd2, \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dd2\u0db9\u0dd4\u0dbb\u0dd4 28 \u0dc4\u0dd2, \u0db4\u0dad \u0d85\u0d82\u0d9a 82 \u0daf\u0dbb\u0dab \u0dc3\u0dd0\u0dc5\u0dd0\u0dc3\u0dca\u0dd9\u0db8\u0dca, \u0dd9\u0db4\u0db1\u0dca\u0db1\u0dd4\u0db8\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db4\u0dc4\u0dad \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d89\u0da9\u0db8\u0dca. 01. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\