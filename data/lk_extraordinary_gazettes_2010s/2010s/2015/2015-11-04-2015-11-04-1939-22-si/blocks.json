    "text": "\u0db8\u0dc4\u0da2\u0db1 \u0d9a\u0da7\u0252\u01ae\u0dad\u00fa \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0255 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0d89\u0da9\u023c \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0d86\u019c\u018d\u0dc0 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0db6\u0dd0\u0269, 1964 \u0d85\u0d82\u0d9a 28 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0d85\u01ae\u0db4\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c (\u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1) \u0db4\u0db1\u01af\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u01dd\u0dad \u0db4\u025c\u01ce \u0d89\u0da9\u023c \u0d85\u01ae\u0db4\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 7 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (1) \u0dc0\u0dd0\u01e7 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dd9\u0db8\u0250\u01e6 \u0daf\u0dd0\u01e9\u023c \u0dd9\u0daf\u023d. \u0db6\u0dc3\u0dca\u0db1\u0dcf\u028f\u0dbb \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0d9c\u023c\u0db4\u0dc4 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u023d\u01e9\u0dc0\u01e6\u0dd9\u0d9c\u02a3\u0da9 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d85\u0d82\u0d9a 135/1, \u0d85\u0dc3\u0dca\u0119\u025c\u0dc0\u0262\u0dd9\u0db4\u02a3\u0dbd \u0daf\u00fd\u0dab \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0daf\u0dcf\u0286\u0dba \u0db4\u01ae\u01b1\u0dc0 \u0288\u029a \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d9a\u017b\u0d9c\u0dc3\u0dca\u0dad\u0dbb \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u0dd9\u0dc0\u01e9\u0dc0\u0da7 \u0d9c\u023c\u0db4\u0dc4 \u01ce\u0dc3\u0dca\u01b5\u00fa \u0dd9\u0da2\u0255\u0dc2\u0dca\u0da8 \u023d\u01e7\u01e6\u0dd9\u0daf\u02a4\u025e \u0d85\u01dd\u0d9a\u0dcf\u025d \u026a\u0286\u01e6 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0db