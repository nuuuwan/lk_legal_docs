  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      564.56,
      286.48,
      609.43
    ],
    "text": "1. Lot No. 1 Name of land: Kongahawatta; Descrption: Open waste land; Claiment: State; Original Claimant: J. M. D. Sripala,",
    "fonts": [
      "TimesNewRomanPS-BoldItal",
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.91920804977417,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      331.28,
      539.51,
      352.88
    ],
    "text": "No. 220/11, Jaya Mawatha, Ihala Biyanvila, Kadawatta; Extent: 0.0436 Hectare.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      354.32,
      539.38,
      505.76
    ],
    "text": "All persons interested in the aforesaid land hereby required to appear personally, or by agents duly authorized in writing, before me at Divisional Secretary\u2019s Office of, Biyagama on the 30th day of November 2015, at 10.00 a.m. and are hereby requested to notify to me in writing (in duplicate) on or before the 23rd day of November, 2015 the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
