.\u1f90.\u0b87\u0bb2 121 \u2013 \u0bae\u0b95\u0bbe\u0bb5\u1fa2 \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2 \u0b9a\u1fb0\u0ba4\u0bbf \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2 \u0bc8\u0b95\u1fb7\u0bc6\u0ba4\u0bbe\u0bb4\u0bbf\u1fbf \u0ba8\u0bbf\u0bc8\u0bb2\u0baf\u1fbb, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb \u0b87\u0bb2 553/\u0b8f, \u0bc6\u0bae\u0ba4\u0bbf\u0bc6\u0bb5\u0bb2 \u1faa\u0ba4\u0bbf, \u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fbf \u0ba4\u0bb2\u0bb5\u1f90\u0bc6\u0b95\u0bbe\u0b9f \u1f9f\u0baa\u0bbe 7500000\u1fbe\u1f81 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 122 0.2141 \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2 \u0b9a\u1fb0\u0ba4\u0bbf \u0ba8\u0bbf\u0ba4\u0bbf \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2 121 \u2013 \u0bae\u0b95\u0bbe\u0bb5\u1fa2 \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2 \u0b9a\u1fb0\u0ba4\u0bbf \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2 \u0bc8\u0b95\u1fb7\u0bc6\u0ba4\u0bbe\u0bb4\u0bbf\u1fbf \u0ba8\u0bbf\u0bc8\u0bb2\u0baf\u1fbb, \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb \u0b87\u0bb2 553/\u0b8f, \u0bc6\u0bae\u0ba4\u0bbf\u0bc6\u0bb5\u0bb2 \u1faa\u0ba4\u0bbf, \u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0bb5\u1fb1\u0b95\u0bbf\u0baf\u0bbf\u1fbf \u0ba4\u0bb2\u0bb5\u1f90\u0bc6\u0b95\u0bbe\u0b9f \u1f9f\u0baa\u0bbe 7500000\u1fbe\u1f81 \u0b85\u0bc8\u0b9f\u0bae\u0bbe\u0ba9\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 127 0.4259 \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2 \u0b9a\u1fb0\u0ba4\u0bbf \u0ba8\u0bbf\u0ba4\u0bbf \u2013 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2 121 \u2013 \u0bae\u0b95\u0bbe\u0bb5\u1fa2 \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2 \u0b9a\u1fb0\u0ba4\u0bbf \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0ba4\u0baf\u0bbf\u0bc8\u0bb2