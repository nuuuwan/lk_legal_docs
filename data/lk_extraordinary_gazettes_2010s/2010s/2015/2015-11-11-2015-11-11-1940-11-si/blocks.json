    "text": "\u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0dc4\u023c\u0db6\u01e6\u0dd9\u0dad\u02a3\u0da7 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0dc4\u023c\u0db6\u01e6\u0dd9\u0dad\u02a3\u0da7 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d9c\u0262\u0dc0\u0dbd \u0dc0\u0dbd\u0269\u0dc0 \u0d9c\u0dd9\u023c, \u0d85\u0d82\u0d9a 93 \u0dc4\u023c\u0db6\u01e6\u0dd9\u0dad\u02a3\u0da7 \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025d \u0dc0\u0dc3\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u0dd9\u0dc0\u01e9\u0dd9\u0dc0\u01e6 \u0dc4\u023c\u0db6\u01e6\u0dd9\u0dad\u02a3\u0da7 \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3 \u0db7\u0dcf\u0dbb \u0dd9\u0da2\u0255\u0dc2\u0dca\u0da8 \u023d\u01e7\u01e6\u0dd9\u0daf\u02a4\u025e \u0d85\u01dd\u0d9a\u0dcf\u025d \u026a\u0286\u01e6 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0240\u0263\u0d9a \u0218\u0249\u025e \u0d85\u0d82\u0d9a 213\u028f \u0dc4\u0dcf \u0d89\u0da9\u023c \u0dbd\u0dd0\u0250\u0dc3\u0dca\u01b1\u0dd9\u0269 \u0218\u017b \u0d85\u0d82\u0d9a 01\u028f \u0daf\u00fa\u0dc0\u0dcf \u0d87\u01af \u023f\u029a \u022a\u023c \u021d\u0db8\u0dcf\u0dab\u0dba \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 1.0426\u00fa \u026d \u0db4\u0dc4\u0dad \u0dc3\u0daf\u0dc4\u01e6 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca.",
