    "sizes": [
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.76,
      400.09,
      286.55,
      461.79
    ],
    "text": "I, hereby give notice, under Sub-section (1) of Section 7 of the Land Acquisition Act, that the Government intends to acquire the following land/servitude* which is required for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.019999980926514,
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.76,
      462.19,
      286.53,
      594.0
    ],
    "text": "Description of the Land or servitude to be acquired: Land in extent of about 0.0311 Hectare, shown in Preliminary Plan and dated 08.12.2014 which appears as Final Village Plan No. 302, Supplement No. 13, Sheet No. 19 in the Preliminary Plan No. Anu/Me/4/RDA/TLW - Final Village Plan No. 302, Supplement No. 22, Sheet No. 28 and dated 19.10.2011, prepared by the Superintendent of Surveyor, situated in the villages of Ihala Thalawa, Moragoda and Minor Division of Nuwaragama Palatha in the Divisional Secretary\u2019s Division of Thalawa, in Anuradhapura District.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.980000019073486,
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.76,
      594.23,
      286.48,
      645.18
    ],
    "text": "01. Lot No.: F.V.F. 302/900 Name of the Land: Road Reservation; Claimant: State.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      6.0,
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      330.25,
      539.5,
      367.2
    ],
    "text": "02. Lot No.: F.V.F. 302/936 Name of the Land: Road (Road Development Authority); Claimant: State.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      367.63,
      539.5,
      416.04
    ],
    "text": "03. Lot No.: F.V.F. 302/15G Name of the Land: Road (Road Development Authority); Claimant: State.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      6.480000019073486,
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      416.59,
      539.5,
      554.04
    ],
    "text": "All persons interested in the aforesaid land/lands* on which a servitude is to be acquired are hereby required to appear personally, or by agents duly authorized in writing, before me at Divisional Secretariat, Thalawa of the 27th April, 2015 at 10.00 a.m. and are hereby requiested to notify to me in writing (in duplicate) on or before the 20th April, 2015, the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land/servitude*, the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.020000457763672
    ]
  },
