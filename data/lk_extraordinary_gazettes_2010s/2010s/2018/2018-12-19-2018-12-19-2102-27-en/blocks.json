  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      382.8,
      310.03,
      464.87
    ],
    "text": "HAVING been duly directed by the Minister of Lands andParliamentary Reforms under sub-section (1) of section 2 ofthe Land Acquisition Act, as amended by the LandAcquisition (Amendment) Act, No. 28 of 1964, I hereby givepublic notice as required by sub-section (1) of the section 7that land in the area described below is required for a publicpurpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      78.96,
      481.2,
      269.34,
      491.27
    ],
    "text": "Description of land/servitude to be acquired :",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      505.2,
      309.91,
      587.27
    ],
    "text": "The allotment of land called Walagamawaththa havingExtent of 0.0126 Hectare depicted as Lot No. 3516 as per thesurvey plan of Padiyathalawa Topo.PP 49, SupplementNo. 54 surveyed by the surveyor General, situated in thevillage of Meegaswatta with in the minor Division ofBinthenna Paththu South under the Padiyathalawa DivisionalSecretariat in Ampara District in the Eastern Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      330.96,
      330.05,
      429.05,
      340.12
    ],
