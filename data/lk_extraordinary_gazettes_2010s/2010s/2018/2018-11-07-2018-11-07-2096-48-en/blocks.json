      124.08,
      362.4,
      297.29,
      384.47
    ],
    "text": "My No. : 2/3/1/4/4.Land Ministry's Ref. No. : 4-3/2015/HA/299.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
