      618.56,
      286.69,
      650.72
    ],
    "text": "Lot No. 01 Name of the Land: Lunupitiyawatta; Description: Garden, Contains 42 Coconut Trees 25-30 years old, 09",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
