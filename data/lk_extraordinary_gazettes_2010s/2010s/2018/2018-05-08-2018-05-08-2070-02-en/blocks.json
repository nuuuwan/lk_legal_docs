  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      445.09,
      539.88,
      468.16
    ],
    "text": "This Order shall be valid for a period of 06 months commencing from May 08, 2018 subject to provisions of Subsection (3) of Section 2 of the Special Commodity Levy Act, No. 48 of 2007.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
