    ],
    "text": "Name of Land: Scrub Estate; Details: Garden; Contains a permanent building Claiment: Kelani Valley Plantations Ltd, No. 400, Deans Road, Colombo 10; Extent: about 0.1010 Hectatres.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
