  },
  {
    "page_number": 0,
    "bbox": [
      48.97,
      459.14,
      543.54,
      542.21
    ],
    "text": "BY virtue of the powers vested in me by Section 20(4)(b) of the Universities Act, No. 16 of 1978, I, Dr. Wijayadasa Rajapaksa, Minister of Higher Education and Cultural Affairs, on being satis\ufb01 ed that the administration of the affairs of the South Eastern University, Sri Lanka have been seriously dislocated and that the authorities of the said University have failed to restore normal conditions, do by this Order, appoint Professor Uma Coomaraswamy to be the Competent Authority with effect from June 18, 2018 for the purpose of exercising, performing and discharging in lieu of Vice-Chancellor of the South Eastern University, Sri Lanka, any power, duty or function which has been conferred or imposed on, or assigned to the said Vice-Chancellor under the said Act, or any Order, Ordinance, Statute, By-law, Regulation or Rule made thereunder.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
