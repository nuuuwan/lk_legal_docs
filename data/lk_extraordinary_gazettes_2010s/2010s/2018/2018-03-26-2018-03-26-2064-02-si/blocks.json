    ],
    "text": "1989 \u0d85\u0d82\u0d9a 12 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf (\u0d86\u01e9\u0dc2\u0dcf\u0d82\u0119\u0d9a \u026a\u01dd\u026a\u0db0\u0dcf\u0db1) \u0db4\u0db1\u0dad \u0d85\u01e9\u0dc0 1983 \u0d85\u0d82\u0d9a 32 \u0dc4\u0dcf 1992 \u0d85\u0d82\u0d9a 11 \u0daf\u0dbb\u0db1 \u0db4\u0db1\u01ae \u0dc0\u0263\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u01dd\u0dad 1972 \u0d85\u0d82\u0d9a 5 \u0daf\u0dbb\u0db1 \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u0db4\u0db1\u0dd9\u01ae 2 (2) \u0dc0\u0d9c\u01e6\u01af\u0dd9\u0dba\u01e6 \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u021d\u0d9a\u0dcf\u0dbb\u0dc0 \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0d9a\u0dd8\u027f\u0d9a\u0259\u0db8, \u0dd9\u0d9c\u02a3\u026a\u0da2\u0db1 \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1, \u0dc0\u0dcf\u025c\u0db8\u0dcf\u0259\u0d9c, \u0da2\u0dbd\u0dc3\u023c\u0db4\u0dcf\u0daf\u0db1 \u0dc4\u0dcf \u0da2\u0dbd\u0db4\u0dc0\u0dc4\u0db1, \u0d86\u0dc4\u0dcf\u0dbb \u0dc3\u0dd0\u0db4\u0251\u023c \u0dc4\u0dcf \u0dd9\u0db6\u0daf\u0dcf\u0dc4\u0dd0\u025d\u0db8 \u0dc3\u0dc4 \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0255 \u0d8b\u0da9\u0dbd\u0db8\u01ae\u0dad \u0d9c\u0db8\u0dd9\u0118 \u0daf\u0dba\u0dcf\u0dc0\u0d82\u0dc1 \u0d86\u025c\u0dba\u01af\u0dbd\u0d9a \u0dc0\u0db1 \u0db8\u0db8, \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0dc3\u0dc4 \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u0dd9\u0dbb\u014f\u0dc3\u0dca\u017e\u0dcf\u0259\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0dc3\u0dc4\u0dba \u026b\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u01ae\u0d9a\u0dbb \u0d87\u01ae\u0dad\u0dcf \u026d \u0db4\u0dc4\u0dad \u0daf\u00fa\u0dc0\u0dcf \u0d87\u01af \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f 1 \u0dc0\u0dd0\u01e7 \u01b0\u025e\u0dd9\u0269 \u0dc3\u0db3\u0dc4\u01e6 \u0d85\u0dba \u0dd9\u0dc0\u0dad 1983 \u0d85\u0d82\u0d9a 32 \u0dc4\u0dcf 1992 \u0d85\u0d82\u0d9a II \u0daf\u0dbb\u0db1 \u0db4\u0db1\u01ae\u0dc0\u0263\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u01dd\u0dad 1972 \u0d85\u0d82\u0d9a 5 \u0daf\u0dbb\u0db1 \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u0db4\u0db1\u0dd9\u01ae \u0dc4\u0dcf \u0d92 \u0dba\u0da7\u0dd9\u01ae \u0db4\u0db1\u0dc0\u0dcf \u0d87\u01af \u025d\u01af \u021d\u0d9a\u0dcf\u0dbb\u0dc0 \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u0dd9\u0dbb\u014f\u0dc3\u0dca\u017e\u0dcf\u0259 \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01ae\u0dad\u0dcf \u026d \u0d91\u00fc \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f III \u0dc0\u0db1 \u01b0\u025e\u0dd9\u0269 \u0dc3\u0db3\u0dc4\u01e6 \u0286\u0dba\u0265 \u0db6\u0dbd\u0dad\u0dbd \u0d91\u00fc \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f II \u0dc0\u0dd0\u01e7 \u01b0\u025e\u0dd9\u0269 \u0dc3\u0db3\u0dc4\u01e6 \u01ce\u0db1 \u0286\u0da7 \u0dd9\u0db8\u0250\u01e6 \u0db4\u0dc0\u0dbb\u023d. \u0d8b\u0da9\u0dbd\u0db8\u01ae\u0dad \u0d9c\u0db8\u0dd9\u0118 \u0daf\u0dba\u0dcf\u0dc0\u0d82\u0dc1 \u0d86\u025c\u0dba\u01af\u0dbd\u0d9a, \u0d9a\u0dd8\u027f\u0d9a\u0259\u0db8, \u0dd9\u0d9c\u02a3\u026a\u0da2\u0db1 \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1, \u0dc0\u0dcf\u025c\u0db8\u0dcf\u0259\u0d9c, \u0da2\u0dbd\u0dc3\u023c\u0db4\u0dcf\u0daf\u0db1 \u0dc4\u0dcf \u0da2\u0dbd\u0db4\u0dc0\u0dc4\u0db1 \u0d86\u0dc4\u0dcf\u0dbb \u0dc3\u0dd0\u0db4\u0251\u023c \u0dc4\u0dcf \u0dd9\u0db6\u0daf\u0dcf\u0dc4\u0dd0\u025d\u0db8 \u0dc3\u0dc4 \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0255, \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u0dad. 2018 \u0dd9\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u025c \u0db8\u0dc3 23 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0d9c\u0dcf\u0262\u0dd9\u0262 \u01cf\u0dba.",
