  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      404.88,
      309.95,
      462.95
    ],
    "text": "I, hereby give notice, under Sub-section (1) of Section 7 ofthe Land Acquisition Act as amended by the Land Acquisition(Amendement) Act, No.28 of 1964, that the Governmentintends to acquire the following land/Servitude which isrequired for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      81.84,
      472.08,
      299.84,
      482.15
    ],
    "text": "Description of the Land or Servitude to be Acquired :",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      493.68,
      310.12,
      575.75
    ],
    "text": "The land allotment called Puwakgahadeniya Kumbura intotal extent of about 0.510 Hectare depicted as Lot No. 1 inPlan No. uq' ms' fld' 9798 dated 07.12.2018 prepared bySurveyor General situated in the village called Dadigamuwa,in the Grama Niladari Division No. 480 of Welipillawa, in theDivisional Secretary's division of Kaduwela of Colombodistrict in Western province.",
    "fonts": [
      "FMAbhayax",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070319175720215,
      10.070419311523438
    ]
  },
