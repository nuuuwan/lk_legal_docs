      310.05,
      392.15
    ],
    "text": "My No.: lvq$bv\u00ef$03$160$CEB.Land Ministry No.: 4-3/2/2018/CEB/163.",
    "fonts": [
      "FMAbhayax",
      "TimesNewRomanPS-ItalicMT",
