    ],
    "text": "\u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dd9\u0dba\u0dca \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0daf\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0dd9\u0db8\u0dca \u0d85\u0d82\u0d9a 2 A \u0db4\u0dd2\u0da7\u0dd4\u0dd9\u0dc0\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0da9\u0dba\u0dd2\u0db8\u0dca \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0db8\u0dca \u0d85\u0d82\u0d9a 510061 (\u0d9a\u0dbd\u0dcf\u0db4 3) \u0dc4\u0dcf \u0db4\u0dad\u0dba 3 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 04 \u0db1\u0dca \u0dbb\u0da2\u0dba\u0da7 \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0db4\u0db8\u0dcf\u0dab\u0dba \u0dba\u0dad\u0dd4\u0dbb\u0dd4 \u0dbd\u0dd2\u0dba\u0db1 \u0dd9\u0daf\u0ddd\u0dc2\u0dba\u0d9a\u0dca \u0db8\u0dad \u0dd9\u0dc4\u0d9a\u0dca. 0.03186 \u0d9a\u0dca \u0dd9\u0dbd\u0dc3 \u0dc3\u0db3\u0dc4\u0db1\u0dca\u0dc0 \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0d9a\u0da9\u0dba\u0dd2\u0db8\u0dca \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0db8\u0dca \u0d85\u0d82\u0d9a 510061 \u0d9a\u0dbd\u0dcf\u0db4 3 \u0dc4\u0dcf \u0db4\u0dad \u0d85\u0d82\u0d9a 3 \u0db4\u0dd2\u0db9\u0dd4\u0dd9\u0dbb\u0dca \u0d91\u0db8 \u0db4\u0db8\u0dcf\u0dab\u0dba \u0dd9\u0dc4\u0d9a\u0dca. 0.3186 \u0d9a\u0dca \u0dd9\u0dbd\u0dc3 \u0daf\u0dd0\u0d9a\u0dca\u0dd9\u0dc0\u0db1 \u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0d9a\u0da9\u0dba\u0dd2\u0db8\u0dca \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0db8\u0dca \u0d85\u0d82\u0d9a 510061 (\u0d9a\u0dbd\u0dcf\u0db4 3) \u0dc4\u0dcf \u0db4\u0dad\u0dba 3 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 04 \u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dd9\u0da1\u0dca\u0daf\u0dba \u0db4\u0dc4\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0db1\u0dba \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0 \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dca \u0db4\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u0db8\u0dd2. 01. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 04 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dc4\u0dbd\u0dca\u0dd9\u0db4 \u0d9a\u0db1\u0dca\u0daf; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0d91\u0db8\u0dca. \u0db4\u0dd3. \u0dd9\u0db4\u0db8\u0dcf\u0db1\u0dd2\u0dc3\u0dca,\u0db1\u0dbb\u0dd2\u0dba\u0db8\u0dd4\u0dbd\u0dca\u0dbd,\u0db8\u0dd3\u0dbb\u0dd2\u0d9c\u0db8; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.3186. \u0d91\u0da0\u0dca. \u0d91\u0db8\u0dca. \u0d91\u0dbd\u0dca. \u0d91\u0dc3\u0dca. \u0dd9\u0dc4\u0dda\u0dbb\u0dad\u0dca, \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca, \u0daf\u0dd2\u0dc0\u0dd4\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dba.",
