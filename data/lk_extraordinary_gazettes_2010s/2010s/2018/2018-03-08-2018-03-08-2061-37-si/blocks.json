    "text": "\u0db8\u0db0\u0255\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0db8\u0dcf\u0dad\u0dd9\u0262 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0daf\u0249\u0262\u0dbd \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0dc0\u0d9c\u0db4\u0db1\u0dc4 \u0db4\u0262\u0dd9\u0262\u0286\u0dba \u0db4\u01ae\u01b1\u0dc0, \u0d85\u0d82\u0d9a \u0d8a 440 \u018c, \u0dc0\u0dd0\u0dbd\u023d\u0179\u0dba\u0dcf\u0dc0 \u011e\u0dcf\u0db8 \u01e7\u0dc5\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0dc0\u0dd0\u0dbd\u023d\u0179\u0dba\u0dcf\u0dc0 \u0d9c\u0dd9\u023c \u0d85\u0dc0\u0dc3\u0dcf\u0db1 \u0d9c\u023c \u0218\u0249\u025e \u0d85\u0d82\u0d9a \u0db8\u0dcf 949 \u028f \u0db4\u0dc4\u0dad \u026a\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0daf\u0dc4\u01e6 \u0d9a\u0dbb \u0d87\u01af \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 01 \u0daf\u00fa\u0dc0\u0dcf (\u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f \u0dc3\u0daf\u0dc4\u01e6 \u0d9a\u0dbb \u0d87\u0dad)",
