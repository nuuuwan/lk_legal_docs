    ],
    "text": "\u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 176 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0db4\u01e6\u0dc3\u0dbd\u0d85\u01ca\u0daf\u0dbb \u0d95\u026a\u0da7, \u0d85\u01ca\u0daf\u0dbb \u0d95\u026a\u0da7, \u0d9a\u0259\u0db8\u0dcf\u01e6\u0dad\u01d0\u0dc0, \u0d86\u0dbb\u013c\u013d\u0dd9\u0d9c\u00fd\u0249\u0dbb, \u0d9a\u0dbb\u0dcf\u00fd\u0249\u0dbb \u0dc3\u0dc4 \u0dd9\u0daf\u02a3\u0dc3\u0dca\u0dad\u0dbb\u0dd9\u0d9c\u0dc0\u01ae\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba : \u0dbb\u0da2\u0dba; \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba : \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf : \u0db1\u0dcf\u0d9c\u025c\u0d9a \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dba \u0d9c\u0dcf\u0262\u0dbd; \u021d\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0066 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0d89\u0da9\u0db8\u0da7 / \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0dba\u0da7 \u028f\u023d\u0d9a\u023c, \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u0dc3\u023c\u0db6\u01e6\u0db0\u0d9a\u023c \u00fb\u0dba\u0dcf \u0286\u0179\u0db1 \u0286\u0dba\u0265 \u0dd9\u0daf\u0db1\u0dcf\u0db8 \u0dad\u0db8 \u0dad\u0db8\u01e6 \u0dd9\u0dc4\u02a4 \u0d94\u026c\u01e6\u0dd9\u0d9c\u01e6 \u0263\u0dba\u026a\u0263 \u0dc0\u0263\u01e6 \u0db6\u0dbd\u0dba\u0dbd\u01ae \u0d85\u0dba\u0dc0\u0265\u01e6 \u0dd9\u0dc4\u02a4 2018.08.20 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u021a.\u0db7\u0dcf 9.00 \u0da7 \u0d9c\u0dcf\u0262\u0dbd \u0d9a\u0da9\u0dc0\u01ae \u0dc3\u0dad\u0dbb",
