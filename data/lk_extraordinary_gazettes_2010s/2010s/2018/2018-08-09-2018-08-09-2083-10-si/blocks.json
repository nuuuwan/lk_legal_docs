    "text": "\u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u02a3\u0dd9\u0dbb\u02a3\u01ae\u01b1 \u0dc0\u0db1 \u0d89\u0da9\u0dd9\u023c/\u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dd9\u0269 \u026a\u0dc3\u0dca\u0dad\u0dbb: \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0d9c\u0dcf\u0262\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0d9c\u0dcf\u0262\u0dbd \u0d9a\u0da9\u0dc0\u01ae \u0dc3\u0dad\u0dbb \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d9c\u0dcf\u0262\u0dbd \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0287\u0db8\u0dcf\u0dc0 \u01b1\u0dc5 101 \u0db8\u0dcf\u0d89\u0179\u0dd9\u0217 \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0db8\u0dcf\u0d89\u0179\u0dd9\u0217 \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 \u0db8\u0dd0\u0db1 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u023c \u0d85\u0d82\u0d9a 810020 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0218\u0249\u0dd9\u0259, \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 01 \u028f \u0db4\u01b4 \u0d85\u0d82\u0d9a 07\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 135, 137, 140 \u0dc3\u0dc4 143 \u0dd9\u0dbd\u0dc3 \u0dd9\u0db4\u01e6\u01e9\u023c \u0d9a\u0dbb \u0d87\u01af \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0174 \u00fa \u026d \u0db4\u0dc4\u0dad \u0db1\u023c\u0dc0\u0263\u01e6 \u0dc4\u0dcf \u0db8\u0dcf\u0250\u023c\u0dc0\u0263\u01e6 \u0252\u01ae \u022a\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dcf\u0250\u023c - \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 135 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 :\u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb \u0db1\u0dd0\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba :\u0dbb\u0da2\u0dba; \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba : \u028f\u025c\u0249\u0dbb \u0dc4\u0dbb\u0dc3\u0dca \u0db4\u0dcf\u0dbb; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf : \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 01 \u028f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0d87\u0dc5 \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0255\u0dc0 \u0d87\u0dad; \u021d\u0db8\u0dcf\u0dab\u0dba - \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0019 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 137 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 : \u0dd9\u0db6\u0dd9\u0dbd\u00fa\u0db8\u01e6\u0d9a\u0db1\u01ae\u0dd9\u01ae \u0d85\u01ca\u0daf\u0dbb\u0dc0\u01ae\u0dad, \u0d9a\u0da9\u00fd\u0178\u0179\u0dd9\u0118\u0dc0\u01ae\u0dad. \u0dd9\u0db6\u02a3\u023c\u0dd9\u0229 \u0d9a\u0dcf\u0dc3\u0262 \u0dc0\u01ae\u0dad \u0db8\u01e6\u0da9\u0dc0\u0dbd\u0dc0\u01ae\u0dad, \u0d85\u0229\u01d0\u00fd\u0dbb\u01e6\u0dc0\u01ae\u0dad, \u0dc0\u0dd1\u0dd9\u0d9c\u02a3\u0da9\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u0db8\u0dbb\u00fa\u0d9a\u0dbd \u00fd\u0249\u0dbb; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba : \u0dd9\u0d9c\u0dc0\u01ae\u0dad, \u0dc3\u0dca\u01c2\u0dbb \u0dd9\u0d9c\u02a3\u0da9\u0db1\u0dd0\u0119\u0262\u0dbd\u0d9a \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dc3\u0dc4 \u023d\u0279 \u0dc0\u0d9c\u0dcf\u0dc0\u01e6 \u0d87\u0dad; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u021d\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0100 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 140 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 :\u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb \u0dd9\u0db1\u02a3\u0db8\u0dd0\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba : \u0dbb\u0da2\u0dba; \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba : \u0db8\u0dcf\u0259\u0d9c\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf :\u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u021d\u0db8\u0dcf\u0dab\u0dba :\u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0048 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 143 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 :\u0dd9\u0db6\u02a3\u023c\u0dd9\u0229 \u0d9a\u0dcf\u0dc3\u0262 \u0dc0\u01ae\u0dad;\u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba : \u0dbb\u0da2\u0dba; \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba : \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf : \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 10 \u0d9a \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0dd9\u0dbd\u0dc3 \u0dc3\u0db3\u0dc4\u01e6\u0dc0 \u0d87\u0dad; \u021d\u0db8\u0dcf\u0dab\u0dba :\u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0007 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d89\u0dc4\u0dad \u0dc3\u0daf\u0dc4\u01e6 \u0d89\u0da9\u0db8\u0da7/\u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0dba\u0da7 \u028f\u023d\u0d9a\u023c, \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u0dc3\u023c\u0db6\u01e6\u0db0\u0d9a\u023c \u00fb\u0dba\u0dcf \u0286\u0179\u0db1 \u0286\u0dba\u0265\u0dd9\u0daf\u0db1\u0dcf\u0db8 \u0dad\u0db8",
