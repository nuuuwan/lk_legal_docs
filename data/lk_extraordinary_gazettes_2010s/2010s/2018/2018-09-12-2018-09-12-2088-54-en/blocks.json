    ],
    "sizes": [
      7.0,
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.17,
      616.45,
      547.29,
      679.6
    ],
    "text": "On the powers conferred to me in Section 27(3) of Urban Council Act, when it is held to conduct the entertainment programsin the Gampola Urban Council Authority as specified in Section III of the Ordinance on Entertainment Taxation, it has beendetermined to impose an Entertainment tax of 10% when the entrance fee is between Rs. 1.00 to Rs. 200, 12% when the entrancefee is between Rs. 201 to Rs. 500, 15% when the entrance fee is over Rs. 501 and 7.5% of the value of the ticket when oncinematic view as per the Section (2) 1 of No. 12 of 1946 Tax Ordinance and Section 37 of the 1984 Tax Amendment Act.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
