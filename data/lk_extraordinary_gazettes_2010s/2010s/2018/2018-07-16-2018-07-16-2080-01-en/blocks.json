      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      453.25,
      539.85,
      488.32
    ],
    "text": "The notification relating to the Rates of Exchange published in Gazette Extraordinary, No. 2079/1 of09th July, 2018 is hereby rescinded and the said Rates of Exchange are Scheduled to be rescinded by a similar notificationto be published on or before 22nd July, 2018.",
