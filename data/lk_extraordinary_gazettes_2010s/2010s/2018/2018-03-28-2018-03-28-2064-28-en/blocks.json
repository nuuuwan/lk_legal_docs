  {
    "page_number": 0,
    "bbox": [
      55.2,
      422.72,
      295.45,
      480.8
    ],
    "text": "I, hereby give notice, under Sub Section (1) of Section 7 of theLand Acquisition Act, as amended by the Land Acquisition(Amendment) Act, No. 28 of 1964 Government intends toacquire the following land/servitude which is required for apublic purpose:",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.2,
      494.72,
      295.4,
      588.8
    ],
    "text": "The following Land situated in the village of Thalpavila Eastin No. 430A Thalpavila North Grama Niladhari division in theMatara Divisional Secretariat division, Matara District,Southern Province and depicted as Lot No. 01 in Primary PlanMara 2725 has been acquired to the renovation of houses dueto the construction of Matara-Katharagama new railway lineand acquisition of houses on the technical requirements ofthe site.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      155.76,
      600.32,
      194.78,
      610.4
    ],
