    "text": "\u0b9a\u0bc8.\u0b8f.\u0b9a\u0bc8. \u0bb0\u0b9e\u0bcd\u0b9c\u0bbf\u0ba4\u0bcd \u0ba4\u0bb0\u0bcd\u0bae\u0baa\u0bbe\u0bb2, \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba8\u0bbf\u0bb0\u0bcd\u0ba3\u0baf \u0b86\u0b95\u0ba3\u0baf\u0bbe\u0bb3\u0bb0\u0bcd. \u0bc8\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba8\u0bbf\u0bb0\u0bcd\u0ba3\u0baf\u0ba4\u0bcd \u0ba4\u0bbf\u0b95\u0ba3\u0b95\u0bcd\u0bc8\u0bb3\u0bae\u0bcd, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0bbf \u0bbf\u0bc8\u0ba4 \u0b9a\u0bae\u0ba4\u0bc1\u0bb0\u201d, \u0b87\u0bb0\u0b9c\u0bae\u0bb2\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4 \u0bb5\u0bc0\u0ba4\u0bbf, \u0baa\u0ba4\u0bcd\u0ba4\u0bb0\u0bae\u0bc1\u0bb2\u0bcd\u0b95\u0bb2. 2018 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0b9a\u0b9a\u0ba4\u0bcd\u0b9a\u0ba4\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd 05\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf.",
