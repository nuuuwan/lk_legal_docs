    "text": "\u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb\u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae (460 \u0dc0\u0dd0\u01e7 \u0db4\u025c\u013c\u0dd9\u0146\u0daf\u0dba ) 7 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0daf\u0dd0\u01e6\u026b\u0db8\u0250 \u0db8\u0dd9\u0118 \u0d85\u0d82\u0d9a\u0dba: DS/GFG/L&L/5/85. \u0d89\u0da9\u023c \u0dc4\u0dcf \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1 \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0d85\u0db8\u0dcf\u0dad\u0255\u0dcf\u0d82\u0dc1 \u0d85\u0d82\u0d9a\u0dba: 4-3/11/2016/UD/76. \u0db8\u0dc4\u0da2\u0db1 \u0d9a\u0da7\u0252\u01ae\u0dad\u00fa \u0dc3\u0daf\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0255 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0d89\u0da9\u0db8 /\u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0 \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0d86\u019c\u018d\u0dc0 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0db6\u0dd0\u0269,1964 \u0d85\u0d82\u0d9a 28 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c (\u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1) \u0db4\u0db1\u01af\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u01dd\u0dad \u0db4\u025c\u01ce \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e7\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 7 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (1) \u0dc0\u0dd0\u01e7 \u0d8b\u0db4 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dd9\u0db8\u0250\u01e6 \u0daf\u0dd0\u01e9\u023c \u01cf \u0286\u0179\u023d. \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u02a3\u0dd9\u0dbb\u02a3\u01ae\u01b1 \u0dc0\u0db1 \u0d89\u0da9\u0dd9\u023c/\u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dd9\u0269 \u026a\u0dc3\u0dca\u0dad\u0dbb : \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0d9c\u0dcf\u0262\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0d9c\u0dcf\u0262\u0dbd \u0d9a\u0da9\u0dc0\u01ae \u0dc3\u0dad\u0dbb \u021d\u0dcf\u0dd9\u01ca\u0274\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d9c\u0dcf\u0262\u0dbd \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0287\u0db8\u0dcf\u0dc0 \u01b1\u0dc5 98, \u0db8\u0da9\u0dc0\u0dbd\u023f\u0262\u0dbd \u0daf\u00fd\u0dab \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0db8\u0da9\u0dc0\u0dbd\u023f\u0262\u0dbd \u0daf\u00fd\u0dab \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 \u0db8\u0dd0\u0db1 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u023c \u0d85\u0d82\u0d9a 810023 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0218\u0249\u0dd9\u0259, \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 03\u028f \u0db4\u01b4 \u0d85\u0d82\u0d9a 04\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 213, 214, 216, 217, 220, 222, 223, 225, 226 \u0dd9\u0dbd\u0dc3 \u0dd9\u0db4\u01e6\u01e9\u023c \u0d9a\u0dbb \u0d87\u01af \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0215 \u00fa \u026c \u0db4\u0dc4\u0dad \u0db1\u023c\u0dc0\u0263\u01e6 \u0dc4\u0dcf \u0db8\u0dcf\u0250\u023c\u0dc0\u0263\u01e6 \u0252\u01ae \u022a\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0dc3\u0daf\u0dc4\u0dcf \u0db8\u0dcf\u0250\u023c- \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 213 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb \u0db1\u0dd0\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0db8\u0dcf\u0259\u0d9c\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0007\u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 214 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb \u0db1\u0dd0\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0db8\u0dcf\u0259\u0d9c\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0005\u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 216 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0db8\u0dcf\u0259\u0d9c\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0072 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 217 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u023f\u0daf\u023d\u0dba\u0db1\u0dd9\u0118 \u0263\u0dba\u01ca\u0daf, \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba - \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a, \u028f\u025c\u0249\u0dbb \u0db4\u0dcf\u0dbb; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0dd9\u0d9c\u0dc0\u01ae\u0dad; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dbb\u0286\u0d9a\u0dcf \u00fd\u0db8\u0dcf\u025c \u0db8\u0262\u0dc0\u0dd0\u01e6\u0db1; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0022\u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 220 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u023f\u0daf\u023d\u0dba\u0db1\u0dd9\u0118 \u0263\u0dba\u01ca\u0daf, \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba - \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a, \u028f\u025c\u0249\u0dbb \u0db4\u0dcf\u0dbb; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0dd9\u0d9c\u0dc0\u01ae\u0dad; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0db1\u0dcf\u0db8\u0264 \u0db8\u0262\u0dc0\u0dd0\u01e6\u0db1; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0009\u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 222 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u023f\u0daf\u023d\u0dba\u0db1\u0dd9\u0118 \u0263\u0dba\u01ca\u0daf, \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba - \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a, \u028f\u025c\u0249\u0dbb \u0db4\u0dcf\u0dbb; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0dd9\u0d9c\u0dc0\u01ae\u0dad; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0db4\u01ca\u0db8\u0dcf \u0dd9\u0269\u0dc0\u0dd0\u0262\u0dc0\u0dbd; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0008 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269.",
