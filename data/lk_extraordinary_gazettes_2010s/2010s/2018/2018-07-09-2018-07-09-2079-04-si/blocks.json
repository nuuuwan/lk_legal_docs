    ],
    "text": "\u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 200 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a, \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0dd9\u0d9c\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u023d\u0279 \u0dc0\u0d9c\u0dcf\u0dc0\u00fa \u0d87\u0dad; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0028 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 202 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u01ce\u00fa\u0263\u0dba\u01ca\u0daf \u021a\u0d82\u013d \u0dd9\u0db4\u02a3\u01b1\u00fd\u0249\u0dbb, \u0dd9\u0dc0\u0dbb\u0265\u0d9c\u0dc4\u0d95\u026a\u0da7 \u0dc3\u0dc4 \u021a\u0dc0\u00fa\u0d9c\u0dc4 \u0d95\u026a\u0da7, \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba - 106, \u027c \u0dd9\u0dc4\u02a2\u0db8\u0dcf\u0db1\u01e6\u0daf \u0db8\u0dcf\u0dc0\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0dd9\u0d9c\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u023d\u0279 \u0dc0\u0d9c\u0dcf\u0dc0\u00fa \u0d87\u0dad; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0d9a\u01e6\u0dd9\u01ca \u0d9a\u021a\u0dd9\u0118 \u01e7\u0db8\u0262 \u021f\u0dba\u01e6\u0dc3\u0dca \u026a\u0dd9\u014e\u0dd9\u0dc3\u02a2\u0d9a\u0dbb; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0008 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 205 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0dd9\u0d9c\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u023d\u0279 \u0dc0\u0d9c\u0dcf\u0dc0\u00fa \u0d87\u0dad; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0049\u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 206 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0d9a\u0dd0\u0dbd\u0dd9\u0dc4\u0179\u0dba\u0dcf\u01d1\u0dc0 \u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u0d9a\u0dd0\u0dbd\u0dd9\u0dc4\u0179\u0dba \u0dc0\u01ae\u0dad \u0d85\u01ca\u0daf\u0dbb\u0d95\u026a\u0da7, \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba 459/22, \u028f\u025c\u0249\u0dbb \u0db4\u0dcf\u0dbb; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0dd9\u0d9c\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u023d\u0279 \u0dc0\u0d9c\u0dcf\u0dc0\u00fa \u0d87\u0dad; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0288\u0db7\u0dcf\u027f\u019e \u0dd9\u00fa\u0dc2\u0dbd\u0dcf \u0d8b\u018d\u0db8\u0dbd\u0d9c\u0dbd \u0d9c\u0db8\u0dd9\u0118; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0005\u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 209 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0d9a\u0dd0\u0dbd\u0dd9\u0dc4\u0179\u0dba\u0dcf\u01d1\u0dc0 \u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u0d9a\u0dd0\u0dbd\u0dd9\u0dc4\u0179\u0dba \u0dc0\u01ae\u0dad \u0d85\u01ca\u0daf\u0dbb\u0d95\u026a\u0da7, \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0dd9\u0d9c\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u023d\u0279 \u0dc0\u0d9c\u0dcf\u0dc0\u00fa \u0d87\u0dad; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0d9a\u0dbd\u0dd9\u0dc4\u02a2 \u0d9a\u01e6\u0d9a\u0dcf\u0db1\u023c\u0dd9\u0118 \u021d\u01cf\u0db4 \u01ce\u0262\u0db8\u0dcf\u0262 \u0daf \u0d85\u0262\u026a\u0dc3\u0dca; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0005\u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 211 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb \u0db1\u0dd0\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0db8\u0dcf\u0259\u0d9c\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0012 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 214 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0d85\u01ca\u0daf\u0dbb\u0d95\u026a\u0da7; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0dd9\u0d9c\u0dc0\u01ae\u0dad, \u0dc3\u0dca\u01c2\u0dbb \u0dd9\u0d9c\u02a3\u0da9\u0db1\u0dd0\u0119\u0262\u0dbd\u00fa \u0d87\u0dad; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0d86\u0259. \u0d91\u013c. \u026a\u0100\u0db8\u0286\u0d82\u0dc4; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0042 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 216 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0dd9\u0d9c\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u023d\u0279 \u0dc0\u0d9c\u0dcf\u0dc0\u00fa \u0d87\u0dad; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0004 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 218 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0dd9\u0d9c\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u023d\u0279 \u0dc0\u0d9c\u0dcf\u0dc0\u00fa \u0d87\u0dad; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0036 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269.",
