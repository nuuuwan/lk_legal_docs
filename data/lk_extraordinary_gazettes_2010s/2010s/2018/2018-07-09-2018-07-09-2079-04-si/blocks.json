    ],
    "text": "\u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 174 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u00fc\u0247\u0dd9\u0dba\u0d9a\u0db1\u0179\u0dba \u0dc3\u0dc4 \u0daf\u0d82\u0d9c\u0dc4 \u0d95\u026a\u0da7 \u0d89\u0dc4\u0dc5 \u0d9a\u0dd0\u0db6\u0dd0\u0262\u0dbd; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0db8\u0dcf\u0259\u0d9c\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0006 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 175 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb \u0db1\u0dd0\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0db8\u0dcf\u0259\u0d9c\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u0db6\u0263\u0d9c\u0dc4 \u0d85\u01b1\u025e \u0d87\u0dc5 \u0db8\u0dcf\u0259\u0d9c\u0dba \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0255\u0dc0 \u0d87\u0dad; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0034\u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 177 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0002 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 178 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0019\u00fa \u0db4\u0db8\u0dab \u0dd9\u0269. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 180 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0d9a\u02a3\u0dc3\u0dca\u01d1\u0dc0\u0dc0\u01ae\u0dad, \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba- 455\u0d8a, \u028f\u025c\u0249\u0dbb \u0db4\u0dcf\u0dbb; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba, \u0d89\u0da9\u023c \u0db4\u025c\u0dc4\u0dbb\u0dab\u0dba - \u0dd9\u0d9c\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u023d\u0279 \u0dc0\u0d9c\u0dcf\u0dc0\u00fa \u0d87\u0dad; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u028f\u0dbb\u01e6\u0dad \u0288\u0150\u0dc0 \u0dd9\u0262\u0d9a\u023c\u0dc0\u0dc3\u023c \u0263\u0dba\u0db1\u0dd9\u0118, \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0004 \u00fa \u0db4\u0db8\u0dab \u0dd9\u0269.",
