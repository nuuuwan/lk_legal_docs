      62.64,
      383.11,
      314.66,
      405.2
    ],
    "text": "My Ref. : DHO/LAN/ACQTN/A1/2/57Land and Parliamentary Reforms Ministry's Reference No. :",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
