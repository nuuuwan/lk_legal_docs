      327.69,
      369.49,
      538.91,
      391.6
    ],
    "text": "DR. INDRAJIT COOMARASWAMY,Chairman of the Monetary Board and the Governor,",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
