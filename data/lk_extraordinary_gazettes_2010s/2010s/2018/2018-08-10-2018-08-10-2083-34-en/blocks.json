    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      48.81,
      424.45,
      538.8,
      469.24
    ],
    "text": "The public is hereby informed that in terms of Section 37 of the Finance Business Act, No. 42 of 2011, theMonetary Board of the Central Bank of Sri Lanka, has decided to cancel the licence issued to The Standard CreditFinance Limited under the said Finance Business Act with effect from 25th July 2018. Accordingly, The Standard CreditFinance Limited is not permitted to carry on finance business with effect from 25th July 2018.",
    "fonts": [
      "TimesNewRoman"
