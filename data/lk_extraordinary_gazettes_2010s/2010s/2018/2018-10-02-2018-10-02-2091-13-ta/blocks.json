    "text": "1980 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 33 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95, \u0baa\u0bc0\u0bc8\u0b9f\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u1fa2\u0b95\u0bc8\u0bb3\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u1f8c\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0bb1\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd II \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba4\u0bcd\u1f90\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0baf\u0bc8\u0ba9\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u1f8c, \u0baa\u0bc0\u0bc8\u0b9f\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u1fa2\u0b95\u0bb3\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bbe\u0bb3\u0bb0\u0bbe\u0b95\u0bbf\u0baf \u0b9c\u0baf\u0bc6\u0b95\u0bbe\u1f8a \u0b86\u0bb0\u0bbe\u0b9a\u0bcd\u0b9a\u0bbf\u0bc7\u0b95 \u0b9a\u0bc1\u0bae\u0bbf\u0ba4\u0bcd \u0b86\u0b95\u0bbf\u0baf \u0ba8\u0bbe\u0ba9\u0bcd,\u0bc6\u0baa\u0bbe\u1f90\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b85\u0b95\u0bcd\u0b95\u0bc8\u0bb1 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0baa\u0bc0\u0bc8\u0b9f\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u1fa2\u0b95\u0bb3\u0bcd \u0bc6\u0ba4\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd\u1f92\u0b9f\u0bcd\u0baa \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bae\u0ba4\u0bbf\u1f9c\u0bc8\u0bb0\u0b95\u0bcd \u0b95\u0bc1\u1fa8\u0bb5\u0bbf\u0ba9\u0bcd \u0bae\u0ba4\u0bbf\u1f9c\u0bc8\u0bb0\u0baf\u0bbf\u0ba9\u0bcd \u0bae\u0bc0\u1f90 \u0b87\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 II \u0b86\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u1f90\u0bc8\u0bb0\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u1f99\u0bc8\u0bb1\u0baf\u0bbf\u0bb2\u0bcd \u0b87\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 I \u0b86\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0b9f\u0bc8\u0ba3\u0baf\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u1f90\u0bc8\u0bb0\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0bb0\u0b9a\u0bbe\u0baf\u0ba9 \u0b9a\u0bc1\u1f9e\u0b95\u0bcd\u0b95 \u0bc7\u0b9a\u0bc8\u0bb5 \u0baa\u0ba4\u0bbf\u1fab \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0bc8\u0ba4 \u0ba4\u0bbe\u0b99\u0bcd\u0b95\u0bbf\u0baf \u1f99\u0bc8\u0ba9\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0b86\u0b95\u0bcd\u0b95\u0b95\u0bcd\u0b95\u0bc2\u1fa0\u0b95\u0bc8\u0bb3\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0baa\u0bc0\u0bc8\u0b9f\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u1fa2\u0b95\u0bb3\u0bcd \u0bc6\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b92\u0bb5\u0bcd\u0bc6\u0bb5\u0bbe\u1f9e \u0b89\u0bbe\u0bbf\u0bae\u0ba4\u0bcd\u0bc8\u0ba4\u1f9c\u0bae\u0bcd \u0b87\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0baf\u0bbe\u0bb2\u0bcd \u0ba4\u0bbf\u0bbe\u0bbf\u1f97\u0baa\u1f8c\u0ba4\u0bcd\u1f90\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd. \u0baa\u0bc0\u0bc8\u0b9f\u0bc6\u0b95\u0bbe\u0bb2\u0bcd\u1fa2\u0b95\u0bb3\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bbe\u0bb3\u0bb0\u0bcd. \u0bc7\u0baa\u0bb0\u0bbe\u0ba4\u0bc8\u0ba9.",
