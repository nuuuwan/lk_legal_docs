    "bbox": [
      321.84,
      329.04,
      562.02,
      351.11
    ],
    "text": "North: Lot No. 117; East: Lot Nos. 120 and 121; South: LotNo. 121; West: Lot No. 117.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
