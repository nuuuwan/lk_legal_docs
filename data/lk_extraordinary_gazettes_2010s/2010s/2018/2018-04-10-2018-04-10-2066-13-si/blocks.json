    ],
    "text": "\u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0daf\u0dd0\u01e6\u026b\u0db8\u0250. \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u01ae, \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dd9\u0269 \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0dbb\u01e7\u0262 \u026a\u0100\u0db8\u0dd9\u0dc3\u02a2\u0d9a\u0dbb \u0dc0\u0db1 \u0db8\u0db8 2012 \u0d85\u0d82\u0d9a 22 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0da1\u01e6\u0daf \u026a\u0db8\u0287\u023c (\u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1) \u0db4\u0db1\u01af\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u01dd\u0dad \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0da1\u01e6\u0daf \u026a\u0db8\u0287\u023c \u0d86\u0da5\u0dcf \u0db4\u0db1\u0dd9\u01ae 66 (\u0d87) \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u021d\u0d9a\u0dcf\u0dbb\u0dc0 \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u0dad \u01b1\u0dc5 \u0218\u028f\u0179\u0dba\u0dcf \u026d \u0dd9\u0db8\u028f \u0db4\u0dc4\u0dad \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba \u0dba\u0da7\u0dd9\u01ae \u0db1\u023c \u0dc3\u0db3\u0dc4\u01e6 \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0d9c\u0dbb\u0dcf\u01dd\u0db4\u01af / \u01e7\u0dd9\u0dba\u02a4\u0da2\u0255 \u0db1\u0d9c\u0dbb\u0dcf\u01dd\u0db4\u01af \u0dd9\u0dad\u02a4\u0dbb\u0dcf \u0db4\u01ae \u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0d9a\u0dcf\u0259\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u025a\u0dc3\u0dca\u026b\u0db8 \u0db4\u0dc4\u0dad \u0d8b\u0db4 \u0dd9\u0262\u0d9b\u0db1\u0dba \u0dba\u0da7\u0dd9\u01ae\u0db8 \u0d85\u01e9\u025f\u0219\u0dc0 \u0daf\u00fa\u0dc0\u0dcf \u0d87\u01af \u01ce\u0db1\u0dd9\u0dba\u028f \u01e7\u0dba\u023d\u0dad \u0dd9\u0269\u0dbd\u0dcf\u0dc0\u