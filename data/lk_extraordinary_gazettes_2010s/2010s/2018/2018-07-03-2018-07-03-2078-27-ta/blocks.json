    "text": "\u0ba8\u0b95\u0bb0\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bbf\u0b9f\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0b9a\u0bcd\u0b9a\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 35, \u0bb2\u0b95\u0bcd\u0ba4\u0bbf\u0baf \u0bc6\u0bae\u1f90\u0bb0, \u1f97\u0ba4\u0bbf\u0baf \u0baa\u0bbe\u0bb0\u1fa6\u0bae\u0ba9\u0bcd\u0bb1 \u1faa\u0ba4\u0bbf, \u0bc6\u0baa\u0bb2\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0baa\u0ba4\u0bcd\u0ba4\u0bb0\u1f99\u0bb2\u0bcd\u0bc8\u0bb2. 2018, \u1f9d\u0ba9\u0bcd 14. \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3 \u0bc6\u0b95\u0bbe\u1fa8\u0bae\u0bcd\u1f97 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd, \u0bc6\u0ba4\u0bb9\u0bbf\u0bb5\u0bc8\u0bb3 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 538, \u0b95\u1fa6\u0bc7\u0baa\u0bbe\u0bb5\u0bbf\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b95\u1fa6\u0bc7\u0baa\u0bbe\u0bb5\u0bbf\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bb0\u0ba4\u0bcd\u0ba9\u0bbe\u0bb5\u0bb2\u0bc0 \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 19 \u0b89\u0bc8\u0b9f\u0baf \u1faa\u0b9f\u0bcd\u1f8c\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u1f9e\u0b95\u0bbe\u0bc8\u0bae\u0baf\u0bbf\u1fa4\u0bb3\u0bcd\u0bb3 \u0b85\u0ba3\u0bcd\u0ba3\u0bb3\u0bb5\u0bbe\u0b95 3 \u0bc7\u0baa\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bb8\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0ba4\u0bcd\u0bc8\u0ba4\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u1f9e\u0bae\u0bcd \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0b95\u0bbe\u0ba3\u0bbf\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf.",
