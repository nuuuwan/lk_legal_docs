  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      451.57,
      538.98,
      514.6
    ],
    "text": "KNOW YE that by virtue of the powers vested in me by Article 70 of the Constitution of the Democratic SocialistRepublic of Sri Lanka, I, Maithripala Sirisena, President of the Democratic Socialist Republic of Sri Lanka, do by thisProclamation, prorogue Parliament with effect from 12.00 noon on October 27, 2018 and hereby fix 16th day of November,2018 at 10.00 a.m. for the commencement of the next session and summon Parliament to meet in the Chamber ofParliament, Sri Jayawardenapura.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      5.800000190734863,
      10.0
    ]
