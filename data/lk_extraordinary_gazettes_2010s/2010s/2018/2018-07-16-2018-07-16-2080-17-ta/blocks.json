    "text": "\u0bc6\u0ba4\u0ba9\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0bae\u0bcd, \u0bb9\u0bae\u0bcd\u0baa\u0bbe\u0ba8\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0bc8\u0b9f \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0bb9\u0bae\u0bcd\u0baa\u0bbe\u0ba8\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0bc8\u0b9f \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b87\u0bb2. 09 - \u0b9a\u0bbf\u0bb1\u0bbf\u0bc7\u0baa\u0bbe\u1f97\u0bb0 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0b9a\u0bbf\u0bb1\u0bbf\u0bc7\u0baa\u0bbe\u1f97\u0bb0 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3, \u0b87.\u0bc6\u0ba4\u0bbe. \u0bb5\u0bc8\u0bb0\u0baa\u0b9f \u0b87\u0bb2. 4, \u0baa\u0bbf\u0bb1\u0bcd\u0bc7\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0bc8\u0b95 \u0b87\u0bb2. 228, \u0ba4\u0bbe\u0bb3\u0bcd \u0b87\u0bb2. 661 \u0b87\u0bb2\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \u0b883643 \u0b87\u0bb2\u0bcd \u0bb5\u0bbf\u0baa\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 0.0054 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bc6\u0bae\u0bbe\u0ba4\u0bcd\u0ba4 \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u1f99\u0bc8\u0b9f\u0baf \u0b92\u1f9e (01) \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd \u1f90\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd \u0bc7\u0bae\u0bb2\u0ba4\u0bbf\u0b95 \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u1f9e\u0bae\u0bbe\u1fa0: 01. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. \u0b883643 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b9a\u0bbf\u0bb1\u0bbf\u0bc7\u0baa\u0bbe\u1f97\u0bb0 \u0b95\u0bc7\u0bb2; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0ba4\u0bbf; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae 