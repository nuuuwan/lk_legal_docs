    "page_number": 0,
    "bbox": [
      50.64,
      420.79,
      286.41,
      476.92
    ],
    "text": "I hereby give notice under Sub section (1) of Section 07 of the Land Acquisition Act, that the Government intends to acquire the following Lands which are required for a public purpose.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      0.9599039554595947,
      7.91920804977417,
