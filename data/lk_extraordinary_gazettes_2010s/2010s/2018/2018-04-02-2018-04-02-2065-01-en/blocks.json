    "page_number": 0,
    "bbox": [
      47.85,
      399.13,
      539.91,
      446.32
    ],
    "text": "IT is hereby notified that by virtue of powers vested in me under Section 17 of the Customs Ordinance (Chapter 235)I, H. P. Jayananda Acting, Director General of Customs, determine that with effect from 02nd April, 2018, all duties of Customsas well as other charges, penalties and forfeitures incurred under the Customs Ordinance (Chapter 235), shall be paid andreceived at the Rates of Exchange set out in the Schedule.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      453.25,
      539.86,
      488.32
    ],
    "text": "The notification relating to the Rates of Exchange published in Gazette Extraordinary, No. 2064/1 of26th March, 2018 is hereby rescinded and the said Rates of Exchange are Scheduled to be rescinded by a similar notificationto be published on or before 08th April, 2018.",
