0bbf\u1fbf, \u0b87\u0bb2. 421 - \u0ba8\u1fbf\u0bb2\u1fb2\u0b9a\u0bbf\u0baf, 424 - \u0ba4\u1fbb\u0bc6\u0bae\u1fb9\u0ba9\u0bbe\u0b95\u0bae, 425 - \u0bc7\u0b95\u0bbe\u1fb9\u0bc6\u0bb5\u0bb5, 427 - \u0bc6\u0ba4\u1fbf\u0b95\u0bbf\u0bbe\u0bbf\u0baf\u0bbe\u0bb5 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u0bb3\u0bbf\u1f94\u1fc0 \u0ba4\u1fbb\u1f97\u1fa4\u1f97\u0bb0, \u0bc7\u0b95\u0bbe\u1fb9\u0bc6\u0bb5\u0bb5, \u0ba8\u1fbf\u0bb2\u1fb2\u0b9a\u0bbf\u0baf, \u0bb0\u0bbe\u0b9c\u0baa\u1fb0\u0bb8\u0b95\u0bae, \u0ba4\u1fbb\u0bc6\u0bae\u1fb9\u0ba9\u0bbe\u0b95\u0bae, \u0bc6\u0ba4\u1fbf\u0b95\u0bbf\u0bbe\u0bbf\u0baf\u0bbe\u0bb5 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb1\u0b95\u0bb3\u0bbf\u1fbf \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\u1f90\u1fbb 110073 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 01 \u0b87\u1fbf \u0b85\u0b9f\u1fb1\u0b95\u0bbf\u1f9c\u1fc0\u0bb3\u1f90\u0bae\u0bbe\u0ba9 2317, 2318, 2319, 2320, 2321, 2322, 2323, 2324, 2325, 2326, 2327, 2328, 2329, 2330, 2331, 2332, 2333, 2334, 2335, 2336, 2337, 2338, 2339, 2340, 2341, 2342, 2343, 2344, 2345, 2346, 2347, 2348, 2349, 2350, 2351, 2352, 2354, 2355, 2356, 2357, 2358, 2359, 2360, 2361, 2362, 2363, 2364, 2365 \u0bae\u1fbe\u1fa0\u1fbb 2366 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb1\u0b95\u0bc8\u0bb3\u1fb0 \u0bc6\u0b95\u0bbe\u1fb6\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u1fa6\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb7 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b87\u0ba4\u0bc7\u0ba9\u0bbe\u1f8c \u0b87\u0bc8\u0ba3\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf \u0ba4\u0bb0\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b8e\u0ba9\u1f90 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 