    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      341.62,
      539.39,
      459.68
    ],
    "text": "To North : Road (Pradeshiya Sabhawa) To East : Road (Pradesshiya Sabhawa) and Galange Watta Kande Watte or Pamunuva Waththa claimed by J. A. Somarathna. To South : Claimed by J. A. Somarathna Galange Hena or Kande Watte or Pamunuva Waththa To West : Road (Pradeshiya Sabhawa)",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      3.119687795639038,
      4.079591751098633,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      459.91,
      539.48,
      575.11
    ],
    "text": "All Persons interested in the aforesaid land are required to appear personally, or by agents duly authorized in writing at Divisional Secretary\u2019s Office Yatinuwara on the 15th May 2018 at 10.00 a.m. and hereby requested to notify to me in writing (in duplicate) on or before the day of 9th May 2018 the nature of their interests in the land and the perticulars of there claims for compensation for the acquition of the aforesaid land. The amount of compensation and the details of the computation such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      0.9599039554595947,
      4.079591751098633,
      10.078991889953613
    ]
  },
