  {
    "page_number": 0,
    "bbox": [
      50.7,
      387.34,
      539.49,
      684.55
    ],
    "text": "\u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0dd9\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 - \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc5\u0dcf\u0dad 2012 \u0dc0\u0dc3\u0dd9\u0dbb\u0dca \u0d85\u0d82\u0d9a 22 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca (\u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0db1) \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd0\u0da9\u0dd2\u0db8\u0db1\u0dad\u0dca \u0daf\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc5\u0dcf\u0dad\u0dca, \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0dd9\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca\u0dc0\u0dbb\u0dba\u0dcf \u0db8\u0dbb\u0dd2\u0dba\u0daf\u0dcf\u0dc3\u0dca \u0db4\u0dd0\u0da7\u0dd2\u0d9a\u0dca \u0da9\u0dd2\u0dbb\u0d82\u0dc3\u0db1\u0dca \u0dc0\u0db1 \u0db8\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca 2012 \u0dc0\u0dc3\u0dd9\u0dbb\u0dca \u0d85\u0d82\u0d9a 22 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca (\u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0db1) \u0db4\u0db1\u0dd9\u0dad\u0dca 66(\u0d8b) \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dca\u0dad\u0dcf \u0dc0\u0dd6 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0d9a\u0dcf\u0dbb\u0dc0, \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc5\u0dcf\u0dad \u0dad\u0dd4\u0dc5 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dd9\u0da9\u0dbd\u0dca\u0dc6\u0dca \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dd9\u0dc0\u0dc4\u0dd2 \u0d8b\u0db4\u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 \u0dd9\u0dad\u0dca\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8 2018.08.28 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dd9\u0db4\u0dbb\u0dc0\u0dbb\u0dd4 \u0db4\u0dd0\u0dba 10.00\u0da7 \u0dd9\u0da9\u0dbd\u0dca\u0dc6\u0dca \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dd9\u0dc0\u0dca \u0dc3\u0db7\u0dcf \u0db8\u0dab\u0dca\u0da9\u0db4\u0dd9\u0dba\u0dca \u0daf\u0dd3 \u0db1\u0dd0\u0dc0\u0dad\u0dad\u0dca \u0d9a\u0dd0\u0db3\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db6\u0dc0 \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0dd9\u0daf\u0db8\u0dd2. \u0db8\u0dbb\u0dd2\u0dba\u0daf\u0dcf\u0dc3\u0dca \u0db4\u0dd0\u0da7\u0dd2\u0d9a\u0dca \u0da9\u0dd2\u0dbb\u0d82\u0dc3\u0db1\u0dca, \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0dd9\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca, \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc5\u0dcf\u0dad. 2018 \u0d85\u0dd9\u0d9c\u0ddd\u0dc3\u0dca\u0dad\u0dd4 \u0db8\u0dc3 17 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0dc0\u0dd0\u0da9\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dc3\u0d82\u0d9a\u0dd3\u0dbb\u0dca\u0dab\u0dba, A-9 \u0db4\u0dcf\u0dbb, \u0d9a\u0dba\u0dd2\u0dad\u0da9\u0dd2 \u0dba\u0dcf\u0db4\u0db1\u0dd9\u0dba\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2, \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0dd9\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca \u0daf\u0dd3 \u0dba. 08-1040",
