    "bbox": [
      70.08,
      551.76,
      309.9,
      609.83
    ],
    "text": "01. Lot No. 1Name of land: Henawatta; Claimant: H. Neel SirinimalFernando, H. Sirimathi Fernando H. Margret Fernando ofNo. 606, Sinhavila Road, Thudella, Ja-Ela; Extent: 0.0094Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
