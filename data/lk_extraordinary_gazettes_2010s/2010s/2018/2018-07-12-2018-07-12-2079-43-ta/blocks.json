2\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bc8\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bc1 \u0b9a\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0b9f \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0bc8\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0ba8\u0bc1\u0bb0\u0bbe\u0ba4\u0baa\u0bc1\u0bb0\u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0bb0\u0bbe\u0b9c\u0bbe\u0b99\u0bcd\u0bc8\u0ba9\u0baf \u0baa\u0bbf\u0bb0\u0b9a\u0ba4\u0b9a \u0b9a\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b87\u0bb2. 441 - \u0ba8\u0bb5\u0b9a\u0bbf\u0bbe\u0bbf\u0bc8\u0bae \u0bc8\u0bbf\u0bb0\u0bbe\u0bae\u0b9a\u0b9a\u0b95\u0bb5 \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0ba8\u0bb5\u0b9a\u0bbf\u0bbe\u0bbf\u0bc8\u0bae (\u0b85\u0b99\u0bcd\u0bc8\u0bae\u0bc1\u0bb5) \u0bc8\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0b95\u0bae\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0bae\u0bcd 110796 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bc8 \u0bc8\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bb2\u0bcd \u0b85\u0bb3\u0b95\u0bb5 \u0bb5\u0b95\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc1 \u0b87\u0bb2. 02 \u0b87\u0bb2\u0bcd \u0b85\u0b9f\u0b99\u0bcd\u0bc8\u0bbf\u0baf\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0bae\u0bbe\u0ba9 1, 3, 9, 10, 11, 12, 13, 16, 19, 20, 21, 27, 28, 34, 35, 37, 39, 41, 42, 43, 44, 47, 49, 50, 55, 59, 60, 62, 63, 67, 68, 70, 71, 72, 78, 81, 82, 83, 92, 95, 98 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 102 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bc8\u0b99\u0bcd\u0bc8\u0b95\u0bb3\u0b95\u0bcd \u0b9a\u0bc8\u0bbe\u0ba3\u0bcd\u0b9f \u0bc8\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0bc8\u0bb3\u0bc1\u0b95\u0bcd\u0bc8\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0ba4\u0bcd \u0b9a\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0bc8 \