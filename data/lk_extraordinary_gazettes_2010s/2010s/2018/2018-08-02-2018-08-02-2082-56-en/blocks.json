      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.2,
      612.36,
      295.32,
      684.56
    ],
    "text": "Lot No. 01Name of Land: Usliyanage Watta, Usliyanage Maha Watta,Madangahawatta; Description: Road and Garden; Claiments:Government; Previous Claimant: Sadik Marikkar HasanMarikkar and others, \"Riwer side\" Dhargha Town, Aluthgama;Extent: 0.1850 Hectare.",
