      92.49,
      664.69,
      440.85,
      699.76
    ],
    "text": "iii.Any other imported Foreign200.0022.08Liquor (which does not comeunder i or ii above)",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
