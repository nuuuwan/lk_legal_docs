    "text": "\u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u02a3\u0dd9\u0dbb\u02a3\u01ae\u01b1\u0dc0\u0db1 \u0d89\u0da9\u023c\u0dc0\u0dbd \u026a\u0dc3\u0dca\u0dad\u0dbb : \u0d8c\u0dc0 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0db6\u01d0\u0262\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0dc0\u0dd0\u0263\u0db8\u0da9 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0daf\u0db9\u026a\u01e6\u0db1 \u0db4\u0dc5\u0dcf\u0dad \u0dd9\u0d9a\u02a3\u0dbb\u0dd9\u0dc5\u02a2 \u0288\u029a \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u023e\u0dbb\u0dc4\u0dc0\u01ae\u0dad \u0d9c\u0dd9\u023c \u0db8\u0dd0\u01e9\u023c\u0db4\u01af \u026a\u0286\u01e6 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb \u0d87\u01af \u0d85.\u0d9c.\u0218. 63 \u0db4\u01b4\u0dd9\u024f \u0d85\u0d82\u0d9a 19, \u0d85\u01af\u0dd9\u0259\u0d9a \u0d85\u0d82\u0d9a 12 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0263 \u0dc3\u0db3\u0dc4\u0dcf \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf 2017. 10. 27 \u01ce\u0db1\u0dd0\u01af \u0d85\u0dc0\u0dc3\u0dcf\u0db1 \u0d9c\u023c \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 537 \u0286\u0da7 552 \u0daf\u00fa\u0dc0\u0dcf \u0dd9\u0db4\u01e6\u01e9\u023c \u0dd9\u0d9a\u0dd9\u0dbb\u0db1 \u023f\u029a \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 1.9147 \u00fa \u026d \u0db4\u0dc4\u0dad \u026a\u0dc3\u0dca\u0dad\u0dbb \u0dd9\u0d9a\u0dd9\u0dbb\u0db1 \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0263;",
