    ],
    "text": "MANGALA SAMARAWEERA,Minister of Finance and Mass Media.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      7.0,
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      439.69,
      131.14,
      462.76
    ],
    "text": "Colombo,31st December, 2018.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      269.49,
      472.09,
      318.22,
      483.16
    ],
    "text": "Regulations",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      492.49,
      539.98,
      527.56
    ],
    "text": "The Insurance Regulatory Commission Regulations, 2005 published in Gazette Extraordinary No. 1414/19 of October12, 2005 as amended, from time to time, are hereby further amended by the repeal of regulation 3 thereof and the substitutiontherefor of the following :-",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      83.85,
      536.89,
      470.84,
      547.96
    ],
    "text": "\"3. An insurer shall pay to the Insurance Regulatory Commission of Sri Lanka as an annual fee :-",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      91.29,
      557.29,
      431.87,
      568.36
    ],
    "text": "(a) a sum of rupees One Hundred Thousand for the first calendar year of operation :",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      107.85,
      577.69,
      539.88,
      612.76
    ],
    "text": "Provided that, any insurer who is required to comply with section 53 of the Regulation of Insurance Industry(Amendment) Act, No. 3 of 2011 shall pay to the Insurance Regulatory Commission of Sri Lanka as an annualfee 0.125% of the gross written premium for the first calender year of operation ; and",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      90.57,
      622.09,
      449.15,
      633.16
    ],
    "text": "(b) from and after the date of commencement of the second calendar year of operation :\u2013",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      117.57,
      642.49,
      439.29,
      653.56
    ],
    "text": "(i) a sum of rupees two hundred thousand in respect of insurance business ; or",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      115.29,
      662.89,
      495.57,
      673.96
    ],
    "text": "(ii) 0.125% of the gross written premium of insurance business of the preceding financial year,",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      107.85,
      683.29,
      230.88,
      694.36
    ],
    "text": "Whichever amount is higher.\u201d.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
