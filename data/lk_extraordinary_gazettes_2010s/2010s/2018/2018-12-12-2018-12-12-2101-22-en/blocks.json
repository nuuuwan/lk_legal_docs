    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      307.2,
      389.64,
      547.23,
      447.68
    ],
    "text": "Lot No. 02Name of the Land: Meegastenna watta; Original Ownership:Pussallawa Plantation Limited, 590, Galle Road, Colombo 03;Land Reform Commission No. 475, Kaduwela Road,Battaramulla, Present Claimant-State; Extent: 3.2196 Hectares.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      307.2,
      464.0,
      547.55,
      570.08
    ],
    "text": "All persons interested in the aforesaid lands are herebyrequired to appear personally or by agents duly authorized inwriting before me at Divisional Secretariat, Kuruwita on21.01.2019 at 09.00 a.m. and are hereby requred to notify me inwriting (in duplicate) on or before the 10.01.2019 the nature oftheir interest in the land, the particulars of their claims forcompensation for the acquisition of the said land, the amountof compensation, the details of the computation of suchamount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
