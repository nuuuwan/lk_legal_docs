    "bbox": [
      50.88,
      582.8,
      286.68,
      615.92
    ],
    "text": "01. Lot No. 1037 Name of the Land: Pimburawatta, Dippitawatta; Description: Garden; Claimant: State; Original Claimant:",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
