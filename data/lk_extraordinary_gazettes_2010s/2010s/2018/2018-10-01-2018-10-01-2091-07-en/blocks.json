    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.56,
      383.6,
      544.7,
      508.64
    ],
    "text": "All persons interested in the aforesaid Land/Lands* on which a servitude is to be acquired are hereby required to appear personally, or by agents duly authorized in writing, before me at Matugama Divisional Secretariat on the 14th day of November at 10.00 a. m. Clock and are hereby requested to notify to me in writing (in duplicate) on or before 01st day of November the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land/servitude* the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
