    ],
    "text": "Reference No. of Ministry of Lands andParliamentary Reforms : 4-3/9/2015/WS/29.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
