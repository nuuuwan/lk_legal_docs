    "text": "\u0db8\u0db0\u0255\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0db8\u0dcf\u0dad\u0dd9\u0262 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0dbd\u0118\u0d9c\u0dbd \u0db4\u0262\u0dd9\u0262\u0d9c\u0db8 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0dbd\u0118\u0d9c\u0dbd \u0db4\u0262\u0dd9\u0262\u0286\u0dba \u0db4\u01ae\u01b1\u0dd9\u0269, E 389 \u0dbb\u0249\u00fa\u0d94\u029a\u0dc0 \u0dc0\u0dc3\u0dd9\u023c \u0218\u028f\u0179, \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 2018.11.14 \u01ce\u0db1 \u0dc3\u023c\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf, \u0237\u0dbd\u00fa\u0dc2\u0dab\u0dcf\u01ae\u0db8\u0d9a \u0240\u0263\u0d9a \u0218\u0249\u025e \u0d85\u0d82\u0d9a 13 \u028f, \u0d85\u01af\u0dd9\u0259\u0d9a \u0d85\u0d82\u0d9a 98 \u028f, \u0db4\u01b4 \u0d85\u0d82\u0d9a 249 \u0daf\u0dbb\u0db1 \u0dc3\u0dd0\u0dc5\u0dd0\u0dc3\u0dca\u0dd9\u023c, \u022a\u023c \u021d\u0db8\u0dcf\u0dab\u0dba \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.1723 \u00fa \u0dc0\u0db1 \u0db4\u0dc4\u0dad \u026a\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0db3\u0dc4\u01e6 \u0d89\u0da9\u0db8:",
