    "bbox": [
      56.4,
      645.36,
      535.32,
      655.43
    ],
    "text": "0.01% of the contract value of the relevant project.In case of change in scope and subsequent increase of contract",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      290.4,
      657.36,
      548.66,
      691.43
    ],
    "text": "value-0.01% of the additional value incurring due to variation ofthe contract value of the relevant project. (Renewal fee shall not beapplicable where there is no variation of the contract value).",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
