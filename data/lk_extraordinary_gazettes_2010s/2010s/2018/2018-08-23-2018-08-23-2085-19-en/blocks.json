      70.07
    ],
    "text": "PART 1: SEC. (1) - GAZETTE EXTRAORDINARY OF THE DEMOCRATIC SOCIALIST REPUBLIC OF SRI LANKA - 23.08.2018",
    "fonts": [
      "TimesNewRomanPSMT"
