    "text": "\u0db6\u01d0\u0262\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0dc0\u0dd0\u0263\u0db8\u0da9 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d85\u0d82\u0d9a 49D, \u0d85\u0dbd\u0dd9\u0d9a\u02a3\u0dbd\u0d9c\u0dcf\u0dbd \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025d \u0dc0\u0dc3\u0dd9\u023c \u0dc0\u0259\u0269\u00fa\u0dc0\u01ae\u0dad \u0d85\u0dd9\u0246\u0dd9\u0dc0\u0dbd \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc0\u0259\u0269\u00fa\u0dc0\u01ae\u0dad \u0d86\u0dd9\u0246\u0dd9\u0dc0\u0dbd \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u0db1\u0db8\u0dd0\u01af \u0d89\u0da9\u0dd9\u0db8\u01e6 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u025f\u018a 2\u00fa \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0db8\u0dcf\u0250\u023c \u01b1\u0dc5 \u026d \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3",
