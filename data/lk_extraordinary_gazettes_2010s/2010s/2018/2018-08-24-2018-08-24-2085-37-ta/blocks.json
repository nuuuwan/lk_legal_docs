    "text": "14 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0bc8\u0bc0\u0bb4\u0bcd \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba8\u0bbf\u0bb0\u0bcd\u0ba3\u0baf \u0b86\u0b95\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u0ba9\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0ba4\u0bcd\u0b95\u0ba4 \u0bb5\u0bb5\u0bb3\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b9a\u0bae\u0b9a\u0bb2\u0baf\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba4\u0b95\u0bb2\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bcd \u0bc8\u0bc0\u0bb4\u0bcd 2014.01.06 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf\u0baf 1844/38 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bc8 \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8 \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0bc8 \u0b9a\u0b9a\u0bbe\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bb0\u0b9a\u0bbf\u0ba9\u0bcd \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0b9a\u0b9a\u0b9f \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0bc1\u0bb0\u0bae\u0bbe\u0ba9 \u0bb5\u0ba4\u0ba9\u0bcd \u0bae\u0bbe\u0bc8\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0bc8\u0bbe\u0bb2\u0bbf \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0ba9\u0bae\u0bc1\u0bae\u0bcd \u0b9a\u0bc2\u0bb4\u0bb2\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0b9a\u0ba4\u0b9a \u0bb5\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd 101 \u0baa\u0bc0- \u0bae\u0bbf\u0bb2\u0bbf\u0ba8\u0bcd\u0ba4\u0bc2\u0bb5 \u0bc8\u0bbf\u0bb0\u0bbe\u0bae \u0b9a\u0b9a\u0b95\u0bb5 \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0bae\u0bbf\u0bb2\u0bbf\u0ba8\u0bcd\u0ba4\u0bc2\u0bb5 \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bc8\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, 810018 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bc8 \u0bc8\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bb2\u0bcd \u0b85\u0bb3\u0b95\u0bb5 \u0bb5\u0b95\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bc1 \u0b87\u0bb2. 03 \u0b87\u0bb2\u0bcd 210 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bc8 \u0bc8\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0bb5\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0bc8 \u0b85\u0bb5\u0bcd\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0b95\u0ba3\u0baf\u0bbf\u0bb2\u0bcd, \u201c\u0bb5\u0b9a\u0bbe\u0ba8\u0bcd\u0ba4\u0b95\u0bcd\u0bc8\u0bbe\u0bb0\u0bb0\u0bcd/\u0bb5\u0b9a\u0bbe\u0ba8\u0bcd\u0ba4\u0b95\u0bcd\u0bc8\u0bbe\u0bb0\u0bb0\u0bcd\u0bc8\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u0baa\u0baf\u0bb0\u0bcd\u0bc8\u0bb3\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0bc8\u0bb5\u0bbe\u0bbf\u0baf\u0bc1\u0bae\u0bcd\u201d \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u201c\u0b9a\u0ba4\u0b9a\u0bbf\u0baf \u0b85\u0b95\u0b9f\u0baf\u0bbe\u0bb3 \u0b85\u0b9f\u0bcd\u0b95\u0b9f \u0b87\u0bb2.\u201d \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bb0\u0bb2\u0bcd\u0bc8\u0bb3\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0b9f\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba4\u0bc8\u0bb5\u0bb2\u0bcd\u0bc8\u0bb3\u0bcd \u0ba8\u0bc0\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u201c\u0bae\u0bc1\u0bb9\u0bae\u0bcd\u0bae\u0ba4\u0bbf \u0baa\u0bcd\u0bb0\u0bbe\u0bb9\u0bbf\u0bae\u0bcd \u0bb0\u0baf\u0bc0\u0bb7\u0bbe \u0bb9\u0bae\u0bcd\u0b9a\u0ba4\u0bcd\u201d, \u201c\u0b87\u0bb2. 35/13 \u0b88, \u0bc8\u0ba9\u0bae\u0bcd\u0baa\u0bbf\u0b9f\u0bbf\u0baf \u0bb5\u0bc0\u0ba4\u0bbf, \u0bc8\u0bbe\u0bb2\u0bbf\u201d\u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u201c876591413v \u201d \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b89\u0bb3\u0bcd\u0bb3\u0b9f\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bb2\u0bcd \u0b9a\u0bb5\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.",
