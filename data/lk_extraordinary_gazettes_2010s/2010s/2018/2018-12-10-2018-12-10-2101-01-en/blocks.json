      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      453.25,
      539.87,
      488.32
    ],
    "text": "The notification relating to the Rates of Exchange published in Gazette Extraordinary, No. 2100/1 of 03rd December,2018 is hereby rescinded and the said Rates of Exchange are Scheduled to be rescinded by a similar notification to bepublished on or before 16th December, 2018.",
