    "text": "\u0dd9\u0db8\u0db8 \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0263 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c \u00fb\u0dba\u0db1 \u0286\u0dba\u0265 \u0dd9\u0daf\u0db1\u0dcf\u0db8 \u0dad\u0db8\u01e6\u0dd9\u0118 \u0db1\u023c \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5\u026b \u0d87\u0dad\u01ae, \u0db1\u0dd0\u0dad\u01ae \u0d91\u0db8 \u0d89\u0da9\u023c \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0dad\u0db8\u01e6\u0da7 \u0d87\u01af \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c, \u0d91\u00fa \u0d91\u00fa \u022a\u023c \u0d9a\u0dd0\u0db6\u0dd0\u0262\u0dbd \u0dd9\u0dc0\u01e9\u0dd9\u0dc0\u01e6 \u0dd9\u0dc0\u0db1 \u0dd9\u0dc0\u0db1\u0db8, \u0218\u0da7\u0db4\u01ae \u0dd9\u0daf\u0d9a\u00fb\u01e6 \u0252\u01ae \u0263\u0dba\u026a\u0262\u0dbd\u00fb\u01e6 \u0d91\u0db8 \u0d89\u0da9\u023c\u0dc0\u0dbd\u0da7 \u0d87\u01af \u0dc3\u0dca\u0dc0\u00fc\u0dba \u0d85\u0250\u01af\u0dd9\u024f \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba, \u0d91\u0db8 \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0263\u0dc0\u0dbd \u0d85\u0250\u01af\u0dba \u0dd9\u0dc0\u01e9\u0dd9\u0dc0\u01e6 \u0dad\u0db8\u01e6\u0da7 \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dc5 \u0dc4\u0dd0\u00fb \u0d9a\u025e\u019f \u0218\u0298\u0db6\u0db3 \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba\u00fa 2018.09.10 \u01ce\u0db1 \u0db8\u0dd9\u0118 \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dd9\u024f \u01cf \u0db8\u0dcf \u0dc4\u023f\u026b \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u0db1 \u0dd9\u0dbd\u0dc3 \u0dd9\u0db8\u0250\u01e6 \u0daf\u0dd0\u01e9\u023c \u0dd9\u0daf\u01e9 \u0dbd\u0dd0\u0dd9\u0229.",
