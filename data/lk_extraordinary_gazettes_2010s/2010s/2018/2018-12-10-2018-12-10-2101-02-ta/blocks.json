    ],
    "text": "\u0b9a\u0bae\u1fbd\u1fba\u0baa\u0bbf\u1fb7\u0ba4\u1fbf \u0bc7\u0bb5\u1fb6\u1f8c\u0bc6\u0bae\u1fb9\u1fa0 \u0b87\u1fb7\u0ba4\u0bbe\u1fbf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb0\u0b95\u1fba\u0baa\u1f8c\u0b95\u0bbf\u1fb9\u0bb1\u1f90. \u0bc7\u0bae\u1fbe\u1f82\u0bb1\u1fba\u0baa\u1fb5\u0b9f \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u1fb0\u1f81 \u1f99\u1fb9\u0ba9\u1fbd \u0b8f\u0bc7\u0ba4\u1f94\u1fbb \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0 \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0bc8\u0baf\u1fb2 \u0b9a\u0bae\u1fbd\u0baa\u0bbf\u1fb0\u0b95\u1fb7 \u0ba4\u0bb5\u1fa0\u0b95\u0bbf\u1fb9\u0bb1 \u0b8f\u0bc7\u0ba4\u1f94\u1fbb \u0b9a\u1fb8\u0ba4\u1fbd\u1fba\u0baa\u1fb7\u0ba4\u0bbf\u1fbf, \u0b95\u0bbe\u0ba3\u0bbf\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u1fb7\u0bc8\u0ba4\u1fb7 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u0bbf\u1fba\u0baa\u0ba4\u1fbe\u1f81 \u0bae\u1fa0\u0b95\u1fb5\u0b9a\u0bbf\u0baf\u0bbf\u1fbf\u0bb2\u0bbe\u0ba4 \u0bb5\u0bbf\u0b9a\u0bbe\u0bb0\u0bc8\u0ba3\u0bc8\u0baf \u0ba8\u0b9f\u0bbe\u1fb7\u1f90\u0bb5\u0ba4\u1fbe\u1f81\u1fbb, \u0b85\u0ba4\u1fbe\u0b95\u0bbf\u0ba3\u1fb1\u0b95 \u0bc7\u0bae\u0bc7\u0bb2\u1f9c\u1fc0\u0bb3 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 14\u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u1fb9 \u0baa\u1f8a \u0b85\u0bb0\u0b9a\u0bbe\u1fb1\u0b95 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u1fbf \u0b85\u1fb7\u0ba4\u0bc8\u0b95\u0baf \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u1f8c\u0bb5\u0ba4\u1fbe\u1f81\u1fbb \u0ba8\u0b9f\u0bb5\u1f8a\u1fb0\u0bc8\u0b95 \u0b8e\u1f8c\u1fb0\u0b95\u1fba\u0baa\u1f8c\u1fbb. \u0bc7\u0bae\u0bc7\u0bb2 \u1f81\u0bb1\u0bbf\u1fba\u1f96\u1f8c \u0bc6\u0b9a\u1fbc\u0baf\u1fba\u0baa\u1fb5\u0b9f 420582 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u1faa\u1f8c \u0b9a\u0bbe\u1fbd\u1fb8\u0ba4 \u0baa\u0b9f\u1fbb \u0b87\u0bc8\u0baf\u0baa\u0bbe\u0ba9 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bbf\u1fb9 \u0b85\u1fa4\u0bb5\u0bb2\u0b95\u1fb7\u0ba4\u0bbf\u1fbf, \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0b95\u1fb7\u0ba4\u0bbf\u1fbf, \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u0b95\u1fb7\u0ba4\u0bbf\u1fbf, \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1f9e\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd \u0b85\u1fa4\u0bb5\u0bb2\u0b95\u1fb7\u0ba4\u0bbf\u1fbf, \u0b85\u1fbf\u0bb2\u1f90 \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u1fbd \u0ba4\u0bc8\u0bb2\u0bc8\u0bae\u0baf\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0baf\u0bbf\u1fb9 \u0b85\u1fa4\u0bb5\u0bb2\u0b95\u1fb7\u0ba4\u0bbf\u1fbf \u1f92\u0ba9\u0bbf\u1fb7\u0ba4\u0bbe\u0bb0\u0bbe\u0baf\u1fba\u0baa\u0b9f\u0bb2\u0bbe\u1fbb. \u0bc7\u0bae\u0bb2\u0ba4\u0bbf\u0b95 \u0ba4\u0b95\u0bb5\u1fbf , \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bbf\u0b9f\u0bae\u0bbf\u1f9e\u1fb8\u1f90, \u0b85\u1fbf\u0bb2\u1f90 \u0b95\u0bbe\u0ba3\u0bbf \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1f9e\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u0b9f\u0bae\u0bbf\u1f9e\u1fb8\u1f90 \u0bc6\u0baa\u1fbe\u1fa0\u1fb0\u0bc6\u0b95\u0bbe\u1fc0\u0bb3\u1fba\u0baa\u0b9f\u0bb2\u0bbe\u1fbb. \u0bc7\u0b95.\u0b8f.\u0bc7\u0b95. \u0bb0\u1fb4\u0b9a\u0bbf\u1fb7 \u0ba4\u1fbd\u0bae\u0baa\u0bbe\u0bb2 , \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u1fbd.",
