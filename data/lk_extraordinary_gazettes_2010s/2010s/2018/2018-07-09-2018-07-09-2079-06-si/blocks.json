    "text": "01. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 01 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0118\u0dbd\u0dcf\u0dc3\u0262 \u0dc0\u01ae\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c\u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dbd\u0dbd\u0dcf\u01e6 \u0dbb\u0db6\u0259 (\u021a\u01ca\u0d9c\u0263\u0d9a) \u0dc3\u0db8\u0dcf\u0d9c\u0db8, \u0d85\u0d82\u0d9a 54, \u00fb\u025e\u0dbd\u0db4\u0db1 \u0d87\u0dc0\u01e7\u0269, \u0dd9\u0d9a\u02a3\u0dc5\u0db9 06; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.7175. 02. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 02 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0118\u0dbd\u0dcf\u0dc3\u0262 \u0dc0\u01ae\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c\u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dbd\u0dbd\u0dcf\u01e6 \u0dbb\u0db6\u0259 (\u021a\u01ca\u0d9c\u0263\u0d9a) \u0dc3\u0db8\u0dcf\u0d9c\u0db8, \u0d85\u0d82\u0d9a 54, \u00fb\u025e\u0dc5\u0db4\u0db1 \u0d87\u0dc0\u01e7\u0269, \u0dd9\u0d9a\u02a3\u0dc5\u0db9 06; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0980. 03. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 03 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dc3\u0db3\u0dc4\u01e6 \u0dd9\u0db1\u02a3\u0dd9\u0269; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dbd\u0dbd\u0dcf\u01e6 \u0dbb\u0db6\u0259 (\u021a\u01ca\u0d9c\u0263\u0d9a) \u0dc3\u0db8\u0dcf\u0d9c\u0db8, \u0d85\u0d82\u0d9a 54, \u00fb\u025e\u0dc5\u0db4\u0db1 \u0d87\u0dc0\u01e7\u0269, \u0dd9\u0d9a\u02a3\u0dc5\u0db9 06; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0253. 04. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 04 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0118\u0dbd\u0dcf\u0dc3\u0262 \u0dc0\u01ae\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dbd\u0dbd\u0dcf\u01e6 \u0dbb\u0db6\u0259 (\u021a\u01ca\u0d9c\u0263\u0d9a) \u0dc3\u0db8\u0dcf\u0d9c\u0db8, \u0d85\u0d82\u0d9a 54, \u00fb\u025e\u0dc5\u0db4\u0db1 \u0d87\u0dc0\u01e7\u0269, \u0dd9\u0d9a\u02a3\u0dc5\u0db9 06; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0428. 05. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 05 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dc3\u0db3\u0dc4\u01e6 \u0dd9\u0db1\u02a3\u0dd9\u0269; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dbd\u0dbd\u0dcf\u01e6 \u0dbb\u0db6\u0259 (\u021a\u01ca\u0d9c\u0263\u0d9a) \u0dc3\u0db8\u0dcf\u0d9c\u0db8, \u0d85\u0d82\u0d9a 54, \u00fb\u025e\u0dc5\u0db4\u0db1 \u0d87\u0dc0\u01e7\u0269, \u0dd9\u0d9a\u02a3\u0dc5\u0db9 06; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0954. 06. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 06 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0118\u0dbd\u0dcf\u0dc3\u0262 \u0dc0\u01ae\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dbd\u0dbd\u0dcf\u01e6 \u0dbb\u0db6\u0259 (\u021a\u01ca\u0d9c\u0263\u0d9a) \u0dc3\u0db8\u0dcf\u0d9c\u0db8, \u0d85\u0d82\u0d9a 54, \u00fb\u025e\u0dc5\u0db4\u0db1 \u0d87\u0dc0\u01e7\u0269, \u0dd9\u0d9a\u02a3\u0dc5\u0db9 06; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.8010. 07. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 07 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0118\u0dbd\u0dcf\u0dc3\u0262 \u0dc0\u01ae\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf: \u0dbd\u0dbd\u0dcf\u01e6 \u0dbb\u0db6\u0259 (\u021a\u01ca\u0d9c\u0263\u0d9a) \u0dc3\u0db8\u0dcf\u0d9c\u0db8, \u0d85\u0d82\u0d9a 54, \u00fb\u025e\u0dc5\u0db4\u0db1 \u0d87\u0dc0\u01e7\u0269, \u0dd9\u0d9a\u02a3\u0dc5\u0db9 06; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0326. \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0d89\u0da9\u0db8\u0da7/\u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0dba\u0da7 \u028f\u023d\u0d9a\u023c, \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u0dc3\u023c\u0db6\u01e6\u0db0\u0d9a\u023c \u00fb\u0dba\u0dcf \u0286\u0179\u0db1 \u0286\u0dba\u0265\u0dd9\u0daf\u0db1\u0dcf\u0db8 \u0dad\u0db8 \u0dad\u0db8\u01e6 \u0dd9\u0dc4\u02a4 \u0d94\u026c\u01e6\u0dd9\u0d9c\u01e6 \u0263\u0dba\u026a\u0263\u0dc0\u0263\u01e6 \u0db6\u0dbd\u0dba\u0dbd\u01ae \u0d85\u0dba\u0dc0\u029a\u01e6 \u0dd9\u0dc4\u02a4 2018 \u0d85\u0dd9\u0d9c\u02a4\u0dc3\u0dca\u01b1 \u0db8\u0dc3 15 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0dd9\u0db4.\u0dc0. 10.00 \u0da7 \u0dd9\u0daf\u028f\u0d95\u026a\u0da7 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dd9\u024f \u01cf \u0db8\u0dcf \u0dc3\u023c\u023f\u0d9b \u026a\u0dba \u0252\u01b1\u0dba. \u0dad\u0dc0 \u0daf, 2018 \u0d85\u0dd9\u0d9c\u02a4\u0dc3\u0dca\u01b1 \u0db8\u0dc3 09 \u0dc0\u0dd0\u01e7 \u01ce\u0db1\u0da7 \u0db8\u01ae\u0dd9\u0dad\u01e6 \u0d92 \u0d89\u0da9\u0db8/\u0d89\u0da9\u023c \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d94\u026c\u01e6\u0dd9\u0118 \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c\u0dc0\u0dbd \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba\u01ae \u0d91\u00fc \u0d89\u0da9\u0db8 /\u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0dba\u0da7 \u0dbd\u0db6\u0dcf\u0d9c\u0dd0\u01e8\u0db8 \u0d9c\u0dd0\u0db1 \u0dc0\u01e6\u01ce \u0d89\u0262\u0264\u0db8\u0da7 \u0d87\u01af \u0d9a\u025e\u019f \u0218\u0298\u0db6\u0db3 \u026a\u0dc3\u0dca\u0dad\u0dbb\u01ae, \u0dc0\u01e6\u01ce \u023f\u0daf\u0dbd \u0dc4\u0dcf \u0d92 \u023f\u0daf\u0dbd \u0d9c\u0dab\u01e6 \u0db6\u0dd0\u0265\u0dc4\u0dd0\u0179\u01ae \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0218\u0da7\u0db4\u01ae \u0dd9\u0daf\u0d9a\u00fa \u0dc3\u028f\u0dad \u026c \u0263\u0dba\u026a\u0262\u0dbd\u00fb\u01e6 \u0daf\u0dd0\u01e9\u023c \u01ce\u0dba \u0252\u01b1\u0250. \u0253. \u0219. \u0da0\u01e6\u0daf\u0db1 \u0d85\u01e9\u025e\u01ca\u0db0 \u0218\u0dba\u0daf\u0dcf\u0dc3, \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c/\u0d89\u0da9\u023c \u0d85\u01ae\u0db4\u01ae \u0d9a\u0dbb\u0d9c\u0dd0\u01e8\u0dd9\u023c \u01e7\u0dbd\u0db0\u0dcf\u025c, \u0dd9\u0daf\u028f\u0d95\u026a\u0da7. 2018 \u0151\u01e7 \u0db8\u0dc3 29 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0dd9\u0daf\u028f\u0d95\u026a\u0da7 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dd9\u024f \u01cf \u0dba. 07-769",
