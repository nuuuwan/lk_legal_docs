  {
    "page_number": 0,
    "bbox": [
      50.88,
      620.0,
      286.52,
      741.2
    ],
    "text": "\u0d8c\u0dc0 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0db6\u01d0\u0262\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0db6\u01d0\u0262\u0dbd \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u025c\u0dbd \u0dca\u0dd9\u0db4\u02a3\u0dbd \u0dd9\u0d9a\u02a4\u0dbb\u0dd9\u0dc5\u02a2 \u0288\u0265 \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf \u0dc3\u0dd9\u024f, \u0db6\u01d0\u0262\u0dbd \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb (78\u022b) \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d9a\u0dd0\u0db3\u0dbd\u0d9c\u0db8, \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3 \u0d85\u0d82\u0d9a 10 - \u0db6\u01d0\u0262\u0dbd \u0db8\u0db0\u0255\u0db8, (\u0db6\u01d0\u0262\u0dbd \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0287\u0db8\u0dcf\u0dc0 \u01b1\u0dbd) \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u0dd9\u0dc0\u01e9\u0dc0\u0da7 \u0db6\u01d0\u0262\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa \u0dd9\u0da2\u0255\u0dc2\u0dca\u0da8 \u023d\u01e7\u01e6\u0dd9\u0daf\u02a4\u025e \u0d85\u01dd\u0d9a\u0dcf\u025c \u026a\u0286\u01e6 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf, \u0d85\u0d82\u0d9a \u0db6. 508 \u0dc4\u0dcf 1999.10.27 \u01ce\u0db1\u0dd0\u01af \u0240\u0263\u0d9a \u0218\u0249\u0dbb \u0dc3\u0dc4 2018.08.24 \u01ce\u0db1\u0dd0\u01af \u0240\u0263\u0d9a \u0218\u0249\u025e \u0d85\u0d82\u0d9a \u0db6. 508 \u0da7 \u0d85\u0daf\u0dcf\u0dbd \u0db4\u025c\u021b\u0dbb\u0d9a \u0d89\u0da9\u023c \u026a\u0dc3\u0dca\u0dad\u0dbb \u0dbd\u0dd0\u0250\u0dc3\u0dca\u01b1\u0dc0 \u0d85\u01e9\u0dc0 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0dbb 0.0119 \u00fa \u026d \u021d\u0db8\u0dcf\u0dab\u0dba\u0da7 \u0db4\u0dc4\u0dad \u026a\u0dc3\u0dca\u0dad\u0dbb \u0dc3\u0db3\u0dc4\u01e6 \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0dd0\u0262\u0dbd \u0dc4\u0dcf \u0db8\u0dcf\u0250\u023c \u0d87\u01b1\u0dc5\u01ae \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba - 01",
