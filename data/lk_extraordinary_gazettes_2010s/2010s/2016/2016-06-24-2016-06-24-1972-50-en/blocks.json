    ],
    "text": "The Uva Provincial Council Co-operative Employees Commission Statute No. 04 of 2010",
    "fonts": [
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      342.61,
      539.95,
      401.68
    ],
    "text": "BY virtue of powers vested in me by Sections 23 and 28 of the Uva Provincial Council Cooperative Employees CommissionStatute No. 04 of 2010, I, Senthil Thondaman, Minister of Road Development, Housing, Water Supply, Estate Infrastructureand Cooperative, Uva Provincial Council hereby notify that approval was granted to amend the Section 34 of Regulationsmade under Cooperative Employees Commission Statute No. 04 of 2010 and published in Extraordinary GazetteNo. 1826/24 on 04th September 2013 as follows. This amendment shall come into effect from 01st June 2016.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      388.05,
      414.61,
      517.67,
      437.68
    ],
    "text": "SENTHIL THONDAMAN,Minister of Road Development,",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      7.0,
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      375.69,
      438.61,
      529.92,
      461.68
    ],
    "text": "Housing, Water Supply,Estate Infrastructure and Cooperative.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      474.61,
      258.45,
      521.68
    ],
    "text": "At the Office of Uva Provincial Road Development,Housing, Water Supply, Estate Infrastuctureand Co-operative Ministry,01st June 2016.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
