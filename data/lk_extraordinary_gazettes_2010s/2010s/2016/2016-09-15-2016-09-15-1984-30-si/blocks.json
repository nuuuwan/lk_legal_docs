    "text": "\u0da9\u0db6\u0dca. \u0d91\u0dc3\u0dca. \u0dc3\u0dad\u0dca\u200d\u0dba\u0dcf\u0db1\u0db1\u0dca\u0daf \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca, \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba, \u0d9a\u0da9\u0dc0\u0dad\u0dca \u0dc3\u0dad\u0dbb - \u0d9c\u0dcf\u0dbd\u0dca\u0dbd. 09-1100",
