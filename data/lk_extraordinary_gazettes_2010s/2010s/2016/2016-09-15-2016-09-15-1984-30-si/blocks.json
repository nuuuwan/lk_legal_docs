    ],
    "text": "8. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 173 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad, \u0db8\u0dd2\u0dc1 \u0dc0\u0d9c\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dad; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dcf\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a, \u0d9c\u0dcf\u0dbd\u0dca\u0dbd, \u0db8\u0d9a\u0dd4\u0dc5\u0dd4\u0dc0, \u0dc3\u0dbb\u0dca\u0d9a\u0dd2\u0dba\u0dd4\u0dbd\u0dbb\u0dca \u0db4\u0dcf\u0dbb, \u0d9a\u0daf\u0dca\u0daf\u0dd4\u0dc0 \u0dc4\u0d9a\u0dca\u0db8\u0db1\u0dd9\u0d9c\u0dca \u0dc3\u0dd3\u0dad\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.0213 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0dd9\u0dc0\u0dca. 9. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 175 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad, \u0db8\u0dd2\u0dc1 \u0dc0\u0d9c\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dad; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dcf\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a, \u0d9c\u0dcf\u0dbd\u0dca\u0dbd, \u0db8\u0d9a\u0dd4\u0dc5\u0dd4\u0dc0, \u0dc3\u0dbb\u0dca\u0d9a\u0dd2\u0dba\u0dd4\u0dbd\u0dbb\u0dca \u0db4\u0dcf\u0dbb, \u0dc4\u0db4\u0dca\u0db4\u0dcf\u0dc0\u0db1 \u0dc0\u0dd2\u0dad\u0dcf\u0db1\u0dd9\u0d9c\u0dca \u0dc3\u0dd2\u0dbb\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2 ; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.0072 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0dd9\u0dc0\u0dca. 10. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 176 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0da2\u0dba\u0dc3\u0dd4\u0db1\u0dca\u0daf\u0dbb \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad \u0dd9\u0dc4\u0dc0\u0dad\u0dca \u0da2\u0dba\u0dc3\u0dd4\u0db1\u0dca\u0daf\u0dbb \u0db8\u0dd4\u0daf\u0dbd\u0dd2\u0dba\u0dcf\u0dbb\u0dca \u0dd9\u0dad\u0ddd\u0da7\u0dca\u0da7\u0db8\u0dca, \u0dc0\u0dbb\u0dd2\u0db4\u0db1\u0db8\u0dca \u0d85\u0d82\u0d9a \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dcf\u0db1\u0dca\u0db1\u0dcf: \u0d9c\u0dcf\u0dbd\u0dca\u0dbd, \u0db8\u0d9a\u0dd4\u0dc5\u0dd4\u0dc0, \u0dc3\u0dbb\u0dca\u0d9a\u0dd2\u0dba\u0dd4\u0dbd\u0dbb\u0dca \u0db4\u0dcf\u0dbb, \u0dc4\u0db4\u0dca\u0db4\u0dcf\u0dc0\u0db1 \u0dc0\u0dd2\u0dad\u0dcf\u0db1\u0dd9\u0d9c\u0dca \u0dc3\u0dd2\u0dbb\u0dd2\u0dbd\u0dca; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.0091 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0dd9\u0dc0\u0dca. 11. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 179 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad, \u0db8\u0dd2\u0dc1 \u0dc0\u0d9c\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dad; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dcf\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a, \u0d9c\u0dcf\u0dbd\u0dca\u0dbd, \u0db8\u0d9a\u0dd4\u0dc5\u0dd4\u0dc0, \u0dc3\u0dbb\u0dca\u0d9a\u0dd2\u0dba\u0dd4\u0dbd\u0dbb\u0dca \u0db4\u0dcf\u0dbb, \u0dc4\u0db4\u0dca\u0db4\u0dcf\u0dc0\u0db1 \u0dc0\u0dd2\u0dad\u0dcf\u0db1\u0dd9\u0d9c\u0dca \u0dc3\u0dd2\u0dbb\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.0107 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0dd9\u0dc0\u0dca. 12. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 180 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad, \u0db8\u0dd2\u0dc1 \u0dc0\u0d9c\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dad; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dcf\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a, \u0d9c\u0dcf\u0dbd\u0dca\u0dbd, \u0db8\u0d9a\u0dd4\u0dc5\u0dd4\u0dc0, \u0dc3\u0dbb\u0dca\u0d9a\u0dd2\u0dba\u0dd4\u0dbd\u0dbb\u0dca \u0db4\u0dcf\u0dbb, \u0dad\u0dbd\u0dca\u0dd9\u0db4\u0dca \u0dd9\u0dc4\u0dda\u0dc0\u0dd9\u0d9c\u0dca \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.0058 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0dd9\u0dc0\u0dca. 13. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 183 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad, \u0db8\u0dd2\u0dc1 \u0dc0\u0d9c\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dad; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dcf\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a, \u0d9c\u0dcf\u0dbd\u0dca\u0dbd, \u0db8\u0d9a\u0dd4\u0dc5\u0dd4\u0dc0, \u0dc3\u0dbb\u0dca\u0d9a\u0dd2\u0dba\u0dd4\u0dbd\u0dbb\u0dca \u0db4\u0dcf\u0dbb, \u0dd9\u0d9a\u0ddc\u0da9\u0dd2\u0dad\u0dd4\u0dc0\u0d9a\u0dca\u0d9a\u0dd4 \u0d9a\u0d82\u0d9a\u0dcf\u0db1\u0db8\u0dca\u0dd9\u0d9c\u0dca \u0dc3\u0dd2\u0dbb\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.0051 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0dd9\u0dc0\u0dca. 14. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 184 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad, \u0db8\u0dd2\u0dc1 \u0dc0\u0d9c\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dad; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dcf\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a, \u0d9c\u0dcf\u0dbd\u0dca\u0dbd, \u0db8\u0d9a\u0dd4\u0dc5\u0dd4\u0dc0, \u0dc3\u0dbb\u0dca\u0d9a\u0dd2\u0dba\u0dd4\u0dbd\u0dbb\u0dca \u0db4\u0dcf\u0dbb, \u0dd9\u0d9a\u0ddc\u0da9\u0dd2\u0dad\u0dd4\u0dc0\u0d9a\u0dca\u0d9a\u0dd4 \u0d9a\u0d82\u0d9a\u0dcf\u0db1\u0db8\u0dca\u0dd9\u0d9c\u0dca \u0db1\u0dd2\u0dc4\u0dcf\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.0024 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0dd9\u0dc0\u0dca. 15. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 187 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad, \u0dc3\u0dca\u0dae\u0dd2\u0dbb \u0dd9\u0d9c\u0ddc\u0da9\u0db1\u0dd0\u0d9c\u0dd2\u0dbd\u0dca\u0dbd\u0d9a \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0d87\u0dad; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dcf\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a, \u0d9c\u0dcf\u0dbd\u0dca\u0dbd, \u0db8\u0d9a\u0dd4\u0dc5\u0dd4\u0dc0, \u0dc3\u0dbb\u0dca\u0d9a\u0dd2\u0dba\u0dd4\u0dbd\u0dbb\u0dca \u0db4\u0dcf\u0dbb, \u0d85\u0d9c\u0dd4\u0dc5\u0dd4\u0d9c\u0dc4 \u0d9c\u0db8\u0dd9\u0d9c\u0dca \u0dc3\u0dd2\u0dbb\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.0024 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0dd9\u0dc0\u0dca. 16. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 188 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0d89\u0da9\u0db8\u0dca \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dcf\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a,",
