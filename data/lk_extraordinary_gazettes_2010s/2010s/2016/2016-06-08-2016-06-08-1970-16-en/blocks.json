  },
  {
    "page_number": 0,
    "bbox": [
      56.13,
      449.17,
      547.27,
      532.24
    ],
    "text": "WHEREAS, I, Maithripala Sirisena, President of the Democratic Socialist Repulic of Sri Lanka being of the opinion that byreason of the existence of a state of disaster in such provisions of Sri Lanka as are specified in the Schedule hereto, it isexpedient so to do in the interests of Public Security, the preservation of Public Order and the maintenance of supplies andservices essential to the life of the community, do, by virtue of the powers vested in me by Section 11 of the Sri LankaDisaster Management Act, No. 13 of 2005, by this Proclamation declare that the provisions of the aforesaid Act, shallcome into operation in such Provinces of Sri Lanka as are specified in the Schedule hereto, on the 30th day of May, TwoThousand and Sixteen.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      92.13,
