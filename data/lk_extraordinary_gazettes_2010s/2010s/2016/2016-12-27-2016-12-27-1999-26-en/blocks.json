    "bbox": [
      304.08,
      331.28,
      539.47,
      375.92
    ],
    "text": "Matara Road bearing Assessment No. 359 Claimed by Sippigathima; On the South by: The Sea; On the West by: The Sea and the Land in Matara Road of which the Assessment can not be found.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
