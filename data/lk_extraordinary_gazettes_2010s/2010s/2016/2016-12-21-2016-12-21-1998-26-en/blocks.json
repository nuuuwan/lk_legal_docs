    "text": "Notification under Section 30",
    "fonts": [
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      383.77,
      538.95,
      433.84
    ],
    "text": "IT is hereby notified that by virtue of the powers vested in the Monetary Board established under the Monetary Law Act(Chapter 422), in terms of Section 30 of the Debt Recovery (Special Provisions) Act, No. 02 of 1990, the MonetaryBoard has, having regard to the current rates of bank interest, determined that with effect from 01st January 2017, theMarket Rate of Interest for the purpose of this Act, shall be seven point zero six per cent (7.06%) per annum.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
