      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 6,
    "bbox": [
      47.85,
      426.49,
      539.91,
      473.56
    ],
    "text": "NOTICE is hereby given in terms of Section 84(07) of the National Water Supply and Drainage Board Law No. 02 of1974 that the following tariffs will be revised with effect from the 01st day of December 2016, for sewerage servicesfrom consumers, connected to all sewerage systems/networks owned, operated and maintained by the National WaterSupply and Drainage Board.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 6,
    "bbox": [
      47.85,
      486.49,
      539.94,
      521.56
    ],
    "text": "This notice replaces the notice appearing in the Gazette Extraordinary No. 1738/7 dated 28th December, 2011in respect of the sewerage tariff with effect from the 01st day of January 2012 and applicable to all consumers connectedto all sewerage systems/networks owned, operated and maintained by the National Waterr Supply and Drainage Board.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 6,
    "bbox": [
      83.85,
      534.49,
      517.09,
      545.56
    ],
    "text": "The monthly sewerage charge for any premises is based on the water consumption of the previous month.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
