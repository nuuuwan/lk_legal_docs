    "bbox": [
      90.69,
      378.49,
      497.01,
      389.56
    ],
    "text": "THE NATIONAL WATER SUPPLY AND DRAINAGE BOARD LAW, No. 2 OF 1974",
    "fonts": [
      "TimesNewRoman,Bold"
