  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      434.77,
      539.89,
      469.84
    ],
    "text": "This notice replaces the notice appearing in the Gazette Extraordinary No. 1776/13 dated 18th September,2012 in respect of the water tariffs with effect from the 01st day of October 2012 and applicable to all consumers whoare supplied with water by the National Water Supply and Drainage Board.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
