      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      133.41,
      645.13,
      430.35,
      656.2
    ],
    "text": "(a) academic or professional qualifications acceptable to the Board ; or",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      132.81,
      669.13,
      538.75,
      680.2
    ],
    "text": "(b) not less than ten years effective experience in the field of insurance, finance, business or in any",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      48.81,
      681.13,
      537.59,
      735.21
    ],
