  {
    "page_number": 0,
    "bbox": [
      50.64,
      339.99,
      306.37,
      484.16
    ],
    "text": "Notice under Section 7 My Reference No.: PLDS/LND/04/ACQ/71. I, hereby give notice under Sub-section (1) of Section (7) of the Land Acquisition Act, that the Government intends to acquire the following lands which are required for a public purpose.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      1.9198079109191895,
      10.078991889953613,
      11.038795471191406,
      22.077693939208984,
      71.9927978515625
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      487.03,
      286.45,
      535.26
    ],
    "text": "I hereby make the following amendment to the Gazette Extraordinary bearing Number 1305/15 dated 09.09.2003.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613,
      11.038795471191406
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      51.6,
      538.63,
      264.6,
      548.72
    ],
    "text": "Description of the land or Servitude to be acquired :",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      551.35,
      286.41,
      635.36
    ],
    "text": "One (01) allotment below name land shown in Final Village Plan No. 209, Supplement No. 12, prepared by the Superintendent of Surveys, Rathnapura District situated in the Grama Niladhari Division of Udapattuwe Sannasgama in the Divisional Secretary\u2019s Division of Pelmadulla in the District of Rathnapura in Sabaragamuwa Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.9994001388549805,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.56,
      331.52,
      386.76,
      341.64
    ],
    "text": "01. Lot No. 445",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      344.96,
      539.71,
      377.12
    ],
    "text": "Name of the Land: Manakumburegoda; Description : Open waste land; Claimant : State; Original Claimant : Rathna Malwatta, Lellopitiya, Sannasgama; Extent : 0.0051 Hectare.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      382.63,
      539.39,
      512.72
    ],
    "text": "All persons interested in the aforesaid land/lands on which a servitude is to be acquired are hereby required to appear personally, or by agents duly authorized in writing, before me at Divisional Secretariat, Pelmadulla of the 16th, January 2017 at 9.30 a. m. and are hereby requested to notify to me in writing (in duplicate) on or before the 16th, January 2017 the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land/servitude, the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      0.9599039554595947,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      514.39,
      538.92,
      570.08
    ],
    "text": "SUGATH SISIRA KUMARA, Divisional Secretary and Acquiring Officer, Pelmadulla.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
