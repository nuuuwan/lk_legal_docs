  },
  {
    "page_number": 0,
    "bbox": [
      66.48,
      381.0,
      285.72,
      419.36
    ],
    "text": "My Reference No.: DSB/LND/02/F1/14.. Land Ministry\u2019s Reference No.: 4-3/16/2013/NRD/26.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      418.4,
      286.41,
      508.63
    ],
    "text": "I, hereby give notice, under Sub-Section (1) of Section 7 of the Land Acquisition Act, as amended by the Land Acquisition (Amendment) Act, No. 28 of 1964, that the Government intends to acquire the following land which is required for Matara-Kataragama Railway Project.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      510.07,
      286.45,
      589.04
    ],
    "text": "Description of the Land: Lot Nos. 191 and 192 depicted in the Plan F. V. P. 307-5/5 dated 27th November 2015, prepared by the Surveyor General and situated in the Village of Ovilana in the Divisional Secretary\u2019s Division of Beliatta in Hambantota District.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      590.48,
      286.51,
      649.52
    ],
    "text": "Lot No. 191 Name of the Land - Lindaarawatta - Claimant: Nilanthi Rupika Wagachchi, Ovilana, Beliatta; Extent: 0.0237 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      346.44,
      539.46,
      390.8
    ],
    "text": "Lot No. 192 Name of the Land - Lindaarawatta - Claimant: Indra Kusumalatha Wagachchi, Ovilana, Beliatta; Extent: 0.0123 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      391.96,
      539.43,
      503.36
    ],
    "text": "All persons interested in the aforesaid lands are hereby required to appear personally, or by agents duly authorized in writing, before me at Divisional Secretariat, of Beliatta on the 2nd March, 2016 at 10.00 a. m. and are hereby requested to notify to me in writing (in duplicate) on or before the 24th February 2016, the nature of their interests in the land, the particulars of their claims for compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.91920804977417,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      503.82,
      539.4,
      528.8
    ],
    "text": "All deeds and other documents in support of the claims should be produced at the inquiry.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      1.9198079109191895,
      10.078991889953613
    ]
