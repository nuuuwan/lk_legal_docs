u0bbe\u0bc8\u0b95\u0bc8\u0baf\u1f9c\u0bae\u0bcd, \u0b85\u0ba4\u0bcd\u0bc6\u0ba4\u0bbe\u0bc8\u0b95 \u0b95\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bc8\u0bb3\u1f9c\u0bae\u0bcd, 2016 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8c \u0ba8\u0bc6\u0bb5\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd 23 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u1f99\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd \u0b8e\u1fa8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u1f99\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0b95\u0bb3\u0bbe\u0b95 \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0baa\u1f8a\u1f9c\u0bae\u0bcd \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0bc7\u0b95\u0b9f\u0bcd\u1f8c\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba9\u0bb0\u0bcd.",
