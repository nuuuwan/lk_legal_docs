  {
    "page_number": 0,
    "bbox": [
      88.05,
      403.21,
      445.12,
      462.28
    ],
    "text": "1.Justice Hector Yapa-Retired Judge of the Supreme Court2.Justice Nimal Dissanayake-Retired Judge of the Supreme Court3.Justice Chandradasa Nanayakkara-Retired Judge of the Court of Appeal4.Mr. M. Somasunderam5.Mrs. Faleela Be Jurangpathy",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      475.21,
      539.89,
      498.28
    ],
    "text": "His Excellency the President has nominated Justice Hector Yapa, retired Supreme Court Judge under the above-mentioned provisions, to be the Chairman of the said Commission.",
