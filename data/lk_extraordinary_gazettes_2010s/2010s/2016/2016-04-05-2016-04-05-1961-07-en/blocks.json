    ],
    "text": "\u201c5. A non-refundable fee of Rupees Ten Thousand (Rs. 10,000) shall be paid when applying for a newlicense or renewal of license\u201d ;",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
