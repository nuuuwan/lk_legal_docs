      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.17,
      398.17,
      546.41,
      421.24
    ],
    "text": "IT this hereby notified for the information of the pilgrims who attended the above festival and other concerned that theabove festival commence 16.07.2016 and terminate on 04.08.2016 with execution of duties to the manes.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.17,
      434.17,
      546.44,
      469.24
    ],
    "text": "The attention of the pilgrims who attend the festival and others concerned is drawn to standing regulation publishedin the Government Gazette No. 10247 dated 11th May 1951 which will be in force during the duration of the abovefestival.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
