    "bbox": [
      47.85,
      572.29,
      412.11,
      583.36
    ],
    "text": "\u201cSmokeless tobacco product\u201d means any tobacco product which do not generate smoke.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
