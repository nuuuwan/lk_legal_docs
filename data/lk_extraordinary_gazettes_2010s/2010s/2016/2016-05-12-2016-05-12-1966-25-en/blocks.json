  {
    "page_number": 0,
    "bbox": [
      50.88,
      439.73,
      286.67,
      513.63
    ],
    "text": "I hereby give notice under Sub-Section (1) of Section 7, of Land Acquisition Act, No.28 of 1964 (Amendment) that the Government intends to acquire the following land which is required for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613,
      11.998800277709961,
      13.918607711791992
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      515.11,
      226.68,
      536.72
    ],
    "text": "Description of the land to be acquired:-",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      538.16,
      286.67,
      628.64
    ],
    "text": "An allotment of land in total extent of about 2.0234 Hectare, depicted as Lot No. 01 in Plan No. P.P. Ga.4137, prepared by the Surveyor General, situated in the village called Walahandoowa in the Grama Niladhari Division No.112 A of Walahandoowa in the Divisional Secretary\u2019s Division of Akmeemana in Galle District of the Southern Province and more fully described as follows.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.56,
      347.16,
      539.84,
      407.6
    ],
    "text": "Lot No. 01 Name of the Land: Walahandoowa watta; Description: Playground and scrub jungle; Claimant: State; Original Claimant: Chairman, Land Reform Commission, Colombo 07; Total Extent: 2.0234 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.079591751098633,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.56,
      408.76,
      542.23,
      526.16
    ],
    "text": "All persons interested in the aforesaid land are hereby required to appear personally, or by agents duly authorized in writing before me at 10.00 a.m. on the 29th June, 2016 at the Akmeemana Divisional Secretariat and are hereby requested to notify to me in writing (in duplicate) on or before the 22nd June, 2016 the nature of their interest in the land, the particulars of their claims for compensation for the acquisition of the said lands, the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.91920804977417,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.56,
      526.87,
      533.88,
      630.56
    ],
    "text": "PUSHPIKA THUSHARI JAGODA, Divisional Secretary, Akmeemana. Divisional Secretariat, Akmeemana, 06th May, 2016. 05 - 864",
