  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      426.56,
      286.64,
      494.24
    ],
    "text": "I hereby give notice, under Sub-section (1) of Section 7 of the Land Acquisition Act, No. 28 of 1964 (Amendment) that the Government intends to acquire the following land which is required for a Public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      495.67,
      230.76,
      512.71
    ],
    "text": "Description of the land to be acquired :",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.9994001388549805,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      513.92,
      286.69,
      616.16
    ],
    "text": "Two allotments of land called Patapilikanda Kele in total extent of 0.1104 hectare depicted as Lot No. 173 and 175 in Cadastral Map No. 120134 Block No. 02 Sheet No. 10 prepared by the Survey General, situated in the village called Minneriya in the Grama Niladhari Division No. 56 of Minneriya in the Divisional Secretary\u2019s Division of Hingurakgoda in Polonnaruwa District of the North Central Province and more fully described as follows.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      617.6,
      286.67,
      696.56
    ],
    "text": "SCHEDULE 01. Lot No. 173 Name of the Land: Patapilikanda Kele; Description: Home Garden , a permanent building available; Claimant: Peoples Thrift and Credit Co-operative Society, Minneriya; Extent: 0.0866 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      3.119687795639038,
      7.91920804977417,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      346.64,
      539.4,
      391.28
    ],
    "text": "02. Lot No. 175 Name of the Land: \u2014; Description: Road; Claimant: Peoples Thrift and Credit Co-operative Society, Minneriya; Extent: 0.0238 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      3.119687795639038,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      403.07,
      594.11,
      521.11
    ],
    "text": "All persons interested in the aforesaid land are hereby required to appear personally, or by agents duly authorized in writing, before me at Hingurakgoda Divisional Secretariat on 04th July 2016 at 10.30 a. m. and are hereby requested to notify to me in writing (in duplicate) on or before 04th July, 2016 the nature of their interest in the land, the particulars of their claims for compensation for the acquisition of the said lands the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      3.119687795639038,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      522.56,
      539.36,
      555.68
    ],
    "text": "All deeds and documents in support of the claims should be produced before me at the inquiry.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
