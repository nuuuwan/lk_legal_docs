0b87\u0bb2. 375 - \u0b95\u0bbf\u0bbe\u0bbf \u0b85\u1f99\u1f8e\u0bc6\u0b95\u0bbe\u0bc7\u0bb2, 383 - \u0b95\u0b9f\u0baf\u0bbe\u0bb5 \u0baf\u0bbe\u0baf 06, 378 - \u0b95\u1fbf\u0bae\u1f8c\u0bb5, 380 -\u0bc6\u0b95\u0bc7\u0bb2\u0b9a\u0bbf\u0baf\u1fbb\u0baa\u0bc7\u0bb2\u0bb5, 381 - \u0bc6\u0bae\u0ba4\u0b95\u0bae, 390 - \u0b87\u0bb9\u0bb2 \u0b9a\u0bbf\u0baf\u1fbb\u0baa\u0bc7\u0bb2\u0bb5, 393 - \u0b8e\u0ba8\u0ba4\u0b95\u0bb2, 394 - \u0b95\u1fbf\u0bb5\u1f8c\u0bb5\u0bbe\u0b95\u0bae, 405 -\u0bc6\u0bae\u0bbe\u0bb0\u0bc6\u0b95\u0bbe\u0b9f \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u0b8e\u1fb8\u0ba4\u0b95\u0bb2, \u0ba4\u1fb9\u0bc6\u0b95\u0bbe\u1fbf\u0bb2\u0b95\u0bae, \u0b95\u1fbf\u0bae\u1f8c\u0bb5, \u0b87\u0bb9\u0bb2\u0bc6\u0bb5\u0bb5, \u0bc6\u0b95\u0bc7\u0bb2\u0b9a\u0bbf\u0baf\u1fbb\u0baa\u0bc7\u0bb2\u0bb5, \u0bc6\u0bae\u0ba4\u0b95\u0bae, \u0ba8\u0baa\u0bc7\u0b9f\u0bb5, \u0bc6\u0baa\u0bbe\u1fb7\u0bc7\u0ba4\u0b95\u0bae, \u0b9a\u0bbf\u0baf\u1fbb\u0baa\u0bc7\u0bb2\u0bb5, \u0baf\u0b95\u1fbf\u0bc7\u0bb2\u0b95\u0bae, \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\u1f90\u1fbb 110100 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 01 \u0b87\u1fbf \u0b85\u0b9f\u1fb1\u0b95\u0bbf\u1f9c\u1fc0\u0bb3\u1f90\u0bae\u0bbe\u0ba9 457 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95\u1fb1\u0b95\u0bc8\u0bb3\u1fb0 \u0bc6\u0b95\u0bbe\u1fb6\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u1fa6\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb7 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b87\u0ba4\u0bc7\u0ba9\u0bbe\u1f8c \u0b87\u0bc8\u0ba3\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f \u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf \u0ba4\u0bb0\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3\u0bb5\u0bbe\