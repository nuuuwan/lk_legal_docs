  {
    "page_number": 0,
    "bbox": [
      51.12,
      618.09,
      286.44,
      717.45
    ],
    "text": "\u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 1 - \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0dbd\u0291\u0dc0\u0dbd\u0dc0\u01ae\u0dd9\u0dad\u0dd9\u0dc4\u02a2\u0db1, \u0dd9\u0db6\u0dbb\u0dc0\u023f\u0262\u0dd9\u0dbd\u0dd9\u0dc4\u02a2\u0db1, \u0dd9\u0dbd\u0291\u0dc0\u0dbd\u0dc0\u01ae\u0dad; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba : \u0dd9\u0d9c\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u0dbd\u01d0 \u0d9a\u0dd0\u0dc5\u0dba, \u0d85\u026c\u025e\u01d0 50\u00fa, 100\u00fa \u0db4\u0db8\u0dab \u0dc0\u0dba\u0dc3\u0dd0\u01af \u0dd9\u0db4\u02a3\u0262 \u0d9c\u0dc3\u0dca 30\u00fa, \u0dd9\u0d9a\u02a3\u0dc3\u0dca \u0d9c\u0dc3\u0dca 04\u00fa, \u00fb\u01b1\u0262 \u0d9c\u0dc3\u0dca 05\u00fa, \u0dc3\u028f\u0dad \u023d\u0279 \u0dd9\u0db7\u02a4\u0d9c \u0dc0\u0d9c\u0dcf\u0dc0\u00fa, \u0d8b\u029a \u0dd9\u0dc3\u026a\u0263 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0dca\u01c2\u0dbb \u0dd9\u0d9c\u02a3\u0da9\u0db1\u0dd0\u0135\u0262\u0dbd\u00fa, \u0dc0\u0dd0\u0286\u00fb\u0298\u0dba\u00fa, \u0dc0\u01b1\u0dbb \u0da7\u0dd0\u0d82\u00fb\u0dba\u00fa, \u0263\u0db3\u00fa \u0dc3\u0dc4 \u0286\u0dd9\u0db8\u01e6\u01af \u0d9a\u0db4\u0dbb\u0dcf\u025e \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db4\u018b \u0dd9\u0db4\u0dc5\u00fa \u0d87\u0dad.\u023f\u0262 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u01e6\u0db1\u01e6\u0dd9\u0118 \u0db1\u0db8 \u0dc4\u0dcf \u0263\u0218\u0db1\u0dba: \u023f. \u0218. 454\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a F-100\u028f \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa, \u023f\u0262 \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0dd9\u0db1\u02a4 \u0dc4\u0db6\u0dbb\u0dcf\u01d0\u0dc0, \u201c\u0d85 \u0dd9\u0dc1\u02a4\u0d9a\u0dcf\u201d \u028f \u0db4\u01ce\u0d82\u013d \u0d86\u0259. \u0da2\u0dba\u0dc0\u0259\u0db0\u0db1, \u0dc0\u0dd0\u0263\u0d9c\u0db8, \u0218\u0179\u01d1\u0dc0 \u0db4\u0dcf\u0dbb, \u0dd9\u0dbd\u0291\u0dc0\u0dbd\u0dc0\u01ae\u0dad \u028f \u0db4\u01ce\u0d82\u013d \u0dd9\u00fa. \u0da2\u0dba\u0dc0\u0259\u0db0\u0db1,",
