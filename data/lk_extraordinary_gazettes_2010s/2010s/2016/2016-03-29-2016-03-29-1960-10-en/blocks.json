  },
  {
    "page_number": 0,
    "bbox": [
      55.17,
      398.17,
      546.3,
      493.24
    ],
    "text": "BY virtue of powers vested in me by Section 20(4) of the Universities Act, No. 16 of 1978, I, Lakshman Kiriella, theMinister of Higher Educations and Highways, on being satisfied that the administration of the affairs of the GampahaWickramarachchi Ayurveda Institute, Sri Lanka have been seriously dislocated and that the authorities of the said Institutehave failed to restore normal conditions, do by this Order appoint Professor Jayantha Walihinda to be the CompetentAuthority with effect from February 27, 2016, for the purpose of exercising, performing or discharging in lieu of Directorof Gampaha Wickramarachchi Ayurveda Institute Sri Lanka, any power, duty or fuction respectively which has been conferredor imposed on, or assigned to the said Director of the Gampaha Wickramarachchi Ayurvedic Institute, Sri Lanka under thesaid Act, or any Order, Ordinance, Statue, by law, Regulation and the Rule made thereunder.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
