      95.04,
      367.44,
      303.68,
      389.51
    ],
    "text": "My Ref. No. : MOR/LAN/01/FI/202Land Ministry Reference No. : 4 - 3/06/2014/HW/310",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
