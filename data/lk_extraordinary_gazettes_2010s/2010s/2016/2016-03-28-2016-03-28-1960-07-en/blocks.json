  {
    "page_number": 0,
    "bbox": [
      63.84,
      403.44,
      303.58,
      437.51
    ],
    "text": "I hereby give notice under Sub-section (1) of Section 7 of theLand Acquisition Act, that the Government intends to acquirethe following lands which are required for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      73.92,
      451.44,
      231.04,
      461.51
    ],
    "text": "Description of the land to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      63.84,
      475.44,
      303.69,
      569.51
    ],
    "text": "Lot No. 209 - 210 (Lots. 02) allotments in total extent ofabout 0.0243 Hectare of land in Cadastral Map No. 520214,Block No. 03, Sheet No. 06, dated 25.01.2016 prepared by theSurveyor-Superintendent on behalf of Surveyor- Colombo,General situated in the Village of Moratuwella North (Withinthe Municipal Council Limits of Moratuwa) in the DivisionalSecretary\u2019s Division of Moratuwa Divisional SecretaryDivision in Colombo District in the Western Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      63.84,
      583.44,
      303.49,
      629.51
    ],
    "text": "01. Lot No. 209Name of land: Assmt. No. 02 (A part) Old Galle Road;Description: Garden; Claimant: State; Original Claimant: \u2013 Notmention; Extent: 0.0107 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      315.36,
      320.64,
      554.99,
      366.71
    ],
    "text": "02. Lot No. 210Name of land: Assmt. No. 2 (A part) Old Galle Road;Description: Garden; Claimant: State; Original Claimant: HewaDewage Saiman Fernando; Extent: 0.0136 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      315.36,
      386.64,
      555.82,
      492.71
    ],
    "text": "All persons interested in the aforesaid lands are herebyrequired to appear personally or by agent duly authorized inwriting, before me at Divisional Secretariat office of Moratuwaon 11th day of May, 2016 at 9.30 a.m. and are hereby requestedto notify to me in writing (in duplicate) on or before the 04thday of May, 2016 the nature of their interests in the land, theparticulars of their claims for compensation for the acquisitionof the said lands, the amount of compensation and the detailsof the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
