    ],
    "text": "AMENDMENT TO THE MEDICAL SERVICE MINUTE OF SRI LANKAN HEALTH SERVICE",
    "fonts": [
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      345.13,
      539.91,
      380.2
    ],
    "text": "THE Medical Service Minute of the Sri Lankan Health Service published in the Government Gazette No. 1883/17 dated11.10.2014 is hereby amended in such a manner as to incorporate the following note immediately after Section 7.2 of theMedical Service Minute of the Sri Lankan Health Service.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      393.13,
      76.65,
      404.2
    ],
    "text": "\u201cNote :",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      417.13,
      540.01,
      476.2
    ],
    "text": "The recruitement age set down in Section 7.2 will not be applicable only to the persons mentioned in the Ordersof the Supreme Court in SC. FR. Application Nos. 135/07 and 136/07, who are presently serving as Registered MedicalOfficers/Assistant Medical Officers in the Ministry of Health or the Provincial Ministries of Health, provided that theyfulfill the criteria laid down by the Supreme Court in the Order dated 07.03.2014 as amended by the Order dated16.07.2014.\u201d",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      83.85,
      489.13,
      422.27,
      500.2
    ],
    "text": "Other provisions of the aforesaid Service Minute shall remain in force unchanged.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
