    "text": "\u0bae\u1fb7\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u1fb7\u0ba4\u0bbf\u1fbf, \u1f92\u0bb5\u0bc6\u0bb0\u1fa2\u0baf\u0bbe \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0b89\u0b9f\u0bc7\u0bb9\u0bb5\u0bbe\u0bc6\u0bb9\u1fb5\u0b9f \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bb5\u1f9e\u0bae\u0bbe\u0ba9 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bbe\u0bbf \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf, (\u0ba4\u1fbe\u0bc7\u0baa\u0bbe\u0bc8\u0ba4\u0baf \u0bb9\u1fb1\u1f81\u0bb0\u0bbe\u1fb9\u0bc6\u0b95\u0ba4 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u1fab), \u0b95\u0bb2\u0b89\u0b9f \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bc7\u0b9a\u0bb5\u0b95\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf \u0b95\u0bb2\u0b89\u0b9f \u0b8e\u1f94\u1fbb \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf \u0b87\u0bb2\u1fb0\u0b95\u1fbb 15 (\u0bae\u1fb7\u0ba4\u0bbf\u0baf) \u0bc6\u0b95\u0bbe\u1fb6\u0b9f \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u1f99\u1fa8 \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5 \u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf \u0b89\u1fb5\u0bc7\u0b9a\u1fbd\u1fb0\u0bc8\u0b95 \u0b87\u0bb2. 8 \u0b87\u1fb9 136, 137, 138, 139, 140, 141, 142, 143, 144, 145, 145 1/2, 146, 147, 148, 149, 150, 151, 153, 154, 155, 156, 157, 158, 159, 160, 161, 162, 164, 166, 167, 168, 169, 170, 171, 172, 173 \u0bae\u1fbe\u1fa0\u1fbb 174 \u0b89\u1fb5\u0bc7\u0b9a\u1fbd\u1fb0\u0bc8\u0b95 \u0b87\u0bb2. 9 \u0b87\u1fb9 180, 181, 182 \u0bae\u1fbe\u1fa0\u1fbb 183 \u0b86\u1fbb \u0ba8\u0bbf\u0bb2\u1fb7\u1f90\u1fb6\u1f8c\u0b95\u0bb3\u0bbe\u0b95 \u0bb5\u0bbf\u0baa\u0bbe\u0bbf\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0b95\u0bbe\u0ba3\u0bbf\u0b95\u1fc0 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbe\u0b95 \u0b95\u0bbe\u0ba3\u0bbf \u0ba8\u0bbf\u1f9e\u0ba3\u0baf\u1fb4 \u0bc6\u0b9a\u1fbc\u1f9c\u1fbb \u0b95\u1fb5\u0b9f\u0bc8\u0bb3\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 4 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u1fbf \u0b92\u1fb9\u1fa0 1979 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0bc6\u0b9a\u1fb7\u0bc6\u0ba4\u1fbb\u0baa\u1fbd \u0bae\u0bbe\u0ba4\u1fbb 21 \u0b86\u1fbb \u0ba4\u0bbf\u0b95\u0ba4\u0bbf 55 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b85\u0bb0\u0b9a \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u1fbf (\u0b87\u0bb2\u1fb0\u0b95\u1fbb 4847 (\u1f92\u0bb5\u0bc6\u0bb0\u1fa2\u0baf\u0bbe) \u0bc6\u0b95\u0bbe\u1fb6\u0b9f \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u0bc8\u0bb2\u1fba \u0baa\u0bbe\u1fbd\u1fb0\u0b95\u1fab\u1fbb) \u0bc7\u0bae\u1fbe\u1f82\u0bb1\u0bbf\u0baf \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9\u0baa\u1f8a \u0bc7\u0bb5\u1fa0 \u1f99\u0bc8\u0bb1\u1fba\u0baa\u1f8a \u0b89\u0bbe\u0bbf\u0baf\u0bb5\u0bbe\u1fa0\u0bc6\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u0b9f\u1fba\u0baa\u1fb5\u0b9f\u0ba4\u0bbe\u1fa4\u1fbb, \u0b85\u1fc2\u0bb5\u0bbe\u1fa0 \u1f81\u0bb1\u0bbf\u1fba\u0baa\u0bbf\u0b9f\u1fba\u0baa\u1fb5\u0b9f \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u1fa2\u1fb9 \u0baa\u1f8a \u0bc6\u0baa\u1fbe\u1fa0\u1fb0\u0bc6\u0b95\u0bbe\u1fb6\u0b9f \u0b9a\u0b95\u0bb2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0 \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0b95\u1fc0 \u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u0baa\u0bbf\u1fbf \u1f81\u0bb1\u0bbf\u1fba\u0baa\u0bbf\u1fb5\u0b9f \u0b95\u1fb5\u0b9f\u0bc8\u0bb3\u1fb2\u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 \u0baa\u0bbf\u0bb0\u0bae\u0bbe\u0ba9\u1fb1\u0b95\u1fa6\u1fb0\u1f81 \u0b87\u0ba3\u1fb1\u0b95 \u0ba8\u0b9f\u0bb5\u1f8a\u1fb0\u0bc8\u0b95 \u0b8e\u1f8c\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3\u0ba4\u0bbe\u1fa4\u1fbb, \u0b87\u1fb1\u1f81 \u0b95\u0bc0\u1fc1 \u0bc8\u0b95\u0bc6\u0baf\u0bbe\u1fba\u0baa\u0bae\u0bbf\u1fb5\u0b9f \u0ba8\u0bbe\u1fb9, \u1f81\u0bb1\u0bbf\u1fba\u0baa\u0bbf\u1fb5\u0b9f \u0b95\u1fb5\u0b9f\u0bc8\u0bb3\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 5(5) \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0baa\u1f8a \u0b8e\u0ba9\u1fb0\u1f81 \u0bb5\