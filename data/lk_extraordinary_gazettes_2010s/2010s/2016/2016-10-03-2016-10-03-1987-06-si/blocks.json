    "text": "\u0dbd\u0db6\u0dcf\u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u02a3\u0dd9\u0dbb\u02a3\u01ae\u01b1 \u0dc0\u0db1 \u0d89\u0da9\u0dd9\u023c/\u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dd9\u0269 \u026a\u0dc3\u0dca\u0dad\u0dbb : \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0db8\u0dcf\u0dad\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0d85\u00fd\u025a\u0dc3\u0dca\u0dc3 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u0dc0\u0dd0\u0263\u0d9c\u023c \u0dd9\u0d9a\u02a4\u0dbb\u0dd9\u0dc5\u02a2 (\u0d8b\u01b1\u0dbb) \u0288\u029a \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d9a\u0dd0\u0da7\u0dd0\u01e6\u026a\u0dbd \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0db8\u0dcf\u0dad\u0dbb \u0dc3\u0259\u0dd9\u0269 \u0da2\u0db1\u0dbb\u0dcf\u0262\u0dd9\u0118 \u0d85.\u0d9c.\u0218. 534 \u0d85\u01af\u0dd9\u0259\u0d9a \u0d85\u0d82\u0d9a 15 \u0dc4\u0dcf \u0db4\u01b4 \u0d85\u0d82\u0d9a 16 \u0daf\u0dbb\u0db1 \u0d85\u0dc0\u0dc3\u0dcf\u0db1 \u0d9c\u023c \u0218\u0249\u0dd9\u0259 \u0dd9\u0db4\u01e6\u01e9\u023c \u0d9a\u0dbb\u0db1 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca:",
