    "text": "\u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0d89\u0da9\u0db8\u0da7/ \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf\u0dc0\u0da7 \u028f\u023d\u0d9a\u023c, \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u0dc3\u023c\u0db6\u01e6\u0db0\u0d9a\u023c \u00fb\u0dba\u0dcf \u0286\u0179\u0db1 \u0286\u0dba\u0265 \u0dd9\u0daf\u0db1\u0dcf\u0db8 \u0dad\u0db8 \u0dad\u0db8\u01e6 \u0dd9\u0dc4\u02a4 \u0d94\u026c\u01e6\u0dd9\u0118 \u0263\u0dba\u026a\u0263\u0dc0\u0263\u01e6 \u0db6\u0dbd\u0dba\u0dbd\u01ae \u0d85\u0dba\u0dc0\u029a\u01e6 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u01ce\u0db1\u0dba\u01e6\u028f\u01cf \u0d85\u00fd\u025e\u0dc3\u0dca\u0dc3 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dd9\u024f\u01cf \u0db8\u0dcf \u0dc3\u023c\u023f\u0d9b \u026a\u0dba \u0252\u01b1\u0250. \u01ce\u0db1\u0dba \u0dd9\u0269\u0dbd\u0dcf\u0dc0 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a\u0dba 2016.12.07 \u0db4. \u0dc0.1.30 331, 332, 333, 334, 335 \u0dad\u0dc0 \u0daf, 2016 \u0dd9\u0db1\u02a3\u0dc0\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 25 \u0dc0\u0dd0\u01e7 \u01ce\u0db1\u0da7 \u0db8\u01ae\u0dd9\u0dad\u01e6 \u0d92 \u0d89\u0da9\u0db8/ \u0d89\u0da9\u023c \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d94\u026c\u01e6\u0dd9\u0118 \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c\u0dc0\u0dbd \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba\u01ae, \u0d91\u00fc \u0d89\u0da9\u0db8/\u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf\u0dc0\u0dba \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8 \u0d9c\u0dd0\u0db1 \u0dc0\u01e6\u01ce \u023f\u0daf\u0262 \u0d89\u0262\u0dbd\u0dcf \u0286\u017a\u0db8\u0da7 \u0d87\u01af \u0d9a\u025e\u019f \u0218\u0298\u0db6\u0db3 \u026a\u0dc3\u0dca\u0dad\u0dbb\u01ae, \u0dc0\u01e6\u01ce \u023f\u0daf\u0dbd \u0dc4\u0dcf \u0d91\u0dba \u0d9c\u0dab\u0db1\u0dba \u0d9a\u0dc5 \u0d86\u0d9a\u0dcf\u0dbb\u0dba\u01ae \u0218\u0da7\u0db4\u01ae \u0dd9\u0daf\u0d9a\u00fa \u0dc3\u028f\u0dad \u0263\u0dba\u026a\u0262\u