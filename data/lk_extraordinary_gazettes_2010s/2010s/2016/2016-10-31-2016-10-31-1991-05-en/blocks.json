    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      343.3,
      286.42,
      453.87
    ],
    "text": "Notice under Section 7 I hereby give notice, under Sub section (1) of section 7 of the Land Acquisition Act, as Amended by the Land Acquisition (Amendment) Act, No. 28 of 1964, that the Government intends to acquire the following land/servitude which is required for a public purpose.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613,
      11.998800277709961,
      13.918607711791992
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      455.35,
      286.46,
      555.2
    ],
    "text": "Description of the land or servitude to be acquired: The following Land situated in the village of Kanaththagoda-North in the Matara Division Secretariat Division, Matara District, Southern Province and depicted as lot 162 in sheet No. 2 of Zone No. 02 in cadastre Map No. 820010 has been acquired to be granted as alternative lands to those persons who were displaced by 2003 Flooded.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.91920804977417,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      568.16,
      195.96,
      591.89
    ],
