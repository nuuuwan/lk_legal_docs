    "bbox": [
      50.64,
      593.36,
      286.44,
      631.04
    ],
    "text": "1. Lot No. 162 Name of Land: Puwakwaththa alias Thalgaspittaniya; Current land use: Home, Garden, around 10 to 20 years",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.079591751098633,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      305.04,
      331.28,
      540.34,
      375.92
    ],
    "text": "old Mixed crops and ten (10) permanent buildings; Claimant: Ven. Hakmana Dharmarathna Thero, Chief Incumbent of Kotikagoda Temple Wewahamanduwa, Matara; Extent: 0.3324 Hectare.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      305.04,
      377.34,
      540.34,
      514.88
    ],
    "text": "All persons interested in the aforesaid land/lands on which a servitude is to be acquired are hereby required to appear personally, or by agents duly authorized in writing, before me at Matara Divisional Secretariat on the 10th November, 2016 at 10.30 a.m. and are hereby requested to notify to me in writing (in duplicate) on or before the 1st of November, 2016 the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land/servitude, the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613,
      11.038795471191406
    ]
