    ],
    "text": "5. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 168 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u1f90; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0b95\u0bb2\u0baa\u0bcd\u1f97\u0baa\u0bcd \u0baa\u0baf\u0bbf\u0bb0\u0bcd\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0bc8\u0b95 \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u1f90; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u1f90; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0161 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 6. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 169 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b9c\u0baf\u0b9a\u0bc1\u0ba8\u0bcd\u0ba4\u0bb0 \u1f99\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bc7\u0b9a\u0bb2\u0bbe\u0bc6\u0b95\u0bb5\u0ba4\u0bcd\u0ba4, \u0b9a\u0bb0\u0bcd\u0b95\u0bbf\u1f9c\u0bb2\u0bb0\u0bcd \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbe\u0bbf \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. 27/6 B \u0b90 \u0b89\u0bc8\u0b9f\u0baf \u0b95\u0bbe\u0ba3\u0bbf; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u1f99\u0b95\u0bae\u0b9f\u0bcd \u0bb9\u0bbe\u0bb7\u0bbf\u0bae\u0bcd \u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf \u1f99\u0bb0\u0bcd\u0bb7\u0bbf\u0ba4\u0bbe, \u0b87\u0bb2. 27/6 B, \u0b9a\u0bb0\u0bcd\u0b95\u0bbf\u1f9c\u0bb2\u0bb0\u0bcd \u1faa\u0ba4\u0bbf, \u0bae\u0b95\u0bcd\u0b95\u0bc1\u1fa4\u0bb5, \u0b95\u0bbe\u1fa2; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0042 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 7. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 172 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b9c\u0baf\u0b9a\u0bc1\u0ba8\u0bcd\u0ba4\u0bb0 \u1f99\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bc7\u0b9a\u0bb2\u0bbe\u0bc6\u0b95\u0bb5\u0ba4\u0bcd\u0ba4, \u0bb5\u0bbe\u0bbf \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0bc6\u0ba4\u0b99\u0bcd\u0b95\u0bc1 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bb2\u0baa\u0bcd\u1f97\u0baa\u0bcd \u0baa\u0baf\u0bbf\u0bb0\u0bcd\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0bc8\u0b95 \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u1f90; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b95\u0bbe\u0bb2\u0b9e\u0bcd \u0bc6\u0b9a\u0ba9\u0bcd\u0bb1 \u0b95\u0bbe\u0bbe\u0bbf\u0baf\u0bb5\u0b9a\u0bae\u0bcd \u0bae\u0bbe\u0ba9\u0bc7\u0b95 \u0ba8\u0ba8\u0bcd\u0ba4\u0b9a\u0bbf\u0bb1\u0bbf\u0bc7\u0b95 \u0b8e\u0ba9\u0bcd\u0baa\u0bb5\u0bbe\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u1f94\u0bbe\u0bbf\u0bc8\u0bae\u0baf\u0bbe\u0bb3\u0bb0\u0bbe\u0ba9 \u0b95\u0ba4\u0bcd\u1f91\u0bb5 \u0bb9\u0b95\u0bcd\u0bae\u0ba9\u0bc7\u0b95 \u0b9a\u0bc0\u0ba4\u0bbe, \u0b9a\u0bb0\u0bcd\u0b95\u0bbf\u1f9c\u0bb2\u0bb0\u0bcd \u1faa\u0ba4\u0bbf, \u0bae\u0b95\u0bcd\u0b95\u0bc1\u1fa4\u0bb5, \u0b95\u0bbe\u1fa2; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0176 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 8. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 173 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u1f90; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0b95\u0bb2\u0baa\u0bcd\u1f97\u0baa\u0bcd \u0baa\u0baf\u0bbf\u0bb0\u0bcd\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0bc8\u0b95 \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u1f90; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u1f90 (\u0b89\u0bc8\u0b9f\u0bc8\u0bae \u0b85\u1f94\u0baa\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bb5\u0bb0\u0bcd: \u0b95\u0ba4\u0bcd\u1f91\u0bb5 \u0bb9\u0b95\u0bcd\u0bae\u0ba9\u0bc7\u0b95 \u0b9a\u0bc0\u0ba4\u0bbe, \u0b9a\u0bb0\u0bcd\u0b95\u0bbf\u1f9c\u0bb2\u0bb0\u0bcd \u1faa\u0ba4\u0bbf, \u0bae\u0b95\u0bcd\u0b95\u0bc1\u1fa4\u0bb5, \u0b95\u0bbe\u1fa2); \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0213 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 9. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 175 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u1f90; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0b95\u0bb2\u0baa\u0bcd\u1f97\u0baa\u0bcd \u0baa\u0baf\u0bbf\u0bb0\u0bcd\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0bc8\u0b95 \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u1f90; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u1f90 (\u0b89\u0bc8\u0b9f\u0bc8\u0bae \u0b85\u1f94\u0baa\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bb5\u0bb0\u0bcd: \u0bb9\u0baa\u0bcd\u0baa\u0bbe\u0bb5\u0ba9 \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9\u0bc7\u0b95 \u0b9a\u0bbf\u0bbe\u0bbf\u0bb2\u0bcd, \u0b9a\u0bb0\u0bcd\u0b95\u0bbf\u1f9c\u0bb2\u0bb0\u0bcd \u1faa\u0ba4\u0bbf, \u0bae\u0b95\u0bcd\u0b95\u0bc1\u1fa4\u0bb5, \u0b95\u0bbe\u1fa2); \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0072 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 10. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 176 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b9c\u0baf\u0b9a\u0bc1\u0ba8\u0bcd\u0ba4\u0bb0 \u1f99\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bc6\u0b9a\u0bc6\u0b95\u0bb5\u0ba4\u0bcd\u0ba4 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b9c\u0baf\u0b9a\u0bc1\u0ba8\u0bcd\u0ba4\u0bb0 \u1f99\u0ba4\u1fa2\u0baf\u0bbe\u0bb0\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0bb5\u0bbe\u0bbf \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0bb9\u0baa\u0bcd\u0baa\u0bbe\u0bb5\u0ba9 \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9\u0bc7\u0b95 \u0b9a\u0bbf\u0bbe\u0bbf\u0bb2\u0bcd, \u0b9a\u0bb0\u0bcd\u0b95\u0bbf\u1f9c\u0bb2\u0bb0\u0bcd \u1faa\u0ba4\u0bbf, \u0bae\u0b95\u0bcd\u0b95\u0bc1\u1fa4\u0bb5, \u0b95\u0bbe\u1fa2); \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0091 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 11. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 179 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u1f90; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0b95\u0bb2\u0baa\u0bcd\u1f97\u0baa\u0bcd \u0baa\u0baf\u0bbf\u0bb0\u0bcd\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0bc8\u0b95 \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u1f90; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u1f90 (\u0b89\u0bc8\u0b9f\u0bc8\u0bae \u0b85\u1f94\u0baa\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bb5\u0bb0\u0bcd: \u0bb9\u0baa\u0bcd\u0baa\u0bbe\u0bb5\u0ba9 \u0bb5\u0bbf\u0ba4\u0bbe\u0ba9\u0bc7\u0b95 \u0b9a\u0bbf\u0bbe\u0bbf\u0bb2\u0bcd, \u0b9a\u0bb0\u0bcd\u0b95\u0bbf\u1f9c\u0bb2\u0bb0\u0bcd \u1faa\u0ba4\u0bbf, \u0bae\u0b95\u0bcd\u0b95\u0bc1\u1fa4\u0bb5, \u0b95\u0bbe\u1fa2); \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0107 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd.",
