    ],
    "text": "Land Ministry's Ref. No.: LD/05/2001/IM/296.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
