    "bbox": [
      304.08,
      347.63,
      539.39,
      396.8
    ],
    "text": "Name of Land: Girawange Watta; Description: Garden, Contains Steps and Retaining Wall; Claimant: State; Original Claimant: P. A. Weerasekara, No. 25, Theldeniya Road, Menikhinna; Extent: 0.0040 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      3.119687795639038,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      398.24,
      539.42,
      638.23
    ],
    "text": "All persons interested in the aforesaid lands are hereby required to appear personally or by agent duly authorized in writing, before me at Divisional Secretariat Office, Kundasale of 24th August, 2016 on 9.30 a.m. and are hereby requested to notify to me in writing (in duplicate) on or before the 22nd August, 2016, the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said lands, the amount of compensation and the details of the computation of such amount. SAMANTHI D. NAGAHATHENNA, Divisional Secretary & Acquiring Officer, Kundasale. Divisional Secretary\u2019s Office, Kundasale, 14th July, 2016. 08 - 155",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.91920804977417,
      10.078991889953613
    ]
