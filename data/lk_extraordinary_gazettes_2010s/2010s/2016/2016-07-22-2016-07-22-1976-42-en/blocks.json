      65.04,
      616.64,
      122.28,
      626.76
    ],
    "text": "01. Lot No. 1",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      627.23,
      306.3,
      676.16
    ],
    "text": "Name of Land: Thannegedarawatta; Description: Open Waste land; Claimant: State; Original Claimant: R. M. I. P. Rajapaksha, No. 47, Pitawala, Menikhinna; Extent: 0.0040 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      3.119687795639038,
      10.078991889953613
