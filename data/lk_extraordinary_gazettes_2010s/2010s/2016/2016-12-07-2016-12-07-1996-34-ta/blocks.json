    "text": "21. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 261 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0baa\u0bbf\u0b9e\u0bcd\u0b9a\u0bbf\u0bc7\u0bb9\u0ba9 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bb9\u0b9f\u0bcd\u0b9f\u0b95\u0bb9 \u1f99\u0bb2\u0bc7\u0bb9\u0ba9 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b8e\u0bae\u0bcd\u0baa\u0bbf\u0bb2\u0bcd\u0bb2\u0b95\u0bb9\u1f99\u0bb2 \u0bc7\u0bb9\u0ba9; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0b95\u0bb2\u0baa\u0bcd\u1f97\u0baa\u0bcd \u0baa\u0baf\u0bbf\u0bb0\u0bcd\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0bc8\u0b95 \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0baa\u1f8c \u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u1f90; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0bb9\u0bbf\u0b9f\u0bcd\u1f8a\u0bb9\u0bbe\u0bae\u0bbf \u0b85\u0baa\u0bcd\u1f97\u0bb9\u0bbe\u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbe\u0bc7\u0b95 \u0b9a\u0bc1\u0b95\u0ba4\u0ba4\u0bbe\u0b9a \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b9a\u0bbf\u0bb2\u0bb0\u0bcd, \u0bbe\u0bbf\u0bb2\u0bcd\u0b92\u1fa4\u0bb5, \u0b95\u0bbf\u0bbe\u0bbf\u1f9c\u0bb2\u0bcd\u0bb2; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0127 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 22. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 262 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0baa\u0bbf\u0b9e\u0bcd\u0b9a\u0bbf\u0bc7\u0bb9\u0ba9, \u0b95\u0bb9\u0b9f\u0bcd\u0b9f\u0b95\u0bb9\u1f99\u0bb2 \u0bc7\u0bb9\u0ba9, \u0b8e\u0bae\u0bcd\u0baa\u0bbf\u0bb2\u0bcd\u0bb2\u0b95\u0bb9\u1f99\u0bb2 \u0bc7\u0bb9\u0ba9 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0baa\u0bbf\u0b9e\u0bcd\u0b9a\u0bbf\u0bc7\u0bb9\u0ba9 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0ba4\u0bbf; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0bb9\u0bbf\u0b9f\u0bcd\u1f8a\u0bb9\u0bbe\u0bae\u0bbf \u0b85\u0baa\u0bcd\u1f97\u0bb9\u0bbe\u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbe\u0bc7\u0b95 \u0b9a\u0bc1\u0b95\u0ba4\u0ba4\u0bbe\u0b9a \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b9a\u0bbf\u0bb2\u0bb0\u0bcd, \u0bbe\u0bbf\u0bb2\u0bcd\u0b92\u1fa4\u0bb5, \u0b95\u0bbf\u0bbe\u0bbf\u1f9c\u0bb2\u0bcd\u0bb2; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0178 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 23. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 263 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0baa\u0bbf\u0b9e\u0bcd\u0b9a\u0bbf\u0bc7\u0bb9\u0ba9 \u0b85\u0bb8\u0bcd\u0bc6\u0bb5\u0ba4\u0bcd\u1f90\u0bae; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u0bb5\u0baf\u0bb2\u0bcd; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0bb9\u0bbf\u0b9f\u0bcd\u1f8a\u0bb9\u0bbe\u0bae\u0bbf \u0b85\u0baa\u0bcd\u1f97\u0bb9\u0bbe\u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbe\u0bc7\u0b95 \u0b9a\u0bc1\u0b95\u0ba4\u0ba4\u0bbe\u0b9a, \u0b9a\u0ba8\u0bcd\u0ba4\u0bbe\u0ba9 \u0bb9\u0bbe\u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbe\u0bc7\u0b95 \u0b9a\u0bc1\u0b95\u0ba4\u0bcd \u0ba8\u0ba8\u0bcd\u0ba4\u0ba9 \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0, \u0bbe\u0bbf\u0bb2\u0bcd\u0b92\u1fa4\u0bb5, \u0b95\u0bbf\u0bbe\u0bbf\u1f9c\u0bb2\u0bcd\u0bb2; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0427 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 24. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 264 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0baa\u0bbf\u0b9e\u0bcd\u0b9a\u0bbf\u0bc7\u0bb9\u0ba9 \u0b85\u0bb8\u0bcd\u0bc6\u0bb5\u0ba4\u0bcd\u1f90\u0bae \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0baa\u0bbf\u0b9e\u0bcd\u0b9a\u0bbf\u0bc7\u0bb9\u0ba9\u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u0bb5\u0baf\u0bb2\u0bcd; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0bb9\u0bbf\u0b9f\u0bcd\u1f8a\u0bb9\u0bbe\u0bae\u0bbf \u0b85\u0baa\u0bcd\u1f97\u0bb9\u0bbe\u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbe\u0bc7\u0b95 \u0b9a\u0bc1\u0b95\u0ba4\u0ba4\u0bbe\u0b9a, \u0b9a\u0ba8\u0bcd\u0ba4\u0bbe\u0ba9 \u0bb9\u0bbe\u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbe\u0bc7\u0b95 \u0b9a\u0bc1\u0b95\u0ba4\u0bcd \u0ba8\u0ba8\u0bcd\u0ba4\u0ba9 \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0, \u0bbe\u0bbf\u0bb2\u0bcd\u0b92\u1fa4\u0bb5, \u0b95\u0bbf\u0bbe\u0bbf\u1f9c\u0bb2\u0bcd\u0bb2; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0457 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 25. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 265 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0baa\u0bbf\u0b9e\u0bcd\u0b9a\u0bbf\u0bc7\u0bb9\u0ba9\u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u0bb5\u0bbe\u0baf\u0bcd\u0b95\u0bcd\u0b95\u0bbe\u0bb2\u0bcd; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u1f90; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0150 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 26. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 266 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b95\u0bc1\u0b9f\u0bbe \u0b92\u0baf \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0baa\u0bbf\u0b9e\u0bcd\u0b9a\u0bbf\u0bc7\u0bb9\u0ba9 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u0b93\u0baf\u0bbe; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u1f90; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0199 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd.",
