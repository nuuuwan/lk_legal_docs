    ],
    "text": "\u0d8b\u01b1\u025e \u0db8\u0dd0\u0daf \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0d85\u01e9\u0dbb\u0dcf\u0db0\u021a\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb \u01e9\u0dc0\u0dbb\u0d9c\u023c \u0db4\u0dc5\u0dcf\u0dad \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u01e9\u0dc0\u0dbb\u0d9c\u023c \u0dd9\u0d9a\u02a4\u0dbb\u0dd9\u0262 \u0288\u029a \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d85\u01e9\u0dbb\u0dcf\u0db0\u021a\u0dbb \u0db1\u0dc0 \u0db1\u0d9c\u0dbb\u0dd9\u024f \u0d85\u0dc0\u0dc3\u0dcf\u0db1 \u0db1\u0d9c\u0dbb \u0218\u0249\u025e \u0d85\u0d82\u0d9a 03 \u028f \u0218\u028f\u0179 \u023d\u01e7\u01e6\u0dd9\u0daf\u02a4\u025e \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dc0 \u026a\u0286\u01e6 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0dab \u0dbd\u0daf 2015.12.30 \u01ce\u0db1\u0dd0\u01af \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 3815 \u0286\u0da7 3825 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0dd9\u0db4\u01e6\u01e9\u023c \u0d9a\u0dbb \u0d87\u01af \u023f\u029a \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0675 \u00fa \u0db4\u0db8\u0dab \u026d \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0db8\u0dcf\u0250\u023c \u01b1\u0dc5 \u0218\u028f\u0179 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca.",
