    ],
    "text": "\u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b9f\u0baa\u0bbf\u0bb3\u0bcd\u1f9d. \u0baa\u0bbf\u0bb0\u0ba3\u0bbe\u0ba8\u0bcd\u1f90; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0409 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 7. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 07 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b95\u0bc0\u0bb5\u0ba9\u0bb9\u0ba9\u0bc6\u0bb5\u0bb2; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1f9a\u1f8c\u0ba4\u0bc8\u0bb0, \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0b9a\u0bc8\u0baa); \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bc7\u0b9a\u0bbe\u0b95\u0bcd\u0b95\u0bbe \u0bc7\u0ba4\u0bbe\u0ba9\u0bbf\u0bb8\u0bcd, \u0b87\u0bb2. 100, \u0bc6\u0b95\u0bbe\u1fa8\u0bae\u0bcd\u1f97 \u1faa\u0ba4\u0bbf, \u0b9c\u0bbe-\u0b8e\u0bb2; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0081 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 8. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 08 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b95\u0bc0\u0bb5\u0ba9\u0bb9\u0ba9\u0bc6\u0bb5\u0bb2; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1f9a\u1f8c\u0ba4\u0bc8\u0bb0, \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0b9a\u0bc8\u0baa); \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b95\u0ba3\u0bcd\u1f8c\u0baa\u0bbf\u1f8a\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f \u0bb5\u0bbf\u0bb2\u0bcd\u0bc8\u0bb2; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0008 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 9. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 09 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b95\u0bc0\u0bb5\u0ba9\u0bb9\u0ba9\u0bc6\u0bb5\u0bb2; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1f9a\u1f8c\u0ba4\u0bc8\u0bb0, \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0b9a\u0bc8\u0baa); \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b9c\u0bc0. \u0bc7\u0b9c. \u0b8f. \u0ba8\u0bbf\u0bb9\u0bbe\u0bb2\u0bcd \u0bc7\u0ba4\u0bbe\u0ba9\u0bbf\u0bb8\u0bcd, \u0b87\u0bb2. 98, \u0bae\u0bc0\u0b95\u1f99\u0bb5 \u1faa\u0ba4\u0bbf, \u0b9c\u0bbe-\u0b8e\u0bb2; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0019 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 10. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 10 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b95\u0bc0\u0bb5\u0ba9\u0bb9\u0ba9\u0bc6\u0bb5\u0bb2; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1f9a\u1f8c\u0ba4\u0bc8\u0bb0, \u1faa\u0ba4\u0bbf (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0b9a\u0bc8\u0baa); \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0baa\u0bc0. \u0baa\u0bbf\u0bbe\u0bbf\u0ba9\u0bcd\u0b9a\u0bbf \u0bc7\u0bae\u0baa\u0bb2\u0bcd \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0008 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 11. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 11 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b95\u0bc0\u0bb5\u0ba9\u0bb9\u0ba9\u0bc6\u0bb5\u0bb2; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1f9a\u1f8c\u0ba4\u0bc8\u0bb0; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0baa\u0bc0. \u0b9f\u0baa\u0bbf\u0bb3\u0bcd\u1f9d. \u0bc7\u0ba4\u0bb5\u0baa\u0bbf\u0bbe\u0bbf\u0baf, \u0b87\u0bb2. 94, \u0bae\u0bc0\u0b95\u1f99\u0bb5 \u1faa\u0ba4\u0bbf, \u0b9c\u0bbe-\u0b8e\u0bb2; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0026 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 12. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 12 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b95\u0bc0\u0bb5\u0ba9\u0bb9\u0ba9\u0bc6\u0bb5\u0bb2; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1f9a\u1f8c\u0ba4\u0bc8\u0bb0; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b9c\u0bc0. \u0b9c\u0bc0. \u0ba4\u0bb0\u0bcd\u0bae\u0b9a\u0bbf\u0bbe\u0bbf, \u0b87\u0bb2. 92, \u0bae\u0bc0\u0b95\u1f99\u0bb5 \u1faa\u0ba4\u0bbf, \u0b9c\u0bbe-\u0b8e\u0bb2; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0040 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 13. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 13 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b95\u0bc0\u0bb5\u0ba9\u0bb9\u0ba9\u0bc6\u0bb5\u0bb2; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1f9a\u1f8c\u0ba4\u0bc8\u0bb0; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b8e\u0bb8\u0bcd. \u0b8f. \u0b8f. \u0baa\u0bc0. \u0bc6\u0bb0\u0bbe\u0b9f\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0b95\u0bc1; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0023 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 14. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 14 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b95\u0bc0\u0bb5\u0ba9\u0bb9\u0ba9\u0bc6\u0bb5\u0bb2; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1f9a\u1f8c\u0ba4\u0bc8\u0bb0; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b8e\u0bb2\u0b95\u0bcd\u0bc7\u0b9a\u0ba9\u0bcd\u0b9f\u0bb0\u0bcd \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0011 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. 15. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 15 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0b95\u0bc0\u0bb5\u0ba9\u0bb9\u0ba9\u0bc6\u0bb5\u0bb2; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1f9a\u1f8c\u0ba4\u0bc8\u0bb0; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0bb0\u0b9a\u0bc1; \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b8e\u0bae\u0bcd. \u0b8e\u0bb8\u0bcd. \u0bc7\u0b9c. \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0002 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd.",
