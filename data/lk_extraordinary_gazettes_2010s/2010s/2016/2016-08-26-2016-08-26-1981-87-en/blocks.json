      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      390.13,
      539.98,
      425.2
    ],
    "text": "BY virtue of the powers vested in me by the Section 22 read with Section 32 of the Excise Ordinance (Chapter 52), as amendedfrom time to time, I, Ravi Karunanayake, Minister of Finance, do by this declare that there shall be imposed an excise duty perbulk liter of following imported foreign liquor as per rules set out hereto and shall come into force on 01.09.2016.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      121.65,
      438.13,
      416.85,
      485.2
    ],
    "text": "(i)Foreign Malt LiquorRs.50.00(ii)Foreign WineRs.100.00(iii)Any other Foreign LiquorRs.200.00(which are not included in (i) and (ii) above)",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      451.89,
      500.53,
      535.87,
      511.6
    ],
    "text": "RAVI KARUNANAYAKE,",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      7.0,
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      512.53,
      534.33,
      559.6
    ],
    "text": "Minister of Finance.Ministry of Finance,Colombo 01,25th August 2016.",
