    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.17,
      398.17,
      546.32,
      493.24
    ],
    "text": "BY virtue of powers vested in me by Section 20(4) of the Universities Act, No. 16 of 1978, I, Lakshman Kiriella, the Ministerof Higher Education and Highways, on being satisfied that the administration of the affairs of the Gampaha WickramarachchiAyurveda Institute, Sri Lanka have been seriously dislocated and that the authorities of the said Institute have failed torestore normal conditions, do by this Order appoint Professor Jayantha Walihinda to be the Competent Authority with effectfrom August 27, 2016, for the purpose of exercising, performing or discharging in lieu of Director of Gampaha WickramarachchiAyurveda Institute Sri Lanka, any power,duty or function respectively which has been conferred or imposed on, or assignedto the said Director of the Gampaha Wickramarachchi Ayurveda Institute, Sri Lanka under the said Act, or any Order,Ordinance, Statue, by law, Regulation and the Rule made thereunder.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
