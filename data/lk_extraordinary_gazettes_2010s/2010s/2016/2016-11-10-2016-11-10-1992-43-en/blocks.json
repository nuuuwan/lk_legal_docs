      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      524.65,
      539.86,
      569.68
    ],
    "text": "The Industrial Disputes Regulations, 1958 published in Gazette Extraordinary No. 11688 of 2nd March 1959amended from time to time and as last amended and published in Gazette Extraordinary No. 1542/35 of 28th March2008 are hereby further amended in the Second Schedule thereto by the substitution for paragraph 2 of that Schedule ofthe following paragraph :-",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      581.17,
      539.86,
      603.52
    ],
    "text": "\u201c02\u2013 Subject as hereafter provided every arbitrator or a member of an Industrial Court, if he is not an officer ofthe Government of Sri Lanka, shall be entitled :-",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      107.25,
      615.13,
      371.9,
      626.2
    ],
    "text": "(1) For attendance at sittings, to a fee calculated at the rate of \u2013",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      131.13,
      637.69,
      506.18,
      648.76
    ],
    "text": "(a) Rupees 1,000/- for each sitting, if the duration of such sitting does not exceed one hour ;",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      131.13,
      660.25,
      539.86,
      682.6
    ],
    "text": "(b) Rupees 1,500/- for each sitting, if the duration of such sitting exceeds one hour and does not exceedthree hours ; and",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      131.85,
      694.21,
      479.14,
      705.28
    ],
    "text": "(c) Rupees 2,000/- for each sitting, if the duration of such sitting exceeds three hours.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      517.89,
      746.65,
      529.89,
      757.72
    ],
    "text": "1A",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
