  },
  {
    "page_number": 0,
    "bbox": [
      56.49,
      404.89,
      547.25,
      451.96
    ],
    "text": "ACTING under the powers vested in it by Section 10(1)(a) of the Consumer Affairs Authority Act, No. 09 of 2003, theConsumer Affairs Authority directs all manufacturers and traders of paints, varnishes and solvents used in the buildingindustry that on the bottles, packs or containers of such paints, varnishes and solvents the following information shall beprinted legibly.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      56.49,
      464.89,
      547.25,
      559.96
    ],
    "text": "(a)Batch No.(b)Date of Manufacture(c)Best before date(d)Volume(e)Maximum retail price(f)A Declaration to the effect that the total Lead content does not exceed the permissible maximum level of Leadcontent specified in Direction No. 36 issued by the Consumer Affairs Authority and published in Gazette NotificationNo. 1725/ 30, dated 30.09.2011.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      56.49,
      572.89,
      547.17,
      595.96
    ],
    "text": "The Consumer Affairs Authority do by this Direction, rescind Direction No. 50 published, in Gazette ExtraordinaryNo. 1875/38 dated 15th August 2014.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      92.49,
      608.89,
      328.79,
      619.96
    ],
    "text": "This Direction shall come into effect from 1st January, 2017.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
