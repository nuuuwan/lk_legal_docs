4\u0bbe\u0ba9 \u0bc7\u0baa\u0bae\u0bb5\u0ba4\u0bc0 525420060v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 48\u0b8f, \u1f81\u1fa8\u0baa\u0ba4, \u0bc6\u0baa\u0bbe\u1f81\u1f8e\u0bb5\u0bbf\u0b9f. 136 0.0525 \u0bb2\u0bb9\u0bbf\u1f9e \u0b9a\u1fbb\u0baa\u1fb7 \u0b85\u0bc7\u0baa\u0b9a\u0bbf\u1fb1\u0bb9 892620393v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97\u0b85\u0bc7\u0baa\u0b9a\u0bbf\u1fb1\u0bb9\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u1fb9 \u2013 \u0b87\u0bb2. 32/1, \u1f81\u1fa8\u0baa\u0ba4, \u0bc6\u0baa\u0bbe\u1f81\u1f8e\u0bb5\u0bbf\u0b9f. \u1f81\u0bb2\u0bb0\u1fb7\u0ba9 \u0bae\u1fbe\u1fa0\u1fbb \u0b9c\u0baf\u0bc6\u0b95\u0bbe\u1f8a \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0b85\u0b9c\u0bbf\u0ba4\u0bbe \u0bae\u1fbf\u0b95\u0bbe\u1fb8\u0ba4\u0bbf \u0b8e\u1fb9\u0baa\u0bb5\u0bb0\u1f90 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 137 0.0645 \u0bc7\u0bb9\u0bb0\u1fb7 \u1f99\u0ba4\u0bbf\u0baf\u1fb9\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0bb0\u0b9a\u0bbf\u0b95\u0bbe 846870407v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u1fb1\u0b95\u0bbf\u0b95\u0bbe \u0bb2\u1fb0\u0bae\u0bbe\u1fa2 \u0bc7\u0bb9\u0bb0\u1fb7 \u0b87\u0bb2. 27, \u1f81\u1fa8\u0baa\u0ba4 \u0baa\u0bbe\u0b9f\u0b9a\u0bbe\u0bc8\u0bb2 \u0b85\u1f9e\u0b95\u0bbe\u0bc8\u0bae, \u1f81\u1fa8\u0baa\u0ba4, \u0bc6\u0baa\u0bbe\u1f81\u1f8e\u0bb5\u0bbf\u0b9f. 139 0.0075 \u0b85\u0bc7\u0baa\u0b9a\u0bbf\u1fb1\u0bb9\u0bc7\u0b95 \u0bc6\u0ba4\u0bbe\u1fb9 \u0b9c\u0baf\u0bc7\u0b9a\u0ba9 612640114v \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u2013 \u2013 \u0b87\u0bb2. 46/1, \u1f81\u1fa8\u0baa\u0ba4, \u0bc6\u0baa\u0bbe\u1f81\u1f8e\u0bb5\u0bbf\u0b9f.",
