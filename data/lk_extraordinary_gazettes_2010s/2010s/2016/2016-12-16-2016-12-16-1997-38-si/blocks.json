    "text": "(14 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba) \u0d8b\u00fa\u0dad \u0275\u0259\u0dc2\u0dba \u0dba\u0da7\u0dd9\u01ae 2016 \u0d85\u0dd9\u0d9c\u02a4\u0dc3\u0dca\u01b1 \u0db8\u0dc3 02 \u0dc0\u0db1 \u01ce\u0db1 \u0d85\u0d82\u0d9a 1978/10 \u0daf\u0dbb\u0dab \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u02a2\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dbd\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db6\u0dc3\u0dca\u0db1\u0dcf\u028f\u0dbb \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0dd9\u0d9a\u02a3\u0dc5\u0db9 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f \u0dbb\u01ae\u0db8\u0dbd\u0dcf\u0db1 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc1\u0dd9\u024f \u0d85\u0d82\u0d9a 543 - \u0d85\u01ae\u01af\u018b\u0dba \u0d8b\u01b1\u0dbb \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025d \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc1\u0dba \u01b1\u0dc5 \u0d85\u01ae\u01af\u018b\u0dba \u0d8b\u01b1\u0dbb \u0db1\u0db8\u0dd0\u01af \u0d9c\u0dd9\u023c \u0218\u028f\u0179\u0dba\u0dcf \u026d \u0daf, \u0d85\u0d82\u0d9a 521010 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0dd9\u023c \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 12 \u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 293 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d91\u028f \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u0dba\u028f; 1) \u201c\u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca\u0dd9\u0118 \u01b0\u0dbb\u0dab \u021d\u0d9a\u0dcf\u0dc1\u0dd9\u024f 55 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u021d\u0d9a\u0dcf\u0dbb \u0dba\u01e6\u0db1 \u0d89\u0dc0\u01ae \u0d9a\u0dbb 12 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u021d\u0d9a\u0dcf\u0dbb \u0dba\u01e6\u0db1 \u0d87\u01b1\u0dbd\u01ae \u0d9a\u0dbb , 2) \u201c\u026a\u01e7\u0dc1\u0dca\u0da0\u0dba\u01e6 \u0dc3\u0dc4 \u0d89\u01e6\u0dd9\u0da2\u01e6\u0dc2\u01e6 \u0dad\u0dc4\u0db1\u023c \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf \u0dd9\u0dc0\u01e6 \u0d87\u01af \u0d8b\u0d9a\u0dc3\u0dca \u0dc4\u0dcf \u0db6\u0dd0\u01fe\u023c \u0218\u0298\u0db6\u0db3 \u026a\u0dc3\u0dca\u0dad\u0dbb\u201d \u0dba\u0db1 \u01b0\u025e\u0dc0\u0da7 \u201c\u0db8\u0118\u0dd9\u0d9c\u02a3\u0db1\u0dd9\u0118 \u0dbb\u0dcf\u01e7 \u021d\u0db1\u0dcf\u01e6\u01d0 \u0dba\u0db1 \u0d85\u0dba\u0dd9\u0118 \u0150\u026a\u0dad \u0236\u00fa\u01af\u0dba\u0da7 \u0dba\u0da7\u01ae\u0dc0\u201d \u0dba\u01e6\u0db1 \u0d87\u01b1\u0dbd\u01ae \u0d9a\u0dbb \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229. \u0dd9\u00fa.\u0d92.\u0dd9\u00fa. \u0dbb\u0d82\u014f\u01ae \u0db0\u0259\u0db8\u0db4\u0dcf\u0dbd, \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca 2016 \u0dd9\u0daf\u0dc3\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 08 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd \u0dbb\u0da2\u0db8\u0262\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbb, \u201c\u023d\u028f\u0d9a\u0dad \u0db8\u0dd0\u01ff\u0dbb\u201d, \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dd9\u0269 \u01cf \u0dba.",
