    "text": "\u0d8b\u01b1\u025e \u0db8\u0dd0\u0daf \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0dd9\u0db4\u02a3\u0dd9\u0dc5\u02a3\u01e6\u0db1\u025e\u0dc0 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u028f\u0137\u0dbb\u00fa\u0dd9\u0d9c\u02a3\u0da9 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u023d\u01e6\u0dd9\u01e6\u025c\u0dba \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 \u0db8\u0dd0\u0db1 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb 2015.10.28 \u01ce\u0db1\u0dd0\u01af \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u023c \u0d85\u0d82\u0d9a 120134 \u0d9a\u0dbd\u0dcf\u0db4 03 \u01e6 02 \u0dc0\u0dd0\u01e7 \u0d9a\u0dbd\u0dcf\u0db4\u0dd9\u024f \u0db4\u01b4 \u0d85\u0d82\u0d9a 10 \u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 173 \u0dc4\u0dcf 175 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0db4\u0da7\u0218\u0298\u0d9a\u01e6\u0daf \u0d9a\u0dd0\u0dd9\u0262 \u0db1\u0db8\u0dd0\u01af \u0d89\u0da9\u0dd9\u023c \u023f\u029a \u0d89\u0da9\u023c \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.1104 \u00fa \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0db4\u0dc4\u0dad \u0db8\u0dcf\u0250\u023c \u01b1\u0dc5 \u0218\u028f\u0179 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0dd9\u0daf\u0d9a, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a\u0dba 173 \u2014 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0db4\u0da7\u0218\u0298\u0d9a\u01e6\u0daf \u0d9a\u0dd0\u0dd9\u0262 ;\u0d89\u0da9\u0dd9\u023c \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259. 0.0866. \u0db8\u0dcf\u0250\u023c \u2014: \u0d8b\u01b1\u0dbb\u0da7 : 44 \u0dc4\u0dcf 46 \u0dc0\u0dd0\u01e7 \u0d9a\u0dd0\u0db6\u0263; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7 : 46 \u0dc4\u0dcf 174 \u0dc0\u0dd0\u01e7 \u0d9a\u0dd0\u0db6\u0263; \u0daf\u00fd\u0dab\u0da7 : 174 \u0dc4\u0dcf 175 \u0dc0\u0dd0\u0