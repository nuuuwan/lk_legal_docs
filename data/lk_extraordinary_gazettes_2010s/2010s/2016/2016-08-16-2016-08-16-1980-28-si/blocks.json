    "text": "\u0263\u0dba\u01ca\u0daf, \u0d9a\u0dc4\u01e6\u0dd9\u0d9c\u02a3\u0da9 \u0263\u0dba\u01ca\u0daf, \u0dbb\u0daf\u0dcf\u0263\u0dba\u01ca\u0daf \u0d85\u0dc3\u0dca\u0dc0\u0dd0\u01ca\u01d0\u0db8, \u0db8\u0dc4\u00fd\u0249\u0dbb \u0d85\u0dc3\u0dca\u0dc0\u0dd0\u01ca\u01d0\u0db8 \u0db1\u0db8\u0dd0\u01af \u0d89\u0da9\u0db8 \u0dd9\u0db4\u02a3\u01d0 \u0d9a\u0da7\u0252\u01b1 \u0dc3\u0db3\u0dc4\u0dcf \u01e7\u026a\u01af\u0d9c\u0dbd \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 7 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0d85\u0d82\u0d9a 1622/23 \u0dc4\u0dcf 2009/10/07 \u01ce\u0db1\u0dd0\u01af \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u02a2\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5 \u0d9a\u0dc5 \u0daf\u0dd0\u01e6\u026b\u0dd9\u0db8\u028f \u0dc3\u0db3\u0dc4\u01e6, \u201c\u0d89\u0da9\u0db8 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85.\u0d9c.\u0286. 36\u028f \u0d85\u01af\u0dd9\u0259\u0d9a \u0d85\u0d82\u0d9a 86 \u0daf\u0dbb\u0db1 \u0218\u0249\u0dd9\u0259 \u0d85\u0d82\u0d9a \u0d86\u0259/\u0d91\u01e6\u026b/\u017a 2008/62 \u0dc4\u0dcf 2009.07.10 \u01ce\u0db1\u0dd0\u01af \u0d85\u01e9\u0dd9\u0259\u0d9b\u0db1\u0dd9\u024f\u201d \u0dba\u01e6\u0dd9\u0db1\u028f \u0d85\u0d82\u0d9a \u0d86\u0259/\u0d91\u01e6\u026b/\u017a 2008/62 \u0dc4\u0dcf 2009.07.10 \u01ce\u0db1\u0dd0\u01af \u0d85\u01e9\u0dd9\u0259\u0d9b\u0db1\u0dd9\u024f \u0dba\u01e6\u0db1 \u0d89\u0dc0\u01ae \u026a\u0dba \u0252\u01b1 \u0dba. \u0d92 \u0d85\u01e9\u0dc0 \u201c\u0d89\u0da9\u0db8 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \