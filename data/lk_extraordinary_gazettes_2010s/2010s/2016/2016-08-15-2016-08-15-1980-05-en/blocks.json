  {
    "page_number": 0,
    "bbox": [
      47.85,
      364.33,
      539.92,
      411.4
    ],
    "text": "I, Ediriweera Weerawardena, Minister of Central Provincial Road Development, Transport, Power and Energy and Housingand Construction regulate the following with effect from 22.08.2016 as per the powers bestowed on me by the 20thStatement to be read along with the Statement No. 24(2)(1)(xiii) of the Passenger Transporting Statute No. 04 of 1992 andthe Statements No. 19(N) and (T) of the Central Provincial Passenger Transport Services Authority Statute No. 01 of 2000.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      260.49,
      424.33,
      327.21,
      435.4
    ],
    "text": "REGULATIONS",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      448.33,
      539.91,
      495.4
    ],
    "text": "A passenger travelling in a bus licensed under the Central Provincial Passenger Transport Services Authority,should acquire a valid ticket approved by the transport services authority which indicates the amount relevant to one'sdestination and the starting point and the end point, and should also keep it with oneself from the begining to the end of thejourney. If not, he/she will be subjected to a local service charge of Rs. 250 plus double the amount of the full fare.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
