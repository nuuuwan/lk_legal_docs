  {
    "page_number": 1,
    "bbox": [
      47.83,
      144.49,
      539.99,
      215.56
    ],
    "text": "The decision made by the Wages Board for the Rubber Growing Manufacturing Trade and set out in the scheduleto the notification published in Gazette Extraordinary No. 10047 dated 25 th November 1949 re-established as WagesBoard for the Rubber Cultivation and Raw Rubber Processing Trade in the notification published in Gazette ExtraordinaryNo. 1913/ 5 dated 05 th May 2015, with reference to the aforesaid decisions as varied from time to time and lastly variedby the notification published in the Gazette Extraordinary No. 1870/3 dated 07 th July 2014, shall be further varied bythe substitution of the following new part instead of the part III (a) and (b).",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      237.19,
      229.38,
      350.59,
      239.34
    ],
    "text": "PART III - OVERTIME RATE",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      9.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      47.83,
      252.49,
      539.91,
      275.56
    ],
    "text": "In respect of each hour of work in excess of normal working day, the minimum overtime rate shall be the minimumhourly rate (ascertained by dividing the daily minimum rate of wages of time rate by 8) increased by 50%.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
