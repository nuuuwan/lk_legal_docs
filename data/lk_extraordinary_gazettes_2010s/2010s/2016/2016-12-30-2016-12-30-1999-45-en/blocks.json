  {
    "page_number": 0,
    "bbox": [
      50.64,
      404.96,
      286.44,
      481.28
    ],
    "text": "I hereby give Notice under Sub-section (1) of Section 7 of the Land Acquisition Act No. 28 of 1964, (Amendment) that the Government intends to acquire the following land which is required for a public purpose:- Description of the lands to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.039495944976807,
      7.91920804977417,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      482.48,
      286.45,
      549.92
    ],
    "text": "Allotments of land in extent about 0.0151 Hectare depicted in Plan No. Ke/3519 prepared by Surveyor General situated in the Village of Bisowela in Beligal Korale East Division in the Divisional Secretary\u2019s Division, Galigamuwa in the District of Kegalle in Sabaragamuwa Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      550.41,
      286.41,
      600.56
    ],
    "text": "1. Lot No. 01 Name of the Land: Bibile Kumbura Now Watta; Name of the Claimant: R. A. Sumanawathi, No.39, Bisowela, Galigamuwa Town; Extent: 0.0147",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.079591751098633,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      331.28,
      539.37,
      375.92
    ],
    "text": "2. Lot No. 02 Name of the Land: Bibile Kumbura Now Watta; Name of the Claimant: R. A. Sumanawathi, No.39, Bisowela, Galigamuwa Town; Extent: 0.0004",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      377.36,
      539.46,
      502.4
    ],
    "text": "All Persons interested in the aforesaid lands are hereby required to appear personally, or by agents duly authorized in writing before me at Divisional Secretariat, Galigamuwa on the day of 25th January 2017 and at 10.00 a.m. and are hereby requested to notify me in writing with duplicate of on or before 18th January 2017 the nature of their interest in the land, the particulars of their claims for compensation for acquisition of the said land the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
