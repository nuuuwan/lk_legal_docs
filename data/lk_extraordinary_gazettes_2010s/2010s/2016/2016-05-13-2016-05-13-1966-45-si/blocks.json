    "text": "\u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a \u2013 03 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0daf\u0262\u0db4\u01ae\u0d8b\u0262\u0dd9\u0262 \u0d9a\u0249\u0dbb \u0dd9\u0db1\u02a3\u0dd9\u0dc4\u02a3\u01ae \u0d9c\u0262\u0dd9\u0dbd\u0dd9\u01e6 \u00fd\u0249\u0dbb, \u00fb\u01e7\u0d9c\u0db8\u0dd9\u0118 \u00fd\u0249\u0dbb \u0db4\u0dc4\u0dbd \u0dc0\u0dbd\u0dd9\u0d9c\u02a3\u0da9\u0dd9\u0d9c\u0dd9\u0daf\u01e7\u0dba \u00fd\u0249\u0dbb \u0d92\u0daf\u019c\u0da9 \u00fd\u0249\u0dbb \u0dc3\u0dc4 \u0d85\u0da7\u0dbd\u0dcf\u0db7 \u0dd9\u0dc4\u0dc0\u01ae \u0dc0\u0dd1\u0d9c\u01e6\u0dad\u0dd9\u0262 \u00fd\u0249\u0dbb; \u028f\u023d\u0d9a\u023c \u0db4\u0dcf\u01e6\u0db1\u0dcf\u0dd9\u0118 \u0db1\u0db8 \u0dc3\u0dc4 \u0263\u0218\u0db1\u0dba: \u0d91\u013c. \u0d91\u023c. \u00fb\u0d82\u0dc3\u0dca\u0263 \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf, 467/2, \u028f\u0262 \u0dd9\u0d9a\u02a3\u0dd9\u0178\u014e \u0dbb\u01e6\u0dc0\u0dbd \u0dc3\u0dc4 \u0da9\u0229\u0263\u0269. \u0d91\u023c. \u0d91\u0dc3\u0dca. \u0dc0\u01e6\u01e7\u0db1\u0dcf\u0dba\u0d9a, \u0dc0\u0262\u0dd9\u0daf\u01e7\u0dba \u0d9a\u0dd1\u0d9c\u0262\u0dbd, \u0d91\u0dc3\u0dca. \u0d86\u0259. \u0da9\u0229\u0263\u0269. \u018c. \u0dd9\u0dc3\u02a2\u0db1\u0dcf\u0db1\u0dcf\u0dba\u0d9a, \u0286\u01b1\u023d\u0dab, \u0db4\u0dc4\u0dc5 \u0dd9\u0d9c\u0daf\u0dbb, \u0dc0\u0262\u0dd9\u0daf\u01e7\u0dba \u0d9a\u0dd1\u0d9c\u0262\u0dbd, \u0dd9\u014e. \u017a. \u0d9a\u025e\u0dab\u0dcf\u0dbb\u01ae\u0db1 \u0dc3\u0dc4 \u0dd9\u014e. \u017a. \u0daf\u023c\u023d\u0d9a\u0dcf \u0288\u0dbd\u00fa\u027f \u0da2\u0dba\u0db6\u0dcf\u0291, \u0dc0\u0262\u0dd9\u0daf\u01e7\u0dba, \u0d9a\u0dd1\u0d9c\u0262\u0dbd, \u0da0\u01e6\u0daf\u0db1 \u0d9a\u029a\u0d86\u0dbb\u013c\u013d, \u0d85\u0d82\u0d9a 99 \u0db4\u0dbb\u0d9c\u023c\u0db8\u0db1, \u0d9a\u0dd1\u0d9c\u0262\u0dbd, \u0da9\u0229\u0263\u0269. \u0d91\u0dc3\u0dca. \u026a\u0db8\u0dbd\u0dd9\u0dc3\u02a2\u0db1, \u0dd9\u01ca\u0dc0\u0dcf\u0dd9\u0262\u0d9c\u0db8, \u0d9a\u0dd1\u0d9c\u0262\u0dbd \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba