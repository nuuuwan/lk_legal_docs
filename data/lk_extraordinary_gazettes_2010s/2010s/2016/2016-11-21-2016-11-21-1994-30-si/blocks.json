    "text": "\u0db8\u0db0\u0255\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0db8\u0dcf\u0dad\u0dd9\u0262 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0dbd\u0118\u0d9c\u0dbd \u0db4\u0262\u0dd9\u0262\u0d9c\u0db8 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0dbd\u0118\u0d9c\u0dbd \u0d8b\u0da9\u0286\u0dba \u0db4\u01ae\u01b1\u0dd9\u0269 \u0d85\u0d82\u0d9a \u0d8a 386 \u0d87\u0da7\u01e6\u0dc0\u0dbd \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025d \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d87\u0da7\u01e6\u0dc0\u0dbd \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0d9a\u0dbd\u0dc0\u0dd0\u0dbd\u023f\u0262\u0dbd \u0d89\u0da9\u0dd9\u023c \u0dc3\u0259\u0dd9\u0269 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 2014.11.28 \u0dc0\u0dd0\u01e7 \u01ce\u0db1\u0dd0\u01af\u0dc0 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0237\u0dbd\u00fa\u0dc2\u0dab\u0dcf\u01ae\u0db8\u0d9a \u0240\u0263\u0d9a \u0218\u0249\u025e 21, \u0d85\u01b1\u025e \u0218\u0249\u025e 67 \u0db4\u01b4 23 \u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 882 \u028f \u023f\u029a \u0dc0\u0259\u0d9c\u0db5\u0dbd\u0dba \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0804",
