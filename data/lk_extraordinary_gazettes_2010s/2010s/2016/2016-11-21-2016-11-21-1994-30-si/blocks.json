    ],
    "text": "\u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u02a3\u0dd9\u0dbb\u02a3\u01ae\u01b1\u0dc0\u0db1 \u0d89\u0da9\u0dd9\u023c \u026a\u0dc3\u0dca\u0dad\u0dbb : \u00fd\u025e\u0dab\u0dd1\u0d9c\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u00fd\u0263\u0dba\u0dcf\u0218\u0179\u0dba \u0db6\u0da7\u028f\u0dbb \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, 1158 \u0d87\u0dc3\u0dca\u0dc3\u0dd0\u01ca\u01d0\u0db8 \u011e\u0dcf\u0db8 \u01e7\u0dc5\u0db0\u0dcf\u025c \u0dc0\u0dc3\u0dd9\u023c \u0218\u028f\u0179, \u027c \u0dbd\u0d82\u0d9a\u0dcf \u023d\u01e7\u01e6\u0dd9\u0daf\u02a4\u025e \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dc0 \u026a\u0286\u01e6 \u0db8\u0dd0\u0db1 \u0218\u0298\u0dd9\u0dba\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a \u0dd9\u00fa\u0253/\u0dd9\u00fa\u0219\u0da9\u0229\u0263\u0269/2016/477 \u0dc4\u0dcf \u0d85.\u0d9c.\u0218. 976 \u028f \u0d85\u01af\u0dd9\u0259\u0d9a \u0d85\u0d82\u0d9a 13 \u0db4\u01b4 \u0d85\u0d82\u0d9a 08 \u0daf\u0dbb\u0db1 \u0218\u0249\u0dd9\u0dbb\u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 73, 74 \u0dba\u0db1 \u0d89\u0da9\u023c. \u0d85.\u0d9c.\u0218. 976 1. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 73 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0db4\u0dbb\u0d9c\u0dc4\u023f\u0dbd\u0dd9\u0dc4\u02a2\u0db1, \u01af\u0247\u025c\u0d9c\u0dc4\u0218\u0179\u0dba\u0dd9\u0dc4\u02a2\u0db1, \u0d9a\u0dc4\u0da7\u0d9c\u0dc4\u023f\u0dbd\u0dd9\u0dc4\u02a2\u0db1, \u0db1\u0dcf\u0dd9\u0d9c\u02a3\u0262\u0dbd\u0dd9\u0dc4\u02a2\u0db1, \u0db1\u0dcf\u0dd9\u0d9c\u02a3\u0262\u0dbd\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u0d9a\u0dc4\u0da7\u0d9c\u0dc4\u023f\u0dbd \u0dc0\u01ae\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0d89\u0da9\u023c \u0d85\u01ae\u0db4\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 38 (\u0d85) \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dbb\u0da2\u0dba\u0da7 \u0db4\u0dc0\u0dbb\u0dcf \u0d9c\u01e6\u0db1\u0dcf \u0dbd\u01cf. \u023f\u0262 \u028f\u023d\u0d9a\u0db8 - \u0d91\u023c. \u0253. \u0d89\u0dbb\u01e6\u0dad \u0daf \u0286\u0262\u0dc0\u0dcf, \u0d85\u0d82\u0d9a: 798/1, \u0d9c\u0dd0\u023f\u01a0 \u0db8\u0dcf\u0dc0\u0dad, \u0d87\u0dc3\u0dca\u0dc0\u0dd0\u01ca\u01d0\u0db8, \u00fd\u0263\u0dba\u0dcf\u0218\u0179\u0dba, \u0d85\u01ae\u0db4\u01ae \u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u023c \u0d9a\u0da7\u0252\u01b1 \u0d85\u0dc0\u0dc3\u01e6 \u00fb\u025c\u0db8 \u0dc3\u0daf\u0dc4\u0dcf; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.5119. \u0db8\u0dcf\u0250\u023c : \u0d8b\u01b1\u0dbb\u0da7: \u0d85\u0dc3\u0dca\u0dc3\u0dd0\u01ca\u01d0\u0db8 \u0d94\u0dba; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0d85\u0dc3\u0dca\u0dc3\u0dd0\u01ca\u01d0\u0db8 \u0d94\u0dba; \u0daf\u00fd\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 5AA \u0dc0\u0dd0\u01e7 \u022a\u023c \u0d9a\u0dd0\u0db6\u0dd0\u0262\u0dbd \u0dc3\u0dc4 \u0db8\u0dcf\u0259\u0d9c\u0dba; \u0db6\u0dc3\u0dca\u0db1\u0dcf\u028f\u0dbb\u0da7: \u0db8\u0dcf\u0259\u0d9c\u0dba. 2. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 74 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0db4\u0dbb\u0d9c\u0dc4\u023f\u0dbd\u0dd9\u0dc4\u02a2\u0db1, \u01af\u0247\u025c\u0d9c\u0dc4\u0218\u0179\u0dba\u0dd9\u0dc4\u02a2\u0db1, \u0d9a\u0dc4\u0da7\u0d9c\u0dc4\u023f\u0dbd\u0dd9\u0dc4\u02a2\u0db1, \u0db1\u0dcf\u0dd9\u0d9c\u02a3\u0262\u0dbd\u0dd9\u0dc4\u02a2\u0db1, \u0db1\u0dcf\u0dd9\u0d9c\u02a3\u0262\u0dbd\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u0d9a\u0dc4\u0da7\u0d9c\u0dc4\u023f\u0dbd \u0dc0\u01ae\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0d89\u0da9\u023c \u0d85\u01ae\u0db4\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 38 (\u0d85) \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dbb\u0da2\u0dba\u0da7 \u0db4\u0dc0\u0dbb\u0dcf \u0d9c\u01e6\u0db1\u0dcf \u0dbd\u01cf. \u023f\u0262 \u028f\u023d\u0d9a\u0db8 - \u0d91\u023c. \u0253. \u0d89\u0dbb\u01e6\u0dad \u0daf \u0286\u0262\u0dc0\u0dcf, \u0d85\u0d82\u0d9a: 798/1, \u0d9c\u0dd0\u023f\u01a0 \u0db8\u0dcf\u0dc0\u0dad, \u0d87\u0dc3\u0dca\u0dc0\u0dd0\u01ca\u01d0\u0db8, \u00fd\u0263\u0dba\u0dcf\u0218\u0179\u0dba, \u0d85\u01ae\u0db4\u01ae \u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u023c \u0d9a\u0da7\u0252\u01b1 \u0d85\u0dc0\u0dc3\u01e6 \u00fb\u025c\u0db8 \u0dc3\u0daf\u0dc4\u0dcf; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0482. \u0db8\u0dcf\u0250\u023c \u0d8b\u01b1\u0dbb\u0da7: \u0db8\u0dcf\u0259\u0d9c\u0dba; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0db8\u0dcf\u0259\u0d9c\u0dba; \u0daf\u00fd\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 5AA \u0dc3\u0dc4 5AB \u0dc0\u0dd0\u01e7 \u022a\u023c \u0d9a\u0dd0\u0db6\u0263; \u0db6\u0dc3\u0dca\u0db1\u0dcf\u028f\u0dbb\u0da7: \u0d85\u0dc3\u0dca\u0dc3\u0dd0\u01ca\u01d0\u0db8 \u0d94\u0dba.",
