    "bbox": [
      65.04,
      500.72,
      263.16,
      588.6
    ],
    "text": "Preliminary Plan: Ya 2846 Situation: Village : Manipay J/140 DS Division: Valikaman South West, Sandilipay District: Jaffna Province: Norhern 1. Lot No. 01",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.039495944976807,
      10.078991889953613
