    "bbox": [
      50.64,
      588.82,
      286.44,
      614.96
    ],
    "text": "Name of the Land: Piddiny Vayal or Piddiny; Description: Garden contains 3 permanent Buildings, 1",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      3.119687795639038,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      331.28,
      539.37,
      364.4
    ],
    "text": "temporary building, 1 masonry well and a pit; Claimant: Velautham Masilamani and wife Thavamalar; Extent: 0.4078 Hectare.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      365.33,
      539.51,
      487.28
    ],
    "text": "All Persons interested in the aforesaid land are hereby required to appear personally, or by agents duly authorized in writing before me at Valikamam South West, Sandilippay DS Office on the day 27th day of February 2017 at 10.00 a.m. and hereby requested to notify to me in writing (in duplicate) on or before the day 16th of February 2017, the nature of their interests in the land, the particulars of their claims for compensation for the Acquisition of the said land, the amount of compensation and the details of the Computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      6.959303855895996,
      10.078991889953613
    ]
