  {
    "page_number": 0,
    "bbox": [
      47.85,
      399.13,
      539.91,
      446.32
    ],
    "text": "IT is hereby notified that by virtue of powers vested in me under Section 17 of the Customs Ordinance (Chapter 235)I, W. A. Chulananda Perera, Director General of Customs, determine that with effect from 10th October, 2016, all duties ofCustoms as well as other charges, penalties and forfeitures incurred under the Customs Ordinance (Chapter 235), shall bepaid and received at the Rates of Exchange set out in the Schedule.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      453.25,
      539.85,
      488.32
    ],
    "text": "The notification relating to the Rates of Exchange published in Gazette Extraordinary, No. 1987/1 of 03rdOctober, 2016 is hereby rescinded and the said Rates of Exchange are Scheduled to be rescinded by a similar notificationto be published on or before 16th October, 2016.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
