      590.89,
      295.08,
      625.96
    ],
    "text": "Lot No. 01Name of land: Mappapulam; Description: Garden containssix permanent buildings, Part of one permanent building, Part",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
