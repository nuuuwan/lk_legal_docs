      295.31,
      575.56
    ],
    "text": "Preliminary Plan: Ya 2843; Situation: Village - Pandath-tharippu J/146; DS Division: Valikamam South West,Sandilipay; District: Jaffna; Province: Northern.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
