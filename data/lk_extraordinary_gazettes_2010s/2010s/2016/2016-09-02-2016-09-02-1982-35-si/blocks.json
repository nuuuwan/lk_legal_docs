    "text": "\u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0d9c\u0dcf\u0262\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f \u0d9c\u0dcf\u0262\u0dbd \u0d9a\u0da9\u0dc0\u01ae \u0dc3\u0dad\u0dbb \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d9c\u0dcf\u0262\u0dbd \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0287\u0db8\u0dcf\u0dc0 \u01b1\u0dc5 99B, \u0dd9\u0db4\u0178\u0179\u0d9c\u0dbd\u0dc0\u01ae\u0dad \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0dd9\u0db4\u0178\u0179\u0d9c\u0dbd\u0dc0\u01ae\u0dad \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 \u0db8\u0dd0\u0db1 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u023c \u0d85\u0d82\u0d9a 810028 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0218\u0249\u0dd9\u0259 \u0d9a\u0dbd\u0dcf\u0db4 02 \u0db4\u01b4 \u0d85\u0d82\u0d9a03 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 113, 114, 118, 119, 120, 123, 124, 125, 128, 129, 130, 132, 133, 134, 137, 138 \u0dd9\u0dbd\u0dc3 \u0dd9\u0db4\u01e6\u01e9\u023c \u0d9a\u0dbb \u0d87\u01af \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.2133 \u00fa \u026d \u0db4\u0dc4\u0dad \u0db1\u023c \u0dc0\u0263\u01e6 \u0dc3\u0dc4 \u0db8\u0dcf\u0250\u023c \u0dc0\u0263\u01e6 \u0252\u01ae \u022a\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dcf\u0250\u023c. 1. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 113 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0db1\u0dd0\u0dad; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u01d0\u023c\u025c\u0dba \u0db8\u0dcf\u0259\u0d9c\u0dba \u0dc3\u0dc4 \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u023f\u0262 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u01e6\u0db1