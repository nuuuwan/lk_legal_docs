      49.65,
      363.61,
      538.01,
      374.68
    ],
    "text": "Method for Determination of Customs Value under the Schedule \u2018E\u2019 of the Customs (Amendment) Act, No. 2 of",
    "fonts": [
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
