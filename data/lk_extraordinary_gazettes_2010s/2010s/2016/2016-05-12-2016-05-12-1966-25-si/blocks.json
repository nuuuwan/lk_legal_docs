    ],
    "text": "\u0dbd\u0db6\u0dcf\u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0db6\u0dbd\u0dcf \u0dd9\u0db4\u02a3 \u0dd9\u0dbb\u02a3\u01ae\u01b1 \u0dc0\u0db1 *\u0d89\u0da9\u0dd9\u023c / \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dd9\u0269 \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0d9c\u0dcf\u0262\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a \u0dd9\u024f, \u0d85\u00fa\u023e\u0db8\u0db1 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, 112 \u0d92, \u0dc0\u0dbd\u0dc4\u01e6\u01d1\u0dc0 \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025d \u0dc0\u0dc3\u0dd9\u023c \u0dc0\u0dbd\u0dc4\u01e6\u01d1\u0dc0 \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0db8\u0dd0\u01e9\u023c\u0db4\u01af \u026a\u0286\u01e6 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u023f.\u0218.\u0d9c\u0dcf. 4137 \u0dc4\u0dcf 2015.12.31 \u01ce\u0db1\u0dd0\u01af \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 01 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0dd9\u0db4\u01e6\u01e9\u023c \u0dd9\u0d9a\u0dd9\u0dbb\u0db1 \u023f\u029a \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 2.0234 \u00fa \u026d \u0db4\u0dc4\u0dad \u026a\u0dc3\u0dca\u0dad\u0dbb \u0dd9\u0d9a\u0dd9\u0dbb\u0db1 \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0dd0\u0262\u0dbd \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a \u201301 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dc0\u0dbd\u0dc4\u01e6\u01d1\u0dc0 \u0dc0\u01ae\u0dad, \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0102\u0da9\u0dcf \u0218\u0179\u0dba \u0dc3\u0dc4 \u0dbd\u01ff \u0d9a\u0dd0\u0dbd\u0dba .\u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba : \u0dbb\u0da2\u0dba, \u023f\u0262 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba : \u0dc3\u0db7\u0dcf\u0db4\u01af, \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0dd9\u0d9a\u02a3\u0dc5\u0db9 07, \u021d\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 : 2.0234",
