      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      453.25,
      539.92,
      488.32
    ],
    "text": "The notification relating to the Rates of Exchange published in Gazette Extraordinary, No. 2042/1 of23rd October, 2017 is hereby rescinded and the said Rates of Exchange are Scheduled to be rescinded by a similarnotification to be published on or before 05th November, 2017.",
