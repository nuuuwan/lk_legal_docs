    "page_number": 0,
    "bbox": [
      110.88,
      427.27,
      286.44,
      448.88
    ],
    "text": "My Reference No.: Bala/2/1/4/11. Land Ministrie\u2019s No.: LD/05/2001/PC/384.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
