    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      449.37,
      288.81,
      525.88
    ],
    "text": "I hereby give notice, under Sub-section (1) of Section 7 of the Land Acquisition Act, as amended by the land Acquisition (Amendment) Act, No. 28 of 1964, that the Government intends to acquire the following Lands/Servitude* which is required for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.079591751098633,
      5.039495944976807,
      7.91920804977417,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      57.84,
      527.35,
      232.92,
      537.43
    ],
    "text": "Description of the land or to be acquired :",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      538.61,
      289.02,
      602.96
    ],
    "text": "The Land called Maradanawatta extent about 0.0017 Hectare depicted as Lot 01 and 02 in the Survey General\u2019s Plan of P.P.G.4292 of 14.11.2017 situated in 88A, Kandegoda Grama Niladhari Division in Balapitiya Divisional Secretary\u2019s Division in Galle District.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      6.959303855895996,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      57.84,
      621.67,
      152.52,
      639.65
    ],
    "text": "Boundaries as follows:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      6.959303855895996,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      641.12,
      286.43,
      708.8
    ],
    "text": "01. Lot No. 01 \u2014 Maradanawatta \u2014 0.0016 Hectare. North : Maradanawatta claimed by L. A. P. K. De Silva. East : Maradanawatta claimed by L. A. P. K. De Silva. South : Kandegoda Devata Road. West :Kandegoda Devata Road.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.32,
      358.16,
      539.65,
      437.6
    ],
    "text": "02. Lot No. 02 \u2014 Maradanawatta \u2014 0.0001 Hectare. North : Kandegoda Devata Road. East : Kandegoda Devata Road. South : Maradanawatta claimed by W. Janak Wasantha. West : Maradanawatta claimed by W. Janak Wasantha.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.32,
      444.32,
      539.72,
      569.35
    ],
    "text": "All Persons interested in the aforesaid land/lands on which a Servitude is to be acquired* are hereby required to appear Personally or by agents duly authorized in writing before me at the Divisional Secretariat, Balapitiya on the 21st day of March 2018 at 10.00 a.m. and are hereby requested to notify to me in writing (in duplicate) on or before the 14th day of March 2018 the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land/Servitude*, the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      318.72,
      582.09,
      507.0,
      620.72
    ],
