    ],
    "text": "ORDER UNDER SECTION 5",
    "fonts": [
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      48.96,
      429.2,
      540.26,
      487.28
    ],
    "text": "By virtue of the powers vested in me by the Section 5 of the Special Commodity Levy Act, No. 48 of 2007, I, Ravi Karunanayake,Minister of Finance of the Democratic Socialist Republic of Sri Lanka, do hereby make an order to waive off Rs. 10 perKg. from the applied Special Commodity Levy of Rs. 15 per Kg. on the importation of rice, classifiable under the HS Codes of1006.30.10, 1006.30.20 and 1006.30.30, listed out in the Schedule of the Order published in the Gazette ExtraordinaryNo. 2000/85 of 06 January 2017.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      48.96,
      501.2,
      539.96,
      523.28
    ],
    "text": "In terms of this Order, a Special Commodity Levy of Rs. 5 per Kg., on Importation of rice classifiable in above HS codes shallbe collected up to 31st March 2017.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.759424209594727,
      10.078991889953613
    ]
  },
