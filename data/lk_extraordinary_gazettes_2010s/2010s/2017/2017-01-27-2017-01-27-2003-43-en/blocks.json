    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      400.33,
      539.94,
      459.4
    ],
    "text": "BY virtue of the powers vested in me by the Section 5 of the Special Commodity Levy Act, No. 48 of 2007, I, RaviKarunanayake, Minister of Finance, the Democratic Socialist Republic of Sri Lanka, do hereby make an order to waive offRs. 10 per Kg. from the applied Special Commodity Levy of Rs. 15 per Kg. on the importation of rice, classifiable underthe HS Codes of 1006.30.10, 1006.30.20 and 1006.30.30, listed out in the Schedule of the Order published in theExtraordinary Gazette Notification No. 2000/85 of January 06, 2007.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      472.33,
      539.89,
      495.4
    ],
    "text": "In terms of this Order, a Special Commodity Levy of Rs. 05 per Kg. on importation of rice shall be collected fora period of 30 days effective from January 28, 2017.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
