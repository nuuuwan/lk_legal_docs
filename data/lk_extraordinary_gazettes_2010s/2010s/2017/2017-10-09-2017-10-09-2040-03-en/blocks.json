    ],
    "text": "MY No.: UDU/2/2/10/61. Land Ministry No.: 13/96/FR/503.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
