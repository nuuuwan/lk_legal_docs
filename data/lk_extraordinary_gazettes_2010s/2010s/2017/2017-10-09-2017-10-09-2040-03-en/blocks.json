  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      397.76,
      286.41,
      521.84
    ],
    "text": "I hereby give notice under Sub-section (1) of Section 7 of the Land Acquisition Act as amended by the Land Acquisition (Amendment) Act, No. 28 of 1964, that the Government intends to acquire the following land servitude for the public purpose (the conservation of Dumbara Mountain Range). Description of the land/servitude to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.039495944976807,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      522.8,
      286.44,
      590.48
    ],
    "text": "An allotment of land called \u201cWinchfield Park Watta\u201d bearing an extent of about 0.4097 Hectare mentioned in Maha 1930 Supplement of the Surveyor General, situated in the Grama Niladhari Division of Karambakatiya, in the Divisional Secretary\u2019s Division of Udadumbara of Kandy District, Central Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      318.48,
      331.27,
      452.76,
      341.35
    ],
    "text": "Name and address of Claimants:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      318.48,
      341.59,
      412.92,
      376.88
    ],
    "text": "Mr. G. K. G. Piyasena, Wadawalakanda, Kobonilla.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      0.9599039554595947,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      377.38,
      539.52,
      495.44
    ],
    "text": "All persons interested in the aforesaid land/servitude on which is to be acquired are hereby required to appear personally, or by agents duly authorized in writing before me at the Divisional Secretariat, Udadumbara on the 15th November, 2017 at 10.00 a.m. and hereby requested to notify to me in writing (in duplicate) on or before the 8th November, 2017 the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said lands, the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      3.119687795639038,
      10.078991889953613
    ]
  },
