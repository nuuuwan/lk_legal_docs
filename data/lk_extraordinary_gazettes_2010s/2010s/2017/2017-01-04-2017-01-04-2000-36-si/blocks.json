    "text": "14 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca\u0dd9\u0118 \u01b0\u0dbb\u0dab \u021d\u0d9a\u0dcf\u0dc1\u0dba \u0d8b\u01b1\u025e \u0db8\u0dd0\u0daf \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0d85\u01e9\u0dbb\u0dcf\u0db0\u021a\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f \u0dad\u0249\u01ae\u0dd9\u01ae\u0d9c\u0db8 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d85\u0d82\u0d9a 425-\u0dd9\u0d9a\u02a4\u01e6\u0dc0\u0dd0\u0dc0, 434-\u0dd9\u0dc3\u02a4\u0dbd\u0db8, 435-\u0db8\u0dc4\u0dd9\u0db6\u0262\u0dbd\u01e6\u0d9a\u0da9\u0dc0\u0dbd \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u01b1\u0dc5 \u0dd9\u0d9a\u02a4\u01e6\u0dc0\u0dd0\u0dc0, \u0db8\u0dc4\u0dd9\u0db6\u0262\u0dbd\u01e6\u0d9a\u0da9\u0dc0\u0dbd, \u0dbb\u0dcf\u0da2\u0db4\u00fa\u0dc2\u0d9c\u0db8, \u0dd9\u0dc3\u02a4\u0dbd\u0db8, \u0dd9\u0dc3\u02a4\u0dbd\u01e6\u0dc0\u0dd0\u0dc0 \u0db1\u0db8\u0dd0\u01af \u0d9c\u0dd9\u023c \u0218\u028f\u0179\u0dba\u0dcf \u026d \u0daf, \u0d85\u0d82\u0d9a 110072 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0dd9\u023c \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 01 \u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 378, 379, 380, 381, 382, 383, 384, 385, 386, 387, 388, 389, 390, 391, 392, 393, 394, 395, 396, 397, 398, 399, 400, 401, 402, 403, 404, 405, 406, 407, 408, 409, 410, 411, 412, 413, 414, 415, 419, 420, 424, 431, 436, 450, 479, 484, 492, 505, 510, 521, 528, 537, 548, 558, 559, 566, 573 \u0dc3\u0dc4 577 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0dd9\u0dbd\u0dc3 \u0dd9\u0db4\u01e6\u01e9\u023c \u0dd9\u0d9a\u02a3\u0da7 \u0d87\u01ae\u0dad\u0dcf \u026d \u0daf, \u028f\u023d\u0d9a\u023c \u0db4\u0dd1\u023c \u0d89\u01ce\u025c\