    "bbox": [
      47.85,
      399.13,
      539.95,
      446.32
    ],
    "text": "IT is hereby notified that by virtue of powers vested in me under Section 17 of the Customs Ordinance (Chapter 235)I, K. D. N. Ranjith Asoka, Acting Director General of Sri Lanka Customs, determine that with effect from 29th May, 2017, allduties of Customs as well as other charges, penalties and forfeitures incurred under the Customs Ordinance (Chapter 235),shall be paid and received at the Rates of Exchange set out in the Schedule.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      453.25,
      539.85,
      488.32
    ],
    "text": "The notification relating to the Rates of Exchange published in Gazette Extraordinary, No. 2020/1 of22nd May, 2017 is hereby rescinded and the said Rates of Exchange are Scheduled to be rescinded by a similar notificationto be published on or before 04th June, 2017.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
