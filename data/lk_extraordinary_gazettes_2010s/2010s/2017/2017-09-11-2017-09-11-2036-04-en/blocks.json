  {
    "page_number": 0,
    "bbox": [
      50.64,
      476.0,
      286.45,
      566.72
    ],
    "text": "One lot (1) in extent of 0.3023 Hectare as depicted in the final Village plan No. \u00fd 2369 of 14th August 2017 prepared by the Senior Superintendent of Surveys Kurunegala on behalf of the Surveyor General, situated in the village of Kahadiwela in Divisional Secretary\u2019s Division of Polgahawela in Kurunegala District Udapola Othota Korale, North Western Province. (Further described as follows)",
    "fonts": [
      "IskoolaPota",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      586.4,
      321.18,
      654.08
    ],
    "text": "01. Lot No. 1 Name of the Land: Kehel elle Kumbura; Claimants: M. T. M. Thowfeek, No. 110, Oruliyadda, Polgahawela, M. S. Mohamed, No. 208, Kegalle Road, Polgahawela and S. Sahabdeen, No. 15 Oruliyadda, Polgahawela; Extent: 0.3023 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      667.04,
      596.2,
      699.92
    ],
    "text": "All persons whom interested in the aforesaid land there names are in the Gazette notice or not are requested to submit their claims in writing, the nature",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
