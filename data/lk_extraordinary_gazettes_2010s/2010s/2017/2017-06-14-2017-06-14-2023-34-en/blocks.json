      71.04,
      426.48,
      548.06,
      472.55
    ],
    "text": "DUMINDA DISSANAYAKE, Minister of Agriculture.Colombo,1st June, 2017.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      6.953384876251221,
