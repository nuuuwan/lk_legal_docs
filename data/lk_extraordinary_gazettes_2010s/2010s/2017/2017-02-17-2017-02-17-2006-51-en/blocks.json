    "bbox": [
      50.88,
      583.79,
      288.99,
      632.72
    ],
    "text": "Name of Land: Welipanewatta; Description: Home garden, Mixed Cultivation is there, There is a grave; Claimed by: Malavi Arachchige Wijesekara, Gegawawaththa, Rathmale; Extent: 0.0288 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      3.119687795639038,
