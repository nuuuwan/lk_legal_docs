    "text": "\u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0d9c\u0db8 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0d89\u0da9\u023c \u0d89\u0da9\u0dd9\u023c \u0d85\u0250\u01af\u0dba \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u0dd9\u0262\u0d9a\u023c \u0286\u01af\u0dba\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u02a2 \u021d\u0db8\u0dcf\u0dab\u0dba \u0218\u0298\u0db6\u0db3 \u0d9a\u0dc5 \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc1\u0dba \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4\u01af\u0d9a\u0dd9\u024f \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dba \u0d85\u0d82\u0d9a\u0dba",
