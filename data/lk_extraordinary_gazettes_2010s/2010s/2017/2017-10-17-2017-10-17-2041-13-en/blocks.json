    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      373.75,
      286.64,
      432.08
    ],
    "text": "I hereby give notice under Sub-section (1) of Section 7 of the Land Acquisition Act, as amended by the Land Acquisition (Amendment) Act, No. 28 of 1964, that the Government intends to acquire the following land servitude * which is required for the public purposes.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      0.9599039554595947,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.08,
      431.87,
      255.48,
      446.96
    ],
    "text": "Description of the land/servitude to be acquired:",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.079591751098633,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      447.71,
      286.66,
      520.64
    ],
    "text": "Description of the said area :- Allotments of land from No. 32 to 88 (Described in the Schedule) in Plan F.V.P. 342, Situated in Pahala bambawa Village in Pahala bambawa Grama Niladhari Division No. E432 E in Kandapalla Korale in Galewela Divisional Secretariat Division in Matale District in Central Province.",
    "fonts": [
      "TimesNewRomanPS-BoldItal",
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.079591751098633,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      520.16,
      286.65,
      684.32
    ],
    "text": "All persons interested in the aforesaid land/lands* on which a servitude is to be acquired are hereby required to appear personally, or by agents duly authorized in writing, before me at Galewela Divisional Secretariat On the 6th November 2017 at 10.00 a.m., and are hereby requested to notify to me in writing (in duplicate) on or before the 20th day of November 2017 the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land/servitude* the amount of compensation and the details of the computation of such amount. M. U. Nishantha, Divisional Secretary - Galewela.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.039495944976807,
      10.078991889953613
    ]
