    ],
    "text": "\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3 \u0bc6\u0b95\u0bbe\u1fa8\u0bae\u0bcd\u1f97 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0bc6\u0bae\u0bbe\u0bb0\u0b9f\u0bcd\u1f8c\u0bc8\u0bb5 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 551, \u0b95\u1f8c\u0bc6\u0baa\u0ba4\u0bcd\u0ba4 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0b95\u1f8c\u0bc6\u0baa\u0ba4\u0bcd\u0ba4 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0b95\u0bae\u0bcd\u0bc6\u0bae\u0ba4\u0bcd\u0ba4 \u0b95\u0bc1\u1f97\u0bb0 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc8\u0bb4\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u1f99\u1fa8 \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b87\u1f9e\u0ba8\u0bcd\u1f90 25 \u0bc7\u0baa\u0bb0\u0bcd\u0b9a\u0bcd\u0b9a\u0bb8\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u1f99\u0bc8\u0b9f\u0baf \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u1f9e\u0bae\u0bcd \u0b8e\u0bb2\u0bcd\u0bc8\u0bb2\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0b95\u0bbe\u0ba3\u0bbf\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf. \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bcd\u0b95\u0bc1: \u0b95\u0bae\u0bcd\u0bc6\u0bae\u0ba4\u0bcd\u0ba4 \u0b95\u0bc1\u1f97\u0bb0 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b92\u1f9e \u0baa\u0b95\u0bc1\u0ba4\u0bbf; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bcd\u0b95\u0bc1: \u0ba4\u0bc0\u0baa \u0b8e\u0bb2; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bbf\u0bb1\u0bcd\u0b95\u0bc1: \u0b95\u1f8c\u0bc6\u0baa\u0ba4\u0bcd\u0bc8\u0ba4\u0baf\u0bbf\u0bb2\u0bcd \u0b87\u1f9e\u0ba8\u0bcd\u1f90 \u0baa\u0bbf\u1fa2\u0baf\u0ba9\u0bcd\u0ba4\u0bc8\u0bb2 \u0bb5\u0bc8\u0bb0\u0baf\u0bbe\u0ba9 \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0\u0ba8\u0bbe\u0baf\u0b95 \u0bae\u0bbe\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bbf\u0bb1\u0bcd\u0b95\u0bc1: \u0bb5\u0bc8\u0bb0\u0baa\u0b9f \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 2354 \u0b87\u0ba9\u0bcd A1 \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd \u1f90\u0ba3\u0bcd\u1f8c. \u0b95\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bb5\u0bbe\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u1f9e\u0bae\u0bcd \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u1f9c\u0bae\u0bcd: \u0ba4\u0bbf\u1f9e\u0bae\u0ba4\u0bbf. \u0bb5\u0bbf\u0bae\u0bb2\u0bbe \u0bb5\u0bbf\u0bc7\u0b9c\u1f90\u0b99\u0bcd\u0b95, \u0b87\u0bb2.: 77, \u2018\u0b9a\u0bbf\u0bbe\u0bbf\u0bae\u0bb2\u0bcd\u2019, \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0 \u0ba8\u0bbe\u0baf\u0b95 \u0bae\u0bbe\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0b95\u1f8c\u0bc6\u0baa\u0ba4\u0bcd\u0ba4 - \u0bc6\u0bae\u0bbe\u0bb0\u0b9f\u0bcd\u1f8c\u0bc8\u0bb5. 2-876",
