    ],
    "text": "\u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba \u01e7\u0dbd\u0db0\u0dcf\u025c\u0dba\u0dcf\u0dd9\u0118 \u0db1\u0db8 \u0db4\u01ae\u0d9a\u0dc5 \u0252\u01b1 \u0db6\u0dbd \u021d\u0dd9\u01ca\u0dc1\u0dba \u0db4\u01ae\u0d9a\u0dc5 \u0252\u01b1 \u0d9a\u0dcf\u0dbd\u0287\u0db8\u0dcf\u0dc0 01. \u0219. \u0d91\u0dc3\u0dca. \u011b\u0dab\u0dc0\u0259\u0db0\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0dd9\u0db6\u01e6\u0dd9\u0dad\u02a3\u0da7 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba 2017.09.01 \u01ce\u0db1 \u0286\u0da7 2017.11.30 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1 \u0dd9\u0dc3\u02a2\u0dc0\u0dba (\u026a\u0279\u0dcf\u023d\u0d9a) \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u0daf\u00fa\u0dc0\u0dcf \u0d86\u0da0\u0dcf\u0259\u0dba \u0d85\u0250. \u0d91\u013c. \u0dd9\u00fa. \u0db8\u0dc4\u0dcf\u0db1\u0dcf\u0db8, \u0dd9\u0262\u0d9a\u023c, \u0d89\u0da9\u023c \u0dc4\u0dcf \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1 \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0d85\u0db8\u0dcf\u0dad\u0255\u0dcf\u0d82\u0dc1\u0dba. 2017 \u0dd9\u0db1\u02a3\u0dc0\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 23 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0d89\u0da9\u023c \u0dc4\u0dcf \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1 \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0d85\u0db8\u0dcf\u0dad\u0255\u0dcf\u0d82\u0dc1\u0dba. \u201c \u023d\u028f\u0d9a\u0dad \u0db8\u0dd0\u01d0\u0dbb\u201c 1200/6, \u0dbb\u0da2\u0db8\u0262\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbb, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd. 12-376",
