  {
    "page_number": 0,
    "bbox": [
      78.96,
      473.52,
      236.32,
      483.59
    ],
    "text": "Description of the land to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      497.52,
      310.96,
      579.59
    ],
    "text": "Allotment of land in extent of 1.1114 Hectare described asLot No. 01 in Preliminary Plan No. P.P.Pu.5325 of 31.03.2017prepared by the Surveyor General, situated at the village ofTiththakade in the Tiththakade Grama Niladari's Division ofNo. 567 in the Munnessaram Pattu Minor Division in DivisionalSecretary's Division of Chilaw in Puttalam District in the NorthWestern Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      593.52,
      310.81,
      641.51
    ],
    "text": "01. Lot No. 01Name of the Land: Devalawatta; Description: 31 permanentBuilding and contains Coconut cultivation 10-15 Years Old;Claimant: Unable to find.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      655.44,
      310.77,
      677.51
    ],
    "text": "All persons interested in the aforesaid land hereby requiredto appear personally or by agents duly authorized in writing,",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
