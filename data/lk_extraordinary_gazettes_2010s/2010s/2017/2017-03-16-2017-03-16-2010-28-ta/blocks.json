    ],
    "text": "\u0b86\u0bb0\u0bae\u0bcd\u0baa\u0baa\u0bcd \u0baa\u0b9f \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 23 \u0b87\u0bb2\u0bcd, \u0bc7\u0bae\u0bb2\u0ba4\u0bbf\u0b95 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 37. \u0ba4\u0bbe\u0bb3\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 51 \u1f97\u0ba4\u0bcd\u0ba4\u0b95 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd EDM \u0bae\u0bbe\u0bb1 1137, EDM \u0bae\u0bbe\u0bb1 1138, EDM \u0bae\u0bbe\u0bb1 1500 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 2012.10.11 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0bc8\u0baf\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0ba4\u0bb0\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3\u0ba9: \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 1079 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0baa\u0ba9\u0bcd\u0b9a\u0bb2\u0b95\u0bbe\u0bb5\u0bc6\u0bb5\u0bb2 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b95\u1fa6\u0b95\u0bb2 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0ba4\u0bbf; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b8e\u0bb8\u0bcd. \u0b8e\u0bae\u0bcd. \u0b8e\u0b9a\u0bcd. \u0b85\u0bc7\u0ba8\u0bbe\u0ba4\u0bcd\u0baf \u0bc6\u0b9a\u0ba9\u0bb5\u0bbf\u0bb0\u0ba4\u0bcd\u0ba9; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0032 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 1080 \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd: \u0baa\u0ba9\u0bcd\u0b9a\u0bb2\u0b95\u0bbe\u0bb5\u0bc6\u0bb5\u0bb2 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b95\u1fa6\u0b95\u0bb2 \u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0; \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd \u0baa\u0baf\u0bbf\u0bb0\u0bcd\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0bc8\u0b95; \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd: \u0b85\u0ba4\u0bbe\u1fab\u0ba4 \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba9\u0bcd\u0ba4; \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.0203 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd. \u0bc7\u0b95. \u0b8e\u0ba9\u0bcd. \u0bc6\u0b95\u0bd7\u0b9a\u0bb2\u0bcd\u0baf \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0bbf, \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd, \u0baa\u0bb8\u0bcd\u0bc6\u0b95\u0bbe\u0bc8\u0b9f.",
