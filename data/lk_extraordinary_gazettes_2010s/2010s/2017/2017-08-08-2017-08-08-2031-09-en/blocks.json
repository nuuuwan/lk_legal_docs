  {
    "page_number": 0,
    "bbox": [
      55.05,
      466.98,
      295.06,
      497.1
    ],
    "text": "1. Description of the servitude - Acquisition of servitude overthe land, for the laying of sewerage pipe lines of Greater KurunegalaWater Supply and Sanitation Project.",
