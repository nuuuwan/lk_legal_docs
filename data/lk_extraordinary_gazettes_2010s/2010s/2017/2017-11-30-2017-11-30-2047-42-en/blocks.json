    ]
  },
  {
    "page_number": 0,
    "bbox": [
      68.16,
      399.19,
      295.37,
      421.28
    ],
    "text": "Land Ministry Ref. No.: 4/3/2014/HW/405. My Ref. No. : MLB/LND/LNDAQ/L1/39-6-i.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.2,
      435.2,
      295.4,
      469.28
    ],
    "text": "I hereby give notice under Sub-section (1) of Section 7 of theLand Acquisition Act, that the Government intends to acquirethe following lands which are required for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      65.28,
      479.83,
      223.14,
      489.91
    ],
    "text": "Description of the land to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.2,
      498.8,
      295.29,
      604.88
    ],
    "text": "Lot No. (01) Lot allotment of land in Total Extent of about0.0034 Hectare, in Preliminary Plan No. Mara. 2694 preparedby the Senior - Superintendent of Surveyor of Matara Districton behalf of the Surveyor General, situated in the village ofGalpamuna in the Grama Niladhari Division ofGalpamuna(402B) in the Minor Divisions of GangabadaPaththuwa and Weligam Korale in the Divisional Secretary\u2019sDivision of Malimbada in Matara District in the SouthernProvince.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      307.2,
      351.2,
      547.2,
      409.28
    ],
    "text": "01. Lot No. 01Name of land: Banwelkosiduwa; Description: Garden,Contain 4 Nos. of Jack Trees - 5-15 years old; Claimant: State;Original Claimant: G.S.Leelasena, \"Charitha\", Kosinduwa,Galpamuna, Palatuwa; Extent: 0.0034 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      307.2,
      422.24,
      547.81,
      517.76
    ],
    "text": "All persons interested in the aforesaid lands are herebyrequired to appear personally or by agent duly authorized inwriting, before me at Divisional Secretariat of Malimbada onthe 11.12.2017 at 10.00 a.m. and are hereby requested to notifyto me in writing (in duplicate) on or before the 04.12.2017 thenature of their interests in the land, the particulars of theirclaims for compensation for the acquisition of the said lands,the amount of compensation and the details of the computationof such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      307.2,
      528.56,
      507.49,
      549.2
    ],
    "text": "Divisional Secretary Malimbada.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
