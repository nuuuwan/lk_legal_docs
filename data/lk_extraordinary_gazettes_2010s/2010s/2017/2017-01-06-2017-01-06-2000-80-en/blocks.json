    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      70.8,
      437.76,
      310.84,
      471.83
    ],
    "text": "Acquisition of a plot of land for the Construction of theUdatenna New Water Treatment Plant of Greater Matale watersupply scheme.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      80.88,
      482.16,
      288.88,
      492.23
    ],
    "text": "Description of the land or servitude to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      70.8,
      500.16,
      310.94,
      570.23
    ],
    "text": "An allotment of land called Rathwattawatta in extent ofabout 0.0433 Hectare depicted as Lot 1 in the P.P.M 1687prepared by Senior Superintendent of Survey, Matale andsituated at Warapitiya village in Udatenna Grama Niladhari inMatale Udasiyapattuwa minor division in Ukuwela DivisionalSecretary's division in Matale District in Central Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
