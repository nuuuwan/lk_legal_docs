      65.28,
      466.38,
      231.0,
      493.53
    ],
    "text": "Description of the Land to be acquired :",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.9994001388549805,
      9.118988037109375,
