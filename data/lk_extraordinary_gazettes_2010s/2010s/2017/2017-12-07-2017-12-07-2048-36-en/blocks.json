  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      493.27,
      286.7,
      609.0
    ],
    "text": "The allotment of land described below, containing in extent 0.0304 Hectare, depicted as lot 1 in Preliminary Plan No. Ma/1714, prepared by Surveyor General, situated at Wariyapola-Ward No. 10 Diyabubula Village (within the Municipal Council limit of Matale) in Kohonsiya Pattuwa Minor Division of Matale Divisioal Secretary\u2019s Division, Matale District, Central Province. 1. Lot No.1-Wariyapola Estate\u2013 Original Ownership: Sity Naleema Mukthal",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      0.9599039554595947,
      6.959303855895996,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.88,
      610.16,
      286.63,
      643.04
    ],
    "text": "North: Wariyapola Estate; Akkaramale Division claimed by S. H. Anverdeen and Others; East: Diyabubulariver Road, Diyabula River; South:",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.56,
      337.28,
      539.89,
      381.92
    ],
    "text": "Diyabubula Riaver and Wariyapola Estate-Akkaramale Division claimed by Ayoob Ansari and Others-West: Wariyapola Estate-Akkaramale Division claimed by Ayoob Ansari and Others and Road.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.56,
      381.19,
      539.88,
      513.43
    ],
    "text": "All parsons interested in the aforesaid land on which a servitude is to be acquired are hereby required to appear personally, or by agents duly authorized in writing, before me at Matale Divisional Secretariat on the 27th day of December 2017 at 10.00 Clock a.m and hereby requested to notify to me in writing (in duplicate) on or before the 20th day of December 2017, the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land, the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
