      572.0,
      286.44,
      616.64
    ],
    "text": "01. Lot No. 01 Name of the Land: Gorakapandurahena alias Gorakagahahena, Babiyalage Kurunduwatta and",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
