    "text": "01. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 01 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dad\u0dbd\u0dd9\u0dc4\u02a2\u0db1; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0379 \u0db8\u0dcf\u0250\u023c \u026a\u0dc3\u0dca\u0dad\u0dbb : \u0d8b\u01b1\u0dbb\u0da7 :\u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db8\u0dcf\u0259\u0d9c\u0dba; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db8\u0dcf\u0259\u0d9c\u0dba \u0dc3\u0dc4 \u018c. \u0150. \u0218\u0dba\u0dd9\u0dc3\u02a2\u0db1 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dad\u0dbd\u0dd9\u0dc4\u02a2\u0db1; \u0daf\u00fd\u0dab\u0da7:\u018c. \u0150. \u0218\u0dba\u0dd9\u0dc3\u02a2\u0db1 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dad\u0dbd\u0dd9\u0dc4\u02a2\u0db1 \u0dc3\u0dc4 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db8\u0dcf\u0259\u0d9c\u0dba; \u0db6\u0da7\u028f\u0dbb\u0da7:\u021d\u0dcf \u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db8\u0dcf\u0259\u0d9c\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u01e6\u0db1\u01e6\u0dd9\u0118 \u0db1\u023c \u0dc4\u0dcf \u0263\u0218\u0db1\u0dba\u01e6 ; \u018c. \u0150. \u0218\u0dba\u0dd9\u0dc3\u02a2\u0db1 \u0db8\u0dc4\u0dad\u0dcf, \u0d85\u0d82\u0d9a 600, \u01ce\u0217\u0218\u0179\u0dba, \u0d85\u0dbd\u0dc0\u01b1\u0dd9\u0d9c\u02a3\u0da9",
