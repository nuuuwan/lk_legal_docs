      73.92,
      366.32,
      285.72,
      397.04
    ],
    "text": "My Reference No.: MUL/LND/2/ACQ/22. Land Ministry\u2019s Reference No.: LD/5/2007/CA/196.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.91920804977417,
