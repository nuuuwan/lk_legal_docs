      50.64,
      594.84,
      286.41,
      627.96
    ],
    "text": "Lot No. 1 \u2014 Name of the Land: Kaludewala Estate; Original Ownership: Abdul Satthar Mohamed Washeer.",
    "fonts": [
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      628.4,
      286.44,
      696.56
    ],
    "text": "North: Road and Lot No. 1 in P.P.Ma. 383; East: Lot No. 1 in P.P.Ma. 383, Road; South: Road and Kaludewala Estate (T. P. 50252) claimed by Abdul Satthar Mohamed Washeer; West: Kaludewala Estate (T.P.50252) claimed by Abdul Satthar Mohamed Washeer and Road.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
