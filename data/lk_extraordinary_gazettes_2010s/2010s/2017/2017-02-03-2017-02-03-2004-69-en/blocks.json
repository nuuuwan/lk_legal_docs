      698.0,
      286.45,
      719.6
    ],
    "text": "All persons interested in the aforesaid land on which a servitude is to acquired are hereby required to appear",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
