  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      484.15,
      286.62,
      593.11
    ],
    "text": "Description of the land to be acquired: The allotment of land described below, containing in Extent 0.1064 Hectares, depicted as lot 1 in Preliminary Plan No. Ma/1688, prepared by Surveyor General, situated at Mandandawala - Ward No. 2 Kaludewala village (within the Municipal Council limit of Matale) in Kohonsiya Pattuwa minor Division of Matale Divisional Secretary\u2019s Division, Matale District, Central province.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.9994001388549805,
      10.078991889953613
