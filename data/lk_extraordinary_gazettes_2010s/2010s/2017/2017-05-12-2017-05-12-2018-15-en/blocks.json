  {
    "page_number": 0,
    "bbox": [
      55.2,
      497.36,
      296.36,
      555.44
    ],
    "text": "I hereby give notice, under Sub-section (1) of Section 7 of theLand Acquisition Act, as amended by Land Acquisition( Amended) Act, No. 28 of 1964, that the Government intendsto acquire the following land which is required for a publicpurpose:",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.36,
      570.55,
      282.4,
      580.63
    ],
    "text": "Description of the Land or Servitude to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.2,
      598.16,
      296.81,
      668.23
    ],
    "text": "Lots 1140, 1141, 1142, 1143, 1144, 1145, 1146, 1147, 1148(Total Extent of 5.1342 Hec.) in Sheet No. 45 of SupplementaryNo. 41 Plan No. 218 prepared by Surveyor General situated inthe village of Yatipawwa, in the Grama Niladhari Division ofYatipawwa in Meda Pattu of Kuruwiti Korale, RatnapuraDistrict, Sabaragamuwa Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      306.72,
      379.76,
      547.81,
      486.08
    ],
    "text": "All persons interested in the aforesaid land are herebyrequired to appear personally, or by agents duly authorized inwriting, before me at Divisional Secretariat, Kiriella, on theday of 14th of June 2017, at 9.30 a.m. and are herebyrequired to notify to me in writing (in duplicate) on or beforethe 31st of May, 2017 the nature of their interests in the land,the particulars of their claims for compensation for theacquisition of the said land, the amount of compensation, andthe details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
