    "text": "\u0db8\u0dc4\u0da2\u0db1 \u0d9a\u0da7\u0252\u01ae\u0dad\u00fa \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0255 \u0dc0\u0db1 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0d89\u0da9\u0db8/ \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0 \u0dbd\u0db6\u0dcf\u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0d86\u019c\u018d\u0dc0 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0db6\u0dd0\u0269 1964 \u0d85\u0d82\u0d9a 28 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c (\u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1) \u0db4\u0db1\u01af\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u01dd\u0dad \u0db4\u025c\u01ce \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 7 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (1) \u0dc0\u0dd0\u01e7 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u028f\u023d\u0d9a\u023c \u0dd9\u0dc4\u02a4 \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u0dc3\u023c\u0db6\u01e6\u0db0\u0d9a\u023c \u00fb\u0dba\u0dcf \u0286\u0179\u0db1 \u0286\u0dba\u029a \u0dd9\u0daf\u0db1\u0dcf\u0db8 1988.01.05 \u0dc0\u0db1 \u01ce\u0db1 \u0d85\u0d82\u0d9a 487/5 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u0db8\u0119\u01e6 1988.03.08 \u021b.\u0db7\u0dcf. 9.30\u0da7 \u0d9a\u0dbd\u0dc0\u0dcf\u0db1 \u0d8b\u0db4 \u01ce\u0dc3\u0dcf\u0db4\u01af \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dd9\u024f \u01cf \u0dc3\u023c\u023f\u0d9b \u026b\u0db8\u0da7 \u0daf\u01e6\u0dc0\u0dcf \u0286\u0179\u0dba \u0daf, \u0d91\u0db8 \u0db4\u025d\u00fa\u0dc2\u0dab \u0d9a\u0da7\u0252\u01b1 \u0d89\u01ce\u025c\u0dba\u0da7 \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1 \u0dd9\u0d9c\u02a3\u0dc3\u0dca \u0dd9\u0db1\u02a3\u0db8\u0dd0\u01af \u0db6\u0dd0\u026a\u01e6 \u0db1\u0dd0\u0dc0\u0dad 7 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u021d\u0286\u01ca\u0db0 \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0