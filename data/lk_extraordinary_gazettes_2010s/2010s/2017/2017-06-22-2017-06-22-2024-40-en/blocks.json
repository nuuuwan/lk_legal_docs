    "page_number": 0,
    "bbox": [
      50.64,
      397.27,
      286.43,
      450.08
    ],
    "text": "I, hereby give notice, under Sub-section (1) of Section 7 of the Land Acquisition Act, that the Government intends to acquire the following lands which are required for a public purpose.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      0.9599039554595947,
      5.039495944976807,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      451.51,
      286.45,
      547.76
    ],
    "text": "Description of the Land to be acquired: Lot No. 01 to 06 (Lots 06) allotments in total extent of about 0.0193 Hectare, of land in Preliminary Plan No. GAM 3984 and dated 26.07.2016, prepared by the Surveyor General situated in the Village of Kirillawala and Minor Division of Adhikari Pattuwa in the Divisional Secretary\u2019s Division of Mahara in Gampaha District in Western Province.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.039495944976807,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      548.71,
      286.44,
      612.08
    ],
    "text": "1. Lot No. 01. Name of Land: Ketaliyakumbura; Description: Garden; Claimant: Stage; Original Claimant: R. A. Samarasena, No. 250, Udupila, Delgoda; Extent: 0.0003 Hectare.",
