    ]
  },
  {
    "page_number": 0,
    "bbox": [
      139.65,
      339.13,
      448.08,
      350.2
    ],
    "text": "FISHERIES AND AQUATIC RESOURCES ACT, No. 02 OF 1996",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      363.13,
      529.11,
      386.2
    ],
    "text": "REGULATIONS made by the Minister of Fisheries and Aquatic Resources Development under Section 61(1)(sc) and(sd) of the Fisheries and Aquatic Resources Act, No. 2 of 1996.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      399.13,
      539.84,
      446.2
    ],
    "text": "MAHINDA AMARAWEERA,Minister of Fisheries and Aquatic Resources Development.Colombo,27th February 2017.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      7.0,
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      266.85,
      459.13,
      320.85,
      470.2
    ],
    "text": "Regulations",
    "fonts": [
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      483.13,
      518.33,
      506.2
    ],
    "text": "1. These regulations may be cited as Conservation of Fish and Aquatic Resources within Sri Lanka WatersRegulations 2016.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      83.85,
      519.13,
      505.07,
      530.2
    ],
    "text": "2. No person shall discharge industrial or domestic effluent directly or indirectly to Sri Lanka Waters.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      543.13,
      522.52,
      566.2
    ],
    "text": "3. No person shall dump any pollutant, waste or foreign matter and fill or reclaim the sea areas in a mannercausing destruction to fish and aquatic resources in Sri Lanka waters.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      579.13,
      523.73,
      602.2
    ],
    "text": "4. No person shall shall engage in removing, cutting or altering mangrove eco systems grown in the coastalbelt or in any area adjacent to the Sri Lanka Waters.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      615.13,
      535.08,
      650.2
    ],
    "text": "5. No person shall engage in any activity which causes a threat to the conservation of fish species in Sri LankaWaters or coastal belt adjacent to it. However the Director General may issue a permit consisting of conditionsrequired to be observed for any activity which does not have any harmful effect.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      83.85,
      663.13,
      184.06,
      674.2
    ],
    "text": "6. In these Regulations -",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      95.85,
      687.13,
      539.91,
      698.2
    ],
    "text": "\u201cSri Lanka Waters\u201d shall have the same meaning as in the Fisheries and Aquatic Resources Act, No. 02 of 1996.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      95.85,
      711.13,
      496.08,
      722.2
    ],
    "text": "\u201cEffluent\u201d means the materials that released directly or indirectly in solid, liquid, or gaseous forms.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      735.13,
      81.45,
      746.2
    ],
    "text": "03- 834",
    "fonts": [
