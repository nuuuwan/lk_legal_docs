      139.44,
      425.48,
      296.08,
      447.68
    ],
    "text": "My Reference No.: 4/1/b/w;am;a/79.Reference No. of the Ministry of Lands:",
    "fonts": [
      "FMAbhayax",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
