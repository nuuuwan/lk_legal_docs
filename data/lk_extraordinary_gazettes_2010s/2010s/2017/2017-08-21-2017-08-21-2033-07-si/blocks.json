    "text": "\u0db8\u0db0\u0255\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0db8\u0dc4\u01e9\u0dc0\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0d8b\u0da9\u01d0\u023c\u0db6\u0dbb \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d9a\u0dbb\u0db9\u0d9a\u0dd0\u0179\u0dba \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dc0\u0dc3\u0db8 \u01b1\u0dc5 \u0218\u028f\u0179 \u0db8\u0dcf\u0179\u01e6\u0dc0\u01ae\u0dad \u0db1\u023c \u026d \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262\u0dd9\u0118 \u0d85\u0d82\u0d9a \u0db8\u0dc4 6628 \u0daf\u0dbb\u0db1 \u0218\u0249\u0dd9\u0259 \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 3.8717 \u00fa \u026d \u0d89\u0da9\u0db8.",
