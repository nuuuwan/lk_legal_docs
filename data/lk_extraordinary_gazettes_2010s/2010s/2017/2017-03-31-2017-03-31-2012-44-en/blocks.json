    "bbox": [
      255.32,
      48.03,
      263.62,
      468.77
    ],
    "text": "Report of the Auditor General :\u2013 Review Report on the Balance Sheet of the Central Bank of Sri Lanka as at 28th February, 2017",
    "fonts": [
      "TimesNewRoman,Bold",
      "TimesNewRoman,Italic",
      "TimesNewRomanPS-BoldItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.5
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      228.44,
      162.03,
      246.82,
      786.06
    ],
    "text": "I have reviewed the accompanying Balance Sheet of the Central Bank of Sri Lanka (CBSL) as at 28th February 2017. This Balance Sheet is the responsibility of the Management of the Central Bank ofSri Lanka. My responsibility is to issue a report on this balance sheet based on my reveiw.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.5
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      194.6,
      162.03,
      222.82,
      786.08
    ],
    "text": "I conducted my review in accordance with Sri Lanka Standards on Review Engagements 2400 applicable to Review Engagements. This Standard requires that the review should be planned and performed to obtainmoderate assurance as to whether the Balance Sheet is free of material misstatements. The review is limited primarily to inquiries of personnel of the CBSL and analytical procedures applied to financial data andthus provide less assurance than an audit.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.5
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      180.44,
      162.03,
      188.74,
      624.0
    ],
    "text": "Based on my review, nothing has come to my attention that causes me to believe that the accompanying Balance Sheet does not give a true and fair view.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.5
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      125.72,
      48.03,
      164.02,
      757.97
    ],
    "text": "H. M. G. Wijesinghe,Auditor General.Auditor General's Department,30th June, 2017.",
    "fonts": [
      "TimesNewRoman,Bold",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.5
    ]
  },
