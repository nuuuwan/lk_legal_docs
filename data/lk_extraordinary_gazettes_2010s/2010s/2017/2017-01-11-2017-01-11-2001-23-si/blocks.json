    "text": "\u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0d9c\u0db8 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0d89\u0da9\u023c \u0d89\u0da9\u0dd9\u023c \u0d85\u0250\u01af\u0dba \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u0dd9\u0262\u0d9a\u023c \u0286\u01af\u0dba\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u02a2 \u021d\u0db8\u0dcf\u0dab\u0dba \u0218\u0298\u0db6\u0db3 \u0d9a\u0dc5 \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc1\u0dba \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4\u01af\u0d9a\u0dd9\u024f \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dba \u0d85\u0d82\u0d9a\u0dba (\u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259) \u0dd9\u0db8\u02a3\u0dbb\u017b\u0dc0 \u0d91\u0dd9\u0d9c\u02a3\u0da9 \u0d8b\u0dba\u0db1 520217 \u0d9a\u0dbd\u0dcf\u0db4 09 0.0252 2518436 \u0dd9\u0daf\u0262\u0d9a\u0db3 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 243 \u0dc3\u0dd0\u0dc5\u00fb\u0dba \u0252\u01b1\u0250. - \u0d91\u0dc0\u0dd0\u01e7 \u0d85\u01e6\u01af\u0db8 \u0d9a\u0dd0\u0db8\u01af \u0db4\u01b4\u0dba\u00fa \u0dd9\u0db1\u02a3\u0db8\u0dd0\u01af \u0dd9\u01ca\u0db4\u0dc5\u0d9a\u0da7 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0dcf \u0286\u0179\u0db1 \u0263\u0252\u023c\u0dc0\u0dbd, \u0d92 \u0dd9\u01ca\u0db4\u0dc5\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0dd9\u023c \u0d85\u0d82\u0d9a\u0dba, \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u02a2 \u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4 \u0d92 \u0d89\u0da9\u023c\u0da7 \u028f\u023d\u0d9a\u023c \u0db4\u0dd1\u0db8\u0da7 \u0dad\u0db8\u0dcf\u0da7 \u0d87\u01af \u0d85\u0250\u01af\u0dba \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb \u01af\u022a\u0dba \u0252\u01b1\u0dba. \u0263\u0252\u023c \u0d9a\u0dc0\u0dd9\u0dbb\u0dd9\u024f \u0dc0\u023c\u0db4\u0dc3 \u0d8b\u0da9 \u0dd9\u0d9a\u0dc5\u0dc0\u0dd9\u0259 \u201c\u0d85\u01e6\u01af\u0db8 \u0d9a\u0dd0\u0db8\u01af \u0db4\u01b4\u0dba\u00fa \u0dd9\u0db1\u02a3\u0db8\u0dd0\u01af \u0dd9\u01ca\u0db4\u0dc5 \u0218\u0298\u0db6\u0db3 \u0d89\u0262\u0265\u023c \u0db4