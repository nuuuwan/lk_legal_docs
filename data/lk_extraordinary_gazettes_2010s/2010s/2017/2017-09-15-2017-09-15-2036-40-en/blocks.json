      359.16,
      286.53,
      391.88
    ],
    "text": "My Reference No.: KDS/HAR/4/2/2/21. Land Ministry\u2019s Reference No.: 4/3/8/2013/CC/54.",
    "fonts": [
      "Times New Roman"
    ],
    "sizes": [
