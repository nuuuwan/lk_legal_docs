    "text": "\u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u00fd\u025e\u0dab\u0dd1\u0d9c\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0db8\u0262\u0dbd\u0dc0\u0218\u0179\u0dba \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d85\u0d82\u0d9a 711, \u0db8\u0262\u0dbd\u0dc0\u0218\u0179\u0dba \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0dd9\u0dad\u0263\u0dba\u0dd9\u0d9c\u02a3\u01e6\u0db1 \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 \u0db8\u0dd0\u0db1 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf, 2017.07.06 \u01ce\u0db1\u0dd0\u01af, \u0d85\u0d82\u0d9a \u00fd 2374 \u0daf\u0dbb\u0db1 \u0240\u0263\u0d9a \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 1 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u201c\u0dd9\u0d9a\u02a4\u01e6\u0d9c\u0dc4\u023f\u0dbd \u0dc0\u01ae\u0dad\u201d \u0db1\u0dd0\u0db8\u01af \u0d89\u0da9\u0dd9\u0db8\u01e6, \u023f\u029a \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0334 \u00fa \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0db4\u0dc4\u0dad \u0db8\u0dcf\u0250\u023c \u01b1\u0dc5 \u0218\u028f\u0179 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3.",
