  {
    "page_number": 0,
    "bbox": [
      50.64,
      437.85,
      288.81,
      514.36
    ],
    "text": "I hereby give notice, under Sub-section (1) of Section 7 of the Land Acquisition Act, as amended by the land Acquisition (Amendment) Act, No. 28 of 1964, that the Government intends to acquire the following Lands which is required for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.079591751098633,
      5.039495944976807,
      7.91920804977417,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      57.84,
      515.83,
      232.92,
      525.91
    ],
    "text": "Description of the land or to be acquired :",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      527.09,
      288.75,
      602.96
    ],
    "text": "An allotments of land depicted as Lot No. 66 in Cadastral Map No. 530176 dated 26.05.2017 prepared by the Surveyor General in the Village of Kumbuka in Kumbuka Pattu in the Divisional Secretaries, Division of Horana in Kalutara District Western Province Containing in extent about 0.0459 Hectare.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      6.959303855895996,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      612.84,
      286.38,
      679.99
    ],
    "text": "01. Lot No. 66 Name of the land: Galgodakele; Description: Garden; Claimant of the Land: State; Extent 0.0459 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      358.88,
      539.49,
      483.92
    ],
    "text": "All Persons interested in the aforesaid land/lands are hereby required to appear Personally or by agents duly authorized in writing before me at the Divisional Secretariat, Horana on the 28 day of December 2017 at 10.00 a.m. and are hereby requested to notify to me in writing (in duplicate) on or before the 22nd day of December 2017 the nature of their interest in the land, the particulars of their claims for compensation for the acquisition of the said land, and the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
