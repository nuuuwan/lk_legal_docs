    "page_number": 0,
    "bbox": [
      55.2,
      426.56,
      295.37,
      472.64
    ],
    "text": "I, hereby give notice under Sub-section (1) of Section 7 ofthe Land Acquisition Act, that the Government intends toacquire the following lands which are required for a publicpurpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.2,
      486.55,
      227.68,
      496.64
    ],
    "text": "Description of the lands to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
