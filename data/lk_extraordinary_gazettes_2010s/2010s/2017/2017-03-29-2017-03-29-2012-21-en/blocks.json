  {
    "page_number": 0,
    "bbox": [
      70.32,
      393.6,
      310.53,
      451.67
    ],
    "text": "I hereby give Notice, under sub section (1) of section 7 of theLand Acquisition Act, as amended by the Land Acquisition(Amendment) Act, No.28 of 1964, that the Government intendsto acquire the following land/ servitude for public purpose(the conservation of Dumbara mountain range.)",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      79.44,
      463.44,
      278.8,
      473.51
    ],
    "text": "Description of the land servitude to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      70.32,
      482.64,
      310.55,
      552.71
    ],
    "text": "An allotment of land called ''Koboneela Watta\"bearing anextent of about 21.2508 Hectares mentioned in F. V. P. 504 Sup.9 Sheet 9 (lot number 192, 193,194,197), Supplement of thesurveyor Genaral, situated in the Grama Niladhari Division ofKobonilla, in the Divisional Secretary's Division ofUdadumbara of Kandy District, Central Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
