      365.6,
      539.66,
      410.24
    ],
    "text": "1. Lot No. 169 Name of the Land: Welkeptiyawewaththa/Godaparagahahena; Claimant: Land Reclamation Commission; Extent :0.7081 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
