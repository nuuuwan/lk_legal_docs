    ],
    "text": "Mortgage Act, No. 06 of 1949",
    "fonts": [
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      400.69,
      537.91,
      447.76
    ],
    "text": "IT is hereby notified that the Hon. Minister of Industry and Commerce has by virtue of the powers vested in him, underSection 114(1) of the Mortgage Act, No. 06 of 1949, has appointed Mr. Shahibdeen Sunairdeen to be the Chairman andMr. K. A. Vimalenthirarajah and Mrs. R. A. Indika I. Ranathunga to be the other members of the Board constituted for thepurpose of the above Act, for a period of 03 years effective from 13th June 2017 to 12th June 2020.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      460.69,
      537.81,
      483.76
    ],
    "text": "It is further notified that the previous Board constituted in terms of Sri Lanka Government Gazette No. 1,602 of28.02.2014 ceased to be in operation.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
