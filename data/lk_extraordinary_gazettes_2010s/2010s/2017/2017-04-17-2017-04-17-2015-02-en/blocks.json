    "bbox": [
      318.24,
      334.88,
      380.52,
      345.0
    ],
    "text": "01. Lot No. 01",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.32,
      346.17,
      539.65,
      400.4
    ],
    "text": "Name of the Land: Ovitewaththa; Description: Wood; Claimant: State; Original Claimant: A. A. M. P. Amarasinghe, Weyangoda, Essella, Naiwala, 1/60; Extent: 0.1736 Hectare.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.079591751098633,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.32,
      403.04,
      539.65,
      552.08
    ],
    "text": "All persons interested in the aforesaid land/lands on which a servitude is to be acquired are hereby required to appear personally, or by agents duly authorized in writing, before me at Divisional Secretariat, Warakapola on th 28th day of June, 2017 At 10.00 a.m. and are hereby requested to notify to me in writing (in duplicate) on or before the 21st day of June, 2017, the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land/servitude, the amount of compensation and the details of the computations of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
