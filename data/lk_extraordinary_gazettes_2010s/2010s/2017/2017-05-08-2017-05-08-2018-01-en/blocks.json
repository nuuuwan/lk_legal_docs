  {
    "page_number": 0,
    "bbox": [
      47.85,
      399.13,
      539.91,
      446.32
    ],
    "text": "IT is hereby notified that by virtue of powers vested in me under Section 17 of the Customs Ordinance (Chapter 235)I, W. A. Chulananda Perera, Director General of Customs, determine that with effect from 08th May, 2017, all duties ofCustoms as well as other charges, penalties and forfeitures incurred under the Customs Ordinance (Chapter 235), shall be paidand received at the Rates of Exchange set out in the Schedule.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      453.25,
      539.85,
      488.32
    ],
    "text": "The notification relating to the Rates of Exchange published in Gazette Extraordinary, No. 2017/1 of01st May, 2017 is hereby rescinded and the said Rates of Exchange are Scheduled to be rescinded by a similar notificationto be published on or before 14th May, 2017.",
