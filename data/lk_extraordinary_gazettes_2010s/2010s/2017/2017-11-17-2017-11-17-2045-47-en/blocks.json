      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      363.37,
      539.9,
      410.44
    ],
    "text": "IT is hereby notified that His Excellency the President has been pleased to promote Rear Admiral Sirimevan SarathchandraRanasinghe, WWV, RWP, USP, ndc, psc, AOWC to the rank of Vice Admiral with effect from October 26, 2017 and toappoint him under the Article 61E, (1)(a) of the Constitution of the Democratic Socialist Republic of Sri Lanka as theHead of the Sri Lanka Navy, with effect from that date.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      10.0
