14\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014- (\u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259) 15 0.3325 1. \u0dd9\u0daf\u02a3\u01e6 \u0da2\u0dba\u01af\u0dc3\u0dca\u0dc3 \u0daf\u0dc3\u0db1\u0dcf\u0dba\u0d9a 502921894v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 2. \u023e\u0db8\u0db1\u0dd9\u0118 \u013d\u01b4 \u0da2\u0dba\u01af\u0dc3\u0dca\u0dc3 537721669v \u0dc3\u0db8 \u0d85\u0250\u01af\u0dba 93\u0d92, \u00fd\u0249\u0d9a \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb, \u0dd9\u0d9c\u02a4\u0db1\u0db4\u0dbd \u0dc4\u01e6\u01ce\u0dba 75 0.0486 \u0db4\u0da7\u0db6\u0dd0\u01ce\u0dd9\u0118 \u01b1\u0dc2\u0dcf\u01e7 \u01e7\u0dbd\u0d82\u0d9c\u0dcf 775843152v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d85\u0dd9\u0229\u0289\u025c\u0dba \u00fd\u0249\u0d9a \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb, \u0db4\u01e6\u0dc3\u0dbd \u0dc4\u01e6\u01ce\u0dba \u0dd9\u0d9c\u02a4\u0db1\u0db4\u0dbd \u0dc4\u01e6\u01ce\u0dba 102 0.0508 \u0da2\u0dba\u01b1\u0d82\u0d9c \u0dd9\u0daf\u02a4\u0db1 \u0218\u0dba\u0287\u0263 498661920v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 178 \u2013 45\u0287/5, \u0dc0\u0db1\u023d\u0d9a\u01e6\u0daf \u0db4\u0dcf\u0dbb, \u00fd\u0249\u0d9a, \u028f \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0dd9\u0d9c\u02a4\u0db1\u0dd9\u0db4\u02a3\u0dbd \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, 172 0.0223 \u0dbb\u0da2\u0dba \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 173 0.0299 \u01d0\u0262\u027f \u01e7\u0266\u0d9a\u0dcf \u0dad\u01e6\u01af\u025c\u0dc0\u01ae\u0dad 765081343v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 172 \u2013 104/\u022b/4, \u0dc0\u0db1\u023e\u0d9a\u01e6\u0daf \u0db4\u0dcf\u0dbb, \u00fd\u0249\u0d9a \u028f \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb, \u0dd9\u0d9c\u02a4\u0db1\u0db4\u0dbd \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, \u0db8\u0dc4\u0da2\u0db1 \u0db6\u0dd0\u0d82\u00fd\u0dc0\u0da7 \u0dad\u0db6\u0dcf \u0d87\u01af \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u01ae\u0dc0 178 0.0654 \u0dbb\u0da2\u0dba \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 179 0.0309 \u026b\u0dbb\u0286\u0d82\u0dc4 \u0288\u01ca\u0daf\u0db1\u0dcf\u0db8\u0dd9\u0118 \u0db1\u0263\u01e6\u0daf 830760768v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a \u2013 \u0dc3\u023c\u0db4\u01ae 178 \u028f 45\u0287/5\u0d92, \u0dc0\u0db1\u023e\u0d9a\u01e6\u0daf \u0db4\u0dcf\u0dbb, \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0dd9\u0d9a\u01ae\u0286\u025c\u021a\u0dbb, \u00fd\u0249\u0d9a \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb, \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, \u0dd9\u0d9c\u02a4\u0db1\u0db4\u0dbd 180 0.0309 \u0dc4\u021a\u0db1\u01e6\u01af\u025c\u0dd9\u0118 \u0dc0\u025e\u0dab \u0d8b\u0daf\u0dba\u0d82\u0d9c 862391349v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 178 \u2013 \u0da0\u0dcf\u023d\u0d9a\u0dbb \u028f \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf 45/\u0287/5\u022b, \u0dd9\u0d9a\u01ae\u0286\u025c\u021a\u0dbb, \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, \u0dc0\u0db1\u023d\u0d9a\u01e6\u0daf \u0db4\u0dcf\u0dbb, \u00fd\u0249\u0d9a \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb, \u0da2\u0dcf\u01af\u0d9a \u0d89\u01af\u025c \u0dd9\u0d9c\u02a4\u0db1\u0db4\u0dbd \u00fb\u025d \u0dd9\u023c \u0db6\u0dd0\u0d82\u00fd\u0dc0\u0da7 \u0dad\u0db6\u0dcf \u0d87\u01af \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u01ae\u0dc0 182 0.0482 \u0dbb\u0da2\u0dba \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 184 0.0309 \u0db8\u0dd9\u0dc4\u02a2\u0dc2\u0dca \u0d89\u01ff\u01e7\u0262 \u0dc0\u01e7\u0d9c\u0286\u0d82\u0dc4 762463148v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 178 \u2013 45\u02877, \u0dc0\u0db1\u023e\u0d9a\u01e6\u0daf\u0db4\u0dcf\u0dbb, \u00fd\u0249\u0d9a, \u0dc3\u0dc4 182 \u028f \u0dd9\u0d9c\u02a4\u0db1\u0dd9\u0db4\u02a3\u0dbd \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, \u0da2\u0dcf\u01af\u0d9a \u0d89\u01af\u025c \u00fb\u025d \u0dd9\u023c \u0db6\u0dd0\u0d82\u00fd\u0dc0\u0da7 \u0dad\u0db6\u0dcf \u0d87\u01af \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u01ae\u0dc0 185 0.0306 \u0da0\u01e6\u01d8\u0d9a\u0dcf \u0dc0\u01e7\u0d9c\u0286\u0d82\u0dc4 647960413v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 178 \u2013 101/28, \u0240\u0dab\u0db8\u0262\u0d9c\u0dc4\u0dc0\u01ae\u0dad, \u0dc3\u0dc4 182 \u028f \u0dd9\u0dc4\u02a3\u01e6\u0db1\u01e6\u0dad\u0dbb, \u0218\u0298\u0dba\u01e6\u0daf\u0dbd \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, 188 0.0302 \u0dc0\u018d\u0dd9\u0118 \u0dc3\u0db8\u01e6 \u021f\u0dba\u0d82\u0d9a\u0dbb 610401112v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 178 \u2013 45/\u0287/1, \u0dc0\u0db1\u023e\u0d9a\u01e6\u0daf \u0db4\u0dcf\u0dbb, \u0dba\u0db1 \u0d9a\u0dd0\u0db6\u0263 \u0dc0\u0dbd \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb \u00fd\u0249\u0d9a \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, 190 0.0300 \u0d85\u0d82\u0dd9\u0dc4\u0178\u0179 \u0dd9\u0d9c\u0daf\u0dbb \u0dd9\u0dc3\u02a2\u0db1\u0d9a \u0db1\u0263\u01e6 780023490v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u