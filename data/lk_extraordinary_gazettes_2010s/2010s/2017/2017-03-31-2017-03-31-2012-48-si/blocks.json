    "text": "(55 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba) \u0dd9\u0d9a\u02a3\u0dc5\u0db9 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f \u0dd9\u0dc4\u02a4\u0db8\u0dcf\u0d9c\u0db8 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc1\u0dd9\u024f \u0d8b\u018d\u0dc0\u0db1 \u0db1\u0db8\u0dd0\u01af \u0d9c\u0dd9\u023c \u026a\u0289 \u023d\u0dba\u0119\u0dba \u0d85\u0dd9\u0246\u0218\u0179\u0dba\u0dd9\u0118 \u0daf\u0dba\u0dcf\u0db4\u0dcf\u0dbd \u0db8\u0dc4\u0dad\u0dcf\u0dd9\u0118 \u0d85\u01e6\u01af\u0db8 \u0d9a\u0dd0\u0db8\u01af \u0db4\u01b4\u0dba\u00fa \u0dd9\u0db1\u02a3\u0db8\u0dd0\u01af \u0dd9\u01ca\u0db4\u0dc5 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dc0\u0250. \u023d\u0dba\u0119\u0dba \u0d85\u0dd9\u0246\u0218\u0179\u0dba\u0dd9\u0118 \u0daf\u0dba\u0dcf\u0db4\u0dcf\u0dbd \u0db8\u0dc4\u0dad\u0dcf\u0da7 \u0d85\u0dba\u01ae \u0dc0 \u01af\u022c\u019f \u0dc4\u0dcf \u0dd9\u0db8\u028f \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f \u026a\u0dc3\u0dca\u0dad\u0dbb \u0dd9\u0d9a\u02a3\u0da7 \u0d87\u01ae\u0dad\u0dcf \u026d, \u0d85\u01e6\u01af\u0db8 \u0d9a\u0dd0\u0db8\u01af \u0db4\u01b4\u0dba\u00fa \u0dd9\u0db1\u02a3\u0db8\u0dd0\u01af \u0dd9\u01ca\u0db4\u0dc5\u0da7 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0dcf \u0286\u0179\u0db1 \u0dd9\u0dc4\u02a4 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dad\u0dcf\u0dc0\u0dba\u00fa \u0d87\u01af \u0dd9\u0dc4\u02a4 \u0db1\u0dd0\u0dad\u0dd0\u01ae\u0dd9\u0dad\u00fd/ \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u01e6 \u026a\u0286\u01e6 \u0d91\u00fc \u0d85\u01e6\u01af\u0db8 \u0d9a\u0dd0\u0db8\u01af \u0db4\u01b4\u0dba\u00fa \u0dd9\u0db1\u02a3\u0db8\u0dd0\u01af \u0dd9\u01ca\u0db4\u0dc5\u0da7 \u0dad\u0db8\u0dcf\u0dd9\u0118 \u0d87\u01af \u0d85\u0250\u01af\u0dba \u0dd9\u0dc4\u02a4 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dad\u0dcf\u0dc0 \u0d9a\u0dc0\u0dd9\u0259\u0daf\u0dd0\u0250 2017 \u0d85\u0dd9\u021d\u02a2\u0262 \u0db8\u0dc3 30 \u01ce\u0db1\u0da7 \u0dd9\u0db4\u0dbb \u0db4\u0dc4\u0dad \u0d85\u01ae\u0dc3\u01e6 \u0d9a\u0dbb\u0db1 \u0d85\u0dba \u0dd9\u0dc0\u0dad \u0263\u0110\u0dad\u0dc0 \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dc5 \u0252\u01b1 \u0db6\u0dc0 \u0dd9\u0db8\u0250\u01e6 \u01e7\u0dd9\u0269\u0daf\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229. \u0d91\u0dd9\u0dc3\u02a2 \u00fb\u025d\u0db8 \u0db4\u0dd0\u0dc4\u0dd0\u0dbb \u0dc4\u025c\u01e9 \u0dbd\u0dd0\u022c\u0dc0\u0dd9\u0dc4\u02a3\u01ae, 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u00fb\u025d\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 55 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (2) \u0dc0\u0db1 \u0dc3\u0dc4 (3) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af \u0dba\u0da7\u0dd9\u01ae \u0d92 \u0dd9\u01ca\u0db4\u0dc5 \u0218\u0298\u0db6\u0db3 \u0d85\u0250\u01af\u0dba \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u00fb\u025d\u0db8\u0da7 \u0d92\u0d9a\u0db4\u0dcf\u00fa\u027f\u0d9a\u0dc0 \u0218\u0dba\u0dc0\u0dbb \u0d9c\u01e9 \u0dbd\u0dd0\u0dd9\u0229. \u0dd9\u00fa.\u0d92.\u0dd9\u00fa.\u0dbb\u0d82\u014f\u01ae \u0db0\u0259\u0db8\u0db4\u0dcf\u0dbd, \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca. 2017 \u0db8\u0dcf\u0259\u01b1 \u0db8\u0dc3 09 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd, \u0dbb\u0da2\u0db8\u0262\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbb, \"\u023d\u028f\u0d9a\u0dad \u0db8\u0dd0\u01d0\u0dbb\", \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dd9\u0269 \u01cf \u0dba.",
