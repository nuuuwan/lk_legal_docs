    "text": "\u0dd9\u0d9a\u02a3\u0dc5\u0db9 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d85\u0d82\u0d9a 572 B \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dc0\u0dc3\u0dd9\u023c \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0d9a\u0dc4\u0da7\u0d9c\u0dc4\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u0d9a\u0db1\u01e6\u0dd9\u0db1\u02a3\u025e\u0dc0 \u0dc0\u01ae\u0dad \u0db1\u0dd0\u0db8\u01af \u0d89\u0da9\u0dd9\u0db8\u01e6 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0db4\u0259\u0da0\u0dc3\u0dca 289 \u00fa \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0db6\u0dbd\u0dba\u0dbd\u01ae \u023d\u01e7\u01e6\u0dd9\u0daf\u02a4\u025e \u0d91\u023c. \u0d91\u023c. \u018c. \u00fd\u0dd9\u0259 \u0db8\u0dc4\u0dad\u0dcf \u026a\u0286\u01e6 2012.09.10 \u01ce\u0dd9\u0db1\u01e6 \u0dc3\u0d9a\u0dc3\u0dca\u0d9a\u0dbb \u0d87\u01af \u0d85\u0d82\u0d9a 2555 \u0daf\u0dbb\u0db1 \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 1 \u0dc4\u0dcf 2 \u0dd9\u0dbd\u0dc3 \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0db8\u0dcf\u0250\u023c \u01b1\u0dc5 \u026d \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0dd9\u0daf\u0d9a.",
