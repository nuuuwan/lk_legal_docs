    "text": "\u0dbd\u0db6\u0dcf\u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u02a3\u0dd9\u0dbb\u02a3\u01ae\u01b1\u0dc0\u0db1 \u0d89\u0da9\u0dd9\u023c/\u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dd9\u0269 \u026a\u0dc3\u0dca\u0dad\u0dbb : \u0db8\u0db0\u0255\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0db8\u0dc4\u01e9\u0dc0\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0d8b\u0da9\u0db4\u0dc5\u0dcf\u0dad \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d9a\u01ff\u0d9a\u0dbb \u0d89\u0dc4\u0dc5 \u0dd9\u0d9a\u02a4\u0dbb\u0dd9\u0dc5\u02a2, \u0d9c\u0dbd\u0dad \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dc0\u0dc3\u0dd9\u023c \u0218\u028f\u0179 \u0db8\u0dd0\u019f\u023c\u0db4\u01af \u026a\u0286\u01e6 \u0db8\u0dd0\u0db1 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a 5844 \u0daf\u0dbb\u0db1 \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0dd0\u0263 \u0d85\u0d82\u0d9a 1 \u0dc4\u0dcf 2 \u0daf\u00fa\u0dc0\u0dcf \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 21.6678 \u00fa \u0dc0\u0db1 \u0d85\u0da7\u0db6\u0dcf\u0dd9\u0118 \u0dc0\u01ae\u0dad \u0db1\u023c \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3. (\u0d9a\u0dd0\u0db6\u0263 \u026a\u0dc3\u0dca\u0dad\u0dbb \u0dbd\u0dd0\u0250\u0dc3\u0dca\u01b1\u0dc0 \u0d85\u023f\u0dab\u0dcf \u0d87\u0dad): 01. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a\u0dba 01 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0d85\u0da7\u0db6\u0dcf\u0dd9\u0118 \u0dc0\u01ae\u0dad: \u0218\u0249\u025e \u0d85\u0d82\u0d9a\u0dba: 5844: \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba\u0dd9\u0118 \u026a\u0dc3\u0dca\u0dad\u0dbb: \u0da2\u0db1\u0dad\u0dcf \u0dc0\u01b1 \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db8\u019c\u0da9\u0dbd\u0dba \u0dc3\u0dc4 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0: \u0d85\u01ae\u0db4\u01ae \u0d9a\u0dbb\u0d9c\u01ae \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 16.7058 02. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a\u0dba 02 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0d85\u0da7\u0db6\u0dcf\u0dd9\u0118\u0dc0\u01ae\u0dad: \u0218\u0249\u025e \u0d85\u0d82\u0d9a\u0dba: 5844: \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba\u0dd9\u0118 \u026a\u0dc3\u0dca\u0dad\u0dbb: \u0da2\u0db1\u0dad\u0dcf \u0dc0\u01b1 \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db8\u019c\u0da9\u0dbd\u0dba \u0dc3\u0dc4 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0: \u0d85\u01ae\u0db4\u01ae \u0d9a\u0dbb\u0d9c\u01ae \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 4.9620 \u0dc0\u01e6\u01ce \u0db4\u025d\u00fa\u0dc2\u0dab \u01ce\u0db1\u0dba\u01e6 \u0dc4\u0dcf \u0dd9\u0269\u0dbd\u0dcf\u0dc0: \u0d85\u01e9. \u0218\u0249\u025e \u0d9a\u0dd0\u0db6\u0dd0\u0263 \u0dc0\u01e6\u01ce \u0dd9\u0269\u0dbd\u0dcf\u0dc0 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u0db4\u025d\u00fa\u0dc2\u0dab \u01ce\u0db1\u0dba 01 \u023f.\u0218.\u0db8\u0dc4 5844 01 \u0dc4\u0dcf 02 2017.08.23 \u0db4.\u0dc0.1.30 \u0d9c\u023c\u0dd9\u0db4\u02a3\u0dbd \u0d8b\u0da9\u0db4\u0dc5\u0dcf\u0dad \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dba",
