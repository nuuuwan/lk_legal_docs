  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      400.17,
      286.43,
      476.68
    ],
    "text": "I, hereby give notice, under Sub-section (1) of Section 7 of the Land Acquisition Act, as amended by the land Acquisition (Amendment) Act, No. 28 of 1964, that the Government intend to acquire the following Land/Servitude which is required for a public purpose.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      4.079591751098633,
      5.039495944976807,
      7.91920804977417,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      57.84,
      478.15,
      275.64,
      488.23
    ],
    "text": "Description of the land or Servitude to be acquired :",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      489.41,
      286.41,
      542.23
    ],
    "text": "Under mentioned allotments of land in extent 0.1316 in the Surveyor General\u2019s Final Village Plan No. 472 (Additional No. 21) situated in Batuwangala in the Divisional Secretary\u2019s Division Neluwa in the Galle.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      6.959303855895996,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      552.12,
      286.42,
      592.64
    ],
    "text": "1. Lot No. 770 Name of the land: Kurunduwaththa; Description: Scrub Jungle; Extent 2.8330 Hectares.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.9994001388549805,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      360.32,
      539.5,
      485.36
    ],
    "text": "All Persons interested in the aforesaid land/lands* on which a Servitude is to be acquired are hereby required to appear personally, or by agents duly authorized in writing, before me at the Divisional Secretariat Neluwa on the 11th day of December, 2017 at 10.00 a.m. and are hereby requested to notify to me in writing (in duplicate) on or before the 1st day of December, 2017 the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land/servitude*, the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      486.31,
      527.88,
      578.47
    ],
    "text": "C. B. K. JANAKA GURUSINGHE, Divisional Secretary, Neluwa Division. Divisional Secretary\u2019s Office, Neluwa, 27th September 2017.",
    "fonts": [
      "TimesNewRomanPSMT"
