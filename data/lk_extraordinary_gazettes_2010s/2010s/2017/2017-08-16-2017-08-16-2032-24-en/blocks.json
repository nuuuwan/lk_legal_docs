  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      429.97,
      539.75,
      452.08
    ],
    "text": "This Order shall be valid for a period of 06 months commencing from 17th August 2017, subject to provisions ofSub Section (3) of Section 2 of the Special Commodity Levy Act, No. 48 of 2007.",
