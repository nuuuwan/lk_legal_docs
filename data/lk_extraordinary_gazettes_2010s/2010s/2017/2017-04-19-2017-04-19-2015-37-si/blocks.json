14\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014- (\u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259) 1 0.0063 \u021a\u01ca\u0d9c\u0263\u0d9a \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u0d9a\u0dd0.\u0d85 03 \u0da7 \u021d\u0dd9\u0269\u0dc1 \u026b\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 4 0.0098 \u021a\u01ca\u0d9c\u0263\u0d9a \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u0d9a\u0dd0.\u0d85. 5, 6 \u0dc3\u0dc4 7 \u0da7 \u021d\u0dd9\u0269\u0dc1 \u026b\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 6 0.0192 \u0dc0\u0dbd\u0d9a\u0da9\u0dc0\u01ae\u0dad\u0dd9\u0118 \u0db6\u01e6\u01d0\u0dbd\u0dd9\u0dc3\u02a2\u0db1 580593160v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 04 \u028f \u2013 \u021d\u0db1\u0dcf\u01e6\u01d0 \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0d82\u0d9a 42/\u022b 3, \u0dba\u0179\u0dba\u0db1\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbb, \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, \u0dc4\u0dd0\u018b\u0d9c\u0db8, \u0218\u0298\u0dba\u01e6\u0daf\u0dbd \u0dbb\u0dcf\u0da2\u0255 \u0d8b\u0d9a\u0dc3\u0dca \u0dc4\u0dcf \u0d86\u0dd9\u0dba\u02a4\u0da2\u0db1 \u0db6\u0dd0\u0d82\u00fd\u0dc0\u0da7 \u0dad\u0db6\u0dcf \u0d87\u01af \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u01ae\u0dc0 8 0.0208 \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 11 0.0118 \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 14 0.1159 \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 23 0.0239 \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 34 0.0070 \u021a\u01ca\u0d9c\u0263\u0d9a \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u0d9a\u0dd0.\u0d85. 31, 32, 33 \u0dc3\u0dc4 35 \u0da7 \u021d\u0dd9\u0269\u0dc1 \u026b\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 41 0.0226 \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 42 0.0292 \u0dd9\u01ca\u0dc0\u0db1\u0dcf\u0dbb\u0dcf\u0dba\u0db1\u0dd9\u0118 \u0dc3\u01e6\u0db0\u0255\u0dcf \u0dd9\u0dc3\u02a2\u0db4\u0dcf\u0263 658412710v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d85\u0d82\u0d9a 40/4 \u0d8a, \u0dba\u0179\u0dba\u0db1\u0dc0\u01ae\u0dad, \u0dc4\u0dd0\u018b\u0d9c\u0db8, \u0218\u0298\u0dba\u01e6\u0daf\u0dbd 44 0.0395 \u0dbb\u0dab\u0286\u0d82\u0dc4\u0dd9\u0118 \u0dc3\u0db1\u01ae 631391451v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d85\u0d82\u0d9a 40/4 \u0d91\u0dc6\u0dca, \u0dba\u0179\u0dba\u0db1\u0dc0\u01ae\u0dad, \u0dc4\u0dd0\u018b\u0d9c\u0db8, \u0218\u0298\u0dba\u01e6\u0daf\u0dbd 45 0.0149 \u0dc4\u0dd0\u01e6\u0db1\u0dd0\u01ce\u0dd9\u0118 \u014f\u01af\u0262 \u021d\u0dc3\u01e6\u0db1 663502182v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 12 \u0dc3\u0dc4 \u2013 \u0dd9\u0dc3\u02a3\u0250\u0dc3\u0dcf 41 \u028f \u0d85\u0d82\u0d9a 40/4/\u0150 1, \u0dba\u0179\u0dba\u0db1 \u0dc0\u01ae\u0dad, \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0dc4\u0dd0\u018b\u0d9c\u0db8, \u0218\u0298\u0dba\u01e6\u0daf\u0dbd \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, 47 0.0159 \u0dad\u0dd0\u01e6\u0dd9\u01e6 \u0dd9\u0d9c\u0daf\u0dbb \u026a\u0dd9\u014e\u0dbb\u01ae\u0db1\u0dd9\u0118 \u0db6\u01e6\u01d0\u0dbd 653423683v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 12 \u0dc3\u0dc4 \u2013 \u0dc4\u025c\u0dc3\u0dca\u0da0\u01e6\u01d6 41 \u028f \u0d85\u0d82\u0d9a 40/4 \u0150, \u0dba\u0179\u0dba\u0db1\u0dc0\u01ae\u0dad, \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0dc4\u0dd0\u018b\u0d9c\u0db8, \u0218\u0298\u0dba\u01e6\u0daf\u0dbd \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, 53 0.0025 \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013",
