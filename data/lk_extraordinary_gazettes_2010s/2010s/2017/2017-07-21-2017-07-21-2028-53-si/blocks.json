    "text": "\u01cf\u0217\u01af \u0db1\u0dcf\u0dbb\u023c\u0db4\u0db1\u0dcf\u0dc0, 940\u0d8a, \u0d8b\u0da9\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbb, \u0dad\u0dbd\u0d82\u0d9c\u0db8 \u0d8b\u01b1\u0dbb, \u0db8\u0dcf\u0dbd\u0dd9\u0229. \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0d89\u0da9\u0db8\u0da7/\u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf\u0dc0\u0dba\u0da7 \u028f\u023d\u0d9a\u023c, \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u0dc3\u023c\u0db6\u01e6\u0db0\u0d9a\u023c \u00fb\u0dba\u0dcf \u0286\u0179\u0db1 \u0286\u0dba\u0265 \u0dd9\u0daf\u0db1\u0dcf\u0db8 \u0dad\u0db8 \u0dad\u0db8\u01e6 \u0dd9\u0dc4\u02a4 \u0d94\u026c\u01e6\u0dd9\u0d9c\u01e6 \u0263\u0dba\u026a\u0263\u0dc0\u0263\u01e6 \u0db6\u0dbd\u0dba\u0dbd\u01ae \u0d85\u0dba\u0dc0\u0265\u01e6 \u0dd9\u0dc4\u02a4 2017 \u0dc3\u0dd0\u0217\u0dad\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 20 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0dd9\u0db4. \u0dc0. 10.00 \u0da7 \u0d8b\u0da9\u01d0\u023c\u0db6\u0dbb \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dd9\u024f \u01cf \u0db8\u0dcf \u0dc3\u023c\u023f\u0d9b \u026a\u0dba \u0252\u01b1 \u0dba.",
