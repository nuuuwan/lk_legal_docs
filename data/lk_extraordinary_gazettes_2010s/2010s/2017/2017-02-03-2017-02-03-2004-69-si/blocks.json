    "text": "\u0db8\u0db0\u0255\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0db8\u0dcf\u0dad\u0dd9\u0262 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0db8\u0dcf\u0dad\u0dd9\u0262 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0dd9\u0d9a\u02a3\u0dd9\u0dc4\u02a3\u01e6\u0286\u0dba \u0db4\u01ae\u01b1\u0dc0 \u0288\u029a \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d9a\u029a\u0daf\u0dd1\u0dc0\u0dbd \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3 \u0d85\u0d82\u0d9a 2 \u0db8\u01e6\u0daf\u019c\u0da9\u0dcf\u0dc0\u0dbd (\u0db8\u0dcf\u0dad\u0dd9\u0262 \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0287\u0db8\u0dcf\u0dc0 \u01b1\u0dc5) \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 \u0db8\u0dd0\u0db1 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a \u0db8\u0dcf/1688 \u0daf\u0dbb\u0db1 \u0240\u0263\u0d9a \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 1 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u00fa. 0.1064 \u00fa \u026d \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dcf\u0250\u023c :",
