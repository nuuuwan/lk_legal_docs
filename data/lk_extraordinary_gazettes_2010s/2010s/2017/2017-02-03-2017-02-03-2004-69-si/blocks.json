    "text": "\u0d85\u0d82\u0d9a 283/16 \u0dc4\u0dcf 1984 \u0dd9\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u025c 09 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af\u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4 \u0dd9\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 7 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dc0\u0db1 \u0db4\u0dc4\u0dad \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba\u0db1\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0daf\u0dd0\u01e6\u026b\u0db8.",
