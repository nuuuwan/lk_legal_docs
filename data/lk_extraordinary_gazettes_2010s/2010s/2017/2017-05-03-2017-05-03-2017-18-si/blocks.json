    ],
    "text": "78 0.3279 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 79 0.1077 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 80 0.0833 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 81 0.0191 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 82 0.2734 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 83 0.0350 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 84 0.0165 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 85 0.0995 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 86 0.2886 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 87 0.2265 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 88 0.1577 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 89 0.1140 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 90 0.1022 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd",
