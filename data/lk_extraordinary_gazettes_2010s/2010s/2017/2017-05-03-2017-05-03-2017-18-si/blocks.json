14\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014- (\u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259) 65 0.0555 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 66 0.0962 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 67 0.0162 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 68 0.0024 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 69 0.0509 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 70 0.0331 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 71 0.0510 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 72 0.0855 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 73 0.0916 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 74 0.0889 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 75 0.0600 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 76 0.0013 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd 77 0.0370 \u0dc3\u0db7\u0dcf\u0db4\u01af \u2013 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 \u0d89\u0da9\u023c \u021d\u01af\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dd9\u0d9a\u02a3\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dc0, \u0d85\u0d82\u0d9a 475, \u0d9a\u018d\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0d9c\u0dd9\u01e6\u0dd9\u0dc4\u02a2\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd",
