    "text": "28. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 507 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0db1\u02a3\u0daf\u01e8, \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d85\u0db1\u0dc0\u0dc3\u0dbb\u0d9a\u025e, \u0dba\u0dcf\u0dba 06, \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0db4\u01ce\u0d82\u013d \u0dd9\u0db4\u02a3\u0262\u0dc0\u01ae\u0dd9\u01ae \u0dd9\u0d9c\u0daf\u0dbb \u0288\u0db8\u0db1\u0dcf\u0dc0\u01b0; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0072. 29. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 509 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0db1\u02a3\u0daf\u01e8, \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d85\u0db1\u0dc0\u0dc3\u0dbb\u0d9a\u025e, \u0dba\u0dcf\u0dba 06, \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0db4\u01ce\u0d82\u013d \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0db6\u0dcf\u0dbd\u0289\u025c\u0dba \u0d86\u0dbb\u013c\u013d\u0dd9\u0118 \u026b\u0dbb\u0dd9\u0d9a\u02a4\u01e6; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0101. 30. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 511 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0db1\u02a3\u0daf\u01e8, \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0dba\u0dcf\u0dba 06, \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0d9a\u019d\u0dc2\u0dca\u0da8 \u026a\u0daf\u0255\u0dcf\u0dbd\u0dba; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0229. 31. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 512 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0db1\u02a3\u0daf\u01e8, \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d85\u0db1\u0dc0\u0dc3\u0dbb\u0d9a\u025e, \u0dba\u0dcf\u0dba 06, \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0db4\u01ce\u0d82\u013d \u0db8\u0dcf\u0dbb\u0286\u0d82\u0dc4 \u0dd9\u0217\u018b\u0dd9\u0118 \u011b\u0dab\u0daf\u0dcf\u0dc3; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0092. 32. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 513 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0db1\u02a3\u0daf\u01e8, \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d85\u0db1\u0dc0\u0dc3\u0dbb\u0d9a\u025e, \u0dba\u0dcf\u0dba 06, \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0db4\u01ce\u0d82\u013d \u0dba\u0179\u01e9\u0dc0\u0dbb \u0dd9\u0d9c\u0daf\u0dbb \u0288\u0db8\u0db1\u0daf\u0dcf\u0dc3; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0818. 33. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 515 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0d9a\u0dd0\u0dd9\u0262, \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dd9\u0db4\u02a5\u01ca\u0d9c\u0263\u0d9a; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0db8\u0dcf\u0259\u0d9c\u0dba \u0d89\u01ce\u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u01ae\u0db4\u01ae\u0d9a\u0dbb \u0d9c\u0dad \u0252\u01b1\u0dc0 \u0d87\u0dad; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0346. 34. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 516 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0d9a\u0dd0\u0dd9\u0262, \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d85\u0db1\u0dc0\u0dc3\u0dbb\u0d9a\u025e, \u0d85\u0d82\u0d9a 61, \u0dba\u0dcf\u0dba 06, \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0db4\u01ce\u0d82\u013d \u0db8\u0d82\u0d9c\u0dbd \u0dd9\u0d9a\u02a3\u017b\u0dd9\u0269 \u0dd9\u0d9c\u0daf\u0dbb \u0d85\u0dd9\u0229\u0dc0\u0259\u0db0\u0db1; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0023. 35. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 518 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0d9a\u0dd0\u0dd9\u0262, \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0dba\u0dcf\u0dba 06, \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0db4\u01ce\u0d82\u013d \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0dbd\u0d82\u0dc3\u00fa\u0d9a\u0dcf\u0dbb \u023f\u01ce\u0dba\u01e6\u0dd9\u0dc3\u02a2\u0dbd\u0dcf\u0dd9\u0118 \u0dd9\u0dc3\u02a4\u0db8\u0db4\u0dcf\u0dbd \u026a\u0286\u01e6 \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0db8\u0dad \u0236\u00fa\u01af\u026a\u01fe; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0010. 36. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 519 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0db1\u02a3\u0daf\u01e8, \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0d9a\u0dd0\u0dd9\u0262, \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d85\u0db1\u0dc0\u0dc3\u0dbb\u0d9a\u025e, \u0d85\u0d82\u0d9a 61, \u0dba\u0dcf\u0dba 06, \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0db4\u01ce\u0d82\u013d \u0db8\u0d82\u0d9c\u0dbd \u0dd9\u0d9a\u02a3\u017b\u0dd9\u0269 \u0dd9\u0d9c\u0daf\u0dbb \u0d85\u0dd9\u0229\u0dc0\u0259\u0db0\u0db1; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0001. 37. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 520 \u0d89\u0da9\u0dd9\