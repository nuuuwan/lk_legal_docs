0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d85\u0db1\u0dc0\u0dc3\u0dbb\u0d9a\u025e, \u0dba\u0dcf\u0dba 06, \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0db4\u01ce\u0d82\u013d \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0d8b\u0dbd\u0db4\u0db1\u0dba\u0dbd\u0dcf\u0dd9\u0118 \u0d8b\u021a\u0262 \u0da0\u01e6\u01d6 \u0dd9\u021d\u02a2\u0db8\u00fd\u0db8\u0dcf\u0dbb; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0264. 24. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 502 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0db1\u02a3\u0daf\u01e8, \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d85\u0db1\u0dc0\u0dc3\u0dbb\u0d9a\u025e, \u0dba\u0dcf\u0dba 06, \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0db4\u01ce\u0d82\u013d \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0db8\u0dd0\u019d\u00fa \u021a\u0dbb\u0dd9\u024f\u0dbd\u0dcf\u0dd9\u0118 \u0daf\u0dba\u0dcf\u0dbb\u01ae\u0db1; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0006. 25. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 504 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: \u0dd9\u0db1\u02a3\u0daf\u01e8, \u026a\u0dc0\u0dd8\u0dad \u023f\u018d\u022a\u0db8; \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u026a\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d85\u0db1\u0dc0\u0dc3\u0dbb\u0d9a\u025e, \u0dba\u0dcf\u0dba 06, \u01ce\u0118\u0d9c\u0262\u021a\u0dbb \u0db8\u0dd0\u01ce\u025c\u0119\u025c\u0dba \u0db4\u01ce\u0d82\u013d \u026b\u0dbb\u0286\u025c \u023f\u01ce\u0dba\u01e6\u0dd9\u0dc3\u02a2\u0dbd\u0dcf\u0dd9\u0118 \u0dbb\u023c\u0db8\u0dd0\u019d\u0dd9\u00fa; \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0412. 26. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 505 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8: