    "text": "\u0b95\u0bbe\u0ba3\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0bb5\u0bb4\u1fb0\u0b95\u0bbf\u1fbe\u1f81 \u0b85\u1fbf\u0bb2\u1f90 \u0b95\u0bbe\u0ba3\u0bbf\u1fb7 \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0\u0b95\u0bbe\u0bb0\u1fbd/ \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0 \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fb0\u1f81\u0bbe\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u0ba9\u1f90 \u0b89\u1fb5\u0baa\u1fb5\u0b9f \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1f9e\u1fb0 \u1f90\u1fb6\u1f8a\u1fb9 \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0b95\u0bbe\u0bb0\u1fbd\u0b95\u0bb3\u0bbf\u1fb9 \u1f99\u1fa8\u1fba \u0bc6\u0baa\u0baf\u1fbd\u0b95\u1fa6\u1fbb \u0b85\u0bc8\u0b9f\u0baf\u0bbe\u0bb3 \u0b87\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 \u0bb5\u1f81\u1fba\u1f97\u1fbb \u0b88\u1f8c, \u1f81\u1fb7 \u1f81\u0bbe\u0bbf\u0baf \u0b9a\u1fb5\u0b9f\u1fb1 \u0b87\u0bb2. \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u1f9c\u1fbb \u0b85\u1fb5\u0bc8\u0b9f \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0b87\u0baf\u1fbf\u1f97\u1fbb \u0ba4\u0bc8\u0b95 \u0b95\u1fa6\u1fc0 \u0b8e\u1fc2 (\u0bc6\u0bb9\u1fb0\u0b9f\u0baf\u0bbe\u1fbd) \u0b87\u0bb2. \u0ba4\u1f8c\u1fba\u1f97\u1fb0 \u0bb5\u0bc8\u0b95\u1fb0\u1f81\u1fbb \u0b95\u1fb5\u0b9f\u0bc8\u0bb3 \u0b85\u0bc8\u0bae\u1fb8\u0ba4\u0bbf\u1f9e\u1fba \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0baa\u0bbf\u1fb9 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0 \u0b95\u1fc0 2 0.0487 \u0b95\u0bc8\u0bb2\u1fb2\u0bc6\u0b9a\u1fbf\u0bb5\u0bbf \u0b95\u1fb8\u0bc8\u0ba4\u0baf\u0bbe 625560926V \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 - - \u0b87\u0bb2. 525 \u0baa\u0bb2\u0bbe\u1fa2 \u1faa\u0ba4\u0bbf, \u0ba4\u0bbf\u1f9e\u0bc6\u0ba8\u1fbf\u0bc7\u0bb5\u1fa2 9 0.0636 \u0b95\u0bbe\u1fbd\u1fb7\u0ba4\u0bbf\u0b95\u0bbe \u0baa\u0bbe\u1fc4\u0b95\u0bb0\u1fb9 \u0b87\u1fbf\u0bc8\u0bb2 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 10 - \u0b87\u0bb2. 07 \u0baa\u0bbf\u1fc0\u0bc8\u0bb3\u0baf\u0bbe\u1fbd \u1faa\u0ba4\u0bbf, \u0b87\u1fb9 \u0b95\u0bbf\u0bb4\u1fb0\u1f81 \u0ba4\u0bbf\u1f9e\u0bc6\u0ba8\u1fbf\u0bc7\u0bb5\u1fa2 \u0b8e\u1fbf\u0bc8\u0bb2\u0baf\u0bbf\u1fa4\u1fc0\u0bb3 \u0b95\u0bbf\u0ba3\u1fbe\u0bb1\u0bbf\u1fb9 \u1f97\u0bb1\u0ba8\u0bc0\u1fb1\u0b95\u0bb2\u0bbe\u0ba9 \u0baa\u1fb1\u1f81\u1fbb, \u0bb5\u0b9f\u1fb0\u1f81 \u0b8e\u1fbf\u0bc8\u0bb2\u0baf\u0bbf\u1f95\u0b9f\u0bbe\u0ba9 \u0bb5\u0bb4\u0bbf\u0bb5\u0bbe\u1fbc\u1fb0\u0b95\u0bbe\u1fbf \u0baa\u0bbe\u0bb5\u0bbf\u1fba\u1f97\u0bbe\u0bbf\u1fb7\u1f90\u1fbb. 15 0.2815 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa - \u0ba8\u1fbf\u1fa5\u1fbd - \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 - - 16 0.0508 1.\u0b9a\u0bbf\u1fb7\u0ba4\u0bbf \u0bae\u0b95\u0bbe\u1fa2\u1fb1\u0b95\u1fbb \u0b87\u1fbf\u0bc8\u0bb2 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 - - 2.\u0bae\u0b95\u0bbe\u1fa2\u1fb1\u0b95\u1fbb \u0b95\u0ba3\u0baa\u0ba4\u0bbf\u1fba\u0baa\u0bbf\u1fc0\u0bc8\u0bb3 583524169V \u0b9a\u0bae \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bae\u0bbe\u0bbe\u0bbf\u0baf\u1fbb\u0bae\u1fb9 \u1faa\u0ba4\u0bbf, \u0ba4\u0bbf\u1f9e\u0bc6\u0ba8\u1fbf\u0bc7\u0bb5\u1fa2 26 0.0680 \u0b9a\u0bc7\u0bb0\u0bbe\u0b9c\u0bbf\u0ba9\u0bbf\u0bc7\u0ba4\u0bb5\u0bbf \u0ba4\u0ba9\u0baa\u0bbe\u0bb2\u1f86\u1fb8\u0ba4\u0bb0\u1fbb 625554039V \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bc7\u0bb5\u1fa4\u1fba\u0baa\u0bbf\u1fc0\u0bc8\u0bb3 - \u0b87\u0bb2. 527 \u0baa\u0bb2\u0bbe\u1fa2 \u1faa\u0ba4\u0bbf, \u0ba4\u0bbf\u1f9e\u0bc6\u0ba8\u1fbf\u0bc7\u0bb5\u1fa2 \u0ba4\u0ba9\u0baa\u0bbe\u0bb2\u1f86\u1fb8\u0ba4\u0bb0\u1fbb \u0b8e\u1fb9\u0baa\u0bb5\u0bb0\u1f90 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 27 0.0495 \u0b9e\u0bbe\u0ba9\u0b9a\u1fb0\u0ba4\u0bbf \u0b95\u0bc7\u0ba3\u0b9a\u0ba8\u0bbe\u0ba4\u1fb9 666320115V \u1f99\u1fa8\u0bb5\u1f90\u1fbb 2\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 48 - \u0b87\u0bb2. 528 \u0baa\u0bb2\u0bbe\u1fa2 \u1faa\u0ba4\u0bbf, \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0ba4\u0bbf\u1f9e\u0bc6\u0ba8\u1fbf\u0bc7\u0bb5\u1fa2 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\u1fbb, \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 45 \u0b87\u1fbf \u0b89\u1fc0\u0bb3 \u0b95\u0bbf\u0ba3\u1fbe\u0bb1\u0bbf\u1fb9 \u0baa\u1fb1\u1f81\u1fbb, \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 46 \u0b87\u1fb9 \u0b8a\u0b9f\u0bbe\u0ba9 \u0bb5\u0bb4\u0bbf \u0bb5\u0bbe\u1fbc\u1fb0\u0b95\u0bbe\u1fbf \u0baa\u0bbe\u0bb5\u0bbf\u1fba\u1f97\u0bbe\u0bbf\u1fb7\u1f90\u1fbb. 34 0.0213 \u0baf\u0b9a\u0bbf\u0ba8\u1fb8\u0ba4\u0bbf\u0ba9\u0bbf \u0b9a\u1fb8\u0ba4\u0bbf\u0bb0\u0bc7\u0b9a\u0b95\u1fbd 705522332V \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 31 - \u0b87\u0bb2. 12/12 \u0bae\u0bbe\u0bbe\u0bbf\u0baf\u1fbb\u0bae\u1fb9 \u1faa\u0ba4\u0bbf, \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0ba4\u0bbf\u1f9e\u0bc6\u0ba8\u1fbf\u0bc7\u0bb5\u1fa2 \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 50 0.0847 \u0b9a\u0bbf\u0bb5\u0bb0\u1fb4\u0b9c\u0bbf\u0ba9\u0bbf \u0b9a\u0bbf\u0bb5\u1f9f\u0baa\u1fb9 868160810V \u1f99\u1fa8\u0bb5\u1f90\u1fbb 2\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 - - \u0b87\u0bb2. 155 \u0baa\u0bb2\u0bbe\u1fa2 \u1faa\u0ba4\u0bbf, \u0ba4\u0bbf\u1f9e\u0bc6\u0ba8\u1fbf\u0bc7\u0bb5\u1fa2 60 0.0972 1.\u0b95\u0ba4\u0bbf\u1fbd\u0b95\u0bbe\u0bae\u0ba8\u0bbe\u0ba4\u1fb9 \u0b95\u0bc7\u0ba3\u0b9a\u0ba8\u0bbe\u0ba4\u1fb9 660360328V \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. - 2.\u0b9e\u0bbe\u0ba9\u0b9a\u1fb0\u0ba4\u0bbf \u0b95\u0bc7\u0ba3\u0b9a\u0ba8\u0bbe\u0ba4\u1fb9 666320115V \u0b9a\u0bae \u0b89\u0bbe\u0bbf\u0bc8\u0bae 48 \u0b87\u1fb9 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0b87\u0bb2. 528 \u0baa\u0bb2\u0bbe\u1fa2 \u1faa\u0ba4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f