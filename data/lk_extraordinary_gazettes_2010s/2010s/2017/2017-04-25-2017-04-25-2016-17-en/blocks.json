  },
  {
    "page_number": 0,
    "bbox": [
      304.56,
      337.28,
      589.78,
      485.36
    ],
    "text": "All parsons interested in the aforesaid land on which a servitude is to be acquired are hereby required to appear personally, or by agents duly authorized in writing, before me at the Land Acquisition Office of the Metro Colombo Urban Development Projects located in the Head Office of the Sri Lanka Land Reclamation and Development Corporation, No. 03, Sri Jayawardhanapura Mawatha, Welikada, Rajagiriya on 31st of May, 2017 at 9.30 a. m. and are hereby requested to notify to me in writing (in duplicate) on or before 23rd of May, 2017 the nature of their claims for compensation for the acquisition of the said land the amount of compensation and the details of the compensation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
