  },
  {
    "page_number": 0,
    "bbox": [
      47.85,
      460.69,
      539.92,
      486.76
    ],
    "text": "This Order shall be valid for a period of 60 days from 01st April 2017, subject to provisions of Sub section (3) ofSection 2 of the Special Commodity Levy Act, No. 48 of 2007.",
