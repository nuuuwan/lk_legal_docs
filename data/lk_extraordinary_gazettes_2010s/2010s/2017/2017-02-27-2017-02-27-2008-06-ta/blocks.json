    "text": "\u0bb5\u0b9f\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0b85\u1f92\u0bb0\u0bbe\u0ba4\u1f97\u0bb0 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0b87\u0baa\u0bc7\u0bb2\u0bbe\u0b95\u0bae \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 \u0b95\u0bb2\u0bbe\u0b95\u0bae \u0bc7\u0b95\u0bbe\u0bb0\u0bc8\u0bb3\u0baf\u0bbf\u0ba9\u0bcd \u0b9a\u0bbf\u1fa0 \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0bb5\u0bbf\u0b9c\u0bbf\u0ba4\u1f97\u0bb0 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bc8\u0bae\u0ba8\u0bcd\u0ba4, \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5 \u0bae\u0bbe \u0b85\u0ba4\u0bbf\u0baa\u0bb0\u0bbe\u0bb2\u0bcd \u0b85\u0bb3\u0ba8\u0bcd\u1f90, 2011.08.26 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c \u0ba4\u0baf\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u1fa0\u0ba4\u0bbf\u0b95\u0bcd \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0bb5\u0bc8\u0bb0\u0baa\u0b9f \u0b87\u0bb2. 850, \u0bc7\u0bae\u0bb2\u0ba4\u0bbf\u0b95 \u0b87\u0bb2. 8, \u0baa\u1f8a\u0bb5 \u0b87\u0bb2. 10 \u0b90 \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u1f90\u0ba3\u0bcd\u1f8a\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 244 \u0b8e\u0ba9\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u201c\u0bb5\u0bbf\u0b9c\u0bbf\u0ba4\u1f97\u0bb0 \u0bb2\u0ba8\u0bcd\u0ba4\u201d \u0b8e\u0ba9\u0bcd\u1f94\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0043 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u1f99\u0bc8\u0b9f\u0baf \u0b95\u0bc