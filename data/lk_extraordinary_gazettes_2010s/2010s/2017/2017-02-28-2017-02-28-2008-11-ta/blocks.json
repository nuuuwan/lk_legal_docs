    ],
    "text": "\u0b8e\u1f8c\u0ba4\u0bcd\u1f90\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0bb5\u0bbf\u1f9e\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd: \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0b95\u0ba3\u0bcd\u1f8a \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0b89\u0b9f\u1f90\u0bae\u0bcd\u0baa\u0bb0 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b95\u0bbf\u0bbe\u0bbf\u0b95\u0b99\u0bcd\u0b95\u0bc1\u1f97\u0bb0 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0bae\u0bc0\u0bc7\u0ba4\u0bbe\u0b9f\u0bc7\u0bb9\u0ba9 (\u0b85\u1f99\u0bc7\u0bb9\u0ba9, \u0bb5\u0b9f\u0bc6\u0b95\u0bbe\u0b9f\u0bc7\u0bb9\u0ba9, \u0b89\u0b9f\u0baa\u0ba4\u0ba9, \u0ba4\u0ba3\u0bc7\u0bb9\u0bc7\u0ba9\u0bc7\u0bb9\u0ba9, \u0b95\u0bb2\u0bcd\u0b92\u1f9e\u0bc7\u0bb5\u0bc7\u0bb9\u0ba9) \u0b8e\u0ba9\u0bcd\u1fa0 \u0b85\u0bc8\u0bb4\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0b87\u0b9f\u0ba4\u0bcd\u0bc8\u0ba4, \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0ba8\u0bbe\u0baf\u0b95\u0ba4\u0bcd \u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0ba4\u0baf\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87. \u0b95\u0bbf. \u0bb5. \u0b87\u0bb2. 369 \u0baa\u0bbf\u0bb1\u0bcd\u0bc7\u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0bc8\u0b95 14 \u0ba4\u0bbe\u0bb3\u0bcd \u0b87\u0bb2. 14 \u0b87\u0bb2. 562, 563, 564, 565, 566, 567, 568, 569, 570, 571, 572, 573, 574, 575, 576, 577, 578, 579, 580, 581, 582, 583, 584, 585, 586, 587, 588 \u0b8e\u0ba9\u0bcd\u1fa0 \u0bb5\u0bbf\u0baa\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 7.0196 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u