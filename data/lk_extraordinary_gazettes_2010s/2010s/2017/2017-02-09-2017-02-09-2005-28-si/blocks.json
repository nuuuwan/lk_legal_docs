14\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014- (\u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259) 9 0.0648 \u0db8\u0dcf\u0dd9\u0d9a\u0dd9\u0dc4\u0262\u0dc0\u0dbd \u01e7\u0dc1\u0dcf\u01e6\u0dad \u0288\u025c\u0dba\u0dd9\u0d9c\u02a3\u0da9 693520223v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 109\u022b/1, \u00fd\u029a\u0db4\u0db1, \u0dd9\u0db4\u02a3\u00fd\u019f\u026a\u0da7, 38 0.0313 \u0d9c\u0db8\u0dd9\u0118 \u0288\u01e7\u0262 \u0dc0\u0dc3\u01e6\u0dad \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf 523370782v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 39 \u028f \u2013 126, \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u0db4\u0dcf\u0dbb, \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d9a\u0249\u025e\u0dd9\u0d9c\u02a3\u0da9.\u0db6\u019c\u0da9\u0dcf\u0dbb\u0d9c\u0db8, \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, 40 0.0510 \u0dd9\u0dc4\u02a2\u0dc0\u0dcf \u0288\u01e6\u0daf\u0dbb\u0dd9\u0118 \u0da0\u023d\u01e6\u0daf \u0dc3\u0d82\u0150\u0dc0 763041964v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 39\u028f \u2013 93/\u0287/5, \u0da0\u01e6\u01ce\u0d9a \u026a\u0dbb\u0dcf\u014f\u01ae \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0db8\u0dcf\u0dc0\u0dad, \u00fd\u029a\u0db4\u0db1, \u0dd9\u0dc4\u02a3\u0dbb\u0dab, \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, \u0dbd\u0d82\u0d9a\u0dcf \u0db6\u0dd0\u0d82\u00fd\u0dc0\u0da7 \u0dad\u0db6\u0dcf \u0d87\u01af \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u01ae\u0dc0 52 0.0634 \u0dd9\u0dc4\u0178\u0179\u0dd9\u0118 \u0da0\u01e6\u01d6\u0dbd\u0dcf\u0262 \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf 196814301110 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 104\u018c, \u00fd\u029a\u0db4\u0db1, \u0dd9\u0db4\u02a3\u00fd\u019f\u026a\u0da7, 56 0.0312 \u0d85\u0150\u01ae \u0dd9\u0dc4\u0178\u0179\u0dd9\u0118 622351978v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 \u2013 39, \u0dd9\u0dc4\u02a3\u0dbb\u0dab \u0db4\u0dcf\u0dbb, \u0dd9\u0db4\u02a3\u00fd\u019f\u026a\u0da7, 74 0.0250 \u0d9c\u0db8\u0dd9\u0118 \u0288\u01e7\u0262 \u0dc0\u0dc3\u01e6\u0dad \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf 523370782v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 39 \u028f \u2013 126, \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u0db4\u0dcf\u0dbb, \u0d9a\u0249\u025e\u0dd9\u0d9c\u02a3\u0da9, \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0db6\u01e6\u0da9\u0dcf\u0dbb\u0d9c\u0db8, \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, 75 0.0252 \u0d9c\u0db8\u0dd9\u0118 \u0288\u01e7\u0262 \u0dc0\u0dc3\u01e6\u0dad \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf 523370782v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 39 \u028f \u2013 126, \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0 \u0db4\u0dcf\u0dbb, \u0d9a\u0249\u025e\u0dd9\u0d9c\u02a3\u0da9, \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0db6\u019c\u0da9\u0dcf\u0dbb\u0d9c\u0db8, \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f, 119 0.0265 \u0d85\u0dd9\u0229\u0286\u0d82\u0dc4\u0dd9\u0118 \u0dd9\u0daf\u02a3\u01e6 \u0d89\u0dd9\u0db1\u02a4\u0d9a\u0dcf \u0db0\u023c\u023d\u0d9a\u0dcf 715530694v \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0da2\u0dcf\u01af\u0d9a \u0d89\u01af\u025c \u2013 \u0d85\u0dd9\u0229\u0286\u0dc4 \u00fb\u025d \u0dd9\u023c \u0db6\u0dd0\u0d82\u00fd\u0dc0\u0da7 16 \u0d9a\u01e9\u0dc0 \u0d89\u01ce\u025c\u0218\u0da7, \u00fd\u029a\u0db4\u0db1, \u0dad\u0db6\u0dcf \u0d87\u01af \u0d8b\u0d9a\u0dc3\u0da7 \u0dd9\u0db4\u02a3\u00fd\u019f\u026a\u0da7, \u0dba\u0da7\u01ae\u0dc0 122 0.0383 \u0dd9\u021d\u02a2\u0db8\u0287\u0263 \u0db4\u0dbb