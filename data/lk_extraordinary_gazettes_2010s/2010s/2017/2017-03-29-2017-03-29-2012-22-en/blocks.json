    ],
    "text": "My Ref. No.: WLP/LAN/2/3/21Land Ministry Reference No.: 4-3/8/2012/PC/172",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
