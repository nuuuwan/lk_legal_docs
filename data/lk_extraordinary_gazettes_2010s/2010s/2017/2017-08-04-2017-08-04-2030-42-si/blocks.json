    "text": "\u0dbd\u0db6\u0dcf\u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dd9\u0db4\u02a3\u0dd9\u0dbb\u02a3\u01ae\u01b1\u0dc0\u0db1 \u0d89\u0da9\u0dd9\u023c/\u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dd9\u0269 \u026a\u0dc3\u0dca\u0dad\u0dbb : \u0d9c\u0dcf\u0262\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0db6\u0dc5\u0218\u0179\u0dba \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d85\u0d82\u0d9a 87 \u0287, \u0dc0\u01b1\u0dd9\u0d9c\u0daf\u0dbb \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dc0\u0dc3\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9c\u0dcf. 4262 \u0dc4\u0dcf 2017.06.13 \u01ce\u0db1\u0dd0\u01af \u0240\u0263\u0d9a \u0218\u0249\u0dd9\u0259 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 01, 02, 03, 04, 05, 06, 07, 08, 09, 10, 11, 12, 13, 14, 15, 16 \u0dc3\u0dc4 17 \u0dd9\u0dbd\u0dc3 \u0dd9\u0db4\u01e6\u01e9\u023c \u0d9a\u0dbb \u0d87\u01af \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0350 \u00fa \u0db4\u0db8\u0dab \u026d \u01b1\u018d\u0dd9\u0269\u0dd9\u0d9c\u02a3\u0da9\u0db6\u0dd0\u01ca\u0daf \u0db1\u0dd0\u0db8\u01af \u0d89\u0da9\u023c \u01b1\u018d\u0dd9\u0269\u0dd9\u0d9c\u02a3\u0da9 \u0d9a\u01e6\u0daf \u0d8b\u0da9\u0da7 \u0d87\u01af \u0db4\u0dcf\u0dbb \u022b. \u0d91\u013c. \u0218\u0dba\u0dd9\u0dc3\u02a2\u0db1 \u0db8\u0dc4\u0dad\u0dcf\u0dd9\u0118 \u01e7\u0dc0\u0dc3 \u0218\u017b\u0db4\u0286\u01e6 \u0d87\u01af \u0db4\u0dcf\u0dbb\u0da7 \u0dc3\u023c\u0db6\u01e6\u0db0 \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u01ae\u0db4\u01ae \u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0db8.",
