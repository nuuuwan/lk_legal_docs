  {
    "page_number": 0,
    "bbox": [
      83.76,
      475.68,
      295.84,
      485.75
    ],
    "text": "Description of the Land or Servitude to be acquired:",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
