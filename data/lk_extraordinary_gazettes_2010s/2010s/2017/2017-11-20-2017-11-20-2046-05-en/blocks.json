    "bbox": [
      57.84,
      547.27,
      273.0,
      557.35
    ],
    "text": "Description of the land or Servitude to be acquired :",
    "fonts": [
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.64,
      558.29,
      288.84,
      645.92
    ],
    "text": "Allotments of land described in below in Plan No. Ma 1713, Approved by Matale Snr. Superintendents of Surveys, Situated in Ulpathapitiya Village, Ulpathapitiya Grama Niladhari Division, in Sub Division of Matale Medasiya Pattuwa, in the Rattota Divisional Secretariat Division, in Matale District, in Central Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      6.959303855895996,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      360.6,
      539.36,
      424.16
    ],
    "text": "Lot No. 1 Name of the land: Rukaththana Gaha Watta; Description: Garden; Claimant: Mrs. S. P. Wasantha Kokilam, No. 2/103, Kiula, Matale; ; Extent 0.1012 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      5.9994001388549805,
      10.078991889953613
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.08,
      424.64,
      539.53,
      538.16
    ],
    "text": "All Persons interested in the aforesaid land is hereby required to appear personally, or by agents duly authorized in writing before me at Divisional Secretariat Rattota on the 10th day of January, 2018, at 10.00 a.m. and are hereby requested to notify to me in writing (in duplicate) on or before the 02nd day of January, 2018, the nature of their interest in the land, the particulars of their claims for compensation for the acquisition of the said land the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.078991889953613
    ]
