  {
    "page_number": 0,
    "bbox": [
      304.32,
      387.92,
      539.98,
      564.08
    ],
    "text": "\u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba \u0dd9\u0d9a\u02a3\u0dc5\u0db9 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0dd9\u0db8\u02a3\u0dbb\u017b\u0dc0 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d85\u0d82\u0d9a 551 \u0d9a\u017b\u0db6\u0dd0\u01ca\u0daf \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dc0\u0dc3\u0dd9\u023c \u0d9a\u017b\u0db6\u0dd0\u01ca\u0daf \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0d9c\u023c\u0db8\u0dd0\u01ca\u0daf \u00fd\u0249\u0dbb \u0db1\u0dd0\u0db8\u01af \u0d89\u0da9\u0dd9\u0db8\u01e6 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0db4\u0259\u0da0\u0dc3\u0dca 25 \u00fa \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0db8\u0dcf\u0250\u023c \u01b1\u0dc5 \u026d \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3. \u0d8b\u01b1\u0dbb\u0da7 : \u0d9c\u023c\u0db8\u0dd0\u01ca\u0daf \u00fd\u0249\u0dbb \u0d89\u0da9\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7 : \u01cf\u0db4 \u0d87\u0dc5; \u0daf\u00fd\u0dab\u0da7: \u0d9a\u017b\u0db6\u0dd0\u01ca\u0daf \u0286\u0da7 \u0218\u0298\u0dba\u01e6\u0daf\u0dbd \u0daf\u00fa\u0dc0\u0dcf \u026d \u0db6\u019c\u0da9\u0dcf\u0dbb\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dcf\u0dc0\u0dad; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0218\u0249\u025e \u0d85\u0d82\u0d9a 2354 \u028f A1 \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0dd0\u0262\u0dbd ; \u0d89\u0da9\u0db8\u0da7 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u01e6\u0db1\u01e6\u0dd9\u0118 \u0db1\u023c \u0dc3\u0dc4 \u0263\u0218\u0db1\u0dba: \u026a\u0db8\u0dbd\u0dcf \u026a\u0dd9\u014e\u01b1\u0d82\u0d9c \u023d\u0dba, \u0d85\u0d82\u0d9a : 77, \u201c\u0286\u025c\u0db8\u0262\u2019\u2019, \u0db6\u019c\u0da9\u0dcf\u0dbb\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dcf\u0dc0\u0dad, \u0d9a\u017b\u0db6\u0dd0\u01ca\u0daf, \u0dd9\u0db8\u02a3\u0dbb\u017b\u0dc0.",
