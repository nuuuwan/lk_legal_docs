9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u1fbf, \u201c\u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0\u0b95\u0bbe\u0bb0\u1fbd / \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0\u0b95\u0bbe\u0bb0\u1fbd\u0b95\u0bb3\u0bbf\u1fb9 \u0bc6\u0baa\u0baf\u1fbd\u0b95\u1fa6\u1fbb \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u1f9c\u1fbb, \u0bc7\u0ba4\u0b9a\u0bbf\u0baf \u0b85\u0bc8\u0b9f\u0baf\u0bbe\u0bb3 \u0b85\u1fb5 \u0b87\u0bb2\u1fb0\u0b95\u1fbb, \u0b95\u0bbe\u0ba3\u0bbf \u0bb5\u0bb4\u1fb0\u0b95\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0b9f\u0baa\u1fb5\u0b9f\u0ba4\u0bbe \u0b88\u1f8c \u1f81\u1fb7\u0ba4\u0bc8\u0b95 \u0ba4\u1f8c\u1fba\u1f97\u1fb0 \u0b95\u1fb5\u0b9f\u0bc8\u0bb3 \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0, \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0b85\u1fbf\u0bb2\u1f90 \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1f9e\u1fb0\u1f81\u0bbe\u0bbf\u0baf \u0b9a\u1fb5\u0b9f\u1fb1\u0b95\u1fa6\u1fc0 \u0b8e\u1fc2\u0bb5\u0bc8\u0b95\u1fb0\u1f81\u1fbb \u0b85\u0bc8\u0bae\u1fb8\u0ba4\u0bbf\u1f9e\u1fba\u0baa\u0bbf\u1fb9 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u1fc0\u201d \u0b86\u0b95\u0bbf\u0baf \u0ba8\u0bbf\u0bb0\u1fbf\u0b95\u0bb3\u0bbf\u1fbf \u201c\u0b8f\u0b95\u0ba8\u0bbe\u0baf\u0b95 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bb2\u0bbe\u0bc7\u0b95 \u0bb0\u0bae\u0ba9\u0bbf \u0b85\u0bc7\u0ba9\u0bbe\u0bae\u0bbe \u0ba8\u0bbe\u0ba9\u0bbe\u0baf\u1fb0\u0b95\u0bbe\u0bb0, \u0b87\u0bb2. 20/\u0baa\u0bbf, \u0bc6\u0baa\u0baf\u0bbe\u0bb0 \u1f96\u1fbf\u1fb5 \u0b89\u1fb7\u0baf\u0bbe\u0ba9\u0baf, \u0bc6\u0b95\u0bbe\u1fa8\u1fbb\u1f97 08, 587923084 v, 620083 \u0baa\u0bbf\u0bbe\u0bbf\u1fab 10 \u0b95\u0bbe\u0ba3\u0bbf\u1fb7 \u1f90\u1fb6\u1f8c \u0b87\u0bb2. 163 \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90, \u0bae\u1fbe\u1fa0\u1fbb \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u1fa0\u0b9a\u0bc0\u0bb0\u0bc8\u0bae\u1fba\u1f97 \u0b86\u0bc8\u0ba3\u1fb0\u1f81\u1fa8\u0bb5\u0bbf\u1fb9 \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90\u201d \u0b8