      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      498.0,
      310.97,
      568.07
    ],
    "text": "Under mentioned land shown in the Surveyor General\u2019s Planof F. V. P. 2343, situated in the Village of Parabewila in theGrama Niladari Division of No. 893 Parabewila in the MinorDivision of Udapolamedalassa Korale in PolgahawelaDivisional Secretary\u2019s Division in Kurunagala District ofNorth West Province.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      69.84,
      580.8,
      310.85,
      638.87
    ],
    "text": "1. Lot No. 136Name of the Land: Katakalagahamulawaththa aliasDamunugahamulawaththa; Description: Garden; Claimant:Government; Original Claimant: Dushmanthi Liyanagama;Extent: 0.0409 Hectare.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
