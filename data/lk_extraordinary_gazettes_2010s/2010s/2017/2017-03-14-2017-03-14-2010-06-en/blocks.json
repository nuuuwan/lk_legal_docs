    "bbox": [
      69.84,
      416.4,
      310.97,
      462.47
    ],
    "text": "I hereby give notice, under Sub-section (1) of Section 7 of theLand Acquisition Act, No. 28 of 1964, that the Governmentintends to acquire the following land/servitude* which isrequired for a public purpose:",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.070419311523438
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      84.0,
      475.2,
      296.92,
      485.27
    ],
    "text": "Description of the Land or Servitude to be acquired:",
