    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      175.15,
      381.17,
      397.18,
      405.23
    ],
    "text": "(f)to grant scholarships to needy school children toenable them to continue their education;",
    "fonts": [
      "Times",
