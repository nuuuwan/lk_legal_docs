    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      173.71,
      241.49,
      397.19,
      265.55
    ],
    "text": "(c)to establish information technology centers for theadvancement of scientific studies;",
    "fonts": [
      "Times",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      172.87,
      279.65,
      397.19,
