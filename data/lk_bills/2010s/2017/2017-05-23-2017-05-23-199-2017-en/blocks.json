  },
  {
    "page_number": 4,
    "bbox": [
      161.85,
      203.45,
      401.91,
      278.27
    ],
    "text": "5.The provisions of section 28A of this Act, shall haveeffect notwithstanding anything to the contrary in any otherwritten law, and accordingly, in the event of any conflict orinconsistency between the provisions of section 28A of thisAct and such other law, the provisions of section 28A of thisAct shall prevail.",
    "fonts": [
      "Times",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      7.0,
      10.0
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      161.85,
      290.33,
      401.9,
      313.19
    ],
    "text": "6.In the event of any inconsistency between the Sinhalaand Tamil texts of this Act, the Sinhala text shall prevail.",
    "fonts": [
      "Times",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
