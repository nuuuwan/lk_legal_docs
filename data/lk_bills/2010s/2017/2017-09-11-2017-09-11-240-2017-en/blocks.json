      343.13,
      401.86,
      379.79
    ],
    "text": "2.Section 5 of the Urban Councils Ordinance (Chapter255) is hereby repealed and the following section substitutedtherefor:\u2014",
    "fonts": [
      "Times",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
