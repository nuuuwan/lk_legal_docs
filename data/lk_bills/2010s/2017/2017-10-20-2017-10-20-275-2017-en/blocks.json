      7.0,
      10.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      173.85,
      279.65,
      401.85,
      290.99
    ],
    "text": "AND TO PROVIDE FOR MATTERS CONNECTED THEREWITH OR INCIDENTAL",
