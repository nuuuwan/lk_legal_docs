    "bbox": [
      157.15,
      167.17,
      377.74,
      190.24
    ],
    "text": "Code of Criminal Procedure (Special Provisions)(Amendment)2",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 3,
