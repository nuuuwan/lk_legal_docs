    "page_number": 4,
    "bbox": [
      157.15,
      523.49,
      397.2,
      601.31
    ],
    "text": "8.(1)The Corporation shall have its own fund and allmoneys heretofore or hereafter to be received by way ofgifts, bequests, donations, subscriptions, contributions, feesor grants for and on account of the corporation shall bedeposited to the credit of the Corporation in one or morebanks as the Board of Directors shall determine.",
    "fonts": [
      "Times",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      157.15,
      616.61,
      397.19,
      667.79
    ],
