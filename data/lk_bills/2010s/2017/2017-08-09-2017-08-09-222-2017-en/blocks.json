    "bbox": [
      175.15,
      533.33,
      397.19,
      557.39
    ],
    "text": "(i)to promote discipline and cultural ethics necessaryand to make provisions to maintain it;",
    "fonts": [
      "Times",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      175.15,
      571.49,
      397.17,
      608.27
    ],
    "text": "(j)to promote artistic creations, sports skills andtechnical knowledge of school leavers and set upvocational training centers; and",
    "fonts": [
      "Times",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      173.71,
      622.25,
      397.17,
      646.31
    ],
