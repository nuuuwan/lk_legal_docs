    "fonts": [
      "Times",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      172.87,
      482.57,
      397.2,
      519.35
    ],
