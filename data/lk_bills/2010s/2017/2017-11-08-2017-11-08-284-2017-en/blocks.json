      "Times",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      172.29,
      378.29,
      401.89,
      413.03
    ],
    "text": "\u201c(4A)The Minister may prescribe any geographicalindication in respect of any goods or products forthe purpose of this Act.\u201d.",
    "fonts": [
      "Times"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      161.85,
      424.85,
      401.9,
      448.07
    ],
