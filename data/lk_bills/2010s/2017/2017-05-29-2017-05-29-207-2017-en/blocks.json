    "bbox": [
      157.15,
      275.81,
      397.19,
      335.15
    ],
    "text": "(3) Where the Account holder has failed to maintain theminimum sum as specified in section 3(1)(a), the commercialbank shall notify the Controller of Immigration andEmigration within seven days after giving the account holdera grace period not exceeding one calendar month.",
    "fonts": [
      "Times",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
