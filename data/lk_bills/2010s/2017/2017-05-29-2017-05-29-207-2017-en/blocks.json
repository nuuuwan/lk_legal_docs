    "bbox": [
      173.85,
      244.13,
      401.85,
      255.47
    ],
    "text": "NATIONALS TO REMIT FOREIGN EXCHANGE INTO SRI LANKA; AND FOR",
    "fonts": [
      "Times"
    ],
    "sizes": [
      7.0,
      10.0
    ]
  },
