  {
    "page_number": 1,
    "bbox": [
      161.85,
      355.13,
      401.86,
      389.87
    ],
    "text": "2.Section 11 of the Office on Missing Persons(Establishment, Administration and Discharge of Functions)Act, No. 14 of 2016 is hereby amended as follows:\u2014",
