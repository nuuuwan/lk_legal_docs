      372.29,
      397.26,
      455.63
    ],
    "text": "11.The seal of the Corporation shall be in the custodyof the Board of Management and it shall not be affixed to anyinstrument whatsoever, except with the sanction of theCorporation and in the presence of two Directors at least oneand the Secretary of the Corporation who shall sign their namesto the instrument in token of their presence and such signingshall be independent of the signing of any person as a witness.",
    "fonts": [
      "Times",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
