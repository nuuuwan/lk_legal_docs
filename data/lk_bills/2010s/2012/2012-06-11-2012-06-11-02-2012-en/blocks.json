  {
    "page_number": 6,
    "bbox": [
      157.15,
      274.97,
      397.17,
      322.31
    ],
    "text": "(3) The Board of Directors of the Corporation shallconsist of the members of the Board of Director of the dayimmediately preceding the date of commencement of thisAct.",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      10.0
