    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      156.19,
      389.11,
      384.45,
      398.18
    ],
    "text": "(a)remove the exemption given on humanitarian grounds ; and",
    "fonts": [
      "Times-Roman",
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      156.19,
      408.31,
      451.21,
      426.98
    ],
    "text": "(b)introduce a punishment in respect of the offence of providing material support orresources to terrorists or terrorists organizations.",
