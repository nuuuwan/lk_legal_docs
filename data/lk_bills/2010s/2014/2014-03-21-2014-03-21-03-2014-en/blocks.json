      "Times-Roman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      143.95,
      442.99,
      455.14,
      480.62
    ],
    "text": "Clause 4 : Clause 4 validates the acts performed by the Commissioner-General of InlandRevenue or the Director-General of Customs, in respect of the collection oftax during the period commencing from January1, 2014 and ending on thedate of operation of this Act.",
