    ]
  },
  {
    "page_number": 3,
    "bbox": [
      193.15,
      505.73,
      397.19,
      542.27
    ],
    "text": "Provided that, where the levy is collected priorto issuing invoices or without issuing invoices, suchlevy\u2014",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      202.87,
      556.13,
      397.19,
      605.27
    ],
