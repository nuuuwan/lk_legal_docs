      187.15,
      262.49,
      397.18,
      297.83
    ],
    "text": "\u201c(4) No assessment or additional assessment shallbe made under this Act in respect of a person orpartnership\u2014",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      10.0
    ]
