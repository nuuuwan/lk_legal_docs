    "bbox": [
      161.85,
      359.57,
      401.88,
      409.91
    ],
    "text": "2.Section 169 of the Pradeshiya Sabha Act, No. 15 of1987 as amended by Local Authorities (Special Provisions)Act, No. 21 of 2012 is hereby further amended by the repealof the Proviso to that section.",
    "fonts": [
      "Times",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
