  },
  {
    "page_number": 2,
    "bbox": [
      161.85,
      372.65,
      401.9,
      422.99
    ],
    "text": "2.Section 215A of the Municipal Councils Ordinance(Chapter 252) as amended by Local Authorities (SpecialProvisions) Act, No. 21 of 2012 is hereby further amendedby the repeal of the Proviso to that section.",
    "fonts": [
      "Times",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      7.0,
      10.0
    ]
  },
  {
