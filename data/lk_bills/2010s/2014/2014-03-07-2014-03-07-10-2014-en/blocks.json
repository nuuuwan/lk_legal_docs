      238.49,
      397.19,
      261.47
    ],
    "text": "(c) to assist low income families in the construction ofnew houese or completion of existing ones;",
    "fonts": [
      "Times-Roman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
