      "Times",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      227.37,
      480.77,
      401.86,
      505.67
    ],
    "text": "(i)the Secretary to the President of theRepublic;",
