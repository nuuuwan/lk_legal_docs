  },
  {
    "page_number": 2,
    "bbox": [
      177.09,
      399.17,
      401.85,
      437.75
    ],
    "text": "(1)by the repeal of paragraphs (a) and (b) of subsection(2) of that section and substitution therefor of thefollowing paragraph:\u2014",
    "fonts": [
      "Times",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      204.69,
      453.53,
      372.82,
      464.87
    ],
