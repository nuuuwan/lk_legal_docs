    "bbox": [
      161.85,
      304.01,
      401.89,
      328.91
    ],
    "text": "1.This Act may be cited as the National Defence Fund(Amendment) Act, No. of 2018.",
    "fonts": [
      "Times",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
