  {
    "page_number": 2,
    "bbox": [
      161.85,
      344.81,
      401.91,
      383.39
    ],
    "text": "2.Section 3 of National Defence Fund Act, No. 9 of1985 (hereinafter referred to as the \u201cprincipal enactment\u201d) ishereby amended as follows:\u2014",
    "fonts": [
      "Times",
      "TimesNewRoman,Bold"
