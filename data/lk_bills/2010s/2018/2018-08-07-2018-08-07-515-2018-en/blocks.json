      161.85,
      314.57,
      401.89,
      339.71
    ],
    "text": "1.This Act may be cited as the Economic Service Charge(Amendment) Act, No. of 2018.",
    "fonts": [
      "Times",
      "Times,Bold"
    ],
    "sizes": [
      10.0
    ]
