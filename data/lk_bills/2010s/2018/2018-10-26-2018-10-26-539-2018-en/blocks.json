      "TimesNewRoman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      139.15,
      305.15,
      451.16,
      323.61
    ],
    "text": "Clause 3 & 4: The amendments made by these Clauses are consequential to theamendment made by Clause 2.",
