      374.81,
      401.91,
      442.91
    ],
    "text": "(2) (a) The Committee of the Foundation that holds officeon the day immediately preceding the date of commencementof this Act, shall function as the Committee of the Corporationuntil the first Committee is appointed or elected in themanner provided for by rules made under section 7.",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      10.0
