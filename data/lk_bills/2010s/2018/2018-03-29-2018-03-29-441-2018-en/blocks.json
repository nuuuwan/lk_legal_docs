    ]
  },
  {
    "page_number": 4,
    "bbox": [
      215.85,
      341.93,
      401.88,
      428.87
    ],
    "text": "24C. The Commission to InvestigateAllegation of Bribery or Corruption shall notbe required, unless it deems appropriate to,record a statement of a person who has given astatement to a Commission of Inquiryappointed under section 2 or has givenevidence before such Commission.",
    "fonts": [
      "Times"
    ],
    "sizes": [
      7.0,
