    ]
  },
  {
    "page_number": 1,
    "bbox": [
      139.15,
      276.19,
      451.23,
      314.9
    ],
    "text": "Clause 2: This clause amends section 5 of the Companies Act, No. 07 of 2007 (hereinafterreferred to as the \u201cprincipal enactment\u201d) and the legal effect of the section as amended is toenable the Registrar of Companies to notify the general public regarding the incorporationof a new company giving certain details of that company.",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      139.15,
      325.63,
      451.22,
      354.5
    ],
    "text": "Clause 3: This clause amends section 9 of the principal enactment and the legal effect ofthe section as amended is to remove the requirement of any company to give public noticeof the incorporation of the company.",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      139.15,
      365.23,
      451.21,
      394.1
    ],
    "text": "Clause 4: This clause amends section 10 of the principal enactment and the legal effectof the section as amended is to enable the Registrar of Companies to direct a company tochange its name, taking into consideration the provisions of sections 5(1)(d) and 9(2).",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      8.0
    ]
  },
