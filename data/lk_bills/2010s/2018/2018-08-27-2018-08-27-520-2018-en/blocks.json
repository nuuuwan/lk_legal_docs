    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 5,
    "bbox": [
      241.15,
      353.57,
      397.18,
      412.91
    ],
    "text": "(f) maintain due care in, and records ofits handling of copies of any workin accessible format whilerespecting the privacy of abeneficiary person.\u201d.",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 5,
    "bbox": [
      157.15,
      425.57,
      397.2,
      448.91
    ],
    "text": "4.In the event of any inconsistency between the Sinhalaand Tamil texts of this Act, the Sinhala text shall prevail.",
    "fonts": [
      "Times",
      "Times,Bold"
