    "fonts": [
      "Times-Roman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      175.15,
      449.09,
      397.19,
      485.03
    ],
