      203.29,
      401.89,
      261.76
    ],
    "text": "(i)to establish relations with local and foreigninstitutions which have similar aims and objectivesof those of the above Foundation and exchangeresources when necessary and working incollaboration with those institutions;",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      179.85,
      272.53,
      401.87,
      307.12
    ],
