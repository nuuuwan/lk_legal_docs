      161.85,
      298.97,
      401.87,
      334.31
    ],
    "text": "1.This act may be cited as the Powers of Attorney(Amendment) Act, No. of 2013 and shall be deemedto have come into operation on January 1, 2013.",
    "fonts": [
      "Times-Roman",
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      161.85,
      346.97,
      401.88,
      394.31
    ],
