    ],
    "text": "AN ACT TO AMEND THE KANDAYAN MARRIAGE ANDDIVORCE ACT (CHAPTER 113)",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.0,
