    ],
    "text": "7.(1) The Corporation shall have its own fund and allmoneys received by way of gifts, testamentary dispositions,transfers, donations or contributions shall be deposited inthe name of the Corporation in once or more banks as maybe decided by the Council.",
    "fonts": [
      "Times-Roman",
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      10.0
