  },
  {
    "page_number": 4,
    "bbox": [
      157.15,
      272.93,
      397.18,
      307.67
    ],
    "text": "(2) The Corpration may establish a depreciation fund or asinking fund for the purpose of rehabilitation, developmentor improvement of the property of the Corporation.",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      10.0
