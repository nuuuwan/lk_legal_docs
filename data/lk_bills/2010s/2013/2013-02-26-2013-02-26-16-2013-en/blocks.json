    "bbox": [
      163.87,
      361.67,
      438.71,
      380.01
    ],
    "text": "(a) to include excise duty paid on the importation in the calculation of liableturnover;",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      8.0
