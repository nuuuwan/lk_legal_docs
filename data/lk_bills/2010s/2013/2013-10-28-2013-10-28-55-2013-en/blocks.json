    "text": "(a)all moneys lying to the credit of the FITIS on theday immdiately preceding the date ofcommencement of this Act, which shall standtransferred to the Corporation as from that date;",
    "fonts": [
      "Times-Roman",
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 6,
    "bbox": [
      172.87,
