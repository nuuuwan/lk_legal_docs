  },
  {
    "page_number": 2,
    "bbox": [
      170.11,
      202.97,
      397.19,
      238.31
    ],
    "text": "(c) to help to maintain the distinct identity of the differentcommunities and foster and promote friendship forpeaceful co-existence;",
    "fonts": [
      "Times-Roman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
