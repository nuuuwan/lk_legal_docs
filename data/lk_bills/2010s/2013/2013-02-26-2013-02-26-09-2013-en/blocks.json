    "fonts": [
      "Times-Roman",
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      201.57,
      571.73,
      400.91,
      595.67
    ],
    "text": "(b)for any period commencing on or afterJanuary 1, 2013-",
    "fonts": [
      "Times-Roman",
      "TimesNewRomanPS-ItalicMT"
