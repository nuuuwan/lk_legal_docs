      "Times-Roman",
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      161.85,
      378.05,
      401.89,
      469.79
    ],
    "text": "2.Section 13 of the Registration of DocumentsOrdinance (Chapter 117) (hereinafter referred to as the\u201cprincipal enactment\u201d) is hereby amended in subsection (6)of that section by the substitution for the words \u201c a feeof five rupees shall be\u201d of the words \u2018a fee of five rupees orsuch other amount as may be prescribed by the Minister,shall be\u201d.",
    "fonts": [
      "Times-Roman",
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      161.85,
      485.33,
      401.89,
      563.63
    ],
