    "fonts": [
      "Times-Roman",
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      161.85,
      579.05,
      401.88,
      603.83
    ],
