    ]
  },
  {
    "page_number": 2,
    "bbox": [
      161.85,
      346.97,
      401.89,
      406.31
    ],
    "text": "2.Section 7 of the Defence Services Command and StaffCollege Act, No. 05 of 2008 (hereinafter referred to as \u201ctheprincipal enactment\u201d) is hereby amended in subsection (1)of that section by the repeal of paragraph (f) of that subsectionand the substitution therefor, of the following paragraph:\u2014",
    "fonts": [
      "Times-Roman",
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      175.29,
      418.97,
      401.87,
      442.31
    ],
    "text": "\u201c(f)the Vice-Chancellor of the General Sir JohnKotelawala Defence University;\u201d.",
    "fonts": [
      "Times-Roman",
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.0
    ]
