    "bbox": [
      173.13,
      514.97,
      401.89,
      550.31
    ],
    "text": "\u201c(b)a representative nominated by the Vice-Chancellorof the General Sir John Kotelawala DefenceUniversity;\u201d.",
    "fonts": [
      "Times-Roman",
      "TimesNewRomanPS-ItalicMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
