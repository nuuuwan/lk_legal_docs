      375.33,
      215.27
    ],
    "text": "AN ACT TO ABOLISH THE DEATH PENALTY AND TO MAKE",
    "fonts": [
      "Times"
    ],
    "sizes": [
      7.0,
      10.0
    ]
  },
  {
