  },
  {
    "page_number": 1,
    "bbox": [
      143.23,
      314.83,
      455.28,
      333.5
    ],
    "text": "Clause 3 : This clause amends section 20 of the principal enactment enabling the Bank toraise any sums by the issue of debentures.",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      8.0
