    "bbox": [
      184.17,
      391.49,
      396.73,
      426.23
    ],
    "text": "\u201clicensed specialized bank\u201d means, a specializedbank licensed under the Banking Act, No. 30 of1988;",
    "fonts": [
      "Times"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 5,
    "bbox": [
      184.17,
      438.29,
      396.72,
      461.27
    ],
    "text": "\u201cpayment card\u201d means, a debit card, credit card,charge card or stored-value card;",
    "fonts": [
      "Times"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 5,
    "bbox": [
      184.17,
      473.33,
      396.73,
      508.07
    ],
    "text": "\u201cperson\u201d shall have the same meaning assigned tosuch expression under the Inland Revenue Act,No. 24 of 2017;",
    "fonts": [
      "Times"
    ],
    "sizes": [
      10.0
    ]
  },
