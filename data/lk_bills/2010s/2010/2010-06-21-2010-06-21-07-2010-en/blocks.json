  },
  {
    "page_number": 2,
    "bbox": [
      173.71,
      349.87,
      397.33,
      386.01
    ],
    "text": "(e)to prepare and submit reports on issues relating toeconomic and social development to and non-governmental organizations in Sri Lanka;",
    "fonts": [
      "Times-Italic",
      "Times-Roman"
    ],
    "sizes": [
      10.0
