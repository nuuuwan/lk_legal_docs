      283.13,
      401.95,
      328.91
    ],
    "text": "(2) All moneys received by way of gift, bequest, donation,subscription, contribution fees or grants for and on accountsof the Corporation shall be deposited in a bank approvedby the Governing Body to the credit of the Corporation.",
    "fonts": [
      "Times"
    ],
    "sizes": [
      10.0
