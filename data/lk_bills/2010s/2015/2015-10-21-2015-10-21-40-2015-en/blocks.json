    "bbox": [
      407.85,
      445.15,
      455.86,
      483.02
    ],
    "text": "Incorporationof theAlhasanFoundation.",
    "fonts": [
      "Times"
    ],
    "sizes": [
      8.0
    ]
  },
  {
