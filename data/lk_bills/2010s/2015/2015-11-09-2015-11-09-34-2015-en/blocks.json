    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      161.85,
      317.69,
      401.94,
      405.23
    ],
    "text": "5.(1) The management, control and adminstration ofthe Corporation shall, subject to the provision of this Actand the rules in force for the time being of the Corporation,vested in an Executive Council (hereinafter referred to asthe \u201cUpper Council\u201d) consisting of the office bearers andsuch other persons as may be provided for in such rules andelected in accordance therewith.",
    "fonts": [
      "Times",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      161.85,
      419.33,
      401.89,
      468.71
    ],
    "text": "(2) The first Executive Council members of theCorporation shall consist of the members of the UpperCouncil of the Foundation holding office on the daypreceding the date of commencement of this Act.",
    "fonts": [
      "Times"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      161.85,
      482.81,
      401.89,
