    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      157.15,
      472.85,
      397.2,
      507.23
    ],
    "text": "7.(1) The relevant Karaka Sangha Sabha of any Nikayaor Chapter may where necessary adopt amendments to theKathikawath registered under section 6.",
    "fonts": [
      "Times-Roman",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      157.15,
      518.69,
      397.24,
      553.07
    ],
    "text": "(2) The procedure set out in sections 3 and 4 of this Actshall be applicable for the registration of any amendment toa Kathikawath.",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      157.15,
      564.77,
      397.18,
      599.15
