    ]
  },
  {
    "page_number": 5,
    "bbox": [
      161.85,
      292.25,
      401.88,
      379.79
    ],
    "text": "8.(1) The Corporation shall be capable in law to takeand hold any property movable or immovable which maybecome vested in it by virtue of any purchase, grant, gift,testamentary disposition or otherwise and all such propertyshall be held by the Corporation for the purpose of this Act,and subject to the rules of the Corporation with full power tosell, mortgage, lease, exchange or dispose of the same.",
    "fonts": [
      "Times",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 5,
    "bbox": [
      161.85,
      393.89,
      401.87,
      443.27
    ],
    "text": "(2) The Corporation shall have the power to borrow orraise money necessary for the furtherance of its objects andto create, execute, grant or issue any mortgages, bounds orobligations to secure the payment of such money.",
    "fonts": [
      "Times"
    ],
    "sizes": [
