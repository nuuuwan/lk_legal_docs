    ],
    "text": "AN ACT TO AMEND THE NATIONAL AUTHORITY ON TOBACCO ANDALCOHOL ACT, NO. 27 OF 2006",
    "fonts": [
      "Times"
    ],
    "sizes": [
      7.0,
