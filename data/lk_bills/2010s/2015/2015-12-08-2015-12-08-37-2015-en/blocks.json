    "fonts": [
      "Times-Roman",
      "TimesNewRoman,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      178.29,
      401.93,
      401.9,
      425.63
    ],
