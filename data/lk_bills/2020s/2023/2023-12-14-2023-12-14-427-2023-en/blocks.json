  {
    "page_number": 2,
    "bbox": [
      221.13,
      619.13,
      401.87,
      667.31
    ],
    "text": "\u201c(ix)for any taxable period commencing onor after January 1, 2024 at the rate ofeighteen per centum (of which the taxfraction is 9/59).\u201d.",
