    ]
  },
  {
    "page_number": 1,
    "bbox": [
      166.44,
      274.34,
      405.58,
      332.93
    ],
    "text": "Clause 2 : This clause inserts the new section 68A in the MortgageAct (Chapter 89), and the legal effect of that section is to limit theapplicability of Part III of the Mortgage Act in relation to movableproperty upon coming into operation of the Secured TransactionsAct, No. of 2023.",
    "fonts": [
      "CIDFont+F1",
      "CIDFont+F5"
    ],
    "sizes": [
      8.024775505065918,
      9.941100120544434
    ]
  },
