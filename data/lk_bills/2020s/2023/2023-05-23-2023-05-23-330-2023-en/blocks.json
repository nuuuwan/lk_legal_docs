    ]
  },
  {
    "page_number": 1,
    "bbox": [
      143.83,
      271.15,
      455.89,
      309.5
    ],
    "text": "Clause 2 : This clause amends section 5 of the Carriage by Air Act and the legal effectof the section as amended is to provide for the Minister to specify the limits of liability fordomestic carriage by air, whereby the higher threshold applicable to the limits of liabilityfor international carriage by air will not be applicable to domestic carriage by air.",
    "fonts": [
      "Times-Italic",
      "Times-Roman"
    ],
    "sizes": [
      8.0
    ]
  },
