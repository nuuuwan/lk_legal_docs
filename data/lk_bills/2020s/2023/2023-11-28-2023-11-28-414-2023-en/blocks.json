      8.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      138.6,
      244.2,
      452.58,
      254.98
    ],
    "text": "technology and knowledge process outsourcing or business process outsourcing or engaged in",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
