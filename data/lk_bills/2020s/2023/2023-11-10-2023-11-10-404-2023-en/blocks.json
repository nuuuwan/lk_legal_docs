  },
  {
    "page_number": 1,
    "bbox": [
      140.16,
      372.4,
      451.79,
      410.1
    ],
    "text": "Clause 2 : This clause amends section 5 of the Prescription Ordinance (Chapter 68), andthe legal effect of the section as amended is to make provisions so that an action for therecovery of any sum due upon any mortgage of any property or any bond for the paymentof money shall be prescribed after ten years from the date of giving notice to the debtor.",
    "fonts": [
      "CIDFont+F1",
      "CIDFont+F5"
    ],
    "sizes": [
      8.040300369262695
    ]
  },
