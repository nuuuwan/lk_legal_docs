      314.57,
      401.91,
      353.51
    ],
    "text": "1.This Act may be cited as the Shop and OfficeEmployees (Regulation of Employment and Remuneration)(Amendment) Act, No. of 2020.",
    "fonts": [
      "Times",
      "Times,Bold"
    ],
    "sizes": [
      10.0
