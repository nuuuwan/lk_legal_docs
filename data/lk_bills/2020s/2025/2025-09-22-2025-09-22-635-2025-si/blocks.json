    ],
    "text": "\u201c(4) \u0db8\u0dda\ufffd \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0dc3\u0dbd\u0dc3\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db8\u0dd2\u0dc3, \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca, \u201c\u0dc0\u0dbb\u0dbd\u0dad\u0dca \u0dc0\u0dcf\u0dcf\u0dc3\u0dca\u0dad\u0dd4 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0da5\u0dba\u0dcf\u0dcf\u201d \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u201c\u0dc0\u0dbb\u0dbd\u0dad\u0dca \u0dc0\u0dcf\u0dcf\u0dc3\u0dca\u0dad\u0dd4 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0da5\u0dba\u0ddd\ufffd\u0ddd\ufffd\u201d \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u201c\u0dc0\u0dcf\u0dcf\u0dc3\u0dca\u0dad\u0dd4 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0da5\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda\u024f \u0d85\u0db0\u0dd2 \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a (\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf)\u201d \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u201c\u0dc0\u0dcf\u0dcf\u0dc3\u0dca\u0dad\u0dd4 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0da5\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda\u024f \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a (\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf)\u201d \u0dba\u0db1 \u0d85\u0db7\u0dd2\u0db0\u0dcf\u0dcf\u0db1\u0dba \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d91\u0dba \u0dc0\u0dcf\u0dcf\u0dc3\u0dca\u0dad\u0dd4 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0, \u0dc0\u0dcf\u0dcf\u0dc3\u0dca\u0dad\u0dd4 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc3\u0dd0\u0dd0\u0dbd\u0dc3\u0dd4\u0db8\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d91\u0dc4\u0dd2 \u0db1\u0dd2\u0dbb\u0dad\u0dc0\u0dd3\u0db8 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc0\u0dcf\u0dcf\u0dc3\u0dca\u0dad\u0dd4 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0dba \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd6 \u0dba\u0db8\u0dca \u0db4\u0ddc\ufffd\u0ddc\u0dad\u0d9a, \u0dc3\u0d9f\u0dbb\u0dcf\u0dcf\u0dc0\u0d9a \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0db4\u0dc5\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a \u0db1\u0dcf\u0dcf\u0db8\u0dba \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dbd\u0dd9\ufffd\u0dc3 \u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9a\u0dbb\u0db1\u0dd4 \u0db1\u0ddc\ufffd\u0ddc\u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\u201d.",
