  },
  {
    "page_number": 1,
    "bbox": [
      59.53,
      122.13,
      373.54,
      142.31
    ],
    "text": "Clause 2: This clause amends section 2 of the Betting and Gaming Levy Act, No. 40 of 1988 and the legal effect of the section as amended is to \u2013",
    "fonts": [
      "Times-Italic",
      "Times-Roman"
    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      86.53,
      155.13,
      373.55,
      175.31
    ],
    "text": "(a) limit the gross collection of ten per centum to have been applicable only for the time period April 1, 2023 to October 1, 2025;",
    "fonts": [
      "Times-Italic",
      "Times-Roman"
    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      86.53,
      188.13,
      373.54,
      208.31
    ],
    "text": "(b) increase the gross collection levy from persons carrying on a business of bookmaker or business of gambling to eighteen per centum from October 1, 2025; and",
    "fonts": [
      "Times-Italic",
      "Times-Roman"
    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      86.53,
      221.13,
      373.54,
      241.31
    ],
    "text": "(c) increase the casino entrance levy from persons who are citizens of Sri Lanka, to United States Dollars one hundred.",
    "fonts": [
      "Times-Italic",
      "Times-Roman"
    ],
    "sizes": [
      8.0
    ]
  },
  {
