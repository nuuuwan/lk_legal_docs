    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      306.07,
      75.28,
      349.62,
      114.86
    ],
    "text": "Sinhala text to prevail in case of inconsistency",
