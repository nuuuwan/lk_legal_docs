      8.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      66.8,
      425.19,
      110.34,
      464.77
    ],
    "text": "\u201cCorporal punishment in respect of children",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
