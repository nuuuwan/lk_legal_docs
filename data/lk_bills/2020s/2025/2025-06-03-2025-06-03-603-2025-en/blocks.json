      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      67.2,
      176.34,
      309.7,
      201.97
    ],
    "text": "1. (1) This Act may be cited as the Budgetary Relief Allowance of Workers (Amendment) Act, No. of 2025.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
