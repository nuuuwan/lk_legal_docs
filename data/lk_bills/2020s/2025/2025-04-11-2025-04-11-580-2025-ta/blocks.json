    "text": "(\u0b86) \u0bc6\u0bb5\u0bd7\u0bbf\u0ba8\u0bbe\u0b9f\u0bcd\u1f8c\u0b95\u0bcd \u0b95\u0b9f\u0ba9\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 4 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0bc6\u0ba4\u0bbe\u0b9f\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bc7\u0ba4\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u1f99\u0ba9\u0bcd\u0ba9\u0bbe\u0bcd \u0baa\u0ba8\u0bcd\u0ba4\u0bbf (\u0b85) \u0bb5\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u1f8c\u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90\u0bae\u0bcd \u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0bc6\u0ba4\u0bbe\u0b9f\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bc7\u0ba4\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0bc7\u0ba8\u0bbe\u0bcd\u1f99\u0bb1\u0bcd\u0bc7\u0baa\u0bbe\u0ba8\u0bcd\u0ba4 \u0ba8\u0bbe\u0bb3\u0ba9\u0bcd\u1fa0 \u0bb5\u1fa4\u0bb5\u0bbf\u1fa4\u0bb3\u0bcd\u0bb3\u1f90\u0bae\u0bbe\u0ba9 \u0b89\u0b9f\u0ba9\u0bcd\u0baa\u1f8a\u0b95\u0bcd\u0bc8\u0b95 \u0b92\u0ba9\u0bcd\u0bb1\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bbe\u0ba4\u0bae\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0baa\u0baf\u0ba9\u0bcd \u0bc6\u0b95\u0bbe\u1f8c\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b86\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b92\u0bb5\u0bcd\u0bc6\u0bb5\u0bbe\u1f9e \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u1f9c\u0bae\u0bcd \u0baa\u0ba8\u0bcd\u0ba4\u0bbf (\u0b85) \u0bb5\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u1f8c\u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b89\u0b9f\u0ba9\u0bcd\u0baa\u1f8a\u0b95\u0bcd\u0bc8\u0b95 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b89\u0ba4\u0bcd\u0ba4\u0bb0\u0bb5\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bbe\u0ba9 \u0b95\u0b9f\u0baa\u0bcd\u0baa\u0bbe\u1f