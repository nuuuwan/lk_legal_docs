  },
  {
    "page_number": 2,
    "bbox": [
      78.72,
      81.63,
      319.45,
      170.1
    ],
    "text": "(d) any application filed or proceeding commenced before any Rent Board established under section 38 of the repealed Act and pending or remaining incomplete on the day immediately preceding the relevant date shall be proceeded with and concluded within a period of one year from the relevant date;",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      78.72,
      181.63,
      319.44,
      270.1
    ],
    "text": "(e) any application filed or proceeding commenced before the Board of Review established under section 40 of the repealed Act and pending or remaining incomplete on the day immediately preceding the relevant date shall be proceeded with and concluded within a period of one year from the relevant date;",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      78.72,
      281.63,
      319.44,
      357.6
    ],
    "text": "(f) any application made to the Commissioner for National Housing under the repealed Act and pending before him on the day immediately preceding the relevant date shall be proceeded with and concluded as if the said Act has not been repealed; and",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      78.72,
      369.13,
      319.45,
      470.1
    ],
    "text": "(g) any action or proceeding or thing commenced under the repealed Act and pending or remaining incomplete on the day immediately preceding the relevant date may be withdrawn with liberty to file a fresh action seeking the same relief under any other law for the time being in force. Such fresh action shall be filed within a period of one year from the relevant date.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      78.72,
      481.47,
      319.42,
      507.6
    ],
    "text": "4. In the event of any inconsistency between the Sinhala and Tamil texts of this Act, the Sinhala text shall prevail.",
