      "Times-Italic",
      "Times-Roman"
    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      139.15,
      355.15,
      451.19,
      383.42
    ],
    "text": "Clause 3: This clause replaces section 3 of the principal enactment and the legal effectof the section as amended is to reduce the time period to three years within which an actionshall be filed to revoke an irrevocable deed of gift on the ground of gross ingratitude.",
    "fonts": [
      "Times-Italic",
      "Times-Roman"
    ],
    "sizes": [
      8.0
    ]
  },
  {
