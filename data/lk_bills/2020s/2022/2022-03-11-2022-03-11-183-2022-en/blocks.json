    "bbox": [
      407.85,
      343.51,
      451.29,
      381.38
    ],
    "text": "Insertion ofnew section154A intoChapter 101",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      5.599999904632568,
      8.0
    ]
  },
