      "Times-Italic",
      "Times-Roman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      157.15,
      276.35,
      397.14,
      300.01
    ],
    "text": "4. In the event of any inconsistency between the Sinhalaand the Tamil texts of this Act, the Sinhala text shall prevail.",
