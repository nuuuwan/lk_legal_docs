      226.79
    ],
    "text": "be deemed to be null and void and shall berejected by the Returning Officer.\u201d.",
    "fonts": [
      "Times-Italic",
      "Times-Roman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      157.15,
      239.57,
      397.2,
      262.91
    ],
    "text": "3.In the event of any inconsistency between the Sinhalaand Tamil texts of this Act, the Sinhala text shall prevail.",
    "fonts": [
      "Times-Bold",
      "Times-Roman"
    ],
    "sizes": [
      10.0
    ]
  },
