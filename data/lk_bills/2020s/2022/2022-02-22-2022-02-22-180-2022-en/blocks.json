    ],
    "text": "AN ACT TO PROVIDE FOR THE IMPOSITION OF SURCHARGE TAX AND",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      7.0,
      10.0
    ]
