  {
    "page_number": 2,
    "bbox": [
      161.85,
      293.69,
      401.88,
      316.43
    ],
    "text": "1.This Act may be cited as the Kandyan Marriage andDivorce (Amendment) Act, No. of 2022.",
    "fonts": [
      "Times-Bold",
      "Times-Roman"
    ],
    "sizes": [
      10.0
    ]
