      157.05,
      419.81,
      432.32,
      431.15
    ],
    "text": "to amend the Kandyan Marriage and Divorce Act (Chapter 113)",
    "fonts": [
      "Times-Bold"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 1,
