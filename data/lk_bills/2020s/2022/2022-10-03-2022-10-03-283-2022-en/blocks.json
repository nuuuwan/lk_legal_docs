  {
    "page_number": 2,
    "bbox": [
      161.85,
      327.89,
      401.92,
      373.43
    ],
    "text": "2.Part II (sections 8, 9, 10, 11, 12, 13, 14 and 15) of theKandyan Marriage and Divorce Act (Chapter 113)(hereinafter referred to as the \u201cprincipal enactment\u201d) is herebyrepealed.",
    "fonts": [
      "Times-Bold",
      "Times-Roman"
    ],
    "sizes": [
      10.0
    ]
