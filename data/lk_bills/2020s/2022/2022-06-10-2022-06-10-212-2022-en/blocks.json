      161.85,
      424.61,
      401.95,
      458.15
    ],
    "text": "8.The Board shall maintain a register of members inwhich name, address and other essential details of themembers be inscribed.",
    "fonts": [
      "Times-Bold",
      "Times-Roman"
    ],
    "sizes": [
      10.0
