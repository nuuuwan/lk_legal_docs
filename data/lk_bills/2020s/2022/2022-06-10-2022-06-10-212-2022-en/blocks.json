    "fonts": [
      "Times-Italic",
      "Times-Roman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      173.71,
      566.45,
      397.19,
      602.03
    ],
