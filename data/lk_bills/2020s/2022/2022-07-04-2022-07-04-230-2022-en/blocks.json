  },
  {
    "page_number": 1,
    "bbox": [
      139.15,
      291.31,
      451.22,
      329.18
    ],
    "text": "Clause 2: This clause amends section 46 of the Industrial Disputes Act (Chapter 131) andthe legal effect of the section as amended is to provide for representation of any party to anyproceeding under the said Act by an Attorney-at-law or a representative as specified in thatsection.",
    "fonts": [
      "Times-Italic",
      "Times-Roman"
    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      215.25,
      167.17,
      401.81,
      178.24
    ],
    "text": "Industrial Disputes (Amendment)1",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      161.85,
      195.05,
      229.4,
      206.39
    ],
    "text": "L.D.-O. 19/2017",
    "fonts": [
      "Times-Roman"
