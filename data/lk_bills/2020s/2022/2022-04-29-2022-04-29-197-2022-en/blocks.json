  {
    "page_number": 3,
    "bbox": [
      157.15,
      431.57,
      397.17,
      457.07
    ],
    "text": "5. Section 7 of the principal enactment is hereby amendedas follows:\u2013",
    "fonts": [
      "Times-Bold",
      "Times-Roman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      172.39,
      474.17,
      397.16,
      499.67
    ],
