    "bbox": [
      169.89,
      330.55,
      452.86,
      387.14
    ],
    "text": "Replacementof section345 ofChapter 19 \u201cSexualharassment",
    "fonts": [
      "Times"
    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      408.81,
      293.59,
