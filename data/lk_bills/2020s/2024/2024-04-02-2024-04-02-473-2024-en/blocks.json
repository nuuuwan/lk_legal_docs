      431.93,
      401.86,
      455.99
    ],
    "text": "(d)the powers, conduct, duties and functions of thevarious officers, agents and servants of Corporation;",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      178.29,
      470.09,
      401.87,
      532.19
    ],
