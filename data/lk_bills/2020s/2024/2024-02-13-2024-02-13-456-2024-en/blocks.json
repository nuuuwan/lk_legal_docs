      "Times"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      170.95,
      499.13,
      397.2,
      550.67
    ],
    "text": "(g)to empower any Provincial Council to prevent anyPolice Officers of any Province entering anotherProvince (vide the limitations contained in subparagraph (k) of the 2nd item of List II of the 9th",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      5.5,
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      193.15,
      552.65,
