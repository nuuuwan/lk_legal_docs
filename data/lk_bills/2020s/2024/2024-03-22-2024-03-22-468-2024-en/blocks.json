      "Times",
      "Times,Italic"
    ],
    "sizes": [
      8.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      139.15,
      328.99,
      451.15,
      348.14
    ],
    "text": "Clause 3 : This clause inserts the Schedules corresponding to the amendments tosub-paragraph (h) of paragraph (1) of section 5.",
