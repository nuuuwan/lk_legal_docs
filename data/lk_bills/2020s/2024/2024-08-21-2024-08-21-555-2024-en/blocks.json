      179.11,
      204.41,
      397.19,
      258.35
    ],
    "text": "(c)any act or thing done or omitted to be done or anyright or entitlement acquired under the repealedAct shall be deemed to be valid for a period of oneyear from the relevant date;",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      179.11,
      275.45,
      397.21,
      371.99
    ],
    "text": "(d)any application filed or proceeding commencedbefore any Rent Board established under section38 of the repealed Act and pending or remainingincomplete on the day immediately preceding therelevant date shall be proceeded with andconcluded within a period of one year from therelevant date;",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      179.11,
      388.97,
      397.19,
      485.51
    ],
    "text": "(e)any application filed or proceeding commencedbefore the Board of Review established undersection 40 of the repealed Act and pending orremaining incomplete on the day immediatelypreceding the relevant date shall be proceededwith and concluded within a period of one yearfrom the relevant date;",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      179.11,
      502.61,
      397.19,
      584.87
    ],
    "text": "(f)any application made to the Commissioner forNational Housing under the repealed Act andpending before him on the day immediatelypreceding the relevant date shall be proceededwith and concluded as if the said Act has not beenrepealed; and",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      179.11,
      601.97,
      397.21,
      670.07
    ],
    "text": "(g)any action or proceeding or thing commencedunder the repealed Act and pending or remainingincomplete on the day immediately preceding therelevant date may be withdrawn with liberty tofile a fresh action seeking the same relief under",
    "fonts": [
