    ]
  },
  {
    "page_number": 4,
    "bbox": [
      157.15,
      244.13,
      397.2,
      322.43
    ],
    "text": "7.All debts and liabilities of the Foundation on the daypreceding the date of commencement of this Act, shall bepaid and discharged by the Corporation hereby constitutedand all debts due to, subscriptions and contributions payableto the Foundation on that date shall be paid to the Corportionfor the purposes of this Act.",
    "fonts": [
      "Times",
