  {
    "page_number": 3,
    "bbox": [
      161.85,
      556.77,
      401.86,
      605.77
    ],
    "text": "(2) The first Board of Directors of the Corporation shallconsist of the members of the Board of Administration of theFoundation holding office on the day immediately precedingthe date of his election.",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      161.85,
      621.81,
      401.86,
      670.81
    ],
