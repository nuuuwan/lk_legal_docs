    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      172.87,
      276.89,
      397.19,
      325.19
    ],
    "text": "(d)to grant opportunities for training in pre-vocationaleducation, in the fields of sports, computer training,massmedia, leadership, learning of Tamil, Englishand other Languages;",
    "fonts": [
      "Times",
