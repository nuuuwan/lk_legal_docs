  },
  {
    "page_number": 1,
    "bbox": [
      139.15,
      274.63,
      451.21,
      334.22
    ],
    "text": "Clause 2 : This clause inserts new section 43B in the Code of Criminal Procedure Act,No. 15 of 1979 and the legal effect of the amendment is to confer a duty on the Magistratesto visit police stations within his judicial division to ensure that the suspects in the custodyof such police stations are protected to the extent provided for in the Convention AgainstTorture and other Cruel, Inhuman or Degrading Treatment or Punishment Act, No. 22 of1994.",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      5.599999904632568,
      8.0
    ]
  },
