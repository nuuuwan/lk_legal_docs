      249.89,
      401.89,
      272.87
    ],
    "text": "(3) A pre-trial conference shall be held forthe purposes of-",
    "fonts": [
      "Times"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      228.57,
      284.93,
      401.87,
      354.83
