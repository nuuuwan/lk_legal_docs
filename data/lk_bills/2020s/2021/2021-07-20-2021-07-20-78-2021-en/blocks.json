    "fonts": [
      "Times"
    ],
    "sizes": [
      7.0,
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      228.57,
      631.73,
      401.87,
      668.27
    ],
    "text": "(a) upon indictment being served on theaccused in terms of section 195, in thepresence of the accused; or",
    "fonts": [
      "Times",
      "Times,Italic"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      407.85,
      306.07,
      441.58,
      315.14
    ],
