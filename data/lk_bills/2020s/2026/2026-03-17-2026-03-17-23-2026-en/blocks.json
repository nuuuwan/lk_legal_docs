    "bbox": [
      60.0,
      201.17,
      356.54,
      219.95
    ],
    "text": "(a) restrict the exemption provided under item 25 of PART Ia by setting out a time period applicable to any motor vehicle referred to in such item; and",
    "fonts": [
      "Times-Italic",
      "Times-Roman",
      "Times-Roman-SC700"
    ],
    "sizes": [
      5.599999904632568,
      8.0
