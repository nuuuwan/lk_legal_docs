    "text": "\u0db1\u0dd0\u0269 \u01e7\u0dd9\u0dba\u0dcf\u0dca\u014f\u0dad\u0dba\u01e6\u0da7, \u0db1\u0dd0\u0269 \u0db6\u018d \u0dd9\u0d9c\u0db1\u0dba\u01e6\u0db1\u01e6\u0da7, \u0dba\u0dcf\u01b4\u0dcf \u0101\u0dba\u0dcf\u0d9a\u025e\u0dc0\u01e6 \u0dd9\u0db1\u0dcf\u0dc0\u0db1 \u0dd9\u0db4\u0dcf\u01d0 \u021d\u0dc0\u0dcf\u0dc4\u0d9a\u0dba\u01e6\u0da7 \u0dc3\u0dc4 \u0d9a\u01e6\u0dd9\u0178\u0db1\u0259 \u0dd9\u0db8\u0dd9\u0dc4\u0252\u023c\u0d9a\u025e\u0dc0\u01e6\u0da7 \u0db6\u0dbd\u0db4\u01b4 \u0dbd\u0db6\u0dcf\u01cf\u0dd9\u023c \u0db4\u0db1\u0dad \u0dc3\u0dc4 \u0db1\u0dd0\u0269 \u01e7\u0dd9\u0dba\u0dcf\u0dca\u014f\u0dad\u0dba\u01e6,\u0db1\u0dd0\u0269 \u0db6\u018d \u0dd9\u0d9c\u0db1\u0dba\u01e6\u0db1\u01e6, \u0dba\u0dcf\u01b4\u0dcf \u0101\u0dba\u0dcf\u0d9a\u025e\u0dc0\u01e6 \u0dd9\u0db1\u0dcf\u0dc0\u0db1 \u0dd9\u0db4\u0dcf\u01d0 \u021d\u0dc0\u0dcf\u0dc4\u0d9a\u0dba\u01e6 \u0dc3\u0dc4 \u0d9a\u01e6\u0dd9\u0178\u0db1\u0259 \u0dd9\u0db8\u0dd9\u0dc4\u0252\u023c\u0d9a\u025e\u0dc0\u01e6 \u0dba\u01e6\u0db1 \u0218\u0298\u0dd9\u0dc0\u0263\u01e6, \u0db1\u0dd0\u0269 \u01e7\u0dd9\u0dba\u0dcf\u0dca\u014f\u0dad\u0dba\u01e6\u0da7, \u0db1\u0dd0\u0269 \u0db6\u018d \u0dd9\u0d9c\u0db1\u0dba\u01e6\u0db1\u01e6\u0da7 \u0dc3\u0dc4 \u0dba\u0dcf\u01b4\u0dcf \u0101\u0dba\u0dcf\u0d9a\u025e\u0dc0\u01e6 \u0dd9\u0db1\u0dcf\u0dc0\u0db1 \u0dd9\u0db4\u0dcf\u01d0 \u021d\u0dc0\u0dcf\u0dc4\u0d9a\u0dba\u01e6\u0da7 \u0db6\u0dbd\u0db4\u01b4 \u0dbd\u0db6\u0dcf \u01cf\u0dd9\u023c \u0db4\u0db1\u0dad \u0dc3\u0dc4 \u0db1\u0dd0\u0269 \u01e7\u0dd9\u0dba\u0dcf\u0dca\u014f\u0dad\u0dba\u01e6, \u0db1\u0dd0\u0269 \u0db6\u018d \u0dd9\u0d9c\u0db1\u0dba\u01e6\u0db1\u01e6 \u0dc3\u0dc4 \u0dba\u0dcf\u01b4\u0dcf \u0101\u0dba\u0dcf\u0d9a\u025e\u0dc0\u01e6 \u0dd9\u0db1\u0dcf\u0dc0\u0db1 \u0dd9\u0db4\u0dcf\u01d0 \u021d\u0dc0\u0dcf\u0dc4\u0d9a\u0dba\u01e6 \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc4\u01ff\u01e6\u0dc0\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0db6\u0dc0",
