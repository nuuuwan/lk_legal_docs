    "doc_type": "lk_bills",
    "doc_id": "2013-02-26-2013-02-26-21-2013-en",
    "num": "2013-02-26-21-2013-en",
    "date_str": "2013-02-26",
    "description": "Betting and Gaming Levy (Amendment)",
    "url_metadata": "https://documents.gov.lk/view/bills/bl_2013.html",
