u0ba4\u0bc8\u0b95\u0baf \u0bc6\u0b9a\u0baf\u0bb2\u0bcd \u0ba8\u0bb2\u0bcd\u0bc6\u0bb2\u0ba3\u0bcd\u0ba3\u0ba4\u0bcd\u1f90\u0b9f\u0ba9\u0bcd\n\n\u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8a\u1f9e\u0ba8\u0bcd\u0ba4\u0bc6\u0ba4\u0ba9 \u0ba8\u0bc0\u0ba4\u0bbf\u0bae\u0ba9\u0bcd\u0bb1\u0bae\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd, \u1f99\u0b95\u0bbe\u0bc8\u0bae\n\n\u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba8\u0bbf\u1f9e\u0bb5\u0bbe\u0b95 \u0ba8\u0bbf\u0ba4\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u1fa2\u1f9e\u0ba8\u0bcd\u1f90 \u0bc6\u0b9a\u1fa4\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bb2\u0bcd\n\n\u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd.\n\n116. (1) \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0ba9\u0bcd \u0b89\u1fa0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bcd, \u0baa\u0bbf\u0bb0\u0ba4\u0bbe\u0ba9\n\n\u0ba8\u0bbf\u0bc8\u0bb1\u0bc7\u0bb5\u0bb1\u0bcd\u1fa0 \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0ba9\u0bcd\n\n\u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd\u0b95\u1fa6\u0bae\u0bcd \u0b8a\u0bb4\u0bbf\u0baf\u0bb0\u0bcd\u0b95\u1fa6\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b92\u0baa\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\n\n\u0b85\u1f8a\u0baa\u0bcd\u0baa\u0bc8\u0b9f\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bb5\u0bb0\u1f90 \u0bc7\u0b9a\u0bc8\u0bb5\u0b95\u0bb3\u0bcd \u0bc6\u0baa\u0bb1\u0bcd\u1fa0\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd\n\n\u0bc7\u0bb5\u0bc6\u0bb1\u0bb5\u0bc7\u0bb0\u1f94\u0bae\u0bbe\u0bb3\u0bcd, \u0ba4\u0ba3\u0bcd\u0b9f\u0bc8\u0ba9\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0b95\u0bcd\u0bc7\u0b95\u0bbe\u0bc8\u0bb5\u0baf\u0bbf\u0ba9\u0bcd\n\n\u0b95\u1f9e\u0ba4\u0bcd\u1f90\u0b95\u0bcd\u0b95\u0bc1\u0b9f\u0bcd\u0baa\u0b9f \u0baa\u0b95\u0bbf\u0bb0\u0b99\u0bcd\u0b95 \u0bc7\u0b9a\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bbe\u0b95\u0b95\u0bcd \