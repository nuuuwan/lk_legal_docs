\u0bb1\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0baf\u0bbf\u0ba9\u0bcd,\n\n\u0bb5\u1fa4\u1fab\u1fa0\u0ba4\u0bcd\u1f90\u0bc8\u0b95\u0bc8\u0baf \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0ba8\u0bc8\u0b9f\u1f99\u0bc8\u0bb1\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u1f90\u0bc8\u0b95\u0bc8\u0baf \u0bae\u0bc0\u1fa0\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u1f99\u0b9f\u0bcd\u1f8c\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0bc8\u0b9f\u0baf\u0bbf\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b8e\u0bb5\u0bc7\u0bb0\u1f94\u0bae\u0bbe\u0bb3\u0bcd \u0ba4\u0bb5\u0bc6\u0bb1\u0bbe\u0ba9\u0bcd\u0bc8\u0bb1\u0baa\u0bcd \u1f97\u0bbe\u0bbf\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bbe\u0bb0\u0bcd.\n\n10. \u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 68 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bc6\u0bb2\u0bbe\u0ba9\u0bcd\u1fa0 \u0bc7\u0b9a\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u1f9e\u0bae\u0bcd,-\n\n(\u0b85) \u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bc8\u0bb2 \u0b8f\u0bb1\u0bcd\u1fa0\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3 \u0bae\u1fa0\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bb5\u1f9e\u0bae\u0bcd;\n\n(\u0b86) \u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u1fa4\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0ba3\u0bcd\u0bc8\u0bae\u0baf\u0bbe\u0ba9 \u1f99\u0bc8\u0bb1\u0baf\u0bbf\u0bb2\u0bcd \u0baa\u0ba4\u0bbf\u1fa2\u1fa0\u0b95\u0bcd\u0b95\u0ba4\u0bcd \u0ba4\u0bb5\u1fa0\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bb5\u1f9e\u0bae\u0bcd; \u0b85\u0bb2\u0bcd\u0bb2\u1f90\n\n(\u0b87) \u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u1fa4\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb1\u0bbf\u0ba8\u0bcd\u1f90 \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u1f8c \u0bc6\u0baa\u0bbe\u0baf\u0bc