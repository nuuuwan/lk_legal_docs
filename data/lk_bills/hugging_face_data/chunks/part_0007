bc1\u0bae\u0bcd\u0bc7\u0baa\u0bbe\u1f90, \u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0b86\u0ba4\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd\n\n\u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0b95\u1fa6\u0bae\u0bcd, \u0bb5\u0bbf\u0b9f\u0baf\u0ba4\u0bcd\u1f90\u0b95\u0bcd\u0bc7\u0b95\u0bb1\u0bcd\u0baa,\n\n\u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa\u0b95\u0bcd\u0b95\u0bc1, \u0bc6\u0baa\u1fa0\u0ba8\u1f9e\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0ba4\u0bcd\u1f90\u0b9f\u0ba9\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f\n\n\u1f99\u0b95\u0bbe\u0bc8\u0bae\u0baf\u0bbe\u0bb3\u1f9e\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3\u0ba9\u0bc6\u0bb5\u0ba9\u0b95\u0bcd \u0b95\u1f9e\u0ba4\u0baa\u0bcd"
