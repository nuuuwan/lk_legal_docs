\u0d9c\u0dbb \u0dc0\u0dcf\u0dc5\u0dbd 4 \u0d87\u0dc1\u0dc6\u0dbd\u0dd2\u0dba\u0db8\u0d9c\u0ddc\u0da9 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 5 \u0dbb\u0dad\u0dca\u0db1\u0dbb \u0dbb \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 6 \u0d9a\u0dd4\u0dbb\u0dd4\u0dc0\u0dd2 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 7 \u0db3\u0dc6\u0dbd\u0dca\u0dd9\u0da9\u0dd4\u0dbd\u0dca\u0dbc \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 8 \u0db6\u0dbc\u0dd2\u0d82\u0db8\u0d9c\u0ddc\u0da9 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 9 \u0d89\u0db9\u0dd4\u0dbd\u0dca\u0db8\u0dda \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 10 \u0db8\u0d9c\u0ddc\u0da9\u0d9a\u0db8\u0dbd\u0dbc \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 11 \u0d9a\u0dc1\u0dbd\u0dad\u0dca\u0dad \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 12 \u0dbd\u0dc6\u0dbd\u0dd2\u0db8\u0d9c\u0db8\u0db3\u0ddc\u0dbc \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 13 \u0db1\u0dd2\u0dc0\u0dd2\u0dad\u0dd2\u0d9c\u0dbc \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 14 \u0d85\u0dba\u0d9c\u0dd9 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 15 \u0d9a\u0dbc\u0dbd\u0dc5\u0db1 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 16 \u0d87\u0db9\u0dd2\u0dbd\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 17 \u0db8\u0d9a\u0ddc\u0db8\u0dbc\u0ddc\u0db1\u0dca\u0db1 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd (25) \u0d9a\u0dd1\u0d9c\u0dbd\u0dca\u0dbc 1 \u0d9a\u0dc7\u0d9c\u0dbd\u0dca\u0dbc \u0dd9\u0dc1\u0dc5 \u0db1\u0d9c\u0dbb \u0dc0\u0dcf\u0dc5\u0dbd 2 \u0dbd\u0dbb\u0d9a\u0dc5\u0db8\u0db3\u0ddc\u0dc2 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 3 \u0d9c\u0dbd\u0dd2\u0d9c\u0db8\u0dd4\u0dbd \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 4 \u0d9a\u0dc7\u0d9c\u0dbd\u0dca\u0dbc \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 5 \u0dbb\u0db9\u0dd4\u0d9a\u0dca\u0d9a\u0db1 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 6 \u0dd9\u0dc5\u0dbd\u0db1\u0dc6\u0dbd\u0dca\u0dbc \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 7 \u0d85\u0dbb\u0dab\u0dc5\u0dba\u0d9a \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 8 \u0dba\u0da7\u0dd2\u0dba\u0db1\u0dca\u0db8\u0dad\u0ddc \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 9 \u0dd4\u0dc0\u0dbc\u0dad\u0dca\u0db8\u0d9a\u0ddc\u0dc4\u0dd4\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 10 \u0dbb\u0dd4\u0dbd\u0db1\u0dca\u0dbd\u0dc6\u0dbd\u0dca\u0dbc \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 11 \u0daf\u0dc6\u0dbb\u0dab\u0dd2\u0dba\u0d9c\u0dbc \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 12 \u0db8\u0daf\u0dc4\u0dd2\u0d95\u0dc0\u0dd2 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd\n\n\u0daf\u0dd2\u0dc0\u0dca\u0dad \u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dba \u0db3\u0dc2\u0dcf\u0dad\u0dca \u0db3\u0dcf\u0dbc\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbc\u0dd2\u0d82\u0d9a\u0dc5 \u0dbb\u0da2\u0db8\u0dda \u0db8\u0dd4\u200d\u0dbb\u0dab \u0db8\u0daf\u0db3\u0dc5\u0dbb\u0dca\u0dad\u0db8\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0db8\u0dc0\u0dca \u0db8\u0dd4\u200d\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbc\u0daf\u0dd3."
