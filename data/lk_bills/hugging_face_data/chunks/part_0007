0dc3\u0dd2\u0db1\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca \u0daf\u0dd3 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0dba\u0dd2\n\n\u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0da2\u0dd9\u0dba\u0dca \u0db8\u0dd4\u0daf\u0dab \u0dd9\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca \u0db8\u0dd4\u0daf\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3\u0dd9\u0d9a\u0ddc\u0dc5\u0db9 5, \u0dbb\u0da2\u0dd9\u0dba\u0dca \u0db4\u0d9a\u0dcf\u0dc1\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0d82\u0dc1\u0dd9\u0dba\u0db1\u0dca \u0db8\u0dd2\u0dbd \u0daf\u0dd3 \u0dbd\u0db6\u0dcf\u0d9c\u0dad \u0dc4\u0dd0\u0d9a\n\n\u0dd9\u0db8\u0db8 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0d85\u0dad\u0dd2 \u0dd9\u0dbb\u0dca\u0d9a\u0dba www.documents.gov.lk \u0dd9\u0dc0\u0db6\u0dca \u0d85\u0da9\u0dc0\u0dd2 \u0dd9\u0dba\u0db1\u0dca \u0db6\u0dcf\u0d9c\u0dad \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a.\n\n\u0db8\u0dd2\u0dbd : \u0dbb\u0dd4. 18.00 \u0dad\u0dd0\u0db4\u0dd0\u0dbd\u0dca \u0d9c\u0dcf\u0dc3\u0dca\u0dad\u0dd4\u0dc0 : \u0dbb\u0dd4. 150.00\u0db8\u0dd2\u0dbd : \u0dbb\u0dd4. 18.00 \u0dad\u0dd0\u0db4\u0dd0\u0dbd\u0dca \u0d9c\u0dcf\u0dc3\u0dca\u0dad\u0dd4\u0dc0 : \u0dbb\u0dd4. 150.00\n\n\u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3\u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3\n\n\u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba\u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba\n\n2025 \u0dd9\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 28 \u0dc0\u0db1 \u0daf\u0dd2\u0db12025 \u0dd9\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 28 \u0dc0\u0db1 \u0daf\u0dd2\u0db1\n\nII \u0dc0\u0db1 \u0dd9\u0d9a\u0ddc\u0da7\u0dc3II \u0dc0\u0db1 \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\n\n\u0d85\u0dad\u0dd2\u0dd9\u0dbb\u0dca\u0d9a\u0dba\u0d85\u0dad\u0dd2\u0dd9\u0dbb\u0dca\u0d9a\u0dba\n\n(2025.03.04 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3)\n\n\u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0daf\u0dd8\u0dc2\u0dca\u0da7\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2\u0da5\u0dba\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0dc3\u0d82\u0d9c\u0db8\u0dba\u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0daf\u0dd8\u0dc2\u0dca\u0da7\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2\u0da5\u0dba\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0dc3\u0d82\u0d9c\u0db8\u0dba\n\n(\u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca)(\u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca)\n\n1\n\n\u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0daf\u0dd8\u0dc2\u0dca\u0da7\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2\u0da5\u0dba\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0dc3\u0d82\u0d9c\u0db8\u0dba \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0daf\u0dd8\u0dc2\u0dca\u0da7\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2\u0da5\u0dba\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0dc3\u0d82\u0d9c\u0db8\u0dba \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\n\n\u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd6 \u0db4\u0db1\u0dad\u0d9a\u0dd2\u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd6 \u0db4\u0db1\u0dad\u0d9a\u0dd2\n\n\u201c\u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0daf\u0dd8\u0dc2\u0dca\u0da7\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2\u0da5\u0dba\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0dc3\u0d82\u0d9c\u0db8\u0dba\u201d \u0dba\u0db1\u0dd4\u0dd9\u0dc0\u0db1\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc4\u0dcf \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc3\u0d82\u0d9c\u0db8\u0dba\u0d9a\u0dca, \u0d91\u0d9a\u0dd3 \u0dc3\u0d82\u0d9c\u0db8\u0dd9\u0dba\u0dca \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db1\u0dca \u0d91\u0d9a\u0d9f \u0dc0\u0dd6 \u0dbb\u0dd3\u0dad\u0dd2\u0dc0\u0dbd\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0d91\u0d9a\u0dd3 \u0dc3\u0d82\u0d9c\u0db8\u0dba\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0db5\u0dbd\u0daf\u0dcf\u0dba\u0dd3 \u0dd9\u0dbd\u0dc3 \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dc4\u0dcf \u0d9a\u0dbb\u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0dd9\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0db8\u0dd9\u0dad\u0d9a\u0dca \u0d9a\u0dbd\u0dca \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0dc0\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dcf \u0dad\u0dd2\u0db6\u0dd6 \u0dd9\u0dc4\u0dba\u0dd2\u0db1\u0dca\u0daf:\n\n\u0d91\u0d9a\u0dd3 \u0dc3\u0d82\u0d9c\u0db8\u0dba \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd4\u0dd9\u0dc0\u0dca \u0dba\u0db8\u0dca \u0db4\u0dbb\u0db8\u0dcf\u0dbb\u0dca\u0dae \u0dc3\u0dc4 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0daf, \u0d92 \u0db4\u0dbb\u0db8\u0dcf\u0dbb\u0dca\u0dae \u0dc3\u0dc4 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0dd9\u0db8\u0dd9\u0dad\u0d9a\u0dca \u0d9a\u0dbd\u0dca \u0d91\u0d9a\u0dd3 \u0db7\u0dcf\u0dbb\u0d9a\u0dcf\u0dbb\u0dad\u0dca\u0dc0\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dcf\u0dbb\u0dca\u0dae\u0d9a \u0dd9\u0dbd\u0dc3 \u0d9a\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb \u0dc3\u0dc4 \u0d89\u0da7\u0dd4 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dd9\u0dc4\u0dba\u0dd2\u0db1\u0dca \u0daf, \u0d91\u0d9a\u0dd3 \u0dc3\u0d82\u0d9c\u0db8\u0dba \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u0d9a\u0dbb\u0db1 \u0dd9\u0dbd\u0dc3 \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0daf, \u0d92 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8 \u0d89\u0da7\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db8\u0dc4\u0da2\u0db1 \u0dba\u0dc4\u0db4\u0dad \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0dc0\u0db1 \u0dd9\u0dc4\u0dba\u0dd2\u0db1\u0dca \u0daf:\n\n\u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dd9\u0db8\u0dd9\u0dc3\u0dda \u0db4\u0db1\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd9\u0db6\u0dca:-\n\n1.1. \u0dd9\u0db8\u0dca \u0db4\u0db1\u0dad 2025 \u0d85\u0d82\u0d9a \u0daf\u0dbb\u0db1 \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0daf\u0dd8\u0dc2\u0dca\u0da7\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2\u0da5\u0dba\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0dc3\u0d82\u0d9c\u0db8\u0dba (\u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca) \u0db4\u0db1\u0dad \u0dba\u0db1\u0dd4\u0dd9\u0dc0\u0db1\u0dca \u0dc4\u0daf\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd9\u0db6\u0dca."
