\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dbb\u0da2\u0dba\u0dda\u024f \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 5, \u0dbb\u0da2\u0dba\u0dda\u024f \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0db1 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0d82\u0d82\ufffd\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db8\u0dd2\u0dbd \u0daf\u0dd3 \u0dbd\u0db6\u0dcf\u0dcf\u0d9c\u0dad \u0dc4\u0dd0\u0dd0\u0d9a\n\n\u0db8\u0dd2\u0dbd : \u0dbb\u0dd4. 36.00 \u0dad\u0dd0\u0dd0\u0db4\u0dd0\u0dd0\u0dbd\u0dca \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dad\u0dd4\u0dc0 : \u0dbb\u0dd4. 150.00\n\n\u0db8\u0dd9\ufffd\u0db8 \u0db4\u0db1\u0dad\u0dca \u0d9a\u0dd9\ufffd\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad www.documents.gov.lk \u0dc0\u0dd9\u0dd9\u0db6\u0dca \u0d85\u0da9\u0dc0\u0dd2\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db6\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dc5 \u0dc4\u0dd0\u0dd0\u0d9a.\n\n[3 \u0dc0\u0db1 \u0db4\u0db1\u0dad\u0dca \u0d9a\u0dd9\ufffd\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad]\n\n02 \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u0daf\u0dd4 (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u0db0\u0db1)\n\n\u0db1\u0dd3\u0dad\u0dd2\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0dd1\u0db8\u0dda\u023c \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dba\n\n2 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba: \u0db8\u0dda\u023c \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca (\u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db8\u0dd2\u0db1\u0dca \u0db8\u0dad\u0dd4 \u201c\u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u201d \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1) 2002 \u0d85\u0d82\u0d82\u0d9a 14 \u0daf\u0dbb\u0db1 \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u0daf\u0dd4 \u0db4\u0db1\u0dad\u0dda\u01ae 2 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u0db0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d92 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0dd1\u0db8 \u0dc0\u0db1\u0dd4\u0dba\u0dda\u024f:-\n\n(\u0d85) \u0db1\u0dd2\u0dbb\u0dca\u0dc0\u0dcf\u0dcf\u0dc3\u0dd2\u0d9a \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d89\u0dbd\u0dd9\ufffd\u0d9a\u0dca\u0da7\u0dca\u200d\u0dbb\u0ddc\u017e\u0ddc\u0db1\u0dd2\u0d9a \u0d86\u0d9a\u0dcf\u0dcf\u0dbb\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0dc3\u0dd0\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0db8\u0dad \u0db6\u0daf\u0dd4 \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca \u0db4\u0dd0\u0dd0\u0db1\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf; \u0dc3\u0dc4\n\n(\u0d86) \u0dc3\u0dbb\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u0daf\u0dd4 \u0dba\u0ddd\ufffd\u0ddd\u0da2\u0db1\u0dcf\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba \u0d85\u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dbb \u0d92 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u0daf\u0dd4 \u0d86\u0db4\u0dc3\u0dd4 \u0d9c\u0dd9\ufffd\u0dc0\u0dd3\u0db8\u0dda\u023c \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u0d9a\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0dcf\u0dcf \u0daf\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf,\n\n\u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0dc3\u0dd0\u0dd0\u0dbd\u0dd0\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8 \u0dc0\u0dda\u0dda.\n\n3 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba: \u0db8\u0dda\u023c \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f 5 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u0db0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d92 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0dd1\u0db8 \u0dc0\u0db1\u0dd4\u0dba\u0dda\u024f \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0dc3\u0dd0\u0dd0\u0db4\u0dba\u0dd4\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0dcf\u0d9a\u0db8 \u0dc1\u0dd4\u0db1\u0dca\u200d\u0dba\u0dba \u0dbd\u0dd9\ufffd\u0dc3 \u0dc3\u0dd0\u0dd0\u0dbd\u0d9a\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0dc3\u0dd0\u0dd0\u0dbd\u0dd0\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8 \u0dc0\u0dda\u0dda:-\n\n(\u0d85) \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0dba\u0ddd\ufffd\u0ddd\u0da2\u0d9a\u0dba\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d94\u0dc4\u0dd4\u0d9c\u0dda\u0118 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0db1\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dba\u0db1\u0dca\u0da7 \u0db1\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dbd\u0dda\u0262 \u0dc4\u0ddd\ufffd\u0ddd \u0dc3\u0dc4\u0db1\u0daf\u0dcf\u0dcf\u0dba\u0dd3 \u0db8\u0dd2\u0dbd\u0da7 \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d86\u0dc4\u0dcf\u0dcf\u0dbb \u0dc4\u0ddd\ufffd\u0ddd \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dcf\u0dc4\u0db1\u0dba;\n\n(\u0d86) \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0db4\u0dd2\u0da7\u0dad \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbb\u0d9a\u0dca\u0dc2\u0dab\u0d9a\u0dbb\u0dd4\u0dc0\u0d9a\u0dd4\u0d9c\u0dd9\ufffd\u0db1\u0dca \u0dba\u0db8\u0dca \u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8\u0d9a\u0dca \u0dc0\u0dd9\u0dd9\u0dad \u0db6\u0dd0\u0d82\u0d82\ufffd\u0d9a\u0dd4\u0dc0\u0d9a\u0dca \u0dc4\u0dbb\u0dc4\u0dcf\u0dcf \u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dc1 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc4\u0dcf\u0dcf\u0dbb \u0db8\u0dd4\u0daf\u0dbd\u0dd2\u0db1\u0dca \u0dbd\u0dd0\u0dd0\u0db6\u0dd9\ufffd\u0db1 \u0dba\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc3\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca \u0dc4\u0ddd\ufffd\u0ddd \u0dba\u0db8\u0dca \u0dc0\u0db1\u0dca\u0daf\u0dd2 \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca; \u0dc3\u0dc4\n\n(\u0d87) \u0d86\u0dab\u0dca\u0da9\u0dd4\u200d\u200d\u0dc0\u0dda\u0dda \u0dc4\u0ddd\ufffd\u0ddd \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0d9a \u0dba\u0db8\u0dca \u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0dad\n\n\u0db1\u0ddc\ufffd\u0ddc\u0d9a\u0dc5 \u0dad\u0dd0\u0dd0\u0db4\u0dd0\u0dd0\u0dbd\u0dca \u0dc3\u0dc4 \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0db8\u0dca \u0db8\u0dd4\u0daf\u0dca\u0daf\u0dbb\u0dc0\u0dbd \u0db8\u0dd4\u0dc4\u0dd4\u0dab\u0dad \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0dcf\u0d9a\u0db8.\n\n03\u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u0daf\u0dd4 (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u0db0\u0db1)"
