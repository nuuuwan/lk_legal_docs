0bb0\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbb\u0ba9\u0bcd 29 \u0b86\u0bae\u0bcd \u0baa\u0bbb\u0bba\u0bbb\u0bb2\u0bbb\u0ba9\u0bcd (3) \u0b86\u0bae\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0bbb\u0bba\u0bbb\u0bb2\u0bbb\u0ba9\u0bcd\u0b95\u0bbc\u0bb4\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0baa\u0b95\u0bac \u0b86\u0bb2\u0bc3\u0b95\u0bcd\u0b95\u0bc1 \u0bb2\u0bb1\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bb1\u0bcd\u0bb1\u0bc1\u0b9a\u0bcd\u0b9a\u0bbc\u0b9f\u0bcd\u0b9f\u0bc1 \u0b85\u0ba4\u0bcd\u0ba4\u0baa\u0b95\u0bac \u0b86\u0bb0\u0bbb\u0ba9\u0bba\u0bb2\u0bcd \u0b95\u0bba\u0ba3\u0bcd\u0baa\u0bbb\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bb2\u0ba4\u0ba9\u0bcd \u0bab\u0bbc\u0ba4\u0bc1 \u0baa\u0bb2\u0baa\u0bcd\u0baa\u0bba\u0ba9\u0ba4\u0bc1 \u0b8b\u0bb5\u0bcd\u0bb2\u0bba\u0bb0\u0bbb\u0ba9\u0bba\u0bb2\u0bcd \u0b87\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0ba4\u0bba \u0b85\u0bb5\u0bcd\u0bb2\u0bba\u0bb2\u0bc3\u0b95\u0bcd\u0b95\u0bc1 \u0bab\u0bbc\u0bb0\u0bb0\u0bbb\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bb2\u0bcd \u0ba4\u0bb2\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\n\n3. \u0b87\u0ba4\u0bb1\u0bcd\u0b95\u0bba\u0ba9 \u0b85\u0b9f\u0bcd\u0b9f\u0bb2\u0baa\u0bc8\u0bac\u0bbb\u0bb1\u0bcd\u0bae\u0bad\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb0 \u0b89\u0bb3\u0bcd\u0bb2\u0bc4\u0bb0\u0bcd \u0b85\u0ba4\u0bbb\u0b95\u0bba\u0bad\u0b9a\u0baa\u0baa\u0b95\u0bb2\u0bc3\u0b95\u0bcd\u0b95\u0bba\u0ba9 \u0ba4\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0baa\u0bb0 \u0ba8\u0b9f\u0bba\u0ba4\u0bcd\u0ba4\u0bc1\u0bb2\u0ba4\u0bb1\u0bcd\u0b95\u0bba\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0baa\u0bb0\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbb\u0ba9\u0bcd \u0b8c\u0bb1\u0bcd\u0baa\u0bba\u0b9f\u0bc1\u0b95\u0bb0\u0bbb\u0ba9\u0bcd \u0b95\u0bbc\u0bb4\u0bcd \u0ba8\u0b9f\u0bb2\u0b9f\u0bbf\u0b95\u0bcd\u0baa\u0b95\u0b95\u0bb3\u0bcd \u0ba4\u0ba4\u0bba\u0b9f\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bb2\u0bcd \u0ba4\u0bb2\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd:\n\n\u0ba4\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0baa\u0bb0 \u0ba8\u0b9f\u0bba\u0ba4\u0bcd\u0ba4\u0bc1\u0bb2\u0ba4\u0bb1\u0bcd\u0b95\u0bba\u0b95 \u0ba8\u0b9f\u0bb2\u0b9f\u0bbf\u0b95\u0bcd\u0baa\u0b95\u0b95\u0bb3\u0bcd \u0ba4\u0ba4\u0bba\u0b9f\u0b99\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0ba4\u0bb2\u0bcd\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n35\n\n\u0b89\u0bb3\u0bcd\u0bb2\u0bc4\u0bb0\u0bcd \u0b85\u0ba4\u0bbb\u0b95\u0bba\u0bad\u0b9a\u0baa\u0baa\u0b95\u0bb3\u0bcd \u0ba4\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bcd\n\n(\u0bb2\u0bbb\u0ba4\u0b9a\u0b9f \u0b8c\u0bb1\u0bcd\u0baa\u0bba\u0b9f\u0bc1\u0b95\u0bb3\u0bcd) 4\n\n\u0b86\u0bac\u0bbb\u0ba9\u0bcd, \u0b95\u0b9f\u0bcd\u0b9f\u0baa\u0bb0\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbb\u0ba9\u0bcd 26 \u0b86\u0bae\u0bcd \u0baa\u0bbb\u0bba\u0bbb\u0bb2\u0bbb\u0ba9\u0bcd \u0ba8\u0bbb\u0bac\u0ba4\u0bbb\u0b95\u0bb0\u0bbb\u0ba9\u0bcd\u0baa\u0b9f\u0bbf \u0ba8\u0bbb\u0bac\u0bab\u0ba9\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbb\u0bad\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bb1\u0bcd\u0bae\u0bbb\u0bac \u0b85\u0bae\u0bbb\u0bb2\u0bbb\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bcd, \u0bb2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bab\u0bba\u0ba9\u0bbb\u0bac\u0bbb\u0bb2\u0bcd \u0ba4\u0bb2\u0bb0\u0bbb\u0bac\u0bbb\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0baa\u0bb0 \u0baa\u0bc4\u0baf\u0bae\u0bcd \u0ba4\u0ba4\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd \u0b86\u0baa\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bb2\u0bc5 \u0ba4\u0bbc\u0bb0\u0bcd\u0bab\u0bba\u0ba9\u0bbb\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bbf\u0bac\u0bb2\u0bba\u0bae\u0bba\u0ba9 \u0b85\u0ba4\u0bcd\u0ba4\u0baa\u0b95\u0bac \u0ba4\u0ba4\u0ba4\u0bbb\u0bac\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba4\u0bb2\u0bb0\u0bbb\u0bac\u0bbb\u0b9f\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0ba4\u0bb2\u0bcd \u0ba4\u0bb2\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bab\u0ba9\u0bcd\u0baa\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd \u0b8b\u0bb5\u0bcd\u0bb2\u0bba\u0bae\u0bba\u0bac\u0bbb\u0ba9\u0bc1\u0bae\u0bcd, \u0b85\u0ba4\u0bcd\u0ba4\u0baa\u0b95\u0bac \u0ba4\u0bbb\u0b95\u0ba4\u0bbb, \u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0ba8\u0baa\u0b9f\u0baa\u0bc3\u0baa\u0bae\u0b95\u0bcd\u0b95\u0bc1\u0bb2\u0bb0\u0bc1\u0bae\u0bcd \u0ba4\u0bbb\u0b95\u0ba4\u0bbb\u0bac\u0bbb\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0baa\u0bc4\u0ba9\u0bcd\u0bb1\u0bc1 \u0bab\u0bba\u0ba4\u0b99\u0bcd\u0b95\u0bb2\u0bc3\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0bbb\u0ba8\u0bcd\u0ba4\u0bba\u0ba4\u0ba4\u0bb2\u0bba\u0bb0\u0bc1 \u0ba4\u0bbb\u0b95\u0ba4\u0bbb\u0bac\u0bba\u0b95\u0bb2\u0bbb\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bc1\u0bae\u0bcd \u0ba4\u0bb2\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\n\n4. \u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbb\u0ba9\u0bcd \u0b9a\u0bbb\u0b99\u0bcd\u0b95\u0bb0, \u0ba4\u0bab\u0bbb\u0bb4\u0bcd \u0b89\u0baa\u0bad\u0b95\u0bb2\u0bc3\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0baa\u0b9f\u0ba4\u0bac \u0b8c\u0ba4\u0ba4\u0ba9\u0bc1\u0bae\u0bcd \u0b92\u0bb5\u0bcd\u0bb2\u0bba\u0baa\u0bab \u0b8c\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0baa\u0b9f\u0bcd\u0b9a\u0ba4\u0bcd\u0ba4\u0bbb\u0bb2\u0bcd \u0b9a\u0bbb\u0b99\u0bcd\u0b95\u0bb0 \u0b89\u0baa\u0bad\u0ba4\u0bac \u0ba4\u0bab\u0ba4\u0baf\u0bba\u0b99\u0bcd\u0b95\u0bbb \u0ba8\u0bbb\u0bb1\u0bcd\u0bae\u0bb2\u0bcd \u0ba4\u0bb2\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\n\n\u0b92\u0bb5\u0bcd\u0bb2\u0bba\u0baa\u0bab \u0b8c\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0bb2\u0bbb\u0b9f\u0bac\u0ba4\u0bcd\u0ba4\u0bbb\u0bb2\u0bcd \u0b9a\u0bbb\u0b99\u0bcd\u0b95\u0bb0 \u0b89\u0baa\u0bad \u0ba4\u0bab\u0ba4\u0baf\u0bba\u0b99\u0bcd\u0b95\u0bbb \u0ba8\u0bbb\u0bb1\u0bcd\u0bae\u0bb2\u0bcd\n\n5\n\n10\n\n15\n\n20\n\n25\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb2\u0baa\u0bc8\n\n\u0bab\u0bba\u0bb2\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb2\u0bc4\u0bb0\u0bcd \u0b85\u0ba4\u0bbb\u0b95\u0bba\u0bad\u0b9a\u0baa\u0baa"
