f\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bc8\u0bb2\u0baa\u0bcd \u0bc6\u0baa\u0bb1\u0bcd\u0bb1\u0ba4\u0ba9\u0bcd\u0bc7\u0bae\u0bb2\u0bcd, \u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bc8\u0bb2\u0baa\u0bcd \u0bc6\u0baa\u0bb1\u0bcd\u0bb1\u0ba4\u0bbf\u1fa2\u1f9e\u0ba8\u0bcd\u1f90 \u1f9a\u0ba9\u0bcd\u1fa0 \u0bc7\u0bb5\u0bc8\u0bb2\u0ba8\u0bbe\u0b9f\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0bbf\u0ba8\u0bcd\u0ba4\u0bbe\u0bae\u0bb2\u0bcd, \u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0bae\u0bbe\u0ba3\u0bae\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0b89\u1fa0\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b92\u1f9e \u0b95\u0bc2\u0bb1\u0bcd\u0bb1\u0bbf\u0ba9\u0bcd \u0baa\u1f8a\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd (\u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u2018\u0bb5\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u1f99\u0bc8\u0bb1\u0baf\u0bbe\u0ba9 \u0b95\u0bc2\u0bb1\u0bcd\u1fa0\u2019 \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u1f8c \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd) \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0b89\u0ba3\u0bcd\u0bc8\u0bae\u0baf\u0bbe\u0ba9\u1f90\u0bae\u0bcd \u0bb5\u0bbf\u0bb5\u0bb0\u0ba3\u0bbe\u0bc0\u0ba4\u0bbf\u0baf\u0bbe\u0ba9\u1f90\u0bae\u0bbe\u0ba9 \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0baa\u1fa2\u0baa\u0bcd\u0bc8\u0baa \u0b8e\u1fa8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u1f90 \u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bc8\u0bb2\u0baa\u0bcd \u0bc6\u0baa\u1fa0\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b86\u0bb3\u0bbf\u0ba9\u0bcd \u0b95\u0b9f\u0bc8\u0bae\u0baf\u0bbe\u0ba4\u0bb2\u0bcd \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd:"
