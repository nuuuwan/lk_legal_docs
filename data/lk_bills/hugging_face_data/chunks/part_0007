    "chunk_text": "\u201c\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2\u0d9a\u0dbb\u0dd4\u201d \u0dba\u0db1\u0dca\u0db1\u0dd9\ufffd\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dba\u0db8\u0dca \u0db4\u0dd4\u0dbb\u0dc0\u0dd0\u0dd0\u0dc3\u0dd2\u0dba\u0d9a\u0dd4 \u0dc4\u0ddd\ufffd\u0ddd \u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dc1 \u0dbb\u0da7\u0d9a \u0dba\u0db8\u0dca \u0db4\u0dd4\u0dbb\u0dc0\u0dd0\u0dd0\u0dc3\u0dd2\u0dba\u0d9a\u0dd4 \u0db4\u0dd9\u0dd9\u0dbb \u0db8\u0dcf\u0dcf\u0dc3 \u0daf\u0ddc\ufffd\u0ddc\u0dc5\u0dc4 \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0d91\u0d9a\u0dad\u0dd4\u0dc0 \u0daf\u0dd2\u0db1 \u0d91\u0d9a\u0dc3\u0dd2\u0dba \u0d85\u0dc3\u0dd6 \u0dad\u0dd4\u0db1\u0d9a\u0dca \u0dc0\u0db1 \u0dc4\u0ddd\ufffd\u0ddd \u0d8a\u0da7 \u0dc0\u0dd0\u0dd0\u0da9\u0dd2 \u0d9a\u0dcf\u0dcf\u0dbd\u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0d9b\u0dab\u0dca\u0da9\u0dc0 \u0dc4\u0ddd\ufffd\u0ddd \u0d85\u0db1\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0d9a\u0dcf\u0dcf\u0dbb\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0dd2\u0da7 \u0d87\u0dad\u0dd2 \u0db1\u0db8\u0dca \u0d91\u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dc1 \u0dbb\u0da7\u0d9a \u0db4\u0dd4\u0dbb\u0dc0\u0dd0\u0dd0\u0dc3\u0dd2\u0dba\u0d9a\u0dd4 \u0dc4\u0ddd\ufffd\u0ddd \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0db1\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad \u0dc0\u0dd3\u0db8\u0da7 \u0dc4\u0ddd\ufffd\u0ddd \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0dc0\u0dc3\u0dbb \u0dbd\u0db6\u0dcf\u0dcf \u0daf\u0dd9\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0d86\u0d9c\u0db8\u0db1 \u0dc4\u0dcf\u0dcf \u0dc0\u0dd2\u0d9c\u0db8\u0db1 \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u023c\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \