    "date_str": "2015-12-03",
    "description": "Sri Lanka Association for Fisheries & Aquatic Resources (Incorporation)",
    "url_metadata": "https://documents.gov.lk/view/bills/bl_2015.html",
    "lang": "en",
    "url_pdf": "https://documents.gov.lk/view/bills/2015/12/49-2015_E.pdf",
