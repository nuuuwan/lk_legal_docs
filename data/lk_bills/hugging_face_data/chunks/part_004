5\u0dbd (16) \u0d85\u0db8\u0dca\u0db3\u0dcf\u0dbb 1 \u0d85\u0d9a\u0dca\u0d9a\u0dbb\u0db3\u0dad\u0dca\u0dad\u0dd4 \u0dd9\u0dc1\u0dc5 \u0db1\u0d9c\u0dbb \u0dc0\u0dcf\u0dc5\u0dbd 2 \u0d85\u0db8\u0dca\u0db3\u0dc5\u0dbb \u0db1\u0d9c\u0dbb \u0dc0\u0dcf\u0dc5\u0dbd 3 \u0db8\u0daf\u0dc4\u0dd2\u0d85\u0dad\u0dca\u0dad\u0d9a\u0dab\u0dca\u0da9\u0dd2\u0dba \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 4 \u0daf\u0dd9\u0db1 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 5 \u0d8b\u0dc1\u0db1 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 6 \u0dd9\u0dc1\u0d94\u0dba \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 7 \u0db1\u0dc5\u0dd9\u0dbd\u0dca\u0d94\u0dba \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 8 \u0db3\u0daf\u0dd2\u0dba\u0dad\u0dbc\u0dc5\u0dbd \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 9 \u0db1\u0dc0\u0dd2\u0daf\u0db1\u0dca\u0db8\u0dc0\u0dca\u0dbd\u0dd2 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 10 \u0dc0\u0db8\u0dca\u0dd9\u0db1\u0dca\u0dad\u0dd4\u0dbb\u0dba\u0dd2 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 11 \u0d89\u0dbb\u0d9a\u0dca\u0d9a\u0dc5\u0dd9\u0db8\u0dca \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 12 \u0d85\u0d9a\u0dca\u0d9a\u0dbb\u0db3\u0dad\u0dca\u0dad\u0dd4 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 13 \u0db8\u0db3\u0ddc\u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 14 \u0d85\u0d9e\u0dca\u0da9\u0dc5\u0dbc\u0da0\u0dca\u0db8\u0da0\u0dca\u0db1 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 15 \u0d86\u0dbc\u0dba\u0da9\u0dd2\u0db8\u0dbd\u0db8\u0dca\u0dd4\u0dc0 \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 16 \u0dbc\u0dc5\u0dc4\u0dd4\u0d9c\u0dbc \u0db3 \u0dbb\u0dc5\u0db8\u0dda\u0dba \u0dba \u0dc0\u0dcf\u0dc5\u0dbd 17 \