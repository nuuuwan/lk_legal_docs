b95\u1fab\u0bae\u0bcd \u0b86\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0bc1\u1fa8\u0bb5\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd\u0b95\u0bc1\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bbf\u0ba9\u1f90\u0bae\u0bcd \u1f97\u0bb2\u0ba9\u0bbe\u0baf\u0bcd\u1fab \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u1f90\u0bae\u0bcd \u0baa\u0ba3\u0bbf\u0b95\u0bb3\u0bcd \u0bc6\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0b95\u1fab\u0bae\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u1f90\u0bc8\u0bb1\u0ba4\u0bcd \u0ba4\u0bc8\u0bb2\u0bc8\u0bae\u0baf\u0ba4\u0bbf\u0baa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f \u0bae\u0ba4\u0bbf\u1f9c\u0bc8\u0bb0\u0bc8\u0baf\u0baa\u0bcd \u0bc6\u0baa\u0bb1\u0bcd\u1fa0\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u1fa6\u0ba4\u1fa4\u0bae\u0bcd \u0b85\u0ba4\u0ba9\u0bcd\u0bae\u0bc0\u1f90 \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb1\u0bcd\u1fa0\u0ba4\u1fa4\u0bae\u0bcd.\n\n(3) \u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bc7\u0ba8\u0bbe\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0b95, \u0b86\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0bc1\u1fa8, \u1f97\u0bb2\u0ba9\u0bbe\u0baf\u0bcd\u1fab \u0b85\u1fa4\u0bb5\u0bb2\u0bc6\u0bb0\u0bbe\u1f9e\u0bb5\u0bb0\u0bbe\u0b95 \u0b8e\u0bb5\u0bc7\u0bb0\u1f94\u0bae\u0bcd \u0b85\u1fa4\u0bb5\u0bb2\u0bc8\u0bb0\u0baa\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd\u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0ba4\u0ba4\u0bcd\u1f90\u0bb5\u1f99\u0bc8\u0b9f\u0baf\u0ba4\u0bbe\u0ba4\u0bb2\u0bcd \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd; \u0b85\u0bb5\u0bb0\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd\u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd, \u1f97\u0bb2\u0ba9\u0bbe\u0baf\u0bcd\u1fab \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bbe\u0ba9 \u0baa\u0ba3\u0bbf\u0b95\u0bc8\u0bb3\u0baa\u0bcd \u1f97\u0bbe\u0bbf\u0ba4\u1fa4\u0bae\u0bcd \u0ba4\u0ba4\u0bcd\u1f90\u0bb5\u0b99\u0bcd\u0b95\u0bc8\u0bb3\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bc7\u0baf\u0bbe\u0b95\u0bbf\u0ba4\u0bcd\u0ba4\u1fa4\u0bae\u0bcd \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd."
