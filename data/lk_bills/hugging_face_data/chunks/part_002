bc8\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0ba9\u0ba4\ufffd\u0bca\u0bb0\u0bc1 \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bc2\u0bb2\u0bae\u0bcd\n\n\u0b9f\u0bbf\u0b9c\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0bb2\u0bcd \u0baa\ufffd\u0bca\u0bb0\u0bc1\u0bb3\u0bbe\u0bbe\u0ba4\u0bbe\u0bbe\u0bb0 \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bbe\u0bcd\u0bcd\u073c \u0b9f\u0bbf\u0b9c\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0bb2\u0bcd \u0baa\ufffd\u0bca\u0bb0\u0bc1\u0bb3\u0bbe\u0bbe\u0ba4\u0bbe\u0bbe\u0bb0 \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bbe\u0bcd\u0bcd\u073c \u0b85\u0bb5\u0bbe\u0bcd\u0bcd\u073c\u0b95\u0bb3\u0bbe\u0bbe\u0bb2\u0bcd 2025 \u0bae\ufffd \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 08 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf \u0b9a\u0bae\u0bbe\u0bcd\u0bcd\u073c\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\n\n(2025 \u0bae\u0bbe\u0bbe\u0b9a\u0bcd\u0b9a\u0bc1 \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 27 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf\u0ba9\u0bcd\u0bb1\u0bc1 \u0bb5\u0bbe\u0bcd\u0bcd\u073c\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bb2\u0bcd\n\n\u0bb5\ufffd\u0bbf\ufffd\u0baf\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1)\n\n\u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0b85\u0bb0\u0b9a\u0bbe\u0bbe\u0b99\u0bcd\u0b95 \u0b85\u0b9a\u0bcd\u0b9a\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0ba3\u0721\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd \u0baa\u0ba4\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0bc6\u0bc6\u0bb1\u0bcd\u0bb1\u0ba4\u0bc1\u0b95\ufffd\u0bca\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1 5, \u0b85\u0bb0\u0b9a\u0bbe\u0bbe\u0b99\u0bcd\u0b95 \u0bb5\ufffd\u0bbf\ufffd\u0baf\u0bc0\u0b9f\u0bcd\u0b9f\u0bb2\u0bc1\u0bb5\u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd \u0baa\u0bc6\u0bc6\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b