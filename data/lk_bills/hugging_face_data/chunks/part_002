    "chunk_text": "(\u0d8a) \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u01e7\u0dbd\u0db0\u0dbb\u0dba\u01e6 \u0dc3\u0dc4 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a\u0dba\u01e6 \u0db4\u01ae\u00fb\u025d\u0db8, \u0dd9\u0dc3\u0dca\u0dc0\u0dd9\u0dba\u028f \u01e7\u0252\u00fa\u0dad \u00fb\u025d\u0db8, \u0dd9\u0dc3\u0dca\u0dc0\u0dd9\u0dba\u01e6 \u0db4\u0dc4\u00fb\u025d\u0db8 \u0dd9\u0dc4\u0dcf\u0dca \u0dd9\u0dc3\u0dca\u0dc0\u0dba \u0d85\u0dc0\u0dc3\u01e6 \u00fb\u025d\u0db8 \u0dc3\u0dc4 \u0d94\u026c\u01e6 \u026a\u0dc2\u0dd9\u0dba\u028f \u026a\u0db1\u0dba \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0db8 \u0dc3\u0dc4 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u026a\u0286\u01e6 \u01b0\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc0\u0dd0\u017b\u0217, \u01cf\u0db8\u0db1\u0dcf \u0dc3\u0dc4 \u0db4\u0dcf\u025c\u0dd9\u0dad\u0dcf\u0dca\u027f\u0d9a \u0dd9\u0d9c\u026b\u0db8\u0da7; \u0dc3\u0dc4\n\n(\u0d8b) \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u0db4\u0dbb\u0db8\u0dcf\u0259\u0dae \u01e7\u0286 \u0dd9\u0dbd\u0dc3 \u0dc3\u0dc4 \u0db5\u0dbd\u0daf\u0dcf\u0251\u0dc0 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0dd9\u0dc4\u0dcf\u0dca \u0288\u01d0\u0288 \u0dd9\u0dc0\u0db1\u01ae \u0286\u0dba\u0265 \u0dd9\u01ca \u0286\u01d0 \u00fb\u025d\u0db8.\n\n(\u0d85) \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u01e6 \u0dc0\u0259\u0d9c \u00fb\u025d\u0db8, \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u01e6 \u0d87\u01b1\u0dc5\u01ae \u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0db8, \u0d89\u0dc0\u01ae \u00fb\u025d\u0db8, \u0dd9\u0db1\u0dbb\u0219\u0db8 \u0dd9\u0dc4\u0dcf\u0dca \u0d89\u0262\u0dbd\u0dcf \u0d85\u0dc3\u0dca\u026b\u0db8 \u0dc3\u0dc4 \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u01e6 \u026a\u0286\u01e6 \u0dd9\u0d9c\u026a\u0dba \u0252\u01b1 \u0d9c\u0dcf\u0dc3\u0dca\u01b1;\n\n(\u0d86) \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u01df\u0dbb \u0daf\u0dbb\u01e6\u0db1\u01e6 \u0dd9\u0dad\u0dcf\u0dca\u0dbb\u0dcf \u0db4\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0db8, \u01df\u0dbb\u0dba \u028f\u0dc3\u0dca \u00fb\u025d\u0db8 \u0dd9\u0dc4\u0dcf\u0dca \u01df\u0dbb\u0dd9\u0dba\u01e6 \u0d89\u0dc0\u01ae \u00fb\u025d\u0db8 \u0dc3\u0dc4 \u01df\u0dbb \u0daf\u0dbb\u01e6\u0db1\u01e6\u0dd9\u0118 \u0db6\u0dbd\u0dad\u0dbd, \u0d9a\u0dcf\u0259\u0dba \u0dc3\u0dc4 \u0d9a\u0259\u0dad\u0dc0\u0dca\u200d\u0dba;\n\n(\u0d87) \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u026a\u026a\u0db0 \u01e7\u0dbd\u0db0\u0dbb\u0dba\u01e6\u0dd9\u0118, \u0d85\u01e9\u0dd9\u0dba\u0dcf\u0dca\u014f\u0dad\u0dba\u01e6\u0dd9\u0118 \u0dc3\u0dc4 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a\u0dba\u01e6\u0dd9\u0118 \u0db4\u01ae\u026b\u0db8, \u0db6\u0dbd\u0dad\u0dbd, \u0d9a\u0dcf\u0259\u0dba \u0dc4\u0dcf \u0d9a\u0259\u0dad\u0dc0\u0dca\u200d\u0dba \u0dc3\u0dc4 \u0dd9\u0d9a\u0dcf\u01e6\u0dd9\u01ca\u0286 \u0dc3\u0dc4 \u01e7\u0dba\u0db8\u0dba\u01e6;\n\n\u0db8\u0dcf\u0dd9\u0db6\u0dcf\u017b\u0dc0\u0db1 \u027c \u0218\u0dba\u0dbb\u0dad\u0db1 \u0db1\u0dcf\u028f\u023d \u0288\u0dc0\u0dd9\u0dc3\u0dc0\u0db1 \u0db4\u0daf\u0db1\u0db8 \u0db8\u0dcf\u0dd9\u0db6\u0dcf\u017b\u0dc0\u0db1 \u027c \u0218\u0dba\u0dbb\u0dad\u0db1 \u0db1\u0dcf\u028f\u023d \u0288\u0dc0\u0dd9\u0dc3\u0dc0\u0db1 \u0db4\u0daf\u0db1\u0db8\n\n(\u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u00fb\u025d\u0dd9\u023c)(\u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u00fb\u025d\u0dd9\u023c)\n\n6\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u0d85\u0dbb\u023f\u0daf\u0dbd\n\n\u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u01e6\u0dd9\u0118 \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a \u0dd9\u0262\u0d9b\u0db1\u0dba\n\n(\u0d88) \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u0dd9\u0dc4\u0dcf\u0dca \u0d91\u028f \u0dba\u023c \u0d85\u01e9\u0d9a\u023d\u017b\u0dc0\u0d9a \u025a\u0dc3\u0dca\u026b\u023c \u0d9a\u0dd0\u0db3\u026b\u0dd9\u023c \u01cf \u0dc4\u0dcf \u0db4\u0dd0\u0dc0\u0dd0\u01ae\u026b\u0dd9\u023c \u01cf \u0d85\u01e9\u0d9c\u0db8\u0db1\u0dba \u0d9a\u0dc5 \u0252\u01b1 \u0d9a\u0dcf\u0259\u0dba \u0db4\u0179\u0db4\u0dcf\u0179\u0dba, \u025a\u0dc3\u0dca\u026b\u023c \u0218\u0298\u0db6\u0db3 \u01e7\u0dd9\u0269\u0daf\u0db1 \u0dc4\u0dcf \u0db1\u0dca\u200d\u0dba\u0dcf\u0dba \u0db4\u01b4, \u0d9c\u0dab\u021b\u0dbb\u0dab\u0dba \u0dc3\u0dc4 \u0d92 \u025a\u0dc3\u0dca\u026b\u023c\u0dc0\u0dbd \u0d9a\u0da7\u0252\u01b1 \u0d9a\u0dbb\u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0db8;\n\n(\u0d89) \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u0dc3\u0dc4 \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u0d9a\u0dd4 \u026b\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0288\u01d0\u0288\u0d9a\u023c \u0dc3\u0dc4 \u01e9\u0288\u01d0\u0288\u0d9a\u023c;\n\n(\u0d8a) \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u0dd9\u01ca\u0db4\u0dc5 \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc3\u0dc4 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u00fb\u025d\u0db8; \u0dc3\u0dc4\n\n(\u0d8b) \u0dd9\u0db4\u0dcf\u01d0\u0dd9\u0269 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u0d9a\u0da7\u0252\u01b1 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u00fb\u025d\u0db8 \u0dc3\u0dc4 \u0d91\u028f \u0db4\u0dbb\u0db8\u0dcf\u0259\u0dae \u023f\u01d0\u01e6\u0db4\u01ae \u0d9a\u0dbb\u0d9c\u0dd0\u01e8\u0db8 \u0dc3\u0dc4 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u026a\u0288\u025e\u0dc0\u0dcf \u0dc4\u0dd0\u025d\u0db8.\n\n(2) \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dba \u026a\u0286\u01e6 \u0dc3\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0dba\u023c \u025d\u01af\u0dba\u00fa \u0dd9\u023c \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (1) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dc3\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u025d\u01af\u0dba\u00fa \u0dd9\u0db8\u01e6\u0db8 \u0d91\u0dc0\u0dd0\u01e7\u0db8 \u025a\u0dc3\u0dca\u026b\u0db8\u0d9a \u01cf \u0d91\u0dc0\u0dd0\u01e7\u0db8 \u0d86\u0d9a\u0dcf\u0dbb\u0dd9\u0dba\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u00fb\u025d\u0db8, \u0dd9\u0dc0\u0db1\u0dc3\u0dca \u00fb\u025d\u0db8, \u0d8a\u0da7 \u0dba\u0db8\u00fa \u0d91\u0d9a\u01b1 \u00fb\u025d\u0db8 \u0dd9\u0dc4\u0dcf\u0dca \u0db4\u025c\u013c\u0147\u01e6\u0db1 \u00fb\u025d\u0db8 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0dc4\u0dd0\u00fb \u0dba.\n\n(3) \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u01e6 \u0dc3\u0dd1\u0db8 \u0d9a\u0262\u028f\u0db8 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u025d\u01af \u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae \u026a\u0dba \u0252\u01b1 \u0dba.\n\n(4) \u0dd9\u0db8\u0db8 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dc3\u0dcf\u0daf\u01e9 \u0dbd\u0dd0\u022d \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u025d\u01af \u0dbb\u0da2\u0dd9\u024f \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5 \u0d9a\u0dc5 \u0252\u01b1 \u0dba.\n\n(5) \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dba \u026a\u0286\u01e6 \u0dc3\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0dc3\u0dd1\u0db8 \u025d\u01af\u0dba\u00fa \u0db8, \u0d91\u0db8 \u025d\u01af \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022b\u0dd9\u0db8\u01e6 \u0db8\u0dcf\u0dc3 \u01b1\u0db1\u00fa \u0d87\u01b1\u0dc5\u0dad \u0d85\u01e9\u0db8\u0dad\u0dba \u0dc3\u0daf\u0dc4\u0dcf \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1\u0dc0 \u0dd9\u0dc0\u0dad \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0dba. \u0d91\u0dd9\u0dc3\u0dca \u0d85\u01e9\u0db8\u0dad \u0dd9\u0db1\u0dcf\u0d9a\u0dc5 \u0dba\u023c \u025d\u01af\u0dba\u00fa, \u0d92 \u0dba\u0da7\u0dd9\u01ae \u01e7\u0286 \u0db4\u025c\u01ce \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022d \u00fb\u0286\u0dc0\u0d9a\u0da7 \u0d85\u0d9c\u01af\u0dba\u00fa \u0dd9\u0db1\u0dcf\u0db8\u0dd0\u01af\u0dc0, \u0d91\u00fc \u0d85\u0db1\u01e9\u0db8\u0dad\u0dd9\u024f \u01ce\u0db1 \u0286\u0da7 \u0db4\u025c\u013c\u0147\u01e6\u0db1 \u0d9a\u0dbb\u01e9 \u0dbd\u022d \u0dd9\u0dbd\u0dc3 \u0dc3\u0dbd\u0d9a\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0dba.\n\n8. \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u01e6\u0dd9\u0118 \u0db1\u023c, \u0263\u0218\u0db1 \u0dc3\u0dc4 \u0dd9\u0dc0\u0db1\u01ae \u0d85\u0dad\u0dca\u200d\u0dba\u0dc0\u0dc1\u0dca\u200d\u0dba \u0dd9\u0dad\u0dcf\u0dbb\u01b1\u025e \u0d87\u01b1\u0dc5\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u01e6\u0dd9\u0118 \u0dd9\u0262\u0d9b\u0db1\u0dba\u00fa \u0db8\u019c\u0da9\u0dbd\u0dba \u026a\u0286\u01e6 \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1 \u0dba\u0dcf \u0252\u01b1 \u0dba.\n\n9. (1) \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0da7 \u0d91\u028f\u0db8 \u0d85\u0dbb\u023f\u0daf\u0dbd\u00fa \u01af\u022a\u0dba \u0252\u01b1 \u0dba."
