bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\ufffd\u0bca\u0bb1\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb2\u0bbe\u0b95, \u201c\u0ba4\u0bc7\u0b9a\u0bbf\u0baf\u0b95\u0bcd \u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bc1\u0bb5\u0bb0\u0bbf\u0b95\u0bcd \u0b95\ufffd\u0bca\u0bb3\u0bcd\u0b95\u0bc8\u0b95\u0bcd\u0b95\u0bbf\u0ba3\u0b99\u0bcd\u0b95, \u0ba8\u0bbf\u0ba4\u0bbf\u0baf\u0bae\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0ba9\u0bcd \u0b95\u0bb2\u0ba8\u0bcd\u0ba4\u0bbe\u0bb2\ufffd\u0bcb\u0b9a\u0ba9\u0bc8\u0baf\u0bc1\u0b9f\u0ba9\u0bcd\u201d \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\ufffd\u0bca\u0bb1\u0bcd\u0b95\u0bb3\u0bc8 \u0b87\u0b9f\u0bc1\u0bb5\u0ba4\u0ba9\u0bcd\u0bae\u0bc2\u0bb2\u0bae\u0bc1\u0bae\u0bcd;\n\n(\u0b86) \u0b85\u0bb5\u0bcd\u0bb5\u0bc1\u0b9f\u0bcd\u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd (\u0b85) \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0baa\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd, \u201c\u0ba4\u0bc7\u0b9a\u0bbf\u0baf \u0bae\u0bc1\u0bb1\u0bc8\u0bae\u0bc8\u0ba4\u0bcd \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0ba8\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u201d \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\ufffd\u0bca\u0bb1\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb2\u0bbe\u0b95, \u201c\u0ba4\u0bc7\u0b9a\u0bbf\u0baf \u0bae\u0bc1\u0bb1\u0bc8\u0bae\u0bc8\u0ba4\u0bcd \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0ba8\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0ba8\u0bbf\u0baf\ufffd\u0bcb\u0b95\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0b89\u0bb0\u0bbf\u0bae\u0bae\u0bcd\u0baa\u0bc6\u0bb1\u0bcd\u0bb1\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd\u201d \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\ufffd\u0bca\u0bb1\u0bcd\u0b95\u0bb3\u0bc8 \u0b87\u0b9f\u0bc1\u0bb5\u0ba4\u0ba9\u0bcd\u0bae\u0bc2\u0bb2\u0bae\u0bc1\u0bae\u0bcd; \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd\n\n(2) \u0b85\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd (4) \u0b86\u0bae\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bc1\u0bb5\u0bbe\u0b9a\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u201c\u0baa\u0bbe\u0b95\u0bae\u0bcd IX \u0b87\u0ba9\u0bcd \u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd\u0baa\u0b9f\u0bbf\u201d \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u201c\u0bae\ufffd\u0bca\u0ba4\u0bcd\u0ba4\u0bb5\u0bbf\u0bb1\u0bcd\u0baa\u0ba9\u0bc8 \u0bae\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bb0\u0b9a\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bc8\u201d \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\ufffd\u0bca\u0bb1\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b8e\u0ba3\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0baa\u0ba4\u0bbf\u0bb2\u0bbe\u0b95, \u0bae\u0bc1\u0bb1\u0bc8\u0baf\u0bc7 \u201c30 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd (2) \u0b86\u0bae\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd (\u0b86) \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0baa\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd (ii) \u0b86\u0bae\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd\u0baa\u0b9f\u0bbf\u201d \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u201c\u0baa\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bc1\u0bb3\u0bcd\u0bb3 \u0bae\ufffd\u0bca\u0ba4\u0bcd\u0ba4\u0bb5\u0bbf\u0bb1\u0bcd\u0baa\u0ba9\u0bc8 \u0bae\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bb0\u0b9a\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bc8\u201d \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\ufffd\u0bca\u0bb1\u0bcd\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b8e\u0ba3\u0bcd\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b87\u0b9f\u0bc1\u0bb5\u0ba4\u0ba9\u0bcd\u0bae\u0bc2\u0bb2\u0bae\u0bc1\u0bae\u0bcd.\n\n18.18. \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bae\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 30 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bc1 \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb1\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bbe\u0bb1\u0bc1 \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1:-\n\n(1) \u0b85\u0baa\u0bcd\u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd (1) \u0b86\u0bae\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u201c\u0bae\ufffd\u0bca\u0ba4\u0bcd\u0ba4 \u0bb5\u0bbf\u0bb1\u0bcd\u0baa\u0ba9\u0bc8 \u0bae\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bb0\u0b9a\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bc8 \u0b8e\u0ba8\u0bcd\u0ba4\u0bc7\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bb1\u0bcd\u0baa\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc8\u0ba4\u0bcd \u0ba4\ufffd\u0bca\u0b9f\u0b99\u0bcd\u0b95\u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\ufffd\u0bcb \u0b85\u0ba4\u0bcd\u0ba4\u0bc7\u0ba4\u0bbf\u0baf\u0bc8\u0b95\u0bcd\u201d \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\ufffd\u0bca\u0bb1\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb2\u0bbe\u0b95, \u201c(2) \u0b86\u0bae\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb0\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b92\u0bb5\u0bcd\u0bb5\u0bca\u0bb0\u0bc1 \u0bae\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bb0\u0b9a\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b8e\u0ba4\u0bcd\u0ba4\u0bc7\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bb1\u0bcd\u0baa\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc8\u0ba4\u0bcd \u0ba4\ufffd\u0bca\u0b9f\u0b99\u0bcd\u0b95 \u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\ufffd\u0bcb \u0b85\u0ba4\u0bcd\u0ba4\u0bc7\u0ba4\u0bbf\u0b95\u0bb3\u0bc8\u0b95\u0bcd\u201d \u0