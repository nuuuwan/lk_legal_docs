bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95, \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0ba8\u0bbf\u0bc8\u0bb2\u0b95\u0bcd \u0b95\u0bbe\u0baa\u0bcd\u1f97 \u0bc6\u0ba4\u0bbe\u0b9f\u0bbe\u0bcd \u0baa\u0bbe\u0ba9 \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0b89\u1f9e\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b8f\u0ba4\u0bbe\u0bb5\u1f90 \u0b92\u1fa8\u0b99\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0b87\u1f9e\u0ba8\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd, \u0b85\u0bb5\u0bcd\u0bb5\u0bbe\u0bb1\u0ba9 \u0b85\u0bc8\u0ba9\u0ba4\u0bcd\u1f90 \u0b92\u1fa8\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u1fa6\u0bae\u0bcd \u0b87\u0bb0\u0ba4\u0bcd\u0ba4\u0bbe\u0b95\u0bc1\u0bae\u0bcd \u0b8e\u0ba9 \u0b95\u0bb5\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3 \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd.\n\n4.4. \u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b9a\u0bbf\u0b99\u0bcd\u0b95\u0bb3, \u0ba4\u0bae\u0bbf\u0bb4\u0bcd \u0b89\u0bc8\u0bb0\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0bc8\u0b9f\u0bc7\u0baf \u0b8f\u0bc7\u0ba4\u1f94\u0bae\u0bcd \u0b92\u0bb5\u0bcd\u0bb5\u0bbe\u0bc8\u0bae \u0b8f\u0bb1\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0baa\u0b9f\u0bcd\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b9a\u0bbf\u0b99\u0bcd\u0b95\u0bb3 \u0b89\u0bc8\u0bb0\u0bc7\u0baf \u0bc7\u0bae\u0bc7\u0bb2\u0bbe\u0b99\u0bcd\u0b95\u0bbf \u0ba8\u0bbf\u0bb1\u0bcd\u0bb1\u0bb2\u0bcd \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd.\n\n\u0b9a\u0bc1\u1f9e\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd"
