    "chunk_text": "\u201c(\u0d94) \u0db6\u0dc3\u0dca\u0dbb\u0dae \u0dd9\u0dc3\u0dca\u0dc0\u0dcf \u0dc4\u0dcf \u021d\u0dc0\u0dcf\u0dc4\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0dcf \u0dc3\u0dd0\u0dbd\u0287\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4 \u0d91\u028f \u0db8\u011a \u0dd9\u0dc3\u0dca\u0dc0\u0dcf \u0d85\u0dc0\u0dc3\u0dbb\u0db4\u01b4 \u0dc3\u0dc4 \u021d\u0dc0\u0dcf\u0dc4\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0dcf \u0d85\u0dc0\u0dc3\u0dbb\u0db4\u01b4 \u01e7\u0d9a\u0dd4\u01ae \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dba\u023c \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u0d9a\u0dd4 \u0dc3\u0db8\u0d9f \u0119\u026a\u0288\u023c\u0dc0\u0dbd\u0da7 \u0d87\u01b1\u0dc5\u01ae \u026b\u0db8;\u201d;\n\n(4) \u0d91\u028f (\u0d9a) \u0dd9\u0146\u0daf\u0dba \u0d89\u0dc0\u01ae \u0d9a\u0dbb, \u0d92 \u0dd9\u0dc0\u01e9\u0dc0\u0da7, \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0dd9\u0146\u0daf\u0dba \u0d86\u0dd9\u01ca\u0dc1 \u00fb\u025d\u0dd9\u0db8\u01e6:-\n\n\u201c(\u0d9a) \u0db6\u0dc3\u0dca \u0dbb\u0dae \u0dd9\u0dc3\u0dca\u0dc0\u0dcf \u0dc3\u0dc4 \u021d\u0dc0\u0dcf\u0dc4\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0dcf \u0db8\u0119\u01e6 \u0db4\u0dc5\u0dcf\u01ae \u0d85\u0dad\u0dbb \u0db7\u0dcf\u019c\u0da9 \u021d\u0dc0\u0dcf\u0dc4\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0da7\u0252\u01b1 \u0218\u0298\u0dd9\u0dba\u0dbd \u00fb\u025d\u0db8;\u201d; \u0dc3\u0dc4\n\n\u201c(\u0d9c) \u0da2\u0dcf\u01af\u0d9a \u0db8\u0178\u0da7\u0dd9\u0db8\u01e6 \u0db8\u0dcf\u0259\u0d9c\u0dc3\u0dca\u0dae \u021d\u0dc0\u0dcf\u0dc4\u0db1 \u0db8\u0dcf\u0259\u0dd9\u0d9c\u0dcf\u0dca\u0db4\u0dd9\u01ca\u0dc1\u0dba\u00fa \u0dc3\u0d9a\u0dc3\u0dca \u00fb\u025d\u0db8;\n\n(\u0da0) \u0d85\u0daf\u0dcf\u0dc5 \u0db4\u0dbb\u01d0 \u0daf\u0dbb\u01e6\u0db1\u01e6\u0dd9\u0118 \u0263\u0110\u0dad \u0dc3\u0dd0\u0dbd\u00fb\u025d\u023c \u0dc3\u0dbd\u0d9a\u0dcf \u0db6\u0dd0\u0264\u0dd9\u0db8\u01e6 \u0db4\u0288, \u021d\u0dc0\u0dcf\u0dc4\u0db1 \u0d9c\u0dcf\u0dc3\u0dca\u01b1 \u0d85\u0dba \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0289\u01b4\u0dba\u00fa \u01b0\u0dbb\u0dab\u0dba \u00fb\u025d\u0db8 \u0dc3\u0dc4 \u0db8\u0dcf\u0259\u0d9c\u0dc3\u0dca\u0dae \u021d\u0dc0\u0dcf\u0dc4\u0db1\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0da2\u0dcf\u01af\u0d9a \u021d\u01af\u0db4\u01ae\u01af\u0dba, \u0dc0\u025c\u01e6 \u0dc0\u0dbb\u0da7, \u0dad\u00fa\u0dd9\u0dc3\u0dca\u025e \u00fb\u025d\u0db8 \u0dc3\u0dc4 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u026a\u0da7 \u01cf \u0d91\u0db8 \u0289\u01b4\u0dba \u021d\u01af\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u00fb\u025d\u0db8;\n\n(\u0da2) \u021d\u0dc0\u0dcf\u0dc4\u0db1 \u0db4\u01ca\u0db0\u01af\u0dba \u01ce\u0252\u019f \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u01ea\u0dad\u0db1 \u0dad\u0dcf\u00fa\u0dc2\u019d\u0d9a \u0db4\u01ca\u0db0\u01af \u0db7\u0dcf\u026a\u0dad\u0dba \u021d\u0dc0\u0259\u0db0\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc3\u0dc4 \u01e7\u0dba\u0dcf\u0db8\u0db1\u0dba \u00fb\u025d\u0db8;\n\n(\u0da7) \u021d\u0dc0\u0dcf\u0dc4\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0dcf\u0dc0\u01e6\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dba\u0179\u0dad\u0dbd \u0db4\u0dc4\u0288\u0d9a\u023c \u021d\u01af\u0db4\u0dcf\u0daf\u0db1 \u0dc3\u0dd0\u0db4\u0251\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc4\u0288\u0d9a\u023c \u0dc3\u0dd0\u0dbd\u0287\u0db8;\n\n(\u0da9) \u021d\u0dc0\u0dcf\u0dc4\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0da2\u0dcf\u01af\u0d9a \u0dd9\u0dad\u0dcf\u0dbb\u01b1\u025e \u0db4\u01ca\u0db0\u01af\u0dba\u00fa \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0db8 \u0dc3\u0dc4 \u021d\u0dc0\u0dcf\u0dc4\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0dcf \u0dc3\u0db4\u0dba\u01e6\u0db1\u01e6 \u026a\u0286\u01e6 \u0dc3\u0dbd\u0dc3\u01e9 \u0dbd\u0db6\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0dcf \u0d85\u01de\u00fa\u0dc2\u0dab\u0dba \u00fb\u025d\u0db8;\n\n(\u0dab) \u021d\u0dc0\u0dcf\u0dc4\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0dcf \u0dc3\u0db4\u0dba\u01e6\u0db1\u01e6 \u021a\u0291\u019f \u00fb\u025d\u0db8\u0da7 \u021a\u0291\u019f \u0db8\u0db0\u0dca\u200d\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u00fa \u0218\u028f\u017b\u026b\u0db8;\n\n(\u0dad) \u0dd9\u023c \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u01ae \u0d85\u0dc0\u0dc3\u0dbb\u0db4\u01b4\u0dba\u00fa \u01e7\u0d9a\u0dd4\u01ae \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0db6 \u0d87\u01ae\u0dd9\u01ae \u0dba\u023c \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u0d9a\u0dd4 \u0dd9\u0dc0\u0dad \u0daf, \u0d85\u0dc0\u0dc3\u0dbb\u0db4\u01b4\u0dba\u00fa \u0d85\u0265\u01ae \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0db6 \u0d87\u01ae\u0dd9\u01ae \u0dba\u023c \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u0d9a\u0dd4\u0dd9\u0118 \u0daf \u0d91\u00fc \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u0dcf \u0dd9\u0dc0\u0dad \u026a\u0db0\u0dcf\u0db1 \u01e7\u0d9a\u0dd4\u01ae \u00fb\u025d\u0db8;\n\n35\n\n\u0da2\u0dcf\u01af\u0d9a \u0d9c\u0db8\u0db1\u0dcf\u0d9c\u0db8\u0db1 \u0dd9\u0d9a\u0dcf\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0da2\u0dcf\u01af\u0d9a \u0d9c\u0db8\u0db1\u0dcf\u0d9c\u0db8\u0db1 \u0dd9\u0d9a\u0dcf\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\n\n(\u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1)(\u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1)\n\n4\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n(\u0daf) \u0db4\u0db1\u0dd9\u0dad\u028f \u01e7\u0dc1\u0dca\u013d\u0dad\u0dc0 \u0daf\u00fa\u0dc0\u0dcf \u0d87\u01af \u0db4\u025c\u01ce \u0dd9\u0d9a\u0dcf\u023d\u0dc2\u01e6 \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0d9a\u0da7\u0252\u01b1 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4\u0dcf\u0dba \u026b\u0db8\u0da7 \u0d8b\u0db4\u0d9a\u023d\u017b \u0db4\u01ae \u00fb\u025d\u0db8;\n\n(\u0db1) \u0db8\u0dcf\u0259\u0d9c\u0dc3\u0dca\u0dae \u021d\u0dc0\u0dcf\u0dc4\u0db1\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0da2\u0dcf\u01af\u0d9a \u021d\u01af\u0db4\u01ae\u01af\u0dba \u0dc0\u0dcf\u0259\u027f\u0d9a\u0dc0 \u0dc3\u0db8\u0dcf\u0dd9\u0dbd\u0dcf\u0dca\u0da0\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc3\u0dc4 \u0d91\u0db8 \u021d\u01af\u0db4\u01ae\u01af\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u01e8\u01af\u0db8\u0dba, \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1\u0db8\u0dba \u0dd9\u0dc4\u0dcf\u0dca \u0dd9\u0dc0\u0db1\u01ae \u0d9a\u025e\u019f \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d86\u019c\u018d\u0dc0\u0da7 \u0d8b\u0db4\u0dd9\u0daf\u0dc3\u0dca \u01cf\u0db8;\n\n(\u0db4) \u0d85\u0daf\u0dcf\u0dc5 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\u0dc1, \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf, \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1, \u01ce\u0dc3\u0dca\u01b5\u00fa \u0dc3\u0dc4 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd, \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0dc3\u0dc4 \u0dd9\u0db4\u0ddf\u01ca\u0d9c\u0263\u0d9a \u0d85\u0d82\u0dc1\u0dd9\u024f \u0dc3\u0d82\u026a\u0db0\u0dcf\u0db1 \u026a\u0db8\u0287\u0db8 \u0dc3\u0dc4 \u0db8\u0dcf\u0259\u0d9c \u0d85\u0db1\u01b1\u025e \u0dc0\u0dd0\u0dc5\u0dd0\u00fa\u026b\u0dd9\u023c \u0d9a\u0dcf\u0259\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4 \u0db8\u011a\u01e6\u0dd9\u0118 \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c \u0288\u025a\u00fc\u0db8 \u0dc3\u0dc4 \u0d86\u0dbb\u00fa\u0dc2\u0dcf \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u021d\u0dc0\u0dcf\u0dc4\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0dcf \u01ce\u0252\u019f \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0dc4\u0dd0\u00fb \u0218\u0dba\u0dc0\u0dbb \u01e7\u0259\u0dd9\u01ca\u0dc1 \u00fb\u025d\u0db8;\n\n(\u0db6) \u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae \u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u0dd9\u0dc4\u0dcf\u0dca \u0d92 \u0dba\u0da7\u0dd9\u01ae \u0dc3\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0dba\u023c \u01e7\u0dd9\u0dba\u0dcf\u0dca\u0d9c\u0dba\u00fa \u0d9a\u0da9\u00fb\u025d\u0db8 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0db8\u0dc4\u0da2\u0db1\u0dad\u0dcf\u0dc0\u0dd9\u0d9c\u01e6 \u0db4\u0dd0\u023d\u019d\u0263 \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8; \u0dc3\u0dc4\n\n(\u0db8) \u0d85\u0dc0\u0dc3\u0dbb\u0db4\u01b4\u0dba\u00fa \u0dd9\u0dc4\u0dcf\u0dca \u0dc3\u0dc4\u01af\u0d9a\u0dba\u00fa \u0d89\u0262\u0265\u023c \u0d9a\u0dbb\u0db1 \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0dc0\u0d9a\u0dd4\u0dd9\u0118, \u0db8\u0119\u0dba\u0d9a\u0dd4\u0dd9\u0118 \u0dd9\u0dc4\u0dcf\u0dca \u0d85\u0dc0\u0dc3\u0dbb\u0db4\u01b4\u0dba\u00fa \u0dd9\u0dc4\u0dcf\u0dca \u0dc3\u0dc4\u01af\u0d9a\u0dba\u00fa \u0daf\u0dbb\u01e6\u0db1\u0d9a\u0dd4\u0dd9\u0118 \u0db4\u0dc4\u0288\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc4\u0dcf\u0dca \u0db4\u0db1\u0dd9\u01ae \u0d9a\u0dcf\u0259\u0dba\u00fa\u0dc2\u0db8 \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0dc4\u0dd0\u00fb, 44 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u01e7\u0dd9\u0dba\u0dcf\u0dca\u0d9c \u0dc3\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0d9a\u025e\u019f \u0dc3\u0db3\u0dc4\u0dcf \u021a\u029a\u0262 \u021d\u0da0\u0dcf\u0dbb\u0dba\u00fa \u0dbd\u0db6\u0dcf \u01cf\u0db8.\u201d.\n\n6. \u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dd9\u024f 9 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba, \u0d91\u028f (\u0d8c) \u0dd9\u0146\u0daf\u0dba \u0d89\u0dc0\u01ae \u0d9a\u0dbb, \u0d92 \u0dd9\u0dc0\u01e9\u0dc0\u0da7, \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0dd9\u0146\u0daf\u0dba \u0d86\u0dd9\u01ca\u0dc1 \u00fb\u025d\u0dd9\u0db8\u01e6 \u0dd9\u0db8\u0250\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229:-\n\n\u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dd9\u024f 9 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u00fb\u025d\u0db8"
