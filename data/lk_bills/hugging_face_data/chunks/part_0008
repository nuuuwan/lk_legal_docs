0\u0dd0\u0dba \u0dc3\u0dc4\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf\u0dc0\n\n\u0db4\u0db1\u0dad\u0dda\ufffd 3 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d92 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0dd1\u0db8\n\n\u0dc0\u0db1\u0dd4\u0dba\u0dda\u024f 2025 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dc3 31 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0db6\u0dbd\u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d85\u0dba\u0dc0\u0dd0\u0dd0\u0dba \u0dc3\u0dc4\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf\u0dc0 \u0d9c\u0dd9\ufffd\u0dc0\u0dd3\u0db8 \u0db1\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0dba.\n\n\u0dc3\u0dda\u02e6\u0dda\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0d85\u0dba\u0dc0\u0dd0\u0dd0\u0dba \u0dc3\u0dc4\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf\u0dc0 (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0db1)\u0dc3\u0dda\u02e6\u0dda\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0d85\u0dba\u0dc0\u0dd0\u0dd0\u0dba \u0dc3\u0dc4\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf\u0dc0 (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0db1)\n\n\u0d91\u0dbd\u0dca.\u0da9\u0dd3.- \u0d95 19/2025\n\n2016 \u0d85\u0d82\u0d82\u0d9a 4 \u0daf\u0dbb\u0db1 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0d85\u0dba\u0dc0\u0dd0\u0dd0\u0dba \u0dc3\u0dc4\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf\u0dc0 \u0db4\u0db1\u0dad 2016 \u0d85\u0d82\u0d82\u0d9a 4 \u0daf\u0dbb\u0db1 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0d85\u0dba\u0dc0\u0dd0\u0dd0\u0dba \u0dc3\u0dc4\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf\u0dc0 \u0db4\u0db1\u0dad\n\n\u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\