    "chunk_text": "(3) \u0d89\u0dc4\u0dad (1) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dba \u0db4 \u0261\u0d9a\u0dcf\u0dbb\u0dc0 \u0dba\u023c \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u00fa \u026a\u0286\u01e6 \u0d86\u0dbb\u0dcf\u026c\u0dbd\u00fa \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba \u00fb\u025d\u0db8 \u0d86\u0dbb\u023c\u0db7 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a \u01cf, \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u0dc3\u0db4\u0dba\u01e6\u0db1\u0dcf \u026a\u0286\u01e6 \u0daf\u0dd0\u01e6\u026b\u0db8 \u0dbd\u0dd0\u022c\u019f \u0dc0\u0dc4\u0dcf\u0db8, \u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u00fd \u0db4\u01ae \u0d9a\u0dbb \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba \u0d86\u0dbb\u023c\u0db7 \u00fb\u025d\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u0255 \u0dba\u023c \u0218\u0dba\u0dc0\u0dbb \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0d9a\u0da7\u0252\u01b1 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0dba.\n\n9. (1) \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba\u00fa \u0286\u01d0 \u00fb\u025d\u0dd9\u023c \u0d9a\u0dcf\u0259\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u025e\u01e6 \u0dd9\u0daf\u0dd9\u0daf\u0db1\u00fd \u0dd9\u0dc4\u02a4 \u0d8a\u0da7 \u0dc0\u0dd0\u018b\u0dd9\u0dba\u01e6 \u0286\u0179\u0dba \u0252\u01b1 \u0db6\u0dc0\u0da7 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u01e6 \u0d91\u0d9a\u0d9f \u026b \u0d87\u01ae\u0db1\u023c \u023d\u0dc3, \u0d91\u00fa \u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u00fd \u0286\u0179\u0dba \u0252\u01b1 \u0dba.\n\n10. \u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u00fd \u0db4\u01ae \u0d9a\u0dc5 \u01ce\u0db1\u0dd9\u024f \u01cf \u0d86\u0dbb\u0dcf\u026c\u0dbd\u00fa \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba \u0d86\u0dbb\u023c\u0db7 \u0d9a\u0dc5 \u0dd9\u0dbd\u0dc3 \u0dc3\u0dd0\u0dc5\u00fb\u0dba \u0252\u01b1 \u0dba.\n\n11. \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dba\u00fa \u026a\u0286\u01e6, \u0dba\u023c \u0286\u026a\u0262 \u0dd9\u0dc4\u02a4 \u0dc0\u0dcf\u019d\u0da2 \u0d86\u0dbb\u0dcf\u026c\u0dbd\u00fa \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0dc0\u0db1 \u0dba\u023c \u0db1\u018d\u0dc0\u0d9a \u01cf \u0dd9\u0dc4\u02a4 \u0db1\u018d \u0d9a\u0da7\u0252\u01ae\u0dad\u0d9a \u01cf \u0db1\u018d \u0d9c\u0dcf\u0dc3\u0dca\u01b1 \u0db4 \u0261\u0daf\u0dcf\u0db1\u0dba \u00fb\u025d\u0dd9\u023c \u01cf \u0dba\u023c \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u00fa \u026a\u0286\u01e6 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dc4\u0db7\u0dcf\u0119 \u026b\u0db8 \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0dd9\u0dbd\u0dc3 \u0db4 \u0261\u01af\u00fa\u0dd9\u0dc2\u02a2\u0db4 \u0d9a\u0dbb \u01af\u0dd9\u0229 \u0daf \u0dba\u01e6\u0db1 \u0dc3\u0dd0\u0dbd\u00fb\u0262\u0dbd\u0da7 \u0d9c\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0dba.\n\n12. \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba \u0db8\u0119\u01e6 \u0d86\u0dbb\u0dcf\u026c\u0dbd \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0db8\u0da7 \u0dc3\u01ca\u0db7\u0dcf\u0dc0\u0dd9\u0dba\u01e6 \u0252\u01b1\u0dc0 \u0d8b\u01ae\u0dc3\u0dcf\u0dc4 \u00fb\u025d\u0db8, \u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae \u0daf\u00fa\u0dc0\u0dcf \u0d87\u01af \u026a\u01dd\u026a\u0db0\u0dcf\u0db1\u0dc0\u0dbd\u0da7 \u0d85\u01e9\u00fe\u0dbd\u0dc0 \u0dbb\u0dc4\u0dc3\u0255\u0db7\u0dcf\u0dc0\u0dba \u0db4\u0dc0\u01ae\u0dc0\u0dcf \u0d9c\u0dd0\u01e8\u0db8 \u0dc3\u0dc4 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba\u00fa \u0286\u01d0 \u00fb\u025d\u0dd9\u023c \u01cf \u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u01e6\u0db1\u0dcf \u026d \u025d\u01af\u0dc0\u0dbd\u0da7 \u0d85\u01e9\u00fe\u0dbd\u0dc0 \u0d9a\u0da7\u0252\u01b1 \u00fb\u025d\u0db8 \u0dba\u023c \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba\u0d9a \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u01e6\u0dd9\u0118 \u0252\u01b1\u0d9a\u0db8 \u0dc3\u0dc4 \u0dc0\u0d9c\u00fc\u0db8 \u026a\u0dba \u0252\u01b1 \u0dba.\n\n13. (1) \u0dba\u023c \u0d86\u0dbb\u0dcf\u026c\u0dbd\u0d9a \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0d9a\u025e\u0dc0\u00fd\u0da7 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dd9\u024f \u0dc3\u0dd0\u0db8 \u0d85\u01ce\u0dba\u0dbb\u0dba\u0d9a \u01cf \u0db8 \u0d8d\u0151\u0dc0 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dd9\u024f \u0dd9\u0dba\u01cf\u0db8\u0da7 \u028f\u023d\u0d9a\u0db8 \u0d87\u01af \u0d85\u0dad\u0dbb, \u0d91\u0dd9\u0dc3\u02a2 \u0dd9\u0dba\u01cf\u0db8\u0da7 \u01e7\u0dba\u0db8 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb, \u0dd9\u0dc0\u0db1\u01ae \u0dba\u023c\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n\u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u00fd \u0db4\u01ae \u00fb\u025d\u0db8\n\n\u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba \u0d86\u0dbb\u023c\u0db7 \u00fb\u025d\u0db8\n\n\u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0dd9\u0dbd\u0dc3 \u021d\u01af\u00fa\u0dd9\u0dc2\u02a2\u0db4 \u00fb\u025d\u0db8 \u0db1\u018d \u0d9c\u0dcf\u0dc3\u0dca\u01b1\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae \u026a\u0dba \u0252\u01b1 \u0db6\u0dc0\n\n\u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba\u00fa \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u01e6 \u0dc3\u01b1 \u0252\u01b1\u0d9a\u023c\n\n\u0dba\u023c \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u0d9a\u0da7 \u0d8d\u0151\u0dc0\u0db8 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dd9\u0dba\u028f \u0dd9\u0dba\u01ce\u0dba \u0dc4\u0dd0\u00fb \u0db6\u0dc0\n\n7\u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab (\u0286\u026a\u0262 \u0dc3\u0dc4 \u0dc0\u0dcf\u019d\u0da2 \u0d86\u0dbb\u0dcf\u026c\u0262)\n\n\u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u026a\u0286\u01e6 \u0d91\u0dc0\u0dd0\u01e7 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0d9a\u025e\u0dc0\u00fd \u01e7\u0dd9\u0dba\u02a4\u0da2\u0db1\u0dba \u00fb\u025d\u0db8 \u0286\u01d0 \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1 \u0dba.\n\n(2) \u0dba\u023c \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u00fa \u026a\u0286\u01e6 \u01e8\u01af\u0da5\u0dc0\u0dbb\u0dba\u00fd \u0d87\u01b1\u029a\u0dc0 \u0dba\u023c \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u0d9a\u0da7 \u026a\u0dc3\u01ff\u0db8\u00fa \u0d87\u01af \u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0dc3\u0dc4\u0dcf\u0dba \u026a\u0dba \u0dc4\u0dd0\u00fb \u0dd9\u0dc0\u0db1\u01ae \u0dba\u023c \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u0dc3\u0db8\u0d9f \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba\u0da7 \u0dc3\u0dc4\u0db7\u0dcf\u011a \u026b\u0db8\u0da7 \u0dd9\u0dad\u02a4\u0dbb\u0dcf \u0d9c\u0dd0\u01e8\u0db8 \u0d9a\u0dc5 \u0dc4\u0dd0\u00fb \u0d85\u0dad\u0dbb, \u0d92 \u0dd9\u0dc0\u0db1\u01ae \u0dba\u023c \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u0dcf \u026a\u0286\u01e6, \u0d92 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dd9\u024f \u0d89\u0262\u0264\u0db8 \u0db8\u0dad \u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab \u0d9a \u0261\u0dd2\u0dba\u0dcf\u0dc0\u0263\u0dba \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u00fb\u025d\u0db8 \u0dc3\u0dc4 \u0db4\u0dcf\u0dbd\u0db1\u0dba \u00fb\u025d\u0db8\u0da7 \u0dba\u0da7\u01ae\u0dc0, \u0d92 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba \u0dd9\u0dc0\u01e9\u0dd9\u0dc0\u01e6 \u0db4 \u0261\u0d9a\u0dcf\u0dc1 \u0286\u01d0 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0dc4\u0dd0\u00fb \u0dba.\n\n(3) \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dba\u00fa \u0dd9\u0dc4\u02a4 \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dba\u00fa \u0dd9\u0dc4\u02a4 \u0ddb\u0db1\u01af\u0d9a \u021a\u01ca\u0d9c\u0dbd\u0db7\u0dcf\u0dc0\u0dba\u00fa \u0d87\u01af \u0dd9\u0dc0\u0db1\u01ae \u0d85\u0dc3\u0dca\u01c2\u01ae\u0dc0\u0dba\u00fa \u0dd9\u0dc4\u02a4 \u0dbb\u0da2\u0dd9\u024f \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dc0\u00fa \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u0d86\u0dba\u0dad\u0db1\u0dba\u00fa \u0dc0\u0db1 \u0dba\u023c \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u00fa \u0dd9\u0dc0\u01e9\u0dd9\u0dc0\u01e6 \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0db8\u00fa \u0d87\u01af \u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0dc3\u0dc4 \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0db8\u0d9a\u0da7 \u0d91\u0d9a\u0d9f \u026b\u0db8\u0da7 \u0d9a\u0dae\u0dcf \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0263\u0110\u0dad\u0dc0 \u0dbd\u0db6\u0dcf\u0dd9\u0daf\u0db1 \u0dbd\u0daf \u01e7\u0286 \u0d85\u01dd\u0d9a\u0dcf\u025c \u0db8\u0178\u0da7\u0db8\u00fa \u0dc3\u028f\u0dad \u01e7\u0dbd\u0db0\u0dbb\u0dba\u00fd \u026a\u0286\u01e6 \u0d92 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba \u01e7\u0dd9\u0dba\u02a4\u0da2\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0dba.\n\n14. (1) \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u0dc3\u0db4\u0dba\u01e6\u0db1\u00fd \u026a\u0286\u01e6 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba \u0286\u01d0 \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1\u0db8\u0dba \u0dc3\u0dc4\u0dcf\u0dba \u0dbd\u0db6\u0dcf\u01ce\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb, \u0d92 \u0d9a\u0dcf\u0259\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u01e7\u0dba\u0db8\u0dba\u01e6\u0da7 \u0d85\u01e9\u00fe\u0dbd\u0dc0 \u0d9a\u0da7\u0252\u01b1 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0dba :-"
