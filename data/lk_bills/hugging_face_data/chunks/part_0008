u0d9c\u0dad \u00fb\u025d\u0dd9\u023c)\u0dd9\u017e\u018a\u0dd9\u0dc3\u0dcf\u0dca \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db4\u0daf\u0db1\u0db8 (\u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u00fb\u025d\u0dd9\u023c)\n\n\u0dd9\u017e\u018a\u0dd9\u0dc3\u0dcf\u0dca \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db4\u0daf\u0db1\u0db8 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u026d \u0dd9\u017e\u018a\u0dd9\u0dc3\u0dcf\u0dca \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db4\u0daf\u0db1\u0db8 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u026d\n\n\u0db4\u0db1\u01ae \u0dd9\u0d9a\u017b\u023c\u0db4\u0dad\u00fb\u0db4\u0db1\u01ae \u0dd9\u0d9a\u017b\u023c\u0db4\u0dad\u00fb\n\n\u023f\u01d6\u0dab\u0dba \u00fb\u025d\u0db8\u0da7 \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1\u0dc0 \u026a\u0286\u01e6 \u01e7\u0dd9\u0dba\u0dcf\u0dca\u0d9c \u0d9a\u0dbb\u0db1 \u0dbd\u01cf\n\n[19 \u0dc0\u0db1 \u0db4\u0db1\u01ae \u0dd9\u0d9a\u017b\u023c\u0db4\u0dad]\n\n\u0dd9\u017e\u018a\u0dd9\u0dc3\u0dcf\u0dca \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db4\u0daf\u0db1\u0db8 \u0dd9\u017e\u018a\u0dd9\u0dc3\u0dcf\u0dca \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db4\u0daf\u0db1\u0db8\n\n(\u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u00fb\u025d\u0dd9\u023c(\u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u00fb\u025d\u0dd9\u023c)\n\n1\n\n\u0dd9\u017e\u018a\u0dd9\u0dc3\u0dcf\u0dca \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db4\u0daf\u0db1\u0db8 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u00fb\u025d\u0db8\n\n\u021b\u0259\u026a\u0d9a\u0dcf\u0dc0\n\n\u0265\u0291\u01a8 \u0db1\u0dcf\u0db8\u0dba\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n\u0dd9\u017e\u018a\u0dd9\u0dc3\u0dcf\u0dca \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db4\u0daf\u0db1\u0db8 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u026d \u0db4\u0db1\u0dad\u00fb\u0dd9\u017e\u018a\u0dd9\u0dc3\u0dcf\u0dca \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db4\u0daf\u0db1\u0db8 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u026d \u0db4\u0db1\u0dad\u00fb\n\n\u201c\u0dd9\u017e\u018a\u0dd9\u0dc3\u0dcf\u0dca \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db4\u0daf\u0db1\u0db8\u201d \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc4\u01ff\u01e6\u0dc0\u01e9 \u0dbd\u0db6\u0db1 \u0dc4\u0dcf \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0dc3\u0dc4 \u0db4\u0daf\u0db1\u0db8\u00fa, \u0d91\u0db8 \u0db4\u0daf\u0db1\u0dd9\u023c \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u01e6 \u0d91\u0d9a\u0d9f \u026d \u025d\u01af\u0dc0\u0dbd\u0da7 \u0d85\u01e9\u0dc0, \u0d91\u00fc \u0db4\u0daf\u0db1\u0db8\u0da7 \u0dc3\u023c\u0db6\u01e6\u0db0 \u0286\u0dba\u0265 \u0d9a\u025e\u019f \u0db5\u0dbd\u0daf\u0dcf\u0251 \u0dd9\u0dbd\u0dc3 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u00fb\u025d\u0dd9\u023c \u0dc4\u0dcf \u0d9a\u0dbb\u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0dd9\u023c \u0d9a\u0dcf\u0259\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0db8\u0dd9\u0dad\u00fa \u0d9a\u0262 \u027c \u0dbd\u0dcf\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u0218\u028f\u017b\u0dc0\u0dcf \u01af\u022d \u0dd9\u0dc4\u0250\u01e6 \u0daf:\n\n\u0d91\u00fc \u0db4\u0daf\u0db1\u0db8 \u0218\u028f\u017b\u0dc0\u01e9 \u0dbd\u0dd0\u022d\u0dd9\u0269 \u0dba\u023c \u0db4\u0dbb\u0db8\u0dcf\u0259\u0dae \u0dc3\u0dc4 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0daf, \u0d92 \u0db4\u0dbb\u0db8\u0dcf\u0259\u0dae \u0dc3\u0dc4 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0dd9\u0db8\u0dd9\u0dad\u00fa \u0d9a\u0262 \u0d91\u00fc \u0db4\u0daf\u0db1\u0db8 \u026a\u0286\u01e6 \u0dc3\u0dcf\u0259\u0dae\u0d9a \u0dd9\u0dbd\u0dc3 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0d9a\u0dbb \u0dc3\u0dc4 \u0d89\u017b \u0d9a\u0dbb \u0d87\u01af \u0dd9\u0dc4\u0250\u01e6 \u0daf, \u0d91\u00fc \u0db4\u0daf\u0db1\u0db8 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u0d9a\u0dbb\u0db1 \u0dd9\u0dbd\u0dc3 \u0d89\u0262\u0dbd\u0dcf \u0d87\u01af \u0db6\u0dd0\u026a\u01e6\u0daf, \u0d92 \u0d89\u0262\u0264\u0db8 \u0d89\u017b \u00fb\u025d\u0db8 \u0db8\u0dc4\u0da2\u0db1 \u0dba\u0dc4\u0db4\u0dad \u0218\u019d\u0dc3 \u0dd9\u0dba\u0dcf\u0dca\u0d9c\u0255 \u0dc0\u0db1 \u0dd9\u0dc4\u0250\u01e6 \u0daf:\n\n\u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1\u0dc0 \u026a\u0286\u01e6 \u0dd9\u0db8\u0dd9\u0dc3\u0dca \u0db4\u0db1\u0dc0\u01e9 \u0dbd\u0dd0\u0dd9\u0229:-\n\n1. \u0dd9\u023c \u0db4\u0db1\u0dad 2025 \u0d85\u0d82\u0d9a \u0daf\u0dbb\u0db1 \u0dd9\u017e\u018a\u0dd9\u0dc3\u0dcf\u0dca \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db4\u0daf\u0db1\u0db8 (\u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u00fb\u025d\u0dd9\u023c) \u0db4\u0db1\u0dad \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc4\u01ff\u01e6\u0dc0\u01e9 \u0dbd\u0dd0\u0dd9\u0229.\n\n2. (1) \u0dd9\u023c \u0db4\u0db1\u0dad \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u026b\u0db8 \u0d86\u0dbb\u023c\u0db7 \u0dc0\u0db1 \u01ce\u0db1 \u0286\u0da7 \u0dc3\u0dc4 \u0d89\u01e6 \u0db4\u0288\u0dc0 (\u0dd9\u0db8\u028f \u023d\u01e6\u0db8\u01b1 \u201c\u0db4\u0daf\u0db1\u0db8\u201d \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1) \u0dd9\u017e\u018a\u0dd9\u0dc3\u0dcf\u0dca \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db4\u0daf\u0db1\u0dd9\u023c \u0daf\u0dd0\u0db1\u0da7 \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u01e6\u0dc0 \u0286\u0179\u0db1 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u01e6 \u0dc3\u0dc4 \u0dd9\u0db8\u0250\u01e6 \u0218\u028f\u017b\u0dc0\u01e9 \u0dbd\u0db6\u0db1 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dba\u0da7 \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u01e6 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u023d\u01e6 \u0db8\u01b1 \u0d87\u01b1\u0dc5\u01ae \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u01e6 (\u0dd9\u0db8\u028f \u023d\u01e6\u0db8\u01b1 \u201c\u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dba\u201d \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc4\u01ff\u01e6\u0dc0\u01e9 \u0dbd\u0db6\u0db1) \u201c\u0dd9\u017e\u018a\u0dd9\u0dc3\u0dcf\u0dca \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0db4\u0daf\u0db1\u0db8\u201d \u0dba\u0db1 \u0db1\u0dcf\u0db8\u0dba \u0dc3\u0dc4 \u0d85\u0234\u0db0\u0dcf\u0db1\u0dba \u0dba\u0da7\u0dd9\u01ae \u0d85\u026a\u013c\u014f\u01e6\u0db1 \u0db4\u0dd0\u0dc0\u0dd0\u01ae\u0db8\u00fa \u0d87\u01af \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dba\u00fa \u026a\u0dba \u0252\u01b1 \u0dba. \u0dad\u0dc0 \u0daf \u0d91\u00fc \u0db1\u0dcf\u0db8\u0dd9\u0dba\u01e6 \u0d92 \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0218\u0dad \u0db8\u019c\u0da9\u0dbd\u0dba \u026a\u0286\u01e6 \u0daf, \u0d91\u0dba\u0da7 \u026a\u025e\u01ca\u0db0\u0dc0 \u0daf, \u0286\u0dba\u0265 \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dc0\u0dbd \u01cf \u0db1\u018d \u0db4\u0dc0\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0dc4\u0dd0\u00fb \u0d85\u0dad\u0dbb, \u0dd9\u0db4\u0dcf\u01d0 \u023f\u01d6\u0dcf\u0dc0\u00fa \u0dad\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0daf, \u0d91\u0dba \u0db4\u0dcf\u026a\u013c\u013d \u00fb\u025d\u0dd9\u023c \u0daf, \u0dc3\u0dca\u0dc0\u00fc\u0dba \u0d85\u0234\u0db8\u0dad\u0dba \u0db4\u025c\u01ce \u0d91\u0dba \u0dd9\u0dc0\u0db1\u0dc3\u0dca \u00fb\u025d\u0dd9\u023c \u0daf \u021b\u0259\u0dab \u0db6\u0dbd\u0dba \u0dc3\u0dc4 \u0d85\u01dd\u0d9a\u0dcf\u0dbb\u0dba \u0d8a\u0da7 \u0d87\u01ae\u0dd9\u01ae \u0dba."
