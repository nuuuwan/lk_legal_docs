0dd0\u0dd0\u0db4\u0dd0\u0dd0\u0dbd\u0dca \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0 : \u0dbb\u0dd4. 150.00\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f\u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f\n\n\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u023c\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u023c\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n\u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0dc0\u0dd2\u0d9c\u0dab\u0db1 (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1)\u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0dc0\u0dd2\u0d9c\u0dab\u0db1 (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1)\n\n2018 \u0d85\u0d82\u0d82\u0d9a 19 \u0daf\u0dbb\u0db1 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0dc0\u0dd2\u0d9c\u0dab\u0db1 \u0db4\u0db1\u0dad \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd6 2018 \u0d85\u0d82\u0d82\u0d9a 19 \u0daf\u0dbb\u0db1 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0dc0\u0dd2\u0d9c\u0dab\u0db1 \u0db4\u0db1\u0dad \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd6\n\n\u0db4\u0db1\u0dad\u0dca \u0d9a\u0dd9\ufffd\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0d9a\u0dd2\u0db4\u0db1\u0dad\u0dca \u0d9a\u0dd9\ufffd\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0d9a\u0dd2\n\n\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u023c\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0d9c \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3\n\n[25 \u0dc0\u0db1 \u0db4\u0db1\u0dad\u0dca \u0d9a\u0dd9\u02c1\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad]\n\n2\n\n\u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0dc0\u0dd2\u0d9c\u0dab\u0db1 (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1)\n\n\u0db1\u0dd3\u0dad\u0dd2\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0dd1\u0db8\u0dda\ufffd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dba\n\n2 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba: \u0db8\u0dda\u023c \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca (\u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db8\u0dd2\u0db1\u0dca \u0db8\u0dad\u0dd4 \u201c\u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u201d \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1) 2018 \u0d85\u0d82\u0d82\u0d9a 19 \u0daf\u0dbb\u0db1 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0dc0\u0dd2\u0d9c\u0dab\u0db1 \u0db4\u0db1\u0dad\u0dda\ufffd 7 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0dd1\u0db8 \u0dc0\u0db1\u0dca\u0db1\u0dda\ufffd, \u0dc0\u0dd2\u0d9c\u0dab\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d86\u0dc3\u0dca\u0dca\u0dae\u0dd2\u0dad\u0dca\u0dc0\u0dba\u0d9a \u0dc0\u0dd2\u0d9c\u0dab\u0db1\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0daf\u0dd3 \u0dc0\u0dd2\u0d9c\u0dab\u0d9a\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0ddc\ufffd\u0ddc\u0dba\u0dcf\u0dcf \u0d9c\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc0\u0d82\u0d82\u0da0\u0dcf\u0dcf\u0dc0\u0d9a\u0dca, \u0daf\u0dd6\u0dc2\u0dab\u0dba\u0d9a\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc3\u0dcf\u0dcf\u0dc0\u0daf\u0dca\u200d\u0dba\ufffd \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0db8\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dca \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dbd\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0dc3\u0dd0\u0dd0\u0dbd\u0dd0\u0dd0\u0dc3\u0dca\u0dca\u0dc0\u0dd3\u0db8 \u0dc0\u0dda\u0dda.\n\n3 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba: \u0db8\u0dda\u023c \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f 9 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0dd1\u0db8 \u0dc0\u0db1\u0dca\u0db1\u0dda\ufffd, \u0d91\u0db8 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f (\u0d85) \u0dc0\u0db1 \u0da1\u0dda\u0dda\u0daf\u0dba\u0dda\u024f \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0dc0\u0dd3\u0db8 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f 21 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0db0\u0dd2\u0db7\u0dcf\u0dcf\u0dbb \u0dc3\u0db8\u0dcf\u0dcf\u0dbd\u0ddd\ufffd\u0ddd\ufffd\u0da0\u0db1 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0 \u0dc0\u0dd9\u0dd9\u0dad \u0daf \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dca\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dda\u0dda."
