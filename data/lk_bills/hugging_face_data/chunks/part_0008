ba\u0dad\u0db1\u0dba \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0d86\u0dba\u0dad\u0db1\u0dba\n\n(\u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd)(\u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd)\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\n\n\u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd6 \u0db4\u0db1\u0dad\u0d9a\u0dd2\u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd6 \u0db4\u0db1\u0dad\u0d9a\u0dd2\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db8\u0dd9\ufffd\u0dc3\u0dda\ufffd\u0dda \u0db4\u0db1\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\ufffd:-\n\n1.1. \u0db8\u0dda\ufffd \u0db4\u0db1\u0dad 2025 \u0d85\u0d82\u0d82\u0d9a \u0daf\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0d86\u0dba\u0dad\u0db1\u0dba (\u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd) \u0db4\u0db1\u0dad \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\ufffd.\n\n2.2. (1) \u0db8\u0dda\ufffd \u0db4\u0db1\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd3\u0db8 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0dc3\u0dc4 \u0d89\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0 (\u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db8\u0dd2\u0db1\u0dca \u0db8\u0dad\u0dd4 \u201c\u0d86\u0dba\u0dad\u0db1\u0dba\u201d \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1) \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda\u024f \u0daf\u0dd0\u0dd0\u0db1\u0da7 \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db1\u0dca \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dad\u0dcf\u0dcf\u0d9a\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0db1\u0dca \u0dc3\u0dc4 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0da7 \u0db8\u0dd2\u0db1\u0dca \u0db8\u0dad\u0dd4 \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db1\u0dca \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db6\u0db3\u0dc0\u0dcf\u0dcf\u0d9c\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0db1\u0dca (\u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db8\u0dd2\u0db1\u0dca \u0db8\u0dad\u0dd4 \u201c\u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u201d \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1) \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0d86\u0dba\u0dad\u0db1\u0dba \u0dba\u0db1 \u0db1\u0dcf\u0dcf\u0db8\u0dba \u0dc4\u0dcf\u0dcf \u0d85\u0db7\u0dd2\u0db0\u0dcf\u0dcf\u0db1\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0d85\u0dc0\u0dd2\u0da0\u0dca\u0da1\u0dd2\u0db1\u0dca\u0db1 \u0db4\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dad\u0dbb, \u0d91\u0d9a\u0dd3 \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d91\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0daf, \u0d8a\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0\u0dc0 \u0daf, \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba\u0db1\u0dca \u0dc4\u0dd2 \u0db1\u0da9\u0dd4 \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd2\u0dba \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0d85\u0dad\u0dbb, \u0db4\u0ddc\u02da\u0ddc\u0daf\u0dd4 \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0dad\u0db6\u0dcf\u0dcf \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dda\ufffd \u0dc3\u0dc4 \u0d91\u0dba \u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0daf\u0dd3 \u0dc3\u0dca\u0dc0\u0d9a\u0dd3\u0dba \u0d85\u0db7\u0dd2\u0db8\u0dad\u0dba \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d91\u0dba \u0dc0\u0dd9\u0dd9\u0db1\u0dc3\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0daf \u0d91\u0dba\u0da7 \u0d86\u0db1\u0dd4\u0dc2\u0d82\u0d82\u0d9c\u0dd2\u0d9a \u0dc0\u0dd6 \u0dc4\u0ddd\ufffd\u0ddd \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0d9a\u0dcf\u0dcf\u0dbb\u0dab\u0dcf\u0dcf \u0dc3\u0dc4 \u0daf\u0dda\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0daf \u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db6\u0dbd\u0dba \u0dc4\u0dcf\u0dcf \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba \u0d91\u0dba\u0da7 \u0d87\u0dad\u0dca\u0dad\u0dda\ufffd \u0dba."
