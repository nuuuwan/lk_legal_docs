0bc1\u0bae\u0bcd\n\n\u0bb5\u0bb0\u0bc8\u0bc8\u0bb5\u0bbf\u0bbf\u0bb2\u0b95\u0bcd\u0b95\u0ba3\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8 \u0b89\u0b9f\u0ba9\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0bbf\u0bbf\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bcd\n\n\u0baa\u0bc1\u0ba4\u0bbf\u0bbf\u0baf \u0bb5\u0bb0\u0bc8\u0bc8\u0bb5\u0bbf\u0bbf\u0bb2\u0b95\u0bcd\u0b95\u0ba3\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8 \u0b87\u0b9f\u0bc1\u0bb5\u0ba4\u0ba9\u0bcd\u0bae\u0bc2\u0bb2\u0bae\u0bc1\u0bae\u0bcd:-\n\n\u201c\u201c\u0baa\u0b95\u0bbf\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bcd \u0b95\u0bc1\u0bb4\u0bc1\u201d \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd\n\n\u201c\u0baa\u0b95\u0bbf\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0b95\u0bcd \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bcd\u0bae\u0bc1\u0baf\u0bb1\u0bcd\u0b9a\u0bbf\u0bbf\u0b95\u0bb3\u0bcd\u0bae\u0bc0\u0ba4\u0bbe\u0bbe\u0ba9\n\n\u0b95\u0bc1\u0bb4\u0bc1\u201d \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1, \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8\u0b9a\u0bcd\n\n\u0b9a\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0b9a\ufffd\u0bcb\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bb0\u0b9a\u0bc1\u0baa\u0bcd\n\n\u0baa\u0bbe\u0bbe\u0bb0\ufffd\u0bb3\u0bc1\u0bae\u0ba9\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bbf\u0bb2\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0baf\u0bb1\u0bcd\n\n\u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8\u0bc8\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bbf\u0baf\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd\u0baa\u0b9f\u0bbf\n\n\u0baa\u0bbe\u0bbe\u0bb0\ufffd\u0bb3\u0bc1\u0bae\u0ba9\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bbe\u0bbe\u0bb2\u0bcd \u0ba8\u0bbf\u0bbf\u0baf\u0bae\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\n\n\u0baa\u0b95\u0bbf\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bcd \u0b95\u0bc1\u0bb4\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd\n\n\u0baa\u0b95\u0bbf\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0ba4\u0bcd \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0baf\u0bb1\u0bcd\u0b9a\u0bbf\u0bbf\u0b95\u0bb3\u0bcd\u0bae\u0bc0\u0ba4\u0bbe\u0bbe\u0ba9\n\n\u0b95\u0bc1\u0bb4\u0bc1 \u0b8e\u0ba9\u0baa\u0bcd \u0baa\ufffd\u0bca\u0bb0\u0bc1\u0bb3\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd;\u201d; \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd\n\n(2) \u201c\u0ba4\u0b95\u0bb5\u0bb2\u0bcd\u201d \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0bb5\u0bb0\u0bc8\u0bc8\u0bb5\u0bbf\u0bbf\u0bb2\u0b95\u0bcd\u0b95\u0ba3\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8\n\n\u0b89\u0b9f\u0ba9\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0bbf\u0bbf\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0baa\u0bc1\u0ba4\u0bbf\u0bbf\u0baf \u0bb5\u0bb0\u0bc8\u0bc8\n\n\u0bb5\u0bbf\u0bbf\u0bb2\u0b95\u0bcd\u0b95\u0ba3\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8 \u0b87\u0b9f\u0bc1\u0bb5\u0ba4\u0ba9\u0bcd\u0bae\u0bc2\u0bb2\u0bae\u0bc1\u0bae\u0bcd:-\n\n\u201c\u201c\u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0baa\u0b9f\u0bcd\u0b9f\u0baf\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n\u0ba8\u0bbf\u0bbf\u0bb1\u0bc1\u0bb5\u0b95\u0bae\u0bcd\u201d \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1, 1959 \u0b86\u0bae\u0bcd\n\n\u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 23 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95,\n\n\u0baa\u0b9f\u0bcd\u0b9f\u0baf\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bbf\u0bbf\u0bb1\u0bc1\u0bb5\u0b95\u0b9a\u0bcd\n\n\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bcd \u0ba4\u0bbe\u0bbe\u0baa\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\n\n\u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0baa\u0b9f\u0bcd\u0b9f\u0baf\u0b95\u0bcd \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bcd\n\n\u0ba8\u0bbf\u0bbf\u0bb1\u0bc1\u0bb5\u0b95\u0bae\u0bcd \u0b8e\u0ba9\u0baa\u0bcd \u0baa\ufffd\u0bca\u0bb0\u0bc1\u0bb3\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd;\u201d.\n\n\u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bcd\u0bae\u0bae\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0bb5\u0bbe\u0b95\u0bcd\u0bcd\u0b95\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd 55 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0ba4\u0bb2\u0bcd\n\n5\n\n10\n\n15\n\n20\n\n25\n\n20\u0ba4\u0bc7\u0b9a\u0bbf\u0baf \u0b95\u0ba3\u0b95\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0baf\u0bcd\u0bb5\u0bc1 (\u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0bcd\u0ba4\u0bae\u0bcd)\u0ba4\u0bc7\u0b9a\u0bbf\u0baf \u0b95\u0ba3\u0b95\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0baf\u0bcd\u0bb5\u0bc1 (\u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0bcd\u0ba4\u0bae\u0bcd)\n\n1616. \u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b9a\u0bbf\u0bbf\u0b99\u0bcd\u0b95\u0bb3, \u0ba4\u0bae\u0bbf\u0bbf\u0bb4\u0bcd \u0b89\u0bb0\u0bc8\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0b9f\u0bc8\u0bc8\u0baf\ufffd \u0b8f\u0ba4\u0bc7\u0bc7\u0ba9\u0bc1\u0bae\u0bcd \u0b92\u0bb5\u0bcd\u0bb5\u0bbe\u0bbe\u0bae\u0bc8\u0bc8 \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0baa\u0b9f\u0bcd\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd \u0b9a\u0bbf\u0bbf\u0b99\u0bcd\u0b95\u0bb3 \u0b89\u0bb0\u0bc8\u0bc8\u0baf\ufffd \u0bae\ufffd\u0bb2\ufffd\u0bcb\u0b99\u0bcd\u0b95\u0bbf\u0bbf \u0ba8\u0bbf\u0bbf\u0bb1\u0bcd\u0bb1\u0bb2\u0bcd \u0bb5\ufffd\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\n\n\u0b92\u0bb5\u0bcd\u0bcd\u0bb5\u0bb5\u0bbe\u0bae\u0bc8 \u0b8f\u0bb1\u0bcd\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0b9f\u0baf\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0bb2\u0bcd \u0b9a\u0bbf\u0b99\u0bcd\u0bcd\u0b95\u0bb3 \u0b89\u0bb0\u0bc8 \u0bae\u0bc7\u0bb2\ufffd\u0bcb\u0b99\u0bcd\u0bcd\u0b95\u0b95\u0bbf \u0ba8\u0bbf\u0bb1\u0bcd\u0bcd\u0bb1\u0bb2\u0bcd\n\n21\u0ba4\u0bc7\u0b9a\u0bbf\u0baf \u0b95\u0ba3\u0b95\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0baf\u0bcd\u0bb5\u0bc1 (\u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0bcd\u0ba4\u0bae\u0bcd)\u0ba4\u0bc7\u0b9a\u0bbf\u0baf \u0b95\u0ba3\u0b95\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0baf\u0bcd\u0bb5\u0bc1 (\u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0bcd\u0ba4\u0bae\u0bcd)\n\n\u0b87\u0bb2\u0b99\u0bcd\u0bcd\u0b95\u0b95\u0bc8 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0bcd\u0b95 \u0b85\u0b9a\u0bcd\u0b9a\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0ba3\u0bc8\u0b95\u0bcd\u0bcd\u0b95\u0bb3\u0bae\u0bcd."
