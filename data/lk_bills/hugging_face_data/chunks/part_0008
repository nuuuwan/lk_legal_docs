u0b9f\u0b9f\u0bbe\u0bb3\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb2\u0bcd\u0bcd\u0bb2\u0ba4\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0bae\u0bc1\u0bb1\u0bc8\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0ba8\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0ba4\u0bbf\u0baf\u0bc1\u0bb0\u0bc8\u0baf\u0bb3\u0bbf\u0ba4\u0bcd\u0bcd\u0ba4\u0bb2\u0bcd;\u201d; \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd\n\n(\u0b87) \u0b85\u0ba4\u0ba9\u0bcd (\u0b89) \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0baa\u0ba8\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd, \u201c\u0ba4\u0bb0\u0bb5\u0bc1\u0baa\u0bcd \u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bc1\u0ba4\u0bcd \u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0bcd\u0baa\u0baa\u0bbe\u0ba9\u201d \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\ufffd\u0bca\u0bb1\u0bcd \u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bb2\u0bbe\u0b95 \u201c\u0ba4\u0ba9\u0bbf\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f \u0ba4\u0bb0\u0bb5\u0bc1\u0baa\u0bcd \u0baa\u0bbe\u0ba4\u0bc1 \u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bc1\u0ba4\u0bcd \u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0bcd\u0baa\u0baa\u0bbe\u0ba9\u201d \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\ufffd\u0bca\u0bb1\u0bcd\u0bcd\u0b95\u0bb3\u0bc8 \u0b87\u0b9f\u0bc1\u0bb5\u0ba4\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bc1\u0bae\u0bcd. 8.8. \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bcd\u0bae\u0bae\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0bb5\u0bbe\u0b95\u0bcd\u0bcd\u0b95\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd 24 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bc1 \u0b87\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbe\u0bb2\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bbe\u0bb1\u0bc1 \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0bcd\u0ba4\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bcd\u0bb1\u0ba4\u0bc1:-\n\n(1) \u0b85\u0ba4\u0ba9\u0bcd (3) \u0b86\u0bae\u0bcd \u0b89\u0b9f\u0bcd\u0bcd\u0baa\u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bbf\u0bb2\u