ba4\u0bcd \u0ba4\u0722\u0bcb\u0bcd\u0ba4\u0bb2\u0bcd\u0bcd\u0b95\u0bb3\u0bcd (\u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0bcd\u0ba4\u0bae\u0bcd)\u0bae\u0bbe\u0b95\u0bbe\u0ba3 \u0b9a\u0baa\u0bc8\u0ba4\u0bcd \u0ba4\u0722\u0bcb\u0bcd\u0ba4\u0bb2\u0bcd\u0bcd\u0b95\u0bb3\u0bcd (\u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0bcd\u0ba4\u0bae\u0bcd)\n\n5\n\n10\n\n15\n\n20\n\n\u0b9a\u0bc1\u0bb0\u0bc1\u0b95\u0bcd\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0bc6\u0baf\u0bb0\u0bcd\n\n1988 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 2 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0ba4\u0bb2\u0bcd\n\n\u0b92\u0bb5\u0bcd\u0bcd\u0bb5\u0bb5\u0bbe\u0bae\u0bc8 \u0b8f\u0bb1\u0bcd\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0b9f\u0baf\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0bb2\u0bcd \u0b9a\u0bbf\u0b99\u0bcd\u0bcd\u0b95\u0bb3 \u0b89\u0bb0\u0bc8 \u0bae\u0bc7\u0bb2\ufffd\u0bcb\u0b99\u0bcd\u0bcd\u0b95\u0b95\u0bbf \u0ba8\u0bbf\u0bb1\u0bcd\u0bcd\u0bb1\u0bb2\u0bcd\n\n1988 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 2 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95, \u0bae\u0bbe\u0b95\u0bbe\u0ba3 \u0b9a\u0baa\u0bc8\u0ba4\u0bcd 1988 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 2 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95, \u0bae\u0bbe\u0b95\u0bbe\u0ba3 \u0b9a\u0baa\u0bc8\u0ba4\u0bcd\n\n\u0ba4\u0722\u0bcb\u0bcd\u0ba4\u0bb2\u0bcd\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0ba9\u0ba4\u0722\u0bca\u0bb0\u0bc1 \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0bae\u0bcd\u0ba4\u0722\u0bcb\u0bcd\u0ba4\u0bb2\u0bcd\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b