    "chunk_text": "(2) (3) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae\u0dc0 \u0dc3\u0db8\u0dae \u0d9a\u0dbb\u0dab\u0dba\u00fa \u0d85\u0dad\u0dbb\u01b1\u0dbb \u01cf (1) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u0dba\u023c \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0dba\u023c \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u026a\u0286\u01e6 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0286\u0dba\u0265 \u0db4 \u0261\u0d9a\u0dcf\u0dc1 \u0d85\u0d9c\u01af \u0dbb\u028f\u0dad\u0dc0 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb, \u0d85\u0db1\u0dcf\u0dc0\u0dbb\u0dab\u0dba \u00fb\u025d\u0db8, \u01e8\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u01e7\u0dba\u0db8 \u0d9a\u0dbb \u0d87\u01af \u026a\u0da7 \u0dd9\u0dc4\u02a4 \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0119\u026a\u0288\u0db8 \u0d9a \u0261\u0dd2\u0dba\u0dcf\u01ae\u0db8\u0d9a \u00fb\u025d\u0dd9\u023c \u0dd9\u0dc4\u02a4 \u0db6\u0dbd\u0dcf\u01ae\u0db8\u0d9a \u00fb\u025d\u0dd9\u023c \u0d9a\u0dcf\u0259\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc4\u02a4 \u023d\u0dc3, \u0dba\u023c \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dba\u0d9a \u01cf \u0dd9\u0dc4\u02a4 \u0dba\u023c \u0dd9\u0229\u025e\u023c\u0d9a\u0dbb\u0dab\u0dba\u0d9a \u01cf \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u0d86\u0dbb\u0dcf\u026c\u0262 \u026a\u0dc3\u01fe\u0dd9\u023c \u0d9a \u0261\u0dd2\u0dba\u0dcf\u0dc0\u0263\u0dba\u0d9a \u01cf \u0dc3\u0dcf\u00fa\u027f \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0d86\u0dd9\u0269\u0dc1\u0255 \u0dd9\u0db1\u02a3\u026a\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb, \u0d92 \u0d85\u01e9\u0dc0 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba\u0d9a \u00fb\u0286\u01ff \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u00fa \u026a\u0286\u01e6 \u0d91\u0dc0\u0dd0\u01e7 \u0dba\u023c \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0dba\u023c \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dba\u0d9a \u01cf, \u0dd9\u0229\u025e\u023c\u0d9a\u0dbb\u0dab \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u0d9a \u0261\u0dd2\u0dba\u0dcf\u0dc0\u0263\u0dba\u0d9a \u01cf \u0dc3\u0dcf\u00fa\u027f \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0d89\u01ce\u025c\u0db4\u01ae \u00fb\u025d\u0db8\u0da7 \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1 \u0d85\u0dad\u0dbb \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dba, \u0dd9\u0229\u025e\u023c\u0d9a\u0dbb\u0dab \u026a\u01e7\u0dc1\u0dca\u0da0\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dba\u00fa \u026a\u0286\u01e6 \u0d92 \u0d9a\u0dcf\u0dbb\u0dab\u0dcf \u0dc3\u0dd0\u0dc5\u00fb\u0262\u0dbd\u0da7 \u0dd9\u0db1\u02a3\u0d9c\u0dad \u0252\u01b1 \u0dba.\n\n5\n\n10\n\n15\n\n20\n\n25\n\n11\u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab (\u0286\u026a\u0262 \u0dc3\u0dc4 \u0dc0\u0dcf\u019d\u0da2 \u0d86\u0dbb\u0dcf\u026c\u0262)\n\n(4) \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dd9\u024f \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u01e6, \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u0dc3\u0db4\u0dba\u01e6\u0db1\u0dcf \u0dc3\u0dc4 \u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf \u0d87\u01b1\u029a\u0dc0 \u00fb\u0286\u01ff \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u026a\u0286\u01e6 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab \u0d9a\u0da7\u0252\u01b1 \u0dd9\u0db4\u02a5\u01ca\u0d9c\u0263\u0d9a\u0dc0 \u0dd9\u0dc4\u02a4 \u0d85\u0dad\u01ae\u0dae\u0255 \u0dd9\u0dbd\u0dc3 \u0dd9\u0dc4\u02a4 \u0db4\u0dd0\u0dc0\u0dd0\u01ae\u026d\u0dc0 \u0daf, \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab \u0d9a\u0da7\u0252\u01b1\u0dc0\u0dbd \u0dc1 \u0261\u0dc0\u0255 \u0dd9\u0dc4\u02a4 \u0daf\u0dd8\u0dc1\u0255 \u0db4\u0179\u0d9c\u0dad \u00fb\u025d\u0db8\u00fa \u0286\u01d0 \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1 \u0dba.\n\n17. \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbd \u01cf \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba\u00fa \u0d85\u0dc0\u0dc3\u01e6 \u0d9a\u0dc5 \u0252\u01b1 \u00d3-\n\n(\u0d85) \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u01e6 \u026a\u0286\u01e6 \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0119\u026a\u0288\u0db8\u00fa \u0d85\u01ae\u0dc3\u01e6 \u0d9a\u0dbb \u0d87\u01af \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a \u01cf; \u0dd9\u0dc4\u02a4\n\n(\u0d86) \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0dba\u023c \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u01e9\u0d9c\u0dad \u0d9a\u025e\u019f\u0dc0\u0dbd \u01cf \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0db8\u00fb\u01e6 \u0dd9\u0dad\u02a3\u0dbb\u0dc0 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba \u0d85\u0dc0\u0dc3\u01e6 \u0d9a\u0dc5 \u0db6\u0dc0\u0da7 \u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0db4 \u0261\u0d9a\u0dcf\u0dc1\u0dba\u00fa \u0286\u01d0 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a \u01cf -\n\n(i) \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dd9\u024f \u0db4 \u0261\u0d9c\u01af\u0dba \u0dc3\u0dbd\u0d9a\u0dcf \u0db6\u0dd0\u0264\u0dd9\u023c \u01cf \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0dc0\u01d0\u0dbb\u0da7\u01ae \u0d8b\u01ae\u0dc3\u0dcf\u0dc4 \u00fb\u025d\u023c \u01e7\u0dc1\u0dca\u0db5\u0dbd \u0dc0\u01e6\u0db1\u0dcf \u026d \u0dc3\u0dc4 \u0d86\u0dbb\u0dcf\u026c\u0262 \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0db8\u00fa \u0286\u01d0\u026b\u0dd9\u023c \u0dc4\u0dd0\u00fb\u0dba\u0dcf\u0dc0\u00fa \u0dd9\u0db1\u02a3\u0db8\u0dd0\u01af \u0dc0\u01e6\u0db1\u0dcf \u026d \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a \u01cf;\n\n(ii) \u0dba\u023c \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u00fa \u026a\u0286\u01e6 \u0dad\u0db8\u01e6 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dd9\u0dba\u01e6 \u0d89\u0262\u0dbd\u0dcf \u0d85\u0dc3\u0dca\u0dc0\u0db1 \u0db6\u0dc0\u0da7 \u0263\u0110\u0dad\u0dc0 \u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0daf\u0dd0\u01e9\u023c \u0dd9\u0daf\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a \u01cf; \u0dd9\u0dc4\u02a4\n\n(iii) \u0286\u0dba\u0265 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u01e6 \u026a\u0286\u01e6 \u0d94\u026c\u01e6 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab \u0d9a\u0da7\u0252\u01b1 \u0d85\u0dc0\u0dc3\u01e6 \u00fb\u025d\u0db8\u0da7 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0db6\u0dc0\u0da7 \u0263\u0110\u0dad\u0dc0 \u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0daf\u0dd0\u01e9\u023c \u0dd9\u0daf\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a \u01cf.\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n\u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba \u0d85\u0dc0\u0dc3\u01e6 \u00fb\u025d\u0db8\n\n12\u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab (\u0286\u026a\u0262 \u0dc3\u0dc4 \u0dc0\u0dcf\u019d\u0da2 \u0d86\u0dbb\u0dcf\u026c\u0262)\n\n18. (1) \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u01e7\u0dba\u0db8\u0dba\u01e6 \u0db8\u0dad \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u01e6 \u026a\u0286\u01e6 \u0d91\u0d9a\u0d9f\u0dad\u0dcf\u0dc0\u0dba\u0d9a\u0da7 \u0d91\u0dc5\u0248 \u0d87\u01af \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a \u01cf, \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u01e6 \u026a\u0286\u01e6 \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u0db8\u028f \u01e7\u0dba\u0db8\u0dba\u01e6 \u0dc3\u0dc4 \u0d91\u0250\u01e6 \u0dc4\u0da7\u0d9c\u01e6\u0db1\u0dcf \u0db6\u0dd0\u01fd\u0dba\u0dcf\u0dc0\u01e6 \u0db4\u0dd0\u0dc4\u0dd0\u01ce\u0298\u0dc0 \u0d85\u0dc0\u0dd9\u0db6\u02a4\u0db0 \u0d9a\u0dbb \u0dd9\u0d9c\u0db1 \u0d87\u01af \u0db6\u0dc0\u0da7 \u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf \u0dc3\u0dd1\u0290\u0db8\u0da7 \u0db4\u01ae\u026b\u0dd9\u0db8\u01e6 \u0d85\u0db1\u01b1\u025e\u0dc0, \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u01e7\u0dba\u0db8\u0dba\u01e6 \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0119\u026a\u0288\u0dd9\u023c \u0263\u0110\u0dad\u0dc0 \u0daf\u00fa\u0dc0\u0dcf \u0d87\u01af \u0db6\u0dc0\u0da7 \u0dc3\u0dc4 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u01e6 \u026a\u0286\u01e6 \u0d91\u0dba \u0d85\u01ae\u0dc3\u01e6 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db6\u0dc0\u0da7 \u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf \u0dc3\u0dc4\u01af\u0d9a \u026a\u0dba \u0252\u01b1 \u0dba.\n\n(2) \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u01e6 \u026a\u0286\u01e6 \u0d91\u0dd9\u0dc3\u02a2 \u0d85\u01ae\u0dc3\u01e6 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0119\u026a\u0288\u0db8 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dd9\u024f \u0db4 \u0261\u01af\u0db5\u0dbd\u0dba\u00fa \u0dd9\u0dbd\u0dc3 \u0d87\u01af \u0d9a\u0dbb\u0d9c\u01ae \u0db6\u0dc0 \u0dc3\u0dc4\u01af\u0d9a \u0d9a\u0dbb\u023d\u01e6 \u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf \u0dd9\u0dc4\u02a4 \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u0dc3\u0db4\u0dba\u01e6\u0db1\u0dcf\u0dd9\u0118 \u0db6\u0dbd\u0dba\u0dbd\u01ae \u01e7\u0dbd\u0db0\u0dbb\u0dba\u00fd \u026a\u0286\u01e6 \u0d92 \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0119\u026a\u0288\u0db8 \u0263\u0dba\u0dcf \u0dc3\u0dc4\u01af\u0d9a \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb \u0d91\u028f \u023f\u0262 \u0218\u0da7\u0db4\u01ae \u0d91\u00fa \u0d91\u00fa \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u01e6 \u0dd9\u0dc0\u0dad \u01e7\u00fd\u01ae \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0dba."
