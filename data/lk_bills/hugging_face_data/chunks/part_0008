    "chunk_text": "82\u0d89. \u0db4\u0da7\u0dc4\u0dd0\u0dd0\u0db1\u0dd2\u0dc0 \u0d94\u0db4\u0dca\u0db4\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd4\u0dc0\u0dc4\u0ddc\ufffd\u0ddc\u0dad\u0dca \u0db8\u0dd2\u0dc3, \u0d85\u0dab\u0d9a\u0dbb\u0dd4\u0d9c\u0dda\u0118 \u0dba\u0db8\u0dca \u0dab\u0dba\u0d9a\u0dca \u0dc4\u0ddd\ufffd\u0ddd \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0db6\u0dd0\u0dd0\u0db3\u0dd3\u0db8\u0d9a\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db8 \u0dc4\u0ddd\ufffd\u0ddd \u0d89\u0db1\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf, \u0da0\u0dd9\u0dd9\u0d9a\u0dca\u0db4\u0dad\u0dda\ufffd \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0d9a\u0dba\u0dcf\u0dcf \u0dc4\u0ddd\ufffd\u0ddd \u0dba\u0dae\u0dcf\u0dcf \u0d9a\u0dcf\u0dcf\u0dbd \u0db0\u0dcf\u0dcf\u0dbb\u0d9a\u0dba\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0da0\u0dd9\u0dd9\u0d9a\u0dca\u0db4\u0dad \u0dbd\u0dd0\u0dd0\u0db6\u0dd4\u0dab\u0dd4 \u0db6\u0dc0\u0da7 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0db1\u0dd2\u0d9c\u0db8\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n\u0d85\u0d9c\u0dbb\u0dd4 \u0dc0\u0dd6 \u0da0\u0dd9\u0dd9\u0d9a\u0dca\u0db4\u0dad\u0d9a \u0dad\u0dd3\u0dbb\u0dab\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc3\u0dcf\u0dcf\u0d9a\u0dca\u0dc2\u0dd2.\n\n\u0da0\u0dd9\u0dd9\u0d9a\u0dca\u0db4\u0dad\u0dda\ufffd \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0d9a\u0dba\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dc4\u0ddd\ufffd\u0ddd \u0dba\u0dae\u0dcf\u0dcf \u0d9a\u0dcf\u0dcf\u0dbd \u0db0\u0dcf\u0dcf\u0dbb\u0d9a\u0dba\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dc0\u0dcf\u0dcf\u0dc3\u0dd2\u0dba\u0da7 \u0dc0\u0db1 \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0db1\u0dd2\u0d9c\u0db8\u0db1\u0dba.\n\n82\u0d8a. \u0db8\u0dda\u023c \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad \u0dba\u0da7\u0dad\u0dda\ufffd \u0dc0\u0dd6 \u0dc0\u0dbb\u0daf\u0d9a\u0da7 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0d9a\u0dca \u0dc0\u0dbb\u0daf\u0d9a\u0dbb\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6 \u0d87\u0dad\u0dd2 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0d9a \u0daf\u0dd3-\n\n(\u0d85) \u0d92 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0d9a\u0dca \u0dc0\u0dda\u0dda \u0db1\u0db8\u0dca, \u0d92 \u0dc0\u0dbb\u0daf \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0daf\u0dd3 \u0d92 \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0dc3\u0dd2\u0da7\u0dd2 \u0dc3\u0dd1\u0dd1\u0db8 \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2\u0dc0\u0dbb\u0dba\u0d9a\u0dd4 \u0db8, \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dd4\u0dc0\u0d9a\u0dd4 \u0db8 \u0dc4\u0ddd\ufffd\u0ddd \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dba\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db8;\n\n(\u0d86) \u0d92 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc4\u0dc0\u0dd4\u0dbd\u0dca \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dba\u0d9a\u0dca\n\n\u0dc0\u0dda\u0dda \u0db1\u0db8\u0dca, \u0d92 \u0dc0\u0dbb\u0daf \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0daf\u0dd3 \u0d92 \u0dc4\u0dc0\u0dd4\u0dbd\u0dca \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dba\u0dda\u024f \u0dc3\u0dd2\u0da7\u0dd2 \u0dc3\u0dd1\u0dd1\u0db8 \u0dc4\u0dc0\u0dd4\u0dbd\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db8; \u0dc3\u0dc4\n\n(\u0d87) \u0d92 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0db1\u0ddc\ufffd\u0ddc\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0d9a\u0dca \u0dc0\u0dda\u0dda \u0db1\u0db8\u0dca, \u0d92 \u0dc0\u0dbb\u0daf \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0daf\u0dd3 \u0d92 \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0db1\u0ddc\ufffd\u0ddc\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0d9a\u0dd4 \u0dc0\u0dd6 \u0dc3\u0dd1\u0dd1\u0db8 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db8,\n\n\u0d91\u0db8 \u0dc0\u0dbb\u0daf \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6 \u0d87\u0dad\u0dd2 \u0dbd\u0dd9\ufffd\u0dc3\u0da7 \u0dc3\u0dbd\u0d9a\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba:\n\n\u0d91\u0dc3\u0dda\ufffd\u0dda \u0dc0\u0dd4\u0dc0 \u0daf, \u0d92 \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0dba\u0db8\u0dca \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2\u0dc0\u0dbb\u0dba\u0d9a\u0dd4, \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dd4\u0dc0\u0d9a\u0dd4 \u0dc4\u0ddd\ufffd\u0ddd \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dba\u0d9a\u0dd4 \u0dc4\u0ddd\ufffd\u0ddd \u0d92 \u0dc4\u0dc0\u0dd4\u0dbd\u0dca \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dba\u0dda\u024f \u0dba\u0db8\u0dca \u0dc4\u0dc0\u0dd4\u0dbd\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0d9a\u0dd4 \u0dc4\u0ddd\ufffd\u0ddd \u0d92 \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0db1\u0ddc\ufffd\u0ddc\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0dba\u0db8\u0dca \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca, \u0d92 \u0dc0\u0dbb\u0daf \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6 \u0d87\u0dad\u0dca\u0dad\u0dda\ufffd \u0d94\u0dc4\u0dd4\u0d9c\u0dda\u0118 \u0daf\u0dd0\u0dd0\u0db1\u0dd4\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0dad\u0ddc\ufffd\u0ddc\u0dbb\u0dc0 \u0db6\u0dc0\u0da7 \u0dc4\u0ddd\ufffd\u0ddd \u0d92 \u0dc0\u0dbb\u0daf \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dd0\u0dd0\u0dc5\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d94\u0dc4\u0dd4 \u0db1\u0dd2\u0dc3\u0dd2 \u0d8b\u0daf\u0dca\u0dba\u0ddd\ufffd\u0ddd\u0d9c\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db6\u0dc0\u0da7 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0dc3\u0dd1\u0dd1\u0dc4\u0dd3\u0db8\u0da7 \u0db4\u0dad\u0dca \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d94\u0db4\u0dca\u0db4\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dda\ufffd \u0db1\u0db8\u0dca, \u0d94\u0dc4\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d92 \u0dc0\u0dbb\u0daf \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dbd\u0dd9\ufffd\u0dc3\u0da7 \u0dc3\u0dbd\u0d9a\u0db1\u0dd4 \u0db1\u0ddc\ufffd\u0ddc\u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\u201d.\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n\u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc0\u0dd0\u0dd0\u0dbb\u0daf\u0dd2.\n\n12\u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba \u0db4\u0dad\u0dca\u200d\u0dbb (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u0db0\u0db1)\u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba \u0db4\u0dad\u0dca\u200d\u0dbb (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u0db0\u0db1)\n\n17. \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f 83 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba, \u0d91\u0dc4\u0dd2 \u201c\u0db8\u0dda\u023c \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf\u201d \u0dba\u0db1 \u0dc0\u0da0\u0db1\u0dc0\u0dbd \u0dc3\u0dd2\u0da7 \u0d91\u0db8 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0d85\u0dc0\u0dc3\u0dcf\u0dcf\u0db1\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dc0\u0da0\u0db1 \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\ufffd.\n\n18. \u0db8\u0dda\u023c \u0db4\u0db1\u0dad\u0dda\ufffd \u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbd \u0dc3\u0dc4 \u0daf\u0dd9\u0dd9\u0db8\u0dc5 \u0db7\u0dcf\u0dcf\u0dc2\u0dcf\u0dcf \u0db4\u0dcf\u0dcf\u0da8 \u0d85\u0dad\u0dbb \u0dba\u0db8\u0dca \u0d85\u0db1\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dad\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc0\u0dd4\u0dc0\u0dc4\u0ddc\ufffd\u0ddc\u0dad\u0dca, \u0d91\u0dc0\u0dd2\u0da7, \u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbd \u0db7\u0dcf\u0dcf\u0dc2\u0dcf\u0dcf \u0db4\u0dcf\u0dcf\u0da8\u0dba \u0db6\u0dbd\u0db4\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\n\n5\n\n\u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f 83 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\n\n\u0d85\u0db1\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dad\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc0\u0dd6 \u0dc0\u0dd2\u0da7 \u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbd \u0db7\u0dcf\u0dcf\u0dc2\u0dcf\u0dcf \u0db4\u0dcf\u0dcf\u0da8\u0dba \u0db6\u0dbd\u0db4\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dbb\u0da2\u0dba\u0dda\u0