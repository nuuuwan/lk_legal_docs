4\u0db1\u0dad\u0dda\ufffd 3 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d91\u0db8 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0dd1\u0db8 \u0dc0\u0db1\u0dd4\u0dba\u0dda\u024f, 2025 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dc3 31 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0db6\u0dbd\u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d85\u0dba\u0dc0\u0dd0\u0dd0\u0dba \u0dc3\u0dc4\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf\u0dc0 \u0d9c\u0dd9\ufffd\u0dc0\u0dd3\u0db8 \u0db1\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0dba.\n\n1\u0dc3\u0dda\u02e6\u0dda\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0d85\u0dba\u0dc0\u0dd0\u0dd0\u0dba \u0dc3\u0dc4\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u0db0\u0db1)\u0dc3\u0dda\u02e6\u0dda\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0d85\u0dba\u0dc0\u0dd0\u0dd0\u0dba \u0dc3\u0dc4\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u0db0\u0db1)\n\n5\n\n10\n\n15\n\n\u0dbd\u0dd4\u0dc4\u0dd4\u0dac\u0dd4 \u0db1\u0dcf\u0dcf\u0db8\u0dba\u0dc3\u0dc4\u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1\u0daf\u0dd2\u0db1\u0dba\n\n2005 \u0d85\u0d82\u0d82\u0d9a 36\u0daf\u0dbb\u0db1 \u0db4\u0db1\u0dad\u0dda\ufffd3 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0db1\u0dba\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\n\n\u0d85\u0db1\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dad\u0dcf\u0dcf\u0dc0\u0d9a\u0dca\u0d87\u0dad\u0dd2 \u0dc0\u0dd6 \u0dc0\u0dd2\u0da7\u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbd \u0db7\u0dcf\u0dcf\u0dc2\u0dcf\u0dcf\u0db4\u0dcf\u0dcf\u0da8\