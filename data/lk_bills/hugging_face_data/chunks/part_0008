\u0dd9\u024f \u0dad\u01e7 \u0dd9\u0d9a\u0dcf\u0da7\u0dc3\u0dca \u028f\u023d\u0dba\u00fd \u0dc3\u0db8\u0d9f \u0dc3\u0db8\u0dcf\u0d9c\u0db8\u00fa \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0d9c\u0dad \u00fb\u025d\u0db8 \u0dd9\u0269.\n\n3 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba : \u0dd9\u023c \u0dc0\u0d9c\u01e6\u01af\u0dba \u0db8\u0119\u01e6 \u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dd9\u024f 11 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u01dd\u0dad \u0db4\u025c\u01ce \u026d \u0d91\u0db8 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u01e8\u01af\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0db8 \u0dc0\u01e9\u0dd9\u024f, \u0dc3\u0dca\u0dc0\u00fc\u0dba \u0db1\u0dcf\u0db8\u0dba \u0dd9\u0dc0\u0db1\u0dc3\u0dca \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0d9a \u01cf, \u0d92 \u0db6\u0dc0 \u0db8\u0dc4\u0da2\u0db1\u0dba\u0dcf \u0dd9\u0dc0\u0dad \u0daf\u0dd0\u01e9\u023c \u01cf\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0d9a\u0dcf\u0dbd \u0287\u0db8\u0dcf \u01cf\u0259\u0d9d \u00fb\u025d\u0db8 \u0dd9\u0269.\n\n4 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba : \u0dd9\u023c \u0dc0\u0d9c\u01e6\u01af\u0dba \u0db8\u0119\u01e6 \u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dd9\u024f 51 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u01dd\u0dad \u0db4\u025c\u01ce \u026d \u0d91\u0db8 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u01e8\u01af\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0db8 \u0dc0\u01e9\u0dd9\u024f, \u0db7\u0dcf\u0dbb\u0d9a \u0dc3\u0db3\u0dc4\u0dcf \u026d \u0dd9\u0d9a\u0dcf\u0da7\u0dc3\u0dca \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0dd9\u0dc4\u0dcf\u0dca \u0db7\u0dcf\u0dbb\u0d9a \u0dd9\u0d9a\u0dcf\u0da7\u0dc3\u0dca \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u01e7\u00fd\u01ae \u00fb\u025d\u0db8 \u0dad\u0dc4\u0db1\u023c \u00fb\u025d\u0db8 \u0dd9\u0269.\n\n5 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba : \u0dd9\u023c \u0dc0\u0d9c\u01e6\u01af\u0dba \u0db8\u0119\u01e6 \u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dba\u0da7 \u0d85\u0265\u01ae 51\u0d85 \u0dc0\u0d9c\u01e6\u01af\u0dba\u00fa \u0d87\u01b1\u0dc5\u01ae \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0d85\u0265\u01ae \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u01e8\u01af\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0db8 \u0dc0\u01e9\u0dd9\u024f, \u0dc4\u0dcf\u0dbb\u0d9a \u0dc3\u0db3\u0dc4\u0dcf \u026d \u0dd9\u0d9a\u0dcf\u0da7\u0dc3\u0dca \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0dd9\u0dc4\u0dcf\u0dca \u0dc4\u0dcf\u0dbb\u0d9a \u0dd9\u0d9a\u0dcf\u0da7\u0dc3\u0dca \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0218\u0298\u0db6\u0db3 \u0dd9\u0dad\u0dcf\u0dbb\u01b1\u025e \u0dd9\u023c \u0db4\u0db1\u01ae \u0dd9\u0d9a\u017b\u023c\u0db4\u0dad \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1 \u0db4\u0db1\u0dad\u00fa \u0dc0\u0db1 \u01cf\u0db1 \u0286\u0da7 \u01cf\u0db1 \u0dc4\u0dd0\u0da7\u00fa \u0d87\u01b1\u0dc5\u0dad \u0dd9\u0dc4\u0298\u0daf\u0dbb\u0269 \u00fb\u025d\u0dd9\u023c \u0dc0\u0d9c\u00fc\u0db8 \u0d91\u00fc \u0dc4\u0dcf\u0dbb\u0d9a \u0dc3\u0db3\u0dc4\u0dcf \u026d \u0dd9\u0d9a\u0dcf\u0da7\u0dc3\u0dca \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0dd9\u0dc4\u0dcf\u0dca \u0dc4\u0dcf\u0dbb\u0d9a \u0dd9\u0d9a\u0dcf\u0da7\u0dc3 \u0db6\u0dbd\u0db4\u01b4\u0dba\u00fa \u0daf\u0dbb\u01e6\u0db1\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d\u0db8 \u0dd9\u0269.\n\n6 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba : \u0dd9\u023c \u0dc0\u0d9c\u01e6\u01af\u0dba \u0db8\u0119\u01e6 \u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dd9\u024f 52 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u01dd\u0dad \u0db4\u025c\u01ce \u026d \u0d91\u0db8 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u01e8\u01af\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0db8 \u0dc0\u01e9\u0dd9\u024f, \u0dd9\u0d9a\u0dcf\u0da7\u0dc3\u0dca \u026a\u0db7\u0da2\u0db1\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d9a\u0dcf\u0dbd \u0287\u0db8\u0dcf\u0dc0\u0dbd\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u00fb\u025d\u0db8 \u0dd9\u0269"
