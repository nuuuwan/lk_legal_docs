\u0d89) \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0db4\u0dbb\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0dae \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0db1\u0dd2\u0dbd\u0db0\u0dbb\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0d9a\u0dba\u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dba\u0dda\u024f \u0db1\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0db8\u0dcf\u0dcf\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d9a\u0dd9\ufffd\u0dbb\u0dd9\u0dd9\u0dc4\u0dd2 \u0dc0\u0dd2\u0db1\u0dba \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dcf\u0d9c\u0dd9\ufffd\u0db1 \u0dba\u0dcf\u0dcf\u0db8 \u0dc3\u0dc4 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dc4\u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dba\u0dda\u024f \u0db1\u0dd2\u0dba\u0db8\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0d9a\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0daf\u0dda\u0dda\u0dc3\u0dd2 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8;\n\n(\u0d8a) \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0dc0\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dc0\u0dd6 \u0dba\u0db8\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0da7 \u0dc3\u0dd2\u0dad\u0db1 \u0d86\u0d9a\u0dcf\u0dcf\u0dbb\u0dba\u0dda\u024f \u0db1\u0dd2\u0dba\u0db8 \u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0dc3\u0dc4 \u0dc3\u0dd4\u0dbb\u0dd0\u0d9a\u0dd4\u0db8\u0dca \u0db8\u0dad \u0dab\u0dba\u0da7 \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8;\n\n(\u0d8b) \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dad\u0dca\u0dc0\u0dba\u0dda\u024f \u0dba\u0db8\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dda\u0279\u0dda\u0dab\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0db8\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0d91\u0d9a\u0dd3 \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8;\n\n(\u0d8c) \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc4\u0dcf\u0dcf \u0dbd\u0dd0\u0dd0\u0db6\u0dd3\u0db8\u0dda\ufffd \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0dba\u0db1 \u0db4\u0dcf\u0dcf\u0da8\u0db8\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0db1\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d9a\u0dbb\u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dd4\u0dc0\u0dd3\u0db8\u0dda\ufffd \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dad\u0dd4 \u0d85\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8;\n\n(\u0d91) \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dc4\u0dcf\u0dcf \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0db1 \u0dba\u0db8\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4 \u0dba\u0dd0\u0dd0\u0dba\u0dd2 \u0dc3\u0dbd\u0d9a\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d86\u0d9a\u0dcf\u0dcf\u0dbb\u0dba\u0da7 \u0d86\u0dba\u0ddd\ufffd\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0db7\u0dcf\u0dcf\u0dbb \u0d87\u0dad\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0dba\u0db8\u0dca \u0db6\u0dd0\u0d82\u0d82\ufffd\u0d9a\u0dd4\u0dc0\u0d9a \u0da2\u0d82\u0d82\u0d9c\u0db8 \u0dad\u0dd0\u0dd0\u0db1\u0dca\u0db4\u0dad\u0dca \u0dc4\u0ddd\ufffd\u0ddd \u0d89\u0dad\u0dd2\u0dbb\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dcf\u0d9c\u0dd9\ufffd\u0db1 \u0dba\u0dcf\u0dcf\u0db8;\n\n(\u0d92) \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd3\u0dba \u0dc3\u0dd0\u0dd0\u0dbd\u0dd0\u0dd0\u0dc3\u0dca\u0db8\u0d9a\u0dca \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dbb\u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0dc4 \u0d91\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0dc3\u0dd0\u0dd0\u0dbd\u0dd0\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8;\n\n(\u0d94) \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0dc3\u0dc4 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dd4\u0dbb\u0dd6\u0db4\u0dd3 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0dc4\u0dad\u0dd2\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8;\n\n(\u0d95) \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0db8\u0dc4\u0dcf\u0dcf \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0d9a\u0daf\u0dd3, \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0db6\u0dc4\u0dd4\u0dad\u0dbb\u0dba\u0dda\u024f \u0da1\u0db1\u0dca\u0daf\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc0\u0dbb\u0dd2\u0db1\u0dca \u0dc0\u0dbb \u0dbb\u0dd3\u0dad\u0dd2 \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dbb\u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0dc4 \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad\n\n5\n\n10\n\n15\n\n20\n\n25\n\n5\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0d86\u0dba\u0dad\u0db1\u0dba\n\n(\u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd)(\u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd)\n\n\u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc3\u0dc4 \u0d91\u0dc4\u0dd2 \u0db4\u0dbb\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0dae \u0d89\u0dc2\u0dca\u0da7 \u0d9a\u0dbb\u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dbb\u0dd3\u0dad\u0dd2 \u0dc3\u0dd1\u0dd1\u0daf\u0dd3\u0db8; \u0dc3\u0dc4\n\n(\u0d9a) \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0db4\u0dbb\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0dae \u0db8\u0dd4\u0daf\u0dd4\u0db1\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d86\u0db1\u0dd4\u0dc2\u0d82\u0d82\u0d9c\u0dd2\u0d9a \u0dc0\u0dd6 \u0dc4\u0ddd\ufffd\u0ddd \u0dba\u0ddd\ufffd\u0ddd\u0d9c\u0dca\u200d\u0dba\u0dba \u0dc0\u0dd6 \u0db1\u0ddb\u0ddb\u0dad\u0dd2\u0d9a \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0daf\u0dda\u0dda \u0d9a\u0dd2\u0dbb\u0dd3\u0db8."
