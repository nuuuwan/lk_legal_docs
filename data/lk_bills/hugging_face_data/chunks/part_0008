    "chunk_text": "(2) 2000 \u0d85\u0d82\u0d9a 44 \u0daf\u0dbb\u0db1 \u0dc1 \u0261\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dc0\u0dcf\u019d\u0da2 \u0dc3\u0db8\u0dae \u0db8\u0db0\u0255\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0db4\u0db1\u0dad \u0d89\u0dc0\u01ae \u00fb\u025d\u0db8 \u0dd9\u0db1\u02a3\u0dad\u0d9a\u0dcf, \u0dd9\u023c \u0db4\u0db1\u0dad \u0d9a \u0261\u0dd2\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0dc0\u0db1 \u01ce\u0db1\u0dba\u0da7 \u0dd9\u0db4\u0dbb\u0dcf\u01b1\u0dc0 \u0db8 \u026d \u01ce\u0db1\u0dd9\u024f \u01cf \u0db4\u0dd0\u0dc0\u01af \u0dc1 \u0261\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dc0\u0dcf\u019d\u0da2 \u0dc3\u0db8\u0dae \u0db8\u0db0\u0255\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dd9\u024f \u0286\u0dba\u0265\u0db8 \u0dc0\u01ae\u0d9a\u023c \u0dc3\u0dc4 \u0dc0\u0d9c\u00fc\u023c \u0dd9\u023c \u0db4\u0db1\u0dad \u0d9a \u0261\u0dd2\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0dc0\u0db1 \u01ce\u0db1 \u0286\u0da7 \u0db6\u0dbd\u0dcf\u01ae\u0db8\u0d9a \u0dc0\u0db1 \u0db4\u025c\u01ce \u0dbb\u0da2\u0dba \u0dc3\u01b1 \u026a\u0dba \u0252\u01b1 \u0dba.\n\n29. \u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae -\n\n\u201c\u0263\u0110\u0dad\u0dc0\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6, \u026a\u0daf\u0256\u01ae \u0dc3\u01e6\u01e7\u0dd9\u0269\u0daf\u0db1\u0dba\u00fa \u0d87\u01b1\u029a\u0dc0 \u0dba\u023c \u0d86\u0d9a\u0dcf\u0dbb\u0dba\u00fb\u01e6 \u0dba\u023c \u0d85\u01e6\u0dad\u0259\u0d9c\u0dad\u0dba\u00fa \u0dc0\u0dcf\u0259\u0dad\u0dcf \u00fb\u025d\u0db8 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0db4\u0288\u0dc0 \u0db4\u025c\u0275\u0dbd\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d91\u028f \u0d87\u01b1\u0dc5\u01ae \u0dd9\u0dad\u02a3\u0dbb\u01b1\u025e\u0dc0\u0dbd\u0da7 \u0db4 \u0261\u0dd9\u0269\u0dc1 \u026a\u0dba \u0dc4\u0dd0\u00fb \u026a\u0dba \u0252\u01b1 \u0dba;\n\n\u201c\u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6, \u0db7\u0dcf\u026a\u0dad \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u01e6\u0db1\u0dcf \u026d \u0db4 \u0261\u0d9a\u0dcf\u0dc1\u0db1 \u0ddb\u0dc1\u0263\u0dba \u0dd9\u0dc4\u02a4 \u0d9a \u0261\u0dd2\u0dba\u0dcf\u0dc0\u0263\u0dba \u0286\u01d0 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0db4\u0daf\u0db1\u0db8 \u0dd9\u0dc4\u02a4 \u0dd9\u0db1\u02a3\u0dad\u0d9a\u0dcf \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u01e6 \u0db8\u0dad \u0d86\u0dbb\u0dcf\u026c\u0dbd\u0da7 \u026a\u0dc3\u01ff\u0db8\u00fa \u0db4\u0db1\u0dc0\u01e9 \u0dbd\u0dd0\u022b\u0dd9\u023c \u0d85\u01dd\u0d9a\u0dcf\u025c \u0db6\u0dbd\u0dba\u00fa \u0dd9\u0db1\u02a3\u0db8\u0dd0\u01af \u0db8\u0db0\u0255\u0dc3\u0dca\u0dae \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u0dd9\u0dc4\u02a4 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u01e6 (\u201c\u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf\u201d) \u0dc0\u0db1 \u0dd9\u0dad\u0dc0\u0db1 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u0d9a\u0dd9\u0118 \u0dc3\u0dc4\u0dcf\u0dba \u0d87\u01af\u0dc0 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u01e6 \u026a\u0286\u01e6 \u0d94\u026c\u01e6 \u0d85\u0dad\u0dbb \u0db4\u0dc0\u01af\u0db1 \u0d86\u0dbb\u0dcf\u026c\u0dbd \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0288\u0dc4\u0daf \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0db8\u0d9a\u0da7 \u0d91\u0dc5\u0248\u0db8\u0da7 \u0d8b\u01ae\u0dc3\u0dcf\u0dc4 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1, \u0d9a \u0261\u0dd2\u0dba\u0dcf\u0dc0\u0263\u0dba\u00fa \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dd9\u0269;\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n\u0d89\u0dc0\u01ae \u00fb\u025d\u023c \u0dc3\u0dc4 \u0d89\u01af\u025c \u00fb\u025d\u023c\n\n\u0d85\u0259\u0dae \u01e7\u025f\u0db4\u0dab\u0dba\n\n19\u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab (\u0286\u026a\u0262 \u0dc3\u0dc4 \u0dc0\u0dcf\u019d\u0da2 \u0d86\u0dbb\u0dcf\u026c\u0262)\n\n\u201c\u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u0dc3\u0db4\u0dba\u01e6\u0db1\u0dcf\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6, \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dba\u01e6 \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1\u0dba \u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u0dbd\u0db6\u0dcf\u0dd9\u0daf\u01e9 \u0dbd\u0db6\u0db1 \u0dba\u023c \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u0dd9\u0dc4\u02a4 \u0d85\u0dc3\u0dca\u01c2\u01ae\u0dc0\u0dba\u00fa \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dd9\u0269;\n\n\u201c\u0dc3\u0db8\u0dae\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf\u201d \u0dba\u01e6\u0dd9\u0db1\u01e6, \u0dba\u023c \u0d86\u0dbb\u0dcf\u026c\u0dbd\u00fa \u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab\u0dd9\u0dba\u01e6 \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u01cf \u0dc3\u0dc4\u0dcf\u0dba \u026b\u0db8\u0da7 \u0db4\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db8\u0db0\u0255\u0dc3\u0dca\u0dae \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u0dc0\u0db1 \u0dd9\u0dad\u0dc0\u0db1 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba\u00fa \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0d91\u00fa \u0dc3\u0db8\u0dae\u0d9a\u025e\u0dc0\u00fd \u0dd9\u0dc4\u02a4 \u0d91\u00fa \u0dc3\u0db8\u0dae\u0d9a\u025e\u0dc0\u00fd\u0da7 \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u018b \u0dc3\u0db8\u0dae\u0d9a\u025e\u0dc0\u01e6 \u0dc3\u0d82\u0d9b\u0255\u0dcf\u0dc0\u00fa \u0d8a\u0da7 \u0d87\u01b1\u0dc5\u01ae \u026a\u0dba \u0252\u01b1 \u0dba.\n\n30. \u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae \u0286\u0d82\u0dc4\u0dbd \u0dc3\u0dc4 \u0dd9\u0daf\u0db8\u0dc5 \u0db7\u0dcf\u0dc2\u0dcf \u0db4\u0dcf\u0da8 \u0d85\u0dad\u0dbb \u0dba\u023c \u0d85\u0db1\u01e9\u00fe\u0dbd\u0dad\u0dcf\u0dc0\u00fa \u0d87\u01af \u026c\u0dc0\u0dd9\u0dc4\u02a3\u01ae, \u0d91\u026a\u0da7, \u0286\u0d82\u0dc4\u0dbd \u0db7\u0dcf\u0dc2\u0dcf \u0db4\u0dcf\u0da8\u0dba \u0db6\u0dbd\u0db4\u0dd0\u0dc0\u0dd0\u01ae\u026a\u0dba \u0252\u01b1 \u0dba.\n\n5\n\n10\n\n\u0d85\u0db1\u01e9\u00fe\u0dbd\u0dad\u0dcf\u0dc0\u00fa \u0d87\u01af \u026d \u026a\u0da7 \u0286\u0d82\u0dc4\u0dbd \u0db7\u0dcf\u0dc2\u0dcf \u0db4\u0dcf\u0da8\u0dba \u0db6\u0dbd\u0db4\u0dd0\u0dc0\u0dd0\u01ae\u026a\u0dba \u0252\u01b1 \u0db6\u0dc0\n\n20\u0dc3\u0db8\u0dae\u0d9a\u0dbb\u0dab (\u0286\u026a\u0262 \u0dc3\u0dc4 \u0dc0\u0dcf\u019d\u0da2 \u0d86\u0dbb\u0dcf\u026c\u0262)\n\n\u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba\n\n[3 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba]\n\n1. \u026a\u0dc0\u0dcf\u0dc4\u0dba \u0d85\u0dc0\u0dbd\u0d82\u011b \u00fb\u025d\u0db8\u00fa \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d86\u0dbb\u0dcf\u026c\u0262.\n\n2. \u026a\u0dc0\u0dcf\u0dc4 \u0276\u0db1\u0255\u0dad\u0dcf\u0dc0 \u0db4 \u0261\u0d9a\u0dcf\u0dc1 \u00fb\u025d\u0db8\u00fa \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d86\u0dbb\u0dcf\u026c\u0262.\n\n3. \u0286\u028f\u026a\u0d9a\u0dbd, \u0db6\u0dcf\u0dbd\u0dc0\u0dba\u0dc3\u0dca\u0d9a\u0dcf\u0dbb \u0dc3\u0dc4 \u0dbb\u00fa\u027f\u0dad \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u01e6\u0da7 \u0dc3\u0dc4 \u0d91\u0db8 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u01e6\u0dd9\u0118 \u022d\u0daf\u0262\u0dc0\u0dbd\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d86\u0dbb\u0dcf\u026c\u0262.\n\n4. \u0db7\u0dcf\u0dbb\u0d9a\u025e\u0dc0\u01e6\u0da7, \u0dd9\u01ca\u0db4\u0dc5 \u0d86\u0dbb\u00fa\u0dc2\u0d9a\u0dba\u01e6\u0da7 \u0dc3\u0dc4 \u0dd9\u01ca\u0db4\u0dc5 \u0db7\u0dcf\u0dbb\u0d9c\u01e6\u0db1\u01e6\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d86\u0dbb\u0dcf\u026c\u0262.\n\n5. \u0daf\u025e\u0d9a\u0db8\u0da7 \u0dc4\u0daf\u0dcf\u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d86\u0dbb\u0dcf\u026c\u0262.\n\n6. \u0d8b\u0db4\u01ae \u0dc3\u0dc4 \u0db8\u0dbb\u0dab \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u00fb\u025d\u0db8\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d86\u0dbb\u0dcf\u026c\u0262.\n\n7. \u0286\u0dba\u0265 \u0dd9\u0daf\u0db1\u0dcf\u0db8 \u0db6\u0dd0\u0dd9\u0db3\u0db1 \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u01e7\u0dc1\u0dca\u0da0\u0dbd \u0dd9\u01ca\u0db4\u0dc5 \u0dd9\u0db6\u01cf\u0db8\u00fa \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d86\u0dbb\u0dcf\u026c\u0262.\n\n8. \u0dd9\u021d\u02a3\u0dd9\u0229\u0178 \u0db6\u0dbd\u0db4\u0dad \u0261 \u0dc3\u0dc4 \u0d85\u01ca\u023d\u01e7\u0dc3\u0dca\u0dad \u0261\u0dcf\u0286 \u0db6\u0dbd\u0db4\u0dad \u0261 \u01e7\u00fd\u01ae \u00fb\u025d\u0db8\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d86\u0dbb\u0dcf\u026c\u0262.\n\n9. \u0dc0\u0dc3\u0dca\u01b1\u0db7\u0d82\u0d9c\u01ae\u0dc0 \u0d86\u0da5\u0dcf\u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u01ae \u0dc3\u0dc4\u0db1 \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d86\u0dbb\u0dcf\u026c\u0262.\n\n10. \u0286\u0dba\u0265 \u0dd9\u0daf\u0db1\u0dcf\u0db8 \u0db6\u0dd0\u0dd9\u0db3\u0db1 \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c\u0dc0\u0dbd\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d85\u01ca\u023d\u0dbb\u0dcf\u0262\u01af \u0d9a\u0dcf\u0dbb\u0dab\u0dcf\u0dc0\u0dbd\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d86\u0dbb\u0dcf\u026c\u0262.\n\n11. \u026a\u0db0\u0dcf\u0dba\u0d9a \u0dd9\u0dc4\u02a4 \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1 \u0101\u0dba\u0dcf\u0dc0\u00fa \u0db8\u0119\u01e6 \u0240\u0263\u0d9a \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u023c \u0d9a\u0da9\u026b\u0db8\u00fa \u0286\u01d0 \u026d \u0db6\u0dc0\u0da7 \u0dd9\u0da0\u02a4\u0daf\u0db1\u0dcf \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d86\u0dbb\u0dcf\u026c\u0262\n\n\u0dbb\u0da2\u0dd9\u024f \u023f\u01d6\u0dab \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dc0"
