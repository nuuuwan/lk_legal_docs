    "chunk_text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dad\u0dae\u0dca\u200d\u0dba\u0dba \u0daf\u0dda\u0dda\u0db4\u0dc5 \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dad\u0dae\u0dca\u200d\u0dba\u0dba \u0daf\u0dda\u0dda\u0db4\u0dc5 \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118\n\n\u0d86\u0dba\u0dad\u0db1\u0dba\u0d86\u0dba\u0dad\u0db1\u0dba\n\n\u0d86\u0dba\u0dad\u0db1\u0dba\u0dda\u024f \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd3\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd3\u0db1\u0dca \u0dc3\u0dc4 \u0dc0\u0dd2\u0db1\u0dba \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dcf\u0d9c\u0dd9\u02c3\u0db1 \u0dba\u0dcf\u0dcf\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0d9c\u0d9a\u0dd2\u0dc0 \u0dba\u0dd4\u0dad\u0dd4 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dad\u0dae\u0dca\u200d\u0dba\u0dba \u0daf\u0dda\u0dda\u0db4\u0dc5 \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0d86\u0dba\u0dad\u0db1\u0dba \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0daf; \u0dad\u0dae\u0dca\u200d\u0dba\u0dba \u0daf\u0dda\u0dda\u0db4\u0dc5 \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc0\u0db1 \u0da2\u0db1\u0dad\u0dcf\u0dcf\u0dc0\u0d9c\u0dda\u0118 \u0d8b\u0db1\u0db1\u0dca\u0daf\u0dd4\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0daf; \u0d92 \u0dc4\u0dcf\u0dcf \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0dc4\u0ddd\ufffd\u0ddd \u0d86\u0db1\u0dd4\u0dc2\u0d82\u0d82\u0d9c\u0dd2\u0d9a \u0d9a\u0dcf\u0dcf\u0dbb\u0dab\u0dcf\u0dcf \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1\n\n\u0dc3\u0dd0\u0dd0\u0dbd\u0dd0\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0daf \u0dc0\u0dd6 \u0db4\u0db1\u0dad\u0dca \u0d9a\u0dd9\ufffd\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0d9a\u0dd2\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dbb\u0da2\u0dba\u0dda\u024f \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u023c\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\n\n\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 5, \u0dbb\u0da2\u0dba\u0dda\u024f \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0db1 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0d82\u0d82\ufffd\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db8\u0dd2\u0dbd \u0daf\u0dd3 \u0dbd\u0db6\u0dcf\u0dcf\u0d9c\u0dad \u0dc4\u0dd0\u0dd0\u0d9a.\n\n\u0db8\u0dd9\u02de\u0db8 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0d85\u0dad\u0dd2\u0dbb\u0dda\u0dda\u0d9a\u0dba www.documents.gov.lk \u0dc0\u0dd9\u0dd9\u0db6\u0dca \u0d85\u0da9\u0dc0\u0dd2\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db6\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dc5 \u0dc4\u0dd0\u0dd0\u0d9a.\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\n\n2025 \u0dc3\u0dd0\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 26 \u0dc0\u0db1 \u0daf\u0dd2\u0db1\n\nII \u0dc0\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\n\n\u0d85\u0dad\u0dd2\u0dbb\u0dda\u0dda\u0d9a\u0dba\n\n(2025.10.01 \u0daf\u0dd2\u0db1 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3)\n\n\u0db8\u0dd2\u0dbd : \u0dbb\u0dd4. 144.00 \u0dad\u0dd0\u0dd0\u0db4\u0dd0\u0dd0\u0dbd\u0dca \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dad\u0dd4\u0dc0 : \u0dbb\u0dd4. 150.00\n\n\u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1, \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0dad\u0dd4\u0db8\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3\n\n1\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dad\u0dae\u0dca\u200d\u0dba\u0dba \u0daf\u0dda\u0dda\u0db4\u0dc5 \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0d86\u0dba\u0dad\u0db1\u0dba\n\n\u0d91\u0dbd\u0dca.\u0da9\u0dd3.-\u0d95 4/2024\n\n\u0d86\u0dba\u0dad\u0db1\u0dba\u0dda\u024f \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd3\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd3\u0db1\u0dca \u0dc3\u0dc4 \u0dc0\u0dd2\u0db1\u0dba \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dcf\u0d9c\u0dd9\u02c3\u0db1 \u0dba\u0dcf\u0dcf\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0d9c\u0d9a\u0dd2\u0dc0 \u0dba\u0dd4\u0dad\u0dd4 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dad\u0dae\u0dca\u200d\u0dba\u0dba \u0daf\u0dda\u0dda\u0db4\u0dc5 \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0d86\u0dba\u0dad\u0db1\u0dba \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0daf; \u0dad\u0dae\u0dca\u200d\u0dba\u0dba \u0daf\u0dda\u0dda\u0db4\u0dc5 \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc0\u0db1 \u0da2\u0db1\u0dad\u0dcf\u0dcf\u0dc0\u0d9c\u0dda\u0118 \u0d8b\u0db1\u0db1\u0dca\u0daf\u0dd4\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0daf; \u0d92 \u0dc4\u0dcf\u0dcf \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0dc4\u0ddd\ufffd\u0ddd \u0d86\u0db1\u0dd4\u0dc2\u0d82\u0d82\u0d9c\u0dd2\u0d9a \u0d9a\u0dcf\u0dcf\u0dbb\u0dab\u0dcf\u0dcf \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0dc3\u0dd0\u0dd0\u0dbd\u0dd0\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0daf \u0dc0\u0dd6 \u0db4\u0db1\u0dad\u0d9a\u0dd2.\n\n\u201c\u0daf \u0d89\u0db1\u0dca\u0dc3\u0dca\u0da7\u0dd2\u0da7\u0dd2\u0dba\u0dd4\u0da7\u0dca \u0d94\u0dc6\u0dca \u0dbb\u0dd2\u0dba\u0dbd\u0dca \u0d91\u0dc3\u0dca\u0da7\u0dda\ufffd\u0da7\u0dca \u0d87\u0db1\u0dca\u0da9\u0dca \u0dc0\u0dd0\u0dd0\u0dbd\u0dd4\u0dc0\u0dda\u0dda\u0dc2\u0db1\u0dca\u201d \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc3\u0dc4 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dca, \u0d91\u0d9a\u0dd3 \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda\u024f \u0dc3\u0dcf\u0d82\u0d82\ufffd\u0d9c\u0db8\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0da7 \u0dc3\u0dc4 \u0dc3\u0dcf\u0d82\u0d82\ufffd\u0d9c\u0db8\u0dd2\u0d9a \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dbd\u0dd2\u0dba\u0da7 \u0d85\u0db1\u0dd4\u0dc0, \u0d91\u0dc4\u0dd2 \u0d85\u0dbb\u0db8\u0dd4\u0dab\u0dd4 \u0db5\u0dbd\u0daf\u0dcf\u0dcf\u0dba\u0dd3 \u0dbd\u0dd9\ufffd\u0dc3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0dc3\u0dc4 \u0d91\u0d9a\u0dd3 \u0d86\u0dba\u0dad\u0db1\u0dba\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0d9a\u0dcf\u0dcf\u0dbb\u0dab\u0dcf\u0dcf \u0db5\u0dbd\u0daf\u0dcf\u0dcf\u0dba\u0dd3 \u0dbd\u0dd9\ufffd\u0dc3 \u0d9a\u0dbb\u0d9c\u0dd9\ufffd\u0db1 \u0dba\u0dcf\u0dcf\u0db8\u0dda\u023c \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf, 2007 \u0d85\u0d82\u0d82\u0d9a 07 \u0daf\u0dbb\u0db1 \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8\u0dca \u0db4\u0db1\u0dad \u0dba\u0da7\u0dad\u0dda\ufffd \u0db8\u0dd9\u02de\u0dad\u0dd9\ufffd\u0d9a\u0dca \u0d9a\u0dbd\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2 \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd6 \u0dc4\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0daf:"
