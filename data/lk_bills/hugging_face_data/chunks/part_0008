a\u0725\u0bca\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9 \u0ba4\u0ba9\u0bcd\u0bae\u0bc8\u0bc8;\n\n(\u0b88) \u0b87\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd, \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bbf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd\n\n\u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\ufffd\u0bb1\u0bc1 \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bbe\u0bbe\u0ba9 \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u0bbe\u0b9f\u0bc1 \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bae\u0bc1\u0bb1\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0bb5\u0b9a\u0bc1 \u0bb5\u0ba3\u0bcd\u0b9f\u0bbf\u0baf\u0bc8\u0bc8\u0baa\u0bcd \u0baa\u0bb0\ufffd\u0bae\u0bb0\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0bb5\u0bbf\u0bbf\u0ba3\u0bcd \u0ba3\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b9a\u0bae\u0bbe\u0bcd\u0bcd\u073c\u0baa\u0bcd\u0baa\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b89\u0b9f\u0ba9\u0bcd \u0ba8\u0bc7\u0bc7\u0bb0\u0bcd\u0bae\u0bc1\u0bb1\u0bcd\u0baa\u0725\u0bcb\u0ba8\u0bcd\u0ba4 \u0b86\u0bb1\u0bc1\u0bae\u0bbe\u0bbe\u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0bbe\u0bb2\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0bbf\u0baf\u0bc8\u0bc8 \u0bae\ufffd\u0bb5\u0bc1\u0b95\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1 \u0bb5\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0b95\u0bcd \u0b95\u0bc2\u0bb1\u0bcd\u0bb1\ufffd\u0bca\u0ba9\u0bcd\u0bb1\u0bbf\u0bbf\u0ba9\u0bcd \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0bae\u0bc0\u0ba4\u0bc1 \u0bb5\u0bbf\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0b95\u0bbe\u0bbe\u0bb0\u0bb0\u0bbf\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bbf\u0bb2\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0ba8\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb0\u0bcd \u0ba4\u0b95\u0bc1\u0ba4\u0bbf\u0bbf; \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd\n\n(\u0b89) \u0baa\u0ba3\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0baa\u0725\u0bca\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0b95\n\n\u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0b9f\u0bae\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0b9f \u0b93\u0b9f\u0bcd\u0b9f\u0bc1\u0ba8\u0bb0\u0bcd, \u0ba8\u0b9f\u0ba4\u0bcd\u0ba4\u0bc1\u0ba9\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0baf\u0ba3\u0bbf\u0bbf\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd \u0baa\u0725\u0bcb\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb3\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0b9a\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0725\u0bca\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9 \u0ba4\u0ba9\u0bcd\u0bae\u0bc8\u0bc8.\".\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n35\n\n\u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0baa\u0725\u0bcb\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1 \u0b86\u0ba3\u0721\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1 \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0baa\u0725\u0bcb\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1 \u0b86\u0ba3\u0721\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1\n\n(\u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd)(\u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd)8\n\n11.11. \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bae\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bb5\u0bbe\u0bbe\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd 24 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\ufffd \u0b89\u0b9f\u0ba9\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0bbf\u0bbf\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0baa\u0bc1\u0ba4\u0bbf\u0bbf\u0baf \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bb