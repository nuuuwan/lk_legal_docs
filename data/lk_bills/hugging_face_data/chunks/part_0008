    "chunk_text": "21 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba21 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba: \u0db8\u0dda\u023c \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f IV \u0dc0\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4\n\n\u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0d85\u0dbd\u0dd4\u0dad\u0dca IV \u0dc0\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dda\ufffd\u0dda (24, 25, 26, 26\u0d85, 26\u0d86, 26\u0d87, 26\u0d88 \u0dc3\u0dc4 27 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dc0\u0dbd) \u0db1\u0dd3\u0dad\u0dd2\u0dba\n\n\u0db6\u0dbd\u0db4\u0dd1\u0dd1\u0db8 \u0dc0\u0db1\u0dd4\u0dba\u0dda\u024f -\n\n\u0dbd\u0dd9\ufffd\u0dc3 \u0d9a\u0dd2\u0dba\u0dcf\u0dcf \u0dc3\u0dd2\u0da7\u0dd3\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc3\u0dc4 \u0dc0\u0dd2\u0db1\u0dba \u0db8\u0dd6\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0db7\u0dcf\u0dcf\u0d9c\u0dba\u0d9a\u0dca \u0db4\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8\n\n\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0dc0\u0db1 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0db4\u0da7\u0dd2\u0db4\u0dcf\u0dcf\u0da7\u0dd2\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0;\n\n(\u0d86) \u0d85\u0db7\u0dd2\u0dba\u0dcf\u0dcf\u0da0\u0db1\u0dcf\u0dcf \u0db8\u0dd6\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0d9a\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0d85\u0db7\u0dd2\u0dba\u0dcf\u0dcf\u0da0\u0db1\u0dcf\u0dcf \u0db8\u0dd6\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0db7\u0dd2\u0dba\u0dcf\u0dcf\u0da0\u0db1\u0dcf\u0dcf\n\n\u0dc0\u0dd2\u0db7\u0dcf\u0dcf\u0d9c \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0;\n\n(\u0d87) \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0db6\u0dda\ufffd\u0dbb\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dab \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0dc0\u0dd9\u0dd9\u0dad \u0d85\u0db7\u0dd2\u0dba\u0dcf\u0dcf\u0da0\u0db1\u0dcf\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0; \u0dc3\u0dc4\n\n(\u0d88) \u0d85\u0db7\u0dd2\u0dba\u0dcf\u0dcf\u0da0\u0db1\u0dcf\u0dcf \u0db8\u0dd6\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d9c\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dbd\u0daf \u0d85\u0dc3\u0dad\u0dd4\u0da7\u0dd4\u0daf\u0dcf\u0dcf\u0dba\u0d9a \u0dad\u0dd3\u0dbb\u0dab\u0dba\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db5\u0dbd \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0,\n\n\u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0dc3\u0dd0\u0dd0\u0dbd\u0dd0\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8 \u0dc0\u0dda\u0dda.\n\n22 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba22 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba: \u0db8\u0dda\u023c \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f 28 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4\n\n\u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d92 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0dd1\u0db8 \u0dc0\u0db1\u0dd4\u0dba\u0dda\u024f, \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u0da2\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0dba\u0dad\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba\n\n\u0db8\u0dd6\u0dbd\u0dcf\u0dcf\u0dc1\u0dca\u200d\u0dbb\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dbb\u0dd2\u0dad\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0d9c, \u0dad\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0d9c \u0dc4\u0ddd\ufffd\u0ddd \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dcf\u0db1 \u0dbd\u0db6\u0dcf\u0dcf \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dda\u023c \u0daf\u0dd3 \u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dc1 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u023c\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0dbd\u0dd2\u0d9b\u0dd2\u0dad\n\n\u0d85\u0db1\u0dd4\u0db8\u0dad\u0dba \u0dbd\u0db6\u0dcf\u0dcf \u0d9c\u0dad \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\u0da7 \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dda\u0dda.\n\n23 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba23 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba: \u0db8\u0dda\u023c \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0da7 31\u0d85 \u0dc3\u0dc4 31\u0d86 \u0dba\u0db1 \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca\n\n\u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0d91\u0dba \u0db8\u0dda\u023c \u0db4\u0db1\u0dad\u0dca \u0d9a\u0dd9\ufffd\u0da7\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dda\ufffd 16 \u0dc0\u0db1 \u0dc4\u0dcf\u0dcf 17 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f 19\n\n\u0dc0\u0db1 \u0dc4\u0dcf\u0dcf 20 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2 \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d86\u0db1\u0dd4\u0dc2\u0d82\u0d82\u0d9c\u0dd2\u0d9a \u0dc0\u0dda\u0dda.\n\n24 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba24 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba: \u0db8\u0dda\u023c \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f 33 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4\n\n\u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d92 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0dd1\u0db8 \u0dc0\u0db1\u0dd4\u0dba\u0dda\u024f, \u0dbd\u0ddd\ufffd\u0ddd\u0d9a \u0d8b\u0dad\u0dca\u0dad\u0dda\ufffd\u0da2\u0d9a \u0db8\u0dbb\u0dca\u0daf\u0db1 \u0db1\u0dd3\u0dad\u0dd2\n\n\u0dc3\u0d82\u0d82\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dba\u0dda\u024f \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dbb\u0dd3\u0dad\u0dd2 \u0dc3\u0dd1\u0dd1\u0daf\u0dd3\u0db8\u0da7 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u0da2\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0dba\u0dad\u0db1\u0dba\u0da7 \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dda\u0dda.\n\n25 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba25 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba: \u0db8\u0dda\u023c \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f 34 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4\n\n\u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d92 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0dd1\u0db8 \u0dc0\u0db1\u0dd4\u0dba\u0dda\u024f, \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0dc3\u0dcf\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0dba\u0db8\u0dca\n\n\u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u0d9c\u0dba\u0d9a\u0dca, \u0d91\u0dba \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0daf\u0dd2\u0db1 \u0d85\u0db1\u0dd6\u0dc0\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u023c\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc0\u0dd9\u0dd9\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\n\n\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0da7 \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dda\u0dda.\n\n26 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba26 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba: \u0db8\u0dda\u023c \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f 36 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4"
  },
