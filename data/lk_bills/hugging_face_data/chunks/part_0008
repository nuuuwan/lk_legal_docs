9f\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bc8\u0ba4\u0bcd\n\n\u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0ba9\u0ba4\u0722\u0bca\u0bb0\u0bc1 \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0bae\u0bc2\u0bb2\u0bae\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0ba9\u0ba4\u0722\u0bca\u0bb0\u0bc1 \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0bae\u0bc2\u0bb2\u0bae\u0bcd\n\n\u0baa\u0bbe\u0bbe\u0bb0\ufffd\u0bb3\u0bc1\u0bae\u0ba9\u0bcd\u0bb1 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0ba9\u0bbe\u0bcd\u0bcd\ufffd \u0b95\ufffd\u0bcc\u0bb0\u0bb5 \u0b9a\u0bbe\u0bbe\u0ba3\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf\u0ba9\u0bcd \u0bb0\ufffd\u0b9c\u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0ba9\u0bcd \u0b87\u0bb0\ufffd\u0b9a\u0bae\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0b85\u0bb5\u0bbe\u0bcd\u0bcd\ufffd\u0b95\u0bb3\u0bbe\u0bbe\u0bb2\u0bcd\n\n2025 \u0baf\u0bc2\u0ba9\u0bcd \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 05 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf\u0ba9\u0bcd\u0bb1\u0bc1 \u0b9a\u0bae\u0bbe\u0bcd\u0bcd\ufffd\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\n\n(2025 \u200b\u0bae\u0bc7 \u0bae\u0bbe\u0ba4\u0bae\u0bcd 22 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bb1\u0bc1 \u0bb5\u0bbe\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u0bb2\u0bcd\n\n\u0bb5\ufffd\u0bcc\u0bbf\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bc1)\n\n\u0b87\u0bb2\u0b99\u0bcd\u0bcd\u0b95\u0b95\u0bc8 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0bcd\u0b95 \u0b85\u0b9a\u0bcd\u0b9a\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0ba3\u0bc8\u0b95\u0bcd\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0ba4\u0bbf\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bbf\u0b95\u0bcd\u0bcd\u0b95\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bc6\u0bb1\u0bcd\u0bcd\u0bb1\u0ba4\u0bc1\n\n\u0b95\ufffd\u0bca\u0bb4