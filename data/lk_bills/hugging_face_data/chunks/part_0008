    "chunk_text": "32.32. \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dcf\u0dc0\u0da7, \u0dc3\u0dd1\u0dd1\u0db8 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0d9a\u0db8 \u0d85\u0db4\u0dca\u200d\u0dbb\u0dda\u0dda\ufffd\u0dbd\u0dca \u0db8\u0dc3 \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d86\u0dbb\u0db8\u0dca\u0db7\u0dc0 \u0d8a\u0dc5\u0d9f \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda\u024f \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dc3 \u0dad\u0dd2\u0dc3\u0dca \u0d91\u0d9a\u0dca \u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0db1 \u0db8\u0dcf\u0dcf\u0dc3 \u0daf\u0ddc\ufffd\u0ddc\u0dc5\u0dc4\u0d9a \u0d9a\u0dcf\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dba\u0d9a\u0dca \u0dc3\u0dc4 \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0dca \u0daf, \u0dc1\u0dda\ufffd\u0dda\u0dc2 \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0dc3\u0dc4 \u0dc0\u0dd2\u0d9c\u0dab\u0d9a \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dcf\u0dc0 \u0daf \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\n\n34.34. \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dc0 \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc4\u0ddd\ufffd\u0ddd \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0dbd\u0dd9\ufffd\u0dc3 \u0db6\u0dbd\u0dba \u0daf\u0dd9\u0dd9\u0db1 \u0dbd\u0daf \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0d9a\u0dd4 \u0dc3\u0dc4 \u0dc3\