bcd\u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u1f8c\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bc8\u0bae\u0baf \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bb8\u0bcd\u0ba4\u0bae\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0bc0\u0bb0\u0bcd\u0ba4\u0bcd\u1f90\u0bc8\u0bb5\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b89\u0b9f\u0ba9\u0bcd\u0baa\u1f8a\u0b95\u0bcd\u0bc8\u0b95 \u0b92\u0ba9\u0bcd\u0bb1\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd\u0baa\u1f8a \u0b8f\u0bb1\u0bcd\u0b95\u0ba9\u0bc7\u0bb5 \u0ba4\u0bc0\u0bb0\u0bcd\u0ba4\u0bcd\u1f90\u0bc8\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3\u0ba4\u0bbe\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bb5\u0bbf\u0b9f\u0baf\u0bae\u0bcd \u0b9a\u0bae\u0bcd\u0baa\u0ba8\u0bcd\u0ba4\u0bae\u0bbe\u0b95 \u0baa\u0bbf\u0ba3\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0ba9\u0bcd\u1fa0 \u0b8e\u1fa8\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u0bb5\u0bbf\u0b9f\u0ba4\u0bcd\u1f90, \u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0bb5\u0bbf\u0b9f\u0baf\u0bae\u0bcd \u0b8f\u0bb1\u0bcd\u0b95\u0ba9\u0bc7\u0bb5 \u0ba4\u0bc0\u0bb0\u0bcd\u0ba4\u0bcd\u1f90\u0bc8\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3\u1f90 \u0b8e\u0ba9 \u0ba8\u0bbf\u0bc8\u0bb2\u0ba8\u0bbe\u0b9f\u0bcd\u1f8c\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0b9a\u0bbe\u0ba9\u0bcd\u0bc6\u0bb1\u0bbe\u0ba9\u0bcd\u0bb1\u0bbe\u0b95 \u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0ba4\u0bc0\u0bb0\u0bcd\u0ba4\u0bcd\u1f90\u0bc8\u0bb5\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b89\u0b9f\u0ba9\u0bcd\u0baa\u1f8a\u0b95\u0bcd\u0bc8\u0b95 \u0b8f\u0bb1\u0bcd\u1fa0\u0b95\u0bcd\u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bb1\u0bcd\u0baa\u0bbe\u0bb2\u0ba4\u0bbe\u0ba4\u0bb2\u0bcd \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd."
