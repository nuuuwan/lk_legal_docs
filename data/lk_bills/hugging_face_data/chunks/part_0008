    "chunk_text": "(\u0b86) \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0baf\u0bcd\u0bb5\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd \u0ba4\u0bb2\u0bc8\u0bc8\u0bae\u0bc8\u0bc8\u0baf\u0ba4\u0bbf\u0bbf\u0baa\u0ba4\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0ba9\u0bbe\u0bbe\u0bb2\u0bcd \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0bbf\u0ba4\u0baa\u0bcd\u0baa\u0bc1\u0bb0\u0bc8\u0bc8\u0b95\u0bb3\u0bc8\u0bc8\u0b95\u0bcd\n\n\u0b95\u0bb5\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\ufffd\u0bca\u0bb3\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bbf\u0bbf\u0b95\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9f\u0ba3\u0bae\ufffd\u0bca\u0ba9\u0bcd\u0bb1\u0bbe\u0bbe\u0b95 \u0bb5\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bb5\ufffd\u0ba3\u0bcd\u0b9f\u0bbf\u0baf\n\n\u0ba4\ufffd\u0bca\u0b95\u0bc8\u0bc8\u0baf\u0bc8\u0bc8 \u0bae\u0bc1\u0b9f\u0bbf\u0baa\u0bc1\u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0bbf\u0bbf\u0b95\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9f\u0ba3\u0baa\u0bcd \u0baa\u0bb0\u0bbf\u0bbf\u0b9a\u0bc0\u0bb2\u0ba3\ufffd\u0b95\u0bcd \u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bcd\n\n\u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bb3\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bbe\u0bbe\u0b95\u0bc1\u0bae\u0bcd; \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd\n\n\u0bb5\u0ba4\u0bbf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0bae\u0bbf\u0bbf\u0b95\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0b9f\u0bcd\u0b9f\u0ba3\u0baa\u0bcd \u0baa\u0bb0\u0bbf\u0bbf\u0b9a\u0bc0\u0bb2\u0ba9\ufffd\u0b95\u0bcd \u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bbf\u0bbf\u0ba9\u0bbe\u0bbe\u0bb2\u0bcd \u0b95\u0b9f\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bb5\ufffd\u0ba3\u0bcd\u0b9f\u0bbf\u0baf\n\n\u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8\u0bae\u0bc1\u0bb1\u0bc8\u0bc8\u0baf\u0bc8\u0bc8 \u0