bcd \u0b85\u0ba4\u0bcd\u0ba4\u0b95\u0bc8\u0bc8\u0baf \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0ba9\u0bb0\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0ba4\u0bb5\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bc1\u0bb1\u0bbe\u0bbe\u0ba4\u0bc6\u0bc6\u0b9e\u0bcd\u0b9a\u0bbf\u0bbf\u0baf\u0bc1\u0bb3\u0bcd\u0bb3 \u0baa\u0bbe\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0b95 \u0baa\u0ba4\u0bb5\u0bbf\u0bbf \u0bb5\u0b95\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bb5\ufffd\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\n\n2323. (1) \u0baa\ufffd\u0bb0\u0bb5\u0bc8\u0bc8 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0bbe\u0ba3\u0bcd\u0bae\u0bc8\u0bc8 \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0baa\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0ba4\u0b95\u0bc8\u0bc8\u0bae\u0bc8\u0bc8\u0baf\u0bc0\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0bc8 \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0bbf \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bb5\ufffd\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\n\n(2) \u0baa\ufffd\u0bb0\u0bb5\u0bc8\u0bc8 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0bbe\u0ba3\u0bcd\u0bae\u0bc8\u0bc8 \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0baa\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0b8e\u0bb5\u0bb0\u0bc7\u0bc7\u0ba9\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0ba9\u0bb0\u0bc8\u0bc8 \u0b85\u0b95\u0bb1\u0bcd\u0bb1\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\ufffd\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bb5\ufffd\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\n\n(3) \u0b87\u0ba4\u0ba9\u0bcd\u0b95\u0ba3\u0bcd \u0b85\u0b9f\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0baf\u0bc1\u0bb3\u0bcd\u0bb3 \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bae\u0bc8\u0bc8\u0baf, \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0bbe\u0ba3\u0bcd\u0bae\u0bc8\u0bc8 \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0baa\u0bc8\u0bc8 \u0b85\u0ba4\u0ba9\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bbf\u0bbf\u0bb2\u0bcd \u0b9a\ufffd\u0bca\u0ba8\u0bcd\u0ba4 \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8\u0bae\u0bc1\u0bb1\u0bc8\u0bc8 \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0b95\u0bc8\u0bc8\u0baf \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0baa\u0bbe\u0bbe\u0bb0 \u0b95\ufffd\u0bca\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb2\u0bcd\u0bb5\u0bbe\u0bbe\u0b99\u0bcd\u0b95\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bbe\u0bbe\u0bae\u0bcd.\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n\u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0bbe\u0ba3\u0bcd\u0bae\u0bc8\u0bc8 \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0baa\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0ba4\u0bbf\u0bbf\u0bb5\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd/ \u0b9a\u0bc6\u0bc6\u0baf\u0bb2\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd\n\n\u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0bbe\u0ba3\u0bcd\u0bae\u0bc8\u0bc8 \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0baa\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0baa\u0ba4\u0bb5\u0bbf\u0bbf \u0bb5\u0bbf\u0bbf\u0bb2\u0b95\u0bb2\u0bcd\n\n\u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0bbe\u0ba3\u0bcd\u0bae\u0bc8\u0bc8 \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0baa\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0b9f\u0bae\u0bbf\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0ba4\u0b95\u0bc8\u0bc8\u0bae\u0bc8\u0bc8 \u0baf\u0bc0\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd\n\n13\u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0bb5\u0b9a\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bcd \u0bae\u0bc1\u0b95\u0bbe\u0bbe\u0bae\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5 \u0ba8\u0bbf\u0bbf\u0bb1\u0bc1\u0bb5\u0b95\u0bae\u0bcd\u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0bb5\u0b9a\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bcd \u0bae\u0bc1\u0b95\u0bbe\u0bbe\u0bae\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5 \u0ba8\u0bbf\u0bbf\u0bb1\u0bc1\u0bb5\u0b95\u0bae\u0bcd\n\n(\u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bbf\u0ba3\u0721\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd)(\u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bbf\u0ba3\u0721\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd)"
