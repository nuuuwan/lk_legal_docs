    "chunk_text": "15\n\n20\n\n25\n\n\u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0118 \u0db4\u0dcf\u0dcf\u0dbb\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a\n\n\u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca\u0dc0\u0dbd \u0daf\u0dd3 \u0d9c\u0dab\u0db4\u0dd6\u0dbb\u0dab\u0dba\n\n\u0dba\u0db8\u0dca \u0d89\u0da9\u0db8\u0d9a\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0dc0\u0dd3 \u0dc3\u0ddd\ufffd\u0ddd\u0daf\u0dd2\u0dc3\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0db6\u0dbd\u0dad\u0dbd\n\n13\u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u200d\u200d\u0d9c\u0ddc\u02c3\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u200d\u200d\u0d9c\u0ddc\u02c3\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9f\u0dd2\u0d9f\u0dd2\u0dbd\u0dd2 \u0db4\u0dbb\u0dca\u0dba\u0dda\u024f\u0dc2\u0dab \u0d86\u0dba\u0dad\u0db1\u0dba\u0dbd\u0dd2 \u0db4\u0dbb\u0dca\u0dba\u0dda\u024f\u0dc2\u0dab \u0d86\u0dba\u0dad\u0db1\u0dba\n\n(3) \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0dcf\u0dcf \u0dc4\u0ddd\ufffd\u0ddd \u0db1\u0dd2\u0dbd\u0db0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0dc0\u0dcf\u0dcf\u0dc4\u0db1, \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0dc4\u0ddd\ufffd\u0ddd \u0d86\u0db8\u0dca\u0db4\u0db1\u0dca\u0db1 \u0dc3\u0dc4\u0dd2\u0dad\u0dc0 \u0dc4\u0ddd\ufffd\u0ddd \u0dbb\u0dc4\u0dd2\u0dad\u0dc0 \u0dba\u0db8\u0dca \u0d89\u0da9\u0db8\u0d9a\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0dc0\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dc0 \u0d91\u0db8 \u0d89\u0da9\u0db8 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dcf\u0dcf \u0d9a\u0dbb \u0dba\u0db8\u0dca \u0db4\u0dc3\u0dca \u0dc3\u0dcf\u0dcf\u0db8\u0dca\u0db4\u0dbd\u0dba\u0d9a\u0dca \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc4\u0ddd\ufffd\u0ddd \u0d91\u0db8 \u0d89\u0da9\u0db8 \u0dad\u0dd4\u0dc5 \u0dba\u0db8\u0dca \u0d87\u0d9c\u0dba\u0dd3\u0db8\u0d9a\u0dca \u0dc4\u0ddd\ufffd\u0ddd \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d9a\u0dc5 \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0dba.\n\n(4) \u0d91\u0db8 \u0d89\u0da9\u0db8\u0dda\u023c \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4 \u0dc4\u0ddd\ufffd\u0ddd \u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2\u0d9a\u0dbb\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca (1) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dc5 \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0dcf\u0dcf\u0da7 \u0dc4\u0ddd\ufffd\u0ddd \u0db1\u0dd2\u0dbd\u0db0\u0dbb\u0dba\u0dcf\u0dcf\u0da7 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dc3\u0dcf\u0dcf\u0db0\u0dcf\u0dcf\u0dbb\u0dab \u0dc3\u0dc4\u0dcf\u0dcf\u0dba \u0dbd\u0db6\u0dcf\u0dcf \u0daf\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\n\n13. (1) \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca, \u0dbd\u0dd2\u0d9b\u0dd2\u0dad\u0dc0 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d91\u0d9a\u0dd3 \u0d9a\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0daf\u0dda\u0dda\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0, 4 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f (\u0d89), (\u0d8b), (\u0d8c), (\u0d91), (\u0d92), (\u0d94), \u0dc3\u0dc4 (\u0d9a) \u0dc0\u0db1 \u0da1\u0dda\u0dda\u0daf\u0dc0\u0dbd \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0dc4\u0dd0\u0dd0\u0dbb \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0db6\u0dbd\u0dad\u0dbd \u0d9a\u0dd2\u0dc3\u0dd2\u0dc0\u0d9a\u0dca, \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0ddd\ufffd\u0ddd\u0da0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2, \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0da7, \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0da7. \u0dad\u0dcf\u0dcf\u0d9a\u0dca\u0dc2\u0dab\u0dd2\u0d9a \u0d8b\u0db4\u0daf\u0dda\u0dda\u0dc1\u0d9a \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0da7 \u0dc4\u0ddd\ufffd\u0ddd 4 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f (\u0d8b) \u0dc0\u0db1 \u0da1\u0dda\u0dda\u0daf\u0dba\u0dda\u024f \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dba\u0db8\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4\u0da7 \u0db4\u0dc0\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0d85\u0dad\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf, \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf, \u0dad\u0dcf\u0dcf\u0d9a\u0dca\u0dc2\u0dab\u0dd2\u0d9a \u0d8b\u0db4\u0daf\u0dda\u0dda\u0dc1\u0d9a \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0 \u0dc4\u0ddd\ufffd\u0ddd 4 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f (\u0d8b) \u0dc0\u0db1 \u0da1\u0dda\u0dda\u0daf\u0dba\u0dda\u024f \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dba\u0db8\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d91\u0db8 \u0db6\u0dbd\u0dad\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dba\u0db8\u0dca \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0db1\u0dca\u200d\u0dba\u0dba \u0dc4\u0ddd\ufffd\u0ddd \u0dc0\u0dd2\u0dc1\u0dda\ufffd\u0dda\u0dc2 \u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1\u0dba\u0db1\u0dca\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\n\n(2) (1) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dba\u0db8\u0dca \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3\u0db8\u0d9a\u0dca \u0db1\u0ddc\ufffd\u0ddc\u0dc3\u0dbd\u0d9a\u0dcf\u0dcf, \u0d91\u0dc3\u0dda\ufffd\u0dda \u0db4\u0dc0\u0dbb\u0db1 \u0dbd\u0daf \u0dba\u0db8\u0dca \u0db6\u0dbd\u0dad\u0dbd \u0d9a\u0dd2\u0dc3\u0dd2\u0dc0\u0d9a\u0dca \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0dba.\n\n14. \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca, \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0d9a\u0dbd, \u0db8\u0dda\u023c \u0db4\u0db1\u0dad \u0dba\u0da7\u0dad\u0dda\ufffd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0db6\u0dbd\u0dad\u0dbd \u0dc3\u0dc4 \u0d9a\u0dbb\u0dca\u0dad\u0dc0\u0dca\u200d\u0dba\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc3\u0dc4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0daf\u0dcf\u0dcf\u0dc5\u0dc0 \u0d91\u0d9a\u0dd3 \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0db1\u0dca\u200d\u0dba\u0dba \u0dc4\u0ddd\ufffd\u0ddd \u0dc0\u0dd2\u0dc1\u0dda\ufffd\u0dda\u0dc2 \u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0da7 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0dba. \u0d91\u0db8 \u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1\u0dc0\u0dbd\u0da7 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd \u0dc0\u0dd3\u0db8 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0dc0\u0db1\u0dca\u0db1\u0dda\ufffd \u0dba.\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n\u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u024f \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3\u0db8\n\n\u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0dba\u0da7\u0dad\u0dda\ufffd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d91\u0dc4\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0d91\u0dc4\u0dd2 \u0d9a\u0dbb\u0dca\u0dad\u0dc0\u0dca\u200d\u0dba\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\n\n14\u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u200d\u200d\u0d9c\u0ddc\u02c3\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u200d\u200d\u0d9c\u0ddc\u02c3\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9f\u0dd2\u0d9f\u0dd2\u0dbd\u0dd2 \u0db4\u0dbb\u0dca\u0dba\u0dda\u024f\u0dc2\u0dab \u0d86\u0dba\u0dad\u0db1\u0dba\u0dbd\u0dd2 \u0db4\u0dbb\u0dca\u0dba\u0dda\u024f\u0dc2\u0dab \u0d86\u0dba\u0dad\u0db1\u0dba\n\n15. \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda\u024f \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dc0-\n\n(\u0d85) \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca, \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0d9a\u0dbd, \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d91\u0d9a\u0dd3 \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0db7\u0dcf\u0dcf\u0dbb\u0dba\u0dda\u024f \u0dad\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba;"
