2e0\u02eb\u02ea\u02c3\u0003\u02c1\u02e1\u02d8\u0003\u02e2\u01cf\n\n[\u001b\u0003\u02e3\u02d8\u0003\u02da\u02d8\u01ae\u0003\u02f3\u02c1\u017b\u023c\u02da\u02d4]\n\n\u01e8\u01af\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0dd9\u023c \u021d\u0d9a\u0dcf\u0dc1\u0dba\u01e8\u01af\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0dd9\u023c \u021d\u0d9a\u0dcf\u0dc1\u0dba\n\n2 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba :2 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba : \u0dd9\u023c \u0dc0\u0d9c\u01e6\u01af\u0dba \u0db8\u0119\u01e6 (\u0dd9\u0db8\u028f \u023d\u01e6\u0db8\u01b1 \u201c\u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dba\u201d \u0dba\u01e9\u0dd9\u0dc0\u01e6 \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1) 2022 \u0d85\u0d82\u0d9a 9 \u0daf\u0dbb\u0db1 \u0dd9\u0db4\u0ddf\u01ca\u0d9c\u0263\u0d9a \u0daf\u01ae\u0dad \u0d86\u0dbb\u00fa\u0dc2\u0dab \u0db4\u0db1\u0dd9\u01ae 1 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb, \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u01dd\u0dad \u0db4\u025c\u01ce \u0d91\u0db8 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u01e8\u01af\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0db8 \u0dc0\u01e9\u0dd9\u024f -\n\n(\u0d85) 1 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc4\u0dd0\u0dbb \u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dd9\u024f \u0d85\u0dd9\u0db1\u00fd\u01ae \u0286\u0dba\u0265 \u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u01e7\u0dba\u0db8\u0dba\u00fa \u0db8\u0119\u01e6 \u0d85\u0db8\u0dcf\u0dad\u0255\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u01e7\u0dba\u0db8 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0dba\u023c \u01ce\u0db1\u0dba\u0d9a \u01cf \u0dd9\u0dc4\u0dcf\u0dca \u01ce\u0db1\u0dc0\u0dbd \u01cf \u0db6\u0dbd\u0dcf\u01ae\u0db8\u0d9a \u026b\u0db8 \u0218\u019d\u0dc3; \u0dc3\u0dc4\n\n(\u0d86) \u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dd9\u024f \u0d89\u0dc0\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u0daf 1 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (3) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dc3\u0dcf\u0daf\u01e9 \u0dbd\u0dd0\u022d \u01e7\u0dd9\u0dba\u0dcf\u0dca\u0d9c \u0db8\u0119\u01e6 \u0daf\u0dd0\u0db1\u0da7\u0db8\u01ae \u0db6\u0dbd\u0dcf\u01ae\u0db8\u0d9a \u0d9a\u0dbb \u0d87\u01af \u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dd9\u024f V \u0dc0\u0db1, VI \u0dc0\u0db1, VIII \u0dc0\u0db1, IX \u0dc0\u0db1 \u0dc3\u0dc4 X \u0dc0\u0db1 \u0dd9\u0d9a\u0dcf\u0da7\u0dc3\u0dca \u0dba\u0da7\u0dd9\u01ae \u0dba\u0dae\u0dcf \u0db4\u025c\u01ce \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dba\u023c \u0dd9\u0daf\u0dba\u00fa \u0dc0\u0dbd\u0d82\u011b\u0dc0\u01e9 \u0218\u019d\u0dc3 \u0dc3\u0dc4 \u0d85\u0d9b\u019c\u0da9\u0dc0 \u0db6\u0dbd\u0dcf\u01ae\u0db8\u0d9a\u0dc0 \u0db4\u0dc0\u01ae\u0dc0\u0dcf \u0d9c\u0dd0\u01e8\u0db8 \u0218\u019d\u0dc3,\n\n\u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u026b\u0db8 \u0dd9\u0269.\n\n3 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba :3 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba : \u0dd9\u023c \u0dc0\u0d9c\u01e6\u01af\u0dba \u0db8\u0119\u01e6 \u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dd9\u024f 12 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (2) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dba \u0d89\u0dc0\u01ae \u00fb\u025d\u0db8 \u0db8\u0119\u01e6 \u0d91\u0db8 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb \u0d91\u0db8 \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba 11 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0db8\u0119\u01e6 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba\u0da7 \u0d86\u01e9\u0dc2\u0d82\u0119\u0d9a \u0dd9\u0269.\n\n4 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba :4 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba : \u0dd9\u023c \u0dc0\u0d9c\u01e6\u01af\u0dba \u0db8\u0119\u01e6 \u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dd9\u024f 17 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb \u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u01dd\u0dad \u0db4\u025c\u01ce \u0d91\u0db8 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f \u01e8\u01af\u0dba \u0db6\u0dbd\u0db4\u0dd1\u0db8 \u0dc0\u01e9\u0dd9\u024f -\n\n(\u0d85) \u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dd9\u024f 13 \u0dc0\u0db1, 14 \u0dc0\u0db1, 15 \u0dc0\u0db1, 16 \u0dc0\u0db1 \u0dd9\u0dc4\u0dcf\u0dca 18 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0daf\u01ae\u0dad \u0daf\u0dcf\u0dba\u0d9a\u0dba\u00fd\u0dd9\u0d9c\u01e6 \u0db4\u0dcf\u0dbd\u0d9a\u0dc0\u0dbb\u0dba\u00fd \u0dd9\u0dc0\u0dad \u0dbd\u0dd0\u0dd9\u0db6\u0db1 \u0d89\u0262\u0264\u0db8\u00fa \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d85\u01e9\u0d9c\u0db8\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0d9a\u0dcf\u0259\u0dba\u0db4\u0179\u0db4\u0dcf\u0179\u0dba \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6; \u0dc3\u0dc4\n\n(\u0d86) \u0d87\u0dad\u0dd0\u023c \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u01e9\u0d9c\u0dad \u0d9a\u025e\u019f \u0dba\u0da7\u0dd9\u01ae \u0dc4\u0dd0\u0dbb, \u0db4\u0dcf\u0dbd\u0d9a\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6 \u0d9c\u0dcf\u0dc3\u0dca\u01b1 \u0d85\u0dba \u00fb\u025d\u0dd9\u0db8\u01e6 \u0dd9\u0dad\u0dcf\u0dbb\u0dc0 \u0d91\u0db8 \u0d89\u0262\u0264\u0db8\u0da7 \u0d85\u01e9\u00fe\u0dbd\u0dc0 \u0101\u0dba\u0dcf \u0d9a\u0dc5 \u0252\u01b1 \u0db6\u0dc0\u0da7,\n\n\u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u026b\u0db8 \u0dd9\u0269."
