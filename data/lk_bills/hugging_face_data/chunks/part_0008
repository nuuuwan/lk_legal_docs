5\u0bcd\u0bcd\u0b95\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bcd\u0bb1\u0ba4\u0bc1\n\n\u0b8e\u0ba9\u0bcd\u0bcd\u0baa\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd, \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0bcd\u0ba4\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0b85\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0baa\u0bcd\u0bcd\u0baa\u0baf\u0ba9\u0bbe\u0ba9\u0ba4\u0bc1 \u0bae\u0bbf\u0b95\u0bc8\u0b95\u0bcd\u0bcd\u0b95\u0b9f\u0bcd\u0bcd\u0b9f\u0ba3\u0baa\u0bcd \u0baa\u0bb0\u0bbf\u0b9a\u0bc0\u0bb2\u0ba9\u0bc8\u0b95\u0bcd\n\n\u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bc8 \u0ba8\u0bbf\u0baf\u0bae\u0bbf\u0baa\u0bcd\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0ba9\u0bcd \u0b89\u0bb3\u0bcd\u0bcd\u0bb3\u0bae\u0bc8\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bc8\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb0\u0bc8\u0baa\u0bcd\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bcd\u0bae\u0bae\u0bc8\u0b9a\u0bcd\n\n\u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0bb5\u0bbe\u0b95\u0bcd\u0bcd\u0b95\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0bb2\u0bcd \u0b8f\u0bb1\u0bcd\u0bcd\u0baa\u0baa\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bbf\u0ba3\u0bc8\u0baa\u0bcd\u0baa\u0bc1\u0b9a\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0bcd\u0bb5\u0ba4\u0bbe\u0b95\u0bc1\u0bae\u0bcd.\n\n\u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd 9:\u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd 9: \u0b87\u0bb5\u0bcd\u0bcd\u0bb5\u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd, \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bcd\u0bae\u0bae\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0bb5\u0bbe\u0b95\u0bcd\u0bcd\u0b95\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0bb2\u0bcd 21\u0b85, 21\u0b86, 21\u0b87, 21\u0b88, 21\u0b89 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 21\u0b8a\n\n\u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bc1\u0b95\u0bb3\u0bc8 \u0b89\u0b9f\u0bcd\u0baa\u0bc1\u0b95\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bcd\u0bb1\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0bcd\u0baa\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd \u0b85\u0baa\u0bcd\u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bc1\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0baa\u0bcd\u0bcd\u0baa\u0baf\u0ba9\u0bbe\u0ba9\u0ba4\u0bc1\n\n\u0bae\u0bbf\u0b95\u0bc8\u0b95\u0bcd\u0bcd\u0b95\u0b9f\u0bcd\u0bcd\u0b9f\u0ba3\u0baa\u0bcd \u0baa\u0bb0\u0bbf\u0b9a\u0bc0\u0bb2\u0ba9\u0bc8\u0b95\u0bcd \u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bbf\u0ba9\u0bcd \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bbf\u0ba9\u0bb0\ufffd\u0bca\u0bb0\u0bc1\u0bb5\u0bb0\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0baa\u0bcd\u0bcd\u0baa\u0ba4\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0bcd\u0ba4\u0ba4\u0bbe\u0ba9 \u0ba4\u0b95\u0bc8\u0bae\u0bc8\u0baf\u0bc0\u0ba9\u0b99\u0bcd\u0bcd\u0b95\u0bb3\u0bcd,\n\n\u0b85\u0ba4\u0bcd\u0bcd\u0ba4\u0b95\u0bc8\u0baf \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0ba4\u0bb5\u0bbf\u0b95\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0bb2\u0bae\u0bcd, \u0b85\u0ba4\u0bcd\u0bcd\u0ba4\u0b95\u0bc8\u0baf \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0ba4\u0bb5\u0bbf \u0bb5\u0bb1\u0bbf\u0ba4\u0bbe\u0ba4\u0bb2\u0bcd,\n\n\u0b85\u0ba4\u0bcd\u0bcd\u0ba4\u0b95\u0bc8\u0baf \u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0bcd\u0b9f\u0bae\u0bc1\u0bae\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0bcd\u0b9f \u0ba8\u0b9f\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bc6\u0ba3\u0bcd\u0ba3\u0bc1\u0bae\u0bcd, \u0b85\u0ba4\u0bcd\u0bcd\u0ba4\u0b95\u0bc8\u0baf \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bbf\u0ba9\u0bb0\u0bcd\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b8a\u0ba4\u0bbf\u0baf\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd\n\n\u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0bcd\u0b9f\u0b99\u0bcd\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bbf\u0baa\u0bc1\u0ba3\u0bb0\u0bcd\u0bcd\u0b95\u0bb3\u0bc8 \u0b85\u0bb4\u0bc8\u0baa\u0bcd\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b85\u0ba4\u0bcd\u0bcd\u0ba4\u0b95\u0bc8\u0baf \u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bb3\u0bbf\u0ba4\u0bcd\u0bcd\u0ba4\u0bb2\u0bcd \u0b86\u0b95\u0bbf\u0baf\u0ba9\n\n\u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0bcd\u0baa\u0baa\u0bbe\u0ba9 \u0b8f\u0bb1\u0bcd\u0bcd\u0baa\u0baa\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u0bcd\u0baa\u0baa\u0bbe\u0b9f\u0bc1\u0b9a\u0bc6\u0baf\u0bcd\u0bcd\u0bb5\u0ba4\u0bbe\u0b95\u0bc1\u0bae\u0bcd.\n\n\u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd 10:\u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd 10: \u0b87\u0bb5\u0bcd\u0bcd\u0bb5\u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd, \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bcd\u0bae\u0bae\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0bb5\u0bbe\u0b95\u0bcd\u0bcd\u0b95\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd 22 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bcd\u0bb1\u0ba4\u0bc1\n\n\u0b8e\u0ba9\u0bcd\u0bcd\u0baa\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd, \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bcd\u0bae\u0bae\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0bb5\u0bbe\u0b95\u0bcd\u0bcd\u0b95\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd 2 \u0b87\u0ba9\u0bbe\u0bb2\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0bcd\u0baf\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0bb1\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0ba9\n\n\u0bb5\u0bbf\u0bb3\u0bc8\u0bb5\u0bbe\u0ba8\u0bcd\u0bcd\u0ba4\u0ba9\u0bcd\u0bcd\u0bae\u0bae\u0bc8\u0baf\u0bc1\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd.\n\n\u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd 11: \u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd 11: \u0b87\u0bb5\u0bcd\u0bcd\u0bb5\u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd, \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bcd\u0bae\u0bae\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0bb5\u0bbe\u0b95\u0bcd\u0bcd\u0b95\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd 23 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bcd\u0bb1\u0ba4\u0bc1"
  },
