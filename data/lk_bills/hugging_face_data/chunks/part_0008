    "chunk_text": "(4) (1) \u0dc0\u0db1, (2) \u0dc0\u0db1 \u0dc3\u0dc4 (3) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dc0\u0dbd \u026a\u01dd\u026a\u0db0\u0dcf\u0db1\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae\u0dc0, \u0da2\u0db1\u0dcf\u01dd\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6, \u0dd9\u023c \u0db4\u0db1\u0dad \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0dc0\u0db1 \u01ce\u0db1 \u0286\u0da7 \u0db8\u0dcf\u0dc3 \u01b1\u0db1\u00fa \u0d87\u01b1\u0dc5\u0dad \u0dd9\u0dc4\u0dcf\u0dca \u0d85\u01dd\u0db7\u0dcf\u0dbb \u0dc3\u0dcf\u0db8\u0dcf\u0dd9\u0dbd\u0dcf\u0dca\u0da0\u0db1 \u0d9a\u023d\u017b\u0dd9\u0269 \u021a\u0dbb\u0217\u0db4\u0dcf\u018d\u0dc0\u00fa \u0d87\u01af \u026b\u0dd9\u023c \u01ce\u0db1 \u0286\u0da7 \u0db8\u0dcf\u0dc3 \u01b1\u0db1\u00fa \u0d87\u01b1\u0dc5\u0dad (1) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (\u0d85) \u0dc0\u0db1, (\u0d86) \u0dc0\u0db1 \u0dc3\u0dc4 (\u0d87) \u0dc0\u0db1 \u0dd9\u0146\u0daf \u0dba\u0da7\u0dd9\u01ae \u0db4\u01ae \u00fb\u025d\u0db8\u0da7 \u01e7\u0dba\u023d\u0dad \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u01e6 \u0218\u0298\u0db6\u0db3\u0dc0 \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0daf\u0dcf\u0dba\u0d9a \u0dc3\u0db7\u0dcf\u0dc0 \u0dd9\u0dc0\u0dad \u0dc3\u0dca\u0dc0\u00fc\u0dba \u01e7\u0259\u0dd9\u01ca\u0dc1\u0dba \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u0dd4\u01b1 \u0dba.\n\n(6) \u0da2\u0db1\u0dcf\u01dd\u0db4\u01af\u0dc0\u0dbb\u0dba\u0dcf \u026a\u0286\u01e6, \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0daf\u0dcf\u0dba\u0d9a \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0d85\u01e9\u0db8\u0dad\u0dba \u0dbd\u0dd0\u022b\u0dd9\u023c \u01ce\u0db1 \u0286\u0da7 \u01ce\u0db1 \u0daf\u0dcf\u0dc4\u0dad\u0dbb\u00fa \u0d87\u01b1\u0dc5\u0dad, \u0d85\u01dd\u0db7\u0dcf\u0dbb \u0dc3\u0db8\u0dcf\u0dd9\u0dbd\u0dcf\u0dca\u0da0\u0db1 \u0d9a\u023d\u017b\u0dd9\u0269 \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0dba\u01e6 \u0db4\u01ae \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022a\u0dba \u0252\u01b1 \u0dba.\u201d.\n\n9. \u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dd9\u024f 21 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba\u0da7 \u0d89\u00fa\u022a\u01af\u0dc0 \u0db8 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0d85\u0265\u01ae \u0dc0\u0d9c\u01e6\u01af \u0dd9\u0db8\u0250\u01e6 \u0d87\u01b1\u0dc5\u01ae \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb \u0d91\u0db8 \u0dc0\u0d9c\u01e6\u01af \u0d91\u0db8 \u021d\u0da5\u0217\u01af\u0dd9\u024f 21\u0d85, 21\u0d86, 21\u0d87, 21\u0d88, 21\u0d89 \u0dc3\u0dc4 21\u0d8a \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0db6\u0dbd\u0dcf\u01ae\u0db8\u0d9a \u026a\u0dba \u0252\u01b1 \u0dba:-\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n\u021d\u0db0\u0dcf\u0db1 \u021d\u0da5\u0217\u01af\u0dba\u0da7 21\u0d85, 21\u0d86, 21\u0d87, 21\u0d88, 21\u0d89 \u0dc3\u0dc4 21\u0d8a \u0dc0\u0db1 \u0d85\u0265\u01ae \u0dc0\u0d9c\u01e6\u01af \u0d87\u01b1\u0dc5\u01ae \u00fb\u025d\u0db8\n\n9\u0da2\u0dcf\u01af\u0d9a \u026a\u0d9c\u0dab\u0db1 (\u0dc3\u0d82\u0dd9\u0dc1\u0dcf\u0dca\u0db0\u0db1)\n\n21\u0d85. \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd -\n\n(\u0d85) \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1 \u0db8\u01e6\u01b6\u0dc0\u0dbb\u0dba\u00fd \u0dd9\u0269 \u0db1\u023c \u0dd9\u0dc4\u0dcf\u0dca \u0db4\u0dcf\u0259\u0263\u0dd9\u023c\u01e6\u01b1 \u0db8\u01e6\u01b6\u0dc0\u0dbb\u0dba\u00fd \u0db6\u0dc0\u0da7 \u0db4\u01ae \u0dd9\u0269 \u0db1\u023c \u0dd9\u0dc4\u0dcf\u0dca \u0dba\u023c \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dc0\u0d9a \u0db8\u01e6\u01b6\u0dc0\u0dbb\u0dba\u00fd \u0dd9\u0269 \u0db1\u023c \u0dd9\u0dc4\u0dcf\u0dca \u0dba\u023c \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dc0\u0d9a \u0db8\u01e6\u01b6\u0dc0\u0dbb\u0dba\u00fd \u0db6\u0dc0\u0da7 \u0db4\u01ae \u0dd9\u0269 \u0db1\u023c \u0dd9\u0dc4\u0dcf\u0dca \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a \u0dc3\u0234\u0d9a\u0dba\u00fd \u0dd9\u0269 \u0db1\u023c \u0dd9\u0dc4\u0dcf\u0dca \u0db4\u0dc5\u0dcf\u01ae \u0db4\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a \u0dc3\u0234\u0d9a\u0dba\u00fd \u0db6\u0dc0\u0da7 \u0db4\u01ae \u0dd9\u0269 \u0db1\u023c;\n\n(\u0d86) \u027c \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u021a\u0dbb\u0dc0\u0dd0\u0286\u0dba\u00fd \u0dd9\u0db1\u0dcf\u0dd9\u0269 \u0db1\u023c \u0dd9\u0dc4\u0dcf\u0dca \u027c \u0dbd\u0d9a\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u021a\u0dbb\u0dc0\u0dd0\u0286\u0dba\u00fd \u026b\u0db8 \u0d85\u0dc0\u0dc3\u01e6 \u0dd9\u0269 \u0db1\u023c;\n\n(\u0d87) \u027c \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u0dd9\u0dc4\u0dcf\u0dca \u0dd9\u0dc0\u0db1\u01ae \u0dba\u023c \u0dbb\u0da7\u0d9a \u0db6\u0dbd\u0db4\u0dc0\u01ae\u0db1\u0dcf \u026d \u0dba\u023c \u01e8\u01af\u0dba\u00fa \u0dba\u0da7\u0dd9\u01ae \u0286\u028f\u026a\u0d9a\u0262 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u0db6\u0dc0\u0da7 \u0d85\u0db1\u0dcf\u0dc0\u0dbb\u0dab\u0dba \u0dd9\u0269 \u0db1\u023c \u0dd9\u0dc4\u0dcf\u0dca \u0d91\u0dd9\u0dc3\u0dca \u0286\u028f\u026a\u0d9a\u0262 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u0db6\u0dc0\u0da7 \u021d\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u01ae\u0dc0 \u0d87\u01ae\u0db1\u023c;\n\n(\u0d88) \u027c \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u0dd9\u0dc4\u0dcf\u0dca \u0dd9\u0dc0\u0db1\u01ae \u0dba\u023c \u0dbb\u0da7\u0d9a \u0dba\u023c \u01e8\u01af\u0dba\u00fa \u0dba\u0da7\u0dd9\u01ae \u0dc0\u0dc3\u0dca\u01b1\u0db6\u0d82\u0d9c\u01ae\u0dc0\u0dba\u0da7 \u0db4\u01ae \u026d \u0dd9\u0dc4\u0dcf\u0dca \u022c\u01e6\u0dc0\u01ae\u0db7\u0dcf\u0dc0\u0dba\u0da7 \u0db4\u01ae \u026d \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u021d\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u01ae \u0d9a\u0dbb \u0d92 \u0dc0\u0dc3\u0dca\u01b1\u0db6\u0d82\u0d9c\u01ae\u0dc0\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u0dcf\u0dca \u022c\u01e6\u0dc0\u01ae\u0db7\u0dcf\u0dc0\u0dd9\u0dba\u01e6 \u01e7\u0daf\u0dc4\u0dc3\u0dca \u0dd9\u0db1\u0dcf\u0d9a\u0dc5 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dad\u00fd \u0dd9\u0269 \u0db1\u023c;\n\n(\u0d89) \u027c \u0dbd\u0d82\u0d9a\u0dcf\u0dd9\u0269 \u0dd9\u0dc4\u0dcf\