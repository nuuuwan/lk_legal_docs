u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0d91\u0d9a\u0dca \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0d9a\u0dd4 \u0daf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da7 \u0daf\u0dd3 \u0db8\u0dd2\u0dc3 \u0d9a\u0dd2\u0dc3\u0dd2\u0db8 \u0dc3\u0dcf\u0dcf\u0db0\u0db1 \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0da7 \u0dad\u0db6\u0db1\u0dd4 \u0db1\u0ddc\ufffd\u0ddc\u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dad\u0dbb, \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dad\u0db8\u0db1\u0dca \u0db4\u0dd0\u0dd0\u0db8\u0dd2\u0dab \u0dc3\u0dd2\u0da7\u0dd2 \u0db6\u0dc0\u0da7 \u0dc3\u0dbd\u0d9a\u0dd4\u0dab\u0d9a\u0dca \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d91\u0d9a\u0dd3 \u0dc3\u0dcf\u0dcf\u0db0\u0db1 \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0dad\u0db8 \u0db1\u0db8 \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dad\u0dbb, \u0d91\u0d9a\u0dd3 \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dcf\u0dcf\u0d9a\u0dca\u0dc2\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0d9a\u0dd4 \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dba\u0db8\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4\u0d9c\u0dda\u0118 \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0da7 \u0db4\u0dbb\u0dd2\u0db6\u0dcf\u0dcf\u0dc4\u0dd2\u0dbb \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\n\n35.35. (1) \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca \u0dc4\u0ddd\ufffd\u0ddd \u0d85\u0db4\u0dcf\u0dcf\u0dbb\u0dcf\u0dcf\u0db0 \u0db1\u0da9\u0dd4 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0dad\u0d9a\u0dca-\n\n(\u0d85) \u0db8\u0dda\ufffd \u0db4\u0db1\u0dad \u0dba\u0da7\u0dad\u0dda\ufffd \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db4\u0dd2\u0dad \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0daf\u0dca\u0db7\u0dcf\u0dcf\u0dc0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d9a\u0dbb\u0db1