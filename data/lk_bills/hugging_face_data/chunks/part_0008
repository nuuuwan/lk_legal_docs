u0dba\u0d9a\u0dca \u0daf \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0dc0\u0dda\u0dda\u037e\n\n\u201c\u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u201d \u0dba\u0db1\u0dca\u0db1\u0dd9\ufffd\u0db1\u0dca, \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dda\u0dda 44\n\n\u0dc0\u0db1 \u0dc4\u0ddd\ufffd\u0ddd 45 \u0dc0\u0db1 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0 \u0dba\u0da7\u0dad\u0dda\ufffd \u0db8\u0dda\u023c \u0db4\u0db1\u0dad \u0db4\u0dc0\u0dbb\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dc0\u0dda\u0dda\u037e \u0dc3\u0dc4\n\n\u201c\u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0db6\u0dbd\u0db0\u0dbb\u0dba\u0db1\u0dca\u201d \u0dba\u0db1\u0dca\u0db1\u0dd9\ufffd\u0db1\u0dca, \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db8 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1,\n\n\u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u023c\u0db1\u0dca\u0dad\u0dd4, \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf, \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u023c\u0db1\u0dca\u0dad\u0dd4 \u0dc3\u0dc4 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0dc3\u0dc4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dd8\u0dd8\u0dad\u0dd2 \u0dba\u0ddd\ufffd\u0ddd\u0da2\u0db1\u0dcf\u0dcf \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0db6\u0dbd\u0d9c\u0db1\u0dca\u0dc0\u0db1 \u0dbd\u0daf \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dd8\u0dd8\u0dad\u0dd2 \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0