    "chunk_text": "(3) \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u0bb3\u0bcd 16, 17, 18, 19, 20, 21, 22, 23 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 24 \u0b8e\u0ba9\u0bcd\u0baa\u0bb5\u0bb1\u0bcd\u0bb1\u0bbf\u0ba9\u0bcd\u0b95\u0bc0\u0bb4\u0bbe\u0ba9 \u0ba4\u0bb5\u0bc6\u0bb1\u0bbe\u0ba9\u0bcd\u0bc8\u0bb1\u0baa\u0bcd \u1f97\u0bbe\u0bbf\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3\u0bc8\u0bae\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b8e\u0bb5\u0bc7\u0bb0\u1f94\u0bae\u0bbe\u0bb3\u0bcd \u0b90\u0ba8\u0bcd\u0ba4\u0bbe\u0ba3\u0bcd\u1f8c\u0b95\u0bc8\u0bb3 \u0bb5\u0bbf\u0b9e\u0bcd\u0b9a\u0bbe\u0ba4\u0bc6\u0bb5\u0bbe\u1f9e \u0b95\u0bbe\u0bb2\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0bae\u0bb1\u0bbf\u0baf\u0bb1\u0bcd\u0bb1\u0ba3\u0bcd\u0b9f\u0bc8\u0ba9\u0baf\u0bbf\u0ba9\u0bbe\u1fa4\u0bae\u0bcd \u0b92\u1f9e \u0bae\u0bbf\u0bb2\u0bcd\u1fa2\u0baf\u0ba9\u0bcd \u1f9f\u0baa\u0bbe\u0bc8\u0bb5 \u0bb5\u0bbf\u0b9e\u0bcd\u0b9a\u0bbe\u0ba4 \u0b95\u0bc1\u0bb1\u0bcd\u0bb1\u0baa\u0bcd\u0baa\u0ba3\u0bc6\u0bae\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba9\u0bbe\u1fa4\u0bae\u0bcd \u0ba4\u0ba3\u0bcd\u1f8a\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bb2\u0bcd \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bae\u0bcd. \u0b95\u0bc1\u0bb1\u0bcd\u0bb1\u0bb5\u0bbf\u0baf\u0bb2\u0bcd \u0ba8\u0b9f\u0bb5\u1f8a\u0b95\u0bcd\u0bc8\u0b95\u1f99\u0bc8\u0bb1\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0b95\u0bcd \u0bc7\u0b95\u0bbe\u0bc8\u0bb5\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 306 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u1f8c\u0b95\u0bb3\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0bae\u0bb1\u0bbf\u0baf\u0bb1\u0bcd\u0bb1\u0ba3\u0bcd\u0b9f\u0bc8\u0ba9\u0ba4\u0bcd\u0ba4\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u1f97\u0ba4\u0bcd \u0bc6\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0b95 \u0b8f\u0bb1\