    "chunk_text": "\u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0 \u0dad\u0dd4\u0dc5 \u0daf\u0dd3 \u0dc4\u0ddd\ufffd\u0ddd \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0db4\u0dd2\u0da7\u0dad \u0dad\u0dd2\u0db6\u0dd4\u0dab \u0daf, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db4\u0ddc\ufffd\u0ddc\u0daf\u0dd4 \u0daf\u0dda\u0dda\u0db4\u0dc5\u0d9a\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0 \u0dad\u0dd4\u0dc5 \u0daf\u0dd3 \u0dc4\u0ddd\ufffd\u0ddd \u0d89\u0db1\u0dca \u0db4\u0dd2\u0da7\u0dad \u0daf\u0dd3 \u0dba\u0db8\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0dc0\u0dd2\u0dbb\u0ddd\u02e1\u0ddd\u0db0\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0d9a\u0dcf\u0dcf\u0dbb\u0d9a\u0db8\u0d9a\u0dca \u0dc4\u0ddd\ufffd\u0ddd \u0d91\u0dc4\u0dd2 \u0dba\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dba\u0db8\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4;\n\n\u0db4\u0db1\u0dad \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0dc0\u0dd3\u0db85\n\n10\n\n15\n\n20\n\n25\n\n30\n\n8 \u0d85\u0db4\u0dbb\u0dcf\u0dcf\u0db0\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0dd2\u0dad \u0daf\u0dda\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0db4\u0dbb\u0dcf\u0dcf\u0db0\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0dd2\u0dad \u0daf\u0dda\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\n\n(\u0d8a) \u0dba\u0db8\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0dc0\u0dd2\u0dbb\u0ddd\u02e1\u0ddd\u0db0\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0d9a\u0dcf\u0dcf\u0dbb\u0d9a\u0db8\u0d9a\u0dca \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0dd2\u0dad \u0daf\u0dda\u0dda \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0 \u0dad\u0dd4\u0d