f\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0db8\u0dc4\u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf;\n\n(\u0d88\u0d88) 1990 \u0d85\u0d82\u0d82\u0d9a 18 \u0daf\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dab\u0dba \u0dad\u0ddc\ufffd\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0d82\u0d82\ufffd\u0dc1 \u0db4\u0db1\u0dad\u0dda\ufffd 5 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dab\u0dba \u0dad\u0ddc\ufffd\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0d82\u0d82\ufffd\u0dc1\u0dba\u0dda\u024f \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf;\n\n(\u0d89\u0d89) (351 \u0dc0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba \u0dc0\u0dd6) \u0d86\u0d9c\u0db8\u0db1 \u0dc0\u0dd2\u0d9c\u0db8\u0db1 \u0db4\u0db1\u0dad\u0dda\ufffd 4 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d86\u0d9c\u0db8\u0db1 \u0dc4\u0dcf\u0dcf \u0dc0\u0dd2\u0d9c\u0db8\u0db1 \u0db4\u0dcf\u0dcf\u0dbd\u0d9a\u0dc0\u0dbb\u0dba\u0dcf\u0dcf;\n\n(\u0d8a\u0d8a) 1969 \u0d85\u0d82\u0d82\u0d9a 1 \u0daf\u0dbb\u0db1 \u0d86\u0db1\u0dba\u0db1 \u0dc3\u0dc4 \u0d85\u0db4\u0db1\u0dba\u0db1 (\u0db4\u0dcf\u0dcf\u0dbd\u0db1) \u0db4\u0db1\u0dad\u0dda\ufffd 2 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d86\u0db1\u0dba\u0db1 \u0dc3\u0dc4 \u0d85\u0db4\u0db1\u0dba\u0db1 \u0db4\u0dcf\u0dcf\u0dbd\u0d9a\u0dc0\u0dbb\u0dba\u0dcf\u0dcf;\n\n(\u0d8b\u0d8b) (464 \u0dc0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba \u0dc0\u0dd6) \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda