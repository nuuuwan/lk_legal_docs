\u0bcd\u0bc8\u0b9f\u1f9c\u0bc8\u0b9f\u0baf \u0b86\u0bc8\u0bb3 \u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u1fa2\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u1f90\u0bc8\u0bb0\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0b95\u0bcd\u0b95\u0bc2\u1f8a\u0baf\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9\u0bbe\u1fa4\u0bae\u0bcd \u1f99\u0baa\u0bcd\u0baa\u1f90 \u0ba8\u0bbe\u0b9f\u0bcd\u0b95\u0bc8\u0bb3 \u0bb5\u0bbf\u0b9e\u0bcd\u0b9e\u0bbe\u0ba4\u1f90\u0bae\u0bbe\u0ba9 \u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0b95\u0bbe\u0bb2\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0ba4\u0bcd \u0ba4\u0b95\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0ba4\u0bb0\u1fab\u0b95\u0bb3\u0bcd \u0bc7\u0baa\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bc6\u0bae\u0ba9\u0bcd\u0baa\u0bc8\u0ba4 \u0b89\u1fa0\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u1f90\u0bae\u0bbe\u1fa0 \u0bc7\u0ba4\u0bc8\u0bb5\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0bb2\u0bbe\u0bae\u0bcd.\n\n(2) \u0b8e\u0b95\u0bcd\u0b95\u0bbe\u0bb2\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0b95\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0ba4\u0bb0\u1fab \u0bc7\u0baa\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f \u0bc7\u0bb5\u0ba3\u0bcd\u1f8c\u0bc7\u0bae\u0bbe \u0b85\u0b95\u0bcd\u0b95\u0bbe\u0bb2\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0baf\u0bbe\u0ba9\u1f90 \u0ba8\u0bc0\u0ba4\u0bbf\u0bb5\u0bbe\u1f94\u0b95\u0bcd\u0b95\u0bc1 \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0bb5\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bae\u0bc0\u1f90 \u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0bc7\u0bae\u1fa4\u0bc6\u0bae\u0bbe\u1f9e \u0b95\u0bbe\u0bb2\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bc0\u1f8a\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bb2\u0bbe\u0bae\u0bcd."
