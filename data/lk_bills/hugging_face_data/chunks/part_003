2\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0dc3\u0dd0\u0dd0\u0dbd\u0dd0\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8;\n\n(\u0d91) \u0d85\u0db4\u0dbb\u0dcf\u0dcf\u0db0\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0dd2\u0dad \u0daf\u0dda\u0dda \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dc0\u0dd6 \u0db1\u0dd3\u0dad\u0dd2\u0dc0\u0dd2\u0dbb\u0ddd\u02e1\u0ddd\u0db0\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0d9a\u0dcf\u0dcf\u0dbb\u0d9a\u0db8\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dd0\u0dd0\u0dc5\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0db8;\n\n(\u0d92) (i) (\u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db8\u0dd2\u0db1\u0dca \u0db8\u0dad\u0dd4 \u201c\u0dc0\u0dbb\u0daf\u0d9a\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0 \u0dbb\u0da2\u0dba \u0dc3\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0db1\u0da9\u0dd4 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u201d \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1) \u0d85\u0db4\u0dbb\u0dcf\u0dcf\u0db0\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0dd2\u0dad \u0daf\u0dda\u0dda \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd3\u0dad\u0dd2\u0dc0\u0dd2\u0dbb\u0ddd\u02e1\u0ddd\u0db0\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0d9a\u0dcf\u0dcf\u0dbb\u0d9a\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dba\u0db8\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0dc0\u0dbb\u0daf\u0d9a\u0dbb\u0dd4 \u0dc0\u0dd3\u0db8 \u0d85\u0db1\u0dd4\u0dc0; \u0dc3\u0dc4\n\n(ii) (\u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db8\u0dd2\u0db1\u0dca \u0db8\u0dad\u0dd4 \u201c\u0dc0\u0dbb\u0daf\u0d9a\u0dbb\u0dd4 \u0db1\u0ddc\ufffd\u0ddc\u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db8\u0dad \u0db4\u0daf\u0db1\u0db8\u0dca \u0dc0\u0dd6 \u0dbb\u0da2\u0dba \u0dc3\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0db1\u0da9\u0dd4 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u201d \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1) \u0d85\u0db4\u0dbb\u0dcf\u0dcf\u0db0\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0dd2\u0dad \u0daf\u0dda\u0dda \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd3\u0dad\u0dd2 \u0dc0\u0dd2\u0dbb\u0ddd\u02e1\u0ddd\u0db0\u0dd3 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0d9a\u0dcf\u0dcf\u0dbb\u0d9a\u0db8 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dba\u0db8\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4\u0da7 \u0d91\u0dbb\u0dd9\u0dd9\u0dc4\u0dd2\u0dc0 \u0db1\u0da9\u0dd4 \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3\u0db8\u0da7 \u0dc3\u0dca\u0dc0\u0dcf\u0dcf\u0db0\u0dd3\u0db1\u0dc0,\n\n\u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0db1\u0da9\u0dd4 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc3\u0dc4 \u0d85\u0db4\u0dbb\u0dcf\u0dcf\u0db0\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0dd2\u0dad \u0daf\u0dda\u0dda \u0dbb\u0da2\u0dba \u0dc3\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0d86\u0da5\u0dcf\u0dcf \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dae\