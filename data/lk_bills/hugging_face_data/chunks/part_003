\u0bcd \u0bb5\u0bc8\u0bb0\u0bb5\u0bbf\u0bb2\u0b95\u0bcd \u0b95\u0ba3\u0ba4\u0bcd\u0bc8\u0ba4\u0ba4\u0bcd \u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u1f90\u0bb5\u0ba4\u0bbe\u0b95\u0bc1\u0bae\u0bcd.\n\n\u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd 14\u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd 14 : \u0b87\u0bb5\u0bcd\u0bb5\u0bbe\u0b9a\u0b95\u0bae\u0bcd \u1f99\u0ba4\u0ba9\u0bcd\u0bc8\u0bae\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f \u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u1f90\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u1f99\u0ba4\u0bb2\u0bbe\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0bbe\u0b95\u0bae\u0bcd II \u0b90 \u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u1f90\u0bb5\u1f90\u0b9f\u0ba9\u0bcd \u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bbe\u0bb1\u0bbe\u0ba9 \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0baf\u0ba9\u0bbe\u0ba9\u1f90, (\u0b85) \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd (\u0b86) \u0b8e\u0ba9\u0bcd\u1f94\u0bae\u0bcd \u0baa\u0ba8\u0bcd\u0ba4\u0bbf\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u1f97\u0ba4\u0bbf\u0baf \u0bb5\u0bbf\u0b9f\u0baf\u0b99\u0bcd\u0b95\u0bc8\u0bb3\u0b9a\u0bcd \u0bc7\u0b9a\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0ba4\u0bbe\u0b95\u0bc1\u0bae\u0bcd.\n\n5\n\n10\n\n15\n\n20\n\n25\n\n30\n\n35\n\n\u0b9a\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0baf\u0ba9\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b95\u0bc2\u0bb1\u0bcd\u1fa0\u0b9a\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0baf\u0ba9\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b95\u0bc2\u0bb1\u0bcd\u1fa0\n\n4\u0bc7\u0b9a\u0bb0\u0bcd\u0bc6\u0baa\u1fa0\u0bae\u0ba4\u0bbf \u0bb5\u0bbe\u0bbf (\u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0b9a\u0bcd) \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\u0bc7\u0b9a\u0bb0\u0bcd\u0bc6\u0baa\u1fa0\u0bae\u0ba4\u0bbf \u0bb5\u0bbe\u0bbf (\u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0b9a\u0bcd) \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\n\n\u0bc7\u0b9a\u0bb0\u0bcd\u0bc6\u0baa\u1fa0\u0bae\u0ba4\u0bbf \u0bb5\u0bbe\u0bbf (\u0ba4\u0bbf\u1f9e