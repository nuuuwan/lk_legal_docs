0dca\u200d\u0dba\u0dba \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0dc4\u0ddd\ufffd\u0ddd \u0db1\u0db8\u0dca\u0d9a\u0dc5 \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba\u0db8\u0dba \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0db1 \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0dc3\u0dc4 \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0dba\u0d9a \u0dc4\u0ddd\ufffd\u0ddd \u0d85\u0dad\u0dae\u0dca\u200d\u0dba\u0dba \u0dc0\u0dad\u0dca\u0d9a\u0db8\u0dca \u0dc3\u0db4\u0dba\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dc0\u0dd6 \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dba\u0d9a \u0dba\u0dd9\ufffd\u0daf\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dc4\u0ddd\ufffd\u0ddd \u0d9a\u0dbb\u0d9c\u0dd9\ufffd\u0db1 \u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dba\u0db8\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dc0\u0dda\u0dda;\n\n\u201c\u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0dd9\u0db1\u0dd4 \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0db4\u0db1\u0dad\u201d \u0dba\u0db1\u0dca\u0db1\u0dd9\ufffd\u0db1\u0dca, 2006\n\n\u0d85\u0d82\u0d82\u0d9a 6 \u0daf\u0dbb\u0db1 \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0dd9\u0db1\u0dd4 \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0db4\u0db1\u0dad \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dc0\u0dda\u0dda;\n\n5\n\n10\n\n15\n\n20\n\n25\n\n234\u0d85\u0db4\u0dbb\u0dcf\u0dcf\u0db0\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0dd2\u0dad \u0daf\u0dda\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0d85\u0db4\u0dbb\u0dcf\u0dcf\u0db0\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d8b\u0dad\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0dd2\u0dad \u0daf\u0dda\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\n\n\u201c\u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0db6\u0dd4\u0daf\u0dca\u0d