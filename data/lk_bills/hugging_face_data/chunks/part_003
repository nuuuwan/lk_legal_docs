\u0bc0\u1f90\n\n\u0b86\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bc6\u0b9a\u1fa4\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba4\u0bb1\u0bcd\u0bc7\u0baa\u0bbe\u1f90\n\n\u0baa\u0baf\u0ba9\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u1f99\u0bc8\u0bb1.\n\n293\u0b95\u0bc1\u0bb1\u0bcd\u0bb1\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bb2\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u1f9e\u0bae\u0bcd\u0baa\u1f8a\u0b95\u0bb3\u0bcd\u0b95\u0bc1\u0bb1\u0bcd\u0bb1\u0b9a\u0bcd \u0bc6\u0b9a\u0baf\u0bb2\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bb5\u1f9e\u0bae\u0bcd\u0baa\u1f8a\u0b95\u0bb3\u0bcd\n\n(\u0b86) \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc2\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b86\u0ba4\u0ba9\u0ba4\u0bcd\u0bc8\u0ba4\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1,\n\n\u0b89\u0bc8\u0b9f\u0bc8\u0bae\u0baf\u0bbf\u0bb2\u0bcd \u0bc8\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u1f9e\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1, \u0bc6\u0b9a\u0bbe\u0ba8\u0bcd\u0ba4\u0bae\u0bbe\u0b95\n\n\u0bc8\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u1f9e\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1, \u0b95\u0b9f\u0bcd\u1f8c\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u1f90\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1, \u0b85\u0ba4\u0ba9\u0bcd\u0bae\u0bc0\u1f90\n\n\u0b86\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bc6\u0b9a\u1fa4\u0ba4\u0bcd\u1f90\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bbf\u0ba4\u0bbf\u0b9a\u0bbe\u0bb0\u0bcd\n\n\u1f9a\u0bb2\u0bb5\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0bc7\u0bb5\u1fa0 \u1f9a\u0bb2\u0bb5\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd\n\n\u0ba4\u0ba9\u0bcd\u0bc8\u0bae.\n\n(\u0b87) \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc2\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bbf\u0ba4\u0bbf\u0b9a\u0bbe\u0bb0\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0bc7\u0bb5\u1fa0\n\n\u1f9a\u0bb2\u0bb5\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b89\u0bc8\u0bb4\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f, \u0bc6\u0baa\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0bb2\u0bcd\u0bb2\u1f90\n\n\u0bc7\u0bb5\u1fa0\u0bb5\u0bc8\u0b95\u0baf\u0bbe\u0b95\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u1f99\u0bc8\u0bb1.\n\n(\u0b88) \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc2\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b86\u0ba4\u0ba9\u0bae\u0bcd \u0b8e\u0bb5\u0bcd\u0bb5\u0bbe\u0bb3\u0bbf\u0b9f\u0bae\u0bbf\u1f9e\u0ba8\u0bcd\u1f90"
