1f9e\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd \u0b95\u0bbe\u0bb0\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u1f99\u1fa8\u0baa\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd\u0b95\u1fa6\u0bae\u0bcd \u0b85\u0bc8\u0b9f\u0baf\u0bbe\u0bb3 \u0b87\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97\u0bae\u0bcd \u0b88\u1f8c, \u0b95\u0bc1\u0ba4\u0bcd \u0b95\u0bc1\u0bbe\u0bbf\u0baf \u0b9a\u0b9f\u0bcd\u0b9f\u0b99\u0bcd \u1f90\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd (\u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd) \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u1f9c\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0bc8\u0b9f \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd \u0b87\u0baf\u0bb2\u0bcd\u1f97\u0bae\u0bcd \u0ba4\u0bc8\u0b95 \u0b95\u1fa6\u0bb3\u0bcd \u0b8e\u0bb5\u0bcd \u0b87\u0bb2. \u0b87\u0bb2. \u0ba4\u1f8c\u0baa\u0bcd\u1f97\u0b95\u0bcd \u0bb5\u0bc8\u0b95\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3 \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u0ba4\u0bbf\u1f9e\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0baa\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bb3\u0bcd\n\n1:12 0.3599 \u0bb0\u0ba3\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0bb2\u0bb2\u0bbe\u0bc7\u0b95 \u0b9a\u0bae\u0ba9\u0bcd 571580535V \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0bb5\u1f90 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 \u0b8e\u0ba4\u0bbf\u0bbe\u0bbf\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 _ \u0bb0\u0ba4\u0bcd\u0ba9\u0b9a\u0bbe\u0bb0 \u0bb0\u0ba3\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0bb2\u0bbe\u0bc7\u0b95 65/1, \u0b9c\u0baf\u0ba8\u0bcd\u0ba4\u0bbf\u1f97\u0bb0 \u1faa\u0ba4\u0bbf, \u0b95\u0bc1\u1f9e\u0ba8\u0bbe\u0b95\u0bb2\u0bcd. \u0b9e\u0bbe\u0ba3\u0bb5\u0ba4\u0bc0 \u0b8e\u0ba9\u0bcd\u0baa\u0bb5\u0bb0\u1f90 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90. 1:42 0.1137 \u0bc7\u0ba4\u0bb5\u0ba8\u0bbe\u0bb0\u0bbe\u0baf\u0ba9 \u0bb9\u0bbf\u0ba4\u0bcd\u0ba4\u0bb0 \u0bc6\u0b95\u0ba4\u0bb0 \u0b9a\u0bae\u0ba8\u0bcd\u0ba4 198202703648 \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0bb5\u1f90 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 \u0bb5\u0bbf\u0bc7\u0b9c\u0b9c\u0bcd\u0ba4\u0bcd\u0bb0 _ \u0b8f\u0b95\u0ba8\u0bbe\u0baf\u0b95 \u0ba8\u0baf\u0bcd\u0bc6\u0ba4\u0bb2\u0bbe\u0bc7\u0b95 \u0b9c\u0baf\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0bb8\u0bcd\u0bc7\u0b9f\u0bbe\u0bb0\u0bcd\u0bb8\u0bcd, \u0b86\u0bbe\u0bbf\u0baf\u0bb5\u0ba4\u0bc0 \u0ba4\u0bb2\u0bcd\u0bc6\u0b95\u0bbe\u0b9f, \u0b95\u0bc1\u1f9e\u0ba8\u0bbe\u0b95\u0bb2\u0bcd. \u0b8e\u0ba9\u0bcd\u0baa\u0bb5\u0bb0\u1f90 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90. 1:43 0.0124 \u0bc7\u0ba4\u0bb5\u0ba8\u0bbe\u0bb0\u0bbe\u0baf\u0ba9 \u0bb9\u0bbf\u0ba4\u0bcd\u0ba4\u0bb0 \u0bc6\u0b95\u0ba4\u0bb0 \u0b9a\u0bae\u0ba8\u0bcd\u0ba4 198202703648 \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0bb5\u1f90 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 \u0bb5\u0bbf\u0bc7\u0b9c\u0b9c\u0bcd\u0ba4\u0bcd\u0bb0 _ \u0b8f\u0b95\u0ba8\u0bbe\u0baf\u0b95 \u0ba8\u0baf\u0bcd\u0bc6\u0ba4\u0bb2\u0bbe\u0bc7\u0b95 \u0b9c\u0baf\u0b9a\u0bbf\u0b99\u0bcd\u0bb9 \u0bb8\u0bcd\u0bc7\u0b9f\u0bbe\u0bb0\u0bcd\u0bb8\u0bcd, \u0ba4\u0bb2\u0bcd\u0bc6\u0b95\u0bbe\u0b9f, \u0b86\u0bbe\u0bbf\u0baf\u0bb5\u0ba4\u0bc0 \u0b95\u0bc1\u1f9e\u0ba8\u0bbe\u0b95\u0bb2\u0bcd. \u0b8e\u0ba9\u0bcd\u0baa\u0bb5\u0bb0\u1f90 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90. EOG 08 - 0140 / 26\n\n1998 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u1f90\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u1fab\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd\n\n14 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95