b4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a 1\u0db65 \u0dc3 - \u0d89\u0dca\u0dad\u0daf\u0dd2\u0d9a \u0dc3\u0db8\u0dca\u0dad \u0d9a\u0dd4\u0db8\u0dcf\u0dbb 2\u0db69 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0d82\u0d9a 5501331 , \u0dbb\u0dab\u0dc0\u0dd2\u0dbb\u0dd4 \u0d9c\u0db8\u0dca\u0db8\u0dcf\u0db1\u0dba, \u0db4\u0dbb\u0dc0\u0dba\u0dba\u0dcf\u0dcf \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0db4\u0db1\u0dcf\u0dba\u0d9c\u0ddc\u0da9, \u0dba \u0dcf\u0db8\u0dcf\u0d9c\u0db8 \u0dc3\u0db8\u0d9c \u0dc3 \u0d89\u0da9\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dba\u0d9a\u0ddc\u0db8\u0dd2\u0dc3\u0db8\u0dca \u0dc3\u0db7\u0dcf\u0dba\u0dda \u0dba\u0d9a\u0ddc\u0dca\u0dad\u0dba\u0dca\u0db0\u0dc3\u0dd2\u0daf\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dda\u0dc0 1:29\u0db6 000427 \u0d9a\u0dd2\u0dbb\u0dd2\u0dc0\u0dbd \u0d9c\u0db8\u0dba\u0dda \u0d9a\u0dae\u0dd2\u0d9a \u0db1\u0dc0 \u0dc0\u0db1 19771\u0db6202410 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a 1\u0db65 \u0dc3 - \u0d9a\u0d82\u0d9a 550191 , \u0dbb\u0dab\u0dc0\u0dd2\u0dbb\u0dd4\u0d9c\u0db8, 2\u0db69 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dd0\u0dbd\u0dd1\u0daf\u0dba\u0d9c\u0ddc\u0da9 \u0db4\u0dcf\u0dbb, \u0db4\u0db1\u0dcf\u0dba\u0d9c\u0ddc\u0da9, \u0db4\u0dbb\u0dc0\u0dba\u0dba\u0dcf\u0dcf \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dba \u0dcf\u0db8\u0dcf\u0d9c\u0db8 \u0dc3\u0db8\u0d9c \u0dc3 \u0db8\u0dcf\u0dc3\u0dc4\u0dd2\u0dcf \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0d9a\u0dad\u0dd4\u0dbb\u0dd4\u0d9c\u0dd2\u0dbb\u0dd2\u0dba \u0dc3\u0d9a\u0dc3\u0dd4\u0dbb\u0dd4\u0dc0\u0db8\u0dca \u0dcf \u0dab\u0dba\u0d9c\u0db1\u0dd4\u0dba\u0daf\u0db1\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u0db8\u0dd2\u0dad\u0dd2\u0dba\u0da7 \u0dcf\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d9a\u0d82\u0d9a 9