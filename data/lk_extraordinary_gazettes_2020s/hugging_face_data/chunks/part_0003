\u0dbb\u0dc5 987542799V \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba - - \u0db1\u0dd2\u0dbe\u0dc5\u0dca\u0dad\u0dad\u0dd2 \u0db4\u0dd4\u0dbf\u0dc4\u0db4\u0dd2\u0d9a\u0dc5 \u0d9a\u0d82\u0d9a 4;18141 , 3 \u0dbd\u0db1 \u0db3\u0da7\u0dd4\u0db8\u0d9c, \u0dba\u0dc1\u0dda\u0db1\u0dbd\u0dda\u0dcf, \u0db8\u0dd3\u0dba\u0d9c\u0ddc\u0da9 EOG 08-0260/23\n\n1998 \u0d85\u0dd2\u0d82 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2 \u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad\n\n\u0d8b\u0db4\u0dc1\u0dda\u0d9b\u0db1\u0dba \u2013 (\u0dc0\u0db8\u0dca\u0db6\u0dca\u0dad\u0db0\u0dd2\u0dad\u0dba\u0dd2) \u0dc0\u0dd2\u0db1\u0dd2\u0dbe\u0dc4\u0da0\u0dba\u0dca\u0dad \u0dc0\u0dc1 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dba\u0dbe\u0dda\u0dbf \u0dba\u0dc1\u0dcf \u0d89\u0dca\u0dad\u0dba\u0da2\u0dcf\u0dca\u0dad\u0dbf\u0dca\u0dad \u0dcf\u0dc1\u0db1\u0db8\u0dca \u0dba\u0db3\u0dde\u0dca\u0db0\u0d9c\u0dbd\u0dd2\u0d9a \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dbe\u0dc5\u0dbc\u0dda\u0dbd\u0dba \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dba\u0dda1\u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dbd\u0dca\u0dad\u0dba\u0dda \u0da2\u0dcf\u0dc5\u0dad\u0dd2\u0d9a \u0d9a\u0dba\u0dd2\u0dad\u0dd2 \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0dda \u0d9a\u0dba\u0dda\u0d9a\u0dca\u0d9a\u0dba\u0dbf\u0dc5\u0dba\u0dbd\u0dca\u0dad \u0d87\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dda \u0dba\u0d9a\u0ddc\u0da7\u0dba\u0dc0\u0dda \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db1\u0db81\u0db1\u0db8\u0dca \u0dc0\u0dc1 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u0dc1\u0dc6\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db3\u0dda \u0d89\u0da9\u0dba\u0db8\u0dca \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dc0\u0dc1 \u0d8b\u0d9a\u0dc0\u0dc4 \u0dc0\u0dc1 \u0db6\u0dc6\u0db3\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dca \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db2 \u0d9a