u0dba\u0dda \u0db8\u0dcf\u0dcf\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dba \u0dba \u0dba\u0db8\u0d9a \u0d9a \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc1\u0dcf\u0dda\u0dba\u0dda\u0d85 \u0d9a\u0d82\u0d9a 1 \u0d92 - \u0d9f\u0dd4\u0dda\u0dcf\u0dd0\u0da7\u0dd2\u0dba \u0db6\u0da7\u0d9f\u0dd4\u0dbb \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd \u0dcf\u0dbb\u0dd2 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc1\u0dcf\u0dda\u0dba \u0dad\u0dd4\u0dc5 \u0db4\u0dd2\u0d9f\u0dd4\u0da7\u0dd2 \u0d9f\u0dd4\u0dda\u0dcf\u0dd0\u0da7\u0dd2\u0dba \u0db6\u0da7\u0d9f\u0dd4\u0dbb \u0d9c\u0db8\u0da7 \u0dba\u0dc4\u0ddd \u0d89\u0dca\u0dad \u0dba\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0da7 \u0dba\u0dc4\u0ddd \u0d9a\u0dc5\u0dcf\u0db4 \u0d9a\u0d82\u0d9a 02\u0d9f\u0dd4 \u0db4\u0dad\u0dca\u200d\u0dbb \u0d9a\u0d82\u0d9a 01 \u0da7 \u0d9a\u0daf\u0dcf\u0dbd\u0dc0 1998 \u0d9a\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u0d9f\u0dd4\u0db8\u0dd2\u0d9a \u0d9a \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba \u0d9a \u0db4\u0db1\u0dba\u0dda 11 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dba\u0dda \u0db8\u0dd2\u0db1\u0dd4 \u0d9a\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0daf\u0dca\u0dad \u0dc3\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0d9a\u0d82\u0d9a 820009 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0 \u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0dba \u0d9a \u0daf\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0d89 \u0d9a \u0dba\u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0d91\u0d9a\u0d9a \u0dba\u0dc4\u0ddd \u0d8a\u0da7 \u0dc0\u0dd0\u0da9\u0dd2 \u0d9c\u0dab\u0db1\u0d9a \u0dba\u0dc4\u0ddd \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0da7 \u0db1\u0dd0\u0dcf\u0dba\u0dc4\u0ddc\u0dda \u0dc3\u0dca\u0dad\u0dcf\u0d9a\u0dba\u0da7 \u0dba\u0dc4\u0ddd \u0dc3 \u0d9a\u0db6\u0dca\u0dad \u0dcf\u0dcf\u0dc0\u0dba\u0d9a\u0da7 \u0d9f\u0dd4\u0db8\u0dd2\u0d9a \u0d9a \u0db4\u0dcf\u0db1 \u0d9a\u0dc0\u0dbb \u0dc0\u0dd4\u0dc0\u0daf \u0dcf\u0dd0\u