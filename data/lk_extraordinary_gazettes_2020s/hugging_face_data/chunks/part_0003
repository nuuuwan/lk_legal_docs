0dd9\u0118 \u0d85\u0d82\u0d9a\u0dba: 4-3/7/2021/ HW/371.2025 \u0d85\u0dd9\u021d\u02a2\u0262 \u0db8\u0dc3 09 \u0dc0\u0dd0\u01e7 \u01ce\u0db1,\u0d9a\u0dd8\u027f\u0d9a\u0259\u0db8, \u0db4\u0276 \u0dc3\u023c\u0db4\u01ae, \u0d89\u0da9\u023c \u0dc3\u0dc4 \u0dc0\u0dcf\u025c\u0db8\u0dcf\u0259\u0d9c \u0d85\u0db8\u0dcf\u0dad\u0255\u0dcf\u0d82\u0dc1\u0dba,\u201c\u023d\u028f\u0d9a\u0dad \u0db8\u0dd0\u01d0\u0dbb \u02ee, \u0dbb\u0da2\u0db8\u0262\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbb,\u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd.\n\nEOG 08 \u2013 0110\n\n\u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dad (460 \u0dc0\u0dd0\u01e7 \u0db4\u025c\u013c\u0dd9\u0146\u0daf\u0dba) 5 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u021d\u0d9a\u0dcf\u0dc1\u0dba\n\n\u0dd9\u0db8\u028f \u0db4\u0dc4\u0dad \u026a\u0dc3\u0dca\u0dad\u0dbb \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d89\u0da9\u023c, \u0dd9\u0db4\u02a3\u01d0\u0da2\u0db1 \u0d9a\u0da7\u0252\u01ae\u0dad\u00fa \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0255 \u0dc0\u0db1 \u0db6\u0dc0\u01ae, \u0d92\u0dc0\u0dcf \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae \u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u0dba\u0da7\u0dd9\u01ae \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u01e9 \u0dbd\u0db6\u0db1 \u0db6\u0dc0\u01ae, \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 5 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (1) \u0d8b\u0db4 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae, \u0d9a\u0dd8\u027f\u0d9a\u0259\u0db8, \u0db4\u0276 \u0dc3\u023c\u0db4\u01ae, \u0d89\u0da9\u023c \u0dc3\u0dc4 \u0dc0\u0dcf\u025c\u0db8\u0dcf\u0259\u0d9c \u0d85\u0db8\u0dcf\u0dad\u0255 \u00fd\u0dbb\u0d9c\u0db8\u0dd9\u0118 \u0dd9\u0daf\u02a3\u01e6 \u0dbd\u0dcf\u0262 \u0d9a\u0dcf\u01e6\u0dad \u0dc0\u0db1 \u0db8\u0db8 \u0dd9\u0db8\u0250\u01e6 \u021d\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u023d.\n\n\u0db8\u0db0\u0255\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0db8\u0dc4\u01e9\u0dc0\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0d8b\u018d\u01e9\u0dc0\u0dbb \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u023e\u0dc0\u01b1\u0dbb (20) \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u023e\u0dc0\u01b1\u0dbb \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u023c \u0d85\u0d82\u0d9a 320334 \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a. 03, \u0db4\u01b4 \u0d85\u0d82\u0d9a. 07 \u0dc4\u0dcf 2018.07.17 \u01ce\u0db1\u0dd0\u01af \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0dd9\u023c \u0dc3\u026a\u0dc3\u0dca\u0dad\u0dbb\u0dc0 \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0db1\u023c\u0dc0\u0263\u01e6 \u0dc4\u0dcf \u021d\u0db8\u0dcf\u0dab\u0dc0\u0263\u01e6 \u0252\u00fa\u0dad \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0263 \u0dc0\u0dbd\u0da7 \u0db8\u0dcf\u0250\u023c:\n\n01. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a. 152 - \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a - \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0001 \u0d8b\u01b1\u0dbb\u0da7: \u0d9a\u0dd0\u0286 320287; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0d9a\u0dd0\u0286 320287 \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a. 151; \u0daf\u00fd\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a. 151 \u0dc3\u0dc4 10; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a. 10.\n\n02. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a. 153 - \u0dd9\u0dc3\u02a3\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u02a3\u0dc4\u0dd0\u0d9a - \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa