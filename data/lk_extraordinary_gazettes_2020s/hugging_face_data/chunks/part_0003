\u1f90 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u1f9e\u0b95\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd \u0b95\u0bbe\u0bb0\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u1f99\u1fa8\u0baa\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd\u0b95\u1fa6\u0bae\u0bcd \u0b85\u0bc8\u0b9f\u0baf\u0bbe\u0bb3 \u0b87\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97\u0bae\u0bcd \u0b88\u1f8c, \u0b95\u0bc1\u0ba4\u0bcd \u0b95\u0bc1\u0bbe\u0bbf\u0baf \u0b9a\u0b9f\u0bcd\u0b9f\u0b99\u0bcd \u1f90\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd (\u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd) \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u1f9c\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0bc8\u0b9f \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd \u0b87\u0baf\u0bb2\u0bcd\u1f97\u0bae\u0bcd \u0ba4\u0bc8\u0b95 \u0b95\u1fa6\u0bb3\u0bcd \u0b8e\u0bb5\u0bcd \u0b87\u0bb2. \u0b87\u0bb2. \u0ba4\u1f8c\u0baa\u0bcd\u1f97\u0b95\u0bcd \u0bb5\u0bc8\u0b95\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3 \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u0ba4\u0bbf\u1f9e\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0baa\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bb3\u0bcd\n\n1:42 0.1216 \u0b9a\u0bbf\u0b99\u0bcd\u0b95\u0baa\u0bcd\u1f97\u1fa2 \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0bc7\u0b95 \u0bc7\u0bb0\u0bbe\u0bb9\u0ba3 780080329V \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0bb5\u1f90 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 \u0bb0\u0ba4\u0bcd\u0ba8\u0bbe\u0baf\u0b95 _ \u0bb5\u0bbf\u0b9c\u0baf\u0b9a\u0bbf\u0bbe\u0bbf \u1f99\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0b87\u0bb9\u0bb2\u0bb5\u0ba4\u0bcd\u0ba4, \u0bc7\u0baa\u0bbe\u0b95\u1f99\u0bb5, \u0b9a\u0ba8\u0bcd\u0ba4\u0bcd\u0bb0\u0baa\u0bbe\u0bb2 \u0bc7\u0baa\u0bbe\u0baf\u0b95\u0bc7\u0ba9. \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba4\u0bb8\u0ba8\u0bbe\u0baf\u0b95 \u1f99\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0b87\u0ba8\u0bcd\u0ba4\u0bcd\u0bb0\u0bbe\u0bb5\u0ba4\u0bc0 \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bb0\u1f90 \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90.\n\n1:43 0.2946 \u0bb0\u0ba4\u0bcd\u0ba8\u0bbe\u0baf\u0b95 \u1f99\u0ba4\u0bbf\u0baf\u0ba9\u0bcd\u0bc7\u0b9a\u0bb2\u0bbe\u0bc7\u0b95 \u0bc7\u0baa\u0bae\u0bbe\u0bb5\u0ba4\u0bc0 545220695V \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0bb5\u1f90 \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 _ _ \u0b87\u0bb2. 50, 2\u0bb5\u1f90 \u0b92\u1fa8\u0b99\u0bcd\u0bc8\u0b95, \u0ba4\u0bb5\u0bb2\u0bae\u0bcd\u0baa\u0bbf\u1f8a\u0baf, \u0bae\u0bc0\u0bbe\u0bbf\u0b95\u0bae. EOG 08 - 0140 / 33"
