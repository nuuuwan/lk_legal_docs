9a\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bbf\u0baf\u0bc1\u0b9f\u0ba9\u0bcd (S) \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bc1 (3) \u0b9a\u0bbe\u0bbe\u0ba4\u0bbe\u0bbe\u0bb0\u0ba3 \u0b9a\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bcd (S) \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b85\u0ba4\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0b9a\u0bae\u0bae\u0bbe\u0bbe\u0ba9 \u0ba4\u0b95\u0bc8\u0bc8\u0bae\u0bc8\u0bc8\u0b95\u0bb3\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bc0\u0bc0\u0b9f\u0bcd\u0b9a\u0bc8\u0bc8\u0b95\u0bb3\u0bcd \u0ba4\u0bbf\u0bbf\u0ba3\ufffd\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bbe\u0bbe\u0bb2\u0bcd \u0ba8\u0b9f\u0bbe\u0bbe\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b95.\u0baa\ufffd\u0bca.\u0ba4\u0ba4. (\u0b9a\u0bbe\u0bbe\u0ba4\u0bbe\u0bbe\u0bb0\u0ba3 \u0ba4\u0ba4\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bbf\u0bb2\u0bcd) \u0b95\u0ba3\u0bbf\u0bbf\u0ba4\u0ba4 \u0baa\u0bbe\u0bbe\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bbf\u0bb2\u0bcd \u0ba4\u0bbf\u0bbf\u0bbf\u0bb1\u0bae\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bbf (C) \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b85\u0ba4\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0b9a\u0bae\u0bae\u0bbe\u0bbe\u0ba9 \u0ba4\u0b95\u0bc8\u0bc8\u0bae\u0bc8\u0bc8\u0b95\u0bb3\u0bcd.\n\n3. \u0bb8\u0bcd\u0bb0\u0bc0\u0bb2\u0b99\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0bbe \u0b87\u0ba9\u0bcd\u0bb8\u0bcd\u0b9f\u0bbf\u0b9f\u0bbf\u0baf\u0bc2\u0b9f\u0bcd \u0b92\u0baa\u0bcd \u0b87\u0ba9\u0bcd\u0baa\u0bcb\u0bae\u0bc7\u0bb7\u0ba9\u0bcd \u0b9f\u0bc6\u0b95\u0bcd\u0ba9\u0bcb\u0bb2\ufffd\u0bca\u0b9c\u0bbf\u0bbf (\u0b89\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0bb0\u0bb5\u0bbe\u0ba4\u0ba4\u0bae\u0bcd) \u0bb2\u0bbf\u0bae\u0bbf\u0bbf\u0b9f\u0bcd\u0bcd\u0b9f\u0b9f\u0bc6\u0b9f\u0bcd \u0b86\u0ba9\u0ba4\u0bc1, \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb0\u0bc8\u0