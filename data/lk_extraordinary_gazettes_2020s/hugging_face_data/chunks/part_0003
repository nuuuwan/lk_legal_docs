b\u0dd9\u0dba\u01e6 \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 0.0976\u00fa \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0db1\u023c\u0dc0\u0263\u01e6 \u0dc4\u0dcf \u021d\u0db8\u0dcf\u0dab\u0dc0\u0263\u01e6 \u0252\u01ae \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0263\u0dc0\u0dbd\u0da7 \u0db8\u0dcf\u0250\u023c:\n\n01. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb \u2018\u0d92\u2019 \u2013 \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0007\u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb \u2018\u0d92\u2019 \u2013 \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0007 \u0d8b\u01b1\u0dbb\u0da7: \u0db4\u0dcf\u0dbb \u0dc3\u0dc4 \u0d91\u023c.\u018c. \u025c\u013e \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d9a\u0dd4\u025e\u0217\u021a\u0dd9\u0d9c\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0289\u025c\u0dba\u0db4\u0dcf\u029a\u0dc0\u0dc0\u01ae\u0dad; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: 510810 \u0dc0\u0dd0\u01e7 \u0d9a\u0da9\u0250\u023c \u0286\u01af\u0dba\u0dd9\u023c 7 \u0dc0\u0dd0\u01e7 \u0d9a\u0dbd\u0dcf\u0db4\u0dd9\u024f 7 \u0dc0\u0dd0\u01e7 \u0db4\u01b4\u0dd9\u024f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 536 \u0dc3\u0dc4 534; \u0daf\u0d9a\u0dd4\u0dab\u0da7: 510810 \u0dc0\u0dd0\u01e7 \u0d9a\u0da9\u0250\u023c \u0286\u01af\u0dba\u0dd9\u023c 7 \u0dc0\u0dd0\u01e7 \u0d9a\u0dbd\u0dcf\u0db4\u0dd9\u024f 7 \u0dc0\u0dd0\u01e7 \u0db4\u01b4\u0dd9\u024f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 534, 538 \u0dc3\u0dc4 \u0dd9\u0db8\u0db8 \u0d85\u01e9\u0dd9\u0259\u0d9b\u0db1\u0dd9\u024f\n\n\u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb B; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb B, \u0d91\u023c.\u018c. \u025c\u013e \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d9a\u0dd4\u025e\u0217\u021a\u0dd9\u0d9c\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0289\u025c\u0dba\u0db4\u0dcf\u029a\u0dc0\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u0db4\u0dcf\u0dbb."
