baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0bcd \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd / \u0b89\u0baa \u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd \u0b86\u0b95\u0bbf\u0bbf\u0baf \u0baa\u0ba4\u0bb5\u0bbf\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0bc7\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\ufffd\u0bcb\u0bb0\u0bcd \u0bb5\u0bbf\u0bbf\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bbf\u0bbf\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\ufffd\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0bb5\u0bbe\u0bbe\u0bb1\u0bc1 \u0b85\u0bae\u0bc8\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b8e\u0ba9 \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb2\u0bcd \u0b85\u0bb1\u0bbf\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bb0\u0bc1\u0b95\u0bbf\u0bbf\u0bb1\ufffd\u0ba9\u0bcd.\n\n\u0b8e\u0bb0\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf \u0b89\u0bae\u0b99\u0bcd\u0b95\u0bbe\u0bbe \u0bae\u0bc6\u0bc6\u0ba9\u0bcd\u0ba4\u0bbf\u0bbf\u0bb8\u0bcd\u0b8e\u0bb0\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf \u0b89\u0bae\u0b99\u0bcd\u0b95\u0bbe\u0bbe \u0bae\u0bc6\u0bc6\u0ba9\u0bcd\u0ba4\u0bbf\u0bbf\u0bb8\u0bcd, \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\ufffd\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf \u0b86\u0ba3\ufffd\u0baf\u0bbe\u0bbe\u0bb3\u0bbe\u0bcd\u0bcd\u073c, \u0ba4\u0bc6\u0bc6\u0ba9\u0bcd \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3\u0bae\u0bcd.\u0ba4\u0bc6\u0bc6\u0ba9\u0bcd \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3 \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\ufffd\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0ba3\ufffd\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd,6 \u0b86\u0bae\u0bcd \u0bae\u0bbe\u0bbe\u0b9f\u0bbf,\u0b95\u0bbe\u0bbe\u0bb2\u0bbf \u0bae\u0bbe\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f \u0b9a\u0bc6\u0bc6\u0baf\u0bb2\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bbf\u0b9f\u0bae\u0bcd,2025, \u0baf\u0bc2\u0bb2\u0bc8\u0bc8 31.\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\ufffd\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\ufffd\n\n\u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd I \u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd II \u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd III \u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd IV \u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd I \u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd II \u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd III \u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd IV\n\n\u0bae\u0bbe\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0 \u0b95\u0bc6\u0bc6\u0bb3\u0bb0\u0bb5 \u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd/ \u0ba4\ufffd\u0bcd\u073c\u0ba8\u0bcd\u0ba4\u0bc6\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0bae\u0bbe\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0 \u0b95\u0bc6\u0bc6\u0bb3\u0bb0\u0bb5 \u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd/ \u0ba4\ufffd\u0bcd\u073c\u0ba8\u0bcd\u0ba4\u0bc6\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf \u0b9a\u0baa\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0bc6\u0bc6\u0baf\u0bbe\u0bcd\u0bcd\u073c \u0b89\u0baa \u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bbe\u0bcd\u0bcd\u073c\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0bc6\u0bc6\u0baf\u0bbe\u0bcd\u0bcd\u073c \u0b9a\u0baa\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0bc6\u0bc6\u0baf\u0bbe\u0bcd\u0bcd\u073c \u0b89\u0baa \u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bbe\u0bcd\u0bcd\u073c\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0bc6\u0bc6\u0baf\u0bbe\u0bcd\u0bcd\u073c\n\n\u0bae\u0bbe\u0bbe\u0ba4\u0bcd\u0ba4\u0bb1\u0bc8\u0bc8\u0bae\u0bbe\u0bbe\u0ba4\u0bcd\u0ba4\u0bb1\u0bc8\u0bc8 \u0bb5\ufffd\u0bb2\u0bbf\u0b95\u0bae \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8 \u0bb5\ufffd\u0bb2\u0bbf\u0b95\u0bae \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8 \u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bbe\u0bcd\u0bcd\u0ba4\u0bb5\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0bb3\u0bbe\u0bcd\u0bcd\u073c \u0bb2\u0b9a\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0bb0\u0bae\u0b9a\u0bc7\u0bc7\u0b95\u0bb0 2025.07.24\u0bb2\u0b9a\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0bb0\u0bae\u0b9a\u0bc7\u0bc7\u0b95\u0bb0 2025.07.24\n\n\u0b89\u0baa \u0ba4\u0bb5\u0bbf\u0b9a\u0bbe\u0bb3\u0bbe\u0bcd\u0b89\u0baa \u0ba4\u0bb5\u0bbf\u0b9a\u0bbe\u0bb3\u0bbe\u0bcd \u0ba4\u0bc6\u0bc6\u0ba9\u0b95\u0bae \u0bb0\ufffd\u0b95\u0bc1\u0bb2 \u0ba4\u0bc7\u0bc7\u0bb0\u0bb0\u0bcd 2025.07.24\u0ba4\u0bc6\u0bc6\u0ba9\u0b95\u0bae \u0bb0\ufffd\u0b95\u0bc1\u0bb2 \u0ba4\u0bc7\u0bc7\u0bb0\u0bb0\u0bcd 2025.07.24\n\nEOG 08 - 0130EOG 08 - 0130\n\n,yq;if murhq;f mr;Rj; jpizf;fsj;jpw; gjpg;gpf;fg;ngw;wJ."
