0bae\u0bc1\u0b95\u0bbe\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bcd)\n\n\u0bae\u0bc1\u0b95\u0bbe\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5 \u0ba4\u0b95\u0bb5\u0bb2\u0bcd \u0bae\u0bc1\u0bb1\u0bc8\u0bae\u0bc8\u0b95\u0bb3\u0bbf\u0bbf\u0bb2\u0bcd \u0bb5\u0ba3\u0bbf\u0b95 \u0ba8\u0bbf\u0bbf\u0bbe\u0bcd\u0bb5\u0bbe\u0b95 \u0b87\u0bb3\u0bae\u0bbe\u0ba3\u0bbf\u0bbf \u0b9a\u0bbf\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1\u0baa\u0bc0\u0baa\u0bc0\u0b8f \u0b9a\u0bbf\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1 (\u0ba4\u0b95\u0bb5\u0bb2\u0bcd \u0bae\u0bc1\u0bb1\u0bc8\u0bae\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bc1\u0b95\u0bbe\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bcd)\n\n\u0bb5\u0ba3\u0bbf\u0b95 \u0bae\u0bc1\u0b95\u0bbe\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0bb2\u0bcd \u0bb5\u0ba3\u0bbf\u0b95 \u0ba8\u0bbf\u0bbf\u0bb0\u0bcd\u0bcd\u0bb5\u0bb5\u0bbe\u0b95 \u0b87\u0bb3\u0bae\u0bbe\u0ba3\u0bbf\u0bbf \u0b9a\u0bbf\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1\u0baa\u0bc0\u0baa\u0bc0\u0b8f \u0b9a\u0bbf\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1 (\u0bb5\u0ba3\u0bbf\u0b95 \u0bae\u0bc1\u0b95\u0bbe\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bcd)\u0ba4\u0ba4\n\n\u0bb0 \u0bae\u0bc1\u0b95\u0bbe\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0bb2\u0bcd \u0bb5\u0ba3\u0bbf\u0b95 \u0ba8\u0bbf\u0bbf\u0bb0\u0bcd\u0bcd\u0bb5\u0bb5\u0bbe\u0b95 \u0b87\u0bb3\u0bae\u0bbe\u0ba3\u0bbf\u0bbf \u0b9a\u0bbf\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1\u0baa\u0bc0\u0baa\u0bc0\u0b8f \u0b9a\u0bbf\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1 (\u0ba4\u0ba4\u0bb0 \u0bae\u0bc1\u0b95\u0bbe\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bcd)\u0ba4\u0ba4\n\n\u0bb0\u0bb5\u0bc1 \u0bb5\u0bbf\u0bbf\u0bbf\u0b9e\u0bcd\u0b9e\u0bbe\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0bbf\u0bbf\u0b9e\u0bcd\u0b9e\u0bbe\u0bbe\u0ba9 \u0b87\u0bb3\u0bae\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf\u0bbf \u0b9a\u0bbf\u0bbf\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1\u0baa\u0bc0\u0b8e\u0bb8\u0bcd\u0b9a\u0bc0 \u0b9a\u0bbf\u0bbf\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1 (\u0ba4\u0ba4\u0bb0\u0bb5\u0bc1 \u0bae\u0bc1\u0b95\u0bbe\u0bbe\u0bae\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bcd)\n\n\u0bae\u0bc6\u0ba9\u0bcd\u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bcd \u0baa\ufffd\u0bca\u0bb1\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0baf\u0bb2\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0bbf\u0b9e\u0bcd\u0bcd\u0b9e\u0b9e\u0bbe\u0bbe\u0ba9 \u0b87\u0bb3\u0bae\u0bbe\u0ba3\u0bbf\u0bbf \u0b9a\u0bbf\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1\u0baa\u0bc0\u0b8e\u0bb8\u0bcd\u0b9a\u0bc0 \u0b9a\u0bbf\u0bbf\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1 (\u0bae\u0bc6\u0bc6\u0ba9\u0bcd\u0baa\ufffd\u0bca\u0bb0\u0bc1\u0bb3\u0bcd \u0baa\ufffd\u0bca\u0bb1\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bbf\u0baf\u0bb2\u0bcd)\n\n\u0b95\u0bb2\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf\u0ba4\u0bbf\u0b95\u0bb2\u0bbe\u0ba8\u0bbf\u0ba4\u0bbf\u0ba4\u0bbf \u0bb9\u0bbe\u0bbf\u0bbf\u0ba3\u0bbf\u0bbf \u0b85\u0bae\u0bb0\u0b9a\u0bc2\u0bb0\u0bbf\u0bbf\u0baf, \u0bb9\u0bbe\u0bbf\u0bbf\u0ba3\u0bbf\u0bbf \u0b85\u0bae\u0bb0\u0b9a\u0bc2\u0bb0\u0bbf\u0bbf\u0baf, \u0b95\u0bb2\u0bcd\u0bcd\u0bb5\u0bb5\u0bbf\u0bbf, \u0b89\u0baf\u0bbe\u0bcd \u0b95\u0bb2\u0bcd\u0bcd\u0bb5\u0bb5\u0bbf\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb1\u0bcd\u0bcd\u0b95\u0bb2\u0bcd\u0bcd\u0bb5\u0bb5\u0bbf\u0bbf \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0bcd\u0b9a\u0b9a\u0bbe\u0b9a\u0bbe\u0bcd.\u0b95\ufffd\u0bca\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1,2025, \u0b93\u0b95\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1 14.\n\nEOG 08 - 232\n\n\u0b87\u0bb2\u0b99\u0bcd\u0bcd\u0b95\u0b95\u0bc8 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0bcd\u0b95 \u0b85\u0b9a\u0bcd\u0b9a\u0bc1\u0ba4\u0bcd\u0ba4\u0bcd \u0ba4\u0bbf\u0ba3\u0bc8\u0b95\u0bcd\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0ba4\u0bbf\u0ba4\u0bbf\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0bbf\u