u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u200d\u200d\ufffd\u0dc0\u0dda\u0dda\u0dda \u0dc3\u0db7\u0dd2\u0d9a \u0db0\u0dd6\u0dbb\u0dba\u0d9a\u0dca \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0dcf\u0da9\u0dd4 \u0dc0\u0dd3 \u0d87\u0dad\u0dd2 \u0dc4\u0dd9\u02e7\u0dba\u0dd2\u0db1\u0dca \u0daf;\n\n\u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\u0dda\u01ae 66\u0d85 (1)(\u0d85) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\u0dda\u01ae \u0db1\u0dcf\u0dcf\u0d9c\u0ddc\u02c3\u0ddc\u0da9 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u200d\u200d\ufffd\u0dc0\u0dda\u0dda\u0dda \u0d85\u0d82\u0d82\u0d9a 5 - \u0db1\u0dcf\u0dcf\u0d9c\u0ddc\u02c3\u0ddc\u0da9 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba\u0da7 \u0dad\u0dda\u0dda\u01ae\u0dbb\u0dd3 \u0db4\u0dad\u0dca\u0dc0\u0dd6 \u0db1\u0dcf\u0dcf\u0d9c\u0ddc\u02c3\u0ddc\u0da9 \u0d9c\u0db8\u0d9c\u0dda\u0dda\u0118 \u0daf\u0dd3\u0db4\u0dca\u0dad\u0dd2 \u0d9a\u0dcf\u0d82\u0d82\ufffd\u0da0\u0db1 \u0da0\u0dad\u0dd4\u0dbb\u0d82\u0d82\u0d9c \u0d85\u0dba\u0dad\u0dca \u0dc0\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dc0\u0dd6 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0db1 \u0db6\u0dbd\u0dc0\u0dda\u0dda\u0dda\u0d9c\u0dba \u0db1\u0db8\u0dca\u0dc0\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca \u0daf\u0dda\u0dda\u0dda\u0dc1\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda\u024f \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca\u0da7 \u0daf\u0dd2\u0db1 \u0dad\u0dd2\u0dc4 (30) \u0d9a \u0d9a\u0dcf\u0dcf\u0dbd \u0db4\u0dbb\u0dd2\u0da0\u0dca\u0da1\u0dda\u0dda\u0dda\u0daf\u0dba \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\u0dda\u01ae (262 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba) 9 \u0dc0\u0d9c\u0db1