: njhFjp (I) - ,yq;ifr; rdehaf Nrhryprf; FbauR tu;j;jkhdg; gj;jpupif - mjp tpNr\\khdJ - 2025.08.15\n\n3. 2024 \u0bae\ufffd 17 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 2384/34 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b85\u0ba4\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0b9a\u0bc7\u0bc7\u0b9f \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0bb5\ufffd\u0bb3\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 2024 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 07 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95, \u0b87\u0bb1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0ba4\u0bbf\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0ba4\u0bbf\u0bbf\u0b95\u0bcd (\u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1) \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bbf\u0bbf\u0bb2\u0bcd 12 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf, \u0b85\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd ''2025 \u0baf\u0bc2\u0ba9\u0bcd \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 30 \u0bb5\u0bb0\u0bc8\u0bc8\" \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc8\u0bc8 \u0b87\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b9a\u0bcd \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0ba4\u0bc1 ''2025 \u0b9a\u0bc6\u0bc6\u0baa\u0bcd\u0ba4\u0bc6\u0bc6\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 30 \u0bb5\u0bb0\u0bc8\u0bc8\" \u0b8e\u0ba9 \u0bae\u0bbe\u0bbe\u0bb1\u0bcd\u0bb1\u0bc0\u0b9f\u0bc1 \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0ba4\u0bc1 \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb2\u0bcd \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1.\n\n\u0b87\u0bb5\u0bcd \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bcd, \u0bae\ufffd\u0bb2\ufffd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 2025 \u0baf\u0bc2\u0bb2\u0bc8\u0bc8 24 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 25/1339/807/016-I \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bb5\u0bc8\u0bc8 \u0bb5\u0bbf\u0bbf\u0b9e\u0bcd\u0b9e\u0bbe\u0bbe\u0baa\u0ba9\u0bae\u0bcd \u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0bbe\u0ba9 2025 \u0b93\u0b95\u0ba4\u0bcd\u0ba4\u0bc1 04 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bb5\u0bc8\u0bc8\u0ba4\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bae\u0bc8\u0bc8\u0baf, 2024 \u0b8f\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0bb1\u0bb2\u0bcd 01 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 24/0644/615/003-I \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bb5\u0bc8\u0bc8 \u0bb5\u0bbf\u0bbf\u0b9e\u0bcd\u0b9e\u0bbe\u0bbe\u0baa\u0ba9\u0bae\u0bcd \u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0bbe\u0ba9 2024 \u0b8f\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0bb1\u0bb2\u0bcd 01 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bb5\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0b85\u0ba9\u0bc1\u0bae\u0ba4\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0b85\u0b9f\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0bb2\u0bbe\u0bbe\u0ba4\u0bcd\u0ba4\u0bc1\u0bb1\u0bc8\u0bc8 \u0bb5\u0bbf\u0bbf\u0b9f\u0baf\u0baa\u0bcd \u0baa\ufffd\u0bca\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1 \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bbf\u0bbf\u0ba9\u0bcd \u0b9a\u0bc6\u0bc6\u0baf\u0bb2\u0bbe\u0bbe\u0bb3\u0bb0\u0bbf\u0bbf\u0ba9\u0bbe\u0bbe\u0bb2\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u201c\u0bb5\u0bbe\u0bbe\u0b95\u0ba9 \u0b87\u0bb1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0ba4\u0bbf\u0bbf \u0b89\u0bb0\u0bbf\u0bbf\u0bae\u0bae\ufffd\u0bca\u0ba9\u0bcd\u0bb1\u0bbf\u0bbf\u0ba9\u0bcd\u201d \u0b95\u0bc0\u0bb4\u0bcd, 2025 \u0b9a\u0ba9\u0bb5\u0bb0\u0bbf\u0bbf 31 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd \u0ba8\u0bbf\u0bbf\u0bb1\u0bc1\u0bb5\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0b9f\u0ba9\u0bcd \u0b95\u0b9f\u0bbf\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0b87\u0bb1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0ba4\u0bbf\u0bbf \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd \u0bb5\u0bbe\u0bbe\u0b95\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0bc8 \u0b9a\u0bc1\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0bbf\u0bbf\u0b9f\u0bc1\u0bb5\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0baa\ufffd\u0bca\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1\u0bae\u0bcd."
