\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0,\u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd \u0dc3\u0d82\u0d82\u0d9a\u0dd3\u0dbb\u0dca\u0dab\u0dba, \u0db1\u0dc0 \u0db1\u0d9c\u0dbb\u0dba, \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb.\n\n\u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\n\n\u0daf\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda\u024f \u0db1\u0db8\n\n\u0dad\u0dda\ufffd\u0dbb\u0dd3\u0db4\u0dad\u0dca \u0dc0\u0dd6 \u0db0\u0dd6\u0dbb\u0dba\u0dad\u0dda\ufffd\u0dbb\u0dd3 \u0db4\u0dad\u0dca \u0dc0\u0dd6 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0dad\u0dda\ufffd\u0dbb\u0dd3 \u0db4\u0dad\u0dca \u0dc0\u0dd6 \u0daf\u0dd2\u0db1\u0dba\n\n\u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb\u0db4\u0dd0\u0dd0\u0dbd\u0dca\u0db8\u0da9\u0dd4\u0dbd\u0dca\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba\u0dc3\u0db7\u0dcf\u0dcf\u0dc0\n\n\u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0db8\u0dcf\u0dcf\u0db1\u0dd2\u0db4\u0dd4\u0dbb\u0dda\u0dda \u0d9c\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0db6\u0daf\u0dd4\u0dc0\u0dad\u0dca\u0dad\u0dd9\ufffd \u0d86\u0da0\u0dcf\u0dcf\u0dbb\u0dd2\u0d9c\u0dd9\ufffd \u0db0\u0dbb\u0dca\u0db8\u0dc3\u0dd2\u0dbb\u0dd2 \u0db8\u0dc4\u0dad\u0dcf\u0dcf2025.07.24\n\n\u0d8b\u0db4 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0dc4\u0dd9\ufffd\u0da7\u0dca\u0da7\u0dd2\u0d9c\u0ddc\ufffd\u0ddc\u0da9 \u0d9c\u0db8\u0d87\u0dad\u0dd2\u0d9c\u0dda\u0118 \u0db1\u0dbd\u0dd2\u0db1\u0dca \u0dc3\u0dda\ufffd\u0dda\u0db1\u0d9a \u0db8\u0dcf\u0dcf\u0d9c\u0db8\u0dca\u0db8\u0db1 \u0db8\u0dc4\u0dad\u0dcf\u0dcf2025.07.24\n\nEOG 09 - 0033\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dbb\u0da2\u0dba\u0dda\u024f \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3."
