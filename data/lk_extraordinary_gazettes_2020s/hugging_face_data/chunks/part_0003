\u023d\u0dba\u0da7 \u0dc0\u0dcf\u0dc4\u0db1 \u0d87\u01b1\u0dc5\u01ae \u00fb\u025d\u0db8 \u0dc3\u023c\u021b\u0259\u0dab\u0dd9\u0dba\u01e6 \u0db8 \u0dad\u0dc4\u0db1\u023c \u0d9a\u0dbb\u023d.\n\n04. \u0dd9\u0d9c\u02a3\u0da9\u0db1\u0dd0\u0119\u0263 \u0d89\u01ce\u00fb\u025d\u0db8 - 04. \u0dd9\u0d9c\u02a3\u0da9\u0db1\u0dd0\u0119\u0263 \u0d89\u01ce\u00fb\u025d\u0db8 -\n\n4.1. \u0db8\u0dcf\u0dd9\u0d9c\u01e6 \u0dd9\u0dc4\u02a4 \u0db6\u0dbd\u0dba\u0dbd\u01ae \u01e7\u0dbd\u0db0\u0dcf\u025c\u0dd9\u0dba\u00fd\u0dd9\u0118 \u0dd9\u0dc4\u02a4 \u0263\u0110\u0dad \u0d85\u0dc0\u0dc3\u0dbb\u0dba\u00fa \u0dd9\u0db1\u02a3\u0db8\u0dd0\u01af\u0dc0, 2025 \u0dc0\u0259\u0dc2\u0dd9\u024f \u0d85\u0dd9\u0d9c\u02a4\u0dc3\u0dca\u01b1 \u0db8\u0dc3 22 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0286\u0da7 \u0dc3\u0dd0\u0217\u0dad\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 08 \u0dc0\u0db1 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf \u0dc0\u0db1 \u0d9a\u0dcf\u0dbd\u0dba \u01b1\u0dc5 \u0d9a\u0db3\u026c\u025e \u021d\u0dd9\u01ca\u0dc1\u0dba \u01b1\u0dc5 \u0dba\u023c \u0db8\u018d\u0dc0\u00fa \u0dd9\u0dc4\u02a4 \u0dba\u023c \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0263\u0d9a \u0dd9\u0dc4\u02a4 \u0dc3\u0dca\u01c2\u0dbb \u0d89\u01ce\u00fb\u025d\u0db8\u00fa \u0dd9\u0dc4\u02a4 \u0dad\u0dd0\u01e8\u0db8\u00fa \u0dd9\u0dc4\u02a4 \u0daf\u0dd0\u0db1\u0da7 \u0db4\u0dc0\u01ae\u0db1\u0dcf \u0dba\u023c \u0dd9\u0d9c\u02a3\u0da9\u0db1\u0dd0\u0119\u0262\u0dbd\u0d9a\u0da7 \u0d85\u029a\u01af\u01e6 \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u00fa \u0d91\u0d9a\u01b1 \u00fb\u025d\u0db8 \u0dd9\u0dc4\u02a4 \u0dd9\u0db1\u02a3\u0d9a\u0dc5 \u0252\u01b1\u0dba.\n\n4.2. \u0d91\u0dd9\u0dc3\u02a2 \u026c\u0dc0 \u0daf, \u0db8\u0dcf\u0dd9\u0118 \u0dd9\u0dc4\u02a4 \u0db6\u0dbd\u0dba \u0dbd\u01ae \u01e7\u0dbd\u0db0\u0dcf\u025c\u0dd9\u0dba\u00fd\u0dd9\u0118 \u0dd9\u0dc4\u02a4 \u01e7\u0dd9\u0dba\u02a4\u0d9c \u0d85\u01b1\u0dd9\u0dbb\u01e6, \u0dba\u023c \u01e7\u0dd9\u0dba\u02a4\u0d9c\u0dba\u00fa \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u00fb\u025d\u0dd9\u023c \u0d9a\u0dcf\u0259\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0db3\u026c\u025e \u0dd9\u0db4\u0dd9\u0daf\u0dc3 \u01b1\u0dc5 \u0d87\u01af \u0dba\u023c \u0d89\u0da9\u0db8\u0d9a\u0da7 \u0dd9\u0dc4\u02a4 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a\u0da7 \u0dd9\u0dc4\u02a4 \u0d87\u01b1\u029a \u026b\u0db8, \u0dc3\u0dc4 \u0dba\u023c \u0daf\u0dd0\u01e6\u026b\u0db8\u00fa \u0dd9\u0dc4\u02a4 \u0db1\u0dcf\u0db8 \u021a\u0dc0\u025e\u0dc0\u00fa \u021d\u0daf\u0259\u0dc1\u0db1\u0dba \u0d9a\u0dbb \u0dad\u0dd0\u022b\u0dd9\u023c \u0d9a\u0dcf\u0259\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0db3\u026c\u025e \u0dd9\u0db4\u0dd9\u0daf\u0dc3 \u01b1\u0dc5 \u0dba\u023c \u0d89\u0da9\u0db8\u0d9a \u0dd9\u0dc4\u02a4 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a, \u0dba\u023c \u0d9a\u019f\u0dc0\u00fa \u0286\u017b\u026b\u0db8 \u0dd9\u0dc4\u02a4 \u0d89\u01ce\u00fb\u025d\u0db8\u00fa, \u0dd9\u0d9c\u02a3\u0da9\u0db1\u0dd0\u011a\u0db8\u00fa \u0286\u01d0 \u00fb\u025d\u0db8\u0da7 \u0d85\u0dc0\u0dc3\u0dbb \u0dbd\u0dd0\u0dd9\u0db6\u01e9 \u0d87\u0dad.\n\n05. \u0dd9\u0db4\u0dbb\u0dc4\u0dd0\u0dbb\u0da7 \u021a\u0daf \u021b\u0da2\u0dcf \u0db4\u0dd0\u0dc0\u0dd0\u01ae\u026b\u0db8 - 05. \u0dd9\u0db4\u0dbb\u0dc4\u0dd0\u0dbb\u0da7 \u021a\u0daf \u021b\u0da2\u0dcf \u0db4\u0dd0\u0dc0\u0dd0\u01ae\u026b\u0db8 -"
