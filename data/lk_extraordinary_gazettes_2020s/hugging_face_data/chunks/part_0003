0bae \u0bb8\u0bcd\u0ba4\u0bbe\u0bbe\u0baa\u0ba9\u0bae\u0bbe\u0bbe\u0b95 \u0b87\u0bb5\u0bcd \u0b85\u0bb1\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1\ufffd\u0ba9\u0bcd.\n\n\u0b85\u0ba8\u0bc1\u0bb0 \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0bb0 \u0ba4\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0bcd\u0b95,\u0b85\u0ba8\u0bc1\u0bb0 \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0bb0 \u0ba4\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0bcd\u0b95, \u0ba8\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf, \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bbf\u0bbf\u0b9f\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\ufffd\u0bca\u0bb0\u0bc1\u0bb3\u0bbe\u0bbe\u0ba4\u0bbe\u0bbe\u0bb0 \u0b85\u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd.\n\n\u0ba8\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf, \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bbf\u0bbf\u0b9f\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\ufffd\u0bca\u0bb0\u0bc1\u0bb3\u0bbe\u0bbe\u0ba4\u0bbe\u0bbe\u0bb0 \u0b85\u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bc1,\u0b95\ufffd\u0bca\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1 01 ,2025, \u0b93\u0b95\u0ba4\u0bcd\u0ba4\u0bc1 15.\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0721\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0721\n\n\"\u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\ufffd \u0baa\u0bc1\u0bb1\u0bcd\u0bb1\u0bc1\u0ba8\ufffd\u0bcb\u0baf\u0bcd \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8 \u0ba8\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf\u0baf\u0bae\u0bcd\"\n\nEOG 08 - 0207"
