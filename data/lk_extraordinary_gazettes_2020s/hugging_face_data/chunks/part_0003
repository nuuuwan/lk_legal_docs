dca\u0da7\u0db9\u0dd4\u0dc0 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0d9c\u0db8\u0da7 \u0dad\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d8b\u0d9a\u0dc3\u0dca \u0d94\u0db4\u0dca\u0db4\u0dd4 \u0d85\u0d82\u0d9a 9194 - 2015.08.04 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:799 0.0548 \u0dc4\u0dc0\u0dbb\u0dd2\u0dc3\u0dbd\u0dd4\u0dd9\u0d9c\u0dca \u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0d9a\u0dd4\u0db8\u0dcf\u0dbb 198305405034 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dd2\u0d82\u0d9c\u0db4\u0dca\u0db4\u0dd4\u0dbd\u0dd2\u0dd9\u0d9c\u0dca _ \u0d85\u0d82\u0d9a 237/\u0d92/2, \u0dc0\u0db1\u0dd4\u0dc0\u0dcf\u0d9c\u0dbd\u0dc0\u0dad\u0dca\u0dad, \u0db8\u0dcf\u0dbd\u0db1\u0dd3 \u0db8\u0dcf\u0d9c\u0da7\u0dca \u0db8\u0dcf \u0d89\u0db9\u0dd4\u0dbd, \u0db1\u0dd2\u0da7\u0dca\u0da7\u0db9\u0dd4\u0dc0 \u0dba\u0db1 \u0d85\u0dba\u0dd9\u0d9c\u0dca \u0da2\u0dd2\u0dc0\u0dd2\u0dad \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dba\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 EOG 08-0070/6\n\n2025 \u0db8\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dc3 11 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0dbb\u0da2\u0db8\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dcf\u0dbb, \"\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dad \u0db8\u0dd0\u0daf\u0dd4\u0dbb\", \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dd9\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca \u0daf\u0dd3 \u0dba.\n\n6 A III \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 - \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u