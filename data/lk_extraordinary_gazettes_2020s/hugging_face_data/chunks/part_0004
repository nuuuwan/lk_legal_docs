\u0dc0\u0db1 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u200d\u0dbb \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc0\u0db1 \u0db4\u0dd9\u0dd9\u0dbb\u0dc3\u0dd0\u0dd0\u0dbb\u0dd2 \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dad\u0dd4\u0dc0\n\nI \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\n\nII \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dbaIII \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\n\n\u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dad\u0dd4\u0dc0(\u0d87\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0dcf \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca\n\n\u0da2\u0db1\u0db4\u0daf \u0da9\u0ddc\u02d0\u0ddc\u0dbd\u0dbb\u0dca)\n\n1\u0dc3\u0dcf\u0dcf\u0db8\u0dca\u0db4\u0dbd \u0d86\u0db1\u0dba\u0db1 \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0$ 50\n\n2\u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\u0dcf\u0dcf\u0d9c\u0dcf\u0dcf\u0dbb (MP) \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0-\u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba\n\n$ 2000\n\n3\u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\u0dcf\u0dcf\u0d9c\u0dcf\u0dcf\u0dbb (MP) \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dba \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0-\u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba\n\n$ 500\n\n4\u0d96\u0dc2\u0db0 \u0d86\u0db1\u0dba\u0db1\u0d9a\u0dbb\u0dd4\u0d9c\u0dda\u0dda\u0118 \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0\n\n$ 600\n\n5\u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dbd\u0dad\u0dca \u0d96\u0dc2\u0db0 \u0d86\u0db1\u0dba\u0db1\u0d9a\u0dbb\u0dd4 \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0$ 200\n\n6\u0d85\u0dbd\u0dd9\ufffd\u0dc0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0db1\u0dc0 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0dd2\u0dad \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dca \u0db4\u0dad\u0dca\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0dc0\u0db1 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0 (\u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0dd2\u0dad \u0d86\u0dba\u0dad\u0db1 \u0db8\u0dcf\u0dcf\u0dbb\u0dd4\u0d9a\u0dd2\u0dbb\u0dd3\u0db8)\n\n$ 500\n\n\u0dad\u0ddc\ufffd\u0ddc\u0d9c \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc0\u0dd2\u0d9a\u0dd2\u0dab\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd6 \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0$ 120\n\n\u0dc3\u0dd2\u0dbd\u0dca\u0dbd\u0dbb \u0d96\u0dc2\u0db0\u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0$ 90\n\n\u0d96\u0dc2\u0db0 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dcf\u0dc4\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd6 \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0$ 20\n\n7\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\u0dcf\u0dcf\u0d9c\u0dcf\u0dcf\u0dbb\u0dba\u0d9a \u0db8\u0dd6\u0dbd\u0dd2\u0d9a \u0d85\u0db1\u0dd4\u0db8\u0dad\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0A \u0d9a\u0dcf\u0dcf\u0dab\u0dca\u0da9\u0dba:-\n\n(i) \u0d85\u0db7\u0dca\u200d\u0dba\u0dba\u0db1\u0dca\u0dad\u0dbb\u0dd2\u0d9a\u0dc0 \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d96\u0dc2\u0db0 (\u0d8b\u0daf\u0dcf\u0dcf: \u0db8\u0dd4\u0d9b\n\n\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dd9\ufffd\u0db1\u0dca, \u0d91\u0db1\u0dca\u0db1\u0dad\u0dca \u0db8\u0d9c\u0dd2\u0db1\u0dca, \u0d86\u0d9d\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dab\u0dba\u0dd9\ufffd\u0db1\u0dca)\n\n(ii) \u0d85\u0db1\u0dd9\ufffd\u0d9a\u0dd4\u0dad\u0dca \u0dc1\u0dbb\u0dd3\u0dbb \u0d9a\u0dd4\u0dc4\u0dbb \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d96\u0dc2\u0db0 (\u0d8b\u0daf\u0dcf\u0dcf: \u0d85\u0d9a\u0dca\u0dc2\u0dd2\u0db8\u0dba, \u0d9a\u0db1, \u0db1\u0dcf\u0dcf\u0dc3\u0dba, \u0d9c\u0dd4\u0daf \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba, \u0dba\u0ddd\ufffd\u0ddd\u02ea\u0db1\u0dd2 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba)\n\n(iii) \u0dc1\u0dbb\u0dd3\u0dbb\u0dba\u0dda\u0dda\u024f \u0db6\u0dcf\u0dcf\u0dc4\u0dd2\u0dbb\u0dc0 \u0d86\u0dbd\u0dda\u0dda\u0262\u0db4\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2 \u0d86\u0dc3\u0dcf\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0dc3\u0dca\u0dca\u0da7\u0dd9\ufffd\u0dbb\u0ddc\ufffd\u0ddc\u0dba\u0dd2\u0da9 \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\n\n$ 100\n\nB \u0d9a\u0dcf\u0dcf\u0dab\u0dca\u0da9\u0dba:-\u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2 \u0d86\u0dc3\u0dcf\u0dcf\u0daf\u0db1 