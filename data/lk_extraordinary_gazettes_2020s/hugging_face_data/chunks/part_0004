u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\n\n1. \u0db8\u0dda\u0dda\u023c \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c 2025 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd (\u0dc3\u0dca\u0dca\u0dc0\u0dda\u0dda\u0dda\u0da0\u0dca\u0da1\u0dcf\u0dcf \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0dba\u0dcf\u0dcf\u0db8\u0dda\u0dda\u023c \u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0db1\u0dcf\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u0dda\u0dda\u024f \u0db1\u0dd2\u0dba\u0db8 \u0dc3\u0dc4 \u0d9a\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0daf\u0dda\u0dda\u0dda\u0dc3\u0dd2) \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dd4\n\n\u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0dda\u0229.\n\n2. \u0db8\u0dda\u0dda\u023c \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c, \u0d85\u0db1\u0dd4\u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db4\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8\u0d9a\u0da7 \u0d85\u0db1\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad \u0dc0\u0dd3\u0db8 \u0dc3\u0dca\u0dca\u0dc0\u0d9a\u0dd3\u0dba \u0dad\u0dda\u01ae\u0dbb\u0dd3\u0db8 \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dc0\u0dd6 \u0daf 2024 \u0d85\u0d82\u0d82\u0d9a 36 \u0daf\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0db4\u0db1\u0dad\u0dda\u01ae 18 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u0dda\u024f (3) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u0dda\u024f ( \u0d8a) \u0da1\u0dda\u0dda\u0dda\u0daf\u0dba\u0dda\u0dda\u024f \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1\u0dc0\u0dbd \u0dc3\u0db3\u0dc4\u0db1\u0dca (\u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db8\u0dd2\u0db1\u0dca\u0db8\u0dad\u0dd4 ''\u0dc3\u0dca\u0dca\u0dc0\u0dda\u0dda\u0dda\u0da0\u0dca\u0da1\u0dcf\u0dcf \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0dba\u0dcf\u0dcf\u0db8\u0dda\u0dda\u023c \u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0db1\u0dcf\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\" \u0dbd\u0dd9\ufffd\u0dc3 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1) \u0dc3\u0dca\u0dca\u0dc0\u0dda\u0dda\u0dda\u0da0\u0dca\u0da1\u0dcf\u0dcf \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0dba\u0dcf\u0dcf\u0db8\u0dda\u0dda\u023c \u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0db1\u0dcf\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u0d9a\u0dca \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc3\u0dca\u0dca\u0dc0\u0dda\u0dda\u0dda\u0da0\u0dca\u0da1\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0dba\u0dcf\u0dcf\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0db6\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dc0\u0dd6 \u0daf, \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u0dda\u024f (\u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db8\u0dd2\u0db1\u0dca\u0db8\u0dad\u0dd4 \"\u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0db1\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dba\u0dcf\u0dcf\" \u0dbd\u0dd9\ufffd\u0dc3 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1) \u0dc3\u0dd1\u0dd1\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dbb\u0dba\u0d9a\u0dd4\u0da7 \u0dc3\u0dc4 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0d9a\u0dba\u0d9a\u0dd4\u0da7 \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\n\n3. 2 \u0dc0\u0db1 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc3\u0dca\u0dca\u0dc0\u0dda\u0dda\u0dda\u0da0\u0dca\u0da1\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0dba\u0dcf\u0dcf\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0db6\u0db1 \u0dba\u0db8\u0dca \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0db1\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dba\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u0dda\u024f \u0db1\u0dd2\u0dc1\u0dca\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0d86\u0d9a\u0dd8\u0dd8\u0dad\u0dd2\u0dba\u0da7 \u0dc3\u0dcf\u0dcf\u0dbb\u0dcf\u0dcf\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0dba.\n\n2 AI fldgi: (I) fPoh - Y%S ,xld m%cd;dka;%sl iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'08'26\n\n4. (1) \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u0dda\u024f \u0dc3\u0dca\u0dca\u0dae\u0dd2\u0dbb \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc0\u0dbb\u0dca\u0d9c\u0dd3\u0d9a\u0dbb\u0dab\u0dba\u0db1\u0dca\u0da7 \u0d85\u0dba\u0dad\u0dca\n\n\u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0db1\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dba\u0db1\u0dca\u0da7 \u0dc3\u0dca\u0dca\u0dc0\u0dda\u0dda\u0dda\u0da0\u0dca\u0da1\u0dcf\u0dcf \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0dba\u0dcf\u0dcf\u0db8\u0dda\u0dda\u023c \u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0db1\u0dcf\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0d9c\u0dd9\ufffd\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0db1\u0dca\u0daf\u0dd2 \u0db8\u0dd4\u0daf\u0dbd \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba:-\n\n(\u0d85) \u0dc0\u0dc3\u0dbb \u0daf\u0dc4\u0dba\u0d9a\u0dca \u0dc4\u0ddd\