daf\u0dda\u0dda\u0dda\u0dc1 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dcf \u0dc4\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0da0\u0dcf\u0dcf\u0dbb\u0d9a \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\n\n2. \u0d9c\u0dbb\u0dd4 \u0dc3\u0d82\u0d82\u0da0\u0dcf\u0dcf\u0dbb\u0d9a \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0dca\u200d\u0dba\u0dba \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\n\n3. \u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dbd\u0dda\u0dda\u0262\u0d9a\u0db8\u0dca\n\n4. \u0dbd\u0dda\u0dda\u0262\u0d9a\u0db8\u0dca, \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\n\n5. \u0dbd\u0dda\u0dda\u0262\u0d9a\u0db8\u0dca, \u0dbb\u0dcf\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1, \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf \u0dc3\u0dc4 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\n\n6. \u0dbd\u0dda\u0dda\u0262\u0d9a\u0db8\u0dca, \u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dda\u0dc1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4, \u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dda\u0dc1 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dcf \u0dc4\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0da0\u0dcf\u0dcf\u0dbb\u0d9a \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\n\n7. \u0dbd\u0dda\u0dda\u0262\u0d9a\u0db8\u0dca, \u0db4\u0dbb\u0dd2\u0dc3\u0dbb \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\n\n8. \u0dbd\u0dda\u0dda\u0262\u0d9a\u0db8\u0dca, \u0d9a\u0dd8\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8, \u0d89\u0da9\u0db8\u0dca, \u0db4\u0dc1\u0dd4\u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0dc4\u0dcf\u0dcf \u0dc0\u0dcf\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\n\n9. \u0dbd\u0dda\u0dda\u0262\u0d9a\u0db8\u0dca, \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dcf\u0dc4\u0db1, \u0db8\u0dc4\u0dcf\u0dcf \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c, \u0dc0\u0dbb\u0dcf\u0dcf\u0dba \u0dc4\u0dcf\u0dcf \u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\n\n10. \u0d85\u0dad\u0dd2\u0dbb\u0dda\u0dda\u0d9a \u0dbd\u0dda\u0dda\u0262\u0d9a\u0db8\u0dca (\u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1), \u0dc3\u0d82\u0d82\u0da0\u0dcf\u0dcf\u0dbb\u0d9a \u0d85\u0d82\u0d82\u0dc1\u0dba, \u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dda\u0dc1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4, \u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dda\u0dc1 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dcf \u0dc4\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0da0\u0dcf\u0dcf\u0dbb\u0d9a \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\n\n11. \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2, \u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\n\n12. \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0da0\u0dcf\u0dcf\u0dbb\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0da0\u0dcf\u0dcf\u0dbb\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0d82\u0d82\ufffd\u0dc1\u0dba\n\n13. \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0da0\u0dcf\u0dcf\u0dbb\u0d9a \u0dc3\u0dc4 \u0dc4\u0ddd\ufffd\u0ddd\ufffd\u0da7\u0dbd\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0d86\u0dba\u0dad\u0db1\u0dba, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dda\ufffd\u0dbd\u0db1 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0d82\u0d82\ufffd\u0dc1\u0dba\n\n14. \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca, \u0db8\u0db0\u0dca\u200d\u0dba\u0dba\u0db8 \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0d9a\u0dd8\u0dd8\u0dad\u0dd2\u0d9a \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\n\nwkqr l=udr \u00c8idkdhluq\u00f8dj\n\n2 A I fldgi: (I) fPoh - Y%S ,xld m%cd;dka;%sl iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'08'20\n\n15. \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca, \u0dc0\u0dd9\u0dd9\u0dbb\u0dc5 \u0dc3\u0d82\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n16. \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca, \u0dc0\u0dcf\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n17. \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca, \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd2 \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n18. \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca, \u0dc0\u0db1 \u0dc3\u0d82\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\n\n19. \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0da0\u0dcf\u0dcf\u0dbb\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\n\n20. \u0d86\u0d9c\u0db8\u0db1 \u0dc0\u0dd2\u0d9c\u0db8\u0db1 \u0db4\u0dcf\u0dcf\u0dbd\u0d9a \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca, \u0d86\u0d9c\u0db8\u0db1 \u0dc4\u0dcf\u0dcf \u0dc0\u0dd2\u0d9c\u0db8\u0db1 \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0"
