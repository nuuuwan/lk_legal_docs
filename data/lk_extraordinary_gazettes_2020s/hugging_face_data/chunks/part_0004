0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0dc3\u0daf\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca \u0d9a\u0dc5 \u0db6\u0dd2\u0db8 2:192 0.3399 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 127A/129/2007 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dd9\u0dc0\u0dd9\u0dc4\u0dbb\u0d9c\u0dbd, \u0d9c\u0dd9\u0da9\u0ddc\u0dbd\u0dca\u0db6\u0dd0\u0daf\u0dca\u0daf, \u0dc0\u0dd0\u0daf\u0dd2\u0d9a\u0dd4\u0db9\u0dd4\u0dbb, \u0dd9\u0db8\u0ddc\u0dab\u0dbb\u0dcf\u0d9c\u0dbd \u0dc4\u0dd2 \u0dd9\u0db4\u0ddc\u0db1\u0dca\u0db1 \u0dd9\u0dc4\u0dda\u0dc0\u0dcf\u0dba\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0db4\u0dd2\u0dba\u0db1\u0dca\u0dad\u0dcf \u0d9a\u0dbd\u0dca\u200d\u0dba\u0dcf\u0dab\u0dd2 \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3 2:195 0.0027 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 2:196 0.0629 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0dc3\u0daf\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca \u0d9a\u0dc5 \u0db6\u0dd2\u0db8 2:198 0.0898 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0dc3\u0daf\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca \u0d9a\u0dc5 \u0db6\u0dd2\u0db8\n\n7A III \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 : \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba - 2025.08.20\n\n\u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba \u2013 (\u0dc3\u0db8\u0dca\u0d