0bbf\u1fb9 \u0b87\u0bb2.843, \u1f81\u0b9f\u0bbe \u0b95\u1fbb\u0bae\u0bbe\u0ba9 07, \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\n\n\u1faa\u0bb0\u0bc6\u0bb9\u0bb2, \u0ba4\u0bbf\u1fc4\u0bb8\u0bae\u0bb9\u0bbe\u0bb0\u0bbe\u0bae\u0baf. \u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 1:90 0.8655 \u0bc6\u0bb0\u0bbe\u1fb5\u1f8c\u1fbb\u0baa \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0b95\u0bc7\u0bb0\u0bbe\u1fa2\u1fc4 530410404V \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 _ \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a.\u0ba4\u0bbf\u1fb9\n\n\u0b87\u0bb2.843, \u1f81\u0b9f\u0bbe \u0b95\u1fbb\u0bae\u0bbe\u0ba9 07, \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9 \u1faa\u0bb0\u0bc6\u0bb9\u0bb2, \u0ba4\u0bbf\u1fc4\u0bb8\u0bae\u0bb9\u0bbe\u0bb0\u0bbe\u0bae\u0baf. \u0b95\u1fa6\u1fb0\u1f81\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 1:125 1.0717 \u1f99\u0ba3\u0b9a\u0bbf\u1fb1\u0b95 \u0b86\u0bb0\u1fb2\u0b9a\u0bbf\u0bc7\u0b95 \u0b9c\u0bbf\u0ba9\u0ba4\u0bbe\u0b9a 582010099V \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 _ \u0b95\u0bbe.\u0b85.\u0b95.\u0b9a.\u0ba4\u0bbf\u1fb9 \u0b87\u0bb2.819, \u1faa\u0bb0\u0bc6\u0bb9\u0bb2, \u0bc6\u0baa\u0bb0\u1fa2\u0bc6\u0bb9\u0bb2, \u0ba8\u0bbf\u0baa\u1fb8\u0ba4\u0bc8\u0ba9\n\n\u0ba4\u0bbf\u1fc4\u0bb8\u0bae\u0bb9\u0bbe\u0bb0\u0bbe\u0bae\u0baf. \u0b95\u1fa6\u1fb0\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90.\n\nEOG 08 - 0263 / 11\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fbb\n\n14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b89\u0bbe\u0bbf\u1fb7\u1f90 \u0ba8\u0bbf\u1fbd\u0ba3\u0baf \u0b86\u0bc8\u0ba3\u0baf\u0bbe\u0bb3\u0bbe\u0bbf\u1fb9 \u0ba4\u0bc0\u1fbd\u0bae\u0bbe\u0ba9\u1fb7\u0bc8\u0ba4 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4\u1fbf\n\n1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 14 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0b95\u0bc0\u1fc1 \u0b8e\u0ba9\u1fb0\u1f81\u0bbe\u0bbf\u1fb7\u0ba4\u0bbe\u1fb0\u0b95\u1fba\u0baa\u1fb5\u1f8c\u1fc0\u0bb3 \u0ba4\u1fb7\u1f90\u0bb5\u1fb1\u0b95\u0bb3\u0bbf\u1fb9 \u0baa\u0baf\u0bc8\u0ba9\u1fb0\u0bc6\u0b95\u0bbe\u1fb6\u1f8c, \u0b95\u0bc0\u0bc7\u0bb4 \u0b92\u1fba\u0baa\u0bae\u0bbf\u1fb5\u1f8c\u1fc0\u0bb3 \u0ba8\u0bbe\u1fb9, 1998 \u0b86\u1fbb \u0b86\u1fb6\u1f8a\u1fb9 21 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 12 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9\n\n\u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u1fb9\u0baa\u1f8a 2019 \u0b86\u1fbb \u0b86\u1fb6\u1f8c \u0b93\u0b95\u1fb7\u1f90 19 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf 2137/17 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u1fbf \u0b89\u0bbe\u0bbf\u0baf \u1f99\u0bc8\u0bb1\u0baf\u0bbf\u1fbf \u0bc6\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u0b9f\u1fba\u0baa\u1fb5\u0b9f\u1f90\u1fbb, \u0b95\u0bbe\u0ba3\u0bbf\u1fb0\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0 \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0b95\u0bc8\u0bb3\u1fb0 \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u1fb9\u0bb1\u1f90\u0bae\u0bbe\u0ba9 83/0319 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u1fa2\u1fbf \u1f81\u0bb1\u0bbf\u1fba\u1f96\u1f8c \u0bc6\u0b9a\u1fbc\u0baf\u1fba\u0baa\u1fb5\u0b9f \u0bc6\u0ba4\u1fb9\n\n\u0b85\u1fb5\u0b9f\u0bb5\u0bc8\u0ba3 (\u0bc6\u0ba4\u0bbe\u0b9f\u1fbd\u1fb2\u0b9a\u0bbf)\n\n\u0b95\u0bbe\u0ba3\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f\n\n\u0bb5\u0bb4\u1fb0\u0b95\u0bbf\u1fbe\u1f81 \u0b85\u1fbf\u0bb2\u1f90 \u0ba4\u0bbe\u1fc0 \u0bb5\u0bbf\u1fc4\u0ba4\u0bc0\u0bb0\u0ba3\u1fbb \u0bc6\u0b9a\u0bbe\u1fb8\u0ba4\u1fb0\u0b95\u0bbe\u0bb0\u1fbd/ \u0bc6\u0