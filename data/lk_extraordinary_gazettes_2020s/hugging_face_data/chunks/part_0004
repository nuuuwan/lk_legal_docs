db1\u0dd2\u0dba\u0db8\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca, \u0d85\u0d82\u0d82\u0d9a 2050/38 \u0daf\u0dbb\u0db1 \u0dc3\u0dc4 2017 \u0daf\u0dd9\u0dd9\u0dc3\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 21 \u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd2\u0dba\u0db8\u0dba\u0dda\u0dda\u024f \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba, \u0d91\u0dc4\u0dd2 \u201c\u0d9c\u0d9c\u0db1 \u0db1\u0dcf\u0dcf\u0dc0\u0dd2\u0d9a \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0dc4 \u0d9c\u0d9c\u0db1 \u0dba\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf\u0d82\u0d82\ufffd\u0d9c\u0db1\u0dc0\u0dbd\u0da7 \u0d86\u0db6\u0daf\u0dca\u0db0 \u0d89\u0da9\u0db8\u0dca (\u0dad\u0dd4\u0db1\u0dca\u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u0dda\u024f \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba \u0d9a\u0ddc\ufffd\u0ddc\u0da7 \u0d87\u0dad\u0dd2)\u201d \u0dba\u0db1 \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2:- (\u0d85) \u0d91\u0dc4\u0dd2 5 \u0dc0\u0db1 \u0d85\u0dba\u0dd2\u0dad\u0db8\u0dba \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3 \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca:-\n\n\u201c5. \u0db4\u0dd2\u0daf\u0dd4\u0dbb\u0dd4\u0dad\u0dbd\u0dcf\u0dcf\u0d9c\u0dbd \u0d9a\u0db1\u0dca\u0daf\u0dda\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dbb\u0dda\u0dda\u0da9\u0dcf\u0dcf\u0dbb\u0dca \u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba, \u0d91\u0dc4\u0dd2 \u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9c\u0dd2\u0dbd\u0dd2 \u0dc4\u0dcf\u0dcf \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0d8a\u0da7 \u0d86\u0db6\u0daf\u0dca\u0db0 \u0d89\u0da9\u0db8, \u0d91\u0db1\u0db8\u0dca-\n\n\u0db8\u0db0\u0dca\u200d\u0dba\u0dba\u0db8 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\u01ae \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0daf\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda\u0dda\u024f \u0db8\u0dad\u0dd4\u0dbb\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca \u200d\u200d\u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u0dda\u024f \u0d85\u0d82\u0d82\u0d9a 512B \u0db8\u0db1\u0dca\u0daf\u0dcf\u0dcf\u0dbb\u0db8\u0dca\u0db1\u0dd4\u0dc0\u0dbb \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dc5\u0db0\u0dcf\u0dcf\u0dbb\u0dd3 \u0dc0\u0dc3\u0db8\u0dda\u0dda\u023c \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2, \u0dc3\u0dbb\u0dca\u0da0\u0dda\u0dda\u0dda\u0dba\u0dbb\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dcf\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d82\u0d9a 330489 \u0daf\u0dbb\u0db1 \u0dc3\u0dc4 2024.11.27 \u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0d9a\u0dd0\u0dd0\u0da9\u0dd0\u0dd0\u0dc3\u0dca\u0dca\u0dad\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0db8 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db6\u0dd9\ufffd\u0daf\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0db1\u0dca\u0d9a\u0dc5 \u0d9a\u0dbd\u0dcf\u0dcf\u0db4 \u0d85\u0d82\u0d82\u0d9a 02 \u0dc4\u0dd2 \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 01 \u0dbd\u0dd9\ufffd\u0dc3 \u0db1\u0dd2\u0dbb\u0dd6\u0db4\u0dd2\u0dad \u0d8b\u0dad\u0dd4\u0dbb\u0da7 \u0db8\u0dd4.\u0db4\u0dd2.\u0db1\u0dd4. 2308 \u0dc4\u0dd2 \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 33 \u0daf, \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb\u0da7 \u0db8\u0dd4.\u0db4\u0dd2.\u0db1\u0dd4. 2308 \u0dc4\u0dd2 \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 33 \u0daf, \u0daf\u0d9a\u0dd4\u0dab\u0da7 \u0db8\u0dd4.\u0db4\u0dd2.\u0db1\u0dd4. 2308 \u0dc4\u0dd2 \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 33 \u0dc3\u0dc4 \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba \u0daf, \u0dc3\u0dc4 \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7 \u0db8\u0dd4.\u0db4\u0dd2.\u0db1\u0dd4. 2308 \u0dc4\u0dd2 \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a 33 \u0dc3\u0dc4 \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba\u0daf, \u0dba\u0db1 \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8\u0dca \u0dad\u0dd4\u0dbd \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc4\u0dd9\ufffd\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dcf\u0dbb \u0db6\u0dd2\u0d82\u0d82\u0daf\u0dd4\u0dc0\u0dba\u0dd2 \u0daf\u0dc1\u0db8 \u0dc4\u0dad\u0dbb\u0dba\u0dd2 \u0d85\u0da7\u0dba\u0dd2 \u0d85\u0da7\u0dba\u0dd2 \u0d85\u0da7\u0d9a (\u0dc4\u0dd9\ufffd\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dcf\u0dbb 0.4888) \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0db1\u0dca\u0dc0\u0dd2\u0dad \u0dc0\u0dd6 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0dd0\u0db6\u0dd0\u0dd0\u0dbd\u0dca\u0dbd \u0dc0\u0dda\u0dda\u0dda.\u201d;\n\n(\u0d86) \u0d91\u0dc4\u0dd2 6 \u0dc0\u0db1 \u0d85\u0dba\u0dd2\u0dad\u0db8\u0dba \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3 \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca:-"
