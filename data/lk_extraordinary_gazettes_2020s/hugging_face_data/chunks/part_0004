u0bb2\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0bc1 \u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0b95 \u0bb5\u0b9f\u0bbf\u0bb5\u0bae\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba9 (\u0ba4\u0bb2\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0bc1 87.02 \u0b87\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bb5\u0bc8\u0bc8 \u0ba4\u0bb5\u0bbf\u0bbf\u0bb0), \u0b87\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd \u0bb8\u0bcd\u0b9f\ufffd\u0bb7\u0ba9\u0bcd 87.02 \u0b87\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bb5\u0bc8\u0bc8 \u0ba4\u0bb5\u0bbf\u0bbf\u0bb0), \u0b87\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd \u0bb8\u0bcd\u0b9f\ufffd\u0bb7\u0ba9\u0bcd \u0bb5\ufffd\u0b95\u0ba9\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0ba8\u0bcd\u0ba4\u0baf \u0b95\u0bbe\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0b9f\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd.\u0bb5\ufffd\u0b95\u0ba9\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0ba8\u0bcd\u0ba4\u0baf \u0b95\u0bbe\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0b9f\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd.\n\n8703.80-\u0b89\u0ba8\u0bcd\u0ba4\u0bc1\u0bb5\u0bbf\u0bbf\u0b9a\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbf\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bbe\u0bb0 \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\ufffd \u0b89\u0bb3\u0bcd\u0bb3 \u0baa\u0bbf\u0bbf\u0bb1 \u0bb5\u0bbe\u0bbe\u0b95\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd\n\n---\u0b8f\u0ba9\ufffd\u0baf\u0bb5\u0bc8\u0bc8, \u0ba4\u0bc0\u0baa\u0bcd\u0baa\ufffd\u0bca\u0bb1\u0bbf\u0bbf\u0baf\u0bc1\u0b9f\u0ba9\u0bcd \u0b95\u0bc2\u0b9f\u0bbf\u0baf - \u0baa\u0bb1\u0bcd\u0bb1\u0bb5\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0bc1 \u0b89\u0bb3\u0bcd \u0b8e\u0bb0\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0baa\u0bbf\u0bbf\u0bb8\u0bcd\u0b9f\u0ba9\u0bcd \u0b87\u0baf\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bae\u0bcd, \u0bae\u0bbf\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bbe\u0bb0 \u0ba4\u0bbf\u0bbf\u0bb0\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bc8\u0bc8 \u0b9a\u0bbe\u0bbe\u0bb0\u0bcd\u0b9c\u0bcd \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\ufffd, \u0bb5\ufffd\u0bbf\ufffd\u0baa\u0bcd\u0baa\u0bc1\u0bb1 \u0bae\u0bbf\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bbe\u0bb0 \u0bae\u0bc2\u0bb2\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd \u0b87\u0ba3\u0721\u0baa\u0bcd\u0baa\u0ba4\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0b9a\u0bbe\u0bbe\u0bb0\u0bcd\u0b9c\u0bcd \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf \u0b87\u0baf\u0bb2\u0bbe\u0bbe\u0ba4\u0ba4\u0bc1 :\n\n8703.80.71----50 \u0b95\u0bbf\u0bbf. \u0b87\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bb1\u0bcd\u0baa\u0b9f\u0bbe\u0bbe\u0ba4, \u0bb5\ufffd\u0bcb. \u0b95\ufffd\u0bca\u0bb3\u0bcd\u0bb3\u0bb3\u0bb5\u0bbf\u0bbf\u0ba9\ufffd\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bc1, \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bae\ufffd\u0bb1\u0bcd\u0baa\u0b9f\u0bbe\u0bbe\u0ba4\u0bb5\u0bc8\u0bc8 \u0bb5\u0bb0\u0bc1\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\n\n(\u0b9a\u0bbf\u0bbf\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0bc2\u0bb0\u0bcd) 10%20%\u0b85\u0b85\n\n8703.80.72----50 \u0b95\u0bbf\u0bbf. \u0b87\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bb1\u0bcd\u0baa\u0b9f\u0bbe\u0bbe\u0ba4, \u0bb5\ufffd\u0bcb. \u0b95\ufffd\u0bca\u0bb3\u0bcd\u0bb3\u0bb3\u0bb5\u0bbf\u0bbf\u0ba9\ufffd\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bc1, \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bb0\u0bc1\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0bc8\n\n(\u0b9a\u0bbf\u0bbf\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0bc2\u0bb0\u0bcd) 10%20%\u0b85\u0b85\n\n8703.80.73----50 \u0b95\u0bbf\u0bbf. \u0b87\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b86\u0ba9\u0bbe\u0bbe\u0bb2\u0bcd, \u0bb5\ufffd\u0bcb. \u0b87\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bb1\u0bcd\u0baa\u0b9f\u0bbe\u0bbe\u0ba4 \u0bb5\ufffd\u0bcb. \u0b95\u0bbf\u0bbf. 100 \u0b95\ufffd\u0bca\u0bb3\u0bcd\u0bb3\u0bb3\u0bb5\u0bbf\u0bbf\u0ba9\ufffd\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bc1, \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bb0\u0bc1\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bb1\u0bcd\u0baa\u0b9f\u0bbe\u0bbe\u0ba4\u0bb5\u0bc8\u0bc8\n\n(\u0b9a\u0bbf\u0bbf\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0bc2\u0bb0\u0bcd) 10%20%\u0b85\u0b85\n\n8703.80.74----50 \u0b95\u0bbf\u0bbf. \u0b87\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b86\u0ba9\u0bbe\u0bbe\u0bb2\u0bcd, \u0bb5\ufffd\u0bcb. \u0b87\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bb1\u0bcd\u0baa\u0b9f\u0bbe\u0bbe\u0ba4 \u0bb5\ufffd\u0bcb. \u0b95\u0bbf\u0bbf. 100 \u0b95\ufffd\u0bca\u0bb3\u0bcd\u0bb3\u0bb3\u0bb5\u0bbf\u0bbf\u0ba9\ufffd\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bc1, \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bb0\u0bc1\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0bc8\n\n(\u0b9a\u0bbf\u0bbf\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0bc2\u0bb0\u0bcd) 10%20%\u0b85\u0b85\n\n8703.80.75----\u0b87\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b86\u0ba9\u0bbe\u0bbe\u0bb2\u0bcd, \u0bb5\ufffd\u0bcb. \u0b95\u0bbf\u0bbf 100 \u0b87\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bb1\u0bcd\u0baa\u0b9f\u0bbe\u0bbe\u0ba4 \u0bb5\ufffd\u0bcb. \u0b95\u0bbf\u0bbf. 200 \u0b95\ufffd\u0bca\u0bb3\u0bcd\u0bb3\u0bb3\u0bb5\u0bbf\u0bbf\u0ba9\ufffd\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0bae\u0bc2\u0ba9\u0bcd\u0bb1\u0bc1, \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bb0\u0bc1\u0b9f\u0b99\u0bcd\u0b95\u