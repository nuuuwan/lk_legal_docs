2\u0dba - \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:21 0.6259 \u0dbb\u0da2\u0dba - \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dc5 \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 148D/2025 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dd9\u0dc0\u0dca\u0d9a\u0db1\u0dca\u0dd9\u0da0\u0dca\u0dd9\u0db1\u0dba\u0dd2 \u0d9a\u0dcf\u0db1\u0dca\u0da0\u0dd2\u0dbb\u0db1\u0dca\u0d9a\u0dd4\u0da9\u0dcf \u0dc4\u0dd2 \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dd9\u0dc0\u0dca\u0dbd\u0dd9\u0db4\u0ddc\u0da9\u0dd2 \u0d89\u0dbb\u0dad\u0dca\u0db1\u0dc3\u0dd2\u0d82\u0dc4\u0db8\u0dca \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3. 1:22 0.1145 \u0dbb\u0da2\u0dba - \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:23 0.0710 \u0dbb\u0da2\u0dba - \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:24 0.0633 \u0dbb\u0da2\u0dba - \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ 1:25 0.0900 \u0dbb\u0da2\u0dba - \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dc5 \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 148D/2013 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dd9\u0dc0\u0dca\u0d9a\u0db1\u0dca\u0dd9\u0da0\u0dca\u0dd9\u0db1\u0dba\u0dd2 \u0d9a\u0dcf\u0db1\u0dca\u0da0\u0dd2\u0dbb\u0db1\u0dca\u0d9a\u0dd4\u0