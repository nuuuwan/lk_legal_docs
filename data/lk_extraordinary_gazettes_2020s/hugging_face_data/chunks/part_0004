e\u0dc0 \u0dd9\u0d9c\u02a3\u0dc3\u0dca \u0d87\u0dad)\n\n15. \u0d92. \u0d91\u023c. \u0d91\u0dc3\u0dca. \u0d85\u0dd9\u0229\u0dbb\u01ae\u0db1 (\u0dc3\u0db8\u01e6 \u0d85\u0dd9\u0229\u0dbb\u01ae\u0db1) 689,056.00\n\n16. \u0253. \u0150. \u0d91\u0262. \u0dd9\u0db8\u0dbd\u0dcf\u01e7 (\u0253. \u0150. \u0dbd\u00fa\u027f\u0d9a\u0dcf \u0dd9\u0db8\u0dbd\u0dcf\u01e7) 569,174.50\n\n\u0d89\u0dc4\u0dad \u028f\u0d9f \u0240\u0263\u0d9a \u0dc0\u0dd0\u017b\u0db4 \u0d9c\u0dab\u0db1\u0dba \u0d9a\u0dbb \u0d87\u01ae\u0dd9\u01ae 2024.12.31 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf \u026c\u0dc0 \u0daf \u0db8\u0dc4\u0dc0\u0dd0\u0263 \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dd9\u024f \u0dc3\u0101\u0dba \u0dd9\u0dc3\u02a2\u0dc0\u0dd9\u024f \u01e7\u0252\u01b1 \u01e7\u0dbd\u0db0\u0dcf\u025c\u01e6\u0dd9\u0118 \u028f\u0d9f \u0dc0\u0dd0\u017b\u0db4 \u0dd9\u0db8\u0db8 \u021d\u0daf\u0dcf\u0db1\u0dba \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5 \u00fb\u025d\u0dd9\u0db8\u01e6 \u0d85\u0db1\u01b1\u025e\u0dc0 \u0dd9\u0daf\u0dc0\u0db1 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba \u026a\u0286\u01e6 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf \u0dc0\u0db1 \u028f\u0d9f \u0dc0\u0dd0\u017b\u0db4 \u0dd9\u0d9c\u026a\u0dba \u0252\u01b1 \u0dd9\u0269. \u0d91\u0dd9\u0db8\u01e6\u0db8 \u0d91\u0dba \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf\u0db8 \u028f\u0d9f \u0dc0\u0dd0\u017b\u0db4\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dd9\u0dc3\u02a2\u0dc0\u0d9a\u0dba\u0dcf\u0dd9\u0d9c\u01e6 \u0dc4\u0dcf \u0dd9\u0dc3\u02a2\u0dc0\u0255\u0dcf\u0dd9\u0d9c\u01e6 \u0d85\u0dba\u026a\u0dba \u0252\u01b1 \u0dd9\u0dc3\u02a2\u0dc0\u0d9a \u0d85\u0259\u0dae \u0dc3\u0dcf\u0db0\u0d9a \u0d85\u0dbb\u023f\u0daf\u0dd9\u0262 \u0dc4\u0dcf \u0dd9\u0dc3\u02a2\u0dc0\u0d9a \u0db7\u0dcf\u0dbb\u0d9a\u0dcf\u0dbb \u0d85\u0dbb\u023f\u0daf\u0dd9\u0262 \u0daf\u0dcf\u0dba\u0d9a\u01ae\u0dc0\u0dba \u0d9c\u0dab\u0db1\u0dba \u0dd9\u0d9a\u02a3\u0da7 \u0dd9\u0d9c\u026b\u0db8 \u0dd9\u0daf\u0dc0\u0db1 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba \u026a\u0286\u01e6 \u0d9a\u0dc5 \u0252\u01b1 \u0dd9\u0269.\n\n\u0db4\u0dc5\u023f\u0dc0\u0db1 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba \u0d89\u0262\u0dbd\u0dcf \u0286\u0179\u0db1 \u028f\u0d9f \u01e7\u0dc0\u0dcf\u018d \u01cf\u0db8\u0db1\u0dcf \u0dc4\u0dcf \u028f\u0d9f \u0dc0\u0dd8\u01ae\u01b0\u0dba \u01cf\u0db8\u0db1\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0d94\u026c\u01e6 \u028f\u023d\u0d9a\u023c \u0dbd\u0db6\u0db1 \u0db6\u0dc0 \u0db4\u0db8\u0dab\u00fa \u021d\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u023d.\n\n\u0d91\u0dd9\u0dc3\u02a2 \u026c\u0dc0\u0daf \u0d85\u028f\u023d \u026d \u01b0\u025e\u0db6\u01d0 \u0dc3\u0dc4\u0db1 \u028f\u023d \u0dc0\u0dcf\u0dc4\u0db1 \u0d86\u0db1\u0dba\u0db1 \u0db6\u0dbd\u0db4\u01b4\u0dd9\u024f \u0dc0\u0179\u0db1\u0dcf\u0d9a\u0db8 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0db4\u0dc5\u023f\u0dc0\u0db1 \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba \u026a\u0286\u01e6 \u0d9a\u0dbb \u0d87\u01af \u0d89\u0262\u0264\u0db8 \u021d\u01af\u00fa\u0dd9\u0dc2\u02a2\u0db4 \u0d9a\u0dbb\u023d. \u0d91\u0dd9\u0dc3\u02a2 \u026c\u0dc0\u0daf \u0dd9\u0db8\u0db8 \u021d\u0daf\u0dcf\u0db1\u0dd9\u0dba\u01e6 \u0db4\u0288 \u0dc0\u0dd0\u017b\u0217 \u0dad\u0dbd\u0dba \u01e7\u0dc0\u0dd0\u0dbb\u01ce\u0dc0 \u0d9c\u0dd0\u0dbd\u0219\u0dd9\u0db8\u01e6 \u0d85\u0db1\u01b1\u025e\u0dc0 \u0db4\u0dc0\u01ae\u0db1\u0dcf \u01e8\u01af \u025d\u01af \u0d85\u01e9\u0dc0 \u0dc0\u0dcf\u0dc4\u0db1 \u0d86\u0db1\u0dba\u0db1 \u0db4\u01b4\u0dba\u00fa \u0d89\u0262\u0265\u023c \u00fb\u025d\u0dd9\u023c \u0dc4\u0dd0\u00fb\u0dba\u0dcf\u0dc0 \u0db4\u0dc5\u023f \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba \u0dc3\u01b1\u0dba."
