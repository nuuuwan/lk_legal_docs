\u0bbe\u0bbf\u1fb7\u1f90\u1fba \u0baa\u0ba4\u0bbf\u1fab\u1fb2 \u0b9a\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fb9 12 \u0b86\u1fbb \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fb9 \u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u1fb9\u0baa\u1f8a 2019.04.08 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf 2118/18 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0bb5\u1fbd\u1fb7\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0baf\u0bbf\u1fbf \u0b89\u0bbe\u0bbf\u0baf \u1f99\u0bc8\u0bb1\u0baf\u0bbf\u1fbf \u0bc6\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u0b9f\u1fba\u0baa\u1fb5\u0b9f\u1f90\u1fbb, \u0b95\u0bbe\u0ba3\u0bbf\u1fb0\u0b95\u0bbe\u0ba9\n\n\u0b89\u0bbe\u0bbf\u0bc8\u0bae\u1fb0 \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0b95\u0bc8\u0bb3\u1fb0 \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u1fb9\u0bb1\u1f90\u0bae\u0bbe\u0ba9 52/1008 \u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u1fa2\u1fbf \u1f81\u0bb1\u0bbf\u1fba\u1f96\u1f8c \u0bc6\u0b9a\u1fbc\u0baf\u1fba\u0baa\u1fb5\u0b9f \u0bc7\u0bae\u1fbf \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u1fb7\u0ba4\u0bbf\u1fb9, \u0bc6\u0b95\u0bbe\u1fa8\u1fbb\u1f97 \u0bae\u0bbe\u0bb5\u1fb5\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf, \u0bc7\u0bb9\u0bbe\u0bae\u0bbe\u0b95\u0bae \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1fbf, \u0b87\u0bb2. 448\u0b8f - \u0b93\u0bb5\u0bbf\u1fb5\u1f8a\u0b95\u0bae \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u1fbd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u1fc0 \u0b93\u0bb5\u0bbf\u1fb5\u1f8a\u0b95\u0bae\n\n\u0b95\u0bbf\u0bb0\u0bbe\u0bae\u1fb7\u0ba4\u0bbf\u1fbf \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\u1f90\u1fbb 520025\u0b86\u1fbb \u0b87\u0bb2\u1fb0\u0b95 \u0b95\u0b9f\u1fb7\u0ba4\u0bbf\u0bb0\u1fbf \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u1fb7\u0ba4\u0bbf\u1fbf \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 16 \u0b87\u1fbf \u0b85\u0b9f\u1fb1\u0b95\u0bbf\u1f9c\u1fc0\u0bb3\u1f90\u0bae\u0bbe\u0ba9 1 : 4, 1 : 16, 1 : 17 \u0bae\u1fbe\u1fa0\u1fbb 1 : 19 \u0b8