\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bbe\u0bbe\u0b9f\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\ufffd\u0b95\u0bbf\u0bbf\u0baf \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb3\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0baf\u0ba9\ufffd\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f\u0bc1 \u0b95\u0bc0\u0bb4\ufffd \u0b95\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\ufffd \u0b87\u0bb2\u0bcd 01 \u0b87\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b8e\u0bb2\u0bcd\u0bb2\u0bc8\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 402.11 \u0bb9\u0730\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bbe\u0bb0\u0bcd \u0bb5\u0bbf\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0b85\u0bb0\u0b9a\u0bbe\u0bbe\u0b99\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf\u0baf\u0bc8\u0bc8 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0baf\u0bc2\u0bb2\u0bc8\u0bc8 \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 15 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf \u0ba4\ufffd\u0bca\u0b9f\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bb0\u0b9c\u0b95\u0bb2 \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0b9f\u0bc1 \u0b8e\u0ba9 \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb2\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1\ufffd\u0ba9\u0bcd.\n\n\u0ba4\u0bae\u0bcd\u0bae\u0bbf\u0bbf\u0b95 \u0baa\u0b9f\u0bcd\u0b9f\u0baa\u0bc6\u0bc6\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf, \u0ba4\u0bae\u0bcd\u0bae\u0bbf\u0bbf\u0b95 \u0baa\u0b9f\u0bcd\u0b9f\u0baa\u0bc6\u0bc6\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf, \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bbe\u0bbe\u0b9f\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd.\n\n\u0b95\u0bae\u0bcd\u0baa\u0bb9\u0bbe\u0bbe \u0bae\u0bbe\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0b9c\u0bcd\u0b9c\u0ba9\u0bcd\u0b95\ufffd\u0bca\u0b9f \u0ba4\u0bbf\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4\u0bb5\ufffd\u0bb3\u0bbf\u0bbf \u0b85\u0bb0\u0b99\u0bcd\u0b95\u0bc1,2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0baf\u0bc2\u0bb2\u0bc8\u0bc8 \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 15 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf.\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\ufffd 01\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\ufffd 01\n\n\u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0baf \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b95\u0ba3\u0bcd\u0b9f\u0bbf \u0bae\u0bbe\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd,\u0bae\u0bc6\u0bc6\u0ba4\u0ba4\u0bc1\u0bae\u0bcd\u0baa\u0bb0 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0bc6\u0bc6\u0baf\u0bb2\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 402.18 \u0bb9\u0730\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bbe\u0bb0\u0bcd \u0bb5\u0bbf\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0b95\u0bc0\u0bb4\ufffd \u0baa\u0bc2\u0b95\ufffd\u0bcb\u0bb3 \u0ba8\u0bbf\u0bbf\u0bb2\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b92\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0ba3\ufffd\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b85\u0bb0\u0b9a\u0bbe\u0bbe\u0b99\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf (\u0b85\u0bb3\u0bb5\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd , \u0baa\u0bc2\u0b95\ufffd\u0bcb\u0bb3 \u0ba8\u0bbf\u0bbf\u0bb2\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b92\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0ba3\ufffd\u0baa\u0bcd\u0baa\u0bc1 EPSG : 5234 \u0bae\u0bc1\u0bb1\u0bc8\u0bc8\u0bae\u0bc8\u0bc8\u0baf\u0bbe\u0bbe\u0b95\u0bc1\u0bae\u0bcd.)\n\n\u0b87\u0bb2.\u0b95\u0bbf\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bc6\u0bc6\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0b95\u0bb2\u0bbe\u0bbe\u0b99\u0bcd\u0b95\u0bc1\n\n1207508229839\n\n2207501229843\n\n3207503229833\n\n4207499229831\n\n5207496229837\n\n6207486229843\n\n7207462229824\n\n8207466229817\n\n9207465229817\n\n10207461229816\n\n11207458229821\n\n12207453229816\n\n13207444229818\n\n14207415229805\n\n15207402229789\n\n16207375229778\n\n17207347229778\n\n18207328229779\n\n19207283229784\n\n20207253229779\n\n21207219229780\n\n22207193229780\n\n23207155229777\n\n24207145229780\n\n25207131229781\n\n26207081229764\n\n27207063229752\n\n28207049229738\n\n29207032229739\n\n30207021229740\n\n31207008229744\n\n32206987229748\n\n33206986229748\n\n34206985229749\n\n35206964229755\n\n36206953229741\n\n37206952229741\n\n\u0b87\u0bb2.\u0b95\u0bbf\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bc6\u0bc6\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0b95\u0bb2\u0bbe\u0bbe\u0b99\u0bcd\u0b95\u0bc1\n\n38206950229723\n\n39206950229722"
