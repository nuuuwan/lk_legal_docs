u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb \u0dc0 \u0db4\u0dc4\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf\u0dc0\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0d9c\u0db8\u0dca/\u0dc3\u0db8\u0dca\u0db8\u0dda\u0dda\u023c\u0dbd\u0db1\u0dba\u0db1\u0dca \u0dc4\u0dd2 \u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2\u0dba \u0dad\u0dcf\u0dcf\u0dc0\u0d9a\u0dcf\u0dcf\u0dbd\u0dd2\u0d9a\u0dc0 \u0d85\u0dad\u0dca\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0d91\u0d9a\u0dd3 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0d9c\u0db8\u0dca / \u0dc3\u0db8\u0dca\u0db8\u0dda\u0dda\u023c\u0dbd\u0db1\u0dba\u0db1\u0dca \u0dc4\u0dd2 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1\u0dba \u0dc4\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0dba\u0db8\u0dca \u0d85\u0dc0\u0dd0\u0dd0\u0dc3\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0dae\u0dcf\u0dcf\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dca\u200d\u0dba\u0dba \u0d85\u0dba\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0d89\u0da7\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d8b\u0daf\u0dd9\u0dd9\u0dc3\u0dcf\u0dcf 1973 \u0d85\u0d82\u0d82\u0d9a 25 \u0daf\u0dbb\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0db4\u0db1\u0dad \u0dc3\u0dc4 \u0d91 \u0dc4\u0dd2 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1 \u0d85\u0db1\u0dd4 \u0dc0 \u0dc3\u0dc4 \u0d92 \u0dba\u0da7\u0dad\u0dda\u0dda\u01ae \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0d85\u0db1\u0dd4\u0dc0 \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0dc0 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dc0\u0dbd\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dbb\u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf\u0dad\u0dca, \u0db1\u0dc0 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd6 \u0db1\u0dd2\u0dbd\u0dc0\u0dbb\u0dab \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dc0\u0dbd\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dbb\u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf\u0dad\u0dca \u0dba\u0db1\u0dcf\u0dcf\u0daf\u0dd3 \u0dc3\u0dd3\u0db8\u0dd2 \u0dad \u0d9a\u0dcf\u0dcf\u0dbb\u0dab\u0dcf\u0dcf \u0dc3\u0db3\u0dc4\u0dcf\u0dcf 2025 \u0d85\u0d9c\u0ddd\ufffd\u0ddd\u02ea\u0dc3\u0dca\u0dca\u0dad\u0dd4 \u0db8\u0dc3 27 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a\u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dad\u0dbb\u0dd4\u0dab \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dc4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\u0dda\u024f \u0dbd\u0dda\u0262\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0db1\u0dd2\u0dc3\u0dd2 \u0db6\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0dcf\u0dcf \u0dbd\u0dd9\ufffd\u0dc3 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db8\u0dd2.\n\n01. \u0dc3\u0dd0\u0dd0\u0dc4\u0dd0\u0dd0\u0dbd\u0dca\u0dbd\u0dd4 \u0db4\u0db1\u0dca\u0daf\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0da7\u0dca 02. \u0d9a\u0db6\u0da9\u0dd203. \u0d91\u0dbd\u0dca\u0dbd\u0dda\u0262\n\n02. \u0db8\u0db8 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca, \u0d89\u0dc4\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf\u0dc0\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0d9c\u0db8\u0dca/\u0dc3\u0db8\u0dca\u0db8\u0dda\u0dda\u023c\u0dbd\u0db1\u0dba\u0db1\u0dca \u0dc4\u0dd2 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0dd2\u0dad \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0dc0 \u0dba\u0da7\u0dad\u0dda\u0dda\u01ae \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a \u0db8\u0dc4 \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dca\u0dc0\u0dd3\u0db8\u0d9a \u0daf\u0dd3 \u0db4\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db1\u0dd2\u0dbd\u0dc0\u0dbb\u0dab\u0dba\u0d9a\u0daf\u0dd3 \u0dc3\u0dd2\u0dba \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0dad\u0ddd\ufffd\u0ddd\u02ea\u0dbb\u0dcf\u0dcf\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0d9c\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dad\u0dd9\ufffd\u0d9a\u0dca, \u0d89\u0dc4\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf\u0dc0\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0d9c\u0db8\u0dca/\u0dc3\u0db8\u0dca\u0db8\u0dda\u0dda\u023c\u0dbd\u0db1\u0dba\u0db1\u0dca \u0dc4\u0dd2 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dba\u0db1\u0dca \u0d9a\u0dbb\u0d9c\u0dd9\ufffd\u0db1 \u0dba\u0dcf\u0dcf\u0db8 \u0dc3\u0dc4 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0dad\u0dbb\u0dd4\u0dab \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dc4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\u0dda\u024f \u0dbd\u0dda\u0262\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db6\u0dbd\u0dba \u0db4\u0dc0\u0dbb\u0dcf\u0dcf \u0daf\u0dd9\u0dd9\u0db8\u0dd2.\n\n\u0dc3\u0dd4\u0db1\u0dd2\u0dbd\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0d9c\u0db8\u0d9c\u0dda\u0118 (\u0db4\u0dcf\u0dcf. \u0db8.),(\u0db4\u0dcf\u0dcf. \u0db8.), \u0dad\u0dbb\u0dd4\u0dab \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc4\u0dcf\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba.2025 \u0d85\u0d9c\u0ddd\ufffd\u0ddd\u02ea\u0dc3\u0dca\u0dca\u0dad\u0dd4 \u0db8\u0dc3 27 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\n\n\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0daf\u0dd3 \u0dba.\n\nEOG 08 - 0299\n\nwxl 2451$25 - 2025 wf.daia;= ui 27 jeks nodod - 2025'08'27\n\n^rcfha n,hmsg m%isoaO lrk ,\u00a7&I jeks fldgi: (I) jeks fPoh - idudkH\n\nY%S ,xld m%cd;dka;%sl iudcjd\u00a7 ckrcfha .ei\u00dc m;%h\n\nw;s \u00fafYI\n\nrcfha ksf\u00f5ok\n\n1A - G 45257 \u2014 05 (2025/08)"
