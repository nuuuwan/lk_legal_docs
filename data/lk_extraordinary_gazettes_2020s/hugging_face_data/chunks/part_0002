0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd0.0281 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u1f97\u0bc6\u0bb0\u0bbe\u0b9f\u0bcd\u0bc7\u0bb2\u0ba9\u0bcd\u0b9f\u0bcd\n\n\u0bb5\u0ba4\u0bcd\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1faa\u0ba4\u0bbf ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd\n\n\u1f97\u0bc6\u0bb0\u0bbe\u0b9f\u0bcd\u0bc7\u0bb2\u0ba9\u0bcd\u0b9f\u0bcd \u0bb5\u0ba4\u0bcd\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u1f90\u0ba3\u0bcd\u1f8c C ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u1f90\u0ba3\u0bcd\u1f8c\n\nC, \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0b85\u0bb1\u0bcd\u0bb1 \u1f97\u0bc6\u0bb0\u0bbe\u0b9f\u0bcd\u0bc7\u0bb2\u0ba9\u0bcd\u0b9f\u0bcd \u0bb5\u0ba4\u0bcd\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd\n\n\u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u1f97\u0bc6\u0bb0\u0bbe\u0b9f\u0bcd\u0bc7\u0bb2\u0ba9\u0bcd\u0b9f\u0bcd \u0bb5\u0ba4\u0bcd\u0ba4 : \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u1f97\u0bc6\u0bb0\u0bbe\u0b9f\u0bcd\u0bc7\u0bb2\u0ba9\u0bcd\u0b9f\u0bcd \u0bb5\u0ba4\u0bcd\u0ba4.\n\n\u0bc7\u0b95. \u1f8a. \u0bb2\u0bbe\u0bb2\u0bcd \u0b95\u0bbe\u0ba8\u0bcd\u0ba4, \u0b95\u0bae\u0ba4\u0bcd\u0bc6\u0ba4\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd, \u0b95\u0bbe\u0bb2\u0bcd\u0ba8\u0bc8\u0b9f \u0bb5\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0b9a\u0ba9 \u0b85\u0bc8\u0bae\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd.\n\n\u0b8e\u0ba9\u1f90 \u0b87\u0bb2. : 4-3/11/2022/CEB/124.\u0baa\u0bbf\u0bb0. \u0bc6\u0b9a\u0baf. \u0b87\u0bb2. : \u0b85\u0bae\u0bcd\u0baa\u0bc7\u0b95\u0bbe/3/7/\u0b85/144.\u0b95\u0bae\u0ba4\u0bcd\u0bc6\u0ba4\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd, \u0b95\u0bbe\u0bb2\u0bcd\u0ba8\u0bc8\u0b9f \u0bb5\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0b9a\u0ba9 \u0b85\u0bc8\u0bae\u0b9a\u0bcd\u0b9a\u0bc1,\u201c\u0bae\u0bbf\u0bb9\u0bbf\u0b95\u0ba4 \u0bc6\u0bae\u1f90\u0bb0\u201d, \u0b87\u0bb2. 1200/ 6, \u0b87\u0bb0\u0b9c\u0bae\u0bb2\u0bcd\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u1faa\u0ba4\u0bbf,\u0baa\u0ba4\u0bcd\u0ba4\u0bb0\u1f99\u0bb2\u0bcd\u0bc8\u0bb2,2025, \u1f9d\u0ba9\u0bcd 06.\n\nEOG 08 - 0053\n\n\u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0b85\u0b9a\u0bcd\u0b9a\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0b9a\u0bcd\u0b9a\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90."
