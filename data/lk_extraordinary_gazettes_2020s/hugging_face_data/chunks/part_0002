9a\u0daf\u0dd3 \u0dc0\u0dba\u0dc3 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 18 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1\n\n\u0db8\u0dd9\ufffd\u0db8 QR \u0d9a\u0dda\ufffd\u0dad\u0dba Scan \u0d9a\u0dbb \u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2\n\n\u0dad\u0ddc\ufffd\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0db6\u0dbd\u0dcf\u0dcf\u0d9c\u0dad \u0dc4\u0dd0\u0dd0\u0d9a. \u0db1\u0dd0\u0dd0\u0dad\u0dd2\u0db1\u0db8\u0dca ec.lk/vrd \u0d85\u0db4\u0d9c\u0dda\u0dda\u0118 \u0dc0\u0dd9\u0dd9\u0db6\u0dca \u0d85\u0da9\u0dc0\u0dd2\u0dba\u0da7 \u0db4\u0dd2\u0dc0\u0dd2\u0dc3\u0dd9\ufffd\u0db1\u0dca\u0db1\n\nI \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3 : (I) \u0da1\u200d\u0dd9\u0dd9\ufffd\u0daf\u0dba - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.07.292\n\n(\u0d91\u0db1\u0db8\u0dca 2007.06.01 \u0dc3\u0dd2\u0da7 2007.09.30 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d8b\u0db4\u0dad \u0dbd\u0daf) \u0dc4\u0dcf\u0dcf 2025(2) \u0db4\u0dbb\u0dd2\u0db4\u0dd6\u0dbb\u0d9a \u0da1\u0db1\u0dca\u0daf \u0dc4\u0dd2\u0db8\u0dd2\n\n\u0db1\u0dcf\u0dcf\u0db8\u0dbd\u0dda\u0dda\u0262\u0d9b\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd2\u0dad \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0db1\u0dca\u0d9c\u0dda\u0dda\u0118 \u0db1\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc0\u0db1 \u0dbd\u0dd0\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dad\u0dd4\u0dc0.\n\n2025 \u0d94\u0d9a\u0dca\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0db6\u0dbb\u0dca \u0db8\u0dc3 01 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 2026 \u0da2\u0db1\u0dc0\u0dcf\u0dcf\u