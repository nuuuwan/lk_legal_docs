    "chunk_text": "\u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e \u026a\u0286\u01e6 \u01e7\u0dd9\u0dba\u02a4\u0d9c \u0dc3\u0d82\u011e\u0dc4\u0dd9\u024f 21 (1) \u01e7\u0dd9\u0dba\u02a4\u0d9c\u0dba\u0da7 \u0d85\u01e9\u0d9c\u0dad\u0dc0 2018.03.02 \u01ce\u0db1 \u0dba\u0da7\u0dd9\u01ae \u0d9c\u025e \u0d85\u01dd\u0d9a\u0dbb\u0dab\u0dba\u0da7 \u0dd9\u0d9c\u02a3\u01e9 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db4\u0dc5\u023f \u021d\u0d9a\u0dcf\u0dc1\u0dba \u0db8\u0119\u01e6 \u021d\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb \u0d87\u01ae\u0dd9\u01ae \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u01e8\u023c \u0db4\u0179\u0db4\u0dcf\u0179\u0dba\u0da7 \u0d85\u01e9\u0dc0 1990.06.01 \u0dc0\u0db1 \u01ce\u0db1 \u0286\u0da7 05 (ii) \u0d9a\u0dcf\u0259\u023d\u0d9a \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dad\u0db1\u01b1\u0dbb\u0daf, 1992.06.01 \u01ce\u0db1 \u0286\u0da7 05 (i) \u0d9a\u0dcf\u0259\u023d\u0d9a \u01e7\u0dbd\u0db0\u0dcf\u025d \u0dad\u0db1\u01b1\u0dbb\u0daf, 1997.06.01 \u0286\u0da7 4 \u0dd9\u0279\u02a2\u019d\u0dd9\u024f \u0d89\u0d82\u014f\u0dd9\u01e6\u025e \u0dad\u0db1\u01b1\u0dbb\u0daf, \u0d91\u0dd9\u0dc3\u02a2\u0db8 \u0d8a\u0da7 \u0db4\u0288 \u0d9a\u0dcf\u0dbd\u0dba\u01e6\u0da7 \u0d85\u0daf\u0dcf\u0dc5\u0dc0 \u0d89\u0d82\u014f\u0dd9\u01e6\u025e \u0dd9\u0dc3\u02a2\u0dc0\u0dd9\u024f \u0d89\u0dc4\u0dc5 \u0dd9\u0279\u02a2\u019d\u0dd9\u024f \u0d89\u0d82\u014f\u0dd9\u01e6\u025e \u0dad\u0db1\u01b1\u0dbb\u0daf, \u0d91\u0dd9\u0dc3\u02a2\u0db8 \u0d8a\u0da7 \u0db4\u0288 \u0d9a\u0dcf\u0dbd\u0dba\u01e6\u0da7 \u0d85\u0daf\u0dcf\u0dc5\u0dc0 \u0d89\u0d82\u014f\u0dd9\u01e6\u025e \u0dd9\u0dc3\u02a2\u0dc0\u0dd9\u024f \u0d89\u0dc4\u0dc5 \u0dd9\u0279\u02a2\u019d\u0dba\u01e6\u0daf \u0286\u0dba\u029a \u028f\u0d9f \u0dc0\u0dd0\u017b\u0217 \u0dc3\u028f\u0dad\u0dc0 \u0d89\u0262\u0dbd\u0dcf \u0286\u017a\u0db8\u0da7 \u00fb\u0286\u01d0 \u0db4\u0daf\u0db1\u0db8\u00fa \u0dd9\u0db1\u02a3\u0db8\u0dd0\u01af \u0db6\u0dc0\u01ae. \u0d8a\u0da7 \u0dd9\u0dc4\u02a2\u01b1 \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u0dc0\u0d9c \u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e \u021d\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb \u0d87\u01ae\u0dd9\u01ae \u0d89\u0262\u0265\u023c\u0d9a\u025e \u0db8\u0dcf\u0259\u0d9c \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dd9\u024f \u0d85\u01e7\u0dba\u023c \u0d9a\u0dcf\u0259\u023d\u0d9a \u01e7\u0dbd\u0db0\u0dcf\u025c\u0dd9\u0dba\u00fd \u0dd9\u0dbd\u0dc3 1987.05.04 \u01ce\u0db1 \u0286\u0da7 1988.05.03 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf\u0daf, 1988.11.03 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf \u0db8\u0dcf\u0dc3 06 \u0d9a\u0dcf\u0dc5 \u0287\u0db8\u0dcf\u0dc0\u0d9a\u0da7 \u01cf\u0259\u0d9d \u0d9a\u0dbb \u0d87\u01af \u0d85\u0dad\u0dbb, \u0da2\u0dcf\u01af\u0d9a \u0d86\u01df\u01e7\u0d9a\u01ae\u0dc0 \u0db8\u019c\u0da9\u0dbd\u0dba \u0db8\u0119\u01e6 \u0218\u025c\u0db1\u0db8\u0db1 \u0dbd\u0daf 1988.04.14 \u01ce\u0db1 \u026a\u0dd9\u0dc1\u02a2\u0dc2 \u0d86\u01df\u01e7\u0d9a\u01ae\u0dc0 \u0da2\u0dcf\u01af\u0d9a \u0dc3\u0dc4\u01af\u0d9a\u0dba \u0db8\u0dad 1988.06.01 \u01ce\u0db1 \u0286\u0da7 \u0db8\u0dcf\u0259\u0d9c \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dd9\u024f \u0d9a\u0dcf\u0259\u023d\u0d9a \u01e7\u0dc5\u0db0\u0dcf\u025d \u0dc3\u0dca\u01c3\u0dbb \u0dad\u0db1\u01b1\u0dbb\u0da7 \u0db4\u01ae\u0dc0 \u0d87\u01af \u0d85\u0dad\u0dbb, 1989.04.25 \u01ce\u0db1 \u0263\u0218\u0dba \u0db8\u0119\u01e6 1988.06.01 \u01ce\u0db1 \u0286\u0da7 \u0db6\u0dbd \u0db4\u0dd0\u0dc0\u0dd0\u01ae\u0dd9\u0dc0\u0db1 \u0db4\u025c\u01ce \u0d9a\u0dcf\u0259\u023d\u0d9a \u01e7\u0dc5\u0db0\u0dcf\u025c 06 \u0dd9\u0279\u02a2\u019d\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u01dd\u0dad \u0dc0\u0dd0\u017b\u0217 \u0dad\u0dbd\u0dd9\u0dba\u028f \u0218\u028f\u017b\u0dc0\u0dcf \u0d87\u01af \u0db6\u0dc0\u01ae,\n\n\u0d89\u01e6 \u0d85\u0db1\u01b1\u025e\u0dc0 \u0dd9\u0db8\u0db8 \u0d89\u0262\u0265\u023c\u0d9a\u025e 1990.01.01 \u01ce\u0db1 \u0286\u0da7 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0dc0\u0db1 \u0db4\u025c\u01ce \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u01ae \u0dbb\u0dcf\u0da2\u0255 \u0dd9\u0dc3\u02a2\u0dc0\u0dd9\u024f \u0db8\u0db0\u0255\u0db8 \u0db8\u0178\u0da7\u0dd9\u023c \u0d9a\u0dcf\u0259\u023d\u0d9a \u01e7\u0dbd\u0db0\u0dcf\u025d iiA \u0dad\u0db1\u01b1\u0dbb\u0da7 \u0db4\u01ae\u0dc0 \u01af\u022a\u0dba\u01cf \u0d91\u0db8 \u0dad\u0db1\u01b1\u0dbb \u0db7\u0dcf\u0dbb\u0dd9\u0d9c\u0db1 \u01af\u022a\u0dba\u01cf 1990.06.01 \u01ce\u0db1 \u0286\u0da7 05 (ii) \u0d9a\u0dcf\u0259\u023d\u0d9a \u01e7\u0dbd\u0db0\u0dcf\u025d \u0dad\u0db1\u01b1\u0dbb\u0da7 \u0db4\u01ae \u026a\u0dba \u0252\u01b1 \u0db6\u0dc0\u0da7 \u0d9a\u0dbb\u0db1 \u0d89\u0262\u0264\u0db8 \u021d\u01af\u0db6\u01e6\u0db0\u0db1\u0dba \u0dc0\u0db1 \u0db6\u0dc0\u01ae, \u0d8a\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 1993.02.01 \u01ce\u0db1 \u0286\u0da7 \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0dc0 \u0d9a\u0dcf\u0259\u023d\u0d9a \u01e7\u0dc5\u0db0\u0dcf\u025d 06 \u0dd9\u0279\u02a2\u019d\u0dd9\u0dba\u028f \u0218\u028f\u017b\u0dc0\u0dcf \u0d87\u01af \u0db6\u0dd0\u026a\u01e6 \u0d9a\u0dcf\u0259\u023d\u0d9a \u01e7\u0dc5\u0db0\u0dcf\u025d 05 (ii) \u0dd9\u0279\u02a2\u019d\u0dba \u0d89\u0262\u0dbd\u0dcf \u0286\u017a\u0db8\u0daf \u021d\u01af\u0db6\u01e6\u0db0\u0db1\u0dba \u0dc0\u0db1 \u0db6\u0dc0\u0dba.\n\n\u0dd9\u0db8\u0db8 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e\u0dd9\u0118 \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0255\u0dcf\u01dd\u0d9a\u0dcf\u025c\u0dc0\u0dbb\u0dba\u0dcf \u201c\u021d\u01af\u0db6\u01e6\u0db0\u0db1\u0dba\u201d \u0dba\u0db1 \u0dc0\u0da0\u0db1\u0dd9\u024f \u0d85\u0259\u0dae \u01e7\u025f\u0db4\u0dab\u0dba \u0dc0\u0dd0\u0dbb\u01ce \u0dc3\u0dc4\u0d9c\u0dad \u0dd9\u0dbd\u0dc3 \u0291\u0dc0\u0dcf \u0daf\u00fa\u0dc0\u0dcf \u0d87\u0dad. \u0dd9\u0db8\u0db8 \u0d89\u0262\u0265\u023c\u0d9a\u025e \u0dd9\u0db8\u0db8 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u0dcf\u0dbb \u0d86\u0dba\u0dad\u0db1\u0dba\u0da7 \u0d85\u01e9\u0252\u00fa\u0dad \u0dc0\u01e9\u0dd9\u024f \u0d89\u0262\u0265\u023c\u0d9a\u025e \u0dbb\u0dcf\u0da2\u0255 \u0dd9\u0dc3\u02a2\u0dc0\u0dd9\u024f \u0286\u0179\u0dba\u01cf \u0db8\u0db0\u0255\u0db8 \u0dbb\u0da2\u0dba \u0d9c\u01ae \u021d\u01af\u0db4\u01ae\u01af\u0db8\u0dba \u01b0\u0dbb\u0dab\u0dba\u00fa \u0db8\u0dad \u0dc4\u0dcf \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf \u0d87\u01af \u00fb\u025d\u0dd9\u0db8\u01e6 \u0db4\u0288 \u0dbb\u0dcf\u0da2\u0255 \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1 \u0da0\u0100\u0dd9\u0262\u0d9b \u0d85\u0d82\u0d9a 56/89 \u028f \u0dd9\u0d9a\u02a3\u01e6\u0dd9\u01ca\u0286 \u021d\u0d9a\u0dcf\u0dbb \u0dbb\u0da2\u0dba \u0dba\u0da7\u0dd9\u01ae \u0d85\u0dc0\u0dc3\u01e6 \u0dc0\u0dbb\u0da7 \u0286\u0179 \u0dad\u0db1\u01b1\u0dd9\u0259\u0db8 \u0218\u028f\u017b\u026a\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb, \u0dd9\u0db8\u0db8 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e \u0d89\u0262\u0266\u023c\u0d9a\u025e\u0dc0 1993.02.01 \u0dc0\u0db1 \u01ce\u0db1 \u0d85\u01e9\u0252\u00fa\u0dad\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c\u01cf \u0dd9\u0dc4\u02a4 1990.01.01 \u0286\u0da7 \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u01ae \u0dbb\u0dcf\u0da2\u0255 \u0dd9\u0dc3\u02a2\u0dc0\u0dba\u0da7 \u0d9a\u0dcf\u0259\u023d\u0d9a \u0dd9\u0dc3\u02a2\u0dc0\u0dd9\u024f (ii) A \u0dad\u0db1\u01b1\u0dbb\u0da7 \u0d85\u01e9\u0252\u00fa\u0dad \u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c\u01cf \u0d85\u0daf\u0dcf\u0dc5 \u0d86\u0dba\u0dad\u0db1\u0dc0\u0dbd \u0db6\u0dbd\u0dcf\u01ae\u0db8\u0d9a \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u01e8\u023c \u0dc4\u0dcf \u0d8b\u0dc3\u0dc3\u0dca \u00fb\u025d\u0dd9\u023c \u0db4\u0179\u0db4\u0dcf\u0179\u0dc0\u0dbd\u0da7 \u0d85\u01e9\u00fd\u0dbd\u0dc0 \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0dd9\u0118 \u0288\u01d0\u0288\u0d9a\u023c \u0db8\u0dad \u0d8b\u0dc3\u0dc3\u0dca\u026a\u023c \u0d89\u0262\u0dbd\u0dcf \u0dd9\u0db1\u02a3\u0286\u0179\u0db1 \u0db6\u0dc0\u0da7 \u00fb\u0286\u01d0 \u0dd9\u0d9a\u02a3\u01e6\u0dd9\u01ca\u0286\u0dba\u0d9a\u0da7 \u0d89\u0262\u0265\u023c\u0d9a\u025e \u0dba\u0da7\u01ae \u026b \u0db1\u0dd0\u0dad.\n\n\u0d92 \u0d85\u01e9\u0dc0 \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0dd9\u0118 \u0d89\u0262\u0264\u0db8 \u021d\u01af\u0db6\u01e6\u0db0\u0db1\u0dba \u026d\u0dd9\u024f \u0dd9\u0d9a\u0dd9\u0dc3\u02a2\u0daf \u0dba\u01e6\u0db1 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e\u0dd9\u0118 \u021d\u0d9a\u0dcf\u0dc1\u0dba \u0db4\u0daf\u0db1\u023c \u0dbb\u028f\u0dad \u0dc0\u0db1 \u0d85\u0dad\u0dbb, \u0dbb\u0dd9\u0178 \u0d95\u0db1\u0dd1\u0db8 \u021a\u0dbb\u0dc0\u0dd0\u0286\u0dd9\u0dba\u00fd\u0da7 \u0d92 \u0d92 \u0d86\u0dba\u0dad\u0db1 \u0dc0\u0dbd \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0179\u0db4\u0dcf\u0179 \u0dc0\u0dbd \u0dc3\u0db3\u0dc4\u01e6 \u0288\u01d0\u0288\u0d9a\u023c \u0db8\u0dad \u0d92 \u0d92 \u0dad\u0db1\u01b1\u0dbb \u0d89\u0262\u0dbd\u0dcf \u0286\u017a\u0dd9\u023c \u0d85\u0250\u01af\u0dba \u0240\u0263\u0d9a \u0d85\u0250\u01af\u0dc0\u0dcf\u0286\u0d9a\u0db8\u00fa \u0db6\u0dc0 \u0db8\u0db8 \u0d85\u0dc0\u0db0\u0dcf\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u023d."
