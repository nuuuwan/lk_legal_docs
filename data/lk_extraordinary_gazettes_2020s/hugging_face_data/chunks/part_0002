\u0ba8\u0bb7\u0bcd\u0b9f \u0b88\u1f8c \u0ba8\u0bbe\u0ba9\u0bcd\u0b95\u0bc1 \u0b87\u0bb2\u0b9f\u0bcd\u0b9a\u0ba4\u0bcd\u1f90 \u0b8e\u1fa8\u0baa\u0ba4\u0bbe\u0baf\u0bbf\u0bb0\u0ba4\u0bcd\u1f90 \u0b8e\u0ba3\u0bcd\u1f8f\u0bb1\u0bcd\u1fa0 \u0b85\u1fa0\u0baa\u0ba4\u0bcd\u0ba4\u0bbe\u1fa0 \u1f9f\u0baa\u0bbe \u0b87\u1f9e\u0baa\u0ba4\u0bcd\u0bc6\u0ba4\u0b9f\u0bcd\u1f8c \u0b9a\u0ba4\u0bae\u0bcd (\u1f9f. 470,866.28) \u0bc6\u0ba4\u0bbe\u0bc8\u0b95\u0bc8\u0baf \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0baf\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bc6\u0baa\u0bb1\u0bcd\u1fa0\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0bb3\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bc6\u0b95\u0bbe\u1fa8\u0bae\u0bcd\u1f97 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f \u0ba8\u0bc0\u0ba4\u0bbf\u0bae\u0ba9\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bb5\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0bb2. DLA/25/24 \u0b87\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0baa\u0bb1\u0bcd\u1fa0 \u0bc8\u0bb5\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3\u0bc6\u0ba4\u0ba9\u0bcd\u0baa\u0bc8\u0ba4 \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd.\n\n\u0b9a\u0ba8\u0bcd\u0ba4\u1f9e\u0bb5\u0ba9\u0bcd \u0b85\u1f92\u1f9e\u0ba4\u0bcd\u0ba4, \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd, \u0bc6\u0b95\u0bbe\u1fa8\u0bae\u0bcd\u1f97.\u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0b95\u0bae\u0bcd,\u0bc6\u0b95\u0bbe\u1fa8\u0bae\u0bcd\u1f97. 2025, \u0b93\u0b95\u0ba4\u0bcd\u1f90 11.\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3"
