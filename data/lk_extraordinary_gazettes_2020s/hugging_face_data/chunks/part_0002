dba\u00fa\u0db8 \u0dd9\u0db8\u0db8 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e\u0dd9\u0118 \u0d85\u01e8\u01af\u0d9a \u0101\u0dba\u0dcf\u0d9a\u0dbd\u0dcf\u0db4\u0dba \u0db8\u0dad \u0d89\u0262\u0266\u023c\u0d9a\u025e\u0da7 \u0daf\u0dd0\u025d\u0db8\u0da7 \u0286\u01d0 \u026d \u0d85\u0db4\u0dc4\u0288\u0dad\u0dcf\u0dc0\u0dba\u01e6\u0daf \u0dc3\u0dd0\u0dbd\u00fb\u0262\u0dbd\u0da7 \u0d9c\u01e7\u023d\u01e6 \u0dd9\u023c \u0dc3\u0db8\u0d9f \u0dd9\u0d9c\u02a3\u01e9 \u0d9a\u0dbb\u0db1 \u2018Y\u2019 \u0daf\u0dbb\u0db1 \u0dc0\u0dcf\u0259\u0dad\u0dcf\u0dc0 \u0db8\u0119\u01e6 \u0d9c\u0dab\u0db1\u0dba \u0d9a\u0dbb \u0d87\u01af \u0d92 \u0d92 \u0dd9\u0279\u02a2\u019d \u0dc4\u0dcf \u0dad\u0db1\u01b1\u025e \u0dc0\u0dbd\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u028f\u0d9f \u0dc0\u0dd0\u017b\u0217 \u0dc4\u0dcf \u01cf\u0db8\u0db1\u0dcf \u0dd9\u0d9c\u0dc0\u0db1 \u0dd9\u0dbd\u0dc3\u0da7 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0dc4\u0dcf \u0252\u00fa\u01af \u0dc3\u0dc4\u0d9c\u0dad \u021d\u0daf\u0dcf\u0db1\u0dba\u00fa \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0da7 \u0dbd\u0db6\u0dcf \u0dd9\u0daf\u0db1 \u0dd9\u0dbd\u0dc3 \u0d89\u0262\u0266\u023c\u0d9a\u025e \u0dd9\u0dc0\u01e9\u0dd9\u0dc0\u01e6 \u0d89\u0dad\u0dcf \u0dba\u0da7\u0dc4\u01ae \u0db4\u0dc4\u01ae \u0db7\u0dcf\u0dc0\u0dd9\u0dba\u01e6 \u0d85\u0dba\u0dd0\u0daf \u0286\u0179.\n\n11AI I \u0dd9\u0d9a\u02a3\u0da7\u0dc3: \u0dd9\u0d9a\u02a3\u0da7\u0dc3: (I) (I) \u0dd9\u0da1\u0daf\u0dba \u0dd9\u0da1\u0daf\u0dba \u2013 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u2013 2025.07.22\u2013 2025.07.22\n\n\u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u0dcf\u0dbb \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dd9\u0dba\u01e6 \u0d89\u01ce\u025c\u0db4\u01ae \u026d \u0d9a\u025e\u019f \u0dc3\u0dc5\u0d9a\u0dcf \u0db6\u0dd0\u0264\u0dd9\u023c\u01cf \u0dd9\u0db8\u0dd9\u0dc3\u02a2 \u0daf \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb \u0d87\u0dad.\n\n1. \u0d9a\u025e\u019f \u0d91\u0dd9\u0dc3\u02a2 \u01af\u022a\u0dba\u01cf \u0dd9\u0db8\u0db8 \u026a\u01e7\u0dc1\u0dca\u0da0\u0dba\u0dcf\u01dd\u0d9a\u0dbb\u0dab\u0dd9\u024f\u01cf \u0d85\u0db1\u0dcf\u0dc0\u0dbb\u0dab\u0dba \u026c\u0dd9\u024f \u0d9a\u023c\u0d9a\u025e \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca\u0dc0\u0dbb\u0dba\u0dcf \u0d89\u01ce\u025c\u0dd9\u024f \u0dc0\u0259\u0dc2 2013 \u0dc0\u0db1 \u026a\u0da7 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u0dcf\u0dbb \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u01ae \u0db8\u0dcf\u0259\u0d9c \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dba \u026a\u0286\u01e6 \u0d9a\u023c\u0d9a\u025e \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022d \u0dd9\u0dba\u02a4\u0da2\u0db1\u0dcf\u0dc0\u00fa \u0db8\u0dad \u0d89\u0262\u0266\u023c\u0d9a\u025e\u0da7 \u0dd9\u0db4\u0dbb\u0daf\u0dcf\u0dad\u0db8 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022d \u0d8b\u0dc3\u0dc3\u0dca\u026b\u023c \u0dbd\u0db6\u0dcf \u01cf \u0dc3\u0dc4 \u0d91\u0dba\u0da7 \u0d85\u01e9\u0dc0 \u028f\u0d9f \u0dc0\u0dd0\u017b\u0217 \u0daf \u0dc3\u0d9a\u0dc3\u0db1 \u0dbd\u0daf \u0d85\u0dad\u0dbb \u0dc0\u0da9\u0dcf\u01ae \u021a\u01d0\u0db8 \u0dc3\u0dc4\u0d9c\u0dad \u0d9a\u025e\u0dab \u0dc0\u01e9\u0dd9\u024f \u0d89\u0262\u0266\u023c\u0d9a\u025e \u0d91\u00fc \u0d8b\u0dc3\u0dc3\u0dca\u026b\u023c \u0dc3\u0dc4 \u0d91\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u028f\u0d9f \u0dc0\u0dd0\u017b\u0217\u0daf \u0dbd\u0db6\u0dcf\u0dd9\u0d9c\u0db1 \u0db1\u0dd0\u0dc0\u0dad \u0dd9\u0db8\u0db8 \u0d85\u01ae\u0dad\u0dd9\u0db1\u02a4\u0db8\u01af\u0d9a \u0d85\u01e8\u01af\u0d9a \u0d89\u0262\u0264\u0db8 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022b\u0db8\u0dba.\n\n2. \u0d9a\u025e\u019f \u0d91\u0dd9\u0dc3\u02a2 \u01af\u022a\u0dba\u01cf \u0dd9\u0db8\u0db8 \u026a\u01e7\u0dc1\u0dca\u0da0\u0dba\u0dcf\u01dd\u0d9a\u0dbb\u0dab\u0dd9\u024f\u01cf \u0d85\u0db1\u0dcf\u0dc0\u0dbb\u0dab\u0dba \u026d\u0dd9\u024f \u0d9a\u023c\u0d9a\u025e \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca\u0dc0\u0dbb\u0dba\u0dcf \u0d89\u01ce\u025c\u0dd9\u024f \u0dc0\u0259\u0dc2 2013 \u0dc0\u0db1 \u026a\u0da7 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u0dcf\u0dbb \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u01ae \u0db8\u0dcf\u0259\u0d9c \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dba \u026a\u0286\u01e6 \u0d9a\u023c\u0d9a\u025e \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0da7 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022d \u0dd9\u0dba\u02a4\u0da2\u0db1\u0dcf\u0dc0\u00fa \u0db8\u0dad \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0da7 \u0dd9\u0db4\u0dbb\u0daf\u0dcf\u0dad\u0db8 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022d \u0d8b\u0dc3\u0dc3\u0dca\u026b\u023c \u0dbd\u0db6\u0dcf \u01cf \u0dc3\u0dc4 \u0d91\u0dba\u0da7 \u0d85\u01e9\u0dc0 \u028f\u0d9f \u0dc0\u0dd0\u017b\u0217\u0daf \u0dc3\u0d9a\u0dc3\u0db1 \u0dbd\u0daf \u0d85\u0dad\u0dbb \u0dc0\u0da9\u0dcf\u01ae \u021a\u01d0\u0db8 \u0dc3\u0dc4\u0d9c\u0dad \u0d9a\u025e\u0dab \u0dc0\u01e9\u0dd9\u024f \u0d89\u0262\u0266\u023c\u0d9a\u025e \u0d91\u00fb \u0d8b\u0dc3\u0dc3\u0dca\u026b\u023c \u0dc3\u0dc4 \u0d91\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u028f\u0d9f \u0dc0\u0dd0\u017b\u0217\u0daf \u0dbd\u0db6\u0dcf\u0dd9\u0d9c\u0db1 \u0db1\u0dd0\u0dc0\u0dad \u0dd9\u0db8\u0db8 \u0d85\u01ae\u0dad\u0dd9\u0db1\u02a4\u0db8\u01af\u0d9a \u0d85\u01e8\u01af\u0d9a \u0d89\u0262\u0264\u023c \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0db6 \u0d87\u01af \u0db6\u0dc0 \u0dc0\u0d9c\u0d8b\u01ae\u0dad\u0dbb\u0d9a\u025e \u021d\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb \u0d87\u0dad.\n\n3. \u0dd9\u0db8\u0db8 \u026a\u01e7\u0dc1\u0dca\u0da0\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0dd9\u0d9c\u02a5\u0dbb\u0dc0\u0dd9\u0dba\u01e6 \u00fb\u0dba\u0dcf \u0286\u0179\u01e6\u0dd9\u01e6 \u0dba\u0db8\u00fd \u0dd9\u0db4\u0dbb\u0daf\u0dcf\u0dad\u0db8 \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u022d \u0d8b\u0dc3\u0dc3\u0dca\u026b\u023c \u0218\u0298\u0dd9\u0d9c\u0db1 \u028f\u0d9f \u0dc0\u0dd0\u017b\u0217\u0daf \u0dbd\u0db6\u0dcf \u0d9c\u01ae\u0dad\u0dcf\u0dba \u0dba\u01e9 \u0d91\u00fc \u0d8b\u0dc3\u0dc3\u0dca\u026b\u023c \u01e8\u0dad\u0255\u0dcf\u01e9\u00fe\u0dbd\u0dc0 \u0218\u0298\u0d9c\u01ae \u0db6\u0dc0\u0250."
