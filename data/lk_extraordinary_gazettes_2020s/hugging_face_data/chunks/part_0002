baf\u0bb2\u0bcd\u1f97\u0bae\u0bcd \u0ba4\u0bc8\u0b95 \u0b95\u1fa6\u0bb3\u0bcd \u0b8e\u0bb5\u0bcd \u0b87\u0bb2. \u0b87\u0bb2. \u0ba4\u1f8c\u0baa\u0bcd\u1f97\u0b95\u0bcd \u0bb5\u0bc8\u0b95\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3 \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u0ba4\u0bbf\u1f9e\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0baa\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bb3\u0bcd\n\n5:1 0.0412 \u0b9a\u0bae\u0bbf\u0bb2 \u0b85\u0ba9\u0bcd\u0bb0\u0ba9\u0bbf \u0b9a\u0bae\u0bb0\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 821971098V \u1f99\u1fa8\u0bb5\u1f90\u0bae\u0bcd 1\u0b86\u0bae\u0bcd \u0bb5\u0b95\u0bc1\u0baa\u0bcd\u1f97 \u0baa\u0bb0\u0bcd\u0ba9\u0bc6\u0b9f\u0ba4\u0bcd \u0bc7\u0bb0\u0bbe\u0bb8\u0bcd _ \u0b87\u0bb2. 12, \u0bc7\u0b9c\u0bbe\u0ba9\u0bcd \u0b9a\u1f99\u0bc7\u0bb5\u0bb2\u0bcd \u1faa\u0ba4\u0bbf, \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0bbe\u0ba9\u0bbf \u0b87\u0bb9\u0bb3 \u0b87\u0ba4\u0bbf\u0bc6\u0baa\u0ba4\u0bcd\u0ba4, \u0bc6\u0bae\u0bbe\u0bb0\u0b9f\u0bcd\u1f8c\u0bb5. \u0b9a\u0bae\u0bb0\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95\u0bb5\u0bbf\u0ba9\u0bcd \u0b9a\u0bc0\u0bb5\u0bbf\u0baf \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90.\n\n16 A III \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 \u2013 \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dba \u2013 2025.08.15\n\n\u0baa\u0b95\u0bc1\u0ba4\u0bbf III \u2013 \u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u1f8a\u0baf\u0bb0\u0b9a\u0bc1 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u