0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bbe\u0bbe\u0b9f\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\ufffd\u0b95\u0bbf\u0bbf\u0baf \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb3\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0baf\u0ba9\ufffd\u0b95\u0bcd\u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f\u0bc1 \u0b95\u0bc0\u0bb4\ufffd \u0b95\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\ufffd\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0b87\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b8e\u0bb2\u0bcd\u0bb2\u0bc8\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 31.33 \u0bb9\u0730\u0b95\u0bcd\u0b9f\u0baf\u0bb0\u0bcd \u0bb5\u0bbf\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0b85\u0bb0\u0b9a \u0b95\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf\u0baf\u0bc8\u0bc8 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0baf\u0bc2\u0bb2\u0bc8\u0bc8 \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 15 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf \u0ba4\ufffd\u0bca\u0b9f\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bae\u0bbf\u0bbf\u0bb2\u0bcd\u0bb2\u0b95\u0bc6\u0bc6\u0bb2\ufffd \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0bbe\u0bbe\u0b9f\u0bc1 \u0b8e\u0ba9 \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb2\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1\ufffd\u0ba9\u0bcd.\n\n\u0ba4\u0bae\u0bcd\u0bae\u0bbf\u0bbf\u0b95 \u0baa\u0b9f\u0bcd\u0b9f\u0baa\u0bc6\u0bc6\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf \u0ba4\u0bae\u0bcd\u0bae\u0bbf\u0bbf\u0b95 \u0baa\u0b9f\u0bcd\u0b9f\u0baa\u0bc6\u0bc6\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf \u0b9a\u0bc1\u0bb1\u0bcd\u0bb1\u0bbe\u0bbe\u0b9f\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd\n\n\u0b95\u0bae\u0bcd\u0baa\u0bb9\u0bbe\u0bbe \u0bae\u0bbe\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0b9c\u0bcd\u0b9c\u0ba9\u0bcd\u0b95\ufffd\u0bca\u0b9f \u0ba4\u0bbf\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4\u0bb5\ufffd\u0bb3\u0bbf\u0bbf \u0b85\u0bb0\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0bb2\u0bcd, 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0baf\u0bc2\u0bb2\u0bc8\u0bc8 \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 15 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf.\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\ufffd 01\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\ufffd 01\n\n\u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd, \u0b8a\u0bb5\u0bbe\u0bbe \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0bae\ufffd\u0bca\u0ba9\u0bb0\ufffd\u0b95\u0bb2\u0bc8\u0bc8 \u0bae\u0bbe\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd, \u0bae\ufffd\u0bca\u0ba9\u0bb0\ufffd\u0b95\u0bb2\u0bc8\u0bc8 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0bc6\u0bc6\u0baf\u0bb2\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 31.33 \u0bb9\u0730\u0b95\u0bcd\u0b9f\u0baf\u0bb0\u0bcd \u0bb5\u0bbf\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0b95\u0bc0\u0bb4\ufffd \u0baa\u0bc2\u0b95\ufffd\u0bcb\u0bb3 \u0ba8\u0bbf\u0bbf\u0bb2\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b92\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0ba3\ufffd\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0b85\u0bb0\u0b9a\u0bbe\u0bbe\u0b99\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf. (\u0b85\u0bb3\u0bb5\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0baa\u0bc2\u0b95\ufffd\u0bcb\u0bb3 \u0ba8\u0bbf\u0bbf\u0bb2\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b92\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0ba3\ufffd\u0baa\u0bcd\u0baa\u0bc1 EPSG 5234 \u0bae\u0bc1\u0bb1\u0bc8\u0bc8\u0bae\u0bc8\u0bc8\u0baf\u0bbe\u0bbe\u0b95\u0bc1\u0bae\u0bcd.)\n\n\u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd\n\n\u0b95\u0bbf\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bc6\u0bc6\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0b99\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0b95\u0bb2\u0bbe\u0b99\u0bcd\u0b95\u0bc1\n\n\u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd\n\n\u0b95\u0bbf\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bc6\u0bc6\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0b99\u0bcd\n\n\u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0b95\u0bb2\u0bbe\u0b99\u0bcd\u0b95\u0bc1\n\n\u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd\n\n\u0b95\u0bbf\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bc6\u0bc6\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0b99\u0bcd"
