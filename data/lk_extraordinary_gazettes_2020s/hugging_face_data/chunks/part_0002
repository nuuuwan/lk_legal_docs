u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba 1:121 \u0dc60\u0dc6874 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba 1:124 \u0dc60\u0dc6315 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0dbe \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba 1:132 \u0dc60\u0dc6279 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba 1:133 \u0dc60\u0dc6525 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dad\u0dd2\u0da7\u0dba\u0dbd\u0dbd\u0dca \u0d86\u0dbb \u0daf\u0dd2\u0dba\u0dda \u0dba\u0dbd\u0dca\u0dad \u0d9a\u0dc2 \u0db6\u0dd2\u0db8 1:134 \u0dc60\u0dc6419 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dad\u0dd2\u0da7\u0dba\u0dbd\u0dbd\u0dca \u0d86\u0dbb 1:135 \u0dc60\u0dc68\u0dc67 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dad\u0dd2\u0da7\u0dba\u0dbd\u0dbd\u0dca \u0d86\u0dbb \u0daf\u0dd2\u0dba\u0dda \u0dba\u0dbd\u0dca\u0dad \u0d9a\u0dc2 \u0db6\u0dd2\u0db8 1:137 \u0dc60\u0dc68\u0dc69 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba \u0dc0\u0daf\u0dc1\u0dc5 \u0dba\u0dbd\u0dca\u0dad \u0d9a\u0dc2 \u0db6\u0dd2\u0db8 1:138 \u0dc60\u0dc6\u0dc683 \u0