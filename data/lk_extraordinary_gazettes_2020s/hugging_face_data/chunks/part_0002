014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1:9 0.3943 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0d89.\u0dc3\u0d82.\u0d86 \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0d85\u0d82\u0d9a 304/263 \u0daf\u0dbb\u0db1 \u0db6\u0dbd\u0db4\u0dad\u0dba \u0db8\u0dad \u0d85\u0dd9\u0db6\u0dca\u0dd9\u0d9a\u0ddd\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dbb\u0d82\u0db6\u0dab\u0dca\u0da9\u0dcf \u0d85\u0dd9\u0db6\u0dca\u0dd9\u0d9a\u0ddd\u0db1\u0dca \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. 1:10 0.0361 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 1:11 0.7697 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0d89.\u0dc3\u0d82.\u0d86 \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0d85\u0d82\u0d9a 289/263 \u0daf\u0dbb\u0db1 \u0db6\u0dbd\u0db4\u0dad\u0dba \u0db8\u0dad \u0dc4\u0dd2\u0d9f\u0dd4\u0dbb\u0dbd \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0da0\u0db1\u0dca\u0daf\u0dd9\u0dc3\u0dda\u0db1 \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. 1:12 0.2849 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0d89.\u0dc3\u0d82.\u0d86 \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0d85\u0d82\u0d9a 31/263 \u0daf\u0dbb\u0db1 \u0db6\u0dbd\u0db4\u0dad\u0dba \u0db8\u0dad \u0dd9\u0daf\u0ddc\u0dbd\u0db1\u0dca \u0d9a\u0da0\u0dca\u0da0\u0dcf\u0dbb\u0dd2\u0dba\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0db1\u0dd2\u0db8\u0dbd\u0dca \u0dbb\u0d82\u0da2\u0dd2\u0dad\u0dca \u0dc0\u0dd2\u0dd9\u0da2\u0dca\u0dad\u0dd2\u0dbd\u0d9a \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. EOG 08 - 0211/5\n\n\u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0da2\u0dd9\u0dba\u0dca \u0db8\u0dd4\u0daf\u0dab \u0dd9\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca \u0db8\u0dd4\u0daf\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3."
