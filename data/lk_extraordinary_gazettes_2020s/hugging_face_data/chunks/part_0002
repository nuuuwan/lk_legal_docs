u0dba\u0db1\u0dca \u0db4\u0dc4\u0dad \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dc0\u0dbb\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0d9a\u0dcf\u0dbb, \u0db8\u0db8 \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dca \u0db4\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u0db8\u0dd2. \u0db4\u0dd3.\u0dc3\u0dd3.\u0da9\u0dd3. \u0dc3\u0dd2\u0dd9\u0d9c\u0dca\u0dbb\u0dcf, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca. 2025 \u0db8\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dc3 17 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0dbb\u0da2\u0db8\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dcf\u0dbb, \"\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dad \u0db8\u0dd0\u0daf\u0dd4\u0dbb\", \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0dd9\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca \u0daf\u0dd3 \u0dba. \u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba\n\n(\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca)\n\n1:242 0.0382 \u0db4\u0dd4\u0d82\u0da0\u0dd2 \u0dd9\u0dc4\u0dda\u0dc0\u0dcf\u0dd9\u0d9c\u0dca \u0dad\u0dd4\u0dc2\u0db1\u0dca\u0dad \u0da9\u0dba\u0dc3\u0dca \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf 197836201223 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba 830138/1/241 \u0dd9\u0db1\u0ddc.100/23,\u0dc0\u0dbd\u0dc3\u0dca\u0db8\u0dd4\u0dbd\u0dca\u0dbd \u0db4\u0dcf\u0dbb, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0\u0dba \u0dd9\u0db6\u0dbd\u0dd2\u0d85\u0dad\u0dca\u0dad \u0dc3\u0db8\u0d9c EOG 07 - 0317/8 1998 \u0d85\u0d82