ba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db2 \u0dc0\u0dd2\u0dc0\u0dc4\u0dcf\u0dbb \u0dc0\u0dd2\u0dc0\u0dc4\u0dcf\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dba\u0dc1\u0d9a\u0dca\u0d9a\u0dba\u0da7\u0dba\u0dc5\u0dbb\u0dca) 1:63 \u0dc60\u0dc6223 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0dbe \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba 1:115 \u0dc60\u0dc6485 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba 1:116 \u0dc60\u0dc6796 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba \u0dc0\u0daf\u0dc1\u0dc5 \u0dba\u0dbd\u0dca\u0dad \u0d9a\u0dc2 \u0db6\u0dd2\u0db8 1:117 \u0dc60\u0dc6\u0dc63\u0dc6 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0d86\u0dbb 1:118 \u0dc60\u0dc618\u0dc6 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba \u0dc0\u0daf\u0dc1\u0dc5 \u0dba\u0dbd\u0dca\u0dad \u0d9a\u0dc2 \u0db6\u0dd2\u0db8 1:12\u0dc6 \u0dc60\u0dc6\u0dc625 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba 1:121 \u0dc60\u0dc6874 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba 1:124 \u0dc60\u0dc6315 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0dbe \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba 1:132 \u0dc60\u0dc6279 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba 1:133 \u0dc60\u0dc6525 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dad\u0dd2\u0da7\u0dba\u0dbd\u0dbd\u0dca \u0d86\u0dbb \u0daf\u0dd2\u0dba\u0dda \u0dba\u0dbd\u0dca\u0dad \u0d9a\u0dc2 \u0db6\u0dd2\u0db8 1:134 \u0dc60\u0dc6419 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dad\u0dd2\u0da7\u0dba\u0dbd\u0dbd\u0dca \u0d86\u0dbb 1:135 \u0dc60\u0dc68\u0dc67 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0dad\u0dd2\u0da7\u0dba\u0dbd\u0dbd\u0dca \u0d86\u0dbb \u0daf\u0dd2\u0dba\u0dda \u0dba\u0dbd\u0dca\u0dad \u0d9a\u0dc2 \u0db6\u0dd2\u0db8 1:137 \u0dc60\u0dc68\u0dc69 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba \u0dc0\u0daf\u0dc1\u0dc5 \u0dba\u0dbd\u0dca\u0dad \u0d9a\u0dc2 \u0db6\u0dd2\u0db8 1:138 \u0dc60\u0dc6\u0dc683 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba \u0dc0\u0daf\u0dc1\u0dc5 \u0dba\u0dbd\u0dca\u0dad \u0d9a\u0dc2 \u0db6\u0dd2\u0db8 1:139 \u0dc60\u0dc6\u0dc623 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba 1:14\u0dc6 \u0dc60\u0dc6172 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0dbe \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba 1:142 \u0dc60\u0dc6412 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba \u0dc0\u0daf\u0dc1\u0dc5 \u0dba\u0dbd\u0dca\u0dad \u0d9a\u0dc2 \u0db6\u0dd2\u0db8 1:143 \u0dc60\u0dc6\u0dc63\u0dc6 \u0dbb\u0da2\u0dcf\u0dba \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db3\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0db8\u0dc5\u0dbb\u0dca\u0d9c\u0dba EOG 08-0219/3\n\n1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad\n\n1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dc1\u0db8\u0dca \u0db4\u0db1\u0dad\n\n6 A III \u0dc1\u0d9a\u0ddc\u0da7\u0dc0 - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbc\u0d82\u0d9a\u0dcf \u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc0\u0db8\u0dcf\u0da2\u0dcf\u0dbd\u0dcf \u0da2 \u0da2\u0dcf\u0db1\u0dbb\u0da2\u0dcf\u0dc1\u0d85 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u