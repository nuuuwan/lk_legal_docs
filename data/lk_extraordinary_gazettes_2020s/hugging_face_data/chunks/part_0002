\u0db1\u0dca \u0dc0\u0db1 \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0d91\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0d9c\u0dda\u0dda\u0118 \u0db1\u0db8\u0dca \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0db1 \u0db6\u0dc0 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0dda\u0229. \u0db8\u0dd9\ufffd\u0db8 \u0db1\u0db8\u0dca 2025.07.11 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2444/60 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba, 2025.07.07 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2444/02 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba, 2025.07.04 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2443/60 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba, 2025.06.27 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2442/60 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba, 2025.06.20 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2441/55 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba, 2025.06.13 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2440/25 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba, 2025.06.06 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2439/65 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0dc3\u0dc4 \u0d8a\u0da7 \u0dba\u0ddc\ufffd\u0ddc\u0db8\u0dd4\u0d9c\u0dad 2025.05.31 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2438/66, 2438/67, 2438/69, 2438/70, 2438/71, 2438/72, 2438/80, 2438/81, 2438/83, 2438/84, 2438/87, 2438/88, 2438/89, 2438/90 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb \u0dc3\u0dc4 2025.05.31 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2438/68, 2438/74, 2438/85 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dbd \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0dda\u0118 \u0db1\u0db8\u0dca \u0dc0\u0dbd\u0da7 \u0d85\u0db8\u0dad\u0dbb \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db6\u0dc0 \u0daf \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0dda\u0229.\n\n\u0d86\u0dbb\u0dca.\u0d91\u0db8\u0dca.\u0d92.\u0d91\u0dbd\u0dca. \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dcf\u0dba\u0d9a, \u0d91\u0db8\u0dca.\u0d92.\u0db4\u0dd3.\u0dc3\u0dd3. \u0db4\u0dd9\u0dd9\u0dbb\u0dda\u0dda\u0dbb\u0dcf\u0dcf, \u0d85\u0db8\u0dd3\u0dbb\u0dca \u0dc6\u0dcf\u0dcf\u0dba\u0dd2\u0dc3\u0dca, \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2, \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a, \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a, \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0. \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0. \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0.\n\n\u0d92. \u0dc2\u0db1\u0dca\u0db8\u0dd4\u0d9c\u0db1\u0dcf\u0dcf\u0daf\u0db1\u0dca, \u0db8\u0dc4\u0dcf\u0dcf\u0da0\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0db8\u0db1\u0dca \u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a, \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a, \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a, \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0. \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0. 2025 \u200d\u200d \u0d85\u0d9c\u0ddd\ufffd\u0ddd\ufffd\u0dc3\u0dca\u0dad\u0dd4 \u0db8\u0dc3 01 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba,\u0dc3\u0dbb\u0dab \u0db8\u0dcf\u0dcf\u0dc0\u0dad,\u0dbb\u0dcf\u0dcf\u0da2\u0d9c\u0dd2\u0dbb\u0dd2\u0dba."
