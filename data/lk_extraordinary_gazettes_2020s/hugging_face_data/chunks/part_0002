    "chunk_text": "2025 \u0da2\u0dd6\u0dbd\u0dd2 \u0db8\u0dc3 24 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0d9a\u0dd8\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8, \u0db4\u0dc1\u0dd4 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca, \u0d89\u0da9\u0db8\u0dca \u0dc3\u0dc4 \u0dc0\u0dcf\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba,\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dad \u0db8\u0dd0\u0dd0\u0daf\u0dd4\u0dbb, \u0d85\u0d82\u0d82\u0d9a 1200/6,\u0dbb\u0da2\u0db8\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dcf\u0dcf\u0dbb,\u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd.\u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\n\n1. \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dda\ufffd \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2.\u20131. \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dda\ufffd \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2.\u2013 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dbd\u0dda\u0dda\u0262\u0d9a\u0db8\u0dca, \u0d9a\u0da9\u0dd4\u0dc0\u0dd9\u0dd9\u0dbd.\n\n01. \u0d9a\u0dd0\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d82\u0d9a \u2018A\u2019 - \u0dbb\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0d9c\u0dbd\u0dca\u0dc4\u0dda\ufffd\u0dda\u0db1\u0dc0\u0dad\u0dca\u0dad, \u0d9a\u0ddd\ufffd\u0ddd\u0db1\u0dca\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0d9c\u0dbd\u0dca\u0dc4\u0dda\ufffd\u0dda\u0db1, \u0daf\u0ddc\ufffd\u0ddc\u0db9\u0dda\u0246\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad \u0dc3\u0dc4 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dbd\u0db1\u0dca\u0daf\u0dd9\u0dd9\u0dc0\u0dad\u0dca\u0dad - \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba: \u0dc4\u0dd9\ufffd\u0d9a\u0dca. 0.3868\u0d8b\u0dad\u0dd4\u0dbb\u0da7: \u0dc4\u0ddc\ufffd\u0ddc\u0dbb\u0dba\u0dd2\u0dc3\u0db1\u0dca \u0d9a\u0dd0\u0dd0\u0db8\u0dca\u0db4\u0dc3\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0dbb\u0dd4 \u0dc3\u0ddc\ufffd\u0ddc\u0dba\u0dcf\u0dcf\u0d9c\u0dad \u0db1\u0ddc\ufffd\u0ddc\u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0da9\u0db6\u0dca.\u0d91\u0dc3\u0dca.\u0dc3\u0dd4\u0dc3\u0dd2\u0dbd\u0dca\n\n\u0da2\u0dba\u0dbd\u0dad\u0dca \u0db4\u0dd9\u0dd9\u0dbb\u0dda\u0dda\u0dbb\u0dcf\u0dcf \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad \u0dc3\u0dc4 \u0dc3\u0dd9\ufffd\u0dbd\u0dd2\u0db1\u0dcf\u0dcf \u0daf\u0dc3\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad; \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb\u0da7: \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0dbb\u0dd4 \u0dc3\u0ddc\ufffd\u0ddc\u0dba\u0dcf\u0dcf\u0d9c\u0dad \u0db1\u0ddc\ufffd\u0ddc\u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0da9\u0db6\u0dca.\u0d91\u0dc3\u0dca.\u0dc3\u0dd4\u0dc3\u0dd2\u0dbd\u0dca \u0da2\u0dba\u0dbd\u0dad\u0dca \u0db4\u0dd9\u0dd9\u0dbb\u0dda\u0dda\u0dbb\u0dcf\u0dcf \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0dc3\u0dd9\ufffd\u0dbd\u0dd2\u0db1\u0dcf\u0dcf \u0daf\u0dc3\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dd2\u0db8\u0dca \u0dbd\u0dd1\u0dd1\u0db1\u0dca\u0da9\u0dca \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad; \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u0db4\u0dca\u200d\u0dbb\u0dba\u0dd2\u0db8\u0dca \u0dbd\u0dd1\u0dd1\u0db1\u0dca\u0da9\u0dca \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0dc0\u0ddb\u0ddb\u0daf\u0dca\u200d\u0dba\ufffd \u0db1\u0dd9\ufffd\u0dc0\u0dd2\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dbb\u0ddd\ufffd\u0ddd\u0dc4\u0dbd \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0dbb\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0d9c\u0dbd\u0dca\u0dc4\u0dda\ufffd\u0dda\u0db1\u0dc0\u0dad\u0dca\u0dad, \u0d9a\u0ddc\u0dca\ufffd\u0dca\ufffd\u0db1\u0dca\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0d9c\u0dbd\u0dca\u0dc4\u0dda\ufffd\u0dda\u0db1, \u0daf\u0ddc\ufffd\u0ddc\u0db9\u0dd9\ufffd\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad \u0dc3\u0dc4 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dbd\u0db1\u0dca\u0daf\u0dda\u0dda\u0dda\u0dc0\u0dad\u0dca\u0dad \u0dc3\u0dc4 \u0dc4\u0ddc\ufffd\u0ddc\u0dbb\u0dba\u0dd2\u0dc3\u0db1\u0dca \u0d9a\u0dd0\u0dd0\u0db8\u0dca\u0db4\u0dc3\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0dc0\u0ddb\u0ddb\u0daf\u0dca\u200d\u0dba\ufffd \u0db1\u0dd9\ufffd\u0dc0\u0dd2\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dbb\u0ddd\ufffd\u0ddd\u0dc4\u0dbd \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0dbb\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0d9c\u0dbd\u0dca\u0dc4\u0dda\ufffd\u0dda\u0db1\u0dc0\u0dad\u0dca\u0dad, \u0d9a\u0ddc\u0dca\ufffd\u0dca\ufffd\u0db1\u0dca\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0d9c\u0dbd\u0dca\u0dc4\u0dda\ufffd\u0dda\u0db1, \u0daf\u0ddc\ufffd\u0ddc\u0db9\u0dd9\ufffd\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad \u0dc3\u0dc4 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dbd\u0db1\u0dca\u0daf\u0dda\u0dda\u0dda\u0dc0\u0dad\u0dca\u0dad \u0dc3\u0dc4 \u0dc4\u0ddc\ufffd\u0ddc\u0dbb\u0dba\u0dd2\u0dc3\u0db1\u0dca \u0d9a\u0dd0\u0dd0\u0db8\u0dca\u0db4\u0dc3\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0db6\u0da7\u0daf\u0ddc\ufffd\u0ddc\u0db9\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad."
