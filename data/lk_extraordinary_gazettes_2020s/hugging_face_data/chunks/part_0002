u0dc5\u0da7 \u0d85\u0dd0\u0dcf\u0dc5 \u0d9a\u0dd0\u0db1\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0dba \u0d9a \u0d85\u0d82\u0d9a\u0dba, \u0d89\u0db1 \u0d9a \u0dba\u0d9a\u0ddc\u0da7\u0dba\u0dc3\u0dda \u0d85\u0d82\u0d9a\u0dba \u0dc3 \u0d92 \u0d89\u0db1\u0db8\u0da7 \u0dc4\u0dd2\u0dba\u0d9c\u0d9a \u0d9a \u0db4\u0dd1\u0db8\u0da7 \u0dcf\u0db8\u0dcf\u0da7 \u0d87\u0dad\u0dd2 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db3 \u0dca\u0dad \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba. \u0dba\u0dd4 \u0d9a \u0d9a\u0dc0\u0dbb\u0dba\u0dda \u0dc0 \u0d9a\u0db4\u0dc3 \u0d8b\u0db1 \u0dba\u0d9a\u0dc5\u0dc0\u0dba\u0daf \u201c\u0d85\u0dca\u0dad\u0dad\u0dd2\u0db8 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0dca\u0d9a\u0dba \u0dba\u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2 \u0dba\u0dca\u0db0\u0db4\u0dc5 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d89\u0db8\u0dd4\u0db8 \u0d9a \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u201d \u0dba\u0db1\u0dd4\u0dba\u0dc0\u0dca\u0dad \u0dba\u0dcf \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba. EOG 08 - 0162 2\n\n9 A III \u0dc1 \u0ddc\u0da7\u0dc3 - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dd2\u0d82 \u0dcf \u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dca\u200d\u0dbb\u0dd2 \u0dc3\u0db8\u0dcf\u0da2\u0dcf\u0dc0\u0dcf \u0da2 \u0da2\u0dcf\u0db8\u0db1\u0da2\u0dcf\u0dc1\u0d85 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u0dc2 \u0dd0\u0dc3 \u0db4 \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.08.15\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0da2\u0dcf\u0dba\u0dda \u0db8\u0dd4\u200d\u0dba \u0dba\u0dd0\u0db4\u0dcf\u0daf\u0dcf\u0dba \u0d9a\u0dca\u0dad\u0dad\u0dd4\u0dba\u0dda \u0db8\u0dd4\u200d\u0dba\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3.\n\n\u0d85\u0db1\u0dca\u0dad\u0dd2\u0db8 \u0dd0\u0db8\u0dad\u0dd2 \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dca \u0dc1\u0db8\u0ddc\u0db8\u0dd0\u0dad\u0dd2 \u0dc1\u0db4\u0db4 \u0dc3\u0dc4\u0dcf\u0dcf \u0dc4\u0dd2\u0db8\u0dd2 \u