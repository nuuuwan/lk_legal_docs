a4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bbe\u1fa2 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bb9\u0baa\u0bb0\u0bbe\u1f91\u0bb5 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bbe\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0b89\u0ba3\u0bb5\u1f8c\u0ba9, \u0baf\u0ba4\u0bcd\u0bc6\u0ba4\u0bb9\u0bbf\u1f99\u0bb2\u0bcd\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0bb5\u0bb0\u0bb2\u0bbe\u0bb1\u0bcd\u1fa0\u0b9a\u0bcd \u0b9a\u0bbf\u0bb1\u0baa\u0bcd\u1f97 \u0bae\u0bbf\u0b95\u0bcd\u0b95 \u0bc6\u0bb5\u0bb2\u0bcd\u0bc7\u0bb2 \u0bc7\u0ba4\u0bb5\u0bbe\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bb5\u1f9e\u0b9f\u0bbe\u0ba8\u0bcd\u0ba4 \u0b8e\u0b9a\u0bb2 \u0ba4\u0bbf\u1f9e\u0bb5\u0bbf\u0bb4\u0bbe 2025 \u0b86\u0b95\u0bb8\u0bcd\u0b9f\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd 08 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0bc6\u0bb5\u0bd7\u0bcd\u0bb3\u0bbf\u0b95\u0bcd \u0b95\u0bbf\u0bb4\u0bc8\u0bae \u1f99\u0ba4\u0bb2\u0bcd 2025 \u0b86\u0b95\u0bb8\u0bcd\u0b9f\u0bcd \u0bae\u0bbe\u0ba4\u0bae\u0bcd 14 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0bb5\u0bbf\u0baf\u0bbe\u0bb4\u0b95\u0bcd\u0b95\u0bbf\u0bb4\u0bc8\u0bae \u0bb5\u0bc8\u0bb0 \u0ba8\u0b9f\u0bbe\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0bc8\u0ba4 \u0baf\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bc8\u0bb0\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 2 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab (175 \u0b86\u0bae\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0bae\u0bbe\u0ba9) \u0b92\u1fa8\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0bbe\u0bb0\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 2125/24 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 2019.05.28 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf\u0bbf\u0b9f\u0bcd\u0b9f \u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0bc7\u0b9a\u0bbe\u0b9a\u1fa2\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u1f8a\u0baf\u0bb0\u0b9a\u0bbf\u0ba9\u0bcd \u0b85\u0ba4\u0bbf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0bb5\u0bbe\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbe\u0bbf\u0bc8\u0b95\u0baf\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0ba4\u0baf\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc8\u0bae\u0baf \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0b85\u0bb1\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u1f9e\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd.\n\n\u0b9f\u0baa\u0bcd.\u0b8f. \u0ba4\u0bb0\u0bcd\u0bae\u0b9a\u0bbf\u0bb1\u0bbf,\u0b9f\u0baa\u0bcd.\u0b8f. \u0ba4\u0bb0\u0bcd\u0bae\u0b9a\u0bbf\u0bb1\u0bbf, \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bbe\u0bcd/ \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0b85\u0ba4\u0bbf\u0baa\u0bbe\u0bcd, \u0b95\u0bbe\u1fa2 \u0ba8\u0bbf\u0bbe\u0bcd\u0bb5\u0bbe\u0b95 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd.\n\n\u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f \u0bc6\u0b9a\u0baf\u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd,\u0b95\u0bbe\u1fa2,2025, \u1f9d\u0bc8\u0bb216\n\nECG 07-0256\n\n\u0b87\u0bb2\u0b99\u0bcd\u0bc8\u0b95 \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95 \u0b85\u0b9a\u0bcd\u0b9a\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0b9a\u0bcd\u0b9a\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90."
