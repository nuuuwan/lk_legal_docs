\u0bb1\u0bbf\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0bb2\u0bcd\u0bcd\u0b95\u0bb3\u0bcd\n\n1981 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 57 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95 \u0b95\u0bb0\u0bc8\u0baf\ufffd\u0bcb\u0bb0\u0bae\u0bcd \u0baa\u0bc7\u0ba3\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bb0\u0bc8\u0baf\ufffd\u0bcb\u0bb0 \u0bae\u0bc2\u0bb2\u0bb5\u0bb3 \u0bae\u0bc1\u0b95\u0bbe\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5 \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd 1981 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 57 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95 \u0b95\u0bb0\u0bc8\u0baf\ufffd\u0bcb\u0bb0\u0bae\u0bcd \u0baa\u0bc7\u0ba3\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bb0\u0bc8\u0baf\ufffd\u0bcb\u0bb0 \u0bae\u0bc2\u0bb2\u0bb5\u0bb3 \u0bae\u0bc1\u0b95\u0bbe\u0bae\u0bc8\u0ba4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5 \u0b9a\u0b9f\u0bcd\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd 16 (2\u0b88) \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0bcd\u0baf\u0baf\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0bbf\u0bb3\u0bae\u0bcd\u0bcd\u0baa\u0baa\u0bb0\u0bae\u0bcd 16 (2\u0b88) \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0bcd\u0baf\u0baf\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0bbf\u0bb3\u0bae\u0bcd\u0bcd\u0baa\u0baa\u0bb0\u0bae\u0bcd\n\n\u0b89\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bc7\u0b9a 107 \u0b85\u0bb2\u0b95\u0bc1\u0b95\u0bb3\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0bcd\u0b9f\u0b9f \u0b85\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0b9f\u0bbf \u0bb5\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0bcd\u0b9f\u0b9f\u0b9f\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u