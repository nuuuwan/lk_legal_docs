    "chunk_text": "\u0dba\u0d9a\u0dca\u0da7\u0dca\u0dc1\u0dcf \u0dba \u0dad\u0dd4\u0dc5 \u0db4\u0dd2\u0dba \u0db4\u0db1 \u0d8b\u0dad\u0dd4\u0dbb \u0db1\u0db8\u0dd0\u0dad\u0dd2 \u0d9c\u0dba\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0dba \u0dba\u0dcf \u0dc0\u0dd6 \u0dd9, \u0d85\u0d82\u0d9a 520006 \u0dd9\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0dba\u0db8\u0dca \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 10\u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dd2 \u0d85\u0d82\u0d9a 669 \u0dd9\u0dbb\u0db1 \u0d89\u0da9\u0db8\u0dca \u0dba\u0d9a\u0dca\u0da7\u0dc3 \u0dc3\u0db8\u0dca\u0db6\u0dca\u0dad \u0dba\u0dba\u0dca\u0dad \u0d91\u0dc4\u0dd2 \u0d8b\u0db4\u0dba\u0dbd\u0dc0\u0d9b\u0db1\u0dba\u0dba\u0dc4\u0dd2; \u201c\u0dc1\u0dda\u0dbd\u0db0 \u0dca\u0da0\u0dba\u0dca\u0dad \u0dc3\u0dc4 \u0d89\u0dca\u0dad\u0dba\u0da2\u0dcf\u0dca\u0dad\u0dc2\u0dca\u0dad \u0dcf\u0dc4\u0db1\u0db8\u0dca \u0d85\u0dba\u0dda\u0d9a\u0dca\u0dc2\u0dcf\u0dba\u0dc0\u0dca\u0dad \u0d87\u0dad\u0dd2 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc1\u0dda\u0dc3\u0dca\u0dcf\u0dbb\u201d\u0dad\u0dd3\u0dbb\u0dd4\u0dba\u0dda \u0d9a\u0dd0\u0db6\u0dd2 \u0d85\u0d82\u0d9a 609\u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0 \u0dba\u0dcf\u0dcf \u0d85\u0dd2\u0dad\u0dad\u0dd2\u0dba \u0dc3\u0db8 \u0db8\u0dc4\u0da2\u0dcf\u0db1 \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0dcf\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d8b\u0d9c\u0dc3\u0da7 \u0dba\u0da7\u0dda\u0dc0 \u0dba\u0dca\u0dad\u0db1 \u0dad\u0dd2\u0dd2\u0dba\u0dba\u0daf\u0dd3 \u0d9a\u0dd0\u0db6\u0dd2 \u0d85\u0d82\u0d9a 148\u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0 \u0dba\u0dcf\u0dcf \u0d85\u0dd2\u0dad\u0dad\u0dd2\u0dba \u0dc3\u0db8 \u0dba\u0dca\u0dad\u0db1 \u0d87\u0dad\u0dd4\u0dbd\u0dda \u0d9a\u0dbb \u0dc3\u0d82\u0dba \u0ddd \u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dba\u0dda. \u0db4\u0dd3. \u0dc3\u0dd3. \u0da9\u0dd3. \u0dc3\u0dd2\u0