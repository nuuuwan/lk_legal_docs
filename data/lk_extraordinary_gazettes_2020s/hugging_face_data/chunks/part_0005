2025.09.04\n\n\u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bae\u0bcd \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u1faa\u1f8c \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u1f90\u0ba3\u0bcd\u1f8c \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u1f90\u0b9a\u0bcd \u0baa\u0ba4\u0bbf\u1fab\n\n\u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b9a\u0bbe\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0baa\u0b9f \u0b87\u0bb2. \u0b87\u0bb2. \u0baa\u0bb0\u0baa\u0bcd\u0baa\u0bb3\u1fab \u0b9a\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0ba4\u0bb4\u0bcd \u0b85\u1fa4\u0bb5\u0bb2\u0b95\u0bae\u0bcd\n\n(\u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd) \u0b87\u0bb2.\n\n\u0bae\u0bc0\u0bbe\u0bbf\u0b95\u0bc8\u0bae \u0ba4\u0bbe\u0bc6\u0b9a\u0ba9\u0bcd\u0baa\u0b9a\u0bcd\u0b9a\u0bbf 510221 \u0baa\u0bbf\u0bbe\u0bbf\u1fab 03 0.6583 2521846 \u0ba8\u0bc0\u0bb0\u0bcd\u0bc6\u0b95\u0bbe\u1fa8\u0bae\u0bcd\u1f97\n\n\u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 0002\n\n\u1f99. \u0b95\u0bc1:- \u0bae\u0bb0\u0ba3\u0b9a\u0bbe\u0b9a\u0ba9\u0bae\u0bbf\u0bb2\u0bcd\u0bb2\u0bbe\u0b9a\u0bcd \u0bc6\u0b9a\u0bbe\u0ba4\u0bcd\u1f90\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc8\u0baf \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u1f8a\u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u1faa\u1f8c \u0b9a\u0bbe\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0baa\u0b9f \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0bc8\u0ba4\u1f9c\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0bc8\u0ba4\u1f9c\u0bae\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0baf \u0bc6\u0b9a\u0bbe\u0ba4\u0bcd\u1f90\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u0bb0 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0baf\u0bbe\u0bb3\u1f9e\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0bc8\u0ba4\u1f9c\u0bae\u0bcd \u0b95\