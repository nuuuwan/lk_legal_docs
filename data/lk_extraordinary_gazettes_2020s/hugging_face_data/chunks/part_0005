n\n\u0b89\u0ba4\u0bcd\u0ba4\u0bc7\u0bc7\u0b9a 288 \u0b85\u0bb2\u0b95\u0bc1\u0b95\u0bb3\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0bae\u0bbe\u0bbe\u0b9f\u0bbf \u0bb5\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b89\u0ba4\u0bcd\u0ba4\u0bc7\u0bc7\u0b9a 288 \u0b85\u0bb2\u0b95\u0bc1\u0b95\u0bb3\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0bae\u0bbe\u0bbe\u0b9f\u0bbf \u0bb5\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 13, \u0baa\u0725\u0bb0\ufffd\u0baf\u0bb0\u0bcd \u0ba8\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bb2\u0bb8\u0bcd \u0bae\u0bbe\u0bbe\u0b95\u0bb8\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0ba9\u0bbe\u0bbe\u0ba8\u0bcd\u0ba4\u0bc1 \u0bae\u0bbe\u0bbe\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8, \u0baa\u0725\u0bcb\u0bb2\u0bb5\u0bb2\u0bbe\u0bbe\u0ba9, \u0ba8\u0bc0\u0bb0\u0bcd\u0b95\ufffd\u0bca\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 13, \u0baa\u0725\u0bb0\ufffd\u0baf\u0bb0\u0bcd \u0ba8\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bb2\u0bb8\u0bcd \u0bae\u0bbe\u0bbe\u0b95\u0bb8\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0ba9\u0bbe\u0bbe\u0ba8\u0bcd\u0ba4\u0bc1 \u0bae\u0bbe\u0bbe\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8, \u0baa\u0725\u0bcb\u0bb2\u0bb5\u0bb2\u0bbe\u0bbe\u0ba9, \u0ba8\u0bc0\u0bb0\u0bcd\u0b95\ufffd\u0bca\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1\n\n\u0b9a\u0bc2\u0bb4\u0bb2\u0bcd \u0ba4\u0bbe\u0bbe\u0b95\u0bcd\u0b95 \u0bae\u0ba4\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1 \u0b85\u0bb1\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8 \u0b9a\u0bc2\u0bb4\u0bb2\u0bcd \u0ba4\u0bbe\u0bbe\u0b95\u0bcd\u0b95 \u0bae\u0ba4\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1 \u0b85\u0bb1\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8\n\n1988 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 64 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 2011 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 49 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 1981 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 57 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0bb0\u0bc8\u0bc8\u0baf\u0727\u0bcb\u0bb0\u0bae\u0bcd \u0baa\u0725\u0ba3\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bb0\u0bc8\u0bc8\u0baf\u0727\u0bcb\u0bb0 \u0bae\u0bc2\u0bb2\u0bb5\u0bb3 \u0bae\u0bc1\u0b95\u0bbe\u0bbe\u0bae\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5 \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd 16(1) \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bae\u0bc8\u0bc8\u0bb5\u0bbe\u0bbe\u0b95 \u0baa\u0ba4\u0bcd\u0ba4\u0bb0\u0bae\u0bc1\u0bb2\u0bcd\u0bb2, \u0baa\u0ba9\u0bcd\u0ba9\u0bbf\u0bbf\u0baa\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0bb5\u0bc0\u0ba4\u0bbf\u0bbf, \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 1087 \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0b95\u0bb5\u0bb0\u0bbf\u0bbf\u0baf\u0bc1\u0b9f\u0bc8\u0bc8\u0baf \u0bb9\u0730\u0bcb\u0bae\u0bcd\u0bb2\ufffd\u0ba3\u0bcd\u0b9f\u0bcd \u0bb8\u0bcd\u0b95\u0bc8\u0bc8\u0bb2\u0bc8\u0bc8\u0ba9\u0bcd \u0ba4\u0ba9\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0bb0\u0bcd \u0ba8\u0bbf\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bbe\u0bbe\u0bb2\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0bb5\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bc0\u0bb0\u0bcd\u0b95\ufffd\u0bca\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1, \u0baa\u0725\u0bcb\u0bb2\u0bb5\u0bb2\u0bbe\u0bbe\u0ba9, \u0baa\u0725\u0bb0\ufffd\u0baf\u0bb0\u0bcd \u0ba8\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bb2\u0bb8\u0bcd \u0bae\u0bbe\u0bbe\u0b95\u0bb8\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0ba9\u0bbe\u0bbe\u0ba8\u0bcd\u0ba4\u0bc1 \u0bae\u0bbe\u0bbe\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8, \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 13 \u0b8e\u0ba9\u0bc1\u0bae\u0bbf\u0bbf\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd \u0ba8\u0bbf\u0bbf\u0bb0\u0bcd\u0bae\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0b89\u0ba4\u0bcd\u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 288 \u0b85\u0bb2\u0b95\u0bc1\u0b95\u0bb3\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0bae\u0bbe\u0bbe\u0b9f\u0bbf \u0bb5\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0b9a\u0bc2\u0bb4\u0bb2\u0bcd \u0ba4\u0bbe\u0bbe\u0b95\u0bcd\u0b95 \u0bae\u0ba4\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u0b9f\u0bc1 \u0b85\u0bb1\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8 \u0baa\u0725\u0bca\u0ba4\u0bc1\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bbe\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0b95 \u0b95\u0bc0\u0bb4\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b87\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0bb2\u0bcd \u0ba8\u0bbe\u0bbe\u0bb3\u0bbe\u0bbe\u0ba8\u0bcd\u0ba4\u0bae\u0bcd \u0bae\u0bc1. \u0baa. 8.30 \u0bae\u0ba3\u0bbf\u0bbf \u0bae\u0bc1\u0ba4\u0bb2\u0bcd \u0baa\u0bbf\u0bbf. \u0baa. 4.15 \u0bae\u0ba3\u0bbf\u0bbf \u0bb5\u0bb0\u0bc8\u0bc8 2025.09.03 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf \u0bae\u0bc1\u0ba4\u0bb2\u0bcd 30 \u0ba8\u0bbe\u0bbe\u0b9f\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd. (\u0bb5\u0bbe\u0bbe\u0bb0 \u0b87\u0bb1\u0bc1\u0ba4\u0bbf\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb0\u0b9a \u0bb5\u0bbf\u0bbf\u0b9f\u0bc1\u0bae\u0bc1\u0bb1\u0bc8\u0bc8 \u0ba4\u0bbf\u0bbf\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bb5\u0bbf\u0bbf\u0bb0),"
