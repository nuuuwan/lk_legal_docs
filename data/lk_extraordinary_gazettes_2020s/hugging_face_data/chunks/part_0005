    "doc_type": "lk_extraordinary_gazettes_2020s",
    "doc_id": "2025-09-29-2025-09-29-2456-02-en",
    "num": "2025-09-29-2456-02-en",
    "date_str": "2025-09-29",
    "description": "Inland Revenue Department - Value added Tax Act No. 14 of 2002 Conditions and specifications to operate Risk based Refund Scheme",
    "url_metadata": "https://documents.gov.lk/view/extra-gazettes/egz_2025.html",
    "lang": "en",
    "url_pdf": "https://documents.gov.lk/view/extra-gazettes/2025/9/2456-02_E.pdf",
    "doc_number": "2456/02",
    "chunk_id": "2025-09-29-2025-09-29-2456-02-en-0001",
