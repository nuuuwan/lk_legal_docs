    "chunk_text": "\u0dd9\u0db8\u028f \u0db4\u0dc4\u0dad \u026a\u0dc3\u0dca\u0dad\u0dbb \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0d89\u0da9\u023c \u0dd9\u0db4\u02a3\u01d0 \u0da2\u0db1 \u0d9a\u0da7\u0252\u01ae\u0dad\u00fa \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0255 \u0db6\u0dc0\u01ae, \u0d92\u0dc0\u0dcf \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae \u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u0dba\u0da7\u0dd9\u01ae \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u01e9 \u0dbd\u0db6\u0db1 \u0db6\u0dc0\u01ae, \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 5 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (1) \u0d8b\u0db4 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0d9a\u0dd8\u027f\u0d9a\u0259\u0db8, \u0db4\u0276 \u0dc3\u023c\u0db4\u01ae, \u0d89\u0da9\u023c \u0dc3\u0dc4 \u0dc0\u0dcf\u025c\u0db8\u0dcf\u0259\u0d9c \u0d85\u0db8\u0dcf\u0dad\u0255, \u00fd\u0dbb\u0d9c\u0db8\u0dd9\u0118 \u0dd9\u0daf\u02a3\u01e6 \u0dbd\u0dcf\u0262 \u0d9a\u0dcf\u01e6\u0dad \u0dc0\u0db1 \u0db8\u0db8 \u0dd9\u0db8\u0250\u01e6 \u021d\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u023d.\n\n01. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb \u2018A\u2019 - \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad - \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0087\u0d8b\u01b1\u0dbb\u0da7: \u0d87\u0dc5; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0dd9\u0db8\u0db8 \u0d89\u0da9\u0dd9\u023c \u0d89\u01af\u025c \u0dd9\u0d9a\u02a3\u0da7\u0dc3; \u0daf\u00fd\u0dab\u0da7: \u0dd9\u0dc0\u02a3\u0178\u0dc3\u01e6 \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb B \u0dc3\u0dc4 \u0d92. \u0d91\u013c. \u025e\u01d8\u011b \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0d92. \u0d91\u013c. \u025e\u01d8\u011b \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad.\n\n02. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb \u2018B\u2019 - \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad - \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0198\u0d8b\u01b1\u0dbb\u0da7: \u0d92. \u0d91\u013c. \u025e\u01d8\u011b \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb A \u0dc3\u0dc4 \u0dd9\u00fa. \u0d92. \u0da2\u0dc3\u0dca\u0179\u0db1\u0dcf \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0dd9\u0db8\u0db8 \u0d89\u0da9\u0dd9\u023c \u0d89\u01af\u025c \u0dd9\u0d9a\u02a3\u0da7\u0dc3, \u0db4\u0dcf\u0dbb \u0dc3\u0dc4 \u0d9a\u0db4\u0db1 \u0dbd\u0daf \u0d9a\u0dcf\u01e9\u0dc0; \u0daf\u00fd\u0dab\u0da7:\u0db8\u0dcf \u0dd9\u0db1\u0262 \u0286\u0262\u0dc0\u0dcf \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0d92. \u0d91\u013c. \u025e\u01d8\u011b \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad.\n\n03. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb \u2018C\u2019 - \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad - \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0076\u0d8b\u01b1\u0dbb\u0da7: \u0db4\u0dcf\u0dbb; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0dd9\u0db8\u0db8 \u0d89\u0da9\u0dd9\u023c \u0d89\u01af\u025c \u0dd9\u0d9a\u02a3\u0da7\u0dc3; \u0daf\u00fd\u0dab\u0da7: \u0dd9\u00fa. \u0dd9\u00fa. \u0db1\u0dcf\u0dba\u0db1\u0dcf \u0dc1\u0255\u0dcf\u0db8\u0264 \u026b\u0dbb\u0286\u0d82\u0dc4 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb D \u0dc3\u0dc4 \u0db8\u0dcf\u0dd9\u0db1\u0262 \u0286\u0262\u0dc0\u0dcf \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0db8\u0dcf \u0dd9\u0db1\u0262 \u0286\u0262\u0dc0\u0dcf \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u0d9a\u0db4\u0db1 \u0dbd\u0daf \u0d9a\u0dcf\u019f\u0dc0.\n\n04. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb \u2018D\u2019 - \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad - \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0141\u0d8b\u01b1\u0dbb\u0da7: \u0db8\u0dcf\u0dd9\u0db1\u0262 \u0286\u0262\u0dc0\u0dcf \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad, \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb C \u0dc3\u0dc4 \u0dd9\u00fa. \u0dd9\u00fa. \u021d\u0db7\u0dcf \u0d89\u0dd9\u0db1\u02a4\u0d9a\u0dcf \u026b\u0dbb\u0286\u0d82\u0dc4 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0dd9\u0db8\u0db8 \u0d89\u0da9\u0dd9\u023c \u0d89\u01af\u025c \u0dd9\u0d9a\u02a3\u0da7\u0dc3; \u0daf\u00fd\u0dab\u0da7: \u0dd9\u00fa. \u0dd9\u00fa. \u0da2\u0d9c\u01ae \u0db0\u023c\u023d\u0d9a \u026b\u0dbb\u0286\u0d82\u0dc4 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb E \u0dc3\u0dc4 \u0db8\u0dcf\u0dd9\u0db1\u0262 \u0286\u0262\u0dc0\u0dcf \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0db8\u0dcf \u0dd9\u0db1\u0262 \u0286\u0262\u0dc0\u0dcf \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad.\n\n05. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb \u2018E\u2019 - \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad - \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0165\u0d8b\u01b1\u0dbb\u0da7: \u0db8\u0dcf\u0dd9\u0db1\u0262 \u0286\u0262\u0dc0\u0dcf \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb D \u0dc3\u0dc4 \u0dd9\u00fa. \u0dd9\u00fa. \u0db1\u0dba\u0db1\u0dcf \u0dc1\u0255\u0dcf\u0db8\u0264 \u026b\u0dbb\u0286\u0d82\u0dc4 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0dd9\u0db8\u0db8 \u0d89\u0da9\u0dd9\u023c \u0d89\u01af\u025c \u0dd9\u0d9a\u02a3\u0da7\u0dc3; \u0daf\u00fd\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb F \u0dc3\u0dc4 \u0db8\u0dcf\u0dd9\u0db1\u0262 \u0286\u0262\u0dc0\u0dcf \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0db8\u0dcf \u0dd9\u0db1\u0262 \u0286\u0262\u0dc0\u0dcf \u0dc3\u0dc4 \u0dad\u0dc0\u01ae \u0d85\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d92\u0d9a\u0dbd\u0dc0\u01ae\u0dad \u0dd9\u0dc4\u0dc0\u01ae \u0db8\u0dcf\u0daf\u023c\u0dc0\u01ae\u0dad."
