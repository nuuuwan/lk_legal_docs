b3 \u0dca\u0dad \u0d9a\u0d82\u0d9a 620369 \u0dcf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0db8\u0d85 \u0d9a\u0dcf\u0dcf\u0dc5 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd \u0dcf\u0dbb\u0dd3 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba\u0dda \u0daf\u0dd3\u0d85 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dba \u0dba \u0db8 \u0dba\u0db8\u0d9a \u0d9a \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba\u0dda \u0daf\u0dd3\u0d85 \u0daf\u0dd2\u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba \u0db8\u0dd2\u0db1\u0dd4 \u0d9a \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba\u0dda \u0daf\u0dd3\u0d85 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a \u0d9a \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba \u0d9a \u0dba\u0d9a\u0dca\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dba\u0dda \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba\u0dda \u0daf\u0dd3\u0d85 \u0dba \u0ddd \u0db8\u0dd2\u0db1\u0dd4 \u0d9a\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dba\u0dda \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba\u0dda \u0daf\u0dd3 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dcf \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dd2\u0dba \u0dd0\u0d9a\u0dd2\u0dba. \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb\u0d85 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd \u0dcf\u0dbb\u0dd2\u0dba\u0d9c\u0dca\u0dad\u0d85 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dba \u0dba \u0dba\u0db8\u0d9a \u0d9a\u0dc0\u0dbb\u0dba\u0dcf\u0dba\u0d9c\u0dca\u0dad\u0d85 \u0dba \u0ddd \u0dc4\u0dd2\u0db8\u0dd2\u0d9a \u0d9a \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba \u0d9a \u0dba\u0d9a\u0dca\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dba\u0d9c\u0dca\u0dad \u0dbd\u0db6\u0dcf \u0d9c\u0dcf \u0dd0\u0d9a\u0dd2\u0dba. \u0db4\u0dd3. \u0dc3\u0dd3. \u0da9\u0dd3. \u0dc3\u0dd2\u0dc1\u0dda\u0dbb\u0dcf, \u0d89\u0da9 \u0d9a \u0dc4\u0dd2\u0db8\u0