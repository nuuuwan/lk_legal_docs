dad\u0dca\u0dad\u0dd1\u0dd1 \u0d85\u0da7 \u0daf\u0dc4\u0dc3\u0dca \u0dc4\u0dad\u0dca\u0dc3\u0dd2\u0dba \u0dad\u0dd2\u0dc3\u0dca \u0db1\u0dc0\u0dba\u0dba\u0dd2 \u0dc1\u0dad \u0dc4\u0dad\u0dc5\u0dd2\u0dc3\u0dca \u0db4\u0dc4\u0d9a\u0dca (\u0dbb\u0dd4. 62,522,578,739.45) \u0dbd\u0dd9\u02e2\u0dc3 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1\u0dba \u0d9a\u0dbb \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0dd9\u02e2\u0db1\u0dca \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0dca \u0daf\u0dd0\u0dd0\u0dbb\u0dd3\u0db8\u0da7 \u0db8\u0dd9\u02de\u0db8 \u0d85\u0dc0\u0dc3\u0dbb\u0dba \u0dbd\u0db6\u0dcf\u0dcf \u0daf\u0dd9\u0dd9\u0db8\u0dd2.\n\n\u0d92. \u0d92. \u0dc3\u0dd3. \u0da2\u0dda\u0dda. \u0dbb\u0dcf\u0dcf\u0da2\u0dbb\u0dad\u0dca\u0db1, \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb, \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dad'\n\n2025 \u0da2\u0dd6\u0dbd\u0dd2 \u0db8\u0dc3 30 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1.\n\nEOG 09-0169/3\n\n________________________________________\n\n\u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2 \u0db6\u0dbd\u0dba\n\n2025 \u0d85\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0db8\u0dca \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\ufffd \u0dc4\u0dba (6) \u0dc0\u0db1 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db1\u0dd2\u0dbd \u0d9a\u0dcf\u0dcf\u0dbd\u0dba 2017 \u0dc3\u0dd0\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 26 \u0daf\u0dd2\u0db1\u0dd9\ufffd\u0db