 (\u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dc4\u0ddc\ufffd\u0ddc\u0dad\u0dca)$ 1,500\n\n2\u0db1\u0dc0 \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\u0dc0\u0dbd \u0db7\u0dde\u02dd\u0dde\u0dad\u0dd2\u0d9a \u0dc3\u0dca\u0dca\u0dc0\u0db7\u0dcf\u0dcf\u0dc0\u0dba(\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d96\u0dc2\u0db0\u0dba\u0d9a \u0daf\u0dd0\u0dd0\u0db1\u0da7 \u0db1\u0ddc\ufffd\u0ddc\u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0db1\u0dc0 \u0db7\u0dde\u02dd\u0dde\u0dad\u0dd2\u0d9a \u0dc3\u0dca\u0dca\u0dc0\u0dbb\u0dd6\u0db4\u0dba\u0d9a\u0dca)$ 1,000\n\n3\u0db1\u0dc0 \u0dc3\u0d82\u0d82\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\u0dba(\u0d96\u0dc2\u0db0 \u0daf\u0dd9\u0dd9\u0d9a\u0d9a\u0dca \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0d8a\u0da7 \u0dc0\u0dd0\u0dd0\u0da9\u0dd2 \u0dc3\u0d82\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0dc0\u0d9a\u0dca \u0dc3\u0d82\u0d82\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c \u0d9a\u0dbb \u0dc3\u0dcf\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0d91\u0d9a\u0dca \u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf\u0dcf \u0dc3\u0dca\u0dca\u0dc0\u0db7\u0dcf\u0dcf\u0dc0\u0dba\u0d9a \u0d86\u0d9a\u0dcf\u0dcf\u0dbb\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc0\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0db8\u0dd3\u0da7 \u0db4\u0dd9\u0dd9\u0dbb \u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2 \u0d9a\u0dbb \u0db1\u0ddc\ufffd\u0ddc\u0db8\u0dd0\u0dd0\u0dad\u0dd2 \u0db1\u0dc0 \u0dc3\u0d82\u0d82\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\u0dba\u0d9a\u0dca )$ 1,500\n\n4\u0db1\u0dc0 \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\u0dba (\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0daf\u0dd0\u0dd0\u0db1\u0da7\u0db8\u0dad\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d95\u0db1\u0dd1\u0dd1\u0db8 \u0d96\u0dc2\u0db0\u0dba\u0d9a \u0db1\u0dc0 \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\u0dba\u0d9a\u0dca )\n\n(\u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba)\n\n$ 750\n\nI fldgi: (I) fPoh - Y%S ,xld m%cd;dka;%sl iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'09'043 A\n\nI \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\n\nII \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dbaIII \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\n\n\u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dad\u0dd4\u0dc0(\u0d87\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0dcf \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca\n\n\u0da2\u0db1\u0db4\u0daf \u0da9\u0ddc\u02d0\u0ddc\u0dbd\u0dbb\u0dca)\n\n(\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba)\n\n(i) \u0d85\u0db7\u0dca\u200d\u0dba\u0dba\u0db1\u0dca\u0dad\u0dbb\u0dd2\u0d9a\u0dc0 \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d96\u0dc2\u0db0 (\u0d8b\u0daf\u0dcf\u0dcf: \u0db8\u0dd4\u0d9b \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dd9\ufffd\u0db1\u0dca, \u0d91\u0db1\u0dca\u0db1\u0dad\u0dca \u0db8\u0d9c\u0dd2\u0db1\u0dca, \u0d86\u0d9d\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dab\u0dba\u0dd9\ufffd\u0db1\u0dca)\n\n(ii) \u0d85\u0db1\u0dd9\ufffd\u0d9a\u0dd4\u0dad\u0dca \u0dc1\u0dbb\u0dd3\u0dbb \u0d9a\u0dd4\u0dc4\u0dbb \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d96\u0dc2\u0db0 (\u0d8b\u0daf\u0dcf\u0dcf: \u0d85\u0d9a\u0dca\u0dc2\u0dd2\u0db8\u0dba, \u0d9a\u0db1, \u0db1\u0dcf\u0dcf\u0dc3\u0dba, \u0d9c\u0dd4\u0daf \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba, \u0dba\u0ddd\ufffd\u0ddd\u02ea\u0db1\u0dd2 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba)\n\n(iii) \u0dc1\u0dbb\u0dd3\u0dbb\u0dba\u0dda\u0dda\u024f \u0db6\u0dcf\u0dcf\u0dc4\u0dd2\u0dbb\u0dc0 \u0d86\u0dbd\u0dda\u0dda\u0262\u0db4\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2 \u0d86\u0dc3\u0dcf\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0dc3\u0dca\u0dca\u0da7\u0dd9\ufffd\u0dbb\u0ddc\ufffd\u0ddc\u0dba\u0dd2\u0da9 \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\n\n$ 500\n\nB \u0d9a\u0dcf\u0dcf\u0dab\u0dca\u0da9\u0dba:-\n\n\u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2 \u0d86\u0dc3\u0dcf\u0dcf\u0daf\u0db1 \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0dc3\u0dca\u0dca\u0da7\u0dd9\ufffd\u0dbb\u0ddc\ufffd\u0ddc\u0dba\u0dd2\u0da9 \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0dc4\u0dd0\u0dd0\u0dbb \u0dc3\u0db8 \u0db8\u0dad \u0d86\u0dbd\u0dda\u0dda\u0262\u0db4\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1\u0dc0\u0dbd \u0db7\u0dde\u02dd\u0dde\u0dad\u0dd2\u0d9a \u0db4\u0dbb\u0dcf\u0dcf\u0dc3\u0dba\u0db1\u0dca\n\n$ 200\n\n5\u0da2\u0ddb\u0ddb\u0dc0 \u0da0\u0dd2\u0d9a\u0dd2\u0dad\u0dca\u0dc3\u0d9a \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0da2\u0ddb\u0ddb\u0dc0 \u0dad\u0dcf\u0dcf\u0d9a\u0dca\u0dc2\u0dab\u0dd2\u0d9a \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1$ 2,000\n\n6\u0daf\u0dd4\u0dbb\u0dca\u0dbd\u0db7 \u0dbb\u0ddd\ufffd\u0ddd\u02ea\u0d9c \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0d96\u0dc2\u0db0 \u0dc3\u0dc4 \u0d9a\u0dd4\u0da9\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0d96\u0dc2\u0db0 (\u0db8\u0dda\ufffd \u0db4\u0dca\u200d\u0dbb\u0db7\u0dda\u0dda\u0233\u0daf\u0dba\u0da7 \u0d85\u0dba\u0dad\u0dca \u0db1\u0dd2\u0dc2\u0dca\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dbd\u0dd0\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dc0 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d96\u0dc2\u0db0 \u0db1\u0dd2\u0dba\u0dcf\u0dcf\u0db8\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0dda\u0dda\u024f (NMRA)\u0dc4\u0dd2 \u0db1\u0dd2\u0dbd \u0dc0\u0dd9\u0dd9\u0db6\u0dca \u0d85\u0da9\u0dc0\u0dd2\u0dba\u0dda\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0dda\u0229.)\n\n\u0db1\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dbd\u0dda\u0dda\u0262\n\n7\u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2 \u0dc3\u0dc4\u0dad\u0dd2\u0d9a\u0dba \u0dc0\u0dc3\u0dbb \u0db4\u0dc4\u0d9a\u0da7 \u0db4\u0dc3\u0dd4 \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\n\n(\u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba)$ 750\n\n(\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba)\n\nA \u0d9a\u0dcf\u0dcf\u0dab\u0dca\u0da9\u0dba:-\n\n(i) \u0d85\u0db7\u0dca\u200d\u0dba\u0dba\u0db1\u0dca\u0dad\u0dbb\u0dd2\u0d9a\u0dc0 \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d96\u0dc2\u0db0 (\u0d8b\u0daf\u0dcf\u0dcf: \u0db8\u0dd4\u0d9b \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dd9\ufffd\u0db1\u0dca, \u0d91\u0db1\u0dca\u0db1\u0dad\u0dca \u0db8\u0d9c\u0dd2\u0db1\u0dca, \u0d86\u0d9d\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dab\u0dba\u0dd9\ufffd\u0db1\u0dca)\n\n(ii) \u0d85\u0db1\u0dd9\ufffd\u0d9a\u0dd4\u0dad\u0dca \u0dc1\u0dbb\u0dd3\u0dbb \u0d9a\u0dd4\u0dc4\u0dbb \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d96\u0dc2\u0db0 (\u0d8b\u0daf\u0dcf\u0dcf: \u0d85\u0d9a\u0dca\u0dc2\u0dd2\u0db8\u0dba, \u0d9a\u0db1, \u0db1\u0dcf\u0dcf\u0dc3\u0dba, \u0d9c\u0dd4\u0daf \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba, \u0dba\u0ddd\ufffd\u0ddd\u02ea\u0db1\u0dd2 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba)"
