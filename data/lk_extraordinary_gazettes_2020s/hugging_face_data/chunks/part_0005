\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba \u0db0\u0dd4\u0dbb\u0dba\n\n1.\u0d9c\u0dbb\u0dd4 \u0db6\u0dd2\u0db8\u0dbd\u0dca \u0db1\u0dd2\u0dbb\u0ddd\ufffd\u0ddd\ufffd\u0dc2\u0db1\u0dca \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dcf, \u0db4\u0dcf\u0dcf.\u0db8.-\u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dcf\u0dc4\u0db1, \u0db8\u0dc4\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c, \u0dc0\u0dbb\u0dcf\u0dcf\u0dba \u0dc3\u0dc4 \u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\n\n2.\u0d9c\u0dbb\u0dd4 \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0dad\u0dd2\u0dbd\u0d9a \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dcf, \u0db4\u0dcf\u0dcf.\u0db8.-\u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1, \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba \u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db4\u0dbb\u0dd2\u0daf\u0dd2, \u0d86\u0da0\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0d91\u0db1\u0dca. \u0d91\u0dc3\u0dca. \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a, \u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca.\n\n2025 \u0d94\u0d9a\u0dca\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0db6\u0dbb\u0dca \u0db8\u0dc3 10 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba,\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 01.\n\nEOG 10 - 0116/1\n\nI \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3 : (I) \u0da1\u200d\u0dd9\u0dd9\ufffd\u0daf\u0dba - \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba - 2025.10.112\n\n\u0db1\u0dd2\u0dc0\u0dda\u0dda\u0daf\u0db1\u0dba \u0db8\u0d9c\u0dda\u0118 \u0d85\u0d82\u0d82\u0d9a\u0dba : \u0db4\u0dd3\u0d91\u0dc3\u0dca/\u0dc3\u0dd3\u0d91\u0dc3\u0dca\u0d92/00/1/1/1/IX. \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u0dda\u024f \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda 47(3)(\u0d86) \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0 \u0dba\u0da7\u0dad\u0dda\u0dda\u01ae, \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9c\u0dbb\u0dd4 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0dca\u200d\u0dba\u0dba \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc3\u0dd2\u0dba \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0dca\u200d\u0dba\u0dba \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba \u0db0\u0dd4\u0dbb\u0dba\u0db1\u0dca\u0d9c\u0dd9\ufffd\u0db1\u0dca 2025 \u0d94\u0d9a\u0dca\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0db6\u0dbb\u0dca \u0db8\u0dc3 10 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d89\u0dbd\u0dca\u0dbd\u0dcf\u0dcf \u0d85\u0dc3\u0dca\u0dc0\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0