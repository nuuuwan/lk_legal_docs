    "chunk_text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2, \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0dc0\u0db1 \u0db8\u0db8, 1979 \u0d85\u0d82\u0d82\u0d9a 61 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0db8\u0dc4\u0da2\u0db1 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0db4\u0db1\u0dad\u0dda\u01ae 2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0 \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0d85\u0db1\u0dd4\u0dc0 \u0db8\u0dd9\ufffd\u0db8 \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0daf\u0db1\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dc4\u0dad \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc0\u0db1 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0dc0\u0db1\u0dca \u0dc3\u0dd0\u0dd0\u0db4\u0dba\u0dd3\u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db1\u0dd2\u0dbb\u0dad \u0dc0\u0db1 \u0d95\u0db1\u0dd1\u0dd1\u0db8 \u0dbb\u0dcf\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dbb\u0da2\u0dba\u0dda\u024f \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u023c\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dcf\u0dbb \u0dc3\u0db8\u0dd2\u0dad\u0dd2\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d92\u0dc0\u0dcf\u0dcf\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0dc1\u0dcf\u0dcf\u0d9b\u0dcf\u0dcf\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0dc0\u0db1\u0dca \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0db1\u0dca\u200d\u0dba\u0dba \u0da2\u0db1\u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dcf\u0d9c\u0dd9\ufffd\u0db1 \u0dba\u0dcf\u0dcf\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0dad\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0dc0\u0db1 \u0db6\u0dc0 \u0dc3\u0dc4 \u0d91\u0d9a\u0dd3 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0dc0\u0da7 \u0d85\u0dc0\u0dc4\u0dd2\u0dbb\u0dba\u0d9a\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db6\u0dcf\u0dcf\u0db0\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0db6\u0dc0 \u0dc3\u0dd0\u0dd0\u0dc5\u0d9a\u0dd2\u0dbd\u0dca\u0dbd\u0da7 \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0d95\u0db1\u0dd1\u0dd1\u0db8 \u0dbb\u0dcf\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dbb\u0da2\u0dba\u0dda\u024f \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u023c\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dcf\u0dbb \u0dc3\u0db8\u0dd2\u0dad\u0dd2\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d92\u0dc0\u0dcf\u0dcf\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0dc1\u0dcf\u0dcf\u0d9b\u0dcf\u0dcf\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db4\u0dc4\u0dad \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f \u0dc3\u0db3\u0dc