    "chunk_text": "(murhq;fj;jpd; mjpfhuj;Jld; gpuRupf;fg;gl;lJ)gFjp I : njhFjp (I) - nghJ\n\nmurhq;f mwptpj;jy;fs;\n\n,yq;ifr; rdehaf Nrhryprf; FbauR th;j;jkhdg; gj;jphpif\n\nmjp tpNr\\khdJ\n\nwxl 2451/17 - 2025 wf.daia;= ui 27 jeks nodod - 2025'08'272451/ 17 Mk; ,yf;fk; - 2025 Mk; Mz;L xfj;J khjk; 27 Me; jpfjp Gjd;fpoik\n\nY%S ,xld m%cd;dka;%sl iudcjd\u00a7 ckrcfha .ei\u00dc m;%h\n\nw;s \u00fafYI\n\n,t; mjptpNrl tu;j;jkhdpia www.documents.gov.lk vDk; ,izaj;jsj;jpypUe;J gjptpwf;fk; nra;a KbAk;.\n\n1A - G 45241 \u2014 05 (2025/08)\n\n\u0b8e\u0ba9\u0ba4\u0bc1 \u0b87\u0bb2.:HA/05/20/01/01/34\n\n\u0ba8\u0723\u0bca\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf\u0b9a\u0bc1\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0ba8\u0bbf\u0bbf\u0baf\u0bae\u0ba9\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bb2\u0bcd\u0ba8\u0723\u0bca\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf\u0b9a\u0bc1\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0ba8\u0bbf\u0bbf\u0baf\u0bae\u0ba9\u0bae\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bb2\u0bcd\n\n\u0ba8\u0723\u0bca\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf\u0b9a\u0bc1 \u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd (107 \u0b86\u0bae\u0bcd \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0\u0bae\u0bcd) 03 \u0b86\u0bb5\u0ba4\u0bc1 \u0b9a\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b95\ufffd\u0bcc\u0bb0\u0bb5 \u0baa\u0725\u0bca\u0ba4\u0bc1 \u0ba8\u0bbf\u0bbf\u0bb0\u0bcd\u0bb5\u0bbe\u0bbe\u0b95, \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3 \u0b9a\u0baa\u0bc8\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\ufffd\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0bbf\u0ba9\u0bbe\u0bbe\u0bb2\u0bcd 2025, \u0baf\u0bc2\u0bb2\u0bc8\u0bc8 \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 04 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0ba8\u0b9f\u0bc8\u0bc8\u0bae\u0bc1\u0bb1\u0bc8\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0bb5\u0b95\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0bc0\u0bb4\ufffd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba8\u0bbf\u0bbf\u0baf\u0bae\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc6\u0bc6\u0ba9 \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb2\u0bcd \u0b85\u0bb1\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bbf\u0bb1\u0ba4\u0bc1.\n\n1. \u0b95\u0bbf\u0bbf\u0ba3\u0bcd\u0ba3\u0bbf\u0bbf\u0baf\u0bbe\u0bbe 06, \u0b9c\u0bbe\u0bbe\u0bb5\u0bbe\u0bbe \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc8\u0bc8, \u0b87\u0bb2. 01/\u0b8f \u0b87\u0bb2\u0bcd \u0bb5\u0ba4\u0bbf\u0bbf\u0baf\u0bc1\u0bae\u0bcd, \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1. \u0bae\u0bb9\u0bcd\u0bb0\u0bc2\u0baa\u0bcd \u0bae\u0bc1\u0bb9\u0bae\u0bcd\u0bae\u0ba4\u0bc1 \u0bae\u0bc1\u0ba9\u0bbe\u0bbe\u0bb8\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0b95\ufffd\u0bcb\u0ba3\u0bae\u0bb2\u0bc8\u0bc8 \u0ba8\u0bc0\u0ba4\u0bbe\u0bbe\u0b9a\u0ba9 \u0bb5\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0ba4\u0bae\u0bbf\u0bbf\u0bb4\u0bcd \u0bae\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0baa\u0ba3\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0723\u0bca\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf\u0b9a\u0bc1 \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\ufffd\u0b95,\n\n2. \u0b95\u0bae\u0bcd\u0baa\u0bb9\u0bbe\u0bbe, \u0b95\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0b9f, \u0b87\u0bb2. 23/2 \u0b87\u0bb2\u0bcd \u0bb5\u0ba4\u0bbf\u0bbf\u0baf\u0bc1\u0bae\u0bcd, \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0bae\u0ba4\u0bbf\u0bbf \u0bae\u0bc1\u0ba4\u0bc1\u0bae\u0bc1\u0ba9\u0bbf\u0bbf \u0bb0\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0b95\u0bbe\u0bbe \u0bb8\u0bcd\u0bb0\u0bc0\u0bae\u0bbe\u0bbe\u0bb2\u0bbf \u0b9a\u0bbf\u0bbf\u0bb2\u0bcd\u0bb5\u0bbe\u0bbe \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd, \u0b95\u0bae\u0bcd\u0baa\u0bb9\u0bbe\u0bbe \u0ba8\u0bc0\u0ba4\u0bbe\u0bbe\u0b9a\u0ba9 \u0bb5\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0b9a\u0bbf\u0bbf\u0b99\u0bcd\u0b95\u0bb3 \u0bae\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0baa\u0ba3\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0723\u0bca\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf\u0b9a\u0bc1 \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\ufffd\u0b95,\n\n3. \u0bb5\u0bb8\u0bcd\u0b95\u0b9f\u0bc1\u0bb5, \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0b95\u0bae \u0bb5\u0bc0\u0ba4\u0bbf\u0bbf, \u0b87\u0bb2. 161 \u0b87\u0bb2\u0bcd \u0bb5\u0ba4\u0bbf\u0bbf\u0baf\u0bc1\u0bae\u0bcd, \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1 \u0b85\u0b95\u0bae\u0bcd\u0baa\u0725\u0bca\u0b9f\u0bbf \u0bb9\u0bbf\u0bbf\u0bae\u0bbe\u0bbe\u0bb2 \u0b9a\u0ba8\u0bcd\u0ba4\u0bc7\u0bc7\u0bb7\u0bcd \u0ba4 \u0b9a\u0bbf\u0bbf\u0bb2\u0bcd\u0bb5\u0bbe\u0bbe \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bb3\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb1\u0bc8\u0bc8\u0bc8 \u0ba8\u0bc0\u0ba4\u0bbe\u0bbe\u0b9a\u0ba9 \u0bb5\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0b9a\u0bbf\u0bbf\u0b99\u0bcd\u0b95\u0bb3 \u0bae\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0baa\u0ba3\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0723\u0bca\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf\u0b9a\u0bc1 \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\ufffd\u0b95,\n\n4. \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0b95\ufffd\u0bcb\u0ba3\u0bae\u0bb2\u0bc8\u0bc8, \u0bae\u0bbf\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bbe\u0bb0 \u0ba8\u0bbf\u0bbf\u0bb2\u0bc8\u0bc8\u0baf \u0bb5\u0bc0\u0ba4\u0bbf\u0bbf, \u0b87\u0bb2. 100 \u0b87\u0bb2\u0bcd \u0bb5\u0ba4\u0bbf\u0bbf\u0baf\u0bc1\u0bae\u0bcd, \u0b9a\u0bc6\u0bc6\u0bb2\u0bcd\u0bb5\u0bbf\u0bbf \u0b89\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0ba3\u0bcd\u0b9f\u0bbf\u0b9a\u0bc6\u0bc6\u0b9f\u0bcd\u0b9f\u0bbf \u0b9a\u0b9a\u0bbf\u0bbf\u0b9a\u0bc1\u0ba4\u0bbe\u0bbe\u0b9c\u0bbf\u0bbf\u0ba9\u0bbf\u0bbf \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0b95\ufffd\u0bcb\u0ba3\u0bae\u0bb2\u0bc8\u0bc8 \u0ba8\u0bc0\u0ba4\u0bbe\u0bbe\u0b9a\u0ba9 \u0bb5\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0ba4\u0bae\u0bbf\u0bbf\u0bb4\u0bcd \u0bae\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0baa\u0ba3\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0723\u0bca\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf\u0b9a\u0bc1 \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\ufffd\u0b95,\n\n5. \u0ba4\ufffd\u0bca\u0b9f\u0bc1\u0bb5\u0bbe\u0bbe\u0bb5, \u0baa\u0bb0\u0bc1\u0ba4\u0bc6\u0bc6\u0bb2\u0bcd\u0baa\u0725\u0bca\u0bb2, \u0b87\u0bb2. 532/\u0b8f \u0b87\u0bb2\u0bcd \u0bb5\u0ba4\u0bbf\u0bbf\u0baf\u0bc1\u0bae\u0bcd, \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0bae\u0ba4\u0bbf\u0bbf \u0ba8\u0bbe\u0bbe\u0ba9\u0baf\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0bb0 \u0bae\u0bb9\u0b95\u0bc1\u0bb0\u0bc1\u0b95\u0bc7\u0bc7 \u0b9f\u0bbf\u0bb2\u0bcd\u0b95\u0bbf\u0bbf \u0bae\u0ba4\u0bc1\u0bb7\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bbf\u0bbf\u0bb2\u0bbe\u0bbe\u0baa\u0bae\u0bcd \u0ba8\u0bc0\u0ba4\u0bbe\u0bbe\u0b9a\u0ba9 \u0bb5\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0b9a\u0bbf\u0bbf\u0b99\u0bcd\u0b95\u0bb3 \u0bae\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0baa\u0ba3\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0723\u0bca\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf\u0b9a\u0bc1 \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\ufffd\u0b95,"
