u0bbe\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0bbf\u0ba4\u0bb4\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bb2\u0bcd\n\n\u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0baa\ufffd\u0bca\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0bbe\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd \u0b86\u0ba3\u0721\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bbe\u0bbe\u0ba9\u0ba4\u0bc1, 2009 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 20\u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0bae\u0bbf\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bbe\u0bb0 \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd 10(2) \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bb3\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0ba9\u0bcd \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0bc8\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf, \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb2\u0bcd \u0baa\u0bbf\u0bbf\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0ba8\u0baa\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1, \u0bae\u0bbf\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bbe\u0bb0\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8 \u0bb5\u0bbf\u0bbf\u0ba8\u0bbf\u0bbf\u0baf\ufffd\u0bcb\u0b95\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd, \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bb2\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0baa\u0bc6\u0bc6\u0bb1 \u0bb5\ufffd\u0ba3\u0bcd\u0b9f\u0bbf\u0baf \u0b89\u0bb0\u0bbf\u0bbf\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0ba4\u0bc7\u0bc7\u0bb5\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0ba9\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bb5\u0bbf\u0bbf\u0bb2\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0baa\ufffd\u0bca\u0bb0\u0bc1\u0b9f\u0bcd\u0b9f\u0bc1, \u0bb5\u0bbf\u0bbf\u0bb2\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b9a\u0bcd \u0b9a\u0bbe\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0bbf\u0ba4\u0bb4\u0bc8\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1.\n\n\u0bb5\u0bbf\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd\u0ba8\u0baa\u0bb0\u0bcd/\u0ba8\u0bbf\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0bae\u0bcd\u0bb5\u0bb3\u0bbe\u0bbe\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd\u0bb5\u0bb2\u0bbf\u0ba4\u0bc1\u0b9f\u0bc8\u0bc8\u0baf \u0b95\u0bbe\u0bbe\u0bb2\u0bae\u0bcd\n\n\u0b86\u0bb0\u0bae\u0bcd\u0baa\u0bae\u0bcd\u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bc1\n\nEL/EX/D/25-19\u0b90\u0bb8\u0bcd\u0bb2\u0ba9\u0bcd\u0b9f\u0bcd \u0bb0\u0bc6\u0bc6\u0b9a\u0bbf\u0bbf\u0b9f\ufffd\u0ba9\u0bcd\u0b9a\u0bc0\u0bb8\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bc1 \u0b86\u0ba4\u0ba9 \u0bae\u0bc1\u0b95\u0bbe\u0bbe\u0bae\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5 \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 2219\n\n\u0b90\u0bb8\u0bcd\u0bb2\u0ba9\u0bcd\u0b9f\u0bcd \u0bb0\u0bc6\u0bc6\u0b9a\u0bbf\u0bbf\u0b9f\ufffd\u0ba9\u0bcd\u0b9a\u0bbf\u0bbf\u0bb8\u0bcd, \u0b87\u0bb2. 49/04, \u0b95\u0bbe\u0bbe\u0bb2\u0bbf \u0bb5\u0bc0\u0ba4\u0bbf\u0bbf, \u0b95\ufffd\u0bca\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1 032025.08.252035.08.24\n\nEL/EX/D/25-20\u0b8e\u0bb2\u0bbf\u0bb7\u0bcd \u0bb9\u0730\u0bb0\u0bc8\u0bc8\u0bb8\u0bcd (\u0baa\u0bbf\u0bbf\u0bb0\u0bc8\u0bc8\u0bb5\ufffd\u0b9f\u0bcd) \u0bb2\u0bbf\u0bae\u0bbf\u0bbf\u0b9f\ufffd\u0b9f\u0bcd\u0b87\u0bb2 26C, \u0b9a\u0bc7\u0bc7\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0bae\u0bbe\u0bbe\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8, \u0ba8\u0bbe\u0bbe\u0bb5\u0bb22025.08.252030.08.24\n\n2AI fldgi ( ^I& fPoh - YS% ,xld m%cd;dka;s%l iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'09'18gFjp I : njhFjp (I) - ,yq;ifr; rdehaf Nrhryprf; FbauR tu;j;jkhdg; gj;jpupif - mjp tpNr\\khdJ - 2025.09.218\n\n\u0bb5\u0bbf\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa