\u0bb2. 32 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. \u0bc6\u0baa\u0bbe\u1f90 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b9a\u0bb5\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81\n\n\u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90 1:32 0.0375 \u0bc7\u0baa\u0bbe\u1fbb\u1f97\u0bb5\u0bb2 \u0bc7\u0ba4\u0bb5\u0bc7\u0b95 \u0b9a\u0bbe\u1fa2\u0baf \u1f90\u0bae\u0bbf\u1fb8\u0ba4 198725702180 \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0b86\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 27 _ 386/1, \u0bc7\u0bae/\u0b89\u1fb0\u0b95\u1fbf\u0baa\u0b9f , \u0b95\u1fbb\u0baa\u0bb9\u0bbe . \u0b85\u1f8e\u1f81\u0bb5\u0bb4\u0bbf \u0bc7\u0b9a\u0bb5\u0b95\n\n\u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. \u0bae\u1fbe\u1fa0\u1fbb\n\n\u0b95\u0bbe.\u1f90.\u0b87\u0bb2. 31 \u0b85\u0bc8\u0bae\u1fb8\u1f90\u1fc0\u0bb3\n\n\u0b95\u0bbf\u0ba3\u1fa0 \u0bc6\u0baa\u0bbe\u1f90 \u0baa\u0bbe\u0bb5\u0bc8\u0ba9\n\n\u0bc7\u0b9a\u0bb5\u0b95 \u0b89\u0bbe\u0bbf\u1fb7\u0ba4\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90. 1:70 0.0519 \u0baa\u0ba4\u0bbf\u0bb0\u0ba3 \u0ba4\u0bbf\u0bb8\u0bbe\u0ba8\u0bbe\u0baf\u0b95\u0bb2\u0bbe\u0bc7\u0b95 \u0ba8\u0baf\u0ba9\u0bbe 767661908V \u1f99\u1fa8\u0bb5\u1f90\u1fbb 1\u0bb5\u1f90 \u0bb5\u1f81\u1fba\u1f97 \u0bc6\u0b95\u0bbe\u1fa8\u1fbb\u1f97 _\n\n\u0ba4\u0bb0\u1fb1\u0b95\u0ba9\u0bc0 \u0ba4\u1fbd\u0bae\u0bc7\u0b9a\u0ba9 \u0b87\u0bb2\u1fb1\u0bc8\u0b95 \u0bb5\u1fb1\u0b95\u0bbf 353/\u0b8e\u1fba , \u0bc7\u0bae/\u0b89\u1fb0\u0b95\u1fbf\u0baa\u0b9f , \u0b95\u1fbb\u0baa\u0bb9\u0bbe . \u0b87\u1fb9 \u0b87\u0bb2. 990 \u0bae\u1fbe\u1fa0\u1fbb\n\n2021.02.11 \u0b85\u0b9f\u0b95\u0bbf\u1fbe\u1f81 \u0b89\u1fb5\u0baa\u1fb5\u0b9f\u1f90.\n\n30 A III \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u2013 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0d