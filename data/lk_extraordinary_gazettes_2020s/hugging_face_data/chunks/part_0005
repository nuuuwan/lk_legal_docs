d\u0dda\u0dc0\u0dcf\u0dcf \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba'\n\n2025 \u0dc3\u0dd0\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 01 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0daf\u0dd3 \u0dba.\n\n\u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\n\n1. \u0db8\u0dd9\u02de\u0db8 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c 2025 \u0d85\u0d82\u0d82\u0d9a 01 \u0daf\u0dbb\u0db1 \u0db8\u0ddd\u02de\u0ddd\u02ea\u0da7\u0dbb\u0dca \u0dc0\u0dcf\u0dcf\u0dc4\u0db1 (\u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba\u0dba) \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n2. (1) \u0d9a\u0dd2\u0dc3\u0dd2\u0dba\u0db8\u0dca \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0d9a \u0db8\u0ddd\u02de\u0ddd\u02ea\u0da7\u0dbb\u0dca \u0dc0\u0dcf\u0dcf\u0dc4\u0db1\u0dba\u0d9a\u0dca, \u0db4\u0daf\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0db1, \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0dc3\u0dad\u0dca\u200d\u0dba\u0dba \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dba\u0db8\u0dca \u0db8\u0ddd\u02de\u0ddd\u02ea\u0da7\u0dbb\u0dca \u0dc0\u0dcf\u0dcf\u0dc4\u0db1\u0dba\u0d9a\u0dca \u0d9a\u0dcf\u0dcf\u0dba\u0dd2\u0d9a\u0dc0 \u0db4\u0dcf\u0dcf\u0dbd\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dba\u0db8\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4 \u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba\u0dba \u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0dad\u0dcf\u0dcf \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0da7 \u0db4\u0ddc\ufffd\u0ddc\u0dbd\u0dd2\u0dc3\u0dca\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dbb\u0dba\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dcf\u0dcf\u0db0\u0dcf\u0dcf\u0dbb\u0dab\u0dc0 \u0dc3\