e\u0bcd \u0baa\ufffd\u0bca\u0bb0\u0bc1\u0b9f\u0bcd\u0b9f\u0bc1, \u0bb5\u0bbf\u0bbf\u0bb2\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b9a\u0bcd \u0b9a\u0bbe\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0bbf\u0ba4\u0bb4\u0bc8\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1.\n\n\u0bb5\u0bbf\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd\u0ba8\u0baa\u0bb0\u0bcd/\u0ba8\u0bbf\u0bbf\u0bb1\u0bc1\u0bb5\u0ba9\u0bae\u0bcd\u0bb5\u0bb3\u0bbe\u0bbe\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd\u0bb5\u0bb2\u0bbf\u0ba4\u0bc1\u0b9f\u0bc8\u0bc8\u0baf \u0b95\u0bbe\u0bbe\u0bb2\u0bae\u0bcd\n\n\u0b86\u0bb0\u0bae\u0bcd\u0baa\u0bae\u0bcd\u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bc1\n\nEL/EX/D/25-23\u0b8e\u0bb8\u0bcd. \u0b8e\u0bb2\u0bcd. \u0b8f. \u0b8f\u0bae\u0bcd. \u0baa\u0bb5\u0bb0\u0bcd \u0b9a\ufffd\u0bca\u0bb2\u0bc1\u0bb7\u0ba9\u0bcd\u0bb8\u0bcd (\u0baa\u0bbf\u0bbf\u0bb0\u0bc8\u0bc8\u0bb5\ufffd\u0b9f\u0bcd) \u0bb2\u0bbf\u0bae\u0bbf\u0bbf\u0b9f\ufffd\u0b9f\u0bcd \u0b87\u0bb2. 155, \u0b95\u0bc6\u0bc6\u0bb8\u0bcd\u0baa\ufffd\u0bb5 \u0bb5\u0bc0\u0ba4\u0bbf\u0bbf, \u0baa\ufffd\u0bca\u0bb0\u0bb2\u0bb8\u0bcd\u0b95\u0bae\u0bc1\u0bb5\n\n\u0bae\u0bbf\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bbe\u0bb0 \u0bb5\u0bbe\u0bbe\u0b95\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0bc8 \u0b9a\u0bbe\u0bbe\u0bb0\u0bcd\u0b9c\u0bcd (\u0bae\u0bbf\u0bbf\u0ba9\u0bcd\u0ba9\ufffd\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd)\u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0bc1\u0bae\u0bcd \u0ba8\ufffd\u0bcb\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0b95 \u0bae\u0bbf\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bbe\u0bb0 \u0bb5\u0bbf\u0bbf\u0ba8\u0bbf\u0bbf\u0baf\ufffd\u0bcb\u0b95\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bb0\u0bbf\u0bbf\u0bae\u0bbe\u0bbe\u0bb1\u0bcd\u0bb1\u0bae\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bb2\u0bcd\n\n2025.08.252030.08.24\n\n\u0ba4\u0bb2\u0bc8\u0bc8\u0bb5\u0bb0\u0bcd \u0b87\u0bb2\