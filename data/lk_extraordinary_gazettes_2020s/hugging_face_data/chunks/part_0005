dc4\u0dcf\u0dcf 2011 \u0d85\u0d82\u0d82\u0d9a 49 \u0daf\u0dbb\u0db1 \u0db4\u0db1\u0dad\u0dca \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0dd2\u0dad 1981 \u0d85\u0d82\u0d82\u0d9a 57 \u0daf\u0dbb\u0db1 \u0dc0\u0dd9\u0dd9\u0dbb\u0dc5 \u0dc3\u0d82\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0dc3\u0dc4 \u0dc0\u0dd9\u0dd9\u0dbb\u0dc5 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0db4\u0db1\u0dad\u0dda\ufffd 16(1) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1\u0dc0\u0dbd\u0da7 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0dcf\u0dcf\u0dbb, \u0d85\u0d82\u0d82\u0d9a 1087 \u0daf\u0dbb\u0db1 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba\u0dda\u024f \u0dc4\u0ddd\ufffd\u0ddd\u02ea\u0db8\u0dca \u0dbd\u0dd1\u0dd1\u0db1\u0dca\u0da9\u0dca \u0dc3\u0dca\u0dca\u0d9a\u0dba\u0dd2\u0dbd\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u0dc5\u0dd4\u0dad\u0dbb, \u0d9a\u0dd4\u0da9\u0dcf\u0dcf\u0dc0\u0dc3\u0dca\u0dca\u0d9a\u0da9\u0dd4\u0dc0. \u0db8\u0dd4\u0daf\u0dd2\u0dbd\u0dca\u0dbd\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad \u0daf\u0dbb\u0db1 \u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba\u0dda\u024f \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dba\u0ddd\u02e0\u0ddd\u02ea\u0da2\u0dd2\u0dad \u0d92\u0d9a\u0d9a 107 \u0d9a\u0dd2\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dca \u0dc3\u0dc4\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dca\u200d\u0dba\u0dba \u0db8\u0dc4\u0dbd\u0dca \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3 \u0d9c\u0ddc\u02c3\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9c\u0dd2\u0dbd\u0dca\u0dbd \u0dc3\u0dc4 \u0dc3\u0dc4\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dca\u200d\u0dba\u0dba \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0db1 \u0dc0\u0dd2\u0dbd\u0dcf\u0dcf \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3 17\u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0db1\u0dca\u0dc0\u0dd2\u0dad \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dd8\u0dd8\u0dad\u0dd2\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd6 \u0db4\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dbb\u0dd2\u0d9a \u0db6\u0dbd\u0db4\u0dd1\u0dd1\u0db8\u0dca \u0d87\u0d9c\u0dba\u0dd3\u0db8\u0dda\ufffd \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dcf\u0dc0 \u0db8\u0dc4\u0da2\u0db1 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dcf\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dc0\u0dbd \u0daf\u0dd2\u0db1\u0db4\u0dad\u0dcf\u0dcf \u0db4\u0dd9\u0dd9.\u0dc0. 8.30 \u0dc3\u0dd2\u0da7 \u0db4.\u0dc0. 4.15 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf 2025.10.02 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0daf\u0dd2\u0db1 30\u0d9a \u0d9a\u0dcf\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dad\u0db6\u0dcf\u0dcf \u0d87\u0dad. (\u0dc3\u0dad\u0dd2 \u0d85\u0db1\u0dca\u0dad \u0dc3\u0dc4 \u0dbb\u0da2\u0dba\u0dda\u024f \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0da9\u0dd4 \u0daf\u0dd2\u0db1\u0dba\u0db1\u0dca \u0dc4\u0dd0\u0dd0\u0dbb)\n\n\u0db8\u0dd3\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0dc0\u0dd9\u0dd9\u0dbb\u0dc5 \u0dc3\u0d82\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0dc3\u0dc4 \u0dc0\u0dd9\u0dd9\u0dbb\u0dc5 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0db1\u0dd2\u0dbd \u0dc0\u0dd9\u0dd9\u0db6\u0dca \u0d85\u0da9\u0dc0\u0dd2\u0dba \u0dc0\u0db1 www.coastal.gov.lk \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d91\u0db8 \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dcf\u0dc0 \u0db7\u0dcf\u0dcf\u0dc2\u0dcf\u0dcf \u0dad\u0dd4\u0db1\u0dd9\ufffd\u0db1\u0dca\u0db8 \u0db4\u0dbb\u0dd2\u0dc1\u0dd3\u0dbd\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d87\u0dad.\n\n01. \u0dc0\u0dd9\u0dd9\u0dbb\u0dc5 \u0dc3\u0d82\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0dc3\u0dc4 \u0dc0\u0dd9\u0dd9\u0dbb\u0dc5 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0, 4 \u0dc0\u0db1 \u0db8\u0dc4\u0dbd, \u0db1\u0dc0 \u0db8\u0dc4 \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba, \u0db8\u0dcf\u0dcf\u0dbd\u0dd2\u0d9c\u0dcf\u0dcf\u0dc0\u0dad\u0dca\u0dad, \u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 10.\n\n02. \u0db8\u0db0\u0dca\u200d\u0dba\u0dba\u0db8 \u0db4\u0dbb\u0dd2\u0dc3\u0dbb \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba, \u0d85\u0d82\u0d82\u0d9a 104, \"\u0db4\u0dbb\u0dd2\u0dc3\u0dbb \u0db4\u0dd2\u0dba\u0dc3\", \u0da9\u0dd9\ufffd\u0db1\u0dca\u0dc3\u0dd2\u0dbd\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0db6\u0dca\u0db6\u0dd1\u0dd1\u0d9a\u0da9\u0dd4\u0dc0 \u0db8\u0dcf\u0dcf\u0dc0\u0dad, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd.\n\n03. \u0daf\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba, \u0d9a\u0dc5\u0dd4\u0dad\u0dbb.\n\n04. \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba, \u0d9a\u0dc5\u0dd4\u0dad\u0dbb.\n\n2 A I fldgi: (I) fPoh - Y%S ,xld m%cd;dka;%sl iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'10'02\n\n05. \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0, \u0d9a\u0dc5\u0dd4\u0dad\u0dbb\n\n06. \u0db8\u0db0\u0dca\u200d\u0dba\u0dba\u0db8 \u0db4\u0dbb\u0dd2\u0dc3\u0dbb \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba, \u0daf\u0dd2\u0dc3\