u0dd0\u0db6\u0dda\u0229. \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a, \u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba.\n\n2025 \u0dc3\u0dd0\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 20 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 01,\u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\u0dda\u024f \u0daf\u0dd3 \u0dba.\n\n\u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\n\n1.\u0db8\u0dd9\u0dd9\u0db8 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c 2025 \u0d85\u0d82\u0d82\u0d9a 01 \u0daf\u0dbb\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0dc0\u0dbb\u0dcf\u0dcf\u0dba \u0db1\u0d9c\u0dbb\u0dba (\u0d9a\u0dca\u200d\u0dbb\u0db8\u0ddd\ufffd\u0ddd\u02ea\u0db4\u0dcf\u0dcf\u0dba \u0dc0\u0dd0\u0dd0\u0daf\u0d9c\u0dad\u0dca\u0d9a\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0daf\u0dd2\u0dbb\u0dd2\u0d9c\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dcf\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0ddd\ufffd\u0ddd\u02ea\u0db4\u0daf\u0dda\u0dda\u0dc1) \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n2.\u0db8\u0dd9\u0dd9\u0db8 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c \u0db6\u0dbd\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0d89\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0ddd\ufffd\u0ddd\u02ea\u0db4\u0dcf\u0dcf\u0dba \u0dc0\u0dd0\u0dd0\u0daf\u0d9c\u0dad\u0dca\u0d9a\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dcf\u0dcf \u0d9c\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d95\u0db1\u0dd1\u0dd1\u0db8\n\n\u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dba\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db8\u0dd9\ufffd\u0db8 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0dc0\u0dda\u0dda.\n\n3. \u0d9a\u0ddc\u0ddc\ufffd\u0dc5\u0db9 \u0dc0\u0dbb\u0dcf\u0dcf\u0dba \u0db1\u0d9c\u0dbb\u0dba\u0dda\u024f \u0db6\u0dbd \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba \u0dad\u0dd4\u0dc5 \u0dc3\u0dc4 \u0d91\u0dc4\u0dd2 \u0dc3\u0dd2\u0da7 \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd \u0db1\u0dd2\u0dbb\u0dad \u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0dc0\u0dbb\u0dcf\u0dcf\u0dba \u0db1\u0d9c\u0dbb\u0dba\u0dda\u024f \u0db6\u0dbd \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dd0\u0dd0\u0db6\u0dd0\u0dd0\u0dbd\u0dca\u0dbd\u0d9a\u0dca \u0db6\u0daf\u0dca\u0daf\u0da7 \u0d9c\u0dd9\ufffd\u0db1 \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d86\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0db1\u0dba\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dc0\u0dd6 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dc0\u0dbb \u0dc4\u0ddd\ufffd\u0ddd