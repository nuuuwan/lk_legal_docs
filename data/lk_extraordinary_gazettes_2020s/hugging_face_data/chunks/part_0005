cd\u0b95\u0bc8\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0b95 \u0b85\u0b9a\u0bcd\u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd 27 \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd I \u0b86\u0bb5\u0ba4\u0bc1 \u0b89\u0baa\u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0b95\u0bbe\u0bbe\u0bb0\u0bae\u0bcd \u0b95\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0baf\u0bb1\u0bcd\u0b9a\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0ba3\u0bcd\u0bae\u0bc8\u0bc8 \u0b85\u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bbf\u0bbf\u0ba9\u0bcd \u0bae\ufffd\u0bb2\u0ba4\u0bbf\u0bbf\u0b95 \u0b9a\u0bc6\u0bc6\u0baf\u0bb2\u0bbe\u0bbe\u0bb3\u0bb0\ufffd\u0b95 (\u0b95\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf) \u0b95\u0b9f\u0bae\u0bc8\u0bc8 \u0baa\u0bc1\u0bb0\u0bbf\u0bbf\u0b95\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1 \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1. \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0ba9\u0bb2\u0bbe\u0bbe\u0b95\u0bc7\u0bc7 \u0b9a\u0bc1\u0b9a\u0ba8\u0bcd\u0ba4 \u0b9c\u0baf\u0ba4\u0bbf\u0bbf\u0bb2\u0b95 \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc8\u0bc8 \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb2\u0bcd \u0ba8\u0bbf\u0bbf\u0baf\u0bae\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1\ufffd\u0ba9\u0bcd.\n\n\u0b9c\ufffd. \u0b8e\u0bae\u0bcd. \u0ba4\u0bbf\u0bbf\u0bb2\u0b95\u0bbe\u0bbe \u0b9c\u0baf\u0b9a\u0bc1\u0ba8\u0bcd\u0ba4\u0bb0,\u0b9c\ufffd. \u0b8e\u0bae\u0bcd. \u0ba4\u0bbf\u0bbf\u0bb2\u0b95\u0bbe\u0bbe \u0b9c\u0baf\u0b9a\u0bc1\u0ba8\u0bcd\u0ba4\u0bb0, \u0b9a\u0bc6\u0bc6\u0baf\u0bb2\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd, \u0b95\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0baf\u0bb1\u0bcd\u0b9a\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0ba3\u0bcd\u0bae\u0bc8\u0bc8 \u0b85\u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bc1.\n\n\u0b95\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0baf\u0bb1\u0bcd\u0b9a\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0ba3\u0bcd\u0bae\u0bc8\u0bc8 \u0b85\u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bc1,\u0b87\u0bb2. 73/1, \u0b95\u0bbe\u0bbe\u0bb2\u0bbf \u0bb5\u0bc0\u0ba4\u0bbf\u0bbf,\u0b95\ufffd\u0bca\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1 03,\n\nEOG 09-0125\n\n(murhq;fj;jpd; mjpfhuj;Jld; gpuRupf;fg;gl;lJ)gFjp I : njhFjp (I) - nghJ\n\nmurhq;f mwptpj;jy;fs;\n\n,yq;ifr; rdehaf Nrhryprf; FbauR th;j;jkhdg; gj;jphpif\n\nmjp tpNr\\khdJ\n\nwxl 2454/04 - 2025 iema;e\u00efn\u00be ui 15 jeks i\u00f7od - 2025'09'152454/ 04 Mk; ,yf;fk; - 2025 Mk; Mz;L nrj;njk;gh; khjk; 15 Me; jpfjp jpq;fl;fpoik\n\nY%S ,xld m%cd;dka;%sl iudcjd\u00a7 ckrcfha .ei\u00dc m;%h\n\nw;s \u00fafYI\n\n,t; mjptpNrl tu;j;jkhdpia www.documents.gov.lk vDk; ,izaj;jsj;jpypUe;J gjptpwf;fk; nra;a KbAk;.\n\n,yq;if murhq;f mr;Rj; jpizf;fsj;jpw; gjpg;gpf;fg;ngw;wJ.1A - G 45364 \u2014 05 (2025/09)"
