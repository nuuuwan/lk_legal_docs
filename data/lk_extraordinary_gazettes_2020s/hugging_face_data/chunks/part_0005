ba. \u0dbd\u0dd2\u0dba\u0dd4\u0db8\u0dca \u0d9a\u0dc0\u0dbb\u0dd9\u0dba\u0dca \u0dc0\u0db8\u0dca\u0db4\u0dc3 \u0d8b\u0da9 \u0dd9\u0d9a\u0dc5\u0dc0\u0dd9\u0dbb\u0dca \u201c\u0d85\u0db1\u0dca\u0dad\u0dd2\u0db8 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0db4\u0dad\u0dba\u0d9a\u0dca \u0dd9\u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2 \u0dd9\u0daf\u0dca\u0db4\u0dc5 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0db8\u0dca \u0db4\u0dad\u0dba\u201d \u0dba\u0db1\u0dd4\u0dd9\u0dc0\u0db1\u0dca \u0dbd\u0dd2\u0dba\u0dcf \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba. EOG 09 - 0146/15\n\n\u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dbb\u0da2\u0dd9\u0dba\u0dca \u0db8\u0dd4\u0daf\u0dab \u0dd9\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dd9\u0dc0\u0dca \u0db8\u0dd4\u0daf\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3."
