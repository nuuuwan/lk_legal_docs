d9a\u0dca\u0d9a\u0dba\u0d9a \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a \u0d89\u0da9\u0db8\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0dd9\ufffd\u0d9a\u0dd4 \u0dbd\u0dd9\ufffd\u0dc3 \u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dca\u0db1\u0db8\u0dca, \u0d91\u0db8 \u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0daf \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0d85\u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n\u0da0\u0db1\u0dca\u0daf\u0db1 \u0dbb\u0dab\u0dc0\u0dd3\u0dbb \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2, \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca, \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0.\n\n2025 \u0dc3\u0dd0\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 02 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0,\u201c\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dad \u0db8\u0dd0\u0dd0\u0daf\u0dd4\u0dbb\u201d 1200/6,\u0dbb\u0da2\u0db8\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dcf\u0dcf\u0dbb,\u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd.\n\nEOG 09 - 0168/1\n\n2 AI fldgi: (I) fPoh - Y%S ,xld m%cd;dka;%sl iudcjd\u00a7 ckrcfha w;s \u00fafYI .ei\u00dc m;%h - 2025'09'17\n\n\u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\n\n\u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\u01ae 6(1) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0dbd\u0d82\u0d82\u0dc3\u0d9a\u0dcf\u0dcf\u0dbb\u200d\u200d\u0d9c\u0dda\u0118 \u0daf\u0ddc\ufffd\u0ddc\u0db1\u0dca \u0db1\u0dd2\u0dc2\u0dcf\u0dcf\u0db1\u0dca \u0dc3\u0dd4\u0daf\u0dad\u0dca \u0daf\u0dd3\u0db4\u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0db8\u0dba\u0dcf\u0dcf \u0d94\u0dc4\u0dd4\u0d9c\u0dda\u0118 \u0dbb\u0dcf\u0dcf\u0da2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd3\u0dc0\u0dbd\u0da7 \u0d85\u0db8\u0dad\u0dbb \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca 2009.10.15 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0dd1\u0d9c\u0dbd, \u0db4\u0dd4\u0dad\u0dca\u0dad\u0dbd\u0db8 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d89\u0da9\u0db8\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0dd9\ufffd\u0d9a\u0dd4 \u0dbd\u0dd9\ufffd\u0dc3 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229. \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0dcf\u0dcf \u0d91\u0db8 \u0dad\u0db1\u0dad\u0dd4\u0dbb\u0dd9\u0dd9\u0dc4\u0dd2 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dba \u0d9a\u0dbb\u0db1 \u0dad\u0dd9\ufffd\u0d9a\u0dca \u0db8\u0dd9\ufffd\u0db8 \u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0dc0\u0db1 \u0d85\u0dad\u0dbb, \u0db8\u0dd3\u0da7 \u0db4\u0dd9\u0dd9\u0dbb \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0d9a/ \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0d9a \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a \u0d89\u0da9\u0db8\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0dd9\ufffd\u0d9a\u0dd4 \u0dbd\u0dd9\ufffd\u0dc3 \u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dca\u0db1\u0db8\u0dca, \u0d91\u0db8 \u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0daf \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0d85\u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n\u0da0\u0db1\u0dca\u0daf\u0db1 \u0dbb\u0dab\u0dc0\u0dd3\u0dbb \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2, \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca, \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0.\n\n2025 \u0dc3\u0dd0\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 02 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0,\u201c\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dad \u0db8\u0dd0\u0dd0\u0daf\u0dd4\u0dbb\u201d 1200/6,\u0dbb\u0da2\u0db8\u0dbd\u0dca\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dcf\u0dcf\u0dbb,\u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd.\n\nEOG 09 - 0168/2\n\n_____________________________________\n\n\u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad"
