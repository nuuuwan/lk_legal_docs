\u0d9a\u0dcf\u0dcf\u0dbb \u0dc0 2025.05.21 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2\u0dc0 \u0d85\u0d82\u0d82\u0d9a 2437/24 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u200d\u200d\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2.\n\n02. 2025.05.21 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2\u0dc0 \u0d85\u0d82\u0d82\u0d9a 2437/24 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0dba\u0da7\u0dad\u0dda\u0dda\u01ae \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf 2025 \u0d85\u0d82\u0d82\u0d9a 01 \u0daf\u0dbb\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0d9c\u0db8\u0dca \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dba\u0db1\u0dca\u0dc4\u0dd2 4 \u0dc0\u0db1 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dba\u0dd9\ufffd\u0dc4\u0dd2 (2) \u0dc3\u0dc4 (3) \u0d8b\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0dda\u0229 -\n\n(2) \u0db4\u0dc4\u0dad \u0dc3\u0dd4\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0db4\u0dd4\u0dbb\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0dba\u0dd9\ufffd\u0d9a\u0dd4 \u0db4\u0db8\u0dab\u0d9a\u0dca \u0d89\u0dc4\u0dad (1) \u0dc4\u0dd2 (i), (ii) \u0dc3\u0dc4 (iv) \u0dba\u0db1 \u0dad\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dad\u0ddd\ufffd\u0ddd\u02ea\u0dbb\u0dcf\u0dcf \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dca\u0dc3\u0dd9\ufffd\u0d9a\u0dd4 \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.\n\n(i) \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0d82\ufffd\u0d82\u0dc1\u0dba\u0dda\u0dda\u024f \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dba \u0dc3\u0dc4\u0dd2\u0dad\u0dc0 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0da2\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0db1\u0dca\u0dad\u0dbb \u0dad\u0dbb\u0d9c \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc3\u0dc4\u0db7\u0dcf\u0dcf\u0d9c\u0dd2 \u0dc0\u0dd3 \u0dad\u0dd2\u0db6\u0dd3\u0db8 \u0dc3\u0dc4/\u0dc4\u0ddd\ufffd\u0ddd\n\n(ii) \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0d9c\u0db8\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0dca\u200d\u0dba\u0dd9\ufffd\u0dd9\u0dc2\u0dca\u0dca\u0da8 \u0dc3\u0dc4/\u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0d9a\u0db1\u0dd2\u0dc2\u0dca\u0dca\u0da8 \u0dc1\u0dd6\u0dbb\u0dad\u0dcf\u0dcf\u0dc0\u0dbd\u0daf\u0dd3 \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0db8\u0dc4\u0dcf\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dcf \u0d8b\u0dc5\u0dd9\ufffd\u0dbd\u0d9a\u0daf\u0dd3, \u0dad\u0db1\u0dd2 \u0d89\u0dc3\u0dc0\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf 1 \u0dc0\u0db1, 2 \u0dc0\u0db1 \u0dc3\u0dc4 3 \u0dc0\u0db1 \u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0db1 \u0dbd\u0db6\u0dcf\u0dcf \u0dad\u0dd2\u0db6\u0dd3\u0db8 \u0dc3\u0dc4 \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dba\u0db8\u0dca \u0dad\u0dbb\u0d9c \u0dc3\u0db3\u0dc4\u0dcf\u0d