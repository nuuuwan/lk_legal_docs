dad\u0dd3\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd6 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dc0\u0dbd 26 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0 \u0dc3\u0dc4 \u0db4\u0dc4\u0dad \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u024f \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0dc0\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dbb \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0da7 \u0d85\u0db1\u0dd4\u0dc0, \u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0dc0\u0dbb\u0dcf\u0dcf\u0dba \u0db1\u0d9c\u0dbb\u0dba \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca, \u0d91\u0d9a\u0dd3 \u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0d85\u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0dc3\u0dc4 \u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0db1\u0dca\u0d9c\u0dda\u0118 \u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2 \u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d91\u0dc4\u0dd2 \u0db1\u0db8 \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u023c \u0dc3\u0dd2\u0dba \u0d85\u0db7\u0dd2\u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0daf\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0dbd\u0db6\u0dcf\u0dcf \u0daf\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n\u0db8\u0dd9\ufffd\u0db8 \u0daf\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0dda\u023c \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0db8\u0dcf\u0dcf\u0dc3 \u0dad\u0dd4\u0db1\u0d9a \u0d9a\u0dcf\u0dcf\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0d89\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dc3\u0dd4 \u0d91\u0d9a\u0dd3 \u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0d85\u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dbb \u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0db1\u0dca\u0d9c\u0dda\u0118 \u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2 \u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d91\u0dc4\u0dd2 \u0db1\u0db8 \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db6\u0dc0\u0dad\u0dca \u0d91\u0dc3\u0dda\u02e6\u0dda \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db1\u0ddc\ufffd\u0ddc\u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0db1\u0dca\u0db1\u0dda\ufffd \u0db1\u0db8\u0dca \u0d9a\u0dcf\u0dcf\u0dbd\u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0 \u0d89\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0dd3\u0db8\u0da7 \u0db4\u0dd9\u0dd9\u0dbb \u0d91\u0dc3\u0dda\u02e6\u0dda \u0db1\u0ddc\ufffd\u0ddc\u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0dd3\u0db8\u0da7 \u0dc4\u0dda\ufffd\u0dda\u0dad\u0dd4 \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0db8\u0da7 \u0dba\u0db8\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0dd4\u0da7 \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0db6\u0dc0\u0dad\u0dca \u0daf\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0dd0\u0da9\u0dd2\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0daf\u0db1\u0dca\u0dc0\u0dcf\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n\u0dbb\u0dd9\u0dd9\u0dc0\u0dcf\u0dcf\u0db1\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dd6\u0dbb\u0dd2\u0dba, \u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0dc0\u0dbb\u0dcf\u0dcf\u0dba \u0db1\u0d9c\u0dbb\u0dba \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca. 2025 \u0dc3\u0dd0\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 26 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0daf\u0dd3 \u0dba.\n\n\u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\n\n\u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0db8\u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d82\u0d9a\u0dba\u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0d9a\u0dcf\u0dcf\u0dab\u0dca\u0da9\u0dba\u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2 \u0d85\u0d82\u0d82\u0d9a\u0dba\u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dc5 \u0daf\u0dd2\u0db1\u0dba\u0d85\u0db8\u0dcf\u0dcf\u0db1\u0dcf\u0dcf \u0dad\u0d9a\u0dcf\u0dcf\u0dc6\u0dd4\u0dbd\u0dca \u0dbd\u0dba\u0dd2\u0dc6\u0dca \u0db4\u0dd3\u0d91\u0dbd\u0dca\u0dc3\u0dd32310190020\u0db6\u0dbd\u0dba\u0dbd\u0dad\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0dcf\u0dcf\u0db4\u0dd3\u0dc3\u0dd3\u0dc3\u0dd3 002895422023/12/01\n\nEOG 09 - 0251\n\nY%S ,xld rcfha uq\u00f8K fomd\u00be;f\u00efka;=f\u00f5 uq\u00f8Kh lrk ,\u00a7'"
