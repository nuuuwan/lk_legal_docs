\u0dd2 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba. \u0dbd\u0dd2\u0dba\u0dd4\u0db8\u0dca \u0d9a\u0dc0\u0dbb\u0dd9\u0dba\u0dca \u0dc0\u0db8\u0dca\u0db4\u0dc3 \u0d8b\u0da9 \u0dd9\u0d9a\u0dc5\u0dc0\u0dd9\u0dbb\u0dca \u201c\u0d85\u0db1\u0dca\u0dad\u0dd2\u0db8 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0db4\u0dad\u0dba\u0d9a\u0dca \u0dd9\u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2 \u0dd9\u0daf\u0dca\u0db4\u0dc5 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0db8\u0dca \u0db4\u0dad\u0dba\u201d \u0dba\u0db1\u0dd4\u0dd9\u0dc0\u0db1\u0dca \u0dbd\u0dd2\u0dba\u0dcf \u0dad\u0dd2\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba. EOG 09 - 0146/11\n\n\u0d85\u0db1\u0dca\u0dad\u0dd2\u0db8 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0db4\u0dad\u0dba\u0d9a\u0dca \u0dd9\u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2 \u0dd9\u0daf\u0dca\u0db4\u0dbd \u0dc3\u0db3\u0dc4\u0dcf \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca\u0db4\u0dd1\u0db8\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dd9\u0dbd\u0dc3 \u0daf\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8\n\n1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dad (55 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba) \u0db8\u0dcf\u0dad\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca \u0dc0\u0dd0\u0dbd\u0dd2\u0d9c\u0db8 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca \u0dd9\u0daf\u0dca\u0db1\u0dd4\u0dc0\u0dbd \u0db1\u0db8\u0dd0\u0dad\u0dd2 \u0d9c\u0dd9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dd6 \u0db8\u0dd2\u0dba\u0d9c\u0dd2\u0dba \u0db8\u0dab\u0dd2\u0d9a\u0dca\u0d9a\u0dd4 \u0db6\u0da9\u0dad\u0dd4\u0dbb\u0dd4\u0dd9\u0d9c\u0dca \u0d86\u0dbb\u0dd2\u0dba\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf\u0dd9\u0d9c\u0dca \u0d85\u0db1\u0dca\u0dad\u0dd2\u0db8 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0db4\u0dad\u0dba\u0d9a\u0dca \u0dd9\u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2 \u0dd9\u0daf\u0dca\u0db4\u0dc5 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0\u0dba\u0dd2. \u0db8\u0dd2\u0dba\u0d9c\u0dd2\u0dba \u0db8\u0dab\u0dd2\u0d9a\u0dca\u0d9a\u0dd4 \u0db6\u0da9\u0dad\u0dd4\u0dbb\u0dd4\u0dd9\u0d9c\u0dca \u0d86\u0dbb\u0dd2\u0dba\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf\u0da7 \u0d85\u0dba\u0dad\u0dca \u0dc0 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0dc4\u0dcf \u0dd9\u0db8\u0dc4\u0dd2 \u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dd9\u0dba\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dd9\u0d9a\u0ddc\u0da7 \u0d87\u0dad\u0dca\u0dad\u0dcf \u0dc0\u0dd6, \u0d85\u0db1\u0dca\u0dad\u0dd2\u0db8 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0db4\u0dad\u0dba\u0d9a\u0dca \u0dd9\u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2 \u0dd9\u0daf\u0dca\u0db4\u0dc5\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0dd9\u0dc4\u0ddd \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dad\u0dcf\u0dc0\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dd9\u0dc4\u0ddd \u0db1\u0dd0\u0dad\u0dd0\u0dad\u0dca\u0dd9\u0dad\u0d9a\u0dd4/ \u0dad\u0dd0\u0db1\u0dd0\u0dad\u0dca\u0dad\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d91\u0d9a\u0dd3 \u0d85\u0db1\u0dca\u0dad\u0dd2\u0db8 \u0d9a\u0dd0\u0db8\u0dad\u0dd2 \u0db4\u0dad\u0dba\u0d9a\u0dca \u0dd9\u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2 \u0dd9\u0daf\u0dca\u0db4\u0dc5\u0da7 \u0dad\u0db8\u0dcf\u0dd9\u0d9c\u0dca \u0d87\u0dad\u0dd2 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dd9\u0dc4\u0ddd \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dad\u0dcf\u0dc0 \u0d9a\u0dc0\u0dd9\u0dbb\u0dca\u0daf\u0dd0\u0dba\u0dd2 2025 \u0d94\u0d9a\u0dca\u0dd9\u0dad\u0ddd\u0db6\u0dbb\u0dca 07 \u0daf\u0dd2\u0db1\u0da7 \u0dd9\u0db4\u0dbb \u0db4\u0dc4\u0dad \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0d85\u0dba \u0dd9\u0dc0\u0dad \u0dbd\u0