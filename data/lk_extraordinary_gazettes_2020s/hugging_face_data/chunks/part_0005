bbf\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0b8e\u0ba9 \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0bcd\u0b95\u0b95\u0bbe\u0b9f\u0bcd\u0bcd\u0b9f\u0b9f\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bb2\u0bbe\u0bae\u0bcd.\n\n2. \u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf\u0bae\u0bc1\u0bb1\u0bc8\u0bc8\u0b95\u0bb3\u0bcd \u0ba8\u0b9f\u0bc8\u0bc8\u0bae\u0bc1\u0bb1\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf\u0ba9\u0bcd\u0bb1\u0bc1 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0bbf\u0bbf\u0bb1\u0b95\u0bc1, \u0b9a\u0bc6\u0bc6\u0baf\u0bb2\u0bcd\u0ba8\u0bc1\u0ba3\u0bc1\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bcd \u0bb5\u0bbe\u0bbe\u0baf\u0bcd\u0ba8\u0bcd\u0ba4 \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bcd\u0bae\u0bae\u0bc8 \u0bb5\u0ba3\u0bbf\u0b95\u0bae\u0bbe\u0b95 \u0b85\u0b9f\u0bc8\u0baf\u0bbe\u0bb3\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0baa\u0bcd\u0bcd\u0baa\u0b9f\u0bcd\u0bcd\u0b9f\u0b9f \u0b8e\u0ba8\u0bcd\u0bcd\u0ba4\u0bb5\ufffd\u0bca\u0bb0\u0bc1 \u0bb5\u0ba3\u0bbf\u0b95\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0baa\u0725\u0bca\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1\u0bae\u0bcd."
