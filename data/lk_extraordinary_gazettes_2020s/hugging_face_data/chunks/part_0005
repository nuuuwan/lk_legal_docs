mjp tpNr\\khdJ - 2025.09.20\n\n5A\n\n\u0bae\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0bcd \u0bb5\u0bbe\u0bbe\u0baf\u0bcd\u0ba8\u0bcd\u0ba4 \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bae\u0bc8\u0bc8 \u0bb5\u0ba3\u0bbf\u0bbf\u0b95\u0bae\u0bbe\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0bc1\u0bae\u0bcd \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8\u0bc8 \u0bb5\ufffd\u0bb3\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1\n\n\u0ba4\ufffd\u0bca\u0b9f\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd\n\n(i) \u0b85\u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf \u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0bbe\u0ba9 \u0b87\u0ba3\u0b95\u0bcd\u0b95\u0b9a\u0bcd \u0b9a\u0bbe\u0bbe\u0ba9\u0bcd\u0bb1\u0bbf\u0bbf\u0ba4\u0bb4\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bb2\u0bcd, \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 (ii) \u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bc1\u0b9f\u0bc8\u0bc8\u0baf \u0bb5\u0b95\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0721 2 \u0b87\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0baa\u0b9f\u0bcd\u0b9a \u0b95\u0bbe\u0bbe\u0bb2\u0bae\u0bcd\n\n\u0b87\u0ba8\u0bcd\u0ba4 \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0ba4\u0bb2\u0bbe\u0bbe\u0bb5\u0ba4\u0bbe\u0bbe\u0b95 \u0b85\u0b9f\u0bc8\u0bc8\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0bbe\u0bb0\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bbe\u0bbe\u0bb2\u0bcd \u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bc1\u0bb1\u0bc1\u0bae\u0bcd.\n\n\"\u0b9a\u0bae\u0bc2\u0b95 \u0b89\u0b9f\u0bcd\u0b95\u0b9f\u0bcd\u0b9f\u0bae\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0bc1\" \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1 \u0b95\ufffd\u0bca\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1 \u0ba4\u0bc1\u0bb1\u0bc8\u0bc8\u0bae\u0bc1\u0b95 \u0ba8\u0b95\u0bb0 (\u0b85\u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0bbe\u0b9f\u0bc1) \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0bbf\u0bbf,\n\n\u0b95\u0bb2\u0bbe\u0bbe\u0b9a\u0bbe\u0bbe\u0bb0\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc1\u0b95\u0bbe\u0bbe\u0ba4\u0bbe\u0bbe\u0bb0\u0baa\u0bcd \u0baa\u0bb0\ufffd\u0bae\u0bb0\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bbe\u0bbe\u0ba8\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0ba8\u0bbf\u0bbf\u0bb2\u0bc8\u0bc8\u0baf \u0ba8\u0bbf\u0bbf\u0bb2\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0b95 \u0ba8\u0bbf\u0bbf\u0baf\u0bae\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bbf\u0bbf\u0bb2\u0ba4\u0bcd\n\n\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bc8\u0bc8\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0bb1\u0ba4\u0bc1.\n\nEOG 09 - 0233\n\n\u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0b85\u0bb0\u0b9a\u0bbe\u0bbe\u0b99\u0bcd\u0b95 \u0b85\u0b9a\u0bcd\u0b9a\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0ba3\u0721\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd \u0baa\u0ba4\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0bc6\u0bc6\u0bb1\u0bcd\u0bb1\u0ba4\u0bc1."
