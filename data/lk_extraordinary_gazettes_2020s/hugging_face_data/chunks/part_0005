\u0dad\u0db1\u0dad\u0dd4\u0dbb\u0dda\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4 \u0dc0\u0dd3\u0db8 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d86\u0dc3\u0dcf\u0dcf\u0db0\u0dcf\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd3 \u0dad\u0dd2\u0db6\u0dda\ufffd\u0daf? \u0dba\u0db1\u0dca\u0db1 \u0dc4\u0dcf\u0dcf \u0d91\u0dc3\u0dda\ufffd\u0dda \u0d86\u0dc3\u0dcf\u0dcf\u0db0\u0dcf\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc0 \u0dad\u0dd2\u0db6\u0dda\ufffd \u0db1\u0db8\u0dca \u0d94\u0dc4\u0dd4\u0da7 \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dc4\u0db1 \u0d9a\u0dc0\u0dbb\u0dda\u0dda \u0daf \u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dc0\u0dda\u0dda\u0dda\u201d\n\n2021.03.18 \u0daf\u0dd2\u0db1 \u0db1\u0dd0\u0dd0\u0dc0\u0dad \u0dc0\u0dd2\u0db7\u0dcf\u0dcf\u0d9c\u0dba \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0daf\u0dd3 \u0db1\u0dd3\u0dad\u0dd3\u0da5 \u0dc3\u0db8\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dbd\u0dcf\u0dcf\u0dbd\u0dca \u0db8\u0dc4\u0dad\u0dcf\u0dcf \u0db4\u0dd0\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dbd\u0dd2\u0d9a\u0dbb\u0dd4 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0db4\u0dd9\u0dd9\u0db1\u0dd3 \u0dc3\u0dd2\u0da7 \u0db4\u0dd0\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dbd\u0dca\u0dbd \u0db8\u0dd9\ufffd\u0dc4\u0dd9\ufffd\u0dba \u0dc0\u0db1 \u0dbd\u0daf\u0dd2. 2015.11.24 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0db8\u0dab\u0dca\u0da9\u0dbd \u0dad\u0dd2\u0dbb\u0dab\u0dba (\u0d92 - 21) \u0d85\u0db1\u0dd4\u0dc0 \u0dc3\u0dc4\u0d9a\u0dcf\u0dcf\u0dbb \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0dad\u0db1\u0dad\u0dd4\u0dbb \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0da7 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc0\u0db1 \u0dc3\u0dda\ufffd\u0dda \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dad\u0dca \u0d91\u0dc3\u0dda\ufffd\u0dda \u0d89\u0dbd\u0dca\u0dbd\u0dd4 \u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba ( \u0d92 - 22 \u0dc4\u0dcf\u0dcf \u0d92 - 22(\u0d92)) \u0db6\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0dcf\u0dcf \u0dc3\u0dd2\u0da7\u0dd3. \u0d91\u0dc3\u0dda\ufffd\u0dda\u0db8 (\u0d92 22 ( \u0db6\u0dd3 )) \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0d9c\u0dda\u0dda\u0118 \u0dad\u0db1\u0dad\u0dd4\u0dbb \u0dc0\u0db1 \u0d85\u0dad\u0dd2\u0dbb\u0dda\u0dda\u0d9a \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0db0\u0dd4\u0dbb\u0dba \u0d85\u0dad\u0dd2\u0dbb\u0dda\u0dda\u0d9a \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0db1\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2 \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0db0\u0dd4\u0dbb\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0db8\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0dd9\ufffd\u0dc3 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dba \u0d89\u0dbd\u0dca\u0dbd\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0dba. ( \u0d92 - 22(\u0dc3\u0dd3)) \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dd9\u0dd9\u0db1\u0dca\u0dc0\u0dcf\u0dcf \u0daf\u0dd9\u0dd9\u0db1\u0dca\u0db1\u0dda\ufffd \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0db1\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dc4\u0dcf\u0dcf \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba\u0dda\u024f \u0db4\u0dd0\u0dd0\u0dc0\u0dad\u0dd2 \u0dc3\u0dcf\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf\u0dcf\u0dc0 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d87\u0dad\u0dd2 \u0dc0\u0dd4 \u0d91\u0d9a\u0d9f\u0dad\u0dcf\u0dcf\u0dc0\u0dba \u0db8\u0dad \u0d94\u0db6\u0da7 \u0dc0\u0dd0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc0\u0dbb\u0dca\u0db0\u0d9a \u0dc4\u0dcf\u0dcf\n\n9AI \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3 : \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dc3 : (I) \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u200d\u200d\u0da1\u0dd9\u0dd9\u0daf\u0dba \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u200d\u200d\u0da1\u0dd9\u0dd9\u0daf\u0dba \u2013 \u2013 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u2013 2025.08.27\u2013 2025.08.27"
