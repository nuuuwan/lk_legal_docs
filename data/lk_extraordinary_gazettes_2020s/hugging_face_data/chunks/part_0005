f \u0baa\ufffd\u0bcb\u0b95\u0bc1\u0bae\u0bcd \u0bb5\u0bbe\u0bbe\u0bb0\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bc8\u0bc8\u0baf\u0bc1\u0bae\u0bcd\n\n\u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b89\u0b9f\u0bb2\u0bbf\u0ba9\u0bcd \u0b95\u0bc1\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0bc7\u0bc7 \u0baa\u0b95\u0bcd\u0b95\u0bb5\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd \u0baa\ufffd\u0bcb\u0b95\u0bc1\u0bae\u0bcd \u0bb5\u0bbe\u0bbe\u0bb0\u0bc8\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f\u0ba4\u0bc1\u0bae\u0bbe\u0bbe\u0ba9 \u0b92\u0bb0\u0bc1 \u0ba8\u0bbf\u0bbf\u0baf\u0bae \u0b86\u0b9a\u0ba9\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf \u0b92\u0ba9\u0bcd\u0bb1\u0bbe\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bb5\ufffd\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd ; \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd\n\n(\u0b86) \u0bae\u0bc1\u0ba9\u0bcd \u0ba8\u0bbf\u0bbf\u0bb0\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0b86\u0b9a\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0b9f \u0b8f\u0ba9\ufffd\u0baf \u0b86\u0b9a\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0b86\u0b9a\u0ba9\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0b95\u0bb3\u0bcd \u0b86\u0b9a\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0bb5\u0b9f\u0bbf\u0bb5\u0bae\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0ba9\u0bcd \u0bae\u0bc0\u0ba4\u0bc1 \u0b95\u0bc1\u0bb1\u0bc8\u0bc8\u0ba8\u0bcd\u0ba4\u0ba4\u0bc1 \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bc1 \u0ba8\u0b99\u0bcd\u0b95\u0bc2\u0bb0\u0baa\u0bcd \u0baa\u0bc1\u0bb3\u0bcd\u0bb3\u0bbf\u0bbf\u0b95\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd \u0b89\u0b9f\u0bb2\u0bbf\u0ba9\u0bcd \u0b95\u0bc1\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0bc7\u0bc7 \u0baa\u0b95\u0bcd\u0b95\u0bb5\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0baa\ufffd\u0bcb\u0b95\u0bc1\u0bae\u0bcd \u0bb5\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf\u0ba9\ufffd\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f \u0ba8\u0bbf\u0bbf\u0baf\u0bae \u0b86\u0b9a\u0ba9\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf \u0b92\u0ba9\u0bcd\u0bb1\u0bbe\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bb5\ufffd\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\n\n8\u0b8a. \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf 8\u0b88 \u0b89\u0baa \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf (2) \u0b87\u0bb2\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u0bbe\u0b9f\u0bc1 \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0bc8 \u0ba4\u0bb5\u0bbf\u0bbf\u0bb0, 2011, \u0b93\u0b95\u0ba4\u0bcd\u0ba4\u0bc1 09 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 1718/12 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b85\u0ba4\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0b9a\u0bc7\u0bc7\u0b9f \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0bb5\ufffd\u0bbf\ufffd\u0baf\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 2011 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 3 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd \u0bb5\u0bbe\u0bbe\u0b95\u0ba9 (\u0b86\u0b9a\u0ba9\u0baa\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0b95\u0bb3\u0bcd) \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd \u0b95\u0b9f\u0bc1\u0b95\u0ba4\u0bbf\u0bbf\u0baa\u0bcd \u0baa\u0bbe\u0bbe\u0ba4\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0b93\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0baa\u0bbe\u0bbe\u0bb5\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0baa\u0bbf\u0bbf\u0bb0\u0bb5\ufffd\u0b9a\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd \u0bb5\u0bbe\u0bbe\u0b95\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0b9a\u0bbe\u0bbe\u0bb0\u0ba4\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b9a\ufffd\u0bca\u0ba8\u0bcd\u0ba4\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0bb0\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u0baa\u0bc1\u0b9f\u0bc8\u0bc8\u0baf\u0ba4\u0bbe\u0bbe\u0ba4\u0bb2\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba4\u0bc1.\u201d.\n\nEOG 09-0239\n\n,yq;if murhq;f mr;Rj; jpizf;fsj;jpw; gjpg;gpf;fg;ngw;wJ."
