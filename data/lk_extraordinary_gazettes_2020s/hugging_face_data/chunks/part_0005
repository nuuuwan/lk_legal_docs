0dd2\u0dba\u0db8\u0dcf\u0dcf\u0dc0\u0dbd\u0dd2\u0dba 2025 \u0d85\u0d82\u0d82\u0d9a 02 \u0daf\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc0\u0dd2\u0dc0\u0dd8\u0dd8\u0dad \u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dbd (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1) \u0db1\u0dd2\u0dba\u0db8\u0dcf\u0dcf\u0dc0\u0dbd\u0dd2\u0dba \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb \u0d91\u0dba\n\n\u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba.\n\n2. 2020 \u0da2\u0db1\u0dc0\u0dcf\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 07 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 2157/9 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2\u0dc0\u0dd2\u0dc1\u200d\u0dd9\ufffd\u0dd9\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd2\u0dba\u0db8\u0dcf\u0dcf\u0dc0\u0dbd\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0dbb\u0da7\n\n\u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc0\u0dd6, 1990 \u0da2\u0db1\u0dc0\u0dcf\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 05 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 591/18 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2\u0dc0\u0dd2\u0dc1\u200d\u0dd9\ufffd\u0dd9\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf 1990 \u0d85\u0d82\u0d82\u0d9a 1 \u0daf\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc0\u0dd2\u0dc0\u0dd8\u0dd8\u0dad \u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dbd \u0db1\u0dd2\u0dba\u0db8\u0dcf\u0dcf\u0dc0\u0dbd\u0dd2\u0dba\u0dda\u0dda\u024f 16 \u0dc0\u0db1 \u0da1\u0dda\u0dda\u0dda\u0daf\u0dba\u0dd9\u0dca\u024f (3) (i) \u0dc0\u0db1 \u0d85\u0db1\u0dd4\u0da1\u0dda\u0dda\u0dda\u0daf\u0dba \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dbb \u0d92 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3 \u0d86\u0daf\u0dda\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0dda\u0229.\n\n\u201c(i) \u0dc1\u0dcf\u0dcf\u0d9b \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf .\u201d\n\nEOG 09 - 0086\n\nY%S ,xld rcfha uq\u00f8K fomd\u00be;f\u00efka;=f\u00f5 uq\u00f8Kh lrk ,\u00a7'"
