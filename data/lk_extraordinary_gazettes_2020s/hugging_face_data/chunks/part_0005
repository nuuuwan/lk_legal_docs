\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d85\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc3\u0dcf\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0db6\u0dc4\u0dcf\u0dcf\u0dbd\u0dd4\u0db8\u0dca \u0db8\u0dbd\u0dd4 \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0db4\u0dcf\u0dcf\u0dbb\u0dd2\u0db7\u0ddd\u02dd\u0ddd\ufffd\u0d9c\u0dd2\u0d9a\u0dba\u0dd9\ufffd\u0d9a\u0dd4 \u0dc0\u0dd9\u0dd9\u0dad \u0db1\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dbd\u0dda\u0262 \u0dbd\u0db6\u0dcf\u0dcf \u0daf\u0dd3\u0db8 \u0db1\u0ddc\ufffd\u0ddc\u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\u0da7 \u0daf \u0d92 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db8\u0dd4\u0daf\u0dbd \u0db6\u0dd2\u0dbd\u0dca\u0db4\u0dad\u0dd9\ufffd\u0dc4\u0dd2 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dc5\u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\u0da7 \u0daf \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n\u0d85\u0da9\u0dd4 \u0d9d\u0db1\u0dad\u0dca\u0dc0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0ddc\ufffd\u0ddc\u0dbd\u0dd2\u0d91\u0dad\u0dd2\u0dbd\u0dd2\u0db1\u0dca (LDPE) - Low-Density Polyethylene\n\n\u0dbb\u0dda\u0dda\u0d9b\u0dd3\u0dba \u0d85\u0da9\u0dd4 \u0d9d\u0db1\u0dad\u0dca\u0dc0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0ddc\ufffd\u0ddc\u0dbd\u0dd2\u0d91\u0dad\u0dd2\u0dbd\u0dd2\u0db1\u0dca (LLDPE) - (Linear Low-Density Polyethylene\n\n\u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf, \u0db6\u0dc4\u0dcf\u0dcf\u0dbd\u0dd4\u0db8\u0dca \u0db8\u0dbd\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0dba\u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db8\u0dd2\u0dbd, \u0dc3\u0dca\u0dc0\u0d9a\u0dd3\u0dba \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dcf\u0dcf\u0dbb\u0dd2\u0d9a \u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0da7\u0dc0 \u0db4\u0dd9\u0dd9\u0db1\u0dd9\ufffd\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dbb\u0dca\u0dc1\u0db1\u0dba \u0d9a\u0dc5\u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0 \u0daf \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n\u0d85\u0dbb\u0dca\u0dae \u0db1\u0dd2\u0dbb\u0dd6\u0db4\u0dab\u0dba\n\n\u0db6\u0dc4\u0dcf\u0dcf\u0dbd\u0dd4\u0db8\u0dca \u0db8\u0dbd\u0dd4 \u0dba\u0db1\u0dca\u0db1\u0dd9\ufffd\u0db1\u0dca \u2018\u0dc3\u0dd2\u0dbd\u0dd2 \u0dc3\u0dd2\u0dbd\u0dd2 \u0db6\u0dd1\u0dd1\u0d9c\u0dca\u2019 \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dd9\u0dcf\ufffd\u0dcf\u0daf\u0dd4\u0dc0\u0dda\u0dda \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db8\u0dd2\u0dbd\u0daf\u0dd3 \u0d9c\u0dad\u0dca \u0db7\u0dcf\u0dcf\u0dab\u0dca\u0da9 \u0dbb\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dba\u0dcf\u0dcf\u0db8\u0dda\ufffd \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0dad\u0dcf\u0dcf \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dc5\u0dd4 \u0dc3\u0dc4\u0dd2\u0dad \u0d9a\u0dd4\u0db8\u0db1 \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0db4\u0dbb\u0dd2\u0db8\u0dcf\u0dcf\u0dab\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dd4 \u0db8\u0dbd\u0dd4 \u0dba\u0db1\u0dca\u0db1 \u0d85\u0daf\u0dc4\u0dc3\u0dca\u0dca \u0dc0\u0dd9\u0dca\u0dca.\n\n(\u0db8\u0db0\u0dca\u200d\u0dba\u0dba\u0db8 \u0db4\u0dbb\u0dd2\u0dc3\u0dbb \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba)\n\n\u0db8\u0dd9\ufffd\u0db8 \u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1\u0dba \u0dc0\u0dbb\u0dca\u0dc2 2025 \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 01 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0db6\u0dbd\u0db4\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0dc0\u0dd9\u0dd9\u0db1\u0dd4 \u0d87\u0dad.\n\n\u0db4\u0dcf\u0dcf\u0dbb\u0dd2\u0db7\u0ddd\u02dd\u0ddd\ufffd\u0d9c\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0dd2