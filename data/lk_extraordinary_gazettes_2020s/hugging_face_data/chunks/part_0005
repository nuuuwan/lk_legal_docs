u0dba\u0dda\u024f \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0daf\u0dd2\u0db1\u0dba\u0dda\u024f \u0dc3\u0dd2\u0da7 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0daf\u0dd9\u0dd9\u0d9a\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d9c\u0dd9\u02c3\u0dc0\u0dd3\u0db8 \u0d9c\u0dd0\u0dd0\u0db1 \u0dc3\u0dbd\u0d9a\u0dcf\u0dcf \u0db6\u0dbd\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229. \u0d9a\u0dd9\ufffd\u0dc3\u0dda\ufffd\u0dda \u0dc0\u0dd4\u0dc0\u0dad\u0dca, \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dc5 \u0db8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0daf\u0dd9\u0dd9\u0d9a\u0d9a\u0dca \u0d89\u0d9a\u0dca\u0db8\u0d9c\u0dd2\u0dba \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dd0\u0dc0\u0dad \u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d91\u0dc4\u0dd2 \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0dcf\u0d9a\u0db8 \u0d86\u0db4\u0dc3\u0dd4 \u0d9c\u0dd9\u02c3\u0dc0\u0dd3\u0db8\u0da7 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db1\u0ddc\ufffd\u0ddc\u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0d85\u0dad\u0dbb, \u0d91\u0db8 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca\u0dc0\u0dbd \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0dcf\u0d9a\u0db8 \u0dbb\u0da2\u0dba\u0dda\u024f \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0db8\u0da7 \u0db6\u0dd0\u0dd0\u0dbb \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.\n\n02. \u0d91\u0dc3\u0dda\ufffd\u0dda \u0dc0\u0dd4\u0dc0\u0dad\u0dca, \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc0\u0dd2\u0dc1\u0dda\u02e4\u0dda\u0dc2 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf \u0dba\u0da7\u0dad\u0dda\ufffd \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0daf\u0dd9\u0dd9\u0d9a\u0d9a\u0dca \u0d89\u0d9a\u0dca\u0db8\u0d9c\u0dd2\u0dba \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca\u0dc0\u0dbd \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0dcf\u0d9a\u0db8 \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4 \u0d85\u0dba\u0d9a\u0dbb\n\n\u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dc3\u0dd4 \u0dbb\u0da2\u0dba\u0dda\u024f \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0db8\u0dd9\ufffd\u0db1\u0dca \u0d86\u0db4\u0dc3\u0dd4 \u0d9c\u0dd9\u02c3\u0dc0\u0dd3\u0db8 \u0d9c\u0dd0\u0dd0\u0db1 \u0dc3\u0dbd\u0d9a\u0dcf\u0dcf \u0db6\u0dd0\u0dd0\u0dbd\u0dd2\u0dba \u0dc4\u0dd0\u0dd0\u0d9a.\n\nI. \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0dc0\u0dd9\u0dd9\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd3\u0db8.\n\nII. \u0db1\u0dd3\u0dad\u0dd2\u0db8\u0dba \u0dc4\u0dda\ufffd\u0dda\u0dad\u0dd6\u0db1\u0dca \u0db8\u0dad \u0d9c\u0dd9\u02c3\u0dc0\u0dbd\u0dca \u0d9a\u0dd4\u0dbd\u0dd3 \u0db4\u0dcf\u0dcf\u0dbd\u0d9a \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0d9a\u0dca \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca \u0dbb\u0db3\u0dc0\u0dcf\u0dcf\u0d9c\u0dd9\u02c3\u0db1 \u0dad\u0dd2\u0db6\u0dd3\u0db8.\n\nIII. \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dda\ufffd \u0db8\u0dd4\u0daf\u0dbd \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dba \u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dc1\u0d9c\u0dad \u0dc0\u0dd3 \u0dc3\u0dd2\u0da7\u0dd3\u0db8.\n\n(\u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dc1 \u0d9c\u0db8\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba.)\n\nIV. \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dba \u0daf\u0dd3\u0dbb\u0dca\u0d9d\u0d9a\u0dcf\u0dcf\u0dbd\u0dd3\u0db1\u0dc0 \u0daf\u0dd0\u0dd0\u0da9\u0dd2 \u0d85\u0dba\u0dc4\u0db4\u0dad\u0dca \u0dc3\u0dde\ufffd\u0dde\u0d9b\u0dca\u200d\u0dba\u0dba \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0\u0dd3\u0db8.\n\n(\u0dbb\u0da2\u0dba\u0dda\u024f \u0dc0\u0ddb\u0ddb\u0daf\u0dca\u200d\u0dba\ufffd \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0d9a\u0dd4\u0d9c\u0dd9\u02c3\u0db1\u0dca \u0dbd\u0db6\u0dcf\u0dcf\u0d9c\u0dad\u0dca \u0dc0\u0ddb\u0ddb\u0daf\u0dca\u200d\u0dba\ufffd \u0dc3\u0dc4\u0dad\u0dd2\u0d9a\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d92 \u0db6\u0dc0 \u0dc3\u0db1\u0dcf\u0dcf\u0dae \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba.)\n\n03. \u0d89\u0dc4\u0dad 02 (I) \u0dc4\u0dcf\u0dcf (II) \u0dba\u0da7\u0dad\u0da7 \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca \u0db8\u0dd9\ufffd\u0db8 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0daf\u0db1\u0dba\u0dda\u024f \u0db4\u0dc5\u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0db8\u0dcf\u0dcf\u0dc3 \u0dad\u0dd4\u0db1\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0db1\u0ddc\ufffd\u0ddc\u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0db1\u0db8\u0dca \u0d91\u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dbb \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0db1\u0da9\u0dd4 \u0d85\u0d82\u0d82\u0d9a \u0d86\u0daf\u0dd3 \u0dc3\u0db8\u0d9c \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0db4\u0dcf\u0dcf\u0dbd\u0d9a \u0dc0\u0dd9\u0dd9\u0dad \u0dbd\u0dd2\u0d9b\u0dd2\u0dad\u0dc0 \u0d91\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba. \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0db4\u0dc4\u0dc3\u0dd4\u0dc0\u0db1\u0dca\u0db1\u0dda\ufffd \u0db1\u0db8\u0dca \u0d92 \u0db6\u0dc0 \u0dbd\u0dd2\u0d9b\u0dd2\u0dad\u0dc0 \u0daf\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd2\u0db