 \u0dc3\u0db7\u0dcf\u200d\u200d\ufffd\u0dc0\u0dda\u0dda\u0dda \u200d\u200d\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0d91\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd9\ufffd\u0d9a\u0dd4\u0d9c\u0dda\u0dda\u0118 \u0db0\u0dd6\u0dbb\u0dba\u0d9a\u0dca \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0dcf\u0da9\u0dd4 \u0dc0\u0dd3 \u0d87\u0dad\u0dd2 \u0dc4\u0dd9\u02e7\u0dba\u0dd2\u0db1\u0dca \u0daf;\n\n\u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\ufffd 66\u0d85 (1) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0d85\u0d9a\u0dca\u0d9a\u0dbb\u0dd9\u0dd9\u0dba\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u200d\u200d\ufffd\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0d91\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd9\ufffd\u0d9a\u0dd4 \u0dbd\u0dd9\ufffd\u0dc3 \u0db4\u0dad\u0dca\u0dc0\u0dd6 \u0db1\u0dcf\u0dcf\u0d9c\u0dd4\u0dbb\u0dca\u0dad\u0db8\u0dca\u0db6\u0dd2 \u0db8\u0dd4\u0dc4\u0db8\u0dca\u0db8\u0da9\u0dca \u0dc3\u0dd2\u0dbb\u0dcf\u0dcf\u0da2\u0dd4\u0daf\u0dd3\u0db1\u0dca \u0d85\u0dba\u0dad\u0dca \u0dc0\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dc0\u0dd6 \u0d85\u0dc4\u0dd2\u0dbd \u0d89\u0dbd\u0d82\u200d\u200d\ufffd\u0d9c\u0dd9\u02c3\u0dba\u0dd2 \u0db8\u0dc4\u0da2\u0db1 \u200d\u200d\u0d9a\u0ddc\u0d82\ufffd\u0d82\ufffd\u0d9c\u0dca\u200d\u0dbb\u0dc3\u0dba \u0db1\u0db8\u0dca\u0dc0\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca \u0daf\u0dda\u0dda\u0dda\u0dc1\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda\u024f \u0dbd\u0dda\u0dda\u0262\u0d9a\u0db8\u0dca\u0da7 \u0daf\u0dd2\u0db1 \u0dad\u0dd2\u0dc4 (30) \u0d9a \u0d9a\u0dcf\u0dcf\u0dbd \u0db4\u0dbb\u0dd2\u0da0\u0dca\u0da1\u0dda\u0dda\u0dda\u0daf\u0dba \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\ufffd (262 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba) 9 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0db1\u0dd4\u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dca\u0dca\u0dc3\u0dd9\ufffd\u0d9a\u0dd4 \u0dc0\u0dd3 \u0db1\u0ddc\ufffd\u0ddc\u0db8\u0dd0\u0dd0\u0dad\u0dd2 \u0d85\u0db4\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0d9a\u0dba\u0dd9\ufffd\u0d9a\u0dd4, \u0dc3\u0dc4\u0dd2\u0d9a\u0dba\u0dd9\ufffd\u0d9a\u0dd4 \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd0\u0dd0\u0dba\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0dd6 \u0daf, \u0d91\u0db8 \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0da7 \u0d85\u0dba\u0dad\u0dca \u0dc0\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dc0\u0dd6 \u0daf, \u0d91\u0db8 \u0d85\u0d9a\u0dca\u0d9a\u0dbb\u0dd9\u0dd9\u0dba\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u200d\u200d\ufffd\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0d91\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dcf\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0db8\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6 \u0d87\u0dad\u0dd2 \u0dc4\u0dd9\u02e7\u0dba\u0dd2\u0db1\u0dca \u0daf;\n\n\u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca \u0daf\u0dda\u0dda\u0dda\u0dc1\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda\u024f \u0dbd\u0dda\u0dda\u0262\u0d9a\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d91\u0db8 \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0dcf\u0da9\u0dd4\u0dc0 \u0db4\u0dd2\u0dbb\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d86\u0daf\u0db8\u0dca\u0dbd\u0dd9\ufffd\u0db6\u0dca\u0db6\u0dd9\ufffd\u0dba\u0dd2 \u0dc3\u0db4\u0dd6\u0dbb\u0dca \u0db1\u0db8\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u0dda\u023c \u0dc3\u0dca\u0dca\u0dc0\u0d9a\u0dd3\u0dba \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0daf\u0db1\u0dca\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6 \u0d87\u0dad\u0dd2 \u0dc4\u0dd9\u02e7\u0dba\u0dd2\u0db1\u0dca \u0daf ;\n\n\u0d85\u0d9a\u0dca\u0d9a\u0dbb\u0dd9\u0dd9\u0dba\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u200d\u200d\ufffd\u0dc0\u0dda\u0dda\u0dda \u0dad\u0dda\ufffd\u0dbb\u0dd3\u0db8\u0dca\u0db7\u0dcf\u0dcf\u0dbb \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2, \u0d85\u0dad\u0dca\u0dad\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dc3\u0dda\ufffd\u0dda\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0dda\u0118 \u0d9a\u0dc3\u0dd4\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0db1\u0dcf\u0dcf\u0dad\u0dca \u0d85\u0dad\u0dca\u0dad\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0dc0\u0db1 \u0db8\u0db8, \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\ufffd (262 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba) 66\u0d85(1) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0d86\u0daf\u0db8\u0dca\u0dbd\u0dd9\ufffd\u0db6\u0dca\u0db6\u0dd9\ufffd\u0dba\u0dd2 \u0dc3\u0db4\u0dd6\u0dbb\u0dca, \u0d85\u0d9a\u0dca\u0d9a\u0dbb\u0dd9\u0dd9\u0dba\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u200d\u200d\ufffd\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbb\u0dcf\u0dcf \u0d91\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd9\ufffd\u0d9a\u0dd4 \u0dbd\u0dd9\ufffd\u0dc3 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1 \u0d9a\u0dbb\u0db8\u0dd2.\n\n\u0d9a\u0dc3\u0dd4\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0db1\u0dcf\u0dcf\u0dad\u0dca \u0d85\u0dad\u0dca\u0dad\u0db1\u0dcf\u0dcf\u0dba\u0d9a, \u0dad\u0dda\ufffd\u0dbb\u0dd3\u0db8\u0dca\u0db7\u0dcf\u0dcf\u0dbb \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2, \u0d85\u0d9a\u0dca\u0d9a\u0dbb\u0dd9\u0dd9\u0dba\u0dd2\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0db8\u0dc4\u0dcf\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0.\n\n2025 \u0d85\u0d9c\u0ddd\u02c3\u0ddd\ufffd\u0dc3\u0dca\u0dca\u0dad\u0dd4 \u0db8\u0dc3 25 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0daf\u0dd2\u0dc3\u0dca\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba,\u0d85\u0db8\u0dca\u0db4\u0dcf\u0dcf\u0dbb.\n\nEOG 09 - 0071"
