db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda\u0dda \u0db8\u0dd0\u0dd0\u0daf \u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba\u0dda\u024f \u0dc3\u0dc4\u0d9a\u0dcf\u0dcf\u0dbb \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0dc0\u0dd9\u0dd9\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dad\u0dbb \u0d89\u0dc4\u0dad \u0db1\u0dd2\u0dba\u0db8\u0dba\u0db1\u0dca \u0d94\u0dc4\u0dd4 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0dc0\u0dd3\u0db8\u0da7 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4 \u0db4\u0dd2\u0dba\u0dc0\u0dbb \u0d9c\u0dad \u0dba\u0dd4\u0dad\u0dd4\u0dba.\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0d8b\u0dc3\u0dc3\u0dca \u0dad\u0dcf\u0dcf\u0d9a\u0dca\u0dc2\u0dab \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d9c\u0dd9\ufffd\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\u0da7 \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0dd2\u0dba\u0dc5\u0dd4 \u0dc4\u0dd2\u0d9f \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0da7\u0dd3. \u0d91\u0db8\u0dca. \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0d9c\u0dda\u0dda\u0118 \u0db8\u0dc4\u0dad\u0dcf\u0dcf\u0da7 \u0d9c\u0dd9\ufffd\u0dc0\u0dd3\u0db8\u0da7 \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db8\u0dd0\u0dd0\u0daf \u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba\u0dda\u024f \u0dc3\u0dc4\u0d9a\u0dcf\u0dcf\u0dbb \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0dc0\u0dd9\u0dd9\u0dad \u0dad\u0dd0\u0dd0\u0db1\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba.\n\n\u0db8\u0dd9\ufffd\u0db8 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dcf\u0db1\u0dba \u0dc3\u0dcf\u0dcf\u0db0\u0dcf\u0dcf\u0dbb\u0dab \u0dc4\u0dcf\u0dcf \u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc3\u0dc4\u0d9c\u0dad \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0db6\u0dc0\u0da7 \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db8\u0dd2.\n\n\u0d91\u0db8\u0dca.\u0d91\u0db8\u0dca. \u0d85\u0dba\u0dd2.\u0d86\u0dbb\u0dca.\u0d92.\u0da2\u0dba\u0dad\u0dd2\u0dbd\u0d9a, \u0db6\u0dda\ufffd\u0dbb\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4.\n\n2025 \u0d85\u0d9c\u0ddd\ufffd\u0ddd\u0dc3\u0dca\u0dad\u0dd4 \u0db8\u0dc3 13 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1.\n\nE0G 09 - 0081_________________\n\n\u0db8\u0d9c\u0dda\u0dda\u0118 \u0d85\u0d82\u0d82\u0d9a\u0dba - IR/COM/04/2019/165 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dcf\u0dcf\u0dc0\u0dd4\u0dbd\u0dca \u0db4\u0db1\u0dad - 131 \u0dc0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba"
