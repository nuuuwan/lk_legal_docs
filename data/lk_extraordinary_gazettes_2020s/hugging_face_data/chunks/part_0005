    "chunk_text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\ufffd \u0dc4\u0dba (6) \u0dc0\u0db1 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db1\u0dd2\u0dbd \u0d9a\u0dcf\u0dcf\u0dbd\u0dba 2017 \u0dc3\u0dd0\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 26 \u0daf\u0dd2\u0db1\u0dd9\ufffd\u0db1\u0dca \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0dd6 \u0db6\u0dd0\u0dd0\u0dc0\u0dd2\u0db1\u0dca 1987 \u0d85\u0d82\u0d82\u0d9a 42 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf \u0db4\u0db1\u0dad\u0dda\ufffd 27 (\u0d85) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0 \u0db8\u0dd9\u02de\u0db8 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda 2025 \u0dc0\u0dbb\u0dca\u0dc2\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0daf\u0dd9\u0dd9\u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0db4\u0dd4\u0dbb\u0d9a \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dba\u0dda\u024f \u0dc4\u0dad\u0dca\u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u024f \u0dc3\u0db3\u0dc4\u0db1\u0dca 2024 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda\u024f \u0d85\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0db8\u0dca \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0dca\u0dc0\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db8\u0dd9\u02de\u0dba\u0d