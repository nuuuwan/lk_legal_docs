\n\n1:76 0.0409 \u0dc3\u0dd2\u0dc0\u0dd4\u0dbb\u0dad\u0dca\u0db1 \u0db6\u0d82\u0da9\u0dcf\u0dbb \u0db1\u0dcf\u0dba\u0d9a \u0dba\u0dcf\u0db4\u0dcf 605140483V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 14 \u0dc4\u0dcf 19 _ \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0daf\u0dba\u0dcf\u0dc0\u0dad\u0dd3 \u0db8\u0dd0\u0dab\u0dd2\u0dd9\u0d9a\u0dca \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0 \u0db4\u0dc4\u0dc5 \u0db8\u0da9\u0dc0\u0dbd, \u0d8b\u0dc4\u0dd4\u0db8\u0dd3\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f 1:104 0.0159 \u0db6\u0dcf\u0dbd\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dd2 685432277V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0d85\u0dd9\u0dc1\u0ddd\u0d9a\u0dcf \u0db6\u0dcf\u0dbd\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0dc3\u0dd4\u0da2\u0dd3\u0dc0, \u0dc3\u0dd2\u0dba\u0dad \u0db4\u0da7\u0dd4\u0db8\u0d9f, \u0db8\u0dbd\u0dca\u0d9a\u0da9\u0dd4\u0dc0\u0dcf\u0dc0, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd 1:130 0.0376 \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0da2\u0dba\u0dad\u0dd2\u0dbd\u0d9a 761560344V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 14 \u0dc4\u0dd2 _ \u0db6\u0d82\u0da9\u0dcf\u0dbb \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 155, \u0db4\u0db0\u0dcf\u0db1 \u0db8\u0dcf\u0dc0\u0dad, \u0db4\u0dd2\u0d82\u0dc0\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d