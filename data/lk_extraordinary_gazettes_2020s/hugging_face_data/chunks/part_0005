ca \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba'\n\n2025 \u0dc3\u0dd0\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 25 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1,\u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9 \u0daf\u0dd3 \u0dba.\n\n\u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\n\n2018 \u0da2\u0db1\u0dc0\u0dcf\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 15 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 2054/8 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0dd2\u0dad 2011 \u0d85\u0d9c\u0ddd\ufffd\u0ddd\u02ea\u0dc3\u0dca\u0dca\u0dad\u0dd4 \u0db8\u0dc3 03 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 1717/14 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf 2011 \u0d85\u0d82\u0d82\u0d9a 2 \u0daf\u0dbb\u0db1 \u0db8\u0ddd\u02de\u0ddd\u02ea\u0da7\u0dbb\u0dca \u0dc0\u0dcf\u0dcf\u0dc4\u0db1 (\u0d85\u0db0\u0dd2\u0dc0\u0dda\u0dda\u0d9c\u0dd3 \u0db8\u0dc4\u0dcf\u0dcf \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c) \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c, \u0d91\u0dc4\u0dd2 8 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dba\u0da7 \u0d89\u0d9a\u0dca\u0db6\u0dd2\u0dad\u0dd2\u0dc0 \u0db8 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\u02de\u0db1\u0dca \u0db8\u0dd9\u02de\u0dba\u0dd2\u0db1\u0dca \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229:-\n\n\u201c8\u0d85. \u0d85\u0db0\u0dd2\u0dc0\u0dda\u0dda\u0d9c\u0dd3 \u0db8\u0dc4\u0dcf\u0dcf \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0d9a \u0db0\u0dcf\u0dcf\u0dc0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db8\u0ddd\u02de\u0ddd\u02ea\u0da7\u0dbb\u0dca \u0dc0\u0dcf\u0dcf\u0dc4\u0db1\u0dba\u0d9a \u0dbb\u0dd2\u0dba\u0daf\u0dd4\u0dbb\u0d9a\u0dd4 \u0dc3\u0dc4 \u0d91\u0db8 \u0db8\u0ddd\u02de\u0ddd\u02ea\u0da7\u0dbb\u0dca \u0dc0\u0dcf\u0dcf\u0dc4\u0db1\u0dba\u0dda\u024f \u0dba\u0db8\u0dca \u0d86\u0dc3\u0db1\u0dba\u0d9a \u0d85\u0dc3\u0dd4\u0db1\u0dca\u0d9c\u0dd9\ufffd\u0db1 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc3\u0dc4 \u0d9c\u0db8\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc3\u0dd1\u0dd1\u0db8 \u0db8\u0d9c\u0dd2\u0dba\u0d9a\u0dd4 \u0db8 \u0dc3\u0dc4 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0d9a\u0dd4 \u0db8, \u0d91\u0db8 \u0db8\u0ddd\u02de\u0ddd\u02ea\u0da7\u0dbb\u0dca \u0dc0\u0dcf\u0dcf\u0dc4\u0db1\u0dba \u0d85\u0db0\u0dd2\u0dc0\u0dda\u0dda\u0d9c\u0dd3 \u0db8\u0dc4\u0dcf\u0dcf \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dda\u024f \u0db0\u0dcf\u0dcf\u0dc0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb\u0dad\u0dd4\u0dbb \u0daf\u0dd3. 8\u0d89 \u0dc0\u0db1 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0d9c\u0dba\u0dda\u024f \u0db1\u0dd2\u0dc1\u0dca\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc0\u0dbb\u0dca\u0d9c\u0dba\u0dda\u024f \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0d86\u0dc3\u0db1 \u0db4\u0da7\u0dd2\u0dba\u0d9a