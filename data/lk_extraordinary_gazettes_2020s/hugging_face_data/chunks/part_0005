u0bb2\u0bc1\u0baa\u0bcd\u0baa\u0bc6\u0bc6\u0bb1\u0bc1\u0bae\u0bcd.\n\n\u0baa\u0b95\u0bbf\u0bbf\u0bb0\u0b99\u0bcd\u0b95 \u0b9a\u0bc7\u0bc7\u0bb5\u0bc8\u0bc8 \u0b86\u0ba3\ufffd\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0ba3\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bae\u0bc8\u0bc8\u0baf,\n\n\u0b9f\u0baa\u0bcd\u0bb3\u0bbf\u0bbf\u0baf\u0bc2.\u0b8e\u0b9a\u0bcd.\u0b8e\u0bae\u0bcd.\u0b8e\u0bae\u0bcd.\u0b9a\u0bc0.\u0b95\u0bc7\u0bc7.\u0ba4\u0baf\u0bbe\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9 \u0b9f\u0baa\u0bcd\u0bb3\u0bbf\u0bbf\u0baf\u0bc2.\u0b8e\u0b9a\u0bcd.\u0b8e\u0bae\u0bcd.\u0b8e\u0bae\u0bcd.\u0b9a\u0bc0.\u0b95\u0bc7\u0bc7.\u0ba4\u0baf\u0bbe\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9 \u0b9a\u0bc6\u0bc6\u0baf\u0bb2\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd, \u0baa\u0b95\u0bbf\u0bbf\u0bb0\u0b99\u0bcd\u0b95 \u0b9a\u0bc7\u0bc7\u0bb5\u0bc8\u0bc8 \u0b86\u0ba3\ufffd\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1.\n\n2025, \u0b9a\u0bc6\u0bc6\u0ba4\u0bcd\u0ba4\u0bc6\u0bc6\u0bae\u0bcd\u0baa\u0bb0\u0bcd 08.\n\n\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0bbf\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0bbf I\n\n\u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 01 - 2016 \u0bae\u0bbe\u0bbe\u0b9a\u0bcd\u0b9a\u0bc1 \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 01 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 1956/16 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b85\u0ba4\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0b9a\u0bc7\u0bc7\u0b9f \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0baa\u0bcd \u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0b95\u0bc8\u0bc8\n\n\u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 02 - 2019 \u0b9a\u0bc6\u0bc6\u0ba4\u0bcd\u0ba4\u0bc6\u0bc6\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 16 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 2141/