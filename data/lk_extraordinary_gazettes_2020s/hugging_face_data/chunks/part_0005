e\u0bcd\u0bae\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1\u0b95\u0bb3\u0bc8\u0bc8\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bbf\u0bb5\u0bc1\u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0bb5\u0bbf\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0bae\u0bc1\u0bb1\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb1\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0ba3\u0bae\u0bcd\n\n\u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd I\u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd II \u0bb5\u0b95\u0bc8\u0bc8\n\n\u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd III\u0b95\u0b9f\u0bcd\u0b9f\u0ba3\u0bae\u0bcd (\u0b90.\u0b85.\u0b9f\ufffd\u0bca\u0bb2\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9a\u0bcd \u0b9a\u0bae\u0bae\u0bbe\u0bbe\u0ba9 \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0bb0\u0bc2\u0baa\u0bbe\u0bbe)\n\n1\u0baa\u0bc1\u0ba4\u0bbf\u0bbf\u0baf \u0bae\u0bc2\u0bb2\u0b95\u0bcd\u0b95\u0bc2\u0bb1\u0bc1 (\u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bb0\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0bb0\u0b9a\u0bbe\u0bbe\u0baf\u0ba9\u0b95\u0bcd \u0b95\u0bb2\u0bb5\u0bc8\u0bc8\u0baf\ufffd\u0bca\u0ba9\u0bcd\u0bb1\u0bbf\u0bbf\u0ba9\u0bcd \u0b92\u0bb0\u0bc1 \u0baa\u0bc1\u0ba4\u0bbf\u0bbf\u0baf \u0b89\u0baa\u0bcd\u0baa\u0bc1, \u0b93\u0bb0\u0bcd \u0b8e\u0bb8\u0bcd\u0ba4\u0bb0\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bc1\u0baa\u0bcd\u0baa\ufffd\u0bca\u0bb0\u0bc1\u0bb3\u0bcd \u0b89\u0b9f\u0bcd\u0baa\u0b9f, \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd \u0baa\u0ba4\u0bbf\u0bbf\u0bb5\u0bc1\u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0bb0\ufffd\u0ba4 \u0b93\u0bb0\u0bcd \u0b87\u0bb0\u0b9a\u0bbe\u0bbe\u0baf\u0ba9\u0b95\u0bcd \u0b95\u0bb2\u0bb5\u0bc8\u0bc8)\n\n\u0baa\u0bbe\u0bbe\u0b95\u0bae\u0bcd \u0baa\u0bbe\u0bbe\u0b95\u0bae\u0bcd 1 \u0bae\u0bc2\u0bb2\u0b95\u0bcd\u0b95\u0bc2\u0bb1\u0bcd\u0bb1\u0bbf\u0bbf\u0ba9\u0bcd\u0bae\u0bc0\u0ba4\u0bc1 \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0bae\u0bc1\u0b9f\u0bbf\u0baa\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0bb5\u0bbf\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0bae\u0bcd(\u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0bae\u0bc1\u0bb1\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0bae\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd)\n\n$ 500\n\n\u0baa\u0bbe\u0bbe\u0b95\u0bae\u0bcd \u0baa\u0bbe\u0bbe\u0b95\u0bae\u0bcd 2 \u0bae\u0ba4\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bc1 (\u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b95\ufffd\u0bca\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bbf\u0ba9\u0bcd)$ 1,500\n\n2\u0baa\u0bc1\u0ba4\u0bbf\u0bbf\u0baf \u0b85\u0bb3\u0bb5\u0bbf\u0bbf\u0bb2\u0bbe\u0bbe\u0ba9 \u0bae\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0b9f\u0bbf\u0bb5\u0bae\u0bcd(\u0b95\u0bbf\u0bbf\u0b9f\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0baa\u0ba4\u0bbf\u0bbf\u0bb5\u0bc1\u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0b9f\u0bbf\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bb5\u0bbf\u0bbf\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0baa\u0ba4\u0bbf\u0bbf\u0bb5\u0bc1\u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b92\u0bb0\u0bc1 \u0bae\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b8f\u0ba4\u0bc7\u0bc7\u0ba9\u0bc1\u0bae\u0bcd \u0baa\ufffd\u0bcc\u0ba4\u0bbf\u0bbf\u0b95 \u0bb5\u0b9f\u0bbf\u0bb5\u0bae\u0bcd)\n\n$ 1,000\n\n3\u0baa\u0bc1\u0ba4\u0bbf\u0bbf\u0baf \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0baf\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc1(\u0b92\u0bb0\u0bc1 \u0baa\u0bc1\u0ba4\u0bbf\u0bbf\u0baf \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd \u0ba4\u0baf\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc