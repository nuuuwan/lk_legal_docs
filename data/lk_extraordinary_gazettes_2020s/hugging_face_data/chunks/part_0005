    "chunk_text": "\u023e\u0dbd\u0d9f\u0da7 \u0dd9\u0db8\u0db8 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a\u0dd9\u0118 \u0d89\u0dc4\u0dad \u00fc \u0d89\u0262\u0264\u023c \u0dd9\u0daf\u0d9a \u0dc4\u0dcf \u0dc3\u023c\u0db6\u01e6\u0db0\u0dc0 \u0d87\u01af \u026a\u0279\u0dcf\u0db8 \u0dba\u0dcf\u0db8\u0da7 \u0d86\u0dc3\u01e6\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a\u0dba\u00fd \u026a\u0286\u01e6 441/2017 \u0da0\u0100\u0dd9\u0262\u0d9b\u0dba \u0db4\u025c\u01ce \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb \u0d87\u01af \u0db4\u0dd0 -8 \u0daf\u0dbb\u0db1 \u01d0\u00fa \u0d9c\u0dd0\u0db1\u026a\u0262\u0dbd \u0dc3\u0db3\u0dc4\u01e6 \u0263\u0218\u0dba \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0d9a\u0dcf\u0dbd\u0dba\u00fa \u01b1\u0dc5 \u00fb\u0286\u01d0 \u021d\u01af\u0da0\u0dcf\u0dbb\u0dba\u00fa \u0dd9\u0db1\u0dcf\u0daf\u0dd0\u00fa\u026b\u0db8 \u0218\u0298\u0db6\u0db3\u0dc0 \u0dc3\u0dbd\u0d9a\u0dcf \u0db6\u0dd0\u0263\u0dba \u0252\u01b1\u0dc0 \u0d87\u0dad. \u0db4\u0dd0-8 \u028f \u0dc3\u0db3\u0dc4\u01e6 \u01d0\u00fa \u0d9c\u0dd0\u0db1\u026a\u0262\u0dbd 2018-07-04 \u0dc0\u0db1 \u01ce\u0db1 441/2017 \u0da0\u0100\u0dd9\u0262\u0d9b\u0dba\u0da7 \u0d85\u01e9\u0dc0 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a \u0286\u01d0\u0d9a\u0dbb \u0d87\u01af \u0db6\u0dc0 \u0db4\u0dd0-8 \u0db4\u025d\u00fa\u0dc2\u0dcf \u00fb\u025d\u0dd9\u023c \u01cf \u0dd9\u0db4\u01e8 \u0dba\u0250.\n\n\u0dd9\u0db8\u0db8 \u0db4\u0dd0-8 \u0daf\u0dbb\u0db1 \u0263\u0218\u0dd9\u0dba\u01e6 \u0286\u0dba \u01d0\u00fa\u0d9c\u0dd0\u0db1\u026a\u0262\u0dbd\u00fa \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u023d\u01e6 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a \u0dad\u0db8\u0dcf\u0dd9\u0118 \u021d\u0dc1\u0dca\u0db1\u0dba\u0d9a\u0da7 \u0218\u0298\u01b1\u0dbb\u00fa \u0db1\u0dd0\u01af \u0db1\u023c \u026a\u0dc3\u01ff\u0db8\u00fa \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8\u0da7 \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf \u0d9a\u0dbb\u0db1 \u0dbd\u01d0\u0dc0 \u0d8a\u0da7 \u0d8b\u01ae\u0dc3\u0dcf\u0dc4 \u0daf\u0dbb\u0dcf \u0d87\u0dad \u0db6\u0dc0\u01ae, \u0dd9\u0db4\u01e8 \u0dba\u0250. \u0d94\u0291 \u026a\u0279\u0dcf\u0db8 \u0dba\u0dcf\u0db8\u0da7 \u0d86\u0dc3\u01e6\u0db1\u0dc0 \u026a\u0279\u0dcf\u0db8 \u0dba\u0dcf\u0db8\u0da7 \u0dd9\u0db4\u0dbb \u0dd9\u0dc3\u0dca\u0dc0\u0d9a\u0dba\u00fd \u0dd9\u0dbd\u0dc3 \u0286\u0179\u0dba\u01cf\u0db8 \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb \u0d87\u01af \u01d0\u00fa\u0d9c\u0dd0\u0db1\u026a\u0262\u0dbd 441/2017 \u0da0\u0100\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f \u0d85\u0dbb\u023f\u0dab \u0dc4\u0dcf \u0dc3\u023c\u0db4\u0dcf\u0dad \u0dd9\u0269. \u0dd9\u0dc3\u0dca\u0dc0\u0d9a\u0250\u01e6 \u0dc4\u0dcf \u0dd9\u0dc3\u0dca\u0dc0\u0dcf \u0dd9\u0dba\u0dcf\u0dca\u0da2\u0d9a \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba \u0d85\u0dad\u0dbb \u0dc0\u0da9\u0dcf \u0dba\u0dc4\u0db4\u01ae \u0dad\u01ae\u01ae\u0dc0\u0dba\u00fa \u01e7\u0259\u0db8\u0dcf\u0dab\u0dba \u00fb\u025d\u0db8\u0da7\u01ae \u0d89\u01e6 \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dd9\u024f\u0db8 \u0d9c\u025e\u01ae\u0dc0\u0dba\u0da7 \u0dc0\u0da7\u0218\u0da7\u0dcf\u0dc0\u00fa \u0dc3\u0dd0\u0dbd\u0287\u0db8 \u0286\u01d0 \u00fb\u025d\u0db8\u00fa \u0d91\u028f \u0d85\u0dbb\u023f\u0dab \u0db6\u0dc0 \u0d92 \u0da0\u0100\u0dd9\u0262\u0d9b\u0dba \u0db4\u025d\u00fa\u0dc2\u0dcf \u00fb\u025d\u0dd9\u023c \u01cf \u0dd9\u0db4\u01e8 \u0dba\u0250. \u0d91\u0dd9\u0dc3\u0dca \u026c\u0dc0\u0daf \u0dd9\u0db8\u0db8 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a 2018.07.04 \u0dc0\u0db1 \u01ce\u0db1 \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u01d0\u00fa \u0d9c\u0dd0\u0db1\u026a\u0262\u0dbd\u0da7 2018.07.17 \u0dc0\u0db1 \u01ce\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a \u026a\u0279\u0dcf\u0db8 \u0dba\u0db1 \u0dd9\u0dad\u00fa \u00fd\u0db8\u0db1 \u0dd9\u0dc4\u0dcf\u0dca \u0218\u0298\u01b1\u0dbb\u00fa \u0dc3\u0db4\u0dba\u0dcf \u0db1\u0dd0\u0dad. 2017.07.04 \u0dc0\u0db1 \u01ce\u0db1 \u01d0\u00fa\u0d9c\u0dd0\u0db1\u026a\u0262\u0dbd\u00fa \u0dd9\u0dbd\u0dc3 \u0dba\u0dc0\u0db1 \u0dbd\u0daf \u0263\u0218\u0dba\u0da7 \u0218\u0298\u01b1\u0dbb\u00fa \u0dc3\u0db4\u0dba\u01e9 \u0dbd\u0db6\u01e6\u0dd9\u01e6 2022.10.28 \u0dc0\u0db1 \u01ce\u0db1 \u0dd9\u0229\u025e\u023c\u0d9a\u0dbb\u0dab \u0db4\u025d\u00fa\u0dc2\u0dcf, \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 \u01cf \u0db4\u0dd0 -9 \u0dd9\u0dbd\u0dc3 \u0dbd\u00fd\u019f \u0d9a\u0dc5 \u0dd9\u0262\u0d9b\u0db1\u0dba \u0db8\u0119\u01e7. \u0d91\u0db8\u0119\u01e6 \u0dd9\u0db8\u0db8 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a \u0db4\u0dd0-8 \u0daf\u0dbb\u0db1 \u01d0\u00fa\u0d9c\u0dd0\u0db1\u026a\u0262\u0dbd \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb \u0d87\u01af \u0db6\u0dc0 \u0daf, \u0dad\u0dc4\u026c\u025e \u0dd9\u0269. \u0d89\u0262\u0265\u023c\u0d9a\u025e \u0dd9\u0dc3\u0dca\u0dc0\u0d9a \u0dad\u01ae\u01ae\u0dc0\u0dd9\u024f \u0286\u0179\u023d\u01e6 \u026a\u0279\u0dcf\u0db8 \u0dba\u0dcf\u0db8\u0da7 \u0dc3\u01af \u0dd9\u0daf\u0d9a\u0d9a\u0da7 \u0db4\u0db8\u0dab \u0dd9\u0db4\u0dbb \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dc5 \u01d0\u00fa\u0d9c\u0dd0\u0db1\u026a\u0262\u0dbd \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u021d\u01af\u0da0\u0dcf\u0dbb \u0daf\u0dd0\u00fa\u026b\u0db8\u0da7 \u0d85\u026c\u025e\u01d0 05 \u0db8\u0dcf\u0dc3 03 \u0d9a \u0d9a\u0dcf\u0dbd\u0dba\u00fa \u0d9c\u0dad \u026b\u0db8 \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u021d\u01af\u0da0\u0dcf\u0dbb \u0daf\u0dd0\u00fa\u026b\u0db8\u00fa \u0dd9\u0dbd\u0dc3 \u0dc3\u0dd0\u0dbd\u00fb\u0dba \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u0d9a. 441/2017 \u0da0\u0100\u0dd9\u0262\u0d9b\u0dba \u0db8\u0119\u01e6 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a\u0da7 \u01cf \u0d87\u01af \u0d85\u0250\u01af\u0dba \u0d85\u01e9\u0dc0 \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db4\u0dd0-8 \u0dc3\u0db3\u0dc4\u01e6 \u01d0\u00fa\u0d9c\u0dd0\u0db1\u026a\u0262\u0dbd \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d9a\u0da7\u0252\u01b1 \u0d9a\u0dbb \u021d\u01af\u0da0\u0dcf\u0dbb \u0dd9\u0db1\u0dcf\u0daf\u0dd0\u00fa\u026b\u0db8 \u0db8\u0119\u01e6 \u0d91\u0dc0\u0d9a\u0da7 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a\u0dba\u00fd\u0dc0 \u0286\u0179 \u0d89\u0262\u0265\u023c\u0d9a\u025e\u0da7 \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0286\u01d0 \u026b \u0d87\u01af \u0db6\u0dc0 \u01b0\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u023d.\n\n\u0d92 \u0d85\u01e9\u0dc0 \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u026a\u0dc3\u01fd\u0dba \u0252\u01b1 \u021d\u0dc1\u0dca\u0db1 \u0dc0\u0dbd\u0da7 \u0dd9\u0db8\u0dd9\u0dc3\u0dca \u0218\u0298\u01b1\u025e \u0dc3\u0db4\u0dba\u023d.\n\n01. \u026a\u0dc3\u01fd\u0dba \u0252\u01b1 \u021d\u0dc1\u0dca\u0db1\u0dba - \u0db1\u0dd0\u0dad02. \u026a\u0dc3\u01fd\u0dba \u0252\u01b1 \u021d\u0dc1\u0dca\u0db1\u0dba - \u0db1\u0dd0\u0dad03. \u026a\u0dc3\u01fd\u0dba \u0252\u01b1 \u021d\u0dc1\u0dca\u0db1\u0dba - \u0d94\u026904. \u026a\u0dc3\u01fd\u0dba \u0252\u01b1 \u021d\u0dc1\u0dca\u0db1\u0dba - \u0d94\u026905. \u026a\u0dc3\u01fd\u0dba \u0252\u01b1 \u021d\u0dc1\u0dca\u0db1\u0dba - \u0d94\u0269\n\n\u0d92 \u0d86\u0d9a\u0dcf\u0dbb\u0dd9\u0dba\u01e6 01. 02 \u0dba\u0db1 \u026a\u0dc3\u01fd\u0dba \u0252\u01b1 \u021d\u0dc1\u0dca\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0dcf\u0dd9\u0dba\u0dcf\u0dca\u0da2\u0d9a \u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dd9\u024f \u0dc0\u0dcf\u0286\u0dba\u0da7 \u01b0\u01e6\u01d0 \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dbb 03, 04. 05 \u0dba\u0db1 \u026a\u0dc3\u01fd\u0dba \u0252\u01b1 \u021d\u0dc1\u0dca\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a\u0dd9\u0118 \u0dc0\u0dcf\u0286\u0dba\u0da7 \u01b0\u01e6\u01d0 \u0d9a\u0dbb\u023d.\n\n\u0dd9\u023c \u0d85\u01e9\u0dc0 03. 04. 05 \u0dba\u0db1 \u026a\u0dc3\u01fd\u0dba \u0252\u01b1 \u021d\u0dc1\u0dca\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a\u0dd9\u0118 \u0dc0\u0dcf\u0286\u0dba\u0da7 \u01b0\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dbb, \u0dd9\u0dc3\u0dca\u0dc0\u0d9a\u0da7 \u0dc3\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0286\u0dba \u0252\u01b1 \u0db6\u0dc0\u0da7\u01ae \u01b0\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u023d. \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc3\u0dca\u0dc0\u0dcf\u0dd9\u0dba\u0dcf\u0dca\u0da2\u0d9a\u0dd9\u0118 \u0dc0\u0d9c\u00fc\u0db8 \u0240\u0dbd\u0255\u0db8\u0dba \u0dad\u00fa\u0dd9\u0dc3\u0dca\u025e\u0dc0\u0d9a\u0da7 \u0dbd\u00fa\u0d9a\u0dbb\u023d. \u0d92 \u0d85\u01e9\u0dc0 \u025e.100,000/- \u0d9a \u0dc0\u01e6\u01ce \u021d\u0daf\u0dcf\u0db1\u0dba\u00fa \u0dd9\u0dbd\u0dc3 \u0dd9\u0dc3\u0dca\u0dc0\u0dcf\u0dd9\u0dba\u0dcf\u0dca\u0da2\u0d9a \u0db4\u00fa\u0dc2\u0dba \u026a\u0286\u01e6 \u0dd9\u0dc3\u0dca\u0dc0\u0d9a\u0da7 \u0dd9\u0db8\u0db8 \u021d\u0daf\u0dcf\u0db1\u0dba \u0d9c\u0dd0\u0dc3\u0178\u0db4\u01b4\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u026b \u0dc3\u01af \u0dd9\u0daf\u0d9a\u00fa \u0d87\u01b1\u0dc5\u0dad \u0daf\u00fd\u019f \u0dd9\u0d9a\u0dcf\u0dc5\u0db9 \u01ce\u0dc3\u0dca\u01b5\u00fa \u0d9a\u023c\u0d9a\u025e \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dd9\u024f \u0dc3\u0dc4\u0d9a\u0dcf\u0dbb \u0d9a\u023c\u0d9a\u025e \u0dd9\u0d9a\u0dcf\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0dd9\u0dc0\u0dad \u0dad\u0dd0\u01e6\u0db4\u01ae \u00fb\u025d\u0db8\u0da7 \u01e7\u0dd9\u0dba\u0dcf\u0dca\u0d9c \u0d9a\u0dbb\u023d.\n\n\u0dd9\u0db8\u0dba \u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab \u0dc4\u0dcf \u0252\u00fa\u01af \u0dc3\u0dc4\u0d9c\u0dad \u01b0\u0dbb\u0dab\u0dba\u00fa \u0db6\u0dc0\u0da7 \u0daf \u0dc0\u0dd0\u018b\u01d0\u0dbb\u0da7\u01ae \u021d\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u023d."
