    ],
    "text": "\u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013--\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 \u0dc0\u0dd2\u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u0ddd \u0db4\u0dad \u0d85\u0d82\u0d9a\u0dba \u0d89\u0db1\u0dca\u0dd9\u0da2\u0db1\u0dca\u0dc2\u0db1\u0dca \u0dad\u0dc4\u0db1\u0db8\u0dca \u0dd9\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0dc4 \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd\u0dad\u0dca\u0dc0\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dd9\u0d9c\u0dca/\u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dd9\u0dba\u0dca \u0d85\u0dd9\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dcf\u0dd9\u0dc0\u0db1\u0dca \u0d87\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dd9\u0dc3\u0dda \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db1\u0db8/\u0db1\u0db8\u0dca \u0dc3\u0dc4 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u0dc4\u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dc4 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dca \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u0db4\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1:3 0.0050 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 02 \u0dc4\u0dcf 04 \u0da7 \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0db8\u0da7 \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf \u0d9a\u0dbb\u0dba\u0dd2 1:7 0.0015 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0d9a\u0dcf\u0dab\u0dd4\u0dc0 1:18 0.0150 \u0dd9\u0db8\u0ddc\u0dc4\u0db8\u0da9\u0dca \u0db8\u0dd4\u0db8\u0dca\u0dad\u0dcf\u0dc3\u0dca \u0dd9\u0db8\u0ddc\u0dc4\u0db8\u0da9\u0dca \u0db8\u0dd4\u0da2\u0dd3\u0db6\u0dca 972123528V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 _ \u0d85\u0d9f\u0dd4\u0dbb\u0dd4\u0dc0\u0dd0\u0dbd\u0dca\u0dbd, \u0dc3\u0dd3/23/2/1, \u0db1\u0dc0 \u0d8b\u0daf\u0dcf\u0db1 \u0db8\u0dcf\u0dc0\u0dad, \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd 1:19 0.0220 \u0dd9\u0db8\u0ddc\u0dc4\u0db8\u0da9\u0dca \u0db8\u0dc0\u0dca\u0dbb\u0dd4\u0dc6\u0dca \u0dc3\u0dd2\u0dad\u0dca\u0dad\u0dd2 \u0db1\u0dc3\u0dd6\u0dc4\u0dcf 685652692V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 _ 260/281, \u0d85\u0d9f\u0dd4\u0dbb\u0dd4\u0dc0\u0dd0\u0dbd\u0dca\u0dbd, \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd 1:36 0.0380 \u0dc3\u0dd3\u0db1\u0dd2\u0db8\u0dd4\u0dc4\u0db8\u0dca\u0db8\u0daf\u0dd4 \u0db8\u0dc3\u0dd3\u0d9a\u0dcf 646681600V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 _ 260/28\u0da2\u0dd3, \u0d85\u0d9f\u0dd4\u0dbb\u0dd4\u0dc0\u0dd0\u0dbd\u0dca\u0dbd, \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd 1:44 0.0423 \u0d9a\u0d82\u0d9a\u0dcf\u0db1\u0db8\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d85\u0db8\u0dd2\u0dad\u0dca \u0dd9\u0dc4\u0dda\u0db8\u0db1\u0dca\u0dad 198033202392 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 40 \u0dc4\u0dd2 \u2013 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0da2\u0dba\u0dd9\u0dc3\u0dda\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf \u0dc3\u0dd3 126/2, \u0d9a\u0dbb\u0dc0\u0dca\u0dd9\u0daf\u0dab\u0dd2\u0dba, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd 1:48 0.0343 \u0d89\u0daf\u0dca\u0daf\u0db8\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba\u0dd9\u0d9c\u0dca \u0dd9\u0db4\u0dca\u0db8\u0dc3\u0dd2\u0dbb\u0dd2 663661760V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 _ \u0dc3\u0dd3 165, \u0d9a\u0dbb\u0dc0\u0dca\u0dd9\u0daf\u0dab\u0dd2\u0dba, \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd 1:49 0.0691 \u0dc3\u0db1\u0dca\u0daf \u0db8\u0db1\u0db1\u0dca\u0db1\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc0\u0dd2\u0da2\u0dd2\u0dad 713243736V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 _ \u0d9a\u0dbb\u0dc0\u0dca\u0dd9\u0daf\u0dab\u0dd2\u0dba, \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd 1:61 0.2131 \u0d85\u0dad\u0dd4\u0dd9\u0d9a\u0ddd\u0dbb\u0dbd\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d85\u0db8\u0dd2\u0db1\u0dca\u0daf \u0db0\u0db8\u0dca\u0db8\u0dd2\u0d9a 197417502328 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 60 \u0dc4\u0dd2 \u0d85\u0dad\u0dd4\u0dd9\u0d9a\u0ddd\u0dbb\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf _ 246/6, \u0d86\u0db1\u0db1\u0dca\u0daf \u0d85\u0dad\u0dd4\u0dd9\u0d9a\u0ddd\u0dbb\u0dbd \u0db8\u0dcf\u0dc0\u0dad, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0d85\u0d9f\u0dd4\u0dbb\u0dd4\u0dc0\u0dd0\u0dbd\u0dca\u0dbd, \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd 1:76 0.0393 \u0db8\u0dd4\u0dbd\u0dca\u0dbd\u0dba\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc3\u0dd4\u0db0\u0dd3\u0dbb \u0dd9\u0d9a\u0dde\u0dc1\u0dbd\u0255 197835303049 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 78 \u0dc4\u0dd2 \u0dc3\u0db8\u0dbb\u0dad\u0dd4\u0d82\u0d9c \u0d85\u0d9c\u0dbd \u0dc4\u0dcf _ 234/20, \u0d85\u0d9f\u0dd4\u0dbb\u0dd4\u0dc0\u0dd0\u0dbd\u0dca\u0dbd, \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 75 \u0dc4\u0dd2 \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c 1:77 0.0569 \u0db8\u0dd4\u0dbd\u0dca\u0dbd\u0dba\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d91\u0dbb\u0d82\u0d9c \u0dbd\u0d9a\u0dca\u0db8\u0dcf\u0dbd\u0dca 813424290V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 78 \u0dc4\u0dd2 \u0dc3\u0db8\u0dbb\u0dad\u0dd4\u0d82\u0d9c \u0d85\u0d9c\u0dbd \u0dc4\u0dcf _ 234/20, \u0d85\u0d9f\u0dd4\u0dbb\u0dd4\u0dc0\u0dd0\u0dbd\u0dca\u0dbd, \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 75 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c 1:85 0.0504 \u0d89\u0dbd\u0dca\u0dc0\u0dcf\u0db1 \u0dc0\u0dd2\u0daf\u0dcf\u0db1\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0daf\u0db8\u0dd2\u0dad \u0da2\u0dd3\u0dc0\u0db1\u0dca 197935503536 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 87 \u0dc4\u0dd2 \u2013 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0dc4 \u0dc3\u0dd3 43 \u0d92, \u0d9a\u0dbb\u0dc0\u0dca\u0dd9\u0daf\u0dab\u0dd2\u0dba, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c 1:114 0.0951 \u0db8\u0dd4\u0dbd\u0dca\u0dbd\u0dba\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d85\u0dc3\u0d82\u0d9a \u0dc3\u0dd4\u0dbb\u0d82\u0da2\u0dd2\u0dad\u0dca 843500897V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 78 \u2013 \u0dc3\u0db8\u0dbb\u0dad\u0dd4\u0d82\u0d9c \u0d85\u0d9c\u0dd9\u0dbd\u0dc4\u0dd2 \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf \u0d85\u0d82\u0d9a 234/20, \u0d85\u0d9f\u0dd4\u0dbb\u0dd4\u0dc0\u0dd0\u0dbd\u0dca\u0dbd, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd 1:118 0.0082 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u2013 \u0d85\u0da9\u0dd2\u0db4\u0dcf\u0dbb 1:124 0.0664 \u0dd9\u0dc3\u0db1\u0dbb\u0dad\u0dca \u0db4\u0dad\u0dd2\u0dbb\u0dd9\u0d9c\u0dca \u0d8b\u0dd9\u0db8\u0dca\u0dc2\u0dca \u0dd9\u0dad\u0dca\u0db