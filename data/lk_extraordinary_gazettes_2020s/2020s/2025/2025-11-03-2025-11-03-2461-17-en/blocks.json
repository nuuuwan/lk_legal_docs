    "bbox": [
      307.15,
      452.15,
      549.68,
      512.22
    ],
    "text": "01. Lot \u2018A\u2019 \u2013 Godadenikanda \u2013 Extent: 2.7976 Hectares North and East: Road and Godadenikanda (Keranketiya) Watta claimed by Land Reforms Commission; South: Road (Pradeshiya Sabha); West: Road (Pradeshiya Sabha) and Road.",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
