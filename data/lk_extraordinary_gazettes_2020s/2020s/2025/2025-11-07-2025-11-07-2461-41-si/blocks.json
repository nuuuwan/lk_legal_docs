    "text": "\u0d95\u0db1\u0dd1\u0db8 \u0db4\u025c\u0279\u0dba\u0d9a \u0db8\u0dcf\u0286\u0d9a \u0da2\u0dbd \u0d9c\u0dcf\u0dc3\u0dca\u01b1\u0dc0\u0da7, \u0db4\u025c\u0dc4\u0dbb\u0dab\u00ab\u0d9c\u0dcf\u0dc3\u0dca\u01b1\u0dc0, \u0db8\u0dcf\u0286\u0d9a \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u0d9c\u0dcf\u0dc3\u0dca\u01b1\u0dc0, \u0d85\u01e7\u00fd\u01ae \u0d9c\u0dcf\u0dc3\u0dca\u01b1 \u0dc3\u0dc4 \u0d85\u0daf\u0dcf\u0dc5 \u0db6\u01d0 \u0d87\u01b1\u0dc5\u01ae \u0dd9\u0269. \u0da2\u0dbd \u022a\u0262\u0db4\u0dd9\u0dad\u028f \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0255\u0dd9\u0dba\u01e6 \u0dc3\u023c\u021b\u0259\u0dab \u0db8\u0dcf\u0286\u0d9a \u0da2\u0dbd \u0d9c\u0dcf\u0dc3\u0dca\u01b1\u0dc0 \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0d95\u0db1\u0dd1\u0db8 \u0db4\u0dcf\u025c\u0dd9\u0db7\u02a4\u0119\u0d9a\u0dba\u00fd\u0da7 \u0dad\u0db8 \u0da2\u0dbd \u022a\u0262\u0db4\u0dad\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0d91\u0d9a\u01b1\u0d9a\u0dc5 \u0d85\u0d9c\u0dba \u0db8\u0dad \u0db6\u01d0 \u0d89\u01e6\u0dd9\u0dc0\u02a3\u0250\u0286\u0dba\u00fa \u0d85\u0dc0\u0dc1\u0255 \u0dd9\u0269 \u0db1\u023c. \u0da2\u0dcf\u01af\u0d9a \u0da2\u0dbd \u0dc3\u023c\u0db4\u0dcf\u0daf\u0db1 \u0dc4\u0dcf \u0da2\u0dbd\u0dcf\u0db4\u0dc0\u0dc4\u0db1 \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u021b\u0259\u0dc0 \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u026b \u0d91\u0dba \u0dbd\u0db6\u0dcf \u0d9c\u0dad \u0dc4\u0dd0\u0d9a.",
