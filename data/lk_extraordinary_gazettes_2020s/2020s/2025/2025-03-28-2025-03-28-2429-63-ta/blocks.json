b5\u0732\u0ba4\u0bcd\u0ba4\u0bb2\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0732\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bc1 \u0736\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0b9f\u0737\u0bae\u0bb2\u0bcd \u0bae\u0731\u0b95\u0731\u0ba3\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd, \u0b95\u0bc1\u0bb0\u0bc1\u0723\u0731\u0b95\u0bb2\u0bcd \u0bae\u0731\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd, \u0b8e\u0736\u0730\u0b9f\u0bc1\u0736\u0bb5\u0bb5 \u0baa\u0732\u0bb0\u0737\u0ba4\u0b9a \u0736\u0b9a\u0baf\u0bb2\u0731\u0bb3\u0bb0\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0bb2\u0bcd, \u0b87\u0bb2. 112 - \u0b8e\u0736\u0730\u0b9f\u0bc1\u0736\u0bb5\u0bb5 \u0b95\u0732\u0bb0\u0731\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bc1\u0bb3\u0bcd \u0bb5\u0732\u0b95\u0731\u0736\u0ba4\u0ba9\u0732\u0b95\u0bae \u0b95\u0732\u0bb0\u0731\u0bae\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0b85\u0738\u0bae\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0bae\u0bcd 420663 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb0\u0bb2\u0bcd \u0b85\u0bb3\u0738\u0bb5 \u0bb5\u0738\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0bc1 \u0b87\u0bb2. 01 \u0b87\u0bb2\u0bcd \u0b85\u0b9f\u0b99\u0bcd\u0b95\u0732\u0baf\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0bae\u0731\u0ba9 1 : 32, 1 : 33, 1 : 34, 1 : 35, 1 : 36, 1 : 37, 1 : 38, 1 : 39, 1 : 40, 1 : 41, 1 : 43, 1 : 44, 1 : 45, 1 : 46, 1 : 48, 1 : 49, 1 : 50, 1 : 51 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 1 : 53 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b99\u0bcd \u0b95\u0738\u0bb3\u0b95\u0bcd \u0736\u0b95\u0731\u0ba3\u0bcd\u0b9f \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0731\u0ba9 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0736\u0ba4\u0731\u0b9f\u0bb0\u0bcd\u0baa\u0731\u0b95 \u0b87\u0ba4\u0737\u0ba9\u0731\u0b9f\u0bc1 \u0b87\u0738\u0ba3\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0738\u0ba3\u0baf\u0732\u0bb2\u0bcd \u0ba4\u0bb0\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0bb5\u0731\u0bb1\u0731\u0ba9 \u0b8e\u0ba9\u0ba4\u0bc1 \u0ba4\u0733\u0bb0\u0bcd\u0bae\u0731\u0ba9\u0ba4\u0bcd\u0738\u0ba4 \u0b87\u0ba4\u0bcd\u0ba4\u0731\u0bb2\u0bcd \u0736\u0bb5\u0bb3\u0732\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0732\u0ba9\u0bcd\u0737\u0bb1\u0ba9\u0bcd. \u0baa\u0bc0.\u0b9a\u0733.\u0b9f\u0bc0. \u0b9a\u0732\u0737\u0b95\u0bb0\u0731, \u0b95\u0731\u0ba3\u0732 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0723\u0732\u0bb0\u0bcd\u0ba3\u0baf \u0b86\u0738\u0ba3\u0baf\u0731\u0bb3\u0bb0\u0bcd \u0723\u0731\u0baf\u0b95\u0bae\u0bcd. \u0b95\u0731\u0ba3\u0732 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0723\u0732\u0bb0\u0bcd\u0ba3\u0baf\u0ba4\u0bcd \u0ba4\u0732\u0738\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0732\u0730\u0732\u0b95\u0ba4 \u0736\u0bae\u0ba4\u0bc1\u0bb0\u201d, \u0b87\u0bb0\u0b9c\u0bae\u0bb2\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4 \u0bb5\u0bc0\u0ba4\u0732, \u0baa\u0ba4\u0bcd\u0ba4\u0bb0\u0bae\u0bc1\u0bb2\u0bcd\u0738\u0bb2, 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0736\u0baa\u0baa\u0bcd\u0baa\u0bc1\u0bb0\u0bc1\u0bb5\u0731\u0732 \u0bae\u0731\u0ba4\u0bae\u0bcd 11 \u0b86\u0bae\u0bcd \u0ba4\u0732\u0b95\u0ba4\u0732.",
