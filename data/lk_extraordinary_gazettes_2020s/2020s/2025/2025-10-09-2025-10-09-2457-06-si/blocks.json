    "text": "1962 \u0d85\u0d82\u0d82\u0d9a 19 \u0daf\u0dbb\u0db1 \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0db8\u0dca \u0dc3\u0d82\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0db4\u0db1\u0dad\u0dda\u01ae 2 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u0dda\u024f \u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0dc0\u0db1 \u0db8\u0db8, 2025 \u0d94\u0d9a\u0dca\u0dad\u0ddd\ufffd\u0ddd\u02ea\u0db6\u0dbb\u0dca \u0db8\u0dc3 10 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7, \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0dc0\u0dd6 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dd9\ufffd\u0dc4\u0dd2 3 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dda\u0dda\u0dda \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db7\u0dcf\u0dcf\u0dab\u0dca\u0da9 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d91\u0d9a\u0dd3 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u0dda\u024f 5 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dda\u0dda\u0dda \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dca\u0dc0\u0dbd \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0db1\u0dca\u200d\u0dba\u0dba \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba\u0db1\u0dca \u0d85\u0db1\u0dd4\u0dc0 \u0dc4\u0ddd\ufffd\u0ddd\u02ea (235 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba \u0dc0\u0db1) \u0dbb\u0dda\u0dda\u0d9c\u0dd4 \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\u01ae \u2018\u0d85\u2019 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u0dda\u024f \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc0\u0dbb\u0dab\u0dd3\u0dba \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba\u0db1\u0dca \u0d85\u0dba\u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0db1 \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0d9c\u0dd9\ufffd\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0d9a \u0db1\u0db8\u0dca, \u0d91\u0d9a\u0dd3 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u0dda\u024f 4 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0dd9\u0dd9\u0dc4\u0dd2 \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dca\u0dc0\u0dbd \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc0\u0dbb\u0dab\u0dd3\u0dba \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba\u0db1\u0dca \u0d85\u0db1\u0dd4\u0dc0, \u0d86\u0db1\u0dba\u0db1 \u0dad\u0dd3\u0dbb\u0dd4 \u0d9c\u0dcf\u0dcf\u0dc3\u0dca\u0dca\u0dad\u0dd4 \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb \u0d85\u0dba\u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\u0da7 \u0dbb\u0dda\u0dda\u0d9c\u0dd4 \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca\u0da7 \u0db8\u0dd9\ufffd\u0db8 \u0d86\u0da5\u0dcf\u0dcf\u0dc0 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb\u0db8\u0dd2. \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dd