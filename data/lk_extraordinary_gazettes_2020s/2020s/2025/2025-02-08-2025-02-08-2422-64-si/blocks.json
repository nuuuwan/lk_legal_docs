    "text": "\u0d87\u0dad\u0dd2\u201d \u0dba\u0dbc\u0dc0 \u0dc0\u0d82\u0dba\u0dbe\u0ddd\u0db0\u0db1\u0dba \u0dc0\u0dd2\u0dba \u0dad\u0dd4\u0dad\u0dd4 \u0db6\u0dbd\u0dca , \u0d91\u0db8 \u0d9c\u0dd0\u0dc0\u0da7\u0dca \u0db3\u0dad\u0dca\u200d\u0dbb\u0dbd\u0dbc \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0d85\u0dba\u0db1\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0dd4\u0dd4 \u0dba\u0db1\u0ddc\u0dba\u0dbd\u0db1\u0dc0 \u0dbd \u0db6\u0dbc\u0db3\u0dbd\u0dca \u0db1\u0dcf \u0db6\u0dbd\u0dca \u0db8\u0dc1\u0da2\u0dcf\u0db1\u0dcf\u0dcf\u0dbd\u0da7 \u0d9a\u0dd0\u0db1 \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc0\u0db2\u0dc1\u0dcf \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0db1\u0dca\u0dd3\u0db0 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbc\u0dd0\u0dba\u0db6\u0dca. \u0dc1\u0dda.\u0dc0\u0dd3.\u0db4\u0dd3. \u0d85\u0dba\u0dd2\u0dbb\u0dcf\u0d82\u0d9c\u0db1\u0dd3, \u0dba\u0dca \u0d9a\u0db8\u0dca \u0dc1\u0dcf \u0db6\u0dbc\u0dcf\u0dbc, \u0d9a\u0dcf\u0dbb\u0dca\u0dba, \u0d9a\u0dbb\u0dca\u0dcf\u0dbd\u0dba, \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dca \u0db8\u0d9a \u0dba\u0dc0\u0db8\u0dda\u0dba\u0db8\u0dca \u0db1\u0dd2\u0dbc\u0db0\u0dcf\u0db8\u0dda, \u0dba\u0d9a\u0ddc\u0dba\u0dbc\u0ddc\u0dca\u0dad\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba \u0dba \u0dc0\u0dc0\u0dcf\u0dbd. 6365 \u0da2\u0dcf\u0db1\u0dbd\u0dcf\u0dbb\u0dd2 \u0db8\u0dc0 68 \u0dbd\u0dd0\u0db1\u0dd2 \u0db1\u0dd0\u0db1, \u0dba\u0d9a\u0ddc\u0dba\u0dbc\u0ddc\u0dca\u0dad\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba \u0dba \u0dc0\u0dc0\u0dcf\u0dbd, \u0dba\u0d9a\u0ddc\u0dba\u0dbc\u0ddc\u0dca\u0dad\u0db1 \u0daf\u0dd3 \u0dba.",
