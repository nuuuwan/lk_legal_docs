    "text": "\u0b95\u0ba3\u0bcd\u0b9f\u0bbf \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 - \u0baa\u0731\u0ba4\u0bcd\u0ba4\u0ba4\u0bc1\u0bae\u0bcd\u0baa\u0738\u0bb0 \u0b92\u0ba9\u0bcd\u0bb1\u0732\u0738\u0ba3\u0ba8\u0bcd\u0ba4 \u0ba8\u0733\u0bb0\u0bcd \u0bb5\u0732\u0ba8\u0732\u0737\u0baf\u0731\u0b95\u0ba4\u0bcd \u0ba4\u0732\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0bcd \u0b95\u0733\u0bb4\u0bcd \u0737\u0b95\u0731\u0ba9\u0732\u0736\u0b95\u0731\u0b9f \u0baa\u0bc2\u0bb8\u0bcd\u0b9f\u0bb0\u0bcd \u0baa\u0bae\u0bcd\u0baa\u0732\u0baf\u0738\u0bb1\u0baf\u0732\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0b85\u0ba4\u0bcd\u0ba4\u0bb0\u0b95\u0bae \u0baa\u0731\u0b9a\u0bb2\u0bcd \u0bae\u0731\u0bb5\u0ba4\u0bcd\u0738\u0ba4 \u0b8a\u0b9f\u0731\u0b95 \u0baa\u0bc2\u0b9c\u0731\u0baa\u0732\u0b9f\u0bbf\u0baf \u0737\u0b9a\u0738\u0bb5\u0ba4\u0bcd \u0ba4\u0b9f\u0731\u0b95\u0bae\u0bcd \u0bb5\u0738\u0bb0\u0baf\u0731\u0ba9 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bb2\u0bcd \u0b95\u0bc1\u0bb4\u0731\u0baf\u0bcd \u0b85\u0738\u0bae\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0731\u0b95 \u0737\u0bb5\u0ba3\u0bcd\u0b9f\u0bbf\u0baf\u0ba4\u0731\u0ba9 \u0b95\u0733\u0bb4\u0bcd\u0b95\u0bcd\u0b95\u0731\u0ba3\u0bc1\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0738\u0baf \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0736\u0b95\u0731\u0bb3\u0bcd\u0bb3 \u0b85\u0bb0\u0b9a\u0731\u0b9f\u0bcd\u0b9a\u0732 \u0baf\u0731\u0bb0\u0bcd \u0b8e\u0ba3\u0bcd\u0ba3\u0732\u0baf\u0732\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0732\u0bb1\u0731\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0738\u0ba4 1964 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 28 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0731\u0ba3\u0732 \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb1\u0bcd (\u0ba4\u0732\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd) \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0731\u0bb2\u0bcd \u0ba4\u0732\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bb5\u0731\u0bb1\u0731\u0ba9 \u0b95\u07