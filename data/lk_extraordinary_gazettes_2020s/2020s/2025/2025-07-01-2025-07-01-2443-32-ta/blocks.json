    "text": "\u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0736\u0b95\u0731\u0bb3\u0bcd\u0bb3\u0bb5\u0732\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0baf\u0732\u0ba9\u0bcd \u0bb5\u0732\u0baa\u0bb0\u0bae\u0bcd: \u0736\u0ba4\u0ba9\u0bcd \u0bae\u0731\u0b95\u0731\u0ba3\u0bae\u0bcd, \u0b85\u0bae\u0bcd\u0baa\u0731\u0ba8\u0bcd\u0737\u0ba4\u0731\u0b9f\u0bcd\u0738\u0b9f \u0bae\u0731\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0b85\u0b99\u0bcd\u0b95\u0bc1\u0ba9\u0736\u0b95\u0731\u0bb2\u0736\u0baa\u0bb2\u0bb8\u0bcd\u0bb8 \u0baa\u0732\u0bb0\u0737\u0ba4\u0b9a \u0736\u0b9a\u0baf\u0bb2\u0731\u0bb3\u0bb0\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0bb2\u0bcd, \u0bb5\u0bc0\u0bb0\u0b95\u0bb8\u0bcd\u0736\u0bb5\u0bb5 \u0b95\u0732\u0bb0\u0731\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0bb2\u0bcd \u0bb5\u0bc0\u0bb0\u0b95\u0bb8\u0bcd\u0736\u0bb5\u0bb5 \u0b95\u0732\u0bb0\u0731\u0bae\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0b85\u0738\u0bae\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3, \u0ba8\u0732\u0bb2 \u0b85\u0bb3\u0738\u0bb5\u0baf\u0731\u0bb3\u0bb0\u0bcd \u0b85\u0ba4\u0732\u0baa\u0731\u0732\u0ba9\u0bcd \u0736\u0baa\u0baf\u0731\u0732\u0bb2\u0bcd \u0b85\u0bae\u0bcd\u0baa\u0731\u0ba8\u0bcd\u0737\u0ba4\u0731\u0b9f\u0bcd\u0738\u0b9f \u0bae\u0731\u0bb5\u0b9f\u0bcd\u0b9f \u0b9a\u0732\u0737\u0bb0\u0bb7\u0bcd\u0b9f \u0ba8\u0732\u0bb2 \u0b85\u0bb3\u0738\u0bb5\u0baf\u0731\u0bb3\u0bb0\u0bcd \u0ba8\u0731\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0731\u0bb2\u0bcd \u0ba4\u0baf\u0731\u0731\u0732\u0b95\u0bcd \u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb0\u0bb2\u0bcd \u0bb5\u0738\u0bb0\u0baa\u0b9f \u0b87\u0bb2. 830300, \u0bb5\u0bb2\u0baf \u0b87\u0bb2. 05, \u0ba4\u0731\u0bb3\u0bcd \u0b87\u0bb2. 01 \u0b87\u0bb2\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 01 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 02 \u0b8e\u0ba9 \u0b95\u0bc1\u0bb1\u0732\u0ba4\u0bcd\u0ba4 \u0b95\u0731\u0ba3\u0732