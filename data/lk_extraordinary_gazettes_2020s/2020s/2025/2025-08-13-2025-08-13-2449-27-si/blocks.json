    "bbox": [
      48.0,
      424.4,
      542.63,
      583.56
    ],
    "text": "(358 \u0dc0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba \u0dc0\u0dd6) \u0db1\u0dcf\u0dcf\u0dc0\u0dd2\u0d9a \u0dc4\u0db8\u0dd4\u0daf\u0dcf\u0dcf \u0db4\u0db1\u0dad\u0dda\u0dda\u01ae 21 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f (1) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2, \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0dc0\u0db1 \u0db8\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca, \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0dc3\u0dd4\u0db7\u0dc3\u0dd2\u0daf\u0dca\u0db0\u0dd2\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba\u0dad\u0dcf\u0dcf\u0dc0\u0dba \u0dc3\u0dd0\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dca\u0dbd\u0da7 \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca, \u0db1\u0dcf\u0dcf\u0dc0\u0dd2\u0d9a \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0db1 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dba\u0db1\u0dca \u0dbd\u0dd9\ufffd\u0dc3, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db1\u0dcf\u0dcf\u0dc0\u0dd2\u0d9a \u0dc4\u0db8\u0dd4\u0daf\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0da7, \u0dc0\u0dd9\u0dd9\u0dc5\u0db3 \u0db1\u0dde\ufffd\u0dde\u0d9a\u0dcf\u0dcf\u0dc0\u0db1\u0dca\u0da7 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0db4\u0dd9\u0ddf\ufffd\u0ddf\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dd3\u0dba \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8\u0dca \u0dc0\u0dd9\u0dd9\u0dad \u0d91\u0dc4\u0dd2 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0dc4\u0dcf\u0dcf \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0dd0\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc3\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dd3\u0dba \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0db8\u0dd9\ufffd\u0dc4\u0dd9\ufffd\u0dba\u0dd4\u0db8\u0dca \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dd8\u0dd8\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dcf\u0d9c\u0dd9\ufffd\u0db1 \u0dba\u0dcf\u0dcf\u0db8, \u0d91\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dd8\u0dd8\u0dad\u0dd2\u0dba\u0dda\u024f \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0db8 \u0db8\u0dd9\ufffd\u0dc4\u0dd9\ufffd\u0dba\u0dd4\u0db8\u0dca, \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0dc3\u0dc4 \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba\u0dba \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\ufffd\u0d82\ufffd\u0dc1\u0dba\u0dda\u024f \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba \u0dba\u0da7\u0dad\u0dda\u0dda\u01ae \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3, \u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0db4\u0dde\ufffd\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dd3\u0dba \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0d85\u0dba\u0dad\u0dca \u0d9c\u0dd2\u0db1\u0dd2 \u0d85\u0dc0\u0dd2, \u0d8b\u0dab\u0dca\u0da9 \u0dc3\u0dc4 \u0d85\u0db1\u0dd9\ufffd\u0d9a\u0dd4\u0dad\u0dca \u0d8b\u0db4\u0dcf\u0d82\ufffd\u0d82\u0d9c \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db1\u0dcf\u0dcf\u0dc0\u0dd2\u0d9a \u0dc4\u0db8\u0dd4\u0daf\u0dcf\u0dcf\u0dc0\u0da7 \u0d85\u0dba\u0dad\u0dca \u0d85\u0dc0\u0dd2 \u0d9c\u0db6\u0da9\u0dcf\u0dcf \u0dad\u0dd4\u0dc5 \u0d9c\u0db6\u0da9\u0dcf\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0d91\u0d9a\u0dd3 \u0d9c\u0dd2\u0db1\u0dd2 \u0d85\u0dc0\u0dd2, \u0d8b\u0dab\u0dca\u0da9 \u0dc3\u0dc4 \u0d85\u0db1\u0dd9\ufffd\u0d9a\u0dd4\u0dad\u0dca \u0d8b\u0db4\u0dcf\u0d82\ufffd\u0d82\u0d9c \u0db8\u0dd9\ufffd\u0dc4\u0dd9\ufffd\u0dba\u0dd4\u0db8\u0dca \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba\u0dad\u0dcf\u0dcf \u0d85\u0db1\u0dd4\u0dc0 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db1\u0dcf\u0dcf\u0dc0\u0dd2\u0d9a \u0dc4\u0db8\u0dd4\u0daf\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba \u0dc4\u0dcf\u0dcf \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dcf\u0dc0 \u0dba\u0da7\u0dad\u0dda\u0dda\u01ae \u0dc0\u0dd2\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0db4\u0dde\ufffd\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb\u0dd3\u0dba \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8\u0dca\u0dc0\u0dbd \u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0dd2\u0dad\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0db4\u0dba\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc0\u0dcf\u0dcf\u0dc4\u0db1 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dba\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf\u0dcf \u0d8b\u0db4\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0d9c\u0dd3 \u0d9a\u0dbb \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dcf\u0dc4\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d87\u0dad\u0dd4\u0dc5\u0dd4\u0dc0 \u0d89\u0dc4\u0dad \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dba\u0db1\u0dca \u0dc4\u0dcf\u0dcf \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d8a\u0da7 \u0d86\u0db1\u0dd4\u0dc1\u0d82\u0d82\u0d9c\u0dd2\u0d9a \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0d9a\u0dcf\u0dcf\u0dbb\u0dab\u0dcf\u0dcf \u0d89\u0da7\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0dd9\ufffd\u0dc3 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0dda\u0229. \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a, \u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2.",
