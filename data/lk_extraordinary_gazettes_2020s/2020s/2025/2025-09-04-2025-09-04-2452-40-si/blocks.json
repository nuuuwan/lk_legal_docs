    "text": "\u201c\u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba\u0dba\u201d \u0dba\u0db1\u0dca\u0db1\u0dd9\ufffd\u0db1\u0dca, (218 \u0dc0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba \u0dc0\u0dd6) \u0dc0\u0dd2\u0dc2 \u0dc0\u0dbb\u0dca\u0d9c, \u0d85\u0db6\u0dd2\u0d82\u0d82 \u0dc3\u0dc4 \u0d85\u0db1\u0dca\u0dad\u0dbb\u0dcf\u0dcf\u0dba\u0daf\u0dcf\u0dcf\u0dba\u0d9a \u0d96\u0dc2\u0db0 \u0dc0\u0dbb\u0dca\u0d9c \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\u01ae \u0dad\u0dd4\u0db1\u0dca\u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u024f \u201c\u0d86\u201d \u0d9a\u0dcf\u0dcf\u0dab\u0dca\u0da9\u0dba\u0dda\u024f \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dba\u0db8\u0dca \u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba\u0dba\u0dba\u0d9a\u0dca \u0dc3\u0dc4 2008 \u0d85\u0d82\u0d82\u0d9a 1 \u0daf\u0dbb\u0db1 \u0db8\u0dcf\u0dcf\u0daf\u0d9a \u0d96\u0dc2\u0db0 \u0dc3\u0dc4 \u0db8\u0db1\u0ddd\ufffd\u0ddd\u02ea \u0dc0\u0dbb\u0dca\u0dad\u0d9a \u0db1\u0dd3\u0dad\u0dd2\u0dc0\u0dd2\u0dbb\u0ddd\ufffd\u0ddd\u02ea\u0db0\u0dd3 \u0dbd\u0dd9\ufffd\u0dc3 \u0da2\u0dcf\u0dcf\u0dc0\u0dcf\u0dcf\u0dbb\u0db8\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d91\u0dbb\u0dd9\u0dd9\u0dc4\u0dd2 \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0dad\u0dd2 \u0db4\u0db1\u0dad\u0dda\u01ae \u0dad\u0dd4\u0db1\u0dca\u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u024f I \u0dc0\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dda\ufffd\u0dda \u0dc3\u0dc4 II \u0dc0\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dda\ufffd\u0dda \u0dc3\u0dc4 \u0dc4\u0dad\u0dbb\u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u024f I \u0dc0\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dda\ufffd\u0dda, II \u0dc0\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dda\ufffd\u0dda, III \u0dc0\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dda\ufffd\u0dda \u0dc3\u0dc4 IV \u0dc0\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dda\ufffd\u0dda \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0