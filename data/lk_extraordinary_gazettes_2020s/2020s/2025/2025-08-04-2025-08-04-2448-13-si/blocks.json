    "text": "\u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba (\u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad\u0dba\u0dd2) \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013--\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 \u0dc0\u0dd2\u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u0ddd \u0db4\u0dad \u0d85\u0d82\u0d9a\u0dba \u0d89\u0db1\u0dca\u0dd9\u0da2\u0db1\u0dca\u0dc2\u0db1\u0dca \u0dad\u0dc4\u0db1\u0db8\u0dca \u0dd9\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0dc4 \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd\u0dad\u0dca\u0dc0\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dd9\u0d9c\u0dca/\u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dd9\u0dba\u0dca \u0d85\u0dd9\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dcf\u0dd9\u0dc0\u0db1\u0dca \u0d87\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dd9\u0dc3\u0dda \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db1\u0db8/\u0db1\u0db8\u0dca \u0dc3\u0dc4 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u0dc4\u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dc4 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dca \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u0db4\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1:22 0.0485 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db8\u0db1\u0db1\u0dca\u0db1\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0daf\u0dba\u0dcf\u0dc0\u0dad\u0dd3 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 117/03/432171 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2 1:23 0.0013 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dcf\u0dab\u0dd4\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dc5 \u0db6\u0dd2\u0db8 1:24 0.0488 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db8\u0db1\u0db1\u0dca\u0db1\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dd9\u0db4\u0dda\u0db8\u0dc0\u0dad\u0dd3 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 117/11/432173 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2 1:25 0.0012 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dcf\u0dab\u0dd4\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dc5 \u0db6\u0dd2\u0db8 1:26 0.0495 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86 \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db8\u0db1\u0db1\u0dca\u0db1\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dd9\u0dc3\u0ddd\u0db8\u0dbb\u0dad\u0dca\u0db1 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 117/08/432170 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2 1:27 0.0015 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dcf\u0dab\u0dd4\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dc5 \u0db6\u0dd2\u0db8 1:28 0.0495 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc0\u0dbd\u0dd2\u0db8\u0dd4\u0db1\u0dd2 \u0dd9\u0daf\u0dca\u0dc0\u0dd9\u0d9c\u0dca \u0d85\u0da2\u0dd2\u0dad\u0dca \u0db1\u0db1\u0dca\u0daf\u0dc3\u0dd2\u0dbb\u0dd2 \u0da2\u0dd2\u0db1\u0daf\u0dcf\u0dc3 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 117/03/432172 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2. 1:30 0.0507 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db4\u0dd2\u0db9\u0dd4\u0dbb \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 1:31 0.0076 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dcf\u0dab\u0dd4\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dc5 \u0db6\u0dd2\u0db8 1:33 0.0500 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u0dad\u0dca \u0d85\u0d9c\u0db8\u0dca\u0dd9\u0db4\u0ddc\u0da9\u0dd2\u0dd9\u0d9c\u0dca \u0dbb\u0d82\u0da2\u0dd2\u0dad\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 117/01/432175 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd2\u0dba\u0dd2 1:34 0.0506 \u0dbb\u0da2\u0dba _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddd\u0dbb\u0dd9\u0dbd\u0dca\u0dd9\u0d9c\u0dca \u0dd9\u0d9a\u0dde\u0dc1\u0dd2\u0d9a \u0db4\u0dd2\u0dba\u0dc1\u0dcf\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a",
