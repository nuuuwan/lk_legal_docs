\u0dcf\u0dd9\u0d9c\u0dca \u0d85\u0da2\u0dd2\u0dad\u0dca \u0dd9\u0db4\u0dda\u0db8\u0dc1\u0dcf\u0db1\u0dca\u0dad 752372381V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - - \u0db8\u0db0\u0dd4\u0dc2\u0dcf\u0db1\u0dca \u0d91\u0db1\u0dca\u0da7\u0dbb\u0dca \u0db4\u0dba\u0dd2\u0dc3\u0dc3\u0dca, \u0d9a\u0dbb\u0dc0\u0dca\u0dd9\u0daf\u0dab\u0dd2\u0dba, \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd 1:90 0.0183 \u0d9c\u0dd4\u0dab\u0dc0\u0dbb\u0dca \u0db0\u0db1 \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca\u0dbd\u0dcf\u0dd9\u0d9c\u0dca 673320481V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - - \u0dbd\u0dbd\u0dd2\u0dad\u0dca \u0dbb\u0d82\u0da2\u0dd2\u0dad\u0dca \u0d9c\u0dd4\u0dab\u0dc0\u0dbb\u0dca \u0db0\u0db1 \u0dc3\u0dd3 43/6,3, \u0db8\u0db0\u0dd4\u0dc2\u0dcf\u0db1\u0dca, \u0d9a\u0dbb\u0dc0\u0dca\u0dd9\u0daf\u0db1\u0dd2\u0dba, \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd 1:93 0.0677 \u0db8\u0dd4\u0dbd\u0dca\u0dd9\u0dbd\u0dba\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0db1\u0daf\u0dd3\u0dad\u0dca \u0dad\u0dbb\u0d82\u0d9c \u0dbd\u0d9a\u0dca\u0dc3\u0dd2\u0dbb\u0dd2 881470551V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dd9\u0d9a\u0ddc\u0db8\u0dbb\u0dca\u0dc2\u0dbd\u0dca - 234/22, \u0d85\u0d9f\u0dd4\u0dbb\u0dd4\u0dc0\u0dd0\u0dbd\u0dca\u0dbd, \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0d94\u0dc6\u0dca\u0dc3\u0dd2\u0dd9\u0dbd\u0ddd\u0db1\u0dca \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0dad\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0d82\u0d9a 4398- 2014.01.24 \u0daf\u0dbb\u0dab \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:95 0.0229 \u0db4\u0dcf\u0dbd\u0dd2\u0dad \u0dbd\u0dd2\u0dba\u0db1\u0dd9\u0d9c\u0dca 671013220V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba