4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 1:42 0.1877 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd2\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0dc0\u0dd2\u0da2\u0dba\u0db4\u0dd4\u0dbb. \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 1:45 0.1961 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 96/260/2014 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc0\u0dd2\u0dd9\u0da2\u0dca\u0dc3\u0dd2\u0d82\u0dc4 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0da0\u0db1\u0dca\u0daf\u0dd2\u0d9a\u0dcf \u0dc0\u0dd2\u0dd9\u0da2\u0dca\u0dc3\u0dd2\u0d82\u0dc4 \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3 1:51 0.0923 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 49/260/2009 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0d92. \u0dd9\u0d9a\u0dca. \u0d9c\u0dd4\u0dbb\u0dd4\u0dc3\u0dd2\u0d82\u0dc4\u0dd9\u0d9c\u0dca \u0d85\u0dad\u0dd4\u0dbd \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0dba\u0db1 \u0d85\u0dba \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0dc0\u0dd2\u0db3\u0dd3 1:82 0.1055 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\