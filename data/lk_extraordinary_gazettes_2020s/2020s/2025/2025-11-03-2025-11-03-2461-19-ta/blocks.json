    "text": "\u0b95\u0ba4\u0bbf\u0bbf\u0bb0\u0bcd\u0b95\u0bbe\u0bbe\u0bae\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd 2026 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0bb5\u0bb0\u0bc8\u0bc8\u0bb5\u0bc1 \u0bb5\u0bb0\u0bb5\u0bc1 \u0b9a\u0bc6\u0bc6\u0bb2\u0bb5\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0b9f \u0baa\ufffd\u0bca\u0ba4\u0bc1\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b95\u0ba4\u0bbf\u0bbf\u0bb0\u0bcd\u0b95\u0bbe\u0bbe\u0bae\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd 2026 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0bb5\u0bb0\u0bc8\u0bc8\u0bb5\u0bc1 \u0bb5\u0bb0\u0bb5\u0bc1 \u0b9a\u0bc6\u0bc6\u0bb2\u0bb5\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0b9f \u0baa\ufffd\u0bca\u0ba4\u0bc1\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bbe\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1, \u0bae\ufffd\u0bb2\u0bc1\u0bae\u0bcd \u0bb5\u0bb0\u0bc8\u0bc8\u0bb5\u0bc1 \u0bb5\u0bb0\u0bb5\u0bc1 \u0b9a\u0bc6\u0bc6\u0bb2\u0bb5\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 2025, \u0ba8\u0bb5\u072d\u0bae\u0bcd\u0baa\u0bb0\u0bcd 03 \u0bae\u0bc1\u0ba4\u0bb2\u0bcd 2025, \u0ba8\u0bb5\u072d\u0bae\u0bcd\u0baa\u0bb0\u0bcd 11 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf \u0bb5\u0bbe\u0bbe\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1, \u0bae\ufffd\u0bb2\u0bc1\u0bae\u0bcd \u0bb5\u0bb0\u0bc8\u0bc8\u0bb5\u0bc1 \u0bb5\u0bb0\u0bb5\u0bc1 \u0b9a\u0bc6\u0bc6\u0bb2\u0bb5\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd 2025, \u0ba8\u0bb5\u072d\u0bae\u0bcd\u0baa\u0bb0\u0bcd 03 \u0bae\u0bc1\u0ba4\u0bb2\u0bcd 2025, \u0ba8\u0bb5\u072d\u0bae\u0bcd\u0baa\u0bb0\u0bcd 11 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf \u0bb5\u0bb0\u0bc8\u0bc8 \u0b85\u0bb0\u0b9a\u0bbe\u0bbe\u0b99\u0bcd\u0b95 \u0bb5\u072d\u0bb2\u0bc8\u0bc8 \u0ba8\u0bbe\u0bbe\u0b9f\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0bbe\u0bbe\u0bb2\u0bc8\u0bc8 9.00 \u0bae\u0ba3\u0bbf\u0bbf \u0bae\u0bc1\u0ba4\u0bb2\u0bcd \u0bae\u0bbe\u0bbe\u0bb2\u0bc8\u0bc8 4.00 \u0bae\u0ba3\u0bbf\u0bbf \u0bb5\u0bb0\u0bc8\u0bc8 \u0b95\u0ba4\u0bbf\u0bbf\u0bb0\u0bcd\u0b95\u0bbe\u0bbe\u0bae\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8 \u0ba8\u0bc2\u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd \u0bb5\u0bb0\u0bc8\u0bc8 \u0b85\u0bb0\u0b9a\u0bbe\u0bbe\u0b99\u0bcd\u0b95 \u0bb5\u072d\u0bb2\u0bc8\u0bc8 \u0ba8\u0bbe\u0bbe\u0b9f\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0bbe\u0bbe\u0bb2\u0bc8\u0bc8 9.00 \u0bae\u0ba3\u0bbf\u0bbf \u0bae\u0bc1\u0ba4\u0bb2\u0bcd \u0bae\u0bbe\u0bbe\u0bb2\u0bc8\u0bc8 4.00 \u0bae\u0ba3\u0bbf\u0bbf \u0bb5\u0bb0\u0bc8\u0bc8 \u0b95\u0ba4\u0bbf\u0bbf\u0bb0\u0bcd\u0b95\u0bbe\u0bbe\u0bae\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8 \u0ba8\u0bc2\u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd \u0bb5\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc8\u0bc8 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0ba4\u0bc6\u0bc6\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0b95\ufffd\u0bca\u0bb3\u0bcd\u0b95\u0bbf\u0bbf\u0bb1\ufffd\u0ba9\u0bcd.\u0bb5\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f