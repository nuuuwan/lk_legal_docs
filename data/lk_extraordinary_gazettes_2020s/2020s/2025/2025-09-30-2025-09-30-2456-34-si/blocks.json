    "text": "\u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0d9a\u0dca \u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0dc0\u0db1\u0dca\u0db1\u0dda\ufffd \u0d91\u0dba \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dc5 \u0db8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0db8\u0dcf\u0dcf\u0dc3 06\u0d9a \u0d9a\u0dcf\u0dcf\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db4\u0db8\u0dab\u0dd2. \u0d91\u0dc4\u0dd9\ufffd\u0dad\u0dca, \u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dcf\u0dcf\u0dbd\u0dba \u0d89\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0dd6 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0d9a\u0da7 \u0dc0\u0dd2\u0dc1\u0dda\u02e4\u0dda\u0dc2 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf \u0d85\u0db1\u0dd4\u0dc0 \u0dc3\u0dbd\u0d9a\u0dcf\u0dcf \u0d91\u0dba \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dc5 \u0db8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0daf\u0dd2\u0db1\u0dba\u0dda\u024f \u0dc3\u0dd2\u0da7 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0daf\u0dd9\u0dd9\u0d9a\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d9c\u0dd9\u02c3\u0dc0\u0dd3\u0db8 \u0d9c\u0dd0\u0dd0\u0db1 \u0dc3\u0dbd\u0d9a\u0dcf\u0dcf \u0db6\u0dbd\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229. \u0d9a\u0dd9\ufffd\u0dc3\u0dda\ufffd\u0dda \u0dc0\u0dd4\u0dc0\u0dad\u0dca, \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dc5 \u0db8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0daf\u0dd9\u0dd9\u0d9a\u0d9a\u0dca \u0d89\u0d9a\u0dca\u0db8\u0d9c\u0dd2\u0dba \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0d9a\u0dca \u0db1\u0dd0\u0dd0\u0dc0\u0dad \u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d91\u0dc4\u0dd2 \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0dcf\u0d9a\u0db