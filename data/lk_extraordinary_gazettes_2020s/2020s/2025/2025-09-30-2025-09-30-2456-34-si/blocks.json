    "text": "\u0db8\u0dcf\u0dcf\u0dc3 \u0dad\u0dd4\u0db1\u0d9a\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0dad\u0dd9\ufffd\u0d9a\u0dca \u0dbd\u0dd0\u0dd0\u0db6\u0dd9\ufffd\u0db1 \u0db4\u0dd0\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dbd\u0dd2 \u0db4\u0db8\u0dab\u0d9a\u0dca \u0dc3\u0dbd\u0d9a\u0dcf\u0dcf \u0db6\u0dd0\u0dd0\u0dbd\u0dd3\u0db8\u0da7 \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dda\u0229. \u0db8\u0dd9\ufffd\u0dba \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0db1\u0dca\u200d\u0dba\u0dba \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca, \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dd4\u0256\u0dad\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca, \u0dc6\u0dd0\u0dd0\u0d9a\u0dca\u0dc3\u0dca\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca \u0dc4\u0dcf\u0dcf \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0dcf\u0d9a\u0db8 \u0d9c\u0dd9\u02c3\u0dc0\u0dcf\u0dcf \u0db7\u0dcf\u0dcf\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0dc0\u0dda\u0dda. \u0d89\u0dc4\u0dad 02 \u0da1\u0dda\u0dda\u0daf\u0dba\u0dda\u024f \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf \u0dba\u0da7\u0dad\u0dda\ufffd \u0dc0\u0dd6 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca\u0dc0\u0dbd \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0dcf\u0d9a\u0db8 \u0dbb\u0dcf\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0db8\u0da7 \u0db6\u0dd0\u0dd0\u0dbb \u0d9a\u0dbb \u0d87\u0dad\u0dca\u0db1\u0db8\u0dca \u0d91\u0db8 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d87\u0dab\u0dc0\u0dd4\u0db8\u0dca\u0dc0\u0dbd \u0dc0\u0da7\u0dd2\u0db1\u0dcf\u0dcf\u0d9a\u0db8 \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0dbb\u0dd9\u0dd9\u0d9c\u0dd4\u0dbd\u0dcf\u0dcf\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0d85\u0db1\u0dd4\u0dc0 \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0db8\u0dd9\ufffd\u0db1\u0dc