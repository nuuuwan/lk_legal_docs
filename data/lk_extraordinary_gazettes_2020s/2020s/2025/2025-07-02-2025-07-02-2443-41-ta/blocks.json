    "text": "\u0b89\u0b9f\u0ba9\u0bcd\u0baa\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd 28 \u0b86\u0bb5\u0ba4\u0bc1 \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd 6 \u0b86\u0bb5\u0ba4\u0bc1 \u0baa\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf\u0baf\u0bc8\u0bc8 \u0ba8\u0bc0\u0b95\u0bcd\u0b95\u0bbf\u0bbf \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bbf\u0bb2\u0bbe\u0bbe\u0b95 \u0b95\u0bc0\u0bb4\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bbf\u0bbf\u0baf\u0bc0\u0b9f\u0bc1 \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f \u0bb5\ufffd\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.",
