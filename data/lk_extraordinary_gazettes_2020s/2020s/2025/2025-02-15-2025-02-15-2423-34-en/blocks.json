      218.59,
      390.74,
      232.06
    ],
    "text": "(3) by the repeal of regulation 50 and the substitution therefor of the following:-",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
