      549.17,
      184.06
    ],
    "text": "(c) by the substitution in paragraph (e) for the words and figures, \u201creaches the age of 50 years\u201d, of the words and figures \u201creaches the age of Sixty (60) years\u201d.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
