    "text": "\u0baf\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u0bb5\u0bc0\u0ba4\u0bbf \u0b85\u0ba7\u0bbf\u0baf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0bc8\u0bbe\u0baa \u0b9a\u0b95\u0ba7 \u0bb5\u0bc0\u0ba4\u0bbf \u0ba8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba7\u0bbf\u0baa\u0b9a\u0ba4\u0b9a \u0b9a\u0b95\u0ba7 \u0bb5\u0bc0\u0ba4\u0bbf ; \u0bc8\u0bbf\u0bae\u0b95\u0bcd\u0b95\u0bc1: \u0ba7\u0bbf\u0baa\u0b9a\u0ba4\u0b9a \u0b9a\u0b95\u0ba7 \u0bb5\u0bc0\u0ba4\u0bbf \u0ba8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd. \u0b9f\u0baa\u0bcd\u0bad\u0bbf\u0bb5\u0bcd, \u0ba4\u0bb0\u0bcd\u0ba8\u0b9a\u0b9a\u0ba6 \u0ba8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\u0bbf\u0bac\u0bb0\u0bcd \u0b89\u0bbe\u0bbf\u0b95\u0ba8 \u0b9a\u0bc8\u0bbe\u0bb0\u0bc1\u0bae\u0bcd \u0ba7\u0b9f\u0b95\u0ba7\u0bb2\u0bbf\u0ba9\u0bbe\u0b95\u0bc8\u0bbe\u0b9f\u0bae\u0bc2\u0bc8\u0bac\u0bbe\u0ba6; \u0b95\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u0b8e\u0ba9\u0bcd. \u0b9f\u0baa\u0bcd\u0bad\u0bbf\u0bb5\u0bcd. \u0ba4\u0bb0\u0bcd\u0ba8\u0b9a\u0b9a\u0ba6 \u0ba8\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\u0bbf\u0bac\u0bb0\u0bcd \u0b89\u0bbe\u0bbf\u0b95\u0ba8 \u0b9a\u0bc8\u0bbe\u0bb0\u0bc1\u0bae\u0bcd \u0ba7\u0b9f\u0b95\u0ba7\u0bb2\u0bbf\u0ba9\u0bbe\u0b95\u0bc8\u0bbe\u0b9f\u0bae\u0bc2\u0bc8\u0bac\u0bbe\u0ba6; \u0b9a\u0ba8\u0bb1\u0bcd\u0b95\u0bc1 : \u0bb5\u0bc0\u0ba4\u0bbf \u0b85\u0ba7\u0bbf\u0baf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0bc8\u0bbe\u0baa \u0b9a\u0b95\u0ba7 \u0bb5\u0bc0\u0ba4\u0bbf.",
