    "text": "\u0dad\u0dda\u01ae \u0dc0\u0dd0\u0dd0\u0dc0\u0dd3\u0db8\u0dda\u023c \u0dc4\u0dcf\u0dcf \u0dc3\u0dd1\u0dd1\u0daf\u0dd3\u0db8\u0dda\u023c \u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0db4\u0da9\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0d9a \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0db1\u0db8\u0dca \u0d9a\u0dbd \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd6 \u0db8\u0dcf\u0dcf\u0dbd\u0d9a \u0dc0\u0dd3\u0dbb\u0dc3\u0dd2\u0d82\u0d82\u0dc4 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda\u0118, \u0d9c\u0dba\u0dcf\u0dcf\u0db1\u0dca \u0d95\u0dc0\u0dd2\u0da7\u0dd2\u0d9c\u0dbd \u0dc3\u0dc4 \u0dc0\u0dd3. \u0da2\u0dd3\u0dc0\u0db1\u0db1\u0dca\u0daf\u0dbb\u0dcf\u0dcf\u0da2\u0dcf\u0dcf \u0dba\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0dc0\u0dd2\u0d9a\u0dd4\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dd3\u0db4, \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0dc3\u0dc4 \u0d9c\u0db1\u0dca\u0daf\u0dd2\u0d9a \u0dc0\u0dd0\u0dd0\u0dbd\u0dd2\u0d9c\u0db8\u0d9c\u0dda\u0118 \u0dba\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0daf \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dca\u200d\u0dba\u0dba \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0dd2\u0dad \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db1\u0dca \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6 \u0dc3\u0dd2\u0da7\u0dd2 \u0db6\u0dd3. \u0db6\u0dd4\u0dc5\u0dd4\u0db8\u0dd4\u0dbd\u0dca\u0dbd \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dd3\u0db4\u0dca \u0dc4\u0dda\ufffd\u0dda\u0db8\u0db1\u0dca\u0dad \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb \u0dbd\u0dd2\u0dba\u0db1\u0d9c\u0dd9\ufffd\u0daf\u0dbb \u0dba\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db6\u0dd2\u0db1\u0dda\ufffd\u0dc2\u0dca \u0db1\u0dd2\u0dba\u0ddc\ufffd\u0ddc\u0db8\u0dcf\u0dcf\u0dbd\u0dca \u0db4\u0db1\u0db1\u0dca\u0dc0\u0dbd \u0dc3\u0dc4 \u0da9\u0dd3. \u0db6\u0dd3. \u0d91\u0dc3\u0dca. \u0d91\u0dbd\u0dca. \u0db4\u0dd9\u0dd9\u0dbb\u0dda\u0dda\u0dbb\u0dcf\u0dcf \u0dba\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0daf \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0d9a \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0da2\u0dd2\u0dad \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0dd9\ufffd\u0d9a\u0dd4 \u0dbd\u0dd9\ufffd\u0dc3 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6 \u0dc3\u0dd2\u0da7\u0dd2 \u0d9a\u0dd2\u0da7\u0dca\u0db1\u0db1\u0dca \u0dc3\u0dd9\ufffd\u0dbd\u0dca\u0dc0\u0dbb\u0dcf\u0dcf\u0da2\u0dca \u0db8\u0dc4\u0dad\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0dbb\u0dd9\u0d82\ufffd\u0d82\u0d9c\u0dc3\u0dcf\u0dcf\u0db8\u0dd2 \u0dc3\u0dd4\u0dbb\u0dda\u0dda\u0dc2\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb\u0dca \u0db8\u0dc4\u0dad\u0dcf\u0dcf \u0daf \u0db4\u0da9\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0d9a \u0dc3\u0db7\u0dcf\u0dcf \u0d86\u0da5\u0dcf\u0dcf \u0db4\u0db1\u0dad\u0dda\u01ae (136 \u0dc0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba) 9 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0dad\u0dd4\u0db8\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dad\u0dca\u0d9a\u0dc5 \u0db6\u0dc0 \u0d91\u0d9a\u0dd3 \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\u01ae 30 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0d9c\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229. \u0db8\u0dd9\ufffd\u0db8 \u0db4\u0dad\u0dca\u0d9