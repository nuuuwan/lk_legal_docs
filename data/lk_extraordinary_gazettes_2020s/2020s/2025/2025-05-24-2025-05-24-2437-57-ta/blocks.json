    "text": "\u0baa\u0bb3\u0bcd\u0bb3\u0bbf\u0baf\u0bb5\u0ba4\u0bcd\u0ba4, \u0ba8\u0bbe\u0bb0\u0bae\u0bcd\u0bae\u0bb2 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0baa\u0bcd\u0baa\u1f8c\u0bb5\u0bbe\u0bc7\u0bb5\u0bb5\u0ba4\u0bcd\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b8e\u0b9a\u0bcd.\u0b9f\u0bc0.\u0b8e\u0b9a\u0bcd. \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0baa\u0bcd\u0baa\u1f8c\u0bb5\u0bbe\u0bc7\u0bb5\u0bc7\u0bb9\u0ba9 \u0ba4\u0bb1\u0bcd\u0bc7\u0baa\u0bbe\u1f90 \u0bb5\u0ba4\u0bcd\u0ba4 ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u0b8e\u0bb2\u0bcd.\u0b8e\u0bae\u0bcd.\u0b8e\u0bb8\u0bcd. \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bc7\u0b9a\u0b95\u0bb0 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0baa\u0bb3\u0bcd\u0bb3\u0bbf\u0baf\u0bb5\u0ba4\u0bcd\u0ba4, \u0ba8\u0bbe\u0bb0\u0bae\u0bcd\u0bae\u0bb2 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0b9a\u0bc8\u0baa \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0baa\u0bcd\u0baa\u1f8c\u0bb5\u0bbe\u0bc7\u0bb5\u0bb5\u0ba4\u0bcd\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b8e\u0b9a\u0bcd.\u0b9f\u0bc0.\u0b8e\u0b9a\u0bcd. \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba4\u0bbf\u0baa\u0bcd\u0baa\u1f8c\u0bb5\u0bbe\u0bc7\u0bb5\u0bc7\u0bb9\u0ba9 \u0ba4\u0bb1\u0bcd\u0bc7\u0baa\u0bbe\u1f90 \u0bb5\u0ba4\u0bcd\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0baa\u0bbe\u0bc8\u0ba4 (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa) ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u0baa\u0bbe\u0bc8\u0ba4 (\u1faa\u0ba4\u0bbf \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0b9a\u0bc8\u0baa) \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0baa\u0bc0.\u0b8f.\u0b9a\u0bc0.\u0bc7\u0b9c. \u0ba4\u0bb0\u0bcd\u0bae\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bb2\u0bcd\u0bb5\u0b99\u0bcd\u0b95\u0bbf\u0baf\u0bb5\u0ba4\u0bcd\u0ba4 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u0bc7\u0baa\u0bb0\u0b95\u0bb8\u0bcd\u0b8e\u0bb2 .",
