    "text": "\u0ba8\u0bb5\ufffd\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 25 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba4\ufffd\u0bca\u0b9f\u0b99\u0bcd\u0b95\u0bbf\u0bbf 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0ba4\u0bbf\u0bbf\u0b9a\u0bc6\u0bc6\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 24 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf\u0ba9\u0bcd\u0bb1\u0bc1 \u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0b9f\u0bc8\u0bc8\u0b95\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1 \u0b95\u0bbe\u0bbe\u0bb2\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\ufffd\u0bcb\u0ba4\u0bbe\u0bbe\u0ba9 \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf\ufffd\u0bca\u0ba9\u0bcd\u0bb1\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0bbe\u0bbe\u0bb2\u0bbe\u0bbe\u0bb5\u0ba4\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bb3\u0bcd\u0bb3 \u0b8f\u0ba4\u0bc7\u0bc7\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\u0bbe\u0bbe\u0bb0\u0ba4\u0bbf\u0bbf \u0b85\u0ba9\u0bc1\u0bae\u0ba4\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b9a\u0bc6\u0bc6\u0bb2\u0bcd\u0bb2\u0bc1\u0baa\u0b9f\u0bbf\u0b95\u0bcd \u0b95\u0bbe\u0bbe\u0bb2\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0ba9\u0ba4\u0bc1, \u0b87\u0baf\u0bc8\u0bc8\u0baa\u0bbe\u0bbe\u0ba9 \u0b9a\u0bbe\u0bbe\u0bb0\u0ba4\u0bbf\u0bbf \u0b85\u0ba9\u0bc1\u0bae\u0ba4\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b9a\u0bc6\u0bc6\u0bb2\u0bcd\u0bb2\u0bc1\u0baa\u0b9f\u0bbf\u0b95\u0bcd \u0b95\u0bbe\u0bbe\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b95\u0bbe\u0bbe\u0bb2\u0bbe\u0bbe\u0bb5\u0ba4\u0bbf\u0bbf\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0b92\u0bb0\u0bc1 \u0bae\u0bbe\u0bbe\u0ba4 (01) \u0b95\u0bbe\u