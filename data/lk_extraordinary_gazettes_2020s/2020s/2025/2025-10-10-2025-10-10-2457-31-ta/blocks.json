    "text": "\u0b87\u0ba8\u0bcd\u0ba4 \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0721\u0baf\u0bbf\u0bbf\u0ba9\u0bcd I \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb0\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0b95\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3, \u0ba8\u0bbf\u0bbf\u0bb0\u0bc1\u0bb5\u0bbe\u0bbe\u0b95 \u0bae\u0bbe\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0baf\u0baa\u0bcd\u0baa\u0bc6\u0bc6\u0bb1\u0bcd\u0bb1\u0bc1\u0bb3\u0bcd\u0bb3, \u0b87\u0bb5\u0bcd\u0bb5\u0b9f\u0bcd\u0b9f\u0bb5\u0ba3\u0721\u0baf\u0bbf\u0bbf\u0ba9\u0bcd II \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bbf\u0bb0\u0bb2\u0bbf\u0bb2\u0bcd \u0b85\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0ba8\u0bc7\u0bc7\u0bb0\ufffd\u0bca\u0ba4\u0bcd\u0ba4 \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb0\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0b95\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b92\u0bb5\u0bcd\u0bb5\ufffd\u0bca\u0bb0\u0bc1 \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0bcd \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0b95 \u0ba4\u0bc6\u0bc6\u0bb0\u0bbf\u0bbf\u0ba8\u0bcd\u0ba4\u0bc6\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0bc6\u0bc6\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0bb5\u0bbe\u0bbe\u0bb1\u0bc6\u0bc6\u0ba9 \u0baa\u0bbf\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1. \u0b87\u0baa\u0bcd\u0baa\u0bc6\u0bc6\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bcd 2025.09.26 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 2455/30 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf, 2025.08.01 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 2447/61 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bbe\u0bcd\u0bcd\u073c\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf, 2025.07.11 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 2444/ 60 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bbe\u0bcd\u0bcd\u073c\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf 2025.07.07 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 2444/ 02 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bbe\u0bcd\u0bcd\u073c\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf, 2025.07.04 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 2443/60 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf, 2025.06.27 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 2442/60 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf, 2025.06.20 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf 2441/55 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf, 2025.06.13 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 2440/25 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf, 2025.06.06 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf 2439/65 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0ba9\u0bc1\u0b9f\u0ba9\u0bcd \u0ba4\ufffd\u0bca\u0b9f\u0bb0\u0bcd\u0baa\u0bc1\u0b9f\u0bc8\u0bc8\u0baf 2025.05.31 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 2438/66, 2438/67, 2438/69, 2438/70, 2438/71, 2438/72, 2438/80, 2438/81, 2438/83, 2438/84, 2438/87, 2438/88, 2438/89, 2438/90 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bbe\u0bcd\u0bcd\u073c\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 2025.05.31 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 2438/68, 2438/74, 2438/85 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf\u0b95\u0bb3\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0ba9\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0bc6\u0bc6\u0baf\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\ufffd\u0bb2\u0ba4\u0bbf\u0bbf\u0b95\u0bae\u0bbe\u0bbe\u0ba9\u0bb5\u0bc8\u0bc8\u0baf\ufffd\u0ba9\u0bb5\u0bc1\u0bae\u0bcd \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb2\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0b95\u0b9f\u0ba9\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1.",
