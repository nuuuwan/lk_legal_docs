  },
  {
    "page_number": 0,
    "bbox": [
      55.15,
      484.39,
      549.73,
      586.46
    ],
    "text": "In terms of the regulations mentioned in the Section Two of the Pilgrimages Ordinance in Authority 175 in No. L.D.B 11/60 dated 14th day of October 1991, it has been published that the 40th Ordination Ceremony (Upasampada Ceremony) of Sri Rohana Maha Sanga Sabha in Divisional Secretary\u2019s Division of Matara Four Gravets in Matara District will be held from 18th , 19th and 20th of May 2025 at the Seema Malaka of Randupatha Uposathagara Maha Vihara of Kotuwegoda, Matara, the headquarters of Rohana Sanga Sabha and the devotees are requested not to bring plastic and polythene based products. And also it is hereby informed that the standing orders and regulations published by the Government Gazette of Democratic Socialist Republic of Sri Lanka Shall be valid within this time period of the Ordination Ceremony (Upasampada Ceremony).",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
