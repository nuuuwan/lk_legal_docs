    ],
    "text": "40th Ordination Ceremony (Upasampada Ceremony) of Sri Rohana Maha Sanga Sabha of Maha Viharawanshika Shyamopali Maha Nikaya",
    "fonts": [
      "TimesNewRomanPS-BoldMT"
