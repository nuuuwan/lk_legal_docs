    "text": "14 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dba\u0dda \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca\u0dba\u0dda \u0dad\u0dd3\u0dbb\u0dab \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dba\u0dba \u0db6\u0dc3\u0dca\u0db1\u0dcf\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dba\u0dda \u0dba\u0d9a\u0ddc\u0dc5\u0db9 \u0daf\u0dd2\u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dba\u0dda \u0d9a\u0dd0\u0dc3\u0dca\u0db6 \u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dba \u0dba \u0dba\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba\u0dda \u0d9a\u0d82\u0d9a 581 \u0db8 \u0db8\u0dc4\u0dbd\u0dca\u0dc0\u0dbb\u0dcf\u0dc0 \u200d\u0dcf\u0db8 \u0db1\u0dd2\u0dbd \u0dcf\u0dbb\u0dd2 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba \u0dc5\u0dc5 \u0db8\u0dc4\u0dbd\u0dca\u0dc0\u0dbb\u0dcf\u0dc0 \u0db1\u0db8\u0dd0\u0dad\u0dd2 \u0d9c\u0dba\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf \u0dc0\u0dd6 , \u0d9a\u0d82\u0d9a 521229 \u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0dba\u0db8\u0dca \u0d9a\u0dbd\u0dcf\u0db4 \u0d9a\u0d82\u0d9a 02 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a 1:159 \u0dbb\u0db1 \u0d89\u0da9\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0dba\u0dbd\u0dc3 \u0dba\u0db4\u0dca\u0dad\u0db1\u0dd4\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7 \u0d87\u0dda\u0dcf\u0dcf \u0dc0\u0dd6 , \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4 \u0db8\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dda \u0d9a\u0dbb\u0db1 \u0dba\u0dbd\u0dc3 \u0dd0\u0db1\u0dd4\u0db8\u0dca \u0dba \u0db8\u0dd2\u0dca\u0dad 1998 \u0d9a\u0d82\u0d9a 21 \u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3