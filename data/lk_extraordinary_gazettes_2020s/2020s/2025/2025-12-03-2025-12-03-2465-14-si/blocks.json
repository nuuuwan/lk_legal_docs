    ],
    "text": "\u0dd9\u0db1\u0ddc\u0dd9\u0dc4\u0ddc\u0dad\u0dca \u0dd9\u0db4\u0dca\u0daf\u0dd4\u0dbb\u0dd4\u0dc0\u0d9a\u0dd4\u0db9\u0dd4\u0dbb \u0dc0\u0dbb\u0dd2\u0db4\u0db1\u0db8\u0dca \u0d85\u0d82\u0d9a\u0dba 408, 410 \u0dc3\u0dc4 412 \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 \u0db4\u0dcf\u0dbb; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dba\u0dd4\u0dd9\u0dbb\u0ddd \u0dc3\u0dca\u0d9a\u0dd1\u0db1\u0dca \u0d91\u0d9a\u0dca\u0dc3\u0dca\u0dd9\u0db4\u0ddd\u0dbb\u0dca\u0da7\u0dca \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0d9c\u0db8; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.0171. 02. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 03 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: -; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad, \u0db4\u0dd0\u0dbb\u0dab\u0dd2 \u0d87\u0dd9\u0dc5\u0dc4\u0dd2 \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dca; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.0025. 03. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 05 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: -; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad, \u0db4\u0dd0\u0dbb\u0dab\u0dd2 \u0d87\u0dd9\u0dc5\u0dc4\u0dd2 \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dca; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.0010. 04. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 06 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0db8\u0dd3\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0dc0\u0dbb\u0dd2\u0db4\u0db1\u0db8\u0dca \u0d85\u0d82\u0d9a\u0dba - 408\u0d92, \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 \u0db4\u0dcf\u0dbb; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad, \u0dc3\u0dca\u0dae\u0dd2\u0dbb \u0dd9\u0d9c\u0ddc\u0da9\u0db1\u0dd0\u0d9c\u0dd2\u0dbd\u0dca\u0dbd\u0d9a \u0dd9\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0d87\u0dad; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dc3\u0dd4\u0da2\u0dcf\u0dad\u0dcf \u0dc1\u0dd2\u0dba\u0dcf\u0db1\u0dd2 \u0d9c\u0dd4\u0dab\u0dbb\u0dad\u0dca\u0db1, \u0d85\u0db1\u0dd4\u0dbb\u0d82\u0d9c \u0dc3\u0da2\u0dd2\u0dad\u0dca \u0d9c\u0dd4\u0dab\u0dbb\u0dad\u0dca\u0db1, \u0db1\u0dd2\u0dbd\u0dd4\u0db4 \u0dbb\u0dc0\u0dd3\u0db1\u0dca \u0d9c\u0dd4\u0dab\u0dbb\u0dad\u0dca\u0db1, \u0dd9\u0dc4\u0dda\u0dc0\u0dcf\u0dd9\u0daf\u0dca\u0dc0\u0dd9\u0d9c\u0dca \u0db1\u0dd2\u0db8\u0dbd\u0dca \u0da2\u0dba\u0dc3\u0dd2\u0dbb\u0dd2 \u0d9c\u0dd4\u0dab\u0dbb\u0dad\u0dca\u0db1 \u0dc3\u0dc4 \u0dd9\u0dc4\u0dda\u0dc0\u0dcf\u0dd9\u0daf\u0dca\u0dc0\u0dd9\u0d9c\u0dca \u0dc3\u0dd4\u0db1\u0dd2\u0dbd\u0dca \u0d9c\u0dd4\u0dab\u0dbb\u0dad\u0dca\u0db1; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.0069. 05. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 08 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0dc3\u0ddc\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0ddc\u0dc4\u0dd0\u0d9a; \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0dd9\u0d9c\u0dc0\u0dad\u0dca\u0dad; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dcf: -; \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.0011.",
