    "bbox": [
      55.31,
      324.86,
      430.01,
      362.0
    ],
    "text": "01. Mediation Board Area : ............................................................................................ 02. Administrative District : ........................................................................................... 03. Particulars of the Individual who recommend Nomination :",
    "fonts": [
