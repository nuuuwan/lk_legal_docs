      292.0
    ],
    "text": "FORM \u201cA\u201d",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      159.48,
      300.67,
      443.13,
      314.0
    ],
    "text": "(To be filled up by individuals eligible to recommend Nominations)",
    "fonts": [
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
