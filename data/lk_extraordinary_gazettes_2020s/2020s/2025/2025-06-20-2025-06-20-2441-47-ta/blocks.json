    "text": "\u0bae\u0bb9\u0bc6\u0b95\u0bbe\u1f8c\u0bb5, \u1faa. \u0b95\u0bbe\u0bb0\u0bbe\u0bb2\u0b9a\u0bbf\u0b99\u0bcd\u0bb9\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0ba4\u0bb0 \u0bb5\u0ba4\u0bcd\u0ba4, \u0ba4\u0bb0\u0ba8\u0bcd\u0bc7\u0ba4 \u0bb5\u0ba4\u0bcd\u0ba4, \u0b95\u0bb2\u0bcd\u0bc6\u0b95\u1f8a\u0bc7\u0baf \u0bc7\u0bb9\u0ba9 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bae\u0bb9\u0bc6\u0b95\u0bbe\u1f8c\u0bb5, \u0b85\u0bb0\u0b9a\u0bbe\u0b99\u0bcd\u0b95\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0ba4\u0bb0 \u0bb5\u0ba4\u0bcd\u0ba4, \u0ba4\u0bb0\u0ba8\u0bcd\u0bc7\u0ba4 \u0bb5\u0ba4\u0bcd\u0ba4, \u0b95\u0bb2\u0bcd\u0bc6\u0b95\u1f8a\u0bc7\u0baf \u0bc7\u0bb9\u0ba9 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bae\u0bb9\u0bc6\u0b95\u0bbe\u1f8c\u0bb5. \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u1f90\u0baa\u0bcd \u0bc7\u0baa\u0b9a\u0bc1\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b9a\u0b95\u0bb2\u1f9e\u0bae\u0bcd \u0ba4\u0bbe\u0bae\u0bbe\u0b95 \u0b85\u0bb2\u0bcd\u0bb2\u1f90 \u1f99\u0bc8\u0bb1\u0baa\u0bcd\u0baa\u1f8a \u0b8e\u1fa8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0bae\u0bcd \u0b85\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bbe\u0bbe\u0bbf\u0baf\u0b95\u0bcd\u0b95\u0bbe\u0bb0\u0bb0\u0bcd \u1f9a\u0bb2\u0bae\u0bbe\u0b95 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8c \u1f9d\u0bc8\u0bb2 \u0bae\u0bbe\u0ba4\u0bae\u0bcd 23 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u1f99.\u0baa. 10.30 \u0bae\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0baa\u0bbe\u0ba4\u0bcd\u0ba4\u1f90\u0bae\u0bcd\u0baa\u0bc8\u0bb0 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b8e\u0ba9\u0bcd \u1f99\u0ba9\u0bcd\u0baa\u0bbe\u0b95 \u0bc6\u0bb5\u0bb3\u0bbf\u0baa\u0bcd\u0baa\u1f8c\u0ba4\u0bcd\u1f90\u0bae\u0bcd\u0baa\u1f8a\u1f9c\u0bae\u0bcd, \u0bc7\u0bae\u1fa4\u0bae\u0bcd, \u0b85\u0b95\u0bcd\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd\u0bb3 \u0b89\u0b9f\u0ba8\u0bcd\u0bc8\u0ba4 \u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba4\u0ba9\u0bcd\u0bc8\u0bae\u0bc8\u0baf\u1f9c\u0bae\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf\u0bc8\u0baf \u0b8e\u1f8c\u0ba4\u0bcd\u0ba4\u0bb1\u0bcd \u0b95\u0bbe\u0ba9 \u0ba8\u0bb7\u0bcd\u0b9f\u0b88\u1f8c \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0bc8\u0b95\u0b95\u0bb3\u0bbf\u0ba9\u0bcd",
