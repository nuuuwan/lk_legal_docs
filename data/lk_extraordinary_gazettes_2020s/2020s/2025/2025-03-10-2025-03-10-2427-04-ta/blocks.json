    "text": "\u1f97\u0ba9\u0bbf\u0ba4\u0bc7\u0b9c\u0bbe\u0ba9\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u0b9c\u0bc0. \u0b8f. \u0b9c\u0bc0. \u0b85\u1f94\u0bb0 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0b9a\u0bbf\u0bbe\u0bbf\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0baa\u0baa\u0bbf\u1fa2\u0baa\u0bbf\u0b9f\u0bcd\u1f8a\u0baf\u0bb5\u0ba4\u0bcd\u0ba4 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc8\u0bb4\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u1f97\u0ba9\u0bbf\u0ba4\u0bc7\u0b9c\u0bbe\u0ba9\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0b8e\u0bb8\u0bcd.\u0b8e\u0ba9\u0bcd. \u0b95\u0bb2\u0bcd\u0b85\u0b99\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0baa\u0baa\u0bbf\u1fa2\u0baa\u0bbf\u0b9f\u0bcd\u1f8a\u0baf\u0bb5\u0ba4\u0bcd\u0ba4 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc8\u0bb4\u0b95\u0bcd \u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u1f97\u0ba9\u0bbf\u0ba4\u0bc7\u0b9c\u0bbe\u0ba9\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd, \u0b9f\u0bc6\u0bb2\u0bbe\u0b95\u0bcd \u0ba8\u0bbf\u1fa0\u0bb5\u0ba9\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0baa\u0baa\u0bbf\u1fa2\u0baa\u0bbf\u0b9f\u0bcd\u1f8a\u0baf\u0bb5\u0ba4\u0bcd\u0ba4 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc8\u0bb4\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd \u1f97\u0ba9\u0bbf\u0ba4\u0bc7\u0b9c\u0bbe\u0ba9\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0baa\u0bbe\u0bc8\u0ba4; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u0baa\u0bbe\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b9c\u0bc0. \u0b8f. \u0b9c\u0bc0. \u0b85\u1f94\u0bb0 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0b9a\u0bbf\u0bbe\u0bbf\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0baa\u0baa\u0bbf\u1fa2\u0baa\u0bbf\u0b9f\u0bcd\u1f8a\u0baf\u0bb5\u0ba4\u0bcd\u0ba4 \u0b8e\u0ba