    "text": "\u0db1\u0dcf\u0dcf\u0db8\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f \u0dad\u0db8\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0db8 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0dd9\ufffd\u0d9a\u0dd4\u0d9c\u0dda\u0118 \u0db1\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dbb\u0dc0\u0dcf\u0dcf \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0d87\u0dad\u0dca\u0dad\u0dcf\u0dcf\u0dc0\u0dd6 \u0d91\u0dc4\u0dd9\ufffd\u0dad\u0dca \u0dad\u0db8\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0db8 \u0da1\u0db1\u0dca\u0daf\u0dc4\u0dd2\u0db8\u0dd2 \u0db1\u0dcf\u0dcf\u0db8\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc4\u0dcf\u0dcf \u201c\u0d86\u201d \u0dbd\u0dd0\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dad\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u201c\u0d85\u201d \u0dbd\u0dd0\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dbb \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d87\u0dad\u0dd2 \u0dba\u0db8\u0dca \u0d9a\u0dd2\u0dc3\u0dd2\u0dc0\u0dd9\u0dd9\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dad\u0db8\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0db8 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0dd9\ufffd\u0d9a\u0dd4\u0d9c\u0dda\u0118 \u0db1\u0db8 \u0db1\u0dcf\u0dcf\u0db8\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dbb\u0dc0\u0dcf\u0dcf \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dad\u0db6\u0dcf\u0dcf \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0ddd\ufffd\u0ddd\ufffd\u0da0\u0dd2\u0dad \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dad\u0db8\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dad\u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc0\u0dd9\u0dd9\u0db1 \u0d9a\u0dd9\ufffd\u0db1\u0dd9\ufffd\u0d9a\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dcf\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dca\u0db1\u0dda\ufffd \u0db1\u0db8\u0dca \u0d91\u0dc3\u0dda\ufffd\u0dda \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dcf\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0d85\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d92 \u0db6\u0dc0 \u0dba\u0dae\u0ddd\ufffd\u0ddd\ufffd\u0d9a\u0dca\u0dad \u0da1\u0db1\u0dca\u0daf\u0dc4\u0dd2\u0db8\u0dd2\u0dba\u0db1\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0db4\u0db1\u0dad\u0dda\ufffd \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u201c\u0d85\u201d \u0dc3\u0dc4 \u201c\u0d86\u201d\u0d86\u0d9a\u0dd8\u0dd8\u0dad\u0dd2\u0dba\u0da7 \u0dc3\u0dcf\u0dcf\u0dbb\u0dcf\u0dcf\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0db8\u0dd9\ufffd\u0db8 \u0daf\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f 2025 \u0da2\u0dd6\u0dbd\u0dd2 11 \u0daf\u0dd2\u0db1 \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dbb \u0d91\u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0dc3\u0dad\u0dd2 4 \u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0d91\u0db1\u0db8\u0dca 2025 \u0d85\u0d9c\u0ddd\u0ddd\u02c3\u0ddd\ufffd\u0dc3\u0dca\u0dad\u0dd4 \u0db8\u0dc3 07 \u0daf\u0dd2\u0db1 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d8a\u0da7 \u0db4\u0dd9\u0dd9\u0dbb \u0db8\u0dda\ufffd \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd6 \u0dc3\u0dd1\u0dd1\u0db8 \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0db8\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0dca\u0db8 \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd3 (\u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba) \u0dc0\u0dd9\u0dd9\u0dad \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba.",
