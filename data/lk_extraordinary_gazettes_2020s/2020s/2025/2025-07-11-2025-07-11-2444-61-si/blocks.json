    "text": "03. \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0dc0\u0dd6 \u0da1\u0db1\u0dca\u0daf\u0dc4\u0dd2\u0db8\u0dd2 \u0db1\u0dcf\u0dcf\u0db8\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u201c\u0d86\u201d \u0dbd\u0dd0\u0dd0\u0dba\u0dd2\u0dc3\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda \u0dad\u0db8\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0db1\u0db8 \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca\u0dc0 \u0d87\u0dad\u0dca\u0dad\u0dcf\u0dcf\u0dc0\u0dd6 \u0dba\u0db8\u0dca",
