    "text": "\u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0baa\u0bbe\u0bc8\u0ba4; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u0bc6\u0ba4\u0b95\u0ba8\u0bcd\u1f90 \u0b95\u0ba8\u0bcd\u1f90\u0bb0 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba8\u0bc0\u0b9f\u0bcd\u1fac\u0b9f\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f \u0ba4\u0bb0\u0bcd\u0bae\u0bb5\u0b99\u0bcd\u0b9a \u0b8f\u0b95\u0bcd\u0b95\u0ba9\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u0bc6\u0ba4\u0b95\u0ba8\u0bcd\u1f90 \u0b95\u0ba8\u0bcd\u1f90\u0bb0 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba8\u0bc0\u0b9f\u0bcd\u1fac\u0b9f\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f \u0ba4\u0bb0\u0bcd\u0bae\u0bb5\u0b99\u0bcd\u0b9a \u0b8f\u0b95\u0bcd\u0b95\u0ba9\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0b8f.\u0baa\u0bbf.\u0b8e\u0bb8\u0bcd. \u0baa\u0bbe\u0bb2\u0b9a\u0bc2\u0bbe\u0bbf\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b9a\u0bc0.\u0b9f\u0bc0.\u0baa\u0bbf\u0bb0\u0ba9\u0bbe\u0ba8\u0bcd\u1f90 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1 : \u0ba8\u0bc0\u0b9f\u0bcd\u1fac\u0b9f\u0bcd \u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f \u1faa\u0b9f\u0bcd\u1f8c\u0ba4\u0bcd\u0bc7\u0ba4\u0bbe\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0ba4\u0bb0\u0bcd\u0bae\u0bb5\u0b99\u0bcd\u0b9a \u0b8f\u0b95\u0bcd\u0b95\u0ba9\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0b8f.\u0baa\u0bbf.\u0b8e\u0bb8\u0bcd. \u0baa\u0bbe\u0bb2\u0b9a\u0bc2\u0bbe\u0bbf\u0baf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b9a\u0bc0.\u0b9f\u0bc0.\u0baa\u0bbf\u0bb0\u0ba9\u0bbe\u0ba8\u0bcd\u1f90 \u0b95\u0bbe\u0ba3\u0bbf \u1f97\u0ba9\u0bb0\u0bc8\u0bae\u0baa\u0bcd\u1f97 \u0bc6\u0b95\u0bbe\u0bae\u0bbf\u0b9a\u0ba9\u0bcd \u0b9a\u0bc8\u0baa \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0b