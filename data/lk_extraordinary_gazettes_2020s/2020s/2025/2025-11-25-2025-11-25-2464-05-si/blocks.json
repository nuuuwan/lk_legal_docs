    ],
    "text": "8.1 \u0286\u025c\u0db4\u0dcf \u0db8\u029a\u0dc0, \u026a\u0279\u0dcf\u0db8 \u0dc1\u0dcf\u0dbd\u0dcf \u021d\u0dd9\u01ca\u0dc1\u0dba\u01e6\u028f \u0dd9\u0db8\u01e6\u0db8 \u0d9c\u0db8\u01e6 \u0db8\u0dcf\u0259\u0d9c\u0dd9\u024f \u0daf \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0dd9\u0dc0\u0dc5\u0db3\u0dcf\u0db8 \u0dad\u0dc4\u0db1\u023c\u0dba. 8.2 \u0db8\u026a\u0286\u01e6 \u0dd9\u0dc4\u02a4 \u0db6\u0dbd\u0dba\u0dbd\u01ae \u01e7\u0dbd\u0db0\u0dcf\u025c\u0dba\u00fd \u026a\u0286\u01e6 \u0d85\u0dc0\u0dc3\u0dbb \u01d0\u01e6 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dc0\u0dbd \u0dc4\u0dd0\u0dbb \u021b\u0da2\u0dcf \u0db7\u0dcf\u019c\u0da9, \u021b\u0da2\u0dcf \u0dc0\u0178\u0179, \u0d86\u0dc4\u0dcf\u0dbb \u01d6\u0dc0\u0255 \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u01d6\u0dc0\u0255 \u0d85\u0dd9\u0dbd\u026a \u0dd9\u0db1\u02a3\u0d9a\u0dc5\u00ab\u0252\u01b1\u0250. 8.3 \u0db8\u01ae\u0db4\u0dd0\u01e6, \u01d0\u023c\u0dc0\u0dd0\u0179 \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0db1\u01ae \u00fb\u0286\u01d0 \u0db8\u01ae\u01d6\u0dc0\u0255\u0dba\u00fa \u0d9c\u0db8\u01e6 \u0db8\u0dcf\u0259\u0d9c\u0dc0\u0dbd \u025a\u0dd9\u0d9c\u0db1\u0dba\u0dcf\u0db8 \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0dc5\u0db3\u0dc3\u0dd0\u0262\u0dc0\u0dbd \u0dad\u0db6\u0dcf \u0d9c\u0dd0\u01e8\u0db8, \u026a\u00fb\u019e\u0db8, \u023d\u0dbd\u01cf \u0d9c\u0dd0\u01e8\u0db8 \u0dd9\u0dc4\u02a4 \u0db7\u0dcf\u026a\u0dad\u0dcf \u00fb\u025d\u0db8 \u0dad\u0dc4\u0db1\u023c\u0dba. 8.4 \u0218\u026a\u0288\u023c \u0db8\u0dcf\u0259\u0d9c\u0dba\u01e6\u028f \u0dd9\u0daf\u0db4\u0dc3 \u0d85\u0dc0\u0dc3\u0dbb \u01cf \u0d87\u01af \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dc0\u0dbd \u0dc4\u0dd0\u0dbb \u00fb\u0286\u01d0 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0263\u0d9a \u0dd9\u0dc4\u02a4 \u0dc3\u0dca\u01c2\u0dbb \u0dd9\u0dc0\u0dc5\u0db3\u0dc3\u0dd0\u0262 \u0dad\u0dd0\u01e8\u0db8 \u0dd9\u0dc4\u02a4 \u0db4\u0dc0\u01ae\u0dc0\u0dcf\u0dd9\u0d9c\u0db1 \u0dba\u0dcf\u0db8 \u0dd9\u0dc4\u02a4 \u0dd9\u0dc0\u0dc5\u0db3\u0dcf\u023c \u00fb\u025d\u0db8 \u0dd9\u0db1\u02a3\u0d9a\u0dc5\u00ab\u0252\u01b1\u0dba. 8.5 \u0dc3\u0dd1\u0db8 \u0dd9\u0dc0\u0dc5\u0db3\u0dc3\u0dd0\u0dbd\u0d9a\u0db8, \u0dc3\u0dd1\u0db8 \u0dd9\u0d9c\u02a3\u0da9\u0db1\u0dd0\u0119\u0262\u0dbd\u0d9a\u0db8 \u0d9a\u0dc3\u0dc5 \u0db6\u01ff\u01e6 \u0dad\u0dd0\u022a\u0dba \u0252\u01b1 \u0d85\u0dad\u0dbb \u0d85\u0db4\u01d6\u0dc0\u0255 \u0286\u0dba\u0262\u0dbd \u0d91\u028f \u0db6\u0dc4\u0dcf\u0263\u0dba \u0252\u01b1\u0dba. 8.6 \u026a\u00fb\u019e\u0db8\u0da7 \u0dad\u0db6\u0dcf \u0d87\u01af \u0286\u0dba\u0265 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dc5\u00ab\u0d86\u0dc4\u0dcf\u0dbb \u01d6\u0dc0\u0255 \u0db8\u0dd0\u0dc3\u0dca\u0dc3\u01e6\u0dd9\u0d9c\u01e6 \u0d86\u0dbb\u00fa\u0dc2\u0dcf \u0dc0\u0db1 \u0db4\u025c\u01ce \u0d86\u0dc0\u0dbb\u0dab\u00ab\u0dc3\u028f\u0dad\u0dc0 \u0dbb\u0db3\u0dc0\u0dcf \u0dad\u0dd0\u022a\u0dba \u0252\u01b1\u0dba. 8.7 \u0daf\u01e6\u0dc3\u0dd0\u0262 \u0dbd\u0db6\u0dcf\u01cf\u0dd9\u023c\u01cf \u0d91\u0db8 \u0d9a\u0dcf\u0dbd\u0dba \u01b1\u0dc5 \u0db4\u0dc0\u01af\u0db1 \u0dd9\u0dc3\u02a5\u0d9b\u0255 \u0dad\u01ae\u01ae\u0dc0\u0dba\u01e6\u0da7 \u0d85\u01e9\u00fe\u0dbd\u0dc0 \u0d91\u0dba \u0d9a\u0dc5\u00ab\u0252\u01b1 \u0d85\u0dad\u0dbb \u0d92 \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dcf\u0dd9\u0118 \u0dd9\u0dc4\u02a4 \u0db6\u0dbd\u0dba\u0dbd\u01ae \u01e7\u0dd9\u0dba\u02a4\u014f\u0dad\u0dd9\u0dba\u00fd\u0dd9\u0118 \u021b\u0259\u0dc0 \u0d85\u0dc0\u0dc3\u0dbb\u0dba \u0263\u0110\u0dad\u0dc0 \u0dbd\u0db6\u0dcf\u0d9c\u0dad \u0252\u01b1\u0dba.",
