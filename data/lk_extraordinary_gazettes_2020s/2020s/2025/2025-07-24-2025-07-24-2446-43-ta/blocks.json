    "text": "10. \u0b86\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0bc7\u0ba8\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bcd \u0b95\u0b9f\u0ba9\u0bcd\u0b95\u0bc8\u0bb3\u0b95\u0bcd \u0ba8\u0bbf\u0bc8\u0bb1\u0bc7\u0bb5\u0bb1\u0bcd\u0bb1\u0bbf\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0bb5\u1f9e\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b89\u0bb4\u1fab \u0b87\u0baf\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bb5\u0bbe\u0b95\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bb5\u1f9e\u0bae\u0bcd \u1f91\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bbe\u0bb5\u1f8a\u0b95\u0bb3\u0bcd \u0b86\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u1f99\u0ba9\u0bcd\u0baa\u0bbe\u0b95 \u0baa\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd\u1f90\u0bc8\u0bb1\u1faa\u0ba4\u0bbf \u0bb5\u0bb4\u0bbf\u0baf\u0bbf\u1f95\u0b9f\u0bbe\u0b95 \u0bae\u0b9f\u0bcd\u1f8c\u0bc7\u0bae \u0b89\u0bb3\u0bcd\u1f92\u0bc8\u0bb4\u0baf \u1f99\u1f8a\u1f9c\u0bae\u0bcd. \u0b85\u0bb5\u0bcd\u0bb5\u0bbe\u1fa0 \u0bb5\u1f9e\u0b95\u0bbf\u0ba9\u0bcd\u0bb1 \u0b95\u0bbe\u0bb5\u1f8a\u0b95\u0bb3\u0bcd \u0baa\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd\u1f90\u0bc8\u0bb1\u1faa\u0ba4\u0bbf \u0bb8\u0bcd\u0bb0\u0bc0 \u1f99\u1f9e\u0b95\u0ba9\u0bcd \u0ba4\u0ba3\u0bcd\u0ba3\u0bc0\u0bb0\u0bcd \u0baa\u0ba8\u0bcd\u0ba4\u1fa4\u0b95\u0bcd\u0b95\u0bc1 \u1f99\u0ba9\u0bcd \u0b87\u0bb1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90\u0bae\u0bcd \u1f91\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bb5\u1f8a \u0bb5\u0bbe\u0b95\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bc8\u0ba9\u0ba4\u0bcd\u1f90\u0bae\u0bcd \u0bc6\u0b9a\u0b9f\u0bcd\u1f8a\u0ba4\u0bcd\u0bc6\u0ba4\u1f9e\u1faa\u0ba4\u0bbf \u0bb5\u0bb4\u0bbf\u0baf\u0bbe\u0b95 \u0bc6\u0bb5\u0bd7\u0bbf\u0bc7\u0baf\u1fa0\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0b92\u1fa8\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bcd \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u1f8c\u0bae\u0bcd.",
