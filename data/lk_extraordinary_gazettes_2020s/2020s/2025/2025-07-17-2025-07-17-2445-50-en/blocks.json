  },
  {
    "page_number": 0,
    "bbox": [
      50.9,
      476.28,
      286.38,
      539.13
    ],
    "text": "I hereby give notice, under Sub Section (1) of Section 7 of the Land Acquisition Act, as Amended by the Land Acquisition (Amendment) Act, No. 28 of 1964 that the Government intends to acquire the following land / servitude which is required for the public purpose.",
    "fonts": [
      "Times New Roman"
    ],
    "sizes": [
      9.0,
      9.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.9,
      538.67,
      286.37,
      634.55
    ],
    "text": "Description of the land/servitude* to be acquired : Following allotment of land depicted in Cadastral Plan bearing No. 820167 situated in the Village of Jamburegoda West in the Divisional Secretary\u2019s Division of Welipitiya in the District of Matara is required to acquisition for building of Penetiyana West Sewa Piyasa.",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Italic"
    ],
    "sizes": [
      9.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.9,
      634.09,
      286.48,
      687.47
    ],
    "text": "01. Lot No. : 01 Name of land: Godawatta; Description of the Land: There is a garden, a permanent building and a toilet;",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Bold"
    ],
    "sizes": [
      9.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.51,
      415.4,
      539.93,
      447.66
    ],
    "text": "Claimant: Late Wickramathunga Achchi Pathiranage Magilin of Godawatta, Penetiyana, Weligama; Extent: 1.0111 Hectare.",
    "fonts": [
      "Times New Roman"
    ],
    "sizes": [
      9.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.51,
      447.2,
      539.92,
      613.86
    ],
    "text": "All persons interested in the aforesaid land servitude is to be acquired are hereby required to appear personally, or by agents duly authorized in writing, before me at Divisional Secretariat of Welipitiya on the 27th day of February, 2026 at 10.00 a.m. and are hereby requested to notify to me in writing (in duplicate) on or before the 13th day of February 2026 the nature of their interests in the land, the particulars of their claims for compensation for the acquisition of the said land /servitude the amount of compensation and the details of the computation of such amount.",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Bold"
    ],
    "sizes": [
      6.480000019073486,
      6.960000038146973,
      9.960000038146973
    ]
  },
