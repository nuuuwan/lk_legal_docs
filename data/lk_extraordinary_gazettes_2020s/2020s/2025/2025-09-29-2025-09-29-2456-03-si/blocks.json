    "text": "\u0d8b\u01b1\u025e \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1 \u0287\u0db8\u0dcf\u0dc0\u01e6 \u01b1\u0dc5 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0dc0\u0db1 \u0287\u0db8\u0dcf \u0dc3\u028f\u0dad \u026a\u026a\u0db0 \u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u0dc3\u023f\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af, \u0dad\u0262 \u0dc3\u0dc4 \u0dd9\u0db4\u02a3\u0262 \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0dc3\u023f\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u0dc3\u0dc4 \u021d\u0dcf\u0dd9\u01ca\u0274\u0d9a \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0dc0\u0db1 \u0d85\u0dd9\u0db1\u00fd\u01ae \u021d\u0dcf\u0dae\u023d\u0d9a \u0db8\u0178\u0da7\u0dd9\u023c \u0dc3\u023f\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u026a\u0286\u01e6 \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u0d9a\u0dbb \u0d87\u01af \u0d85\u01b1\u025e \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbd \u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u0db8\u0119\u01e6 \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u021d\u0d9a\u0dcf\u0dbb\u0dc0, \u0d8b\u01b1\u025e \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0dc3\u023f\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0dc3\u0dc4 \u0dc3\u023f\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u0dd9\u0dbb\u014f\u0dc3\u0dca\u017e\u0dcf\u0259 \u0db1\u0da9\u0dbb\u0dcf\u0da2\u0dcf \u01af\u025e\u0263\u0d82\u0d9c\u0db1\u0dcf\u0daf\u01e6 \u0dc0\u0db1 \u0db8\u0db8, 1977.12.28 \u01ce\u0db1\u0dd0\u01af \u0d85\u0d82\u0d9a 297/7 \u0dc3\u0dc4 1998.5.19 \u01ce\u0db1\u0dd0\u01af \u0d85\u0d82\u0d9a 1028/06 \u0daf\u0dbb\u0db1 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a \u0dd9\u0dc1\u02a2\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u0db8\u0119\u01e6 \u021d\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u021d\u0dcf\u0dd9\u01ca\u0274\u0d9a \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf \u0dd9\u0dad\u02a4\u0dbb\u0dcf \u0d9c\u0dd0\u01e8\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u01e7\u0dd9\u0dba\u02a4\u0d9c 2025.08.15 \u01ce\u0db1 \u0286\u0da7 \u0db6\u0dbd\u0db4\u0dd0\u0dc0\u0dd0\u01ae\u0dd9\u0dc0\u0db1 \u0db4\u025c\u01ce \u0d8b\u01b1\u025e \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0db6\u0dbd \u021d\u0dd9\u01ca\u0dc1\u0dba \u01b1\u0dc5 \u0db6\u0dbd \u0dd9\u0db1\u02a3\u0db4\u0dd0\u0dc0\u0dd0\u01ae\u0dd9\u0dc0\u0db1 \u0db6\u0dc0 \u0dd9\u0db8\u0250\u01e6 \u021d\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u023d. \u0d92 \u0dd9\u0dc0\u01e9\u0dc0\u0da7, \u0db4\u0dc4\u0dad \u0daf\u00fa\u0dc0\u0dcf \u0d87\u01af \u01e8\u01af 01 \u0286\u0da7 24 \u0daf\u00fa\u0dc0\u0dcf 2025.08.15 \u01ce\u0db1 \u0286\u0da7 \u0db6\u0dbd \u0db4\u0dd0\u0dc0\u0dd0\u01ae\u0dd9\u0dc0\u0db1 \u0db4\u025c\u01ce \u0db6\u0dbd\u0dcf\u01ae\u0db8\u0d9a \u0dd9\u0269.",
    "fonts": [
