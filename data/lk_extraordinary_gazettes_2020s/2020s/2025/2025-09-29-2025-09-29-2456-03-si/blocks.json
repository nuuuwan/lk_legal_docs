    ],
    "text": "\u0d91\u01e6. \u01af\u025e\u0263\u0d82\u0d9c\u0db1\u0dcf\u0daf\u01e6,\u0d91\u01e6. \u01af\u025e\u0263\u0d82\u0d9c\u0db1\u0dcf\u0daf\u01e6, \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0dc3\u0dc4 \u0dc3\u0240\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u0dd9\u0dbb\u014f\u0dc3\u0dca\u017e\u0dcf\u0259, \u0d8b\u01b1\u025e \u0db4\u0dc5\u0dcf\u0dad, \u0dba\u0dcf\u0db4\u0db1\u0dba.1. \u0265\u0291\u01a8 \u0db1\u0dcf\u0db8\u0dba \u0287\u0db8\u0dcf \u0dc3\u028f\u0dad \u026a\u026a\u0db0\u0dd9\u0dc3\u02a2\u0dc0\u0dcf \u0dc3\u023f\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af, \u0dad\u0262 \u0dc3\u0dc4 \u0dd9\u0db4\u02a3\u0262 \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0dc3\u023f\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af \u0dc3\u0dc4 \u0d8b\u01b1\u025e \u0db4\u0dc5\u0dcf\u0dad \u01b1\u0dc5 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0dc0\u0db1 \u021d\u0dcf\u0dd9\u01ca\u0274\u0d9a \u0db8\u0dc4 \u0dc3\u0db7\u0dcf \u0dc3\u028f\u0dad \u021d\u0dcf\u0dae\u023d\u0d9a \u0dc3\u023f\u0db4\u0d9a\u0dcf\u0dbb \u0dc3\u023d\u01af\u0dc0\u0dbd \u021d\u0dcf\u0dd9\u01ca\u0274\u0d9a \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf \u01e7\u0dd9\u0dba\u02a4\u014f\u0dad\u0250\u01e6 \u0dd9\u0dad\u02a4\u0dbb\u0dcf \u0d9c\u0dd0\u01e8\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u01e7\u0dd9\u0dba\u02a4\u0d9c \u0dd9\u0dbd\u0dc3 \u0dc4\u01ff\u01e6\u0dc0\u01e9 \u0dbd\u0dd0\u0dd9\u0229.",
