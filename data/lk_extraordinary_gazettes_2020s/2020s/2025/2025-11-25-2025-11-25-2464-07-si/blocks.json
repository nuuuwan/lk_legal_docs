u0dc4\u0dd2\u0dcf\u0dba, \u0d9a\u0dbd\u0db4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dba\u0dda \u0dbb\u0dda\u0db1\u0dcf \u0dba\u0dc4\u0dda\u0db8\u0dbd\u0dcf\u0dcf \u0d9a\u0dd4\u0dbd\u0dbb\u0dda\u0db1\u0dba\u0dda \u0da2\u0dd3\u0dc0\u0dd2\u0dcf \u0db7\u0dd4\u0d9a\u0dca\u0d9a\u0dba\u0dad\u0dd2\u0dba\u0da7 \u0dba\u0da7\u0dda\u0dc0 1 : 118 0.0313 \u0da0\u0dd2\u0dca\u0dad\u0dad\u0dd2\u0d9a\u0dcf \u0da2\u0dcf\u0dba\u0dbb\u0dda\u0db1 \u0dba\u0db1\u0ddc\u0dba\u0dc4\u0ddc\u0dda 785550242V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0.\u0d9a 121 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dad\u0dd2\u0dbb\u0dcf\u0da2\u0dcf \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0d9a\u0d82\u0d9a 31/06, \u0db4\u0dc5\u0dc0\u0db1 \u0db4\u0db8\u0d9c\u0db8\u0d9c , \u0dc3\u0dc4\u0dd2\u0dcf\u0dba \u0d9a\u0dd2\u0dbd\u0db4\u0dc5\u0db4\u0db1. 1 : 124 0.0422 \u0dba\u0db8\u0dba\u0dc4\u0ddc\u0db8\u0da9\u0dca \u0d8b\u0dc0\u0dba\u0dd2\u0dc3\u0dca \u0dba\u0db8\u0ddc\u0dba\u0dc4\u0ddc\u0db8\u0da9\u0dca 863622662V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0db8\u0dcf\u0db1\u0dcf \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0dcf\u0db6\u0dcf \u0d89\u0db8\u0dca\u0dc3\u0dcf\u0dca\u0dad \u0d87\u0dad\u0dd2 \u0d9a\u0d82\u0d9a 2216 - \u0d9a\u0d82\u0d9a 06/04, 12 , 2024/11/26 \u0daf\u0dbb\u0db1 \u0d87\u0dba\u0dbd\u0d9a\u0dca\u0d9a\u0dba\u0dc3\u0dd0\u0dca\u0dad\u0da9\u0dca\u200d\u0dbb\u0dcf \u0db8\u0dcf\u0dc0\u0dcf, \u0dba\u0d9a\u0ddc\u0dc5\u0db9 06. \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dda\u0dc0, \u0d9a\u0dd0.\u0d9a 121 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0dc4\u0dd2\u0dcf\u0dba 1 : 137 0.0138 \u0dc6\u0dcf\u0dad\u0dd2\u0db8\u0dcf \u0d9a\u0dc2\u0dca\u0dbb\u0dcf \u0dc0\u0dc3\u0dd3\u0dbb\u0dca 198584804278 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba 2025.04.23 \u0dc3\u0dd2\u0daf\u0da7 \u0d9a\u0d82\u0d9a 29/1\u0d92 , 1/1, \u0db4\u0dca\u0dad\u0dc3\u0dbd 2027.04.22 \u0daf\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0dcf \u0db4\u0dcf\u0dbb, \u0d9a\u0dc5\u0dd4\u0dba\u0db6\u0ddd\u0dc0\u0dd2\u0dbd. \u0db6\u0dbd\u0db4\u0dd0\u0dc0\u0dd0\u0dda\u0dba\u0dc0\u0db1 \u0dba\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0dd2\u0dba\u0da7\u0dca \u0dcf\u0dc4\u0db1\u0db8\u0da7 \u0dba\u0da7\u0dda\u0dc0,\u0d9a\u0dd0.\u0d9a 121\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0dc4\u0dd2\u0dcf\u0dba 1 : 138 0.0050 \u0dc6\u0dcf\u0dad\u0dd2\u0db8\u0dcf \u0d9a\u0dc2\u0dca\u0dbb\u0dcf \u0dc0\u0dc3\u0dd3\u0dbb\u0dca 198584804278 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba 2025.04.23 \u0dc3\u0dd2\u0daf\u0da7 \u0d9a\u0d82\u0d9a 29/01 \u0d92, \u0d9a\u0dc5\u0dd4\u0dba\u0db6\u0ddd\u0dc0\u0dd2\u0dbd. \u0db6\u0dbd\u0db4\u0dd0\u0dc0\u0dd0\u0dda\u0dba\u0dc0\u0db1 \u0dba\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0dd2\u0dba\u0da7\u0dca \u0dcf\u0dc4\u0db1\u0db8\u0da7 \u0dba\u0da7\u0dda\u0dc0,\u0d9a\u0dd0.\u0d9a 121 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0dc4\u0dd2\u0dcf\u0dba 1 : 139 0.0050 \u0dc6\u0dcf\u0dad\u0dd2\u0db8\u0dcf \u0d9a\u0dc2\u0dca\u0dbb\u0dcf \u0dc0\u0dc3\u0dd3\u0dbb\u0dca 198584804278 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba 2025.04.23 \u0dc3\u0dd2\u0daf\u0da7 \u0d9a\u0d82\u0d9a 29/1\u0d92 , 1/1 , \u0db4\u0dca\u0dad\u0dc3\u0dbd 2027.04.22 \u0daf\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0dcf \u0db4\u0dcf\u0dbb, \u0d9a\u0dc5\u0dd4\u0dba\u0db6\u0ddd\u0dc0\u0dd2\u0dbd. \u0db6\u0dbd\u0db4\u0dd0\u0dc0\u0dd0\u0dda\u0dba\u0dc0\u0db1 \u0dba\u0d9a\u0dca\u0d9a\u0dba\u0dc0\u0dd2\u0dba\u0da7\u0dca \u0dcf\u0dc4\u0db1\u0db8\u0da7 \u0dba\u0da7\u0dda\u0dc0 1 : 141 0.0463 \u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0d9a\u0dbb\u0dc0\u0db1 \u0db4\u0da7\u0db6\u0dd0\u0daf\u0dd2\u0dba\u0dda \u0d86\u0db1\u0dca\u0dad\u0daf 650532082V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dc3\u0dd2\u0daf\u0da7\u0dd2\u0dc3\u0dca\u0dad \u0dd2\u0dc0\u0dc0\u0dba\u0dbd\u0ddc\u0dda\u0db8\u0dca\u0dad\u0da7\u0dca \u0d9a\u0db8\u0dbb\u0db1\u0dcf\u0dba\u0d9a \u0db6\u0dd2\u0dc3\u0dca\u0db1\u0dc3\u0dca \u0dc6\u0dd2\u0db1\u0dd1\u0dca\u0dad\u0dc3\u0dca 31/1 \u0da9\u0dd3, \u0db4\u0dc5\u0dc0\u0db1 \u0db4\u0db8\u0d9c\u0db8\u0d9c, \u0db4\u0dd3.\u0d91\u0dbd\u0dca.\u0dc3\u0dd3 \u0d86\u0dba\u0dcf\u0db1\u0dba\u0da7 \u0d9a\u0dd2\u0dbd\u0db4\u0dc5\u0db4\u0db1, \u0dba\u0d9a\u0ddc\u0dc5\u0db9 05. \u0dcf\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d9a\u0d82\u0d9a 570 - 2019.09.17 \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dda\u0dc0, \u0d9a\u0dd0.\u0d9a 121 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0dc4\u0dd2\u0dcf\u0dba 1 : 149 0.0493 \u0da2\u0dcf\u0dba\u0dad\u0dd2\u0dbd\u0d9a \u0dbd\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dca\u0db8\u0dca\u0dad \u0dc3\u0dd4\u0db1\u0dd2\u0dbd\u0dca \u0dba\u0db4\u0dca\u200d\u0dbb\u0dda\u0db8\u0dca 463591784V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0.\u0d9a 154 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0d82\u0d9a 23, \u0db4\u0dc5\u0db8\u0dd4 \u0db4\u0db8\u0d9c\u0db8\u0d9c, \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0dc4\u0dd2\u0dcf\u0dc0 \u0d9a\u0dd2\u0dbd\u0db4\u0dc5\u0db4\u0db1, \u0dba\u0d9a\u0ddc\u0dc5\u0db9 05. EOG 11 - 0187/2",
