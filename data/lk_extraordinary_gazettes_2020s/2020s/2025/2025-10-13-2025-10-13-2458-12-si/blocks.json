    "text": "1978 \u0d85\u0d82\u0d82\u0d9a 16 \u0daf\u0dbb\u0db1 \u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dbd \u0db4\u0db1\u0dad\u0dda\u01ae 25\u0d85 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0d9a\u0dd2\u0dba\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 27(1)(\u0d86) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb, \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db4\u0db1, \u0d8b\u0dc3\u0dc3\u0dca \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db4\u0db1 \u0dc4\u0dcf\u0dcf \u0dc0\u0dd8\u0dd8\u0dad\u0dca\u0dad\u0dd3\u0dba \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db4\u0db1 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba \u0d86\u0da0\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0dc4\u0dbb\u0dd2\u0db1\u0dd2 \u0d85\u0db8\u0dbb\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0dc0\u0db1 \u0db8\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca, 2007 \u0d85\u0d82\u0d82\u0d9a 7 \u0daf\u0dbb\u0db1 \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8\u0dca \u0db4\u0db1\u0dad \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dbb \u0d87\u0dad\u0dd2, \u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2 \u0d85\u0d82\u0d82\u0d9a \u0db4\u0dd3. \u0dc0\u0dd3. 17745 \u0daf\u0dbb\u0db1 \u0d8b\u0db4\u0dcf\u0dcf\u0db0\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dcf\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dca \u0dbd\u0dd9\ufffd\u0dc3 \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d9a\u0dbd\u0db8\u0dca\u0db6\u0dd4 \u0d89\u0db1\u0dca\u0da7\u0dbb\u0dca\u0db1\u0dd0\u0dd0\u0dc2\u0db1\u0dbd\u0dca \u0db1\u0ddd\ufffd\u0ddd\ufffd\u0da7\u0dd2\u0d9a\u0dbd\u0dca \u0d87\u0db1\u0dca\u0da9\u0dca \u0d89\u0db1\u0dca\u0da2\u0dd2\u0db1\u0dd2\u0dba\u0dbb\u0dd2\u0db1\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0dbd\u0dda\ufffd\u0da2\u0dca (\u0db4\u0dca\u200d\u0dbb\u0dba\u0dd2\u0dc0\u0da7\u0dca) \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0db4\u0db1\u0dad\u0dda\u01ae 70\u0d87 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dcf\u0dc0\u0d9a\u0dca \u0dbd\u0db6\u0dcf\u0dcf \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dc3\u0dd4, \u0dc3\u0dc4 \u0d91\u0d9a\u0dd3 \u0d9a\u0dbd\u0db8\u0dca\u0db6\u0dd4 \u0d89\u0db1\u0dca\u0da7\u0dbb\u0dca\u0db1\u0dd0\u0dd0\u0dc2\u0db1\u0dbd\u0dca \u0db1\u0ddd\ufffd\u0ddd\ufffd\u0da7\u0dd2\u0d9a\u0dbd\u0dca \u0d87\u0db1\u0dca\u0da9\u0dca \u0d89\u0db1\u0dca\u0da2\u0dd2\u0db1\u0dd2\u0dba\u0dbb\u0dd2\u0db1\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0dbd\u0dda\ufffd\u0da2\u0dca (\u0db4\u0dca\u200d\u0dbb\u0dba\u0dd2\u0dc0\u0da7\u0dca) \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8 2019 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0db8\u0dc3 23 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0daf\u0dbb\u0db1 \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8\u0dca \u0dbb\u0dd9\u0dd9\u0da2\u0dd2\u0dc3\u0dca\u0da7\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dbb\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0dc3\u0dc4\u0dad\u0dd2\u0d9a\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc3\u0dd2\u0db1\u0dd9\ufffd\u0d9a\u0dca \u0d9a\u0dd0\u0dd0\u0db8\u0dca\u0db4\u0dc3\u0dca (\u0db4\u0dca\u200d\u0dbb\u0dba\u0dd2\u0dc0\u0da7\u0dca) \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0d9c\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db6\u0dd0\u0dd0\u0dc0\u0dd2\u0db1\u0dca\u0daf, \u0db8\u0dd9\ufffd\u0db8 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca, \u0d91\u0d9a\u0dd3 \u0db4\u0db1\u0dad \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc3\u0dcf\u0dcf\u0daf\u0db1 \u0dbd\u0daf 2013 \u0da2\u0dd6\u0dbd\u0dd2 \u0db8\u0dc3 09 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 1818/7 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u200d\u200d\u0dc1\u0dd9\ufffd\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd2\u0dba\u0db8\u0dba\u0dda\u0dda\u024f \u0d9a\u0dbd\u0db8\u0dca\u0db6\u0dd4 \u0d89\u0db1\u0dca\u0da7\u0dbb\u0dca\u0db1\u0dd0\u0dd0\u0dc2\u0db1\u0dbd\u0dca \u0db1\u0ddd\ufffd\u0ddd\ufffd\u0da7\u0dd2\u0d9a\u0dbd\u0dca \u0d87\u0db1\u0dca\u0da9\u0dca \u0d89\u0db1\u0dca\u0da2\u0dd2\u0db1\u0dd2\u0dba\u0dbb\u0dd2\u0db1\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0dbd\u0dda\ufffd\u0da2\u0dca (\u0db4\u0dca\u200d\u0dbb\u0dba\u0dd2\u0dc0\u0da7\u0dca) \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8 \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0dc3\u0dd1\u0dd1\u0db8 \u0dad\u0dd0\u0dd0\u0db1\u0d9a\u0db8 \u0d92 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u201c\u0dc3\u0dd2\u0db1\u0dd9\ufffd\u0d9a\u0dca \u0d9a\u0dd0\u0dd0\u0db8\u0dca\u0db4\u0dc3\u0dca (\u0db4\u0dca\u200d\u0dbb\u0dba\u0dd2\u0dc0\u0da7\u0dca) \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca\u201d \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0d86\u0daf\u0dda\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0d92 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0d9c\u0dba \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\ufffd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0dad\u0dbb \u0d89\u0dc4\u0dad \u0d9a\u0dd3 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb \u0db8\u0dd2\u0db1\u0dca \u0db4\u0dd9\u0dd9\u0dbb \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6 \u0d87\u0dad\u0dd2 \u0dba\u0db8\u0dca \u0db1\u0dd2\u0dba\u0db8\u0dba\u0d9a, \u0daf\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0d9a, \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8\u0d9a, \u0dc3\u0db1\u0dca\u0db1\u0dd2\u0dc0\u0dda\u0dda\u0dda\u0daf\u0db1\u0dba\u0d9a \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0d9a \u201c\u0d9a\u0dbd\u0db8\u0dca\u0db6\u0dd4 \u0d89\u0db1\u0dca\u0da7\u0dbb\u0dca\u0db1\u0dd0\u0dd0\u0dc2\u0db1\u0dbd\u0dca \u0db1\u0ddd\ufffd\u0ddd\ufffd\u0da7\u0dd2\u0d9a\u0dbd\u0dca \u0d87\u0db1\u0dca\u0da9\u0dca \u0d89\u0db1\u0dca\u0da2\u0dd2\u0db1\u0dd2\u0dba\u0dbb\u0dd2\u0db1\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0dbd\u0dda\ufffd\u0da2\u0dca (\u0db4\u0dca\u200d\u0dbb\u0dba\u0dd2\u0dc0\u0da7\u0dca) \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca \u0dc3\u0db8\u0dcf\u0dcf\u0d9c\u0db8\u201d \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d87\u0dad\u0dd2 \u0dc3\u0dd1\u0dd1\u0db8 \u0dc3\u0db3\u0dc4\u0db1\u0d9a\u0dca\u0db8 \u201c\u0dc3\u0dd2\u0db1\u0dd9\ufffd\u0d9a\u0dca \u0d9a\u0dd0\u0dd0\u0db8\u0dca\u0db4\u0dc3\u0dca (\u0db4\u0dca\u200d\u0dbb\u0dba\u0dd2\u0dc0\u0da7\u0dca) \u0dbd\u0dd2\u0db8\u0dd2\u0da7\u0da9\u0dca\u201d \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u200d\u200d\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0db3\u0dc4\u0db1\u0d9a\u0dca \u0dbd\u0dd9\ufffd\u0dc3 \u0d9a\u0dd2\u0dba\u0dc0\u0dcf\u0dcf \u0dad\u0dda\u01ae\u0dbb\u0dd4\u0db8\u0dca \u0d9c\u0dad \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\u0da7 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0dda\u0229.",
