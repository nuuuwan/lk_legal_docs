    "text": "\u0bc6\u0bb9\u0bb5\u0bbe\u0bc6\u0baa\u0bbe\u0ba9\u0bcd \u0bc7\u0b9a\u0b95\u0bbe\u0bc7\u0b95 \u0b9a\u0bbf\u0ba8\u0bcd\u0ba4\u0b95 \u1f97\u1f97\u1f90 \u0b95\u0bc1\u0b9a\u0bc1\u0bae\u0bcd \u0bb8\u0bcd\u0bb0\u0bc0 \u0bc6\u0baa\u0bbe\u0ba9\u0bcd\u0bc7\u0b9a\u0b95\u0bbe\u0b95\u0bc2\u0b9f\u0bcd\u1f8c\u0bb1\u1fab \u0b85\u0baa\u0bbf\u0bb5\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf \u0b89\u0ba4\u0bb5\u0bbf \u0b86\u0bc8\u0ba3\u0baf\u0bb0\u0bcd (\u0ba4\u0bbf\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd)\u0bc7\u0bae\u0bb2\u0bcd\u0bae\u0bbe\u0b95\u0bbe\u0ba3 \u0bae\u0bbe\u0b95\u0bbe\u0ba3 \u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0ba9\u0bcd 2011 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 04 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0bc2\u0b9f\u0bcd\u1f8c\u0bb1\u1fab\u0b9a\u0bcd \u0b9a\u0b99\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0ba4\u0bbf\u1f9e\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bc8\u0bae\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 1998 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 03 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0bc2\u0b9f\u0bcd\u1f8c\u0bb1\u1fab\u0b9a\u0bcd \u0b9a\u0b99\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bbf\u0baf\u0ba4\u0bbf\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b87\u0bb2. 02(3),4, (4(2) \u0ba4\u0bb5\u0bbf\u0bb0) 5, 6, 7, 8, 33, 43(\u0b85), 43(\u0b86), 44, 45, 46, 47, 50, 52, 53, 54, (54(2)\u0ba4\u0bb5\u0bbf\u0bb0 ) 58(2), 59, 67, 68, 69, 74, 76 \u0b86\u0b95\u0bbf\u0baf \u0baa\u0bbf\u0bbe\u0bbf\u1fab\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bbe\u0bb3\u1f9e\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9 \u0ba4\u0ba4\u0bcd\u1f90\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 1972 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 05 \u0b86\u0bae\u0b