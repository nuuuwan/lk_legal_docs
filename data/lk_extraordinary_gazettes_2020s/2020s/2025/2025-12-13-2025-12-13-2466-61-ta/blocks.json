    ],
    "text": "\u0b85\u0bb5\u1fbd\u0b95\u1fa6\u1fb0\u1f81\u1fc0\u0bb3 \u0b89\u0b9f\u1fb8\u0bc8\u0ba4\u0b95\u0bb3\u0bbf\u1fb9 \u0ba4\u1fb9\u0bc8\u0bae\u0bc8\u0baf\u1f9c\u1fbb \u1f81\u0bb1\u0bbf\u1fb7\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf\u0bc8\u0baf \u0b8e\u1f8c\u1fb7\u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0ba8\u1fb5\u0b9f\u0b88\u1f8c \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0b85\u0bb5\u1fbd\u0b95\u0bb3\u0bbf\u1fb9 \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0b95\u0bb3\u0bbf\u1fb9 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u0bc8\u0bb3\u1f9c\u1fbb \u0ba8\u1fb5\u0b9f \u0b88\u1fb5\u1f8c\u1fb7 \u0bc6\u0ba4\u0bbe\u0bc8\u0b95\u0bc8\u0baf\u1f9c\u1fbb \u0b85\u1fb7\u0bc6\u0ba4\u0bbe\u0bc8\u0b95 \u0b95\u0ba3\u0bbf\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f \u0bb5\u0bbf\u0ba4\u1fb7\u0bc8\u0ba4\u1f9c\u1fbb \u0b87\u0bb0\u1fb6\u1f8c \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0b95\u1fa6\u0b9f\u1fb9 \u0b8e\u1fa8\u1fb7\u0ba4\u0bbe\u0bb5\u0ba3\u1fbb \u0b8a\u0b9f\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0baf\u1fb7\u0ba4\u1f9e\u0ba4\u1fbf \u0bc7\u0bb5\u1fb6\u1f8c\u1fbb \u0b8e\u1fb9\u1fa0\u1fbb \u1f81\u0bb1\u0bbf\u1fba\u0baa\u0bbf\u0b9f\u1fba \u0baa\u1fb5\u1f8c\u1fc0\u0bb3\u1f90. \u0b85\u0ba4\u1fbe\u1f81\u1fba \u0baa\u0ba4\u0bbf\u0bb2\u0bbe\u0b95 2025.12.24 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u1f99\u1fbe\u0baa\u0b95\u1fbf 10.00 \u0bae\u0ba3\u0bbf \u1f99\u0ba4\u1fbf \u1f81\u1f9e\u0ba8\u0bbe\u0b95\u1fbf \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0b95\u1fb7\u0ba4\u0bbf\u1fbf \u0b8e\u1fb9 \u1f99\u1fb9\u0baa\u0bbe\u0b95 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u1f90\u1fbb \u0baa\u1f8a\u1f9c\u1fbb, 2025.12.17 \u0b86\u1fb8 \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u1fb0\u1f81 \u1f99\u1fb9\u0ba9\u1fbd \u0b85\u1fb0\u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u1fbf \u0b85\u0bb5\u1fbd\u0b95\u1fa6\u1fb0\u1f81\u1fc0\u0bb3 \u0b89\u0b9f\u1fb8\u0bc8\u0ba4\u0b95\u0bb3\u0bbf\u1fb9 \u0ba4\u1fb9\u0bc8\u0bae\u0bc8\u0baf\u1f9c\u1fbb \u1f81\u0bb1\u0bbf\u1fb7\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf\u0bc8\u0baf \u0b8e\u1f8c\u1fb7\u0ba4\u1fbe\u0b95\u0bbe\u0ba9 \u0ba8\u1fb5\u0b9f\u0b88\u1f8c \u0baa\u1fbe\u0bb1\u0bbf\u0baf \u0b85\u0bb5\u1fbd\u0b95\u0bb3\u0bbf\u1fb9 \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u1fb0\u0bc8\u0b95\u0b95\u0bb3\u0bbf\u1fb9 \u0bb5\u0bbf\u0baa\u0bb0\u1fb1\u0b95\u0bc8\u0bb3\u1f9c\u1fbb \u0ba8\u1fb5\u0b9f \u0b88\u1fb5\u1f8c\u1fb7 \u0bc6\u0ba4\u0bbe\u0bc8\u0b95\u0bc8\u0baf\u1f9c\u1fbb \u0b85\u1fb7 \u0bc6\u0ba4\u0bbe\u0bc8\u0b95 \u0b95\u0ba3\u0bbf\u1fb0\u0b95\u1fba\u0baa\u1fb5\u0b9f \u0bb5\u0bbf\u0ba4\u1fb7\u0bc8\u0ba4\u1f9c\u1fbb \u0b8e\u0ba9\u1fb0\u1f81 \u0b87\u0bb0\u1fb6\u1f8c \u0baa\u0bbf\u0bb0\u0ba4\u0bbf\u0b95\u1fa6\u0b9f\u1fb9 \u0b8e\u1fa8\u1fb7\u0ba4\u0bbe \u0bb5\u0ba3\u1fb7\u0ba4\u0bbf\u1fbf \u0b85\u0bb1\u0bbf\u0baf\u1fb7\u0ba4\u1f9e\u0ba4\u1fbf \u0bc7\u0bb5\u1fb6\u1f8c\u1fbb \u0b8e\u0ba9 \u0bae\u0bbe\u1fbe\u0bb1\u0bbf \u0baf\u0bc8\u0bae\u1fb7\u1f90 \u0b85\u1fb8\u0ba4 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u1fb7\u0ba4\u1fbf \u0baa\u0bbf\u1fb9\u0bb5\u1f9e\u0bae\u0bbe\u1fa0 \u0ba4\u0bbf\u1f9e\u1fb7\u0ba4\u1fba\u0baa\u1fb5 \u1f8c\u1fc0\u0bb3\u1f90 \u0b8e\u0ba9 \u0b87\u1fb7\u0ba4\u0bbe\u1fbf \u0b85\u0bb1\u0bbf\u0baf\u1fb7\u0ba4\u0bb0\u1fba\u0baa\u1f8c\u0b95\u0bbf\u0bb1\u1f90. \u0ba8\u0bc0\u1fb0\u0b95\u1fba\u0baa\u0b9f \u0bc7\u0bb5\u1fb6\u1f8a\u0baf \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0ba8\u0bc0\u1fb0\u0b95\u1fba\u0baa\u0b9f \u0bc7\u0bb5\u1fb6\u1f8a\u0baf \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u1fb0\u1f81\u1fba \u0baa\u0ba4\u0bbf\u0bb2\u0bbe\u0b95 \u0bae\u0bbe\u1fbe\u0bb1\u0bc0\u1f8c \u0bc6\u0b9a\u1fbc\u0baf\u1fba\u0baa\u0b9f \u0bc7\u0bb5\u1fb6\u1f8a\u0baf \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0b8e\u1fb9\u1f99\u1fb9 \u0bc6\u0bb5\u0bb3\u0bbf\u1fba\u0baa\u1f8c\u1fb7\u0ba4 \u0bc7\u0bb5\u1fb6\u1f8a\u0baf \u0ba4\u0bbf\u0b95\u0ba4\u0bbf - 1998.11.23 2025.12.24 \u0b86\u0bb5\u0ba3\u1fb1\u0b95\u1fc0 \u0bc8\u0b95\u0baf\u0bb3\u0bbf\u1fb0\u0b95\u1fba\u0baa\u0b9f \u0bc7\u0bb5\u1fb6\u1f8a\u0baf \u0ba4\u0bbf\u0b95\u0ba4\u0bbf - 1998.11.10 2025.12.17 \u0b9f\u0baa\u0bbf\u1fc0\u1f9d. \u0b8e\u1fc4. \u0bc7\u0b9a\u0ba9\u0bbe\u0ba4\u0bbf\u1fc4\u0bb8,