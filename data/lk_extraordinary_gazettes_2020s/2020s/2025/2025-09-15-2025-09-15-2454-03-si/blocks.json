    "text": "\u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\ufffd \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda 2019 \u0d85\u0d82\u0d82\u0d9a 02 \u0daf\u0dbb\u0db1 \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dcf\u0dbb \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0d9a \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0dc0\u0dd0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dd9\u02e0\u0dc4\u0dd2 24 \u0dc0\u0dd9\u0dd9\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0dc0\u0dd2\u0dc2\u0dba \u0db7\u0dcf\u0dcf\u0dbb \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd, \u0db8\u0dda\u023c \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd4\u0dbb\u0dd4\u0dc0\u0dcf\u0dcf \u0dc4\u0dd0\u0dd0\u0dbb \u0d87\u0dad\u0dd2 \u0db6\u0dd0\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dda\u0dda 154 \u0d87. \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0 \u0d85\u0db1\u0dd4\u0dc0 \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dcf\u0dcf\u0dbb \u0dc0\u0db1 \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dd0\u0dd0\u0dc0\u0dd2\u0db1\u0dca, \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\ufffd \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda 2019 \u0d85\u0d82\u0d82\u0d9a 02 \u0daf\u0dbb\u0db1 \u0dc3\u0db8\u0dd4\u0db4\u0d9a\u0dcf\u0dcf\u0dbb \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0d9a \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0dc0\u0dd0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0db4\u0dca\u200d\u0dbb\u0da5\u0db4\u0dca\u0dad\u0dd2\u0dba\u0dd9\u0dca\u024f \u0db1\u0dd2\u0dba\u0ddd\u02e0\u0ddd\u0d9c\u0dc0\u0dbd 6.ii (\u0d87) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dc4 (\u0d85) \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f \u0dc0\u0d9c\u0dd4\u0dc0 \u0d85\u0d82\u0d82\u0d9a 01 \u0d89\u0dc0\u0dad\u0dca\u0d9a\u0dbb \u0d92 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dc4 \u0dc0\u0d9c\u0dd4\u0dc0 \u0d85\u0d82\u0d82\u0d9a 01 \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0d91\u0db8 \u0db1\u0dd2\u0dba\u0ddd\u02e0\u0ddd\u0d9c \u0db8\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0ddd\u02e0\u0ddd\u0d9c \u0db4\u0db1\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229. \u0db8\u0dd9\ufffd\u0db8 \u0db1\u0dd2\u0dba\u0ddd\u02e0\u0ddd\u0d9c 2024.04.01 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0db6\u0dbd\u0db4\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba.",
