    "text": "2025 \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 06 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1.\u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u0dda\u023c\u0db1\u0dca\u0dad\u0dd4 \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba,\u0db1\u0dd0\u0dd0\u0d9c\u0dd9\u02c3\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dcf\u0dad,\u0d9a\u0db1\u0dca\u0db1\u0dd2\u0dba\u0dcf\u0dcf \u0db4\u0dcf\u0dcf\u0dbb, \u0dc0\u0dbb\u0ddd\ufffd\u0ddd\u02ea\u0daf\u0dba \u0db1\u0d9c\u0dbb\u0dca,\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0dcf\u0db8\u0dbd\u0dba.",
