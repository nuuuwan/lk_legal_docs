    "text": "\u0dcf\u0dbd\u0dd0, 2025 \u0dba\u0db1 \u0dbd\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc0 17 \u0dbd\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1\u0da7 \u0db8\u0dad\u0dca \u0dba\u0dcf\u0dca\u0dad, \u0d92 \u0d89\u0da9\u0db8/\u0db4\u0dbb\u0dbd\u0dbe\u0dcf\u0dcf\u0dbd\u0dba \u0dc0\u0db8\u0dca\u0db6\u0dca\u0dad \u0dba\u0dba\u0dca\u0dad \u0d94\u0dc0\u0dd4\u0dca\u0dad\u0dba\u0dda \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dbd\u0dcf\u0dc3\u0dd2\u0daf\u0d9a\u0db8\u0dca\u0dbd\u0dbc \u0dc0\u0dca\u0dbd\u0db7\u0dcf\u0dbd\u0dba\u0dad\u0dca, \u0d91\u0d9a\u0dd3 \u0d89\u0da9\u0db8 /\u0db4\u0dbb\u0dbd\u0dbe\u0dcf\u0dcf\u0dbd\u0dba \u0dbc\u0db6\u0dcf\u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d9c\u0dd0\u0db1 \u0dbd\u0dca\u0dad\u0daf\u0dd2 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0da7 \u0d87\u0dad\u0dd2 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb\u0dad\u0dca, \u0dbd\u0dca\u0dad\u0daf\u0dd2 \u0d85\u0d82\u0dd0\u0dbc \u0dc1\u0dcf \u0db5\u0dca \u0d85\u0d82\u0dd0\u0dbc \u0d9c\u0dba\u0dca\u0dad \u0db6\u0dd0\u0dbd\u0dd5 \u0dc1\u0dd0\u0da7\u0dd2\u0dad\u0dca, \u0db8\u0dcf \u0dba\u0dbd\u0dcf \u0db4\u0dd2\u0da7\u0db4\u0dad\u0dca \u0dba\u0dd0\u0d9a\u0d9a\u0dca \u0dc0\u0da7\u0dd2\u0dcf \u0dc0\u0dd5 \u0dbd\u0dd2\u0dba\u0dc0\u0dd2\u0dbd\u0dca\u0dbc\u0d9a\u0dd2\u0dca\u0dad \u0dd0\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.",
