    ],
    "text": "\u201c\u0dba\u023c \u026a\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u02a4 \u0dd9\u0db4\u02a5\u01ca\u0d9c\u0263\u0d9a \u01e8\u01af\u0dba\u0d9a\u0da7 \u0dba\u0da7\u01ae \u0db1\u023c \u0d92 \u0218\u0298\u0db6\u0db3 \u026a\u0dc3\u0dca\u0dad\u0dbb \u01b0\u025e\u0dc0\u0da7\u201d \u201c\u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u01ae \u0dd9\u0d9a\u02a3\u01e6\u0dd9\u01ca\u0286\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u01ae\u0dc0\u201d \u0dd9\u0dbd\u0dc3 \u0daf \u0d87\u01b1\u0dbd\u01ae \u0d9a\u0dbb \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229. \u0219.\u0287.\u018c.\u0286\u0dd9\u0118\u0dbb\u0dcf, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0262. 2025 \u0151\u01e7 \u0db8\u0dc3 09 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd \u0dbb\u0da2\u0db8\u0262\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbb, \u201c\u023d\u028f\u0d9a\u0dad \u0db8\u0dd0\u01d0\u0dbb\u201d, \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dd9\u0269 \u01cf \u0dba. EOG 07-0025/6 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u00fb\u025d\u0dd9\u023c \u0db4\u0db1\u0dad (14 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba) \u0d8b\u00fa\u0dad \u0275\u0259\u0dc2\u0dba \u0dba\u0da7\u0dd9\u01ae 2017 \u0dd9\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u025c \u0db8\u0dc3 09 \u0dc0\u0db1 \u01ce\u0db1 \u0d85\u0d82\u0d9a 2005/33 \u0daf\u0dbb\u0dab \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db6\u0dc3\u0dca\u0db1\u0dcf\u028f\u0dbb \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0dd9\u0d9a\u02a3\u0dc5\u0db9 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f \u0dbb\u01ae\u0db8\u0dbd\u0dcf\u0db1 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d85\u0d82\u0d9a 541 - \u0d9c\u0262\u00fb\u0dc3\u0dca\u0dc3 \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025d \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u01b1\u0dc5 \u0d9c\u0262\u00fb\u0dc3\u0dca\u0dc3 \u0db1\u0db8\u0dd0\u01af \u0d9c\u0dd9\u023c \u0218\u028f\u0179\u0dba\u0dcf \u026d \u0daf, \u0d85\u0d82\u0d9a 521004 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0dd9\u023c \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 08 \u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 357 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d91\u028f \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u0dba\u028f; \u201c\u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u0dda \u0d85\u0d82\u0d9a\u0dba, \u026a\u0dc1\u0dcf\u0dbd\u01ae\u0dc0\u0dba, \u0d85\u0250\u01af\u0d9a\u025e\u0dd9\u0118/\u0d85\u0250\u01af\u0d9a\u025e\u0dc0\u01e6\u0dd9\u0118 \u0dc3\u023c\u021b\u0259\u0dab \u0db1\u0db8/\u0db1\u023c \u0dc3\u0dc4 \u0263\u0218\u0db1\u0dba, \u0da2\u0dcf\u01af\u0d9a \u0dc4\u0dd0\u01ff\u01e9\u023c\u0db4\u01ae \u0d85\u0d82\u0d9a\u0dba\u201d, \u201c\u026a\u01e7\u0dc1\u0dca\u0da0\u0dba\u01e6 \u0dc3\u0dc4 \u0d89\u01e6\u0dd9\u0da2\u01e6\u0dc2\u01e6 \u0dad\u0dc4\u0db1\u023c \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf\u0dd9\u0dc0\u01e6 \u0d87\u01af \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u01fe\u023c \u0218\u0298\u0db6\u0db3 \u026a\u0dc3\u0dca\u0dad\u0dbb\u201d \u0dba\u0db1 \u01b0\u0dbb\u0dba\u01e6\u028f \u201c 357, 0.0168, \u0dd9\u0db8\u02a3\u0dd9\u0dc4\u02a3\u0db8\u018a \u0dd9\u0dba\u01e7\u0dba\u0dcf \u01e9\u025e\u0262 \u0daf\u0dcf\u029d\u0dba\u0dcf, \u0d85\u0d82\u0d9a 24, \u0da9\u018a\u0263 \u0dd9\u0dc3\u0dda\u0db1\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dcf\u0dc0\u0dad, \u0db1\u0dcf\u0d9c\u025c\u0d9a \u01e7\u0dc0\u0dcf\u0dc3 \u0dd9\u0daf\u028f\u0dc0\u0dbd,\u0dd9\u0db8\u02a3\u0dd9\u0dc4\u02a3\u0db8\u018a \u0da2\u0dd0\u023d\u0262 \u025c\u0dc3\u0dca\u0dc0\u0dcf\u01e6 \u0dba\u0db1 \u0d85\u0dba\u0dd9\u0118 \u0150\u026a\u0dad \u0236\u00fa\u01af\u0dba\u0da7 \u0dba\u0da7\u01ae\u0dc0\u201d \u0dd9\u0dbd\u0dc3 \u0dc3\u0db3\u0dc4\u01e6 \u0dd9\u0dad\u02a3\u0dbb\u01b1\u0dbb \u201c 07 : 681, 0.0128, \u0d86\u0daf\u023c\u0db6\u0dcf\u0dc0\u0dcf \u01e7\u0dba\u0dcf\u0dc3\u0dca \u0d85\u0d82\u0d9a 20/20, \u027c \u0db0\u0259\u0db8\u0db4\u0dcf\u0dbd \u0db4\u0dcf\u0dbb, \u0dd9\u0daf\u028f\u0dc0\u0dbd, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 586 \u028f \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0250\u01af\u0dba \u0dc3\u0db8\u0d9f\u201d \u0dd9\u0dbd\u0dc3 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229. \u0219.\u0287.\u018c.\u0286\u0dd9\u0118\u0dbb\u0dcf, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0262. 2025 \u0151\u01e7 \u0db8\u0dc3 09 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd \u0dbb\u0da2\u0db8\u0262\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbb, \u201c\u023d\u028f\u0d9a\u0dad \u0db8\u0dd0\u01d0\u0dbb\u201d, \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dd9\u0269 \u01cf \u0dba. EOG 07-0025/7",
