d\u0dca\u200d\u0dbb\u0dba\u0dda\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb \u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dbd\u0dba\u0dda\u0dda\u024f \u0db4\u0dd3\u0da8\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0db1\u0dcf\u0d82\u0d82\ufffd\u0dc1\u0dba\u0db1\u0dca \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0db1 \u0dbd\u0daf \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u0dda\u024f I \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\u0dda\u0dda\u024f (2007 \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 14 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d82\u0d9a 1523/16 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\ufffd\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u0dda\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db1\u0dd2\u0dba\u0db8\u0dba\u0dda\u0dda\u024f \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2) \u201c\u0d9a\u0dbd\u0dcf\u0dcf \u0dc4\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0d9a\u0dd8\u0dd8\u0dad\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0dd3\u0da8\u0dba\u201d \u0dba\u0db1 \u0d85\u0dba\u0dd2\u0dad\u0db8\u0dba \u0dc3\u0dc4 \u0d91\u0db8 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u0dda\u024f II \u0dc0\u0db1 \u0dad\u0dd3\u0dbb\u0dba\u0dda\u0dda\u024f \u0d87\u0dad\u0dd2 \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0db1\u0dca \u0d89\u0dc0\u0dad\u0dca\u0d9a\u0dbb \u0d92 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3 \u0d86\u0daf\u0dda\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8