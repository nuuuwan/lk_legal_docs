    "text": "1998 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0732\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0bcd 14 \u0b86\u0bae\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bcd \u0b95\u0733\u0bb4\u0bcd \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1\u0731\u0732\u0ba4\u0bcd\u0ba4\u0731\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba4\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0732\u0ba9\u0bcd \u0baa\u0baf\u0738\u0ba9\u0b95\u0bcd\u0736\u0b95\u0731\u0ba3\u0bcd\u0b9f\u0bc1, \u0b95\u0733\u0737\u0bb4 \u0b92\u0baa\u0bcd\u0baa\u0bae\u0732\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0723\u0731\u0ba9\u0bcd, 1998 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 21 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0ba4\u0732\u0bb5\u0bc1\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0bcd 12 \u0b86\u0bae\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bcd \u0723\u0732\u0baf\u0ba4\u0732\u0b95\u0bb3\u0732\u0ba9\u0bcd\u0baa\u0b9f\u0bbf 2024.10.07 \u0b86\u0ba8\u0bcd \u0ba4\u0732\u0b95\u0ba4\u0732\u0baf, 2405/07 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0731\u0ba9\u0732\u0baf\u0732\u0bb2\u0bcd \u0b89\u0731\u0732\u0baf \u0bae\u0bc1\u0738\u0bb1\u0baf\u0732\u0bb2\u0bcd \u0736\u0bb5\u0bb3\u0732\u0baf\u0732\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\u0bae\u0bcd, \u0b95\u0731\u0ba3\u0732\u0b95\u0bcd\u0b95\u0731\u0ba9 \u0b89\u0731\u0732\u0738\u0bae\u0b95\u0bcd \u0737\u0b95\u0731\u0731\u0732\u0b95\u0bcd\u0738\u0b95\u0b95\u0738\u0bb3\u0b95\u0bcd \u0737\u0b95\u0731\u0bb0\u0bc1\u0b95\u0732\u0ba9\u0bcd\u0bb1\u0ba4\u0bc1\u0bae\u0731\u0ba9 31/0423 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b85\u0bb1\u0732\u0bb5\u0732\u0ba4\u0bcd\u0ba4\u0bb2\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0732\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bc1 \u0736\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bae\u0ba4\u0bcd\u0ba4\u0732\u0baf \u0bae\u0731\u0b95\u0731\u0ba3\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd, \u0bae\u0731\u0ba4\u0bcd\u0ba4\u0738\u0bb3 \u0bae\u0731\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd, \u0ba4\u0bae\u0bcd\u0baa\u0bc1\u0bb3\u0bcd\u0738\u0bb3 \u0baa\u0732\u0bb0\u0737\u0ba4\u0b9a \u0736\u0b9a\u0baf\u0bb2\u0731\u0bb3\u0bb0\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0bb2\u0bcd, \u0b87\u0bb2. \u0b88/450 \u0b8f - \u0baa\u0bb2\u0bcd\u0736\u0bb5\u0736\u0730\u0bb0 \u0b95\u0732\u0bb0\u0731\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0732\u0ba9\u0bc1\u0bb3\u0bcd \u0baa\u0bb2\u0bcd\u0736\u0bb5\u0736\u0730\u0bb0 \u0b95\u0732\u0bb0\u0731\u0bae\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0b85\u0738\u0bae\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0bae\u0bcd 310012 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb0\u0bb2\u0bcd \u0b85\u0bb3\u0738\u0bb5 \u0bb5\u0738\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0bc1 \u0b87\u0bb2. 4 \u0b87\u0bb2\u0bcd \u0b85\u0b9f\u0b99\u0bcd\u0b95\u0732\u0baf\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0bae\u0731\u0ba9 2:1, 2:7, 2:9, 2:10, 2:11, 2:40 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0738\u0bb3\u0b95\u0bcd \u0736\u0b95\u0731\u0ba3\u0bcd\u0b9f \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0731\u0ba9 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0736\u0ba4\u0731\u0b9f\u0bb0\u0bcd\u0baa\u0731\u0b95 \u0b87\u0ba4\u0737\u0ba9\u0731\u0b9f\u0bc1 \u0b87\u0738\u0ba3\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0738\u0ba3\u0baf\u0732\u0bb2\u0bcd \u0ba4\u0bb0\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0bb5\u0731\u0bb1\u0731\u0ba9 \u0b8e\u0ba9\u0ba4\u0bc1 \u0ba4\u0733\u0bb0\u0bcd\u0bae\u0731\u0ba9\u0ba4\u0bcd\u0738\u0ba4 \u0b87\u0ba4\u0bcd\u0ba4\u0731\u0bb2\u0bcd \u0736\u0bb5\u0bb3\u0732\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0732\u0ba9\u0bcd\u0737\u0bb1\u0ba9\u0bcd. \u0baa\u0bc0.\u0b9a\u0733.\u0b9f\u0bc0. \u0b9a\u0732\u0737\u0b95\u0bb0\u0731, \u0b95\u0731\u0ba3\u0732 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0723\u0732\u0bb0\u0bcd\u0ba3\u0baf \u0b86\u0738\u0ba3\u0baf\u0731\u0bb3\u0bb0\u0bcd \u0723\u0731\u0baf\u0b95\u0bae\u0bcd. \u0b95\u0731\u0ba3\u0732 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1 \u0723\u0732\u0bb0\u0bcd\u0ba3\u0baf\u0ba4\u0bcd \u0ba4\u0732\u0738\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd, \u0b87\u0bb2. 1200/6, \u201c\u0bae\u0732\u0730\u0732\u0b95\u0ba4 \u0736\u0bae\u0ba4\u0bc1\u0bb0\u201d, \u0b87\u0bb0\u0b9c\u0bae\u0bb2\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4 \u0bb5\u0bc0\u0ba4\u0732, \u0baa\u0ba4\u0bcd\u0ba4\u0bb0\u0bae\u0bc1\u0bb2\u0bcd\u0738\u0bb2, 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0737\u0bae \u0bae\u0731\u0ba4\u0bae\u0bcd 16 \u0b86\u0bae\u0bcd \u0ba4\u0732\u0b95\u0ba4\u0732.",
