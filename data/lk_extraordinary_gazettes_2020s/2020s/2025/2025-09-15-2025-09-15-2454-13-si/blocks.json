    "text": "\u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae \u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u0dba\u0da7\u0dd9\u01ae \u0d9c\u025e \u0d9a\u0dd8\u027f\u0d9a\u0259\u0db8, \u0db4\u0276 \u0dc3\u023c\u0db4\u01ae, \u0d89\u0da9\u023c \u0dc3\u0dc4 \u0dc0\u0dcf\u025c\u0db8\u0dcf\u0259\u0d9c \u0d85\u0db8\u0dcf\u0dad\u0255\u01b1\u0db8\u0dcf \u026a\u0286\u01e6 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u0d89\u0da9\u023c \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1\u0dba \u00fb\u025d\u0dd9\u023c \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0db8\u0119\u01e6 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0db8\u0dc4 \u0dd9\u0d9a\u02a3\u0dc5\u0db9 \u0d9c\u0d82\u0dc0\u01b1\u0dbb \u0db4\u0dcf\u0dbd\u0db1\u0dba \u00fb\u025d\u0dd9\u023c \u0dc4\u0dcf \u0db4\u025c\u0dc3\u0dbb\u0dba \u0dc0\u0dd0\u018b\u01ce\u0252\u019f \u00fb\u025d\u0dd9\u023c \u0dc0\u0255\u0dcf\u0db4\u0dd8\u01af\u0dba, \u0dd9\u0269\u025a\u0dc3\u0dca\u0d9c\u0d9f \u0dc0\u0dd0\u0286 \u0da2\u0dbd\u0dba \u0d85\u0db4\u0dc0\u0dc4\u0db1\u0dba \u0dc4\u0dcf \u0db4\u025c\u0dc3\u0dbb\u0dba \u0dc0\u0dd0\u018b\u01ce\u0252\u019f \u00fb\u025d\u0dd9\u023c \u0dc0\u0255\u0dcf\u0db4\u0dd8\u01af\u0dba, \u0dd9\u0d9a\u02a3\u0dc5\u0db9 \u0d85\u0d9c\u0db1\u0d9c\u0dbb \u0d86\u027b\u0dad \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0dc0\u0255\u0dcf\u0db4\u0dd8\u01af\u0dba \u0dc3\u0dc4 \u0dd9\u0d9a\u02a3\u0dd9\u0dc5\u02a3\u01e6\u0db1\u0dcf\u0dc0 \u0dc0\u0dd0\u0286 \u0da2\u0dbd\u0dba \u0d85\u0db4\u0dc0\u0dc4\u0db1\u0dba \u0dc4\u0dcf \u0db4\u025c\u0dc3\u0dbb \u0dc0\u0dd0\u018b\u01ce\u0252\u019f \u00fb\u025d\u0dd9\u023c \u0dc0\u0255\u0dcf\u0db4\u0dd8\u01af\u0dba \u0dba\u0db1 \u0dc0\u0255\u0dcf\u0db4\u0dd8\u01af \u0dc3\u0db3\u0dc4\u0dcf \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0d9a\u0da7\u0252\u01b1 \u0286\u01d0 \u00fb\u025d\u0db8 \u0218\u019d\u0dc3 \u0db4\u01ae\u0d9a\u0dbb \u0d87\u01af \u0db4\u0dc4\u0dad \u0db1\u023c \u0dc3\u0db3\u0dc4\u01e6 \u01e7\u0dbd\