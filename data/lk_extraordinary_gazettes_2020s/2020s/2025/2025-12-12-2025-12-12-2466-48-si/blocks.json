    "text": "(14 \u0dc0\u0db1 \u0dc0\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba) \u0d8b\u0d9a\u0dca\u0dcf \u0dc1\u0dd3\u0dbb\u0dca\u0dc2\u0dba \u0dba\u0da7\u0dba\u0dda 2017 \u0da2\u0dd4\u0db1\u0dd2 \u0db8\u0dc3 02 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0d85\u0d82\u0d9a 2021/38 \u0daf\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dcf\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dcf\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0dcf\u0db1\u0dbb\u0da2\u0dcf\u0dba\u0dda \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dba \u0dda\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db6\u0dc3\u0dca\u0db1\u0dcf\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dba\u0dda \u0d9a\u0dc5\u0dd4\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0d9a\u0dc5\u0dd4\u0dcf\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dc1\u0dd3\u0dba \u0dba\u0db8\u0d9a \u0d9a \u0dba\u0d9a\u0dca\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba\u0dda \u0d85\u0d82\u0d9a 710 - \u0d9a\u0dd4\u0da9\u0dcf\u0dc0\u0dc3\u0dca\u0d9a\u0da9\u0dd4\u0dc0 \u0db1\u0dd0\u0dba\u0d9c\u0db1\u0dc4\u0dd2\u0dbb \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd \u0dcf \u0dba\u0d9a\u0dca\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba \u0dad\u0dd4\u0dc5 \u0d9a\u0dd4\u0da9\u0dcf\u0dc0\u0dc3\u0dca\u0d9a\u0da9\u0dd4\u0dc0 \u0db1\u0db8\u0dd0\u0dad\u0dd2 \u0d9c\u0dba \u0d9a \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf \u0dc0\u0dd6 \u0daf, \u0d85\u0d82\u0d9a 530085 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0dba \u0d9a \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 02 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 404 \u0daf\u0dbb\u0db1 \u0d89\u0da9 \u0d9a \u0dba\u0d9a\u0dca\u0da7\u0dc3 \u0dc3 \u0d9a\u0db6\u0dca\u0dad \u0dba\u0dba\u0dca\u0dad \u0d91\u0dc4\u0dd2 \u0d8b\u0db4\u0dba\u0db8\u0d9b\u0db1\u0dba\u0dba\u0dc4\u0dd2; \u0db4\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d9a\u0dba 0 \u0dba\u0dbd\u0dc3 \u0dad\u0dad\u0dd4\u0dc5\u0dda \u0d9a\u0dbb, \u201c\u0dc0\u0dd2\u0db1\u0dd2 \u0dca\u0da0\u0dba\u0dca\u0dad \u0dc3\u0dc4 \u0d89\u0dca\u0dad\u0dba\u0da2\u0dcf\u0dca\u0dad\u0dc2\u0dca\u0dad \u0dcf\u0dc4\u0db1 \u0d9a \u0d85\u0dba\u0dda\u0d9a\u0dca\u0dc2\u0dcf\u0dba\u0dc0\u0dca\u0dad \u0dad\u0dad\u0dd2 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u0db3\u0dd3 \u0d9a \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb\u201d \u0dba\u0db1 \u0dad\u0dd3\u0dbb\u0dba\u0dda \u0dc3\u0db3\u0dc4\u0dca\u0dad \u201c\u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1 4 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0 \u0dcf\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c\u201d \u0dba\u0dca\u0dad\u0db1 \u0d89\u0dc0\u0dda \u0d9a\u0dbb \u201c\u0db4\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d9a\u0dba 0 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 402 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0 \u0dcf\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c\u201d \u0dba\u0dbd\u0dc3 \u0dad\u0dad\u0dd4\u0dc5\u0dda \u0d9a\u0dbb \u0dc3\u0d82\u0dba \u0ddd \u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dba\u0dda. \u0db4\u0dd3. \u0dc3\u0dd3. \u0da9\u0dd3. \u0dc3\u0dd2\u0dc1\u0dda\u0dbb\u0dcf, \u0d89\u0da9 \u0d9a \u0dc4\u0dd2\u0db8\u0dd2\u0d9a \u0d9a \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0db8 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba \u0d9a \u0dba\u0d9a\u0dca\u0db8\u0dc3\u0dcf \u0dc3\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0db8. 2025 \u0dba\u0db1\u0dca\u0dc0\u0dd0 \u0d9a\u0db6\u0dbb\u0dca \u0db8\u0dc3 2 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0db8\u0dbd \u0dbb\u0da2\u0dcf\u0db8\u0db8\u0dc0\u0dda\u0dcf \u0db4\u0dcf\u0dbb, \u201c\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dcf \u0db8\u0dd0\u0daf\u0dd4\u0dbb\u201d, \u0d85\u0d82\u0d9a 1200/ , \u0d89\u0da9 \u0d9a \u0dc4\u0dd2\u0db8\u0dd2\u0d9a \u0d