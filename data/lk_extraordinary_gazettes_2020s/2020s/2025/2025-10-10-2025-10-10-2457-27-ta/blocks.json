bc0\u1f8c \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bc7\u0bae\u0bb2\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0b95\u0bae\u0bcd\u0baa\u0bb9\u0bbe \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0bae\u0bc0\u0bbe\u0bbf\u0b95\u0bae \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b87\u0bb2. 401 - \u0bb9\u0bbf\u0b99\u0bcd\u0b95\u0bc1\u1f9e\u0bc6\u0bb5\u0bb5 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u0bb3\u0bcd \u0b95\u0bc1\u0b9f\u0bbe\u0b95\u0bae, \u0bb9\u0bbf\u0b99\u0bcd\u0b95\u0bc1\u1f9e\u0bc6\u0bb5\u0bb5 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3\u1f90\u0bae\u0bcd 110151 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bb2\u0bcd \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2. 02 \u0b87\u0bb2\u0bcd \u0b85\u0b9f\u0b99\u0bcd\u0b95\u0bbf\u1f9c\u0bb3\u0bcd\u0bb3\u1f90\u0bae\u0bbe\u0ba9 1 : 198, 1 : 202, 2 : 95, 2 : 159, 2 : 161, 2 : 187, 2 : 188, 2 : 189, 2 : 190, 2 : 191, 2 : 192, 2 : 205, 2 : 208, 2 : 209 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 2 : 210 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bc8\u0bb3\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd\u1f90\u0ba3\u0bcd\u1f8c\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0ba4\u0bcd\u1f90 \u0bc6\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0b95 \u0b87\u0ba4\u0bc7\u0ba9\u0bbe\u1f8c \u0b87\u0bc8\u0ba3\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0b9f\u0bcd\u0b9f\u0bb5\u0bc8\u0ba3\u0baf\u0bbf\u0bb2\u0bcd \u0ba4\u0bb0\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0bb5\u0b