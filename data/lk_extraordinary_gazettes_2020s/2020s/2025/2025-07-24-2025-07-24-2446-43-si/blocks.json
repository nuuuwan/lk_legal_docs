    "text": "\u0dd9\u0db8\u0db8 \u0d9c\u0dd0\u0dc3\u0178 \u01e7\u0dd9\u0269\u0daf\u0db1\u0dba 1947 \u0d85\u0d82\u0d9a 29 \u0daf\u0dbb\u0db1 \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0d86\u0da5\u0dcf\u0db4\u0db1\u0dd9\u01ae 56 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba\u0da7 \u0d85\u01e9\u00fe\u0dbd\u0dc0 \u0dc3\u0dc4 \u0dba\u0dcf\u0db4\u0db1\u0dba \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u026a\u0286\u01e6 \u01e7\u00fd\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9c\u0dd0\u0dc3\u0178 \u01e7\u0dd9\u0269\u0daf\u0db1\u0dba \u0db8\u0119\u01e6 \u0dc3\u023c\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf 2017.06.16 \u01ce\u0db1\u0dd0\u01af \u0d85\u0d82\u0d9a 2024 \u0daf\u0dbb\u0db1 \u0dd9\u0dbb\u011b\u0dbd\u0dcf\u0286 \u0dc3\u0dc4 2025.01.24 \u01ce\u0db1\u0dd0\u01af \u0d85\u0d82\u0d9a 2421 \u0daf\u0dbb\u0db1 \u01e8\u01af \u025d\u01af\u0dc0\u0dbd\u0da7 \u0d85\u01e9\u00fe\u0dbd\u0dc0\u01ae 2025.06.23 \u01ce\u0db1\u0dd0\u01af \u0d85\u0d82\u0d9a JMC/2025/06/09 \u0daf\u0dbb\u0db1 \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0db8\u0dcf\u0286\u0d9a \u0db8\u0dc4\u0dcf \u0dc3\u0db7\u0dcf \u025a\u0dc3\u0dca\u026b\u0dd9\u023c \u0dd9\u0dba\u02a4\u0da2\u0db1\u0dcf\u0dc0\u0da7 \u0d85\u01e9\u00fe\u0dbd\u0dc0 \u021d\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u01ae \u0d9a\u0dbb\u0db1 \u0db6\u0dc0 \u0dd9\u0db8\u0250\u01e6 \u021d\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u023d. \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u01b0\u0dbb\u0dab \u0d85\u01e9\u00fe\u0dbd\u0dc0\u01ae \u021d\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u01ae \u0d9a\u0dbb \u0d87\u0dad.",
