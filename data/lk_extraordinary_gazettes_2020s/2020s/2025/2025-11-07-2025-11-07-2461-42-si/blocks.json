    "text": "\u0d85) \u0d91\u0dc4\u0dd2 \u0d9c\u0d9c\u0db1 \u0db1\u0dcf\u0dcf\u0dc0\u0dd2\u0d9a \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0dc4 \u0d9c\u0d9c\u0db1 \u0dba\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf\u0d82\u0d82\ufffd\u0d9c\u0db1 \u0dc0\u0dbd\u0da7 \u0d86\u0db6\u0daf\u0dca\u0db0 \u0d89\u0da9\u0db8\u0dca (\u0dad\u0dd4\u0db1\u0dca\u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u0dda\u024f \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba \u0d9a\u0ddc\ufffd\u0ddc\u0da7 \u0d87\u0dad\u0dd2) \u0dba\u0da7\u0dad\u0dda\u0dda\u01ae \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u201c4. \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0da2\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0db1\u0dca\u0dad\u0dbb \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\ufffd\u0ddc\u0da7\u0dd4\u0db4\u0dbd\u0dd9\ufffd\u0dc4\u0dd2 \u0db0\u0dcf\u0dcf\u0dc0\u0db1 \u0db4\u0dae\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d9c\u0db8\u0dca\u0db4\u0dc4, \u0db4\u0db8\u0dd4\u0dab\u0dd4\u0d9c\u0db8, \u0d9a\u0dd0\u0dd0\u0db4\u0dd4\u0db1\u0dca\u0d9c\u0ddc\ufffd\u0ddc\u0da9 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2, \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0dc3\u0d82\u0d82\u0dad\u0dbb\u0dab \u0d8b\u0db4\u0d9a\u0dcf\u0dcf\u0dbb\u0d9a, \u0d91\u0dc4\u0dd2 \u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9c\u0dd2\u0dbd\u0dd2 \u0dc3\u0dc4 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0d8a\u0da7 \u0d86\u0db6\u0daf\u0dca\u0db0 \u0d89\u0da9\u0db8\u201d \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7, \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3 \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca:- \u201c4. \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0da2\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0db1\u0dca\u0dad\u0dbb \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\ufffd\u0ddc\u0da7\u0dd4\u0db4\u0dbd\u0dd9\ufffd\u0dc4\u0dd2 \u0db0\u0dcf\u0dcf\u0dc0\u0db1 \u0db4\u0dae\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d9c\u0db8\u0dca\u0db4\u0dc4, \u0db4\u0db8\u0dd4\u0dab\u0dd4\u0d9c\u0db8, \u0d9a\u0dd0\u0dd0\u0db4\u0dd4\u0db1\u0dca\u0d9c\u0ddc\ufffd\u0ddc\u0da9 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2, \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2",
