    "text": "1974 \u0d85\u0d82\u0d82\u0d9a 2 \u0daf\u0dbb\u0db1 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0dbd \u0dc3\u0db8\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0dc4\u0dcf\u0dcf \u0da2\u0dbd\u0dcf\u0dcf\u0db4\u0dc0\u0dc4\u0db1 \u0db8\u0dab\u0dca\u0da9\u0dbd \u0db4\u0db1\u0dad\u0dda\u01ae, 92 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb, \u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1, \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba, \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0dad\u0dd2\u0dbd\u0d9a \u0dc0\u0db1 \u0db8\u0db8, \u0d91\u0d9a\u0dd3 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0da7, \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0d8b\u0dad\u0dd4\u0dbb \u0db4\u0dcf\u0dcf\u0dad\u0daf\u0dd4\u0db8\u0dca\u0db6\u0dbb \u0d92\u0d9a\u0dcf\u0dcf\u0db6\u0daf\u0dca\u0db0 \u0da2\u0dbd \u0dc3\u0db8\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dd8\u0dd8\u0dad\u0dd2\u0dba\u0dda\u024f, \u0d9a\u0ddc\ufffd\u0ddc\u0db1\u0d9a\u0dbd\u0d9c\u0dbd \u0db1\u0dc0 \u0db4\u0ddc\ufffd\u0ddc\u0db8\u0dca\u0db4\u0dcf\u0dcf\u0d9c\u0dcf\u0dcf\u0dbb\u0dba \u0d89\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d85\u0db8\u0dad\u0dbb \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba\u0dc0 \u0d87\u0dad\u0dd2 \u0dc4\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca, \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db4\u0dc4\u0dad \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dd9\ufffd\u0dc4\u0