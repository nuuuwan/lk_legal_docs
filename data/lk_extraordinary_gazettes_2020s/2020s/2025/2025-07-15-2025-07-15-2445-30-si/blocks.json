dca \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd9\u0dba\u0db1\u0dca \u0d91\u0dc4\u0dd2 \u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dd9\u0dba\u0dc4\u0dd2; \u201c\u0dc0\u0dd2\u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0d89\u0db1\u0dca\u0dd9\u0da2\u0db1\u0dca\u0dc2\u0db1\u0dca \u0dad\u0dc4\u0db1\u0db8\u0dca \u0d85\u0dd9\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dcf\u0dd9\u0dc0\u0db1\u0dca \u0d87\u0dad\u0dd2 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u201d \u0dba\u0db1 \u0dad\u0dd3\u0dbb\u0dd4\u0dc0\u0da7 \u201c \u0d85\u0d82\u0d9a 2513 \u0dc4\u0dcf 2018.08.06 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d94\u0db4\u0dca\u0db4\u0dd4\u0dc0 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dc3\u0dd3/\u0dc3 \u0d9c\u0dbd\u0dd2\u0d9c\u0db8\u0dd4\u0dc0 \u0dc0\u0dd2.\u0dd9\u0dc3\u0dda.\u0dc3. \u0dc3\u0db8\u0dd2\u0dad\u0dd2\u0dd9\u0dba\u0dca \u0db6\u0da7\u0dd4\u0dc0\u0dad\u0dca\u0dad \u0d9c\u0dcf\u0db8\u0dd3\u0dba \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dd9\u0dc0\u0dca \u0dad\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u201d \u0dba\u0db1\u0dca\u0db1 \u0d89\u0dc0\u0dad\u0dca\u0d9a\u0dbb \u0d85\u0d82\u0d9a 2990 \u0dc4\u0dcf 2018.06.30 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d94\u0db4\u0dca\u0db4\u0dd4\u0dc0 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0dc3\u0dd3/\u0dc3 \u0d9c\u0dbd\u0dd2\u0d9c\u0db8\u0dd4\u0dc0 \u0dc0\u0dd2.\u0dd9\u0dc3\u0dda.\u0dc3. \u0dc3\u0db8\u0dd2\u0dad\u0dd2\u0dd9\u0dba\u0dca \u0db6\u0da7\u0dd4\u0dc0\u0dad\u0dca\u0dad \u0d9c\u0dcf\u0db8\u0dd3\u0dba \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dd9\u0dc0\u0dca \u0dad\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u201d \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca\u0d9a\u0dbb \u0dc3\u0d82\u0dd9\u0dc1\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd9\u0db6\u0dca.",
