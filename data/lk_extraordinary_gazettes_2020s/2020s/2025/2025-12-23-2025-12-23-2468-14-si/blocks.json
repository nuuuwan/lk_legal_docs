    "text": "\u201c\u0dd9\u0daf\u0db4\u0dcf\u0259\u0dc1\u0dca\u0dc0\u0dba \u0d85\u0dad\u0dbb 1994.11.16 \u01ce\u0db1 \u0d85\u01ae\u0dc3\u01e6 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0dc0\u0dd9\u0db6\u02a4\u0db0\u0dad\u0dcf \u0119\u026a\u0288\u0db8 \u0dc4\u0dcf \u0d91\u028f \u0dba\u0dcf\u0dc0\u01ae\u0d9a\u0dcf\u0264\u0db1 \u00fb\u025d\u023c\u0dc0\u0dbd\u01cf \u021d\u0dc3\u0dcf\u0daf \u01cf\u0db8\u0db1\u0dcf \u0dd9\u0d9c\u026b\u0dd2\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0d91\u0d9a\u0d9f\u0dad\u0dcf\u0dc0\u0dba\u00fa \u0d87\u01af \u026b \u01af\u0dd9\u0229\u0daf \u0dc4\u0dcf \u0d91\u0dd9\u0dc3\u02a2 \u0d87\u01af \u026b \u01af\u0dd9\u0229 \u0db1\u023c \u0dd9\u0db8\u0db8 \u0dd9\u0dc3\u02a2\u0dc0\u0d9a\u0250\u01e6\u0da7 \u021d\u0dc3\u0dcf\u0daf \u01cf\u0db8\u0db1\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u028f\u023d\u0d9a\u023c \u01af\u0dd9\u0229\u0daf \u0dba\u01e6\u0db1\u01ae \u0dc3\u0dc4 \u0dd9\u0db8\u0db8 \u0db4\u0dd0\u023d\u019d\u0262\u0dbd \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0dc0\u0dd8\u01ae\u01b0\u0dba \u0dc3\u023d\u01af\u0dd9\u024f \u0dc3\u0dcf\u0db8\u0dcf\u014f\u0d9a\u0250\u01e6 \u0dc0\u0db1 \u0dd9\u0db8\u0db8 \u0d86\u0dba\u0dad\u0db1\u0dd9\u024f \u0dd9\u0dc3\u02a2\u0dc0\u0dba \u0d9a\u0dbb\u0db1 \u0dd9\u014e. \u0d91\u023c. \u0d91\u0dc3\u0dca. \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf \u0db8\u0dba\u0dcf \u0d87\u01b1\u029a \u0dd9\u0dc3\u02a2\u0dc0\u0d9a\u0250\u01e6 38 \u0dd9\u0daf\u0db1\u0dcf\u0da7 \u0dbd\u0db6\u023d\u01e6 \u0286\u0179 \u0dc0\u0dcf\u0259\u027f\u0d9a \u021d\u0dc3\u0dcf\u0daf \u01cf\u0db8\u0db1\u0dcf\u0dc0\u0dbd 2015 \u0d85\u0dd9\u021d\u02a2\u0262 \u0db8\u0dcf\u0dc3\u0dba\u0da7 \u01e7\u0dba\u023d\u0dad \u023f\u0daf\u0263\u01e6 25% \u00fa \u0d85\u018d\u0dd9\u0dc0\u01e6 \u0dd9\u0d9c\u026b\u0dd9\u0db8\u01e6 \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0286\u01d0\u0dc0 \u01af\u0dd9\u0229\u0daf \u0dba\u01e6\u0db1 \u0dc4\u0dcf \u0d91\u0dd9\u0dc3\u02a2 \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0286\u01d0\u0dc0 \u01af\