    ],
    "text": "\u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u00fd\u025e\u0dab\u0dd1\u0d9c\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0dc0\u0dcf\u025c\u0dba\u0dd9\u0db4\u02a3\u0dbd \u021d\u0dcf\u0dd9\u01ca\u0274\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f,\u0d85\u0d82\u0d9a 1249, \u0d89\u0db4\u0dbd\u0dc0 \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d89\u0db4\u0dbd\u0dc0 \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a KU/WRY/2021/407 \u0dc4\u0dcf 2021.12.09 \u01ce\u0db1\u0dd0\u01af \u021d\u0d9c\u0db8\u0db1 \u0d85\u01e9\u0dd9\u0259\u0d9b\u0db1\u0dd9\u024f \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca\u0dc0\u0dbd\u0da7 \u0db8\u0dcf\u0250\u023c:",
    "fonts": [
