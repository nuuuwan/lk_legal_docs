  {
    "page_number": 0,
    "bbox": [
      55.32,
      618.97,
      298.29,
      730.35
    ],
    "text": "01. \u0d9a\u0dd0\u0db6\u0dd0\u0263 \u0d85\u00fa\u0dc2\u0dbb \u2018A\u2019 - \u0db4\u0dc4\u0dbd\u0dd9\u0dc0\u0dd9\u0262 \u0dd9\u0daf\u028f\u0d85\u01ae\u0dad \u0d85\u0d9c\u0dcf\u0dd9\u0dbb\u00fd\u0249\u0dbb \u0286\u0dba\u0db9\u0dbd\u0dcf\u0d9c\u0dc4\u00fd\u0249\u0dbb \u0dc3\u0dc4 \u0d8a\u0da7 \u0dba\u0dcf\u026d \u0dd9\u0d9c\u02a3\u0da9 - \u0db8\u0da9 \u022a\u023c \u0dc0\u0dcf\u0286\u0dba - \u021d\u0db8\u0dcf\u0dab\u0dba : \u0dd9\u0dc4\u00fa. 0.8091 \u0d8b\u01b1\u0dbb\u0da7 : \u0dd9\u00fa.\u0d92. \u00fd\u0288\u0db8\u0dbd\u0dad\u0dcf \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0286\u0dba\u0db9\u0dbd\u0dcf\u0d9c\u0dc4\u00fd\u0249\u0dbb \u0dc3\u0dc4 \u0db8\u01df\u0dbb \u0dd9\u0dc3\u02a2\u0db1\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0286\u0dba\u0db9\u0dbd\u0dcf\u0d9c\u0dc4\u00fd\u0249\u0dbb; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0db8\u01df\u0dbb \u0dd9\u0dc3\u02a2\u0db1\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0286\u0dba\u0db9\u0dbd\u0dcf\u0d9c\u0dc4\u00fd\u0249\u0dbb \u0dc3\u0dc4 \u0dd9\u0db8\u0db8 \u0d85\u01e9\u0dd9\u0259\u0d9b\u0db1\u0dd9\u024f 2 \u0dd9\u0dc0\u01e7 \u022a\u023c \u0d9a\u0dd0\u0db6\u0dd0\u0262\u0dbd; \u0daf\u00fd\u0dab\u0da7 : \u0dd9\u0db8\u0db8 \u0d85\u01e9\u0dd9\u0259\u0d9b\u0db1\u0dd9\u024f 2 \u0dd9\u0dc0\u01e7 \u022a\u023c \u0d9a\u0dd0\u0db6\u0dd0\u0262\u0dbd \u0dc3\u0dc4 \u0db8\u0dcf\u0259\u0d9c\u0dba; \u0db6\u0da7\u028f\u0dbb\u0da7 : \u0db8\u0dcf\u0259\u0d9c\u0dba \u0dc3\u0dc4 \u0dd9\u00fa.\u0d92.\u00fd\u0288\u0db8\u0dbd\u0dad\u0dcf \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0286\u0dba\u0db9\u0dbd\u0dcf\u0d9c\u0dc4\u00fd\u0249\u0dbb.",
    "fonts": [
