  },
  {
    "page_number": 0,
    "bbox": [
      48.02,
      496.31,
      286.67,
      570.69
    ],
    "text": "I hereby give notice, under Sub-section (1) of Section 7 of the Land Acquisition Act, as amended by the Land Acquisition (Amendment) Act, No. 28 of 1964, that the Government intends to acquire/servitude right over the following land which is required for a public purpose:-",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Bold"
    ],
    "sizes": [
      9.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      48.02,
      570.23,
      286.6,
      708.11
    ],
    "text": "Description of the land to be acquired/servitude right : All that allotment of land in total extent of about 0.2241 Hectare, depicted as Lot No. 01, block No. 01, Sheet No. 01 in the Cadastral Map No. cad. map 420578 and dated 04.03.2024 surveyed and prepared by the Surveyor General, situated at the village of Halpane, in Medapaththu Korale East, in the Divisional Secretary\u2019s Division of Pannala in Kurunegala District, North Western Province and bounded as follows :",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Bold",
      "Times New Roman,Italic"
    ],
    "sizes": [
      9.960000038146973
    ]
  },
