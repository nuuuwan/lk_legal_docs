    "bbox": [
      48.0,
      636.87,
      542.5,
      662.01
    ],
    "text": "(a) three (3) simple passes (S) in any stream in one and the same sitting at G.C.E. (Advance Level) Examination conducted by the Department of Examination of Sri Lanka or equivalent qualification.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
