  {
    "page_number": 0,
    "bbox": [
      55.15,
      466.85,
      549.65,
      548.2
    ],
    "text": "1987 \u0d85\u0d82\u0d9a 15 \u0daf\u0dbb\u0db1 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db4\u0db1\u0dad \u0dc3\u0db8\u0d9f \u00fb\u0dba\u026a\u0dba \u0252\u01b1, \u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0dcf\u01ae \u0d9c\u025e \u0d86\u019c\u018d\u0d9a\u0dcf\u0dbb\u01b1\u0db8\u01e6 \u026a\u0286\u01e6 2020.10.29 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0d85\u0d82\u0d9a 2199/15 \u0daf\u0dbb\u0db1 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f (\u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2) \u0db4\u0dc5 \u0d9a\u0dbb\u01e6\u0db1\u0da7 \u0d9a\u0da7\u0252\u01b1 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0dc3\u023c\u0db4\u0dcf\u0daf\u0db1\u0dba \u0dc4\u0dcf \u0db6\u0dbd\u0dcf\u01ae\u0db8\u0d9a \u00fb\u025d\u0dd9\u023c \u025d\u01af \u0d85\u0d82\u0d9a 10(2) \u021d\u0d9a\u0dcf\u0dbb\u0dc0 \u0d86\u0dbb\u013c\u013d\u0d9a\u0178\u017b\u0dc0 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0d9a\u0dc3\u0dca\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dd9\u0d9a\u017b\u023c\u0db4\u01ae \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0dd9\u0262\u0d9b\u0db1\u0dba 2025 \u0d94\u00fa\u0dd9\u0dad\u02a4\u0db6\u0259 \u0db8\u0dc3 24 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0286\u0da7 2025 \u0dd9\u0db1\u02a3\u0dc0\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 05 \u01ce\u0db1 \u0dd9\u0dad\u00fa (\u0dbb\u0da2\u0dd9\u024f \u01e7\u0dc0\u0dcf\u018d \u01ce\u0db1 \u0dc4\u0dcf \u0d89\u025c\u0daf\u0dcf \u01ce\u0db1 \u0dc4\u0dd0\u0dbb) \u0d86\u0dbb\u013c\u013d\u0d9a\u0178\u017b\u0dc0 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u021d\u0db0\u0dcf\u0db1 \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0dd9\u024f \u0dc3\u0dc4 \u0d86\u0dbb\u013c\u013d\u0d9a\u0178\u017b\u0dc0, \u0db6\u0d82\u0d9c\u0dd9\u0daf\u01e7\u0dba, \u0d8b\u0da9\u0217\u021a\u0dc0, \u0d85\u011b\u0dab\u026a\u0dbd \u0dc0\u0db1 \u021a\u0dc3\u0dca\u0dad\u0d9a\u0dcf\u0dbd\u0dc0\u0dbd \u01cf \u0d9a\u0dcf\u0259\u0dba\u0dcf\u0dbd\u0251\u0dba \u0dd9\u0269\u0dbd\u0dcf\u0dc0 \u01b1\u0dc5 \u0db8\u0dc4\u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0dd9\u0dc0\u0dad \u0db4\u025d\u00fa\u0dc2\u0dcf \u0d9a\u0dbb \u0db6\u0dd0\u0264\u0db8\u0da7 \u0d89\u0da9 \u0d9a\u0da9 \u0dc3\u0dbd\u0dc3\u0dcf \u0d87\u01af \u0db6\u0dc0 \u0dd9\u0db8\u0250\u01e6 \u01e7\u0dd9\u0269\u0daf\u0db1\u0dba \u0d9a\u0dbb\u023d.",
