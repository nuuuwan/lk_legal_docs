    "text": "\u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dba \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013--\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 \u0dc0\u0dd2\u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba\u0db1\u0dca \u0dc3\u0dc4 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u0ddd \u0db4\u0dad \u0d85\u0d82\u0d9a\u0dba \u0d89\u0db1\u0dca\u0dd9\u0da2\u0db1\u0dca\u0dc2\u0db1\u0dca \u0dad\u0dc4\u0db1\u0db8\u0dca \u0dd9\u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0dc4 \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd\u0dad\u0dca\u0dc0\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dd9\u0d9c\u0dca/\u0d85\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d85\u0dba\u0dd2\u0dad\u0dd2 \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dd9\u0dba\u0dca \u0d85\u0dd9\u0db4\u0dca\u0d9a\u0dca\u0dc2\u0dcf\u0dd9\u0dc0\u0db1\u0dca \u0d87\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dd9\u0dc3\u0dda \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db1\u0db8/\u0db1\u0db8\u0dca \u0dc3\u0dc4 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u0dc4\u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dc4 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dca \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u0db4\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1:22 1.0089 \u0d87\u0dad\u0dd4\u0d9c\u0dbd\u0dca \u0dd9\u0db4\u0dca\u0da9\u0dd2\u0dd9\u0d9c\u0dca \u0db1\u0dd2\u0db8\u0dbd\u0dca \u0da2\u0dba\u0dc3\u0dd2\u0d82\u0dc4 601763338V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0d85\u0d82\u0d9a 251, \u0db8\u0dc4\u0d8b\u0dbd\u0dca\u0db4\u0dad, \u0d9a\u0dcf\u0dc1\u0255\u0db4\u0db4\u0dd4\u0dbb \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:34 1.0950 \u0db1\u0dd2\u0d9a\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0da0\u0db8\u0dd2\u0dbd\u0dcf 825010823V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0db4\u0dd2\u0dba\u0d82\u0d9c\u0db1\u0dd3 \u0db1\u0dd2\u0d9a\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0d85\u0d82\u0d9a 124, \u0db8\u0dc4\u0d8b\u0dbd\u0dca\u0db4\u0dad, \u0d9a\u0dcf\u0dc1\u0255\u0db4\u0db4\u0dd4\u0dbb \u0dba\u0da7\u0dad\u0dca\u0dc0 1:64 1.0050 \u0d87\u0dad\u0dd4\u0d9c\u0dbd\u0dca \u0dd9\u0db4\u0dca\u0da9\u0dd2\u0dd9\u0d9c\u0dca \u0dc3\u0dd4\u0db1\u0dd2\u0dbd\u0dca \u0da2\u0dba\u0db1\u0dca\u0dad 602483096V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0d85\u0d82\u0d9a, 175, \u0db8\u0dc4\u0d8b\u0dbd\u0dca\u0db4\u0dad, \u0d9a\u0dcf\u0dc1\u0255\u0db4\u0db4\u0dd4\u0dbb \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:72 1.0000 \u0db1\u0dd2\u0d9a\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0da7\u0dd2\u0d9a\u0dd2\u0dbb\u0dd2\u0db6\u0db1\u0dca\u0da9\u0dcf 511121671V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0d85\u0d82\u0d9a 247, \u0db8\u0dc4\u0d8b\u0dbd\u0dca\u0db4\u0dad, \u0d9a\u0dcf\u0dc1\u0255\u0db4\u0db4\u0dd4\u0dbb \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:84 1.0070 \u0dd9\u0dc4\u0dda\u0dbb\u0dad\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc3\u0dd2\u0dbb\u0dd2\u0dba\u0dcf\u0dc0\u0dad\u0dd3 196970003657 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0d85\u0d82\u0d9a 157, \u0db8\u0dc4\u0d8b\u0dbd\u0dca\u0db4\u0dad, \u0d9a\u0dcf\u0dc1\u0255\u0db4\u0db4\u0dd4\u0dbb \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:104 1.0056 \u0dd9\u0dc3\u0dda\u0db1\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dbd\u0dd2\u0dd9\u0d9c\u0dca \u0d8b\u0dad\u0dca\u0db4\u0dbd\u0dc0\u0db1\u0dca\u0db1\u0dcf 938502218V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0dc3\u0dda\u0db1\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0d85\u0d82\u0d9a 178, \u0db8\u0dc4\u0d8b\u0dbd\u0dca\u0db4\u0dad, \u0d9a\u0dcf\u0dc1\u0255\u0db4\u0db4\u0dd4\u0dbb \u0dba\u0da7\u0dad\u0dca\u0dc0 1:147 1.0050 \u0d89\u0dbd\u0dd4\u0d9a\u0dca\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dca\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc3\u0dd3\u0dbd\u0dc0\u0dad\u0dd3 446942050V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0db8\u0dd0\u0dab\u0dd2\u0dd9\u0d9a\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0d85\u0d82\u0d9a 282, \u0db8\u0dc4\u0d8b\u0dbd\u0dca\u0db4\u0dad, \u0d9a\u0dcf\u0dc1\u0255\u0db4\u0db4\u0dd4\u0dbb \u0dba\u0da7\u0dad\u0dca\u0dc0 1:164 0.9986 \u0d85\u0daf\u0dcf\u0dc3\u0dd2 \u0d9c\u0db8\u0dbb\u0dcf\u0dc5\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc0\u0dd3\u0dbb\u0dd9\u0dc3\u0dda\u0d9a\u0dbb 551091759V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0d85\u0d82\u0d9a 129, \u0db8\u0dc4\u0d8b\u0dbd\u0dca\u0db4\u0dad, \u0d9a\u0dcf\u0dc1\u0255\u0db4\u0db4\u0dd4\u0dbb, \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2\u0dc0\u0dbd\u0da7 \u0daf\u0dd2\u0db9\u0dd4\u0dbd\u0dcf\u0d9c\u0dbd \u0dba\u0da7\u0dad\u0dca\u0dc0 1:169 0.9997 \u0dd9\u0dad\u0ddc\u0db1\u0dca\u0da9\u0dd4\u0dc0\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dd9\u0dc3\u0ddd\u0db8\u0dbb\u0dad\u0dca\u0db1 490803670V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dd9\u0dad\u0dca \u0d85\u0d82\u0d9a 133, \u0db8\u0dc4\u0d8b\u0dbd\u0dca\u0db4\u0dad, \u0d9a\u0dcf\u0dc1\u0255\u0db4\u0db4\u0dd4\u0dbb \u0dd9\u0d9a\u0ddc\u0db1\u0dc