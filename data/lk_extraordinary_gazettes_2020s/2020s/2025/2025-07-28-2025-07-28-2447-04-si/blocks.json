    "text": "\u0db6\u0dc3\u0dca\u0db1\u0dcf\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dba\u0dda, \u0dba\u0d9a\u0ddc\u0dc5\u0db9 \u0daf\u0dd2\u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0dbb\u0dda\u0db8\u0dbd\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba \u0dba \u0dba\u0db8\u0d9a\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba\u0dda, \u0dba\u0daf\u0dc4\u0dd2\u0dc0\u0dbd \u0d9c\u0db8\u0dc3\u0dca\u0dc3\u0dca\u0dc3 \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf \u0dc3\u0dd3\u0db8\u0dcf\u0dba\u0dc0\u0dca \u0d85\u0d82\u0d9a 541, \u0d9c\u0db8\u0dc3\u0dca\u0dc3\u0dca\u0dc3 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0dba\u0db8\u0dca \u0dc4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc3\u0dbb\u0dca\u0dba\u0dc0\u0dca\u0dba\u0dbb\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0db8 \u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dad \u0dc4\u0dd2\u0dc5\u0dd2\u0dba\u0dba\u0dbd \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d85\u0d82\u0d9a 521004/07/09 \u0dc4\u0dcf 2025/03/21 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0dba\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 01 \u0dc4\u0dcf 02 \u0dc0\u0dd9\u0dba\u0dba\u0dca\u0dad \u0dba\u0db4\u0dca\u0dad\u0db1\u0dd4\u0db8\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dba\u0dba\u0dba\u0dca\u0dad \u0dba\u0dc4\u0d9a\u0dca. 0.1063 \u0d9a\u0dca \u0dc0\u0dd6 \u0d89\u0da9\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 02 :",
