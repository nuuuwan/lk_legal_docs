      50.76,
      115.97,
      289.24,
      672.35
    ],
    "text": "08. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 09 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dd9\u0d9a\u0ddc\u0dd9\u0dc4\u0ddc\u0dbd\u0dcf\u0db1 \u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0d89\u0da9\u0dd9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0d91\u0da0\u0dca. \u0d86\u0dbb\u0dca. \u0da9\u0dd3. \u0dc3\u0dd3. \u0dc4\u0dbd\u0dca\u0dbd\u0dc0, \u0d85\u0d82\u0d9a 157/C, \u0dc0\u0dbd\u0dc0\u0dca\u0dc0\u0dad\u0dca\u0dad, \u0d9a\u0dbd\u0dca\u0d91\u0dc5\u0dd3\u0dba (\u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf); \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.1776. 09. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 10 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0d85\u0db9\u0d9c\u0dc4\u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0d89\u0da9\u0dd9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0db8\u0dc4\u0db4\u0dca\u0db4\u0dd4 \u0dd9\u0d9a\u0ddd\u0dbb\u0dcf\u0dbd\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0da0\u0dd2\u0dad\u0dcf \u0da0\u0dcf\u0db1\u0dca\u0daf\u0db1\u0dd3, \u0d85\u0d82\u0d9a 5, \u0db4\u0dd0\u0dbd\u0db4\u0dd2\u0da7\u0dd2\u0d9c\u0db8 \u0dc4\u0db1\u0dca\u0daf\u0dd2\u0dba, \u0dd9\u0db6\u0ddc\u0d9a\u0dbd\u0d9c\u0db8 (\u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf); \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.0279. 10. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 11 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0d85\u0db9\u0d9c\u0dc4\u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0d89\u0da9\u0dd9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0d9c\u0ddc\u0da9 \u0dbb\u0da2\u0db8\u0dc4\u0dcf \u0dc0\u0dd2\u0dc4\u0dcf\u0dbb\u0dd9\u0dba\u0dca \u0dc0\u0dd2\u0dc4\u0dcf\u0dbb\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 (\u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf); \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.0239. 11. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 12 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dc3\u0db8\u0db1\u0dca\u0dad\u0dcf\u0db4\u0dd4\u0dbb\u0dcf\u0dab\u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0d89\u0da9\u0dd9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0db1\u0dd4\u0dc0\u0dbb \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dd9\u0d9c\u0dca \u0db4\u0dcf\u0dbd\u0dd2\u0dad \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dcf\u0dbd, \u0d85\u0d82\u0d9a 34/4/1, \u0dba\u0dcf\u0db4\u0dbd\u0dcf\u0db1, \u0dd9\u0db6\u0ddc\u0d9a\u0dbd\u0d9c\u0db8 (\u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf); \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.1309. 12. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 13 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: -; \u0d89\u0da9\u0dd9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d87\u0dc5; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: - (\u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0d85\u0db0\u0dd2\u0dd9\u0dc0\u0dca\u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dd9\u0dba\u0dca, 01 \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0dc0\u0dd3 \u0d87\u0dad); \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.0140. 13. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 14 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dc0\u0dbd\u0db6\u0dd4\u0db1\u0dca\u0dd9\u0db1\u0dca\u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0d89\u0da9\u0dd9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dc0\u0dd2\u0d9a\u0db8\u0dc3\u0dd6\u0dbb\u0dd2\u0dba\u0dd9\u0d9c\u0dca \u0dc3\u0dbb\u0dad\u0dca \u0dd9\u0dc4\u0dda\u0db8\u0dad\u0dd2\u0dbd\u0d9a, \u0d85\u0d82\u0d9a 5, \u0dd9\u0daf\u0ddc\u0dbd\u0dd9\u0dc4\u0dda\u0db1, \u0dd9\u0db6\u0ddc\u0d9a\u0dbd\u0d9c\u0db8 (\u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf); \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.0395. 14. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 15 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dc0\u0dbd\u0db6\u0dd4\u0db1\u0dca\u0dd9\u0db1\u0dca\u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0d89\u0da9\u0dd9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0db8\u0dcf\u0dbd\u0dd2\u0d9c \u0dbb\u0d82\u0dd9\u0d9c\u0dca \u0dc3\u0dd4\u0dd9\u0dbb\u0dca\u0d9a\u0dcf \u0d9c\u0dd4\u0dab\u0dc3\u0dd2\u0d82\u0dc4, \u0d85\u0d82\u0d9a 67/5, \u0d87\u0dbd\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0dd9\u0db6\u0ddc\u0d9a\u0dbd\u0d9c\u0db8 (\u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf); \u0db4\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u0d9a\u0dca. 0.0406. 15. \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 16 \u0d89\u0da9\u0dd9\u0db8\u0dca \u0db1\u0db8: \u0dc0\u0dbd\u0db6\u0dd4\u0db1\u0dca\u0dd9\u0db1\u0dca\u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0d89\u0da9\u0dd9\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dba: \u0d9a\u0dd4\u0db9\u0dd4\u0dbb; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0dbb\u0da2\u0dba; \u0db8\u0dd4\u0dbd\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0d85\u0dba: \u0db8\u0dcf\u0dbd\u0dd2\u0d9c\u0dbb\u0d82\u0dd9\u0d9c\u0dca",
