    "text": "\u0daf\u0dca\u0dc0\u0dd2\u0dad\u0dca\u0dc0 \u0db6\u0daf\u0dd4 \u0d85\u0dba\u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dd0\u0dd0\u0dc5\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0db8 \u0daf \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0db8 \u0db8\u0dad \u0dc0\u0dd6 \u0db6\u0daf\u0dd4 \u0d9c\u0dd9\u02c3\u0dc0\u0dd3\u0db8 \u0db8\u0d9f\u0dc4\u0dd0\u0dd0\u0dbb\u0dd3\u0db8 \u0dc0\u0dd0\u0dd0\u0dc5\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0db8 \u0daf \u0dc3\u0db3\u0dc4\u0dcf\u0dcf 2013 \u0da2\u0db1\u0dc0\u0dcf\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 22 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0daf\u0dd3 \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf (\u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db8\u0dd2\u0db1\u0dca \u0db8\u0dad\u0dd4 \"\u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8\" \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1) \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\ufffd\u0ddd\u02ea\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc3\u0db1\u0dca\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0d85\u0db4\u0dda\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u0dda\u024f \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc3\u0dc4 \u0d89\u0db1\u0dca\u0daf\u0dd3\u0dba \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u0dda\u024f \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db8\u0dd9\ufffd\u0dc3\u0dda\ufffd\u0dda \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0d9c\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u