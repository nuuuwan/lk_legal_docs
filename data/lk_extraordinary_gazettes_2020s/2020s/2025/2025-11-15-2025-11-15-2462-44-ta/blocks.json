    "text": "\u0b9a\u0bbe\u0bbe\u0bae\u0bcd\u0baa\u0b9a\u0bbf\u0bbf\u0bb5\u0bae\u0bcd \u0b9a\u0bc1\u0ba4\u0bb0\u0bcd\u0b9a\u0ba9\u0bcd \u0b9a\u0bbe\u0bbe\u0bae\u0bcd\u0baa\u0b9a\u0bbf\u0bbf\u0bb5\u0bae\u0bcd \u0b9a\u0bc1\u0ba4\u0bb0\u0bcd\u0b9a\u0ba9\u0bcd, \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\ufffd\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf \u0b86\u0ba3\ufffd\u0baf\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd, \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3\u0bae\u0bcd. \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\ufffd\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf\u0ba4\u0bcd \u0ba4\u0bbf\u0bbf\u0ba3\ufffd\u0b95\u0bcd\u0b95\u0bb3\u0bae\u0bcd, \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3\u0bae\u0bcd,\u0bae\u0bc1\u0ba4\u0bbf\u0bbf\u0baf\ufffd\u0bcb\u0bb0\u0bcd \u0b87\u0bb2\u0bcd\u0bb2 \u0bb5\u0bb3\u0bbe\u0bbe\u0b95\u0bae\u0bcd,A9 \u0bb5\u0bc0\u0ba4\u0bbf\u0bbf, \u0b95\u0bc8\u0bc8\u0ba4\u0b9f\u0bbf,\u0baf\u0bbe\u0bbe\u0bb4\u0bcd\u0baa\u0bcd\u0baa\u0bbe\u0bbe\u0ba3\u0bae\u0bcd,2025, \u0ba8\u0bb5\ufffd\u0bae\u0bcd\u0baa\u0bbe\u0bcd\u0bcd\u073c \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 13 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf.",
