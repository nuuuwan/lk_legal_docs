    "text": "\u0d85\u0db0\u0255\u0dcf\u0db4\u0db1, \u0d8b\u0dc3\u0dc3\u0dca \u0d85\u0db0\u0255\u0dcf\u0db4\u0db1 \u0dc3\u0dc4 \u0dc0\u0dd8\u01ae\u01b0\u0dba \u0d85\u0db0\u0255\u0dcf\u0db4\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0255 \u0d86\u0da0\u0dcf\u0259\u0dba \u0dc4\u025c\u01e7 \u0d85\u0db8\u0dbb\u0289\u025c\u0dba \u0dc0\u0db1 \u0db8\u0db8 1961 \u0d85\u0d82\u0d9a 08 \u0daf\u0dbb\u0db1 \u0d8b\u0db4\u0d9a\u0dd8\u0dad \u0db4\u0dcf\u0da8\u0dc1\u0dcf\u0dbd\u0dcf \u0dc4\u0dcf \u0d85\u0db7\u0255\u0dcf\u0dc3 \u026a\u0daf\u0255\u0dcf\u0dbd (\u0db4\u025c\u021b\u0dbb\u0d9a \u026a\u01dd\u026a\u0db0\u0dcf\u0db1) \u0db4\u0db1\u0dd9\u01ae 10 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u021d\u0d9a\u0dcf\u0dbb\u0dc0 \u0101\u0dba\u0dcf \u0d9a\u0dbb\u023d\u01e6, \u0d85\u0d82\u0d9a 12790 \u0dc4\u0dcf 1961.12.01 \u01ce\u0db1\u0dd0\u01af \u0dbd\u0d82\u0d9a\u0dcf\u019c\u018d\u0dd9\u0269 (\u0d85\u01af\u026a\u0dd9\u0dc1\u0dc2) \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5\u0d9a\u0dbb\u0db1 \u0dbd\u0daf, \u0d85\u0d82\u0d9a 258 \u0daf\u0dbb\u0db1 \u0db4\u0dd0\u0dc0\u025e\u023c \u01e7\u0dd9\u0dba\u02a4\u0d9c\u0dba, \u0d91\u028f \u026a\u0dc3\u0dca\u0dad\u0dbb \u0dd9\u0d9a\u02a3\u0da7 \u0daf\u00fa\u0dc0\u0dcf \u0d87\u01af \u0d85\u00fa\u0d9a\u0dbb 01 \u0250 \u025f\u018a 02 \u0d9a \u0237\u023d \u021d\u0db8\u0dcf\u0dab\u0dba\u0da7 \u0db4\u0db8\u0dab\u00fa \u0d85\u0daf\u0dcf\u0dc5 \u0dc0\u0db1\u0dad\u0dcf\u00fa \u01d0\u0dbb\u0da7 2025 \u0db8\u0dcf\u0259\u01b1 \u0db8\u0dc3 12 \u01ce\u0db1 \u0286\u0da7 \u0db6\u0dbd\u0db4\u0dd0\u0dc0\u0dd0\u01ae\u0dd9\u0dc0\u0db1 \u0db4\u025c\u01ce \u0dd9\u0db8\u0250\u01e6 \u0d85\u0dc0\u0dbd\u0d82\u011b \u0d9a\u0dbb\u023d.",
