    "text": "\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0baf \u0bae\u0bbe\u0bbe\u0b95\u0bbe\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd \u0ba8\u0bc1\u0bb5\u0bb0\u0bc6\u0bc6\u0bb2\u0bbf\u0baf\u0bbe\u0bbe \u0bae\u0bbe\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd \u0ba8\u0bc1\u0bb5\u0bb0\u0bc6\u0bc6\u0bb2\u0bbf\u0baf\u0bbe\u0bbe\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0bb9\u0bb5\u0bbe\u0bbe\u0b8e\u0bb2\u0bbf\u0baf \u0bae\ufffd\u0bb1\u0bcd\u0b95\u0bc1 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0bc6\u0bc6\u0baf\u0bb2\u0bbe\u0bbe\u0bb3\u0bbe\u0bcd\u0bcd\u073c \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb2\u0bcd 535 F \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95, \u0b95\u0bbf\u0bbf\u0bb0\ufffd\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bc1\u0bb3\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0bae\u0bbe\u0bbe\u0ba9 \u0ba8\u0bbf\u0bbf\u0bb2 \u0b85\u0bb3\u0bb5\u0bc8\u0bc8\u0baf\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd \u0ba4\u0bb2\u0bc8\u0bc8\u0bae\u0bc8\u0bc8\u0baf\u0ba4\u0bbf\u0bbf\u0baa\u0ba4\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0ba9\u0bbe\u0bbe\u0bb2\u0bcd \u0b86\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 2024/11/27 \u0b86\u0ba8\u0bcd\u0ba4\u0bc7\u0bc7\u0ba4\u0bbf\u0bbf\u0baf 330184 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd \u0bb5\u0bb0\u0bc8\u0bc8\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0bbf\u0bb5\u0bb0\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 02 \u0b87\u0bb2\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 01 \u0b8e\u0ba9\u0bcd\u0bb1\u0bb5\u0bbe\u0bbe\u0bb1\u0bbe\u0bbe\u0b95 \u0b85\u0b9f\u0bc8\u0bc8\u0baf\u0bbe\u0bbe\u0bb3\u0bae\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\u0bae\u0bcd, \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe\u0bbe\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\u0bae\u0bcd \u0bb5\u0bb0\u0bc8\u0bc8\u0baf\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1\u0bae\u0bbe\u0bbe\u0ba9 \u0b95\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1, \u0baa\u0bc2\u0b9a\u0bcd\u0b9a\u0bbf\u0bbf\u0baf\u0bae\u0bcd \u0ba4\u0b9a\u0bae\u0bcd \u0b90\u0ba8\u0bcd\u0ba4\u0bc1 \u0b8e\u0b9f\u0bcd\u0b9f\u0bc1 \u0b92\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba8\u0bbe\u0bbe\u0ba9\u0bcd\u0b95\u0bc1 \u0bb9\u0730\u0b95\u0bcd\u0b9f\ufffd\u0baf\u0bb0\u0bcd (0.5814 \u0bb9\u0730) \u0bb5\u0bbf\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0ba4\u0bcd\u0ba4\u0bc8\u0bc8\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd \u0b9a\ufffd\u0bca\u0bb2\u0bcd\u0bb2\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 01 \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0bb2\u0bcd \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bae\u0bc8\u0bc8 \u0bb5\u0bb0\u0bc8\u0bc8\u0baa\u0b9f \u0b87\u0bb2. 2289 \u0b87\u0ba9\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 23 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 330184 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd \u0bb5\u0bb0\u0bc8\u0bc8\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b95\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 02 \u0b87\u0ba9\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 02, \u0b95\u0bbf\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0bb2\u0bcd 330184 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0\u0bb2\u0bcd \u0bb5\u0bb0\u0bc8\u0bc8\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b95\u0bbe\u0bbe\u0ba3\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 02 \u0b87\u0ba9\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 02, \u0ba4\u0bc6\u0bc6\u0bb1\u0bcd\u0b95\u0bbf\u0bbf\u0bb2\u0bcd \u0baa\ufffd\u0ba3\u0bcd\u0b9f\u0bb0\u0bcd \u0bb9\u0730\u0bcb\u0bae\u0bcd \u0baa\u0ba3\u0bcd\u0ba3\u0721 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\ufffd\u0bb1\u0bcd\u0b95\u0bbf\u0bbf\u0bb2\u0bcd \u0baa\ufffd\u0ba3\u0bcd\u0b9f\u0bb0\u0bcd \u0bb9\u0730\u0bcb\u0bae\u0bcd \u0baa\u0ba3\u0bcd\u0ba3\u0721 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0ba4\u0ba9\u0bcd\u0bae\u0bc8\u0bc8 \u0bb5\u0bb0\u0bc8\u0bc8\u0baa\u0b9f \u0b87\u0bb2. 2289 \u0b87\u0ba9\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. 23 \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b8e\u0bb2\u0bcd\u0bb2\u0bc8\u0bc8\u0b95\u0bb3\u0bc8\u0bc8\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.\".",
