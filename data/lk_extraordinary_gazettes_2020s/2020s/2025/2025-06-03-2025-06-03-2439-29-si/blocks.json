    "bbox": [
      307.15,
      402.15,
      549.65,
      533.5
    ],
    "text": "\u00fb\u0dba\u0db1 \u0dc0\u0dd0\u025e\u0262\u0dbd\u0d9c\u0dc4\u0dbd\u01e6\u0daf, \u0dd9\u014e.\u0d92.\u0d91\u023c. \u0da2\u0dba\u0dd9\u0d9a\u02a3\u018b \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dc0\u0dd0\u025e\u0262\u0dbd\u0d9c\u0dc4\u0dbd\u01e6\u0daf \u0dc3\u0dc4 \u0dd9\u014e.\u0d92.\u018c.\u0253. \u0da2\u0dba\u0dd9\u0d9a\u02a3\u018b \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dc0\u0dd0\u025e\u0262\u0dbd\u0d9c\u0dc4\u0dbd\u01e6\u0daf; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0dd9\u014e.\u0d92.\u018c.\u0253. \u0da2\u0dba\u0dd9\u0d9a\u02a3\u018b \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dc0\u0dd0\u025e\u0262\u0dbd\u0d9c\u0dc4\u0dbd\u01e6\u0daf \u0dc3\u0dc4 \u0db8\u0dcf\u0259\u0d9c\u0dba; \u0daf\u00fd\u0dab\u0da7: \u0db8\u0dcf\u0259\u0d9c\u0dba, \u0dd9\u014e.\u0d92.\u0d92 \u0da2\u0dba\u0dd9\u0d9a\u02a3\u018b \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dc0\u0dd0\u025e\u0262\u0dbd\u0d9c\u0dc4\u0dbd\u01e6\u0daf \u0dc3\u0dc4 \u0dd9\u014e.\u0d92.\u0d92.\u0da9\u0229 \u0da2\u0dba\u0dd9\u0d9a\u02a3\u018b \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dc0\u0dd0\u025e\u0262\u0dbd\u0d9c\u0dc4\u0dbd\u01e6\u0daf; \u0db6\u0da7\u028f\u0dbb\u0da7: \u0dd9\u014e.\u0d92.\u0d92 \u0da2\u0dba\u0dd9\u0d9a\u02a3\u018b \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dc0\u0dd0\u025e\u0262\u0dbd\u0d9c\u0dc4\u0dbd\u01e6\u0daf, \u0dd9\u014e.\u0d92.\u0d92.\u0da9\u0229 \u0da2\u0dba\u0dd9\u0d9a\u02a3\u018b \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dc0\u0dd0\u025e\u0262\u0dbd\u0d9c\u0dc4\u0dbd\u01e6\u0daf, \u0dd9\u014e.\u0d92.\u0dd9\u00fa \u0da2\u0dba\u0dd9\u0d9a\u02a3\u018b \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dc0\u0dd0\u025e\u0262\u0dbd\u0d9c\u0dc4\u0dbd\u01e6\u0daf, \u0db6\u0dbd\u0d9c\u0262\u0dbd \u0d86\u0daf\u0259\u0dc1 \u021d\u0dcf\u0dae\u023d\u0d9a \u026a\u0daf\u0255\u0dcf\u0dbd\u0dba \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dc0\u0dd0\u025e\u0262\u0dbd\u0d9c\u0dc4\u0dbd\u01e6\u0daf, \u0dd9\u014e.\u0d92.\u0d91\u023c. \u0da2\u0dba\u0dd9\