    "text": "2021 \u0d85\u0d82\u0d82\u0d9a 13 \u0daf\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\ufffd\u0db0\u0db1) \u0db4\u0db1\u0dad\u0dd2\u0db1\u0dca, 2019 \u0d85\u0d82\u0d82\u0d9a 11 \u0daf\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\ufffd\u0db0\u0dd2\u0dad) \u0db4\u0db1\u0dad\u0dd2\u0db1\u0dca, 2006 \u0d85\u0d82\u0d82\u0d9a 35 \u0daf\u0dbb\u0db1 \u0db4\u0db1\u0dad\u0dd2\u0db1\u0dca, 1982 \u0d85\u0d82\u0d82\u0d9a 52 \u0daf\u0dbb\u0db1 \u0db4\u0db1\u0dad\u0dd2\u0db1\u0dca \u0dc3\u0dc4 1976 \u0d85\u0d82\u0d82\u0d9a 27 \u0daf\u0dbb\u0db1 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\ufffd\u0db0\u0dd2\u0dad 1968 \u0d85\u0d82\u0d82\u0d9a 15 \u0daf\u0dbb\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf \u0db4\u0db1\u0dad\u0dda\u0dda\u01ae 4 (\u0d85) 1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb, \u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1, \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba, \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0dad\u0dd2\u0dbd\u0d9a \u0dc0\u0db1 \u0db8\u0db8, \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\u0dda\u01ae \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0db8 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1\u0dba\u0db1\u0dca\u0dc4\u0dd2 \u0d91\u0d9a\u0d9f\u0dad\u0dcf\u0dcf\u0dc0\u0dba \u0db8\u0dad \u0db4\u0dc4\u0dad \u0db4\u0dc5\u0db8\u0dd4 \u0d8b\u0db4\u0dbd\u0dda\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u0dda\u024f \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0d9a\u0ddc\ufffd\u0ddc\u0da7 \u0d87\u0dad\u0dd2 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u0dda\u024f \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\u0dda\u01ae \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8\u0dca \u0dad\u0dd4\u0dc5 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0da2\u0dbd\u0dba \u0db6\u0dd0\u0dd0\u0dc3 \u0dba\u0db1 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0da2\u0dbd\u0dba \u0db6\u0dd0\u0dd0\u0dc3 \u0dba\u0dcf\u0dcf\u0db8\u0da7 \u0dc3\u0dbd\u0dc3\u0dca\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0da2\u0dbd\u0dba \u0db6\u0dd0\u0dd0\u0dc3 \u0dba\u0dcf\u0dcf\u0db8\u0dda\ufffd \u0d85\u0dbb\u0db8\u0dd4\u0dab\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dcf\u0dab\u0dba \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dcf\u0dab\u0dba \u0dc0\u0dd3 \u0d87\u0dad\u0dd2, \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0d87\u0dc5 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c, \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0dc5 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c \u0dc4\u0dcf\u0dcf \u0db4\u0ddd\ufffd\u0ddd\ufffd\u0dc2\u0d9a \u0d87\u0dc5 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dc0\u0dbd \u0daf\u0dd9\u0dd9\u0db4\u0dc3 \u0d89\u0dc0\u0dd4\u0dbb\u0dda\u0dda \u0dc3\u0dd2\u0da7 \u0d91\u0d9a\u0dd3 \u0d87\u0dc5 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dc0\u0dbd \u0db8\u0dad\u0dd4\u0db4\u0dd2\u0da7 \u0db4\u0dc5\u0dbd\u0da7 \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4\u0dd3\u0dc0 \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0db4\u0dc4\u0dad \u0daf\u0dd9\u0dd9\u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u0dda\u024f \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0daf\u0dd4\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dcf\u0dab\u0dba\u0db1\u0dca \u0d87\u0dc5 \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dba \u0d9a\u0ddc\ufffd\u0ddc\u0da7 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca\u0d9a\u0dbb\u0db8\u0dd2. \u0db8\u0dd9\ufffd\u0db8 \u0d87\u0dc5 \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dba\u0dda\u0dda\u024f \u0d9a\u0dd2\u0dc3\u0dd2\u0dba\u0db8\u0dca \u0dc3\u0dca\u0dae\u0dd2\u0dbb \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dad\u0dcf\u0dcf\u0dc0\u0d9a\u0dcf\u0dcf\u0dbd\u0dd2\u0d9a \u0dc4\u0ddd\ufffd\u0ddd\ufffd/\u0dc4\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0d86\u0d9a\u0dcf\u0dcf\u0dbb\u0dba\u0d9a \u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9c\u0dd2\u0dbd\u0dd2 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc0\u0dca\u200d\u0dba\u0dd4\u0dd4\u0dc4 \u0d89\u0daf\u0dd2\u0d9a\u0dbb\u0db1\u0dd4 \u0db1\u0ddc\ufffd\u0ddc\u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dad\u0dbb, \u0d91\u0d9a\u0dd3 \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0dad\u0dd4\u0dc5 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d9a\u0dd2\u0dc3\u0dd2\u0dba\u0db8\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dca\u0dad\u0d9a\u0dca \u0dc3\u0daf\u0dc4\u0dcf\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\ufffd \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db8\u0dd9\ufffd\u0dc4\u0dd2 \u0dad\u0dd4\u0db1\u0dca\u0dc0\u0db1 \u0d8b\u0db4\u0dbd\u0dda\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u0dda\u024f \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dc4\u0dcf\u0dcf/\u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0dda\u0dda\u024f \u0daf\u0dd3 \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0d9a\u0dbd\u0da7 \u0db4\u0db1\u0dc0\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0daf\u0dda\u0dda\u0dda\u0dc3\u0dd2 \u0dc4\u0dcf\u0dcf \u0db1\u0dd2\u0dba\u0db8\u0dba\u0db1\u0dca\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0d91\u0d9a\u0dd3 \u0dc3\u0d82\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd9\u0dd9\u0dad\u0dd2\u0db1\u0dca \u0dbd\u0dd2\u0d9b\u0dd2\u0dad \u0d85\u0dc0\u0dc3\u0dbb\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0dcf\u0dcf\u0d9c\u0dad \u0dba\u0dd4\u0dad\u0dd4\u0dba.",
