    ],
    "text": "\u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dda\ufffd \u0db4\u0db1\u0dad\u0dda\u01ae (460 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0db4\u0dbb\u0dd2\u0da0\u0dca\u0da1\u0dda\u0dda\u0daf\u0dba) 38 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u200d\u200d\u0dba\u0dda\u024f (\u0d85) \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dd9\u0dad \u0db4\u0dc0\u0dbb\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0d85\u0db1\u0dd4\u0dc0 \u0d9a\u0dd8\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8, \u0db4\u0dc1\u0dd4 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca, \u0d89\u0da9\u0db8\u0dca \u0dc3\u0dc4 \u0dc0\u0dcf\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba \u0d9a\u0dd4\u0dbb\u0d9c\u0db8\u0d9c\u0dda\u0118 \u0daf\u0ddc\ufffd\u0ddc\u0db1\u0dca \u0dbd\u0dcf\u0dcf\u0dbd\u0dca \u0d9a\u0dcf\u0dcf\u0db1\u0dca\u0dad \u0dc0\u0db1 \u0db8\u0db8, \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d8b\u0db4\u200d\u200d\u0dbd\u0dda\u0262\u0d9b\u0db1\u200d\u200d\u0dba\u0dda\u024f I \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0da1\u0dda\u0dda\u0daf\u0dba\u0dda\u024f \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dda\ufffd \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0da7 \u0db1\u0dd0\u0dd0\u0dad\u0dc4\u0ddc\ufffd\u0ddc\u0dad\u0dca, \u0d91\u0d9a\u0dd3 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d92 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db6\u0dbd\u0dba \u0daf\u0dd9\u0dd9\u0db1 \u0dbd\u0daf \u0dc0\u0dd9\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0dd9\ufffd\u0d9a\u0dd4\u0da7, \u0d91\u0db8 \u0d8b\u0db4\u0dbd\u0dda\u0262\u0d9b\u0db1\u0dba\u0dda\u024f II \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0da1\u0dda\u0dda\u0daf\u0dba\u0dda\u024f \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0dd9\u0db1 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad \u0d89\u0da9\u0db8 \u0dc3\u0dca\u0dc0\u0dcf\u0dcf\u0db8\u0dd2\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db8\u0dd9\u02de\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb\u0db8\u0dd2. \u0d9a\u0dda\u00fa. \u0da9\u0dd3. \u0dbd\u0dcf\u0dcf\u0dbd\u0dca \u0d9a\u0dcf\u0dcf\u0db1\u0dca\u0dad, \u0d9a\u0dd8\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8, \u0db4\u0dc1\u0dd4 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca, \u0d89\u0da9\u0db8\u0dca \u0dc3\u0dc4 \u0dc0\u0dcf\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba.",
