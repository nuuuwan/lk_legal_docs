    "text": "\u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc3\u0dcf\u0dcf\u0db8\u0dca\u0db4\u0dc3\u0dd2\u0dc0\u0db8\u0dca \u0dc3\u0dd4\u0daf\u0dbb\u0dca\u0dc1\u0db1\u0dca \u0dc0\u0db1 \u0db8\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca 2012 \u0d85\u0d82\u0d82\u0d9a 22 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d86\u0dba\u0dad\u0db1 \u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dca (\u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1) \u0db4\u0db1\u0dad\u0dda\ufffd 66(\u0d8b) \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dca\u0dad\u0dcf\u0dcf \u0dc0\u0dd6 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0, \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc5\u0dcf\u0dcf\u0dad \u0dad\u0dd4\u0dc5 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc0\u0dd0\u0dd0\u0dbd\u0dca\u0dc0\u0dd9\u0dd9\u0da7\u0dca\u0da7\u0dd2\u0dad\u0dd4\u0dbb\u0dba\u0dd2 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0dc4\u0dd2 \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0dcf\u0da9\u0dd4 \u0dc0\u0dd3 \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0dad\u0dda\ufffd\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0dbb\u0dd0\u0dc3\u0dca\u0dca\u0dc0\u0dd3\u0db8 2025.11.28 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0db4\u0dd9\u0dd9\u0dbb\u0dc0\u0dbb\u0dd4 \u0db4\u0dd0\u0dd0\u0dba 9.30 \u0da7 \u0dc0\u0dd0\u0dd0\u0dbd\u0dca\u0dc0\u0dd9\u0dd9\u0da7\u0dca\u0da7\u0dd2\u0dad\u0dd4\u0dbb\u0dba\u0dd2 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0db7\u0dcf\u0dcf \u0db8\u0dab\u0dca