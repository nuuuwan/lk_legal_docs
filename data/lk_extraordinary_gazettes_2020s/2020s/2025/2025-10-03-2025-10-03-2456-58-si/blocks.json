      366.2,
      543.33,
      473.76
    ],
    "text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f 2025 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda\u024f \u0db8\u0dd0\u0dd0\u0dba\u0dd2 \u0db8\u0dc3 23 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 2437/53 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d86\u0da5\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca, 2025 \u0dc3\u0dc4 2026 \u0dc0\u0dbb\u0dca\u0dc2\u0dc0\u0dbd \u0daf\u0dd3 \u0db4\u0dd0\u0dd0\u0dc0\u0dd0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8\u0da7 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad. \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0d9c\u0dab\u0db1\u0dba (\u0d9a\u0dd8\u0dd8\u0dc2\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4) \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dd2\u0dab\u0dd2\u0dc3 \u0da2\u0db1\u0dbd\u0dda\u0262\u0d9b\u0db1 \u0dc4\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dbd\u0dda\u0262\u0d9b\u0db1 \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dd4\u0dc4\u0db1\u0dca\u0daf\u0dd2\u0dbb\u0db8\u0dca\u0dbd\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0daf\u0ddd\ufffd\u0ddd\u02ea\u0db1 \u0dc1\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db8\u0dbd\u0dd3 \u0daf\u0dd3\u0db4\u0dd2\u0d9a\u0dcf\u0dcf \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2\u0dba \u0dc3\u0d82\u0d82\u0d9c\u0dab\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dc3\u0d82\u0d82\u0d9c\u0dab\u0db1 \u0d86\u0da5\u0dcf\u0dcf\u0db4\u0db1\u0dad\u0dda\ufffd (143 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dba\u0dda\u024f) 3 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc0\u0dd2\u0dc2\u0dba \u0db7\u0dcf\u0dcf\u0dbb \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d9c\u0dbb\u0dd4 \u0da2\u0db1\u0dcf\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd2. \u0d86\u0da0\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0dc4\u0dbb\u0dca\u0dc2\u0dab \u0dc3\u0dd6\u0dbb\u0dd2\u0dba\u0db4\u0dca\u0db4\u0dd9\u0dd9\u0dbb\u0dd4\u0db8, \u0dbd\u0dda\u0262\u0d9a\u0db8\u0dca, \u0db8\u0dd4\u0daf\u0dbd\u0dca, \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0dcf\u0daf\u0db1 \u0dc3\u0dc4 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\u0255\u0d82\ufffd\u0dc1\u0dba.",
