    "text": "\u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2. : \u0b95\u0731\u0ba3\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd \u201c\u0b8f\u201d \u0bae\u0731\u0b95\u0731\u0ba3\u0bae\u0bcd : \u0bb5\u0b9f \u0bae\u0731\u0b95\u0731\u0ba3\u0bae\u0bcd \u0bae\u0731\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bcd : \u0baf\u0731\u0bb4\u0bcd\u0baa\u0bcd\u0baa\u0731\u0ba3\u0bae\u0bcd \u0baa\u0732\u0bb0\u0737\u0ba4\u0b9a \u0736\u0b9a\u0baf\u0bb2\u0731\u0bb3\u0bb0\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0bc1: \u0ba8\u0bb2\u0bcd\u0bb2\u0bc2\u0bb0\u0bcd \u0b95\u0732\u0bb0\u0731\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0732\u0731\u0732\u0bb5\u0bc1 : \u0737\u0b95\u0731\u0ba3\u0bcd\u0b9f\u0731\u0bb5\u0732\u0bb2\u0bcd \u0736\u0ba4\u0ba9\u0bcd\u0b95\u0732\u0bb4\u0b95\u0bcd\u0b95\u0bc1 \u0737\u071e/120 \u0b95\u0732\u0bb0\u0731\u0bae\u0ba4\u0bcd\u0ba4\u0732\u0ba9\u0bcd \u0736\u0baa\u0baf\u0bb0\u0bcd : \u0737\u0b95\u0731\u0ba3\u0bcd\u0b9f\u0731\u0bb5\u0732\u0bb2\u0bcd \u0b95\u0731\u0ba3\u0732 \u0b89\u0731\u0732\u0738\u0bae\u0baf\u0731\u0bb3\u0731\u0732\u0ba9\u0bcd \u0736\u0baa\u0baf\u0bb0\u0bcd : \u0b9a\u0bb0\u0bb5\u0ba3\u0bae\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0b95\u0bc1\u0b95\u0ba4\u0731\u0b9a\u0ba9\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0738\u0bb2\u0bb5\u0731\u0ba3\u0732 \u201c\u0ba4\u0bc1\u0bb5\u0731\u0bb0\u0738\u0b95\u201d \u0737\u0b95\u0731\u0ba3\u0bcd\u0b9f\u0731\u0bb5\u0732\u0bb2\u0bcd \u0b95\u0732\u0bb4\u0b95\u0bcd\u0b95\u0bc1, \u0737\u0b95\u0731\u0ba3\u0bcd\u0b9f\u0731\u0bb5\u0732\u0bb2\u0bcd. \u0737\u0bae\u0bb1\u0bcd\u0b95\u0bc1\u0bb1\u0732\u0ba4\u0bcd\u0ba4 \u0b95\u0731\u0ba3\u0732\u0b95\u0bcd\u0b95\u0bc1 / \u0b86\u0b9f\u0bcd\u0b9a\u0732 \u0b89\u0731\u0732\u0738\u0bae \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0736\u0b95\u0731\u0bb3\u0bcd\u0bb3\u0bb5\u0732\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b95\u0731\u0ba3\u0732\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0731\u0732\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd\u0737\u0baa\u0b9a\u0bc1\u0b95\u0732\u0ba9\u0bcd\u0bb1 \u0b9a\u0b95\u0bb2\u0bb0\u0bc1\u0bae\u0bcd \u0ba4\u0731\u0bae\u0731\u0b95 \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0bae\u0bc1\u0738\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bbf \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0732\u0bb2\u0bcd \u0b85\u0ba4\u0732\u0b95\u0731\u0bb0\u0bae\u0bb3\u0732\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0731\u0731\u0732\u0baf\u0b95\u0bcd\u0b95\u0731\u0bb0\u0bb0\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0731\u0b95",
