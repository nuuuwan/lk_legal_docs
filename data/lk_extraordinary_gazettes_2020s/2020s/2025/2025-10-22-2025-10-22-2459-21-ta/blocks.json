    "text": "\u0ba4\u0bc7\u0bc7\u0bb0\u0bc1\u0ba8\u0bb0\u0bcd\u0b95\u0bb3\u0bc8\u0bc8\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bbf\u0bb5\u0bc1 \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0ba4\u0bb2\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bae\u0bc8\u0bc8\u0baf 2025\u0ba4\u0bc7\u0bc7\u0bb0\u0bc1\u0ba8\u0bb0\u0bcd\u0b95\u0bb3\u0bc8\u0bc8\u0baa\u0bcd \u0baa\u0ba4\u0bbf\u0bbf\u0bb5\u0bc1 \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0ba4\u0bb2\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bae\u0bc8\u0bc8\u0baf 2025 (2) \u0b95\u0bc1\u0bb1\u0bc8\u0bc8\u0ba8\u0bbf\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0bc1 \u0ba4\u0bc7\u0bc7\u0bb0\u0bc1\u0ba8\u0bb0\u0bcd \u0b87\u0b9f\u0baa\u0bcd\u0baa\u0bc1 (2) \u0b95\u0bc1\u0bb1\u0bc8\u0bc8\u0ba8\u0bbf\u0bbf\u0bb0\u0baa\u0bcd\u0baa\u0bc1 \u0ba4\u0bc7\u0bc7\u0bb0\u0bc1\u0ba8\u0bb0\u0bcd \u0b87\u0b9f\u0baa\u0bcd\u0baa\u0bc1 \u0b85\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bbe\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd\u0b85\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bbe\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd",
