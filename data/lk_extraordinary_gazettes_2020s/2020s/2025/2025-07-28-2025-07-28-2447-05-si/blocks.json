    "text": "\u0db6\u0dda\u0dda\u0229\u0dbb\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0db1\u0dd3\u0dad\u0dd3\u0da5 \u0d86\u0dbb\u0dca. \u0db1\u0dc0\u0ddd\ufffd\u0ddd\u0daf\u0dba\u0db8\u0dca \u0db8\u0dc4\u0dad\u0dcf\u0dcf \u0db8\u0dd9\ufffd\u0db8 \u0d86\u0dbb\u0dcf\u0dcf\u0dc0\u0dd4\u0dbd\u0dd9\ufffd\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dcf\u0dcf \u0d85\u0dc3\u0dca\u0dca\u0dc0\u0db1 \u0db6\u0dc0 \u0daf\u0db1\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad. \u0d91\u0db6\u0dd0\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0dba\u0dae\u0ddd\ufffd\u0ddd\u0d9a\u0dca\u0dad \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u0d9c\u0dba \u0d85\u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dc5\u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0dd0\u0dd0\u0dba\u0dd2 \u0daf\u0dd0\u0dd0\u0db1\u0dca \u0db4\u0dd9\u0dd9\u0db1\u0dd3 \u0dba\u0db1 \u0dc4\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca, \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba \u0d86\u0da0\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0d85\u0db1\u0dd2\u0dbd\u0dca \u0da2\u0dba\u0db1\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0db1\u0dcf\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dc0\u0db1 \u0db8\u0dcf\u0dcf, \u0d91\u0db8 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u0d9c\u0dba \u0d85\u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dbb, \u0d91\u0d9a\u0dd3 2022.06.29 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0daf\u0dbb\u0db1 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u0d9c\u0dba \u0db8\u0dad \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf \u0db1\u0ddc\ufffd\u0ddc\u0d9a\u0dbb\u0db1 \u0dbd\u0dd9\ufffd\u0dc3 \u0daf \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u0d9c \u0d9a\u0dbb\u0db8\u0dd2.",
