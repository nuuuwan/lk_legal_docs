    ],
    "text": "1984 \u0d85\u0d82\u0d9a 37 \u0daf\u0dbb\u0db1 \u026a\u0dd9\u0db1\u02a4\u0daf \u0db6\u01d0 (\u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1) \u0db4\u0db1\u01af\u01e6 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u01dd\u0dad (267 \u0dc0\u0db1 \u0d85\u01dd\u0d9a\u0dcf\u0dbb\u0dba \u026d) 1946 \u0d85\u0d82\u0d9a 12 \u0daf\u0dbb\u0db1 \u026a\u0dd9\u0db1\u02a4\u0daf \u0db6\u01d0 \u0d86\u0da5\u0dcf\u0db4\u0db1\u0dd9\u01ae 2 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (1) \u0dc0\u0db1 \u0d8b\u0db4 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dc3\u0db3\u0dc4\u01e6 \u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u021d\u0d9a\u0dcf\u0dbb\u0dc0, \u0db8\u0dc4\u01e9\u0dc0\u0dbb \u0db8\u0dc4\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u026a\u0286\u01e6 2023.08.16 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0db4\u0dd0\u0dc0\u01af \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab \u0d9a\u023d\u017b\u0dd9\u0269 \u01b0\u0dbb\u0dab \u0d85\u0d82\u0d9a 2023/408 \u0dba\u0da7\u0dd9\u01ae \u0dc3\u023c\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u01d0\u0dc0, \u0db8\u0dcf \u026a\u0286\u01e6 \u0d85\u01e9\u0db8\u0dad \u0d9a\u0dbb \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u0d82\u0d9a 2384/33 \u0dc4\u0dcf 2024.05.17 \u01ce\u0db1\u0dd0\u01af \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u0db8\u0119\u01e6 \u021d\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u01ae \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u01e7\u0dd9\u0269\u0daf\u0db1\u0dba, \u0db8\u0dc4\u01e9\u0dc0\u0dbb \u0db8\u0dc4\u0dcf \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dd9\u0269 2024.10.01 \u0dc0\u0db1 \u01ce\u0db1 \u0db4\u0dd0\u0dc0\u01af \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab\u00ab\u0d9a\u023d\u017b\u0dd9\u0269 \u01b0\u0dbb\u0dab \u0d85\u0d82\u0d9a 2024/1544 \u0dba\u0da7\u0dd9\u01ae \u0dc3\u023c\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0dd9\u0dba\u02a4\u0da2\u0db1\u0dcf\u0dc0 \u0db4\u025c\u01ce \u0dd9\u0db8\u028f \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u0dba\u028f \u0dc3\u0db3\u0dc4\u01e6 \u0d86\u0d9a\u0dcf\u0dbb\u0dba\u0da7 \u0dc3\u0d82 \u0dd9\u0dc1\u02a4\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0db6\u0dc0, 1989 \u0d85\u0d82\u0d9a 12 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf (\u0d86\u01e9\u0dc1\u0dcf\u0d82\u0119\u0d9a \u026a\u01dd\u026a\u0db0\u0dcf\u0db1) \u0db4\u0db1\u0dd9\u01ae 2(1) (\u0d85) \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dc3\u0db8\u0d9f \u00fb\u0dba\u026a\u0dba \u0252\u01b1 \u026a\u0dd9\u0db1\u02a4\u0daf \u0db6\u01d0 \u0d86\u0da5\u0dcf\u0db4\u0db1\u0dd9\u01ae 2(2) \u0d8b\u0db4 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0dc3\u0db3\u0dc4\u01e6 \u026a\u01dd\u026a\u0db0\u0dcf\u0db1 \u0d85\u01e9\u0dc0 \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u021d\u0d9a\u0dcf\u0dbb\u0dc0 \u0db8\u0db0\u0255\u0db8 \u0db4\u0dc5\u0dcf\u01ae \u0d86\u019c\u018d\u0d9a\u0dcf\u0dbb \u0dc3\u0dbb\u01ae \u022b. \u0d91\u0dc3\u0dca. \u0d85\u0db7\u0dba\u0dd9\u0d9a\u02a4\u01e6 \u0dc0\u0db1 \u0db8\u0dcf \u026a\u0286\u01e6 \u0d85\u01e9\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db6\u0dc0\u0da7 \u0d91\u00fc \u0d8b\u0db4\u0dc0\u0d9c\u01e6\u01af\u0dba \u0d85\u01e9\u0dc0 \u0dd9\u0db8\u0250\u01e6 \u0db4\u0dc5\u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229.",
