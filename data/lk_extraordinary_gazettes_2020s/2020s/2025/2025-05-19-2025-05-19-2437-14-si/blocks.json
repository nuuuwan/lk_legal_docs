    ],
    "text": "\u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 38 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba (\u0d85) \u0d85\u01b1\u025e \u026a\u0db0\u0dcf\u0db1\u0dba \u0dba\u0da7\u0dd9\u01ae \u0db4\u0db1\u0dc0\u0db1 \u0dbd\u01ca\u0daf\u0dcf\u026d \u0daf, \u0d85\u0d82\u0d9a 1887/41 \u0dc4\u0dcf 2014.11.07 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0daf\u0dbb\u0db1 \u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5\u0d9a\u0dbb\u0db1 \u0dbd\u01ca\u0daf\u0dcf\u026d \u0daf, 2014 \u0d85\u0d82\u0d9a 308 \u0dc4\u0dcf 2014.10.31 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0daf\u0dbb\u0db1 \u0d86\u0da5\u0dcf\u0dd9\u0269 \u0dc3\u026a\u0dc3\u0dca\u0dad\u0dbb\u0dc0 \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dba \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u01af\u0dd9\u0229. \u0db4\u0dc4\u0dad \u026a\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0db1 \u0d91\u0db8 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u0dda \u0236\u00fa\u01af\u0dba \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dba \u0dd9\u0dc0\u01e9\u0dd9\u0dc0\u01e6 \u0dd9\u0db8\u0dd9\u0dad\u00fa \u0db7\u0dcf\u0dbb\u0dd9\u0d9c\u0db1 \u0dd9\u0db1\u02a3\u0db8\u0dd0\u0dad. \u0d91\u0db6\u0dd0\u026a\u01e6, \u0d9a\u0dd8\u027f\u0d9a\u0259\u0db8, \u0db4\u0276 \u0dc3\u023c\u0db4\u01ae, \u0d89\u0da9\u023c \u0dc3\u0dc4 \u0dc0\u0dcf\u025c\u0db8\u0dcf\u0259\u0d9c \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba, \u0d9a\u0dd4\u0dbb\u0d9c\u0db8\u0dd9\u0118 \u0dd9\u0daf\u02a3\u01e6 \u0dbd\u0dcf\u0262 \u0d9a\u0dcf\u01e6\u0dad \u0dc0\u0db1 \u0db8\u0db8 \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 39(1) \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0db8\u0dcf\u0dc4\u0da7 \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u0d85\u01e9\u0dc0 \u0d85\u0d82\u0d9a 1887/41 \u0dc4\u0dcf 2014.11.07 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0daf\u0dbb\u0db1 \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 2014 \u0d85\u0d82\u0d9a 308 \u0dc4\u0dcf 2014.10.31 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0daf\u0dbb\u0db1 \u0d86\u0da5\u0dcf\u0dd9\u0dc0\u028f \u0db4\u0dc4\u0dad \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u0dc3\u023c\u0db6\u01e6\u0db0 \u0dd9\u0dba\u01e6 \u0db4\u0db8\u0dab\u00fa \u01e7\u0dba\u0db8\u0dba \u0db8\u0119\u01e6 \u021d\u0dad\u0dca\u200d\u0dba\u0dcf\u01ce\u0dc2\u0dca\u0da8 \u0d9a\u0dbb\u023d.",
