    "text": "\u0b95\u0ba8\u0bcd\u0ba4\u0bbe\u0bbe\u0ba9\u0724, \u0baa\u0bc1\u0ba9\u0bbf\u0bbf\u0ba4 \u0b9a\u0bc6\u0bc6\u0baa\u0bb8\u0bcd\u0b9f\u0bbf\u0baf\u0ba9\u0bcd \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0ba4\u0bc7\u0bc7\u0bb5\u0bbe\u0bbe\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0bb5\u0bb0\u0bc1\u0b9f\u0bbe\u0bbe\u0ba8\u0bcd\u0ba4 \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bbf\u0bb4\u0bbe\u0bbe 2026, \u0b9a\u0ba9\u0bb5\u0bb0\u0bbf\u0bbf 20 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf \u0ba8\u0b9f\u0bc8\u0bc8\u0baa\u0bc6\u0bc6\u0bb1\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1\u0bae\u0bcd, \u0baa\ufffd\u0bca\u0ba4\u0bc1 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0ba4\u0b95\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0b95 \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bbf\u0bb4\u0bbe\u0bbe\u0b95\u0bcd \u0b95\u0bbe\u0bbe\u0bb2\u0bae\u0bcd 03.01.2026 \u0bae\u0bc1\u0ba4\u0bb2\u0bcd 08.02.2026 \u0bb5\u0bb0\u0bc8\u0bc8\u0bc8\u0baf\u0bbe\u0bbe\u0ba9 \u0b95\u0bbe\u0bbe\u0bb2\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0bbf \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b87\u0ba4\u0ba9\u0bcd \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0b85\u0bb1\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1.",
