    "text": "\u201b\u201b \u201b\u201b\u0d85\u0dad\u0dae\u0dca\u200d\u0dba\u0dba \u0dbd\u0dd9\ufffd\u0dc3 \u0da1\u0db1\u0dca\u0daf\u0dba \u0dbd\u0db6\u0dcf\u0dcf\u0daf\u0dd3\u0db8\u0dda\u023c \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u201d, \u0dba\u0db1\u0dca\u0db1\u0dd9\ufffd\u0db1\u0dca, \u0dba\u0db8\u0dca \u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0d9a \u0daf\u0dd3 \u0da1\u0db1\u0dca\u0daf \u0db8\u0db0\u0dca\u200d\u0dba\u0dba\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba\u0d9a\u0da7 \u0da1\u0db1\u0dca\u0daf\u0daf\u0dcf\u0dcf\u0dba\u0d9a\u0dba\u0db1\u0dca \u0db7\u0dde\ufffd\u0dde\u0dad\u0dd2\u0d9a \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dd0\u0dd0\u0db8\u0dd2\u0dab\u0dd3\u0db8\u0dda\u023c \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba\u0dad\u0dcf\u0dcf\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0dad\u0ddc\u02d4\u0ddc\u0dbb\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dc0 \u0da1\u0db1\u0dca\u0daf\u0dba \u0dbd\u0db6\u0dcf\u0dcf\u0daf\u0dd3\u0db8, \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8, \u0dc3\u0db8\u0dca\u0db4\u0dca\u200d\u0dbb\u0dda\u0dda\u0dc2\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0da1\u0db1\u0dca\u0daf \u0d9c\u0dab\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d89\u0dbd\u0dd9\ufffd\u0d9a\u0dca\u0da7\u0dca\u200d\u0dbb\u0ddc\u017e\u0ddc\u0db1\u0dd2\u0d9a \u0db4\u0daf\u0dca\u0db0\u0db0\u0dad\u0dd2, \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0da9\u0dd2\u0da2\u0dd2\u0da7\u0dbd\u0dca \u0d9a\u0dca\u200d\u0dbb\u0db8 \u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d85\u0daf\u0dc4\u0dc3\u0dca\u0dca \u0dc0\u0dda\u0dda.\u201d",
