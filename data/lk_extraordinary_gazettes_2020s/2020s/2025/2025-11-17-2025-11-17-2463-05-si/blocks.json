    ],
    "text": "\u0d86. \u0d89\u0db1\u0dca\u0dc0\u0ddc\ufffd\u0ddc\u0dba\u0dd2\u0dc3\u0dd2\u0dba\u0dda\u024f \u0daf\u0dd2\u0db1\u0dba - MM/DD/YYYY (\u0db8\u0dcf\u0dcf\u0dc3\u0dba/\u0daf\u0dd2\u0db1\u0dba/\u0dc0\u0dbb\u0dca\u0dc2\u0dba) \u0d86\u0d9a\u0dd8\u0dd8\u0dad\u0dd2\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dd2\u0dad \u0d89\u0db1\u0dca\u0dc0\u0ddc\ufffd\u0ddc\u0dba\u0dd2\u0dc3\u0dd2\u0dba \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dc5 \u0daf\u0dd2\u0db1\u0dba.\u0d87. \u0dc3\u0dd0\u0dd0\u0db4\u0dba\u0dd4\u0db8\u0dca \u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba - \u0db7\u0dcf\u0dcf\u0dab\u0dca\u0da9 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0dc3\u0dd0\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0dc0\u0db1 \u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba.\u0d88. \u0dc3\u0dd0\u0dd0\u0db4\u0dba\u0dd4\u0db8 \u0db7\u0dcf\u0dcf\u0dbb \u0daf\u0dd9\u0dd9\u0db1 \u0daf\u0dd2\u0db1\u0dba - MM/DD/YYYY (\u0db8\u0dcf\u0dcf\u0dc3\u0dba/\u0daf\u0dd2\u0db1\u0dba/\u0dc0\u0dbb\u0dca\u0dc2\u0dba) \u0d86\u0d9a\u0dd8\u0dd8\u0dad\u0dd2\u0dba\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dd2\u0dad \u0db7\u0dcf\u0dcf\u0dab\u0dca\u0da9 \u0db6\u0dd9\ufffd\u0daf\u0dcf\u0dcf \u0dc4\u0dd0\u0dd0\u0dbb\u0dd3\u0db8 \u0dc4\u0ddd\ufffd\u0ddd\ufffd",
    "fonts": [
      "IskoolaPota",
