dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 5:51 0.0771 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0d9c\u0dbd 5:52 0.0521 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - - 5:53 0.0297 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - - 5:54 0.0417 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u0dad\u0dca \u0d9a\u0dc3\u0dca\u0dad\u0dcf\u0dbb\u0db1\u0dca \u0db4\u0dad\u0dd2\u0dbb\u0db1\u0dca\u0db1\u0dd0\u0dc4\u0dd0\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dad\u0dd4\u0dc2\u0dcf\u0db1\u0dca \u0dc0\u0dc3\u0db1\u0dca\u0dad \u0da0\u0db1\u0dca\u0daf\u0db4\u0dcf\u0dbd \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 507781 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc0\u0d9c\u0dcf\u0d9a\u0dbb \u0d87\u0dad. \u0daf\u0dd2\u0db8\u0db1\u0dcf\u0db4\u0dad\u0dba\u0d9a\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 5:55 0.0593 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - - 5:56 0.0214 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - - 5:57 0.0202 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0db8\u0dcf\u0dbb\u0dca \u0d9c\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dbb \u0d87\u0dad. 5:58 0.0470 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - - 5:59 0.1583 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0d89.\u0dc3\u0d82.\u0d86. \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db1\u0dc0\u0d9c\u0db8\u0dd4\u0dc0\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0db1\u0dd2\u0dc4\u0dcf\u0dbd\u0dca \u0db1\u0dc0\u0d9c\u0db8\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 507780 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc0\u0d9c\u0dcf\u0d9a\u0dbb \u0d87\u0dad. \u0daf\u0dd3\u0db8\u0db1\u0dcf \u0db4\u0dad\u0dba\u0d9a\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 5:60 0.2244 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - - 5:61 0.4015 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - - 5:62 0.1043 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - - 5:63 0.1029 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - - 5:64 0.1391 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0d89.\u0dc3\u0d82.\u0d86 \u0db4\u0db1\u0dad \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddd\u0dbb\u0dcf\u0dbd \u0d9c\u0db8\u0dd9\u0d9c\u0dca \u0dbd\u0dc4\u0dd2\u0dbb\u0dd4 \u0daf\u0dd2\u0db1\u0dcf\u0dbd\u0dca \u0db4\u0db1\u0dcf\u0db1\u0dca\u0daf\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dad \u0d85\u0d82\u0d9a 507778 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0dc0\u0d9c\u0dcf\u0d9a\u0dbb \u0d87\u0dad. \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0db4\u0dad\u0dba\u0d9a\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 5:65 0.0169 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0db8\u0dcf\u0dbb\u0dca \u0d9c\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dc5 \u0db6\u0dd2\u0db8 5:66 0.0678 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0d87\u0dc5 \u0daf\u0dd2\u0dd9\u0d9c\u0dca \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dc5 \u0db6\u0dd2\u0db8 5:67 0.0188 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0d87\u0dc5 5:68 0.0513 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0d87\u0dc5 \u0daf\u0dd2\u0dd9\u0d9c\u0dca \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dc5 \u0db6\u0dd2\u0db8 5:69 0.2328 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - - 5:70 0.0171 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0db8\u0dcf\u0dbb\u0dca \u0d9c\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dc0\u0db1\u0dca\u0d9a\u0dc5 \u0db6\u0dd2\u0db8 5:71 0.0367 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0d87