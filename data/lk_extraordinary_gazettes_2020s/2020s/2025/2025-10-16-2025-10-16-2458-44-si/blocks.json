    "text": ", \u0d85\u0d82\u0d82\u0d9a 99 \u0daf\u0ddc\ufffd\u0ddc\u0da9\u0db8\u0dca\u0d9c\u0ddc\ufffd\u0ddc\u0dbd\u0dca\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8 \u0daf\u0daf, \u0d85\u0d82\u0d82\u0d9a 99B \u0daf\u0dd9\u0dd9\u0dc4\u0dd2\u0d85\u0dad\u0dca\u0dad\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8 \u0daf\u0daf, \u0d85\u0d82\u0d82\u0d9a 99A \u0d9a\u0dab\u0dd4\u0dbd\u0dca\u0dc0\u0dd9\u0dd9\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8 \u0daf\u0daf, \u0d85\u0d82\u0d82\u0d9a 100A \u0d9a\u0dd4\u0dbb\u0dd4\u0dc0\u0dcf\u0dcf\u0db9 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8 \u0dc4\u0dcf\u0dcf \u0d85\u0d82\u0d82\u0d9a 100E \u0dc4\u0dd9\ufffd\u0dc0\u0dd9\u0dd9\u0dbd\u0dca\u0dc0\u0dd9\u0dd9\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dca \u0dc0\u0dbd\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0d85\u0d82\u0d82\u0d9a 102D \u0d85\u0db9\u0d9c\u0ddc\ufffd\u0ddc\u0dbd\u0dca\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0d89\u0dad\u0dd2\u0dbb\u0dd2 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3 \u0daf\u0daf, \u0d85\u0d82\u0d82\u0d9a 102A \u0dbb\u0daf\u0daf\u0dbd\u0dd2\u0dba\u0daf\u0dca\u0daf\u0daf \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0d89\u0dad\u0dd2\u0dbb\u0dd2 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0daf\u0daf, \u0d85\u0d82\u0d82\u0d9a 100B \u0dbb\u0dad\u0dd4\u0db4\u0dc3\u0dca\u0d9a\u0dd0\u0dd0\u0da7\u0dd2\u0dba \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\ufffd \u0