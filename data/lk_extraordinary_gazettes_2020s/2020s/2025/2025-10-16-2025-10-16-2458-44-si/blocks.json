    "text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\ufffd 1980.04.18 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0dc3\u0dc4 \u0d85\u0d82\u0d82\u0d9a 84/7 \u0daf\u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2 \u0db6\u0dbd \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba\u0d9a\u0dca \u0dbd\u0dd9\ufffd\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0daf \u0db8\u0ddc\ufffd\u0ddc\u0db1\u0dbb\u0dcf\u0dcf\u0d9c\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda\ufffd \u0db6\u0dd2\u0db6\u0dd2\u0dbd \u0db1\u0dcf\u0dcf\u0d9c\u0dbb\u0dd2\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db0\u0db1 \u0db6\u0dbd \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dc1\u0dba\u0da7 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dca \u0dc0\u0dc1\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d85\u0dba\u0dad\u0dca \u0dc0\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dc0\u0dd6 \u0d85\u0d82\u0d82\u0d9a 102D \u0d85\u0db9\u0d9c\u0ddc\ufffd\u0ddc\u0dbd\u0dca\u0dbd \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8 \u0daf\u0daf, \u0d85\u0d82\u0d82\u0d9a 102A \u0dbb\u0daf\u0daf\u0dbd\u0dd2\u0dba\u0daf\u0dca\u0daf\u0daf \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0daf\u0daf, \u0d85\u0d82\u0d82\u0d9a 100B \u0dbb\u0dad\u0dd4\u0db4\u0dc3\u0dca\u0d9a\u0dd0\u0dd0\u0da7\u0dd2\u0dba \u0d9c\u0dca\u2