dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1:64 0.0242 \u0db4\u0dad\u0dd2\u0dbb\u0dc0\u0dc3\u0db8\u0dca \u0db8\u0dcf\u0daf\u0dd4\u0dd9\u0d9c\u0ddc\u0da9\u0dd9\u0d9c\u0dca \u0d85\u0dbb\u0dd4\u0dab\u0dd2\u0d9a\u0dcf 198281200093 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1:14, _ \u0d8b\u0daf\u0dba\u0dcf\u0d82\u0d9c\u0db1\u0dd3 1:61 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dc4\u0dcf \u0db8\u0dc0\u0dd4\u0db1\u0dca\u0da7\u0dca \u0db4\u0dca\u0dbd\u0dc3\u0db1\u0dca\u0da7\u0dca \u0dc0\u0dad\u0dca\u0dad, \u0d85\u0dd9\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0dc4\u0db4\u0dd4\u0d9c\u0dbd, \u0dc0\u0d9a\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd. \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0d9c. 1:122 0.0249 \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd2\u0db8\u0dcf \u0dc3\u0dd4\u0dbb\u0db1\u0dca\u0daf\u0dd2 \u0dc0\u0dd3\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 828242644V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1:61 \u0dc4\u0dd2 _ \u0dd9\u0db1\u0ddc.22\u0da9\u0dd3, \u0db1\u0dcf\u0d9c\u0dbb\u0dd4\u0d9a\u0dca\u0d9a\u0dcf\u0dbb\u0dcf\u0db8 \u0db4\u0dcf\u0dbb, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dc4\u0dcf \u0d85\u0dd9\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd9\u0dbd\u0dca\u0d9c\u0dcf\u0db1, \u0d9c\u0dcf\u0dbd\u0dca\u0dbd. \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c. 1:148 0.0265 \u0dd9\u0dc4\u0dda\u0dc0\u0dcf \u0dc0\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd9\u0d9c\u0dca \u0da2\u0db1\u0d9a \u0dc3\u0dd4\u0dc3\u0db1\u0dca\u0dad 763581730V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1:147 _ \u0d85\u0d82\u0d9a 40, \u0db0\u0dbb\u0dca \u0db8\u0dbb\u0dcf\u0da2 \u0db8\u0dcf\u0dc0\u0dad, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dc4\u0dcf \u0d85\u0dd9\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0d9a\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dcf\u0dbd\u0dca\u0dbd. \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd3\u0db1\u0dca \u0dc3\u0db8\u0d9c. 1:150 0.0281 \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0db7\u0dcf\u0dad\u0dd2\u0dba 952672223V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1:147 \u0dc4\u0dd2 _ \u0db8\u0dd2\u0dc4\u0dd2\u0dbb\u0dcf\u0db1\u0dca \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dc4\u0dcf \u0d85\u0dd9\u0db1\u0d9a\u0dd4\u0dad\u0dca 8/1\u0dc3\u0dd3, \u0dc0\u0dd0\u0d9a\u0dd4\u0dab\u0dd4\u0dd9\u0d9c\u0ddc\u0da9 \u0db4\u0da7\u0dd4\u0db8\u0d9c, \u0db4\u0dbb\u0dc0\u0dc1\u0255\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dd9\u0db6\u0ddd \u0dd9\u0db4\u0dca, \u0d9c\u0dcf\u0dbd\u0dca\u0dbd. \u0dc3\u0db8\u0d9c. EOG 04 - 0066/1",
