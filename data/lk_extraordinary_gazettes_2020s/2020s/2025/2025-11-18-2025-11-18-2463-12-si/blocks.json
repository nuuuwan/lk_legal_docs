    ],
    "text": "5. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb \u2018F\u2019 - \u0dc4\u0d9a\u0dd4\u025e\u0d9a\u0dd4\u0249\u0dbb (\u0dd9\u0d9a\u0dcf\u0da7\u0dc3\u00fa) \u0dc3\u0dc4 \u0d87\u0dc3\u0dca\u0288\u01ca\u0daf\u0dcf\u0dc0\u0dbd \u0d9a\u0dd4\u0249\u0dbb - \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.2040 \u0d8b\u01b1\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb C (\u0dc3\u0dd0\u0dc5\u0263\u028f\u019d \u0db8\u0dcf\u0dc0\u0dad \u0d87\u0dd9\u0dc5\u0dca \u0dd9\u0d9a\u0dcf\u0da7\u0dc3\u00fa); \u0db1\u0dd0 \u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb C (\u0dc3\u0dd0\u0dc5\u0263\u028f\u019d \u0db8\u0dcf\u0dc0\u0dad \u0d87\u0dd9\u0dc5\u0dca \u0dd9\u0d9a\u0dcf\u0da7\u0dc3\u00fa) \u0dc3\u0dc4 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u01e6\u0db1\u0dcf \u0dc3\u0dc4 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8; \u0daf\u0d9a\u0dd4\u0dab\u0da7: \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u01e6\u0db1\u0dcf \u0dc3\u0dc4 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8,\u023f\u0262\u0dd9\u0262\u025c\u0dba\u0dcf\u0dc0, \u0286\u025c\u0db4\u0dd0\u0dbb\u0d9a\u0dd4\u023c \u0db8\u0dcf\u0dc0\u0dd9\u01ae, \u0d85\u0d82\u0d9a 499/3/K/5 \u028f \u0db4\u01ce\u0d82\u013d \u026a\u0100\u0db8\u0286\u0d82\u0dc4 \u0d86\u0dbb\u013c\u013d\u0dbd\u0dcf\u0dd9\u0118 \u0d9a\u0dcf\u01e6\u01af \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d87\u0dc3\u0dca\u0288\u01ca\u0daf\u0dcf\u0dc0\u0dbd \u0d9a\u0dd4\u0249\u0dbb, \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u01e6\u0db1\u0dcf \u0dc3\u0dc4 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8, \u0d92.\u0d91\u013c.\u0219. \u026a\u0db8\u0dbd\u0dbb\u01ae\u0db1 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dd9\u0d9c\u0dcf\u0da9\u0dd0\u0262\u0dbd \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8, \u0150.\u0288\u014f\u0dc0 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dd9\u0d9c\u0dcf\u0da9\u0dd0\u0262\u0dbd \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba 126/086 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u0db8,\u028f\u023d\u0d9a\u023c \u00fb\u0dba\u01e6\u0db1\u0dcf \u0dc3\u0dc4 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8, \u0d91\u023c.\u0219.\u021f\u0dba\u01e6\u0dad \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dd9\u0d9c\u0dcf\u0da9\u0dd0\u0262\u0dbd \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8 \u0dc3\u0dc4 \u0d85\u0d82\u0dd9\u0d9c\u0dcf\u0da9, \u023f\u0262\u0dd9\u0262\u025c\u0dba\u0dcf\u0dc0 \u0d8b\u01b1\u0dbb,\u0dd9\u0db6\u0dcf\u0dca\u01dd\u0dba \u0db4\u017b\u0db8\u0dd9\u0134 \u0d85\u0d82\u0d9a 55G \u028f \u0db4\u01ce\u0d82\u013d \u0dc4\u021a\u0d86\u0dbb\u013c\u013d\u0dd9\u0118 \u0dc3\u0db8\u0dcf\u01dd \u01e8\u0dd9\u0dbb\u0dcf\u0dca\u0dc2\u019e \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d89\u0da9\u0db8; \u0db6\u0da7\u028f\u0dbb\u0da7: \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u01e6\u0db1\u0dcf \u0dc3\u0dc4 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8, \u0d92.\u0d91\u013c.\u0219. \u026a\u0db8\u0dbd\u0dbb\u01ae\u0db1 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dd9\u0d9c\u0dcf\u0da9\u0dd0\u0262\u0dbd \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8, \u0150.\u0288\u014f\u0dc0 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dd9\u0d9c\u0dcf\u0da9\u0dd0\u0262\u0dbd \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba 126/086 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u0db8,\u028f\u023d\u0d9a\u023c \u00fb\u0dba\u01e6\u0db1\u0dcf \u0dc3\u0dc4 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8 \u0d91\u023c.\u0219.\u021f\u0dba\u01e6\u0dad \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dd9\u0d9c\u0dcf\u0da9\u0dd0\u0262\u0dbd \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8 \u0dc3\u0dc4 \u0d85\u0d82\u0dd9\u0d9c\u0dcf\u0da9, \u023f\u0262\u0dd9\u0262\u025c\u0dba\u0dcf\u0dc0 \u0d8b\u01b1\u0dbb,\u0dd9\u0db6\u0dcf\u0dca\u01dd\u0dba \u0db4\u017b\u0db8\u0dd9\u0134 \u0d85\u0d82\u0d9a 55G \u028f \u0db4\u01ce\u0d82\u013d \u0dc4\u021a\u0d86\u0dbb\u013c\u013d\u0dd9\u0118 \u0dc3\u0db8\u0dcf\u01dd \u01e8\u0dd9\u0dbb\u0dcf\u0dca\u0dc2\u019e \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d89\u0da9\u0db8.",
