    "text": "\u201c\u0d9a\u0dd8\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0dc0\u0dd2\u0dc1\u0dda\ufffd\u0dda\u0dc2 \u0d9a\u0dca\u0dc2\u0dda\u0dda\ufffd\u0dad\u0dca\u200d\u0dbb\u0dba \u0dba\u0db1\u0dca\u0db1\u0dd9\ufffd\u0db1\u0dca, \u0d9a\u0dd8\u0dd8\u0dc2\u0dd2 \u0da2\u0dd3\u0dc0 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0, \u0d9a\u0dd8\u0dd8\u0dc2\u0dd2 \u0d89\u0d82\u0d82\u0da2\u0dd2\u0db1\u0dda\ufffd\u0dbb\u0dd4 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0, \u0d9a\u0dd8\u0dd8\u0dc2\u0dd2 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db4\u0dca\u0dad\u0dd2, \u0dc3\u0dad\u0dca\u0dad\u0dca\u0dc0 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0, \u0da2\u0dd3\u0dc0 \u0dc3\u0d82\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db1\u0dba, \u0d9a\u0dd8\u0dd8\u0dc2\u0dd2 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0, \u0db6\u0ddd\ufffd\u0ddd\ufffd\u0d9c \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0, \u0d86\u0dc4\u0dcf\u0dcf\u0dbb \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0 \u0dc3\u0dc4 \u0dad\u0dcf\u0dcf\u0d9a\u0dca\u0dc2\u0dab\u0dba, \u0db4\u0dd0\u0dd0\u0dbd\u0dd1\u0dd1\u0da7\u0dd2 \u0dc3\u0d82\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dab\u0dba, \u0db4\u0dcf\u0d82\ufffd\u0d82\u0dc1\u0dd4 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dc0, \u0dc0\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db4\u0dcf\u0dcf\u0dbb \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dcf\u0dbd\u0db1\u0dba, \u0db6\u0dc4\u0dd4 \u0dc1\u0dd2\u0d9a\u0dca\u0dc2\u0dab \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0dba\u0db1 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d86\u0dba\u0dad\u0db1\u0dba\u0dda\u0dda\u024f \u0dc3\u0dc4 \u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0dbd\u0dba\u0dda\u0dda\u024f \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dba \u0db8\u0dad \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dc1\u0dda\ufffd\u0dda\u0dc2 \u0d9a\u0dca\u0dc2\u0dda\u0dda\ufffd\u0dad\u0dca\u200d\u0dbb\u0dba\u0d9a\u0dca \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dc0\u0dda\u0dda\u0dda; \u0dc3\u0dc4\u201d.",
