    "text": "2005 \u0d85\u0d82\u0d82\u0d9a 38 \u0daf\u0dbb\u0db1 \u0dc3\u0d82\u0d82\u0da0\u0dcf\u0dcf\u0dbb\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0db1\u0dad\u0dda\u01ae 53 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0dc3\u0d82\u0d82\u0da0\u0dcf\u0dcf\u0dbb\u0d9a \u0dc3\u0d82\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0dda\u0dda\u024f \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd2\u0d9a \u0dc4\u0dda\u0dda\u02e7\u0dda\u0dc0\u0dcf\u0dcf\u0dc0\u0dc3\u0db8\u0dca \u0dc0\u0db1 \u0db8\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca, \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dcf\u0dbb\u0dd2\u0dba\u0dda\u0dda\u024f \u0dc3\u0dcf\u0dcf\u0db8\u0dcf\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db1\u0dca\u0d9c\u0dda\u0dda\u0118 \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dda\u0dc1\u0dba \u0db8\u0dad, \u0db8\u0dd9\ufffd\u0db8 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca, 2005 \u0d85\u0d82\u0d82\u0d9a 38 \u0daf\u0dbb\u0db1 \u0dc3\u0d82\u0d82\u0da0\u0dcf\u0dcf\u0dbb\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0db1\u0dad\u0dda\u01ae 53 \u0dc0\u0db1 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u0dda\u024f (1) \u0dc0\u0db1 \u0d8b\u0db4\u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0dc3\u0dcf\u0dcf\u0daf\u0db1 \u0dbd\u0daf \u0db4\u0dc4\u0dad \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0db1 \u0db1\u0dd2\u0dba\u0db8\u0dba\u0db1\u0dca, \u0d92 \u0dba\u0da7\u0dad\u0dda\u01ae \u0db8\u0dd2\u0db1\u0dca \u0db4\u0dd9\u0dd9\u0dbb \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u0dd2\u0dc3\u0dd2\u0dc0\u0d9a\u0da7 \u0d85\u0d9c\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0db1\u0ddc\uff