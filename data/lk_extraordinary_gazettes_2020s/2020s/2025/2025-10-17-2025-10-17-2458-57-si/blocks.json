\u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014- (\u0dba \u0d9a\u0dca\u0d9a\u0dba\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1 : 9 0.0408 \u0d8b\u0dc3\u0dca\u0dc0\u0dda\u0dcf \u0dbd\u0dd2\u0dba\u0db1\u0dba\u0dda \u0dbb\u0d82\u0da2\u0dd2\u0dda 195821601240 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a - \u0d9a\u0d82\u0d9a 649, \u0dc3\u0db8 \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba 52002\u0dc3/1/39 \u0dc3 \u0d9a\u0dca\u0dad\u0dba\u0daf\u0dc0\u0dda\u0dcf, \u0db8\u0dd3\u0dba\u0d9c\u0ddc\u0da9 52002\u0dc3/2/6,10 \u0dc3 11\u0dc3 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f 1 : 2 0.0469 \u0dba\u0db8\u0dbb\u0dd2\u0da4\u0dca\u0da4\u0dbd\u0dcf\u0dba\u0dda \u0db1\u0dd2\u0dba\u0dbb\u0dcf\u0dc2\u0dcf 806460249V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a 10 \u0dc4\u0dd2 - \u0da2\u0dcf\u0dba\u0dbb\u0dd4\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf \u0d9a\u0d82\u0d9a 645/3, \u0d9a\u0dca\u0dad\u0dba\u0daf\u0dc0\u0dda\u0dcf, \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0db8\u0dd3\u0dba\u0d9c\u0ddc\u0da9 1 : 65 0.04\u0dc38 \u0d9a\u0db1\u0dda\u0dcf\u0dba\u0dda \u0da0\u0db8\u0dca\u0db4\u0dcf \u0dc3\u0db8\u0dbb\u0dba\u0d9a\u0dcf\u0dca\u0dad 50546263\u0dc3V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba - - \u0d9a\u0d82\u0d9a 638, \u0d9a\u0dca\u0dad\u0dba\u0daf\u0dc0\u0dda\u0dcf, \u0db8\u0dd3\u0dba\u0d9c\u0ddc\u0da9 1 : 81 0.025\u0dc3 \u0dba\u0db8\u0ddc\u0db1\u0dd2\u0d9a\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db1\u0dd2 \u0db8\u0dcf\u0dcf\u0dbb\u0dba\u0dda \u0dc35\u0dc3221110V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba 52002\u0dc3/01/39, - \u0d9a\u0d82\u0d9a 646/5, 52002\u0dc3/02/ \u0d9a\u0dca\u0dad\u0dba\u0daf\u0dc0\u0dda\u0dcf, \u0db8\u0dd3\u0dba\u0d9c\u0ddc\u0da9 10 \u0dc3 11\u0dc3 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0d9a\u0d82\u0d9a 18\u0dc31 \u0dcf 2012.06.28 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d89\u0dad\u0dd2\u0dbb\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0dcf\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dda\u0dc0 1 : 82 0.025\u0dc3 \u0dbb\u0dd4\u0dc0\u0dca\u0dad \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0daf\u0dba\u0dcf\u0db1\u0dca\u0dad\u0daf \u0dc3\u0dc33421439V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a - \u0dbb\u0dab\u0dc3\u0dd2\u0daf\u0d82 \u0dc32,11\u0dc3,131 \u0dc3 10 \u0dc4\u0dd2 \u0d9a\u0d82\u0d9a 646/4, \u0d9a\u0dca\u0dad\u0dba\u0daf\u0dc0\u0dda\u0dcf, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf \u0db8\u0dd3\u0dba\u0d9c\u0ddc\u0da9 \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d89\u0dad\u0dd2\u0dbb\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0dcf\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d9a\u0d82\u0d9a 1869 - 2012.06.28 \u0daf\u0dbb\u0dab \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dda\u0dc0 1 : 8\u0dc3 0.0513 \u0d9a\u0dbd \u0dda\u0dba\u0db4\u0dbb\u0dd4\u0db8\u0dba\u0dda \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0daf\u0dcf\u0dc3 5\u0dc309\u0dc3110\u0dc3V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a - \u0d9a\u0d82\u0d9a 640/1 , \u0d9a\u0dca\u0dad\u0dba\u0daf\u0dc0\u0dda\u0dcf, 52002\u0dc3/1/39, \u0db8\u0dd3\u0dba\u0d9c\u0ddc\u0da9 52002\u0dc3/2/6, \u0dc32 \u0dc3 11\u0dc3 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c 1 : 90 0.0513 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d86\u0dbb\u0da0\u0dbb\u0da0\u0dd2\u0da0\u0dd2\u0dba\u0dda \u0db8\u0dbd\u0dca\u0dbd\u0dd2\u0d9a\u0dcf \u0db4\u0dca\u0db0\u0db8\u0dd2 81\u0dc342364\u0dc3V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0daf\u0dca\u0db0\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0db8\u0dd4\u0dbd - \u0d9a\u0d82\u0d9a 623/3, \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0dcf\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d9a\u0dca\u0dad\u0dba\u0daf\u0dc0\u0dda\u0dcf, \u0db8\u0dd3\u0dba\u0d9c\u0ddc\u0da9 \u0d9a\u0d82\u0d9a \u0dc3945 - 2024.06.2\u0dc3 \u0daf\u0dbb\u0dab \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dda\u0dc0 1 : 94 0.0556 \u0dba\u0dc0\u0daf \u0d86\u0dbb\u0da0\u0dbb\u0da0\u0dd2\u0da0\u0dd2\u0dba\u0dda \u0dba\u0dbb\u0dcf\u0dc4\u0dd2\u0dcf 19\u0dc3026302331 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a - \u0dbb\u0dca\u0db8\u0dbb\u0dda\u0db1 3, 6 \u0dc3 \u0dc32 \u0dc4\u0dd2 \u0dba\u0dda\u0dbd\u0dca\u0d9c\u0db8 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf 636/2, \u0d9a\u0dca\u0dad\u0dba\u0daf\u0dc0\u0dda\u0dcf, \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0db8\u0dd3\u0dba\u0d9c\u0ddc\u0da9 1 : 101 0.0512 \u0dc0\u0dd3\u0dbb\u0dc3\u0dd2\u0daf\u0d82 \u0d86\u0dbb\u0da0\u0dbb\u0da0\u0dd2\u0da0\u0dd2\u0dba\u0dda \u0dbb\u0d82\u0da2\u0dcf\u0dca\u0dad 5\u0dc31491451V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a - \u0d9a\u0d82\u0d9a 622, 52002\u0dc3/01/39, \u0db8\u0dcf\u0dbd\u0dd2 \u0dba\u0dc3\u0dc0\u0db1, \u0d9a\u0dca\u0dad\u0daf\u0dc0\u0dda\u0dcf, 52002\u0dc3/02/3,6 \u0dc3 \u0db8\u0dd3\u0dba\u0d9c\u0ddc\u0da9 11\u0dc3 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c \u0d9a\u0d82\u0d9a 55\u0dc39 \u0dcf",
