bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd \u0bb5\u0ba3\u0bcd\u0b9f\u0bbf, \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd \u0bb5\u0ba3\u0bcd\u0b9f\u0bbf, \u0b95\u0ba9\u0bb0\u0b95 \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd \u0bb5\u0ba3\u0bcd\u0b9f\u0bbf, \u0b87\u0bb0\u0b9f\u0bcd\u0b9f\u0bc8\u0bc8 \u0ba8\ufffd\u0bcb\u0b95\u0bcd\u0b95 \u0bb5\u0bbe\u0bbe\u0b95\u0ba9\u0bae\u0bcd, \u0b87\u0bb2\u0b95\u0bc1\u0bb0\u0b95 \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd \u0bb2\ufffd\u0bca\u0bb1\u0bbf\u0bbf, \u0b95\u0ba9\u0bb0\u0b95 \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd \u0bb2\ufffd\u0bca\u0bb1\u0bbf\u0bbf \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd \u0bae\u0ba9\ufffd \u0bb5\u0bbe\u0bbe\u0b95\u0ba9\u0bae\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bbf\u0bbf\u0ba9\u0bcd \u0b9a\u0bbe\u0bbe\u0bb0\u0ba4\u0bbf\u0bbf \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0b9a\ufffd\u0bca\u0ba8\u0bcd\u0ba4\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0bb0\u0bb0\u0bcd ;",
