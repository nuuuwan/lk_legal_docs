    "text": "\u0b85\u0ba4\u0bcd\u0ba4\u0b95\u0bc8\u0bc8\u0baf \u0bae\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0bcd \u0bb5\u0bbe\u0bbe\u0b95\u0ba9\u0bae\u0bcd \u0b95\u0b9f\u0bc1\u0b95\u0ba4\u0bbf\u0bbf\u0baa\u0bcd \u0baa\u0bbe\u0bbe\u0ba4\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0b93\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1 \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0bb5\ufffd\u0bb3\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bcd, \u0b92\u0bb4\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bb5\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf 8\u0b89 \u0bb5\u0bbf\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb0\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u0b95\u0bc8\u0bc8\u0baf\u0bbe\u0bbe\u0ba9 \u0ba4\u0ba9\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0bb3\u0bcd \u0baa\u0bbe\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0bbe\u0baa\u0bcd\u0baa\u0bc1 \u0b86\u0b9a\u0ba9\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bc8\u0bc8 \u0b85\u0ba3\u0bbf\u0bbf\u0ba4\u0bb2\u0bcd \u0bb5\ufffd\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.",
