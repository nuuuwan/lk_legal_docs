    ],
    "text": "\u0bae\u0bbe\u0bbe\u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd (252 \u0b86\u0bae\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd) 212 (\u0b86) \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0b9f\u0bbf 2026\u0bae\u0bbe\u0bbe\u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd (252 \u0b86\u0bae\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd) 212 (\u0b86) \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0b9f\u0bbf 2026 \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf \u0bb5\u0bb0\u0bc1\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0b95, \u0bae\u0ba4\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bc1 \u0b86\u0bae\u0bcd \u0ba8\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf \u0bb5\u0bb0\u0bc1\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bbe\u0bbe\u0b95, \u0bae\u0ba4\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bc1 \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u072d\u0bb2\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bcd\u0bcd\u073c\u0b9f\u0bcd\u0b9f \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bb5\u072d\u0bb2\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bcd\u0bcd\u073c\u0b9f\u0bcd\u0b9f \u0bb5\u0bb0\u0bb5\u0bc1 \u0b9a\u0bc6\u0bc6\u0bb2\u0bb5\u0bc1 \u0b85\u0bb1\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8, 2025, \u0ba8\u0bb5\u072d\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 17 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf \u0ba4\ufffd\u0bca\u0b9f\u0b95\u0bcd\u0b95\u0bae\u0bcd 0\u0bb5\u0bb0\u0bb5\u0bc1 \u0b9a\u0bc6\u0bc6\u0bb2\u0bb5\u0bc1 \u0b85\u0bb1\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8, 2025, \u0ba8\u0bb5\u072d\u0bae\u0bcd\u0baa\u0bb0\u0bcd \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 17 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf \u0ba4\ufffd\u0bca\u0b9f\u0b95\u0bcd\u0b95\u0bae\u0bcd 07 \u0ba4\u0bbf\u0bbf\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 7 \u0ba4\u0bbf\u0bbf\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0baa\ufffd\u0bca\u0ba4\u0bc1\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0bbe\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0bbe\u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8 \u0bae\u0bc1\u0ba9\u0bcd \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd, \u0b95\u0bc1\u0bb0\u0bc1\u0ba8\u0bbe\u0bbe\u0b95\u0bb2\u0bcd \u0bae\u0bbe\u0bbe\u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8 \u0baa\ufffd\u0bca\u0ba4\u0bc1 \u0ba8\u0bc2\u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0baa\ufffd\u0bca\u0ba4\u0bc1\u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0bbe\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bbe\u0bbe\u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8 \u0bae\u0bc1\u0ba9\u0bcd \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd, \u0b95\u0bc1\u0bb0\u0bc1\u0ba8\u0bbe\u0bbe\u0b95\u0bb2\u0bcd \u0bae\u0bbe\u0bbe\u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8 \u0baa\ufffd\u0bca\u0ba4\u0bc1 \u0ba8\u0bc2\u0bb2\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0bb5\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1 \u0bb5\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc8\u0bc8 \u0b85\u0bb1\u0bbf\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bb0\u0bc1\u0b95\u0bbf\u0bbf\u0ba9\u0bcd\u0bb1\ufffd\u0ba9\u0bcd.\u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc8\u0bc8 \u0b85\u0bb1\u0bbf\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bb0\u0bc1\u0b95\u0bbf\u0