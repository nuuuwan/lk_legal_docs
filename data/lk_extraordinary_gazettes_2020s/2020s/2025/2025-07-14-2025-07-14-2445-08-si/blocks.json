    "text": "\u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\u01ae, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0dd1\u0d9c\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda\u024f, \u0db6\u0db8\u0dd4\u0dab\u0dcf\u0dcf\u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f, \u0d85\u0d82\u0d82\u0d9a 1226 \u0dc0\u0dad\u0dd4\u0d9a\u0db1 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f, \u0dc0\u0dad\u0dd4\u0d9a\u0db1 \u0d9c\u0db8\u0dda\ufffd \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc3\u0dbb\u0dca\u0dc0\u0dda\u0dda\u0dba\u0dbb\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0dd9\ufffd\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d82\u0d9a KU/BMK/2021/02 \u0dc4\u0dcf\u0dcf 2022.11.30 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0db8\u0db1 \u0d85\u0db1\u0dd4\u0dbb\u0dda\u0dda\u0d9b\u0db1\u0dba\u0dda\u024f \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0da7 \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8\u0dca:",
