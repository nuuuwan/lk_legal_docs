    "text": "\u0db8\u0dad\u0dca\u0db4\u0dd0\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd6 \u0dc3\u0dd4\u0dbb\u0dcf\u0db6\u0daf\u0dca\u0daf \u0d9a\u0dbd\u0dd2\u0db1\u0dca \u0d9a\u0dbc\u0da7 \u0dc0\u0d82\u0db8\u0dbe\u0ddd\u0db0\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dbc\u0daf \u0db3\u0dbb\u0dd2\u0daf\u0dd2 (52 \u0dbd\u0dd0\u0db1\u0dd2 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dba \u0dc0\u0dd6) \u0dc3\u0dd4\u0dbb\u0dcf\u0db6\u0daf\u0dd4 \u0d86\u0da5\u0dcf\u0db3\u0db1\u0db8\u0dda 22 \u0dbd\u0dd0\u0db1\u0dd2 \u0dbd\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0db8\u0dda \u0db8\u0dcf \u0db8\u0dbd\u0dad \u0db3\u0dd0\u0dbd\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbc\u0dad\u0dbc \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb \u0dd4\u0daf\u0daf\u0dca, \u0dca\u200d\u0dbb\u0db8\u0dc0\u0dca\u0db4\u0db3\u0dcf\u0daf\u0db1 \u0dc0\u0dc1 \u0d86\u0dca\u0dae\u0dd2\u0d9a\u0d9a \u0dc0\u0d82\u0dbd\u0dca\u0dae\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dba \u0d85\u0dd4\u0dbb\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0daf\u0dd2\u0dc0\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0dbd\u0db1 \u0db8\u0db8 2025 \u0da2\u0db1\u0dbd\u0dcf\u0dbb\u0dd2 \u0db8\u0dc0 11 \u0dbd\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0db6\u0dbc\u0db3\u0dd0\u0dbd\u0dd0\u0dda\u0db8\u0dbd\u0db1 \u0db3\u0dbb\u0dd2\u0daf\u0dd2; (1) \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbc\u0d82\u0d9a\u0dcf\u0db8\u0dda \u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0db1\u0dbd\u0db1 \u0dbc\u0daf \u0db6\u0dbc\u0db3\u0dad\u0dca\u200d\u0dbb\u0dbc\u0dda \u0dba\u0dca\u0db4 \u0db1\u0dd2\u0dbf\u0db4\u0db3\u0dcf\u0daf\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u0d9a \u0db1\u0dd2\u0db3\u0daf\u0dbd\u0dd4\u0dbb \u0dbc\u0dd0\u0db6 \u0db1\u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dda \u0d9a\u0dbb\u0dd4\u0dbb \u0dbc\u0db6\u0db1\u0dca\u0db1\u0dcf \u0dc0\u0dd6 \u0dc0\u0dd2\u0db8\u0dbe \u0dbf \u0d85\u0dbb\u0dca\u0d9a\u0d9a\u0dd4 \u0db8\u0dda\u0db3\u0dd0\u0db1\u0dca \u0db8\u0db0\u0dba\u0dc0\u0dcf\u0dbb \u0dc0\u0dd1\u0db8 \u0dd3\u0da7\u0da7\u0dbb\u0dba\u0d9a\u0da7 \u0db8 \u0dbb\u0dd4\u0dc4\u0dd2\u0dba\u0dca, \u0dc1\u0dda\u0daf\u0dc1\u0dc0\u0db4 \u0db8\u0daf\u0dc3\u0dd2\u0dba \u0dc1\u0dad\u0dd2\u0dc3\u0dc0\u0db4 \u0dc1\u0dad\u0dbb\u0dca\u0d9a (\u0dbb\u0dd4. 7 244.00) \u0dbd\u0db1 \u0db6\u0dca\u0daf\u0daf\u0dca\u0d9a \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dd4 \u0dba\u0dd0\u0dba\u0dd2 \u0daf; (2) \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbc\u0d82\u0d9a\u0dcf\u0db8\u0dda \u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0db1\u0dbd\u0db1 \u0dbc\u0daf \u0db6\u0dbc\u0db3\u0dad\u0dca\u200d\u0dbb\u0dbc\u0dda \u0dba\u0dca\u0db4 \u0db1\u0dd2\u0dbf\u0db4\u0db3\u0dcf\u0daf\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u0d9a \u0db1\u0dd2\u0db3\u0daf\u0dbd\u0dd4\u0dbb \u0dbc\u0dd0\u0db6 \u0db1\u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dda \u0d9a\u0dbb\u0dd4\u0dbb \u0dbc\u0db6\u0db1\u0dca\u0db1\u0dcf \u0dc0\u0dd6 \u0db1\u0dca\u0d9a\u0dd4\u0db4\u0db3\u0dcf\u0d9a \u0dad\u0dca, \u0db8\u0db3\u0ddc\u0dca, \u0dc0\u0dc1 \u0db3\u0daf\u0dca\u0db4 \u0d9a\u0dc2 \u0d85\u0dbb\u0dca\u0d9a\u0d9a\u0dd4 \u0db8\u0dda\u0db3\u0dd0\u0db1\u0dca \u0db8\u0db0\u0dba\u0dc0\u0dcf\u0dbb \u0dc0\u0dd1\u0db8 \u0dd3\u0da7\u0da7\u0dbb\u0dba\u0d9a\u0da7 \u0db8 \u0dbb\u0dd4\u0dc4\u0dd2\u0dba\u0dca, \u0dc1\u0dda\u0daf\u0dc1\u0dc0\u0db4 \u0dc1\u0dda\u0dc3\u0dd2\u0dba \u0db3\u0db1\u0dc0\u0db4 \u0db8\u0daf\u0d9a\u0dca\u0d9a (\u0dbb\u0dd4. 7 752.00) \u0dbd\u0db1 \u0db6\u0dca\u0daf\u0daf\u0dca\u0d9a \u0d85\u0dba \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dd4 \u0dba\u0dd0\u0dba\u0dd2 \u0daf; (3) \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbc\u0d82\u0d9a\u0dcf\u0dbd \u0dd4\u0dc2 \u0db1\u0dd2\u0db3\u0daf\u0dbd\u0dd4\u0dbb \u0dbc\u0db6\u0db1 \u0db8\u0db8\u0dbb\u0da7 \u0dc0\u0dd1\u0daf\u0dd4 \u201c\u0dc0\u0dd2\u0db8\u0dca\u0daf\u0dc1\u0dd3\u0dba\u201d \u0dc0\u0db4\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dd4 \u0db8\u0dda\u0db3\u0dd0\u0db1\u0dca \u0db8\u0db0\u0dba\u0dc0\u0dcf\u0dbb \u0dc0\u0dd1\u0db8 \u0dd3\u0da7\u0da7\u0dbb\u0dba\u0d9a\u0da7 \u0db8 \u0dbb\u0dd4\u0dc4\u0dd2\u0dba\u0dca, \u0dc1\u0dda\u0daf\u0dc1\u0dc0\u0db4 \u0db1\u0dbd\u0dc3\u0dd2\u0dba \u0dc1\u0dd0\u0da7 