    ],
    "text": "III. \u0d86\u0dc3\u0dcf\u0daf\u0db1 \u0dd9\u0dbb\u02a4\u0d9c\u0dba\u00fb\u01e6 \u0dd9\u0dc4\u02a4 \u0dc3\u0dca\u0db4\u0259\u0dc1\u0d9a \u0dd9\u0dbb\u02a4\u0d9c\u0dba\u00fb\u01e6 \u0dd9\u0db4\u0dd9\u0dbd\u0db1 \u0dd9\u0dc4\u02a4 \u0dd9\u0db4\u0dd9\u0dc5\u01e6\u0dd9\u01e6 \u0dba\u0dd0\u0250 \u0dad\u0db8\u0dcf \u0daf\u01e6\u0db1\u0dcf \u00fb\u0286\u0db8 \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u00fd\u0da7 \u0d9a\u0db3\u026c\u025e \u0dd9\u0db4\u0dd9\u0daf\u0dc3 \u0d87\u01b1\u0dc5\u0dad \u0dba\u023c \u0dd9\u0229\u0d9a\u025c\u0dba\u00fa, \u0d9a\u0dd0\u026a\u0263\u0dc4\u0dbd\u00fa \u0dd9\u0dc4\u02a4 \u0d9a\u0dd0\u026a\u0263 \u0dc3\u0dcf\u0daf\u0db1 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u00fa, \u0dd9\u0db7\u02a4\u0da2\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u00fa \u0dd9\u0dc4\u02a4 \u0daf\u01e6\u0dc3\u0dbd\u00fa \u0dad\u01ae\u0d9a\u0dcf\u0dbd\u0dd9\u024f \u0db7\u0dcf\u0dbb\u0dc0 \u0286\u0179\u0db1 \u0dba\u023c \u0dad\u0dd0\u0db1\u0dd0\u01ae\u0dd9\u0dad\u00fd \u026a\u0286\u01e6 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0dc0\u02a4\u013d\u0dad \u0db4\u025c\u01ce \u0d92 \u0dd9\u0229\u0d9a\u025c\u0dba\u0da7,\u00ab\u0d9a\u0dd0\u026a\u0263\u0dc0\u0dbd\u0da7 \u0dd9\u0dc4\u02a4 \u0d9a\u0dd0\u026a\u0263 \u0dc3\u0dcf\u0daf\u0db1 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0da7, \u0dd9\u0db7\u02a4\u0da2\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u0da7 \u0dd9\u0dc4\u02a4 \u0daf\u01e6\u0dc3\u0dbd\u0da7 \u0d87\u01b1\u029a\u026b\u0db8\u0da7 \u0dd9\u0dc4\u02a4 \u0dba\u023c \u01d6\u0dc0\u0255\u0dba\u00fa \u0d86\u0dc4\u0dcf\u0dbb \u0db4\u0dcf\u0db1 \u0dd9\u0db6\u0daf\u0dcf \u0dc4\u0dd0\u025d\u0dd9\u023c \u01cf, \u026a\u00fb\u019e\u0dd9\u023c \u01cf \u0dd9\u0dc4\u02a4 \u01e7\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u00fb\u025d\u0dd9\u023c \u01cf \u0dc3\u0dc4\u0db7\u0dcf\u0119\u026b\u0db8\u0da7 \u0db6\u0dbd\u0dba \u0db1\u0dd0\u0dad.",
