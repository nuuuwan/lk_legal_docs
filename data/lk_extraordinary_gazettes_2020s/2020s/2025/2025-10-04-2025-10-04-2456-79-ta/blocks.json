    "text": "\u0b85\u0b9f\u0bcd\u0b9f\u0b9f\u0bb5\u0ba3\u0bc8 : \u0b8e\u0ba4\u0bcd\u0ba4\u0bc1\u0ba9\u0bcd\u0b95\u0bb9\u0ba4\u0bc6\u0ba9\u0bcd\u0ba9\u0ba9\u0bcd\u0ba9 \u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0b85\u0bb2\u0bcd\u0bb2\u0bb2\u0ba4\u0bc1 \u0bae\u0bbe\u0b95\u0bcd\u0bb8\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8\u0b85\u0b9f\u0bcd\u0b9f\u0b9f\u0bb5\u0ba3\u0bc8 : \u0b8e\u0ba4\u0bcd\u0ba4\u0bc1\u0ba9\u0bcd\u0b95\u0bb9\u0ba4\u0bc6\u0ba9\u0bcd\u0ba9\u0ba9\u0bcd\u0ba9 \u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0b85\u0bb2\u0bcd\u0bb2\u0bb2\u0ba4\u0bc1 \u0bae\u0bbe\u0b95\u0bcd\u0bb8\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8\u0b95\u0b95",
