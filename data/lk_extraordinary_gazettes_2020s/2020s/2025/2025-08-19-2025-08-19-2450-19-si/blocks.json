    "text": "\u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013--\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 \u026a\u01e7\u0dc1\u0dca\u0da0\u0dba\u01e6 \u0dc3\u0dc4 \u0dba\u023c \u026a\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u02a4 \u0db4\u01b4 \u0d85\u0d82\u0d9a\u0dba \u0d89\u01e6\u0dd9\u0da2\u01e6\u0dc2\u01e6 \u0dad\u0dc4\u0db1\u023c \u0dd9\u0db4\u02a5\u01ca\u0d9c\u0263\u0d9a \u0dc3\u0dc4 \u0d89\u0da9\u023c \u026a\u0dc1\u0dcf\u0dbd\u01ae\u0dc0\u0dba \u0d85\u0250\u01af\u0d9a\u025e\u0dd9\u0118/\u0d85\u0250\u01af\u0d9a\u025e\u0dc0\u01e6\u0dd9\u0118 \u0da2\u0dcf\u01af\u0d9a \u0d85\u0250\u01af \u0d85\u0250\u01af\u0dd9\u024f \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf\u0dd9\u0dc0\u01e6 \u0d87\u01af \u01e8\u01af\u0dba\u0d9a\u0da7 \u0dba\u0da7\u01ae \u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u0dda \u0dc3\u023c\u021b\u0259\u0dab \u0db1\u0db8/\u0db1\u023c \u0dc3\u0dc4 \u0263\u0218\u0db1\u0dba \u0dc4\u0dd0\u01ff\u01e9\u023c\u0db4\u01ae \u0d89\u0da9\u0dd9\u023c \u0db4\u01e6\u01af\u0dba \u0dc3\u0dc4 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u01fe\u023c \u0db1\u023c \u0d92 \u0218\u0298\u0db6\u0db3 \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u021d\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0218\u0298\u0db6\u0db3 \u026a\u0dc3\u0dca\u0dad\u0dbb \u026a\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014- (\u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259) 1 : 44 0.0208 \u00fb\u025c\u0dc0\u0dd0\u01e6\u0daf\u0dbd\u0dcf\u0dd9\u0118 \u0d9c\u0d82\u0d9c\u0dcf\u01e7 \u0dc3\u0daf\u0db8\u0dcf\u0263 837294290V \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 47 \u028f \u0d85\u0d82\u0d9a 290/2, \u027c \u021a\u0dc2\u0dca\u0db4\u0dcf\u0dbb\u0dcf\u0db8 \u0db4\u0dcf\u0dbb, \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0250\u01af\u0dba \u026a\u0dd9\u0262\u0dd9\u0d9c\u02a3\u0da9. \u0dc3\u0db8\u0d9f \u0dc4\u0dcf \u0d9a\u029a\u0dad\u0dbb \u0d8b\u01b1\u0dbb \u0dd9\u0dc4\u0178\u0179\u0d86\u0dbb\u013c\u013d\u0dd9\u0118 \u0dd9\u0daf\u02a4\u0db1 \u0d85\u023d\u0dad\u0dcf \u01e7\u0262\u023d\u019d \u0dba\u0db1 \u0d85\u0dba\u0dd9\u0118 \u0d85\u0d82\u0d9a 13950/2024. 03 . 01 \u01ce\u0db1\u0dd0\u01af \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u01ae\u0dc0 1 : 45 0.0417 \u0dbb\u01ae\u0db1\u0dcf\u0dba\u0d9a \u023f\u01ce\u0dba\u01e6\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0118 \u0d9a\u0288\u01e6 198934801206 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 47 \u028f \u0d86\u0286\u025c \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0250\u01af\u0dba \u0d85\u0d82\u0d9a 290, \u021a\u0dc2\u0dca\u0db4\u0dcf\u0dbb\u0dcf\u0db8 \u0db4\u0dcf\u0dbb, \u0dc3\u0db8\u0d9f \u0dc4\u0dcf \u0dbb\u01ae\u0db1\u0dcf\u0dba\u0d9a \u026a\u0dd9\u0262\u0dd9\u0d9c\u02a3\u0da9, \u0d9a\u029a\u0dad\u0dbb \u0d8b\u01b1\u0dbb \u023f\u01ce\u0dba\u01e6\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0118 \u0288\u01e7\u0262 \u0dc1\u0dcf\u01e6\u0dad \u026a\u0dd9\u014e\u0dd9\u0dc3\u0dda\u0d9a\u0dbb \u0dba\u0db1 \u0d85\u0dba\u0dd9\u0118 \u0150\u026a\u0dad \u0236\u00fa\u01af\u0dba\u0da7 \u0dba\u0da7\u01ae\u0dc0 1 : 48 0.2885 \u0dc0\u01e6\u01e7\u0d86\u0dbb\u013c\u013d \u0d9a\u01e6\u0d9a\u0dcf\u0db1\u01e6\u0dd9\u0118 \u0d85\u01e9\u0dbd\u0dcf 568150619V \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 78 \u028f \u0d85\u0250\u0dbb\u0dcf\u0d82\u0d9c\u01e8 \u0db0\u0259\u0db8\u0dd9\u0dc3\u0dda\u0db1 \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0250\u01af\u0dba \u0d85\u0d82\u0d9a 289/\u022b, \u026a\u0dd9\u0262\u0dd9\u0d9c\u02a3\u0da9, \u0dc3\u0db8\u0d9f \u0d9a\u029a\u0dad\u0dbb \u0d8b\u01b1\u0dbb 1 : 72 0.0349 \u0db8\u0dc4\u0dcf\u0dd9\u0dc4\u0dda\u0dc0\u0dcf\u0dd9\u0118 \u0da9\u0dba\u0db1\u0dcf \u0d88\u01e6 \u026a\u01e8\u0dad\u0dcf 595952700V \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 78 \u028f \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0250\u01af\u0dba \u0d85\u0d82\u0d9a 289\u0d8a, \u027c \u021a\u0dc2\u0dca\u0db4\u0dcf\u0dbb\u0dcf\u0db8 \u0db4\u0dcf\u0dbb, \u0dc3\u0db8\u0d9f \u026a\u0dd9\u0262\u0dd9\u0d9c\u02a3\u0da9, \u0d9a\u029a\u0dad\u0dbb \u0d8b\u01b1\u0dbb 1 : 74 0.0292 \u0db8\u0dcf\u0151\u0dc0\u0dcf\u0db1 \u0d9c\u0db8\u0dd9\u0118 \u01e7\u0262\u023d\u019d \u021f\u0dba\u01e6\u0dad\u0dcf 196774201630 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 78 \u028f \u0d85\u0d82\u0d9a 288/9, \u027c \u021a\u0dc2\u0dca\u0db4\u0dcf\u0dbb\u0dcf\u0db8 \u0db4\u0dcf\u0dbb, \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0250\u01af\u0dba \u026a\u0dd9\u0262\u0dd9\u0d9c\u02a3\u0da9, \u0d9a\u029a\u0dad\u0dbb \u0d8b\u01b1\u0dbb \u0dc3\u0db8\u0d9f 1 : 76 0.0252 \u0dd9\u0dc4\u0178\u0179\u0d86\u0dbb\u013c\u013d\u0dd9\u0118 \u0dd9\u0daf\u02a4\u0db1 \u0d85\u023d\u0dad\u0dcf 196858400880 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 78 \u028f \u01e7\u0262\u023d\u019d \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0250\u01af\u0dba \u0d85\u0d82\u0d9a 288/7, \u027c \u021a\u0dc2\u0dca\u0db4\u0dcf\u0dbb\u0dcf\u0db8 \u0dc3\u0db8\u0d9f \u0db4\u0dcf\u0dbb, \u026a\u0dd9\u0262\u0dd9\u0d9c\u02a3\u0da9, \u0d9a\u029a\u0dad\u0dbb \u0d8b\u01b1\u0dbb 1 : 84 0.0246 \u026a\u0100\u0db8\u0286\u0d82\u0dc4 \u0d86\u0dbb\u013c\u013d\u0dbd\u0dcf\u0dd9\u0118 \u0dbd\u00fa\u0db8\u0dcf\u0263 197968800686 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 78 \u028f \u021f\u0dba\u01e6\u01af\u0d9a\u0dcf \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0250\u01af\u0dba \u0d85\u0d82\u0d9a 288/2, \u027c \u021a\u0dc2\u0dca\u0db4\u0dcf\u0dbb\u0dcf\u0db8 \u0db4\u0dcf\u0dbb, \u0dc3\u0db8\u0d9f \u026a\u0dd9\u0262\u0dd9\u0d9c\u02a3\u0da9, \u0d9a\u029a\u0dad\u0dbb \u0d8b\u01b1\u0dbb 1 : 87 0.0414 \u0d91\u01d0\u0dc3\u0dca\u0288\u025c\u0dba\u0dd9\u0118 \u021d\u01cf\u0217 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb 763161854V \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 78 \u028f \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf \u0db8\u0dcf\u0259\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0250\u01af\u0dba \u0d85\u0d82\u0d9a 329/\u0d92, \u027c \u021a\u0dc2\u0dca\u0db4\u0dcf\u0dbb\u0dcf\u0db8 \u0db4\u0dcf\u0dbb, \u0dc3\u0db8\u0d9f \u026a\u0dd9\u0262\u0dd9\u0d9c\u02a3\u0da9, \u0d9a\u029a\u0dad\u0dbb \u0d8b\u01b1\u0dbb EOG 08-0212/1 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u00fb\u025d\u0dd9\u023c \u0db4\u0db1\u0dad 14 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca\u0dd9\u0118 \u01b0\u0dbb\u0dab \u021d\u0d9a\u0dcf\u0dc1\u0dba \u0db6\u0dc3\u0dca\u0db1\u0dcf\u028f\u0dbb \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0d9a\u029a\u0dad\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0d9a\u029a\u0dad\u0dbb \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d85\u0d82\u0d9a 718 \u022b - \u0dd9\u0db6\u02a3\u0178\u01e7\u00fa\u0dc0\u01ae\u0dad \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u01b1\u0dc5 \u0dd9\u0db6\u02a3\u0178\u01e7\u00fa\u0dc0\u01ae\u0dad \u0db1\u0db8\u0dd0\u01af \u0d9c\u0dd9\u023c \u0218\u028f\u0179\u0dba\u0dcf \u026d \u0daf \u0d85\u0d82\u0d9a 530129 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0dd9\u023c \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 1 \u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 1:9, 1:10, 1:14, 1:16, 1:22, 1:23, 1:25, 1:31, 1:217 \u0dc3\u0dc4 1:219 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0dd9\u0dbd\u0dc3 \u0dd9\u0db4\u01e6\u01e9\u023c \u0dd9\u0d9a\u02a3\u0da7 \u0d87\u01ae\u0dad\u0dcf \u026d \u0daf, \u028f\u023d\u0d9a\u023c \u0db4\u0dd1\u023c \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u0db1 \u0dd9\u0dbd\u0dc3 \u0daf\u0dd0\u01e9\u023c \u0dd9\u0daf\u023d\u01e6 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u00fb\u025d\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 12 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u021d\u0d9a\u0dcf\u0dbb 2024-10-08 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0d85\u0d82\u0d9a 2405/23 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0dba\u0dae\u0dcf \u0db4\u025c\u01ce \u0db4\u0dc5\u0d9a\u0dbb\u0db1",
