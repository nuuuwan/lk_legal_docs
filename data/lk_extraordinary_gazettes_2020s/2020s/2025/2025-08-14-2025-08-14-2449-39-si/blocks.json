    ],
    "text": "3A III \u0dd9\u0d9a\u02a3\u0da7\u0dc3 - \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba - 2025.08.14 \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u01b1\u0dc5 \u023f\u0262\u0dd9\u0262\u0d9c\u0db8 \u0db1\u0db8\u0dd0\u01af \u0d9c\u0dd9\u023c \u0218\u028f\u0179\u0dba\u0dcf \u026d \u0daf, \u0d85\u0d82\u0d9a 520013 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0dd9\u023c \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 22 \u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 07 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d91\u028f \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u0dba\u028f; \u201c\u0dba\u023c \u026a\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u02a4 \u0dd9\u0db4\u02a5\u01ca\u0d9c\u0263\u0d9a \u01e8\u01af\u0dba\u0d9a\u0da7 \u0dba\u0da7\u01ae \u0db1\u023c \u0d92 \u0218\u0298\u0db6\u0db3 \u026a\u0dc3\u0dca\u0dad\u0dbb \u201d \u0dba\u0db1 \u01b0\u025e\u0dd9\u0269 \u201c \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 8, 9, 11 \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0263 \u0dc0\u0dbd\u0da7 \u021d\u0dd9\u0269\u0dc1 \u026b\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u201d \u0dd9\u0dbd\u0dc3 \u0dc3\u0db3\u0dc4\u01e6 \u0dd9\u0dad\u02a3\u0dbb\u01b1\u0dbb \u0d89\u0dc0\u01ae \u0d9a\u0dbb \u201c \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 8, 9 \u0dc3\u0dc4 14 \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0263 \u0dc0\u0dbd\u0da7 \u021d\u0dd9\u0269\u0dc1 \u026b\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u201d \u0dba\u01e6\u0db1 \u0d87\u01b1\u0dbd\u01ae \u0d9a\u0dbb \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229. \u0219. \u0287. \u018c. \u0286\u0dd9\u0118\u0dbb\u0dcf, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0262. 2025 \u0152\u0263 \u0db8\u0dc3 24 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd \u0dbb\u0da2\u0db8\u0262\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbb, \u201c\u023d\u028f\u0d9a\u0dad \u0db8\u0dd0\u01d0\u0dbb\u201d, \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dd9\u0269 \u01cf \u0dba. EOG 08-0145/4 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u00fb\u025d\u0dd9\u023c \u0db4\u0db1\u0dad (14 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba) \u0d8b\u00fa\u0dad \u0275\u0259\u0dc2\u0dba \u0dba\u0da7\u0dd9\u01ae 2025 \u0dd9\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u025c \u0db8\u0dc3 07 \u0dc0\u0db1 \u01ce\u0db1 \u0d85\u0d82\u0d9a 2422/62 \u0daf\u0dbb\u0db1 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0db8\u0dc4\u01e9\u0dc0\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f \u0dc4\u0dcf\u025c\u0dc3\u0dca\u0db4\u01ae\u01b1\u0dc0 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d85\u0d82\u0d9a 450 - \u0db8\u0dcf\u0db4\u0dcf\u0db8\u018d\u0262\u0dbd \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025d \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u01b1\u0dc5 \u0db8\u0dcf\u0db4\u0dcf\u0db8\u018d\u0262\u0dbd \u0db1\u0db8\u0dd0\u01af \u0d9c\u0dd9\u023c \u0218\u028f\u0179\u0dba\u0dcf \u026d \u0daf, \u0d85\u0d82\u0d9a 320498 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0dd9\u023c \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 02 \u028f \u0db4\u01b4 \u0d85\u0d82\u0d9a 01 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 74 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d91\u028f \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u0dba\u028f; \u201c\u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u023c \u0d85\u0d82\u0d9a\u0dba 3202198\u201d \u0dba\u01e6\u0db1 \u0d89\u0dc0\u01ae \u0d9a\u0dbb \u201c \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u023c \u0d85\u0d82\u0d9a\u0dba 320498\u201d \u0dba\u01e6\u0db1 \u0d87\u01b1\u0dbd\u01ae \u0d9a\u0dbb \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229. \u0219. \u0287. \u018c. \u0286\u0dd9\u0118\u0dbb\u0dcf, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0262. 2025 \u0152\u0263 \u0db8\u0dc3 24 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd \u0dbb\u0da2\u0db8\u0262\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbb, \u201c\u023d\u028f\u0d9a\u0dad \u0db8\u0dd0\u01d0\u0dbb\u201d, \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dd9\u0269 \u01cf \u0dba. EOG 08-0145/5 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u00fb\u025d\u0dd9\u023c \u0db4\u0db1\u0dad (14 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba) \u0d8b\u00fa\u0dad \u0275\u0259\u0dc2\u0dba \u0dba\u0da7\u0dd9\u01ae 2024 \u0dd9\u0daf\u0dc3\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 12 \u0dc0\u0db1 \u01ce\u0db1 \u0d85\u0d82\u0d9a 2414/44 \u0daf\u0dbb\u0db1 \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0db8\u0dc4\u01e9\u0dc0\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f \u0dc4\u0dcf\u025c\u0dc3\u0dca\u0db4\u01ae\u01b1\u0dc0 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d85\u0d82\u0d9a 449 - \u0daf\u0da9\u0dd9\u0dc4\u02a4\u0d9c\u0db8 \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025d \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u01b1\u0dc5 \u0daf\u0da9\u0dd9\u0dc4\u02a4\u0d9c\u0db8 \u0db1\u0db8\u0dd0\u01af \u0d9c\u0dd9\u023c \u0218\u028f\u0179\u0dba\u0dcf \u026d \u0daf, \u0d85\u0d82\u0d9a 320499 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0dd9\u023c \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 02 \u028f \u0db4\u01b4 \u0d85\u0d82\u0d9a 01 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 230 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d91\u028f \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u0dba\u028f;",
