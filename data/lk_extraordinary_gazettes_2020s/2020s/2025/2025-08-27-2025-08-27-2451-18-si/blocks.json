    ],
    "text": "\u0d85\u0dc0\u0dc3\u01e6 \u0dc0\u0dbb\u0da7 \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dbd\u00fa\u0dc2\u0255\u0dd9\u024f (5) \u0286\u0da7 \u0d85\u0d82\u0d9a : 52 \u0d9a\u0da9\u0dc0\u01ae \u0dbb\u0db9\u0dd1\u0dc0 \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0db6\u0da7\u028f\u0dbb \u0db8\u0dcf\u0250\u023c \u0d94\u0dc3\u0dca\u0dd9\u0dc3\u02a2 \u0daf\u00fd\u019f \u01ce\u0dc1\u0dcf\u01e9\u0d9c\u0dad\u0dc0 \u0d9c\u0db8\u01e6 \u0d9a\u0dbb \u0d85\u0d82\u0d9a: 57 \u0db8\u0dc4\u01ce\u026c\u0262\u0dc0\u0dd0\u0dc0 \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d8b\u01b1\u025e \u0db8\u0dcf\u0250\u0db8 \u0dc4\u023f\u0dc0\u0db1 \u0dbd\u00fa\u0dc2\u0255\u0dba (6) \u0daf\u00fa\u0dc0\u0dcf\u0daf, \u0d91\u0dad\u0dd0\u01e6 \u0286\u0da7 \u0db1\u0dcf\u0d9c\u025c\u0d9a \u0dc3\u0d82\u0dc0\u0259\u0db0\u0db1 \u0d85\u01dd\u0d9a\u0dcf\u025c\u0dba \u0db8\u0119\u01e6 \u0d85\u0d82\u0d9a: 1517/14 \u0dc4\u0dcf 2007.10.03 \u01ce\u0db1 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dba \u0db8\u0119\u01e6 \u021d\u0d9a\u0dcf\u0274\u0dad \u0db8\u0dcf\u0250\u023c \u0dc4\u023f\u0dc0\u0db1 \u0dbd\u00fa\u0dc2\u0255\u0dba (7) \u0daf\u00fa\u0dc0\u0dcf \u0d9c\u0db8\u01e6 \u0d9a\u0dbb, \u0d91\u0dad\u0dd0\u01e6 \u0286\u0da7 \u0d85\u0d82\u0d9a :70 \u0dc4\u0dd0\u0dbd\u0db9\u0d9c\u0dc3\u0dca\u0dc0\u0dd0\u0dc0 \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0db6\u0da7\u028f\u0dbb \u0db8\u0dcf\u0250\u0db8 \u0d94\u0dc3\u0dca\u0dd9\u0dc3\u02a2 \u0db8\u0dd0\u0daf\u0dc0\u013c\u013d\u0dba. \u0dd9\u0dc4\u02a3\u0dd9\u0dbb\u02a3\u0269 \u0dd9\u0db4\u02a3\u0dad\u0dcf\u0db1 \u0db8\u0dcf\u0259\u0d9c\u0dba \u0dd9\u0146\u0daf\u0db1\u0dba \u0d9a\u0dbb\u023d\u01e6, \u0daf\u00fd\u019f \u0dc3\u0dc4 \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb \u01ce\u0dc1\u0dcf\u01e9\u0d9c\u0dad\u0dc0 \u0d9c\u0db8\u01e6 \u0d9a\u0dbb \u0d91\u00fc \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0daf\u00fd\u019f \u0db8\u0dcf\u0250\u0db8 \u0d94\u0dc3\u0dca\u0dd9\u0dc3\u02a2 \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7 \u01ce\u0dc1\u0dcf\u01e9\u0d9c\u0dad\u0dc0 \u0d9c\u0db8\u01e6 \u0d9a\u0dbb \u0d85\u0d82\u0d9a: 72 \u00fb\u025c\u0d9c\u0262\u0dc0\u0dd0\u0dc0 \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0db6\u0da7\u028f\u0dbb \u0db8\u0dcf\u0250\u0db8 \u0dc4\u023f\u0dc0\u0db1 \u0dbd\u00fa\u0dc2\u0255\u0dba (8) \u0daf\u00fa\u0dc0\u0dcf\u0daf, \u0d91\u0dad\u0dd0\u01e6\u0286\u0da7 \u0d91\u00fc \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0db6\u0da7\u028f\u0dbb \u0db8\u0dcf\u0250\u0db8 \u0d94\u0dc3\u0dca\u0dd9\u0dc3\u02a2 \u0d9c\u0db8\u01e6 \u0d9a\u0dbb \u0d85\u0d82\u0d9a : 77 \u0263\u0db3 \u0dc0\u0dd0\u0dc0 \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d8b\u01b1\u025e \u0db8\u0dcf\u0250\u0db8 \u0dc4\u023f\u0dc0\u0db1 \u0dbd\u00fa\u0dc2\u0255\u0dba (9) \u0daf\u00fa\u0dc0\u0dcf, \u0d91\u0dad\u0dd0\u01e6 \u0286\u0da7 \u0d91\u00fc \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0db6\u0da7\u028f\u0dbb \u0db8\u0dcf\u0250\u0db8 \u0d94\u0dc3\u0dca\u0dd9\u0dc3\u02a2 \u0daf\u00fd\u019f \u01ce\u0dc1\u0dcf\u01e9\u0d9c\u0dad\u0dc0 \u0d9c\u0db8\u01e6 \u0d9a\u0dbb \u0dbb\u0db9\u0dd1\u0dc0 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dc3\u0db7\u0dcf \u0db6\u0dbd \u021d\u0dd9\u01ca\u0dc1\u0dd9\u024f \u0d8b\u01b1\u025e \u0db8\u0dcf\u0250\u0db8 \u0dc4\u023f\u0dc0\u0db1 \u0dbd\u00fa\u0dc2\u0255\u0dba (10) \u0daf\u00fa\u0dc0\u0dcf\u0daf,",
