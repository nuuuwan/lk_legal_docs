    "text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u0dda\u024f 1978 \u0daf\u0dd9\u0dd9\u0dc3\u0dd0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 08 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0d85\u0d82\u0d82\u0d9a 14 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u0dda\u024f \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dda\u0dda\u0dda \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0dda\u0daf\u0db1 \u0dba\u0da7\u0dad\u0dda\u0dda\u01ae \u0db4\u0dc5 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0dc3\u0dda\u02e6\u0dda\u0dc0\u0dcf\u0dcf \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd3\u0dad\u0dd2 \u0dc0\u0dbd\u0da7 \u0d85\u0daf\u0dcf\u0dcf\u0dc5 II \u0dc0\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dda\u02e6\u0dda \u0d87\u0dad\u0dd2 \u2018\u2018\u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0db1\u0dd2\u0dbd\u0db0\u0dbb\u0dba\u0db1\u0dca\u0d9c\u0dda\u0dda\u0118 \u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8\u0dca, \u0d8b\u0dc3\u0dc3\u0dca\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0db8\u0dcf\u0dcf\u0dbb\u0dd4\u0dc0\u0dd3\u0db8\u0dca\u2019\u2019 \u0dba\u0da7\u0dad\u0dda\u0dda\u01ae 06 \u0dc0\u0db1 \u0da2\u0dda\u0dda\u0dda\u0daf\u0dba\u0dda\u0dda\u024f \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u0dda\u024f 2023 \u0d85\u0db4\u0dca\u200d\u0dbb\u0dda\u0dda\u0dda\u0dbd\u0dca \u0db8\u0dc3 04 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1\u0dd0\u0dd0\u0dad\u0dd2 \u0d85\u0d82\u0d82\u0d9a 2326/31 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u200d\u0dd9\u02e4\u0dd9\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u0dda\u024f \u0dbb\u0da2\u0dba\u0dda\u0dda\u024f \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0dda\u0daf\u0db1 \u0dba\u0da7\u0dad\u0dda\u0dda\u01ae \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0db8\u0dca, \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0dc3\u0dda\u02e6\u0dda\u0dc0\u0dcf\u0dcf \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dbb, \u0d92 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0d85\u0daf\u0dcf\u0dcf\u0dc5 \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0\u0da7 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0dda\u0229.",
