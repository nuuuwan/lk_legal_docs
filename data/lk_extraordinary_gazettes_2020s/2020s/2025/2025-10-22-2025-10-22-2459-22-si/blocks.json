    ],
    "text": "\u0daf\u0dd2\u0db1 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0daf\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb \u0db6\u0dd9\ufffd\u0daf\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u2018\u0d87\u2019 \u0d85\u0d9a\u0dca\u0dc2\u0dbb\u0dba \u0daf\u0dbb\u0db1 \u0da1\u0db1\u0dca\u0daf \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dba \u0db1\u0dd0\u0dd0\u0dc0\u0dad \u0db6\u0dd9\ufffd\u0daf\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0da7 \u0dba\u0dd9\ufffd\u0daf\u0dd4\u0db1 \u0db6\u0dc0\u0dad\u0dca \u201d \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u201c\u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0db8\u0dd0\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0d9a\u0ddc\u02c1\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0d85\u0d82\u0d82\u0d9a 1757/18 \u0dc3\u0dc4 2012.05.11 \u0daf\u0dd2\u0db1 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u200d\u200d\u0dc1\u0dd9\u02e4\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dd9\ufffd\u0dc4\u0dd2 \u0db4\u0dc5 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0daf\u0dd0\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb \u0db6\u0dd9\ufffd\u0daf\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u2018\u0d86\u2019 \u0d85\u0d9a\u0dca\u0dc2\u0dbb\u0dba \u0daf\u0dbb\u0db1 \u0da1\u0db1\u0dca\u0daf \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dba \u0db1\u0dd0\u0dd0\u0dc0\u0dad \u0db6\u0dd9\ufffd\u0daf\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0da7 \u0dba\u0dd9\ufffd\u0daf\u0dd4\u0db1 \u0db6\u0dc0\u0dad\u0dca\u201d \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca; \u0dc4\u0dcf\u0dcf \u0d91\u0d9a\u0dd3 \u0d8b\u0db4 \u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u024f \u201c\u0da1\u0db1\u0dca\u0daf \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dba \u2018\u0d87\u2019- \u0db4\u0ddc\u02da\u0ddc\u0dc5\u0ddc\u02e8\u0ddc\u0db1\u0dca\u0db1\u0dbb\u0dd4\u0dc0\u201d \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u201c \u0da1\u0db1\u0dca\u0daf \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dba \u2018\u0d86\u2019- \u0db8\u0dd0\u0dd0\u0daf\u0dd2\u0dbb\u0dd2\u0d9c\u0dd2\u0dbb\u0dd2\u0dba\u201d \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\u02ea\u0db0\u0db1\u0dba \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db6\u0dc0 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd9\u0dd9\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229.",
