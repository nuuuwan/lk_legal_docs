    "text": "\u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0dd9\u0d9c\u0daf\u0dbb \u0dc0\u0dad\u0dca\u0dad, \u0daf\u0dbb\u0db1\u0dca\u0dd9\u0daf\u0dca \u0dc0\u0dad\u0dca\u0dad, \u0d9c\u0dbd\u0dca\u0d9a\u0dd0\u0da7\u0dd2\u0dd9\u0dba\u0dca \u0dd9\u0dc4\u0dda\u0db1 \u0dc3\u0dc4 \u0db8\u0dc4\u0dd9\u0d9a\u0ddc\u0da7\u0dd4\u0dc0 \u0db4\u0dcf\u0dbb, \u0dba\u0dd6. \u0d91\u0db8\u0dca. \u0db6\u0daf\u0dd4\u0dbb\u0dd4\u0dc3\u0db8\u0dcf\u0db1\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0dd9\u0d9c\u0daf\u0dbb \u0dc0\u0dad\u0dca\u0dad, \u0daf\u0dbb\u0db1\u0dca\u0dd9\u0daf\u0dca \u0dc0\u0dad\u0dca\u0dad, \u0d9c\u0dbd\u0dca\u0d9a\u0dd0\u0da7\u0dd2\u0dd9\u0dba\u0dca \u0dd9\u0dc4\u0dda\u0db1 \u0dc3\u0dc4 \u0db8\u0dc4\u0dd9\u0d9a\u0ddc\u0da7\u0dd4\u0dc0; \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7: \u0dba\u0dd6. \u0d91\u0db8\u0dca. \u0db6\u0daf\u0dd4\u0dbb\u0dd4\u0dc3\u0db8\u0dcf\u0db1\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0dd9\u0d9c\u0daf\u0dbb \u0dc0\u0dad\u0dca\u0dad, \u0daf\u0dbb\u0db1\u0dca\u0dd9\u0daf\u0dca \u0dc0\u0dad\u0dca\u0dad, \u0d9c\u0dbd\u0dca\u0d9a\u0dd0\u0da7\u0dd2\u0dd9\u0dba\u0dca \u0dd9\u0dc4\u0dda\u0db1 \u0dc3\u0dc4 \u0db8\u0dc4\u0dd9\u0d9a\u0ddc\u0da7\u0dd4\u0dc0, \u0dc0\u0dd3. \u0d9a\u0dcf\u0dbb\u0dcf\u0dbd\u0dc3\u0dd2\u0d82\u0dc4\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0dd9\u0d9c\u0daf\u0dbb \u0dc0\u0dad\u0dca\u0dad, \u0daf\u0dbb\u0db1\u0dca\u0dd9\u0daf\u0dca \u0dc0\u0dad\u0dca\u0dad, \u0d9c\u0dbd\u0dca\u0d9a\u0dd0\u0da7\u0dd2\u0dd9\u0dba\u0dca \u0dd9\u0dc4\u0dda\u0db1 \u0dc3\u0dc4 \u0db8\u0dc4\u0dd9\u0d9a\u0ddc\u0da7\u0dd4\u0dc0, \u0dbb\u0da2\u0dba \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0db1 \u0dd9\u0d9c\u0daf\u0dbb \u0dc0\u0dad\u0dca\u0dad, \u0daf\u0dbb\u0db1\u0dca\u0dd9\u0daf\u0dca \u0dc0\u0dad\u0dca\u0dad, \u0d9c\u0dbd\u0dca\u0d9a\u0dd0\u0da7\u0dd2\u0dd9\u0dba\u0dca \u0dd9\u0dc4\u0dda\u0db1 \u0dc3\u0dc4 \u0db