    "text": "\u201c\u0da2\u0dcf\u01af\u0d9a \u0dd9\u0dbd\u02a3\u0dad\u025a\u0250 \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u0dd9\u0dc3\u02a2\u0dc0\u0dba \u0d9a\u0dc5 \u018c. \u0d91\u023c. \u0d91\u0dc3\u0dca. \u011b\u0dab\u0dbb\u01ae\u0db1 \u0db8\u0dc4\u0dad\u0dcf\u0dd9\u0118 \u0dc0\u0dd0\u0da9 \u0dad\u0dc4\u0db1\u023c \u0d9a\u0dbd 2002.10.28 \u01ce\u0db1 \u0286\u0da7 \u0db1\u018d \u01b0\u01e6\u01d0\u0dd9\u0dc0\u01e6 \u01e7\u0dd9\u0daf\u02a3\u0dc3\u0dca\u0dd9\u0d9a\u02a3\u0da7 \u01e7\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dc5 2022.01.26 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf \u0dc0\u0db1 \u0d9a\u0dcf\u0dbd\u0dba \u01b1\u0dc5 \u0d94\u0291\u0da7 \u0dc0\u0dd0\u017b\u0217, \u0d8b\u0dc3\u0dc3\u0dca\u026b\u023c, \u01cf\u0db8\u0db1\u0dcf \u0dc4\u0dcf \u0d85\u0dd9\u0db1\u00fd\u01ae \u0dc0\u0dbb\u021d\u0dc3\u0dcf\u0daf \u0dc3\u0db3\u0dc4\u0dcf \u028f\u023d\u0d9a\u0db8\u00fa \u01af\u0dd9\u0229 \u0daf, \u028f\u023d\u0d9a\u0db8\u00fa \u01af\u0dd9\u0229 \u0db1\u023c \u0d92\u0dc0\u0dcf \u0dd9\u0db1\u02a3\u0dbd\u0dd0\u022b\u0dd9\u0db8\u01e6 \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0286\u01d0\u0dc0 \u01af\u0dd9\u0229\u0daf \u0dba\u01e6\u0db1\u01ae \u0d91\u0dd9\u0dbd\u0dc3 \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0286\u01d0\u0dc0 \u01af\u0dd9\u0229 \u0db1\u023c \u028f\u023d\u026a\u0dba \u0252\u01b1 \u0dc3\u0dc4\u0db1 \u0d9a\u0dc0\u0dd9\u0259\u0daf \u0dba\u01e6\u0db1\u01ae \u0218\u0298\u0db6\u0db3\u0dc0 \u0dd9\u0269.\u201d",
