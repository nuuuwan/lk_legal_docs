  {
    "page_number": 0,
    "bbox": [
      47.95,
      548.68,
      542.48,
      635.24
    ],
    "text": "\u0db6\u0dc3\u0dca\u0db1\u0dcf\u0dcf\u0dc4\u0dd2\u0dbb \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dda\u01ae, \u0d9c\u0db8\u0dca\u0db4\u0dc4 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda\u024f, \u0dc3\u0dd2\u0dba\u0db1\u0dd1\u0dd1 \u0d9a\u0ddd\ufffd\u0ddd\u02ea\u0dbb\u0dc5\u0dba\u0dda\u024f, \u0dbb\u0dcf\u0dcf\u0d9c\u0db8\u0dca \u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda, \u0dc0\u0dad\u0dca\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf \u0db6\u0dbd \u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0 \u0dad\u0dd4\u0dc5 \u0dc0\u0dad\u0dca\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dbd\u0dda\ufffd\u0d9a\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f \u0d85\u0d82\u0d82\u0d9a 168 B \u0daf\u0dd2\u0d9a\u0dca\u0d95\u0dc0\u0dd2\u0da7 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd2 \u0dc0\u0dc3\u0db8\u0dda\u023c \u0daf\u0dd2\u0d9a\u0dca\u0d95\u0dc0\u0dd2\u0da7 \u0d9c\u0db8 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc3\u0dbb\u0dca\u0dc0\u0dda\u0dda \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d82\u0d9a GA/WAT/2021/408 \u0dc4\u0dcf\u0dcf 2021.12.24 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0daf\u0dbb\u0db1 \u0d85\u0db1\u0dd4 \u0dbb\u0dda\u0dda\u0d9b\u0db1\u0dba\u0dda\u024f \u0db1\u0dd2\u0dbb\u0dd6\u0db4\u0dab\u0dba \u0d9a\u0ddc\ufffd\u0ddc\u0da7 \u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0da7 \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8\u0dca, \u0d8b\u0dad\u0dd4\u0dbb\u0da7 ; \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0dbb\u0dd4 \u0db1\u0ddc\ufffd\u0ddc\u0daf\u0db1\u0dca\u0db1\u0dcf\u0dcf \u0dc0\u0dd2\u0dc0\u0dd8\u0dd8\u0dad \u0db8\u0dd4\u0da9\u0dd4\u0db6\u0dd2\u0db8 \u0daf, \u0db1\u0dd0\u0dd0\u0d9c\u0dd9\ufffd\u0db1\u0dc4\u0dd2\u0dbb\u0da7 ; \u0dc0\u0dd9\u0dd9\u0dbb\u0dc5 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0daf, \u0daf\u0d9a\u0dd4\u0dab\u0da7 ; \u0dba\u0dd4\u0d9c\u0daf\u0db1\u0dc0\u0dd2 \u0da2\u0dbd \u0db4\u0ddc\ufffd\u0ddc\u0db8\u0dca\u0db4\u0dcf\u0dcf\u0d9c\u0dcf\u0dcf\u0dbb\u0dba \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0d89\u0da9\u0db8 \u0daf, \u0db6\u0dc3\u0dca\u0db1\u0dcf\u0dcf\u0dc4\u0dd2\u0dbb\u0da7 ; \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0dc0\u0dd9\u0dd9\u0dbb\u0dc5\u0daf \u0dba\u0db1 \u0db8\u0dcf\u0dcf\u0dba\u0dd2\u0db8\u0dca \u0dad\u0dd4\u0dc5 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dbb\u0dd6\u0da9\u0dca \u0d91\u0d9a (\u0d85:0, \u0dbb\u0dd6:1, \u0db4\u0dbb\u0dca:0) \u0d9a\u0dca (\u0dc4\u0dd9\ufffd\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dcf\u0dbb\u0dca 0.1012) \u0d9a \u0dc0\u0dd2\u0dc1\u0dcf\u0dcf\u0dbd \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3 \u0dc3\u0dc4 \u0d92 \u0dad\u0dd4\u0dc5 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0d9c\u0dc4\u0d9a\u0ddc\ufffd\u0ddc\u0dc5, \u0db4\u0dc5\u0dad\u0dd4\u0dbb\u0dd4 \u0d86\u0daf\u0dd3 \u0dc3\u0dd2\u0dba\u0dbd\u0dca\u0dbd \u0daf \u0dc3\u0db8\u0d9c \u0dc0\u0dda\u0dda.",
