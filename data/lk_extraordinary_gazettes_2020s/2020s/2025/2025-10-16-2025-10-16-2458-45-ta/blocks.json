    "text": "\u0b95\u0bc7\u0bc7\u0b95\u0bbe\u0bbe\u0bb2\u0bc8\u0bc8 \u0bae\u0bbe\u0bbe\u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8\u0bc8 \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bc7\u0bc7\u0b95\u0bbe\u0bbe\u0bb2\u0bc8\u0bc8 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0bc8 \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b92\u0bb0\u0bc1 \u0b95\u0bc7\u0bc7\u0b95\u0bbe\u0bbe\u0bb2\u0bc8\u0bc8 \u0bae\u0bbe\u0bbe\u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8\u0bc8 \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bc7\u0bc7\u0b95\u0bbe\u0bbe\u0bb2\u0bc8\u0bc8 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0bc8 \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0b92\u0bb0\u0bc1",
