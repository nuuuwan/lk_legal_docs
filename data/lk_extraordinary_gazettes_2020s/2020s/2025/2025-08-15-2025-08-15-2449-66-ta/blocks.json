    "text": "\u0bc6\u0b9a\u1fa2\u0ba9\u0bbe \u0ba4\u0b9a\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0baa\u0bb2\u0bb9 \u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 ; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1 : \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd \u0b95\u0ba3\u0bcd\u1f8c\u0baa\u0bbf\u1f8a\u0b95\u0bcd\u0b95 \u1f99\u1f8a\u0baf\u0bbe\u0ba4 \u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0baa\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0b9f\u0baa\u0bcd\u0bb3\u0bbf\u1f9d. \u0b8e\u0bb8\u0bcd. \u0b9a\u0bc1\u0b9a\u0bbf\u0bb2\u0bcd \u0b9c\u0baf\u0bb2\u0ba4\u0bcd \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0baa\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0bc6\u0b9a\u0bb2\u0bc0\u0ba9\u0bbe \u0ba4\u0b9a\u0ba8\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0baa\u0bb2\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0baa\u0bbf\u0bc8\u0bb0\u0bae\u0bcd \u0bc7\u0bb2\u0ba9\u0bcd\u0b9f\u0bcd \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u0bb0\u0bcd \u0b95\u0bae\u0bcd\u0baa\u0ba9\u0bbf \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0baa\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 ; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 : \u0baa\u0bbf\u0bc8\u0bb0\u0bae\u0bcd \u0bc7\u0bb2\u0ba9\u0bcd\u0b9f\u0bcd \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u0bb0\u0bcd \u0b95\u0bae\u0bcd\u0baa\u0ba9\u0bbf \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0baa \u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0bc8\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bb0\u0bcd \u0bc6\u0ba8\u0bb5\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0ba9\u0bbe\u0ba8\u0bcd\u1f90 \u0bc8\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0b9a\u0bbe\u0bc8\u0bb2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0bb0\u0bbe\u0ba9\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0baa\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0b95\u0bb2\u0bcd\u0bc7\u0bb9\u0ba9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0bc6\u0b95\u0bbe\u0ba9\u0bcd\u0b95\u0bb9 \u0bb5\u0ba4\u0bcd\u0bc8\u0ba4,\u0b95\u0bb2\u0bcd\u0bc7\u0bb9\u0ba9, \u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0bc7\u0baa\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0baa\u0b95\u0bb9\u0bb2\u0ba8\u0bcd\u0bc7\u0ba4\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc6\u0bb9\u0bbe\u0bb0\u0baf\u0bbf\u0b9a\u0ba9\u0bcd \u0bc6\u0b95\u0bae\u0bcd\u0baa\u0bb8\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0baa\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u0bc8\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bb0\u0bcd \u0bc6\u0ba8\u0bb5\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bb0\u0ba9\u0bbe\u0ba8\u0bcd\u1f90 \u0bc8\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0b9a\u0bbe\u0bc8\u0bb2 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0bb0\u0bbe\u0ba9\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0baa\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0b95\u0bb2\u0bcd\u0bc7\u0bb9\u0ba9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0bc6\u0b95\u0bbe\u0ba9\u0bcd\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4, \u0b95\u0bb2\u0bcd\u0bc7\u0bb9\u0ba9, \u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0bc7\u0baa\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0baa\u0b95\u0bb9\u0bb2\u0ba8\u0bcd\u0bc7\u0ba4\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bc6\u0bb9\u0bbe\u0bb0\u0baf\u0bbf\u0b9a\u0ba9\u0bcd \u0bc6\u0b95\u0bae\u0bcd\u0baa\u0bb8\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0baa\u0b95\u0bb9\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4.",
