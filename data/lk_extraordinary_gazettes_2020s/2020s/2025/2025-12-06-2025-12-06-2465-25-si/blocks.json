    "text": "\u201c\u027c \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0db8\u0db1\u0dcf\u0d9c\u0db8\u0db1 \u0db8\u019c\u0da9\u0dbd\u0dd9\u024f \u0dd9\u0dad\u0262\u0dd9\u0daf\u019d\u0dba \u018b\u0dd9\u0db4\u02a4\u0dd9\u0269 1983.03.15 \u0286\u0da7 2017.03.26 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf \u0dd9\u0dc3\u0dda\u0dc0\u0dba \u0d9a\u0dc5 \u0252. \u0150. \u00fb\u025c\u0db6\u019c\u0da9\u0dcf \u0db8\u0dba\u0dcf 1977.11.07 \u0286\u0da7 2016.07.07 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf \u0dd9\u0dc3\u0dda\u0dc0\u0dba \u0d9a\u0dc5 \u0219. \u0dd9\u0db4\u025c\u0dba\u0dc3\u0dcf\u023d \u0db8\u0dba\u0dcf, 1986.12.11 \u0286\u0da7 2016.10.30 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf \u0dd9\u0dc3\u0dda\u0dc0\u0dba \u0d9a\u0dc5 \u0d86\u0259. \u0d91\u013c. \u0dd9\u00fa. \u0db6\u019c\u0da9\u0dcf \u0db8\u0dba\u0dcf, 1996.09.01 \u0286\u0da7 2017.10.31 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf \u0dd9\u0dc3\u0dda\u0dc0\u0dba \u0d9a\u0dc5 \u0150. \u0d92. \u0150. \u0d91\u0dc3\u0dca. \u0d92\u0d9a\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dba\u0dcf \u0dc3\u0dc4 1980.11.03 \u0286\u0da7 2017.03.25 \u01ce\u0db1 \u0daf\u00fa\u0dc0\u0dcf \u0dd9\u0dc3\u0dda\u0dc0\u0dba \u0d9a\u0dc5 \u0dd9\u00fa.\u0150. \u0db1\u0dc0\u0dbb\u01ae\u0db1 \u0db8\u0dba\u0dcf \u0dba\u0db1 \u0d85\u0dba\u0da7 2004 \u0dd9\u0db4\u0db6\u0dbb\u0dc0\u0dcf\u025c \u0db8\u0dc3 \u0286\u0da7 2004 \u0d85\u0dd9\u021d\u0dda\u0262 \u0db8\u0dc3 \u0daf\u00fa\u0dc0\u0dcf \u0dbd\u0db6\u0dcf \u01cf 2004 \u0db8\u0dd0\u0250 \u0db8\u0dc3 \u0286\u0da7 \u0d85\u01ae\u028f\u017b\u0dc0\u0db1 \u0dbd\u0daf \u0dc0\u0dd0\u017b\u0217 \u0dc0\u0259\u0db0\u0d9a \u0db1\u0dd0\u0dc0\u0dad \u0dbd\u0db6\u0dcf \u0dd9\u0db1\u02a3\u01cf\u0dd9\u0db8\u01e6 \u0d91\u0db8 \u0dd9\u0dc3\u0dda\u0dc0\u0d9a\u0250\u01e6\u0da7 \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0286\u01d0\u0dc0 \u01af\u0dd9\u0229 \u0daf \u0dba\u01e6\u0db1\u01ae \u0d91\u0dd9\u0dc3\u0dda \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u00fa \u0286\u01d0\u0dc0 \u0d87\u01ae\u0db1\u023c \u028f\u023d\u026a\u0dba \u0252\u01b1 \u0dc3\u0dc4\u0db1 \u0d9a\u0dc0\u0dd9\u0259 \u0daf \u0dba\u01e6\u0db1\u01ae \u0218\u0298\u0db6\u0db3\u0dc0 \u0dd9\u0269.\u201d",
