    "text": "\u0d8b\u0db4\u0dc1\u0dda\u0d9b\u0db1\u0dba \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2013--\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 \u0dc0\u0dd2\u0db1\u0dd2\u0dba\u0dca\u0da0\u0dba\u0dca\u0dad \u0dc3\u0db1 \u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dba\u0dba\u0dda\u0dc2 \u0dba\u0db1\u0ddd \u0db4\u0dad\u0dca\u200d\u0dbb \u0d9a\u0d82\u0d9a\u0dba \u0d89\u0dca\u0dad\u0dba\u0da2\u0dcf\u0dca\u0dad\u0dc2\u0dca\u0dad \u0dcf\u0db1\u0db1\u0db8\u0dca \u0dba\u0db4\u0dde\u0dca\u0db0\u0d9c\u0dbd\u0dd2\u0d9a \u0dc3\u0db1 \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dd2\u0dba\u0dcf\u0dbd\u0dda\u0dc0\u0dba \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dba\u0dda/\u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0dca\u0dad\u0dba\u0dda \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d9a\u0dba\u0dd2\u0dad\u0dd2 \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba\u0dda \u0d9a\u0dba\u0db4\u0dca\u0d9a\u0dca\u0d9a\u0dba\u0dc2\u0dcf\u0dba\u0dc0\u0dca\u0dad \u0d87\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dba\u0da7\u0dda \u0dba\u0d9a\u0ddc\u0da7\u0dba\u0dc3\u0dda \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db1\u0db8/\u0db1\u0db8\u0dca \u0dc3\u0db1 \u0dbd\u0dd2\u0db4\u0dd2\u0db1\u0dba \u0db1\u0dd0\u0db3\u0dd4\u0dd4\u0dc0\u0db8\u0dca\u0db4\u0dda \u0d89\u0da9\u0dba\u0db8\u0dca \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dc3\u0db1 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0db1 \u0db6\u0dd0\u0db3\u0dd3\u0db8\u0dca \u0db1\u0db8\u0dca \u0d92 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0d82\u0d9a\u0dba \u0d9a\u0d82\u0d9a\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014- (\u0dba\u0db1\u0d9a\u0dca\u0d9a\u0dba\u0da7\u0dba\u0dcf\u0dbb\u0dca) :84 0.0 7 \u0d89\u0da9\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dba\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0dca\u0dad \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba _ _ \u0d9a\u0d82\u0d9a 475,\u0d9a\u0da9\u0dd4\u0dba\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd :85 0.03 3 \u0d89\u0da9\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dba\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0dca\u0dad \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba _ _ \u0d9a\u0d82\u0d9a 475,\u0d9a\u0da9\u0dd4\u0dba\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd :8 0.1 39 \u0d89\u0da9\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dba\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0dca\u0dad \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba _ _ \u0d9a\u0d82\u0d9a 475,\u0d9a\u0da9\u0dd4\u0dba\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd :88 0.04 3 \u0d89\u0da9\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dba\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0dca\u0dad \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba _ _ \u0d9a\u0d82\u0d9a 475,\u0d9a\u0da9\u0dd4\u0dba\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd :89 0.1149 \u0d89\u0da9\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dba\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0dca\u0dad \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba _ _ \u0d9a\u0d82\u0d9a 475,\u0d9a\u0da9\u0dd4\u0dba\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd :91 0.050 \u0d89\u0da9\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dba\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0dca\u0dad \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba _ _ \u0d9a\u0d82\u0d9a 475,\u0d9a\u0da9\u0dd4\u0dba\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd :93 0.003 \u0d89\u0da9\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dba\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0dca\u0dad \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba _ _ \u0d9a\u0d82\u0d9a 475,\u0d9a\u0da9\u0dd4\u0dba\u0dc0\u0dbd \u0db4\u0dcf\u0dbb,\u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd :94 0.03 3 \u0d89\u0da9\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dba\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0dca\u