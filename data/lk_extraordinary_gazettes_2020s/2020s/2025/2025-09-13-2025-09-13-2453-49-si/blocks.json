    "text": "14 \u0dbd\u0dd0\u0db1\u0dd2 \u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dba\u0dda \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0db8\u0dc0\u0dcf\u0dbb\u0dd2\u0dc0\u0dca\u0dba\u0dda \u0dad\u0dd3\u0dbb\u0dab \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbe\u0dba \u0db8 \u0dba\u0db8 \u0db4\u0dc2\u0dcf\u0dba\u0dda \u0db8\u0dc1\u0db1\u0dd4\u0dbd\u0dbb \u0dd2\u0dc3\u0dc0\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dba\u0dda \u0db4\u0dc5\u0db4\u0dc2\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dba \u0dba \u0dba\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc0\u0dba\u0dda \u0d9a\u0d82\u0d9a 1123 \u0d9a\u0dd2\u0dbb\u0dd2\u0dca\u0dad\u0d9c \u200d\u0dcf\u0db8 \u0db1\u0dd2\u0dbc \u0dcf\u0dbb\u0dd2 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc0\u0dba \u0dad\u0dd4\u0dc2 \u0dc4\u0dd2\u0dca\u0dad\u0db1\u0dcf\u0dbb\u0dca\u0dad\u0dba\u0d9c\u0db1\u0dd2\u0dba \u0db1\u0db8\u0dd0\u0dad\u0dd2 \u0d9c\u0dba\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dcf \u0dc0\u0dd5 \u0d9c, \u0d9a\u0d82\u0d9a 320161 \u0d9c\u0dbb\u0db1 \u0d9a\u0dd0\u0dc5\u0dd0\u0dc0\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0dba\u0db8\u0dca \u0d9a\u0dbc\u0dcf\u0db4 \u0d9a\u0d82\u0d9a 02 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a 1:61 \u0d9c\u0dbb\u0db1 \u0d89\u0dc5\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dc0\u0dca \u0dba\u0dbc\u0dc0 \u0dba\u0db4\u0dca\u0dad\u0db1\u0dd4\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7 \u0d87\u0dda\u0dcf\u0dcf \u0dc0\u0dd5 \u0d9c, \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db4\u0dd1\u0db8\u0dca \u0d89\u0dd2\u0dc3\u0dbb\u0dd2\u0db4\u0dda \u0d9a\u0dbb\u0db1 \u0dba\u0dbc\u0dc0 \u0d9c\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0dba\u0d9c\u0db8\u0dd2\u0dca\u0dad 1998 \u0d9a\u0d82\u0d9a 21 \u0d9c\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0dd2\u0dc3\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0db4\u0db1\u0dba\u0dda 55 \u0dbd\u0dd0\u0db1\u0dd2 \u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb 2025002007 \u0dbd\u0dd0\u0db1\u0dd2 \u0dd2\u0dc3\u0db1 \u0d9a\u0d82\u0d9a 2422662 \u0d9c\u0dbb\u0db1 \u0d9c\u0dd0\u0dc0\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda \u0dba\u0dae\u0dcf \u0db4\u0dbb\u0dd2\u0dd2\u0dc3 \u0db4\u0dc2\u0d9a\u0dbb\u0db1 \u0dbc\u0d9c \u0d9c\u0dd0\u0dca\u0dad\u0dc0\u0dd3\u0dba\u0db8\u0dca \u0dc0\u0db3\u0dc1\u0dca\u0dad \u0dba\u0d9a\u0ddc\u0da7 \u0d87\u0dda\u0dcf\u0dcf \u0dc0\u0dd5 \u0d9c, \u0d89\u0dc5\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dc0\u0dca\u0dbd\u0dbc \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc0\u0db8\u0dca\u0db6\u0dca\u0dad \u0dba\u0dba\u0dca\u0dad \u0dba\u0db8\u0dc4\u0dd2 \u0db4\u0db4\u0dba\u0dbd\u0dca\u0d9b\u0db1\u0dba\u0dda \u0d9c\u0dd0\u0d9a\u0dca\u0d9a\u0dba\u0dba\u0dbd\u0db1 \u0db8\u0dcf\u0dba\u0dda \u0dad\u0dd3\u0dbb\u0dab 1998 \u0d9a\u0d82\u0d9a 21 \u0d9c\u0dbb\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0dd2\u0dc3\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0db4\u0db1\u0dba\u0dda 14 \u0dbd\u0dd0\u0db1\u0dd2 \u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba\u0dba\u0dca\u0dad \u0db4\u0dc1\u0dcf \u0d9a\u0dda\u0dc0\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0db8\u0dcf \u0dba\u0dbd\u0dcf \u0db4\u0dbd\u0dbb\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dbc\u0dcf\u0dbc \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbb, \u0db8\u0db8 \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dbe \u0d9a\u0dbb\u0db8\u0dd20 \u0db4\u0dd3. \u0dc3\u0dd3. \u0da9\u0dd3. \u0dc3\u0dd2\u0dc1\u0dda\u0dbb\u0dcf, \u0d89\u0dc5\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0db8\u0dc0\u0dcf\u0dbb\u0dd2\u0dc0\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dbd\u0dca0 2025 \u0d9a\u0dba\u0d9c\u0dd