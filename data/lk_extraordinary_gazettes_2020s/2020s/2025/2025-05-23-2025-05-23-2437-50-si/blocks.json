    "text": "\u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u00fd\u025e\u0dab\u0dd1\u0d9c\u0dbd \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0db8\u0dcf\u0dc0\u0dad\u0d9c\u0db8 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d85\u0d82\u0d9a 700, \u0d9a\u01ff\u0dd9\u0db6\u02a3\u0da9 \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0db8\u0da9\u0dc0 \u0dad\u0dcf\u0dbb\u0dcf\u0dd9\u0db4\u02a3\u0dad \u011e\u0dcf\u0db8\u0dd9\u024f \u0218\u028f\u0179 \u0d89\u0da9\u0db8\u0da7, \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262\u0dd9\u0118 2023 \u0dd9\u0db1\u02a3\u0dc0\u0dd0\u023c\u0db6\u0259 \u0db8\u0dc3 24 \u01ce\u0db1 \u0daf\u0dbb\u0db1 \u0d85\u0d82\u0d9a KU/MWT/2023/348 \u0daf\u0dbb\u0db1 \u0d85\u01e9\u0dd9\u0259\u0d9b\u0dab\u0dba\u0da7 \u0d85\u01e9\u0dc0 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb \u2018\u2019 \u022b \u2018\u2019 \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb \u201c \u0287 \u201c \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u01e7\u025f\u0218\u0dad \u201c\u0db4\u01e6\u0dc3\u0262\u0dc0\u01ae\u0dad \u201c \u0db1\u0db8\u0dd0\u01af \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0263 \u0dc0\u0263\u01e6 \u0dc3\u0db8\u01e6\u026a\u0dad \u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259 1.6085 (\u0d85.3, \u025f.3, \u0db4\u0259.36.0) \u00fa \u026a\u0dc1\u0dcf\u0dbd\u01ae\u0dc0\u0dd9\u0dba\u01e6 \u0252\u00fa\u0dad \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0db4\u025c\u01ce \u0db8\u0dcf\u0250\u023c \u026d \u021d\u0dd9\u01ca\u0dc1\u0dba.",
