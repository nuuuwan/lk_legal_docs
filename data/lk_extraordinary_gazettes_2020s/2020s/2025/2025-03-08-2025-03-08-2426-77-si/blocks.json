    "text": "\u0d89\u0dc4\u0dcf \u0dc3\u0db3\u0dc4\u0dca\u0dad \u0d89\u0da9\u0db8\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dc0\u0dcf\u0dc3\u0dd2\u0daf\u0d9a\u0db8\u0dca \u0dba\u0dc4\u0ddd \u0dba\u0dc0\u0db1\u0dda \u0dc3\u0db8\u0dca\u0db6\u0dca\u0dad \u0d9a\u0db8\u0dca \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0daf\u0da7\u0dd2\u0db1 \u0dc3\u0dd2\u0daf\u0dba\u0dbd\u0dd4 \u0dba\u0daf\u0db1\u0dcf\u0db8 \u0dcf\u0db8 \u0dcf\u0db8\u0dca\u0dad \u0dba\u0dc4\u0ddd \u0d94\u0dc0\u0dd4\u0dca\u0dad\u0dba\u0d9c\u0dca\u0dad \u0dbd\u0dd2\u0dba\u0dc0\u0dd2\u0dbd\u0dd2\u0dc0\u0dbd\u0dd2\u0dca\u0dad \u0db6\u0dbd\u0dba\u0dbd\u0dda \u0d85\u0dba\u0dc0\u0dbd\u0dd4\u0dca\u0dad \u0dba\u0dc4\u0ddd 2025 \u0dd9\u0dd0\u0dba\u0dd2\u0dc0 \u0dd9\u0dc3 06 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0dc1\u0db4.\u0dc0.10.00 \u0dda \u0dad\u0dd2\u0db9\u0dd2\u0dbb\u0dd2\u0d9c\u0dc3\u0dca\u0dba\u0dcf\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dba \u0dba \u0dba1\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba\u0dda \u0daf\u0dd3 \u0db8\u0dcf \u0dc3\u0db8\u0dca\u0d85\u0d82\u0d9b \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2.",
