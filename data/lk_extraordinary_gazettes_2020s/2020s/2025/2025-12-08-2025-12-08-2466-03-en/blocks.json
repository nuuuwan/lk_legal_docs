  {
    "page_number": 0,
    "bbox": [
      48.01,
      453.58,
      542.49,
      479.35
    ],
    "text": "IT is hereby announced for the information of the general public that the Annual Feast of St. Sebastian's National Shrine, Kandana will be held on 20th January 2026 and the duration of the Feast will be from 03.01.2026 to 08.02.2026.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      66.01,
      489.88,
      542.48,
      515.35
    ],
    "text": "1. The attention of the general public is drawn to the Regulations published in Gazette Notification No. 2135/34 dated 06th August 2019 under the Pilgrimage Ordinance 175 in this regard.",
    "fonts": [
      "TimesNewRomanPS-ItalicMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      66.01,
      525.88,
      526.82,
      539.35
    ],
    "text": "2. These rules and regulations that have been promulgated shall be applicable during the period of this ceremony.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
