    "bbox": [
      55.15,
      567.95,
      549.66,
      593.29
    ],
    "text": "(a) declare that the area of land called as \u201cDikwella Deegawalukarama Rajamaha Viharaya\u201d speci\ufb01ed in the Schedule hereto shall be an Urban Development area for the purpose of the aforesaid Ordinance; and",
    "fonts": [
      "Times-Italic",
      "Times-Roman"
    ],
    "sizes": [
      10.0
    ]
