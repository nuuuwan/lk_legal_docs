    "text": "\u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dd9\u0269 2019 \u0d85\u0d82\u0d9a 02 \u0daf\u0dbb\u0db1 \u0dc3\u023f\u0db4\u0d9a\u0dcf\u0dbb \u0dd9\u0dc3\u02a2\u0dc0\u0d9a \u026a\u0279\u0dcf\u0db8 \u0dc0\u0dd0\u017b\u0217 \u021d\u0da5\u0217\u01af\u0dd9\u0dba\u028f 24 \u0dd9\u0dc0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u026a\u0dc2\u0dba \u0db7\u0dcf\u0dbb \u0d85\u0db8\u0dcf\u0dad\u0255\u0dc0\u0dbb\u0dba\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd, \u0dd9\u023c \u0dc0\u0db1\u026a\u0da7 \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dc0 \u026a\u0288\u025e\u0dc0\u0dcf \u0dc4\u0dd0\u0dbb \u0d87\u01af \u0db6\u0dd0\u026a\u01e6 \u027b \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d86\u019c\u018d\u0100\u0db8 \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0269 154 \u0d87. \u0dc0\u0255\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0d85\u01e9\u0dc0 \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u01ae \u0d86\u019c\u018d\u0d9a\u0dcf\u0dbb \u0dc0\u0db1 \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dd0\u026a\u01e6, \u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0db4\u0dc5\u0dcf\u01ae \u0dc3\u0db7\u0dcf\u0dd9\u0269 2019 \u0d85\u0d82\u0d9a 02 \u0daf\u0dbb\u0db1 \u0dc3\u023f\u0db4\u0d9a\u0dcf\u0dbb \u0dd9\u0dc3\u02a2\u0dc0\u0d9a \u026a\u0279\u0dcf\u0db8 \u0dc0\u0dd0\u017b\u0217 \u021d\u0da5\u0217\u01af\u0dd9\u024f \u01e7\u0dd9\u0dba\u02a4\u0d9c\u0dc0\u0dbd 03 \u0dc0\u0db1 \u01e7\u0dd9\u0dba\u02a4\u0d9c\u0dba \u0d89\u0dc0\u01ae \u0d9a\u0dbb \u0d92 \u0dd9\u0dc0\u01e9\u0dc0\u0da7 \u0db4\u0dc4\u0dad \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u01e7\u0dd9\u0dba\u02a4\u0d9c\u0dba \u0d86\u0dd9\u01ca\u0dc1 \u0d9a\u0dbb\u023d\u01e6 \u0d91\u0db8 \u01e7\u0dd9\u0dba\u02a4\u0d9c \u0db8\u0dcf\u0dbd\u0dcf\u0dc0 \u0dc3\u0d82\u0dd