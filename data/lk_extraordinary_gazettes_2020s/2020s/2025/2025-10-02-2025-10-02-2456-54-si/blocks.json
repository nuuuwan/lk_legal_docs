    "text": "\u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dda\ufffd \u0db4\u0db1\u0dad\u0dda\u01ae 38 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba (\u0d85) \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0db4\u0db1\u0dc0\u0db1 \u0dbd\u0daf\u0dca\u0daf\u0dcf\u0dcf \u0dc0\u0dd6 \u0daf, \u0d85\u0d82\u0d82\u0d9a 1887/41 \u0dc4\u0dcf\u0dcf 2014.11.07 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0daf\u0dbb\u0db1 \u0dbb\u0da2\u0dba\u0dda\u024f \u0d85\u0dad\u0dd2\u0dc0\u0dd2\u0dc1\u200d\u0dd9\u0dd9\u02e4\u0dd9\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dc5\u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dca\u0daf\u0dcf\u0dcf \u0dc0\u0dd6 \u0daf, 2014 \u0d85\u0d82\u0d82\u0d9a 308 \u0dc4\u0dcf\u0dcf 2014.10.31 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0daf\u0dbb\u0db1 \u0d86\u0da5\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc3\u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb\u0dc0 \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd9\u0dd9\u0dd9\u0db1 \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba \u0dc0\u0dd9\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0dad\u0dd2\u0db6\u0dda\ufffd. \u0d91\u0db1\u0db8\u0dd4\u0dad\u0dca \u200d\u200d\u0db8\u0dda\ufffd \u0d9a\u0dd2\u0dba\u0db1 \u0dbd\u0daf \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3 \u0d85\u0dad\u0dbb\u0dd2\u0db1\u0dca \u0db8\u0dd9\u02de\u0dc4\u0dd2 \u0db4\u0dc4\u0dad \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0db1 \u0d89\u0da9\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dd9\ufffd\u0dc4\u0dd2 \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dba \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba \u0dc0\u0dd9\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0dd9\u0db1\u0dca \u0dad\u0dc0\u0db8 \u0db7\u0dcf\u0dcf\u0dbb \u0d9c\u0dd9\ufffd\u0db1 \u0db1\u0dd0\u0dd0\u0dad. \u0d91\u0db6\u0dd0\u0dd0\u0dc0\u0dd2\u0db1\u0dca, \u0d9a\u0dd8\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8, \u0db4\u0dc1\u0dd4 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca, \u0d89\u0da9\u0db8\u0dca \u0dc3\u0dc4 \u0dc0\u0dcf\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba, \u0d9a\u0dd4\u0dbb\u0d9c\u0db8\u0d9c\u0dda\u0118 \u0daf\u0ddc\ufffd\u0ddc\u0db1\u0dca \u0dbd\u0dcf\u0dcf\u0dbd\u0dca \u0d9a\u0dcf\u0dcf\u0db1\u0dca\u0dad \u0dc0\u0db1 \u0db8\u0db8 \u0d89\u0da9\u0db8\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8\u0dda\ufffd \u0db4\u0db1\u0dad\u0dda\u01ae 39 (1) \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda\u01ae \u0db8\u0dcf\u0dcf \u0dc4\u0da7 \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0d82\u0d82\u0d9a 1887/41 \u0dc4\u0dcf\u0dcf 2014.11.07 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0daf\u0dbb\u0db1 \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u200d\u0dd9\u0dd9\u02e4\u0dd9\u0dc2 \u0d9c\u0dd0\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0db4\u0dc5\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca 2014 \u0d85\u0d82\u0d82\u0d9a 308 \u0dc4\u0dcf\u0dcf 2014.10.31 \u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1 \u0daf\u0dbb\u0db1 \u0d86\u0da5\u0dcf\u0dcf\u0dc0\u0da7 \u0d85\u0dba\u0dad\u0dca \u0db4\u0dc4\u0dad \u0d8b\u0db4\u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dba\u0dda\u024f \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d89\u0da9\u0db8\u0dca \u0d9a\u0dd0\u0dd0\u0db6\u0dd0\u0dd0\u0dbd\u0dca\u0dbd \u0db4\u0db8\u0dab\u0d9a\u0dca \u0db8\u0dd9\u02de\u0db8 \u0db1\u0dd2\u0dba\u0db8\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0dad\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0daf\u0dd2\u0dc2\u0dca\u0da8 \u0d9a\u0dbb\u0db8\u0dd2.",
