    ],
    "text": "\u0b87\u0bb2\u0b99\u0bcd\u0bcd\u0b95\u0b95\u0bc8\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0baf\u0b95 \u0b9a\ufffd\u0bcb\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bb0\u0b9a\u0bbf\u0bbf\u0ba9\u0bcd 1980.04.18 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0ba4\u0bbf\u0baf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 84/ 7 \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0bcd\u0b9f \u0b85\u0ba4\u0bbf\u0ba4\u0bbf\u0bb5\u0bbf\u0bbf\u0b9a\u0bc7\u0b9f\u0b9f \u0bb5\u0bbe\u0bcd\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0bae\u0bbe\u0ba9\u0bbf\u0bbf \u0b85\u0bb1\u0bbf\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0bb2\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bae\u0bc8\u0bb5\u0bbe\u0b95, \u0ba8\u0b95\u0bb0 \u0b85\u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0b9a\u0baa\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a\u0bae\u0bbe\u0b95 \u0baa\u0bbf\u0bbf\u0bb0\u0b95\u0b9f\u0b9f\u0ba9\u0baa\u0bcd\u0bcd\u0baa\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0baf \u0bae\ufffd\u0bca\u0ba9\u0bb0\u0bbe\u0b95\u0bb2\u0bc8 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0bcd\u0b9f\u0bae\u0bcd, \u0baa\u0bbf\u0bbf\u0baa\u0bbf\u0bbf\u0bb2 \u0ba8\u0b95\u0bb0 \u0b85\u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bcd \u0b92\u0bb0\u0bc1\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0ba4\u0bbf\u0baf\u0bbe\u0b95 \u0b85\u0bae\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 102 D \u0b85\u0bae\u0bcd\u0bcd\u0baa\u0baa\u0b95\ufffd\u0bca\u0bb3\u0bcd\u0bcd\u0bb3 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 102 A \u0bb0\u0ba4\u0ba4\u0bb2\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4, \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 100B \u0bb0\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0baa\u0bb8\u0bcd\u0bcd\u0b95\u0b95\u0bc6\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 101C \u0bb2\u0bbf\u0ba8\u0bcd\u0bcd\u0ba4\u0b95\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0bb0 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 100 \u0baa\u0bbf\u0bbf\u0baa\u0bbf\u0bbf\u0bb2 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 100 C \u0b85\u0bae\u0bcd\u0bcd\u0baa\u0baa\u0bc7\u0bb2\u0ba8\u0bcd\u0bcd\u0ba4 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 99 \u0ba4\ufffd\u0bca\u0b9f\u0bae\u0bcd\u0b95\u0bca\u0bb3\u0bcd\u0bcd\u0bb3 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 99B \u0ba4\u0bc6\u0bb9\u0bbf\u0bbf\u0b85\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbe\u0bb5\u0bc6\u0bb2 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 99 A \u0b95\u0ba3\u0bc1\u0bb2\u0bcd\u0bcd\u0bb5\u0bb5\u0bc6\u0bb2 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 100 A \u0b95\u0bc1\u0bb1\u0bc1\u0bb5\u0bbe\u0bae\u0bcd\u0bcd\u0baa\u0baa \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 100 E \u0bb9\u0bc7\u0bb5\u0bc6\u0bb2\u0bcd\u0bcd\u0bb5\u0bb5\u0bc6\u0bb2 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc7\u0bb2\u0bbe\u0b95 \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 102 D \u0b85\u0bae\u0bcd\u0bcd\u0baa\u0baa\u0b95\ufffd\u0bca\u0bb3\u0bcd\u0bcd\u0bb3 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0ba4\u0bbf, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 102 A \u0bb0\u0ba8\u0bcd\u0bcd\u0ba4\u0bb2\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0ba4\u0bbf, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 102B \u0bb0\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0baa\u0bb8\u0bcd\u0bcd\u0b95\u0b95\u0bc6\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0ba4\u0bbf, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 101C \u0bb2\u0bbf\u0ba8\u0bcd\u0bcd\u0ba4\u0b95\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0bb0 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0ba4\u0bbf, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 100 \u0baa\u0bbf\u0bbf\u0baa\u0bbf\u0bbf\u0bb2 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0ba4\u0bbf, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 100C \u0b85\u0bae\u0bcd\u0bcd\u0baa\u0baa\u0bc7\u0bb2\u0ba8\u0bcd\u0bcd\u0ba4 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0ba4\u0bbf, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 99 \u0ba4\ufffd\u0bca\u0b9f\u0bae\u0bcd\u0b95\u0bca\u0bb3\u0bcd\u0bcd\u0bb3 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0ba4\u0bbf, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 99B \u0ba4\u0bc6\u0bb9\u0bbf\u0bbf\u0b85\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbe\u0bb5\u0bc6\u0bb2 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0ba4\u0bbf, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 99A \u0b95\u0ba3\u0bc1\u0bb2\u0bcd\u0bcd\u0bb2\u0bb5\u0bc6\u0bb2 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0ba4\u0bbf,\u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 100 A \u0b95\u0bc1\u0bb1\u0bc1\u0bb5\u0bbe\u0bae\u0bcd\u0bcd\u0baa\u0baa \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0ba4\u0bbf, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 100 E \u0bb9\u0bc7\u0bb5\u0bc6\u0bb2\u0bcd\u0bcd\u0bb5\u0bb5\u0bc6\u0bb2 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b8e\u0b9e\u0bcd\u0bcd\u0b9a\u0b9a\u0bbf\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0ba4\u0bbf, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 98 A \u0b88\u0ba4\u0ba4\u0ba9\u0bb5\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bc8 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 100 D \u0b95\u0bb5\u0bcd\u0bcd\u0b9f\u0b9f\u0bc6\u0bb2\u0bcd\u0bcd\u0bb2\u0bb2 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 100F \u0baa\u0ba4\u0bc1\u0bb3\u0bcd\u0bcd\u0bb3\u0b95\u0bae\u0bcd\u0bcd\u0bae\u0bae\u0ba9 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 102 \u0bb5\u0bc7\u0b95\u0bae \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1. \u0b87\u0bb2\u0b95\u0bcd\u0bcd\u0b95\u0bae\u0bcd 102 C \u0bb5\u0bc7\u0b95\u0bae \u0ba4\u0bc6\u0bb1\u0bcd\u0b95\u0bc1 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1, \u0b86\u0b95\u0bbf\u0bbf\u0baf \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bbe\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1\u0b95\u0bb3\u0bc8\u0b95\u0bcd \u0b95\ufffd\u0bca\u0ba3\u0bcd\u0bcd\u0b9f \u0bae\u0bc1\u0bb4\u0bc1 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a\u0ba4\u0bcd\u0ba4\u0bcd\u0bcd\u0ba4\u0ba4\u0bbf\u0ba9\u0bc8 \u0b89\u0bb3\u0bcd\u0bcd\u0bb3\u0b9f\u0b9f\u0b95\u0bcd\u0bcd\u0b95\u0b95\u0bbf\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0ba4\u0bbf\u0baf\u0bbe\u0b95\u0bc1\u0bae\u0bcd.",
