 \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014- (\u0dba \u0d9a\u0dca\u0d9a\u0dba\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1 : 4 . 947 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0dca\u0dad\u0dba\u0dc3\u0dda\u0dbd\u0dcf\u0dba\u0dda \u0da0\u0db8\u0dd2\u0dbd\u0dcf 197 61 2 59 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dc3\u0dd6\u0db4\u0db4\u0d9a\u0dcf\u0dbb \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dd3\u0dba \u0dba \u0dbb\u0dca\u0dc2\u0db1\u0dd2 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0- 57, \u0db8\u0dd3\u0dba \u0d9c\u0db8\u0dd4 \u0db4\u0dcf\u0dbb, \u0d9a\u0da7\u0dd4\u0db4\u0dba\u0dda\u0dba\u0d9c\u0daf\u0dbb, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0dba\u0dc0\u0dcf \u0dcf\u0db6\u0dcf \u0dba \u0dda\u0db1\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0d87\u0dad\u0dd2 \u0d9a\u0d82\u0d9a 6 -2 24/ 6/2 \u0daf\u0dbb\u0dab \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dda\u0dc0 1 : 5 . 4 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0dca\u0dad\u0dba\u0dc3\u0dda\u0dbd\u0dcf\u0dba\u0dda \u0da0\u0db8\u0dd2\u0dbd\u0dcf 197 61 2 59 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dc3\u0dd6\u0db4\u0db4\u0d9a\u0dcf\u0dbb \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dd3\u0dba \u0dba \u0dbb\u0dca\u0dc2\u0db1\u0dd2 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0- 57, \u0db8\u0dd3\u0dba \u0d9c\u0db8\u0dd4 \u0db4\u0dcf\u0dbb, \u0d9a\u0da7\u0dd4\u0db4\u0dba\u0dda\u0dba\u0d9c\u0daf\u0dbb, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0dba\u0dc0\u0dcf \u0dcf\u0db6\u0dcf \u0dba \u0dda\u0db1\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0d87\u0dad\u0dd2 \u0d9a\u0d82\u0d9a 6 -2 24/ 6/2 \u0daf\u0dbb\u0dab \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dda\u0dc0 1 : 6 . 9 4 \u0dad\u0dd2\u0db6\u0dca\u0db6\u0da7\u0dd4\u0db8\u0dd4\u0dab\u0dd4\u0dba\u0dda \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0dba\u0dda \u0dc3\u0dbb\u0dda 6324 2 24V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0d9a\u0da7\u0dd4\u0db4\u0dba\u0dda \u0dba\u0d9c\u0daf\u0dbb, \u0dba \u0dda\u0db1\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd 1 : 1 . 354 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dbd\u0dcf\u0dba\u0dda \u0da0\u0dcf\u0db8\u0dbb \u0daf\u0dd2\u0db1\u0dd4\u0dc2 732713532V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dc3\u0dd6\u0db4\u0db4\u0d9a\u0dcf\u0dbb \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dd3\u0dba \u0dba \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0- 57, \u0db8\u0dd3\u0dba \u0d9c\u0db8\u0dd4 \u0db4\u0dcf\u0dbb, \u0d9a\u0d82\u0d9a 372, \u0dba\u0db6\u0ddd\u0d9c\u0db8\u0dd4\u0dbd \u0dc0\u0dda\u0dcf, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0dba\u0dc0\u0dcf \u0dcf\u0db6\u0dcf \u0dba \u0dda\u0db1\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0d87\u0dad\u0dd2 \u0d9a\u0d82\u0d9a 1513-2 19/ 5/15 \u0daf\u0dbb\u0dab \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dda\u0dc0 1 : 77 . 67 \u0dbb\u0da2\u0dcf\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba 1 : 92 . 15 \u0db4\u0dd4\u0dca\u0db0\u0d9c\u0dbd\u0dd2\u0d9a \u0db1\u0dd0\u0dcf \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a.79, 9 \u0dcf 91 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dba\u0ddd\u0da2\u0dcf\u0db1\u0dba \u0dc3\u0db3 \u0dcf \u0d87\u0dad\u0dd2 \u0dc5\u0dd2\u0db3 1 : 1 4 .176 \u0dc0\u0dbd\u0dca\u0dba\u0daf\u0db1\u0dd2 \u0daf\u0dd4\u0dbb\u0dba\u0dbd\u0dcf\u0dba\u0dda \u0da2\u0dcf\u0dba\u0dbd\u0dda 19 3251 256 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba 432, \u0dba \u0dda\u0db1\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd 1 : 1 5 . 5 \u0dc0\u0dbb\u0dd4\u0dc3\u0dc0\u0dd2\u0dcf\u0dcf\u0dbb\u0dab \u0daf\u0dba\u0dcf\u0dbb\u0dda\u0db1 1961 22 2667 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba 424/3, \u0dba \u0dda\u0db1\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd 1 : 13 . 441 \u0db8 \u0dba \u0da7\u0dca\u0da7\u0dd2 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0dba\u0dda \u0db6\u0dd4\u0dca\u0db0\u0db0\u0dd2\u0d9a \u0db1\u0dd2\u0db8\u0dbd\u0dca 197129 4329 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dba \u0da7\u0dca\u0da7\u0dd2\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0d87\u0dcf\u0dcf\u0dc0\u0dd0\u0da7\u0dd4\u0db1\u0db4\u0dd2\u0da7\u0dd2\u0dba, \u0dba \u0dda\u0db1\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd 1 : 131 . 169 \u0dbb\u0dda\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0dca\u0dad\u0dba\u0dc3\u0dda\u0dbd\u0dcf\u0dba\u0dda \u0db1\u0dd2\u0dbd\u0dca\u0dad\u0dad\u0dd2 19 2572 399 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2 \u0dbb\u0dda\u0db1\u0dcf\u0dba\u0d9a \u0d9a\u0d82\u0d9a 419/2, \u0d87\u0dcf\u0dcf\u0dc0\u0dd0\u0da7\u0dd4\u0db1\u0db4\u0dd2\u0da7\u0dd2\u0dba, \u0dba \u0dda\u0db1\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd 1 : 135 . 914 \u0dba \u0dda\u0dbb\u0dda \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0dca\u0dad\u0dba\u0dc3\u0dda\u0dbd\u0dcf\u0dba\u0dda \u0da0\u0dca\u0dad\u0daf\u0db1 1971326 1596 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a 13 \u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dca\u0dad\u0dcf \u0dba \u0dda\u0dbb\u0dda \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dba\u0dcf\u0dcf\u0dc0 4 2, \u0dcf\u0dad\u0dd2\u0d9c\u0db8\u0dca\u0db8\u0db1, \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0db1\u0dd2\u0d9a\u0dc0\u0dd0\u0dbb\u0da7\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0dba\u0d9a\u0ddc\u0db8\u0dbb\u0dca\u0dc2\u0dbd\u0dca \u0db6\u0dd1\u0dca\u0dad\u0d9a\u0dca\u0d9a\u0dba \u0d94\u0dc6\u0dca \u0dc3\u0dd2\u0daf\u0dba\u0dbd\u0ddc\u0dca\u0dad - \u0db1\u0dd2\u0d9a\u0dc0\u0dd0\u0dbb\u0da7\u0dd2\u0dba \u0dba\u0dcf\u0d9b\u0dcf\u0dc0 \u0dba\u0dc0\u0dcf \u0dcf\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d9a\u0d82\u0d9a 12311-2 1 / 1/ 6 \u0daf\u0dbb\u0dab \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dda\u0dc0",
