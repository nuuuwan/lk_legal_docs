    "text": "\u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0db1\u0db8\u0da7 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d91\u0d9a\u0dd3 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0dc0\u0dd9\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba. \u0dad\u0dc0 \u0daf, \u0db8\u0dd9\ufffd\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dd8\u0dd8\u0dad\u0dd2\u0dba\u0dda\u0dda\u024f \u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0dad\u0dba \u0d8b\u0daf\u0dd9\u0dd9\u0dc3\u0dcf\u0dcf \u0dc3\u0dd2\u0daf\u0dd4\u0d9a\u0dbb\u0db1 \u0db7\u0dcf\u0dcf\u0dab\u0dca\u0da9 \u0d86\u0db1\u0dba\u0db1\u0dba\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0dd2\u0dc1\u0dda\u0dda\u02e4\u0dda\u0dc2 \u0dc0\u0dd9\u0dd9\u0dc5\u0db3 \u0db7\u0dcf\u0dcf\u0dab\u0dca\u0da9 \u0db6\u0daf\u0dca\u0daf \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0db1\u0dd2\u0dbb\u0dca\u0daf\u0dda\u0dda\u0dda\u0dc1 \u0dbd\u0dd2\u0db4\u0dd2\u0dba\u0d9a\u0dca \u0d86\u0db4\u0daf\u0dcf\u0dcf \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0dcf\u0d9a\u0dbb\u0dab \u0db8\u0db0\u0dca\u200d\u0dba\u0dba\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dbb\u0dda\u0dda\u0d9c\u0dd4 \u0d85\u0db0\u0dca\u200d\u0dba\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba.",
