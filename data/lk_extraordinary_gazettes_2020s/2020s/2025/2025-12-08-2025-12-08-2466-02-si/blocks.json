    "text": "\u0d8b\u0db4\u0dbd\u0dda\u0dda\u0262\u0d9b\u0db1\u0dba \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0d85. \u0dad\u0dd0\u0dd0\u0db1\u0dd0\u0dd0\u0dad\u0dca\u0dad\u0db1\u0dca \u0dbd\u0dd0\u0dd0\u0db6\u0dd3 \u0db1\u0ddc\ufffd\u0ddc\u0db8\u0dd0\u0dd0\u0dad \u0d86. \u0d85\u0dc3\u0dca\u0dae\u0dd2\u0dad\u0dca\u0dc0 \u0dc3\u0dc4 \u0dc0\u0dd9\u0dd9\u0db1\u0dad\u0dca \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dba\u0db8\u0dca \u0dbd\u0dd0\u0dd0\u0db6\u0dd3 \u0db1\u0ddc\ufffd\u0ddc\u0db8\u0dd0\u0dd0\u0dad \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca",
