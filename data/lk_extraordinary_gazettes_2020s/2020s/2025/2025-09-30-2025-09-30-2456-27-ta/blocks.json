    ],
    "text": "\u0b95\u0bb3\u0bbf\u0baf\u0bbe\u0b9f\u0bcd\u0b9f \u0bb5\u0bbe\u0bbf (267 \u0b86\u0bb5\u1f90 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0bae\u0bbe\u0ba9) \u0b95\u0bb3\u0bbf\u0baf\u0bbe\u0b9f\u0bcd\u0b9f \u0bb5\u0bbe\u0bbf \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bbe\u0bb5\u1f90 \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd (1) \u0b86\u0bb5\u1f90 \u0b89\u0baa \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u1f9a\u0bb2\u0bae\u0bcd \u0bc6\u0baa\u0bbe\u1fa0\u0baa\u0bcd\u0baa\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0bbe\u0bb0\u0bae\u0bcd \u0b95\u0bbe\u1fa2 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3 \u0b85\u0bae\u0bcd\u0baa\u0bb2\u0bbe\u0b99\u0bcd\u0bc6\u0b95\u0bbe\u0bc8\u0b9f \u0ba8\u0b95\u0bb0 \u0b9a\u0bc8\u0baa\u0baf\u0bbf\u0bb2\u0bcd 2025, \u1f9d\u0bc8\u0bb2 \u0bae\u0bbe\u0ba4\u0bae\u0bcd 01 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0ba8\u0bc8\u0b9f\u0bc6\u0baa\u0bb1\u0bcd\u0bb1 \u0b9a\u0bc8\u0baa\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd 05.01.01.01 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0ba4\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0bae\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u1f9e\u0bae\u0bcd \u1f99\u0ba9\u0bcd\u0bc6\u0bae\u0bbe\u0bb4\u0bbf\u0bc8\u0bb5 1989 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8a\u0ba9\u0bcd 12 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0bae\u0bbe\u0b95\u0bbe\u0ba3 \u0b9a\u0bc8\u0baa\u0b95\u0bb3\u0bcd (\u0bc6\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u1f97\u0bc8\u0b9f\u0baf \u0b8f\u0bb1\u0bcd\u0baa\u0bbe\u1f8c\u0b95\u0bb3\u0bcd) \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bbe\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd (1) \u0b86\u0bb5\u1f90 \u0b89\u0baa \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd (\u0b85) \u0baa\u0ba8\u0bcd\u0ba4\u0bbf\u1f9c\u0b9f\u0ba9\u0bcd \u0bc7\u0b9a\u0bb0\u0bcd\u0ba4\u0bcd\u1f90 \u0bb5\u0bbe\u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f \u0bc7\u0bb5\u0ba3\u0bcd\u1f8a\u0baf \u0b95\u0bb3\u0bbf\u0baf\u0bbe\u0b9f\u0bcd\u0b9f \u0bb5\u0bbe\u0bbf \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bbe\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd (2) \u0b86\u0bb5\u1f90 \u0b89\u0baa \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u1f9a\u0bb2\u0bae\u0bcd \u0bc6\u0baa\u0bbe\u1fa0\u0baa\u0bcd\u0baa\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bb0\u0b95\u0bbe\u0bb0\u0bae\u0bcd \u0bc6\u0ba4\u0ba9\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3 \u0b86\u1fa6\u0ba8\u0bb0\u0bbe\u0ba9 \u0bae\u0ba4\u0bcd\u1f90\u0bae \u0b95\u0b99\u0bcd\u0b95\u0bbe\u0ba9\u0bae\u0bb2\u0bbe\u0bc7\u0b95 \u0baa\u0ba8\u0bcd\u1f90\u0bb2 \u0bb9\u0bbe\u0bbf\u0bb8\u0bcd\u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0 \u0b86\u0b95\u0bbf\u0baf \u0ba8\u0bbe\u0ba9\u0bcd \u0b85\u1f94\u0bae\u0ba4\u0bbf \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bc1\u0b95\u0bbf\u0bc7\u0bb1\u0ba9\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0bc8\u0ba4 \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0ba4\u0baf\u0bb5\u0bbe\u0b95 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd\u0bc7\u0bb1\u0ba9\u0bcd.",
