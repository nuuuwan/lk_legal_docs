    "text": "\u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u01b1\u0dc5 \u01b1\u023c\u0dd9\u0db6\u02a4\u026a\u0dbd \u0db1\u0db8\u0dd0\u01af \u0d9c\u0dd9\u023c \u0218\u028f\u0179\u0dba\u0dcf \u026d \u0daf, \u0d85\u0d82\u0d9a 521203 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0dd9\u023c \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 01 \u028f \u0db4\u01b4 \u0d85\u0d82\u0d9a 01 \u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 332 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3 \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0d91\u028f \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u0dba\u028f; \u201c\u0d85\u0250\u01af\u0d9a\u025e\u0dd9\u0118/\u0d85\u0250\u01af\u0d9a\u025e\u0dc0\u01e6\u0dd9\u0118 \u0dc3\u023c\u021b\u0259\u0dab \u0db1\u0db8/\u0db1\u023c \u0dc3\u0dc4 \u0263\u0218\u0db1\u0dba\u201d,\u0da2\u0dcf\u01af\u0d9a \u0dc4\u0dd0\u01ff\u01e9\u023c\u0db4\u01ae \u0d85\u0d82\u0d9a\u0dba \u0dba\u0db1 \u01b0\u025e\u0dc0\u0dbd \u0dc3\u0db3\u0dc4\u01e6 \u021a\u01ca\u0d9c\u0263\u0d9a \u0dba\u01e6\u0db1 \u0d89\u0dc0\u01ae \u0d9a\u0dbb, \u0db8\u0262\u0dc0\u0dbd\u0dd9\u0118 \u0db8\u0262\u0263\u0d9a\u0dcf \u0dd9\u0dc3\u0dd9\u0db1\u026a\u0dbb\u01ae\u0db1 676020837v \u0dba\u01e6\u0db1 \u0d87\u01b1\u0dbd\u01ae \u0d9a\u0dbb \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229. \u0dd9\u0db1\u02a3.113/3, \u0dc4\u023f\u0daf\u0dcf \u01e7\u0dc0\u0dcf\u0dc3 \u0db4\u0dcf\u0dbb, \u01b1\u023c\u0dd9\u0db6\u02a4\u026a\u0dbd, \u0218\u0298\u0dba\u01e6\u0daf\u0dbd \u0219. \u0287. \u018c. \u0286\u0dd9\u0118\u0dbb\u0dcf, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0262 2025 \u0d94\u00fa\u0dd9\u0dad\u02a4\u0db6\u0259 \u0db8\u0dc3 08 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd \u0dbb\u0da2\u0db8\u0262\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0db