    "text": "\u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0dba\u02a3\u023f \u0d85\u0d82\u0d9a\u0dba: DSM/WL/LND/4/3/8/8/27. \u0d89\u0da9\u023c \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\u0dc1\u0dd9\u024f \u0d85\u0d82\u0d9a\u0dba: 03J/91/IR/176. \u0d89\u0da9\u023c \u0d85\u01ae\u0d9a\u0dbb \u0d9c\u0dd0\u01e8\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 7 \u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u0d85\u0d82\u0d9a 1643/18 \u0dc4\u0dcf 2010.03.02 \u01ce\u0db1\u0dd0\u01af \u027c \u0dbd\u0d82\u0d9a\u0dcf \u021d\u0da2\u0dcf\u0dad\u0dcf\u01e6\u01b5\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u01cf \u0da2\u0db1\u0dbb\u0da2\u0dd9\u024f \u0d85\u01af \u026a\u0dd9\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0db4\u0dc5 \u026d \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262\u0dd9\u0118 \u0d85\u0dc0\u0dc3\u0dcf\u0db1 \u0d9c\u023c \u0218\u0249\u025e \u0d85\u0d82\u0d9a \u0dd9\u0da7\u02a4\u0dd9\u0db4\u02a4 \u0219.\u0219. 13, \u0d85\u01af\u0dd9\u0259\u0d9a \u0d85\u0d82\u0d9a 48, \u0db4\u01b4 \u0d85\u0d82\u0d9a 148 \u0dc4\u0dcf 2009.02.27 \u01ce\u0db1\u0dd0\u01af \u0218\u0249\u0dd9\u0259 \u0dc3\u0db3\u0dc4\u01e6 3194, 3197, 3198, 3200, 3202, 3203, 3204, 3205, 3207, 3210, 3211, 3214, 3215, 3216 \u0dba\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u028f\u023d\u0d9a\u023c \u0db4\u025d\u00fa\u0dc2\u0dab \u01ce\u0db1\u0dba 2025.06.04 \u0dd9\u0dbd\u0dc3 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1\u0dba \u026a\u0dba \u0252\u01b1 \u0db6\u0dc0 \u0dd9\u0db8\u0250\u01e6 \u01e7\u0dd9\u0269\u0daf\u0db1\u0dba \u0d9a\u0dbb\u01e9 \u0dbd\u0dd0\u0dd9\u0229. \u0d91\u013c. \u0d91\u023c. \u0d85\u0250. \u0286\u025c\u0dc0\u0259\u0db0\u0db1, \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c, \u026a\u0262\u0d9c\u023f\u0dc0. 2025 \u0db8\u0dd0\u0250 \u0db8\u0dc3 05 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u026a\u0262\u0d9c\u023f\u0dc0 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u