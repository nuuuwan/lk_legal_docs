    "text": "\u0bc6\u0b95\u0bbe\u0b95\u0bcd\u0bc7\u0b95\u0bbe , \u0b8f\u0bb2\u0b95\u0bcd\u0b95\u0bbe\u0baf\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0bae\u0bbf\u0bb3\u0b95\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0ba9 \u0bb5\u0bb3\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf \u0bc6\u0b9a\u0baf\u0bcd\u0ba4\u0bb2\u0bcd \u0bc6\u0ba4\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0bc7\u0bb5\u0bc8\u0bb2\u0baf\u0bbe\u0b9f\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc7\u0bb5\u0ba3\u0bcd\u1f8a\u0baf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0baa\u1f8a\u0b95\u0bb3\u0bcd 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8c \u0b9a\u0ba9\u0bb5\u0bbe\u0bbf \u0bae\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc2\u0bb1\u0bbf\u0baf \u0bc6\u0ba4\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd\u0b95\u1fa6\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0bb5\u0bbe\u0bb4\u0bcd\u0b95\u0bcd\u0bc8\u0b95\u0baa\u0bcd \u0baa\u1f8a\u0b9a\u0bcd \u0b9a\u0bc1\u0b9f\u0bcd\u0bc6\u0b9f\u0ba3\u0bcd 212.2 \u0b86\u0b95 \u0b87\u1f9e\u0baa\u0bcd\u0baa\u0ba4\u0bbe\u0bb2\u0bcd 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u1f8c \u0bc6\u0baa\u0baa\u0bcd\u1f97\u1f9e\u0bb5\u0bbe\u0bbf \u0bae\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b9a\u0bbe\u0ba4\u0bbe\u0bb0\u0ba3 \u0bc7\u0bb5\u0bc8\u0bb2 \u0ba8\u0bc6\u0bb3\u0bbe\u0ba9\u0bcd\u1fa0 \u0bc6\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0b95\u0b9a\u0bcd \u0bc6\u0b9a\u1fa4\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f \u0bc7\u0bb5\u0ba3\u0bcd\u1f8a\u0baf \u0bb5\u0bbf\u0bc7\u0b9a\u0b9f \u0baa\u1f8a \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u1f9e\u0bae\u0bbe\u0bb1\u0bbe\u0b95\u0bc1\u0bae\u0bcd \u0b8e\u0ba9 (136 \u0b86\u0bae\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbe\u0baf\u0bae\u0bbe\u0b95\u0bbf\u0baf) \u0b9a\u0bae\u0bcd\u0baa\u0bb3\u0b9a\u0bcd \u0b9a\u0bc8\u0baa\u0b95\u0bb3\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc8\u0bb3\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd 20(2) (\u0b86) \u0b86\u0bae\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u1f8c\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u1f90.",
