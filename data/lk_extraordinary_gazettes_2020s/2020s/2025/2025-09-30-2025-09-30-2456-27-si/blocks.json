  {
    "page_number": 1,
    "bbox": [
      47.87,
      134.36,
      542.37,
      235.71
    ],
    "text": "267 \u0dc0\u0db1 \u0d85\u01dd\u0d9a\u0dcf\u0dbb\u0dba \u0dc0\u0db1 \u026a\u0dd9\u0db1\u02a4\u0daf \u0db6\u01d0 \u0d86\u0da5\u0dcf \u0db4\u0db1\u0dd9\u01ae \u0dd9\u0daf\u0dc0\u0db1 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u024f (1) \u0dc0\u0db1 \u0d8b\u0db4 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u0dba\u01e6 \u0db4\u0dd0\u0dc0\u025d \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u021d\u0d9a\u0dcf\u0dbb\u0dc0 \u0d85\u023c\u0db6\u0dbd\u01e6\u0dd9\u0d9c\u02a3\u0da9 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0, \u0dc3\u0db7\u0dcf\u0dd9\u0269 \u0db4\u025c\u0db4\u0dcf\u0dbd\u0db1 \u0287\u0db8\u0dcf \u0d87\u01b1\u0dc5\u0dad \u026d \u021d\u0dd9\u01ca\u0dc1\u0dd9\u0dba\u028f \u0db4\u0dc0\u01ae\u0dc0\u01e9 \u0dbd\u0db6\u0db1 \u0d91\u00fc \u0d86\u0da5\u0dcf \u0db4\u0db1\u0dd9\u01ae \u026a\u0dc3\u0dca\u0dad\u0dbb \u0d9a\u0dbb \u0d87\u01af \u0dba\u023c \u0dba\u023c \u026a\u0dd9\u0db1\u02a4\u0daf \u0d9a\u0da7\u0252\u01ae\u0dad\u0d9a\u0da7 \u0d9a\u0dbb\u01e9 \u0dbd\u0db6\u0db1 \u0dd9\u0d9c\u026b\u0db8\u00fb\u01e6, \u0286\u0db1\u0db8\u0dcf \u0dc1\u0dcf\u0dbd\u0dcf \u0dc3\u0db3\u0dc4\u0dcf 10% \u00fa \u0daf, \u0d85\u0dd9\u0db1\u00fd\u01ae \u0286\u0dba\u0265\u0db8 \u026a\u0dd9\u0db1\u02a4\u0daf \u0d9a\u0da7\u0252\u01b1 \u0dc3\u0db3\u0dc4\u0dcf \u021d\u0dd9\u0269\u0dc1 \u0db4\u01b4 \u0dc0\u0179\u0db1\u0dcf\u0d9a\u023d\u01e6 12.5% \u0d9a\u0da7 \u0dc3\u0db8\u0dcf\u0db1 \u023f\u0daf\u0dbd\u00fa \u0db6\u01ca\u0daf \u0dc0\u0dc1 \u0dd9\u0dba\u01e6 \u0db4\u0db1\u0dc0\u0dcf \u0d85\u0dba \u0d9a\u0dc5 \u0252\u01b1 \u0dba\u0dd0\u0250 \u0daf, \u0dd9\u0db8\u0db8 \u0dd9\u0dba\u02a4\u0da2\u0db1\u0dcf\u0dc0 2025.10.01 \u01ce\u0db1 \u0286\u0da7 \u0101\u0dba\u0dcf\u01ae\u0db8\u0d9a \u026a\u0dba \u0252\u01b1 \u0dba\u0dd0\u0250 \u0daf, \u0dd9\u0dba\u02a4\u0da2\u0db1\u0dcf \u0d9a\u0dbb\u01e6\u01e8\u0dba. \u0d91\u0dd9\u0dc3\u02a2\u0db8 \u0d89\u0dc4\u0dad \u0db4\u0db1\u0dc0\u0db1 \u0dbd\u0daf \u026a\u0dd9\u0db1\u02a4\u0daf \u0db6\u01ca\u0daf \u0d91\u00fc \u026a\u0dd9\u0db1\u02a4\u0daf \u0d9a\u0dcf\u0259\u0dba\u0dba \u0db4\u0dc0\u01ae\u0dc0\u0db1 \u01ce\u0db1\u0da7 \u0dd9\u0db4\u0dbb \u0d85\u0daf\u0dcf\u0dc5 \u0dc3\u0d82\u026a\u0db0\u0dcf\u0dba\u0d9a \u0dd9\u0dc4\u02a4 \u0dc3\u0d82\u026a\u0db0\u0dcf\u0dba\u0d9a\u0dc0\u025e\u01e6 \u026a\u0286\u01e6 \u01e7\u0286 \u0dd9\u0dbd\u0dc3 \u0d85\u023c\u0db6\u0dbd\u01e6\u0dd9\u0d9c\u02a3\u0da9 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0\u0da7 \u0dd9\u0d9c\u026a\u0dba \u0252\u01b1 \u0db6\u0dc0\u0da7\u01ae,\u00ab\u0d85\u023c\u0db6\u0dbd\u01e6\u0dd9\u0d9c\u02a3\u0da9 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u0dc0\u0dd0\u018b\u01d0\u0dbb\u0da7\u01ae \u0dd9\u0dba\u02a4\u0da2\u0db1\u0dcf \u0d9a\u0dbb\u01e6\u01e8\u0dba.",
