    "text": "\u0ba4\u0bc7\u0bc7\u0baf\u0bbf\u0bbf\u0bb2\u0bc8\u0bc8 \u0bb5\u0bb3\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0bc7\u0baf\u0bbf\u0bbf\u0bb2\u0bc8\u0bc8 \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba4\u0bcd \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0b9a\u0bae\u0bcd\u0baa\u0bb3\u0b9a\u0bcd \u0b9a\u0baa\u0bc8\u0bc8\u0ba4\u0bc7\u0bc7\u0baf\u0bbf\u0bbf\u0bb2\u0bc8\u0bc8 \u0bb5\u0bb3\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0bc7\u0baf\u0bbf\u0bbf\u0bb2\u0bc8\u0bc8 \u0b89\u0bb1\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba4\u0bcd \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0b9a\u0bae\u0bcd\u0baa\u0bb3\u0b9a\u0bcd \u0b9a\u0baa\u0bc8\u0bc8",
