    "text": "\u0daf\u00fd\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0dc4\u023c\u0db6\u01e6\u0dd9\u0dad\u02a3\u0da7 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u026b\u0dbb\u0d9a\u0dd0\u0179\u0dba \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0d85\u0d82\u0d9a 391, \u022c\u01ca\u01dd\u0dba\u0d9c\u0db8 \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u022c\u01ca\u01dd\u0dba\u0d9c\u0db8 \u011e\u0dcf\u0db8\u0dd9\u024f \u0218\u028f\u0179 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a \u201c\u0d92 \u201d \u0daf\u0dbb\u0db1, \u0dd9\u0d9a\u02a3\u01e6\u0d9c\u0dc4\u0dd9\u0dc4\u02a2\u0db1\u0dc0\u01ae\u0dad, \u021a\u0d82\u013d\u0dd9\u0d9c\u02a3\u0da9\u0dd0\u0262\u0dbd\u0dd9\u0dc4\u02a2\u0db1, \u0d9c\u0262\u0dd9\u0db4\u02a3\u01ae\u0dd9\u0dad\u0dd9\u0dc4\u02a2\u0db1, \u0218\u0d82\u0dd9\u0dc4\u02a2\u0db1 \u0d86\u01ce\u0dba \u0dd9\u0dc4\u0dc0\u01ae \u0dd9\u0d9a\u02a3\u01e6\u0daf\u0d9c\u0dbd \u0dbb\u0da2\u0db8\u0dc4\u0dcf \u026a\u0dc4\u0dcf\u0dbb\u0dba \u0218\u028f\u0179 \u0d89\u0da9\u0db8, \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a \u201c\u0287 \u201d \u0daf\u0dbb\u0db1 \u0db8\u0250\u0dbd\u0dd9\u0dc4\u02a2\u0db1 \u0dd9\u0d9a\u02a3\u01e6\u0daf\u0d9c\u0dbd \u0dbb\u0da2\u0db8\u0dc4\u0dcf \u026a\u0dc4\u0dcf\u0dbb\u0dba \u0218\u028f\u0179 \u0d89\u0da9\u0db8 \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a \u201c\u018c \u201d \u0daf\u0dbb\u0db1 \u0dd9\u0d9a\u02a3\u01e6\u0daf\u0d9c\u0dbd \u0240\u0d9a\u0dbd\u0dcf\u0db1 \u0dd9\u0dc4\u0dc0\u01ae \u0dd9\u0d9a\u02a3\u01e6\u0daf\u0d9c\u0dbd \u0dbb\u0da2\u0db8\u0dc4\u0dcf \u026a\u0dc4\u0dcf\u0dbb\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0218\u028f\u0179 \u0d89\u0da9\u0db8 \u0db1\u0db8\u0dd0\u01af \u0d89\u0da9\u023c \u0d9a\u0dd0\u0db6\u0263 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262\u0dd9\u0118 2023 \u0151\u01e7 \u0db8\u0dc3 28 \u01ce\u0db1\u0d