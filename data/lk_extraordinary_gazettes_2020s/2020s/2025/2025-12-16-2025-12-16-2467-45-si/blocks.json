u0dd2 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dba\u0dda \u0d9a\u0dbb\u0dd4\u0dab\u0dbb\u0dda\u0db1 \u0dba\u0db1 \u0d9a\u0dba\u0dba\u0dda \u0da2\u0dd3\u0dc0\u0dd2\u0dcf \u0db7\u0dd4\u0d9a\u0dca\u0d9a\u0dba\u0dad\u0dd2\u0dba\u0da7 \u0dba\u0da7\u0dda\u0dbd 1 : 98 000059 \u0db4\u0dd4\u0dca\u0db0\u0d9c\u0dbd\u0dd2\u0d9a \u0db1\u0dd0\u0dcf \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba _ \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a 99, 100 \u0dc1\u0dcf 97 \u0da7 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0dbe \u0dc0\u0dd3\u0db8 \u0dc0\u0db3\u0dc1\u0dcf 1 : 99 000260 \u0dc3\u0dd6\u0dbb\u0dd2\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0d82\u0d9a\u0dcf\u0db1\u0db8\u0dbc\u0dcf\u0dba\u0dda \u0d9a\u0db4\u0dd2\u0dbc 196911501921 \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a 94 \u0dc3\u0dd4\u0dba\u0dca\u0db0\u0dc0\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dca \u0dc3\u0dd6\u0dbb\u0dd2\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0dc1\u0dcf 98 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9a\u0d82\u0d9a 44556, \u0db4\u0dbb\u0dbd\u0dbe\u0dcf\u0dcf \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0db1\u0dd2\u0dd9\u0dc1\u0dc0\u0dca\u0d9c\u0db8 \u0db8\u0dcf\u0dbd\u0dcf, \u0dba\u0d9c\u0ddd\u0db1\u0dba\u0dc1\u0dda\u0db1, \u0dc0\u0db8\u0d9f \u0d9a\u0da9\u0dbd\u0dcf 1 : 135 001681 \u0dba\u0dc0\u0ddd\u0dbc\u0d82\u0d9c \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbc\u0dcf\u0dba\u0dda \u0db1\u0dd4\u0dbd\u0dca\u0dad 198100300100 \u0dc0\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db4\u0dca\u0dad\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 134 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0da0\u0dca\u0dad\u0daf\u0dd2\u0d9a \u0db4\u0dbb\u0dbd\u0dbe\u0dcf\u0dcf \u0d9a\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0d9a\u0d82\u0d9a 44452 \u0d92, \u0dba\u0d9c\u0ddd\u0db1\u0dba\u0dc1\u0dda\u0db1,