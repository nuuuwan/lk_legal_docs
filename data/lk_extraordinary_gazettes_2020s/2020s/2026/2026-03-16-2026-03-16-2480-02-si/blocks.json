    "text": "\u0d85\u0db1\u0dd4 \u0d85\u0d82\u0d82\u0d9a\u0dba\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0dbb\u0ddd\ufffd\u0ddd\ufffd\u0daf \u0dbb\u0dae \u0db1\u0dd0\u0dd0\u0dc0\u0dad\u0dd4\u0db8\u0dca \u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0d9c\u0dcf\u0dcf\u0dbd\u0dca \u0d9a\u0dc5 \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0d8b\u0db4\u0dbb\u0dd2\u0db8 \u0dad\u0dca\u200d\u0dbb\u0dd3 \u0dbb\u0ddd\ufffd\u0ddd\ufffd\u0daf \u0dbb\u0dae \u0d9c\u0dab\u0db11\u0d9a\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da7102\u0d9a\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db6\u0dd0\u0d82\u0d82\ufffd\u0d9a\u0dd4\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da7053\u0d9a\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db4\u0dd0\u0dd0\u0dbb\u0dab\u0dd2 \u0dc0\u0dd9\u0dd9\u0dc5\u0db3 \u0dc3\u0d82\u0d82\u0d9a\u0dd3\u0dbb\u0dca\u0dab\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da7104\u0d9a\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db6\u0dc3\u0dca\u0db1\u0dd0\u0dd0\u0dc0\u0dad\u0dd4\u0db8\u0dca\u0db4\u0ddc\ufffd\u0ddc\u0dc5 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da7085\u0dad\u0ddc\ufffd\u0ddc\u0dbb\u0dba\u0da9\u0dd2\u0dba \u0dad\u0ddc\ufffd\u0ddc\u0da7\u0dd4\u0db4\u0ddc\ufffd\u0ddc\u0dc5 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da7 106\u0d9a\u0dd4\u0dbb\u0dd2\u0da4\u0dca\u0da4\u0db8\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db8\u0d82\u0d82\u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dba157\u0d9a\u0db1\u0dca\u0daf\u0d9a\u0dd4\u0dbd\u0dd2\u0dba \u0db8\u0dd4\u0db1\u0dda\ufffd \u0d9a\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbd\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db8\u0dcf\u0dcf\u0dc0 \u0d85\u0dc3\u0dc5158\u0db4\u0dbd\u0dca\u0dbd\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3\u0dbd\u0dca\u0dad\u0dd4\u0dbb\u0dda\u0dda \u0d85\u0d82\u0d82\u0d9a 01 \u0dad\u0dd0\u0dd0\u0db4\u0dd0\u0dd0\u0dbd\u0dca \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da7109\u0db4\u0dbd\u0dca\u0dbd\u0dd2\u0dc0\u0dcf\u0dcf\u0dc3\u0dbd\u0dca\u0dad\u0dd4\u0dbb\u0dda\u0dda \u0dad\u0d9a\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf \u0db8\u0dd4\u0dc3\u0dca\u0dbd\u0dd2\u0db8\u0dca \u0daf\u0dda\u0dda\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da70810\u0d9a\u0db1\u0dca\u0daf\u0d9a\u0dd4\u0da9\u0dcf\u0dcf\u0dc0 \u0d85\u0d82\u0d82\u0d9a 01 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0db4\u0dd2\u0dbb\u0dc0\u0dd4\u0db8\u0dca \u0dc4\u0dbd \u0d85\u0dc3\u0dc51011\u0d9a\u0db1\u0dca\u0daf\u0d9a\u0dd4\u0da9\u0dcf\u0dcf\u0dc0 \u0d85\u0d82\u0d82\u0d9a 02 \u0d9a\u0db1\u0dca\u0daf\u0d9a\u0dd4\u0da9\u0dcf\u0dcf\u0dc0 \u0db8\u0dd4\u0dc3\u0dca\u0dbd\u0dd2\u0db8\u0dca \u0db4\u0dcf\u0dcf\u0dc3\u0dd0\u0dd0\u0dbd\u0dca \u0db8\u0d82\u0d82\u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dba1012\u0db8\u0dd4\u0daf\u0dbd\u0db4\u0dca\u0db4\u0dcf\u0dcf\u0dbd\u0dd2\u0dba \u0d9a\u0dd2\u0dba\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0 \u0d85\u0dc3\u0dc51013\u0db4\u0dcf\u0dcf\u0dbd\u0d9a\u0dd4\u0da9\u0dcf\u0dcf\u0dc0 \u0d9c\u0ddc\ufffd\u0ddc\u0dc0\u0dd2\u0da2\u0db1 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0db8\u0db0\u0dca\u200d\u0dba\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba \u0d85\u0dc3\u0dc52014\u0dad\u0dbd\u0dc0\u0dd2\u0dbd \u0d85\u0d82\u0d82\u0d9a 01 \u0dad\u0dd0\u0dd0\u0db4\u0dd0\u0dd0\u0dbd\u0dca \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dcf\u0dbd\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da71015\u0dad\u0dbd\u0dc0\u0dd2\u0dbd \u0d85\u0d82\u0d82\u0d9a 02 \u0dbb\u0d82\u0d82\u0da2\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dcf\u0dcf\u0d9c\u0dda\u0dda\u0118 \u0d9a\u0da9\u0dba \u0d85\u0dc3\u0dc51016\u0d92\u0dad\u0dca\u0dad\u0dcf\u0dcf\u0dbd \u0d89\u0db1\u0dca\u0db0\u0db1 \u0db4\u0dd2\u0dbb\u0dc0\u0dd4\u0db8\u0dca \u0dc4\u0dbd \u0d85\u0dc3\u0dc51017\u0d85\u0dbd\u0d82\u0d82\u0d9a\u0dd4\u0da9\u0dcf\u0dcf\u0dc0 \u0dc4\u0db1\u0dca\u0daf\u0dd2\u0dba \u0db8\u0dd4\u0dc3\u0dca\u0dbd\u0dd2\u0db8\u0dca \u0db4\u0dbd\u0dca\u0dbd\u0dd2\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da70818\u0d9a\u0ddc\ufffd\u0ddc\u0dba\u0dd2\u0dba\u0dcf\u0dcf\u0dc0\u0dcf\u0dcf\u0da9\u0dd2\u0dba \u0dc4\u0db1\u0dca\u0daf\u0dd2\u0dba \u0daf\u0ddc\ufffd\u0ddc\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dad\u0dca\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da70819\u0db1\u0ddc\ufffd\u0ddc\u0dbb\u0da0\u0dca\u0da0\u0ddd\u02c7\u0ddd\ufffd\u0dbd \u0d85\u0d82\u0d82\u0d9a 01 \u0d89\u0dbd\u0db1\u0dca\u0dad\u0da9\u0dd2\u0dba \u0d9c\u0db8\u0dca\u0db8\u0dcf\u0dcf\u0db1\u0dba\u0da7 \u0dba\u0db1 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0d85\u0dc3\u0dc50820\u0db1\u0ddc\ufffd\u0ddc\u0dbb\u0da0\u0dca\u0da0\u0ddd\u02c7\u0ddd\ufffd\u0dbd \u0d85\u0d82\u0d82\u0d9a 02 \u0db1\u0ddc\ufffd\u0ddc\u0dbb\u0da0\u0dca\u0da0\u0ddd\u02c7\u0ddd\ufffd\u0dbd \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0db8\u0db0\u0dca\u200d\u0dba\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba \u0d85\u0dc3\u0dc50621\u0d89\u0dbd\u0db1\u0dca\u0dad\u0da9\u0dd2\u0dba \u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbd \u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dbd \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da70522\u0db4\u0dd6\u0dbd\u0da0\u0dca\u0da0\u0dda\u0dda\u0db1 \u0db8\u0d82\u0d82\u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dba\u0dd9\u0dca\u024f \u0db6\u0dc3\u0dca \u0db1\u0dd0\u0dd0\u0dc0\u0dad\u0dd4\u0db8\u0dca\u0db4\u0ddc\ufffd\u0ddc\u0dc5 \u0d85\u0dc3\u0dc51023\u0db4\u0db1\u0dba\u0da9\u0dd2\u0dba \u0db8\u0d82\u0d82\u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dba\u0dd9\u0dca\u024f \u0db6\u0dc3\u0dca \u0db1\u0dd0\u0dd0\u0dc0\u0dad\u0dd4\u0db8\u0dca\u0db4\u0ddc\ufffd\u0ddc\u0dc5 \u0d85\u0dc3\u0dc50824\u0db8\u0dcf\u0dcf\u0db8\u0dca\u0db4\u0dd4\u0dbb\u0dd2\u0dba \u0db8\u0d82\u0d82\u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dba\u0dd9\u0dca\u024f \u0d9a\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbd\u0dd2\u0d9a \u0daf\u0dda\u0dda\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da71525\u0daf\u0dc5\u0dd4\u0dc0 \u0dc3\u0dd2\u0d82\u0d82\u0dc4\u0dbd \u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dbd \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da71526\u0dc3\u0dda\ufffd\u0dda\u0dad\u0db4\u0ddc\ufffd\u0ddc\u0dc5 \u0db8\u0d82\u0d82\u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dba \u0d9a\u0dad\u0ddd\ufffd\u0ddd\ufffd\u0dbd\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db8\u0dcf\u0dcf\u0dc0 \u0d85\u0dc3\u0dc50527\u0d9a\u0dbb\u0db9 \u0d87\u0d9f\u0dbd\u0dd4\u0db8\u0dca \u0d9a\u0db8\u0dca\u0dc4\u0dbd \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da70528\u0d9a\u0dbb\u0db9 \u0d9c\u0dd4\u0dc0\u0db1\u0dca SLBC \u0dc1\u0dcf\u0dcf\u0d9b\u0dcf\u0dcf\u0dcf\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da70829\u0d9a\u0dbb\u0db9 \u0db8\u0d82\u0d82\u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dba \u0db4\u0dd4\u0dbd\u0dd4\u0daf\u0dd2\u0dc0\u0dba\u0dbd\u0dca \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8\u0dba\u0da7 \u0dba\u0db1 \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dda\u0dda\u024f \u0d86\u0dbb\u0db8\u0dca\u0db7\u0dba0630\u0d8b\u0dbd\u0dd4\u0d9a\u0dca\u0d9a\u0dcf\u0dcf\u0db4\u0dbd\u0dca\u0dbd\u0db8 \u0db8\u0dd4\u0dc3\u0dca\u0dbd\u0dd2\u0db8\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dbd \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da71331\u0d9a\u0da9\u0dba\u0dcf\u0dcf\u0db8\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da7 \u0db8\u0d82\u0d82\u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dba \u0db8\u0dd4\u0dc3\u0dca\u0dbd\u0dd2\u0db8\u0dca \u0daf\u0dda\u0dda\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da70932\u0d9a\u0ddc\ufffd\u0ddc\u0dad\u0dca\u0dad\u0db1\u0dca\u0dad\u0dd2\u0dc0\u0dca \u0db8\u0d82\u0d82\u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dba\u0dd9\u0dca\u024f \u0db1\u0dc3\u0dca\u0db8\u0dd2\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dcf\u0dcf\u0d9c\u0dda\u0dda\u0118 \u0d9a\u0da9\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da71133\u0db8\u0dd4\u0d9a\u0dca\u0d9a\u0dd4\u0dad\u0ddc\ufffd\u0ddc\u0da9\u0dd4\u0dc0\u0dcf\u0dcf\u0dc0 \u0db8\u0d82\u0d82\u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dba19",
