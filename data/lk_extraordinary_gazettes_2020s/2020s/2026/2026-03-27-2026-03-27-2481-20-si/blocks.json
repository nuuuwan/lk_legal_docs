    "text": "01. \u0d91\u0db1\u0dca. \u0db6\u0dd3. \u0d85\u0dba\u0dd2. \u0db1\u0dcf\u0dcf\u0db1\u0dcf\u0dcf\u0dba\u0d9a\u0dca\u0d9a\u0dcf\u0dcf\u0dbb \u0db8\u0dd2\u0dba (\u0dc1\u0dca\u200d\u0dbb\u0dd3.\u0dbd\u0d82\u0d82.\u0db4.\u0dc3\u0dda\ufffd\u0dda. - \u0dc0\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0db8\u0dd2\u0d9a \u0db1\u0dd2\u0dc5\u0db0\u0dcf\u0dcf\u0dbb\u0dd3)\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0da2\u0dba\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0db4\u0dd4\u0dbb \u0d9a\u0ddd\ufffd\u0ddd\ufffd\u0da7\u0dca\u0da7\u0dda\ufffd, \u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0db9, \u0d9a\u0da9\u0dd4\u0dc0\u0dd9\u0dd9\u0dbd, \u0d9a\u0ddc\ufffd\u0ddc\u0dc5\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0db1\u0dcf\u0dcf\u0dc0, \u0daf\u0dd9\u0dd9\u0dc4\u0dd2\u0dc0\u0dbd, \u0dbb\u0dad\u0dca\u0db8\u0dbd\u0dcf\u0dcf\u0db1, \u0db8\u0dc4\u0dbb\u0d9c\u0db8, \u0d9a\u0dd0\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dd1\u0dc0, \u0db8\u0ddc\ufffd\u0ddc\u0dbb\u0da7\u0dd4\u0dc0, \u0dad\u0dd2\u0db9\u0dd2\u0dbb\u0dd2\u0d9c\u0dc3\u0dca\u0dca\u0dba\u0dcf\u0dcf\u0dba \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dbd\u0dda\u0dda\u0262\u0d9a\u0db8\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dcf\u0dc3 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf",
