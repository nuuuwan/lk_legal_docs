    "text": "\u0dd9\u0d9a\u0dcf\u01e6\u0d9c\u0dc3\u0dca\u0dd9\u0d9c\u0dcf\u0da9\u0dd0\u0262\u0dbd; \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0263\u0dba\u0db1\u0dd9\u0118 \u0d9a\u025e\u0dab\u0dcf\u0dd9\u0dc3\u0dca\u0db1 \u0dc3\u0dc4 \u01ce\u0dba\u0dd9\u0db4\u0dcf\u0da7 \u0d85\u0db8\u0dbb\u01b1\u0d82\u0d9c\u0dd9\u0118 \u022c\u01ca\u01dd\u0d9a\u0dcf \u021f\u0dba\u0daf\u0259\u0dc1\u01e8 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dd9\u0d9c\u0dcf\u0da9\u0dd0\u0262\u0dbd \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a 56 \u0daf\u0dbb\u0db1 \u0dd9\u0d9a\u0dcf\u01e6\u0d9c\u0dc3\u0dca\u0dd9\u0d9c\u0dcf\u0da9\u0dd0\u0262\u0dbd, \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u01e6\u0db1\u0dcf \u0dc3\u0dc4 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8 \u0dc3\u0dc4 \u0263\u0dba\u0db1\u0dd9\u0118 \u0daf\u0dba\u0dcf\u0dc0\u0d82\u0dc1 \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0dd9\u0d9c\u0dcf\u0da9\u0dd0\u0262\u0dbd \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a 68/13 \u0daf\u0dbb\u0db1 \u0dd9\u0d9a\u0dcf\u01e6\u0d9c\u0dc3\u0dca\u0dd9\u0d9c\u0dcf\u0da9\u0dd0\u0262\u0dbd\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u0dd9\u0db8\u0db8 \u0d85\u01e9\u0dd9\u0259\u0d9b\u0dab\u0dd9\u024f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb B; \u0daf\u00fd\u0dab\u0da7: \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb C (\u0dc3\u0dd0\u0dc5\u0263\u028f\u019d \u0db8\u0dcf\u0dc0\u0dad \u0d87\u0dd9\u0dc5\u0dca \u0dd9\u0d9a\u0dcf\u0da7\u0dc3\u00fa); \u0db6\u0da7\u028f\u0dbb\u0da7: \u0219.\u0d92. \u0219\u025c\u0dc3\u0dca \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0db1\u0dcf\u0dbb\u0d82\u0dd9\u0d9c\u0dcf\u0da9 \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0dd9\u0daf\u0dcf\u0db9\u0d9c\u0dc4\u00fd\u0249\u0dbb 