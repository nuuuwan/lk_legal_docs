    "text": "\u0b95\u0bbe\u0ba3\u0bbf; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1: \u0b85\u0ba4\u0bcd\u1f90\u1f9e\u0b95\u0bbf\u0bbe\u0bbf\u0baf \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b86\u0ba4\u0ba9 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0b8e\u0bae\u0bcd.\u0b8e\u0bb2\u0bcd.\u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf, \u1faa\u0ba4\u0bbf, \u0b85\u0ba4\u0bcd\u1f90\u1f9e\u0b95\u0bbf\u0bbe\u0bbf\u0baf \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b86\u0ba4\u0ba9 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf ; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b85\u0ba4\u0bcd\u1f90\u1f9e\u0b95\u0bbf\u0bbe\u0bbf\u0baf \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b86\u0ba4\u0ba9 \u0bb5\u0bbe\u0bbf \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0bbe\u0bc0.\u0bc7\u0b95.\u0bb5\u0bbf\u0ba4\u0bbe\u0ba9\u0bc7\u0b95 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf.",
