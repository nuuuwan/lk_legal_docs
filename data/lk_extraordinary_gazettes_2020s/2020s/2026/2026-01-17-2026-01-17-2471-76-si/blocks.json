9a\u0dca\u0da7\u0dc3 \u0dc3\u0db8\u0dca\u0db6\u0dca\u0dad \u0dba\u0dba\u0dca\u0dad \u0d91\u0dc4\u0dd2 \u0d8b\u0db4\u0dba\u0db8\u0d9b\u0db1\u0dba\u0dba\u0dc4\u0dd2; \u201c\u0dc3\u0dd2\u0daf\u0dba\u0dbd\u0dd4 \u0dba\u0dcf\u0dca\u0dbb\u0dc5\u0dbb\u0dd4\u201d \u0d89\u0dc0\u0dda \u0d9a\u0dbb \u0dc3\u0d82\u0dba\u0dd9\u0ddd \u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dba\u0dda \u0db4\u0dd3. \u0dc3\u0dd3. \u0da9\u0dd3. \u0dc3\u0dd2\u0dc1\u0dda\u0dbb\u0dcf, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0db0\u0dbb\u0dc0\u0dd4\u0db8 \u0d9a\u0dd2 \u0d9a\u0dba\u0db8\u0dca \u0dba\u0d9a\u0dca\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0db8. 2025 \u0dba\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 16 \u0dc0\u0dd0\u0dbd\u0db0 \u0daf\u0dd2\u0db1, \u0db6\u0dda\u0dcf\u0dbb\u0db8\u0dd4\u0db8\u0dbd \u0dbb\u0da2\u0dcf\u0db8\u0db8\u0dc0\u0dda\u0dcf \u0db4\u0dcf\u0dbb, \u201c\u0db8\u0dd2\u0dc4\u0dd2\u0d9a\u0dcf \u0db8\u0dd0\u0daf\u0dd4\u0dbb\u201d, \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9\u0db8\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dbd\u0db0\u0dbb\u0dc0\u0dd4\u0db8 \u0d9a\u0dd2 \u0d9a\u0dba\u0db8\u0dca \u0dba\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dcf\u0dba\u0db8\u0dca\u0dca\u0dad\u0dc5\u0dba\u0dda \u0daf\u0dd3 \u0dba.",
