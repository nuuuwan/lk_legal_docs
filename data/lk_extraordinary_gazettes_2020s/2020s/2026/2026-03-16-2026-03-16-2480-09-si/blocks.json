    "text": "\u0d85\u0dad\u0dbb \u0db4\u0dc0\u01ae\u0db1\u0dcf 2021.12.31 \u01ce\u0db1 \u0daf\u0dbb\u0db1 \u0d9a\u023c\u0d9a\u025e \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0262\u0dc0\u0dbb\u0dba\u0dcf\u0dd9\u0118 \u021d\u0d9a\u0dcf\u0dc1\u0db1\u0dd9\u024f \u0dc3\u0db3\u0dc4\u01e6 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u025e\u019f \u0218\u0298\u0db6\u0db3\u0dc0\u026d \u0d9a\u0dcf\u0259\u023d\u0d9a \u0d86\u0dbb\u0dcf\u026c\u0262 \u0dd9\u0229\u025e\u023c \u00fb\u025d\u0dd9\u0db8\u01e6 \u0dc3\u0db8\u0dae\u0dba\u0da7 \u0db4\u01ae\u00fb\u025d\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0229\u025e\u023c\u0d9a\u025e \u0dc0\u0dc1\u0dd9\u0dba\u01e6 \u01e8\u01af\u0da5 \u0d85\u0db8\u0262 \u0d92. \u0dbb\u01e6\u0dd9\u0daf\u01e7\u0dba \u0db8\u0dc4\u0dad\u0dcf \u0dd9\u0dc0\u0dad \u0dd9\u0dba\u02a3\u023f \u0d9a\u0dbb\u0db1 \u0dbd\u01cf.",
    "fonts": [
      "IskoolaPota"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.15,
      639.55,
      549.65,
      674.9
    ],
    "text": "\u0dd9\u0229\u025e\u023c\u0d9a\u025e \u01e8\u01af\u0da5 \u0d85\u0db8\u0262 \u0d92. \u0dbb\u01e6\u0dd9\u0daf\u01e7\u0dba \u0db8\u0dc4\u0dad\u0dcf \u0dd9\u0dba\u02a3\u023f\u0dc0 \u0dc3\u0d82\u0dd9\u0dc1\u02a4\u0db0\u0db1\u0dd9\u0dba\u01e6 \u0d85\u0db1\u01b1\u025e\u0dc0 \u0db1\u0dd0\u0dc0\u0dad \u0dd9\u0dba\u02a3\u023f \u0d9a\u0dbb\u0db1 \u0dd9\u0dbd\u0dc3 \u0d9a\u0dbb \u0d87\u01af \u0daf\u0dd0\u01e9\u023c\u01cf\u0db8 \u0d85\u01e9\u0dc0, \u0dba\u0dd9\u0dae\u02a4\u00fa\u0dad \u01e7\u0dd9\u0dba\u02a4\u0d9c\u0dba \u0d85\u0dc0\u0dbd\u0d82\u011b \u0d9a\u0dc5\u0252\u01b1 \u0dba\u0dd0\u0250 \u0daf\u0dd0\u01e6 \u0dd9\u0db4\u01e8 \u0dba\u0db1 \u0dd9\u0dc4\u0250\u01e6, \u0d9a\u023c\u0d9a\u025e \u0d85\u0db8\u0dcf\u0dad\u0255 \u0d86\u0da0\u0dcf\u0259\u0dba \u0d85\u01e7\u0262 \u0da2\u0dba\u01e6\u0dad \u021d\u0db1\u0dcf\u01e6\u01d0 \u0dc0\u0db1 \u0db8\u0dcf, \u0d91\u0db8 \u01e7\u0dd9\u0dba\u02a4\u0d9c\u0dba \u0d85\u0dc0\u0dbd\u0d82\u011b \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dbb, \u0d91\u00fc 2021.12.31 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0daf\u0dbb\u0db1 \u01e7\u0dd9\u0dba\u02a4\u0d9c\u0dba \u0db8\u0dad \u0101\u0dba\u0dcf \u0dd9\u0db1\u02a3\u0d9a\u0dbb\u0db1 \u0dd9\u0dbd\u0dc3 \u0daf \u0dd9\u0db8\u0250\u01e6 \u01e7\u0dd9\u0dba\u02a4\u0d9c \u0d9a\u0dbb\u023d.",
