    "text": "(\u0d86) \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf\u0dc0\u0db1\u0dca \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0dc0\u0dd3\u0db8 \u0db1\u0dd2\u0dbb\u0dd6\u0db4\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0d85\u0d82\u0d82\u0d9a 3 \u0daf\u0dbb\u0db1 \u0db4\u0dda\u0dda\u0dc5\u0dd2\u0dba\u0dda\u024f \u201c\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0da7 \u0db4\u0dd0\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0dba\u0dda\u024f (FDOA)\u0dc3\u0dd2\u0da7 \u0daf\u0dd2\u0db1 4\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad.\u201d \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0dc3\u0dc4 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0db8 \u0dc0\u0dd9\ufffd\u0db1\u0dd4\u0dc0\u0da7, \u201c\u0db4\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db8\u0dca \u0dbd\u0dd2\u0dba\u0dcf\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0da7 \u0db4\u0dd0\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0daf\u0dd2\u0db1\u0dba\u0dda\u024f \u0dc3\u0dd2\u0da7 \u0daf\u0dd2\u0db1 4\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad\u201d \u0dba\u0db1 \u0dc0\u0da0\u0db1 \u0dc3\u0dc4 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0db8 \u0d86\u0daf\u0dda\u0dda\u0dc1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dd9\ufffd\u0db1\u0dca; (\u0d87) \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0dc0\u0dbd\u0d82\u0d82\u0d9c\u0dd4 \u0d9a\u0dcf\u0dcf\u0dbd\u0dc3\u0dd3\u0db8\u0dcf\u0dcf\u0dc0 \u0db1\u0dd2\u0dbb\u0dd6\u0db4\u0dab\u0dba \u0d9a\u0dbb\u0db1 \u0d85\u0d82\u0d82\u0d9a 4 \u0daf\u0dbb\u0db1 \u0db4\u0dda\u0217\u0dc5\u0dd2\u0dba\u0dda\u024f, \u201c\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf\u0dc0\u0da7 \u0db4\u0dd0\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0dba\u0dda\u024f (FDOA) \u0dc3\u0dd2\u0da7 \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dcf\u0dc0\u201d \u0dba\u0db1 \u0d