    "text": "\u0bb5\u0bc8\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0baf\u0bb0\u0bcd \u0b8e\u0b9a\u0bcd. \u0b8e\u0bae\u0bcd. \u0b9a\u0bc1\u0b9a\u0bbf\u0bbf\u0bb2\u0bcd \u0bb0\u0ba3\u0b9a\u0bbf\u0bbf\u0b99\u0bcd\u0b95,\u0b8e\u0b9a\u0bcd. \u0b8e\u0bae\u0bcd. \u0b9a\u0bc1\u0b9a\u0bbf\u0bbf\u0bb2\u0bcd \u0bb0\u0ba3\u0b9a\u0bbf\u0bbf\u0b99\u0bcd\u0b95, \u0bb5\u0bc0\u0b9f\u0bae\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0bc1, \u0ba8\u0bbf\u0bbf\u0bb0\u0bcd\u0bae\u0bbe\u0bbe\u0ba3\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd.",
