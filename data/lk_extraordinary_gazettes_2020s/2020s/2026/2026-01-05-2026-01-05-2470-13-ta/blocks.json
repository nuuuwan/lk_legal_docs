    "text": "\u0bb5\u0b9f\u0bae\u0bc7\u0bb2\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0b95\u0bc1\u0bb0\u0bc1\u0ba8\u0bbe\u0b95\u0bb2\u0bcd \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0b95\u0bc1\u0bb3\u0bbf\u0bbf\u0baf\u0bbe\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bc1 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0bc6\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd, \u0b87\u0bb2. 1142, \u0b95\u0bbf\u0ba4\u0ba4\u0bcd\u0ba4\u0bb2\u0bb5 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b95\u0bbf\u0ba4\u0ba4\u0bcd\u0ba4\u0bb2\u0bb5 \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd\u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba8\u0bbf\u0bbf\u0bb2 \u0b85\u0bb3\u0bb5\u0bc8\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0ba8\u0bbe\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0ba4\u0ba4\u0baf\u0bbe\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0b9f \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0bb5\u0bb0\u0bc8\u0baa\u0b9f \u0b87\u0bb2. KU/KPW/2021/662 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd 2023.07.27 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0ba4\u0bbf\u0baf\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0b9f \u0bae\u0bc1\u0ba4\u0bb1\u0bcd \u0b9a\u0bc1\u0bb5\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb0\u0bc8\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bc0\u0bb4\u0bc7 \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b95\u0bbe\u0ba3\u0bbf\u0bbf\u0baa\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0b8e\u0bb2\u0bcd\u0bb2\u0bc8\u0b95\u0bb3\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u0bbf\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bbe\u0bb1\u0bc1: 01. \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u2018\u2018A\u2019\u2019 \u2013 \u0ba8\u0b95\u0bb2\u0ba9\u0bcd\u0bb5\u0ba4\u0ba4\u0bcd\u0ba4 \u2013 \u0bb5\u0bbf\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.1518 01. \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u2018\u2018A\u2019\u2019 \u2013 \u0ba8\u0b95\u0bb2\u0ba9\u0bcd\u0bb5\u0ba4\u0ba4\u0bcd\u0ba4 \u2013 \u0bb5\u0bbf\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.1518 \u0bb9\u0bc6\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\u0bb9\u0bc6\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\ufffd\u0bcb\u0b9f\u0bcd\u0b9f\u0b9f \u0b85\u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b9a\u0bcd \u0b9a\u0baa\u0bc8 \u0b89\u0bb0\u0bbf\u0bae\u0bc8\u0b95\ufffd\u0bcb\u0bb0\u0bc1\u0bae\u0bcd \u0ba8\u0bbe\u0b95\u0bb2\u0ba9\u0bcd\u0bb5\u0ba4\u0ba4\u0bcd\u0ba4 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bc1\u0ba9\u0bbf\u0bb2\u0bcd \u0b85\u200b\u0baa\u0bc7\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 \u0b89\u0bb0\u0bbf\u0bae\u0bc8\u0b95\ufffd\u0bcb\u0bb0\u0bc1\u0bae\u0bcd \u0ba8\u0bbe\u0b95\u0bb2\u0ba9\u0bcd\u0bb5\u0ba4\u0ba4\u0bcd\u0ba4 ; \u0b95\u0bbf\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u0b95\u0bc1\u0bb3\u0bbf\u0bbf\u0baf\u0bbe\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8 \u0b89\u0bb0\u0bbf\u0bae\u0bc8\u0b95\ufffd\u0bcb\u0bb0\u0bc1\u0bae\u0bcd \u0ba8\u0bbe\u0b95\u0bb2\u0ba9\u0bcd\u0bb5\u0ba4\u0ba4\u0bcd\u0ba4 \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 B \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0bbf\u0b9a\u0bcd \u0b9a\u0bc0\u0bb0\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0ba4\u0bcd\u0ba4 \u0b86\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bb4\u0bc1 \u0b89\u0bb0\u0bbf\u0bae\u0bc8\u0b95\ufffd\u0bcb\u0bb0\u0bc1\u0bae\u0bcd \u0ba8\u0bbe\u0b95\u0bb2\u0ba9\u0bcd\u0bb5\