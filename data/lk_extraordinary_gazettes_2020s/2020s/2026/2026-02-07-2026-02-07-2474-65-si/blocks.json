    "text": "1. \u0db0\u0db8\u0dca\u0db8\u0dd2\u0d9a \u0d9a\u0dc3\u0dca\u0dca\u0dad\u0dd4\u0dbb\u0dd2\u0db8\u0dd4\u0daf\u0dbd\u0dd2 \u0db8\u0dc4\u0dad\u0dcf\u0dcf - \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2 2. \u0db1\u0dd3\u0dad\u0dd2\u0da5 \u0d91\u0db8\u0dca. \u0d91\u0da0\u0dca. \u0d86\u0db1\u0db1\u0dca\u0daf \u0d9a\u0dd4\u0db8\u0dcf\u0dcf\u0dbb \u0db8\u0dc4\u0dad\u0dcf\u0dcf3. \u0da2\u0dcf\u0dcf\u0dad\u0dd2\u0d9a \u0d94\u0dbd\u0dd2\u0db8\u0dca\u0db4\u0dd2\u0d9a\u0dca \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0dda\u0dda\u0dda \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0dd2\u0dad, \u0db1\u0dd2\u0dbd\u0dd6\u0d9a \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dcf\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf\u0dcf4. \u0d92. \u0d9a\u0dda\ufffd. \u0db1\u0db1\u0dca\u0daf\u0dc0\u0dd3\u0dbb \u0db8\u0dc4\u0dad\u0dcf\u0dcf5. \u0dbb\u0ddd\ufffd\u0ddd\u02ea\u0dc4\u0dd2\u0dad \u0db8\u0dbd\u0dca\u0dbd\u0dc0\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0db8\u0dc4\u0dad\u0dcf\u0dcf6. \u0db4\u0dd3. \u0d8b\u0db4\u0dd4\u0dbd\u0dca \u0d85\u0db6\u0dda\u0dda\u0229\u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0db8\u0dc4\u0dad\u0dcf\u0dcf7. \u0d85\u0db1\u0dd4\u0dbb \u0d85\u0db4\u0dca\u0db4\u0dd4\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9c\u0dda\u0118 \u0db8\u0dc4\u0dad\u0dcf\u0dcf",
