    "text": "\u0daf\u0dc5\u0dd4\u0dba\u0dbd\u0dbc \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbc\u0dbb\u0dcf \u0dc0 \u0dbd\u0dc0\u0dba\u0db8\u0dca \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0dba \u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dba\u0dcf\u0dba\u0dcf\u0dbc\u0dba \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0db3\u0dc1\u0dcf \u0d89\u0da9\u0db8\u0dca \u0dba\u0d9a\u0dd4\u0da7\u0dc0\u0d9a\u0dca \u0d9a\u0dda\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc0\u0db3\u0dc1\u0dcf \u0d9a\u0dbd\u0dbe\u200d \u0db4\u0dc1\u0dcf \u0daf\u0dd0\u0d9a\u0dca\u0dba\u0dbd\u0db1 \u0d89\u0da9\u0db8/\u0db4\u0dbb\u0dbd\u0dbe\u0dcf\u0dcf\u0dbd \u0dbc\u0db6\u0dcf\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dbd \u0d9a\u0daf\u0dc1\u0dc0\u0dca \u0d9a\u0dbb\u0db1 \u0db6\u0dd0\u0dc0\u0dca 1964 \u0d9a\u0d82\u0d9a 28 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u0db8\u0dca \u0d9a\u0dda\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dba\u0db8\u0dca \u0db4\u0db1\u0dba\u0dda 7 \u0dbd\u0dd0\u0db1\u0dd2 \u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba\u0dda (1) \u0dbd\u0dd0\u0db1\u0dd2 \u0d8b\u0db4\u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dba\u0dda \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0dba\u0daf\u0db8\u0dd2. \u0dbd \u0dbc\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db6\u0dbc\u0dcf\u0dba\u0db4\u0dd4\u0dba\u0dbb\u0dd4\u0dda\u0dad\u0dd4 \u0dbd\u0db1 \u0d89\u0da9\u0dba\u0db8\u0dca/\u0db4\u0dbb\u0dbd\u0dbe\u0dcf\u0dcf\u0dba\u0dc0\u0dca \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb\u0dba : \u0db8\u0dbb\u200d\u0db8 \u0db4\u0dc2\u0dcf\u0dba\u0dda \u0db8\u0dcf\u0dcf\u0dba \u0daf\u0dd2\u0dc0\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dba\u0da7\u0dbd\u0dda\u0dcf \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba\u0dba \u0dba \u0d9a\u0db8\u0dca \u0dba\u0d9a\u0dd4\u0da7\u0dca\u0da8\u0dcf\u0dc0\u0dba\u0dda \u0d9a\u0dc0\u0dca\u0d9c\u0dd2 \u0dc0 \u0d8b\u0da9\u0dc3\u0dd2\u0dba \u0db4\u0dda\u0dad\u0dd4\u0dbd \u0dc3\u0dd4\u0dc5\u0dd4 \u0dba