db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014- (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1 : 130 0.0199 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1 : 131 0.3122 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1 : 132 0.1317 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1 : 133 0.1249 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1 : 134 0.1451 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1 : 135 0.1075 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1 : 136 0.0649 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1 : 137 0.0786 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1 : 138 0.0490 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1 : 139 0.1044 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1 : 140 0.1123 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1 : 141 0.1141 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1 : 142 0.0371 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1 : 143 0.3905 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 - \u0d89\u0da9\u0db8\u0dca \u0db4\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab _ \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0d82\u0d9a 475, \u0d9a\u0da9\u0dd4\u0dd9\u0dc0\u0dbd \u0db4\u0dcf\u0dbb, \u0d9c\u0dd9\u0db1\u0dca\u0dd9\u0dc4\u0dda\u0db1, \u0db6\u0dad\u0dca\u0dad\u0dbb\u0db8\u0dd4\u0dbd\u0dca\u0dbd",
