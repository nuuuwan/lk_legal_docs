  {
    "page_number": 0,
    "bbox": [
      55.3,
      455.46,
      549.78,
      516.12
    ],
    "text": "1988 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bbf\u0ba9\u0bcd 83 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb2\u0bcd \u0ba4\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b9a\u0bc1\u0b99\u0bcd\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0bae\u0bcd (\u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0baf\u0bae\u0bcd 235) \u0b87\u0ba9\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1 10\u0b85 \u0b87\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0b9f\u0bbf, \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0b9a\ufffd\u0bcb\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bb0\u0b9a\u0bbf\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf, \u0ba4\u0bbf\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bbf\u0bbf\u0b9f\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\ufffd\u0bca\u0bb0\u0bc1\u0bb3\u0bbe\u0bbe\u0ba4\u0bbe\u0bbe\u0bb0 \u0b85\u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf \u0b85\u0bae\u0bc8\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\ufffd\u0b95\u0bbf\u0bbf\u0baf \u0b85\u0ba8\u0bc1\u0bb0 \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0bb0 \u0ba4\u0bbf\u0bbf\u0b9a\u0bbe\u0bbe\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0b86\u0b95\u0bbf\u0bbf\u0baf \u0ba8\u0bbe\u0bbe\u0ba9\u0bcd, \u0bae\ufffd\u0bb1\u0bcd\u0b95\u0ba3\u0bcd\u0b9f \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1 10\u0b85 \u0b87\u0ba9\u0bcd \u0b95\u0bc0\u0bb4\u0bcd \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 2026, \u0b9a\u0ba9\u0bb5\u0bb0\u0bbf\u0bbf 31 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf\u0baf 2473/31 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b85\u0bb0\u0b9a \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0bbe\u0ba9\u0bbf\u0bbf \u0b85\u0bb1\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0bb2\u0bcd \u0bb5\ufffd\u0bbf\ufffd\u0baf\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8\u0bc8 2026, \u0b8f\u0baa\u0bcd\u0baa\u0bbf\u0bbf\u0bb1\u0bb2\u0bcd 01 \u0bae\u0bc1\u0ba4\u0bb2\u0bcd \u0b85\u0bae\u0bc1\u0bb2\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0bb5\u0b95\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0bb2\u0bcd \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bb2\u0bcd \u0b87\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b9a\u0bcd \u0b9a\u0bc6\u0bc6\u0baf\u0bcd\u0b95\u0bbf\u0bbf\u0bb1\ufffd\u0ba9\u0bcd.",
