    "text": "\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf \u0da0\u0dcf\u0dcf\u0dc0\u0d9a\u0da0\u0dca\u0da0\u0dda\u0dda\u0dbb\u0dd2 \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dbb \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0dda\u0229. \u0d91\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0255\u0dcf\u0db4\u0dcf\u0dcf\u0dbb \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0daf\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0d87\u0db8\u0dd4\u0dab\u0dd4\u0db8\u0dda\ufffd \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad. \u0d91\u0db8 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca\u0dc0\u0dbd, \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0dcf\u0db1 \u0d86\u0daf\u0dcf\u0dcf\u0dba\u0db8\u0dca \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0d9a\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0d9c\u0dda\u0118 \u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0dba\u0ddc\ufffd\u0ddc\u0db8\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0dda\ufffd\u0dda \u0db4\u0daf\u0dd2\u0d82\u0d82\u0da0\u0dd2\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc3\u0dc4\u0dad\u0dd2\u0d9a\u0dba\u0dda\u0dda\u024f \u0dc0\u0dd2\u0dc2\u0dba \u0db4\u0dd0\u0dd0\u0dc4\u0dd0\u0dd0\u0daf\u0dd2\u0dbd\u0dd2\u0dc0 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0dca\u200d\u0dba\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0d91\u0db8 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0db4\u0dd0\u0dd0\u0dc4\u0dd0\u0dd0\u0daf\u0dd2\u0dbd\u0dd2\u0dc0 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dcf\u0dcf \u0db1\u0ddc\ufffd\u0ddc\u0d9a\u0dc5 \u0d85\u0dad\u0dbb \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0d9a\u0ddc\ufffd\u0ddc\u0db8\u0dc3\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dcf\u0da7 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0dd9\ufffd\u0db1\u0dca \u0dbd\u0db6\u0dcf\u0dcf \u0daf\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0daf\u0dc4\u0dc3\u0dca\u0dca \u0daf\u0dd0\u0dd0\u0d9a\u0dca\u0dc0\u0dd6\u0dba\u0dda\u0dda\u024f \u0db1\u0dd0\u0dd0\u0dad. 2026.01.20 \u0daf\u0dd2\u0db1 \u0d91\u0db8 \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dca\u0dc0\u0dd3\u0db8\u0dda\ufffd \u0db8\u0dd4\u0dbd\u0dc3\u0dd4\u0db1 \u0daf\u0dd0\u0dd0\u0dbb\u0dd6 \u0d91\u0db8 \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf, \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0dc4 \u0d91\u0db8 \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dca\u0dc0\u0dd3\u0db8\u0dda\ufffd \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0dcf\u0d9c\u0dd9\ufffd\u0db1 \u0dba\u0dcf\u0dcf\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0dad\u0dd4\u0dbb\u0dd4 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1\u0dc0\u0dbd\u0da7 \u0d85\u0db1\u0dd4\u0d9a\u0dd6\u0dbd\u0dc0 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf \u0db1\u0ddc\ufffd\u0ddc\u0d9a\u0dc5\u0dda\ufffd\u0dda\u0dba.",
