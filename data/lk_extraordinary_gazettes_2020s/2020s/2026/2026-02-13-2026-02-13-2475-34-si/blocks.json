    "text": "\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d8b\u0db4\u0daf\u0dd9\u0dd9\u0dc3\u0dca\u0dca \u0d85\u0da9\u0d82\u0d82\u0d9c\u0dd4 \u0dbd\u0dd2\u0db4\u0dd2\u0dba \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0dca\u200d\u0dba\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d89\u0dc0\u0dad \u0daf\u0dd0\u0dd0\u0db8\u0dd3\u0db8 \u0dbb\u0da2\u0dba\u0dda\u0dda\u024f \u0daf\u0dd9\u0dd9\u0db4\u0dcf\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\ufffd\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0dda\u0dda \u0dc3\u0dc4 \u0dbb\u0da2\u0dba\u0dda\u0dda\u024f \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dba\u0dda\u0dda\u024f \u0dbd\u0dda\ufffd\u0d9b\u0db1\u0dc0\u0dbd\u0da7 \u0d85\u0db4\u0d9a\u0dd3\u0dbb\u0dca\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0d9c\u0dd9\ufffd\u0db1 \u0daf\u0dd9\u0dd9\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dc0\u0d9a\u0dd2.",
