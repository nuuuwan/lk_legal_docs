    "text": "\u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbe\u0bbf\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b85\u0b99\u0bcd\u0bc6\u0b95\u0bbe\u0bc8\u0b9f, \u1f99\u0bb2\u0bcd\u0bc7\u0bb2\u0bbe\u0bbf\u0baf\u0bbe\u0bb5 \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1, \u0bc7\u0baa\u0bbe\u0ba4\u0bbf\u0baf \u0b92\u1fa8\u0b99\u0bcd\u0bc8\u0b95, \u0b87\u0bb2. 55G \u0b8e\u1f94\u0bae\u0bcd \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bb9\u0baa\u0bcd\u1f97 \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0bc7\u0b95 \u0b9a\u0bae\u0bbe\u0ba4\u0bc0 \u0ba8\u0bbf\u0bc7\u0bb0\u0bbe\u0bb7\u0ba9\u0bc0 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf; \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf, \u0b8f.\u0b8e\u0b9a\u0bcd.\u0baa\u0bc0. \u0bb5\u0bbf\u0bae\u0bb2\u0bb0\u0ba4\u0bcd\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0bbe\u0bc6\u0b9f\u0bb2\u0bcd\u0bb2 \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbe\u0bbf\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf, \u0b9c\u0bc0. \u0b9a\u0bc1\u0b9c\u0bc0\u0bb5 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0bbe\u0bc6\u0b9f\u0bb2\u0bcd\u0bb2 \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbe\u0bbf\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 126/086 \u0b90 \u0b89\u0bc8\u0b9f\u0baf \u0b95\u0bbe\u0ba3\u0bbf, \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf, \u0b8e\u0bae\u0bcd.\u0baa\u0bc0. \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba8\u0bcd\u0ba4 \u0b95\u0bc1\u0bae\u0bbe\u0bb0 \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0bbe\u0bc6\u0b9f\u0bb2\u0bcd\u0bb2 \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbe\u0bbf\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b85\u0b99\u0bcd\u0bc6\u0b95\u0bbe\u0bc8\u0b9f, \u1f99\u0bb2\u0bcd\u0bc7\u0bb2\u0bbe\u0bbf\u0baf\u0bbe\u0bb5 \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1, \u0bc7\u0baa\u0bbe\u0ba4\u0bbf\u0baf \u0b92\u1fa8\u0b99\u0bcd\u0bc8\u0b95, \u0b87\u0bb2. 55G \u0b8e\u1f94\u0bae\u0bcd \u1f99\u0b95\u0bb5\u0bbe\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bb9\u0baa\u0bcd\u1f97 \u0b86\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0bc7\u0b95 \u0b9a\u0bae\u0bbe\u0ba4\u0bc0 \u0ba8\u0bbf\u0bc7\u0bb0\u0bbe\u0bb7\u0ba9\u0bc0 \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf.",
