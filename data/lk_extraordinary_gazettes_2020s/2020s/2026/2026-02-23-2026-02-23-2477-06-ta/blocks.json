    "text": "\u0ba4\u0bbf\u0baf\u0bc6\u0baa\u0bbe\u0b9f\u0bcd\u0b9f \u0b85\u0bae\u0bb0\u1f90\u0b99\u0bcd\u0b95\u0bc7\u0b95 \u1f97\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bbe \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u0bb0\u0bcd\u0bb7\u0ba9\u0bc0 \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bb0\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0bbe\u0bc6\u0b9f\u0bb2\u0bcd\u0bb2 \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbe\u0bbf \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. 56 \u0b90 \u0b89\u0bc8\u0b9f\u0baf \u0bc7\u0b95\u0bbe\u0ba9\u0bcd\u0b95\u0bb8\u0bcd\u0bc6\u0b95\u0bbe\u0bc6\u0b9f\u0bb2\u0bcd\u0bb2 \u0b95\u0bbe\u0ba3\u0bbf\u1f9c\u0bae\u0bcd; \u0b95\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u1fa2\u0baf\u0ba9\u0bc7\u0b95 \u0b95\u1f9e\u0ba3\u0bbe\u0bc7\u0b9a\u0ba9, \u0ba4\u0bbf\u0baf\u0bc6\u0baa\u0bbe\u0b9f\u0bcd\u0b9f \u0b85\u0bae\u0bb0\u1f90\u0b99\u0bcd\u0b95\u0bc7\u0b95 \u1f97\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bbe \u0baa\u0bbf\u0bbe\u0bbf\u0baf\u0ba4\u0bbe\u0bcd\u0bb7\u0ba9\u0bc0 \u0b86\u0b95\u0bbf\u0bc7\u0baf\u0bbe\u0bb0\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0bbe\u0bc6\u0b9f\u0bb2\u0bcd\u0bb2 \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbe\u0bbf \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. 56 \u0b90 \u0b89\u0bc8\u0b9f\u0baf \u0bc7\u0b95\u0bbe\u0ba9\u0bcd\u0b95\u0bb8\u0bcd\u0bc6\u0b95\u0bbe\u0bc6\u0b9f\u0bb2\u0bcd\u0bb2 \u0b95\u0bbe\u0ba3\u0bbf, \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf, \u1fa2\u0baf\u0ba9\u0bc7\u0b95 \u0ba4\u0baf\u0bbe\u0bb5\u0b99\u0bcd\u0b9a \u0bc6\u0baa\u0bc7\u0bb0\u0bb0\u0bbe \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0bc6\u0b95\u0bbe\u0bc6\u0b9f\u0bb2\u0bcd\u0bb2 \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbe\u0bbf \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2. 68/13 \u0b90 \u0b89\u0bc8\u0b9f\u0baf \u0bc7\u0b95\u0bbe\u0ba9\u0bcd\u0b95\u0bb8\u0bcd\u0bc6\u0b95\u0bbe\u0bc6\u0b9f\u0bb2\u0bcd\u0bb2\u0bb5\u0ba4\u0bcd\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b87\u0b9a\u0bcd \u0b9a\u0bc1\u0bb5\u0b9f\u0bcd\u1f8c \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u1f90\u0ba3\u0bcd\u1f8c B; \u0bc6\u0ba4\u0bb1\u0bcd\u0b95\u0bc1:\u0b87\u0b9a\u0bcd \u0b9a\u0bc1\u0bb5\u0b9f\u0bcd\u1f8c \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u1f90\u0ba3\u0bcd\u1f8c C (\u0bc6\u0b9a\u0bb2\u1fa2\u0bb9\u0bbf\u0ba9\u0bbf \u0bae\u0bbe\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0b95\u0bbe\u0bb2\u0bcd\u0bb5\u0bbe\u0baf\u0bbf\u0ba9\u0bcd \u0b92\u1f9e \u0baa\u0b95\u0bc1\u0ba4\u0bbf); \u0bc7\u0bae\u0bb1\u0bcd\u0b95\u0bc1: \u0baa\u0bc0.\u0b8f. \u0baa\u0bc0\u0bbe\u0bbf\u0bb8\u0bcd \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bae\u0bcd \u0ba8\u0bbe\u0bb0\u0b99\u0bcd\u0bc6\u0b95\u0bbe\u0b9f \u1faa\u0ba4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bbe\u0bbf \u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u0b9f\u0bcd\u1f8c \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0bc6\u0ba4\u0bbe\u0bae\u0bcd\u0baa\u0b95\u0bb9\u0b95\u0bc1\u0bae\u0bcd\u1f97\u0bb0 \u0b95\u0bbe\u0ba3\u0bbf\u1f9c\u0bae\u0bcd, \u0b89\u0bbe\u0bbf\u0bc8\u0bae \u0bc7\u0b95\u0bbe\u1f9e\u0bc7\u0bb5\u0bbe\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b95\u0bbe\u0ba3\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0bc6\u0baa\u0baf\u0bb0\u0bcd \u0bc6\u0ba4\u0bbe\u0bbf\u0baf\u0bbe\u0ba4 \u0b95\u0bbe\u0ba3\u0bbf\u1f9c\u0bae\u0bcd.",
