    ],
    "text": "48. \u0b9a\u0bc1\u0ba4\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf49. \u0baa\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb0\u0bc1 \u0bb9\ufffd\u0bb2 \u0b89\u0bb1\u0bc1\u0bae\u0baf50. \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bbf\u0bbf\u0bb2\u0bc8\u0bc8 \u0b9a\ufffd\u0bcb\u0bb7\u0bb2\u0bbf\u0bb8 \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf51. \u0baa\ufffd\u0bca\u0ba4\u0bc1 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0b9a\u0bc1\u0ba4\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf52. \u0baa\ufffd\u0bca\u0ba4\u0bc1\u0b9a\u0ba9 \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf53. \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf54. \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf55. \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbf\u0bbf\u0b9f\u0bc1\u0ba4\u0bb2\u0bc8\u0bc8 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf56. \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0ba3\u0bbf\u0bbf57. \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0b87\u0b9f\u0ba4\u0bc1\u0b9a\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf58. \u0bae\u0bb2\u0bc8\u0bc8\u0baf\u0b95 \u0b85\u0bb0\u0b9a\u0bbf\u0bbf\u0baf\u0bb2\u0bcd \u0b85\u0bb0\u0b99\u0bcd\u0b95\u0bae\u0bcd59. \u0bae\u0bb9\u0b9c\u0ba9 \u0b8e\u0b95\u0bcd\u0b9a\u0ba4\u0bcd \u0baa\u0bc6\u0bc6\u0bb0\u0bae\u0bc1\u0ba960. \u0ba8\u0bb2\u0bcd\u0bb2\u0bbe\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf61. \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd \u0b95\u0bbe\u0bbe\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0bb0\u0bb8\u0bcd (\u0b85\u0bb0\u0b9a\u0bbf\u0bbf\u0baf\u0bb2\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bc1)62. \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf63. \u0bb2\u0bbf\u0baa\u0bb0\u0bb2\u0bcd \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf64. \u0baa\u0bc1\u0bb0\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf\u0b95\u0bb0 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0b95\u0bcd\u0ba4\u0bbf\u0bbf65. \u0bb8\u0bcd\u0bb0\u0bc0 \u0bb2\u0b99\u0bcd\u0b95\u0bbe\u0bbe \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf 66. \u0bb8\u0bcd\u0bb0\u0bc0 \u0bb2\u0b99\u0bcd\u0b95\u0bbe\u0bbe \u0baa\ufffd\u0bca\u0ba4\u0bc1\u0b9c\u0ba9 \u0baa\u0bc6\u0bc6\u0bb0\u0bae\u0bc1\u0ba967. \u0bb8\u0bcd\u0bb0\u0bc0 \u0bb2\u0b99\u0bcd\u0b95\u0bbe\u0bbe \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf68. \u0bb8\u0bcd\u0bb0\u0bc0 \u0bb2\u0b99\u0bcd\u0b95\u0bbe\u0bbe \u0bae\u0bc1\u0bb8\u0bcd\u0bb2\u0bbf\u0bae\u0bcd \u0b95\u0bbe\u0bbe\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0bb0\u0bb8\u0bcd69. \u0bb8\u0bcd\u0bb0\u0bc0 \u0bb2\u0b99\u0bcd\u0b95\u0bbe\u0bbe \u0b95\ufffd\u0bca\u0bae\u0bbf\u0bbf\u0baf\u0bc2\u0ba9\u0bbf\u0bbf\u0bb8\u0bcd\u0b9f\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf70. \u0bb8\u0bcd\u0bb0\u0bc0 \u0bb2\u0b99\u0bcd\u0b95\u0bbe\u0bbe \u0b9a\u0bae\u0bc2\u0b95 \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf71. \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0b9a\ufffd\u0bcb\u0b9a\u0bb2\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf72. \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0b95\u0bcd\u0ba4\u0bbf\u0bbf73. \u0b9a\u0bae\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf74. \u0b9a\u0bae \u0ba8\u0bbf\u0bbf\u0bb2\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf75. \u0b9a\ufffd\u0bcb\u0b9a\u0bb2\u0bbf\u0b9a \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf76. \u0b9a\ufffd\u0bcb\u0b9a\u0bb2\u0bbf\u0b9a \u0b9a\u0bae\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf77. \u0b9a\u0bb0\u0bcd\u0bb5\u0b9c\u0ba9 \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0\u0bae\u0bcd",
