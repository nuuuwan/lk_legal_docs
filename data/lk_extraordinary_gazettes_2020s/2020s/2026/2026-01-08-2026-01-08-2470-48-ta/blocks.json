    "text": "1. \u0b85\u0b95\u0bbf\u0bbf\u0bb2 \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0ba4\u0bae\u0bbf\u0bbf\u0bb4\u0bcd\u0b95\u0bcd \u0b95\u0bbe\u0bbe\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0bb0\u0bb8\u0bcd2. \u0b85\u0b95\u0bbf\u0bbf\u0bb2 \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0ba4\u0bae\u0bbf\u0bbf\u0bb4\u0bb0\u0bcd \u0bae\u0b95\u0bbe\u0bbe\u0b9a\u0baa\u0bc8\u0bc83. \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0b95\u0bcd\u0ba4\u0bbf\u0bbf \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf4. \u0baa\u0bc1\u0ba4\u0bbf\u0bbf\u0baf \u0b9a\u0bc1\u0ba4\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf 5. \u0b85\u0bb0\u0bc1\u0ba3\u0bb2\u0bc1 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf6. \u0b85\u0b95\u0bbf\u0bbf\u0bb2 \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bbe\u0bbe\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0bb0\u0bb8\u0bcd7. \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8\u0bc8\u0ba4\u0bcd \u0ba4\u0bae\u0bbf\u0bbf\u0bb4\u0bcd \u0b85\u0bb0\u0b9a\u0bc1\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf8. \u0b88\u0bb0\ufffd\u0bcb\u0bb8\u0bcd \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf9. \u0b88\u0bb4 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf10. \u0b88\u0bb4 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bc1\u0bb0\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf\u0b95\u0bb0 \u0bb5\u0bbf\u0bbf\u0b9f\u0bc1\u0ba4\u0bb2\u0bc8\u0bc8 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf11. \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bb0\u0b9a\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf12. \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0b9a\u0bc1\u0ba4\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf13. \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf14. \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bae\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0bc115. \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf16. \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0b95\u0bcd \u0b95\u0bc1\u0bb0\u0bb2\u0bcd17. \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf18. \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0b87\u0b9f\u0ba4\u0bc1\u0b9a\u0bbe\u0bbe\u0bb0\u0bbf\u0bbf \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf19. \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0b9a\ufffd\u0bcb\u0b9a\u0bb2\u0bbf\u0b9a \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf20. \u0b90\u0b95\u0bcd\u0b95\u0bbf\u0bbf\u0baf \u0b9a\u0bae\u0bbe\u0bbe\u0ba4\u0bbe\u0bbe\u0ba9 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bae\u0bc8\u0bc8\u0baa\u0bcd\u0baa\u0bc121. \u0bae\u0bb2\u0bc8\u0bc8\u0baf\u0b95 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf22. \u0ba4\ufffd\u0bca\u0bb4\u0bbf\u0bbf\u0bb2\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf23. \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0baa\ufffd\u0bcb\u0bb0\ufffd\u0b9f\u0bcd\u0b9f \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf24. \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0b99\u0bcd\u0b95\u0bc7\u0bc7\u0bb1\u0bcd\u0baa\u0bc1 \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf25. \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbf\u0bbf\u0b9f\u0bc1\u0ba4\u0bb2\u0bc8\u0bc8 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf26. \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bc7\u0bc7\u0bb5\u0b95\u0bb0\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf27. \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0ba4\u0bae\u0bbf\u0bbf\u0bb4\u0bcd \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0ba3\u0bbf\u0bbf28. \u0b9c\u0ba9\u0b9a\u0bc6\u0bc6\u0ba4 \u0baa\u0bc6\u0bc6\u0bb0\u0bae\u0bc1\u0ba329. \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0b95\u0bbe\u0bbe\u0b99\u0bcd\u0b95\u0bbf\u0bbf\u0bb0\u0bb8\u0bcd30. \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0b95\u0bcd\u0ba4\u0bbf\u0bbf31. \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf32. \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0b9a\u0bc1\u0ba4\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf33. \u0ba4\u0bc7\u0bc7\u0b9a\u0bbf\u0bbf\u0baf \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf34. \u0b9c\u0bbe\u0bbe\u0ba4\u0bbf\u0bbf\u0b95 \u0b9a\u0b99\u0bcd\u0bb5\u0bb0\u0bcd\u0ba4\u0ba9 \u0baa\u0bc6\u0bc6\u0bb0\u0bae\u0bc1\u0ba935. \u0ba4\u0bae\u0bbf\u0bbf\u0bb4\u0bcd \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0ba3\u0bbf\u0bbf36. \u0ba4\u0bae\u0bbf\u0bbf\u0bb4\u0bcd \u0bae\u0bc1\u0bb1\u0bcd\u0baa\ufffd\u0bcb\u0b95\u0bcd\u0b95\u0bc1 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0ba3\u0bbf\u0bbf 37. \u0ba4\u0bae\u0bbf\u0bbf\u0bb4\u0bb0\u0bcd \u0b9a\u0bae\u0bc2\u0b95 \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf38. \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bbe\u0bbe\u0bb5\u0ba4\u0bc1 \u0ba4\u0bb2\u0bc8\u0bc8\u0bae\u0bc1\u0bb1\u0bc8\u0bc839. \u0ba8\u0bbe\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bb1\u0bcd\u0bb1\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0b95\u0bcd\u0ba4\u0bbf\u0bbf40. \u0ba4\u0bc7\u0bc7\u0b9a \u0bb5\u0bbf\u0bbf\u0bae\u0bc1\u0b95\u0bcd\u0ba4\u0bbf\u0bbf \u0b9c\u0ba9\u0ba4\u0bbe\u0bbe \u0baa\u0b95\u0bcd \u0bb7\u0baf41. \u0ba4\u0bae\u0bbf\u0bbf\u0bb4\u0bcd \u0b88\u0bb4 \u0bb5\u0bbf\u0bbf\u0b9f\u0bc1\u0ba4\u0bb2\u0bc8\u0bc8 \u0b87\u0baf\u0b95\u0bcd\u0b95\u0bae\u0bcd42. \u0ba4\u0bae\u0bbf\u0bbf\u0bb4\u0bb0\u0bcd \u0bb5\u0bbf\u0bbf\u0b9f\u0bc1\u0ba4\u0bb2\u0bc8\u0bc8\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0ba3\u0bbf\u0bbf43. \u0baa\u0bc1\u0ba4\u0bbf\u0bbf\u0baf \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0bbf44. \u0baa\u0bc1\u0ba4\u0bbf\u0bbf\u0baf \u0b9c\u0ba9\u0ba8\u0bbe\u0bbe\u0baf\u0b95 \u0bae\u0bbe\u0bbe\u0b95\u0bcd\u0b9a\u0bbf\u0bbf\u0b9a \u0bb2\ufffd\u0ba9\u0bbf\u0bbf\u0ba9\u0bbf\u0bbf\u0b9a\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf45. \u0ba8\u0bb5 \u0bb2\u0b99\u0bcd\u0b95\u0bbe\u0bbe \u0ba8\u0bbf\u0bbf\u0ba4\u0bb9\u0bb8\u0bcd \u0baa\u0b95\u0bcd \u0bb7\u0baf46. \u0ba8\u0bb5 \u0b9a\u0bae\u0b9a\u0bae\u0bbe\u0bbe\u0b9c\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf47. \u0ba8\u0bb5 \u0b9a\u0bbf\u0bbf\u0bb9\u0bb2 \u0b89\u0bb1\u0bc1\u0bae\u0baf",
