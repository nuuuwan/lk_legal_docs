    "text": "\u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba \u026a\u01e7\u0dc1\u0dca\u0da0\u0dba\u01e6 \u0dc3\u0dc4 \u0dba\u023c \u026a\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u02a4 \u0db4\u01b4 \u0d85\u0d82\u0d9a\u0dba \u0d89\u01e6\u0dd9\u0da2\u01e6\u0dc2\u01e6 \u0dad\u0dc4\u0db1\u023c \u0dd9\u0db4\u02a5\u01ca\u0d9c\u0263\u0d9a \u0dc3\u0dc4 \u0d89\u0da9\u023c \u026a\u0dc1\u0dcf\u0dbd\u01ae\u0dc0\u0dba \u0d85\u0250\u01af\u0d9a\u025e\u0dd9\u0118/\u0d85\u0250\u01af\u0d9a\u025e\u0dc0\u01e6\u0dd9\u0118 \u0da2\u0dcf\u01af\u0d9a \u0d85\u0250\u01af \u0d85\u0250\u01af\u0dd9\u024f \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf\u0dd9\u0dc0\u01e6 \u0d87\u01af \u01e8\u01af\u0dba\u0d9a\u0da7 \u0dba\u0da7\u01ae \u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u0dda \u0dc3\u023c\u021b\u0259\u0dab \u0db1\u0db8/\u0db1\u023c \u0dc3\u0dc4 \u0263\u0218\u0db1\u0dba \u0dc4\u0dd0\u01ff\u01e9\u023c\u0db4\u01ae \u0d89\u0da9\u0dd9\u023c \u0db4\u01e6\u01af\u0dba \u0dc3\u0dc4 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u01fe\u023c \u0db1\u023c \u0d92 \u0218\u0298\u0db6\u0db3 \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u021d\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0218\u0298\u0db6\u0db3 \u026a\u0dc3\u0dca\u0dad\u0dbb \u026a\u0dc3\u0dca\u0dad\u0dbb (\u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259) 1:0075 0.1564 \u0daf\u0da9\u0262\u0dbd\u0dd9\u0118 \u0db8\u0dd9\u0dc4\u0dda\u0dc2\u0dca \u0d89\u01e6\u01ce\u0d9a 871103860V \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 _ \u0db8\u0dba\u0dcf \u0d85\u0d82\u0d9a 52, \u0dc3\u01ff\u01e6\u0d9c\u0db8, \u01af\u0dc3\u0dca\u0dc3\u0db8\u0dc4\u0dcf\u0dbb\u0dcf\u0db8\u0dba 1:0076 0.1541 \u0daf\u0da9\u0262\u0dbd\u0dd9\u0118 \u01ce\u0dd9\u01e6\u0dc2\u0dca \u0dc3\u0d82\u0150\u0dc0 198411900971 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 _ \u0db8\u0dba\u0dcf \u0d85\u0d82\u0d9a 52, \u0dc3\u01ff\u01e6\u0d9c\u0db8, \u01af\u0dc3\u0dca\u0dc3\u0db8\u0dc4\u0dcf\u0dbb\u0dcf\u0db8\u0dba EOG 03-0183/1 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u00fb\u025d\u0dd9\u023c \u0db4\u0db1\u0dad 14 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u0dba\u0da7\u0dd9\u01ae \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca\u0dd9\u0118 \u01b0\u0dbb\u0dab \u021d\u0d9a\u0dcf\u0dc1\u0dba \u0daf\u0d9a\u0dd4\u019f \u0db4\u0dc5\u0dcf\u0dd9\u01ae \u0dc4\u023c\u0db6\u01e6\u0dd9\u0dad\u02a3\u0da7 \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f \u01af\u0dc3\u0dca\u0dc3\u0db8\u0dc4\u0dcf\u0dbb\u0dcf\u0db8 \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f \u0d85\u0d82\u0d9a 07 - \u0dbb\u0db6\u0259\u0dc0\u01ae\u0dad \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u02a3\u0178\u0da8\u0dcf\u0dc3\u0dba \u01b1\u0dc5 \u0dbb\u0db6\u0259\u0dc0\u01ae\u0dad \u0db1\u0db8\u0dd0\u01af \u0d9c\u0dd9\u023c \u0218\u028f\u0179\u0dba\u0dcf \u026d \u0daf, \u0d85\u0d82\u0d9a 830073 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dad\u0dbb \u0286\u01af\u0dba\u0dd9\u023c \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 01 \u028f \u0d9a\u0dd0\u0db6\u0263 \u0d85\u0d82\u0d9a 1:68 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca \u0dd9\u0dbd\u0dc3 \u0dd9\u0db4\u01e6\u01e9\u023c \u0dd9\u0d9a\u02a3\u0da7 \u0d87\u01ae\u0dad\u0dcf \u026d \u0daf, \u028f\u023d\u0d9a\u023c \u0db4\u0dd1\u023c \u0d89\u01ce\u025c\u0db4\u01ae \u0d9a\u0dbb\u0db1 \u0dd9\u0dbd\u0dc3 \u0daf\u0dd0\u01e9\u023c \u0dd9\u0daf\u023d\u01e6 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u00fb\u025d\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 55 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dba \u021d\u0d9a\u0dcf\u0dbb 2025.08.07 \u0dc0\u0dd0\u01e7 \u01ce\u0db1 \u0d85\u0d82\u0d9a 2448/42 \u0daf\u0dbb\u0db1 \u0d9c\u0dd0\u0dc3\u0178 \u0db4\u01b4\u0dd9\u024f \u0dba\u0dae\u0dcf \u0db4\u025c\u01ce \u0db4\u0dc5\u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0daf\u0dd0\u01e6\u026b\u0dd9\u023c \u0dc3\u0db3\u0dc4\u01e6 \u0dd9\u0d9a\u02a3\u0da7 \u0d87\u01ae\u0dad\u0dcf \u026d \u0daf, \u0d89\u0da9\u023c \u0dd9\u0d9a\u02a3\u0da7\u0dc3\u0dca\u0dc0\u0dbd \u0d85\u0250\u01af\u0dba \u0dc3\u023c\u0db6\u01e6\u0db0\u0dd9\u0dba\u01e6 \u0dd9\u0db8\u028f \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dd9\u024f \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0db8\u0dcf\u0dd9\u0118 \u01b0\u0dbb\u0dab 1998 \u0d85\u0d82\u0d9a 21 \u0daf\u0dbb\u0db1 \u028f\u023d\u0d9a\u023c \u0263\u0dba\u0dcf\u0db4\u01ce\u0d82\u013d \u00fb\u025d\u0dd9\u023c \u0db4\u0db1\u0dd9\u01ae 14 \u0dc0\u0dd0\u01e7 \u0dc0\u0d9c\u01e6\u01af\u0dd9\u0dba\u01e6 \u0db4\u0dc4\u0dad \u0d85\u01ae\u0dc3\u01e6 \u0d9a\u0dbb\u0db1 \u0db8\u0dcf \u0dd9\u0dc0\u0dad \u0db4\u0dc0\u0dbb\u0dcf \u0d87\u01af \u0db6\u0dbd\u0dad\u0dbd \u021d\u0d9a\u0dcf\u0dbb, \u0db8\u0db8 \u0dd9\u0db8\u0250\u01e6 \u021d\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u023d. \u0219. \u0287. \u018c. \u0286\u0dd9\u0118\u0dbb\u0dcf, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0d9a\u02a3\u0db8\u0dc3\u0dcf\u025c\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0262. 2026 \u0db8\u0dcf\u0259\u01b1 \u0db8\u0dc3 03 \u0dc0\u0dd0\u01e7 \u01ce\u0db1, \u0db6\u01ae\u0dad\u0dbb\u023f\u0262\u0dbd, \u0dbb\u0da2\u0db8\u0262\u0dc0\u01ae\u0dad \u0db4\u0dcf\u0dbb, \"\u023d\u028f\u0d9a\u0dad \u0db8\u0dd0\u01d0\u0dbb\", \u0d85\u0d82\u0d9a 1200/6, \u0d89\u0da9\u023c \u028f\u023d\u0d9a\u023c \u01e7\u0dbb\u026c\u0262 \u00fb\u025d\u0dd9\u023c \u0dd9\u0daf\u0db4\u0dcf\u0259\u0dad\u0dd9\u023c\u01e6\u01b1\u0dd9\u0269 \u01cf \u0dba. \u0d8b\u0db4\u0dd9\u0262\u0d9b\u0db1\u0dba \u026a\u01e7\u0dc1\u0dca\u0da0\u0dba\u01e6 \u0dc3\u0dc4 \u0dba\u023c \u026a\u0dd9\u0dc1\u0dda\u0dc2 \u0dd9\u0dc4\u02a4 \u0db4\u01b4 \u0d85\u0d82\u0d9a\u0dba \u0d89\u01e6\u0dd9\u0da2\u01e6\u0dc2\u01e6 \u0dad\u0dc4\u0db1\u023c \u0dd9\u0db4\u02a5\u01ca\u0d9c\u0263\u0d9a \u0dc3\u0dc4 \u0d89\u0da9\u023c \u026a\u0dc1\u0dcf\u0dbd\u01ae\u0dc0\u0dba \u0d85\u0250\u01af\u0d9a\u025e\u0dd9\u0118/\u0d85\u0250\u01af\u0d9a\u025e\u0dc0\u01e6\u0dd9\u0118 \u0da2\u0dcf\u01af\u0d9a \u0d85\u0250\u01af \u0d85\u0250\u01af\u0dd9\u024f \u0d85\u0dd9\u0217\u00fa\u0dc2\u0dcf\u0dd9\u0dc0\u01e6 \u0d87\u01af \u01e8\u01af\u0dba\u0d9a\u0da7 \u0dba\u0da7\u01ae \u0dd9\u0d9a\u02a3\u0da7\u0dd9\u0dc3\u0dda \u0dc3\u023c\u021b\u0259\u0dab \u0db1\u0db8/\u0db1\u023c \u0dc3\u0dc4 \u0263\u0218\u0db1\u0dba \u0dc4\u0dd0\u01ff\u01e9\u023c\u0db4\u01ae \u0d89\u0da9\u0dd9\u023c \u0db4\u01e6\u01af\u0dba \u0dc3\u0dc4 \u0d8b\u0d9a\u0dc3\u0dca \u0dc3\u0dc4 \u0db6\u0dd0\u01fe\u023c \u0db1\u023c \u0d92 \u0218\u0298\u0db6\u0db3 \u0d85\u0d82\u0d9a\u0dba \u0d85\u0d82\u0d9a\u0dba \u021d\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba \u0218\u0298\u0db6\u0db3 \u026a\u0dc3\u0dca\u0dad\u0dbb \u026a\u0dc3\u0dca\u0dad\u0dbb (\u0dd9\u0dc4\u00fa\u0da7\u0dba\u0dcf\u0259) 1:0068 0.0987 \u0db4\u0dbb\u0dab \u011b\u025e\u0dd9\u0118 \u0d9a\u0288\u01e6 \u0dc3\u023d\u01e6\u0daf 198207002972 \u0dc3\u023c\u021b\u0259\u0dab \u021d\u0dae\u0db8 \u0db4\u01e6\u01af\u0dba \u2013 _ \u0d85\u0d82\u0d9a 430/01/\u0d92, \u0dbb\u0db6\u0259\u0dc0\u01ae\u0dad, \u01af\u0dc3\u0dca\u0dc3\u0db8\u0dc4\u0dcf\u0dbb\u0dcf\u0db8\u0dba EOG 03-0183/2",
