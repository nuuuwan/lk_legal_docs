    ],
    "text": "i. \"YY\" \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d89\u0db1\u0dca\u0dc0\u0dd9\u0dcf\ufffd\u0dcf\u0dba\u0dd2\u0dc3\u0dd2\u0dba \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dbd\u0dd2\u0dad\u0dca \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda\u024f \u0d85\u0dc0\u0dc3\u0dcf\u0dcf\u0db1 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0db8\u0dca \u0daf\u0dd9\u0dd9\u0d9a \u0db1\u0dd2\u0dba\u0ddd\u0ddd\u02e0\u0ddd\u02ea\u0da2\u0db1\u0dba \u0dc0\u0dda\u0dda; ii. \"MMM\" \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d89\u0db1\u0dca\u0dc0\u0dd9\u0dcf\ufffd\u0dcf\u0dba\u0dd2\u0dc3\u0dd2\u0dba \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dc5 \u0dbd\u0dd2\u0dad\u0dca \u0db8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f \u0d89\u0d82\u0d82\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0dc3\u0dd2 \u0db1\u0db8\u0dda\ufffd \u0db4\u0dc5\u0db8\u0dd4 \u0d85\u0d9a\u0dca\u0dc2\u0dbb \u0dad\u0dd4\u0db1 \u0d9a\u0dd0\u0dd0\u0db4\u0dd2\u0da7\u0dbd\u0dca \u0d85\u0d9a\u0dd4\u0dbb\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0ddd\u0ddd\u02e0\u0ddd\u02ea\u0da2\u0db1\u0dba \u0dc0\u0dda\u0dda; iii. \"QQQQ\" \u0dba\u0db1\u0dd4 \u0dc1\u0dcf\u0dcf\u0d9b\u0dcf\u0dcf, \u0d85\u0d82\u0d82\u0dc1, \u0d92\u0d9a\u0d9a, \u0dc0\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0db4\u0dd8\u0dd8\u0dad\u0dd2, \u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0dd9\u0db1\u0dd4\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0dba\u0db8\u0dca \u0dc0\u0dbb\u0dca\u0d9c\u0dd3\u0d9a\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0dc3\u0d82\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0d85\u0dc3\u0dca\u0dca\u0dae\u0dd2\u0dad\u0dca\u0dc0 \u0db4\u0dbb\u0dcf\u0dcf\u0dc3\u0dba\u0d9a\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dcf\u0dcf\u0d9c\u0dd0\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dba\u0ddc\u02e0\u0ddc\u0daf\u0dcf\u0dcf \u0d9c\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d85\u0d9a\u0dca\u0dc2\u0dbb \u0dc3\u0dc4 \u0d85\u0d82\u0d82\u0d9a\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0db1\u0dca\u0dc0\u0dd2\u0dad \u0d9a\u0dda\ufffd\u0dad\u0dba\u0d9a\u0dd2. \u0d91\u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0d9a\u0dda\ufffd\u0dad\u0dba\u0d9a\u0da7 \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dd2\u0dba \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2, \u0dba\u0da7\u0dad\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca, \u0d91\u0d9a\u0dca \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0db8\u0d9a\u0dca\u0dc0\u0dad\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dad\u0dbb \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0db8\u0dca \u0d9c\u0dab\u0db1 \u0db4\u0dc4\u0dc5\u0ddc\ufffd\u0ddc\u0dc0\u0d9a\u0da7 \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0dd0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba. iv. \"XXXXX\" \u0dba\u0db1\u0dd4 \u0d89\u0db1\u0dca\u0dc0\u0ddc\ufffd\u0ddc\u0dba\u0dd2\u0dc3\u0dd2\u0dba\u0dda\u024f \u0dc3\u0d82\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d85\u0db1\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a \u0d85\u0d82\u0d82\u0d9a\u0dba \u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0d91\u0dba \u0db8\u0dd4\u0dc5\u0dd4\u0db8\u0db1\u0dd2\u0db1\u0dca\u0db8 \u0dc3\u0d82\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\ufffd\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d85\u0d9a\u0dca\u0dc2\u0dbb\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0db1\u0dca\u0dc0\u0dd2\u0dad \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dad\u0dbb \u0dc0\u0dbb\u0dca\u0dab\u0db8\u0dcf\u0dcf\u0dbd\u0dcf\u0dcf\u0dc0\u0dda\u0dda \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0d85\u0d9a\u0dca\u0dc2\u0dbb\u0dba\u0d9a\u0dca \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0dc3\u0d82\u0d82\u0d9a\u0dda\ufffd\u0dad\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0db1\u0ddc\ufffd\u0ddc \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba. \u0d91\u0dc0\u0dd0\u0dd0\u0db1\u0dd2 \u0d85\u0db1\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a \u0d85\u0d82\u0d82\u0d9a\u0dba\u0d9a\u0dca \u0db4\u0dd9\u0dd9\u0dbb \u0db8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0dc0\u0dc3\u0dcf\u0dcf\u0db1 \u0d85\u0d82\u0d82\u0d9a\u0dba\u0dda\u024f \u0dc3\u0dd2\u0da7 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba. \u0d9a\u0dd9\ufffd\u0dc3\u0dda\ufffd\u0dda \u0d8b\u0dc0\u0daf, \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba \u0d85\u0dc0\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dbd \u0daf\u0dd3 \u0d91\u0db8 \u0d85\u0d82\u0d82\u0d9a \u0dba\u0dd9\u02e0\u0daf\u0dd3\u0db8 \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0db8\u0dcf\u0dcf\u0dc3\u0dba\u0dda\u024f \u0dc4\u0ddd\ufffd\u0ddd\u02ea \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda\u024f \u0d86\u0dbb\u0db8\u0dca\u0db7\u0dba\u0dda\u024f \u0dc3\u0dd2\u0da7 \u0db1\u0dd0\u0dd0\u0dc0\u0dad \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dc5 \u0dc4\u0dd0\u0dd0\u0d9a\u0dd2\u0dba. v. \u0d89\u0dc4\u0dad \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0db8\u0dca, \u0d85\u0d9a\u0dd4\u0dbb\u0dd4 \u0dc3\u0dc4 \u0dc3\u0d82\u0d82\u0d9a\u0dda\ufffd\u0dad \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d89\u0db1\u0dca\u0dc0\u0ddc\ufffd\u0ddc\u0dba\u0dd2\u0dc3\u0dd2\u0dba\u0dda\u024f \u0d85\u0db1\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dd2\u0d9a \u0d85\u0d82\u0d82\u0d9a\u0dba\u0da7 \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0d89\u0da9\u0d9a\u0dca (space) \u0d85\u0da9\u0d82\u0d82\u0d9c\u0dd4 \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0d85\u0dad\u0dbb \u0d85\u0d9a\u0dca\u0dc2\u0dbb \u0dc4\u0dad\u0dc5\u0dd2\u0dc4\u0d9a\u0da7 (40) \u0dc3\u0dd3\u0db8\u0dcf\u0dcf \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba.",
