    "text": "\u0d8c. \u0d9c\u0dd9\ufffd\u0dc0\u0dd3\u0db8\u0dca \u0d9a\u0dbb\u0db1 \u0d86\u0d9a\u0dcf\u0dcf\u0dbb\u0dba - \u0d9c\u0dd9\ufffd\u0dc0\u0dd3\u0db8\u0dca \u0d9a\u0dbb\u0db1 \u0d86\u0d9a\u0dcf\u0dcf\u0dbb\u0dba \u0db8\u0dd4\u0daf\u0dbd\u0dd2\u0db1\u0dca \u0daf, \u0db6\u0dd0\u0d82\u0d82\ufffd\u0d9a\u0dd4 \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0d9a\u0dca \u0dc4\u0dbb\u0dc4\u0dcf\u0dcf \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db8\u0dcf\u0dcf\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0daf, \u0da0\u0dd9\u0dd9\u0d9a\u0dca\u0db4\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0daf, \u0dab\u0dba/\u0dc4\u0dbb \u0d9a\u0dcf\u0dcf\u0da9\u0dca\u0db4\u0dad\u0d9a\u0dd2\u0db1\u0dca \u0daf, \u0da2\u0d82\u0d82\u0d9c\u0db8 \u0db8\u0dd9\ufffd\u0dc0\u0dbd\u0db8\u0d9a\u0dca \u0db7\u0dcf\u0dcf\u0dc0\u0dd2\u0dad\u0dba\u0dd9\ufffd\u0db1\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d9c\u0dd9\ufffd\u0dc0\u0dd3\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0db8\u0dcf\u0dcf\u0dbb\u0dca\u0d9c\u0d9c\u0dad \u0d9c\u0dd9\ufffd\u0dc0\u0dd3\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0daf \u0dba\u0db1 \u0dc0\u0d9c \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dba. \u0db6\u0daf\u0dd4 \u0d89\u0db1\u0dca\u0dc0\u0ddc\ufffd\u0ddc\u0dba\u0dd2\u0dc3\u0dd2\u0dba \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0daf\u0dd3 \u0d9c\u0dd9\ufffd\u0dc0\u0dd3\u0db8\u0dca \u0d9a\u0dbb\u0db1 \u0d86\u0d9a\u0dcf\u0dcf\u0dbb\u0dba \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0d9c\u0dd2\u0d9a \u0db1\u0ddc\ufffd\u0ddc\u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0daf\u0dd3 \u0d9c\u0dd9\ufffd\u0dc0\u0dd3\u0db8\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0db4\u0dda\u0dda\u0dda\u0d9a\u0dca\u0dc2\u0dcf\u0dcf \u0d9a\u0dbb\u0db1 \u0d86\u0d9a\u0dcf\u0dcf\u0dbb\u0dba \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dc5 \u0dc4\u0dd0\u0dd