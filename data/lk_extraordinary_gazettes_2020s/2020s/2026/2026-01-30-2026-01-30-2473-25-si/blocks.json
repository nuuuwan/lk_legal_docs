    "text": "\u0d91\u0dc3\u0dda\ufffd\u0dda \u0dc0\u0dd4\u0dc0 \u0daf, \u0db8\u0dd9\ufffd\u0db8 \u0db1\u0dd2\u0dba\u0ddd\ufffd\u0ddd\ufffd\u0d9c\u0dba \u0dba\u0da7\u0dad\u0dda\ufffd \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dba\u0dda\u0dda\u024f \u0db1\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad \u0d9a\u0dbb\u0dc0\u0db1 \u0dbd\u0daf \u0dba\u0db8\u0dca \u0dc3\u0dca\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dba\u0d9a\u0d9c\u0dda\u0dda\u0118 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0db8\u0dd4\u0dbb\u0dba \u0db4\u0dc3\u0dca\u0dca\u0dc0\u0dbb\u0dd4 \u0dc4\u0dba\u0dad\u0dca \u0db4\u0dc3\u0dd4\u0daf\u0dcf\u0dcf \u0db4\u0dd9\u0dd9\u0dbb\u0dc0\u0dbb\u0dd4 \u0dc4\u0dba\u0dad\u0dca \u0d85\u0dad\u0dbb \u0dc0\u0dda\u0dda\u0dda\u0dbd\u0dcf\u0dcf\u0dc0\u0d9a \u0daf\u0dd3 \u0d85\u0dc0\u0dc3\u0db1\u0dca\u0dc0\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0d9a \u0daf\u0dd3, \u0d91\u0d9a\u0dd3 \u0dc3\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf \u0db8\u0dd4\u0dbb\u0dba \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc0\u0dd6 \u0d85\u0dc0\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda \u0dc3\u0dd2\u0da7 \u0db4\u0dd9\u0dd9\u0dbb\u0dc0\u0dbb\u0dd4 \u0dc4\u0dba \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d91\u0db8 \u0dc3\u0dca\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dba\u0da7 \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4 \u0db1\u0dc0\u0dcf\u0dcf\u0dad\u0dd0\u0dd0\u0db1\u0d9a\u0dca \u0dc3\u0dd0\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0dc4\u0ddd\ufffd\u0ddd\ufffd \u0d91\u0db8 \u0dc3\u0dca\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dda\u0dda\u0118 \u0dc3\u0dd4\u0db4\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0dc0\u0dcf\u0dcf\u0dc3\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dcf\u0dc4\u0db1 \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0dd0\u0dd0\u0db4\u0dba\u0dd3\u0db8 \u0d87\u0dad\u0dd4\u0dc5\u0dd4\u0dc0 \u0d91\u0db8 \u0dc3\u0dca\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dba\u0d9c\u0dda\u0dda\u0118 \u0dc3\u0dde\ufffd\u0dde\u0d9b\u0dca\u200d\u0dba\u0dcf\ufffd\