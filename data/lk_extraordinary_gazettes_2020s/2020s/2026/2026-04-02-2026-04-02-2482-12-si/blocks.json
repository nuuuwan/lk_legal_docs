    "text": "\u0dc3\u0db8\u0dca\u0db6\u0dcf\u0dcf \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0dc0\u0dd9\u0dd9\u0dc5\u0dd2\u0db1\u0dca \u0d86\u0daf\u0dda\u0dda\u0dc1\u0d9a \u0dc3\u0dda\ufffd\u0dda \u0dc3\u0dc5\u0d9a\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0dc3\u0dc4 \u0dc3\u0d82\u0d82\u0dba\u0ddd\ufffd\u0ddd\u02ea\u0da2\u0dd2\u0dad \u0dc0\u0dbb\u0dca\u0d9c\u0dd3\u0d9a\u0dbb\u0dab \u0d9a\u0dda\ufffd\u0dad\u0dcf\u0d82\u0d82\ufffd\u0d9a 1006.30.29 \u0dba\u0da7\u0dad\u0dda\ufffd \u0dc0\u0dbb\u0dca\u0d9c\u0dd3\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dbb \u0d87\u0dad\u0dd2, \u0db4\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0db1\u0dd2 \u0dc3\u0db8\u0dca\u0db6\u0dcf\u0dcf \u0dc3\u0dc4 \u0d9a\u0dd2\u0dbb\u0dd2/\u0db4\u0dcf\u0dcf\u0dbd\u0dca \u0db4\u0ddc\ufffd\u0ddc\u0db1\u0dca\u0db1\u0dd2 \u0dc3\u0dc4\u0dbd\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dd4\u0dc0 GR 11 \u0dc3\u0dc4\u0dbd\u0dca \u0dbd\u0dd9\ufffd\u0dc3 \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0db1 \u0dc3\u0dc4\u0dbd\u0dca \u0dc0\u0dbb\u0dca\u0d9c\u0dba \u0d86\u0db1\u0dba\u0db1\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d86\u0db1\u0dba\u0db1 \u0db4\u0dcf\u0dcf\u0dbd\u0db1 \u0db6\u0dbd\u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda\u024f \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dba\u0dad\u0dcf\u0dcf\u0dc0\u0dba \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd0\u0db6\u0dda\u0229. \u0d9a\u0dd9\ufffd\u0dc3\u0dda\ufffd\u0dda \u0dc0\u0dd9\u0dd9\u0dad\u0dad\u0dca, \u0db8\u0dd9\ufffd\u0db8 \u0dbb\u0dd9\u0dd9\u0d9c\u0dd4\u0dbd\u0dcf\u0dcf\u0dc3\u0dd2 \u0dba\u0da7\u0dad\u0dda\ufffd, \u0d91\u0d9a\u0dca \u0d86\u0db1\u0dba\u0db1\u0d9a\u0dbb\u0dd4\u0dc0\u0dd9\u0dd9\u0d9a\u0dd4\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0dcf\u0dcf \u0dc3\u0dc4 \u0d9a\u0dd3\u0dbb\u0dd2 \u0dc3\u0db8\u0dca\u0db6\u0dcf\u0dcf \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d86\u0daf\u0dda\u0dda\u0dc1\u0d9a \u0dc3\u0dda\ufffd\u0dda \u0dc3\u0dc5\u0d9a\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0db4\u0ddc\ufffd\u0