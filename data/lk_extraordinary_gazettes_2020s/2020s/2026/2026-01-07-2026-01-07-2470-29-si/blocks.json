  {
    "page_number": 0,
    "bbox": [
      315.63,
      377.23,
      558.14,
      568.58
    ],
    "text": "\u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4 \u028f\u023d\u0d9a\u025e \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8, \u0d85\u01b1\u025e\u0119\u025c\u0dba; \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d91\u023c. \u0d91\u0262. \u0dd9\u0db4\u0dd9\u0259\u0dbb\u0dcf \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d89\u0da9\u0db8 \u0dc3\u0dc4 \u0d85\u01b1\u025e\u0119\u025c\u0dba \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4 \u028f\u023d\u0d9a\u025e \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8 ; \u0daf\u00fd\u0dab\u0da7: \u0d85\u01b1\u025e\u0119\u025c\u0dba \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d91\u023c.\u0d91\u0262. \u0dd9\u0db4 \u0dd9\u0259\u0dbb\u0dcf \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d89\u0da9\u0db8, \u0dc3\u0dc4 \u0d85\u01b1\u025e\u0119\u025c\u0dba \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u0dc3\u0dc4 \u028f\u023d\u0d9a\u025e \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u0dc3\u0dc4 \u028f\u023d\u0d9a\u025e \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8; \u0db6\u0da7\u028f\u0dbb\u0da7 : \u0d89\u0da9\u0db8 \u0dc3\u0dc4 \u0d89\u0da9\u0dd9\u023c \u0db1\u0db8 \u0dc3\u0dc4 \u028f\u023d\u0d9a\u025e \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u0d89\u0da9\u0db8 \u0dc3\u0dc4 \u0d85\u01b1\u025e\u0119\u025c\u0dba \u0db4\u0dcf\u0dd9\u0259 \u0dc0\u025c\u0db4\u0db1\u023c \u0d85\u0d82\u0d9a\u0dba \u0dd9\u0dc3\u0dcf\u0dba\u0dcf\u0d9c\u0dad \u0dd9\u0db1\u0dcf\u0dc4\u0dd0\u00fb \u017a. \u0dd9\u00fa. \u026a\u0dad\u0dcf\u0db1\u0dd9\u0118 \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0d89\u0da9\u0db8 \u0dd9\u0d9a\u0dca. \u0da9\u0dd3. \u0dbd\u0dcf\u0dbd\u0dca \u0d9a\u0dcf\u0db1\u0dca\u0dad, \u0d9a\u0dd8\u027f\u0d9a\u0259\u0db8, \u0db4\u0276 \u0dc3\u023c\u0db4\u01ae, \u0d89\u0da9\u023c \u0dc3\u0dc4 \u0dc0\u0dcf\u025c\u0db8\u0dcf\u0259\u0d9c \u0d85\u0db8\u0dcf\u0dad\u0255.",
