    "bbox": [
      48.0,
      448.18,
      542.52,
      509.65
    ],
    "text": "I, Hanif Yusoof, the Governor of the Western Province, according to the powers vested upon me under the Section 32 (1) of the Western Provincial Council Act No. 42 of 1987, hereby notify that with effect from 05.01.2026, Mrs. Weerasinghe Mudiyanselage Bhagya Lakmali Weerasinghe of the Sri Lanka Administrative Service Class II, has been appointed for acting duties to the post of Western Province Commissioner of the Co-operative Development and Registrar of the Co-operative Societies.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
