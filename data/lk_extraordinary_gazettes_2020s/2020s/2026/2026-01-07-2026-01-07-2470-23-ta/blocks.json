    "text": "\u0b95\u0bb2\u0bbe\u0bbe\u0ba8\u0bbf\u0bbf\u0ba4\u0bbf\u0bbf \u0b8e\u0ba9\u0bcd. \u0b8e\u0bb8\u0bcd. \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0bcd\u0b95\u0b8e\u0ba9\u0bcd. \u0b8e\u0bb8\u0bcd. \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0bcd\u0b95, \u0b9a\u0ba9\u0bbe\u0bbe\u0ba4\u0bbf\u0bbf\u0baa\u0ba4\u0bbf\u0bbf\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0b9a\u0bc6\u0bc6\u0baf\u0bb2\u0bbe\u0bbe\u0bb3\u0bb0\u0bcd.\u0b95\u071b\u0bca\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1 01,\u0b9a\u0ba9\u0bbe\u0bbe\u0ba4\u0bbf\u0bbf\u0baa\u0ba4\u0bbf\u0bbf \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0b95\u0bae\u0bcd,2026 \u0b9a\u0ba9\u0bb5\u0bb0\u0bbf\u0bbf \u0bae\u0bbe\u0bbe\u0ba4\u0bae\u0bcd 06 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bbf\u0b95\u0ba4\u0bbf\u0bbf.",
