    "text": "\u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0d8b\u0dad\u0dd4\u0dbb - \u0db4\u0dcf\u0dcf\u0daf\u0dd4\u0db8\u0dca\u0db6\u0dbb \u0d92\u0d9a\u0dcf\u0db6\u0dca\u0db0 \u0da2\u0dcf\u0dbd \u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0dc0\u200d\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba\u0dda \u0dc5\u0dd4\u0d9c\u0db8\u0d9c\u0db8\u0dca\u0db8\u0db1 \u0dba\u0db4\u0ddc\u0db8\u0dca\u0db4\u0dcf\u0d9c\u0dcf\u0dbb\u0dba \u0d89\u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db8 \u0dc3\u0dcf\u0dc4\u0dcf \u0d85\u0dad\u0dd2\u0dba\u0dbb\u0dca\u0d9a \u0d89\u0da9\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0d85\u0dda\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u200d \u0db4\u0dc4\u0dcf \u0daf\u0dd0\u0d9a\u0dca\u0dba\u0dc0\u0db1 \u0d89\u0da9\u0db8 \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0d9a\u0dbb\u0db1 \u0db6\u0dd0\u0dc0\u0dca, 1964 \u0d85\u0d82\u0d9a 28 \u0daf\u0dbb\u0db1 \u0d89\u0da9\u0db8\u0dca \u0d85\u0dda\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dba\u0db8\u0dca (\u0dc3\u0d82\u0dba\u0dc1\u0ddd \u0db1) \u0db4\u0db1\u0dad\u0dd2\u0dca\u0dad \u0dc3\u0d82\u0dba\u0dc1\u0ddd\u0db0\u0dd2\u0dcf \u0db4\u0dbb\u0dd2\u0d9a\u0dd2 \u0d89\u0da9\u0db8\u0dca \u0d85\u0dda\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0dba\u0db8\u0dca \u0db4\u0db1\u0dba\u0dda 7 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba\u0dda (1) \u0dc0\u0dd0\u0db1\u0dd2 \u0d8b\u0db4\u0dc0\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dba\u0dda \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd3 \u0dc3\u0dd2\u0daf\u0da7\u0dd2\u0db8\u0dd2. \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db6\u0dbd\u0dcf\u0dba\u0db4\u0ddc\u0dba\u0dbb\u0ddc\u0dda\u0dad\u0dd4\u0dc0\u0db1 \u0d89\u0da9\u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb:- \u0db8 \u200d\u0db8 \u0db4\u0dcf\u0dcf\u0dba\u0dda, \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0d9a\u0dd2\u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0dc4\u0dcf\u0dbb\u0dd2\u0dc3\u0dca\u0db4\u0dda\u0dad\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dba \u0dba \u0dba\u0db8\u0d9a\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba\u0dda, \u0dc5\u0dd4\u0d9c\u0db8\u0d9c\u0db8\u0dca\u0db8\u0db1 \u0dc3\u0dd2\u0daf\u0dba\u0db4\u0dda\u0dad\u0dd4\u0dc0 \u0dc5\u0dd4\u0d9c\u0db8 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba\u0dda \u0d85\u0d82\u0d9a 447, \u0dc5\u0dd4\u0d9c\u0db8\u0d9c\u0db8\u0dca\u0db8\u0db1 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbd \u0dcf\u0dbb\u0dd2 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc3\u0dba\u0dda \u0dc5\u0dd4\u0d9c\u0db8\u0d9c\u0db8\u0dca\u0db8\u0db1 \u0d9c\u0dba\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0d9a\u0dd2\u0dc3\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dba\u0da2\u0dcf\u200d\u0dc2\u0dca\u0dc3 \u0db8\u0dd2\u0db1\u0dd2\u0dca\u0dad\u0dba\u0daf\u0ddd\u0dbb\u0dd4 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2 \u0dc0\u0dd2\u0dc3\u0dd2\u0daf\u0dca\u0dad \u0db8\u0dd0\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0dba\u0dcf \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a 320505 \u0daf\u0dbb\u0db1 \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0dba\u0db8\u0dca \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0d82\u0d9a 07 \u0dc4\u0dd2 \u0db4\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d9a2 \u0dc4\u0dd2 \u0d89.\u0dc0\u0dd2.\u0dbd\u0dd0 1 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1 \u0dba\u0dbd\u0dc3 \u0daf\u0dd0\u0d9a\u0dca\u0dba\u0dc0\u0db1 \u0db4\u0dc4\u0dcf \u0dc0\u0dd2\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dcf\u0dc4\u0dca\u0dad \u0d89\u0da9\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dc3\u0da7 \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca :",
