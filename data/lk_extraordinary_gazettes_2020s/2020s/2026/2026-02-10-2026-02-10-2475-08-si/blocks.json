    "text": "\u0db1\u0dd2\u0da7\u0dca\u0da7\u0db9\u0dd4\u0dc0 \u0db4\u0dc3\u0dca\u0dba\u0dcf\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dc0\u200d\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0dc3\u0dcf\u0dc4\u0dcf \u0d85\u0d82\u0d9a 2254/27 \u0daf\u0dbb\u0db1 2021 \u0dba\u0db1\u0ddc\u0dc0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 17 \u0dc0\u0dd0\u0db1\u0dd2 \u0db6\u0daf\u0dcf\u0daf\u0dcf \u0d9a\u0dd2\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dcf\u0dcf\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dcf\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0dcf\u0db1\u0dbb\u0da2\u0dcf\u0dba\u0dda \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dba\u0dc1\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda 15\u0d92 \u0db4\u0dd2\u0da7\u0dd4\u0dba\u0dc0\u0dc4\u0dd2 \u0db7\u0dcf\u0dc2\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dba\u0dba\u0dca\u0dad \u0db4\u0dcf \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0dbb\u0dca\u0dba\u0dc0\u0dca\u0dba\u0dbb\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0db8 \u0dc0\u0dd2\u0dc3\u0dd2\u0daf\u0dca\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf 2021.09.01 \u0d9a\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0dc4\u0dcf \u0d9a\u0dd0\u0da9\u0dd0\u0dc3\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0db8\u0dca \u0d85\u0d82\u0d9a 510607 \u0dc4\u0dd2 \u0d9a\u0dbd\u0dcf\u0db4 01 \u0db4\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d9a 16 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 513, 514 \u0dc0\u0dc1\u0dba\u0dba\u0dca\u0dad \u0dba\u0db4\u0dca\u0dad\u0db1\u0dd4\u0db8\u0dca \u0d9a\u0dbb \u0d9a\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dba\u0dba\u0dba\u0dca\u0dad \u0dba\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 0.2168 \u0d9a\u0dca \u0dc0\u0dd6 \u0d89\u0da9\u0dba\u0db8\u0dca \u0db4\u0dc4\u0dcf \u0dc3\u0dcf\u0dc4\u0dca\u0dad \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a \u0db4\u0dc4\u0dcf \u0db4\u0dbb\u0dd2\u0d9a\u0dd2 \u0dc3\u0d82\u0dba\u0