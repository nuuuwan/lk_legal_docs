    "text": "\u2022 \u0dbb\u0dad\u0dca\u0db8\u0dbd\u0dcf\u0dcf\u0db1, \u0d9a\u0db3\u0dc0\u0dbd \u0db4\u0dcf\u0dcf\u0dbb\u0dda\u0dda\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dc3\u0dda\u02e6\u0dda\u0dc0\u0dcf\u0dcf \u0db4\u0dd4\u0dc4\u0dd4\u0dab\u0dd4 \u0db8\u0db0\u0dca\u200d\u0dba\u0dba\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba, \u0d91\u0dc4\u0dd2 \u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9c\u0dd2\u0dbd\u0dd2 \u0dc3\u0dc4 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0d8a\u0da7 \u0d86\u0db6\u0daf\u0dca\u0db0 \u0d89\u0da9\u0db8\u2022 \u0dbb\u0dad\u0dca\u0db8\u0dbd\u0dcf\u0dcf\u0db1, \u0d85\u0dad\u0dca\u0dad\u0dd2\u0da9\u0dd2\u0dba\u0dda\u0dda\u024f \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0d9c\u0d9c\u0db1 \u0db1\u0dcf\u0dcf\u0dc0\u0dd2\u0d9a \u0dc3\u0db1\u0dca\u0db1\u0dd2\u0dc0\u0dda\u0dda\u0dda\u0daf\u0db1 \u0dc3\u0db8\u0dca\u0db4\u0dca\u200d\u0dbb\u0dda\u0dda\u0dda\u0dc2\u0dab\u0dcf\u0dcf\u0d9c\u0dcf\u0dcf\u0dbb\u0dba, \u0d91\u0dc4\u0dd2 \u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9c\u0dd2\u0dbd\u0dd2 \u0dc3\u0dc4 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0d8a\u0da7 \u0d86\u0db6\u0daf\u0dca\u0db0 \u0d89\u0da9\u0db8\u2022 \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0da2\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0db1\u0dca\u0dad\u0dbb \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0ddc\ufffd\u0ddc\u0da7\u0dd4\u0db4\u0dbd \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d9c\u0db8\u0dca\u0db4\u0dc4, \u0db8\u0da9\u0db8\u0dca\u0db4\u0dd0\u0dd0\u0dbd\u0dca\u0dbd\u0dda\ufffd \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0dc3\u0d82\u0d82\u0dad\u0dbb\u0dab \u0d8b\u0db4\u0d9a\u0dcf\u0dcf\u0dbb\u0d9a, \u0d91\u0dc4\u0dd2 \u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9c\u0dd2\u0dbd\u0dd2 \u0dc3\u0dc4 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0d8a\u0da7 \u0d86\u0db6\u0daf\u0dca\u0db0 \u0d89\u0da9\u0db8\u2022 \u0db6\u0dab\u0dca\u0da9\u0dcf\u0dcf\u0dbb\u0db1\u0dcf\u0dcf\u0dba\u0d9a \u0da2\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0dba\u0db1\u0dca\u0dad\u0dbb \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0ddc\ufffd\u0ddc\u0da7\u0dd4\u0db4\u0dbd\u0dd9\ufffd\u0dc4\u0dd2 \u0db0\u0dcf\u0dcf\u0dc0\u0db1 \u0db4\u0dae\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0d9c\u0db8\u0dca\u0db4\u0dc4, \u0db4\u0db8\u0dd4\u0dab\u0dd4\u0d9c\u0db8, \u0d9a\u0dd0\u0dd0\u0db4\u0dd4\u0db1\u0dca\u0d9c\u0ddc\ufffd\u0ddc\u0da9 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0dc3\u0d82\u0d82\u0dad\u0dbb\u0dab \u0d8b\u0db4\u0d9a\u0dcf\u0dcf\u0dbb\u0d9a, \u0d91\u0dc4\u0dd2 \u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9c\u0dd2\u0dbd\u0dd2 \u0dc3\u0dc4 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0d8a\u0da7 \u0d86\u0db6\u0daf\u0dca\u0db0 \u0d89\u0da9\u0db8\u2022 \u0db4\u0dd2\u0daf\u0dd4\u0dbb\u0dd4\u0dad\u0dbd\u0dcf\u0dcf\u0d9c\u0dbd \u0d9a\u0db1\u0dca\u0daf\u0dda\u0dda\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dbb\u0dda\u0dda\u0dda\u0da9\u0dcf\u0dcf\u0dbb\u0dca \u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0db1\u0dba, \u0d91\u0dc4\u0dd2 \u0d9c\u0ddc\ufffd\u0ddc\u0da9\u0db1\u0dd0\u0dd0\u0d9c\u0dd2\u0dbd\u0dd2 \u0dc3\u0dc4 \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0d8a\u0da7 \u0d86\u0db6\u0daf\u0dca\u0db0 \u0d89\u0da9\u0db8\u2022 \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dc3\u0dda\u02e6\u0dda\u0dc0\u0dcf\u0dcf \u0d9a\u0dcf\u0dcf\u0dbb\u0dca\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db1\u0dd2\u0dc0\u0dcf\u0dcf\u0da9\u0dd4 \u0db1\u0dd2\u0d9a\u0dda\ufffd\u0dad\u0db1\u0dba \u0d89\u0daf\u0dd2\u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd9\ufffd\u0db1 \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0daf\u0dd2\u0dc3\u0