    "text": "I. \u0b86\u0ba4\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd : \u0b86\u0ba4\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd : \u0b95\u0ba3\u0bcd\u1f8a \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 - \u0baa\u0bbe\u0ba4\u0bcd\u0ba4\u1f90\u0bae\u0bcd\u0baa\u0bc8\u0bb0 \u0b95\u0ba3\u0bcd\u1f8a \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1 - \u0baa\u0bbe\u0ba4\u0bcd\u0ba4\u1f90\u0bae\u0bcd\u0baa\u0bc8\u0bb0 \u0b92\u0ba9\u0bcd\u0bb1\u0bbf\u0bc8\u0ba3\u0ba8\u0bcd\u0ba4 \u0ba8\u0bc0\u0bb0\u0bcd \u0bb5\u0bbf\u0ba8\u0bbf\u0bc7\u0baf\u0bbe\u0b95 \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bb2\u0bcd\u0bc6\u0bb2\u0ba9\u0bb5\u0ba4\u0bcd\u0ba4 \u0b92\u0ba9\u0bcd\u0bb1\u0bbf\u0bc8\u0ba3\u0ba8\u0bcd\u0ba4 \u0ba8\u0bc0\u0bb0\u0bcd \u0bb5\u0bbf\u0ba8\u0bbf\u0bc7\u0baf\u0bbe\u0b95 \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bb2\u0bcd\u0bc6\u0bb2\u0ba9\u0bb5\u0ba4\u0bcd\u0ba4 \u0bc7\u0b9a\u0bc8\u0bb5\u0ba4\u0bcd \u0ba4\u0b9f\u0bbe\u0b95\u0bae\u0bcd \u0bb5\u0bc8\u0bb0\u0baf\u0bbe\u0ba9 \u0bb5\u0bbf\u0ba8\u0bbf\u0bc7\u0baf\u0bbe\u0b95 \u0b95\u0bc1\u0bb4\u0bbe\u0baf\u0bcd \u0baa\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bc7\u0b9a\u0bc8\u0bb5\u0ba4\u0bcd \u0ba4\u0b9f\u0bbe\u0b95\u0bae\u0bcd \u0bb5\u0bc8\u0bb0\u0baf\u0bbe\u0ba9 \u0bb5\u0bbf\u0ba8\u0bbf\u0bc7\u0baf\u0bbe\u0b95 \u0b95\u0bc1\u0bb4\u0bbe\u0baf\u0bcd \u0baa\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b85\u0b99\u0bcd\u0b95\u0bbf\u1f9e\u0ba8\u0bcd\u1f90 \u0bb5\u0bbf\u0ba8\u0bbf\u0bc7\u0baf\u0bbe\u0b95 \u0b95\u0bc1\u0bb4\u0bbe\u0baf\u0bcd \u0b85\u0bc8\u0bae\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0ba9 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0b85\u0b99\u0bcd\u0b95\u0bbf\u1f9e\u0ba8\u0bcd\u1f90 \u0bb5\u0bbf\u0ba8\u0bbf\u0bc7\u0baf\u0bbe\u0b95 \u0b95\u0bc1\u0bb4\u0bbe\u0baf\u0bcd \u0b85\u0bc8\u0bae\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0