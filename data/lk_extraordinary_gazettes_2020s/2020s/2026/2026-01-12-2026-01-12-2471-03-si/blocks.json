  {
    "page_number": 0,
    "bbox": [
      307.15,
      568.94,
      549.76,
      688.5
    ],
    "text": "01. \u0d9a\u0dd0\u0db6\u0263 \u0d85\u00fa\u0dc2\u0dbb \u2018A\u2019 \u2013 \u00fd\u025e\u0d9a\u0dd0\u0217\u0dd9\u0db4\u0179\u0dba\u0dc0\u01ae\u0dad, \u0dc0\u025c. \u0d85\u0d82\u0d9a 478, \u01e9\u0dc0\u0dbb \u0db4\u0dcf\u0dbb \u2013 \u021d\u0db8\u0dcf\u0dab\u0dba: \u0dd9\u0dc4\u00fa. 0.0172\u0d8b\u01b1\u0dbb\u0da7: \u0d92. \u0d91\u023c. \u0287. \u0d85\u01ae\u0dad\u0db1\u0dcf\u0dba\u0d9a \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0daf\u0d82\u0d9c\u0dc4\u023f\u0dbd\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u0db8\u0dcf\u0259\u0d9c\u0dba (\u0db8\u0dcf.\u0dc3\u0d82.\u0d85.); \u0db1\u0dd0\u0dd9\u0d9c\u0db1\u028f\u0dbb\u0da7: \u0db8\u0dcf\u0259\u0d9c\u0dba (\u0db8\u0dcf.\u0dc3\u0d82.\u0d85.) \u0dc3\u0dc4 \u0dc6\u0dc3\u0dcf\u0262 \u0dc4\u023e\u018a \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u00fd\u025e\u0d9a\u0dd0\u0217\u0dd9\u0db4\u0179\u0dba\u0dc0\u01ae\u0dad; \u0daf\u00fd\u0dab\u0da7: \u0dc6\u0dc3\u0dcf\u0262 \u0dc4\u023e\u018a \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u00fd\u025e\u0d9a\u0dd0\u0217\u0dd9\u0db4\u0179\u0dba\u0dc0\u01ae\u0dad \u0dc3\u0dc4 \u0d91\u0dc3\u0dca. \u022b. \u0dc0\u01ff\u0dbb\u0dcf\u0d9c\u0dbd \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u00fd\u025e\u0d9a\u0dd0\u0217\u0dd9\u0db4\u0179\u0dba\u0dc0\u01ae\u0dad (\u0dc0\u025c. \u0d85\u0d82\u0d9a 478, \u01e9\u0dc0\u0dbb \u0db4\u0dcf\u0dbb); \u0db6\u0da7\u028f\u0dbb\u0da7: \u0d91\u0dc3\u0dca. \u022b. \u0dc0\u01ff\u0dbb\u0dcf\u0d9c\u0dbd \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u00fd\u025e\u0d9a\u0dd0\u0217\u0dd9\u0db4\u0179\u0dba\u0dc0\u01ae\u0dad (\u0dc0\u025c. \u0d85\u0d82\u0d9a 478, \u01e9\u0dc0\u0dbb \u0db4\u0dcf\u0dbb) \u0dc3\u0dc4 \u0d92. \u0d91\u023c. \u0287. \u0d85\u01ae\u0dad\u0db1\u0dcf\u0dba\u0d9a \u028f\u023d\u0d9a\u023c \u00fb\u0dba\u0db1 \u0daf\u0d82\u0d9c\u0dc4\u023f\u0dbd\u0dc0\u01ae\u0dad.",
