  {
    "page_number": 0,
    "bbox": [
      54.02,
      559.9,
      533.3,
      585.37
    ],
    "text": "1 . These Rules shall be cited as the \u201cRepatriation of Export Proceeds into Sri Lanka Rules No. 01 of 2026\u201d and shall come into effect on which date these Rules are approved by the Parliament.",
    "fonts": [
      "IskoolaPota",
