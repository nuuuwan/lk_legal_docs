    "text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d82\u0d9a\u0dcf\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dcf\u0dad\u0dcf\u0dcf\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0dcf\u0da2\u0dc0\u0dcf\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dba\u0dda\u024f \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dca\u200d\u0dbb\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dba\u0dc0\u0dc3\u0dca\u0dca\u0dae\u0dcf\u0dcf\u0dc0\u0dda\u0dda\u0dda 13 \u0dc0\u0db1 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\ufffd\u0db0\u0db1\u0dba\u0dda\u024f 154 \u0d8a (1) \u0dc4\u0dcf\u0dcf (2) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dc0\u0dbd \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0 \u0dc3\u0dc4 1987 \u0d85\u0d82\u0d82\u0d9a 42 \u0daf\u0dbb\u0db1 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf \u0db4\u0db1\u0dad\u0dda\ufffd \u0d85\u0d82\u0d82\u0d9a 32(1) \u0dc0\u0d9c\u0db1\u0dca\u0dad\u0dd2\u0dba\u0dda\u024f \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0dc0\u0dd2\u0db0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0dcf\u0db1 \u0dba\u0da7\u0dad\u0dda\ufffd \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db8\u0dd0\u0dd0\u0daf \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0d9c\u0dbb\u0dd4 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dcf\u0dcf\u0dbb\u0dad\u0dd4\u0db8\u0dcf\u0dcf \u0dc0\u0dd9\u0dd9\u0dad \u0db4\u0dd0\u0dd0\u0dc0\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbd\u0dad\u0dbd \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dcf\u0dbb\u0dc0, \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0dcf \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca 2026.02.01 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0db8\u0dd0\u0dd0\u0daf \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0da7 \u0d85\u0dba\u0dad\u0dca \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0d82\ufffd\u0d82\u0dc1 05 \u0dc4\u0dd2 \u0dc0\u0dd2\u0dc2\u0dba\u0db1\u0dca \u0db4\u0dc4\u0dad \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u0dcf \u0d87\u0dad\u0dd2 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0dc3\u0d82\u0d82\u0dc1\u0ddd\u02e4\u0ddd\ufffd\u0db0\u0db1\u0dba \u0d9a\u0dbb \u0d91\u0db8 \u0db1\u0dc0 \u0db4\u0dc5\u0dcf\u0dcf\u0dad\u0dca \u0d85\u0db8\u0dcf\u0dcf\u0dad\u0dca\u200d\u0dba\u0d82\ufffd\u0d82\u0dc1\u0dc0\u0dbd \u0dbd\u0dda\u0dda\u0262\u0d9a\u0db8\u0dca \u0dad\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0db4\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0d9c\u0dbb\u0dd4 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dcf\u0dcf\u0dbb\u0dad\u0dd4\u0db8\u0dcf\u0dcf\u0d9c\u0dda\u0dda\u0118 \u0d8b\u0db4\u0daf\u0dd9\u0dd9\u0dc3\u0dca \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0db8\u0dd9\ufffd\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dda\u0dda\u0dda\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2.",
