    "text": "\u0bb5\u0b9f\u0bae\u0bc7\u0bb2\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0bb0\u0bc1\u0ba8\u0bbe\u0b95\u0bb2\u0bcd \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b89\u0b9f\u0bc1\u0baa\u0ba4\u0bcd\u0ba4\u0bbe\u0ba4\u0bcd\u0ba4\u0bbe\u0bb5 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0bc6\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, 1508 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0ba4\u0ba4\u0bcd\u0ba4\u0bc8\u0baf\u0bc1\u0b9f\u0bc8\u0baf \u0bb5\u0bb2\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0b95\u0bae \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0bb5\u0bb2\u0bcd\u0baa\u0bbf\u0bbf\u0b9f\u0b95\u0bae \u0b95\u0bbf\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0ba8\u0bbf\u0bbf\u0bb2 \u0b85\u0bb3\u0bb5\u0bc8\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0ba8\u0bbe\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0ba4\u0ba4\u0baf\u0bbe\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0b9f \u0b86\u0bb0\u0bae\u0bcd\u0baa \u0bb5\u0bb0\u0bc8\u0baa\u0b9f \u0b87\u0bb2. KU/UDB/2023/382 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0ba4\u0ba4\u0bcd\u0ba4\u0bc8\u0baf\u0bc1\u0bae\u0bcd 2024.03.04 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0ba4\u0bbf\u0baf\u0bbf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0b9f \u0bae\u0bc1\u0ba4\u0bb1\u0bcd \u0b9a\u0bc1\u0bb5\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb0\u0bc8\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0bbf\u0baa\u0bb0\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb3 \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0bbe\u0ba9 \u0b8e\u0bb2\u0bcd\u0bb2\u0bc8\u0b95\u0bb3\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0bb5\u0bbf\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bbe\u0bb1\u0bc1: 01. \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u2018\u0b85\u2019 \u2013 \u0b95\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bbf\u0baf\u0bb5\u0ba4\u0ba4\u0bcd\u0ba4 \u2013 \u0bb5\u0bbf\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.1250 01. \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1 \u2018\u0b85\u2019 \u2013 \u0b95\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bbf\u0baf\u0bb5\u0ba4\u0ba4\u0bcd\u0ba4 \u2013 \u0bb5\u0bbf\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u0bae\u0bcd: 0.1250 \u0bb9\u0bc6\u0b95\u0bcd\u0b9f\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd\u0bb9\u0bc6\u0b95\u0bcd\u0b9f\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0b9f\u0b95\u0bcd\u0b95\u0bc1: \u0baa\u0bbe\u0ba4\u0bc8 (\u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8) ; \u0b95\u0bbf\u0bbf\u0bb4\u0b95\u0bcd\u0b95\u0bc1: \u0baa\u0bbe\u0ba4\u0bc8 (\u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0b9a \u0b9a\u0baa\u0bc8); \u0ba4\u0bc6\u0bb1\u0bcd\u0b95\u0bc1 : \u0baa\u0bc0.\u0b8f. \u0b9a\ufffd\u0bcb\u0bae\u0bb5\u0ba4\u0bbf\u0ba4\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b8f\u0ba9\u0bc8\u0baf\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b89\u0bb0\u0bbf\u0bae\u0bc8 \u0b95\ufffd\u0bcb\u0bb0\u0bc1\u0bae\u0bcd \u0b95\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bbf\u0baf\u0bb5\u0ba4\u0ba4\u0bcd\u0ba4 ; \u0bae\u0bc7\u0bb1\u0bcd\u0b95\u0bc1: \u0b8e\u0b9a\u0bcd.\u0b8f. \u0b85\u0ba9\u0bc1\u0baa\u0bae\u0bbe \u0ba4\u0bbf\u0ba4\u0bbf\u0bb2\u0bcd\u0bb9\u0bbe\u0bb9\u0bbe\u0ba9\u0bbf\u0bbf \u0b95\u0bb0\u0bc1\u0ba3\u0bbe\u0bb0\u0ba4\u0bcd\u0ba9\u0ba9 \u0b89\u0bb0\u0bbf\u0bae\u0bc8 \u0b95\ufffd\u0bcb\u0bb0\u0bc1\u0bae\u0bcd \u0b95\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bbf\u0baf\u0bb5\u0ba4\u0ba4\u0bcd\u0ba4.",
