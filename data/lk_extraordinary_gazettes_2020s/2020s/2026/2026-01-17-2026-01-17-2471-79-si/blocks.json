a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 260 \u0dc4\u0dd2 \u0d85\u0d82\u0d9a 146/\u0db6\u0dd3/2/\u0db6\u0dd3, \u0dc3\u0dd6\u0dbb\u0dd2\u0dba\u0db4\u0dcf\u0dbd\u0dd4\u0dc0, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0d9a\u0da9\u0dc0\u0dad \u0dc3\u0db8\u0d9f \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d89\u0dad\u0dd2\u0dbb\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0dad\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0d82\u0d9a 2721 \u0dc4\u0dcf 2025.02.20 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d8b\u0d9a\u0dc3\u0dca \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0dd9\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1 : 256 0.0087 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0db1\u0dd0\u0dad \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 257 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0db8\u0da7 1 : 260 0.0360 \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0dbd\u0dd2\u0dba\u0db1\u0dd9\u0d9c\u0dca \u0da0\u0dad\u0dd4\u0dbb \u0dbd\u0d9a\u0dd2\u0db3\u0dd4 743510828V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0d85\u0d82\u0d9a 490/\u0dc3\u0dd3, \u0dc0\u0dd1\u0db6\u0da9 \u0db6\u0da7\u0dc4\u0dd2\u0dbb, \u0dc0\u0dd1\u0db6\u0da9 1 : 263 0.0324 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc3\u0db8\u0dd3\u0dbb 881281953V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a259 \u0dc4\u0dd2 \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0d9a\u0dd4\u0db8\u0dcf\u0d