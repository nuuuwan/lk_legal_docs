u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0dd9\u0d9c\u0ddd\u0db1\u0dd9\u0dc4\u0dda\u0db1, \u0d9a\u0da9\u0dc0\u0dad \u0dad\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0db4.\u0dd9\u0db1\u0ddc. \u0dc3\u0dd3. \u0dc0\u0dd2\u0dd9\u0da2\u0dca\u0dc3\u0dd2\u0d82\u0dc4\u0dd9\u0d9c\u0dca \u0d85\u0d82\u0d9a 2674 \u0dc4\u0dcf 2016.02.25 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d8b\u0d9a\u0dc3\u0dca \u0d9c\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0dd9\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1 : 143 0.1054 \u0daf\u0dc4\u0db1\u0dcf\u0dba\u0d9a\u0dd9\u0d9c\u0dca \u0dc3\u0dd3\u0dad\u0dcf \u0d89\u0db1\u0dca\u0daf\u0dcf\u0db1\u0dd2 \u0dd9\u0dc4\u0dc0\u0dad\u0dca 725431210V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 203 \u0dc4\u0dd2 \u0dc3\u0dd3\u0dad\u0dcf \u0d89\u0db1\u0dca\u0daf\u0dcf\u0db1\u0dd2 \u0daf\u0dc4\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0d85\u0d82\u0d9a 449/\u0db6\u0dd3, \u0dc3\u0db8\u0d9f \u0dd9\u0d9c\u0ddd\u0db1\u0dd9\u0dc4\u0dda\u0db1, \u0d9a\u0da9\u0dc0\u0dad 1 : 145 0.1442 \u0dc3\u0dd4\u0dbb\u0d82\u0d9c \u0dd9\u0d9a\u0dde\u0dc1\u0dbd\u0dca\u200d\u0dba \u0daf\u0dc4\u0db1\u0dcf\u0dba\u0d9a 197335900726 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 178 \u0dc4\u0dd2 \u0d85\u0d82\u0d9a 449/\u0dc3\u0dd3, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dd9\u0d9c\u0ddd\u0db1\u0dd9\u0dc4\u0dda\u0db1, \u0d9a\u0da9\u0dc0\u0dad \u0dc3\u0db8\u0d9f 1 : 181 0.0185 \u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dd9\u0d9c\u0dca \u0dc3\u0dd4\u0dd9\u0dbb\u0dca\u0dc2\u0db1 832811483V \u0dc3\u0db8\u0dca\u0db4\u0dd