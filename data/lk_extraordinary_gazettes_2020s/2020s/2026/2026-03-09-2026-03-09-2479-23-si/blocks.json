    "text": "\u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0db8\u0dc4 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0, \u0d9a\u0da9\u0dd4\u0d9c\u0db1\u0dca\u0db1\u0dcf\u0dcf\u0dc0 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0, \u0dc0\u0dad\u0dca\u0dad\u0dda\ufffd\u0d9c\u0db8 \u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dcf\u0dc0, \u0d9c\u0d9f\u0dc0\u0da7\u0d9a\u0ddd\ufffd\u0ddd\u02ea\u0dbb\u0dc5\u0dda\u0dda\u02e8\u0dda \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0, \u0dba\u0da7\u0dd2\u0db1\u0dd4\u0dc0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0, \u0d85\u0d9a\u0dd4\u0dbb\u0dab \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0, \u0d9a\u0dd4\u0dab\u0dca\u0da9\u0dc3\u0dcf\u0dcf\u0dbd\u0dda\u0dda\u0262 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0, \u0dad\u0dd4\u0db8\u0dca\u0db4\u0db1\u0dda\ufffd \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0\u0dd9\u0dd9\u0db1\u0dca \u0d9a\u0ddc\ufffd\u0ddc\u0da7\u0dc3\u0d9a\u0dca, \u0dc4\u0dcf\u0dcf\u0dbb\u0dd2\u0dc3\u0dca\u0dca\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0, \u0db4\u0dcf\u0dcf\u0dad\u0dc4\u0dda\ufffd\u0dda\u0dc0\u0dcf\u0dcf\u0dc4\u0dd0\u0dd0\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0, \u0d8b\u0da9\u0dd4\u0db1\u0dd4\u0dc0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dc3\u0dc4 \u0db4\u0dcf\u0dcf\u0dad\u0daf\u0dd4\u0db8\u0dca\u0db6\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dcf\u0daf\u0dda\u0dda\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dcf\u0dc0 \u0dba\u0db1 \u0db6\u0dbd \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dda\u0dda\u0dc1 \u0dc3\u0db3\u0dc4\u0dcf\u0dcf \u0dc0\u0db1 \u0dc0\u0dd2\u0dc3\u0dbd\u0dca \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0db1\u0d9c\u0dbb \u0dc3\u0dd0\u0dd0\u0dbd\u0dd0\u0dd0\u0dc3\u0dca\u0dca\u0db8 \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8",
