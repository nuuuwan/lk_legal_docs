    "page_number": 0,
    "bbox": [
      55.15,
      668.59,
      298.21,
      718.66
    ],
    "text": "01. Lot \u2018A\u2019 \u2013 Thalagahawatta \u2013 Extent: 0.3110 Hectare North: Sri Jayanthi Mawatha, Road and Thalagahawatta of which the Assmt. No. cannot be traced in Sri Jayanthi Mawatha of which the claimant cannot be traced; East:",
    "fonts": [
      "TimesNewRomanPS-BoldMT",
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
