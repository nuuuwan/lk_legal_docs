    "text": "\u200b\u0baa\ufffd\u0bca\u0bb2\u0bcd\u0b95\u0bb9\u0bb5\ufffd\u0bb2 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a\u0baa\ufffd\u0bca\u0bb2\u0bcd\u0b95\u0bb9\u0bb5\ufffd\u0bb2 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0ba4\u0bc6\u0bc6\u0bb0\u0bbf\u0bbf\u0bb5\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0bb0\u0ba4\u0bcd\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0ba4\u0bbf\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bc7\u0bb2\u0bbe\u0bbe\u0b95\u0bc7\u0bc7 \u0bb9\u0bb0\u0bc7\u0bc7\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0 \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0 \u0bb0\u0ba4\u0bcd\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0b9a\u0baa\u0bc8\u0bc8\u0baf\u0bbf\u0bbf\u0ba9\u0bcd \u0ba4\u0bc6\u0bc6\u0bb0\u0bbf\u0bbf\u0bb5\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0bbf \u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0bb0\u0bcd \u0bb0\u0ba4\u0bcd\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0ba4\u0bbf\u0bbf\u0baf\u0ba9\u0bcd\u0b9a\u0bc7\u0bc7\u0bb2\u0bbe\u0bbe\u0b95\u0bc7\u0bc7 \u0bb9\u0bb0\u0bc7\u0bc7\u0ba8\u0bcd\u0ba4\u0bbf\u0bbf\u0bb0 \u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0 \u0bb0\u0ba4\u0bcd\u0ba8\u0bbe\u0bbe\u0baf\u0b95\u0bcd\u0b95 \u0b86\u0b95\u0bbf\u0bbf\u0baf \u0ba8\u0bbe\u0bbe\u0ba9\u0bcd, \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0bcd \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8\u0b95\u0bb3\u0bcd \u0ba4\u0bc7\u0bc7\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd (262 \u0b86\u0bae\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0baf\u0bae\u0bcd) 66\u0b85(1) (\u0b85) \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0b86\u0b95\u0bbf\u0bbf\u0baf \u0ba8\u0bbe\u0bbe\u0ba9\u0bcd, \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bb0\u0bcd \u0b85\u0ba4\u0bbf\u0bbf\u0b95\u0bbe\u0bbe\u0bb0 \u0b9a\u0baa\u0bc8\u0bc8\u0b95\u0bb3\u0bcd \u0ba4\u0bc7\u0bc7\u0bb0\u0bcd\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bb3\u0bc8\u0bc8\u0bc8\u0b9a\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0ba9\u0bcd (262 \u0b86\u0bae\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0baf\u0bbe\u0bbe\u0baf\u0bae\u0bcd) 66\u0b85(1) (\u0b85) \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0baa\u0bbf\u0bbf\u0bb0\u0bbf\u0bbf\u0bb5\u0bbf\u0bbf\u0ba9\u0bcd \u0ba8\u0bbf\u0bbf\u0baf\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd\u0baa\u0b9f\u0bbf \u0b9a\u0bc6\u0bc6\u0baf\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0bae\u0bb2\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4 \u0bb5\u0bbf\u0bbf\u0ba4\u0bbe\u0bbe\u0ba9\u0baf\u0bb2\u0bbe\u0bbe\u0b95\u0bc7\u0bc7 \u0b9a\u0bb0\u0ba4\u0bcd \u0b9a\u0bbf\u0bbf\u0b9a\u0bbf\u0bbf\u0bb0 \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0bb0 \u0b8e\u0ba9\u0bcd\u0baa\u0bb5\u0bb0\u0bcd \u0ba8\u0bbf\u0bbf\u0baf\u0ba4\u0bbf\u0bbf\u0b95\u0bb3\u0bbf\u0bbf\u0ba9\u0bcd\u0baa\u0b9f\u0bbf \u0b9a\u0bc6\u0bc6\u0baf\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0bae\u0bb2\u0bcd\u0bb5\u0ba4\u0bcd\u0ba4 \u0bb5\u0bbf\u0bbf\u0ba4\u0bbe\u0bbe\u0ba9\u0baf\u0bb2\u0bbe\u0bbe\u0b95\u0bc7\u0bc7 \u0b9a\u0bb0\u0ba4\u0bcd \u0b9a\u0bbf\u0bbf\u0b9a\u0bbf\u0bbf\u0bb0 \u0b95\u0bc1\u0bae\u0bbe\u0bbe\u0bb0 \u0b8e\u0ba9\u0bcd\u0baa\u0bb5\u0bb0\u0bcd \u0baa\ufffd\u0bca\u0bb2\u0bcd\u0b95\u0bb9\u0bb5\ufffd\u0bb2 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0baa\ufffd\u0bca\u0bb2\u0bcd\u0b95\u0bb9\u0bb5\ufffd\u0bb2 \u0baa\u0bbf\u0bbf\u0bb0\u0ba4\u0bc7\u0bc7\u0b9a \u0b9a\u0baa\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0b9a\u0baa\u0bc8\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bae\u0bcd 12- \u0bb9\u0ba8\u0bcd\u0ba4\u0bc1\u0b95\u0bb2 \u0bb5\u0b9f\u0bcd\u0b9f\u0bbe\u0bbe\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bbf\u0bb1\u0bcd\u0b95\u0bc112- \u0bb9\u0ba8\u0bcd\u0ba4\u0