    "text": "\u0db8\u0db0\u0255\u0db8 \u0db4\u0dc5\u0dcf\u0dd9\u01ae, \u0db8\u0dc4\u01e9\u0dc0\u0dbb \u01ce\u0dc3\u0dca\u01b5\u00fa\u0d9a\u0dd9\u024f, \u0d9c\u0d9f\u0d89\u0dc4\u0dc5 \u0dd9\u0d9a\u0dcf\u0dca\u0dbb\u0dd9\u0dc5\u0dca \u021d\u0dcf\u0dd9\u01ca\u0275\u0dba \u0dd9\u0262\u0d9a\u023c \u0dd9\u0d9a\u0dcf\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u023d\u0dba\u0db1\u0dd9\u0d9c\u0dcf\u0262\u0dbd(1050), \u011e\u0dcf\u0db8 \u01e7\u0dbd\u0db0\u0dcf\u025c \u0dd9\u0d9a\u0dcf\u0178\u0da8\u0dcf\u0dc3\u0dd9\u024f, \u0dd9\u0dbd\u0269\u0dd9\u0daf\u019d\u0dba \u0d9c\u0dd9\u023c \u0218\u028f\u0179 \u0dc3\u0259\u0dd9\u0269\u0dba\u0259 \u0da2\u0db1\u0dbb\u0dcf\u0262 \u026a\u0286\u01e6 \u0218\u0298\u0dd9\u0dba\u0dbd \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a Maha/GIK/2022/1175 \u0dc4\u0dcf 2023.03.23 \u01ce\u0db1\u0dd0\u01af \u021d\u0d9c\u0db8\u0db1 \u0d85\u01e9\u0dd9\u0259\u0d9b\u0dab\u0dd9\u024f \u0dc3\u026a\u0dc3\u0dca\u0dad\u0dbb\u0dc0 \u0daf\u0dd0\u00fa\u0dd9\u0dc0\u0db1 \u0db4\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u01e6 \u0db1\u023d\u01e6 \u0dc4\u0dcf \u021d\u0db8\u0dcf\u0dab\u0dd9\u0dba\u01e6 \u0252\u00fa\u0dad \u0d89\u0da9\u023c \u0dd9\u0d9a\u0dcf\u0da7\u0dc3\u0da7 \u0db8\u0dcf\u0250\u023c:",
