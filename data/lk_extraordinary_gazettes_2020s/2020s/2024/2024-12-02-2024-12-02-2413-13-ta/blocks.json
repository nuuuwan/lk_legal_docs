    "text": "\u0b89\u0ba4\u0bcd\u0b9a\u0ba4\u0b9a \u0bb2\u0bad\u0bb5\u0bc1 \u0b9a\u0b9a\u0baf\u0bb5\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f \u0b85\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0bc8 \u2013 2025 \u0bc8\u0bb2\u0bcd\u0bae\u0bc1\u0b95\u0ba9 \u0bab\u0bbe\u0ba8\u0bc8\u0bad \u0b9a\u0b95\u0baa\u0bac\u0bbf\u0ba9\u0bcd 2025 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0bc8\u0bbe\u0ba9 \u0b89\u0ba4\u0bcd\u0b9a\u0ba4\u0b9a \u0bb2\u0bad\u0bb5\u0bc1 \u0b9a\u0b9a\u0baf\u0bb5\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f \u0b85\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0bc8 \u0bc8\u0bb2\u0bcd\u0bae\u0bc1\u0b95\u0ba9 \u0b9a\u0baa\u0bbe\u0ba4\u0bc1 \u0ba8\u0bc2\u0baf\u0bc8 \u0bb2\u0bb0\u0bbe\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0b95\u0bab\u0ba8\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb0 \u0bab\u0bbe\u0ba8\u0bc8\u0bad \u0b9a\u0b95\u0baa\u0bac\u0bbf\u0ba9\u0bcd \u0baa\u0bbf\u0bad\u0ba4\u0bbe\u0ba9 \u0b85\u0bb2\u0bc1\u0bb2\u0baf\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b9a\u0baa\u0bbe\u0ba4\u0bc1 \u0bab\u0b95\u0bcd\u0bc8\u0bb3\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bb2\u0b95\u0bcd\u0bc8\u0bbe\u0bc8 \u0b95\u0bb2\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb0\u0ba4\u0bc1. \u0b87\u0ba4\u0b95\u0ba9 2024.12.02 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf \u0b9a\u0ba4\u0bbe\u0b9f\u0b95\u0bcd\u0bc8\u0bae\u0bcd 2024.12.13 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf \u0bb2\u0b95\u0bad \u0b85\u0bb2\u0bc1\u0bb2\u0baf\u0bc8 \u0b9a\u0ba8\u0bad\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bb2\u0bac\u0bbf\u0b9f \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd \u0b9a\u0baa\u0bbe\u0ba4\u0bc1 \u0bab\u0b95\u0bcd\u0bc8\u0bb3\u0bcd \u0ba4\u0bab\u0ba4\u0bc1 \u0bc8\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0bc8\u0b95\u0bb0 \u0b9a\u0bab\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f \u0bc8\u0bbe\u0baf\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b8e\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0bae\u0bc2\u0baf\u0bae\u0bcd \u0bc8\u0bb2\u0bcd\u0bae\u0bc1\u0b95\u0ba9 \u0bab\u0bbe\u0ba8\u0bc8\u0bad \u0b9a\u0b95\u0baa \u0b85\u0bb2\u0bc1\u0bb2\u0baf\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b9a\u0bab\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0bc8 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0b95\u0ba9\u0baf\u0bc1\u0bae\u0bcd \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0b85\u0bae\u0bbf\u0bac\u0ba4\u0bcd\u0ba4\u0bb0\u0bc1\u0bc8\u0bbf\u0ba9\u0bcd\u0b9a\u0bae\u0ba9\u0bcd.",
