    "text": "\u0dc0\u0db6\u0dbb\u0d9c\u0d85\u0d82\u0dbd \u0db3\u0dc2\u0dc5\u0dba\u0dda, \u0d9a\u0dc7\u0d9c\u0dbd\u0dca\u0dbc \u0daf\u0dd2\u0dc0\u0dc4\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0dbb\u0dd4\u0dbd\u0dca\u0dad\u0dbd\u0dc6\u0dbd\u0dca\u0dbc \u0db4\u0dca\u200d\u0dbb\u0dc5\u0dba\u0dd3\u0dba \u0dba \u0dba\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dba\u0d9a \u0da7\u0dca\u0dc3\u0dc5\u0dc0\u0dba\u0dda, \u0dba\u0daf\u0d9c\u0db8\u0d9c\u0db8\u0dca\u0db3\u0dbd\u0dca \u0dba\u0d9a\u0ddd\u0dbb\u0dba\u0dc2 \u0d85\u0d82\u0d9a 98\u0d92, \u0dba\u0dbc\u0db1\u0d9c\u0dbc \u0d9c\u0dca\u200d\u0dbb\u0dc5\u0db8 \u0db1\u0dd2\u0dbc\u0db0\u0dc5\u0dbb\u0dd2 \u0dba\u0d9a \u0da7\u0dca\u0dc3\u0dc5\u0dc0\u0dba\u0dda \u0db6\u0dc0\u0dc4\u0db1\u0dc5\u0dba\u0d9c \u0da9 \u0d9c\u0dba\u0db8\u0dca \u0db4\u0dd2\u0d9c\u0db8\u0da7\u0dd2, \u0dc0\u0dbb\u0dca\u0dba\u0dc0\u0dca\u0dba\u0dbb\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dc5\u0dbd\u0dca\u0dba\u0dda \u0d9a\u0dc6\u0da9\u0dc6\u0dc0\u0dc4\u0dcf\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0db8\u0dca \u0d85\u0d82\u0d9a 610421, \u0d9a\u0dbc\u0dc5\u0db3 \u0d85\u0d82\u0d9a 5, \u0db3\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d9a 1 \u0dc1\u0dc5 2024.10.09 \u0daf\u0dd2\u0db1\u0dc6\u0dad\u0dd2 \u0db4\u0dd2\u0dd4\u0dbb\u0dba\u0dbb\u0dca \u0dc0\u0dc0\u0dd2\u0dc0\u0dc4\u0dcf\u0dbb\u0dbd \u0daf\u0dc6\u0d9a\u0dca\u0dba\u0dbd\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc5\u0dba\u0dba\u0dba\u0dca\u0dad \u0dba\u0dc1\u0d9a\u0dca\u0da7\u0dba\u0dc5\u0dbb\u0dca 0.0208 \u0d9a\u0dca \u0dc0\u0dd5 \u0db3\u0dc1\u0dcf 1 \u0dc1\u0dc5 3 \u0daf\u0dbb\u0db1 \u0db6\u0dd2\u0db8\u0dca \u0d9a\u0dc6\u0db6\u0dbd\u0dd2.",
