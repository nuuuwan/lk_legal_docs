    ],
    "text": "2024 , \u0b9a\u0bab \u0bab\u0bbe\u0ba4\u0bae\u0bcd 17\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf\u0bac 2384 /30 \u0b86\u0bae\u0bcd \u0b87\u0baf\u0b95\u0bcd\u0bc8 \u0b85\u0ba4\u0bbf\u0bb2\u0bbf\u0b9a\u0b9a\u0b9f \u0bb2\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bab\u0bbe\u0ba9\u0bbf\u0bac\u0bbf\u0bb2\u0bcd \u0b9a\u0bb2\u0bb0\u0bbf\u0bac\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b85\u0bb8\u0bcd\u0b9a\u0bb2\u0b9a\u0bc1\u0bab \u0ba8\u0baf\u0ba9\u0bcd\u0baa\u0bc1\u0bbe\u0bbf\u0b95\u0bcd \u0b9a\u0bc8\u0bbe\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba9\u0bb5\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b87\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd \u0b87\u0bad\u0ba4\u0bcd\u0ba4\u0bc1 \u0b9a\u0b9a\u0baf\u0bcd\u0bac\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bc8\u0bbf\u0bae\u0ba4\u0bc1, \u0b86\u0ba9\u0bbe\u0bb2\u0bcd, \u0b85\u0ba4\u0ba9\u0bcd I \u0b86\u0bb2\u0ba4\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb2\u0b95\u0bc8 \u0bab\u0bb1\u0bcd\u0bae\u0bc8\u0bae\u0bcd II \u0b86\u0bb2\u0ba4\u0bc1 \u0b85\u0b9f\u0bcd\u0b9f\u0bb2\u0b95\u0bc8 \u0b9a\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbe\u0bc8, \u0ba8\u0baf\u0ba9\u0bcd\u0baa\u0bc1\u0bbe\u0bbf \u0ba8\u0ba9\u0bcd\u0b95\u0bab\u0bc8\u0bb3\u0bc1\u0b95\u0bcd\u0bc8\u0bbe\u0bc8 \u0b8f\u0bb1\u0bcd\u0bc8\u0ba9\u0b9a\u0bb2 \u0b9a\u0ba4\u0bbe\u0bbf\u0bb5\u0bc1\u0b9a\u0b9a\u0baf\u0bcd\u0bac\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b9a\u0bab\u0bb2\u0bc1\u0bae\u0bcd \u0baa\u0bb2\u0bcd\u0b9a\u0bb2\u0bae\u0bc8 \u0bc8\u0bbe\u0bad\u0bc8\u0b99\u0bcd\u0bc8\u0bb0\u0bbe\u0bb2\u0bcd \u0b9a\u0bc8\u0bbe\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba9\u0bb5\u0bc1 \u0bb2\u0bb1\u0b99\u0bcd\u0b95\u0bc1\u0bb2\u0ba4\u0bbf\u0bb2\u0bcd \u0ba4\u0bbe\u0bab\u0ba4\u0bae\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb0 \u0baa\u0bac\u0ba9\u0bbe\u0bb0\u0bbf\u0bc8\u0bb3\u0bcd, \u0b9a\u0bab\u0bb2\u0bcd\u0bae\u0bc1\u0b95\u0bae\u0bae\u0bc3\u0b9f\u0bc1\u0bc8\u0b95\u0bb0\u0b9a\u0bcd \u0b9a\u0bab\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba4\u0bb1\u0bcd\u0b9a\u0baa\u0bbe\u0ba4\u0bc1 \u0baa\u0bbe\u0bbf\u0b9a\u0bc0\u0baf\u0b95\u0ba9\u0b95\u0bcd\u0b95\u0bc1\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bc1\u0bb3\u0bcd\u0bb0 \u0bb2\u0bbf\u0ba3\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0ba4\u0bbe\u0bad\u0bb0\u0bcd\u0bc8\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1, \u0b85\u0bb2\u0bb0\u0bcd\u0bc8\u0bb0\u0bbf\u0ba9\u0bcd \u0ba4\u0b95\u0bc1\u0ba4\u0bbf\u0bac\u0bbf\u0bb1\u0bcd\u0b9a\u0bc8\u0bb1\u0bcd\u0baa 2024.12.31 \u0bb2\u0b95\u0bad \u0b95\u0bc1\u0bae\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f \u0b9a\u0bc8\u0bbe\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba9\u0bb5\u0bc1\u0bc8\u0bb3\u0bcd \u0bb2\u0bb1\u0b99\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0b9a\u0bb2\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.",
