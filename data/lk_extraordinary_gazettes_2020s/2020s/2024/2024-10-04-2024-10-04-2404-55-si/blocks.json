dd2\u0dba _ \u2013 1:23 0.2667 \u0dbb\u0dad\u0db8\u0dbd \u0dbb\u0dcf\u0dbd\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc3\u0d82\u0da2\u0dd3\u0dc0 \u0db4\u0daf\u0dd3\u0db4\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dbb 198317204080 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0dc0\u0dbb\u0dc5\u0dd4\u0d9c\u0db8, \u0dc0\u0dbd\u0d9a\u0dd4\u0db9\u0dd4\u0dbb\u0dd4\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1:26 0.0014 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd4\u0db9\u0dd4\u0dbb 1:27 0.0013 \u0dbb\u0da2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd4\u0db9\u0dd4\u0dbb 1:28 0.2623 \u0d91\u0dbd\u0dd2\u0dc0\u0dd2\u0da7\u0dd2 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc3\u0dd3\u0dbd\u0dc0\u0dad\u0dd3 546662748V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd4\u0db9\u0dd4\u0dbb \u0db8\u0dd0\u0db1\u0dd2\u0dd9\u0d9a\u0dca \"\u0dc3\u0db1\u0dca\u0db0\u0dca\u200d\u0dba\u0dcf\", \u0dd9\u0dc0\u0dbb\u0dc5\u0dd4\u0d9c\u0db8, \u0dc0\u0dbd\u0d9a\u0dd4\u0db9\u0dd4\u0dbb\u0dd4\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1:57 0.1179 \u0da2\u0dba\u0dd9\u0dc3\u0dda\u0d9a\u0dbb \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d9a\u0dcf\u0dbd\u0dd2\u0d82\u0d9c 830265279V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0db8\u0dc4\u0da2\u0db1 \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0 _ \u0db4\u0dd2\u0dba\u0dc1\u0dcf\u0db1\u0dca\u0dad \u0dd9\u0dc0\u0dad \u0dad\u0db6\u0dcf \u0dad\u0dd2\u0dd9\u0db6\u0db1 \u0d9a\u0db3\u0dcf\u0db1\u0dc0\u0dad\u0dca\u0dad, \u0dd9\u0dc0\u0dbb\u0dc5\u0dd4\u0d9c\u0db8, \u0dc0\u0dbd\u0d9a\u0dd4\u0db9\u0dd4\u0dbb\u0dd4\u0db8\u0dd4\u0dbd\u0dca\u0dbd \u0d85\u0d82\u0d9a 6577 - 2011.12.16 \u0daf\u0dbb\u0dab \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0dc3\u0dc4 \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 63 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9c 1:63 0.1332 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 52, 53, 57, 58, 59, 60, 61, 62, 64 \u0dc3\u0dc4 70 \u0da7 \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 1:68 0.0148 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0 - \u0db4\u0db1\u0dca\u0db1\u0dbd \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0d9a\u0dd2 1:69 0.2851 \u0dc0\u0dd2\u0da2\u0dba\u0dd9\u0d9a\u0ddd\u0db1\u0dca \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0da0\u0db1\u0dca\u0daf\u0db1 671551230V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dc0\u0dd2\u0da2\u0dba\u0dd9\u0d9a\u0ddd\u0db1\u0dca \"\u0da0\u0db1\u0dca\u0daf\u0db1 \", \u0dd9\u0dc0\u0dbb\u0dc5\u0dd4\u0d9c\u0db8, \u0dc0\u0dbd\u0d9a\u0dd4\u0db9\u0dd4\u0dbb\u0dd4\u0db8\u0dd4\u0dbd\u0dca\u0dbd 1:75 0.0069 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0 - \u0d9a\u0dd4\u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db6\u0da7\u0dc4\u0dd2\u0dbb \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u2013",
