    "text": "\u0db6\u0dc0\u0dca\u0db1\u0dcf\u0dc4\u0dd2\u0dbb \u0db4\u0dc2\u0dcf\u0dba\u0dda, \u0d9a\u0dc5\u0dd4\u0dcf\u0dbb \u0daf\u0dd2\u0dc0\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0dba\u0dd4\u0dc0\u0dbd\u0dbd\u0dbc \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dba\u0dba \u0dba\u0dda\u0d9a\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc0\u0dba\u0dda 749 - \u0d9a\u0d82\u0d9a\u0dcf\u0db1\u0db8\u0dca\u0dba\u0d9c\u0ddc\u0da9 \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbc \u0dcf\u0dbb\u0dd2 \u0dbd\u0dc0\u0dba\u0db8\u0dca, \u0d9a\u0d82\u0d9a\u0dcf\u0db1\u0db8\u0dca\u0dba\u0d9c\u0ddc\u0da9 \u0d9c\u0dba\u0db8\u0dca, \u0db8\u0dcf\u0d9c\u0dda\u0dba\u0dda\u0dba\u0dbd\u0dbc \u0d89\u0da9\u0dba\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0d9a\u0dd0\u0da9\u0dc0\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0db8\u0dca \u0d85\u0d82\u0d9a 530746 \u0dc1\u0dcf 2024.02.07 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0db4\u0dd2\u0db9\u0dd4\u0dba\u0dda \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 01, 02 \u0dc0\u0dc1 03 \u0dba\u0dbc\u0dc0 \u0dba\u0db4\u0dca\u0dad\u0db1\u0dd4\u0db8\u0dca \u0d9a\u0dbb\u0db1 \u0db8\u0dd4\u0dc5\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dba\u0dba\u0dba\u0dca\u0dad \u0dba\u0dc1\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb 0.0752 \u0d9a\u0dca \u0dc0\u0dd5 \u0db4\u0dc1\u0dcf \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb \u0dba\u0d9a\u0dba\u0dbb\u0db1 \u0d89\u0da9\u0db8\u0dca \u0d9a\u0dd0\u0db6\u0dd0\u0dda\u0dbc.",
