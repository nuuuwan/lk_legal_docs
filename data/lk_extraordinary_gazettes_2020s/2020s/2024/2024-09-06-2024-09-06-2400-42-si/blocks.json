    "text": "\u0db8\u0db0\u200d\u0db8 \u0db3\u0dc2\u0dcf\u0dba\u0dda, \u0db8\u0dcf\u0dcf\u0dba\u0dda \u0daf\u0dd2\u0dc0\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0dbc\u0dda\u0d9c\u0dbc \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba\u0dba \u0dba\u0dda\u0d9a\u0db8\u0dca \u0dba\u0d9a \u0da7\u0dca\u0da8\u0dcf\u0dc0\u0dba\u0dda, \u0dbc\u0dda\u0d9c\u0dbc \u0db3\u0dda\u0dba\u0dda\u0dc3\u0dd2\u0dba \u0db3\u0dda\u0dad\u0dd4\u0dba\u0dc0\u0dca E396B \u0d85\u0d9a\u0dbb\u0dc1\u0dd0\u0da9\u0dd2\u0dba \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbc\u0db0\u0dcf\u0dbb\u0dd2 \u0dbd\u0dc0\u0dba\u0db8\u0dca \u0dc4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2, \u0dc0\u0dbb\u0dca\u0dba\u0dc0\u0dca\u0dba\u0dbb\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dcf\u0dda \u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dad 2023.03.10 \u0daf\u0dd2\u0db1 \u0dc0\u0db8\u0dca\u0db8\u0dcf \u0d9a\u0dbb\u0db1 \u0dbc\u0daf, \u0d9a\u0dd0.\u0dc3\u0dd2. 310243 \u0dc4\u0dd2, \u0d9a\u0dbc\u0dcf\u0db3 \u0d85\u0d82\u0d9a 22 \u0dc4\u0dd2, \u0db3\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d9a 2 \u0daf\u0dbb\u0db1 \u0dc0\u0dd0\u0dbc\u0dd0\u0dc0\u0dca\u0dba\u0db8\u0dca, \u0dd2\u0db8\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dba\u0dba \u0dba\u0dc1\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca 2.8910 \u0d9a\u0dca \u0dbd\u0db1 \u0db3\u0dc1\u0dcf \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0d89\u0da9\u0db8 :",
