dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014 (\u0dd9\u0dc4\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb\u0dca) 1:35 0.0468 \u0db8\u0dd2\u0db1\u0dca\u0db1\u0dd2\u0db1\u0dca\u0d9c\u0dbd \u0dc3\u0dd0\u0db8\u0dca\u0dc3\u0db1\u0dca \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf 652602070V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0dc0\u0db1\u0dad\u0dca \u0db1\u0db8\u0dca: \u0db8\u0dd4\u0dbb\u0dd4\u0d9a\u0dca\u0d9a\u0dd4\u0dc0\u0dcf \u0daf\u0dd4\u0dbb \u0dc3\u0dd0\u0db8\u0dca\u0dc3\u0db1\u0dca \u0d85\u0d82\u0d9a 161/1, \u0d9a\u0daf\u0dd4\u0dbb\u0dd4\u0dd9\u0db4\u0dca, \u0db6\u0dd6\u0dc3\u0dca\u0dc3. 1:37 0.1660 \u0db8\u0dd2\u0db1\u0dca\u0db1\u0db1\u0dca\u0d9c\u0dbd \u0dc3\u0dd0\u0db8\u0dca\u0dc3\u0db1\u0dca \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf 652602070V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0dd9\u0dc0\u0db1\u0dad\u0dca \u0db1\u0db8\u0dca: \u0db8\u0dd4\u0dbb\u0dd4\u0d9a\u0dca\u0d9a\u0dd4\u0dc0\u0dcf \u0daf\u0dd4\u0dbb \u0dc3\u0dd0\u0db8\u0dca\u0dc3\u0db1\u0dca \u0d85\u0d82\u0d9a 161/1, \u0d9a\u0daf\u0dd4\u0dbb\u0dd4\u0dd9\u0db4\u0dca, \u0db6\u0dd6\u0dc3\u0dca\u0dc3. 1:57 0.0033 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1:65 \u0da7 \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 1:68 0.0045 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1:66, 1:67 \u0da7 \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 1:86 0.0698 \u0dd9\u0dc4\u0db1\u0dca\u0daf \u0db8\u0dbb\u0d9a\u0dca\u0d9a\u0dbd \u0d8b\u0db4\u0dc3\u0dd2\u0dbb\u0dd2 632723199V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0db8\u0dd3\u0daf\u0d9c\u0dbd, \u0d9a\u0db3\u0dd4\u0dbb\u0dd4\u0dd9\u0db4\u0dca, \u0db6\u0dd6\u0dc3\u0dca\u0dc3. 1:87 0.0048 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1:55 \u0da7 \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 1:96 0.0250 \u0d9c\u0dbd\u0dca\u0dd9\u0db6\u0ddc\u0d9a\u0dca\u0d9a \u0dd9\u0dc4\u0dda\u0dc0\u0dcf\u0dd9\u0d9c\u0dca \u0dbb\u0dc3\u0dd2\u0d9a \u0dc3\u0d82\u0da2\u0dba 850511667V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0db8\u0dd2\u0daf\u0d9c\u0dbd, \u0d9a\u0daf\u0dd4\u0dbb\u0dd4\u0dd9\u0db4\u0dca, \u0db6\u0dd6\u0dc3\u0dca\u0dc3. 1:109 0.0129 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd0.\u0d85. 1:108, 1:110, 1:112, \u0dc4\u0dcf 1:113 \u0da7 \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0db8 \u0dc3\u0daf\u0dc4\u0dcf 1:119 0.3368 \u0dd9\u0d9a\u0ddd\u0dbb\u0dd9\u0dbd\u0dca\u0dd9\u0d9c\u0dba\u0dd2 \u0db4\u0dc3\u0db1\u0dca\u0db1 196602500867 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ _ \u0d85\u0d82\u0d9a 155, \u0d9a\u0daf\u0dd4\u0dbb\u0dd4\u0dd9\u0db4\u0dca,\u0db6\u0dd6\u0dc3\u0dca\u0dc3. 1:121 0.0459 \u0dd9\u0dad\u0ddc\u0db8\u0dca\u0db8\u0dcf\u0daf\u0dd4\u0dbb \u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db8\u0dd9\u0db1\u0ddd\u0dc4\u0dbb 763651460V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0.\u0d85. 1:137 \u0dc4\u0dd2 _ \u0d85\u0d82\u0d9a 145/2, \u0d9a\u0daf\u0dd4\u0dbb\u0dd4\u0dd9\u0db4\u0dca,\u0db6\u0dd6\u0dc3\u0dca\u0dc3. \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db8\u0dcf\u0dbb\u0dca \u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f 1:128 0.0031 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd0.\u0d85. 1:134 \u0da7 \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0db8 \u0dc3\u0daf\u0dc4\u0dcf 1:136 0.0029 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd0.\u0d85\u0d82\u0d9a 1:121,1:122, 1:123, 1:134, 1:135, 1:137 \u0da7 \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0db8 \u0dc3\u0daf\u0dc4\u0dcf 1:140 0.0449 \u0dd9\u0dad\u0ddc\u0db8\u0dca\u0db8\u0dcf\u0daf\u0dd4\u0dbb \u0dc1\u0dd2\u0dbb\u0dcf\u0db1\u0dca \u0db8\u0dd9\u0db1\u0ddd\u0dc4\u0dbb 740582038V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0.\u0d85. 1:137 \u0dc4\u0dd2 _ \u0d85\u0d82\u0d9a 145/3,\u0d9a\u0daf\u0dd4\u0dbb\u0dd4\u0dd9\u0db4\u0dca,\u0db6\u0dd6\u0dc3\u0dca\u0dc3. \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0db8\u0dcf\u0dbb\u0dca \u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f 1:141 0.0117 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd0.\u0d85\u0d82\u0d9a 1:137, 1:142, 1:146, 1:159 \u0da7 \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0db8 \u0dc3\u0daf\u0dc4\u0dcf 1:144 0.0025 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1:142 \u0da7 \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf 1:152 0.0085 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u2013 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1:157 \u0dc3\u0dc4 1:158 \u0da7 \u0db4\u0dd9\u0dc0\u0dca\u0dc1 \u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf",
