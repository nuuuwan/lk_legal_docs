    "text": "14 \u0dbd\u0dc6\u0db1\u0dd2 \u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dba\u0dda \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dba\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0db8\u0dc0\u0dc5\u0dbb\u0dd2\u0dc0\u0dc4\u0dba\u0dda \u0dad\u0dd3\u0dbb\u0dab \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dc5\u0dbe\u0dba \u0dc0\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dbd \u0db3\u0dc2\u0dc5\u0dba\u0dda, \u0dbb\u0dda\u0db1\u0db4\u0dd4\u0dbb \u0daf\u0dd2\u0dc0\u0dc4\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dba\u0dda, \u0dd4\u0dbd\u200d\u0dbc \u0dc4\u0dba\u0db3 \u0db4\u0dca\u200d\u0dbb\u0dc5\u0dba\u0dca\u0db0\u0dba \u0dba \u0dba\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dc5\u0dc0\u0dba\u0dda, \u0d9a\u0d82\u0d9a 276- \u0db8\u0dd4\u0dda\u0dba\u0dcf\u0da7\u0dca\u0da7\u0dd4\u0dba\u0dda\u0d9c\u0db8 \u0d9c\u0dca\u200d\u0dbb\u0dc5\u0db8 \u0db1\u0dd2\u0dbc\u0db0\u0dc5\u0dbb\u0dd2 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dc5\u0dc0\u0dba \u0dad\u0dd4\u0dc2 \u0db8\u0dd4\u0dda\u0dba\u0dcf\u0da7\u0dca\u0da7\u0dd4\u0dba\u0dda\u0d9c\u0db8 \u0db1\u0db8\u0dc6\u0dad\u0dd2 \u0d9c\u0dba\u0db8\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dc5 \u0dc0\u0dd5 \u0daf, \u0d9a\u0d82\u0d9a 620753 \u0daf\u0dbb\u0db1 \u0d9a\u0dc6\u0da9\u0dc6\u0dc0\u0dc4\u0dcf\u0dbb \u0dc3\u0dd2\u0daf\u0dad\u0dd2\u0dba\u0dba\u0db8\u0dca \u0d9a\u0dbc\u0dc5\u0db3 \u0d9a\u0d82\u0d9a 5 \u0dc4\u0dd2 \u0d9a\u0dc6\u0db6\u0dbd\u0dd2 \u0d9a\u0d82\u0d9a 1 : 21 \u0daf\u0dbb\u0db1 \u0dd4\u0da9\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dc0\u0dc4 \u0dba\u0dbc\u0dc0 \u0dba\u0db3\u0dca\u0dad\u0db1\u0dd4\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7 \u0d87\u0dda\u0dcf\u0dc5 \u0dc0\u0dd5 \u0daf, \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0db3\u0dc7\u0db8\u0dca \u0dd4\u0daf\u0dd2\u0dbb\u0dd2\u0db3\u0dda \u0d9a\u0dbb\u0db1 \u0dba\u0dbc\u0dc0 \u0daf\u0dc6\u0db1\u0dd4\u0db8\u0dca \u0dba\u0daf\u0db8\u0dd2\u0dca\u0dad 1998 \u0d9a\u0d82\u0d9a 21 \u0daf\u0