    ],
    "text": "1:133 0.0246 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd3 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc0\u0da2\u0dd2\u0dbb 830242210V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 183 \u0dc4\u0dd2 - \u0db4\u0dd2\u0dba\u0d82\u0d9a\u0dbb \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0d82\u0d9a 75/49\u0d8a, \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba 1:141 0.0617 \u0dd9\u0dc3\u0dda\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dd9\u0d9c\u0dca \u0db1\u0dd3\u0dbd\u0dca \u0db4\u0dd2\u0dba\u0db1\u0dca\u0dad 653381336V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 63 \u0dc4\u0dd2 - \u0dd9\u0dc3\u0dda\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0d82\u0d9a 63, \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8 \u0db4\u0dcf\u0dbb, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba 1:144 0.0338 \u0dd9\u0dbb\u0ddc\u0dc2\u0dd2\u0da7\u0dcf \u0daf\u0dd4\u0dbd\u0dcf\u0d82\u0da2\u0dbd\u0dd3 \u0db8\u0dcf\u0db9\u0dd4\u0dbd\u0dd9\u0d9c\u0dca 925941514V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 63 \u0dc3\u0dc4 16 - \u0d85\u0d82\u0d9a 75,\u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8 \u0db4\u0dcf\u0dbb, \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d85\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0d89\u0daf\u0dca\u0daf\u0db8\u0dbd\u0dca\u0dd9\u0d9c\u0ddc\u0da9 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dd9\u0d9c\u0dca \u0db4\u0dd2\u0dba\u0dcf\u0dab\u0dd2 \u0dd9\u0dc4\u0dda\u0db8\u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dd2 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0dba\u0db1 \u0d85\u0dba\u0dd9\u0d9c\u0dca \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dba\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:156 0.0285 \u0dd9\u0daf\u0dca\u0dc1\u0db4\u0dd2\u0dba \u0dd9\u0d9c\u0daf\u0dbb \u0da0\u0dad\u0dd4\u0dbb\u0dd2\u0d9a\u0dcf \u0db8\u0dd9\u0dc4\u0dda\u0dc2\u0db1\u0dd3 825312897V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 63 \u0dc4\u0dd2 - \u0dd9\u0daf\u0dca\u0dc1\u0db4\u0dd2\u0dba \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0d82\u0d9a 99, \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8 \u0db4\u0dcf\u0dbb, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba 1:163 0.1505 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0 - \u0db8\u0dc4\u0dbb\u0d9c\u0db8 - \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 1:164 0.0878 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0 - \u0db8\u0dc4\u0dbb\u0d9c\u0db8 - \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 1:172 0.0246 \u0dbb\u0dab\u0dc0\u0dd3\u0dbb \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0db1\u0dbd\u0dd2\u0db1\u0dca 791560772V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 163 \u0dc4\u0dd2 - \u0db0\u0db8\u0dca\u0db8\u0dd2\u0d9a \u0dbb\u0dab\u0dc0\u0dd3\u0dbb \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0d82\u0d9a 126, \u0daf\u0db9\u0dd9\u0dc4\u0dda\u0db1 \u0db4\u0dcf\u0dbb, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba 1:198 0.0202 \u0db1\u0db8\u0dc3\u0dca\u0dc0\u0dcf\u0dba\u0db8\u0dca\u0dd9\u0d9c\u0dca \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dd2 \u0d8b\u0daf\u0dba\u0d82\u0d9c\u0db1\u0dd3 626561969V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 211 \u0dc4\u0dd2 - \u0d85\u0d82\u0d9a 75/47/Q/1, 12 \u0dc0\u0db1 \u0db4\u0da7\u0dd4\u0db8\u0d9c, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f 1:200 0.0201 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2 \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dc0\u0da2\u0dd2\u0dbb 830242210V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 163 \u0dc3\u0dc4 - \u0db4\u0dd2\u0dba\u0d82\u0d9a\u0dbb \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2 201 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0d82\u0d9a 75/49 \u0d8a, \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0dc3\u0db8\u0d9f 1:212 0.0264 \u0db6\u0db1\u0dca\u0da9\u0dcf\u0dbb\u0db1\u0dcf\u0dba\u0d9a\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd2\u0d9a\u0dcf 765830958V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 163 \u0dc4\u0dd2 - \u0da0\u0dcf\u0db1\u0dca\u0daf\u0db1\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0d82\u0d9a 75/49\u0db4\u0dd3, \u0daf\u0db8\u0dd9\u0dc4\u0dda\u0db1 \u0db4\u0dcf\u0dbb, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db8\u0dba\u0dd2\u0dbd\u0db1\u0dca\u0dd9\u0d9c\u0dca \u0db1\u0dcf\u0dbd\u0db1\u0dd3 \u0dd9\u0db4\u0dd9\u0dbb\u0dca\u0dbb\u0dcf \u0dba\u0db1 \u0d85\u0dba\u0dd9\u0d9c\u0dca \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0db7\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dba\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 EOG 09-0019/1",
