    "text": "1:48 0.0289 \u0dd9\u0db8\u0ddc\u0dbb\u0d9c\u0dc4\u0db8\u0da9\u0dd2\u0dad\u0dca\u0dd9\u0dad\u0dca \u0db6\u0da9\u0dbd\u0dca \u0dd9\u0d9c\u0daf\u0dbb 660051120V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 16 \u0dc4\u0dd2 - \u0dc0\u0dd2\u0db8\u0dbd\u0dc3\u0dd2\u0dbb\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0d82\u0d9a 22/22, \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8 \u0db4\u0dcf\u0dbb, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba 1:51 0.0295 \u0da0\u0dad\u0dd4\u0dbb\u0dd3 \u0dd9\u0d9a\u0ddc\u0da9\u0dd2\u0dad\u0dd4\u0dc0\u0d9a\u0dca\u0d9a\u0dd4 828101161V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 16 \u0dc4\u0dd2 - \u0d85\u0d82\u0d9a 22/25, \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8\u0dca \u0db4\u0dcf\u0dbb, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba 1:52 0.0280 \u0dad\u0dc5\u0dd4\u0dd9\u0db4\u0dbb\u0dd4\u0db8 \u0dc1\u0dd2\u0dba\u0dcf\u0db1\u0db1\u0dca\u0daf \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf 631260268V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 01 \u0dc3\u0dc4 63 - \u0d85\u0d82\u0d9a 22/27, \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8 \u0db4\u0dcf\u0dbb, \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0dc3\u0db8\u0d9f 1:63 0.1994 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0 - \u0db8\u0dc4\u0dbb\u0d9c\u0db8 - \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba - \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba 1:70 0.0271 \u0dc3\u0db8\u0db1\u0dca \u0d85\u0db1\u0dd4\u0dbb \u0db8\u0dd4\u0dab\u0dc3\u0dd2\u0d82\u0dc4 196026000106 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 16 \u0dc4\u0dd2 - \u0d85\u0d82\u0d9a 22/5, \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8 \u0db4\u0dcf\u0dbb, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba 1:72 0.0282 \u0db4\u0da7\u0dca\u0da7\u0dd2\u0dd9\u0d9c\u0dca \u0daf\u0dd3\u0db4\u0dca\u0dad\u0dd2 \u0db4\u0dd3\u0dbb\u0dd2\u0dc3\u0dca 621341715V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 16 \u0dc4\u0dd2 - \u0d85\u0d82\u0d9a 22/8, \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8 \u0db4\u0dcf\u0dbb, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba 1:79 0.0271 \u0dbb\u0dcf\u0db8\u0db1\u0dcf\u0dba\u0d9a\u0dd9\u0d9c\u0dca \u0db1\u0dd2\u0dc4\u0dcf\u0dbd\u0dca \u0d89\u0db1\u0dca\u200d\u0daf\u0da2\u0dd2\u0dad\u0dca 591340646V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 16 \u0dc4\u0dd2 - \u0d85\u0d82\u0d9a 22/15, \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8 \u0db4\u0dcf\u0dbb, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba 1:81 0.0270 \u0dc3\u0dca\u0dc0\u0dbb\u0dca\u0dab\u0dc3\u0dd2\u0d82\u0dc4 \u0db1\u0dc0\u0dbb\u0dad\u0dca\u0db1\u0dad\u0dd2\u0dbd\u0d9a 195835800808 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 16 \u0dc3\u0dc4 63 - \u0d86\u0db6\u0dbb\u0dab\u0dd9\u0d9c\u0daf\u0dbb \u0d8b\u0db4\u0dcf\u0dbd\u0dd2 \u0d85\u0db8\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0d82\u0d9a 208, \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8 \u0db4\u0dcf\u0dbb, \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0dc3\u0db8\u0d9f \u0dc4\u0dd0\u0da7\u0db1\u0dca \u0db1\u0dd0\u0dc2\u0db1\u0dbd\u0dca \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7 \u0dad\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0d82\u0d9a 121 - 2000.07.03 \u0daf\u0dbb\u0db1 \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:84 0.0271 \u0da2\u0dba\u0db8\u0dd2\u0dab\u0dd2 \u0d8b\u0daf\u0dcf\u0dbb \u0d89\u0dd9\u0dbd\u0dca\u0dd9\u0db4\u0dbb\u0dd4\u0db8 871680167V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 01 \u0dc3\u0dc4 63 - \u0d85\u0d82\u0d9a 58, \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8 \u0db4\u0dcf\u0dbb, \u0dc4\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba \u0dc3\u0db8\u0d9f 1:85 0.0268 \u0d9c\u0dd3\u0dad\u0dcf \u0dbb\u0db8\u0dca\u200d\u0dba\u0dcf \u0dc0\u0dd2\u0d9a\u0db8\u0dbb\u0dad\u0dca\u0db1 \u0d9c\u0dd4\u0dab\u0dd9\u0dc3\u0dda\u0d9a\u0dbb 196462600256 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 63 \u0dc4\u0dd2 - \u0d85\u0d82\u0d9a 22/14, \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8\u0dca \u0db4\u0dcf\u0dbb, , \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0db1\u0db8, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba 1:95 0.0288 \u0dc3\u0db8\u0dbb\u0dc0\u0dd3\u0dbb \u0db8\u0dd4\u0daf\u0dbd\u0dd2\u0dd9\u0d9c\u0dca \u0daf\u0dba\u0dcf\u0dbb\u0dad\u0dca\u0db1 582261091V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 63 \u0dc4\u0dd2 - \u0daf \u0d85\u0dbd\u0dca\u0dc0\u0dd2\u0dc3\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0db4\u0dbb\u0dc0\u0dc1\u0dca\u200d\u0dba\u0dad\u0dcf \u0d85\u0d82\u0d9a 34, \u0dc0\u0da7\u0dbb\u0dc0\u0dd4\u0db8 \u0db4\u0dcf\u0dbb, \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0d9f \u0d85\u0dbb\u0dbd\u0dd2\u0dba \u0d8b\u0dba\u0db1, \u0dd9\u0daf\u0db4\u0dcf\u0dbd\u0db8, \u0db4\u0db1\u0dca\u0db1\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba 1:97 0.0278 \u0dd9\u0daf\u0ddc\u0db1\u0dca \u0dc6\u0dd0\u0db1\u0dca\u0dc3\u0dd2\u0dc3\u0dca\u0d9a\u0dd4\u0dd9\u0d9c\u0dca \u0db4\u0dcf\u0dbd\u0dd2\u0dad \u0dd9\u0dbb\u0dca\u0db1\u0dd4 1961087009