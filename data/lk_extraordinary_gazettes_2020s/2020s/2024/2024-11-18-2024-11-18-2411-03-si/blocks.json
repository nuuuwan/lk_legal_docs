    "text": "\u0da9\u0db6\u0dca. \u0d92. \u0dd9\u0db4\u0dda\u0db8\u0dc3\u0dd2\u0dbb\u0dd2 \u0db8\u0dba\u0dcf, \u0db4\u0dbd\u0dd4\u0d9c\u0dc4\u0dc0\u0dad\u0dca\u0dad, \u0d89\u0dc4\u0dbd \u0dc0\u0dd3\u0dbb\u0dd9\u0d9a\u0ddc\u0da9\u0dd2\u0dba\u0dcf\u0db1, \u0dc0\u0dd3\u0dbb\u0dd9\u0d9a\u0ddc\u0da9\u0dd2\u0dba\u0dcf\u0db1. \u0dc3\u0dc4 \u0dbd\u0d82\u0d9a\u0dcf \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba, \u0d85\u0d82\u0d9a 50, \u0dc3\u0dbb\u0dca \u0da0\u0dd2\u0dad\u0dca\u0dad\u0db8\u0dca\u0db4\u0dbd\u0db8\u0dca \u0d92. \u0d9c\u0dcf\u0da9\u0dd2\u0db1\u0dbb\u0dca \u0db8\u0dcf\u0dc0\u0dad, \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 02.",
