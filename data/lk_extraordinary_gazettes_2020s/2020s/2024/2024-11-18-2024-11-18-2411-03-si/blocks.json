    "text": "\u0da9\u0db6\u0dca. \u0d91\u0db8\u0dca. \u0d85\u0dd9\u0dc1\u0ddd\u0d9a\u0dcf \u0daf\u0db8\u0dba\u0db1\u0dca\u0dad\u0dd2 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2 \u0db8\u0dd2\u0dba, \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 (\u0dbb\u0dcf. \u0d86.), \u0db8\u0dcf\u0daf\u0dd4\u0dbb\u0dd4\u0d94\u0dba \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0d89\u0dc0\u0dd4\u0dbb \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba, \u0dc0\u0dd0\u0dbd\u0dd2\u0d9a\u0db1\u0dca\u0daf. \u0dc3\u0dc4 \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db8\u0dc4\u0dc0\u0dd0\u0dbd\u0dd2 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dba, \u0d85\u0d82\u0d9a 500, \u0da7\u0dd3. \u0db6\u0dd3. \u0da2\u0dba\u0dcf \u0db8\u0dcf\u0dc0\u0dad, \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 10. \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dc1\u0dca\u0dc0\u0dba\u0db1\u0dca \u0d85\u0dad\u0dbb \u0d87\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dcf\u0dc0\u0dd4\u0dbd\u0da7 \u0dd9\u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd3 \u0db4\u0dc0\u0dad\u0dca\u0db1\u0dcf \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dc0\u0db1\u0dd4\u0dd9\u0dba\u0dca, \u201c\u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db8\u0dc4\u0dc0\u0dd0\u0dbd\u0dd2 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0dd9\u0dba\u0dca \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 (\u0dbb\u0dcf. \u0d86.) \u0dd9\u0dbd\u0dc3 \u0dd9\u0dc3\u0dda\u0dc0\u0dba \u0d9a\u0dbb\u0db1 \u0da9\u0db6\u0dca. \u0d91\u0db8\u0dca. \u0d85\u0dd9\u0dc1\u0ddd\u0d9a\u0dcf \u0daf\u0db8\u0dba\u0db1\u0dca\u0dad\u0dd2 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2 \u0db8\u0dd2\u0dba \u0dc4\u0da7, 1. 2020.11.26 \u0daf\u0dd2\u0db1 \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dad\u0db1\u0dad\u0dd4\u0dbb \u0dc3\u0db3\u0dc4\u0dcf \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0d9b \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dad\u0db1\u0dad\u0dd4\u0dbb \u0dc3\u0db3\u0dc4\u0dcf \u0dd9\u0dad\u0dca\u0dbb\u0dd3\u0db8\u0dca \u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dd9\u0dba\u0dca \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0db4\u0dd4\u0dbb\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dd9\u0dab\u0dca \u0daf \u0dba\u0db1\u0dca\u0db1\u0dad\u0dca, 2. \u0d91\u0daf\u0dd2\u0db1 \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0d9b \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba \u0db8\u0dad \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad \u0dad\u0db1\u0dad\u0dd4\u0dbb \u0dbd\u0db6\u0dcf \u0dd9\u0db1\u0ddc\u0daf\u0dd3 \u0db1\u0dd0\u0dc0\u0dad \u0dc0\u0dc3\u0dbb\u0d9a\u0da7 \u0db4\u0dc3\u0dd4\u0dc0 \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0d9b \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dd9\u0dba\u0dca\u0daf\u0dd3 \u0d87\u0dba\u0da7 \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc0 \u0dad\u0dd2\u0dd9\u0db6\u0dca\u0daf \u0dba\u0db1\u0dca\u0db1\u0dad\u0dca, \u0d91\u0dd9\u0dc3\u0dda \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd3 \u0dad\u0dd2\u0dd9\u0db6\u0dca \u0db1\u0db8\u0dca \u0d87\u0dba\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dc4\u0db1\u0dba\u0db1\u0dca \u0d9a\u0dc0\u0dd9\u0dbb\u0dca \u0daf \u0dba\u0db1\u0dca\u0db1\u0dad\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dd9\u0dc0\u0dca.\u201d \u0d91\u0da0\u0dca. \u0dd9\u0d9a\u0dca. \u0dd9\u0d9a\u0dca. \u0d92. \u0da2\u0dba\u0dc3\u0dd4\u0db1\u0dca\u0daf\u0dbb, \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dd9\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca. 2024 \u0d94\u0d9a\u0dca\u0dd9\u0dad\u0ddd\u0db6\u0dbb\u0dca \u0db8\u0dc