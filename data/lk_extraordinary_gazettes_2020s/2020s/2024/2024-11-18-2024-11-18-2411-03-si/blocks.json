    ],
    "text": "\u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dc1\u0dca\u0dc0\u0dba\u0db1\u0dca \u0d85\u0dad\u0dbb \u0d87\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dcf\u0dc0\u0dd4\u0dbd\u0da7 \u0dd9\u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd3 \u0db4\u0dc0\u0dad\u0dca\u0db1\u0dcf \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0dc0\u0db1\u0dd4\u0dd9\u0dba\u0dca, \u201c\u0dbd\u0d82\u0d9a\u0dcf \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0db6\u0dbd \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dd9\u0dba\u0dca \u0dd9\u0dc3\u0dda\u0dc0\u0dba \u0d9a\u0dc5 \u0da9\u0db6\u0dca. \u0d92. \u0dd9\u0db4\u0dda\u0db8\u0dc3\u0dd2\u0dbb\u0dd2 \u0db8\u0dc4\u0dad\u0dcf, \u0dc0\u0dd0\u0da9 \u0dad\u0dc4\u0db1\u0db8\u0da7 \u0dbd\u0d9a\u0dca\u0dc0 \u0dc3\u0dd2\u0da7\u0dd2 \u0d9a\u0dcf\u0dbd\u0dc3\u0dd3\u0db8\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0d91\u0db1\u0db8\u0dca 1990.04.16 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 1991.04.19 \u0daf\u0dd2\u0db1 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc4\u0dcf 2002.11.13 \u0daf\u0dd2\u0db1 \u0dc3\u0dd2\u0da7 2006.09.18 \u0daf\u0dd2\u0db1 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d9a\u0dcf\u0dbd\u0dc3\u0dd3\u0db8\u0dcf\u0dc0\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0d94\u0dc4\u0dd4\u0da7 \u0dc4\u0dd2\u0d9f \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0d9a\u0dca \u0dad\u0dd2\u0dd9\u0db6\u0dca\u0daf, \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0d9a\u0dca \u0dad\u0dd2\u0dd9\u0db6\u0dca \u0db1\u0db8\u0dca \u0d91\u0dba \u0dd9\u0db1\u0ddc\u0dd9\u0d9c\u0dc0\u0dd3\u0db8 \u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd3 \u0dad\u0dd2\u0dd9\u0db6\u0dca\u0daf \u0dba\u0db1\u0dca\u0db1\u0dad\u0dca, \u0d91\u0dd9\u0dc3\u0dda \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc0 \u0dad\u0dd2\u0dd9\u0db6\u0dca \u0db1\u0db8\u0dca \u0d94\u0dc4\u0dd4\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dc4\u0db1 \u0d9a\u0dc0\u0dd9\u0dbb\u0dca\u0daf \u0dba\u0db1\u0dca\u0db1\u0dad\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dd9\u0dc0\u0dca.\u201d \u0d91\u0da0\u0dca. \u0dd9\u0d9a\u0dca. \u0dd9\u0d9a\u0dca. \u0d92. \u0da2\u0dba\u0dc3\u0dd4\u0db1\u0dca\u0daf\u0dbb, \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dd9\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca. 2024 \u0d94\u0d9a\u0dca\u0dd9\u0dad\u0ddd\u0db6\u0dbb\u0dca \u0db8\u0dc3 28 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0dd9\u0d9a\u0ddc\u0dc5\u0db9 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dd9\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca \u0dad\u0dd0\u0db1\u0dd9\u0d9c\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dd9\u0dba\u0dca \u0daf\u0dd3 \u0daf\u0dd2\u0db1 \u0dd9\u0dba\u0ddc\u0daf\u0db1 \u0dbd\u0daf\u0dd3. EOG 11 - 0087",
