    "text": "\u0dd9\u0db8\u0db8 \u0db1\u0dd2\u0dd9\u0dba\u0ddd\u0d9c\u0dba \u0d85\u0db1\u0dd4\u0db6\u0daf\u0dca\u0db0\u0dd2\u0dad \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dd9\u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca\u0dc0\u0dbb\u0dba\u0dcf\u0dd9\u0d9c\u0dca \u0db4\u0d9a\u0dcf\u0dc1\u0db1\u0dd9\u0dba\u0dca \u0db1\u0dd2\u0dba\u0db8 \u0d9a\u0dbb \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dab\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 - \u0da9\u0db6\u0dca. \u0d91\u0db8\u0dca. \u0d85\u0dd9\u0dc1\u0ddd\u0d9a\u0dcf \u0daf\u0db8\u0dba\u0db1\u0dca\u0dad\u0dd2 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2 \u0db8\u0dd2\u0dba, \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 (\u0dbb\u0dcf. \u0d86.), \u0db8\u0dcf\u0daf\u0dd4\u0dbb\u0dd4\u0d94\u0dba \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0d89\u0dc0\u0dd4\u0dbb \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba,",
