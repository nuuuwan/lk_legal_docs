    "text": "\u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba\u0dba\u0dca\u0dad \u0db8\u0dc5 \u0dba\u0dbd\u0dcf \u0db3\u0dc6\u0dbd\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbc\u0dcf\u0dbc \u0d85\u0db1\u0dd4\u0dbd, \u0d91\u0d9a\u0dd3 \u0d86\u0dbb\u0dc5\u0dc0\u0dd4\u0dbc \u0dba\u0db6\u0dca\u0dbb\u0dd4\u0db8\u0dca \u0dd2\u0dba\u0dbb\u0dd3\u0dba\u0db8\u0dca\u0dad \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0dd2\u0dba\u0dbb\u0dd3\u0db8 \u0dc0\u0db2\u0dc1\u0dc5 \u0dba\u0db6\u0dca\u0dbb\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dbd\u0dbe\u0dba\u0dba\u0dca\u0dad \u0dd2\u0dc5\u0dd2\u0db6\u0dba\u0dca\u0dad\u0d9a\u0dbc, \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dc5\u0dba\u0dbc\u0ddd\u0d9a \u0db3\u0dc5\u0dbb, \u0d85\u0d82\u0d9a 40, \u0d86\u0dcf\u0dc5\u0dbb\u0dca\u0dba \u0dba\u0dca\u0dc0. \u0d92. \u0dad\u0dd2\u0dbc\u0d9a\u0dbb\u0dda\u0db1 \u0db8\u0dc1\u0dcf\u0dc5 \u0db3\u0dda \u0d9a\u0dbb \u0d94\u0dc4\u0dd4 \u0dba\u0dbd\u0dcf \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0dba\u0dba\u0ddc\u0dd4\u0daf \u0d9a\u0dbb\u0db1\u0dd4 \u0dbc\u0dc6\u0dba\u0db6\u0dca. \u0db8\u0dc1\u0dc5\u0dcf\u0dc5\u0dbb\u0dca\u0dba \u0d85\u0db1\u0dd2\u0dca \u0da2\u0dba\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb \u0dcf\u0db1\u0dca\u0dd4, \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d85\u0db8\u0dc5\u0dcf\u0dba. 2024 \u0dba\u0d9a\u0dc0\u0dc6\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc0 19 \u0dbd\u0dc6\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0dba\u0d9a\u0ddc\u0dc2\u0db9 \u0daf\u0dd3 \u0dba.",
