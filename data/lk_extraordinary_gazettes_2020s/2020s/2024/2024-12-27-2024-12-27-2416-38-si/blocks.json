    "text": "\u0dc0\u0dc1 \u0dbc\u0d82\u0d9a\u0dc5 \u0db0\u0dd3\u0dbd\u0dbb \u0dc0\u0d82\u0dc0\u0dc4\u0dae\u0dc5\u0dbd, \u0d85\u0d82\u0d9a 15, \u0dba\u0dbb\u0ddc\u0dca\u0dc0 \u0dc1\u0dc0\u0dd4\u0dc0\u0dc4 \u0db3\u0da7\u0dd4\u0db8\u0d9c, \u0dba\u0d9a\u0ddc\u0dc2\u0db9 15. \u0d89\u0dc1\u0dcf \u0dc0\u0db2\u0dc1\u0dca\u0dad \u0db3\u0dc5\u0dbb\u0dca\u0dbe\u0dc4\u0dbd\u0dba\u0dca\u0dad \u0d85\u0dcf\u0dbb \u0d87\u0dad\u0dd2 \u0d9a\u0dc5\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dc5\u0dc0\u0dd4\u0dbc\u0da7 \u0dba\u0dc1\u0dda\u0dad\u0dd4\u0dc0\u0dd3 \u0db3\u0dbd\u0dda\u0db1\u0dc5 \u0d9a\u0dbb\u0dd4\u0dba \u0dbd\u0db1\u0dd4\u0dba\u0dda, \u201c\u0dbc\u0d82\u0d9a\u0dc5 \u0db0\u0dd3\u0dbd\u0dbb \u0dc0\u0d82\u0dc0\u0dc4\u0dae\u0dc5\u0dba \u0dba\u0dc0\u0dda\u0dbd\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbc\u0db6\u0db1 \u0db4\u0dd3. \u0da9\u0dd3. \u0db4\u0dd3. \u0db4\u0dd4\u0dc0\u0dc4\u0dc0\u0dc6\u0dbd\u0dca\u0dbc \u0db8\u0dc1\u0dcf\u0dc5\u0da7 \u0dc0\u0dc5\u0db8\u0dc5\u0db1\u0dba\u0dc5\u0db0\u0dd2\u0d9a\u0dc5\u0dbb\u0dd2 \u0dcf\u0db1\u0dad\u0dd4\u0dba\u0dbb\u0dca \u0dbb\u0dc5\u0da2\u0dcf\u0d9a\u0dc5\u0dbb\u0dd3 \u0d86\u0dbd\u0dbb\u0dba\u0dba \u0d9a\u0dbb\u0db1 \u0dbc\u0d9a 2017.12.07 \u0dc3\u0da7 2019.05.01 \u0d9a\u0dca\u0dc0\u0dbd\u0dc5 \u0d9a\u0dc5\u0dbc\u0dba \u0dc0\u0db2\u0dc1\u0dc5 \u0dbd\u0dc6\u0da9 \u0db6\u0dc6\u0dbd\u0dd3\u0dba\u0db8\u0dca \u0daf\u0dd3\u0db8\u0db1\u0dc5\u0dbd\u0dca\u0dc0 \u0dc4\u0dd2\u0db8\u0dd2 \u0d9a, \u0dc4\u0dd2\u0db8\u0dd2\u0db1\u0db8\u0dca \u0d91\u0dba \u0dbc\u0db6\u0dc5 \u0dba\u0db1\u0ddc\u0daf\u0dd3\u0db8 \u0db8\u0d9c\u0dd2\u0dca\u0dad \u0d94\u0dc4\u0dd4\u0da7 \u0d85\u0dc0\u0dc5\u0db0\u0dc5\u0dbb\u0dba\u0dba\u0dca\u0dc0 \u0dc3\u0daf\u0dd4\u0dbd \u0dad\u0dd2\u0dba\u0db6\u0dca \u0d9a \u0dba\u0dca\u0dad\u0db1\u0dda \u0d91\u0dba\u0dc0\u0dda \u0d85\u0dc0\u0dc5\u0db0\u0dc5\u0dbb\u0dba\u0dba\u0dca\u0dc0 \u0dc3\u0daf\u0dd4\u0dbd \u0dad\u0dd2\u0dba\u0db6\u0dca \u0db1\u0db8\u0dca \u0d94\u0dc4\u0dd4\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u