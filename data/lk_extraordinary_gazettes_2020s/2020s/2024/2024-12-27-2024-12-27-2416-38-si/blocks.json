  {
    "page_number": 0,
    "bbox": [
      51.98,
      531.98,
      538.79,
      750.5
    ],
    "text": "\u0dc0\u0dc1 \u0dbc\u0d82\u0d9a\u0dc5 \u0db0\u0dd3\u0dbd\u0dbb \u0dc0\u0d82\u0dc0\u0dc4\u0dae\u0dc5\u0dbd, \u0d85\u0d82\u0d9a 15, \u0dba\u0dbb\u0ddc\u0dca\u0dc0 \u0dc1\u0dc0\u0dd4\u0dc0\u0dc4 \u0db3\u0da7\u0dd4\u0db8\u0d9c, \u0dba\u0d9a\u0ddc\u0dc2\u0db9 15. \u0d85\u0dcf\u0dbb \u0d9a\u0dc5\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dc5\u0dc0\u0dd4\u0dbc\u0dca\u0dc0 \u0db3\u0dbd\u0dad\u0dd2\u0db1 \u0dba\u0dc1\u0dba\u0dd2\u0dca\u0dad \u0d9a, \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d85\u0db8\u0dc5\u0dcf\u0dba \u0db8\u0dc1\u0dc5\u0dcf\u0dc5\u0dbb\u0dca\u0dba \u0d85\u0db1\u0dd2\u0dbd\u0dca \u0da2\u0dcf\u0dba\u0dca\u0dad\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db1\u0dc5\u0dca\u0dad\u0daf\u0dd4 \u0dbd\u0db1 \u0db8\u0db8 1957 \u0d85\u0d82\u0d9a 14 \u0dc1\u0dc5 1957 \u0d85\u0d82\u0d9a 62 \u0dc1\u0dc5 1962 \u0d85\u0d82\u0d9a 4 \u0dc1\u0dc5 1968 \u0d85\u0d82\u0d9a 39 (1968 \u0d85\u0d82\u0d9a 37 \u0d9a\u0dbb\u0db1 \u0d9a\u0dc5\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dc5\u0dc0\u0dd4\u0dbd\u0dca (\u0dc0\u0dd2\u0dba\u0dbe\u0dda\u0dbf \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db3\u0dc5\u0d9a\u0db1) \u0db3\u0db1\u0dcf \u0dc0\u0db8\u0d9c \u0dd2\u0dba\u0dba\u0dbd\u0dc5) \u0d9a\u0dbb\u0db1 \u0db3\u0db1\u0dda\u0dbd\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0d82\u0dba\u0dbe\u0ddd\u0db0\u0dd2\u0dcf \u0dc0\u0dd5 \u0dbc\u0d82\u0d9a\u0dc5\u0dba \u0dbd\u0dba\u0dbd\u0dc0\u0dc4\u0dae\u0dc5\u0dd2\u0dc5\u0dcf \u0d85\u0dba\u0db3\u0db1\u0dda\u0dbd\u0dbc 131 \u0dbd\u0db1 \u0db3\u0dbb\u0dd2\u0dca\u0da1\u0dba\u0daf\u0d9a\u0dba (1956 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dba\u0dbe\u0ddd\u0db0\u0dd2\u0dcf \u0dd4\u0daf\u0dca\u200d\u0dbb\u0dba\u0dba) \u0dbd\u0db1 \u0d9a\u0dc5\u0dbb\u0dca\u0db8\u0dd2\u0d9a \u0d86\u0dbb\u0dc5\u0dc0\u0dd4\u0dbd\u0dca \u0db3\u0db1\u0dba\u0dda 4(1) \u0dbd\u0db1 \u0dbd\u0d9c\u0dca\u0dad\u0dad\u0dd2\u0dba\u0dba\u0dca\u0dad \u0db8\u0dc5 \u0dba\u0dbd\u0dcf \u0db3\u0dc6\u0dbd\u0dbb\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dbc\u0dcf\u0dbc \u0d85\u0db1\u0dd4\u0dbd, \u0d91\u0d9a\u0dd3 \u0d86\u0dbb\u0dc5\u0dc0\u0dd4\u0dbc \u0dba\u0db6\u0dca\u0dbb\u0dd4\u0db8\u0dca \u0dd2\u0dba\u0dbb\u0dd3\u0dba\u0db8\u0dca\u0dad \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0dd2\u0dba\u0dbb\u0dd3\u0db8 \u0dc0\u0db2\u0dc1\u0dc5 \u0dba\u0db6\u0dca\u0dbb\u0dd4\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0dbd\u0dbe\u0dba\u0dba\u0dca\u0dad \u0dba\u0dc1\u0ddd\u0d9a\u0dca\u0dad\u0d9a\u0dbb \u0d8b\u0dad\u0dd4\u0dbb, \u0d85\u0dbb\u0d82\u0d9c\u0dbc, \u0dbb\u0dba\u0db8\u0dba\u0dd4\u0dbb \u0db8\u0dc5\u0dbd\u0dcf, \u0d85\u0d82\u0d9a 453/\u0d91\u0dc3\u0dc4, \u0d9a\u0dd4\u0db8\u0dc5\u0dbb\u0dd2 \u0da2\u0dcf\u0dba\u0dbb\u0dda\u0db1 \u0db8\u0dd2\u0dba \u0db3\u0dda \u0d9a\u0dbb \u0d87\u0dba \u0dba\u0dbd\u0dcf \u0dba\u0db8\u0dba\u0dd2\u0dca\u0dad \u0dba\u0dba\u0ddc\u0dd4\u0daf \u0d9a\u0dbb\u0db1\u0dd4 \u0dbc\u0dc6\u0dba\u0db6\u0dca. \u0db8\u0dc1\u0dc5\u0dcf\u0dc5\u0dbb\u0dca\u0dba \u0d85\u0db1\u0dd2\u0dca \u0da2\u0dba\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb \u0dcf\u0db1\u0dca\u0dd4, \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0d85\u0db8\u0dc5\u0dcf\u0dba . 2024 \u0dba\u0d9a\u0dc0\u0dc6\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc0 19 \u0dbd\u0dc6\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0dba\u0d9a\u0ddc\u0dc2\u0db9 \u0daf\u0dd3 \u0dba.",
    "fonts": [
