    "text": "\u0dbc\u0db6\u0dc5\u0d9c\u0dc6\u0db1\u0dd3\u0db8\u0da7 \u0db6\u0dbc\u0dc5\u0dba\u0db4 \u0dba\u0dbb \u0dda\u0dad\u0dd4 \u0dbd\u0db1 \u0d89\u0da9\u0dba\u0db8\u0dca \u0dc0\u0dd2\u0dc0\u0dc4\u0dcf\u0dbb :- \u0db8\u0db0\u0dca\u200d\u200d\u0db8 \u0db4\u0dc2\u0dc5\u0dba\u0dda, \u0db8\u0dc5\u0dcf\u0dba\u0dda \u0daf\u0dd2\u0dc0\u0dc4\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0db8\u0dc5\u0dcf\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc5\u0dba\u0dd3\u0dba\u0dba \u0dba\u0dda\u0d9a\u0db8\u0dca \u0dba\u0d9a \u0da7\u0dca\u0da8\u0dc5\u0dc0\u0dba\u0dda, \u0d94\u0dba\u0db4\u0dc1\u0dc2 \u0d9c\u0dca\u200d\u0dbb\u0dc5\u0db8 \u0db1\u0dd2\u0dbc\u0db0\u0dca\u200d\u0dc5 \u0dc0 \u0dbd\u0dc0\u0dba\u0db8\u0dca, \u0dba\u0d9c \u0d82\u0d9c\u0dc5\u0dba\u0dbd\u0dbc (\u0dba\u0d9a \u0da7\u0dca\u0da8\u0dc5\u0dc0 \u0d85\u0d82\u0d9a 06, \u0daf\u0dd4\u0db8\u0dca \u0dc0\u0dba\u0dba\u0db4 \u0dc2 \u0dba\u0db4\u0dba\u0daf\u0dc0, \u0db8\u0dc5\u0dcf\u0dba\u0dda \u0db8\u0dc1 \u0db1\u0d9c\u0dbb \u0dc0\u0db7\u0dc5 \u0dc3\u0dd3\u0db8\u0dc5\u0dbd \u0dad\u0dd4\u0dc2) \u0dba\u0db1 \u0d9c\u0dba\u0db8\u0dc4\u0dd2 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc0\u0dbb\u0dca\u0dba\u0dc0\u0dca\u0dba\u0dbb\u0dca \u0da2\u0dcf\u0db1\u0dbb\u0dc5\u0dda \u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dad \u0db8\u0dc6\u0db1 \u0dc0\u0d9a\u0dc0\u0dc4 \u0d9a\u0dbb\u0db1 \u0dbc\u0daf \u0d85\u0d82\u0d9a 310362 \u0d9a\u0dc6\u0da9\u0dc6\u0dc0\u0dc4\u0dcf\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0dba\u0db8\u0dc4\u0dd2 \u0d9a\u0dc6\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 1 \u0dc3\u0dd2\u0da7 4 \u0dbd\u0dbe\u0dba\u0dba\u0dca\u0dad \u0daf\u0dc6\u0d9a\u0dca\u0dba\u0dbd\u0db1 \u0db8\u0dd4\u0dc5\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dc5\u0dba\u0dba \u0dba\u0dc1\u0d9a\u0dca. 0.0295 \u0d9a\u0dca \u0dc0\u0dd5 \u0db4\u0dc1\u0dcf \u0daf\u0dc6\u0d9a\u0dca\u0dba\u0dbd\u0db1 \u0d89\u0da9\u0db8\u0dca \u0dba\u0d9a \u0da7\u0dc0\u0dc4 \u0dc0\u0db3\u0dc1\u0dc5 \u0db8\u0dc5\u0dba\u0dd2\u0db8\u0dca :",
