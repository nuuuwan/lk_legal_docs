  },
  {
    "page_number": 0,
    "bbox": [
      50.78,
      500.4,
      286.26,
      563.37
    ],
    "text": "I hereby give notice Sub-section (1) of Section 7 of the Land Acquisition Act, as Amended by the Land Acquisition (Amendment) Act, No. 28 of 1964, that the Government intends to acquire the following land/ servitude which is required for a public purpose.",
    "fonts": [
      "Times New Roman"
    ],
    "sizes": [
      9.0,
      9.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      50.78,
      562.91,
      286.39,
      711.59
    ],
    "text": "Description of the land or servitude to be acquired: Preliminary Plan No. : CM 910392 Village : Karampan G. N. Division : J/54Karampan West D. S. Division : Islands North, Kayts District : Jaffna Province : Northern Province Purpose : Acquisition of land for Naval Security / SLNS Kanchadewa Security Zone \u201cC\u201d - Karampan.",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Italic"
    ],
    "sizes": [
      6.960000038146973,
      9.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.51,
      429.68,
      539.96,
      472.53
    ],
    "text": "01. Lot No. 01 Name of land: Oorundi and Ithinioda Oorundi; Land Use: Garden contains Five permanent buildings; Owner: Not Known; Extent: 0.4047 Hectare.",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Bold"
    ],
    "sizes": [
      9.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.51,
      472.07,
      539.92,
      599.61
    ],
    "text": "All persons interested in the aforesaid land/ lands on which a servitude is to be acquired are hereby required to appear personally, or by agents duly authorized in writing, before me at the Divisional Secretariat, Kayts on the 26th day of August 2024 at 10.00 a.m. and are hereby requested to notify to me in writing (in duplicate) on or before the 08th day of August 2024 the nature of their interests in the land, the particulars of their claims for Compensation for the acquisition of the said land/ servitude, the amount of compensation and the details of the Computation of such amount.",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Bold"
    ],
    "sizes": [
      6.480000019073486,
      9.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.51,
      599.04,
      524.01,
      703.43
    ],
    "text": "Manchuladevi Satheesan, Divisional Secretary, Kayts. At Divisional Secretariat, Kayts. 26th July 2024. EOG 07 - 0276",
    "fonts": [
      "Times New Roman",
      "Times New Roman,Bold"
    ],
    "sizes": [
      8.039999961853027,
      9.0,
