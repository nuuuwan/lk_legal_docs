    "text": "\u0dc0\u0dba\u0db9 \u0db4\u0dc5\u0dcf\u0dd9\u0dad\u0dca \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dd2\u0d9a\u0dca\u0d9a\u0dd9\u0dba\u0dca \u0db8\u0dc4\u0dc0 \u0db4\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd3\u0dba \u0dd9\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca \u0db4\u0dc4\u0dc5 \u0dc0\u0dd2\u0dc3\u0dd2\u0dd9\u0daf\u0dd9\u0d9a\u0dca \u0dd9\u0d9a\u0ddd\u0dbb\u0dc5\u0dd9\u0dba\u0dca \u0d9a\u0dd2\u0dbb\u0dd2\u0db8\u0dd0\u0da7\u0dd2\u0dba\u0dcf\u0dc0 \u0d9c\u0dcf\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2 \u0dd9\u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3\u0dd9\u0dba\u0dca \u0d9a\u0dd2\u0dbb\u0dd2\u0db8\u0dd0\u0da7\u0dd2\u0dba\u0dcf\u0dc0 \u0db1\u0db8\u0dd0\u0dad\u0dd2 \u0d9c\u0db8 (\u0d85\u0d82\u0d9a 3683 (\u0dc0\u0dba\u0db9) \u0daf\u0dbb\u0db1 \u0dbd\u0d82\u0d9a\u0dcf \u0db8\u0dd0\u0db1\u0dd3\u0dd9\u0db8\u0dca \u0d9c\u0db8\u0dca \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0db8) \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc3\u0dd2\u0daf\u0dca\u0db0 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0d82\u0d9a 5534 (\u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd) \u0daf\u0dbb\u0db1 \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0daf\u0dd0\u0db1\u0dca\u0dc0\u0dd3\u0db8 \u0d85\u0db1\u0dd4\u0dc0 2023 \u0da2\u0dd4\u0db1\u0dd2 08 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2 \u0d85\u0d82\u0d9a 2335/20 \u0daf\u0dbb\u0db1 \u0dc1\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0da2\u0dcf\u0dad\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a \u0dc3\u0db8\u0dcf\u0da2\u0dc0\u0dcf\u0daf\u0dd3 \u0da2\u0db1\u0dbb\u0da2\u0dd9\u0dba\u0dca \u0d85\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9\u0dc1\u0dda\u0dc2 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dd9\u0dba\u0dca III \u0dd9\u0d9a\u0ddc\u0da7\u0dc3 \u0d89\u0da9\u0db8\u0dca \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db4\u0dc5 \u0dc0\u0dd6 \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0db8\u0dca \u0d85\u0dc0\u0dc3\u0dcf\u0db1 \u0db1\u0d