      57.14,
      472.39,
      288.88,
      498.45
    ],
    "text": "My Reference No.: ARA/LND/ACQVI/D3/52 Ministry of Tourism and Lands No.: 4-3/15/2018/VE/08.",
    "fonts": [
      "Iskoola Pota",
      "Times New Roman",
      "Times New Roman,Bold",
