    ],
    "text": "Notification made under section 3(8) of the Road Passenger Transport Services Statute No. 01 of 1992 of the Western Provincial Council",
    "fonts": [
      "TimesNewRomanPS-BoldMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      48.0,
      458.35,
      542.53,
      531.49
    ],
    "text": "I, Roshan Goonetileke, the Governor of the Western Province, in terms of the powers vested in me under Article 154(C) of the 13th Amendment to the Constitution and Section 3(8) of the Road Passenger Transport Services Statue No. 01 of 1992 of the Western Provincial Council do hereby notify the removal of Prasanna Sanjeewa who functions as a member and the Chairman of the Road Passenger Transport Authority of the Western Province from the membership of the Authority as it is deemed satisfied that the said Prasanna Sanjeewa has failed to execute the powers and duties of the Authority properly when functioning in his office.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      48.0,
      542.35,
      530.15,
      615.49
    ],
    "text": "Roshan Goonetileke, RWP and BAR VSV USP Phd (Hon), FIM (Sri Lanka) ndc psc, Marshal of the Sri Lanka Air Force, The Governor, Western Province.",
    "fonts": [
      "TimesNewRomanPSMT",
      "TimesNewRomanPSMT-SC700"
    ],
    "sizes": [
      7.0,
      10.0
    ]
  },
