    "text": "\u0dc0\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dbd \u0db4\u0dc2\u0dcf\u0dba\u0dda, \u0d9a\u0dd1\u0d9c\u0dbd\u0dca\u0dbc \u0daf\u0dd2\u0dc0\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0d85\u0dbb\u0dba\u0dcf\u0dba\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dca\u0db0\u0dba \u0dba \u0dba\u0dbd\u0dca\u0d9a\u0db8\u0dca \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc0\u0dba\u0dda, \u0d9c\u0dbd\u0dca\u0dba\u0db6\u0ddc\u0da9 \u0dba\u0d9a\u0dc5\u0dbb\u0dba\u0dc2 (\u0db6\u0da7\u0dbb)\u0dbb) \u0dc3\u0dd4\u0dc5\u0dd4 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc0\u0dba\u0dda \u0d85\u0d82\u0d9a 43\u0db6\u0dd3, \u0d9c\u0dd0\u0da7\u0dba\u0dda\u0dbb\u0dd2\u0d9a\u0dca\u0dad\u0daf \u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8 \u0db1\u0dd2\u0dbc \u0dcf\u0dbb\u0dd2 \u0dba\u0d9a\u0ddc\u0da7\u0dca\u0dc3\u0dcf\u0dc0\u0dba\u0dda, \u0dbd\u0dd0\u0dbd\u0dd2\u0db8\u0dca\u0dad\u0db1 \u0d9c\u0dba\u0db8\u0dca \u0db4\u0dd2\u0dbb)\u0da7\u0dd2 \u0dba\u0da2\u0dcf\u200d\u0dbf\u0dca\u0dc3 \u0db8\u0dd2\u0db1\u0dd2\u0dca\u0dad\u0dba\u0daf\u0dc5\u0dbb\u0dd4 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2 \u0dc0\u0dd2\u0dc3\u0dd2\u0daf\u0dca\u0dad 2019.12.17 \u0daf\u0dd2\u0db1\u0dd0\u0dad\u0dd2\u0dbd \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0dba\u0dbc \u0d9a\u0dbb\u0db1 \u0dbc\u0daf \u0db8\u0dd4.\u0db4\u0dd2.\u0d9a\u0dd1. 3742 \u0daf\u0dbb\u0db1 \u0db8\u0dd6\u0dbd\u0dd2\u0d9a \u0db4\u0dd2\u0db9\u0dd4\u0dba\u0dda \u0d9a\u0dd0\u0db6\u0dbd\u0dd2 \u0d85\u0d82\u0d9a 01 \u0dbd\u0dbe\u0dba\u0dba\u0dca\u0dad \u0dba\u0db4\u0dca\u0dad\u0db1\u0dd4\u0db8\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dba\u0dba\u0dba\u0dca\u0dad \u0dba\u0dc1\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dda 0.0202\u0d9a\u0dca \u0db4\u0db8\u0dba \u0dc0\u0dd5 \u0db1\u0dd2\u0d9a\u0dcf\u0dd0\u0dca\u0dad\u0db1 \u0dbd\u0dda\u0dcf \u0db1\u0dd0\u0db8\u0dd0\u0dad\u0dd2 \u0d89\u0da9\u0db8 \u0dc0\u0db3\u0dc1\u0dcf \u0db8\u0dcf\u0dba\u0dd2\u0db8\u0dca.",
