  },
  {
    "page_number": 0,
    "bbox": [
      48.05,
      453.9,
      542.6,
      506.07
    ],
    "text": "IT is hereby notified that by virtue of the powers vested in the Central Bank of Sri Lanka established under the Central Bank of Sri Lanka Act, No. 16 of 2023, in terms of Section 192 of the Civil Procedure Code, as amended by the Civil Procedure Code (Amendment) Act, No. 06 of 1990, the Central Bank has, having regard to the current rates of bank interest, determined that with effect from 01st January 2025, the Legal Rate of Interest shall be twelve point one two per centum (12.12%) per annum.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
