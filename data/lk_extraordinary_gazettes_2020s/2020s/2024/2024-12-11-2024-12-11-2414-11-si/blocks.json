    "text": "\u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0dc0\u0dca 99\u0d85 \u0dc0\u0dca\u200d\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db4\u0d9a\u0dcf\u0dc1\u0db1\u0dba \u0dd9\u0db8\u0dc4\u0dd2 \u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dd9\u0dba\u0dca II \u0dc0\u0dd0\u0db1\u0dd2 \u0dad\u0dd3\u0dbb\u0dd4\u0dd9\u0dc0\u0dc4\u0dd2 \u0daf\u0dd0\u0d9a\u0dca\u0dd9\u0dc0\u0db1 \u0dad\u0dd0\u0db1\u0dd0\u0dad\u0dca\u0dad\u0db1\u0dca\u0dd9\u0d9c\u0db1\u0dca \u0d91\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0dad\u0dd0\u0db1\u0dd0\u0dad\u0dca\u0dad\u0dcf, \u0d92 \u0d8b\u0db4\u0dd9\u0dbd\u0dca\u0d9b\u0db1\u0dd9\u0dba\u0dca I \u0dc0\u0dd0\u0db1\u0dd2 \u0dad\u0dd3\u0dbb\u0dd4\u0dd9\u0dc0\u0dc4\u0dd2 \u0d85\u0db1\u0dd4\u0dbb\u0dd6\u0db4 \u0dc3\u0da7\u0dc4\u0dd9\u0db1\u0dc4\u0dd2 \u0dc3`o\u0dc4\u0db1\u0dca \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0dd9\u0dc0\u0db1\u0dd4\u0dd9\u0dc0\u0db1\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dd9\u0dc0\u0dca 99\u0d85 \u0dc0\u0dca\u200d\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dba\u0da7\u0dd9\u0dad\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0dd9\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dd3\u0dc0\u0dbb\u0dd9\u0dba\u0d9a\u0dd4 \u0dc0\u0dc1\u0dd9\u0dba\u0db1\u0dca \u0dd9\u0dad\u0ddd\u0dbb\u0dcf \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dbd\u0daf \u0db6\u0dc0 \u0dd9\u0db8\u0dba\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dd9\u0dc0\u0dca\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dd9\u0db6\u0dca. \u0d86\u0dbb\u0dca. \u0d91\u0db8\u0dca. \u0d92. \u0d91\u0dbd\u0dca. \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a, \u0d91\u0db8\u0dca. \u0d92. \u0db4\u0dd3. \u0dc3\u0dd3. \u0dd9\u0db4\u0dd9\u0dbb\u0dca\u0dbb\u0dcf, \u0d85\u0db8\u0dd3\u0dbb\u0dca \u0dc6\u0dcf\u0dba\u0dd2\u0dc3\u0dca, \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2, \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a, \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a, \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0. \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0. \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0. \u0d92. \u0dc2\u0db1\u0dca\u0db8\u0dd4\u0d9c\u0db1\u0dcf\u0daf\u0db1\u0dca, \u0db8\u0dc4\u0dcf\u0da0\u0dcf\u0dbb\u0dca\u0dba \u0dbd\u0d9a\u0dca\u0dc2\u0dca\u0db8\u0db1\u0dca \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a, \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a, \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a, \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0. \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0. 2024 \u0dd9\u0daf\u0dc3\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc3 11 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1, \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0, \u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dbb\u0dab \u0dd9\u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba, \u0dc3\u0dbb\u0dab \u0db8\u0dcf\u0dc0\u0dad, \u0dbb\u0dcf\u0da2\u0d9c\u0dd2\u0dbb\u0dd2\u0dba.",
