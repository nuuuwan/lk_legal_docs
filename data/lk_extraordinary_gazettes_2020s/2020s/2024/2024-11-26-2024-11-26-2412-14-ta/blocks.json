    ],
    "text": "(\u0b85) \u0ba4\u0bc8\u0bbe\u0bb3\u0bc3\u0bae\u0bcd\u0b95\u0baa\u0b9a\u0bcd \u0b9a\u0b9a\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0baa\u0bbf\u0bad\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4 \u0ba4\u0ba8\u0bbe\u0ba4\u0bcd\u0ba4\u0bbe\u0bbe\u0bbf\u0b9a\u0bc1 \u0b9a\u0bc1\u0bad\u0bb5\u0bc0\u0bad \u0b86\u0bad\u0b9a\u0bcd\u0b9a\u0bbf\u0b9a\u0bc8 \u0ba4\u0b9f\u0baf\u0bbe\u0bbe\u0bbf \u0b85\u0bab\u0ba8\u0bcd\u0ba4\u0bbf\u0bc8\u0bbe \u0b9a\u0bc1\u0bad\u0bb5\u0bc0\u0bad\u0bb2\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b85\u0ba4\u0bcd\u0ba4\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 2023 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0b92\u0bb1\u0bcd\u0b9a\u0bae\u0bbe\u0baa\u0bb0\u0bcd 28 \u0b86\u0ba8\u0bcd \u0ba4\u0bbf\u0bc8\u0ba4\u0bbf\u0bac\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 2460 \u0b86\u0bae\u0bcd \u0b87\u0baf\u0b95\u0bcd\u0bc8 \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baa\u0bcd \u0ba4\u0baa\u0bbe\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bb1\u0bc1\u0ba4\u0bbf\u0bac\u0bbf\u0ba9\u0bcd \u0bc8\u0bc0\u0bb4\u0bcd \u0bae\u0bc1\u0b95\u0bae\u0bac\u0bbe\u0bc8 \u0ba8\u0bbf\u0bac\u0bab\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b9a\u0bab\u0b9a\u0baf \u0ba4\u0baa\u0bac\u0bbe\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0b9a\u0bbe\u0bb2\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baa\u0bcd\u0ba4\u0baa\u0bbe\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bcd \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baa\u0bcd\u0ba4\u0baa\u0bbe\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0bb0\u0bb0\u0bcd\u0bc8\u0bb3\u0bc1\u0bae\u0bcd \u0b85\u0bb2\u0bb0\u0bcd\u0bc8\u0bb0\u0ba4\u0bc1 \u0b85\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb1\u0bc1\u0ba8\u0bb0\u0bcd\u0bc8\u0bb3\u0bc1\u0bae\u0bcd \u2018\u2018\u0b9a\u0bac\u0bbe\u0bc8\u0bbe\u0baa\u0bc1\u0bad\u0bae\u0bcd \u0b9c\u0bac\u0bad\u0ba4\u0bcd\u0ba9\u0bae\u0bcd \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baa\u0bcd \u0ba4\u0baa\u0bbe\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u201d \u0b8e\u0ba9\u0bc1\u0bae\u0bcd \u0ba4\u0baa\u0bac\u0bb0\u0bcd \u0bab\u0b95\u0bc1\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd\u0bc8\u0bc0\u0bb4\u0bcd \u0ba4\u0baa\u0bbe\u0ba4\u0bc1 \u0b87\u0baf\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0ba9\u0b95\u0bac\u0baf\u0bc1\u0bae\u0bcd \u0b87\u0b95\u0b9f\u0bac\u0bae\u0bbe \u0bb2\u0bb1\u0bbf\u0baf\u0bc1\u0bbe\u0bbf\u0b95\u0bab\u0b95\u0bac\u0baf\u0bc1\u0bae\u0bcd \u0ba4\u0bc8\u0bbe\u0ba3\u0bcd\u0b9f \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bbf\u0b95\u0bc8\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bc1\u0bb3\u0bc3\u0ba4\u0bb2\u0bbe\u0ba9\u0bcd\u0bae\u0bbe\u0ba4\u0bb2\u0bcd \u0b9a\u0bb2\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bb5\u0bc1\u0bae\u0bcd ; (\u0b86) \u0ba4\u0b9a\u0bbe\u0bb2\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baa\u0bcd \u0ba4\u0baa\u0bbe\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0bb0\u0bb0\u0bcd\u0bc8\u0bb3\u0bcd \u0ba4\u0b9a\u0bbe\u0bb2\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0baa\u0bac\u0bb0\u0bcd \u0bab\u0b95\u0bc1\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bc8\u0bc0\u0bb4\u0bcd, \u0ba4\u0b9a\u0bbe\u0bb2\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baa\u0bcd \u0ba4\u0baa\u0bbe\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bcd \u0b9a\u0bbe\u0bb0\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u0b8f\u0b9a\u0ba4\u0ba9\u0bc1\u0bae\u0bcd \u0b85\u0b95\u0b9a\u0bb5\u0bc1\u0bb3\u0bcd\u0bb0 \u0b85\u0bb2\u0bcd\u0baf\u0ba4\u0bc1 \u0b85\u0b95\u0b9a\u0bb2\u0bb1\u0bcd\u0bae \u0b86\u0ba4\u0ba9\u0ba4\u0bcd\u0b95\u0ba4\u0b95\u0bcd \u0ba4\u0bc8\u0bbe\u0bb3\u0bcd\u0bb2\u0ba9\u0bb5\u0bc1 \u0ba4\u0b9a\u0baf\u0bcd\u0bac\u0baf\u0bbe\u0bae\u0bcd, \u0ba4\u0baa\u0bae\u0baf\u0bbe\u0bae\u0bcd, \u0b95\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0bc8\u0baf\u0bbe\u0bae\u0bcd, \u0bc8\u0b9f\u0ba9\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0bc8\u0baf\u0bbe\u0bae\u0bcd \u0b85\u0bb2\u0bcd\u0baf\u0ba4\u0bc1 \u0b9a\u0bb2\u0bb1\u0bc1 \u0bb2\u0b95\u0bc8\u0bac\u0bbf\u0bb2\u0bcd \u0ba4\u0bc8\u0bbe\u0bb3\u0bcd\u0bb0\u0baf\u0bbe\u0bae\u0bcd, \u0bb2\u0bbf\u0bb1\u0bcd\u0bc8\u0baf\u0bbe\u0bae\u0bcd, \u0ba4\u0bc8\u0bbe\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bab\u0bbe\u0bb1\u0bcd\u0bae\u0baf\u0bbe\u0bae\u0bcd, \u0b88\u0b9f\u0bc1\u0b95\u0bb2\u0b95\u0bcd\u0bc8\u0baf\u0bbe\u0bae\u0bcd, \u0b85\u0b9f\u0bab\u0bbe\u0ba9\u0bae\u0bcd \u0b95\u0bb2\u0b95\u0bcd\u0bc8\u0baf\u0bbe\u0bae\u0bcd, \u0b95\u0bc1\u0ba4\u0bcd\u0ba4\u0b95\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0ba4\u0bc8\u0bbe\u0b9f\u0bc1\u0b95\u0bcd\u0bc8\u0baf\u0bbe\u0bae\u0bcd \u0b85\u0bb2\u0bcd\u0baf\u0ba4\u0bc1 \u0b9a\u0bb2\u0bb1\u0bc1 \u0bb2\u0b95\u0bc8\u0bac\u0bbf\u0bb2\u0bcd \u0b95\u0bc8\u0baf\u0bc1\u0ba4\u0bbf\u0bb0\u0bcd\u0b95\u0bcd\u0bc8\u0baf\u0bbe\u0bae\u0bcd \u0b8e\u0ba9\u0bb5\u0bc1\u0bae\u0bcd ; \u0b85\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd (\u0b87) \u0ba4\u0b9a\u0bbe\u0bb2\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baa\u0bcd \u0ba4\u0baa\u0bbe\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0bb0\u0bb0\u0bcd\u0bc8\u0bb3\u0bcd \u0ba4\u0b9a\u0bbe\u0bb2\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0baa\u0bac\u0bb0\u0bcd \u0bab\u0b95\u0bc1\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bc8\u0bc0\u0bb4\u0bcd \u0ba4\u0b9a\u0bbe\u0bb2\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baa\u0bcd \u0ba4\u0baa\u0bbe\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0ba4\u0bcd \u0ba4\u0ba4\u0bbe\u0b9f\u0bb0\u0bcd\u0baa\u0bbf\u0bb2\u0bcd, \u0b8e\u0bb3\u0bc3\u0bc8\u0bbf\u0ba9\u0bcd\u0bae \u0b8e\u0bb2\u0bcd\u0baf\u0bbe \u0bb2\u0bb1\u0b95\u0bcd\u0b95\u0bc1\u0bc8\u0bb0\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0bb2\u0bb1\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0b9f\u0bb2\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0bc8\u0bb0\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0b87\u0baf\u0b99\u0bcd\u0b95\u0bc8\u0bac\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb0 \u0b85\u0bb2\u0bcd\u0baf\u0ba4\u0bc1 \u0b9a\u0bb2\u0bb1\u0bc1 \u0b8e\u0b99\u0bcd\u0b9a\u0bc8\u0ba9\u0bc1\u0bae\u0bc1\u0bb3\u0bcd\u0bb0 \u0b8f\u0b9a\u0ba4\u0ba9\u0bc1\u0bae\u0bcd \u0ba8\u0bc0\u0ba4\u0bbf\u0bab\u0ba9\u0bcd\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0bb2\u0bb1\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0ba4\u0ba4\u0bbe\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd, \u0bb2\u0bb1\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0ba4\u0ba4\u0bbe\u0b9f\u0bc1\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bb2\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd, \u0baa\u0ba4\u0bbf\u0baf\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd, \u0baa\u0ba4\u0bbf\u0baf\u0bb0\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bb2\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd, \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0bb2\u0bbe\u0ba4\u0bae\u0bcd \u0ba4\u0b9a\u0baf\u0bcd\u0bb2\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bab\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0bb2\u0bbe\u0ba4\u0bae\u0bcd \u0ba4\u0b9a\u0baf\u0bcd\u0bac\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bb2\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b9a\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b87\u0bac\u0ba9\u0bcd\u0bae\u0bb2\u0bb0\u0bcd\u0bc8\u0bb0\u0bbe\u0bc8\u0bb5\u0bc1\u0bae\u0bcd \u0ba4\u0b95\u0bc1\u0ba4\u0bbf\u0bb2\u0bbe\u0baf\u0bcd\u0ba8\u0bcd\u0ba4\u0bb2\u0bb0\u0bcd\u0bc8\u0bb0\u0bbe\u0bc8\u0bb5\u0bc1\u0bae\u0bcd \u0b87\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b9a\u0bb2\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bb5\u0bc1\u0bae\u0bcd ; \u0baa\u0bc8\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba4\u0bb2\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bc8\u0bbf\u0ba9\u0bcd\u0b9a\u0bae\u0ba9\u0bcd. \u0b87\u0b95\u0bcd\u0bc8\u0b9f\u0bcd\u0b9f\u0b95\u0bb0\u0bac\u0bbe\u0ba9\u0ba4\u0bc1 \u0b87\u0bb2\u0bcd\u0baf\u0bbe\u0ba4\u0ba4\u0bbe\u0bb1\u0bbf\u0b95\u0bcd\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0baf\u0bbe\u0bae\u0bcd \u0b85\u0bb2\u0bcd\u0baf\u0ba4\u0bc1 \u0b85\u0bb2\u0b9a\u0bbf\u0bac\u0ba4\u0bab\u0ba9 \u0b8e\u0ba9\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0b9a\u0ba4\u0bbe\u0ba9\u0bcd\u0bb1\u0bc1\u0bc8\u0bbf\u0ba9\u0bcd\u0bae\u0bb2\u0bbe\u0bae\u0bbe\u0ba9 \u0b85\u0ba4\u0bcd\u0ba4\u0b95\u0bc8\u0bac \u0bae\u0bc1\u0b95\u0bae\u0bac\u0bbf\u0bb2\u0bcd \u0bc8\u0bbe\u0baf\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd\u0bc8\u0bbe\u0baf\u0bae\u0bcd \u0b9a\u0bb2\u0bb1\u0bc1\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0baf\u0bbe\u0bae\u0bcd \u0b85\u0bb2\u0bcd\u0baf\u0ba4\u0bc1 \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0baf\u0bbe\u0bae\u0bcd. \u0bb9\u0bbe\u0bbf\u0ba9\u0bbf \u0b85\u0bab\u0bad\u0b9a\u0bc2\u0bbe\u0bbf\u0bac, \u0ba8\u0bc0\u0ba4\u0bbf, \u0ba4\u0baa\u0bbe\u0ba4\u0bc1\u0ba8\u0bbf\u0bb0\u0bc1\u0bb2\u0bbe\u0bc8, \u0b89\u0bb3\u0bcd\u0ba8\u0bbe\u0b9f\u0bcd\u0b9f\u0bb2\u0bc1\u0bb2\u0bb2\u0bcd\u0bc8\u0bb3\u0bcd, \u0bab\u0bbe\u0bc8\u0bbe\u0bc8 \u0b9a\u0b95\u0baa\u0bc8\u0bb3\u0bcd, \u0b89\u0bb3\u0bcd\u0bb3\u0bc2\u0bad\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf \u0bab\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba4\u0ba4\u0bbe\u0bb1\u0bbf\u0bb2\u0bcd \u0b85\u0b95\u0bab\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd. \u0ba4\u0bc8\u0bbe\u0bb3\u0bc3\u0bae\u0bcd\u0baa\u0bc1, 2024, \u0ba8\u0ba4\u0bb2\u0bae\u0bcd\u0baa\u0bb0\u0bcd 07. EOG 11 - 0162",
