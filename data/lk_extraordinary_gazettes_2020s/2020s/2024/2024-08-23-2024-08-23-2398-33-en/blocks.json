    ],
    "text": "Notice under Section 53(1) (b) of the Statute of Central Province Co-operative Societies No. 10 of 1990 as amended by the Statute No. 04 of 1993",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
