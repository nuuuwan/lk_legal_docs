  },
  {
    "page_number": 0,
    "bbox": [
      48.02,
      481.68,
      542.71,
      555.15
    ],
    "text": "All members officers employees and non-members who have done business with one of the following Co-operative Societies in the Kandy District of the central Province where the registration has been cancelled and the liquidation proceedings are being carried out are being called in relation to the money owed to the institutions Accordingly the submission of claims should be made through an application form prepared in the following format and one application form should be sent to the liquidator by registered mail on or before 23.11.2024 Alternatively you can meet and deliver at the following address 23.11.2024 I, further note that the claim submitted after 23.11.2024 will not be considered.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
