  },
  {
    "page_number": 0,
    "bbox": [
      50.82,
      601.25,
      286.6,
      677.58
    ],
    "text": "The following land depicted in C.M. No. 820108 situated in Gurubebila (Midigama) in Grama Niladhari\u2019s Division of Gurubebila\u2014380 A in the Divisional Secretary\u2019s Division of Weligama in Matara District in the Southern Province for the purpose of expansion of Midigama Market.",
    "fonts": [
      "TimesNewRoman"
    ],
    "sizes": [
      1.0199999809265137,
      10.020000457763672
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      304.5,
      443.47,
      539.94,
      599.66
    ],
    "text": "01. Lot No. 1 Name of the Land: Usbandarawatta; Claimant: D.L. Mervin Janaka Gunasekara; Extent: 0.0343 Hectare. All persons interested in the aforesaid land/ Servitude is to be acquired are hereby required to appear personally, or by agents duly authorized in writing before me at Divisional Seretariat,Weligama on the 30th day of October 2024 at 10.00 a.m. and are hereby requested to notify to me in writing (in duplicate) on or before the 23rd day of October, 2024 mentioning the nature of their interests in the land, the particulars of their claims for compensation and the details of the computation of such amount.",
    "fonts": [
      "TimesNewRoman",
      "TimesNewRoman,Bold"
    ],
    "sizes": [
      7.019999980926514,
      10.020000457763672
