bf\u0bb2\u0bcd \u0b89\u0bbe\u0bbf\u0baf \u1f99\u0bc8\u0bb1\u0baf\u0bbf\u0bb2\u0bcd \u0bc6\u0bb5\u0bb3\u0bbf\u0baf\u0bbf\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u1f90\u0bae\u0bcd, \u0b95\u0bbe\u0ba3\u0bbf\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b89\u0bbe\u0bbf\u0bc8\u0bae\u0b95\u0bcd \u0bc7\u0b95\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0bc8\u0b95\u0b95\u0bc8\u0bb3\u0b95\u0bcd \u0bc7\u0b95\u0bbe\u1f9e\u0b95\u0bbf\u0ba9\u0bcd\u0bb1\u1f90\u0bae\u0bbe\u0ba9 81/0245 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u1fa2\u0bb2\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc0\u1f8c \u0bc6\u0b9a\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bc6\u0ba4\u0ba9\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bbe\u1fa2 \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd,\u0bc6\u0ba8\u1fa4\u0bb5 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b87\u0bb2. 232\u0b9a\u0bc0 - \u0ba4\u0ba9\u0bb5\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0bc7\u0b9a\u0bc8\u0bb5 \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u1f94\u0bb3\u0bcd \u0ba4\u0ba9\u0bb5\u0bb2 \u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3\u1f90\u0bae\u0bcd 810653 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b95\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bb2\u0bcd \u0b85\u0bb3\u0bc8\u0bb5 \u0bb5\u0bc8\u0bb0\u0baa\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u1fab \u0b87\u0bb2 03 \u0b87\u0bb2\u0bcd \u0b85\u0b9f\u0b99\u0bcd\u0b95\u0bbf\u1f9c\u0bb3\u0bcd\u0bb3\u1f90\u0bae\u0bbe\u0ba9 1 : 2, 1 : 3, 1 : 11, 1 : 46, 1 : 81 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd 1 : 82 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0b99\u0bcd\u0b95\u0bc8\u0bb3\u0b95\u0bcd \u0bc6\u0b95\u0bbe\u0ba3\u0bcd\u0b9f \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\