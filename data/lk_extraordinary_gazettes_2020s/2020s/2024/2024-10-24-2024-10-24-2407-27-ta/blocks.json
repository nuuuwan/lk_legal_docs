    "text": "\u0bb5\u0b9f\u0bc7\u0bae\u0bb2\u0bcd \u0bae\u0bbe\u0b95\u0bbe\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd, \u0b95\u0bc1\u1f9e\u0ba8\u0bbe\u0b95\u0bb2\u0bcd \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd, \u0ba8\u0bbe\u0bb0\u0bae\u0bcd\u0bae\u0bc8\u0bb2 \u0baa\u0bbf\u0bb0\u0bc7\u0ba4\u0b9a \u0bc6\u0b9a\u0baf\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd, \u0b87\u0bb2. 1052, \u0baa\u0bb2\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4 \u0b95\u0bbf\u0bb0\u0bbe\u0bae \u0b85\u1fa4\u0bb5\u0bb2\u0bb0\u0bcd \u0baa\u0bbf\u0bbe\u0bbf\u0bb5\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0baa\u0bb2\u0bb5\u0ba4\u0bcd\u0bc8\u0ba4\u0b95\u0bbf\u0bb0\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0bc8\u0bae\u0ba8\u0bcd\u1f90\u0bb3\u0bcd\u0bb3, \u0b95\u0bc1\u1f9e\u0ba8\u0bbe\u0b95\u0bb2\u0bcd \u0bae\u0bbe\u0bb5\u0b9f\u0bcd\u0b9f \u0b9a\u0bbf\u0bc7\u0bb0\u0bb7\u0bcd\u0b9f \u0ba8\u0bbf\u0bb2 \u0b85\u0bb3\u0bc8\u0bb5\u0baf\u0bbe\u0bb3\u0bb0\u0bcd \u0ba8\u0bbe\u0baf\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0ba4\u0baf\u0bbe\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f 2023.12.29 \u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf\u0baf \u0b9a\u0bc1\u0bb5\u0b9f\u0bcd\u1f8c \u0bb5\u0bc8\u0bb0\u0baa\u0b9f \u0b87\u0bb2. 420777, \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 03 \u0bae\u0bb1\u0bcd\u1fa0\u0bae\u0bcd \u0ba4\u0bbe\u0bb3\u0bcd \u0b87\u0bb2. 01 \u0b87\u0bb2\u0bcd \u1f90\u0ba3\u0bcd\u1f8c \u0b87\u0bb2. 01 - 08 \u0bb5\u0bc8\u0bb0 \u0bb5\u0bbf\u0baa\u0bbe\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u1f8c\u0bb3\u0bcd\u0bb3 \u0b9a\u0bc1\u0bae\u0bbe\u0bb0\u0bcd 0.0572 \u0bc6\u0bb9\u0b95\u0bcd\u0b9f\u0baf\u0bbe\u0bb0\u0bcd \u0bb5\u0bbf\u0bb8\u0bcd\u0ba4\u0bc0\u0bb0\u0ba3\u1f99\u0bc8\u0b9f\u0baf \u0b8e\u0b9f\u0bcd\u1f8c (08) \u0b95\u0bbe\u0ba3\u0bbf\u0ba4\u0bcd \u1f90\u0ba3\u0bcd\u1f8c\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bc7\u0bae\u0bb2\u0ba4\u0bbf\u0b95 \u0bb5\u0bbf\u0baa\u0bb0\u0b99\u0bcd\u0b95\u0b