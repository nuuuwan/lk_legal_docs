    "text": "\u0db1\u0dd2\u0dba\u0dba\u0ddd\u0d9c\u0dba \u0db8\u0d9c\u0dd2\u0dca\u0dad \u0d9a\u0dcf\u0dbb\u0d9c\u0db8 \u0da9\u0dd2\u0dba\u0db3\u0ddd\u0dba \u0dc3\u0dd2\u0daf\u0da7 \u0d85\u0db8\u0dca\u0db6\u0dbc\u0dca\u0dad\u0dba\u0dcf\u0ddc\u0da7 \u0da9\u0dd2\u0dba\u0db3\u0ddd\u0dbd\u0da7 \u0dc0\u0dc4\u0dcf\u0dc5\u0db1\u0db8\u0dc5\u0dbb\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0dd2\u0dbd\u0dba \u0daf\u0dd3 2020.12.18 \u0dc3\u0dd2\u0daf\u0da7 2020.12.31 \u0daf\u0dd2\u0db1 \u0daf\u0d9a\u0dca\u0dbd\u0dc5 \u0d85\u0db8\u0dca\u0db6\u0dbc\u0dca\u0dad\u0dba\u0dcf\u0ddc\u0da7 \u0da9\u0dd2\u0dba\u0db3\u0ddd\u0dba \u0dba\u0dc0\u0dda\u0dbd\u0dba\u0da7 \u0dbd\u0dc5\u0dbb\u0dca\u0dcf\u0dc5 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dbd\u0dc0\u0dc4\u0dcf\u0dc5\u0dbd \u0dbc\u0db6\u0dc5 \u0dba\u0db1\u0ddc\u0daf\u0dd3\u0db8 \u0dad\u0dd4\u0dc2 2020.12.18 \u0dc3\u0dd2\u0daf\u0da7 2020.12.31 \u0daf\u0dd2\u0db1 \u0daf\u0d9a\u0dca\u0dbd\u0dc5 \u0dbd\u0dc6\u0da7\u0dd4\u0db3 \u0d85\u0dc4\u0dd2\u0db8\u0dd2 \u0dc0\u0dd3\u0db8. iii. \u0dbd\u0dd2\u0dda\u0dad\u0dd3\u0dba \u0dc0\u0db8\u0dd2\u0dad\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0dbd\u0db1\u0dd4\u0dba\u0dbd\u0dca\u0dad \u0db8\u0dc5\u0dc3\u0dd2\u0daf\u0d9a\u0dbd \u0dbc\u0db6\u0dc5\u0dba\u0daf\u0db1 \u0dbb\u0dc5\u0da2\u0dcf\u0d9a\u0dc5\u0dbb\u0dd2 \u0db1\u0dd2\u0dbd\u0dc5\u0dd4 \u0daf\u0dd2\u0db1 02 2020 \u0dba\u0daf\u0dc0\u0dc6\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dc5\u0dc0\u0dba \u0dc0\u0db2\u0dc1\u0dc5 \u0dbc\u0db6\u0dc5",
