    "text": "1:111 0.5449 \u0dc3\u0dd2\u0dba\u0db9\u0dbd\u0dcf\u0db4\u0dd2\u0da7\u0dd2\u0dba\u0dd9\u0d9c\u0dca \u0dd9\u0da9\u0dca\u0dc0\u0dca\u0da7\u0dca \u0d85\u0db4\u0dca\u0db4\u0dd4\u0dc4\u0dcf\u0db8\u0dd2 431451816V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dd2\u0dba\u0db9\u0dbd\u0dcf\u0db4\u0dd2\u0da7\u0dd2\u0dba\u0dd9\u0d9c\u0dca \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dd0\u0d9a\u0dd4\u0dbd\u0dcf\u0dc0\u0dbd, \u0d9a\u0dd4/\u0dad\u0db9\u0d9c\u0dbd\u0dca\u0dbd \u0dbb\u0dd6\u0db4\u0dcf \u0db1\u0dd3\u0dbd\u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dd2 \u0d86\u0da5\u0dcf \u0db4\u0db1\u0dd9\u0dad\u0dca \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0db4\u0dca\u0dad\u0dd2\u0d9a\u0dba\u0d9a\u0dd4 \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dc0\u0dbd\u0da7 \u0dd9\u0dbd\u0dc3 \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0d9a\u0dbb \u0d87\u0dad 1:115 0.2679 \u0dc4\u0dad\u0dca\u0dd9\u0d9a\u0ddc\u0da7\u0dd4\u0dc0 \u0d9c\u0db8\u0dd9\u0d9c\u0dca \u0dc3\u0dd4\u0dd9\u0db1\u0dca\u0dad\u0dcf 757902788V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d86\u0da5\u0dcf \u0dd9\u0db6\u0ddd\u0da9\u0dca \u0dc4\u0db1\u0dca\u0daf\u0dd2\u0dba, \u0d9a\u0dd0\u0d9a\u0dd4\u0dbd\u0dcf\u0dc0\u0dbd, \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dc0\u0dbd\u0da7 \u0d9a\u0dd4/\u0dad\u0db9\u0d9c\u0dbd\u0dca\u0dbd \u0dba\u0da7\u0dad\u0dca\u0dc0 1:116 0.1262 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dda\u0dbd\u0dcf\u0dd9\u0d9c\u0dca 626661645V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0da7\u0dd3.\u0da9\u0da9\u0dca.\u0daf\u0dd4\u0dbd\u0dcf\u0d82\u0da2\u0dbd\u0dd3 \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2\u0dc4\u0dcf\u0db8\u0dd2 \u0d8b\u0dd9\u0daf\u0dca\u0dc1\u0dd2\u0d9a\u0dcf \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2 \u0d86\u0da5\u0dcf \u0db4\u0db1\u0dd9\u0dad\u0dca \u0d9a\u0dd0\u0d9a\u0dd4\u0dbd\u0dcf\u0dc0\u0dbd, \u0d9a\u0dd4/\u0dad\u0db9\u0d9c\u0dbd\u0dca\u0dbd \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0db4\u0dca\u0dad\u0dd2\u0d9a\u0dba\u0d9a\u0dd4 \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dd9\u0dbd\u0dc3 \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0d9a\u0dbb \u0d87\u0dad 1:117 0.0817 \u0da7\u0dd2\u0d9a\u0dd2\u0dbb\u0dd2\u0dba\u0dcf \u0dc0\u0dbb\u0dca\u0dab\u0dd9\u0d9c\u0dca \u0d89\u0db1\u0dca\u0daf\u0dd2\u0d9a \u0dc3\u0db8\u0db1\u0dca 851303200V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d86\u0da5\u0dcf \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dc0\u0dbd\u0da7 \u0d89\u0db1\u0dca\u0daf\u0dd2\u0d9a \u0dd9\u0db6\u0dca\u0d9a\u0dbb\u0dca\u0dc3\u0dca, \u0db8\u0dd0\u0dc4\u0dd2\u0d87\u0dbd\u0dca\u0dbd\u0d9c\u0db8, \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0dc4\u0dd2\u0dbb\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba, \u0db1\u0dd2\u0d9a\u0db3\u0dbd\u0dd4\u0dd9\u0db4\u0ddc\u0dad 1:122 0.3775 \u0da7\u0dd2\u0d9a\u0dd2\u0dbb\u0dd2\u0dba\u0dcf \u0dc0\u0dbb\u0dca\u0dab\u0dd9\u0d9c\u0dca \u0db8\u0dd9\u0db1\u0ddd\u0da2\u0dca \u0dc3\u0d82\u0da2\u0dba 833163272V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0dd3/\u0dbb \u0dd9\u0db4\u0dca\u0da9\u0dd2\u0d9c\u0db8 \u0dc3\u0dab\u0dc3 \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0daf \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf \u0dc3\u0db8\u0dd2\u0dad\u0dd2\u0dba- \u0dd9\u0db4\u0dca\u0da9\u0dd2\u0d9c\u0db8, \u0d86\u0da5\u0dcf \u0dc3\u0db4\u0dca\u0db4\u0dcf\u0dba\u0d82\u0d9c\u0dbd \u0db4\u0dcf\u0dbb, \u0d9a\u0dd0\u0d9a\u0dd4\u0dbd\u0dcf\u0dc0\u0dbd, \u0d9a\u0dd4/\u0dad\u0db9\u0d9c\u0dbd\u0dca\u0dbd \u0db4\u0db1\u0dd9\u0dad\u0dca \u0d9a\u0dd4/\u0dad\u0db9\u0d9c\u0dbd\u0dca\u0dbd \u0dd9\u0dc0\u0dad \u0dad\u0db6\u0dcf \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dc0\u0dbd\u0da7 \u0d87\u0dad\u0dd2 \u0dba\u0da7\u0dad\u0dca\u0dc0 6734-2021/12/16 \u0d8b\u0d9a\u0dc3\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:123 0.2998 \u0dbb\u0db1\u0dca\u0dd9\u0d9a\u0ddc\u0dad\u0dca \u0dd9\u0db4\u0dca\u0da9\u0dd2\u0dbd\u0dcf \u0dd9\u0d9c\u0dca \u0db1\u0dd2\u0db8\u0dbd\u0dca \u0dc0\u0dd3\u0dbb\u0dad\u0dd4\u0d82\u0d9c 741933101V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d86\u0da5\u0dcf \u0d9a\u0dd0\u0d9a\u0dd4\u0dbd\u0dcf\u0dc0\u0dbd, \u0d9a\u0dd4/\u0dad\u0db9\u0d9c\u0dbd\u0dca\u0dbd \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dc0\u0dbd\u0da7 \u0dba\u0da7\u0dad\u0dca\u0dc0 1:127 0.5889 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dd4\u0daf\u0dd2\u0dba\u0db1\u0dca\u0dd9\u0dc3\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d8b\u0d9a\u0dca\u0d9a\u0dd4 194764110218 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba _ \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d86\u0da5\u0dcf \u0d85\u0db8\u0dca\u0db8\u0dcf \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dc0\u0dbd\u0da7 \u0dc3\u0db4\u0dca\u0db4\u0dcf\u0dba\u0d82\u0d9c\u0dbd \u0db4\u0dcf\u0dbb, \u0d9a\u0dd0\u0d9a\u0dd4\u0dbd\u0dcf\u0dc0\u0dbd, \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0d9a\u0dd4/\u0dad\u0db9\u0d9c\u0dbd\u0dca\u0dbd 1:128 0.3784 \u0dd9\u0dc4\u0da7\u0dca\u0da7\u0dd2\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0dbd\u0dd4\u0dc0\u0dd2\u0dc3\u0dca \u0dc3\u0dd2\u0d82\u0da5\u0dcf 610181503V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dd9\u0dc4\u0da7\u0dca\u0da7\u0dd2\u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0dbd\u0dcf\u0dd9\u0d9c\u0dca \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0dd0\u0d9a\u0dd4\u0dbd\u0dcf\u0dc0\u0dbd, \u0d9a\u0dd4/\u0dad\u0db9\u0d9c\u0dbd\u0dca\u0dbd \u0d85\u0db1\u0dd4\u0dc1\u0dca\u0d9a \u0dc3\u0db3\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d86\u0da5\u0dcf \u0db4\u0db1\u0dd9\u0dad\u0dca \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0db4\u0dca\u0dad\u0dd2\u0d9a\u0dba\u0d9a\u0dd4 \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 \u0dc0\u0dbd\u0da7 \u0dd9\u0dbd\u0dc3 \u0dbd\u0dd2\u0dba\u0dcf\u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0d9a\u0dbb \u0d87\u0dad 1:140 0.1859 \u0dbb\u0db1\u0dca\u0dd9\u0d9a\u0ddc\u0dad\u0dca \u0dd9\u0db4\u0dca\u0da9\u0dd2\u0dd9\u0d9c\u0dca \u0d9c\u0dcf\u0db8\u0dd2\u0dab\u0dd3 \u0dc3\u0dd4\u0db6\u0dc3\u0dd2\u0d82\u0dc4 691264580V \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0db4\u0dae\u0db8 \u0db4\u0db1\u0dca\u0dad\u0dd2\u0dba \u0dc3\u0db8\u0dd8\u0daf\u0dca\u0db0\u0dd2 \u0d89\u0da9\u0db8\u0dca \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d86\u0da5\u0dcf \u0d9a\u0dd0\u0d9a\u0dd4\u0dbd\u0dcf\u0dc0\u0dbd, \u0d9a\u0dd4/\u0dad\u0db9\u0d9c\u0dbd\u0dca\u0dbd \u0db4\u0da2\u0dcf\u0db8\u0dd6\u0dbd \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0 \u0db4\u0db1\u0dd9\u0dad\u0dca \u0dd9\u0d9a\u0ddc\u0db1\u0dca\u0dd9\u0daf\u0dca\u0dc3\u0dd2 (\u0dd9\u0db4\u0ddc\u0dad\u0dd4\u0dc0\u0dcf\u0dd9\u0d9c\u0ddc\u0db1\u0dca\u0db1)- \u0dc0\u0dbd\u0da7 \u0d9c\u0dd9\u0db1\u0dca\u0dc0\u0dad\u0dca\u0dad, \u0dba\u0da7\u0dad\u0dca\u0dc0 \u0db1\u0dd2\u0d9a\u0db3\u0dbd\u0dd4\u0dd9\u0db4\u0ddc\u0dad \u0dd9\u0dc0\u0dad \u0dad\u0db6\u0dcf \u0d87\u