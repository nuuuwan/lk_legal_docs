    "text": "\u0dcf\u0dbd \u0daf, 2024 \u0dba\u0db1\u0dd4\u0dbd\u0dd0\u0d9c\u0dda\u0db6\u0dbb\u0dca \u0db8\u0dc0 25 \u0dbd\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1\u0da7 \u0db8\u0dda\u0dba\u0dcf\u0dca\u0dad, \u0d92 \u0d89\u0da9\u0d9c\u0dda \u0dc0\u0d9c\u0dda\u0db6\u0dca\u0dad\u0db0\u0dba\u0dba\u0dca\u0dad \u0d94\u0dc0\u0dd4\u0dca\u0dad\u0dba\u0dba \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dbd\u0dcf\u0dc3\u0dd2\u0d9a\u0d9c\u0dda\u0dbd\u0dbc \u0dc0\u0dca\u0dbd\u0db7\u0dcf\u0dbd\u0dba\u0dda, \u0d91\u0d9a\u0dd3 \u0d89\u0da9\u0d9c\u0dda \u0dbc\u0db6\u0dcf\u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d9c\u0dd0\u0db1 \u0dbd\u0dca\u0dad\u0daf\u0dd2 \u0d89\u0db8\u0dbd\u0dd3\u0db8\u0da7 \u0d87\u0dad\u0dd2 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db2 \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb\u0dda, \u0dbd\u0dca\u0dad\u0daf\u0dd2 \u0d85\u0daf\u0dbc \u0dc1\u0dcf \u0d92 \u0d85\u0daf\u0dbc \u0d9c\u0dba\u0dca\u0dad \u0db6\u0dd0\u0dbd\u0dd5 \u0dc1\u0dd0\u0da7\u0dd2\u0dda \u0db8\u0dcf \u0dba\u0dbd\u0dcf \u0db4\u0dd2\u0da7\u0db3\u0dda \u0dba\u0daf\u0d9a\u0d9a\u0dca \u0dc0\u0dc4\u0dd2\u0dcf \u0dc0\u0dd5 \u0dd2 \u0dba\u0dc0\u0dd2\u0db8\u0dbc\u0dd2\u0dba\u0dca\u0dad \u0daf\u0dd0\u0db1\u0dd4\u0d9c\u0dda \u0daf\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dba. \u0d85\u0dba\u0dd2\u0dad\u0dd2\u0dba \u0dcf\u0dc1\u0dc0\u0dd4\u0dbb\u0dd4 \u0dd2\u0dba\u0dbb\u0dd3\u0db8 \u0dc0\u0db2\u0dc1\u0dcf \u0d94\u0db6 \u0dba\u0dbd\u0dcf \u0d87\u0dad\u0dd2 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0db8 \u0d94\u0db4\u0db4\u0dd4 \u0dc1\u0dcf \u0dd2 \u0dba\u0dc0\u0dd2\u0dd2 \u0daf, \u0d8a\u0da7 \u0d85\u0daf\u0dcf\u0dc2 \u0db3\u0dda\u0d89\u0dbb\u0dd4 \u0db4\u0dd2\u0da7\u0db3\u0dda \u0daf, \u0db3\u0dbb\u0dd3\u0d9a\u0dca\u0dbf\u0dba \u0d85\u0dbd\u0dc0\u0dca\u0dae\u0dcf\u0dba\u0dc0\u0dca \u0daf\u0dd3 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db3\u0dda \u0d9a\u0dc2 \u0dba\u0dd4\u0dad\u0dd4\u0dba. \u0d91\u0db8. \u0d91\u0dca\u0dad. \u0db4\u0dd2\u0dba\u0dd4\u0db8\u0dbd\u0dd3 \u0dd2 \u0dba\u0db1\u0dba\u0dba, \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3