    "text": "\u0dbc\u0db6\u0dcf\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db6\u0dbc\u0dcf\u0dba\u0db3\u0dd4\u0dba\u0dbb\u0dd4\u0dda\u0dad\u0dd4\u0dbd\u0db1 \u0d89\u0da9\u0d9c\u0dda \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb :- \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0db3\u0dc2\u0dcf\u0dba\u0dda, \u0d9c\u0dcf\u0db8\u0dbc \u0daf\u0dd2\u0dc0\u0dca\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda, \u0dba\u0db6\u0ddd\u0dba\u0db4 \u0dba\u0db3\u0ddd\u0dd3\u0daf\u0dbc \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dba\u0dd3\u0dba \u0dba \u0dba\u0db8\u0d9a\u0d9c\u0dda \u0dba\u0d9a\u0dd4\u0da7\u0dca\u0dc3\u0dcf\u0dc0\u0dba\u0dda, \u0d85\u0d82\u0d9a 121 \u0dbd\u0d9a\u0dca\u0dbd\u0dd0\u0db8\u0dbc \u200d\u0dcf\u0db8 \u0db1\u0dd2\u0dbc\u0db0\u0dcf\u0dbb\u0dd2 \u0dba\u0d9a\u0dd4\u0da7\u0dca\u0dc3\u0dcf\u0dc0\u0dba\u0dda \u0dbd\u0d9a\u0dca\u0dbd\u0dd0\u0db8\u0dbc \u0d9c\u0dba\u0d9c\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2, \u0dba\u0da2\u0dcf\u200d\u0dbf\u0dca\u0dc3 \u0db8\u0dd2\u0db1\u0dd2\u0dca\u0dad\u0dba\u0daf\u0ddd\u0dbb\u0dd4 \u0d85\u0db0\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2 \u0dc0\u0dd2\u0dc3\u0dd2\u0dca\u0dad \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0dba\u0dbc \u0d9a\u0dbb\u0db1 \u0dbc\u0daf \u0d9a\u0dd0\u0da9\u0dd0\u0dc0\u0dca\u0dcf\u0dbb \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0d9c\u0dda \u0d85\u0d82\u0d9a 810179 \u0d9a\u0dbc\u0dcf\u0db3 \u0d85\u0d82\u0d9a 06 \u0db3\u0dad\u0dca\u200d\u0dbb \u0d85\u0d82\u0d9a 1 \u0dc4\u0dd2 \u0d9a\u0dd0\u0db6\u0dd2 \u0d85\u0d82\u0d9a 01 \u0dc1\u0dcf 02 \u0dba\u0dbc\u0dc0 \u0db1\u0dd2\u0dbb\u0dd5\u0db4\u0dd2\u0dcf \u0db3\u0dc1\u0dcf \u0dc0\u0dd2\u0dc0\u0dca\u0dcf\u0dbb \u0dba\u0d9a\u0dba\u0dbb\u0db1 \u0d89\u0da9\u0d9c\u0dda \u0dba\u0d9a\u0dd4\u0da7\u0dc0\u0dca.",
