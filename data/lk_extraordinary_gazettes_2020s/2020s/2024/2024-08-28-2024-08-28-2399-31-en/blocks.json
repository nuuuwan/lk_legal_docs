    "fonts": [
      "TimesNewRomanPSMT"
    ],
    "sizes": [
      10.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      55.28,
      655.68,
      549.82,
      702.15
    ],
    "text": "AND whereas it is now deemed expedient that the said Order be revoked, due to Mr. Janajith De Silva, Attorney - at - Law, the Arbitrator informing that he is resigning from the post of Arbitrator, I, Manusha Nanayakkara, Minister of Labour and Foreign Employment do hereby revoke the said Order and further make Order that no proceedings be taken upon the said Order dated 20.04.2021.",
    "fonts": [
      "TimesNewRomanPSMT"
    ],
